    <bpmn:process id="W_W2121" name="W2121. Warranty Transfer for Resold Properties" isExecutable="false">
      <bpmn:documentation>Trigger: Homeowner requests warranty transfer to new property owner
Frequency: ~50–100 requests/month; peaks in summer renovation
Volume: ~50–100/month; avg 10–30 items per property
Owner: Customer Service Rep
Participants: CSR, Customer Service Director
Source: workflow W2121 — Warranty Transfer for Resold Properties</bpmn:documentation>
      <bpmn:laneSet id="W2121_LaneSet3">
        <bpmn:lane id="W2121_Lane1" name="CSR">
        <bpmn:flowNodeRef>W2121_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2121_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2121_Lane2" name="System">
        <bpmn:flowNodeRef>W2121_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2121_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2121_Start4" name="Homeowner requests warranty transfer to new property owner">
        <bpmn:outgoing>W2121_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2121_Task5" name="CSR verifies original purchase on the Install Base instance (fit-gap D16)…">
        <bpmn:documentation>Step 1: CSR verifies original purchase on the Install Base instance (fit-gap D16); confirms warranty status, remaining coverage; creates transfer record with new owner details
Responsible (R): CSR
Accountable (A): Customer Service Dir
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W2121_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2121_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2121_Task6" name="System sends transfer confirmation to both parties; updates vendor portal…">
        <bpmn:documentation>Step 2: System sends transfer confirmation to both parties; updates vendor portal; notes expired items and offers extended warranty renewal
Responsible (R): System
Accountable (A): CSR
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2121_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2121_Flow12</bpmn:outgoing>
