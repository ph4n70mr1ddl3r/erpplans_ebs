    <bpmn:process id="W_W2119" name="W2119. Online Purchase Warranty Registration" isExecutable="false">
      <bpmn:documentation>Trigger: Ecommerce order with warranty-eligible items fulfilled
Frequency: ~8,580 warranty registrations/month from ecommerce
Volume: ~8,580/month
Owner: Ecommerce System / CRM
Participants: Ecommerce Ops, Customer
Source: workflow W2119 — Online Purchase Warranty Registration</bpmn:documentation>
      <bpmn:laneSet id="W2119_LaneSet2">
        <bpmn:lane id="W2119_Lane1" name="System">
        <bpmn:flowNodeRef>W2119_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2119_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2119_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2119_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2119_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2119_Start3" name="Ecommerce order with warranty-eligible items fulfilled">
        <bpmn:outgoing>W2119_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2119_Task4" name="Ecommerce platform identifies warranty-eligible SKUs; auto-generates…">
        <bpmn:documentation>Step 1: Ecommerce platform identifies warranty-eligible SKUs; auto-generates registration upon fulfillment confirmation; sends digital warranty certificate via email
Responsible (R): System
Accountable (A): Ecommerce Ops
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2119_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2119_Flow11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W2119_Task5" name="For serial-numbered items: customer prompted to register serial via online form…">
        <bpmn:documentation>Step 2: For serial-numbered items: customer prompted to register serial via online form within 14 days; system sends reminders at day 7 and 13
Responsible (R): System
Accountable (A): Customer
Duration: &lt;1 min</bpmn:documentation>
        <bpmn:incoming>W2119_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2119_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W2119_Task6" name="Warranty data pushed to vendor portal; record created on the Install Base…">
        <bpmn:documentation>Step 3: Warranty data pushed to vendor portal; record created on the Install Base instance (fit-gap D16), linked to the customer profile in CRM and visible in mobile app
Responsible (R): System
Accountable (A): CRM
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2119_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2119_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2119_End7" name="Complete">
        <bpmn:incoming>W2119_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2119_Annotation8">
        <bpmn:text>Controls: - CTL-37: warranty validity; CTL-44 (registration integrity); operational: Ecommerce Ops monitoring
Owner: Ecommerce System / CRM</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2119_Assoc9" sourceRef="W2119_Annotation8" targetRef="W2119_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2119_Flow10" sourceRef="W2119_Start3" targetRef="W2119_Task4" />
      <bpmn:sequenceFlow id="W2119_Flow11" sourceRef="W2119_Task4" targetRef="W2119_Task5" />
      <bpmn:sequenceFlow id="W2119_Flow12" sourceRef="W2119_Task5" targetRef="W2119_Task6" />
      <bpmn:sequenceFlow id="W2119_Flow13" sourceRef="W2119_Task6" targetRef="W2119_End7" />
    </bpmn:process>
