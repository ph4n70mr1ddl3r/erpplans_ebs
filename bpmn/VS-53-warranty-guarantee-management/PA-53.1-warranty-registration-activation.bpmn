      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2120" name="W2120. Bulk Warranty Registration for Trade Accounts" isExecutable="false">
      <bpmn:documentation>Trigger: Trade/corporate account purchases warranty items in bulk
Frequency: ~1,050 bulk registrations/month
Volume: ~1,050/month; avg 5–15 items per invoice
Owner: Trade Account Manager
Participants: Head of Trade / Account Management, Customer
Source: workflow W2120 — Bulk Warranty Registration for Trade Accounts</bpmn:documentation>
      <bpmn:laneSet id="W2120_LaneSet3">
        <bpmn:lane id="W2120_Lane1" name="Trade Account Mgr">
        <bpmn:flowNodeRef>W2120_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2120_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2120_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2120_Lane2" name="System">
        <bpmn:flowNodeRef>W2120_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2120_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2120_Start4" name="Trade/corporate account purchases warranty items in bulk">
        <bpmn:outgoing>W2120_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2120_Task5" name="Account Manager creates the project warranty file as linked Install Base…">
        <bpmn:documentation>Step 1: Account Manager creates the project warranty file as linked Install Base instances (fit-gap D16): links all items to project ID, customer account, delivery addresses
Responsible (R): Trade Account Mgr
Accountable (A): Head of Trade / Account Management
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W2120_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2120_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2120_Task6" name="System auto-registers each item with project-level warranty start date (may…">
        <bpmn:documentation>Step 2: System auto-registers each item with project-level warranty start date (may differ from invoice date for phased deliveries)
Responsible (R): System
Accountable (A): Trade Account Mgr
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2120_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2120_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2120_Task7" name="Account Manager sends consolidated warranty schedule to customer; system…">
        <bpmn:documentation>Step 3: Account Manager sends consolidated warranty schedule to customer; system schedules expiry alerts at 30 and 90 days before expiry
Responsible (R): Trade Account Mgr
Accountable (A): Customer
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W2120_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2120_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2120_End8" name="Complete">
        <bpmn:incoming>W2120_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2120_Annotation9">
        <bpmn:text>Controls: - CTL-37: warranty validity; CTL-06 (project/customer master); operational: Head of Trade / Account Management sign-off on project warranty files
Owner: Trade Account Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2120_Assoc10" sourceRef="W2120_Annotation9" targetRef="W2120_Start4" associationDirection="None" />
