      <bpmn:sequenceFlow id="W2120_Flow12" sourceRef="W2120_Task5" targetRef="W2120_Task6" />
      <bpmn:sequenceFlow id="W2120_Flow13" sourceRef="W2120_Task6" targetRef="W2120_Task7" />
      <bpmn:sequenceFlow id="W2120_Flow14" sourceRef="W2120_Task7" targetRef="W2120_End8" />
    </bpmn:process>
