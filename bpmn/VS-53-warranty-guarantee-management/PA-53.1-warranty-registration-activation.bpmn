<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-53.1-warranty-registration-activation" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2118" name="W2118. POS Warranty Capture at Checkout" isExecutable="false">
      <bpmn:documentation>Trigger: Customer purchases warranty-eligible product at POS or online
Frequency: ~420,000 warranty-eligible transactions/month
Volume: ~420K transactions/month across 200 stores + ecommerce
Owner: Cashier / POS System
Participants: Store Manager, IT Integration Lead
Source: workflow W2118 — POS Warranty Capture at Checkout</bpmn:documentation>
      <bpmn:laneSet id="W2118_LaneSet4">
        <bpmn:lane id="W2118_Lane1" name="POS System">
        <bpmn:flowNodeRef>W2118_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2118_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2118_Lane2" name="Cashier">
        <bpmn:flowNodeRef>W2118_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2118_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2118_Lane3" name="System">
        <bpmn:flowNodeRef>W2118_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2118_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2118_Start5" name="Customer purchases warranty-eligible product at POS or online">
        <bpmn:outgoing>W2118_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2118_Task6" name="POS auto-identifies warranty-eligible SKU at scan; prompts cashier; captures…">
        <bpmn:documentation>Step 1: POS auto-identifies warranty-eligible SKU at scan; prompts cashier; captures transaction date, SKU, serial number, store, loyalty ID; generates the warranty record on the Oracle Install Base item instance (fit-gap D16)
Responsible (R): POS System
Accountable (A): Cashier
Duration: 30–60 sec</bpmn:documentation>
        <bpmn:incoming>W2118_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2118_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2118_Task7" name="Cashier prints warranty card with terms, duration, claim instructions, and…">
        <bpmn:documentation>Step 2: Cashier prints warranty card with terms, duration, claim instructions, and registration QR code; customer scans for digital warranty wallet
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 30 sec</bpmn:documentation>
        <bpmn:incoming>W2118_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2118_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2118_Task8" name="For serial-numbered items: cashier scans or enters serial number; system…">
        <bpmn:documentation>Step 3: For serial-numbered items: cashier scans or enters serial number; system validates format and links to item+transaction record
Responsible (R): Cashier
Accountable (A): Cashier
Duration: 15–30 sec</bpmn:documentation>
        <bpmn:incoming>W2118_Flow15</bpmn:incoming>
        <bpmn:outgoing>W2118_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2118_Task9" name="System pushes registration to vendor portal (real-time for top 20 vendors…">
        <bpmn:documentation>Step 4: System pushes registration to vendor portal (real-time for top 20 vendors; batch daily for others); customer receives SMS/email confirmation
Responsible (R): System
Accountable (A): IT Integration Lead
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2118_Flow16</bpmn:incoming>
        <bpmn:outgoing>W2118_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2118_End10" name="Complete">
        <bpmn:incoming>W2118_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2118_Annotation11">
        <bpmn:text>Controls: - CTL-194 (ensure warranty registration &amp; claim integrity.); CTL-388 (ensure controlled execution — Product Warranty Registration &amp; Activation (PA-53.1).)
Owner: Cashier / POS System</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2118_Assoc12" sourceRef="W2118_Annotation11" targetRef="W2118_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2118_Flow13" sourceRef="W2118_Start5" targetRef="W2118_Task6" />
      <bpmn:sequenceFlow id="W2118_Flow14" sourceRef="W2118_Task6" targetRef="W2118_Task7" />
      <bpmn:sequenceFlow id="W2118_Flow15" sourceRef="W2118_Task7" targetRef="W2118_Task8" />
      <bpmn:sequenceFlow id="W2118_Flow16" sourceRef="W2118_Task8" targetRef="W2118_Task9" />
      <bpmn:sequenceFlow id="W2118_Flow17" sourceRef="W2118_Task9" targetRef="W2118_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2118_diag">
      <bpmndi:BPMNPlane id="W2118_plane" bpmnElement="W_W2118">
        <bpmndi:BPMNShape id="W2118_Lane1_di" bpmnElement="W2118_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
