<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-53.2-warranty-claim-processing" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2126" name="W2126. In-Store Warranty Claim Initiation" isExecutable="false">
      <bpmn:documentation>Trigger: Customer brings defective product with proof of purchase to store
Frequency: ~2,000–3,000 claims/month across 200 stores (one register with W1630; ~10–15 per store/month)
Volume: ~8K–10K/month; peaks Jan–Feb, Jun–Jul
Owner: Customer Service Rep
Participants: CSR, Store Manager, Customer
Source: workflow W2126 — In-Store Warranty Claim Initiation</bpmn:documentation>
      <bpmn:laneSet id="W2126_LaneSet3">
        <bpmn:lane id="W2126_Lane1" name="CSR">
        <bpmn:flowNodeRef>W2126_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2126_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2126_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2126_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2126_Lane2" name="System">
        <bpmn:flowNodeRef>W2126_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2126_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2126_Start4" name="Customer brings defective product with proof of purchase to store">
        <bpmn:outgoing>W2126_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2126_Task5" name="CSR verifies warranty coverage on the Install Base instance (fit-gap D16)…">
        <bpmn:documentation>Step 1: CSR verifies warranty coverage on the Install Base instance (fit-gap D16); inspects product; photographs defect; checks serial number match
Responsible (R): CSR
Accountable (A): Store Manager
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W2126_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2126_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2126_Task6" name="System classifies claim: standard (auto-approve), borderline (route to…">
        <bpmn:documentation>Step 2: System classifies claim: standard (auto-approve), borderline (route to Supervisor), out-of-warranty (offer paid repair)
Responsible (R): System
Accountable (A): CSR
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2126_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2126_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2126_Task7" name="CSR offers resolution: immediate replacement, store credit, service center…">
        <bpmn:documentation>Step 3: CSR offers resolution: immediate replacement, store credit, service center repair, or DC/vendor replacement (7–14 days)
Responsible (R): CSR
Accountable (A): Customer
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W2126_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2126_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2126_Task8" name="Customer selects resolution; system processes inventory adjustment, creates…">
        <bpmn:documentation>Step 4: Customer selects resolution; system processes inventory adjustment, creates claim record, notifies vendor
Responsible (R): CSR / System
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W2126_Flow15</bpmn:incoming>
        <bpmn:outgoing>W2126_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2126_End9" name="Complete">
        <bpmn:incoming>W2126_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2126_Annotation10">
        <bpmn:text>Controls: - CTL-389 (ensure controlled execution — Warranty Claim Processing &amp; Resolution (PA-53.2).) | - operational: Store Manager sign-off on borderline claims
Owner: Customer Service Rep</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2126_Assoc11" sourceRef="W2126_Annotation10" targetRef="W2126_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2126_Flow12" sourceRef="W2126_Start4" targetRef="W2126_Task5" />
      <bpmn:sequenceFlow id="W2126_Flow13" sourceRef="W2126_Task5" targetRef="W2126_Task6" />
      <bpmn:sequenceFlow id="W2126_Flow14" sourceRef="W2126_Task6" targetRef="W2126_Task7" />
      <bpmn:sequenceFlow id="W2126_Flow15" sourceRef="W2126_Task7" targetRef="W2126_Task8" />
      <bpmn:sequenceFlow id="W2126_Flow16" sourceRef="W2126_Task8" targetRef="W2126_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2126_diag">
      <bpmndi:BPMNPlane id="W2126_plane" bpmnElement="W_W2126">
        <bpmndi:BPMNShape id="W2126_Lane1_di" bpmnElement="W2126_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
