        <bpmndi:BPMNEdge id="W2127_Flow12_di" bpmnElement="W2127_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2127_Flow13_di" bpmnElement="W2127_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2127_Flow14_di" bpmnElement="W2127_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2127_Assoc10_di" bpmnElement="W2127_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2128" name="W2128. Vendor Warranty Claim Escalation" isExecutable="false">
      <bpmn:documentation>Trigger: Claim requires manufacturer involvement (high-value &gt;PHP 10K, complex product)
Frequency: ~1,500–2,000 vendor escalations/month
Volume: ~1.5K–2K/month (~20% of claims)
Owner: Vendor Warranty Coordinator
Participants: Coordinator, Category Manager, Vendor
Source: workflow W2128 — Vendor Warranty Claim Escalation</bpmn:documentation>
      <bpmn:laneSet id="W2128_LaneSet3">
        <bpmn:lane id="W2128_Lane1" name="System">
        <bpmn:flowNodeRef>W2128_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2128_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2128_Lane2" name="Coordinator">
        <bpmn:flowNodeRef>W2128_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2128_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2128_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2128_Start4" name="Claim requires manufacturer involvement (high-value &gt;PHP 10K, complex product)">
        <bpmn:outgoing>W2128_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2128_Task5" name="System auto-flags for vendor involvement; Coordinator packages claim with…">
        <bpmn:documentation>Step 1: System auto-flags for vendor involvement; Coordinator packages claim with photos, purchase proof, serial number
Responsible (R): System / Coordinator
Accountable (A): Category Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W2128_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2128_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2128_Task6" name="Coordinator submits via vendor portal or email; tracks acknowledgment within 48…">
        <bpmn:documentation>Step 2: Coordinator submits via vendor portal or email; tracks acknowledgment within 48 hours; manages vendor resolution (approve/return/deny)
Responsible (R): Coordinator
Accountable (A): Vendor
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W2128_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2128_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2128_Task7" name="Coordinator tracks 14-day vendor SLA; escalates to Category Manager if…">
        <bpmn:documentation>Step 3: Coordinator tracks 14-day vendor SLA; escalates to Category Manager if breached; monthly vendor warranty scorecard
Responsible (R): Coordinator
Accountable (A): Category Manager
Duration: 15 min/case</bpmn:documentation>
        <bpmn:incoming>W2128_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2128_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2128_End8" name="Complete">
        <bpmn:incoming>W2128_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2128_Annotation9">
        <bpmn:text>Controls: - CTL-389 (ensure controlled execution — Warranty Claim Processing &amp; Resolution (PA-53.2).) | - operational: Category Manager sign-off on vendor-SLA breaches
Owner: Vendor Warranty Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2128_Assoc10" sourceRef="W2128_Annotation9" targetRef="W2128_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2128_Flow11" sourceRef="W2128_Start4" targetRef="W2128_Task5" />
      <bpmn:sequenceFlow id="W2128_Flow12" sourceRef="W2128_Task5" targetRef="W2128_Task6" />
      <bpmn:sequenceFlow id="W2128_Flow13" sourceRef="W2128_Task6" targetRef="W2128_Task7" />
      <bpmn:sequenceFlow id="W2128_Flow14" sourceRef="W2128_Task7" targetRef="W2128_End8" />
    </bpmn:process>
