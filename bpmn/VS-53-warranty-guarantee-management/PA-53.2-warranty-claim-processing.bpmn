      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2129" name="W2129. Service Center Repair Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Claim requires repair at authorized service center
Frequency: ~3,000–4,000 repair claims/month
Volume: ~3K–4K/month; 7–14 day turnaround
Owner: Service Center Coordinator
Participants: Coordinator, Service Center, CS Supervisor
Source: workflow W2129 — Service Center Repair Coordination</bpmn:documentation>
      <bpmn:laneSet id="W2129_LaneSet3">
        <bpmn:lane id="W2129_Lane1" name="System">
        <bpmn:flowNodeRef>W2129_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2129_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2129_Lane2" name="Service Center">
        <bpmn:flowNodeRef>W2129_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2129_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2129_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2129_Start4" name="Claim requires repair at authorized service center">
        <bpmn:outgoing>W2129_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2129_Task5" name="System assigns to nearest authorized service center; generates work order…">
        <bpmn:documentation>Step 1: System assigns to nearest authorized service center; generates work order; arranges item transfer from store
Responsible (R): System / Coordinator
Accountable (A): Service Center
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W2129_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2129_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2129_Task6" name="Service center diagnoses: warranty-covered repair → proceed; non-covered →…">
        <bpmn:documentation>Step 2: Service center diagnoses: warranty-covered repair → proceed; non-covered → quote customer; beyond repair → replacement authorized
Responsible (R): Service Center
Accountable (A): Coordinator
Duration: 7–14 days</bpmn:documentation>
        <bpmn:incoming>W2129_Flow12</bpmn:incoming>
