    <bpmn:process id="W_W2133" name="W2133. Warranty Claim Analytics &amp; Trends" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly analytics cycle
Frequency: Monthly comprehensive; weekly operational
Volume: Monthly: ~10,000 claims analyzed
Owner: Analytics Manager
Participants: Category Manager
Source: workflow W2133 — Warranty Claim Analytics &amp; Trends</bpmn:documentation>
      <bpmn:laneSet id="W2133_LaneSet3">
        <bpmn:lane id="W2133_Lane1" name="System">
        <bpmn:flowNodeRef>W2133_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2133_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2133_Lane2" name="Analytics Manager">
        <bpmn:flowNodeRef>W2133_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2133_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2133_Start4" name="Monthly analytics cycle">
        <bpmn:outgoing>W2133_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2133_Task5" name="System generates analytics: claim volume by category/vendor/store, claim rate…">
        <bpmn:documentation>Step 1: System generates analytics: claim volume by category/vendor/store, claim rate by SKU, resolution time, cost, top 20 claim SKUs, repeat claim rate
Responsible (R): System
Accountable (A): Analytics Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2133_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2133_Flow11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2133_Task6" name="Analytics Manager identifies trends: rate increase &gt;2x triggers quality alert…">
        <bpmn:documentation>Step 2: Analytics Manager identifies trends: rate increase &gt;2x triggers quality alert; vendor &gt;5% triggers vendor review; store &gt;2x average triggers investigation
Responsible (R): Analytics Manager
Accountable (A): Category Manager
Duration: 4–6 hours</bpmn:documentation>
        <bpmn:incoming>W2133_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2133_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2133_End7" name="Complete">
        <bpmn:incoming>W2133_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2133_Annotation8">
        <bpmn:text>Controls: - CTL-389 (ensure controlled execution — Warranty Claim Processing &amp; Resolution (PA-53.2).) | - operational: Category Manager sign-off on quality alerts
Owner: Analytics Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2133_Assoc9" sourceRef="W2133_Annotation8" targetRef="W2133_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2133_Flow10" sourceRef="W2133_Start4" targetRef="W2133_Task5" />
      <bpmn:sequenceFlow id="W2133_Flow11" sourceRef="W2133_Task5" targetRef="W2133_Task6" />
      <bpmn:sequenceFlow id="W2133_Flow12" sourceRef="W2133_Task6" targetRef="W2133_End7" />
    </bpmn:process>
