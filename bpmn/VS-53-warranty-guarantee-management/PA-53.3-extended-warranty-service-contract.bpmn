      <bpmn:sequenceFlow id="W2137_Flow11" sourceRef="W2137_Task5" targetRef="W2137_Task6" />
      <bpmn:sequenceFlow id="W2137_Flow12" sourceRef="W2137_Task6" targetRef="W2137_End7" />
    </bpmn:process>
