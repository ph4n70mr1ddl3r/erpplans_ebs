    <bpmn:process id="W_W2136" name="W2136. Extended Warranty Contract Management" isExecutable="false">
      <bpmn:documentation>Trigger: Contract active through coverage period
Frequency: ~75,000–100,000 active contracts
Volume: ~75K–100K active contracts at any time
Owner: Warranty Administrator
Participants: Finance, Finance Manager, Warranty Admin, VP Merchandising
Source: workflow W2136 — Extended Warranty Contract Management</bpmn:documentation>
      <bpmn:laneSet id="W2136_LaneSet3">
        <bpmn:lane id="W2136_Lane1" name="System">
        <bpmn:flowNodeRef>W2136_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2136_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2136_Lane2" name="Warranty Admin">
        <bpmn:flowNodeRef>W2136_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2136_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2136_Start4" name="Contract active through coverage period">
        <bpmn:outgoing>W2136_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2136_Task5" name="System maintains contract lifecycle (active/approaching…">
        <bpmn:documentation>Step 1: System maintains contract lifecycle (active/approaching expiry/expired/cancelled); monthly liability accrual journal generated
Responsible (R): System / Finance
Accountable (A): Finance Manager
Duration: 4–6 hours/month</bpmn:documentation>
        <bpmn:incoming>W2136_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2136_Flow11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2136_Task6" name="Quarterly: review contract portfolio (renewal rate, claim rate vs. estimate…">
        <bpmn:documentation>Step 2: Quarterly: review contract portfolio (renewal rate, claim rate vs. estimate, cancellation rate, revenue vs. cost); annual re-pricing
Responsible (R): Warranty Admin / Finance
Accountable (A): VP Merchandising
Duration: 4–6 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W2136_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2136_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2136_End7" name="Complete">
        <bpmn:incoming>W2136_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2136_Annotation8">
        <bpmn:text>Controls: - CTL-390: PFRS 15 deferred-revenue accuracy — links to VS-157; CTL-44 (contract-count integrity); operational: Finance Manager monthly sign-off; VP Merchandising quarterly sign-off
Owner: Warranty Administrator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2136_Assoc9" sourceRef="W2136_Annotation8" targetRef="W2136_Start4" associationDirection="None" />
