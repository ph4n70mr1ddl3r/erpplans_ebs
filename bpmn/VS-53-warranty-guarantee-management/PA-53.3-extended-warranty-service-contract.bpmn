    <bpmn:process id="W_W2137" name="W2137. Extended Warranty Claim Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer files claim on product covered by extended warranty
Frequency: ~1,500–2,500 extended warranty claims/month
Volume: ~1.5K–2.5K/month; higher avg value
Owner: Extended Warranty Claims Specialist
Participants: Specialist, CS Director, Finance Manager
Source: workflow W2137 — Extended Warranty Claim Processing</bpmn:documentation>
      <bpmn:laneSet id="W2137_LaneSet3">
        <bpmn:lane id="W2137_Lane1" name="System">
        <bpmn:flowNodeRef>W2137_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2137_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2137_Lane2" name="Specialist">
        <bpmn:flowNodeRef>W2137_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2137_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2137_Start4" name="Customer files claim on product covered by extended warranty">
        <bpmn:outgoing>W2137_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2137_Task5" name="System verifies active contract, coverage period, claim type; Specialist…">
        <bpmn:documentation>Step 1: System verifies active contract, coverage period, claim type; Specialist validates defect is covered (not wear/misuse/accidental)
Responsible (R): System / Specialist
Accountable (A): CS Director
Duration: 20–30 min</bpmn:documentation>
        <bpmn:incoming>W2137_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2137_Flow11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2137_Task6" name="Specialist authorizes: repair at service center, replacement (&gt;70% of…">
        <bpmn:documentation>Step 2: Specialist authorizes: repair at service center, replacement (&gt;70% of replacement cost), or store credit; Finance tracks vs. accrual
Responsible (R): Specialist
Accountable (A): Finance Manager
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W2137_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2137_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2137_End7" name="Complete">
        <bpmn:incoming>W2137_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2137_Annotation8">
        <bpmn:text>Controls: - CTL-390 (ensure controlled execution — Extended Warranty &amp; Service Contract Management (PA-53.3).) | - operational: CS Director sign-off; Finance Manager accrual review
Owner: Extended Warranty Claims Specialist</bpmn:text>
      </bpmn:textAnnotation>
