    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2135" name="W2135. Extended Warranty POS Upsell" isExecutable="false">
      <bpmn:documentation>Trigger: Customer purchases eligible item at POS
Frequency: ~42,000 upsell opportunities/month
Volume: ~42K/month; target 15–20% attach rate
Owner: Cashier
Participants: Store Manager, Analytics Manager
Source: workflow W2135 — Extended Warranty POS Upsell</bpmn:documentation>
      <bpmn:laneSet id="W2135_LaneSet3">
        <bpmn:lane id="W2135_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W2135_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2135_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2135_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2135_Lane2" name="POS System">
        <bpmn:flowNodeRef>W2135_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2135_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2135_Start4" name="Customer purchases eligible item at POS">
        <bpmn:outgoing>W2135_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2135_Task5" name="POS auto-prompts with warranty options and price; cashier presents offer using…">
        <bpmn:documentation>Step 1: POS auto-prompts with warranty options and price; cashier presents offer using trained script
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 30–60 sec</bpmn:documentation>
        <bpmn:incoming>W2135_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2135_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2135_Task6" name="Customer accepts: warranty added to transaction, contract printed on receipt…">
        <bpmn:documentation>Step 2: Customer accepts: warranty added to transaction, contract printed on receipt, digital acknowledgment signed; auto-registered as a Service Contract on the Install Base instance (fit-gap D16)
Responsible (R): Cashier / System
Accountable (A): Cashier
Duration: 30 sec</bpmn:documentation>
        <bpmn:incoming>W2135_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2135_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W2135_Task7" name="Customer declines: recorded for analytics; no repeated offers to protect…">
        <bpmn:documentation>Step 3: Customer declines: recorded for analytics; no repeated offers to protect customer experience
Responsible (R): POS System
Accountable (A): Analytics Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2135_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2135_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2135_End8" name="Complete">
        <bpmn:incoming>W2135_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2135_Annotation9">
        <bpmn:text>Controls: - CTL-390 (ensure controlled execution — Extended Warranty &amp; Service Contract Management (PA-53.3).) | - operational: Store Manager attach-rate review
Owner: Cashier</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2135_Assoc10" sourceRef="W2135_Annotation9" targetRef="W2135_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2135_Flow11" sourceRef="W2135_Start4" targetRef="W2135_Task5" />
