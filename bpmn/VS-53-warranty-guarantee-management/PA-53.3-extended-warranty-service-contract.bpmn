    <bpmn:process id="W_W2134" name="W2134. Extended Warranty Product Design &amp; Pricing" isExecutable="false">
      <bpmn:documentation>Trigger: Annual review or new category launch
Frequency: Quarterly review; new category as needed
Volume: ~10–15 products across 6 categories
Owner: Category Manager
Participants: Finance, VP Merchandising, Legal
Source: workflow W2134 — Extended Warranty Product Design &amp; Pricing</bpmn:documentation>
      <bpmn:laneSet id="W2134_LaneSet3">
        <bpmn:lane id="W2134_Lane1" name="Category Mgr">
        <bpmn:flowNodeRef>W2134_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2134_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2134_Lane2" name="Legal">
        <bpmn:flowNodeRef>W2134_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2134_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2134_Start4" name="Annual review or new category launch">
        <bpmn:outgoing>W2134_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2134_Task5" name="Category Manager identifies eligible categories; Finance calculates pricing…">
        <bpmn:documentation>Step 1: Category Manager identifies eligible categories; Finance calculates pricing based on claim rate, repair cost, target margin (40–60%)
Responsible (R): Category Mgr / Finance
Accountable (A): VP Merchandising
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W2134_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2134_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2134_Task6" name="Legal reviews contract terms for Consumer Act compliance; Manager configures in…">
        <bpmn:documentation>Step 2: Legal reviews contract terms for Consumer Act compliance; Manager configures in ERP with service SKU, pricing tiers, POS upsell rules
Responsible (R): Legal / Category Mgr
Accountable (A): VP Merchandising
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2134_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2134_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2134_End7" name="Complete">
        <bpmn:incoming>W2134_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2134_Annotation8">
        <bpmn:text>Controls: - CTL-390 (ensure controlled execution — Extended Warranty &amp; Service Contract Management (PA-53.3).) | - CTL-390: extended-warranty pricing adequacy — links to VS-157; service-contract terms conform to the Consumer Act (RA 7394) — links to VS-22; operational: VP Merchandising sign-off
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2134_Assoc9" sourceRef="W2134_Annotation8" targetRef="W2134_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2134_Flow10" sourceRef="W2134_Start4" targetRef="W2134_Task5" />
      <bpmn:sequenceFlow id="W2134_Flow11" sourceRef="W2134_Task5" targetRef="W2134_Task6" />
      <bpmn:sequenceFlow id="W2134_Flow12" sourceRef="W2134_Task6" targetRef="W2134_End7" />
    </bpmn:process>
