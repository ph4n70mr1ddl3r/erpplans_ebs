    <bpmn:process id="W_W4099" name="W4099. Technology Investment Portfolio &amp; Capex/Opex Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Investment intake; capex cycle
Frequency: Continuous + annual capex
Volume: Enterprise tech investment portfolio (ERP, omnichannel, AI, renewable-tech, statutory)
Owner: FinOps Lead / CIO
Participants: PMO (VS-112), Finance/Capex (VS-40), sponsors, EA (VS-113), Innovation (VS-30)
Source: workflow W4099 — Technology Investment Portfolio &amp; Capex/Opex Planning</bpmn:documentation>
      <bpmn:laneSet id="W4099_LaneSet2">
        <bpmn:lane id="W4099_Lane1" name="FinOps Lead">
        <bpmn:flowNodeRef>W4099_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4099_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4099_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4099_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4099_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4099_Start3" name="Investment intake; capex cycle">
        <bpmn:outgoing>W4099_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4099_Task4" name="FinOps Lead/CIO maintain the technology investment portfolio, classify capex vs…">
        <bpmn:documentation>Step 1: FinOps Lead/CIO maintain the technology investment portfolio, classify capex vs opex (links to VS-40 capex accounting), and align to the corporate capex envelope and strategy (VS-33)
Responsible (R): FinOps Lead / Capex / PMO
Accountable (A): CIO / CFO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4099_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4099_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4099_Task5" name="FinOps Lead/EA ensure investments are architecture-aligned (VS-113)…">
        <bpmn:documentation>Step 2: FinOps Lead/EA ensure investments are architecture-aligned (VS-113), de-duplicated, and sequenced with OCM (VS-134) and PMO (VS-112)
Responsible (R): FinOps Lead / EA / OCM
Accountable (A): CIO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4099_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4099_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4099_Task6" name="FinOps Lead track investment progress and benefit realization (W4113), and…">
        <bpmn:documentation>Step 3: FinOps Lead track investment progress and benefit realization (W4113), and report to the capex/investment committee and Board (VS-40/VS-36)
Responsible (R): FinOps Lead / Finance
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4099_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4099_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4099_End7" name="Complete">
        <bpmn:incoming>W4099_Flow13</bpmn:incoming>
      </bpmn:endEvent>
