      <bpmn:startEvent id="W4103_Start3" name="Annual portfolio review; redundancy/duplication; high run-cost">
        <bpmn:outgoing>W4103_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4103_Task4" name="EA/IT Finance assess the application portfolio (business value, technical fit…">
        <bpmn:documentation>Step 1: EA/IT Finance assess the application portfolio (business value, technical fit, run-cost, usage, redundancy, risk) using TIME (Tolerate/Invest/Migrate/Eliminate) framing
Responsible (R): EA / FinOps Lead / ITAM
Accountable (A): CIO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4103_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4103_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4103_Task5" name="EA/IT Finance identify rationalization actions (consolidate, retire, replace…">
        <bpmn:documentation>Step 2: EA/IT Finance identify rationalization actions (consolidate, retire, replace, renegotiate), build the business case (W4100), and sequence with OCM (VS-134)
Responsible (R): EA / FinOps Lead / OCM
Accountable (A): CIO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4103_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4103_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4103_Task6" name="EA/IT Finance execute retire/consolidate, capture run-cost savings (W4113), and…">
        <bpmn:documentation>Step 3: EA/IT Finance execute retire/consolidate, capture run-cost savings (W4113), and update the architecture (VS-113) and ITAM (VS-99)
Responsible (R): EA / IT / ITAM
Accountable (A): CIO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4103_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4103_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4103_End7" name="Complete">
        <bpmn:incoming>W4103_Flow13</bpmn:incoming>
      </bpmn:endEvent>
