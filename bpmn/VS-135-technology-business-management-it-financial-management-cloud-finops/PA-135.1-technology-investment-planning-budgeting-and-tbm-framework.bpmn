    <bpmn:process id="W_W4103" name="W4103. Application Portfolio Rationalization &amp; Run-Cost Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Annual portfolio review; redundancy/duplication; high run-cost
Frequency: Annual + on trigger
Volume: Enterprise application portfolio (ERP core + ~10+ integrations + perimeter apps)
Owner: FinOps Lead / Enterprise Architect (VS-113)
Participants: EA (VS-113), IT (VS-27), ITAM (VS-99), business owners, OpEx (VS-133)
Source: workflow W4103 — Application Portfolio Rationalization &amp; Run-Cost Analysis</bpmn:documentation>
      <bpmn:laneSet id="W4103_LaneSet2">
        <bpmn:lane id="W4103_Lane1" name="EA">
        <bpmn:flowNodeRef>W4103_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4103_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4103_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4103_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4103_End7</bpmn:flowNodeRef>
