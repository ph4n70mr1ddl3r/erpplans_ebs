<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-41.3-private-label-brand-marketing" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1846" name="W1846. Private Label Brand Identity Development &amp; Guideline Management" isExecutable="false">
      <bpmn:documentation>Trigger: Initial private label strategy approval (W1830); periodic brand refresh (every 3–5 years)
Frequency: One-time initial development; periodic refresh
Volume: 2 brand tiers: &quot;BuildRight Essentials&quot; (economy) and &quot;BuildRight Pro&quot; (professional grade)
Owner: CMO
Participants: CMO, VP Merchandising, Category Manager, Brand Designer (external agency or in-house)
Source: workflow W1846 — Private Label Brand Identity Development &amp; Guideline Management</bpmn:documentation>
      <bpmn:laneSet id="W1846_LaneSet3">
        <bpmn:lane id="W1846_Lane1" name="CMO">
        <bpmn:flowNodeRef>W1846_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1846_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1846_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1846_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1846_Lane2" name="Brand Designer">
        <bpmn:flowNodeRef>W1846_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1846_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1846_Start4" name="Initial private label strategy approval (W1830); periodic brand refresh (every 3–5 years)">
        <bpmn:outgoing>W1846_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1846_Task5" name="CMO and VP Merchandising define brand architecture: (a) &quot;BuildRight…">
        <bpmn:documentation>Step 1: CMO and VP Merchandising define brand architecture: (a) &quot;BuildRight Essentials&quot;: positioned as quality-equivalent to national brands at 15–25% lower price; target customer: value-conscious DIYer and homeowner; visual identity: clean, practical, trustworthy — color palette: blue and white with orange accent, (b) &quot;BuildRight Pro&quot;: positioned as professional-grade quality at competitive pricing; target customer: contractors, builders, electricians, plumbers; visual identity: robust, technical, premium — color palette: black and gold with blue accent, (c) brand positioning statements, brand personality traits, and tone of voice for packaging and marketing communications
Responsible (R): CMO
Accountable (A): CEO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1846_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1846_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1846_Task6" name="Brand Designer develops comprehensive brand guidelines document: (a) logo…">
        <bpmn:documentation>Step 2: Brand Designer develops comprehensive brand guidelines document: (a) logo design for each brand tier: primary, secondary, monochrome versions, minimum size requirements, clear space rules, (b) color palette: primary, secondary, and accent colors with Pantone, CMYK, RGB, and HEX specifications, (c) typography: primary and secondary typefaces for packaging, signage, and digital, (d) packaging design templates: layout grids for each package type (blister card, box, bag, label, hang tag), (e) photography style: product photography guidelines (lighting, background, angle), (f) iconography: standard icons for product features (waterproof, heavy-duty, ergonomic, etc.), (g) regulatory label placement: standardized position for required Philippine labeling elements (SRP, manufacturing details, safety warnings)
Responsible (R): Brand Designer
Accountable (A): CMO
Duration: 4–6 weeks</bpmn:documentation>
        <bpmn:incoming>W1846_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1846_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1846_Task7" name="CMO and VP Merchandising review and approve brand guidelines; Legal Counsel…">
        <bpmn:documentation>Step 3: CMO and VP Merchandising review and approve brand guidelines; Legal Counsel reviews for trademark registrability and conflict with existing brands in the Philippine market; upon approval: distribute to all stakeholders (Buyers, factories, packaging designers, Marketing team, store operations)
Responsible (R): CMO / Legal
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1846_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1846_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1846_Task8" name="Ongoing: CMO manages brand guideline updates: (a) annual review: are guidelines…">
        <bpmn:documentation>Step 4: Ongoing: CMO manages brand guideline updates: (a) annual review: are guidelines current and being followed? collect feedback from Buyers (factory compliance issues) and stores (customer perception), (b) periodic refresh (every 3–5 years): update visual identity if brand perception has shifted or competitive landscape requires differentiation update, (c) brand guideline version control: all stakeholders notified of updates; outdated templates removed from circulation
Responsible (R): CMO
Accountable (A): CEO
Duration: 1–2 days/year</bpmn:documentation>
        <bpmn:incoming>W1846_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1846_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1846_End9" name="Complete">
        <bpmn:incoming>W1846_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1846_Annotation10">
        <bpmn:text>Controls: - CTL-366 (ensure controlled execution — Private Label Brand, Packaging &amp; Marketing (PA-41.3).) | - operational: CMO review and approval gate
Owner: CMO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1846_Assoc11" sourceRef="W1846_Annotation10" targetRef="W1846_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1846_Flow12" sourceRef="W1846_Start4" targetRef="W1846_Task5" />
      <bpmn:sequenceFlow id="W1846_Flow13" sourceRef="W1846_Task5" targetRef="W1846_Task6" />
      <bpmn:sequenceFlow id="W1846_Flow14" sourceRef="W1846_Task6" targetRef="W1846_Task7" />
      <bpmn:sequenceFlow id="W1846_Flow15" sourceRef="W1846_Task7" targetRef="W1846_Task8" />
      <bpmn:sequenceFlow id="W1846_Flow16" sourceRef="W1846_Task8" targetRef="W1846_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1846_diag">
      <bpmndi:BPMNPlane id="W1846_plane" bpmnElement="W_W1846">
        <bpmndi:BPMNShape id="W1846_Lane1_di" bpmnElement="W1846_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
