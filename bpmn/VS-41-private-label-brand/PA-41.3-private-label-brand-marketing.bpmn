        <bpmndi:BPMNEdge id="W1846_Flow13_di" bpmnElement="W1846_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1846_Flow14_di" bpmnElement="W1846_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1846_Flow15_di" bpmnElement="W1846_Flow15"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1846_Flow16_di" bpmnElement="W1846_Flow16"><di:waypoint x="1210" y="165" /><di:waypoint x="1260" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1846_Assoc11_di" bpmnElement="W1846_Assoc11"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1847" name="W1847. Private Label Packaging Design, Artwork Approval &amp; Production" isExecutable="false">
      <bpmn:documentation>Trigger: New SKU launch (W1832); packaging redesign; regulatory labeling change
Frequency: ~20–30 new SKU packaging designs/year; ~5–10 redesigns/year
Volume: 1 artwork per SKU per package type
Owner: Category Manager
Participants: Category Manager, Packaging Designer, QA Manager, Legal Counsel, Buyer (factory coordination)
Source: workflow W1847 — Private Label Packaging Design, Artwork Approval &amp; Production</bpmn:documentation>
      <bpmn:laneSet id="W1847_LaneSet4">
        <bpmn:lane id="W1847_Lane1" name="Packaging Designer">
        <bpmn:flowNodeRef>W1847_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1847_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1847_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1847_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W1847_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1847_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1847_Lane3" name="Buyer">
        <bpmn:flowNodeRef>W1847_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1847_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1847_Start5" name="New SKU launch (W1832); packaging redesign; regulatory labeling change">
        <bpmn:outgoing>W1847_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1847_Task6" name="Packaging Designer creates artwork per brand guidelines (W1846): (a) select…">
        <bpmn:documentation>Step 1: Packaging Designer creates artwork per brand guidelines (W1846): (a) select correct template per brand tier and package type, (b) input product-specific content: product name, size, quantity, material, usage instructions, safety warnings, (c) generate barcode (EAN-13 or UPC-A) per GS1 standards, (d) include regulatory marks: BPS/ICC mark (if required), FDA notification number (if required), &quot;Made in [Country of Origin]&quot;, (e) bilingual labeling: English and Filipino per DTI requirement, (f) submit artwork proof to Category Manager
Responsible (R): Packaging Designer
Accountable (A): Category Manager
Duration: 2–4 hours/SKU</bpmn:documentation>
        <bpmn:incoming>W1847_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1847_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1847_Task7" name="Approval workflow: (a) Category Manager reviews: product information accuracy…">
        <bpmn:documentation>Step 2: Approval workflow: (a) Category Manager reviews: product information accuracy, pricing display, shelf appeal, competitive differentiation, (b) QA Manager reviews: regulatory labeling compliance, safety warning completeness, barcode scannability, (c) Legal Counsel reviews: trademark usage, claim substantiation (e.g., &quot;heavy duty&quot; must be defensible), Consumer Act compliance, (d) if any reviewer requests changes: Packaging Designer revises and resubmits; maximum 2 revision rounds
Responsible (R): Category Manager / QA Manager / Legal
Accountable (A): VP Merchandising
Duration: 2–5 days</bpmn:documentation>
        <bpmn:incoming>W1847_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1847_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1847_Task8" name="Buyer transmits approved artwork to factory: (a) send print-ready files in…">
        <bpmn:documentation>Step 3: Buyer transmits approved artwork to factory: (a) send print-ready files in factory&#x27;s required format (PDF/X, AI, or PSD), (b) specify print substrate (cardboard, plastic, label stock), print method (offset, flexo, digital), and finish (matte, gloss, UV), (c) factory produces packaging proof (digital or physical) for final BuildRight approval before mass production
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1847_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1847_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1847_Task9" name="Category Manager approves packaging proof: (a) verify color accuracy against…">
        <bpmn:documentation>Step 4: Category Manager approves packaging proof: (a) verify color accuracy against brand guidelines, (b) verify text legibility at actual package size, (c) verify barcode scans correctly at actual print quality, (d) if approved: authorize factory to proceed with mass production, (e) if not approved: request corrections and repeat proof cycle
Responsible (R): Category Manager
Accountable (A): —
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W1847_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1847_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1847_Task10" name="Packaging artwork archived in system: (a) final artwork file stored in digital…">
        <bpmn:documentation>Step 5: Packaging artwork archived in system: (a) final artwork file stored in digital asset master (W316) linked to SKU, (b) version history maintained for traceability, (c) artwork reusable for reorders unless product specification or regulatory requirements change
Responsible (R): Packaging Designer
Accountable (A): Category Manager
Duration: 15 min/SKU</bpmn:documentation>
        <bpmn:incoming>W1847_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1847_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1847_End11" name="Complete">
        <bpmn:incoming>W1847_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1847_Annotation12">
        <bpmn:text>Controls: - CTL-366 (ensure controlled execution — Private Label Brand, Packaging &amp; Marketing (PA-41.3).) | - operational: Category Manager review and approval gate
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1847_Assoc13" sourceRef="W1847_Annotation12" targetRef="W1847_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1847_Flow14" sourceRef="W1847_Start5" targetRef="W1847_Task6" />
      <bpmn:sequenceFlow id="W1847_Flow15" sourceRef="W1847_Task6" targetRef="W1847_Task7" />
      <bpmn:sequenceFlow id="W1847_Flow16" sourceRef="W1847_Task7" targetRef="W1847_Task8" />
      <bpmn:sequenceFlow id="W1847_Flow17" sourceRef="W1847_Task8" targetRef="W1847_Task9" />
      <bpmn:sequenceFlow id="W1847_Flow18" sourceRef="W1847_Task9" targetRef="W1847_Task10" />
      <bpmn:sequenceFlow id="W1847_Flow19" sourceRef="W1847_Task10" targetRef="W1847_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1847_diag">
      <bpmndi:BPMNPlane id="W1847_plane" bpmnElement="W_W1847">
        <bpmndi:BPMNShape id="W1847_Lane1_di" bpmnElement="W1847_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1847_Lane2_di" bpmnElement="W1847_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1847_Lane3_di" bpmnElement="W1847_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1370" height="170" /></bpmndi:BPMNShape>
