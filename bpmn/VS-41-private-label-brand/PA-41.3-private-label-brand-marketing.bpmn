        <bpmndi:BPMNShape id="W1847_Annotation12_di" bpmnElement="W1847_Annotation12"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1847_Flow14_di" bpmnElement="W1847_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1847_Flow15_di" bpmnElement="W1847_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1847_Flow16_di" bpmnElement="W1847_Flow16"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1847_Flow17_di" bpmnElement="W1847_Flow17"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1847_Flow18_di" bpmnElement="W1847_Flow18"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1847_Flow19_di" bpmnElement="W1847_Flow19"><di:waypoint x="1420" y="165" /><di:waypoint x="1470" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1847_Assoc13_di" bpmnElement="W1847_Assoc13"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1848" name="W1848. Private Label In-Store Display, Planogram &amp; Merchandising Standards" isExecutable="false">
      <bpmn:documentation>Trigger: New private label category launch; annual planogram refresh; store reset
Frequency: Per category launch (~2–4/year); annual planogram refresh
Volume: New category launches require planogram updates across 200 stores
Owner: Store Operations Coordinator
Participants: Store Operations Coordinator, Category Manager, Marketing, Store Managers
Source: workflow W1848 — Private Label In-Store Display, Planogram &amp; Merchandising Standards</bpmn:documentation>
      <bpmn:laneSet id="W1848_LaneSet4">
        <bpmn:lane id="W1848_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W1848_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1848_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1848_Lane2" name="Store Operations Coordinator">
        <bpmn:flowNodeRef>W1848_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1848_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1848_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W1848_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1848_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1848_Start5" name="New private label category launch; annual planogram refresh; store reset">
        <bpmn:outgoing>W1848_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1848_Task6" name="Category Manager defines planogram placement strategy for private label: (a)…">
        <bpmn:documentation>Step 1: Category Manager defines planogram placement strategy for private label: (a) shelf placement: private label products positioned adjacent to national brand equivalents (not isolated in separate section) — encourages comparison and substitution, (b) eye-level placement for high-volume private label SKUs (fasteners, hand tools), (c) &quot;Better Value&quot; shelf talkers highlighting price differential vs. national brand, (d) cross-merchandising: private label adhesives displayed near lumber; private label paint rollers near paint station, (e) &quot;BuildRight Recommends&quot; endcap displays for new private label launches (2–4 week rotation)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1848_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1848_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1848_Task7" name="Store Operations Coordinator develops planogram specifications: (a) shelf…">
        <bpmn:documentation>Step 2: Store Operations Coordinator develops planogram specifications: (a) shelf allocation: linear footage per private label SKU per store cluster (based on store size and local demand), (b) display fixture requirements: peg hooks for blister-packed items, shelf dividers for boxed items, bin displays for bulk fasteners, (c) signage and POS materials: price tags, shelf talkers, category headers, endcap signage, (d) distribute planogram and merchandising guide to all 200 stores
Responsible (R): Store Operations Coordinator
Accountable (A): VP Store Operations
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1848_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1848_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1848_Task8" name="Store Merchandising execution: (a) each store implements planogram per guide…">
        <bpmn:documentation>Step 3: Store Merchandising execution: (a) each store implements planogram per guide during next scheduled reset (W1407 — seasonal department reset), (b) Department Supervisors oversee execution, (c) Store Manager verifies compliance and submits photo evidence through store manager app
Responsible (R): Store Manager / Department Supervisor
Accountable (A): Store Operations Coordinator
Duration: 1 day/store</bpmn:documentation>
        <bpmn:incoming>W1848_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1848_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1848_Task9" name="Store Operations Coordinator conducts planogram compliance audit: (a) monthly…">
        <bpmn:documentation>Step 4: Store Operations Coordinator conducts planogram compliance audit: (a) monthly: review photo evidence from stores; flag non-compliant stores for corrective action, (b) quarterly: in-person planogram audit at 10–15 randomly selected stores, (c) compliance rate target: ≥ 90% of stores adhering to planogram specifications
Responsible (R): Store Operations Coordinator
Accountable (A): VP Store Operations
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1848_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1848_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1848_End10" name="Complete">
        <bpmn:incoming>W1848_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1848_Annotation11">
        <bpmn:text>Controls: - CTL-366 (ensure controlled execution — Private Label Brand, Packaging &amp; Marketing (PA-41.3).) | - operational: Store Operations Coordinator review and approval gate
Owner: Store Operations Coordinator</bpmn:text>
      </bpmn:textAnnotation>
