    <bpmn:process id="W_W3176" name="W3176. Lease Buyout, Early Termination &amp; Renewal" isExecutable="false">
      <bpmn:documentation>Trigger: Customer elects buy-out, early termination, or renewal
Frequency: Per lease at customer election
Volume: Subset of leases
Owner: Lease Operations Manager
Participants: Lease Operations Mgr, Finance, Legal, Customer
Source: workflow W3176 — Lease Buyout, Early Termination &amp; Renewal</bpmn:documentation>
      <bpmn:laneSet id="W3176_LaneSet4">
        <bpmn:lane id="W3176_Lane1" name="Lease Operations Mgr">
        <bpmn:flowNodeRef>W3176_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3176_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3176_Lane2" name="Finance">
        <bpmn:flowNodeRef>W3176_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3176_Lane3" name="Lease Origination Mgr">
        <bpmn:flowNodeRef>W3176_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3176_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3176_Start5" name="Customer elects buy-out, early termination, or renewal">
        <bpmn:outgoing>W3176_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3176_Task6" name="Lease Operations Mgr compute early-termination / buy-out quote per contract…">
        <bpmn:documentation>Step 1: Lease Operations Mgr compute early-termination / buy-out quote per contract formula (typically: PV of remaining rentals + residual − unearned income − early-termination fee); communicate to customer with Truth-in-Lending-style disclosure
Responsible (R): Lease Operations Mgr / Finance
Accountable (A): Lease Operations Manager
Duration: Per request</bpmn:documentation>
        <bpmn:incoming>W3176_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3176_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3176_Task7" name="On customer acceptance: Finance process buy-out payment; transfer asset title…">
        <bpmn:documentation>Step 2: On customer acceptance: Finance process buy-out payment; transfer asset title to customer (release the chattel-mortgage registration / RA 11057 notation — W3168); book lease termination and gain/loss (links to VS-17)
Responsible (R): Finance / Legal
Accountable (A): Controller
Duration: Per deal</bpmn:documentation>
        <bpmn:incoming>W3176_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3176_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3176_Task8" name="For renewal: Lease Origination Mgr originate new/renewed lease per current…">
        <bpmn:documentation>Step 3: For renewal: Lease Origination Mgr originate new/renewed lease per current rates (W3162) and credit (W3163); book new lease (W3169) and close prior lease; or convert to month-to-month per contract
Responsible (R): Lease Origination Mgr / Lease Operations Mgr
Accountable (A): CFO
Duration: Per deal</bpmn:documentation>
        <bpmn:incoming>W3176_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3176_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3176_End9" name="Complete">
        <bpmn:incoming>W3176_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3176_Annotation10">
        <bpmn:text>Controls: - CTL-105 (prevent unauthorized lease credit extension.) | - operational: actuarially-sound formula and periodic recalibration
Owner: Lease Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3176_Assoc11" sourceRef="W3176_Annotation10" targetRef="W3176_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3176_Flow12" sourceRef="W3176_Start5" targetRef="W3176_Task6" />
      <bpmn:sequenceFlow id="W3176_Flow13" sourceRef="W3176_Task6" targetRef="W3176_Task7" />
      <bpmn:sequenceFlow id="W3176_Flow14" sourceRef="W3176_Task7" targetRef="W3176_Task8" />
      <bpmn:sequenceFlow id="W3176_Flow15" sourceRef="W3176_Task8" targetRef="W3176_End9" />
    </bpmn:process>
