<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-96.2-lease-booking-billing-asset-lifecycle" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3169" name="W3169. Lease Booking, Asset Capitalization &amp; Start-Day Setup" isExecutable="false">
      <bpmn:documentation>Trigger: Origination complete (W3168)
Frequency: Per lease deal
Volume: Per lease deal
Owner: Lease Operations Manager
Participants: Lease Operations Mgr, Finance, IT, Treasury (links to VS-18)
Source: workflow W3169 — Lease Booking, Asset Capitalization &amp; Start-Day Setup</bpmn:documentation>
      <bpmn:laneSet id="W3169_LaneSet4">
        <bpmn:lane id="W3169_Lane1" name="Lease Operations Mgr">
        <bpmn:flowNodeRef>W3169_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3169_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3169_Lane2" name="Finance Analyst">
        <bpmn:flowNodeRef>W3169_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3169_Lane3" name="Treasury Analyst">
        <bpmn:flowNodeRef>W3169_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3169_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3169_Start5" name="Origination complete (W3168)">
        <bpmn:outgoing>W3169_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3169_Task6" name="Lease Operations Mgr book lease in Lease &amp; Finance Management (OKL): contract…">
        <bpmn:documentation>Step 1: Lease Operations Mgr book lease in Lease &amp; Finance Management (OKL): contract terms, payment schedule, asset record (serial, location, customer), residual, end-of-term option, lessor (W3165), funding source; generate lease ID
Responsible (R): Lease Operations Mgr / IT
Accountable (A): Lease Operations Manager
Duration: Per deal</bpmn:documentation>
        <bpmn:incoming>W3169_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3169_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3169_Task7" name="Finance capitalize asset / record lease receivable per lease type (operating…">
        <bpmn:documentation>Step 2: Finance capitalize asset / record lease receivable per lease type (operating vs. finance lease per PFRS 16, which superseded PAS 17 — links to VS-17); post advance rental receipt and initial direct cost; reconcile to GL
Responsible (R): Finance Analyst
Accountable (A): Controller
Duration: Per deal</bpmn:documentation>
        <bpmn:incoming>W3169_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3169_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3169_Task8" name="Treasury (links to VS-18) confirm funding draw (if lessor-funded) or BuildRight…">
        <bpmn:documentation>Step 3: Treasury (links to VS-18) confirm funding draw (if lessor-funded) or BuildRight warehouse line; disburse to vendor; activate billing schedule (links to W3170); confirm start day and first billing date
Responsible (R): Treasury Analyst
Accountable (A): CFO
Duration: Per deal</bpmn:documentation>
        <bpmn:incoming>W3169_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3169_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3169_End9" name="Complete">
        <bpmn:incoming>W3169_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3169_Annotation10">
        <bpmn:text>Controls: - CTL-518 (ensure controlled execution — Lease Booking, Billing &amp; Asset Lifecycle Management (PA-96.2).) | - operational: 4-eyes booking review
Owner: Lease Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3169_Assoc11" sourceRef="W3169_Annotation10" targetRef="W3169_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3169_Flow12" sourceRef="W3169_Start5" targetRef="W3169_Task6" />
      <bpmn:sequenceFlow id="W3169_Flow13" sourceRef="W3169_Task6" targetRef="W3169_Task7" />
      <bpmn:sequenceFlow id="W3169_Flow14" sourceRef="W3169_Task7" targetRef="W3169_Task8" />
      <bpmn:sequenceFlow id="W3169_Flow15" sourceRef="W3169_Task8" targetRef="W3169_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3169_diag">
      <bpmndi:BPMNPlane id="W3169_plane" bpmnElement="W_W3169">
        <bpmndi:BPMNShape id="W3169_Lane1_di" bpmnElement="W3169_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3169_Lane2_di" bpmnElement="W3169_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3169_Lane3_di" bpmnElement="W3169_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3169_Task6_di" bpmnElement="W3169_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3169_Task7_di" bpmnElement="W3169_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3169_Task8_di" bpmnElement="W3169_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3169_Start5_di" bpmnElement="W3169_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3169_End9_di" bpmnElement="W3169_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3169_Annotation10_di" bpmnElement="W3169_Annotation10"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3169_Flow12_di" bpmnElement="W3169_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3169_Flow13_di" bpmnElement="W3169_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3169_Flow14_di" bpmnElement="W3169_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3169_Flow15_di" bpmnElement="W3169_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3169_Assoc11_di" bpmnElement="W3169_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3170" name="W3170. Lease Billing Cycle, Auto-Debit &amp; AR Management" isExecutable="false">
      <bpmn:documentation>Trigger: Billing cycle (monthly)
Frequency: Monthly per active lease
Volume: All active leases (~hundreds to low-thousands)
Owner: Lease Operations Manager
Participants: Lease Operations Mgr, AR (links to VS-16), Finance, Treasury (links to VS-18)
Source: workflow W3170 — Lease Billing Cycle, Auto-Debit &amp; AR Management</bpmn:documentation>
      <bpmn:laneSet id="W3170_LaneSet3">
        <bpmn:lane id="W3170_Lane1" name="System">
        <bpmn:flowNodeRef>W3170_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3170_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3170_Lane2" name="AR Clerk">
        <bpmn:flowNodeRef>W3170_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3170_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3170_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3170_Start4" name="Billing cycle (monthly)">
        <bpmn:outgoing>W3170_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W3170_Task5" name="System generates monthly rental invoice per lease: rental amount, VAT (W3183)…">
        <bpmn:documentation>Step 1: System generates monthly rental invoice per lease: rental amount, VAT (W3183), other charges (insurance, maintenance if bundled); deliver to customer per preference (email, portal, e-invoice — links to VS-79)
Responsible (R): System / AR
Accountable (A): Lease Operations Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3170_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3170_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W3170_Task6" name="AR (links to VS-16) process collection: auto-debit (ADA) via customer-bank…">
        <bpmn:documentation>Step 2: AR (links to VS-16) process collection: auto-debit (ADA) via customer-bank mandate, online transfer, PDC (post-dated cheques) on file; apply cash; manage exceptions (failed debit, NSF cheque)
Responsible (R): AR Clerk
Accountable (A): Finance Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3170_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3170_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3170_Task7" name="AR monitor aging; flag past-due to delinquency workflow (W3174); reconcile…">
        <bpmn:documentation>Step 3: AR monitor aging; flag past-due to delinquency workflow (W3174); reconcile customer ledger; report portfolio billing metrics (on-time collection %, average days-past-due)
Responsible (R): AR Clerk / Finance
Accountable (A): Lease Operations Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3170_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3170_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3170_End8" name="Complete">
        <bpmn:incoming>W3170_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3170_Annotation9">
        <bpmn:text>Controls: - CTL-518 (ensure controlled execution — Lease Booking, Billing &amp; Asset Lifecycle Management (PA-96.2).) | - operational: PDC back-up and proactive outreach
Owner: Lease Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3170_Assoc10" sourceRef="W3170_Annotation9" targetRef="W3170_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3170_Flow11" sourceRef="W3170_Start4" targetRef="W3170_Task5" />
      <bpmn:sequenceFlow id="W3170_Flow12" sourceRef="W3170_Task5" targetRef="W3170_Task6" />
      <bpmn:sequenceFlow id="W3170_Flow13" sourceRef="W3170_Task6" targetRef="W3170_Task7" />
      <bpmn:sequenceFlow id="W3170_Flow14" sourceRef="W3170_Task7" targetRef="W3170_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3170_diag">
      <bpmndi:BPMNPlane id="W3170_plane" bpmnElement="W_W3170">
        <bpmndi:BPMNShape id="W3170_Lane1_di" bpmnElement="W3170_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3170_Lane2_di" bpmnElement="W3170_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3170_Task5_di" bpmnElement="W3170_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3170_Task6_di" bpmnElement="W3170_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3170_Task7_di" bpmnElement="W3170_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3170_Start4_di" bpmnElement="W3170_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3170_End8_di" bpmnElement="W3170_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3170_Annotation9_di" bpmnElement="W3170_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3170_Flow11_di" bpmnElement="W3170_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3170_Flow12_di" bpmnElement="W3170_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3170_Flow13_di" bpmnElement="W3170_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3170_Flow14_di" bpmnElement="W3170_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3170_Assoc10_di" bpmnElement="W3170_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3171" name="W3171. Lease Asset Tracking, Maintenance &amp; Inspection" isExecutable="false">
      <bpmn:documentation>Trigger: Lease term; periodic inspection; maintenance schedule
Frequency: Per schedule + event-driven
Volume: All leased assets
Owner: Lease Operations Manager
Participants: Lease Operations Mgr, Field Service (links to VS-12), Quality, Customer, Insurance (links to VS-26)
Source: workflow W3171 — Lease Asset Tracking, Maintenance &amp; Inspection</bpmn:documentation>
      <bpmn:laneSet id="W3171_LaneSet3">
        <bpmn:lane id="W3171_Lane1" name="Lease Operations Mgr">
        <bpmn:flowNodeRef>W3171_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3171_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3171_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3171_Lane2" name="Field Service">
        <bpmn:flowNodeRef>W3171_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3171_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3171_Start4" name="Lease term; periodic inspection; maintenance schedule">
        <bpmn:outgoing>W3171_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3171_Task5" name="Lease Operations Mgr maintain asset record: location, condition, hours/usage…">
        <bpmn:documentation>Step 1: Lease Operations Mgr maintain asset record: location, condition, hours/usage (where telematics available), maintenance history, serial; track moves between sites with customer notification
Responsible (R): Lease Operations Mgr / IT
Accountable (A): Lease Operations Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3171_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3171_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3171_Task6" name="Field Service (links to VS-12) / Vendor perform scheduled maintenance per…">
        <bpmn:documentation>Step 2: Field Service (links to VS-12) / Vendor perform scheduled maintenance per contract (BuildRight-managed or customer-managed); capture service records; for solar/storage (links to VS-70), leverage remote monitoring (W2542-style)
Responsible (R): Field Service / Vendor
Accountable (A): Lease Operations Manager
Duration: Per schedule</bpmn:documentation>
        <bpmn:incoming>W3171_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3171_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3171_Task7" name="Lease Operations Mgr conduct periodic inspection (annual or per contract)…">
        <bpmn:documentation>Step 3: Lease Operations Mgr conduct periodic inspection (annual or per contract): asset condition, misuse, unauthorized modification, insurance compliance; document with photos; flag issues for remediation (W3172) or default path (W3174)
Responsible (R): Lease Operations Mgr / Inspector
Accountable (A): Lease Operations Manager
Duration: Annual per lease</bpmn:documentation>
        <bpmn:incoming>W3171_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3171_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3171_End8" name="Complete">
        <bpmn:incoming>W3171_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3171_Annotation9">
        <bpmn:text>Controls: - CTL-105 (prevent unauthorized lease credit extension.) | - operational: inspection and maintenance contract
Owner: Lease Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3171_Assoc10" sourceRef="W3171_Annotation9" targetRef="W3171_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3171_Flow11" sourceRef="W3171_Start4" targetRef="W3171_Task5" />
      <bpmn:sequenceFlow id="W3171_Flow12" sourceRef="W3171_Task5" targetRef="W3171_Task6" />
      <bpmn:sequenceFlow id="W3171_Flow13" sourceRef="W3171_Task6" targetRef="W3171_Task7" />
      <bpmn:sequenceFlow id="W3171_Flow14" sourceRef="W3171_Task7" targetRef="W3171_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3171_diag">
      <bpmndi:BPMNPlane id="W3171_plane" bpmnElement="W_W3171">
        <bpmndi:BPMNShape id="W3171_Lane1_di" bpmnElement="W3171_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3171_Lane2_di" bpmnElement="W3171_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3171_Task5_di" bpmnElement="W3171_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3171_Task6_di" bpmnElement="W3171_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3171_Task7_di" bpmnElement="W3171_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3171_Start4_di" bpmnElement="W3171_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3171_End8_di" bpmnElement="W3171_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3171_Annotation9_di" bpmnElement="W3171_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3171_Flow11_di" bpmnElement="W3171_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3171_Flow12_di" bpmnElement="W3171_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3171_Flow13_di" bpmnElement="W3171_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3171_Flow14_di" bpmnElement="W3171_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3171_Assoc10_di" bpmnElement="W3171_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3172" name="W3172. Lease Mid-Term Modification, Upgrade &amp; Add-On" isExecutable="false">
      <bpmn:documentation>Trigger: Customer request; technology refresh; contract amendment
Frequency: Event-driven
Volume: Subset of active leases
Owner: Lease Origination Manager
Participants: Lease Origination Mgr, Lease Operations Mgr, Finance, Legal, Customer
Source: workflow W3172 — Lease Mid-Term Modification, Upgrade &amp; Add-On</bpmn:documentation>
      <bpmn:laneSet id="W3172_LaneSet4">
        <bpmn:lane id="W3172_Lane1" name="Lease Origination Mgr">
        <bpmn:flowNodeRef>W3172_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3172_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3172_Lane2" name="Finance">
        <bpmn:flowNodeRef>W3172_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3172_Lane3" name="Lease Operations Mgr">
        <bpmn:flowNodeRef>W3172_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3172_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3172_Start5" name="Customer request; technology refresh; contract amendment">
        <bpmn:outgoing>W3172_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3172_Task6" name="Lease Origination Mgr assess modification request: upgrade (new asset swap)…">
        <bpmn:documentation>Step 1: Lease Origination Mgr assess modification request: upgrade (new asset swap), add-on (additional asset under same contract), term extension, re-pricing; validate credit impact (links to W3163) and residual impact (links to W3162)
Responsible (R): Lease Origination Mgr
Accountable (A): Lease Origination Manager
Duration: Per request</bpmn:documentation>
        <bpmn:incoming>W3172_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3172_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3172_Task7" name="Finance/Lease Origination re-price: new payment schedule, residual adjustment…">
        <bpmn:documentation>Step 2: Finance/Lease Origination re-price: new payment schedule, residual adjustment, fees, taxes; Lease Credit Mgr re-approve if exposure increase; Legal execute amendment
Responsible (R): Finance / Legal / Credit
Accountable (A): CFO
Duration: Per request</bpmn:documentation>
        <bpmn:incoming>W3172_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3172_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3172_Task8" name="Lease Operations Mgr book modification: update schedule, asset record…">
        <bpmn:documentation>Step 3: Lease Operations Mgr book modification: update schedule, asset record (swap-in/out — links to W3175 for returned asset); communicate new terms; archive amendment
Responsible (R): Lease Operations Mgr / IT
Accountable (A): Lease Operations Manager
Duration: Per request</bpmn:documentation>
        <bpmn:incoming>W3172_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3172_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3172_End9" name="Complete">
        <bpmn:incoming>W3172_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3172_Annotation10">
        <bpmn:text>Controls: - CTL-518 (ensure controlled execution — Lease Booking, Billing &amp; Asset Lifecycle Management (PA-96.2).) | - operational: 4-eyes review and audit trail
Owner: Lease Origination Manager</bpmn:text>
      </bpmn:textAnnotation>
