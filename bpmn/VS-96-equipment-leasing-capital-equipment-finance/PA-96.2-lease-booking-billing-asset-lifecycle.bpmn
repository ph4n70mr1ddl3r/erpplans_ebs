      <bpmn:sequenceFlow id="W3175_Flow13" sourceRef="W3175_Task6" targetRef="W3175_Task7" />
      <bpmn:sequenceFlow id="W3175_Flow14" sourceRef="W3175_Task7" targetRef="W3175_End8" />
    </bpmn:process>
