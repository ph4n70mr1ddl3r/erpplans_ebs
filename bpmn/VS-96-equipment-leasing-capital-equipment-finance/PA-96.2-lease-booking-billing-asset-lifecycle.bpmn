    <bpmn:process id="W_W3173" name="W3173. Lease Insurance, Loss &amp; Damage Management" isExecutable="false">
      <bpmn:documentation>Trigger: Asset damage, theft, total loss
Frequency: Event-driven
Volume: Subset of leases
Owner: Lease Operations Manager
Participants: Lease Operations Mgr, Insurance (links to VS-26), Customer, Legal, Finance
Source: workflow W3173 — Lease Insurance, Loss &amp; Damage Management</bpmn:documentation>
      <bpmn:laneSet id="W3173_LaneSet4">
        <bpmn:lane id="W3173_Lane1" name="Lease Operations Mgr">
        <bpmn:flowNodeRef>W3173_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3173_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3173_Lane2" name="Insurance Coordinator">
        <bpmn:flowNodeRef>W3173_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3173_Lane3" name="Finance">
        <bpmn:flowNodeRef>W3173_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3173_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3173_Start5" name="Asset damage, theft, total loss">
        <bpmn:outgoing>W3173_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3173_Task6" name="Customer reports damage/theft; Lease Operations Mgr capture incident with…">
        <bpmn:documentation>Step 1: Customer reports damage/theft; Lease Operations Mgr capture incident with evidence (photos, police report for theft); confirm coverage per insurance policy (W3168)
Responsible (R): Lease Operations Mgr / Customer
Accountable (A): Lease Operations Manager
Duration: Per incident (&lt;48 hr)</bpmn:documentation>
        <bpmn:incoming>W3173_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3173_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3173_Task7" name="Insurance Coordinator (links to VS-26) file claim with insurer; coordinate…">
        <bpmn:documentation>Step 2: Insurance Coordinator (links to VS-26) file claim with insurer; coordinate adjuster inspection; obtain repair/replacement authorization; manage deductible (customer or BuildRight per contract)
Responsible (R): Insurance Coordinator
Accountable (A): CFO
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W3173_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3173_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3173_Task8" name="On settlement: Finance reconcile insurer payout, customer liability…">
        <bpmn:documentation>Step 3: On settlement: Finance reconcile insurer payout, customer liability (deductible, uninsured loss), and lease balance; repair or replace asset (links to W3172) or settle lease (links to W3176); update asset/insurance records
Responsible (R): Finance / Lease Operations Mgr
Accountable (A): Controller
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W3173_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3173_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3173_End9" name="Complete">
        <bpmn:incoming>W3173_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3173_Annotation10">
        <bpmn:text>Controls: - CTL-518 (ensure controlled execution — Lease Booking, Billing &amp; Asset Lifecycle Management (PA-96.2).) | - operational: mandatory insurance verification (W3168) and annual check (W3171)
Owner: Lease Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
