    <bpmn:process id="W_W3175" name="W3175. Lease Maturity, Return Inspection &amp; Disposition" isExecutable="false">
      <bpmn:documentation>Trigger: Lease end-of-term with return option exercised
Frequency: Per maturing lease
Volume: Per lease
Owner: Lease Operations Manager
Participants: Lease Operations Mgr, Inspector, Quality, Customer, Inventory (links to VS-05)
Source: workflow W3175 — Lease Maturity, Return Inspection &amp; Disposition</bpmn:documentation>
      <bpmn:laneSet id="W3175_LaneSet3">
        <bpmn:lane id="W3175_Lane1" name="Lease Operations Mgr">
        <bpmn:flowNodeRef>W3175_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3175_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3175_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3175_Lane2" name="Inspector">
        <bpmn:flowNodeRef>W3175_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3175_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3175_Start4" name="Lease end-of-term with return option exercised">
        <bpmn:outgoing>W3175_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3175_Task5" name="Pre-maturity (90 days): Lease Operations Mgr contact customer re: end-of-term…">
        <bpmn:documentation>Step 1: Pre-maturity (90 days): Lease Operations Mgr contact customer re: end-of-term options (return/renew/buy-out — W3176); provide return logistics guidance if returning
Responsible (R): Lease Operations Mgr
Accountable (A): Lease Operations Manager
Duration: 90 days pre-maturity</bpmn:documentation>
        <bpmn:incoming>W3175_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3175_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3175_Task6" name="On return: Inspector assess asset vs. end-of-lease condition standard (links to…">
        <bpmn:documentation>Step 2: On return: Inspector assess asset vs. end-of-lease condition standard (links to W3162 residual); identify excess wear/damage; compute customer charge for excess (per contract); document with photos
Responsible (R): Inspector / Quality
Accountable (A): Lease Operations Manager
Duration: Per return</bpmn:documentation>
        <bpmn:incoming>W3175_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3175_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3175_Task7" name="Disposition returned asset: remarket via used-equipment channel (W3179)…">
        <bpmn:documentation>Step 3: Disposition returned asset: remarket via used-equipment channel (W3179), refurbish (links to VS-09), redeploy to new lease, or scrap (links to VS-73/VS-35); reconcile to residual and post gain/loss (links to VS-17)
Responsible (R): Lease Operations Mgr / Inventory / Finance
Accountable (A): Lease Operations Manager
Duration: Per return</bpmn:documentation>
        <bpmn:incoming>W3175_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3175_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3175_End8" name="Complete">
        <bpmn:incoming>W3175_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3175_Annotation9">
        <bpmn:text>Controls: - CTL-518 (ensure controlled execution — Lease Booking, Billing &amp; Asset Lifecycle Management (PA-96.2).) | - operational: conservative residual (W3162) and strong remarketing (W3179)
Owner: Lease Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3175_Assoc10" sourceRef="W3175_Annotation9" targetRef="W3175_Start4" associationDirection="None" />
