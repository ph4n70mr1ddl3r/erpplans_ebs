    <bpmn:process id="W_W3174" name="W3174. Lease Delinquency, Restructure &amp; Cure Period" isExecutable="false">
      <bpmn:documentation>Trigger: Past-due payment
Frequency: Per delinquency
Volume: Subset of leases
Owner: Lease Credit Manager
Participants: Lease Credit Mgr, AR (links to VS-16), Legal, Customer Service, Field Recovery
Source: workflow W3174 — Lease Delinquency, Restructure &amp; Cure Period</bpmn:documentation>
      <bpmn:laneSet id="W3174_LaneSet4">
        <bpmn:lane id="W3174_Lane1" name="AR Clerk">
        <bpmn:flowNodeRef>W3174_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3174_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3174_Lane2" name="Lease Credit Mgr">
        <bpmn:flowNodeRef>W3174_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3174_Lane3" name="Legal">
        <bpmn:flowNodeRef>W3174_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3174_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3174_Start5" name="Past-due payment">
        <bpmn:outgoing>W3174_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3174_Task6" name="AR (links to VS-16) flag past-due; escalate per timeline (1–3 days: reminder…">
        <bpmn:documentation>Step 1: AR (links to VS-16) flag past-due; escalate per timeline (1–3 days: reminder; 7–15: notice; 30+: demand letter); Lease Credit Mgr outreach to customer, understand hardship, agree cure plan
Responsible (R): AR Clerk / Lease Credit Mgr
Accountable (A): Lease Credit Manager
Duration: Per delinquency</bpmn:documentation>
        <bpmn:incoming>W3174_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3174_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3174_Task7" name="For viable customers: Lease Credit Mgr offer restructure (extended term, lower…">
        <bpmn:documentation>Step 2: For viable customers: Lease Credit Mgr offer restructure (extended term, lower payment, deferment); re-underwrite (links to W3163); Legal document amendment (links to W3172)
Responsible (R): Lease Credit Mgr / Legal
Accountable (A): CFO
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W3174_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3174_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3174_Task8" name="For non-curable default: Legal/Field Recovery execute remedies per contract —…">
        <bpmn:documentation>Step 3: For non-curable default: Legal/Field Recovery execute remedies per contract — repossession of asset, demand full balance, file collection suit, report to credit bureau (where applicable); recover asset (links to W3175) and remarket (W3179)
Responsible (R): Legal / Field Recovery
Accountable (A): VP Legal &amp; Compliance
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W3174_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3174_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3174_End9" name="Complete">
        <bpmn:incoming>W3174_Flow15</bpmn:incoming>
      </bpmn:endEvent>
