      <bpmn:documentation>Trigger: Asset delivered; contract signed
Frequency: Per lease deal
Volume: Per lease deal
Owner: Lease Origination Manager
Participants: Lease Origination Mgr, Legal, Insurance (links to VS-26), Finance, Customer
Source: workflow W3168 — Lease Origination Documentation, Insurance &amp; Perfection</bpmn:documentation>
      <bpmn:laneSet id="W3168_LaneSet4">
        <bpmn:lane id="W3168_Lane1" name="Legal Counsel">
        <bpmn:flowNodeRef>W3168_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3168_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3168_Lane2" name="Insurance Coordinator">
        <bpmn:flowNodeRef>W3168_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3168_Lane3" name="Lease Origination Mgr">
        <bpmn:flowNodeRef>W3168_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3168_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3168_Start5" name="Asset delivered; contract signed">
        <bpmn:outgoing>W3168_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3168_Task6" name="Legal perfect lease: contract execution; security agreement / chattel mortgage…">
        <bpmn:documentation>Step 1: Legal perfect lease: contract execution; security agreement / chattel mortgage registration with the Registry of Deeds (Act 1508) / notation under the RA 11057 personal-property security registry, where applicable; lien on asset
Responsible (R): Legal Counsel
Accountable (A): VP Legal &amp; Compliance
Duration: Per deal</bpmn:documentation>
        <bpmn:incoming>W3168_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3168_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3168_Task7" name="Insurance (links to VS-26) bind required coverage: property damage, theft…">
        <bpmn:documentation>Step 2: Insurance (links to VS-26) bind required coverage: property damage, theft, casualty, third-party liability; confirm lessor as loss-payee; verify customer-maintained coverage where applicable
Responsible (R): Insurance Coordinator
Accountable (A): CFO
Duration: Per deal</bpmn:documentation>
        <bpmn:incoming>W3168_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3168_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3168_Task8" name="Lease Origination Mgr complete booking package: signed contract, perfect…">
        <bpmn:documentation>Step 3: Lease Origination Mgr complete booking package: signed contract, perfect security interest, insurance certificate, asset record, customer acceptance, funding confirmation; book lease (links to W3169) and disburse to vendor
Responsible (R): Lease Origination Mgr / Finance
Accountable (A): CFO
Duration: Per deal</bpmn:documentation>
        <bpmn:incoming>W3168_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3168_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3168_End9" name="Complete">
        <bpmn:incoming>W3168_Flow15</bpmn:incoming>
      </bpmn:endEvent>
