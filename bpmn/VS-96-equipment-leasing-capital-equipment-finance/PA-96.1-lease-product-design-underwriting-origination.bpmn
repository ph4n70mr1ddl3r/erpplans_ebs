        </bpmn:lane>
        <bpmn:lane id="W3165_Lane3" name="Finance Analyst">
        <bpmn:flowNodeRef>W3165_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3165_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3165_Start5" name="New partnership; funding-source review; portfolio rebalance">
        <bpmn:outgoing>W3165_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3165_Task6" name="Treasury/Lease Origination (links to VS-18) maintain lessor-partner…">
        <bpmn:documentation>Step 1: Treasury/Lease Origination (links to VS-18) maintain lessor-partner relationships: bank leasing subsidiaries, standalone leasing companies, OEM-captive finance; negotiate master agreement, funding spread, recourse (with/without recourse), approval criteria, SLA
Responsible (R): Treasury / Lease Origination Mgr
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3165_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3165_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3165_Task7" name="Per deal: route to appropriate lessor per asset category, ticket size, customer…">
        <bpmn:documentation>Step 2: Per deal: route to appropriate lessor per asset category, ticket size, customer rating; obtain funding approval; document BuildRight&#x27;s role (originator/servicer/broker); book accordingly (W3169)
Responsible (R): Lease Origination Mgr
Accountable (A): Lease Origination Manager
Duration: Per deal</bpmn:documentation>
        <bpmn:incoming>W3165_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3165_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3165_Task8" name="Finance/Treasury monitor partner performance: approval rate, funding speed…">
        <bpmn:documentation>Step 3: Finance/Treasury monitor partner performance: approval rate, funding speed, default recovery, repricing events; diversify funding to avoid concentration; manage BuildRight&#x27;s warehouse line / funding facility
Responsible (R): Finance Analyst / Treasury
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3165_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3165_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3165_End9" name="Complete">
        <bpmn:incoming>W3165_Flow15</bpmn:incoming>
      </bpmn:endEvent>
