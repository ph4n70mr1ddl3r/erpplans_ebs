<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-96.1-lease-product-design-underwriting-origination" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3161" name="W3161. Lease Product Strategy &amp; Portfolio Design" isExecutable="false">
      <bpmn:documentation>Trigger: Strategic cycle (links to VS-33); B2B customer demand; partner-bank opportunity
Frequency: Annual + event-driven
Volume: ~3–6 lease products; addressable ~5,400 B2B accounts
Owner: Leasing Product Manager
Participants: Leasing Product Mgr, CFO, B2B Sales (links to VS-11), Category (links to VS-01), Legal, Risk
Source: workflow W3161 — Lease Product Strategy &amp; Portfolio Design</bpmn:documentation>
      <bpmn:laneSet id="W3161_LaneSet3">
        <bpmn:lane id="W3161_Lane1" name="Leasing Product Mgr">
        <bpmn:flowNodeRef>W3161_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3161_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3161_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3161_Lane2" name="CFO">
        <bpmn:flowNodeRef>W3161_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3161_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3161_Start4" name="Strategic cycle (links to VS-33); B2B customer demand; partner-bank opportunity">
        <bpmn:outgoing>W3161_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3161_Task5" name="Leasing Product Mgr/B2B Sales (links to VS-11) assess demand: which customer…">
        <bpmn:documentation>Step 1: Leasing Product Mgr/B2B Sales (links to VS-11) assess demand: which customer segments (trade/corporate/government), which asset categories (generators, HVAC, solar — links to VS-70, material handling, scaffolding), typical ticket size (PHP 100K–5M), desired tenor (12–60 months); size addressable portfolio
Responsible (R): Leasing Product Mgr
Accountable (A): CFO
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W3161_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3161_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3161_Task6" name="Define product menu: operating lease (off-balance-sheet for lessee), finance…">
        <bpmn:documentation>Step 2: Define product menu: operating lease (off-balance-sheet for lessee), finance lease (capital lease / lease-to-own), sale-and-leaseback; tenor, advance rental, residual %, end-of-term options (return/renew/buy-out); align to lessor-partner appetite (W3165)
Responsible (R): Leasing Product Mgr / Risk
Accountable (A): CFO
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W3161_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3161_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3161_Task7" name="Steering committee approves strategy, capex/funding envelope (links to…">
        <bpmn:documentation>Step 3: Steering committee approves strategy, capex/funding envelope (links to VS-40/VS-18), risk appetite, 24-month P&amp;L; integrate to VS-33 strategic plan
Responsible (R): CFO / Finance Controller
Accountable (A): CEO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W3161_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3161_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3161_End8" name="Complete">
        <bpmn:incoming>W3161_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3161_Annotation9">
        <bpmn:text>Controls: - CTL-517 (ensure controlled execution — Lease Product Design, Credit Underwriting &amp; Origination (PA-96.1).) | - operational: conservative LTV, residual discipline, and portfolio diversification
Owner: Leasing Product Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3161_Assoc10" sourceRef="W3161_Annotation9" targetRef="W3161_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3161_Flow11" sourceRef="W3161_Start4" targetRef="W3161_Task5" />
      <bpmn:sequenceFlow id="W3161_Flow12" sourceRef="W3161_Task5" targetRef="W3161_Task6" />
      <bpmn:sequenceFlow id="W3161_Flow13" sourceRef="W3161_Task6" targetRef="W3161_Task7" />
      <bpmn:sequenceFlow id="W3161_Flow14" sourceRef="W3161_Task7" targetRef="W3161_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3161_diag">
      <bpmndi:BPMNPlane id="W3161_plane" bpmnElement="W_W3161">
        <bpmndi:BPMNShape id="W3161_Lane1_di" bpmnElement="W3161_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3161_Lane2_di" bpmnElement="W3161_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3161_Task5_di" bpmnElement="W3161_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3161_Task6_di" bpmnElement="W3161_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3161_Task7_di" bpmnElement="W3161_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3161_Start4_di" bpmnElement="W3161_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3161_End8_di" bpmnElement="W3161_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3161_Annotation9_di" bpmnElement="W3161_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3161_Flow11_di" bpmnElement="W3161_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3161_Flow12_di" bpmnElement="W3161_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3161_Flow13_di" bpmnElement="W3161_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3161_Flow14_di" bpmnElement="W3161_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3161_Assoc10_di" bpmnElement="W3161_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3162" name="W3162. Lease Pricing, Residual Setting &amp; Yield Modeling" isExecutable="false">
      <bpmn:documentation>Trigger: New product; rate review; cost-of-funds change
Frequency: Quarterly + event-driven
Volume: Per product + per deal
Owner: Leasing Product Manager
Participants: Leasing Product Mgr, Finance/Treasury (links to VS-18), Risk, Category (links to VS-01)
Source: workflow W3162 — Lease Pricing, Residual Setting &amp; Yield Modeling</bpmn:documentation>
      <bpmn:laneSet id="W3162_LaneSet4">
        <bpmn:lane id="W3162_Lane1" name="Finance Analyst">
        <bpmn:flowNodeRef>W3162_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3162_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3162_Lane2" name="Risk Analyst">
        <bpmn:flowNodeRef>W3162_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3162_Lane3" name="Leasing Product Mgr">
        <bpmn:flowNodeRef>W3162_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3162_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3162_Start5" name="New product; rate review; cost-of-funds change">
        <bpmn:outgoing>W3162_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3162_Task6" name="Treasury (links to VS-18) provide cost-of-funds (funding spread over…">
        <bpmn:documentation>Step 1: Treasury (links to VS-18) provide cost-of-funds (funding spread over benchmark); Finance build lease-pricing model: monthly rental from asset cost, tenor, advance rental, residual value, cost-of-funds, operating cost, target margin, tax (VAT/EWT — W3183)
Responsible (R): Finance Analyst / Treasury
Accountable (A): Leasing Product Manager
Duration: Per rate review</bpmn:documentation>
        <bpmn:incoming>W3162_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3162_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3162_Task7" name="Risk/Category (links to VS-01/VS-35) set residual values per asset category…">
        <bpmn:documentation>Step 2: Risk/Category (links to VS-01/VS-35) set residual values per asset category: depreciation curve, secondary-market value (used-equipment market — links to W3179), remarketing cost, end-of-lease condition standards; benchmark to industry data
Responsible (R): Risk Analyst / Category
Accountable (A): CFO
Duration: Per category/annual</bpmn:documentation>
        <bpmn:incoming>W3162_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3162_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3162_Task8" name="Leasing Product Mgr publish rate card and approval matrix; configure pricing…">
        <bpmn:documentation>Step 3: Leasing Product Mgr publish rate card and approval matrix; configure pricing engine with margin floor and approval tiers; Legal/Compliance review for Truth in Lending Act disclosure compliance
Responsible (R): Leasing Product Mgr / Legal
Accountable (A): CFO
Duration: Per rate review</bpmn:documentation>
        <bpmn:incoming>W3162_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3162_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3162_End9" name="Complete">
        <bpmn:incoming>W3162_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3162_Annotation10">
        <bpmn:text>Controls: - CTL-517 (ensure controlled execution — Lease Product Design, Credit Underwriting &amp; Origination (PA-96.1).) | - operational: conservative curves and market-data benchmarking
Owner: Leasing Product Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3162_Assoc11" sourceRef="W3162_Annotation10" targetRef="W3162_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3162_Flow12" sourceRef="W3162_Start5" targetRef="W3162_Task6" />
      <bpmn:sequenceFlow id="W3162_Flow13" sourceRef="W3162_Task6" targetRef="W3162_Task7" />
      <bpmn:sequenceFlow id="W3162_Flow14" sourceRef="W3162_Task7" targetRef="W3162_Task8" />
      <bpmn:sequenceFlow id="W3162_Flow15" sourceRef="W3162_Task8" targetRef="W3162_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3162_diag">
      <bpmndi:BPMNPlane id="W3162_plane" bpmnElement="W_W3162">
        <bpmndi:BPMNShape id="W3162_Lane1_di" bpmnElement="W3162_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3162_Lane2_di" bpmnElement="W3162_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3162_Lane3_di" bpmnElement="W3162_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3162_Task6_di" bpmnElement="W3162_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3162_Task7_di" bpmnElement="W3162_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3162_Task8_di" bpmnElement="W3162_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3162_Start5_di" bpmnElement="W3162_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3162_End9_di" bpmnElement="W3162_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3162_Annotation10_di" bpmnElement="W3162_Annotation10"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3162_Flow12_di" bpmnElement="W3162_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3162_Flow13_di" bpmnElement="W3162_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3162_Flow14_di" bpmnElement="W3162_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3162_Flow15_di" bpmnElement="W3162_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3162_Assoc11_di" bpmnElement="W3162_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3163" name="W3163. Customer Credit Underwriting &amp; Lease Approval" isExecutable="false">
      <bpmn:documentation>Trigger: Lease application from B2B customer
Frequency: Per application
Volume: ~50–200 applications/year
Owner: Lease Credit Manager
Participants: Lease Credit Mgr, Credit Analyst, B2B Sales (links to VS-11), Trade Credit (links to VS-68), Legal
Source: workflow W3163 — Customer Credit Underwriting &amp; Lease Approval</bpmn:documentation>
      <bpmn:laneSet id="W3163_LaneSet4">
        <bpmn:lane id="W3163_Lane1" name="B2B Sales">
        <bpmn:flowNodeRef>W3163_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3163_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3163_Lane2" name="Credit Analyst">
        <bpmn:flowNodeRef>W3163_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3163_Lane3" name="Lease Credit Manager">
        <bpmn:flowNodeRef>W3163_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3163_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3163_Start5" name="Lease application from B2B customer">
        <bpmn:outgoing>W3163_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3163_Task6" name="B2B Sales (links to VS-11) submits lease application: customer KYB (links to…">
        <bpmn:documentation>Step 1: B2B Sales (links to VS-11) submits lease application: customer KYB (links to VS-86), financial statements, trade references, existing exposure (links to VS-68 credit), asset &amp; tenor requested, intended use
Responsible (R): B2B Sales / Credit Analyst
Accountable (A): Lease Credit Manager
Duration: Per application</bpmn:documentation>
        <bpmn:incoming>W3163_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3163_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3163_Task7" name="Credit Analyst underwrite: credit-scoring model (financial ratios, payment…">
        <bpmn:documentation>Step 2: Credit Analyst underwrite: credit-scoring model (financial ratios, payment history with BuildRight — links to VS-16 AR, industry risk, project/contract backing), exposure aggregation vs. limit, sanctions/PEP screening (links to VS-86); assign internal rating
Responsible (R): Credit Analyst
Accountable (A): Lease Credit Manager
Duration: Per application (1–3 days)</bpmn:documentation>
        <bpmn:incoming>W3163_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3163_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3163_Task8" name="Lease Credit Manager approves per authority matrix (small-ticket automated…">
        <bpmn:documentation>Step 3: Lease Credit Manager approves per authority matrix (small-ticket automated; large-ticket committee with CFO/Risk); communicate decision to Sales; on decline, provide reasons and remediation path; record decision and conditions
Responsible (R): Lease Credit Manager / Credit Committee
Accountable (A): CFO
Duration: Per application</bpmn:documentation>
        <bpmn:incoming>W3163_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3163_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3163_End9" name="Complete">
        <bpmn:incoming>W3163_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3163_Annotation10">
        <bpmn:text>Controls: - CTL-105 (prevent unauthorized lease credit extension.) | - operational: risk-based pricing (margin tier by internal rating)
Owner: Lease Credit Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3163_Assoc11" sourceRef="W3163_Annotation10" targetRef="W3163_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3163_Flow12" sourceRef="W3163_Start5" targetRef="W3163_Task6" />
      <bpmn:sequenceFlow id="W3163_Flow13" sourceRef="W3163_Task6" targetRef="W3163_Task7" />
      <bpmn:sequenceFlow id="W3163_Flow14" sourceRef="W3163_Task7" targetRef="W3163_Task8" />
      <bpmn:sequenceFlow id="W3163_Flow15" sourceRef="W3163_Task8" targetRef="W3163_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3163_diag">
      <bpmndi:BPMNPlane id="W3163_plane" bpmnElement="W_W3163">
        <bpmndi:BPMNShape id="W3163_Lane1_di" bpmnElement="W3163_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3163_Lane2_di" bpmnElement="W3163_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3163_Lane3_di" bpmnElement="W3163_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3163_Task6_di" bpmnElement="W3163_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3163_Task7_di" bpmnElement="W3163_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3163_Task8_di" bpmnElement="W3163_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3163_Start5_di" bpmnElement="W3163_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3163_End9_di" bpmnElement="W3163_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3163_Annotation10_di" bpmnElement="W3163_Annotation10"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3163_Flow12_di" bpmnElement="W3163_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3163_Flow13_di" bpmnElement="W3163_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3163_Flow14_di" bpmnElement="W3163_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3163_Flow15_di" bpmnElement="W3163_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3163_Assoc11_di" bpmnElement="W3163_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3164" name="W3164. Lease Quote, Proposal &amp; Contract Generation" isExecutable="false">
      <bpmn:documentation>Trigger: Approved credit; customer quote request
Frequency: Per deal
Volume: Per lease deal
Owner: Lease Origination Manager
Participants: Lease Origination Mgr, B2B Sales (links to VS-11), Legal, Finance
Source: workflow W3164 — Lease Quote, Proposal &amp; Contract Generation</bpmn:documentation>
      <bpmn:laneSet id="W3164_LaneSet4">
        <bpmn:lane id="W3164_Lane1" name="Lease Origination Mgr">
        <bpmn:flowNodeRef>W3164_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3164_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3164_Lane2" name="B2B Sales">
        <bpmn:flowNodeRef>W3164_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3164_Lane3" name="Legal">
        <bpmn:flowNodeRef>W3164_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3164_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3164_Start5" name="Approved credit; customer quote request">
        <bpmn:outgoing>W3164_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3164_Task6" name="Lease Origination Mgr generate lease quote: asset spec, price, tenor, advance…">
        <bpmn:documentation>Step 1: Lease Origination Mgr generate lease quote: asset spec, price, tenor, advance rental, monthly rental, residual, end-of-term options, fees, taxes (VAT/EWT — W3183), insurance, total cost of lease; Truth-in-Lending disclosure (effective interest rate)
Responsible (R): Lease Origination Mgr
Accountable (A): Lease Origination Manager
Duration: Per quote</bpmn:documentation>
        <bpmn:incoming>W3164_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3164_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3164_Task7" name="B2B Sales (links to VS-11) present quote and negotiate terms within authority…">
        <bpmn:documentation>Step 2: B2B Sales (links to VS-11) present quote and negotiate terms within authority; for off-matrix deals, escalate to Lease Product Mgr/Credit Mgr; capture customer acceptance
Responsible (R): B2B Sales
Accountable (A): Head of Trade / Account Management
Duration: Per deal</bpmn:documentation>
        <bpmn:incoming>W3164_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3164_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3164_Task8" name="Legal/Lease Origination generate lease contract from approved template…">
        <bpmn:documentation>Step 3: Legal/Lease Origination generate lease contract from approved template: parties, asset description, tenor, rentals, residual, insurance/maintenance obligations, default/cure, early-termination, end-of-term options, jurisdiction; obtain signatures (digital — links to VS-30)
Responsible (R): Legal / Lease Origination Mgr
Accountable (A): VP Legal &amp; Compliance
Duration: Per deal</bpmn:documentation>
        <bpmn:incoming>W3164_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3164_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3164_End9" name="Complete">
        <bpmn:incoming>W3164_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3164_Annotation10">
        <bpmn:text>Controls: - CTL-517 (ensure controlled execution — Lease Product Design, Credit Underwriting &amp; Origination (PA-96.1).) | - operational: template-based generation and legal review
Owner: Lease Origination Manager</bpmn:text>
      </bpmn:textAnnotation>
