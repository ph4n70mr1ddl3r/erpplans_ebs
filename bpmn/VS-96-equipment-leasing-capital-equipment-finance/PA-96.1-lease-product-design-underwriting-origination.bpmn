    <bpmn:process id="W_W3165" name="W3165. Lessor Partner / Funding Source Management" isExecutable="false">
      <bpmn:documentation>Trigger: New partnership; funding-source review; portfolio rebalance
Frequency: Quarterly + event-driven
Volume: ~3–8 lessor partners (banks, leasing companies, OEM captive)
Owner: Lease Origination Manager
Participants: Lease Origination Mgr, Treasury (links to VS-18), Legal, Finance
Source: workflow W3165 — Lessor Partner / Funding Source Management</bpmn:documentation>
      <bpmn:laneSet id="W3165_LaneSet4">
        <bpmn:lane id="W3165_Lane1" name="Treasury">
        <bpmn:flowNodeRef>W3165_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3165_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3165_Lane2" name="Lease Origination Mgr">
