    <bpmn:process id="W_W3167" name="W3167. Asset Specification, Vendor Selection &amp; Procurement for Lease" isExecutable="false">
      <bpmn:documentation>Trigger: Lease signed; asset to be procured
Frequency: Per lease deal
Volume: Per lease deal
Owner: Lease Origination Manager
Participants: Lease Origination Mgr, Procurement (links to VS-03/VS-34), Category (links to VS-01), Vendor, Receiving (links to VS-04)
Source: workflow W3167 — Asset Specification, Vendor Selection &amp; Procurement for Lease</bpmn:documentation>
      <bpmn:laneSet id="W3167_LaneSet4">
        <bpmn:lane id="W3167_Lane1" name="Lease Origination Mgr">
        <bpmn:flowNodeRef>W3167_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3167_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3167_Lane2" name="Procurement">
        <bpmn:flowNodeRef>W3167_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3167_Lane3" name="Receiving">
        <bpmn:flowNodeRef>W3167_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3167_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3167_Start5" name="Lease signed; asset to be procured">
        <bpmn:outgoing>W3167_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3167_Task6" name="Lease Origination Mgr/Category (links to VS-01) finalize asset spec: brand…">
        <bpmn:documentation>Step 1: Lease Origination Mgr/Category (links to VS-01) finalize asset spec: brand, model, configuration, warranty, accessories; confirm vendor (BuildRight inventory if stocked, or vendor direct — links to VS-03); capture serial/asset-tag plan
Responsible (R): Lease Origination Mgr / Category
Accountable (A): VP Merchandising
Duration: Per deal</bpmn:documentation>
        <bpmn:incoming>W3167_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3167_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3167_Task7" name="Procurement (links to VS-03/VS-34) place purchase order to vendor; negotiate…">
        <bpmn:documentation>Step 2: Procurement (links to VS-03/VS-34) place purchase order to vendor; negotiate BuildRight&#x27;s purchase price (separate from lease price to customer — margin capture); arrange delivery to customer site or BuildRight DC for inspection
Responsible (R): Procurement / Vendor
Accountable (A): Lease Origination Manager
Duration: Per deal</bpmn:documentation>
        <bpmn:incoming>W3167_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3167_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3167_Task8" name="Receiving (links to VS-04) / Field verify asset delivery, condition, serial…">
        <bpmn:documentation>Step 3: Receiving (links to VS-04) / Field verify asset delivery, condition, serial number, warranty commencement; capture asset record and photos; deliver/install to customer; obtain customer acceptance (links to W3168 perfection)
Responsible (R): Receiving / Field / Customer
Accountable (A): Lease Origination Manager
Duration: Per deal</bpmn:documentation>
        <bpmn:incoming>W3167_Flow14</bpmn:incoming>
