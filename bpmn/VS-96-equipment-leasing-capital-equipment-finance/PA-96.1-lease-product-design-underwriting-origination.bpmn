    <bpmn:process id="W_W3166" name="W3166. Lease vs Buy vs Rent Decision Support &amp; Sales Enablement" isExecutable="false">
      <bpmn:documentation>Trigger: Customer decision moment; sales enablement cycle
Frequency: Per opportunity
Volume: Per B2B customer opportunity
Owner: Lease Origination Manager
Participants: Lease Origination Mgr, B2B Sales (links to VS-11), Finance, Customer
Source: workflow W3166 — Lease vs Buy vs Rent Decision Support &amp; Sales Enablement</bpmn:documentation>
      <bpmn:laneSet id="W3166_LaneSet4">
        <bpmn:lane id="W3166_Lane1" name="Lease Origination Mgr">
        <bpmn:flowNodeRef>W3166_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3166_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3166_Lane2" name="B2B Sales">
        <bpmn:flowNodeRef>W3166_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3166_Lane3" name="Finance Analyst">
        <bpmn:flowNodeRef>W3166_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3166_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3166_Start5" name="Customer decision moment; sales enablement cycle">
        <bpmn:outgoing>W3166_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3166_Task6" name="Lease Origination Mgr provide decision tool to Sales (links to VS-11): compare…">
        <bpmn:documentation>Step 1: Lease Origination Mgr provide decision tool to Sales (links to VS-11): compare lease vs. buy vs. rent (links to VS-12) on total-cost-of-ownership, cash-flow, tax treatment (deductibility of rentals vs. depreciation — W3183), balance-sheet impact, technology refresh
Responsible (R): Lease Origination Mgr / Finance
Accountable (A): Head of Trade / Account Management
Duration: Per tool/cycle</bpmn:documentation>
        <bpmn:incoming>W3166_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3166_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3166_Task7" name="B2B Sales position lease value proposition: conserve cash, predictable…">
        <bpmn:documentation>Step 2: B2B Sales position lease value proposition: conserve cash, predictable payments, bundled maintenance, end-of-term flexibility, fast approval; tailor to customer segment (trade vs. corporate vs. government — links to VS-46)
Responsible (R): B2B Sales
Accountable (A): Head of Trade / Account Management
Duration: Per opportunity</bpmn:documentation>
        <bpmn:incoming>W3166_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3166_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3166_Task8" name="Sales/Finance run win/loss analysis: why customers chose/declined lease; refine…">
        <bpmn:documentation>Step 3: Sales/Finance run win/loss analysis: why customers chose/declined lease; refine product/pricing/process; feed into product strategy (W3161)
Responsible (R): Finance Analyst / B2B Sales
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3166_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3166_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3166_End9" name="Complete">
        <bpmn:incoming>W3166_Flow15</bpmn:incoming>
      </bpmn:endEvent>
