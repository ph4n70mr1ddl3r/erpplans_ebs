        <bpmn:outgoing>W2361_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2361_Task4" name="VP Store Operations curates weekly newsletter: top-performing stores, new…">
        <bpmn:documentation>Step 1: VP Store Operations curates weekly newsletter: top-performing stores, new procedures, upcoming promos, compliance scores, safety tips, HR updates; system distributes every Monday morning
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 2–3 hours/week</bpmn:documentation>
        <bpmn:incoming>W2361_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2361_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2361_End5" name="Complete">
        <bpmn:incoming>W2361_Flow9</bpmn:incoming>
      </bpmn:endEvent>
