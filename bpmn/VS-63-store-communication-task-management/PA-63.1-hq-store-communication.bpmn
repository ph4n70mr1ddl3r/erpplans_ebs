    <bpmn:process id="W_W2358" name="W2358. Corporate Announcement Broadcasting" isExecutable="false">
      <bpmn:documentation>Trigger: Corporate announcement from HQ
Frequency: ~10–15 announcements/month
Volume: ~10–15 broadcasts to 200 stores/month
Owner: VP Corporate Communications
Participants: VP Corp Comms, COO, Regional Ops Manager, Field Communications Manager
Source: workflow W2358 — Corporate Announcement Broadcasting</bpmn:documentation>
      <bpmn:laneSet id="W2358_LaneSet3">
        <bpmn:lane id="W2358_Lane1" name="VP Corp Comms, Field Communications Manager">
        <bpmn:flowNodeRef>W2358_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2358_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2358_Lane2" name="System">
        <bpmn:flowNodeRef>W2358_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2358_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2358_Start4" name="Corporate announcement from HQ">
        <bpmn:outgoing>W2358_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2358_Task5" name="VP Corp Comms drafts announcement in store communication platform: targets (all…">
        <bpmn:documentation>Step 1: VP Corp Comms drafts announcement in store communication platform: targets (all stores, regional, specific stores), priority (info/action/urgent), category (policy, promo, safety, HR); attaches documents
Responsible (R): VP Corp Comms, Field Communications Manager
Accountable (A): COO
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W2358_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2358_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2358_Task6" name="System pushes to store manager app with notification; tracks read receipts per…">
        <bpmn:documentation>Step 2: System pushes to store manager app with notification; tracks read receipts per store; auto-escalates unread urgent messages after 4 hours; Regional Ops follows up with non-responsive stores
Responsible (R): System / Regional Ops Mgr
Accountable (A): VP Corp Comms
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2358_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2358_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2358_End7" name="Complete">
        <bpmn:incoming>W2358_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2358_Annotation8">
        <bpmn:text>Controls: - CTL-418 (ensure controlled execution — HQ-to-Store Communication &amp; Broadcast (PA-63.1).) | - Operational: COO sign-off on urgent-priority broadcasts (prevents priority-creep); VP Corp Comms read-rate review
Owner: VP Corporate Communications</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2358_Assoc9" sourceRef="W2358_Annotation8" targetRef="W2358_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2358_Flow10" sourceRef="W2358_Start4" targetRef="W2358_Task5" />
      <bpmn:sequenceFlow id="W2358_Flow11" sourceRef="W2358_Task5" targetRef="W2358_Task6" />
      <bpmn:sequenceFlow id="W2358_Flow12" sourceRef="W2358_Task6" targetRef="W2358_End7" />
    </bpmn:process>
