    <bpmn:process id="W_W2361" name="W2361. Weekly Store Manager Newsletter" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly editorial schedule
Frequency: Weekly; 200 Store Managers
Volume: ~200 recipients/week
Owner: VP Store Operations
Participants: VP Store Operations, COO
Source: workflow W2361 — Weekly Store Manager Newsletter</bpmn:documentation>
      <bpmn:laneSet id="W2361_LaneSet2">
        <bpmn:lane id="W2361_Lane1" name="VP Store Operations">
