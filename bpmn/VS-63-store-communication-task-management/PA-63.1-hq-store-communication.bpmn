    <bpmn:process id="W_W2362" name="W2362. Two-Way Store Feedback Channel" isExecutable="false">
      <bpmn:documentation>Trigger: Store Manager submits feedback or question
Frequency: Continuous; ~50–100 feedback items/month
Volume: ~50–100/month
Owner: Store Manager
Participants: VP Store Operations
Source: workflow W2362 — Two-Way Store Feedback Channel</bpmn:documentation>
      <bpmn:laneSet id="W2362_LaneSet2">
        <bpmn:lane id="W2362_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W2362_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2362_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2362_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2362_Start3" name="Store Manager submits feedback or question">
        <bpmn:outgoing>W2362_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2362_Task4" name="Store Manager submits feedback/question via the platform (category, priority…">
        <bpmn:documentation>Step 1: Store Manager submits feedback/question via the platform (category, priority, attachments); system routes to the responsible HQ function; HQ responds within SLA (48 hours standard, 24 hours urgent); feedback closed-loop on resolution
Responsible (R): Store Manager / HQ Function
Accountable (A): VP Store Operations
Duration: Per item</bpmn:documentation>
        <bpmn:incoming>W2362_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2362_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2362_End5" name="Complete">
        <bpmn:incoming>W2362_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2362_Annotation6">
        <bpmn:text>Controls: - CTL-418 (ensure controlled execution — HQ-to-Store Communication &amp; Broadcast (PA-63.1).) | - Operational: VP Store Operations SLA-compliance review; closed-loop-rate monitored
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2362_Assoc7" sourceRef="W2362_Annotation6" targetRef="W2362_Start3" associationDirection="None" />
