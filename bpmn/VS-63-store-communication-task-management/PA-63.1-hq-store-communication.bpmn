    <bpmn:process id="W_W2360" name="W2360. Emergency Communication Protocol" isExecutable="false">
      <bpmn:documentation>Trigger: Emergency event (typhoon, safety incident, system outage)
Frequency: Ad-hoc; ~5–10 emergencies/year
Volume: ~5–10 emergency broadcasts/year to 200 stores
Owner: COO
Participants: CEO, Regional Ops Manager
Source: workflow W2360 — Emergency Communication Protocol</bpmn:documentation>
      <bpmn:laneSet id="W2360_LaneSet3">
        <bpmn:lane id="W2360_Lane1" name="COO">
        <bpmn:flowNodeRef>W2360_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2360_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2360_Lane2" name="System">
        <bpmn:flowNodeRef>W2360_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2360_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2360_Start4" name="Emergency event (typhoon, safety incident, system outage)">
        <bpmn:outgoing>W2360_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2360_Task5" name="COO or designated executive sends emergency broadcast: mandatory read, audio…">
        <bpmn:documentation>Step 1: COO or designated executive sends emergency broadcast: mandatory read, audio alert on store devices, clear instructions (close store, evacuate, shelter in place, system workaround)
Responsible (R): COO
Accountable (A): CEO
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W2360_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2360_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2360_Task6" name="System tracks real-time acknowledgment; non-responding stores contacted by…">
        <bpmn:documentation>Step 2: System tracks real-time acknowledgment; non-responding stores contacted by phone; Regional Ops confirms physical safety; follow-up communications as situation evolves
Responsible (R): System / Regional Ops Mgr
Accountable (A): COO
Duration: Continuous during emergency</bpmn:documentation>
        <bpmn:incoming>W2360_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2360_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2360_End7" name="Complete">
        <bpmn:incoming>W2360_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2360_Annotation8">
        <bpmn:text>Controls: - CTL-199 (ensure store-communication task closure.) | - CTL-418 (BCP communication — links to VS-26 / W49); operational: CEO sign-off on emergency broadcasts; post-emergency review of acknowledgment rates
Owner: COO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2360_Assoc9" sourceRef="W2360_Annotation8" targetRef="W2360_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2360_Flow10" sourceRef="W2360_Start4" targetRef="W2360_Task5" />
      <bpmn:sequenceFlow id="W2360_Flow11" sourceRef="W2360_Task5" targetRef="W2360_Task6" />
      <bpmn:sequenceFlow id="W2360_Flow12" sourceRef="W2360_Task6" targetRef="W2360_End7" />
    </bpmn:process>
