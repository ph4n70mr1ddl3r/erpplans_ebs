    <bpmn:process id="W_W2359" name="W2359. Merchandising Directive Communication" isExecutable="false">
      <bpmn:documentation>Trigger: Planogram change or merchandising directive
Frequency: ~20–30 directives/month
Volume: ~20–30/month to 200 stores
Owner: Merchandising Coordinator
Participants: Merchandising Planner, Store Manager
Source: workflow W2359 — Merchandising Directive Communication</bpmn:documentation>
      <bpmn:laneSet id="W2359_LaneSet3">
        <bpmn:lane id="W2359_Lane1" name="Merch Coordinator">
        <bpmn:flowNodeRef>W2359_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2359_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2359_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W2359_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2359_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2359_Start4" name="Planogram change or merchandising directive">
        <bpmn:outgoing>W2359_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2359_Task5" name="Coordinator creates merchandising directive: action required, affected zones…">
        <bpmn:documentation>Step 1: Coordinator creates merchandising directive: action required, affected zones, product details, photos of expected result, deadline, compliance photo requirement; distributes to stores
Responsible (R): Merch Coordinator
Accountable (A): Merchandising Planner
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W2359_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2359_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2359_Task6" name="Store Manager acknowledges receipt; assigns to stock team; executes by…">
        <bpmn:documentation>Step 2: Store Manager acknowledges receipt; assigns to stock team; executes by deadline; submits compliance photos; Coordinator verifies within 48 hours
Responsible (R): Store Manager / Merch Coordinator
Accountable (A): Merchandising Planner
Duration: 1–2 hours + execution time</bpmn:documentation>
        <bpmn:incoming>W2359_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2359_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2359_End7" name="Complete">
        <bpmn:incoming>W2359_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2359_Annotation8">
        <bpmn:text>Controls: - CTL-418 (ensure controlled execution — HQ-to-Store Communication &amp; Broadcast (PA-63.1).) | - operational: planogram-version integrity; operational: Merchandising Planner verification sign-off
Owner: Merchandising Coordinator</bpmn:text>
      </bpmn:textAnnotation>
