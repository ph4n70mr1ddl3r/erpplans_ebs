    <bpmn:process id="W_W2363" name="W2363. Policy &amp; Procedure Update Distribution" isExecutable="false">
      <bpmn:documentation>Trigger: Policy or procedure change
Frequency: ~5–10 policy updates/month
Volume: ~5–10/month to 200 stores
Owner: VP Legal / VP Store Operations
Participants: VP Legal &amp; Compliance, VP Store Operations, COO, Store Manager, Coordinator
Source: workflow W2363 — Policy &amp; Procedure Update Distribution</bpmn:documentation>
      <bpmn:laneSet id="W2363_LaneSet3">
        <bpmn:lane id="W2363_Lane1" name="VP Legal">
        <bpmn:flowNodeRef>W2363_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2363_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2363_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W2363_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2363_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2363_Start4" name="Policy or procedure change">
        <bpmn:outgoing>W2363_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2363_Task5" name="VP Legal / VP Store Operations distributes the policy/procedure update: the…">
        <bpmn:documentation>Step 1: VP Legal / VP Store Operations distributes the policy/procedure update: the changed policy, effective date, the &quot;what changed&quot; summary, the required store action (acknowledge, retrain, post); read-and-acknowledge required
Responsible (R): VP Legal / VP Store Operations
Accountable (A): COO
Duration: Per update</bpmn:documentation>
        <bpmn:incoming>W2363_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2363_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2363_Task6" name="Store Manager acknowledges; posts/communicates per the required action…">
        <bpmn:documentation>Step 2: Store Manager acknowledges; posts/communicates per the required action; Coordinator verifies acknowledgment across all 200 stores
Responsible (R): Store Manager / Coordinator
Accountable (A): VP Store Operations
Duration: Per update</bpmn:documentation>
        <bpmn:incoming>W2363_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2363_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2363_End7" name="Complete">
        <bpmn:incoming>W2363_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2363_Annotation8">
        <bpmn:text>Controls: - CTL-418 (ensure controlled execution — HQ-to-Store Communication &amp; Broadcast (PA-63.1).) | - operational: policy-version integrity — links to VS-88; operational: VP Store Operations acknowledgment-completion sign-off
Owner: VP Legal / VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2363_Assoc9" sourceRef="W2363_Annotation8" targetRef="W2363_Start4" associationDirection="None" />
