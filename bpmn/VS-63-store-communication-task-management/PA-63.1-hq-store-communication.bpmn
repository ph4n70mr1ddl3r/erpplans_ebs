    <bpmn:process id="W_W2364" name="W2364. Seasonal Preparation Communication Package" isExecutable="false">
      <bpmn:documentation>Trigger: Pre-season communication (6 seasons/year)
Frequency: 6/year; 200 stores
Volume: ~1,200 seasonal packages/year
Owner: Merchandising Planner
Participants: VP Merchandising
Source: workflow W2364 — Seasonal Preparation Communication Package</bpmn:documentation>
