    <bpmn:process id="W_W510" name="W510. Ecommerce Product Review &amp; Rating Management" isExecutable="false">
      <bpmn:documentation>Trigger: Customer submits product review; or scheduled weekly review moderation
Frequency: ~2,000–3,000 new reviews/month across 35,000 SKUs
Volume: ~2,500 average/month; peaks 2 weeks after major promo (+50%)
Owner: Digital Content Manager
Participants: Customer Experience Representative, Category Manager, Vendor Manager, Ecommerce Marketing Specialist
Source: workflow W510 — Ecommerce Product Review &amp; Rating Management</bpmn:documentation>
      <bpmn:laneSet id="W510_LaneSet6">
        <bpmn:lane id="W510_Lane1" name="Customer">
        <bpmn:flowNodeRef>W510_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W510_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W510_Lane2" name="System">
        <bpmn:flowNodeRef>W510_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W510_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W510_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W510_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W510_Lane3" name="Content Rep">
        <bpmn:flowNodeRef>W510_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W510_Lane4" name="CX Rep">
        <bpmn:flowNodeRef>W510_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W510_Lane5" name="Digital Content Manager">
        <bpmn:flowNodeRef>W510_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W510_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W510_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W510_Start7" name="Customer submits product review; or scheduled weekly review moderation">
        <bpmn:outgoing>W510_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W510_Task8" name="Customer submits product review via ecommerce platform after verified purchase…">
        <bpmn:documentation>Step 1: Customer submits product review via ecommerce platform after verified purchase (post-delivery email prompt or product page review form); review includes star rating (1–5), text, and optional photos
Responsible (R): Customer
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W510_Flow20</bpmn:incoming>
        <bpmn:outgoing>W510_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W510_Task9" name="System validates: purchase verification (order number match), review…">
        <bpmn:documentation>Step 2: System validates: purchase verification (order number match), review completeness (minimum rating and text), duplicate detection (one review per SKU per customer), profanity and inappropriate content filter
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W510_Flow21</bpmn:incoming>
        <bpmn:outgoing>W510_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W510_Task10" name="If auto-filter flags content: review enters manual moderation queue; Digital…">
        <bpmn:documentation>Step 3: If auto-filter flags content: review enters manual moderation queue; Digital Content Representative reviews for policy compliance (no hate speech, no personal information, no competitor mentions, no spam); approve, reject, or edit
Responsible (R): Content Rep
Accountable (A): Digital Content Manager
Duration: 5 min/review</bpmn:documentation>
        <bpmn:incoming>W510_Flow22</bpmn:incoming>
        <bpmn:outgoing>W510_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W510_Task11" name="If review passes auto-filter: published to product page within 24 hours; rating…">
        <bpmn:documentation>Step 4: If review passes auto-filter: published to product page within 24 hours; rating incorporated into SKU&#x27;s average rating displayed on product page, search results, and Google Shopping feed
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W510_Flow23</bpmn:incoming>
        <bpmn:outgoing>W510_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W510_Task12" name="If negative review (1–2 stars): system auto-generates customer experience…">
        <bpmn:documentation>Step 5: If negative review (1–2 stars): system auto-generates customer experience ticket (W258); CX Representative contacts customer within 48 hours to understand issue and offer resolution
Responsible (R): System / CX Rep
Accountable (A): CX Manager
Duration: 15 min/ticket</bpmn:documentation>
        <bpmn:incoming>W510_Flow24</bpmn:incoming>
        <bpmn:outgoing>W510_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W510_Task13" name="CX Representative drafts public vendor response for applicable reviews…">
        <bpmn:documentation>Step 6: CX Representative drafts public vendor response for applicable reviews; response posted alongside customer review on product page
Responsible (R): CX Rep
Accountable (A): Digital Content Manager
Duration: 10 min/response</bpmn:documentation>
        <bpmn:incoming>W510_Flow25</bpmn:incoming>
        <bpmn:outgoing>W510_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W510_Task14" name="Weekly: Digital Content Manager reviews review analytics: average rating by…">
        <bpmn:documentation>Step 7: Weekly: Digital Content Manager reviews review analytics: average rating by category, review velocity (reviews per SKU per week), sentiment trend, top-flagged SKUs by negative review volume
Responsible (R): Digital Content Manager
Accountable (A): GM, Digital Commerce Inc.
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W510_Flow26</bpmn:incoming>
        <bpmn:outgoing>W510_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W510_Task15" name="Monthly: system identifies SKUs with average rating &lt;3.0 stars AND &gt;5 reviews →…">
        <bpmn:documentation>Step 8: Monthly: system identifies SKUs with average rating &lt;3.0 stars AND &gt;5 reviews → auto-alerts Category Manager for product quality investigation; Category Manager coordinates with vendor for corrective action (W110)
Responsible (R): System
Accountable (A): Category Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W510_Flow27</bpmn:incoming>
        <bpmn:outgoing>W510_Flow28</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W510_Task16" name="Quarterly: Digital Content Manager compiles vendor feedback report: aggregate…">
        <bpmn:documentation>Step 9: Quarterly: Digital Content Manager compiles vendor feedback report: aggregate vendor rating, recurring quality themes from reviews, review response rate; shares with Vendor Manager for JBP discussions (W155)
Responsible (R): Digital Content Manager
Accountable (A): GM, Digital Commerce Inc.
Duration: 4 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W510_Flow28</bpmn:incoming>
        <bpmn:outgoing>W510_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W510_End17" name="Complete">
        <bpmn:incoming>W510_Flow29</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W510_Annotation18">
        <bpmn:text>Controls: - CTL-269 (ensure controlled execution — Ecommerce Platform Operations (PA-10.1).) | - operational: verified purchase requirement and fraud detection algorithms; operational: velocity monitoring and manual review for sudden spikes; operational: Legal-approved response templates
Owner: Digital Content Manager</bpmn:text>
      </bpmn:textAnnotation>
