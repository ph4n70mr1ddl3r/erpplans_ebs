      <bpmn:sequenceFlow id="W1185_Flow15" sourceRef="W1185_Task6" targetRef="W1185_Task7" />
      <bpmn:sequenceFlow id="W1185_Flow16" sourceRef="W1185_Task7" targetRef="W1185_Task8" />
      <bpmn:sequenceFlow id="W1185_Flow17" sourceRef="W1185_Task8" targetRef="W1185_Task9" />
      <bpmn:sequenceFlow id="W1185_Flow18" sourceRef="W1185_Task9" targetRef="W1185_End10" />
    </bpmn:process>
