      <bpmn:sequenceFlow id="W907_Flow17" sourceRef="W907_Task8" targetRef="W907_Task9" />
      <bpmn:sequenceFlow id="W907_Flow18" sourceRef="W907_Task9" targetRef="W907_Task10" />
      <bpmn:sequenceFlow id="W907_Flow19" sourceRef="W907_Task10" targetRef="W907_Task11" />
      <bpmn:sequenceFlow id="W907_Flow20" sourceRef="W907_Task11" targetRef="W907_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W907_diag">
      <bpmndi:BPMNPlane id="W907_plane" bpmnElement="W_W907">
        <bpmndi:BPMNShape id="W907_Lane1_di" bpmnElement="W907_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W907_Lane2_di" bpmnElement="W907_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W907_Lane3_di" bpmnElement="W907_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W907_Lane4_di" bpmnElement="W907_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1370" height="170" /></bpmndi:BPMNShape>
