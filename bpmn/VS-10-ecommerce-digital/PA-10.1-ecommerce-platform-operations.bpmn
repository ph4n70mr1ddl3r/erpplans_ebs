    <bpmn:process id="W_W568" name="W568. E-Commerce Flash Sale &amp; Limited-Time Offer Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Flash sale event scheduled (Payday Sale, 11.11, 12.12, Lazada/Shopee birthday sale, BuildRight anniversary sale, clearance event)
Frequency: ~2–4 flash sales per month (1–2 BuildRight proprietary, 1–2 marketplace-partnered)
Volume: Each sale generates up to ~4,300 orders/day at the canonical 3.0x ecommerce peak factor (vs. ~1,430 daily average per §1.1)
Owner: E-Commerce Operations Manager
Participants: E-Commerce Manager, Digital Marketing Specialist, Category Manager (C for pricing), Supply Planning Manager (C for inventory), IT Operations (C for infrastructure), Customer Service Lead (C for support surge)
Source: workflow W568 — E-Commerce Flash Sale &amp; Limited-Time Offer Operations</bpmn:documentation>
      <bpmn:laneSet id="W568_LaneSet8">
        <bpmn:lane id="W568_Lane1" name="E-Commerce Manager">
        <bpmn:flowNodeRef>W568_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W568_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W568_Task20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W568_Task21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W568_Start9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W568_Lane2" name="Supply Planning Manager">
        <bpmn:flowNodeRef>W568_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W568_Lane3" name="Category Manager">
        <bpmn:flowNodeRef>W568_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W568_Lane4" name="IT Operations">
        <bpmn:flowNodeRef>W568_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W568_Lane5" name="Digital Marketing Specialist">
        <bpmn:flowNodeRef>W568_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W568_Lane6" name="System">
        <bpmn:flowNodeRef>W568_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W568_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W568_Task18</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W568_Lane7" name="DC">
        <bpmn:flowNodeRef>W568_Task19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W568_End22</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W568_Start9" name="Flash sale event scheduled (Payday Sale, 11.11, 12.12, Lazada/Shopee birthday sale…">
        <bpmn:outgoing>W568_Flow25</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W568_Task10" name="Flash sale planning (T-14 days)">
        <bpmn:documentation>Step 1: Flash sale planning (T-14 days): E-Commerce Manager, Category Manager, and Supply Planning define sale scope — participating SKUs, discount depth, inventory allocation per W57
Responsible (R): E-Commerce Manager / Category Manager
Accountable (A): E-Commerce Manager
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W568_Flow25</bpmn:incoming>
        <bpmn:outgoing>W568_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W568_Task11" name="Inventory pre-reservation (T-7 days)">
        <bpmn:documentation>Step 2: Inventory pre-reservation (T-7 days): Supply Planning allocates dedicated flash sale inventory pool — excluded from regular ATP per W105 to prevent overselling
Responsible (R): Supply Planning Manager
Accountable (A): E-Commerce Manager
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W568_Flow26</bpmn:incoming>
        <bpmn:outgoing>W568_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W568_Task12" name="Pricing setup (T-5 days)">
        <bpmn:documentation>Step 3: Pricing setup (T-5 days): Category Manager configures flash sale pricing in e-commerce platform with start/end timestamps; system cross-checks against DTI price freeze status per W468
Responsible (R): Category Manager
Accountable (A): E-Commerce Manager
Duration: 3 hours</bpmn:documentation>
        <bpmn:incoming>W568_Flow27</bpmn:incoming>
        <bpmn:outgoing>W568_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W568_Task13" name="Infrastructure readiness (T-3 days)">
        <bpmn:documentation>Step 4: Infrastructure readiness (T-3 days): IT Operations confirms CDN capacity, payment gateway rate limits, server auto-scaling per W376; load test at 5x normal traffic
Responsible (R): IT Operations
Accountable (A): E-Commerce Manager
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W568_Flow28</bpmn:incoming>
        <bpmn:outgoing>W568_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W568_Task14" name="Content staging (T-2 days)">
        <bpmn:documentation>Step 5: Content staging (T-2 days): Digital Marketing stages landing pages, banners, email campaigns, push notification templates — held in draft for go-live
Responsible (R): Digital Marketing Specialist
Accountable (A): E-Commerce Manager
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W568_Flow29</bpmn:incoming>
        <bpmn:outgoing>W568_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W568_Task15" name="Flash sale go-live (T-0)">
        <bpmn:documentation>Step 6: Flash sale go-live (T-0): system activates pricing at scheduled time; monitoring dashboard live — order rate, inventory depletion, payment success rate, page load time, error rate
Responsible (R): System / E-Commerce Manager
Accountable (A): E-Commerce Manager
Duration: Automated + monitoring</bpmn:documentation>
        <bpmn:incoming>W568_Flow30</bpmn:incoming>
        <bpmn:outgoing>W568_Flow31</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W568_Task16" name="Real-time monitoring (every 30 minutes during sale)">
        <bpmn:documentation>Step 7: Real-time monitoring (every 30 minutes during sale): inventory depletion alerts (flag at 50%, 75%, 90% sold); payment gateway error rate monitoring; site performance monitoring; escalate anomalies immediately
Responsible (R): E-Commerce Manager / IT Operations
Accountable (A): E-Commerce Manager
Duration: Continuous during sale</bpmn:documentation>
        <bpmn:incoming>W568_Flow31</bpmn:incoming>
        <bpmn:outgoing>W568_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W568_Task17" name="Inventory emergency protocol">
        <bpmn:documentation>Step 8: Inventory emergency protocol: if SKU sells out, system auto-displays &quot;Sold Out&quot; badge and recommends substitutes per W279; if overall inventory error detected, pause sale for affected SKUs
Responsible (R): System / E-Commerce Manager
Accountable (A): E-Commerce Manager
Duration: Event-driven</bpmn:documentation>
        <bpmn:incoming>W568_Flow32</bpmn:incoming>
        <bpmn:outgoing>W568_Flow33</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W568_Task18" name="Flash sale end">
        <bpmn:documentation>Step 9: Flash sale end: system reverts pricing; unallocated inventory released back to general ATP; &quot;Sale Ended&quot; messaging displayed
Responsible (R): System
Accountable (A): E-Commerce Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W568_Flow33</bpmn:incoming>
        <bpmn:outgoing>W568_Flow34</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W568_Task19" name="Post-sale order fulfillment surge">
        <bpmn:documentation>Step 10: Post-sale order fulfillment surge: DC and store pick teams prioritize flash sale orders per SLA (BOPIS: 4 hours; delivery: 2–3 days); dedicated fulfillment queue for flash sale orders
Responsible (R): DC / Store Teams
Accountable (A): E-Commerce Manager
Duration: 24–72 hours post-sale</bpmn:documentation>
        <bpmn:incoming>W568_Flow34</bpmn:incoming>
        <bpmn:outgoing>W568_Flow35</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W568_Task20" name="Post-sale reconciliation (T+3 days)">
        <bpmn:documentation>Step 11: Post-sale reconciliation (T+3 days): reconcile sales vs. inventory allocation; identify oversells/undersells; payment reconciliation per W267; fraud review per W266 (flag orders with unusual patterns — bulk buying, new accounts, high-value)
Responsible (R): E-Commerce Manager / Finance
Accountable (A): E-Commerce Manager
Duration: 4–6 hours</bpmn:documentation>
        <bpmn:incoming>W568_Flow35</bpmn:incoming>
        <bpmn:outgoing>W568_Flow36</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W568_Task21" name="Post-sale performance report (T+7 days)">
        <bpmn:documentation>Step 12: Post-sale performance report (T+7 days): revenue, units sold, conversion rate, average discount depth, inventory sell-through %, customer acquisition (new vs. returning), fulfillment SLA compliance, fraud incidents, and ROI feeding into W565
Responsible (R): E-Commerce Manager
Accountable (A): VP E-Commerce
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W568_Flow36</bpmn:incoming>
