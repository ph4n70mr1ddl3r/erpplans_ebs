    <bpmn:process id="W_W940" name="W940. Ecommerce Customer Product Comparison Tool &amp; Buying Guide Content Management" isExecutable="false">
      <bpmn:documentation>Trigger: Customer uses the product comparison feature on buildright.com.ph, or Content Team creates/updates buying guides
Frequency: ~15,000–25,000 comparison sessions/month; ~2,000–3,000 buying guide views/month
Volume: ~50–80 active buying guides covering key categories; ~20–30 new guides or major updates per year
Owner: Ecommerce Merchandiser / Content Writer
Participants: Customer, Content Writer, Ecommerce Merchandiser, Category Manager, SEO Specialist
Source: workflow W940 — Ecommerce Customer Product Comparison Tool &amp; Buying Guide Content Management</bpmn:documentation>
      <bpmn:laneSet id="W940_LaneSet6">
        <bpmn:lane id="W940_Lane1" name="Customer">
        <bpmn:flowNodeRef>W940_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W940_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W940_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
