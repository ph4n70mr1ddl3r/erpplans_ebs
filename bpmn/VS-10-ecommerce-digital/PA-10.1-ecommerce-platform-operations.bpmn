        <bpmndi:BPMNShape id="W1287_Task9_di" bpmnElement="W1287_Task9"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1287_Task10_di" bpmnElement="W1287_Task10"><dc:Bounds x="1450" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1287_Start4_di" bpmnElement="W1287_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1287_End11_di" bpmnElement="W1287_End11"><dc:Bounds x="1680" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1287_Annotation12_di" bpmnElement="W1287_Annotation12"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1287_Flow14_di" bpmnElement="W1287_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1287_Flow15_di" bpmnElement="W1287_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1287_Flow16_di" bpmnElement="W1287_Flow16"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1287_Flow17_di" bpmnElement="W1287_Flow17"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1287_Flow18_di" bpmnElement="W1287_Flow18"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1287_Flow19_di" bpmnElement="W1287_Flow19"><di:waypoint x="1420" y="335" /><di:waypoint x="1450" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1287_Flow20_di" bpmnElement="W1287_Flow20"><di:waypoint x="1630" y="335" /><di:waypoint x="1680" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1287_Assoc13_di" bpmnElement="W1287_Assoc13"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1311" name="W1311. Negative-Review Quality-Pattern Escalation, Seller Response Governance &amp; Positive-Review Amplification" isExecutable="false">
      <bpmn:documentation>Trigger: Negative review (≤ 2 stars) posted; SKU quality-pattern alert (≥ 3 negative reviews within 30 days, or average rating &lt; 3.5 stars); or monthly review-governance cycle
Frequency: ~15–25 negative reviews/week requiring response; ~5–10 quality-pattern escalations/month; monthly analytics
Volume: ~2,000–3,000 reviews/month (aligned to the canonical W510 volume); average rating target: ≥ 4.2 stars across catalog
Owner: Ecommerce Manager
Participants: Ecommerce Manager, Category Manager, Customer Service Representative, Product Quality Analyst, Digital Marketing Specialist
Source: workflow W1311 — Negative-Review Quality-Pattern Escalation, Seller Response Governance &amp; Positive-Review Amplification</bpmn:documentation>
      <bpmn:laneSet id="W1311_LaneSet5">
        <bpmn:lane id="W1311_Lane1" name="System">
        <bpmn:flowNodeRef>W1311_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1311_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1311_Lane2" name="Customer Service Representative">
        <bpmn:flowNodeRef>W1311_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1311_Lane3" name="Ecommerce Manager">
        <bpmn:flowNodeRef>W1311_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1311_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1311_Lane4" name="Digital Marketing Specialist">
        <bpmn:flowNodeRef>W1311_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1311_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1311_Start6" name="Negative review (≤ 2 stars) posted; SKU quality-pattern alert (≥ 3 negative reviews…">
        <bpmn:outgoing>W1311_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1311_Task7" name="Review intake hand-off">
        <bpmn:documentation>Step 1: Review intake hand-off: review collection, verified-purchase checks and moderation are owned by W510 (steps 1–4, with the W1286 playbook detail); this workflow begins at the posted-review stage — its triggers are the ≤2-star alerts and quality-pattern thresholds raised there
Responsible (R): System
Accountable (A): Ecommerce Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1311_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1311_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1311_Task8" name="Negative review response &amp; escalation">
        <bpmn:documentation>Step 2: Negative review response &amp; escalation: (a) for reviews ≤ 2 stars: system triggers immediate alert to Customer Service Representative and Category Manager; (b) Customer Service Representative responds to negative review within 48 hours of posting per response template (the canonical W510 CX-response SLA): (i) acknowledge customer&#x27;s experience, (ii) apologize for the issue, (iii) offer resolution: replacement, refund, or store credit per W101/W781, (iv) provide customer service contact for direct follow-up; (c) Customer Service Representative logs review complaint in ticketing system (W258) for tracking; (d) for product quality complaints (item defective, not as described, wrong item): Category Manager investigates — check item master description accuracy per W252, check vendor quality records per W110, check if complaint is part of a pattern (multiple negative reviews for same SKU within 30 days)
Responsible (R): Customer Service Representative / Category Manager
Accountable (A): Ecommerce Manager
Duration: 15–30 min per negative review</bpmn:documentation>
        <bpmn:incoming>W1311_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1311_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1311_Task9" name="Product quality pattern escalation">
        <bpmn:documentation>Step 3: Product quality pattern escalation: (a) system monitors review trends: (i) any SKU receiving ≥ 3 negative reviews (≤ 2 stars) within 30 days triggers quality alert, (ii) any SKU&#x27;s average rating dropping below 3.5 stars triggers listing review, (iii) any product with &quot;not as described&quot; complaint pattern triggers description audit; (b) Ecommerce Manager escalates quality pattern to Category Manager: (i) review product images and description — does the online listing accurately represent the product?, (ii) review vendor quality data — is the vendor shipping substandard items?, (iii) if vendor quality issue: initiate vendor CAPA per W110, (iv) if listing accuracy issue: update product description and images immediately; (c) for severe quality issues (safety concern, widespread defect): Category Manager may temporarily suspend online sales of the item pending investigation per W873 (product recall assessment)
Responsible (R): Ecommerce Manager / Category Manager
Accountable (A): VP Merchandising
Duration: Per alert: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W1311_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1311_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1311_Task10" name="Positive review amplification">
        <bpmn:documentation>Step 4: Positive review amplification: (a) Digital Marketing Specialist identifies high-quality positive reviews (5 stars, detailed text, photos) for amplification: (i) feature on product page as &quot;Top Review&quot;, (ii) share on social media (Facebook, Instagram) per W142 with customer permission, (iii) use in marketing emails per W508 (review-based email campaigns: &quot;See what customers say about...&quot;), (iv) use review quotes in promotional materials; (b) monthly: compile top-rated products and feature in &quot;Customer Favorites&quot; section of website and email newsletter
Responsible (R): Digital Marketing Specialist
Accountable (A): Ecommerce Manager
Duration: 2–3 hours/week</bpmn:documentation>
        <bpmn:incoming>W1311_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1311_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1311_Task11" name="Monthly review analytics &amp; action">
        <bpmn:documentation>Step 5: Monthly review analytics &amp; action: (a) Ecommerce Manager compiles monthly review analytics: (i) total reviews submitted, published, and rejected, (ii) average rating by category and overall, (iii) response rate and response time for negative reviews (target: 100% response, &lt; 24 hours), (iv) top 10 most-reviewed products, (v) top 10 lowest-rated products with action taken, (vi) review conversion impact: products with reviews vs. without — conversion rate comparison, (vii) review generation rate: % of orders generating reviews (target: ≥ 15%); (b) share report with Category Managers for assortment and vendor quality actions; (c) identify categories with low review volume — implement review incentives (loyalty bonus points for verified reviews); weekly rating analytics are owned by W510 (step 7)
Responsible (R): Ecommerce Manager
Accountable (A): VP Marketing
Duration: 2–3 hours/month</bpmn:documentation>
        <bpmn:incoming>W1311_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1311_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1311_End12" name="Complete">
        <bpmn:incoming>W1311_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1311_Annotation13">
        <bpmn:text>Controls: - CTL-269 (ensure controlled execution — Ecommerce Platform Operations (PA-10.1).) | - operational: Ecommerce Manager review and approval gate
Owner: Ecommerce Manager</bpmn:text>
      </bpmn:textAnnotation>
