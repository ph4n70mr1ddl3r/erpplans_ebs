    <bpmn:process id="W_W563" name="W563. E-Commerce SEO &amp; Digital Merchandising Management" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly SEO review cycle; product content update; search algorithm change (Google core update); keyword ranking drop; new product category launch
Frequency: Weekly SEO review; continuous optimization; monthly comprehensive audit
Volume: 35,000 SKUs requiring SEO metadata; ~500–1,000 keyword optimizations per month; ~50–100 content refreshes per week
Owner: Digital Content Manager / SEO Specialist
Participants: SEO Specialist, Digital Content Manager, Product Content Writer, E-Commerce Manager (C), Category Manager (C for product knowledge)
Source: workflow W563 — E-Commerce SEO &amp; Digital Merchandising Management</bpmn:documentation>
      <bpmn:laneSet id="W563_LaneSet3">
        <bpmn:lane id="W563_Lane1" name="SEO Specialist">
        <bpmn:flowNodeRef>W563_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W563_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W563_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W563_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W563_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W563_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W563_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W563_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W563_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W563_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W563_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W563_Lane2" name="Product Content Writer">
        <bpmn:flowNodeRef>W563_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W563_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W563_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W563_Start4" name="Weekly SEO review cycle; product content update; search algorithm change (Google core…">
        <bpmn:outgoing>W563_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W563_Task5" name="Weekly keyword performance review: Google Search Console data pull for…">
        <bpmn:documentation>Step 1: Weekly keyword performance review: Google Search Console data pull for BuildRight.com.ph — track rankings, impressions, click-through rates, and positions for top 500 keywords
Responsible (R): SEO Specialist
Accountable (A): Digital Content Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W563_Flow20</bpmn:incoming>
        <bpmn:outgoing>W563_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W563_Task6" name="Identify declining rankings (dropped &gt; 5 positions week-over-week) and rising…">
        <bpmn:documentation>Step 2: Identify declining rankings (dropped &gt; 5 positions week-over-week) and rising opportunities (page 2 keywords approaching page 1); prioritize optimization targets
Responsible (R): SEO Specialist
Accountable (A): Digital Content Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W563_Flow21</bpmn:incoming>
        <bpmn:outgoing>W563_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W563_Task7" name="Product page audit: sample 50 product pages per week for SEO quality — title…">
        <bpmn:documentation>Step 3: Product page audit: sample 50 product pages per week for SEO quality — title tags, meta descriptions, H1 tags, alt text, schema markup (Product, AggregateRating, Offer)
Responsible (R): SEO Specialist
Accountable (A): Digital Content Manager
Duration: 3 hours</bpmn:documentation>
        <bpmn:incoming>W563_Flow22</bpmn:incoming>
        <bpmn:outgoing>W563_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W563_Task8" name="On-site search analysis: review BuildRight.com.ph internal search logs — top…">
        <bpmn:documentation>Step 4: On-site search analysis: review BuildRight.com.ph internal search logs — top 100 queries, zero-result searches, low-click searches; identify content gaps and navigation issues
Responsible (R): SEO Specialist
Accountable (A): E-Commerce Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W563_Flow23</bpmn:incoming>
        <bpmn:outgoing>W563_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W563_Task9" name="Content gap analysis: identify high-search-volume keywords where BuildRight has…">
        <bpmn:documentation>Step 5: Content gap analysis: identify high-search-volume keywords where BuildRight has no ranking page — create content briefs for Product Content Writer with target keyword, content format, and competitive benchmark
Responsible (R): SEO Specialist
Accountable (A): Digital Content Manager
Duration: 3 hours</bpmn:documentation>
        <bpmn:incoming>W563_Flow24</bpmn:incoming>
        <bpmn:outgoing>W563_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W563_Task10" name="Product Content Writer optimizes pages per brief: keyword-rich titles…">
        <bpmn:documentation>Step 6: Product Content Writer optimizes pages per brief: keyword-rich titles, benefit-focused descriptions, specification tables, FAQ sections, how-to guides for DIY categories
Responsible (R): Product Content Writer
Accountable (A): Digital Content Manager
Duration: 20 hours/week</bpmn:documentation>
        <bpmn:incoming>W563_Flow25</bpmn:incoming>
        <bpmn:outgoing>W563_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W563_Task11" name="Category page optimization: update category landing pages with seasonal content…">
        <bpmn:documentation>Step 7: Category page optimization: update category landing pages with seasonal content (per W264 seasonal calendar), curated collections, and buyer&#x27;s guides
Responsible (R): Product Content Writer / SEO Specialist
Accountable (A): Digital Content Manager
Duration: 4 hours/week</bpmn:documentation>
        <bpmn:incoming>W563_Flow26</bpmn:incoming>
        <bpmn:outgoing>W563_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W563_Task12" name="Technical SEO coordination with IT: page speed optimization, mobile…">
        <bpmn:documentation>Step 8: Technical SEO coordination with IT: page speed optimization, mobile responsiveness, structured data errors, crawl budget optimization, XML sitemap management
Responsible (R): SEO Specialist / IT
Accountable (A): E-Commerce Manager
Duration: 4 hours/week</bpmn:documentation>
        <bpmn:incoming>W563_Flow27</bpmn:incoming>
        <bpmn:outgoing>W563_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W563_Task13" name="Local SEO: update Google Business Profile for all 200 stores with accurate…">
        <bpmn:documentation>Step 9: Local SEO: update Google Business Profile for all 200 stores with accurate hours, services, photos, and BOPIS availability per W254 (location master)
Responsible (R): SEO Specialist
Accountable (A): Digital Content Manager
Duration: 2 hours/week</bpmn:documentation>
        <bpmn:incoming>W563_Flow28</bpmn:incoming>
        <bpmn:outgoing>W563_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W563_Task14" name="Monthly comprehensive SEO report: organic traffic, keyword rankings, conversion…">
        <bpmn:documentation>Step 10: Monthly comprehensive SEO report: organic traffic, keyword rankings, conversion rate from organic, revenue attribution, competitor benchmark (vs. Ace Hardware, CitiHardware, Wilcon)
Responsible (R): SEO Specialist
Accountable (A): E-Commerce Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W563_Flow29</bpmn:incoming>
        <bpmn:outgoing>W563_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W563_Task15" name="Quarterly SEO strategy review: update keyword targets, content calendar, and…">
        <bpmn:documentation>Step 11: Quarterly SEO strategy review: update keyword targets, content calendar, and technical roadmap; align with merchandising priorities and seasonal calendar (W264)
Responsible (R): SEO Specialist / Digital Content Manager
Accountable (A): E-Commerce Manager
Duration: 4 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W563_Flow30</bpmn:incoming>
        <bpmn:outgoing>W563_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W563_Task16" name="Annual SEO audit: full technical crawl, content quality assessment, backlink…">
        <bpmn:documentation>Step 12: Annual SEO audit: full technical crawl, content quality assessment, backlink profile review, algorithm update impact analysis; benchmark against prior year performance
Responsible (R): SEO Specialist
Accountable (A): E-Commerce Manager
Duration: 16 hours/year</bpmn:documentation>
        <bpmn:incoming>W563_Flow31</bpmn:incoming>
        <bpmn:outgoing>W563_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W563_End17" name="Complete">
        <bpmn:incoming>W563_Flow32</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W563_Annotation18">
        <bpmn:text>Controls: - CTL-269 (ensure controlled execution — Ecommerce Platform Operations (PA-10.1).) | - operational: Digital Content Manager / SEO Specialist review and approval gate
Owner: Digital Content Manager / SEO Specialist</bpmn:text>
      </bpmn:textAnnotation>
