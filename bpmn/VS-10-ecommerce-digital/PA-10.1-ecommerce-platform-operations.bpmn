        <bpmndi:BPMNEdge id="W98_Assoc25_di" bpmnElement="W98_Assoc25"><di:waypoint x="340" y="970" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W266" name="W266. Ecommerce Online Fraud Detection &amp; Prevention" isExecutable="false">
      <bpmn:documentation>Trigger: Online order placed on website/app (W11 / W19)
Frequency: Real-time, per online order (~1,500/day)
Volume: ~42,900 orders/month (per profile §8.5)
Owner: Fraud Prevention Specialist
Participants: System (Rules Engine), Fraud Prevention Specialist (Reviewer), Customer Service Representative, Payment Gateways (PayMongo, Dragonpay)
Source: workflow W266 — Ecommerce Online Fraud Detection &amp; Prevention</bpmn:documentation>
      <bpmn:laneSet id="W266_LaneSet5">
        <bpmn:lane id="W266_Lane1" name="Payment Gateway">
        <bpmn:flowNodeRef>W266_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W266_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W266_Lane2" name="System">
        <bpmn:flowNodeRef>W266_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W266_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W266_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W266_Lane3" name="Fraud Specialist">
        <bpmn:flowNodeRef>W266_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W266_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W266_Lane4" name="CSR">
        <bpmn:flowNodeRef>W266_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W266_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W266_Start6" name="Online order placed on website/app (W11 / W19)">
        <bpmn:outgoing>W266_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W266_Task7" name="Initial Transaction Screening">
        <bpmn:documentation>Step 1: Initial Transaction Screening: Customer submits online order; payment gateway executes 3D Secure 2.0 (3DS) authentication and initial card security check.
Responsible (R): Payment Gateway / System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W266_Flow17</bpmn:incoming>
        <bpmn:outgoing>W266_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W266_Task8" name="Risk Evaluation">
        <bpmn:documentation>Step 2: Risk Evaluation: ERP Fraud Rules Engine scores transaction based on pre-defined criteria: (a) device fingerprinting score, (b) IP location mismatch vs. shipping address, (c) high-risk email domain / guest checkout status, (d) purchase velocity per IP/email/card, (e) bulk high-risk SKUs in cart (e.g. power tools, copper wires).
Responsible (R): System
Accountable (A): Fraud Specialist
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W266_Flow18</bpmn:incoming>
        <bpmn:outgoing>W266_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W266_Task9" name="Order Queue Routing">
        <bpmn:documentation>Step 3: Order Queue Routing: System routes order based on risk score threshold: (a) Low Risk (&lt;50): Auto-approved, sent to picking queue (W11/W19); (b) Medium Risk (50–85): Held in fraud queue, email notification to specialist; (c) High Risk (&gt;85): Auto-cancelled and blocked.
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W266_Flow19</bpmn:incoming>
        <bpmn:outgoing>W266_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W266_Task10" name="Manual Fraud Review">
        <bpmn:documentation>Step 4: Manual Fraud Review: Fraud Prevention Specialist reviews medium-risk held orders: (a) cross-checks social media matching or directory listings, (b) checks address validation maps, (c) reviews previous order history for matching device fingerprint.
Responsible (R): Fraud Specialist
Accountable (A): Fraud Specialist
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W266_Flow20</bpmn:incoming>
        <bpmn:outgoing>W266_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W266_Task11" name="Customer Out-of-Band Verification">
        <bpmn:documentation>Step 5: Customer Out-of-Band Verification: If card/billing remains suspect, Specialist contacts customer via phone/email to verify order details (e.g. request proof of ID or secondary contact verification).
Responsible (R): CSR / Fraud Specialist
Accountable (A): Fraud Specialist
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W266_Flow21</bpmn:incoming>
        <bpmn:outgoing>W266_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W266_Task12" name="Dispositions &amp; Releases">
        <bpmn:documentation>Step 6: Dispositions &amp; Releases: Specialist records decision in dashboard: (a) Approved: releases order to picking queue; (b) Rejected: cancels order, initiates automatic payment void/refund per W101, and updates system blacklist.
Responsible (R): Fraud Specialist
Accountable (A): Store Mgr / Director
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W266_Flow22</bpmn:incoming>
        <bpmn:outgoing>W266_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W266_Task13" name="Feedback Loop &amp; Machine Learning">
        <bpmn:documentation>Step 7: Feedback Loop &amp; Machine Learning: System logs confirmed fraud or chargebacks to the blacklist table (IP, email, card hash, shipping address); updates rules engine parameters to adjust weights.
Responsible (R): System
Accountable (A): Fraud Specialist
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W266_Flow23</bpmn:incoming>
        <bpmn:outgoing>W266_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W266_End14" name="Complete">
        <bpmn:incoming>W266_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W266_Annotation15">
        <bpmn:text>Controls: - CTL-269 (ensure controlled execution — Ecommerce Platform Operations (PA-10.1).) | - operational: Fraud Prevention Specialist review and approval gate
Owner: Fraud Prevention Specialist</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W266_Assoc16" sourceRef="W266_Annotation15" targetRef="W266_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W266_Flow17" sourceRef="W266_Start6" targetRef="W266_Task7" />
      <bpmn:sequenceFlow id="W266_Flow18" sourceRef="W266_Task7" targetRef="W266_Task8" />
      <bpmn:sequenceFlow id="W266_Flow19" sourceRef="W266_Task8" targetRef="W266_Task9" />
      <bpmn:sequenceFlow id="W266_Flow20" sourceRef="W266_Task9" targetRef="W266_Task10" />
      <bpmn:sequenceFlow id="W266_Flow21" sourceRef="W266_Task10" targetRef="W266_Task11" />
      <bpmn:sequenceFlow id="W266_Flow22" sourceRef="W266_Task11" targetRef="W266_Task12" />
      <bpmn:sequenceFlow id="W266_Flow23" sourceRef="W266_Task12" targetRef="W266_Task13" />
      <bpmn:sequenceFlow id="W266_Flow24" sourceRef="W266_Task13" targetRef="W266_End14" />
    </bpmn:process>
