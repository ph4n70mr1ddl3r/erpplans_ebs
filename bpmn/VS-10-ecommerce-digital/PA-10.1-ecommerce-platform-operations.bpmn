    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W509" name="W509. Ecommerce Product Return Inspection, Grading &amp; Disposition" isExecutable="false">
      <bpmn:documentation>Trigger: Returned ecommerce item arrives at DC or designated store for inspection
Frequency: ~500–1,000 returned items/month (the W1623 canon: ~250–350 ecommerce return requests/month ≈ 0.6–0.8% of ~42,900 orders, ~2–3 items per return)
Volume: ~750 items/month average; peaks post-holiday and post-promo (+40%)
Owner: Returns Processing Supervisor (DC)
Participants: Returns Inspector, Category Specialist, AP Clerk (for vendor returns)
Source: workflow W509 — Ecommerce Product Return Inspection, Grading &amp; Disposition</bpmn:documentation>
      <bpmn:laneSet id="W509_LaneSet5">
        <bpmn:lane id="W509_Lane1" name="Returns Inspector">
        <bpmn:flowNodeRef>W509_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W509_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W509_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W509_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W509_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W509_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W509_Lane2" name="Category Specialist">
        <bpmn:flowNodeRef>W509_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W509_Lane3" name="System">
        <bpmn:flowNodeRef>W509_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W509_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W509_Lane4" name="Returns Supervisor">
        <bpmn:flowNodeRef>W509_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W509_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W509_Start6" name="Returned ecommerce item arrives at DC or designated store for inspection">
        <bpmn:outgoing>W509_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W509_Task7" name="Returned item received at DC returns processing area; Returns Inspector scans…">
        <bpmn:documentation>Step 1: Returned item received at DC returns processing area; Returns Inspector scans return order barcode; system retrieves original order details, item SKU, return reason, and customer-reported condition
Responsible (R): Returns Inspector
Accountable (A): Returns Supervisor
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W509_Flow19</bpmn:incoming>
        <bpmn:outgoing>W509_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W509_Task8" name="Returns Inspector performs physical inspection against grading criteria: (a)…">
        <bpmn:documentation>Step 2: Returns Inspector performs physical inspection against grading criteria: (a) Sealed/original packaging intact → proceed to Grade A check; (b) Opened but undamaged → detailed inspection; (c) Damaged packaging or item → Grade C candidate
Responsible (R): Returns Inspector
Accountable (A): Returns Supervisor
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W509_Flow20</bpmn:incoming>
        <bpmn:outgoing>W509_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W509_Task9" name="Grade A assessment: item is unused, all accessories/manuals present, original…">
        <bpmn:documentation>Step 3: Grade A assessment: item is unused, all accessories/manuals present, original tags attached, packaging intact; confirmed Grade A → system updates inventory status to &quot;available&quot; and returns to saleable stock
Responsible (R): Returns Inspector
Accountable (A): Returns Supervisor
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W509_Flow21</bpmn:incoming>
        <bpmn:outgoing>W509_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W509_Task10" name="Grade B assessment: item is unused but packaging opened, minor cosmetic damage…">
        <bpmn:documentation>Step 4: Grade B assessment: item is unused but packaging opened, minor cosmetic damage to packaging, missing non-essential accessory; confirmed Grade B → system creates discount listing on ecommerce &quot;open box&quot; section at 10–25% discount; inventory status &quot;open-box available&quot;
Responsible (R): Returns Inspector
Accountable (A): Category Specialist
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W509_Flow22</bpmn:incoming>
        <bpmn:outgoing>W509_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W509_Task11" name="Grade C assessment: item is damaged, defective, missing essential components…">
        <bpmn:documentation>Step 5: Grade C assessment: item is damaged, defective, missing essential components, or customer-reported malfunction; confirmed Grade C → system routes to disposition decision
Responsible (R): Returns Inspector
Accountable (A): Returns Supervisor
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W509_Flow23</bpmn:incoming>
        <bpmn:outgoing>W509_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W509_Task12" name="Grade C disposition decision: (a) Vendor-attributable defect → initiate RTV…">
        <bpmn:documentation>Step 6: Grade C disposition decision: (a) Vendor-attributable defect → initiate RTV (W88) with defect documentation; (b) Repairable (power tools, appliances) → route to service center (W440); (c) Non-recoverable → write-off with inventory adjustment (W92)
Responsible (R): Category Specialist
Accountable (A): Returns Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W509_Flow24</bpmn:incoming>
        <bpmn:outgoing>W509_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W509_Task13" name="System records grading decision with inspector ID, timestamp, photos, and…">
        <bpmn:documentation>Step 7: System records grading decision with inspector ID, timestamp, photos, and grading rationale; updates inventory status accordingly
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W509_Flow25</bpmn:incoming>
        <bpmn:outgoing>W509_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W509_Task14" name="Weekly: Returns Supervisor reviews return grading dashboard: Grade A/B/C…">
        <bpmn:documentation>Step 8: Weekly: Returns Supervisor reviews return grading dashboard: Grade A/B/C distribution by category, return reason correlation with grading, vendor defect rate from Grade C RTVs; identifies vendors with &gt;10% defect rate for CAPA (W110)
Responsible (R): Returns Supervisor
Accountable (A): GM, Digital Commerce Inc.
Duration: 2 hours/week</bpmn:documentation>
        <bpmn:incoming>W509_Flow26</bpmn:incoming>
        <bpmn:outgoing>W509_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W509_Task15" name="Monthly: system calculates return-to-saleable conversion rate (Grade A %)…">
        <bpmn:documentation>Step 9: Monthly: system calculates return-to-saleable conversion rate (Grade A %); tracks by category and vendor; feeds into vendor scorecard (W44) and category performance (W102)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W509_Flow27</bpmn:incoming>
        <bpmn:outgoing>W509_Flow28</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W509_End16" name="Complete">
        <bpmn:incoming>W509_Flow28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W509_Annotation17">
        <bpmn:text>Controls: - CTL-269 (ensure controlled execution — Ecommerce Platform Operations (PA-10.1).) | - operational: category-specific grading criteria with photo examples; operational: limiting open-box to ecommerce channel with clear &quot;open box&quot; labeling; operational: photo evidence and defect documentation at inspection
Owner: Returns Processing Supervisor (DC)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W509_Assoc18" sourceRef="W509_Annotation17" targetRef="W509_Start6" associationDirection="None" />
