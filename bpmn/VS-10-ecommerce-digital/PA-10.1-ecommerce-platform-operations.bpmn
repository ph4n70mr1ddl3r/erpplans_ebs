      <bpmn:sequenceFlow id="W98_Flow40" sourceRef="W98_Task21" targetRef="W98_Task22" />
      <bpmn:sequenceFlow id="W98_Flow41" sourceRef="W98_Task22" targetRef="W98_End23" />
    </bpmn:process>
