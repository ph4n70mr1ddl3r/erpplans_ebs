        <bpmn:flowNodeRef>W1359_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1359_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1359_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1359_Start4" name="New promotional pricing created in ERP merchandising module; or ecommerce platform price…">
        <bpmn:outgoing>W1359_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1359_Task5" name="Category Manager or Pricing Analyst creates promotional price record in ERP…">
        <bpmn:documentation>Step 1: Category Manager or Pricing Analyst creates promotional price record in ERP: promotional price, start datetime, end datetime, eligible channels (POS-only, ecommerce-only, or omnichannel), stacking rules
Responsible (R): Pricing Analyst
Accountable (A): Category Manager
Duration: 30 min/promotion</bpmn:documentation>
        <bpmn:incoming>W1359_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1359_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1359_Task6" name="System pushes promotional price to POS price file (continuous sync to 600…">
        <bpmn:documentation>Step 2: System pushes promotional price to POS price file (continuous sync to 600 terminals) and ecommerce product catalog API simultaneously
Responsible (R): System
Accountable (A): —
Duration: Near-real-time (&lt; 30 sec to POS via event streaming; &lt; 5 min to ecommerce via API)</bpmn:documentation>
        <bpmn:incoming>W1359_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1359_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1359_Task7" name="Pricing Analyst verifies price display on buildright.com.ph staging environment…">
        <bpmn:documentation>Step 3: Pricing Analyst verifies price display on buildright.com.ph staging environment before go-live; confirms correct promotional badge, original vs. discounted price display, and promotional period countdown timer
Responsible (R): Pricing Analyst
Accountable (A): —
Duration: 15 min/promotion</bpmn:documentation>
        <bpmn:incoming>W1359_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1359_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1359_Task8" name="System monitors price parity: daily automated comparison of ERP price master…">
        <bpmn:documentation>Step 4: System monitors price parity: daily automated comparison of ERP price master vs. ecommerce displayed price vs. POS price file for all promotional SKUs; generates discrepancy report
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1359_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1359_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1359_Task9" name="If discrepancy detected: Pricing Analyst investigates root cause (API timeout…">
        <bpmn:documentation>Step 5: If discrepancy detected: Pricing Analyst investigates root cause (API timeout, ecommerce cache lag, manual override at store level); resolves and triggers immediate re-sync
Responsible (R): Pricing Analyst
Accountable (A): Ecommerce Manager
Duration: 15–30 min/incident</bpmn:documentation>
        <bpmn:incoming>W1359_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1359_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1359_Task10" name="Post-promotion: System automatically reverts all promotional prices to standard…">
        <bpmn:documentation>Step 6: Post-promotion: System automatically reverts all promotional prices to standard SRP at promotion end datetime; Pricing Analyst verifies reversion on both channels
Responsible (R): System / Pricing Analyst
Accountable (A): Category Manager
Duration: 15 min/promotion</bpmn:documentation>
        <bpmn:incoming>W1359_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1359_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1359_Task11" name="Monthly price parity audit: Pricing Analyst samples 100 SKUs across both…">
        <bpmn:documentation>Step 7: Monthly price parity audit: Pricing Analyst samples 100 SKUs across both channels; confirms POS price matches ecommerce price for omnichannel promotions; reports findings to Category Manager
Responsible (R): Pricing Analyst
Accountable (A): VP Merchandising
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1359_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1359_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1359_End12" name="Complete">
        <bpmn:incoming>W1359_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1359_Annotation13">
        <bpmn:text>Controls: - CTL-269 (ensure controlled execution — Ecommerce Platform Operations (PA-10.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Pricing Analyst</bpmn:text>
      </bpmn:textAnnotation>
