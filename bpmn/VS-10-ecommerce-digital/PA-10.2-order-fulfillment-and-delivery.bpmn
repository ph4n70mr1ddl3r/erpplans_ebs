      <bpmn:sequenceFlow id="W1234_Flow19" sourceRef="W1234_Task9" targetRef="W1234_Task10" />
      <bpmn:sequenceFlow id="W1234_Flow20" sourceRef="W1234_Task10" targetRef="W1234_Task11" />
      <bpmn:sequenceFlow id="W1234_Flow21" sourceRef="W1234_Task11" targetRef="W1234_Task12" />
      <bpmn:sequenceFlow id="W1234_Flow22" sourceRef="W1234_Task12" targetRef="W1234_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1234_diag">
      <bpmndi:BPMNPlane id="W1234_plane" bpmnElement="W_W1234">
        <bpmndi:BPMNShape id="W1234_Lane1_di" bpmnElement="W1234_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1234_Lane2_di" bpmnElement="W1234_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1234_Lane3_di" bpmnElement="W1234_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1580" height="170" /></bpmndi:BPMNShape>
