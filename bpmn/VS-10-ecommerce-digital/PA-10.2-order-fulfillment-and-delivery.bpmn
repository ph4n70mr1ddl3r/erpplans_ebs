Responsible (R): Stock Associate
Accountable (A): Dept. Supervisor
Duration: 5–15 min/order</bpmn:documentation>
        <bpmn:incoming>W11_Flow24</bpmn:incoming>
        <bpmn:outgoing>W11_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W11_Task11" name="If item not in stock at store: system offers substitution or cancels line…">
