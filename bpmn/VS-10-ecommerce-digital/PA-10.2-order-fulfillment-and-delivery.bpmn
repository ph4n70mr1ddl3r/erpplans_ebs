        <bpmn:outgoing>W11_Flow21</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W11_Task7" name="Customer places order on website/app; selects pickup store; pays online">
        <bpmn:documentation>Step 1: Customer places order on website/app; selects pickup store; pays online
Responsible (R): Customer
Accountable (A): —
Duration: —</bpmn:documentation>
        <bpmn:incoming>W11_Flow21</bpmn:incoming>
