      <bpmndi:BPMNPlane id="W246_plane" bpmnElement="W_W246">
        <bpmndi:BPMNShape id="W246_Lane1_di" bpmnElement="W246_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
