      <bpmn:sequenceFlow id="W899_Flow18" sourceRef="W899_Task8" targetRef="W899_Task9" />
      <bpmn:sequenceFlow id="W899_Flow19" sourceRef="W899_Task9" targetRef="W899_Task10" />
      <bpmn:sequenceFlow id="W899_Flow20" sourceRef="W899_Task10" targetRef="W899_Task11" />
      <bpmn:sequenceFlow id="W899_Flow21" sourceRef="W899_Task11" targetRef="W899_Task12" />
      <bpmn:sequenceFlow id="W899_Flow22" sourceRef="W899_Task12" targetRef="W899_End13" />
    </bpmn:process>
