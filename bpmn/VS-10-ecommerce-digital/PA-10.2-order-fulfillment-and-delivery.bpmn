    </bpmn:process>
    <bpmndi:BPMNDiagram id="W829_diag">
      <bpmndi:BPMNPlane id="W829_plane" bpmnElement="W_W829">
        <bpmndi:BPMNShape id="W829_Lane1_di" bpmnElement="W829_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2210" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W829_Lane2_di" bpmnElement="W829_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="2210" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W829_Lane3_di" bpmnElement="W829_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="2210" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W829_Task6_di" bpmnElement="W829_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W829_Task7_di" bpmnElement="W829_Task7"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
