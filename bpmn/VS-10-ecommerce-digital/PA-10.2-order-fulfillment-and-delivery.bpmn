    <bpmn:process id="W_W246" name="W246. Drop-Ship Vendor (DSV) Order Fulfillment" isExecutable="false">
      <bpmn:documentation>Trigger: Customer orders a specialty, custom, or bulk direct-ship item (custom glass panels, premium cabinets, industrial pumps) on website or POS
Frequency: ~200–400 orders/month chain-wide
Volume: Avg PHP 20,000–100,000 per order
Owner: Ecommerce Fulfillment Manager
Participants: System, Drop-Ship Vendor (DSV), CSR, virtual Receiving Clerk, Finance (AP)
Source: workflow W246 — Drop-Ship Vendor (DSV) Order Fulfillment</bpmn:documentation>
      <bpmn:laneSet id="W246_LaneSet3">
        <bpmn:lane id="W246_Lane1" name="System">
        <bpmn:flowNodeRef>W246_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W246_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W246_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W246_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W246_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W246_Lane2" name="Vendor">
        <bpmn:flowNodeRef>W246_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W246_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W246_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W246_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W246_Start4" name="Customer orders a specialty, custom, or bulk direct-ship item (custom glass panels…">
        <bpmn:outgoing>W246_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W246_Task5" name="Order Route">
        <bpmn:documentation>Step 1: Order Route: Customer places order; system identifies SKU as Drop-Ship in Item Master; processes payment; split-routes order to generate back-to-back PO
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W246_Flow15</bpmn:incoming>
        <bpmn:outgoing>W246_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W246_Task6" name="Vendor Intake">
        <bpmn:documentation>Step 2: Vendor Intake: PO automatically transmitted to the accredited Drop-Ship Vendor via EDI/Vendor Portal; vendor confirms stock and production timeline within 24 hours
Responsible (R): Vendor
Accountable (A): Ecommerce Fulfillment Mgr
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W246_Flow16</bpmn:incoming>
        <bpmn:outgoing>W246_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W246_Task7" name="Fulfillment &amp; Labeling">
        <bpmn:documentation>Step 3: Fulfillment &amp; Labeling: Vendor picks/produces item; prints co-branded BuildRight packing slip and co-branded shipping label from Vendor Portal
Responsible (R): Vendor
Accountable (A): —
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W246_Flow17</bpmn:incoming>
        <bpmn:outgoing>W246_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W246_Task8" name="Dispatch">
        <bpmn:documentation>Step 4: Dispatch: Vendor dispatches package directly to customer&#x27;s address using co-branded carrier; enters tracking number in Vendor Portal
Responsible (R): Vendor
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W246_Flow18</bpmn:incoming>
        <bpmn:outgoing>W246_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W246_Task9" name="Transit Sync">
        <bpmn:documentation>Step 5: Transit Sync: System automatically imports tracking status via carrier APIs; triggers tracking updates and SMS alerts to the customer
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W246_Flow19</bpmn:incoming>
        <bpmn:outgoing>W246_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W246_Task10" name="Virtual Receipt">
        <bpmn:documentation>Step 6: Virtual Receipt: Upon carrier delivery confirmation (POD signature): system automatically posts a &quot;Virtual Goods Receipt&quot; in ERP; triggers sales revenue recognition
Responsible (R): System
Accountable (A): virtual Receiving Clerk
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W246_Flow20</bpmn:incoming>
        <bpmn:outgoing>W246_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W246_Task11" name="Invoice &amp; Reconciliation">
        <bpmn:documentation>Step 7: Invoice &amp; Reconciliation: Vendor submits invoice via Portal; system performs 3-way match (PO vs. Virtual GR vs. Invoice); routes to AP for payment settlement (W7)
Responsible (R): System / Finance
Accountable (A): Accountant
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W246_Flow21</bpmn:incoming>
        <bpmn:outgoing>W246_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W246_End12" name="Complete">
        <bpmn:incoming>W246_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W246_Annotation13">
        <bpmn:text>Controls: - CTL-270 (ensure controlled execution — Order Fulfillment &amp; Delivery (PA-10.2).) | - operational: only shows the vendor&#x27;s stock status at the point of PO creation
Owner: Ecommerce Fulfillment Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W246_Assoc14" sourceRef="W246_Annotation13" targetRef="W246_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W246_Flow15" sourceRef="W246_Start4" targetRef="W246_Task5" />
      <bpmn:sequenceFlow id="W246_Flow16" sourceRef="W246_Task5" targetRef="W246_Task6" />
      <bpmn:sequenceFlow id="W246_Flow17" sourceRef="W246_Task6" targetRef="W246_Task7" />
      <bpmn:sequenceFlow id="W246_Flow18" sourceRef="W246_Task7" targetRef="W246_Task8" />
      <bpmn:sequenceFlow id="W246_Flow19" sourceRef="W246_Task8" targetRef="W246_Task9" />
      <bpmn:sequenceFlow id="W246_Flow20" sourceRef="W246_Task9" targetRef="W246_Task10" />
      <bpmn:sequenceFlow id="W246_Flow21" sourceRef="W246_Task10" targetRef="W246_Task11" />
      <bpmn:sequenceFlow id="W246_Flow22" sourceRef="W246_Task11" targetRef="W246_End12" />
    </bpmn:process>
