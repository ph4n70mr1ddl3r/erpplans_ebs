    <bpmn:process id="W_W11" name="W11. Ecommerce — BOPIS Order Fulfillment" isExecutable="false">
      <bpmn:documentation>Trigger: Customer places BOPIS order on website/app
Frequency: ~25,700 BOPIS orders/month; ~857/day
Volume: Avg 3–4 items per order
Owner: Customer Service Rep (in-store)
Participants: System (order routing), Stock Associate (picker), Customer Service Rep (handoff), Customer
Source: workflow W11 — Ecommerce — BOPIS Order Fulfillment</bpmn:documentation>
      <bpmn:laneSet id="W11_LaneSet5">
        <bpmn:lane id="W11_Lane1" name="Customer">
