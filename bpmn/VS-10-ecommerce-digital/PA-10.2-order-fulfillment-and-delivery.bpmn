        <bpmndi:BPMNShape id="W1155_Task10_di" bpmnElement="W1155_Task10"><dc:Bounds x="1030" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1155_Start6_di" bpmnElement="W1155_Start6"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1155_End11_di" bpmnElement="W1155_End11"><dc:Bounds x="1260" y="657" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1155_Annotation12_di" bpmnElement="W1155_Annotation12"><dc:Bounds x="160" y="800" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1155_Flow14_di" bpmnElement="W1155_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1155_Flow15_di" bpmnElement="W1155_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1155_Flow16_di" bpmnElement="W1155_Flow16"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1155_Flow17_di" bpmnElement="W1155_Flow17"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1155_Flow18_di" bpmnElement="W1155_Flow18"><di:waypoint x="1210" y="675" /><di:waypoint x="1260" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1155_Assoc13_di" bpmnElement="W1155_Assoc13"><di:waypoint x="340" y="800" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1195" name="W1195. Mixed-Basket Multi-Origin Order Orchestration &amp; Split Shipment Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Customer places ecommerce order containing items available from multiple fulfillment origins (DC, store, drop-ship vendor)
Frequency: ~7–12% of ecommerce orders (the multi-origin share, per W534) are mixed-basket (multi-origin)
Volume: ~12,000–17,000 mixed-basket orders/month (of ~42,900 total ecommerce orders)
Owner: Ecommerce Operations Manager
Participants: Ecommerce Ops Manager, DC Warehouse, Store Stock Associate, Drop-Ship Vendor, Logistics Manager, Customer
Source: workflow W1195 — Mixed-Basket Multi-Origin Order Orchestration &amp; Split Shipment Coordination</bpmn:documentation>
      <bpmn:laneSet id="W1195_LaneSet3">
        <bpmn:lane id="W1195_Lane1" name="System">
        <bpmn:flowNodeRef>W1195_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1195_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1195_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1195_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1195_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1195_Lane2" name="Ecommerce Ops Manager">
        <bpmn:flowNodeRef>W1195_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1195_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1195_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1195_Start4" name="Customer places ecommerce order containing items available from multiple fulfillment…">
        <bpmn:outgoing>W1195_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1195_Task5" name="Order intake and origin determination">
        <bpmn:documentation>Step 1: Order intake and origin determination: At order placement: system checks inventory availability across all fulfillment origins: (a) DC inventory (standard pick/pack/ship items), (b) store inventory (bulky items, lumber, cement — only available from stores with forklift/loading capability), (c) drop-ship vendor inventory (DSV items per W246); system determines optimal split based on: (i) item availability, (ii) delivery speed (nearest origin to customer), (iii) shipping cost optimization (minimize number of shipments), (iv) item compatibility (hazardous items cannot ship with standard items per W82)
Responsible (R): System
Accountable (A): —
Duration: Automated (&lt; 10 sec)</bpmn:documentation>
        <bpmn:incoming>W1195_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1195_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1195_Task6" name="Split order creation">
        <bpmn:documentation>Step 2: Split order creation: System creates parent order with child shipment orders: (a) Child Order A — DC-origin items (fulfilled per W19), (b) Child Order B — Store-origin items (fulfilled per W19B or W1196), (c) Child Order C — DSV-origin items (fulfilled per W246); each child order has independent fulfillment SLA but unified customer-facing tracking
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1195_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1195_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1195_Task7" name="Delivery coordination">
        <bpmn:documentation>Step 3: Delivery coordination: For mixed-basket orders where DC and store shipments arrive on different days: (a) if customer selects BOPIS: system holds all items at store until complete order is ready for single pickup, (b) if customer selects delivery: system schedules deliveries to arrive on same day when possible; if not possible, system communicates partial delivery to customer per W829 with estimated arrival of remaining items
Responsible (R): Ecommerce Ops Manager
Accountable (A): —
Duration: 5 min/order</bpmn:documentation>
        <bpmn:incoming>W1195_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1195_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1195_Task8" name="Unified tracking presentation">
        <bpmn:documentation>Step 4: Unified tracking presentation: Customer sees single order tracking page showing all child shipments with individual tracking numbers, origins, and ETAs; system sends consolidated status updates: &quot;2 of 3 shipments dispatched,&quot; &quot;1 of 3 shipments delivered,&quot; &quot;Order complete&quot;
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1195_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1195_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1195_Task9" name="Exception handling">
        <bpmn:documentation>Step 5: Exception handling: If any child shipment is delayed or cancelled: (a) system alerts Ecommerce Ops Manager, (b) customer is proactively notified per W829 with options: wait for delayed item, cancel delayed item for refund, or substitute with available alternative, (c) if customer cancels: partial refund processed immediately, remaining shipments proceed
Responsible (R): Ecommerce Ops Manager
Accountable (A): —
Duration: 10 min/exception</bpmn:documentation>
        <bpmn:incoming>W1195_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1195_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1195_Task10" name="Settlement reconciliation">
        <bpmn:documentation>Step 6: Settlement reconciliation: System tracks cost allocation per child shipment: (a) DC fulfillment cost, (b) store fulfillment cost (labor allocation), (c) DSV fulfillment fee, (d) delivery cost per shipment; reconciles total fulfillment cost against order margin for profitability analysis
Responsible (R): System / Finance
Accountable (A): Controller
Duration: Automated + 1 hour/week</bpmn:documentation>
        <bpmn:incoming>W1195_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1195_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1195_End11" name="Complete">
        <bpmn:incoming>W1195_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1195_Annotation12">
        <bpmn:text>Controls: - CTL-270 (ensure controlled execution — Order Fulfillment &amp; Delivery (PA-10.2).) | - operational: unified tracking page and proactive communication in Step 4; operational: cost optimization in Step 1 and minimum order thresholds for free delivery; operational: real-time inventory reservation at order placement and exception handling in Step 5
Owner: Ecommerce Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1195_Assoc13" sourceRef="W1195_Annotation12" targetRef="W1195_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1195_Flow14" sourceRef="W1195_Start4" targetRef="W1195_Task5" />
      <bpmn:sequenceFlow id="W1195_Flow15" sourceRef="W1195_Task5" targetRef="W1195_Task6" />
      <bpmn:sequenceFlow id="W1195_Flow16" sourceRef="W1195_Task6" targetRef="W1195_Task7" />
      <bpmn:sequenceFlow id="W1195_Flow17" sourceRef="W1195_Task7" targetRef="W1195_Task8" />
      <bpmn:sequenceFlow id="W1195_Flow18" sourceRef="W1195_Task8" targetRef="W1195_Task9" />
      <bpmn:sequenceFlow id="W1195_Flow19" sourceRef="W1195_Task9" targetRef="W1195_Task10" />
      <bpmn:sequenceFlow id="W1195_Flow20" sourceRef="W1195_Task10" targetRef="W1195_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1195_diag">
      <bpmndi:BPMNPlane id="W1195_plane" bpmnElement="W_W1195">
        <bpmndi:BPMNShape id="W1195_Lane1_di" bpmnElement="W1195_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1195_Lane2_di" bpmnElement="W1195_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1195_Task5_di" bpmnElement="W1195_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1195_Task6_di" bpmnElement="W1195_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
