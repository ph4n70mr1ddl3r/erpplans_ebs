        <bpmn:documentation>Step 8: Customer arrives at Customer Service counter; presents ID and order number
Responsible (R): Customer
Accountable (A): —
Duration: —</bpmn:documentation>
        <bpmn:incoming>W11_Flow28</bpmn:incoming>
        <bpmn:outgoing>W11_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W11_Task15" name="Customer Service Rep verifies ID; scans order; releases items">
        <bpmn:documentation>Step 9: Customer Service Rep verifies ID; scans order; releases items
Responsible (R): CSR
Accountable (A): Store Manager
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W11_Flow29</bpmn:incoming>
        <bpmn:outgoing>W11_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W11_Task16" name="System marks order as &quot;Completed&quot;; inventory deducted">
        <bpmn:documentation>Step 10: System marks order as &quot;Completed&quot;; inventory deducted
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W11_Flow30</bpmn:incoming>
        <bpmn:outgoing>W11_Flow31</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W11_Task17" name="If not picked up within 5 days: auto-cancel; refund initiated; items returned…">
        <bpmn:documentation>Step 11: If not picked up within 5 days: auto-cancel; refund initiated; items returned to shelf
Responsible (R): System
Accountable (A): CSR
Duration: Automated (return: 5 min)</bpmn:documentation>
        <bpmn:incoming>W11_Flow31</bpmn:incoming>
        <bpmn:outgoing>W11_Flow32</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W11_End18" name="Complete">
        <bpmn:incoming>W11_Flow32</bpmn:incoming>
