    <bpmn:process id="W_W1155" name="W1155. Customer Ecommerce Same-Day / Express Delivery Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Customer selects same-day or express delivery option at ecommerce checkout
Frequency: ~3,000–5,000 same-day/express orders/month (projected ~10% of ecommerce orders at maturity)
Volume: 1 order per transaction; average 1–5 line items
Owner: Ecommerce Operations Manager (HQ)
Participants: Ecommerce Operations Coordinator, Store Fulfillment Team (ship-from-store), 3PL Express Courier, Customer
Source: workflow W1155 — Customer Ecommerce Same-Day / Express Delivery Operations</bpmn:documentation>
      <bpmn:laneSet id="W1155_LaneSet5">
        <bpmn:lane id="W1155_Lane1" name="System">
        <bpmn:flowNodeRef>W1155_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1155_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1155_Lane2" name="Store Fulfillment Associate">
        <bpmn:flowNodeRef>W1155_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1155_Lane3" name="Express Courier">
        <bpmn:flowNodeRef>W1155_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1155_Lane4" name="Ecommerce Operations Coordinator">
        <bpmn:flowNodeRef>W1155_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1155_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1155_Start6" name="Customer selects same-day or express delivery option at ecommerce checkout">
        <bpmn:outgoing>W1155_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1155_Task7" name="Express Order Receipt &amp; Fulfillment Store Selection">
        <bpmn:documentation>Step 1: Express Order Receipt &amp; Fulfillment Store Selection: (a) customer selects same-day or express delivery at checkout, pays express delivery surcharge (same-day: PHP 150–300 based on distance; next-day: PHP 99–150); (b) system evaluates fulfillment options: ship-from-store (W19B) — checks nearest store inventory for all line items, if available → same-day eligible; DC fulfillment — standard delivery only (2–5 days), not eligible for same-day; (c) if nearest store has all items: order routed to that store for immediate pick &amp; pack; (d) if nearest store is out of stock on some items: system checks next-nearest store or offers partial shipment with express items delivered same-day and remainder on standard delivery; (e) order appears in store fulfillment queue with EXPRESS priority flag and cutoff time
Responsible (R): System
Accountable (A): Ecommerce Operations Manager
Duration: Automated (&lt; 30 sec)</bpmn:documentation>
        <bpmn:incoming>W1155_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1155_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1155_Task8" name="Store-Level Priority Pick &amp; Pack">
        <bpmn:documentation>Step 2: Store-Level Priority Pick &amp; Pack: (a) store fulfillment associate receives express order notification on mobile device with audible alert; (b) associate picks items from shelf within 30 minutes of order receipt (vs. standard 2-hour pick SLA for BOPIS); (c) items scanned for accuracy and packed in appropriate packaging: fragile items (tiles, light fixtures) — bubble wrap and reinforced box; heavy items (cement, paint) — double-bagged or boxed; long items (lumber, pipes) — wrapped in protective covering; (d) pack confirmation scanned in system; (e) order staged in express pickup area separate from standard BOPIS/ship-from-store staging
Responsible (R): Store Fulfillment Associate
Accountable (A): Store Manager
Duration: 20–30 min</bpmn:documentation>
        <bpmn:incoming>W1155_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1155_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1155_Task9" name="Express Courier Dispatch &amp; Delivery">
        <bpmn:documentation>Step 3: Express Courier Dispatch &amp; Delivery: (a) system automatically dispatches express courier (Lalamove, Transportify, or GrabExpress for same-day; BuildRight&#x27;s own scheduled fleet for next-day) based on vehicle requirement and delivery distance; (b) courier receives pickup notification with store address, order number, and package details; (c) courier arrives at store, presents ID and order number; store associate hands over package and scans handoff; (d) real-time tracking link sent to customer via SMS/app; (e) delivery SLA: same-day orders placed by 10 AM delivered by 6 PM; next-day orders delivered by 12 PM; (f) delivery confirmation via digital POD with customer signature and photo
Responsible (R): Express Courier / Store Fulfillment Associate
Accountable (A): Ecommerce Operations Manager
Duration: 1–4 hours (pickup + delivery)</bpmn:documentation>
        <bpmn:incoming>W1155_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1155_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1155_Task10" name="Exception Handling &amp; Performance Monitoring">
        <bpmn:documentation>Step 4: Exception Handling &amp; Performance Monitoring: (a) if store cannot fulfill within express SLA (stock discrepancy, item damaged): customer notified immediately with options — substitute item (per W279 substitution rules), cancel and refund, or downgrade to standard delivery with delivery fee refund; (b) if courier delay exceeds SLA by &gt;2 hours: customer notified with updated ETA and delivery fee refund; (c) daily express performance dashboard: on-time delivery rate (target: ≥95%), average delivery time, fulfillment success rate, customer satisfaction rating, delivery cost per order; (d) weekly review with 3PL express partners per W242 (3PL performance review)
Responsible (R): Ecommerce Operations Coordinator
Accountable (A): Ecommerce Operations Manager
Duration: 30–60 min/day</bpmn:documentation>
        <bpmn:incoming>W1155_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1155_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1155_End11" name="Complete">
        <bpmn:incoming>W1155_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1155_Annotation12">
        <bpmn:text>Controls: - CTL-270 (ensure controlled execution — Order Fulfillment &amp; Delivery (PA-10.2).) | - operational: shows stock but physical shelf is empty, order fails
Owner: Ecommerce Operations Manager (HQ)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1155_Assoc13" sourceRef="W1155_Annotation12" targetRef="W1155_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1155_Flow14" sourceRef="W1155_Start6" targetRef="W1155_Task7" />
      <bpmn:sequenceFlow id="W1155_Flow15" sourceRef="W1155_Task7" targetRef="W1155_Task8" />
      <bpmn:sequenceFlow id="W1155_Flow16" sourceRef="W1155_Task8" targetRef="W1155_Task9" />
      <bpmn:sequenceFlow id="W1155_Flow17" sourceRef="W1155_Task9" targetRef="W1155_Task10" />
      <bpmn:sequenceFlow id="W1155_Flow18" sourceRef="W1155_Task10" targetRef="W1155_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1155_diag">
      <bpmndi:BPMNPlane id="W1155_plane" bpmnElement="W_W1155">
        <bpmndi:BPMNShape id="W1155_Lane1_di" bpmnElement="W1155_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1155_Lane2_di" bpmnElement="W1155_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1155_Lane3_di" bpmnElement="W1155_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1155_Lane4_di" bpmnElement="W1155_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1160" height="170" /></bpmndi:BPMNShape>
