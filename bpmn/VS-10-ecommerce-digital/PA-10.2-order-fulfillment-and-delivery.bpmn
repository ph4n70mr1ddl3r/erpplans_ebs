      <bpmn:sequenceFlow id="W1196_Flow19" sourceRef="W1196_Task8" targetRef="W1196_Task9" />
      <bpmn:sequenceFlow id="W1196_Flow20" sourceRef="W1196_Task9" targetRef="W1196_Task10" />
      <bpmn:sequenceFlow id="W1196_Flow21" sourceRef="W1196_Task10" targetRef="W1196_Task11" />
      <bpmn:sequenceFlow id="W1196_Flow22" sourceRef="W1196_Task11" targetRef="W1196_Task12" />
      <bpmn:sequenceFlow id="W1196_Flow23" sourceRef="W1196_Task12" targetRef="W1196_End13" />
    </bpmn:process>
