        <bpmndi:BPMNShape id="W724_Start5_di" bpmnElement="W724_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W724_End12_di" bpmnElement="W724_End12"><dc:Bounds x="1680" y="487" width="36" height="36" /></bpmndi:BPMNShape>
