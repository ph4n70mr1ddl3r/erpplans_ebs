      <bpmndi:BPMNPlane id="W724_plane" bpmnElement="W_W724">
        <bpmndi:BPMNShape id="W724_Lane1_di" bpmnElement="W724_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
