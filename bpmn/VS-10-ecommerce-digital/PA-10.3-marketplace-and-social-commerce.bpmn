      <bpmn:sequenceFlow id="W5550_Flow20" sourceRef="W5550_Task8" targetRef="W5550_Task9" />
      <bpmn:sequenceFlow id="W5550_Flow21" sourceRef="W5550_Task9" targetRef="W5550_Task10" />
      <bpmn:sequenceFlow id="W5550_Flow22" sourceRef="W5550_Task10" targetRef="W5550_Task11" />
      <bpmn:sequenceFlow id="W5550_Flow23" sourceRef="W5550_Task11" targetRef="W5550_Task12" />
      <bpmn:sequenceFlow id="W5550_Flow24" sourceRef="W5550_Task12" targetRef="W5550_Task13" />
      <bpmn:sequenceFlow id="W5550_Flow25" sourceRef="W5550_Task13" targetRef="W5550_End14" />
    </bpmn:process>
