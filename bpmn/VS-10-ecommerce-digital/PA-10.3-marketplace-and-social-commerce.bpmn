    <bpmn:process id="W_W1463" name="W1463. TikTok Shop Integration, Content-to-Commerce &amp; Livestream Selling Operations" isExecutable="false">
      <bpmn:documentation>Trigger: TikTok Shop order; or scheduled livestream selling event
Frequency: Daily order management; weekly livestream events (1–2/week)
Volume: ~3,000–5,000 TikTok Shop orders/month; livestream events generate 200–500 orders each
Owner: Ecommerce Operations Manager
Participants: Social Commerce Specialist, Content Creator, DC Picker, TikTok Logistics Partner
Source: workflow W1463 — TikTok Shop Integration, Content-to-Commerce &amp; Livestream Selling Operations</bpmn:documentation>
      <bpmn:laneSet id="W1463_LaneSet4">
        <bpmn:lane id="W1463_Lane1" name="Social Commerce Specialist">
        <bpmn:flowNodeRef>W1463_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1463_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1463_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1463_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1463_Lane2" name="Content Creator">
        <bpmn:flowNodeRef>W1463_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1463_Lane3" name="Ecommerce Ops Manager">
        <bpmn:flowNodeRef>W1463_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1463_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1463_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1463_Start5" name="TikTok Shop order; or scheduled livestream selling event">
        <bpmn:outgoing>W1463_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1463_Task6" name="Catalog sync">
        <bpmn:documentation>Step 1: Catalog sync: Syndicate approved listings to TikTok Shop every 4 hours; new listings with category tags (#BuildRightPH #DIY)
Responsible (R): Social Commerce Specialist
Accountable (A): Ecommerce Ops Manager
Duration: 1–2 hours/week</bpmn:documentation>
        <bpmn:incoming>W1463_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1463_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1463_Task7" name="Content creation">
        <bpmn:documentation>Step 2: Content creation: Create 15–60 sec videos (product demos, quick tips, before/after); tag with shoppable links
Responsible (R): Social Commerce Specialist
Accountable (A): Ecommerce Ops Manager
Duration: 8–10 hours/week</bpmn:documentation>
        <bpmn:incoming>W1463_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1463_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1463_Task8" name="Livestream preparation">
        <bpmn:documentation>Step 3: Livestream preparation: Schedule 1–2×/week (Thursday 7–9 PM, Saturday 10 AM–12 PM); select 10–15 products; prepare demos and flash deals
Responsible (R): Social Commerce Specialist
Accountable (A): Ecommerce Ops Manager
Duration: 4 hours/session</bpmn:documentation>
        <bpmn:incoming>W1463_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1463_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1463_Task9" name="Livestream execution">
        <bpmn:documentation>Step 4: Livestream execution: Host conducts live demo with Q&amp;A; post shoppable links; activate flash deals; 60–90 min per session
Responsible (R): Content Creator
Accountable (A): Ecommerce Ops Manager
Duration: 90 min/session</bpmn:documentation>
        <bpmn:incoming>W1463_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1463_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1463_Task10" name="Order fulfillment">
        <bpmn:documentation>Step 5: Order fulfillment: Orders pushed to ERP via middleware (same as W180); DC pick/pack/ship per W19; tracking pushed to TikTok Shop
Responsible (R): Ecommerce Ops Manager / DC Picker
Accountable (A): —
Duration: Per W19</bpmn:documentation>
        <bpmn:incoming>W1463_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1463_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1463_Task11" name="Weekly performance review">
        <bpmn:documentation>Step 6: Weekly performance review: Revenue, orders, AOV, top videos/sessions, return rate (8–12% for impulse purchases), CAC vs. Lazada/Shopee
Responsible (R): Ecommerce Ops Manager
Accountable (A): CMO
Duration: 1 hour/week</bpmn:documentation>
        <bpmn:incoming>W1463_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1463_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1463_End12" name="Complete">
        <bpmn:incoming>W1463_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1463_Annotation13">
        <bpmn:text>Controls: - CTL-271 (ensure controlled execution — Marketplace &amp; Social Commerce (PA-10.3).) | - operational: Ecommerce Operations Manager review and approval gate
Owner: Ecommerce Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
