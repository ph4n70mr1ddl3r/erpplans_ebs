      <bpmn:sequenceFlow id="W947_Flow16" sourceRef="W947_Task7" targetRef="W947_Task8" />
      <bpmn:sequenceFlow id="W947_Flow17" sourceRef="W947_Task8" targetRef="W947_Task9" />
      <bpmn:sequenceFlow id="W947_Flow18" sourceRef="W947_Task9" targetRef="W947_End10" />
    </bpmn:process>
