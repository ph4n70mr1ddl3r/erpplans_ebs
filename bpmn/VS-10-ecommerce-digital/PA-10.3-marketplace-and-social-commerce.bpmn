    <bpmn:process id="W_W180" name="W180. E-commerce Marketplace Integration (Lazada/Shopee)" isExecutable="false">
      <bpmn:documentation>Trigger: Order placed on external marketplace (Lazada/Shopee)
Frequency: High; ~9,000–13,000 orders/month (one register with W724/W1470&#x27;s ~30% share)
Volume: Avg 2–3 items per order; avg order value PHP 1,500–3,000
Owner: Ecommerce Operations Manager
Participants: System (Middleware), DC Picker, Marketplace Courier
Source: workflow W180 — E-commerce Marketplace Integration (Lazada/Shopee)</bpmn:documentation>
      <bpmn:laneSet id="W180_LaneSet6">
        <bpmn:lane id="W180_Lane1" name="System">
        <bpmn:flowNodeRef>W180_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W180_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W180_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W180_Lane2" name="DC Picker">
        <bpmn:flowNodeRef>W180_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W180_Lane3" name="DC Packer">
        <bpmn:flowNodeRef>W180_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W180_Lane4" name="DC Dispatch">
        <bpmn:flowNodeRef>W180_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W180_Lane5" name="Finance Clerk">
        <bpmn:flowNodeRef>W180_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W180_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W180_Start7" name="Order placed on external marketplace (Lazada/Shopee)">
        <bpmn:outgoing>W180_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W180_Task8" name="Order Sync">
        <bpmn:documentation>Step 1: Order Sync: Middleware pulls orders from Lazada/Shopee APIs; creates Sales Orders in ERP
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W180_Flow17</bpmn:incoming>
        <bpmn:outgoing>W180_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W180_Task9" name="ATP Verification">
        <bpmn:documentation>Step 2: ATP Verification: System checks DC stock; if unavailable, system auto-notifies marketplace to cancel or delay
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W180_Flow18</bpmn:incoming>
        <bpmn:outgoing>W180_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W180_Task10" name="Picking">
        <bpmn:documentation>Step 3: Picking: DC Picker receives marketplace pick task; scans each item
Responsible (R): DC Picker
Accountable (A): DC Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W180_Flow19</bpmn:incoming>
        <bpmn:outgoing>W180_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W180_Task11" name="Packaging">
        <bpmn:documentation>Step 4: Packaging: Items packed in marketplace-specific packaging; marketplace shipping labels printed from middleware
Responsible (R): DC Packer
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W180_Flow20</bpmn:incoming>
        <bpmn:outgoing>W180_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W180_Task12" name="Handover">
        <bpmn:documentation>Step 5: Handover: Marketplace Courier (Lex/Shopee Xpress) picks up from DC; pickup confirmation synced to marketplace
Responsible (R): DC Dispatch
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W180_Flow21</bpmn:incoming>
        <bpmn:outgoing>W180_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W180_Task13" name="Settlement">
        <bpmn:documentation>Step 6: Settlement: Bi-weekly: Marketplace remits payment (net of commission/fees); Finance reconciles with ERP Sales Orders
Responsible (R): Finance Clerk
Accountable (A): Controller
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W180_Flow22</bpmn:incoming>
        <bpmn:outgoing>W180_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W180_End14" name="Complete">
        <bpmn:incoming>W180_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W180_Annotation15">
        <bpmn:text>Controls: - CTL-271 (ensure controlled execution — Marketplace &amp; Social Commerce (PA-10.3).) | - operational: periodic reconciliation against source documents
Owner: Ecommerce Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
