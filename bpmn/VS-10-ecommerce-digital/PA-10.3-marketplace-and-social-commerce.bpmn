    <bpmn:process id="W_W947" name="W947. Ecommerce Live Video Shopping &amp; Virtual Store Walkthrough" isExecutable="false">
      <bpmn:documentation>Trigger: Customer schedules or initiates a live video shopping session via BuildRight mobile app or website
Frequency: ~2,000–3,000 sessions/month
Volume: 1 customer per session; average session duration 15–30 min; average order value PHP 4,500 (higher than standard ecommerce AOV of PHP 3,500)
Owner: Ecommerce Manager
Participants: Customer, Video Shopping Associate, Category Specialist (on-call), Ecommerce Operations, Payment Gateway
Source: workflow W947 — Ecommerce Live Video Shopping &amp; Virtual Store Walkthrough</bpmn:documentation>
      <bpmn:laneSet id="W947_LaneSet3">
        <bpmn:lane id="W947_Lane1" name="System">
        <bpmn:flowNodeRef>W947_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W947_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W947_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W947_Lane2" name="Video Shopping Associate">
        <bpmn:flowNodeRef>W947_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W947_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W947_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W947_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W947_Start4" name="Customer schedules or initiates a live video shopping session via BuildRight mobile app…">
        <bpmn:outgoing>W947_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W947_Task5" name="Session Scheduling &amp; Preparation">
        <bpmn:documentation>Step 1: Session Scheduling &amp; Preparation: Customer books live video session via: (a) mobile app — selects date/time slot, product category of interest, and specific items or project description; (b) website — same booking flow; (c) walk-in scheduling at customer service counter (for future session); system confirms availability of Video Shopping Associate and sends calendar invite with video link; for project-specific sessions (e.g., &quot;complete bathroom renovation&quot;): system pre-loads relevant product catalog pages, current promotions, and inventory availability for customer&#x27;s preferred store; customer receives pre-session email with: video link, session agenda, and project checklist to prepare dimensions/requirements
Responsible (R): System / Ecommerce Ops
Accountable (A): Ecommerce Manager
Duration: 5 min (automated)</bpmn:documentation>
        <bpmn:incoming>W947_Flow13</bpmn:incoming>
        <bpmn:outgoing>W947_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W947_Task6" name="Session Initiation &amp; Customer Need Assessment">
        <bpmn:documentation>Step 2: Session Initiation &amp; Customer Need Assessment: Video Shopping Associate joins video call at scheduled time; conducts brief needs assessment: (a) project type (new build, renovation, repair, DIY); (b) budget range; (c) timeline; (d) product categories of interest; (e) store preference for BOPIS pickup or home delivery; associate uses mobile device with gimbal/stabilizer to walk store aisles, showing products in real-time; customer can direct associate to specific departments or products
Responsible (R): Video Shopping Associate
Accountable (A): Ecommerce Manager
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W947_Flow14</bpmn:incoming>
        <bpmn:outgoing>W947_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W947_Task7" name="Live Product Demonstration &amp; Consultation">
        <bpmn:documentation>Step 3: Live Product Demonstration &amp; Consultation: Associate presents products per customer interest: (a) physical product demonstration — showing dimensions, material quality, color options, weight, packaging; (b) side-by-side product comparison — placing items next to each other for visual comparison; (c) specification explanation — reading labels, showing technical specs, explaining compatibility; (d) project advice — recommending complementary products, suggesting alternatives when preferred item is out of stock, providing installation tips; for technical questions beyond associate&#x27;s expertise, system enables instant escalation to Category Specialist (via 3-way video call or chat relay); associate checks real-time inventory per W533 during session
Responsible (R): Video Shopping Associate / Category Specialist
Accountable (A): Ecommerce Manager
Duration: 10–20 min</bpmn:documentation>
        <bpmn:incoming>W947_Flow15</bpmn:incoming>
        <bpmn:outgoing>W947_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W947_Task8" name="Real-Time Order Creation &amp; Payment">
        <bpmn:documentation>Step 4: Real-Time Order Creation &amp; Payment: Associate adds selected items to shared digital cart visible to customer on screen; customer reviews cart — quantities, prices, product specifications; system applies: (a) current promotional pricing; (b) loyalty member discounts; (c) trade account pricing (if verified per W897); customer confirms order and pays via: (a) in-app payment (credit card, GCash, Maya); (b) payment link sent to customer&#x27;s email/SMS; order created in ERP with &quot;Live Video&quot; channel tag; fulfillment routed per W536 (BOPIS or home delivery)
Responsible (R): Video Shopping Associate / System / Customer
Accountable (A): Ecommerce Manager
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W947_Flow16</bpmn:incoming>
        <bpmn:outgoing>W947_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W947_Task9" name="Post-Session Follow-Up">
        <bpmn:documentation>Step 5: Post-Session Follow-Up: System sends post-session communication within 2 hours: (a) order confirmation with delivery/pickup details; (b) session recording link (with customer consent per RA 10173) for customer reference; (c) related product recommendations based on items viewed during session; (d) satisfaction survey (3 questions); (e) loyalty points credited for session attendance (50 points); for sessions that did not result in immediate purchase: abandoned cart reminder sent within 24 hours per W557; Video Shopping Associate makes personal follow-up call within 48 hours for high-value sessions (order value &gt; PHP 10,000 or project-based inquiries)
Responsible (R): System / Video Shopping Associate
Accountable (A): Ecommerce Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W947_Flow17</bpmn:incoming>
        <bpmn:outgoing>W947_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W947_End10" name="Complete">
        <bpmn:incoming>W947_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W947_Annotation11">
        <bpmn:text>Controls: - CTL-271 (ensure controlled execution — Marketplace &amp; Social Commerce (PA-10.3).) | - operational: per store
Owner: Ecommerce Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W947_Assoc12" sourceRef="W947_Annotation11" targetRef="W947_Start4" associationDirection="None" />
