      <bpmn:sequenceFlow id="W4513_Flow12" sourceRef="W4513_Task5" targetRef="W4513_Task6" />
      <bpmn:sequenceFlow id="W4513_Flow13" sourceRef="W4513_Task6" targetRef="W4513_End7" />
    </bpmn:process>
