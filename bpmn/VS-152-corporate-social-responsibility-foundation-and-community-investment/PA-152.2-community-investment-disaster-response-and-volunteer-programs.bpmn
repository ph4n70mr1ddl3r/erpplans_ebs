      <bpmn:sequenceFlow id="W4514_Flow12" sourceRef="W4514_Task5" targetRef="W4514_Task6" />
      <bpmn:sequenceFlow id="W4514_Flow13" sourceRef="W4514_Task6" targetRef="W4514_End7" />
    </bpmn:process>
