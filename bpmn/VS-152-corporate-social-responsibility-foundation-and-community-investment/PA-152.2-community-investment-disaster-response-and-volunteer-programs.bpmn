    <bpmn:process id="W_W4516" name="W4516. Education, School-Build &amp; Vocational Support Programs" isExecutable="false">
      <bpmn:documentation>Trigger: Education need; school-build; back-to-school season
Frequency: Per program/season
Volume: School-build/repair + education-support programs
Owner: Foundation ED / Programs
Participants: Apprenticeship (VS-123), Green Building (VS-78), Volunteers (W4518), Suppliers
Source: workflow W4516 — Education, School-Build &amp; Vocational Support Programs</bpmn:documentation>
      <bpmn:laneSet id="W4516_LaneSet2">
        <bpmn:lane id="W4516_Lane1" name="Programs">
        <bpmn:flowNodeRef>W4516_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4516_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4516_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4516_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4516_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4516_Start3" name="Education need; school-build; back-to-school season">
        <bpmn:outgoing>W4516_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4516_Task4" name="Programs/Foundation ED design education programs (school build/repair aligned…">
        <bpmn:documentation>Step 1: Programs/Foundation ED design education programs (school build/repair aligned to profile §13.2 May &quot;School build-out&quot;, vocational support, scholarships, tools-for-schools)
Responsible (R): Programs / Foundation ED
Accountable (A): Foundation Board
Duration: Per program</bpmn:documentation>
        <bpmn:incoming>W4516_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4516_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4516_Task5" name="Programs/Logistics/Volunteers execute school builds (VS-06 logistics, VS-12…">
        <bpmn:documentation>Step 2: Programs/Logistics/Volunteers execute school builds (VS-06 logistics, VS-12 install, VS-78 green building, W4518 volunteers) with child-safeguarding (W4511) on school sites
Responsible (R): Programs / Logistics / Volunteers
Accountable (A): Foundation ED
Duration: Per build</bpmn:documentation>
        <bpmn:incoming>W4516_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4516_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4516_Task6" name="Programs/Foundation ED deliver education support (tools/materials donation…">
        <bpmn:documentation>Step 3: Programs/Foundation ED deliver education support (tools/materials donation W4520, vocational linkage VS-123), measure education outcomes (W4521), and sustain partnerships
Responsible (R): Programs / Foundation ED
Accountable (A): Foundation Board
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W4516_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4516_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4516_End7" name="Complete">
