    <bpmn:process id="W_W4524" name="W4524. Foundation Annual Report, Audit &amp; Regulatory Filing" isExecutable="false">
      <bpmn:documentation>Trigger: Annual cycle; SEC/BIR/PCNC filing
Frequency: Annual
Volume: Foundation annual report + external audit + regulatory filings
Owner: Foundation ED / Finance (VS-17) / Corp Secretary (VS-36)
Participants: Audit (VS-21), Tax (VS-79), Legal (VS-100.3), Board (VS-36)
Source: workflow W4524 — Foundation Annual Report, Audit &amp; Regulatory Filing</bpmn:documentation>
      <bpmn:laneSet id="W4524_LaneSet4">
        <bpmn:lane id="W4524_Lane1" name="Finance">
        <bpmn:flowNodeRef>W4524_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4524_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4524_Lane2" name="Audit">
        <bpmn:flowNodeRef>W4524_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
