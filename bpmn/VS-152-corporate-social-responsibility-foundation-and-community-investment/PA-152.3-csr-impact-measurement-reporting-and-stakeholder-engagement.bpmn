        <bpmn:flowNodeRef>W4524_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4524_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4524_Start5" name="Annual cycle; SEC/BIR/PCNC filing">
        <bpmn:outgoing>W4524_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4524_Task6" name="Finance/Foundation ED prepare the Foundation annual report (activity, impact…">
        <bpmn:documentation>Step 1: Finance/Foundation ED prepare the Foundation annual report (activity, impact W4521, financials) and external-audit-ready books, separate from operating entities (VS-17)
Responsible (R): Finance / Foundation ED
Accountable (A): CFO / Foundation Board
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4524_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4524_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4524_Task7" name="Audit/Tax complete the external audit and regulatory filings (SEC annual, BIR…">
