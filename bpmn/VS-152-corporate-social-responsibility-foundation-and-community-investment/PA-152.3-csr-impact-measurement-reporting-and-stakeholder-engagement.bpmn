        <bpmn:flowNodeRef>W4523_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4523_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4523_Lane2" name="Reporting">
        <bpmn:flowNodeRef>W4523_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4523_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4523_Start4" name="Reporting cycle (annual/ESG); disclosure requirement">
        <bpmn:outgoing>W4523_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4523_Task5" name="Sustainability/ESG Manager/Foundation ED prepare the CSR/social disclosures…">
        <bpmn:documentation>Step 1: Sustainability/ESG Manager/Foundation ED prepare the CSR/social disclosures (GRI 400-series social, IRIS+ metrics, community-investment spend, Foundation activity) integrating with ESG reporting (VS-25)
Responsible (R): Sustainability/ESG Manager / ESG / Foundation ED
Accountable (A): Sustainability/ESG Manager / CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4523_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4523_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4523_Task6" name="Reporting/Audit ensure disclosure accuracy/assurance (internal VS-21 + optional…">
        <bpmn:documentation>Step 2: Reporting/Audit ensure disclosure accuracy/assurance (internal VS-21 + optional external assurance), data traceability (W4512), and alignment to integrated reporting (VS-17)
Responsible (R): Reporting / Audit
Accountable (A): CFO / Sustainability/ESG Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4523_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4523_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4523_Task7" name="Sustainability/ESG Manager/Compliance manage disclosure to stakeholders (B2B…">
        <bpmn:documentation>Step 3: Sustainability/ESG Manager/Compliance manage disclosure to stakeholders (B2B customer ESG due diligence, investors, regulators), with greenwashing-risk control (W4527)
Responsible (R): Sustainability/ESG Manager / Compliance
Accountable (A): Sustainability/ESG Manager / VP Legal &amp; Compliance
Duration: On request</bpmn:documentation>
        <bpmn:incoming>W4523_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4523_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4523_End8" name="Complete">
        <bpmn:incoming>W4523_Flow14</bpmn:incoming>
      </bpmn:endEvent>
