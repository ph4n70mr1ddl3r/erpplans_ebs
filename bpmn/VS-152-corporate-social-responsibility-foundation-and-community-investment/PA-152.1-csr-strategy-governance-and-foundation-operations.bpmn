        </bpmn:lane>
        <bpmn:lane id="W4507_Lane3" name="Audit">
        <bpmn:flowNodeRef>W4507_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4507_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4507_Start5" name="Board cycle; PCNC cycle; governance review">
        <bpmn:outgoing>W4507_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4507_Task6" name="Board/Corp Secretary run Foundation governance (board composition…">
        <bpmn:documentation>Step 1: Board/Corp Secretary run Foundation governance (board composition, independence, conflict-of-interest policy, committees — audit/finance/programs), per VS-36 governance standards
Responsible (R): Board / Corp Secretary
Accountable (A): Board Chair
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4507_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4507_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4507_Task7" name="Foundation ED/Board pursue and maintain PCNC (Philippine Council for NGO…">
        <bpmn:documentation>Step 2: Foundation ED/Board pursue and maintain PCNC (Philippine Council for NGO Certification) accreditation — the standard NGO-credibility seal — with the documentary/financial evidence cycle
Responsible (R): Foundation ED / Board / Audit
Accountable (A): Board Chair
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W4507_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4507_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4507_Task8" name="Audit/Finance ensure Foundation financial oversight (separate books, annual…">
        <bpmn:documentation>Step 3: Audit/Finance ensure Foundation financial oversight (separate books, annual external audit, fund-use discipline) links to VS-21/VS-17, and report to the board
Responsible (R): Audit / Finance / Foundation ED
Accountable (A): Board Audit Committee
Duration: Quarterly/Annual</bpmn:documentation>
        <bpmn:incoming>W4507_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4507_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4507_End9" name="Complete">
        <bpmn:incoming>W4507_Flow15</bpmn:incoming>
      </bpmn:endEvent>
