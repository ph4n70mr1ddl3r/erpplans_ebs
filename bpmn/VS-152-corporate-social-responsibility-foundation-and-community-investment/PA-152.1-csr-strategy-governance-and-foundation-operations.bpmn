    <bpmn:process id="W_W4507" name="W4507. Foundation Governance, Board &amp; PCNC Accreditation" isExecutable="false">
      <bpmn:documentation>Trigger: Board cycle; PCNC cycle; governance review
Frequency: Board quarterly + PCNC periodic
Volume: Foundation Board + committees + PCNC accreditation
Owner: Foundation Board / Corporate Secretary (VS-36)
Participants: Foundation ED, Audit (VS-21), Legal (VS-100.3), Finance (VS-17)
Source: workflow W4507 — Foundation Governance, Board &amp; PCNC Accreditation</bpmn:documentation>
      <bpmn:laneSet id="W4507_LaneSet4">
        <bpmn:lane id="W4507_Lane1" name="Board">
        <bpmn:flowNodeRef>W4507_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4507_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4507_Lane2" name="Foundation ED">
