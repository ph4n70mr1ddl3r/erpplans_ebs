      <bpmn:documentation>Trigger: PAGASA Signal No. 1 in store region
Frequency: 8–15 activations per year
Volume: Up to 200 stores simultaneously
Owner: Treasury Analyst
Participants: Treasury Analyst, Store Manager, CIT Service, Finance
Source: workflow W2508 — Pre-Typhoon Cash Float &amp; Payment Contingency Setup</bpmn:documentation>
      <bpmn:laneSet id="W2508_LaneSet4">
        <bpmn:lane id="W2508_Lane1" name="Treasury Analyst">
        <bpmn:flowNodeRef>W2508_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2508_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
