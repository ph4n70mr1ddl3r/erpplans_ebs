    <bpmn:process id="W_W2507" name="W2507. Typhoon Emergency Pricing Freeze Activation" isExecutable="false">
      <bpmn:documentation>Trigger: PAGASA Signal No. 2+ or DTI price monitoring alert in affected region
Frequency: 6–10 activations per year
Volume: Affects 500–2,000 emergency SKUs across 50–200 stores
Owner: Pricing Manager
Participants: Pricing Mgr, Legal, Merchandising, Store Ops
Source: workflow W2507 — Typhoon Emergency Pricing Freeze Activation</bpmn:documentation>
      <bpmn:laneSet id="W2507_LaneSet4">
        <bpmn:lane id="W2507_Lane1" name="Pricing Manager">
        <bpmn:flowNodeRef>W2507_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2507_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2507_Lane2" name="Legal">
        <bpmn:flowNodeRef>W2507_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2507_Lane3" name="Store Ops">
        <bpmn:flowNodeRef>W2507_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2507_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2507_Start5" name="PAGASA Signal No. 2+ or DTI price monitoring alert in affected region">
        <bpmn:outgoing>W2507_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2507_Task6" name="Pricing Manager activates emergency pricing freeze for disaster-essential items…">
        <bpmn:documentation>Step 1: Pricing Manager activates emergency pricing freeze for disaster-essential items (construction materials, basic hardware, emergency supplies) per DTI price control regulations (RA 7581 — Price Act); locks SRP in system for affected region
Responsible (R): Pricing Manager
Accountable (A): VP Merchandising
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W2507_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2507_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2507_Task7" name="Legal confirms DTI compliance: no price increases above SRP during declared…">
        <bpmn:documentation>Step 2: Legal confirms DTI compliance: no price increases above SRP during declared disaster period; system blocks all promotional markdown overrides and manual price changes for frozen categories
Responsible (R): Legal / Pricing Manager
Accountable (A): CFO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W2507_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2507_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2507_Task8" name="Store Ops verifies POS price sync across affected stores; confirms price labels…">
        <bpmn:documentation>Step 3: Store Ops verifies POS price sync across affected stores; confirms price labels on shelf; documents compliance for DTI audit trail
Responsible (R): Store Ops / Regional Manager
Accountable (A): VP Store Operations
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W2507_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2507_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2507_End9" name="Complete">
        <bpmn:incoming>W2507_Flow15</bpmn:incoming>
      </bpmn:endEvent>
