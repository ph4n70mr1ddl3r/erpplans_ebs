Responsible (R): Marketing Comms Manager
Accountable (A): CMO
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W2506_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2506_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2506_Task7" name="Customer Service prepares FAQ responses: store hours, product availability…">
