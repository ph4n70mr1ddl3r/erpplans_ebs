    <bpmn:process id="W_W2509" name="W2509. Staff Safety Notification &amp; Deployment Readiness" isExecutable="false">
      <bpmn:documentation>Trigger: PAGASA Signal No. 1 in store/DC region or management decision
Frequency: 8–15 activations per year
Volume: 6,932 employees across 200 stores, 4 DCs, HQ
Owner: HR Operations Manager
Participants: HR Ops Mgr, Store Managers, DC Ops Managers, Safety Officer
Source: workflow W2509 — Staff Safety Notification &amp; Deployment Readiness</bpmn:documentation>
      <bpmn:laneSet id="W2509_LaneSet3">
        <bpmn:lane id="W2509_Lane1" name="HR Operations Manager">
        <bpmn:flowNodeRef>W2509_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2509_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2509_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2509_Lane2" name="Store">
        <bpmn:flowNodeRef>W2509_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2509_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2509_Start4" name="PAGASA Signal No. 1 in store/DC region or management decision">
        <bpmn:outgoing>W2509_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2509_Task5" name="HR activates emergency notification system: SMS blast to all employees in…">
        <bpmn:documentation>Step 1: HR activates emergency notification system: SMS blast to all employees in affected region with safety instructions, reporting requirements, emergency contacts; confirms employee location and safety via response tracking
Responsible (R): HR Operations Manager
Accountable (A): CHRO
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W2509_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2509_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2509_Task6" name="Store/DC Managers implement staffing contingency: pre-identify skeleton crew…">
        <bpmn:documentation>Step 2: Store/DC Managers implement staffing contingency: pre-identify skeleton crew for immediate post-typhoon reopening, arrange overnight shelter for essential staff at store/DC if needed, cancel employee travel to affected areas
Responsible (R): Store/DC Manager
Accountable (A): COO
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2509_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2509_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2509_Task7" name="HR tracks employee safety status post-typhoon; activates employee assistance…">
        <bpmn:documentation>Step 3: HR tracks employee safety status post-typhoon; activates employee assistance program for affected staff; coordinates emergency salary advances or relief assistance per company policy
Responsible (R): HR Operations Manager
Accountable (A): CHRO
Duration: Ongoing (24–72 hrs post-event)</bpmn:documentation>
        <bpmn:incoming>W2509_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2509_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2509_End8" name="Complete">
        <bpmn:incoming>W2509_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2509_Annotation9">
        <bpmn:text>Controls: - CTL-436 (ensure controlled execution — Typhoon Preparedness &amp; Early Warning Operations (PA-69.1).) | - operational: backup radio communication
Owner: HR Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
