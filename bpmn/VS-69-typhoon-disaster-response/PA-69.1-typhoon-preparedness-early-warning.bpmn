<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-69.1-typhoon-preparedness-early-warning" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2502" name="W2502. Typhoon Season Pre-Positioning &amp; Emergency Stock Planning" isExecutable="false">
      <bpmn:documentation>Trigger: PAGASA typhoon season advisory (June–November) or approaching tropical cyclone
Frequency: Seasonal (annual pre-positioning June); event-driven per typhoon
Volume: 1 annual plan; 8–12 event-driven activations per year
Owner: VP Supply Chain
Participants: VP Supply Chain, Merchandising, DC Ops, Logistics, Store Ops
Source: workflow W2502 — Typhoon Season Pre-Positioning &amp; Emergency Stock Planning</bpmn:documentation>
      <bpmn:laneSet id="W2502_LaneSet4">
        <bpmn:lane id="W2502_Lane1" name="Merchandising Manager">
        <bpmn:flowNodeRef>W2502_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2502_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2502_Lane2" name="Supply Planning">
        <bpmn:flowNodeRef>W2502_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2502_Lane3" name="DC Ops">
        <bpmn:flowNodeRef>W2502_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2502_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2502_Start5" name="PAGASA typhoon season advisory (June–November) or approaching tropical cyclone">
        <bpmn:outgoing>W2502_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2502_Task6" name="Merchandising identifies emergency merchandise categories: tarps, plywood…">
        <bpmn:documentation>Step 1: Merchandising identifies emergency merchandise categories: tarps, plywood, nails, waterproofing, flashlights, batteries, water containers, generators, ropes, sandbags; reviews prior year demand curves by region
Responsible (R): Merchandising Manager
Accountable (A): VP Merchandising
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W2502_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2502_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2502_Task7" name="Supply Chain calculates pre-position quantities per DC region based on…">
        <bpmn:documentation>Step 2: Supply Chain calculates pre-position quantities per DC region based on historical typhoon impact zones; coordinates emergency POs with vendors; arranges early shipments to high-risk DCs (Visayas, Bicol)
Responsible (R): Supply Planning
Accountable (A): VP Supply Chain
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W2502_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2502_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2502_Task8" name="DC Ops allocates dedicated emergency staging areas; ensures stock is segregated…">
        <bpmn:documentation>Step 3: DC Ops allocates dedicated emergency staging areas; ensures stock is segregated and tagged as emergency reserve; Logistics pre-books surge delivery capacity with 3PL partners
Responsible (R): DC Ops / Logistics Manager
Accountable (A): VP Supply Chain
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W2502_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2502_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2502_End9" name="Complete">
        <bpmn:incoming>W2502_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2502_Annotation10">
        <bpmn:text>Controls: - CTL-232 (ensure typhoon-response protocol execution.) | - operational: maintaining flexible inter-DC transfer capability
Owner: VP Supply Chain</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2502_Assoc11" sourceRef="W2502_Annotation10" targetRef="W2502_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2502_Flow12" sourceRef="W2502_Start5" targetRef="W2502_Task6" />
      <bpmn:sequenceFlow id="W2502_Flow13" sourceRef="W2502_Task6" targetRef="W2502_Task7" />
      <bpmn:sequenceFlow id="W2502_Flow14" sourceRef="W2502_Task7" targetRef="W2502_Task8" />
      <bpmn:sequenceFlow id="W2502_Flow15" sourceRef="W2502_Task8" targetRef="W2502_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2502_diag">
      <bpmndi:BPMNPlane id="W2502_plane" bpmnElement="W_W2502">
        <bpmndi:BPMNShape id="W2502_Lane1_di" bpmnElement="W2502_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2502_Lane2_di" bpmnElement="W2502_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2502_Lane3_di" bpmnElement="W2502_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2502_Task6_di" bpmnElement="W2502_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2502_Task7_di" bpmnElement="W2502_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2502_Task8_di" bpmnElement="W2502_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2502_Start5_di" bpmnElement="W2502_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2502_End9_di" bpmnElement="W2502_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2502_Annotation10_di" bpmnElement="W2502_Annotation10"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2502_Flow12_di" bpmnElement="W2502_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2502_Flow13_di" bpmnElement="W2502_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2502_Flow14_di" bpmnElement="W2502_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2502_Flow15_di" bpmnElement="W2502_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2502_Assoc11_di" bpmnElement="W2502_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2503" name="W2503. Store-Level Typhoon Readiness Checklist Execution" isExecutable="false">
      <bpmn:documentation>Trigger: PAGASA Signal No. 1 raised in store region or typhoon within 48-hour projected path
Frequency: 8–15 activations per store per year (regional variance)
Volume: Up to 200 stores simultaneously for nationwide typhoons
Owner: Store Manager
Participants: Store Manager, All Store Staff, Regional Manager
Source: workflow W2503 — Store-Level Typhoon Readiness Checklist Execution</bpmn:documentation>
      <bpmn:laneSet id="W2503_LaneSet3">
        <bpmn:lane id="W2503_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W2503_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2503_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2503_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2503_Lane2" name="Stock Associate">
        <bpmn:flowNodeRef>W2503_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2503_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2503_Start4" name="PAGASA Signal No. 1 raised in store region or typhoon within 48-hour projected path">
        <bpmn:outgoing>W2503_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2503_Task5" name="Store Manager receives automated PAGASA alert via ERP dashboard; initiates…">
        <bpmn:documentation>Step 1: Store Manager receives automated PAGASA alert via ERP dashboard; initiates typhoon readiness checklist: secure outdoor lumber yard, move chemicals to elevated shelving, cover tile displays, sandbag entrances
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2503_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2503_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2503_Task6" name="Staff executes facility checklist: test backup generator, verify fuel levels…">
        <bpmn:documentation>Step 2: Staff executes facility checklist: test backup generator, verify fuel levels, charge POS terminals for offline mode, secure cash in safe, backup local POS data
Responsible (R): Stock Associate / Cashier
Accountable (A): Store Manager
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W2503_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2503_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2503_Task7" name="Store Manager confirms checklist completion via mobile app; Regional Manager…">
        <bpmn:documentation>Step 3: Store Manager confirms checklist completion via mobile app; Regional Manager reviews status across affected region; escalates incomplete stores
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W2503_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2503_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2503_End8" name="Complete">
        <bpmn:incoming>W2503_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2503_Annotation9">
        <bpmn:text>Controls: - CTL-232 (ensure typhoon-response protocol execution.) | - operational: SMS backup alerts
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2503_Assoc10" sourceRef="W2503_Annotation9" targetRef="W2503_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2503_Flow11" sourceRef="W2503_Start4" targetRef="W2503_Task5" />
      <bpmn:sequenceFlow id="W2503_Flow12" sourceRef="W2503_Task5" targetRef="W2503_Task6" />
      <bpmn:sequenceFlow id="W2503_Flow13" sourceRef="W2503_Task6" targetRef="W2503_Task7" />
      <bpmn:sequenceFlow id="W2503_Flow14" sourceRef="W2503_Task7" targetRef="W2503_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2503_diag">
      <bpmndi:BPMNPlane id="W2503_plane" bpmnElement="W_W2503">
        <bpmndi:BPMNShape id="W2503_Lane1_di" bpmnElement="W2503_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2503_Lane2_di" bpmnElement="W2503_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2503_Task5_di" bpmnElement="W2503_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2503_Task6_di" bpmnElement="W2503_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2503_Task7_di" bpmnElement="W2503_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2503_Start4_di" bpmnElement="W2503_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2503_End8_di" bpmnElement="W2503_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2503_Annotation9_di" bpmnElement="W2503_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2503_Flow11_di" bpmnElement="W2503_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2503_Flow12_di" bpmnElement="W2503_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2503_Flow13_di" bpmnElement="W2503_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2503_Flow14_di" bpmnElement="W2503_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2503_Assoc10_di" bpmnElement="W2503_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2504" name="W2504. DC &amp; Warehouse Typhoon Preparedness Protocol" isExecutable="false">
      <bpmn:documentation>Trigger: PAGASA Signal No. 2 in DC region or typhoon within 36-hour projected path
Frequency: 4–8 activations per DC per year
Volume: 4 DCs; up to all 4 simultaneously for super typhoons
Owner: DC Operations Manager
Participants: DC Ops Manager, Warehouse Supervisors, Logistics, Safety Officer
Source: workflow W2504 — DC &amp; Warehouse Typhoon Preparedness Protocol</bpmn:documentation>
      <bpmn:laneSet id="W2504_LaneSet4">
        <bpmn:lane id="W2504_Lane1" name="DC Ops Manager">
        <bpmn:flowNodeRef>W2504_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2504_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2504_Lane2" name="Warehouse Supervisor">
        <bpmn:flowNodeRef>W2504_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2504_Lane3" name="Logistics Manager">
        <bpmn:flowNodeRef>W2504_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2504_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2504_Start5" name="PAGASA Signal No. 2 in DC region or typhoon within 36-hour projected path">
        <bpmn:outgoing>W2504_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2504_Task6" name="DC Ops Manager activates typhoon protocol: halt outbound shipments to affected…">
        <bpmn:documentation>Step 1: DC Ops Manager activates typhoon protocol: halt outbound shipments to affected stores, expedite any in-transit deliveries, secure dock doors, move ground-level inventory to upper racks or elevated areas
Responsible (R): DC Ops Manager
Accountable (A): VP Supply Chain
Duration: 3–4 hours</bpmn:documentation>
        <bpmn:incoming>W2504_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2504_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2504_Task7" name="Warehouse Supervisors secure hazardous materials (paint, solvents, chemicals)…">
        <bpmn:documentation>Step 2: Warehouse Supervisors secure hazardous materials (paint, solvents, chemicals) per DENR hazmat protocols; verify fire suppression systems; test emergency lighting and backup power
Responsible (R): Warehouse Supervisor / Safety Officer
Accountable (A): DC Ops Manager
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2504_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2504_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2504_Task8" name="Logistics Manager cancels or reroutes scheduled 3PL deliveries; secures fleet…">
        <bpmn:documentation>Step 3: Logistics Manager cancels or reroutes scheduled 3PL deliveries; secures fleet vehicles in covered areas or higher ground; activates driver safety stand-down
Responsible (R): Logistics Manager
Accountable (A): VP Supply Chain
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W2504_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2504_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2504_End9" name="Complete">
        <bpmn:incoming>W2504_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2504_Annotation10">
        <bpmn:text>Controls: - CTL-436 (ensure controlled execution — Typhoon Preparedness &amp; Early Warning Operations (PA-69.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: DC Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2504_Assoc11" sourceRef="W2504_Annotation10" targetRef="W2504_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2504_Flow12" sourceRef="W2504_Start5" targetRef="W2504_Task6" />
      <bpmn:sequenceFlow id="W2504_Flow13" sourceRef="W2504_Task6" targetRef="W2504_Task7" />
      <bpmn:sequenceFlow id="W2504_Flow14" sourceRef="W2504_Task7" targetRef="W2504_Task8" />
      <bpmn:sequenceFlow id="W2504_Flow15" sourceRef="W2504_Task8" targetRef="W2504_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2504_diag">
      <bpmndi:BPMNPlane id="W2504_plane" bpmnElement="W_W2504">
        <bpmndi:BPMNShape id="W2504_Lane1_di" bpmnElement="W2504_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2504_Lane2_di" bpmnElement="W2504_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2504_Lane3_di" bpmnElement="W2504_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2504_Task6_di" bpmnElement="W2504_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2504_Task7_di" bpmnElement="W2504_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2504_Task8_di" bpmnElement="W2504_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2504_Start5_di" bpmnElement="W2504_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2504_End9_di" bpmnElement="W2504_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2504_Annotation10_di" bpmnElement="W2504_Annotation10"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2504_Flow12_di" bpmnElement="W2504_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2504_Flow13_di" bpmnElement="W2504_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2504_Flow14_di" bpmnElement="W2504_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2504_Flow15_di" bpmnElement="W2504_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2504_Assoc11_di" bpmnElement="W2504_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2505" name="W2505. Emergency Merchandise Demand Surge Forecasting" isExecutable="false">
      <bpmn:documentation>Trigger: PAGASA Signal No. 2+ or post-disaster assessment indicating severe impact area
Frequency: 6–10 activations per year
Volume: Regional forecasts for 3–5 regions
Owner: Merchandise Planner
Participants: Merch Planner, Supply Planning, Procurement, Finance
Source: workflow W2505 — Emergency Merchandise Demand Surge Forecasting</bpmn:documentation>
      <bpmn:laneSet id="W2505_LaneSet3">
        <bpmn:lane id="W2505_Lane1" name="Merchandise Planner">
        <bpmn:flowNodeRef>W2505_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2505_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2505_Lane2" name="Supply Planning">
        <bpmn:flowNodeRef>W2505_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2505_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2505_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2505_Start4" name="PAGASA Signal No. 2+ or post-disaster assessment indicating severe impact area">
        <bpmn:outgoing>W2505_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2505_Task5" name="Planner models demand surge using historical typhoon data by region and…">
        <bpmn:documentation>Step 1: Planner models demand surge using historical typhoon data by region and severity: tarps (+400%), plywood (+300%), nails (+250%), waterproofing (+500%), generators (+200%); adjusts by Signal level and population density
Responsible (R): Merchandise Planner
Accountable (A): VP Merchandising
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2505_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2505_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2505_Task6" name="Supply Planning converts forecast to emergency PO recommendations; Procurement…">
        <bpmn:documentation>Step 2: Supply Planning converts forecast to emergency PO recommendations; Procurement contacts vendors for expedited shipments; Finance pre-approves emergency procurement budget (PHP 50M–200M per major typhoon)
Responsible (R): Supply Planning / Procurement
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2505_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2505_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2505_Task7" name="System updates emergency stock allocation rules: prioritizes hardest-hit…">
        <bpmn:documentation>Step 3: System updates emergency stock allocation rules: prioritizes hardest-hit stores, overrides normal ABC allocation, enables automatic replenishment triggers at reduced ROP thresholds
Responsible (R): Supply Planning
Accountable (A): VP Supply Chain
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W2505_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2505_Flow14</bpmn:outgoing>
