      <bpmn:startEvent id="W2508_Start5" name="PAGASA Signal No. 1 in store region">
        <bpmn:outgoing>W2508_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2508_Task6" name="Treasury increases cash float for affected stores by 50% to handle surge in…">
        <bpmn:documentation>Step 1: Treasury increases cash float for affected stores by 50% to handle surge in cash transactions (GCash/e-wallet outages common during typhoons); coordinates expedited CIT delivery
Responsible (R): Treasury Analyst
Accountable (A): Treasury Manager
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2508_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2508_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2508_Task7" name="Store Manager activates payment contingency: verifies offline POS payment…">
        <bpmn:documentation>Step 2: Store Manager activates payment contingency: verifies offline POS payment cache, tests manual credit card imprint capability, confirms change fund adequacy
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W2508_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2508_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2508_Task8" name="Finance monitors bank branch closures in affected areas; adjusts cash deposit…">
        <bpmn:documentation>Step 3: Finance monitors bank branch closures in affected areas; adjusts cash deposit schedules; authorizes extended cash holding at stores with bank holiday overrides
Responsible (R): Finance Manager
Accountable (A): CFO
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W2508_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2508_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2508_End9" name="Complete">
        <bpmn:incoming>W2508_Flow15</bpmn:incoming>
      </bpmn:endEvent>
