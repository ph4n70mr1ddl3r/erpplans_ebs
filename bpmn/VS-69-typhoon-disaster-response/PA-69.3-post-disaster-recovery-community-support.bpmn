    <bpmn:process id="W_W2522" name="W2522. Typhoon Event After-Action Review &amp; Lessons Learned" isExecutable="false">
      <bpmn:documentation>Trigger: Post-disaster recovery stabilized (typically 2–4 weeks after major event)
Frequency: After every significant typhoon event (3–5 per year)
Volume: 1 AAR per major event
Owner: COO
Participants: All functional VPs, Regional Managers, Store/DC Managers, HR, Safety
Source: workflow W2522 — Typhoon Event After-Action Review &amp; Lessons Learned</bpmn:documentation>
      <bpmn:laneSet id="W2522_LaneSet3">
        <bpmn:lane id="W2522_Lane1" name="COO">
        <bpmn:flowNodeRef>W2522_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2522_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2522_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2522_Lane2" name="All VPs">
        <bpmn:flowNodeRef>W2522_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2522_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2522_Start4" name="Post-disaster recovery stabilized (typically 2–4 weeks after major event)">
        <bpmn:outgoing>W2522_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2522_Task5" name="COO compiles event timeline: PAGASA warnings vs. company response, store/DC…">
        <bpmn:documentation>Step 1: COO compiles event timeline: PAGASA warnings vs. company response, store/DC closure and reopening times, inventory loss, employee safety incidents, customer complaints, financial impact, supply chain disruption duration
Responsible (R): COO
Accountable (A): COO
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W2522_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2522_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2522_Task6" name="Cross-functional review meeting: each VP presents functional performance…">
        <bpmn:documentation>Step 2: Cross-functional review meeting: each VP presents functional performance; identifies gaps in preparedness, response, and recovery; documents lessons learned and action items with owners and deadlines
Responsible (R): All VPs
Accountable (A): COO
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W2522_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2522_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2522_Task7" name="COO updates typhoon preparedness protocols, checklists, and training materials…">
        <bpmn:documentation>Step 3: COO updates typhoon preparedness protocols, checklists, and training materials based on lessons learned; HR incorporates into annual training; Facilities updates capital improvement plan for identified structural weaknesses
Responsible (R): COO / HR / Facilities
Accountable (A): COO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2522_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2522_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2522_End8" name="Complete">
        <bpmn:incoming>W2522_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2522_Annotation9">
        <bpmn:text>Controls: - CTL-438 (ensure controlled execution — Post-Disaster Recovery &amp; Community Support (PA-69.3).) | - operational: COO review and approval gate
Owner: COO</bpmn:text>
      </bpmn:textAnnotation>
