    <bpmn:process id="W_W2524" name="W2524. Post-Disaster Vendor Recovery &amp; Supply Chain Re-Establishment" isExecutable="false">
      <bpmn:documentation>Trigger: Post-disaster supply chain disruption assessment
Frequency: 3–5 activations per year
Volume: 50–200 vendors potentially affected per major event
Owner: Procurement Manager
Participants: Procurement, Logistics, Merchandising, Finance, Vendors
Source: workflow W2524 — Post-Disaster Vendor Recovery &amp; Supply Chain Re-Establishment</bpmn:documentation>
      <bpmn:laneSet id="W2524_LaneSet3">
        <bpmn:lane id="W2524_Lane1" name="Procurement">
        <bpmn:flowNodeRef>W2524_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2524_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2524_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2524_Lane2" name="Logistics Manager">
        <bpmn:flowNodeRef>W2524_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2524_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2524_Start4" name="Post-disaster supply chain disruption assessment">
        <bpmn:outgoing>W2524_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2524_Task5" name="Procurement contacts affected vendors: assesses their operational status…">
        <bpmn:documentation>Step 1: Procurement contacts affected vendors: assesses their operational status (facility damage, workforce availability, production capacity); classifies as fully operational, partially operational, or offline; identifies critical supply gaps
Responsible (R): Procurement / Buyers
Accountable (A): VP Merchandising
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W2524_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2524_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2524_Task6" name="For offline/critical vendors: activates alternative sourcing from unaffected…">
        <bpmn:documentation>Step 2: For offline/critical vendors: activates alternative sourcing from unaffected regions or substitute vendors; negotiates temporary supply agreements with expedited onboarding; Merchandising approves SKU substitutions where necessary
Responsible (R): Procurement / Merchandising
Accountable (A): VP Supply Chain
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W2524_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2524_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2524_Task7" name="Logistics re-establishes transport routes: identifies road closures, port…">
        <bpmn:documentation>Step 3: Logistics re-establishes transport routes: identifies road closures, port disruptions, bridge damage; works with 3PL partners on alternative routing; adjusts lead times in system for affected vendor-origin shipments
Responsible (R): Logistics Manager
Accountable (A): VP Supply Chain
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2524_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2524_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2524_End8" name="Complete">
        <bpmn:incoming>W2524_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2524_Annotation9">
        <bpmn:text>Controls: - CTL-438 (ensure controlled execution — Post-Disaster Recovery &amp; Community Support (PA-69.3).) | - operational: Procurement Manager review and approval gate
Owner: Procurement Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2524_Assoc10" sourceRef="W2524_Annotation9" targetRef="W2524_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2524_Flow11" sourceRef="W2524_Start4" targetRef="W2524_Task5" />
      <bpmn:sequenceFlow id="W2524_Flow12" sourceRef="W2524_Task5" targetRef="W2524_Task6" />
      <bpmn:sequenceFlow id="W2524_Flow13" sourceRef="W2524_Task6" targetRef="W2524_Task7" />
      <bpmn:sequenceFlow id="W2524_Flow14" sourceRef="W2524_Task7" targetRef="W2524_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2524_diag">
      <bpmndi:BPMNPlane id="W2524_plane" bpmnElement="W_W2524">
