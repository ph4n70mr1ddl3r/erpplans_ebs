    <bpmn:process id="W_W2525" name="W2525. Annual Typhoon Season Readiness Program &amp; Drill Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Annual pre-typhoon season (May)
Frequency: Annual
Volume: 200 stores + 4 DCs + HQ
Owner: COO
Participants: All functional leaders, Store/DC Managers, Safety, HR
Source: workflow W2525 — Annual Typhoon Season Readiness Program &amp; Drill Execution</bpmn:documentation>
      <bpmn:laneSet id="W2525_LaneSet4">
        <bpmn:lane id="W2525_Lane1" name="COO">
        <bpmn:flowNodeRef>W2525_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2525_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2525_Lane2" name="HR">
        <bpmn:flowNodeRef>W2525_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2525_Lane3" name="IT">
        <bpmn:flowNodeRef>W2525_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2525_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2525_Start5" name="Annual pre-typhoon season (May)">
        <bpmn:outgoing>W2525_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2525_Task6" name="COO reviews and updates typhoon preparedness protocols based on prior season…">
        <bpmn:documentation>Step 1: COO reviews and updates typhoon preparedness protocols based on prior season lessons learned; updates store/DC checklists, emergency contact lists, generator maintenance schedules; reviews insurance coverage adequacy with Finance
Responsible (R): COO
Accountable (A): COO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2525_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2525_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2525_Task7" name="HR coordinates annual typhoon preparedness training for all 6,918 employees…">
        <bpmn:documentation>Step 2: HR coordinates annual typhoon preparedness training for all 6,918 employees (online module + in-store tabletop exercise); ensures new hires receive orientation; certifies first aid responders per store (minimum 2 per store); conducts evacuation drill at each location
Responsible (R): HR / Safety Officer
Accountable (A): CHRO
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W2525_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2525_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2525_Task8" name="IT tests disaster communication systems: emergency notification platform…">
        <bpmn:documentation>Step 3: IT tests disaster communication systems: emergency notification platform, backup internet at all locations, POS offline mode, data backup integrity; Facilities completes generator preventive maintenance and fuel top-up at all 205 locations
Responsible (R): IT / Facilities
Accountable (A): CIO / COO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2525_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2525_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2525_End9" name="Complete">
        <bpmn:incoming>W2525_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2525_Annotation10">
        <bpmn:text>Controls: - CTL-438 (ensure controlled execution — Post-Disaster Recovery &amp; Community Support (PA-69.3).) | - operational: COO review and approval gate
Owner: COO</bpmn:text>
      </bpmn:textAnnotation>
