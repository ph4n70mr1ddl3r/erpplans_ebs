<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-69.3-post-disaster-recovery-community-support" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2518" name="W2518. Post-Typhoon Store Damage Assessment &amp; Rapid Reopening" isExecutable="false">
      <bpmn:documentation>Trigger: Weather conditions improve and local government lifts evacuation order
Frequency: 2–5 per store per year
Volume: Up to 200 stores per major event; typically 20–60 stores
Owner: Regional Manager
Participants: Regional Manager, Store Manager, Facilities, Safety, LP, Insurance
Source: workflow W2518 — Post-Typhoon Store Damage Assessment &amp; Rapid Reopening</bpmn:documentation>
      <bpmn:laneSet id="W2518_LaneSet3">
        <bpmn:lane id="W2518_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W2518_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2518_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2518_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2518_Lane2" name="Facilities">
        <bpmn:flowNodeRef>W2518_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2518_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2518_Start4" name="Weather conditions improve and local government lifts evacuation order">
        <bpmn:outgoing>W2518_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2518_Task5" name="Regional Manager authorizes Store Manager to conduct initial assessment…">
        <bpmn:documentation>Step 1: Regional Manager authorizes Store Manager to conduct initial assessment: structural integrity (roof, walls, doors), electrical safety, water intrusion, inventory damage, security status; documents with photos/video via mobile app
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2518_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2518_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2518_Task6" name="Facilities and Safety conduct secondary assessment for: electrical system…">
        <bpmn:documentation>Step 2: Facilities and Safety conduct secondary assessment for: electrical system safety check, mold/water damage remediation needs, structural engineering review for severe damage, fire system verification
Responsible (R): Facilities / Safety Officer
Accountable (A): COO
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W2518_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2518_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2518_Task7" name="Based on assessment: classify store as Green (safe to open), Yellow (partial…">
        <bpmn:documentation>Step 3: Based on assessment: classify store as Green (safe to open), Yellow (partial operations), Red (closed for repairs); Green/Yellow stores execute rapid reopening: clean-up, inventory count, system boot, cash float load, resume operations within 24 hours where possible
Responsible (R): Store Manager / Regional Manager
Accountable (A): VP Store Operations
Duration: 12–24 hours</bpmn:documentation>
        <bpmn:incoming>W2518_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2518_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2518_End8" name="Complete">
        <bpmn:incoming>W2518_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2518_Annotation9">
        <bpmn:text>Controls: - CTL-438 (ensure controlled execution — Post-Disaster Recovery &amp; Community Support (PA-69.3).) | - operational: Regional Manager review and approval gate
Owner: Regional Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2518_Assoc10" sourceRef="W2518_Annotation9" targetRef="W2518_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2518_Flow11" sourceRef="W2518_Start4" targetRef="W2518_Task5" />
      <bpmn:sequenceFlow id="W2518_Flow12" sourceRef="W2518_Task5" targetRef="W2518_Task6" />
      <bpmn:sequenceFlow id="W2518_Flow13" sourceRef="W2518_Task6" targetRef="W2518_Task7" />
      <bpmn:sequenceFlow id="W2518_Flow14" sourceRef="W2518_Task7" targetRef="W2518_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2518_diag">
      <bpmndi:BPMNPlane id="W2518_plane" bpmnElement="W_W2518">
        <bpmndi:BPMNShape id="W2518_Lane1_di" bpmnElement="W2518_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2518_Lane2_di" bpmnElement="W2518_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2518_Task5_di" bpmnElement="W2518_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2518_Task6_di" bpmnElement="W2518_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2518_Task7_di" bpmnElement="W2518_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2518_Start4_di" bpmnElement="W2518_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2518_End8_di" bpmnElement="W2518_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2518_Annotation9_di" bpmnElement="W2518_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2518_Flow11_di" bpmnElement="W2518_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2518_Flow12_di" bpmnElement="W2518_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2518_Flow13_di" bpmnElement="W2518_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2518_Flow14_di" bpmnElement="W2518_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2518_Assoc10_di" bpmnElement="W2518_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2519" name="W2519. Post-Disaster Inventory Loss Quantification &amp; Insurance Claim" isExecutable="false">
      <bpmn:documentation>Trigger: Store/DC damage assessment reveals inventory loss
Frequency: 2–5 significant claims per year
Volume: PHP 5M–200M per event; typically 1–10 locations per claim
Owner: Finance Manager
Participants: Finance Mgr, Store/DC Ops, LP, Insurance Broker, External Adjuster
Source: workflow W2519 — Post-Disaster Inventory Loss Quantification &amp; Insurance Claim</bpmn:documentation>
      <bpmn:laneSet id="W2519_LaneSet4">
        <bpmn:lane id="W2519_Lane1" name="Store">
        <bpmn:flowNodeRef>W2519_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2519_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2519_Lane2" name="Finance Manager">
        <bpmn:flowNodeRef>W2519_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2519_Lane3" name="Finance">
        <bpmn:flowNodeRef>W2519_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2519_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2519_Start5" name="Store/DC damage assessment reveals inventory loss">
        <bpmn:outgoing>W2519_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2519_Task6" name="Store/DC Ops conducts emergency inventory count: categorizes stock as…">
        <bpmn:documentation>Step 1: Store/DC Ops conducts emergency inventory count: categorizes stock as undamaged, damaged-but-salvageable, total loss; records per SKU with quantity and WAC value; documents with photos/video
Responsible (R): Store/DC Ops / LP
Accountable (A): Regional Manager
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W2519_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2519_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2519_Task7" name="Finance compiles loss claim: extracts pre-disaster inventory valuation from…">
        <bpmn:documentation>Step 2: Finance compiles loss claim: extracts pre-disaster inventory valuation from ERP, compares with post-disaster count, calculates loss at WAC and SRP; prepares insurance claim with adjuster coordination
Responsible (R): Finance Manager / Insurance Broker
Accountable (A): CFO
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W2519_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2519_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2519_Task8" name="System processes inventory write-off: journals loss to insurance claim…">
        <bpmn:documentation>Step 3: System processes inventory write-off: journals loss to insurance claim receivable account, removes damaged stock from perpetual inventory, updates aging and NRV for salvageable items; tracks claim through settlement
Responsible (R): Finance / Accounting
Accountable (A): CFO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2519_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2519_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2519_End9" name="Complete">
        <bpmn:incoming>W2519_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2519_Annotation10">
        <bpmn:text>Controls: - CTL-438 (ensure controlled execution — Post-Disaster Recovery &amp; Community Support (PA-69.3).) | - operational: thorough photo documentation and pre-disaster inventory records
Owner: Finance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2519_Assoc11" sourceRef="W2519_Annotation10" targetRef="W2519_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2519_Flow12" sourceRef="W2519_Start5" targetRef="W2519_Task6" />
      <bpmn:sequenceFlow id="W2519_Flow13" sourceRef="W2519_Task6" targetRef="W2519_Task7" />
      <bpmn:sequenceFlow id="W2519_Flow14" sourceRef="W2519_Task7" targetRef="W2519_Task8" />
      <bpmn:sequenceFlow id="W2519_Flow15" sourceRef="W2519_Task8" targetRef="W2519_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2519_diag">
      <bpmndi:BPMNPlane id="W2519_plane" bpmnElement="W_W2519">
        <bpmndi:BPMNShape id="W2519_Lane1_di" bpmnElement="W2519_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2519_Lane2_di" bpmnElement="W2519_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2519_Lane3_di" bpmnElement="W2519_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2519_Task6_di" bpmnElement="W2519_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2519_Task7_di" bpmnElement="W2519_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2519_Task8_di" bpmnElement="W2519_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2519_Start5_di" bpmnElement="W2519_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2519_End9_di" bpmnElement="W2519_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2519_Annotation10_di" bpmnElement="W2519_Annotation10"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2519_Flow12_di" bpmnElement="W2519_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2519_Flow13_di" bpmnElement="W2519_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2519_Flow14_di" bpmnElement="W2519_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2519_Flow15_di" bpmnElement="W2519_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2519_Assoc11_di" bpmnElement="W2519_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2520" name="W2520. Community Building Materials Donation &amp; Relief Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Major disaster event with significant community impact in store area
Frequency: 2–4 activations per year
Volume: PHP 5M–20M in donated materials per event
Owner: CSR Manager / Store Manager
Participants: CSR Mgr, Store Manager, LGU, DSWD/Red Cross, Logistics, Finance, Legal
Source: workflow W2520 — Community Building Materials Donation &amp; Relief Operations</bpmn:documentation>
      <bpmn:laneSet id="W2520_LaneSet4">
        <bpmn:lane id="W2520_Lane1" name="CSR Manager">
        <bpmn:flowNodeRef>W2520_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2520_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2520_Lane2" name="Finance">
        <bpmn:flowNodeRef>W2520_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2520_Lane3" name="Logistics">
        <bpmn:flowNodeRef>W2520_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2520_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2520_Start5" name="Major disaster event with significant community impact in store area">
        <bpmn:outgoing>W2520_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2520_Task6" name="CSR/Store Manager identifies community needs in coordination with LGU and DSWD…">
        <bpmn:documentation>Step 1: CSR/Store Manager identifies community needs in coordination with LGU and DSWD: temporary shelter materials (tarps, plywood, nails), water containers, tools for debris clearing; proposes donation list with estimated value
Responsible (R): CSR Manager / Store Manager
Accountable (A): CEO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2520_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2520_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2520_Task7" name="CEO approves donation budget; Finance processes zero-price goods issue from…">
        <bpmn:documentation>Step 2: CEO approves donation budget; Finance processes zero-price goods issue from inventory with donation GL coding; Legal ensures BIR-deductible donation documentation (certification from DSWD/LGU, official receipts)
Responsible (R): Finance / Legal
Accountable (A): CEO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2520_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2520_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2520_Task8" name="Logistics arranges delivery to LGU distribution points or directly to affected…">
        <bpmn:documentation>Step 3: Logistics arranges delivery to LGU distribution points or directly to affected communities; Store Manager coordinates volunteer staff for on-site assistance; PR team documents for corporate communications
Responsible (R): Logistics / Store Manager / Marketing
Accountable (A): CMO
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W2520_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2520_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2520_End9" name="Complete">
        <bpmn:incoming>W2520_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2520_Annotation10">
        <bpmn:text>Controls: - CTL-438 (ensure controlled execution — Post-Disaster Recovery &amp; Community Support (PA-69.3).) | - operational: LGU/DSWD partnership
Owner: CSR Manager / Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2520_Assoc11" sourceRef="W2520_Annotation10" targetRef="W2520_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2520_Flow12" sourceRef="W2520_Start5" targetRef="W2520_Task6" />
      <bpmn:sequenceFlow id="W2520_Flow13" sourceRef="W2520_Task6" targetRef="W2520_Task7" />
      <bpmn:sequenceFlow id="W2520_Flow14" sourceRef="W2520_Task7" targetRef="W2520_Task8" />
      <bpmn:sequenceFlow id="W2520_Flow15" sourceRef="W2520_Task8" targetRef="W2520_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2520_diag">
      <bpmndi:BPMNPlane id="W2520_plane" bpmnElement="W_W2520">
        <bpmndi:BPMNShape id="W2520_Lane1_di" bpmnElement="W2520_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2520_Lane2_di" bpmnElement="W2520_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2520_Lane3_di" bpmnElement="W2520_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2520_Task6_di" bpmnElement="W2520_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2520_Task7_di" bpmnElement="W2520_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2520_Task8_di" bpmnElement="W2520_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2520_Start5_di" bpmnElement="W2520_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2520_End9_di" bpmnElement="W2520_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2520_Annotation10_di" bpmnElement="W2520_Annotation10"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2520_Flow12_di" bpmnElement="W2520_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2520_Flow13_di" bpmnElement="W2520_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2520_Flow14_di" bpmnElement="W2520_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2520_Flow15_di" bpmnElement="W2520_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2520_Assoc11_di" bpmnElement="W2520_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2521" name="W2521. Post-Disaster Emergency Product Pricing &amp; Availability Management" isExecutable="false">
      <bpmn:documentation>Trigger: Post-disaster reopening or DTI price monitoring activation
Frequency: 6–10 activations per year
Volume: 500–2,000 SKUs across 20–100 stores
Owner: Pricing Manager
Participants: Pricing Mgr, Legal, Merchandising, Store Ops, DTI Liaison
Source: workflow W2521 — Post-Disaster Emergency Product Pricing &amp; Availability Management</bpmn:documentation>
      <bpmn:laneSet id="W2521_LaneSet4">
        <bpmn:lane id="W2521_Lane1" name="Pricing Manager">
        <bpmn:flowNodeRef>W2521_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2521_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2521_Lane2" name="Merchandising">
        <bpmn:flowNodeRef>W2521_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2521_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W2521_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2521_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2521_Start5" name="Post-disaster reopening or DTI price monitoring activation">
        <bpmn:outgoing>W2521_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2521_Task6" name="Pricing Manager reviews DTI price freeze status for disaster-affected areas…">
        <bpmn:documentation>Step 1: Pricing Manager reviews DTI price freeze status for disaster-affected areas; confirms which SKUs remain under price control and which have been released; updates system pricing rules accordingly
Responsible (R): Pricing Manager
Accountable (A): VP Merchandising
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W2521_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2521_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2521_Task7" name="Merchandising manages availability communication: updates ecommerce stock…">
        <bpmn:documentation>Step 2: Merchandising manages availability communication: updates ecommerce stock levels (may show limited availability), coordinates with Marketing on &quot;rebuilding supplies available&quot; messaging, ensures BOPIS availability reflects actual post-disaster stock
Responsible (R): Merchandising / Marketing
Accountable (A): CMO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2521_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2521_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2521_Task8" name="Store Ops monitors for stockouts on emergency items; escalates to Supply Chain…">
        <bpmn:documentation>Step 3: Store Ops monitors for stockouts on emergency items; escalates to Supply Chain for emergency replenishment; implements purchase limits per customer on scarce items (e.g., max 10 plywood sheets) to prevent hoarding
Responsible (R): Store Manager / Supply Planning
Accountable (A): VP Supply Chain
Duration: Ongoing (1–2 weeks post-event)</bpmn:documentation>
        <bpmn:incoming>W2521_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2521_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2521_End9" name="Complete">
        <bpmn:incoming>W2521_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2521_Annotation10">
        <bpmn:text>Controls: - CTL-438 (ensure controlled execution — Post-Disaster Recovery &amp; Community Support (PA-69.3).) | - operational: Pricing Manager review and approval gate
Owner: Pricing Manager</bpmn:text>
      </bpmn:textAnnotation>
