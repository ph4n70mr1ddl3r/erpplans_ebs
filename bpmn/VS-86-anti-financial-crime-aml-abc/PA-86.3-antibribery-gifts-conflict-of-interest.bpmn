      </bpmn:startEvent>
      <bpmn:userTask id="W2939_Task5" name="Employee reports solicitation or facilitation-payment demand via confidential…">
        <bpmn:documentation>Step 1: Employee reports solicitation or facilitation-payment demand via confidential channel within 24 hours
Responsible (R): Employee
Accountable (A): Compliance Officer
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W2939_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2939_Flow12</bpmn:outgoing>
      </bpmn:userTask>
