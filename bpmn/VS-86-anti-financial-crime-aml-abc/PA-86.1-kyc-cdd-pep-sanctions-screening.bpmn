        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2921_Start5" name="New customer onboarding (trade/corporate) or periodic review">
        <bpmn:outgoing>W2921_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2921_Task6" name="Compliance risk-scores each customer: geography, business type, transaction…">
        <bpmn:documentation>Step 1: Compliance risk-scores each customer: geography, business type, transaction profile, ownership; assigns low/medium/high tier
Responsible (R): Compliance Analyst
Accountable (A): Compliance Officer
Duration: Per onboarding</bpmn:documentation>
        <bpmn:incoming>W2921_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2921_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2921_Task7" name="Compliance determines due-diligence level: Simplified (low), Standard (medium)…">
        <bpmn:documentation>Step 2: Compliance determines due-diligence level: Simplified (low), Standard (medium), Enhanced (high) per AMLA risk-based approach
Responsible (R): Compliance
Accountable (A): Compliance Officer
Duration: Per onboarding</bpmn:documentation>
        <bpmn:incoming>W2921_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2921_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2921_Task8" name="AR configures KYC tier in customer master; applies transaction monitoring…">
        <bpmn:documentation>Step 3: AR configures KYC tier in customer master; applies transaction monitoring rules; flags for periodic review cadence
Responsible (R): AR
Accountable (A): AR Manager
Duration: Per onboarding</bpmn:documentation>
        <bpmn:incoming>W2921_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2921_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2921_End9" name="Complete">
        <bpmn:incoming>W2921_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2921_Annotation10">
        <bpmn:text>Controls: - CTL-237 (ensure AML/KYC &amp; sanctions compliance.) | - operational: documented risk methodology
Owner: Compliance Analyst</bpmn:text>
      </bpmn:textAnnotation>
