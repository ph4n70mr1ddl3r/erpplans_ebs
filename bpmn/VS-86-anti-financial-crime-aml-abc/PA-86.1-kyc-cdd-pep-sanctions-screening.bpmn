    <bpmn:process id="W_W2923" name="W2923. PEP (Politically Exposed Person) Screening &amp; Enhanced Due Diligence" isExecutable="false">
      <bpmn:documentation>Trigger: Onboarding or periodic screening
Frequency: Event-driven + continuous re-screening
Volume: All customers/vendors/UBOs
Owner: Compliance Analyst
Participants: Compliance, Senior Management (approval)
Source: workflow W2923 — PEP (Politically Exposed Person) Screening &amp; Enhanced Due Diligence</bpmn:documentation>
      <bpmn:laneSet id="W2923_LaneSet3">
        <bpmn:lane id="W2923_Lane1" name="Compliance Analyst">
        <bpmn:flowNodeRef>W2923_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2923_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2923_Lane2" name="Compliance">
        <bpmn:flowNodeRef>W2923_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2923_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2923_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2923_Start4" name="Onboarding or periodic screening">
        <bpmn:outgoing>W2923_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2923_Task5" name="Compliance screens customer/vendor/UBO against PEP database (domestic and…">
        <bpmn:documentation>Step 1: Compliance screens customer/vendor/UBO against PEP database (domestic and foreign PEPs, family, close associates)
Responsible (R): Compliance Analyst
Accountable (A): Compliance Officer
Duration: Per screening</bpmn:documentation>
        <bpmn:incoming>W2923_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2923_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2923_Task6" name="On PEP match, Compliance conducts Enhanced Due Diligence: source of…">
        <bpmn:documentation>Step 2: On PEP match, Compliance conducts Enhanced Due Diligence: source of wealth/funds, business rationale, senior-management approval
Responsible (R): Compliance
Accountable (A): Compliance Officer
Duration: Per match</bpmn:documentation>
        <bpmn:incoming>W2923_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2923_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2923_Task7" name="Compliance sets enhanced monitoring (lower thresholds, more frequent review)…">
        <bpmn:documentation>Step 3: Compliance sets enhanced monitoring (lower thresholds, more frequent review); documents approval and rationale
Responsible (R): Compliance
Accountable (A): Compliance Officer
Duration: Per match</bpmn:documentation>
        <bpmn:incoming>W2923_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2923_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2923_End8" name="Complete">
        <bpmn:incoming>W2923_Flow14</bpmn:incoming>
      </bpmn:endEvent>
