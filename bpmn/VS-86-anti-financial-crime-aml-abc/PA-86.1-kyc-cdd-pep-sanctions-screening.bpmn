        <bpmn:flowNodeRef>W2922_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2922_Start4" name="New vendor onboarding or periodic review">
        <bpmn:outgoing>W2922_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2922_Task5" name="Procurement collects vendor KYC: SEC/DTI registration, financials, ownership…">
        <bpmn:documentation>Step 1: Procurement collects vendor KYC: SEC/DTI registration, financials, ownership structure; identifies Ultimate Beneficial Owner (UBO) ≥ 25%
Responsible (R): Procurement
Accountable (A): Procurement Manager
Duration: Per onboarding</bpmn:documentation>
        <bpmn:incoming>W2922_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2922_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2922_Task6" name="Compliance validates UBO integrity, screens against PEP/sanctions/adverse…">
        <bpmn:documentation>Step 2: Compliance validates UBO integrity, screens against PEP/sanctions/adverse media; assigns vendor risk tier
Responsible (R): Compliance
Accountable (A): Compliance Officer
Duration: Per onboarding</bpmn:documentation>
        <bpmn:incoming>W2922_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2922_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2922_Task7" name="Procurement configures vendor master with KYC tier and review cadence; flags…">
        <bpmn:documentation>Step 3: Procurement configures vendor master with KYC tier and review cadence; flags high-risk vendors for enhanced controls
Responsible (R): Procurement
Accountable (A): Procurement Manager
Duration: Per onboarding</bpmn:documentation>
        <bpmn:incoming>W2922_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2922_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2922_End8" name="Complete">
        <bpmn:incoming>W2922_Flow14</bpmn:incoming>
      </bpmn:endEvent>
