Responsible (R): IT Security
Accountable (A): Compliance Officer
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W2928_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2928_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2928_Task8" name="DPO supports data-subject requests (access, correction, deletion within legal…">
