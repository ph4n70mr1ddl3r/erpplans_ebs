    <bpmn:process id="W_W2922" name="W2922. Vendor/Supplier Due Diligence, UBO Identification &amp; Beneficial Ownership" isExecutable="false">
      <bpmn:documentation>Trigger: New vendor onboarding or periodic review
Frequency: Event-driven + annual
Volume: ~800–1,000 active vendors; import vendors higher-risk
Owner: Procurement Compliance Analyst
Participants: Procurement, Compliance, Legal
Source: workflow W2922 — Vendor/Supplier Due Diligence, UBO Identification &amp; Beneficial Ownership</bpmn:documentation>
      <bpmn:laneSet id="W2922_LaneSet3">
        <bpmn:lane id="W2922_Lane1" name="Procurement">
        <bpmn:flowNodeRef>W2922_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2922_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2922_Start4</bpmn:flowNodeRef>
