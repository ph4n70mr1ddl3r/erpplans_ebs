    <bpmn:process id="W_W2921" name="W2921. Customer KYC Tiering, Risk Scoring &amp; Due Diligence Level Determination" isExecutable="false">
      <bpmn:documentation>Trigger: New customer onboarding (trade/corporate) or periodic review
Frequency: Event-driven + periodic
Volume: ~5,200 AR trade/corporate accounts; ~50,000 MSME (VS-82)
Owner: Compliance Analyst
Participants: Compliance, AR, Trade Sales
Source: workflow W2921 — Customer KYC Tiering, Risk Scoring &amp; Due Diligence Level Determination</bpmn:documentation>
      <bpmn:laneSet id="W2921_LaneSet4">
        <bpmn:lane id="W2921_Lane1" name="Compliance Analyst">
        <bpmn:flowNodeRef>W2921_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2921_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
