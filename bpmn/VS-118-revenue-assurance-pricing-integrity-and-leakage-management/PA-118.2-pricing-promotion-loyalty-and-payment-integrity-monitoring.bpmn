      <bpmn:sequenceFlow id="W3697_Flow12" sourceRef="W3697_Task5" targetRef="W3697_Task6" />
      <bpmn:sequenceFlow id="W3697_Flow13" sourceRef="W3697_Task6" targetRef="W3697_End7" />
    </bpmn:process>
