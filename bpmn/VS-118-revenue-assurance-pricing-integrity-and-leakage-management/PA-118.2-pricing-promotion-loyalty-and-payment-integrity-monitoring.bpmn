      <bpmn:sequenceFlow id="W3698_Flow12" sourceRef="W3698_Task5" targetRef="W3698_Task6" />
      <bpmn:sequenceFlow id="W3698_Flow13" sourceRef="W3698_Task6" targetRef="W3698_End7" />
    </bpmn:process>
