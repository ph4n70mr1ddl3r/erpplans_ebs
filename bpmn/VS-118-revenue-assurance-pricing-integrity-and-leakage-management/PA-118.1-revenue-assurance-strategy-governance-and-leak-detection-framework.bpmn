        <bpmndi:BPMNShape id="W3690_Task6_di" bpmnElement="W3690_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3690_Start3_di" bpmnElement="W3690_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3690_End7_di" bpmnElement="W3690_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3690_Annotation8_di" bpmnElement="W3690_Annotation8"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3690_Flow10_di" bpmnElement="W3690_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3690_Flow11_di" bpmnElement="W3690_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3690_Flow12_di" bpmnElement="W3690_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3690_Flow13_di" bpmnElement="W3690_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3690_Assoc9_di" bpmnElement="W3690_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3691" name="W3691. Sales-to-Cash Reconciliation &amp; Settlement Integrity" isExecutable="false">
      <bpmn:documentation>Trigger: Daily/monthly close; settlement cycle
Frequency: Daily + monthly
Volume: ~PHP 5.19B monthly revenue; ~2.8M POS transactions; ~515K ecommerce orders/yr
Owner: Revenue Assurance Lead / Finance
Participants: Revenue Assurance Lead, Finance (links to VS-17.1), Treasury (links to VS-18.1), Payments (links to VS-80), POS/IT (links to VS-08/VS-27), Bank reconciliation, Ecommerce (links to VS-10)
Source: workflow W3691 — Sales-to-Cash Reconciliation &amp; Settlement Integrity</bpmn:documentation>
      <bpmn:laneSet id="W3691_LaneSet2">
        <bpmn:lane id="W3691_Lane1" name="Revenue Assurance Lead">
        <bpmn:flowNodeRef>W3691_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3691_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3691_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3691_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3691_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3691_Start3" name="Daily/monthly close; settlement cycle">
        <bpmn:outgoing>W3691_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3691_Task4" name="Revenue Assurance Lead/Finance perform sales-to-cash reconciliation: reconcile…">
        <bpmn:documentation>Step 1: Revenue Assurance Lead/Finance perform sales-to-cash reconciliation: reconcile POS gross sales (by tender) to bank deposits (links to W215), ecommerce collections to payment-gateway settlement (links to VS-80.2), and AR collections to remittance (links to VS-16.3); identify and investigate unmatched/variance items daily
Responsible (R): Revenue Assurance Lead / Finance / Treasury
Accountable (A): Revenue Assurance Lead
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W3691_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3691_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3691_Task5" name="Revenue Assurance Lead/Payments verify settlement integrity: confirm…">
        <bpmn:documentation>Step 2: Revenue Assurance Lead/Payments verify settlement integrity: confirm acquirer/PSP settlement amounts, MDR/fee deductions, chargebacks and refunds reconcile to expected revenue (links to VS-80.2), and that multi-tender/split-payment transactions captured full value
Responsible (R): Revenue Assurance Lead / Payments / Treasury
Accountable (A): Revenue Assurance Lead
Duration: Daily + monthly</bpmn:documentation>
        <bpmn:incoming>W3691_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3691_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3691_Task6" name="Revenue Assurance Lead drive variance resolution: investigate sales-vs-cash…">
        <bpmn:documentation>Step 3: Revenue Assurance Lead drive variance resolution: investigate sales-vs-cash gaps to root cause (system sync failure, offline-mode gap, unbanked cash, settlement timing), recover/correct, and feed findings to leak-detection (W3705) and controls (W3693); report reconciliation integrity to month-end close (links to VS-17.1)
Responsible (R): Revenue Assurance Lead / Finance / IT
Accountable (A): Revenue Assurance Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3691_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3691_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3691_End7" name="Complete">
        <bpmn:incoming>W3691_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3691_Annotation8">
        <bpmn:text>Controls: - CTL-108 (ensure revenue leakage detection &amp; recovery.) | - operational: daily reconciliation and root-cause; operational: offline-integrity check (W3692)
Owner: Revenue Assurance Lead / Finance</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3691_Assoc9" sourceRef="W3691_Annotation8" targetRef="W3691_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3691_Flow10" sourceRef="W3691_Start3" targetRef="W3691_Task4" />
      <bpmn:sequenceFlow id="W3691_Flow11" sourceRef="W3691_Task4" targetRef="W3691_Task5" />
      <bpmn:sequenceFlow id="W3691_Flow12" sourceRef="W3691_Task5" targetRef="W3691_Task6" />
      <bpmn:sequenceFlow id="W3691_Flow13" sourceRef="W3691_Task6" targetRef="W3691_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3691_diag">
      <bpmndi:BPMNPlane id="W3691_plane" bpmnElement="W_W3691">
        <bpmndi:BPMNShape id="W3691_Lane1_di" bpmnElement="W3691_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3691_Task4_di" bpmnElement="W3691_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3691_Task5_di" bpmnElement="W3691_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3691_Task6_di" bpmnElement="W3691_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3691_Start3_di" bpmnElement="W3691_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3691_End7_di" bpmnElement="W3691_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3691_Annotation8_di" bpmnElement="W3691_Annotation8"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3691_Flow10_di" bpmnElement="W3691_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3691_Flow11_di" bpmnElement="W3691_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3691_Flow12_di" bpmnElement="W3691_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3691_Flow13_di" bpmnElement="W3691_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3691_Assoc9_di" bpmnElement="W3691_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3692" name="W3692. POS Transaction Integrity &amp; Data-Flow Assurance" isExecutable="false">
      <bpmn:documentation>Trigger: Near-real-time event stream; daily integrity check; offline-mode event
Frequency: Continuous + daily
Volume: ~2.8M POS transactions/month; 600 terminals
Owner: Revenue Assurance Lead / POS-IT
Participants: Revenue Assurance Lead, POS/IT (links to VS-08/VS-27.2), Finance (links to VS-17.1), Loss Prevention (links to VS-23), BI (links to VS-28.1)
Source: workflow W3692 — POS Transaction Integrity &amp; Data-Flow Assurance</bpmn:documentation>
      <bpmn:laneSet id="W3692_LaneSet2">
        <bpmn:lane id="W3692_Lane1" name="Revenue Assurance Lead">
        <bpmn:flowNodeRef>W3692_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3692_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3692_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3692_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3692_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3692_Start3" name="Near-real-time event stream; daily integrity check; offline-mode event">
        <bpmn:outgoing>W3692_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3692_Task4" name="Revenue Assurance Lead/POS-IT monitor POS transaction integrity in…">
        <bpmn:documentation>Step 1: Revenue Assurance Lead/POS-IT monitor POS transaction integrity in near-real-time: confirm every transaction (and its lines) flows POS → event stream → ERP → GL without loss/duplication, detect sequence gaps, duplicate transaction IDs, failed-sync flags, and offline-mode transactions pending sync
Responsible (R): Revenue Assurance Lead / POS-IT / BI
Accountable (A): Revenue Assurance Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3692_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3692_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3692_Task5" name="Revenue Assurance Lead/POS-IT assure offline-mode revenue capture: when a POS…">
        <bpmn:documentation>Step 2: Revenue Assurance Lead/POS-IT assure offline-mode revenue capture: when a POS operates offline (network outage, ≥8-hour cache per profile §5), ensure the offline transaction cache syncs fully on reconnect, no transactions are lost/duplicated, and offline sales reconcile to cash; investigate sync failures
Responsible (R): Revenue Assurance Lead / POS-IT
Accountable (A): Revenue Assurance Lead
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W3692_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3692_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3692_Task6" name="Revenue Assurance Lead trace end-to-end data integrity periodically: select…">
        <bpmn:documentation>Step 3: Revenue Assurance Lead trace end-to-end data integrity periodically: select sample transactions and trace from POS scan → price lookup → tender → receipt → event → ERP journal → GL revenue (the W348 step-5 test, now operationalized continuously), and remediate data-flow defects with IT (links to VS-27.1)
Responsible (R): Revenue Assurance Lead / IT / Finance
Accountable (A): Revenue Assurance Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3692_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3692_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3692_End7" name="Complete">
        <bpmn:incoming>W3692_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3692_Annotation8">
        <bpmn:text>Controls: - CTL-583 (ensure controlled execution — Revenue Assurance Strategy, Governance &amp; Leak Detection Framework (PA-118.1).) | - operational: offline-integrity monitoring; operational: idempotency checks
Owner: Revenue Assurance Lead / POS-IT</bpmn:text>
      </bpmn:textAnnotation>
