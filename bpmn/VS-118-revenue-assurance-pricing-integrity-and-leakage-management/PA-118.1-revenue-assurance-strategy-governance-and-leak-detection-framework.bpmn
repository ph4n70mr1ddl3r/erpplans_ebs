      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3690" name="W3690. Revenue Leakage Taxonomy &amp; Risk Mapping" isExecutable="false">
      <bpmn:documentation>Trigger: Program strategy (W3689); new channel/product; loss event
Frequency: Maintained + on change
Volume: Enterprise leakage taxonomy
Owner: Revenue Assurance Lead / Finance
Participants: Revenue Assurance Lead, Finance (links to VS-17.4), BI (links to VS-28.1), POS (links to VS-08), Ecommerce (links to VS-10), Loyalty/Gift Card (links to VS-13/VS-54), Promotions (links to VS-58), Payments (links to VS-80), Loss Prevention (links to VS-23), Audit (links to VS-21.3)
Source: workflow W3690 — Revenue Leakage Taxonomy &amp; Risk Mapping</bpmn:documentation>
      <bpmn:laneSet id="W3690_LaneSet2">
        <bpmn:lane id="W3690_Lane1" name="Revenue Assurance Lead">
        <bpmn:flowNodeRef>W3690_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3690_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3690_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3690_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3690_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3690_Start3" name="Program strategy (W3689); new channel/product; loss event">
        <bpmn:outgoing>W3690_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3690_Task4" name="Revenue Assurance Lead/Finance maintain the revenue-leakage taxonomy: the…">
        <bpmn:documentation>Step 1: Revenue Assurance Lead/Finance maintain the revenue-leakage taxonomy: the catalog of leakage vectors — pricing/price-override error, promo/markdown mis-application, loyalty-points/gift-card mis-issuance or abuse, discount-stacking, mandatory-discount/tax-exempt mis-application, VAT/tax mis-calculation, catch-weight/cut-length measurement error, refund/reversal leakage, payment/MDR/fee discrepancy, settlement/timing gap, POS-to-GL data-integrity failure, ecommerce/marketplace/3P settlement gap, system-rounding
Responsible (R): Revenue Assurance Lead / Finance / BI
Accountable (A): Revenue Assurance Lead
Duration: Maintained</bpmn:documentation>
        <bpmn:incoming>W3690_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3690_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3690_Task5" name="Revenue Assurance Lead map each leakage vector to the channel/system/control…">
        <bpmn:documentation>Step 2: Revenue Assurance Lead map each leakage vector to the channel/system/control where it originates and the detection control that should catch it (W3693), quantify the potential exposure per vector, and risk-rank to prioritize monitoring; identify controls gaps
Responsible (R): Revenue Assurance Lead / BI
Accountable (A): Revenue Assurance Lead
Duration: Maintained</bpmn:documentation>
        <bpmn:incoming>W3690_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3690_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3690_Task6" name="Revenue Assurance Lead publish the leakage taxonomy and risk map to the…">
        <bpmn:documentation>Step 3: Revenue Assurance Lead publish the leakage taxonomy and risk map to the program, drive coverage of every vector by a monitoring control (W3693/W3697–W3704), and refresh on channel/product/control change; report residual exposure to governance (links to W3689)
Responsible (R): Revenue Assurance Lead / Finance
Accountable (A): Revenue Assurance Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3690_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3690_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3690_End7" name="Complete">
        <bpmn:incoming>W3690_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3690_Annotation8">
        <bpmn:text>Controls: - CTL-108 (ensure revenue leakage detection &amp; recovery.) | - operational: periodic taxonomy refresh and benchmarking; operational: exposure modeling
Owner: Revenue Assurance Lead / Finance</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3690_Assoc9" sourceRef="W3690_Annotation8" targetRef="W3690_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3690_Flow10" sourceRef="W3690_Start3" targetRef="W3690_Task4" />
      <bpmn:sequenceFlow id="W3690_Flow11" sourceRef="W3690_Task4" targetRef="W3690_Task5" />
      <bpmn:sequenceFlow id="W3690_Flow12" sourceRef="W3690_Task5" targetRef="W3690_Task6" />
      <bpmn:sequenceFlow id="W3690_Flow13" sourceRef="W3690_Task6" targetRef="W3690_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3690_diag">
      <bpmndi:BPMNPlane id="W3690_plane" bpmnElement="W_W3690">
        <bpmndi:BPMNShape id="W3690_Lane1_di" bpmnElement="W3690_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3690_Task4_di" bpmnElement="W3690_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
