    <bpmn:process id="W_W640" name="W640. Merchant Fee Analysis &amp; Payment Cost Optimization" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly settlement data availability; quarterly negotiation cycle
Frequency: Monthly analysis; quarterly optimization review; annual contract renegotiation
Volume: ~2.8M POS card/e-wallet transactions/month + ~42,900 ecommerce payment transactions/month
Owner: Finance Analyst
Participants: Treasury Analyst, IT Payments Lead, Finance Manager
Source: workflow W640 — Merchant Fee Analysis &amp; Payment Cost Optimization</bpmn:documentation>
      <bpmn:laneSet id="W640_LaneSet7">
        <bpmn:lane id="W640_Lane1" name="System">
        <bpmn:flowNodeRef>W640_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W640_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W640_Lane2" name="Finance Analyst">
        <bpmn:flowNodeRef>W640_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W640_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W640_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W640_Lane3" name="Treasury Analyst">
        <bpmn:flowNodeRef>W640_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W640_Lane4" name="Finance Manager">
        <bpmn:flowNodeRef>W640_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W640_Lane5" name="IT Payments Lead">
        <bpmn:flowNodeRef>W640_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W640_Lane6" name="CFO">
        <bpmn:flowNodeRef>W640_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W640_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W640_Start8" name="Monthly settlement data availability; quarterly negotiation cycle">
        <bpmn:outgoing>W640_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W640_Task9" name="System aggregates total payment processing cost by payment method (Visa/MC/JCB…">
        <bpmn:documentation>Step 1: System aggregates total payment processing cost by payment method (Visa/MC/JCB, GCash, Maya, GrabPay, bank transfer, COD), by channel (POS vs. ecommerce), and by store
Responsible (R): System
Accountable (A): Finance Analyst
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W640_Flow20</bpmn:incoming>
        <bpmn:outgoing>W640_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W640_Task10" name="Finance Analyst calculates effective merchant fee rate (total fees ÷ total…">
        <bpmn:documentation>Step 2: Finance Analyst calculates effective merchant fee rate (total fees ÷ total transaction value) per payment method, per channel, and per store; compares against contracted rates
Responsible (R): Finance Analyst
Accountable (A): Finance Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W640_Flow21</bpmn:incoming>
        <bpmn:outgoing>W640_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W640_Task11" name="Finance Analyst calculates total cost of acceptance per payment method…">
        <bpmn:documentation>Step 3: Finance Analyst calculates total cost of acceptance per payment method including: MDR, per-transaction fees, settlement fees, chargeback costs, FX conversion fees, and cash handling costs (CIT per W174, deposit processing, reconciliation labor)
Responsible (R): Finance Analyst
Accountable (A): Finance Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W640_Flow22</bpmn:incoming>
        <bpmn:outgoing>W640_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W640_Task12" name="Treasury Analyst tracks payment method mix shift (cash → card → e-wallet)…">
        <bpmn:documentation>Step 4: Treasury Analyst tracks payment method mix shift (cash → card → e-wallet) month-over-month; models financial impact of mix changes on total payment cost
Responsible (R): Treasury Analyst
Accountable (A): Finance Manager
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W640_Flow23</bpmn:incoming>
        <bpmn:outgoing>W640_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W640_Task13" name="Quarterly: Finance Analyst benchmarks BuildRight&#x27;s effective rates against…">
        <bpmn:documentation>Step 5: Quarterly: Finance Analyst benchmarks BuildRight&#x27;s effective rates against Philippine market rates and peer retailers; identifies overpriced payment methods
Responsible (R): Finance Analyst
Accountable (A): Finance Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W640_Flow24</bpmn:incoming>
        <bpmn:outgoing>W640_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W640_Task14" name="Finance Manager develops optimization recommendations: volume-based rate…">
        <bpmn:documentation>Step 6: Finance Manager develops optimization recommendations: volume-based rate renegotiation targets, customer steering strategies (e-wallet incentives over card), surcharging feasibility assessment per payment method, new payment method evaluation (QR PH, BNPL)
Responsible (R): Finance Manager
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W640_Flow25</bpmn:incoming>
        <bpmn:outgoing>W640_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W640_Task15" name="IT Payments Lead evaluates technical feasibility of recommended changes…">
        <bpmn:documentation>Step 7: IT Payments Lead evaluates technical feasibility of recommended changes; estimates implementation cost and timeline
Responsible (R): IT Payments Lead
Accountable (A): Finance Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W640_Flow26</bpmn:incoming>
        <bpmn:outgoing>W640_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W640_Task16" name="CFO approves optimization plan; Finance Manager executes rate renegotiations…">
        <bpmn:documentation>Step 8: CFO approves optimization plan; Finance Manager executes rate renegotiations with acquirers and e-wallet providers
Responsible (R): CFO
Accountable (A): CEO
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W640_Flow27</bpmn:incoming>
        <bpmn:outgoing>W640_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W640_End17" name="Complete">
        <bpmn:incoming>W640_Flow28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W640_Annotation18">
        <bpmn:text>Controls: - CTL-285 (ensure controlled execution — Vendor Payment &amp; Reconciliation (PA-15.2).) | - operational: dedicated monthly analysis and quarterly optimization reviews; operational: quarterly evaluation of new payment methods in Step 6; operational: multi-provider strategy and competitive bidding
Owner: Finance Analyst</bpmn:text>
      </bpmn:textAnnotation>
