    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W101" name="W101. Customer Refund &amp; Credit Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer return approved (W12), ecommerce cancellation (W98), special order deposit refund (W38), customer deposit refund (W94), loyalty points reversal (W17), or credit note issuance from complaint resolution (W41)
Frequency: ~50,000–58,000 refund/credit transactions/month across all channels (per the Volume)
Volume: ~48,000–56,000 in-store return refunds/credits (the W12/W1627 returns canon of ~56,000/month, mostly settled at POS by refund or store credit) + ~3,300–4,200 ecommerce refunds (the W12B store drop-off canon; all ecommerce return requests ≈ 4,000–5,000/month per W1623, the remainder refunded on courier pickup) + ~50–100 deposit refunds + ~50–200 trade credit notes/month
Owner: CSR (in-store refunds); Ecommerce Customer Support (online refunds); AR Supervisor (trade/corporate credit notes)
Participants: CSR, Cashier, Store Manager, AR Supervisor, AR Clerk, Ecommerce Customer Support, Treasury Analyst, Controller
Source: workflow W101 — Customer Refund &amp; Credit Processing</bpmn:documentation>
      <bpmn:laneSet id="W101_LaneSet7">
        <bpmn:lane id="W101_Lane1" name="Per trigger workflow">
        <bpmn:flowNodeRef>W101_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W101_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W101_Lane2" name="System">
        <bpmn:flowNodeRef>W101_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W101_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W101_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W101_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W101_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W101_Lane3" name="Cashier">
        <bpmn:flowNodeRef>W101_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W101_Lane4" name="AR Clerk">
        <bpmn:flowNodeRef>W101_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W101_Lane5" name="AR Supervisor">
        <bpmn:flowNodeRef>W101_Task17</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W101_Lane6" name="Controller">
        <bpmn:flowNodeRef>W101_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W101_End19</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W101_Start8" name="Customer return approved (W12), ecommerce cancellation (W98), special order deposit…">
        <bpmn:outgoing>W101_Flow22</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W101_Task9" name="Trigger workflow">
        <bpmn:documentation>Step 1: Trigger workflow creates refund request: (a) W12 (return) — CSR processes return in POS; system creates refund request, (b) W98 (ecommerce cancellation) — system auto-creates refund for unfulfilled orders, (c) W38 (deposit refund) — CSR processes deposit refund with reason code, (d) W94 (advance payment refund) — CSR or AR Clerk processes with reason code, (e) W41 (complaint credit) — CS Manager authorizes refund or credit as complaint resolution, (f) W17 (loyalty reversal) — system auto-reverses points on return
Responsible (R): Per trigger workflow
Accountable (A): Per authorization matrix
Duration: Per trigger workflow</bpmn:documentation>
        <bpmn:incoming>W101_Flow22</bpmn:incoming>
        <bpmn:outgoing>W101_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W101_Task10" name="System validates refund request: (a) original transaction exists and is within…">
        <bpmn:documentation>Step 2: System validates refund request: (a) original transaction exists and is within refund policy window, (b) refund amount does not exceed original transaction amount, (c) no prior refund already processed against same transaction (duplicate refund prevention), (d) authorization per matrix above is met — system enforces approval routing by amount and channel
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W101_Flow23</bpmn:incoming>
        <bpmn:outgoing>W101_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W101_Task11" name="System determines refund payment method(s) from original transaction: for…">
        <bpmn:documentation>Step 3: System determines refund payment method(s) from original transaction: for split-tender transactions, system identifies each payment method and calculates pro-rata refund amount per method
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W101_Flow24</bpmn:incoming>
        <bpmn:outgoing>W101_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W101_Task12" name="Cash refund">
        <bpmn:documentation>Step 4: Cash refund: Cashier disburses from cash drawer; system reduces cash drawer accountability; if cash in drawer insufficient, Cashier uses petty cash float (W25) with Store Manager override; system logs cash refund with cashier ID and drawer balance impact
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W101_Flow25</bpmn:incoming>
        <bpmn:outgoing>W101_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W101_Task13" name="Card/e-wallet refund">
        <bpmn:documentation>Step 5: Card/e-wallet refund: System initiates electronic refund via payment processor integration; if terminal-based refund: Cashier processes refund on POS terminal; if gateway-based refund (ecommerce): system processes via PayMongo/Dragonpay API; system tracks refund settlement status (initiated → settled → confirmed)
Responsible (R): System / Cashier
Accountable (A): —
Duration: 2 min (terminal) / automated (gateway)</bpmn:documentation>
        <bpmn:incoming>W101_Flow26</bpmn:incoming>
        <bpmn:outgoing>W101_Flow27</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W101_Task14" name="Trade account credit">
        <bpmn:documentation>Step 6: Trade account credit: AR Clerk posts credit memo to customer&#x27;s AR account; system reduces outstanding balance; credit memo reference linked to original invoice and trigger workflow
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W101_Flow27</bpmn:incoming>
        <bpmn:outgoing>W101_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W101_Task15" name="Gift card / loyalty reversal">
        <bpmn:documentation>Step 7: Gift card / loyalty reversal: System reloads gift card balance or deducts loyalty points; reversal posted with reference to original earning transaction
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W101_Flow28</bpmn:incoming>
        <bpmn:outgoing>W101_Flow29</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W101_Task16" name="System posts GL entries: (a) Dr. Revenue (or Dr. Sales Returns) / Cr. Cash (or…">
        <bpmn:documentation>Step 8: System posts GL entries: (a) Dr. Revenue (or Dr. Sales Returns) / Cr. Cash (or AR-Card/E-Wallet/Ecommerce) — revenue reversal at original amount, (b) Dr. Inventory / Cr. COGS — if physical goods returned to stock (for non-damaged returns), (c) Dr. VAT Output / Cr. VAT Payable — output VAT reversal on refund (BIR requirement: refund must reverse the VAT portion), (d) system generates BIR-compliant credit memo or refund receipt with all required fields (TIN, original invoice reference, credit memo number, reason code, VAT reversal)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W101_Flow29</bpmn:incoming>
        <bpmn:outgoing>W101_Flow30</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W101_Task17" name="Weekly: AR Supervisor and Treasury Analyst review unsettled electronic refund…">
        <bpmn:documentation>Step 9: Weekly: AR Supervisor and Treasury Analyst review unsettled electronic refund report — refunds initiated but not yet settled by card processors or payment gateways; aged items &gt; 7 business days investigated with processor
Responsible (R): AR Supervisor / Treasury Analyst
Accountable (A): Controller
Duration: 30 min/week</bpmn:documentation>
        <bpmn:incoming>W101_Flow30</bpmn:incoming>
        <bpmn:outgoing>W101_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W101_Task18" name="Monthly: Controller reviews refund analytics: (a) total refund volume by…">
        <bpmn:documentation>Step 10: Monthly: Controller reviews refund analytics: (a) total refund volume by channel (in-store, ecommerce, trade), (b) refund rate as % of revenue by channel (target: in-store &lt; 3%, ecommerce &lt; 8%), (c) top refund reasons, (d) refund processing time (initiation to settlement), (e) authorization compliance — spot-check 20 random refunds per tier for proper approval, (f) refund fraud indicators — high-refund stores, high-refund employees, repeat refund customers
Responsible (R): Controller
Accountable (A): CFO
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W101_Flow31</bpmn:incoming>
        <bpmn:outgoing>W101_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W101_End19" name="Complete">
        <bpmn:incoming>W101_Flow32</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W101_Annotation20">
        <bpmn:text>Controls: - CTL-285 (ensure controlled execution — Vendor Payment &amp; Reconciliation (PA-15.2).) | - operational: CSR (in-store refunds); Ecommerce Customer Support (online refunds); AR Supervisor (trade/corporate credit notes) review and approval gate
Owner: CSR (in-store refunds); Ecommerce Customer Support (online refunds); AR Supervisor (trade/corporate credit notes)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W101_Assoc21" sourceRef="W101_Annotation20" targetRef="W101_Start8" associationDirection="None" />
      <bpmn:sequenceFlow id="W101_Flow22" sourceRef="W101_Start8" targetRef="W101_Task9" />
      <bpmn:sequenceFlow id="W101_Flow23" sourceRef="W101_Task9" targetRef="W101_Task10" />
      <bpmn:sequenceFlow id="W101_Flow24" sourceRef="W101_Task10" targetRef="W101_Task11" />
