    <bpmn:process id="W_W635" name="W635. PFRS 16 Lease Accounting Operations" isExecutable="false">
      <bpmn:documentation>Trigger: New lease commencement (W117); lease modification; monthly recurring journal entries; lease termination
Frequency: Ongoing for new/modified leases; monthly for recurring entries
Volume: ~200 store leases + 4 DC leases + equipment leases + ~10 new leases/year (new stores)
Owner: Accounting Manager
Participants: Property Manager, Senior Accountant, External Auditor (annual review)
Source: workflow W635 — PFRS 16 Lease Accounting Operations</bpmn:documentation>
      <bpmn:laneSet id="W635_LaneSet5">
        <bpmn:lane id="W635_Lane1" name="Property Manager">
        <bpmn:flowNodeRef>W635_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W635_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W635_Lane2" name="Senior Accountant">
        <bpmn:flowNodeRef>W635_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W635_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W635_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W635_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
