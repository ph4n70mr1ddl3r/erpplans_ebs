      <bpmn:sequenceFlow id="W1310_Flow17" sourceRef="W1310_Task8" targetRef="W1310_Task9" />
      <bpmn:sequenceFlow id="W1310_Flow18" sourceRef="W1310_Task9" targetRef="W1310_End10" />
    </bpmn:process>
