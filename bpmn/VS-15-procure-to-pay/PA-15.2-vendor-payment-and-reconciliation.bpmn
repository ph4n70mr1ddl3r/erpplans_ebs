      <bpmndi:BPMNPlane id="W662_plane" bpmnElement="W_W662">
        <bpmndi:BPMNShape id="W662_Lane1_di" bpmnElement="W662_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
