    <bpmn:process id="W_W662" name="W662. AP Aging Management &amp; Vendor Payment Prioritization" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly AP aging review cycle
Frequency: Weekly review; monthly comprehensive analysis
Volume: ~8,500–9,500 AP invoices/month across 5 entities; ~800–1,000 active vendor accounts (per profile §6.5)
Owner: AP Manager
Participants: Treasury Analyst, Finance Manager, Category Manager (for strategic vendors)
Source: workflow W662 — AP Aging Management &amp; Vendor Payment Prioritization</bpmn:documentation>
      <bpmn:laneSet id="W662_LaneSet4">
        <bpmn:lane id="W662_Lane1" name="AP Manager">
        <bpmn:flowNodeRef>W662_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W662_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W662_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W662_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W662_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W662_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W662_Lane2" name="Treasury Analyst">
        <bpmn:flowNodeRef>W662_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W662_Lane3" name="Finance Manager">
        <bpmn:flowNodeRef>W662_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W662_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W662_Start5" name="Weekly AP aging review cycle">
        <bpmn:outgoing>W662_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W662_Task6" name="System auto-generates AP aging report by entity: current, 1-30, 31-60, 61-90…">
        <bpmn:documentation>Step 1: System auto-generates AP aging report by entity: current, 1-30, 31-60, 61-90, 90+ days with vendor-level detail
Responsible (R): AP Manager
Accountable (A): AP Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W662_Flow16</bpmn:incoming>
        <bpmn:outgoing>W662_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W662_Task7" name="AP Manager reviews total AP aging by entity and consolidated; flags aging…">
        <bpmn:documentation>Step 2: AP Manager reviews total AP aging by entity and consolidated; flags aging buckets exceeding policy thresholds (total 90+ &gt; 5% of AP, any single vendor &gt; PHP 5M in 90+)
Responsible (R): AP Manager
Accountable (A): Finance Manager
Duration: 1 hr</bpmn:documentation>
        <bpmn:incoming>W662_Flow17</bpmn:incoming>
        <bpmn:outgoing>W662_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W662_Task8" name="AP Manager classifies vendor payment priority: Priority 1 (statutory — BIR…">
        <bpmn:documentation>Step 3: AP Manager classifies vendor payment priority: Priority 1 (statutory — BIR, SSS, PhilHealth, Pag-IBIG — legal deadline), Priority 2 (critical supply — top 20 vendors by spend, single-source vendors, import LC payments per W232), Priority 3 (standard terms — Net 30/60 vendors), Priority 4 (disputed — per W244, on hold)
Responsible (R): AP Manager
Accountable (A): Category Manager
Duration: 1 hr</bpmn:documentation>
        <bpmn:incoming>W662_Flow18</bpmn:incoming>
        <bpmn:outgoing>W662_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W662_Task9" name="Treasury Analyst provides cash position input per W30 and weekly forecast per…">
        <bpmn:documentation>Step 4: Treasury Analyst provides cash position input per W30 and weekly forecast per W589; AP Manager adjusts payment proposal accordingly
Responsible (R): Treasury Analyst
Accountable (A): AP Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W662_Flow19</bpmn:incoming>
        <bpmn:outgoing>W662_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W662_Task10" name="AP Manager identifies early payment discount opportunities using annualized ROI…">
        <bpmn:documentation>Step 5: AP Manager identifies early payment discount opportunities using annualized ROI calculation per W324 dynamic discounting
Responsible (R): AP Manager
Accountable (A): Finance Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W662_Flow20</bpmn:incoming>
        <bpmn:outgoing>W662_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W662_Task11" name="Monthly: AP Manager produces comprehensive aging analysis with trend (vs. prior…">
        <bpmn:documentation>Step 6: Monthly: AP Manager produces comprehensive aging analysis with trend (vs. prior month, vs. same period last year), DPO calculation per entity, and vendor concentration risk
Responsible (R): AP Manager
Accountable (A): Finance Manager
Duration: 4 hrs</bpmn:documentation>
        <bpmn:incoming>W662_Flow21</bpmn:incoming>
        <bpmn:outgoing>W662_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W662_Task12" name="Finance Manager reviews monthly analysis; escalates to CFO if total AP overdue…">
        <bpmn:documentation>Step 7: Finance Manager reviews monthly analysis; escalates to CFO if total AP overdue &gt; 15% of total AP or if critical vendor relationships at risk
Responsible (R): Finance Manager
Accountable (A): CFO
Duration: 1 hr</bpmn:documentation>
        <bpmn:incoming>W662_Flow22</bpmn:incoming>
        <bpmn:outgoing>W662_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W662_End13" name="Complete">
        <bpmn:incoming>W662_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W662_Annotation14">
        <bpmn:text>Controls: - CTL-285 (ensure controlled execution — Vendor Payment &amp; Reconciliation (PA-15.2).) | - operational: AP Manager review and approval gate
Owner: AP Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W662_Assoc15" sourceRef="W662_Annotation14" targetRef="W662_Start5" associationDirection="None" />
