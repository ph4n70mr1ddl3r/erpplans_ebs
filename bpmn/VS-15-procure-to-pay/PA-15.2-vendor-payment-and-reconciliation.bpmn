    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W939" name="W939. Customer Store Credit Expiration Management &amp; Unclaimed Credit Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled monthly batch process identifying store credits approaching expiration or past expiration
Frequency: Monthly batch; ~3,000–5,000 active store credit records at any time; ~500–700 new credits issued per month (from returns per W12, refunds per W101, damaged item compensation per W549; one register with W28/W781)
Volume: Average store credit value: PHP 500–3,000; ~15–20% of store credits expire unclaimed; annual unclaimed credit value: ~PHP 1.5–3M
Owner: AR Supervisor
Participants: AR Supervisor, CS Manager, Finance Controller, Customer
Source: workflow W939 — Customer Store Credit Expiration Management &amp; Unclaimed Credit Processing</bpmn:documentation>
      <bpmn:laneSet id="W939_LaneSet4">
        <bpmn:lane id="W939_Lane1" name="System">
        <bpmn:flowNodeRef>W939_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W939_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W939_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W939_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W939_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W939_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W939_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W939_Lane2" name="AR Supervisor">
        <bpmn:flowNodeRef>W939_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W939_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W939_Lane3" name="Finance Controller">
        <bpmn:flowNodeRef>W939_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W939_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W939_Start5" name="Scheduled monthly batch process identifying store credits approaching expiration or past…">
        <bpmn:outgoing>W939_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W939_Task6" name="System issues store credit when triggered by: customer return (W12) where…">
        <bpmn:documentation>Step 1: System issues store credit when triggered by: customer return (W12) where customer selects store credit over refund; customer complaint resolution (W41) where CS Manager issues credit as compensation; damaged/open-box item discount residual (W549); store credit gift card (W28); each credit issuance creates a record: credit ID, customer ID (loyalty account or guest name + mobile), issuance date, original amount, expiration date (configurable per credit type: returns = 12 months, compensation = 6 months, gift = no expiry per Philippine gift card law), source transaction reference
Responsible (R): System
Accountable (A): CS Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W939_Flow18</bpmn:incoming>
        <bpmn:outgoing>W939_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W939_Task7" name="Monthly batch (1st of each month): system identifies store credits in three…">
        <bpmn:documentation>Step 2: Monthly batch (1st of each month): system identifies store credits in three categories: (a) credits approaching expiration in 60 days — &quot;Expiring Soon&quot; list; (b) credits approaching expiration in 30 days — &quot;Final Notice&quot; list; (c) credits past expiration date with no activity — &quot;Expired&quot; list
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W939_Flow19</bpmn:incoming>
        <bpmn:outgoing>W939_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W939_Task8" name="For &quot;Expiring Soon&quot; credits (T-60 days): system sends customer notification via…">
        <bpmn:documentation>Step 3: For &quot;Expiring Soon&quot; credits (T-60 days): system sends customer notification via SMS (primary), email (secondary), and app push notification (loyalty members): &quot;You have a store credit of PHP [amount] expiring on [date]. Use it at any BuildRight store or online. View your credits: [link]&quot;; notification includes loyalty app deep link to credit balance page
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W939_Flow20</bpmn:incoming>
        <bpmn:outgoing>W939_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W939_Task9" name="For &quot;Final Notice&quot; credits (T-30 days): system sends final customer…">
        <bpmn:documentation>Step 4: For &quot;Final Notice&quot; credits (T-30 days): system sends final customer notification with urgency messaging: &quot;FINAL NOTICE: Your store credit of PHP [amount] expires in 30 days on [date]. Visit any BuildRight store or buildright.com.ph to redeem&quot;; if customer has no valid contact (guest with no mobile/email), CS Manager attempts contact via receipt lookup
Responsible (R): System / CS Manager
Accountable (A): AR Supervisor
Duration: Automated + 30 min</bpmn:documentation>
        <bpmn:incoming>W939_Flow21</bpmn:incoming>
        <bpmn:outgoing>W939_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W939_Task10" name="For &quot;Expired&quot; credits (past expiration): system auto-sets credit status to…">
        <bpmn:documentation>Step 5: For &quot;Expired&quot; credits (past expiration): system auto-sets credit status to &quot;Expired&quot;; expired credits remain visible in customer&#x27;s loyalty profile (grayed out) for 12 months for reference but are not redeemable; system generates BIR-compliant credit note adjustment referencing original credit note
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W939_Flow22</bpmn:incoming>
        <bpmn:outgoing>W939_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W939_Task11" name="AR Supervisor reviews monthly expiration batch report: total credits expired…">
        <bpmn:documentation>Step 6: AR Supervisor reviews monthly expiration batch report: total credits expired, total value expired, customer notification delivery success rate, credit utilization rate (credits used vs. issued); identifies anomalies (unusually high expiration rate, same customer repeatedly losing credits, credits &gt; PHP 10,000 expiring)
Responsible (R): AR Supervisor
Accountable (A): Finance Controller
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W939_Flow23</bpmn:incoming>
        <bpmn:outgoing>W939_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W939_Task12" name="Finance Controller reviews unclaimed credit accounting: system posts journal…">
        <bpmn:documentation>Step 7: Finance Controller reviews unclaimed credit accounting: system posts journal entry for expired credits — Dr. Store Credit Liability (deferred revenue) / Cr. Other Income (breakage income); breakage income recognized per PFRS 15 (store credit with no obligation to refund cash, expected breakage based on historical pattern); monthly breakage estimate vs. actual reconciliation
Responsible (R): System / Finance Controller
Accountable (A): CFO
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W939_Flow24</bpmn:incoming>
        <bpmn:outgoing>W939_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W939_Task13" name="Quarterly: AR Supervisor generates store credit program analytics — issuance…">
        <bpmn:documentation>Step 8: Quarterly: AR Supervisor generates store credit program analytics — issuance volume by source (returns, complaints, compensation), utilization rate, average days to redemption, expiration rate by value band, customer contact success rate, breakage rate trend; Finance Controller reviews breakage accounting adequacy with external auditor per W487 (revenue recognition)
Responsible (R): AR Supervisor / Finance Controller
Accountable (A): CFO
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W939_Flow25</bpmn:incoming>
        <bpmn:outgoing>W939_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W939_Task14" name="Annual: Finance Controller reviews store credit expiration policy for…">
        <bpmn:documentation>Step 9: Annual: Finance Controller reviews store credit expiration policy for regulatory compliance — Philippine Consumer Act (RA 7394) does not explicitly regulate store credit expiry; however, DTI consumer protection guidelines and best practices recommend reasonable expiration periods; Finance Controller recommends policy adjustments (e.g., extending returns credit from 12 to 18 months, or eliminating expiration for credits &gt; PHP 5,000) for CFO approval
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: 4 hours/year</bpmn:documentation>
        <bpmn:incoming>W939_Flow26</bpmn:incoming>
        <bpmn:outgoing>W939_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W939_End15" name="Complete">
        <bpmn:incoming>W939_Flow27</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W939_Annotation16">
        <bpmn:text>Controls: - CTL-285 (ensure controlled execution — Vendor Payment &amp; Reconciliation (PA-15.2).) | - operational: AR Supervisor review and approval gate; operational: periodic reconciliation against source documents
Owner: AR Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W939_Assoc17" sourceRef="W939_Annotation16" targetRef="W939_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W939_Flow18" sourceRef="W939_Start5" targetRef="W939_Task6" />
      <bpmn:sequenceFlow id="W939_Flow19" sourceRef="W939_Task6" targetRef="W939_Task7" />
      <bpmn:sequenceFlow id="W939_Flow20" sourceRef="W939_Task7" targetRef="W939_Task8" />
      <bpmn:sequenceFlow id="W939_Flow21" sourceRef="W939_Task8" targetRef="W939_Task9" />
      <bpmn:sequenceFlow id="W939_Flow22" sourceRef="W939_Task9" targetRef="W939_Task10" />
      <bpmn:sequenceFlow id="W939_Flow23" sourceRef="W939_Task10" targetRef="W939_Task11" />
      <bpmn:sequenceFlow id="W939_Flow24" sourceRef="W939_Task11" targetRef="W939_Task12" />
      <bpmn:sequenceFlow id="W939_Flow25" sourceRef="W939_Task12" targetRef="W939_Task13" />
      <bpmn:sequenceFlow id="W939_Flow26" sourceRef="W939_Task13" targetRef="W939_Task14" />
      <bpmn:sequenceFlow id="W939_Flow27" sourceRef="W939_Task14" targetRef="W939_End15" />
    </bpmn:process>
