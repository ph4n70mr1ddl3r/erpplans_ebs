        <bpmn:flowNodeRef>W635_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W635_Lane4" name="Accounting Manager">
        <bpmn:flowNodeRef>W635_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W635_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W635_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W635_Start6" name="New lease commencement (W117); lease modification; monthly recurring journal entries…">
        <bpmn:outgoing>W635_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W635_Task7" name="For new lease: Property Manager provides lease agreement details (term, payment…">
        <bpmn:documentation>Step 1: For new lease: Property Manager provides lease agreement details (term, payment schedule, escalation clauses, renewal options, incentives) to Accounting Manager
Responsible (R): Property Manager
Accountable (A): Accounting Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W635_Flow18</bpmn:incoming>
        <bpmn:outgoing>W635_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W635_Task8" name="Senior Accountant calculates initial right-of-use (ROU) asset and lease…">
        <bpmn:documentation>Step 2: Senior Accountant calculates initial right-of-use (ROU) asset and lease liability using incremental borrowing rate per entity; inputs into lease accounting module
Responsible (R): Senior Accountant
Accountable (A): Accounting Manager
Duration: 1 day/lease</bpmn:documentation>
        <bpmn:incoming>W635_Flow19</bpmn:incoming>
        <bpmn:outgoing>W635_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W635_Task9" name="System auto-generates monthly journal entries: ROU asset depreciation, lease…">
        <bpmn:documentation>Step 3: System auto-generates monthly journal entries: ROU asset depreciation, lease liability interest accretion, lease payment allocation (principal vs. interest)
Responsible (R): System
Accountable (A): Senior Accountant
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W635_Flow20</bpmn:incoming>
        <bpmn:outgoing>W635_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W635_Task10" name="Senior Accountant reviews auto-generated entries for accuracy; verifies against…">
        <bpmn:documentation>Step 4: Senior Accountant reviews auto-generated entries for accuracy; verifies against lease payment schedule; posts to GL
Responsible (R): Senior Accountant
Accountable (A): Accounting Manager
Duration: 0.5 day/month for all leases</bpmn:documentation>
        <bpmn:incoming>W635_Flow21</bpmn:incoming>
        <bpmn:outgoing>W635_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W635_Task11" name="For lease modifications (rent escalation, extension, early termination per…">
        <bpmn:documentation>Step 5: For lease modifications (rent escalation, extension, early termination per W45): Senior Accountant remeasures ROU asset and lease liability; adjusts remaining lease term and payment schedule
Responsible (R): Senior Accountant
Accountable (A): Accounting Manager
Duration: 0.5 day/modification</bpmn:documentation>
        <bpmn:incoming>W635_Flow22</bpmn:incoming>
        <bpmn:outgoing>W635_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W635_Task12" name="For IC leases (Depot Inc. leasing from Property Mgmt Inc.): Accounting Manager…">
        <bpmn:documentation>Step 6: For IC leases (Depot Inc. leasing from Property Mgmt Inc.): Accounting Manager verifies IC lease elimination matches during consolidation (W234); confirms transfer pricing compliance (W235)
Responsible (R): Accounting Manager
Accountable (A): Finance Manager
Duration: Monthly check</bpmn:documentation>
        <bpmn:incoming>W635_Flow23</bpmn:incoming>
        <bpmn:outgoing>W635_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W635_Task13" name="Quarterly: Senior Accountant prepares PFRS 16 disclosure schedule (lease…">
        <bpmn:documentation>Step 7: Quarterly: Senior Accountant prepares PFRS 16 disclosure schedule (lease liabilities maturity analysis, ROU asset reconciliation, lease expense breakdown, variable lease payments, sale-and-leaseback disclosures)
Responsible (R): Senior Accountant
Accountable (A): Accounting Manager
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W635_Flow24</bpmn:incoming>
        <bpmn:outgoing>W635_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W635_Task14" name="Annual: External Auditor reviews lease accounting policies, sample of ROU…">
        <bpmn:documentation>Step 8: Annual: External Auditor reviews lease accounting policies, sample of ROU calculations, and disclosure completeness
Responsible (R): Accounting Manager
Accountable (A): Finance Manager
Duration: During annual audit</bpmn:documentation>
        <bpmn:incoming>W635_Flow25</bpmn:incoming>
        <bpmn:outgoing>W635_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W635_End15" name="Complete">
        <bpmn:incoming>W635_Flow26</bpmn:incoming>
      </bpmn:endEvent>
