    <bpmn:process id="W_W461" name="W461. Intercompany Fulfillment &amp; Logistics Fee Settlement" isExecutable="false">
      <bpmn:documentation>Trigger: Month-end close cycle
Frequency: Monthly
Volume: ~12,000–20,000 movements/month (W4, W19, W22; per W277)
Owner: Intercompany Accountant
Participants: Logistics Finance, Ecom Finance, Controller
Source: workflow W461 — Intercompany Fulfillment &amp; Logistics Fee Settlement</bpmn:documentation>
      <bpmn:laneSet id="W461_LaneSet4">
        <bpmn:lane id="W461_Lane1" name="Intercompany Accountant">
        <bpmn:flowNodeRef>W461_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W461_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W461_Lane2" name="System">
        <bpmn:flowNodeRef>W461_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W461_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W461_Lane3" name="IC Accountant">
        <bpmn:flowNodeRef>W461_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W461_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W461_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W461_Start5" name="Month-end close cycle">
        <bpmn:outgoing>W461_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W461_Task6" name="Transactional Audit">
        <bpmn:documentation>Step 1: Transactional Audit: Extract all DC receipts, pick-and-pack events, and outbound shipments from WMS/ERP
Responsible (R): Intercompany Accountant
Accountable (A): —
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W461_Flow14</bpmn:incoming>
        <bpmn:outgoing>W461_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W461_Task7" name="Unit Cost Application">
        <bpmn:documentation>Step 2: Unit Cost Application: Apply &quot;Per-Pallet Receipt,&quot; &quot;Per-Case Pick,&quot; and &quot;Per-Drop Delivery&quot; rates per the Transfer Pricing Master
Responsible (R): System / IC Accountant
Accountable (A): Controller
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W461_Flow15</bpmn:incoming>
        <bpmn:outgoing>W461_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W461_Task8" name="Ecom Fulfillment Fee">
        <bpmn:documentation>Step 3: Ecom Fulfillment Fee: Apply &quot;Per-Order&quot; fulfillment fee for Digital Commerce Inc. services (BOPIS/Delivery)
Responsible (R): IC Accountant
Accountable (A): Ecom Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W461_Flow16</bpmn:incoming>
        <bpmn:outgoing>W461_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W461_Task9" name="Reconciliation">
        <bpmn:documentation>Step 4: Reconciliation: Compare computed total vs. Logistics Inc. operating costs to ensure &quot;Cost + Markup&quot; target is met
Responsible (R): IC Accountant
Accountable (A): Logistics Mgr
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W461_Flow17</bpmn:incoming>
        <bpmn:outgoing>W461_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W461_Task10" name="Settlement Journal">
        <bpmn:documentation>Step 5: Settlement Journal: Post IC Netting entries; trigger cash settlement via W14.8
Responsible (R): System / IC Accountant
Accountable (A): CFO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W461_Flow18</bpmn:incoming>
        <bpmn:outgoing>W461_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W461_End11" name="Complete">
        <bpmn:incoming>W461_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W461_Annotation12">
        <bpmn:text>Controls: - CTL-284 (ensure controlled execution — Invoice Processing &amp; Matching (PA-15.1).) | - operational: periodic reconciliation against source documents
Owner: Intercompany Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W461_Assoc13" sourceRef="W461_Annotation12" targetRef="W461_Start5" associationDirection="None" />
