      <bpmn:sequenceFlow id="W919_Flow19" sourceRef="W919_Task10" targetRef="W919_Task11" />
      <bpmn:sequenceFlow id="W919_Flow20" sourceRef="W919_Task11" targetRef="W919_Task12" />
      <bpmn:sequenceFlow id="W919_Flow21" sourceRef="W919_Task12" targetRef="W919_End13" />
    </bpmn:process>
