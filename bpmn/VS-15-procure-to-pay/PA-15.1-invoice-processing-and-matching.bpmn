      <bpmn:startEvent id="W498_Start7" name="Import vendor requires advance payment before shipment; or vendor agreement specifies…">
        <bpmn:outgoing>W498_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W498_Task8" name="Buyer requests advance payment linked to approved import PO; specifies amount…">
        <bpmn:documentation>Step 1: Buyer requests advance payment linked to approved import PO; specifies amount (percentage or fixed), vendor bank details, and expected shipment date
Responsible (R): Buyer
Accountable (A): AP Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W498_Flow20</bpmn:incoming>
        <bpmn:outgoing>W498_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W498_Task9" name="System validates: PO is approved, vendor is active, advance amount within PO…">
        <bpmn:documentation>Step 2: System validates: PO is approved, vendor is active, advance amount within PO value, vendor bank details verified against vendor master
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W498_Flow21</bpmn:incoming>
        <bpmn:outgoing>W498_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W498_Task10" name="System routes advance payment request through approval workflow: ≤PHP 500K → AP…">
        <bpmn:documentation>Step 3: System routes advance payment request through approval workflow: ≤PHP 500K → AP Supervisor; ≤PHP 2M → Controller; &gt;PHP 2M → CFO
Responsible (R): System
Accountable (A): CFO (tiered)
Duration: 5 min review</bpmn:documentation>
        <bpmn:incoming>W498_Flow22</bpmn:incoming>
        <bpmn:outgoing>W498_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W498_Task11" name="AP Supervisor or Treasury Analyst executes bank transfer via electronic banking…">
        <bpmn:documentation>Step 4: AP Supervisor or Treasury Analyst executes bank transfer via electronic banking (W320); system records advance payment with link to PO
Responsible (R): Treasury Analyst
Accountable (A): AP Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W498_Flow23</bpmn:incoming>
        <bpmn:outgoing>W498_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W498_Task12" name="System posts journal entry: Dr. Vendor Advance (asset) / Cr. Bank; advance…">
        <bpmn:documentation>Step 5: System posts journal entry: Dr. Vendor Advance (asset) / Cr. Bank; advance tracked separately from regular AP balance
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W498_Flow24</bpmn:incoming>
        <bpmn:outgoing>W498_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W498_Task13" name="System monitors advance aging: advance outstanding &gt;30 days past expected…">
        <bpmn:documentation>Step 6: System monitors advance aging: advance outstanding &gt;30 days past expected shipment date → alert to Buyer; &gt;60 days → escalation to AP Supervisor
Responsible (R): System
Accountable (A): AP Supervisor
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W498_Flow25</bpmn:incoming>
        <bpmn:outgoing>W498_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W498_Task14" name="At goods receipt against the PO: system automatically applies advance payment…">
        <bpmn:documentation>Step 7: At goods receipt against the PO: system automatically applies advance payment against vendor invoice (partial or full settlement)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W498_Flow26</bpmn:incoming>
        <bpmn:outgoing>W498_Flow27</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W498_Task15" name="If advance exceeds invoice: system creates vendor credit balance; AP Clerk…">
        <bpmn:documentation>Step 8: If advance exceeds invoice: system creates vendor credit balance; AP Clerk decides on refund request or application to next PO
Responsible (R): AP Clerk
Accountable (A): AP Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W498_Flow27</bpmn:incoming>
        <bpmn:outgoing>W498_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W498_Task16" name="Monthly: AP Supervisor reviews advance aging report; follows up on unapplied…">
        <bpmn:documentation>Step 9: Monthly: AP Supervisor reviews advance aging report; follows up on unapplied advances &gt;60 days; escalates to Controller for potential write-off
Responsible (R): AP Supervisor
Accountable (A): Controller
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W498_Flow28</bpmn:incoming>
        <bpmn:outgoing>W498_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W498_End17" name="Complete">
        <bpmn:incoming>W498_Flow29</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W498_Annotation18">
        <bpmn:text>Controls: - CTL-284 (ensure controlled execution — Invoice Processing &amp; Matching (PA-15.1).) | - operational: vendor risk tiering (W491)
Owner: AP Supervisor</bpmn:text>
      </bpmn:textAnnotation>
