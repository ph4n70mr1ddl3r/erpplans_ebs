      <bpmn:sequenceFlow id="W767_Flow23" sourceRef="W767_Task12" targetRef="W767_Task13" />
      <bpmn:sequenceFlow id="W767_Flow24" sourceRef="W767_Task13" targetRef="W767_End14" />
    </bpmn:process>
