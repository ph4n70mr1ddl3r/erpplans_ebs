      <bpmndi:BPMNPlane id="W770_plane" bpmnElement="W_W770">
        <bpmndi:BPMNShape id="W770_Lane1_di" bpmnElement="W770_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
