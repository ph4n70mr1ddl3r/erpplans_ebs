        <bpmndi:BPMNShape id="W767_Start6_di" bpmnElement="W767_Start6"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W767_End14_di" bpmnElement="W767_End14"><dc:Bounds x="1890" y="657" width="36" height="36" /></bpmndi:BPMNShape>
