        <bpmndi:BPMNShape id="W770_Start5_di" bpmnElement="W770_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W770_End13_di" bpmnElement="W770_End13"><dc:Bounds x="1890" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W770_Annotation14_di" bpmnElement="W770_Annotation14"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W770_Flow16_di" bpmnElement="W770_Flow16"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W770_Flow17_di" bpmnElement="W770_Flow17"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W770_Flow18_di" bpmnElement="W770_Flow18"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W770_Flow19_di" bpmnElement="W770_Flow19"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W770_Flow20_di" bpmnElement="W770_Flow20"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W770_Flow21_di" bpmnElement="W770_Flow21"><di:waypoint x="1420" y="505" /><di:waypoint x="1450" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W770_Flow22_di" bpmnElement="W770_Flow22"><di:waypoint x="1630" y="165" /><di:waypoint x="1660" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W770_Flow23_di" bpmnElement="W770_Flow23"><di:waypoint x="1840" y="165" /><di:waypoint x="1890" y="505" /></bpmndi:BPMNEdge>
