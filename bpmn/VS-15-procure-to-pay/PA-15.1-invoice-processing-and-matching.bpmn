        <bpmndi:BPMNEdge id="W500_Flow23_di" bpmnElement="W500_Flow23"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W500_Flow24_di" bpmnElement="W500_Flow24"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="505" /></bpmndi:BPMNEdge>
