      <bpmn:sequenceFlow id="W7_Flow25" sourceRef="W7_Task10" targetRef="W7_Task11" />
      <bpmn:sequenceFlow id="W7_Flow26" sourceRef="W7_Task11" targetRef="W7_Task12" />
      <bpmn:sequenceFlow id="W7_Flow27" sourceRef="W7_Task12" targetRef="W7_Task13" />
      <bpmn:sequenceFlow id="W7_Flow28" sourceRef="W7_Task13" targetRef="W7_Task14" />
      <bpmn:sequenceFlow id="W7_Flow29" sourceRef="W7_Task14" targetRef="W7_Task15" />
      <bpmn:sequenceFlow id="W7_Flow30" sourceRef="W7_Task15" targetRef="W7_Task16" />
      <bpmn:sequenceFlow id="W7_Flow31" sourceRef="W7_Task16" targetRef="W7_Task17" />
      <bpmn:sequenceFlow id="W7_Flow32" sourceRef="W7_Task17" targetRef="W7_End18" />
    </bpmn:process>
