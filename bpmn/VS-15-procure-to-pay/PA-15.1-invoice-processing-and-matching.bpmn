    <bpmn:process id="W_W498" name="W498. Vendor Advance Payment &amp; Prepayment Management" isExecutable="false">
      <bpmn:documentation>Trigger: Import vendor requires advance payment before shipment; or vendor agreement specifies prepayment terms
Frequency: ~30–50 advance payments/month (primarily for import vendors)
Volume: ~40 average/month; peaks during seasonal buy periods (+30%)
Owner: AP Supervisor
Participants: Buyer, Treasury Analyst, AP Clerk, Controller
Source: workflow W498 — Vendor Advance Payment &amp; Prepayment Management</bpmn:documentation>
      <bpmn:laneSet id="W498_LaneSet6">
        <bpmn:lane id="W498_Lane1" name="Buyer">
        <bpmn:flowNodeRef>W498_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W498_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
