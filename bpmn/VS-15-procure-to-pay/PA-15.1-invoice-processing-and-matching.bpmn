    <bpmn:process id="W_W500" name="W500. Transfer Order In-Transit Damage Claim &amp; Resolution" isExecutable="false">
      <bpmn:documentation>Trigger: Receiving location (store or DC) discovers damaged goods during transfer order receipt
Frequency: ~80–120 damage incidents/month across all DC→Store and Store→Store transfers
Volume: ~100 average/month; ~1,200/year; higher during rainy season (+20%)
Owner: Logistics Supervisor (DC-originated) / Store Manager (store-originated)
Participants: Receiving Clerk, Logistics Supervisor, Carrier Account Manager, Insurance Coordinator, AP Clerk
Source: workflow W500 — Transfer Order In-Transit Damage Claim &amp; Resolution</bpmn:documentation>
      <bpmn:laneSet id="W500_LaneSet6">
        <bpmn:lane id="W500_Lane1" name="Receiving Clerk">
        <bpmn:flowNodeRef>W500_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W500_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W500_Lane2" name="System">
        <bpmn:flowNodeRef>W500_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W500_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W500_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W500_Lane3" name="Logistics Supervisor">
        <bpmn:flowNodeRef>W500_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W500_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W500_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W500_Lane4" name="Insurance Coordinator">
        <bpmn:flowNodeRef>W500_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W500_Lane5" name="AP Clerk">
        <bpmn:flowNodeRef>W500_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W500_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W500_Start7" name="Receiving location (store or DC) discovers damaged goods during transfer order receipt">
        <bpmn:outgoing>W500_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W500_Task8" name="Receiving Clerk identifies damaged items during transfer order goods receipt…">
        <bpmn:documentation>Step 1: Receiving Clerk identifies damaged items during transfer order goods receipt; documents damage with photos (minimum 3: overview, close-up of damage, shipping label); records damage in system against transfer order line
Responsible (R): Receiving Clerk
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W500_Flow20</bpmn:incoming>
        <bpmn:outgoing>W500_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W500_Task9" name="System captures: damage quantity, damage severity (minor — saleable at…">
        <bpmn:documentation>Step 2: System captures: damage quantity, damage severity (minor — saleable at discount; major — unsaleable but salvageable; total loss), transfer order number, originating location, carrier, driver name
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W500_Flow21</bpmn:incoming>
        <bpmn:outgoing>W500_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W500_Task10" name="System identifies responsible party based on carrier assignment on transfer…">
        <bpmn:documentation>Step 3: System identifies responsible party based on carrier assignment on transfer order: owned fleet → Logistics Supervisor investigates; 3PL carrier → carrier claim process initiated; inter-DC → DC operations investigates
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W500_Flow22</bpmn:incoming>
        <bpmn:outgoing>W500_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W500_Task11" name="Logistics Supervisor reviews damage report and photos; confirms damage…">
        <bpmn:documentation>Step 4: Logistics Supervisor reviews damage report and photos; confirms damage classification; determines if insurance claim applies (shipments above PHP 50K declared value or insured cargo)
Responsible (R): Logistics Supervisor
Accountable (A): Logistics Supervisor
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W500_Flow23</bpmn:incoming>
        <bpmn:outgoing>W500_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W500_Task12" name="If carrier-responsible: system generates carrier damage claim notification with…">
        <bpmn:documentation>Step 5: If carrier-responsible: system generates carrier damage claim notification with evidence package (photos, transfer order, delivery receipt); sends to carrier with 10-day response SLA
Responsible (R): Logistics Supervisor
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W500_Flow24</bpmn:incoming>
        <bpmn:outgoing>W500_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W500_Task13" name="If insurance-applicable: Insurance Coordinator initiates insurance claim (W59)…">
        <bpmn:documentation>Step 6: If insurance-applicable: Insurance Coordinator initiates insurance claim (W59) with supporting documentation
Responsible (R): Insurance Coordinator
Accountable (A): Controller
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W500_Flow25</bpmn:incoming>
        <bpmn:outgoing>W500_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W500_Task14" name="System adjusts inventory at receiving location: minor damage → inventory status…">
        <bpmn:documentation>Step 7: System adjusts inventory at receiving location: minor damage → inventory status changed to &quot;damaged - pending disposition&quot;; major/total loss → inventory written off with transfer order reference
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W500_Flow26</bpmn:incoming>
        <bpmn:outgoing>W500_Flow27</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W500_Task15" name="AP Clerk processes carrier chargeback or credit: if carrier accepts liability →…">
        <bpmn:documentation>Step 8: AP Clerk processes carrier chargeback or credit: if carrier accepts liability → debit memo to carrier (reduces carrier AP); if carrier disputes → escalation to Logistics Supervisor for resolution
Responsible (R): AP Clerk
Accountable (A): AP Supervisor
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W500_Flow27</bpmn:incoming>
        <bpmn:outgoing>W500_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W500_Task16" name="Monthly: Logistics Supervisor reviews damage trend dashboard — damage rate by…">
        <bpmn:documentation>Step 9: Monthly: Logistics Supervisor reviews damage trend dashboard — damage rate by carrier, route, product category, and severity; identifies chronic carriers or problem routes for corrective action
Responsible (R): Logistics Supervisor
Accountable (A): VP Supply Chain
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W500_Flow28</bpmn:incoming>
        <bpmn:outgoing>W500_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W500_End17" name="Complete">
        <bpmn:incoming>W500_Flow29</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W500_Annotation18">
        <bpmn:text>Controls: - CTL-284 (ensure controlled execution — Invoice Processing &amp; Matching (PA-15.1).) | - operational: photographic evidence at receiving; operational: carrier liability clauses in 3PL contracts (W62B)
Owner: Logistics Supervisor (DC-originated) / Store Manager (store-originated)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W500_Assoc19" sourceRef="W500_Annotation18" targetRef="W500_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W500_Flow20" sourceRef="W500_Start7" targetRef="W500_Task8" />
      <bpmn:sequenceFlow id="W500_Flow21" sourceRef="W500_Task8" targetRef="W500_Task9" />
      <bpmn:sequenceFlow id="W500_Flow22" sourceRef="W500_Task9" targetRef="W500_Task10" />
      <bpmn:sequenceFlow id="W500_Flow23" sourceRef="W500_Task10" targetRef="W500_Task11" />
      <bpmn:sequenceFlow id="W500_Flow24" sourceRef="W500_Task11" targetRef="W500_Task12" />
      <bpmn:sequenceFlow id="W500_Flow25" sourceRef="W500_Task12" targetRef="W500_Task13" />
      <bpmn:sequenceFlow id="W500_Flow26" sourceRef="W500_Task13" targetRef="W500_Task14" />
      <bpmn:sequenceFlow id="W500_Flow27" sourceRef="W500_Task14" targetRef="W500_Task15" />
      <bpmn:sequenceFlow id="W500_Flow28" sourceRef="W500_Task15" targetRef="W500_Task16" />
      <bpmn:sequenceFlow id="W500_Flow29" sourceRef="W500_Task16" targetRef="W500_End17" />
    </bpmn:process>
