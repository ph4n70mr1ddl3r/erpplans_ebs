    <bpmn:process id="W_W7C" name="W7C. Non-PO / Recurring Expense Invoice Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Utility bill, service invoice, rent, or other recurring expense received without a Purchase Order
Frequency: ~2,000–3,000 non-PO invoices/month across all locations (200 stores + 4 DCs + HQ); combined with ~6,715 merchandise/vendor invoices (W7), total AP invoice volume is ~8,500–9,500/month; the ~6,715 figure in model-company-profile §10.2 refers to merchandise/vendor invoices only
Volume: ~10–15 recurring vendor invoices per store per month (electricity, water, internet, rent to Property Mgmt Inc., security, cleaning, waste disposal)
Owner: AP Supervisor
Participants: AP Clerk, Store Manager / Department Head (approval), AP Supervisor
Source: workflow W7C — Non-PO / Recurring Expense Invoice Processing</bpmn:documentation>
      <bpmn:laneSet id="W7C_LaneSet4">
        <bpmn:lane id="W7C_Lane1" name="AP Clerk">
        <bpmn:flowNodeRef>W7C_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W7C_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W7C_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W7C_Lane2" name="System">
        <bpmn:flowNodeRef>W7C_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W7C_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W7C_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W7C_Lane3" name="AP Supervisor">
        <bpmn:flowNodeRef>W7C_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W7C_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W7C_Start5" name="Utility bill, service invoice, rent, or other recurring expense received without a…">
        <bpmn:outgoing>W7C_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W7C_Task6" name="AP Clerk receives and logs non-PO invoice (utility bill, service invoice, lease…">
        <bpmn:documentation>Step 1: AP Clerk receives and logs non-PO invoice (utility bill, service invoice, lease payment); classifies as recurring or one-time
Responsible (R): AP Clerk
Accountable (A): AP Supervisor
Duration: 5 min/invoice</bpmn:documentation>
        <bpmn:incoming>W7C_Flow15</bpmn:incoming>
        <bpmn:outgoing>W7C_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W7C_Task7" name="System attempts 2-way match: invoice amount vs. contract amount or budget…">
        <bpmn:documentation>Step 2: System attempts 2-way match: invoice amount vs. contract amount or budget allocation per cost center
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W7C_Flow16</bpmn:incoming>
        <bpmn:outgoing>W7C_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W7C_Task8" name="If invoice within tolerance of contract/budget: route to cost center owner for…">
        <bpmn:documentation>Step 3: If invoice within tolerance of contract/budget: route to cost center owner for approval (Store Manager for store expenses, Department Head for HQ expenses)
Responsible (R): System
Accountable (A): Cost center owner
Duration: 1 min/auto-approved</bpmn:documentation>
        <bpmn:incoming>W7C_Flow17</bpmn:incoming>
        <bpmn:outgoing>W7C_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W7C_Task9" name="If invoice exceeds budget or no contract on file: route to cost center owner…">
        <bpmn:documentation>Step 4: If invoice exceeds budget or no contract on file: route to cost center owner for review with explanation of variance
Responsible (R): AP Clerk / Cost center owner
Accountable (A): AP Supervisor
Duration: 5 min/invoice</bpmn:documentation>
        <bpmn:incoming>W7C_Flow18</bpmn:incoming>
        <bpmn:outgoing>W7C_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W7C_Task10" name="Approved non-PO invoices queued for payment in standard payment run (W7.9–11)…">
        <bpmn:documentation>Step 5: Approved non-PO invoices queued for payment in standard payment run (W7.9–11); EWT computed per ATC for service invoices (W7.9a)
Responsible (R): System
Accountable (A): AP Supervisor
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W7C_Flow19</bpmn:incoming>
        <bpmn:outgoing>W7C_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W7C_Task11" name="Monthly: AP Supervisor reviews non-PO expense summary by cost center; flags…">
        <bpmn:documentation>Step 6: Monthly: AP Supervisor reviews non-PO expense summary by cost center; flags locations with unusual expense patterns for management review
Responsible (R): AP Supervisor
Accountable (A): Controller
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W7C_Flow20</bpmn:incoming>
        <bpmn:outgoing>W7C_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W7C_End12" name="Complete">
        <bpmn:incoming>W7C_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W7C_Annotation13">
        <bpmn:text>Controls: (none recorded)
Owner: AP Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W7C_Assoc14" sourceRef="W7C_Annotation13" targetRef="W7C_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W7C_Flow15" sourceRef="W7C_Start5" targetRef="W7C_Task6" />
      <bpmn:sequenceFlow id="W7C_Flow16" sourceRef="W7C_Task6" targetRef="W7C_Task7" />
      <bpmn:sequenceFlow id="W7C_Flow17" sourceRef="W7C_Task7" targetRef="W7C_Task8" />
      <bpmn:sequenceFlow id="W7C_Flow18" sourceRef="W7C_Task8" targetRef="W7C_Task9" />
      <bpmn:sequenceFlow id="W7C_Flow19" sourceRef="W7C_Task9" targetRef="W7C_Task10" />
      <bpmn:sequenceFlow id="W7C_Flow20" sourceRef="W7C_Task10" targetRef="W7C_Task11" />
      <bpmn:sequenceFlow id="W7C_Flow21" sourceRef="W7C_Task11" targetRef="W7C_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W7C_diag">
      <bpmndi:BPMNPlane id="W7C_plane" bpmnElement="W_W7C">
        <bpmndi:BPMNShape id="W7C_Lane1_di" bpmnElement="W7C_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W7C_Lane2_di" bpmnElement="W7C_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W7C_Lane3_di" bpmnElement="W7C_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W7C_Task6_di" bpmnElement="W7C_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W7C_Task7_di" bpmnElement="W7C_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W7C_Task8_di" bpmnElement="W7C_Task8"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W7C_Task9_di" bpmnElement="W7C_Task9"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W7C_Task10_di" bpmnElement="W7C_Task10"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W7C_Task11_di" bpmnElement="W7C_Task11"><dc:Bounds x="1450" y="465" width="180" height="80" /></bpmndi:BPMNShape>
