        <bpmn:flowNodeRef>W499_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W499_Lane2" name="Tax Accountant">
        <bpmn:flowNodeRef>W499_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W499_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W499_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W499_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W499_Lane3" name="Controller">
        <bpmn:flowNodeRef>W499_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W499_Lane4" name="Treasury Analyst">
