        <bpmn:flowNodeRef>W499_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W499_Start6" name="Quarterly percentage tax filing deadline (BIR Form 2551Q, due within 25 days after end of…">
        <bpmn:outgoing>W499_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W499_Task7" name="System computes quarterly gross receipts per entity; identifies revenue streams…">
        <bpmn:documentation>Step 1: System computes quarterly gross receipts per entity; identifies revenue streams subject to percentage tax (3%) vs. VAT (12%) based on tax master configuration (W293)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W499_Flow19</bpmn:incoming>
        <bpmn:outgoing>W499_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W499_Task8" name="Tax Accountant reviews percentage tax computation: validates revenue…">
        <bpmn:documentation>Step 2: Tax Accountant reviews percentage tax computation: validates revenue classification, confirms entity registration status (VAT vs. non-VAT), checks threshold monitoring
Responsible (R): Tax Accountant
Accountable (A): Controller
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W499_Flow20</bpmn:incoming>
        <bpmn:outgoing>W499_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W499_Task9" name="System generates BIR Form 2551Q per entity with required fields: gross…">
        <bpmn:documentation>Step 3: System generates BIR Form 2551Q per entity with required fields: gross receipts, exempt amounts, tax base, percentage tax due, prior quarter payments
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W499_Flow21</bpmn:incoming>
        <bpmn:outgoing>W499_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W499_Task10" name="Tax Accountant reviews generated form; validates against GL revenue accounts…">
        <bpmn:documentation>Step 4: Tax Accountant reviews generated form; validates against GL revenue accounts and supporting schedules; identifies any misclassified transactions
Responsible (R): Tax Accountant
Accountable (A): Controller
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W499_Flow22</bpmn:incoming>
        <bpmn:outgoing>W499_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W499_Task11" name="Controller approves percentage tax return">
        <bpmn:documentation>Step 5: Controller approves percentage tax return
Responsible (R): Controller
Accountable (A): Controller
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W499_Flow23</bpmn:incoming>
        <bpmn:outgoing>W499_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W499_Task12" name="Tax Accountant submits via BIR eFPS (W260); generates Payment Reference Number…">
        <bpmn:documentation>Step 6: Tax Accountant submits via BIR eFPS (W260); generates Payment Reference Number (PRN)
Responsible (R): Tax Accountant
Accountable (A): Controller
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W499_Flow24</bpmn:incoming>
        <bpmn:outgoing>W499_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W499_Task13" name="Treasury Analyst processes payment via Authorized Agent Bank (AAB) or…">
        <bpmn:documentation>Step 7: Treasury Analyst processes payment via Authorized Agent Bank (AAB) or electronic payment
Responsible (R): Treasury Analyst
Accountable (A): Controller
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W499_Flow25</bpmn:incoming>
        <bpmn:outgoing>W499_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W499_Task14" name="System posts payment: Dr. Percentage Tax Expense / Cr. Bank">
        <bpmn:documentation>Step 8: System posts payment: Dr. Percentage Tax Expense / Cr. Bank
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W499_Flow26</bpmn:incoming>
        <bpmn:outgoing>W499_Flow27</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W499_Task15" name="Annual: Tax Accountant monitors VAT registration threshold per entity…">
        <bpmn:documentation>Step 9: Annual: Tax Accountant monitors VAT registration threshold per entity (currently PHP 3M annual gross receipts); if entity approaches threshold, escalates to Controller for VAT registration evaluation
Responsible (R): Tax Accountant
Accountable (A): Controller
Duration: 30 min/year</bpmn:documentation>
        <bpmn:incoming>W499_Flow27</bpmn:incoming>
        <bpmn:outgoing>W499_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W499_End16" name="Complete">
        <bpmn:incoming>W499_Flow28</bpmn:incoming>
      </bpmn:endEvent>
