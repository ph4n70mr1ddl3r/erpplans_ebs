<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-15.1-invoice-processing-and-matching" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W7" name="W7. Accounts Payable — Vendor Invoice Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor invoice received (email, mail, or vendor portal)
Frequency: ~6,715 invoices/month
Volume: ~305 invoices/business day (6,715 ÷ 22; ~217/day on a calendar basis); peaks at month-end (+50%)
Owner: AP Supervisor
Participants: AP Clerk, Buyer (for discrepancies), Treasury (for payment), AP Supervisor
Source: workflow W7 — Accounts Payable — Vendor Invoice Processing</bpmn:documentation>
      <bpmn:laneSet id="W7_LaneSet5">
        <bpmn:lane id="W7_Lane1" name="AP Clerk">
        <bpmn:flowNodeRef>W7_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W7_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W7_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W7_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W7_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W7_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W7_Lane2" name="System">
        <bpmn:flowNodeRef>W7_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W7_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W7_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W7_Task17</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W7_Lane3" name="AP Supervisor">
        <bpmn:flowNodeRef>W7_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W7_Lane4" name="Treasury Analyst">
        <bpmn:flowNodeRef>W7_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W7_End18</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W7_Start6" name="Vendor invoice received (email, mail, or vendor portal)">
        <bpmn:outgoing>W7_Flow21</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W7_Task7" name="AP Clerk receives and scans/logs vendor invoice (via email, mail, or vendor…">
        <bpmn:documentation>Step 1: AP Clerk receives and scans/logs vendor invoice (via email, mail, or vendor portal submission)
Responsible (R): AP Clerk
Accountable (A): AP Supervisor
Duration: 5 min/invoice</bpmn:documentation>
        <bpmn:incoming>W7_Flow21</bpmn:incoming>
        <bpmn:outgoing>W7_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W7_Task8" name="System attempts auto-match: PO → Goods Receipt → Invoice (3-way match)">
        <bpmn:documentation>Step 2: System attempts auto-match: PO → Goods Receipt → Invoice (3-way match)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W7_Flow22</bpmn:incoming>
        <bpmn:outgoing>W7_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W7_Task9" name="If matched (quantities and price within tolerance): auto-approve for payment">
        <bpmn:documentation>Step 3: If matched (quantities and price within tolerance): auto-approve for payment
Responsible (R): System
Accountable (A): AP Supervisor
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W7_Flow23</bpmn:incoming>
        <bpmn:outgoing>W7_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W7_Task10" name="If mismatch (price, quantity, or missing GR): route to AP Clerk for review">
        <bpmn:documentation>Step 4: If mismatch (price, quantity, or missing GR): route to AP Clerk for review
Responsible (R): AP Clerk
Accountable (A): AP Supervisor
Duration: 10 min/invoice</bpmn:documentation>
        <bpmn:incoming>W7_Flow24</bpmn:incoming>
        <bpmn:outgoing>W7_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W7_Task11" name="If price discrepancy: AP Clerk contacts Buyer for resolution">
        <bpmn:documentation>Step 5: If price discrepancy: AP Clerk contacts Buyer for resolution
Responsible (R): AP Clerk
Accountable (A): Buyer
Duration: 15 min/invoice</bpmn:documentation>
        <bpmn:incoming>W7_Flow25</bpmn:incoming>
        <bpmn:outgoing>W7_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W7_Task12" name="If quantity discrepancy (partial receipt): verify GR status; wait for remaining…">
        <bpmn:documentation>Step 6: If quantity discrepancy (partial receipt): verify GR status; wait for remaining delivery or adjust
Responsible (R): AP Clerk
Accountable (A): AP Supervisor
Duration: 10 min/invoice</bpmn:documentation>
        <bpmn:incoming>W7_Flow26</bpmn:incoming>
        <bpmn:outgoing>W7_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W7_Task13" name="Approved invoices queued for payment per vendor terms (Net 30, Net 60)">
        <bpmn:documentation>Step 7: Approved invoices queued for payment per vendor terms (Net 30, Net 60)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W7_Flow27</bpmn:incoming>
        <bpmn:outgoing>W7_Flow28</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W7_Task14" name="AP Supervisor reviews AP aging weekly; prioritize payments by due date and…">
        <bpmn:documentation>Step 8: AP Supervisor reviews AP aging weekly; prioritize payments by due date and vendor relationship
Responsible (R): AP Supervisor
Accountable (A): CFO
Duration: 2 hours/week</bpmn:documentation>
        <bpmn:incoming>W7_Flow28</bpmn:incoming>
        <bpmn:outgoing>W7_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W7_Task15" name="Twice-weekly payment run: system generates payment file (checks, bank transfers)">
        <bpmn:documentation>Step 9: Twice-weekly payment run: system generates payment file (checks, bank transfers)
Responsible (R): AP Clerk
Accountable (A): AP Supervisor
Duration: 1 hour/run</bpmn:documentation>
        <bpmn:incoming>W7_Flow29</bpmn:incoming>
        <bpmn:outgoing>W7_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W7_Task16" name="Treasury reviews and approves payment batch; transmits to bank">
        <bpmn:documentation>Step 10: Treasury reviews and approves payment batch; transmits to bank
Responsible (R): Treasury Analyst
Accountable (A): CFO
Duration: 30 min/run</bpmn:documentation>
        <bpmn:incoming>W7_Flow30</bpmn:incoming>
        <bpmn:outgoing>W7_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W7_Task17" name="System posts payment; updates vendor balance">
        <bpmn:documentation>Step 11: System posts payment; updates vendor balance
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W7_Flow31</bpmn:incoming>
        <bpmn:outgoing>W7_Flow32</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W7_End18" name="Complete">
        <bpmn:incoming>W7_Flow32</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W7_Annotation19">
        <bpmn:text>Controls: - CTL-09 (separate purchasing from receiving.); CTL-10 (separate payment initiation from approval.); CTL-14 (ensure AP invoices match PO and GR.); CTL-17 (ensure GRNI completeness.); CTL-44 (detect and prevent duplicate vendor payments.) | - operational: Controller intervention for GRNI items aged 90+ days with permanent accrual
Owner: AP Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W7_Assoc20" sourceRef="W7_Annotation19" targetRef="W7_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W7_Flow21" sourceRef="W7_Start6" targetRef="W7_Task7" />
      <bpmn:sequenceFlow id="W7_Flow22" sourceRef="W7_Task7" targetRef="W7_Task8" />
      <bpmn:sequenceFlow id="W7_Flow23" sourceRef="W7_Task8" targetRef="W7_Task9" />
