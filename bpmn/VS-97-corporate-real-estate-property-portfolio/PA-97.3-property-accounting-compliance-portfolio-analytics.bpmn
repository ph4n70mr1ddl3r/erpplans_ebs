<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-97.3-property-accounting-compliance-portfolio-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3201" name="W3201. Property-Level P&amp;L, NOI &amp; Yield Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly close; quarterly portfolio review
Frequency: Monthly + quarterly
Volume: ~205+ properties
Owner: Property Controller
Participants: Property Controller, Finance (links to VS-17), Director, Facilities &amp; Real Estate, Treasury (links to VS-18)
Source: workflow W3201 — Property-Level P&amp;L, NOI &amp; Yield Reporting</bpmn:documentation>
      <bpmn:laneSet id="W3201_LaneSet4">
        <bpmn:lane id="W3201_Lane1" name="Property Controller">
        <bpmn:flowNodeRef>W3201_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3201_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3201_Lane2" name="Finance Analyst">
        <bpmn:flowNodeRef>W3201_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3201_Lane3" name="Director, Facilities &amp; Real Estate">
        <bpmn:flowNodeRef>W3201_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3201_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3201_Start5" name="Monthly close; quarterly portfolio review">
        <bpmn:outgoing>W3201_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3201_Task6" name="Property Controller close each property&#x27;s P&amp;L monthly: rental revenue…">
        <bpmn:documentation>Step 1: Property Controller close each property&#x27;s P&amp;L monthly: rental revenue (intercompany + third-party per W3195), CAM recovery net of recoverable expenses, other income (parking, signage), operating expenses (repairs/maintenance, utilities common area, security, property mgmt fee), property tax (W3202), insurance (W3204); compute NOI, cap rate on fair value (W3189), yield-on-cost
Responsible (R): Property Controller / Finance Analyst
Accountable (A): Property Controller
Duration: 3–5 days/close</bpmn:documentation>
        <bpmn:incoming>W3201_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3201_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3201_Task7" name="Finance (links to VS-17.4) consolidate property P&amp;L into Property Mgmt Inc…">
        <bpmn:documentation>Step 2: Finance (links to VS-17.4) consolidate property P&amp;L into Property Mgmt Inc. entity reporting and group consolidation (links to VS-17.2); eliminate intercompany rent and intercompany profit on services; report NOI by property, by cluster, and portfolio
Responsible (R): Finance Analyst / Property Controller
Accountable (A): CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3201_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3201_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3201_Task8" name="Director, Facilities &amp; Real Estate/Finance review portfolio performance vs…">
        <bpmn:documentation>Step 3: Director, Facilities &amp; Real Estate/Finance review portfolio performance vs budget (links to VS-33) and prior year: occupancy, NOI growth, yield vs hurdle, variance drivers, watchlist properties; feed into strategy (W3185) and asset-plan decisions (hold/sell/redevelop — W3192)
Responsible (R): Director, Facilities &amp; Real Estate / Finance
Accountable (A): CEO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3201_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3201_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3201_End9" name="Complete">
        <bpmn:incoming>W3201_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3201_Annotation10">
        <bpmn:text>Controls: - CTL-134 (ensure property income &amp; LGU tax compliance (as owner).) | - operational: capitalization policy (W3203/links to VS-35) and review; operational: automated IC matching (links to VS-17)
Owner: Property Controller</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3201_Assoc11" sourceRef="W3201_Annotation10" targetRef="W3201_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3201_Flow12" sourceRef="W3201_Start5" targetRef="W3201_Task6" />
      <bpmn:sequenceFlow id="W3201_Flow13" sourceRef="W3201_Task6" targetRef="W3201_Task7" />
      <bpmn:sequenceFlow id="W3201_Flow14" sourceRef="W3201_Task7" targetRef="W3201_Task8" />
      <bpmn:sequenceFlow id="W3201_Flow15" sourceRef="W3201_Task8" targetRef="W3201_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3201_diag">
      <bpmndi:BPMNPlane id="W3201_plane" bpmnElement="W_W3201">
        <bpmndi:BPMNShape id="W3201_Lane1_di" bpmnElement="W3201_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3201_Lane2_di" bpmnElement="W3201_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3201_Lane3_di" bpmnElement="W3201_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3201_Task6_di" bpmnElement="W3201_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3201_Task7_di" bpmnElement="W3201_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3201_Task8_di" bpmnElement="W3201_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3201_Start5_di" bpmnElement="W3201_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3201_End9_di" bpmnElement="W3201_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3201_Annotation10_di" bpmnElement="W3201_Annotation10"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3201_Flow12_di" bpmnElement="W3201_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3201_Flow13_di" bpmnElement="W3201_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3201_Flow14_di" bpmnElement="W3201_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3201_Flow15_di" bpmnElement="W3201_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3201_Assoc11_di" bpmnElement="W3201_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3202" name="W3202. Real Property Tax, Assessment &amp; LGU Compliance (as Owner)" isExecutable="false">
      <bpmn:documentation>Trigger: Annual RPT cycle; LGU assessment notice; transfer of ownership (W3187)
Frequency: Annual + event-driven
Volume: ~205+ titled properties across ~150 LGUs
Owner: Property Tax Manager
Participants: Property Tax Mgr, Finance (links to VS-79), Legal, LGU Assessor/Collector
Source: workflow W3202 — Real Property Tax, Assessment &amp; LGU Compliance (as Owner)</bpmn:documentation>
      <bpmn:laneSet id="W3202_LaneSet2">
        <bpmn:lane id="W3202_Lane1" name="Property Tax Mgr">
        <bpmn:flowNodeRef>W3202_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3202_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3202_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3202_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3202_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3202_Start3" name="Annual RPT cycle; LGU assessment notice; transfer of ownership (W3187)">
        <bpmn:outgoing>W3202_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3202_Task4" name="Property Tax Mgr maintain property tax declaration master: Tax Declaration No…">
        <bpmn:documentation>Step 1: Property Tax Mgr maintain property tax declaration master: Tax Declaration No., classification (residential/commercial/industrial/ agricultural), assessed value, LGU/municipality, barangay, annual RPT due; reconcile to title/property master (links to VS-29/W3191) and to BuildRight-as-tenant RPT pass-through analysis (links to VS-42.3)
Responsible (R): Property Tax Mgr
Accountable (A): Property Controller
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3202_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3202_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3202_Task5" name="Pay annual RPT (on or before Jan 31, or quarterly per LGU schedule) to claim…">
        <bpmn:documentation>Step 2: Pay annual RPT (on or before Jan 31, or quarterly per LGU schedule) to claim early-payment discount (typically 10–20%); for new acquisitions, transfer tax declaration to Property Mgmt Inc. name and update Assessor&#x27;s Office; ensure no delinquency that could trigger auction/lien
Responsible (R): Property Tax Mgr / Finance
Accountable (A): Property Controller
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3202_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3202_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3202_Task6" name="Contest unfair assessments: file protest with Local Board of Assessment Appeals…">
        <bpmn:documentation>Step 3: Contest unfair assessments: file protest with Local Board of Assessment Appeals (LBAA) within statutory period where assessed value exceeds fair market value; document evidence (W3189 appraisal, sales comps); coordinate with VS-79 tax and VS-76 LGU compliance
Responsible (R): Property Tax Mgr / Legal
Accountable (A): Director, Facilities &amp; Real Estate
Duration: Event-driven</bpmn:documentation>
        <bpmn:incoming>W3202_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3202_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3202_End7" name="Complete">
        <bpmn:incoming>W3202_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3202_Annotation8">
        <bpmn:text>Controls: - CTL-134 (ensure property income &amp; LGU tax compliance (as owner).) | - operational: master calendar and early-payment discipline; operational: systematic protest (LBAA) and appraisal evidence
Owner: Property Tax Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3202_Assoc9" sourceRef="W3202_Annotation8" targetRef="W3202_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3202_Flow10" sourceRef="W3202_Start3" targetRef="W3202_Task4" />
      <bpmn:sequenceFlow id="W3202_Flow11" sourceRef="W3202_Task4" targetRef="W3202_Task5" />
      <bpmn:sequenceFlow id="W3202_Flow12" sourceRef="W3202_Task5" targetRef="W3202_Task6" />
      <bpmn:sequenceFlow id="W3202_Flow13" sourceRef="W3202_Task6" targetRef="W3202_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3202_diag">
      <bpmndi:BPMNPlane id="W3202_plane" bpmnElement="W_W3202">
        <bpmndi:BPMNShape id="W3202_Lane1_di" bpmnElement="W3202_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3202_Task4_di" bpmnElement="W3202_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3202_Task5_di" bpmnElement="W3202_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3202_Task6_di" bpmnElement="W3202_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3202_Start3_di" bpmnElement="W3202_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3202_End7_di" bpmnElement="W3202_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3202_Annotation8_di" bpmnElement="W3202_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3202_Flow10_di" bpmnElement="W3202_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3202_Flow11_di" bpmnElement="W3202_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3202_Flow12_di" bpmnElement="W3202_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3202_Flow13_di" bpmnElement="W3202_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3202_Assoc9_di" bpmnElement="W3202_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3203" name="W3203. Capital Improvements, Repair Reserve &amp; CAPEX Governance" isExecutable="false">
      <bpmn:documentation>Trigger: Property condition assessment; tenant request; reserve study; lifecycle event
Frequency: Annual plan + event-driven
Volume: ~205+ properties with recurring capex needs
Owner: Property Development Manager
Participants: Property Dev Mgr, Facilities (links to VS-20.3), Finance/Project Accounting (links to VS-40), Director, Facilities &amp; Real Estate
Source: workflow W3203 — Capital Improvements, Repair Reserve &amp; CAPEX Governance</bpmn:documentation>
      <bpmn:laneSet id="W3203_LaneSet3">
        <bpmn:lane id="W3203_Lane1" name="Property Dev Mgr">
        <bpmn:flowNodeRef>W3203_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3203_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3203_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3203_Lane2" name="Finance Analyst">
        <bpmn:flowNodeRef>W3203_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3203_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3203_Start4" name="Property condition assessment; tenant request; reserve study; lifecycle event">
        <bpmn:outgoing>W3203_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3203_Task5" name="Property Dev/Facilities maintain property condition assessments (links to…">
        <bpmn:documentation>Step 1: Property Dev/Facilities maintain property condition assessments (links to VS-20.3 annual DC/store condition assessments): building systems (roof, HVAC, electrical, plumbing, fire, structural), parking/grounds, seismic/typhoon resilience (links to VS-69); estimate remaining useful life and replacement cost; build 5–10 year capital plan
Responsible (R): Property Dev Mgr / Facilities
Accountable (A): Director, Facilities &amp; Real Estate
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3203_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3203_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3203_Task6" name="Finance (links to VS-40) fund a repair/replacement reserve per reserve study…">
        <bpmn:documentation>Step 2: Finance (links to VS-40) fund a repair/replacement reserve per reserve study: set reserve contribution per property from NOI, segregate funds, project cash needs vs reserves; governance for reserve draw (board authority per VS-36)
Responsible (R): Finance Analyst / Treasury
Accountable (A): CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3203_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3203_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3203_Task7" name="Execute capital improvements per VS-40 project accounting: scope/bid/build…">
        <bpmn:documentation>Step 3: Execute capital improvements per VS-40 project accounting: scope/bid/build (links to VS-20.2), track cost and schedule, capitalize qualifying expenditures to investment property (W3188/W3189), activate; ensure LGU permits (links to VS-22/VS-76) and tenant coordination (W3196)
Responsible (R): Property Dev Mgr / Construction
Accountable (A): Director, Facilities &amp; Real Estate
Duration: Per project</bpmn:documentation>
        <bpmn:incoming>W3203_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3203_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3203_End8" name="Complete">
        <bpmn:incoming>W3203_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3203_Annotation9">
        <bpmn:text>Controls: - CTL-522 (ensure controlled execution — Property Accounting, Compliance &amp; Portfolio Analytics (PA-97.3).) | - operational: reserve study and disciplined contribution; operational: capitalization policy (links to VS-35)
Owner: Property Development Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3203_Assoc10" sourceRef="W3203_Annotation9" targetRef="W3203_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3203_Flow11" sourceRef="W3203_Start4" targetRef="W3203_Task5" />
      <bpmn:sequenceFlow id="W3203_Flow12" sourceRef="W3203_Task5" targetRef="W3203_Task6" />
      <bpmn:sequenceFlow id="W3203_Flow13" sourceRef="W3203_Task6" targetRef="W3203_Task7" />
      <bpmn:sequenceFlow id="W3203_Flow14" sourceRef="W3203_Task7" targetRef="W3203_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3203_diag">
      <bpmndi:BPMNPlane id="W3203_plane" bpmnElement="W_W3203">
        <bpmndi:BPMNShape id="W3203_Lane1_di" bpmnElement="W3203_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3203_Lane2_di" bpmnElement="W3203_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3203_Task5_di" bpmnElement="W3203_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3203_Task6_di" bpmnElement="W3203_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3203_Task7_di" bpmnElement="W3203_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3203_Start4_di" bpmnElement="W3203_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3203_End8_di" bpmnElement="W3203_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3203_Annotation9_di" bpmnElement="W3203_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3203_Flow11_di" bpmnElement="W3203_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3203_Flow12_di" bpmnElement="W3203_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3203_Flow13_di" bpmnElement="W3203_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3203_Flow14_di" bpmnElement="W3203_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3203_Assoc10_di" bpmnElement="W3203_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3204" name="W3204. Property Insurance, Risk Transfer &amp; Coverage Program" isExecutable="false">
      <bpmn:documentation>Trigger: Annual renewal; acquisition (W3187); significant change/loss event
Frequency: Annual + event-driven
Volume: Portfolio-wide property insurance program
Owner: Risk &amp; Insurance Manager
Participants: Risk &amp; Insurance Mgr, Treasury/Finance (links to VS-18/VS-26), Legal, Director, Facilities &amp; Real Estate, Insurer/Broker
Source: workflow W3204 — Property Insurance, Risk Transfer &amp; Coverage Program</bpmn:documentation>
      <bpmn:laneSet id="W3204_LaneSet3">
        <bpmn:lane id="W3204_Lane1" name="Risk &amp; Insurance Mgr">
        <bpmn:flowNodeRef>W3204_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3204_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3204_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3204_Lane2" name="Broker">
        <bpmn:flowNodeRef>W3204_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3204_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3204_Start4" name="Annual renewal; acquisition (W3187); significant change/loss event">
        <bpmn:outgoing>W3204_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3204_Task5" name="Risk &amp; Insurance Mgr design portfolio insurance program: property/all-risk…">
        <bpmn:documentation>Step 1: Risk &amp; Insurance Mgr design portfolio insurance program: property/all-risk (fire, typhoon, flood, earthquake — critical for PH per VS-69), business interruption / loss of rent (for lessor income protection), boiler &amp; machinery, general liability, builder&#x27;s risk during construction (W3188); coverage limits, deductibles, sub-limits, per-location scheduling
Responsible (R): Risk &amp; Insurance Mgr / Broker
Accountable (A): CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3204_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3204_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3204_Task6" name="Broker/Insurer place coverage: market the program to insurers, negotiate…">
        <bpmn:documentation>Step 2: Broker/Insurer place coverage: market the program to insurers, negotiate premium and terms, bind policies; confirm Property Mgmt Inc./Holdings as named insured, lender as loss-payee where financed (W3190), tenants per lease requirements; ensure tenant-provided insurance certificates on file and compliant (W3196)
Responsible (R): Broker / Risk &amp; Insurance Mgr
Accountable (A): CFO
Duration: 4–8 weeks</bpmn:documentation>
        <bpmn:incoming>W3204_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3204_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3204_Task7" name="Finance (links to VS-26.3) manage claims and premium allocation: allocate…">
        <bpmn:documentation>Step 3: Finance (links to VS-26.3) manage claims and premium allocation: allocate premium and claim recoveries to property-level P&amp;L (W3201); manage claim filing, adjuster coordination, and recovery for typhoon/seismic events (links to VS-26/VS-69); maintain insurance register
Responsible (R): Risk &amp; Insurance Mgr / Finance
Accountable (A): CFO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W3204_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3204_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3204_End8" name="Complete">
        <bpmn:incoming>W3204_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3204_Annotation9">
        <bpmn:text>Controls: - CTL-522 (ensure controlled execution — Property Accounting, Compliance &amp; Portfolio Analytics (PA-97.3).) | - operational: appraisal-based limits and BI/loss-of-rent coverage; operational: compliance monitoring (W3196) and landlord-purchased coverage
Owner: Risk &amp; Insurance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3204_Assoc10" sourceRef="W3204_Annotation9" targetRef="W3204_Start4" associationDirection="None" />
