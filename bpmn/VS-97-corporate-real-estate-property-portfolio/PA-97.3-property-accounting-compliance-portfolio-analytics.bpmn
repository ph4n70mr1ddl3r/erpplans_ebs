    <bpmn:process id="W_W3206" name="W3206. Environmental, Zoning &amp; Land-Use Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: Acquisition (W3191); development (W3188); regulatory change; inspection
Frequency: Per event + periodic review
Volume: ~205+ properties
Owner: Property Compliance Manager
Participants: Property Compliance Mgr, Legal, Environmental (links to VS-24/VS-73/VS-25), Director, Facilities &amp; Real Estate, LGU/DENR
Source: workflow W3206 — Environmental, Zoning &amp; Land-Use Compliance</bpmn:documentation>
      <bpmn:laneSet id="W3206_LaneSet4">
        <bpmn:lane id="W3206_Lane1" name="Property Compliance Mgr">
        <bpmn:flowNodeRef>W3206_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3206_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3206_Lane2" name="Environmental Eng">
        <bpmn:flowNodeRef>W3206_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3206_Lane3" name="Legal">
        <bpmn:flowNodeRef>W3206_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3206_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3206_Start5" name="Acquisition (W3191); development (W3188); regulatory change; inspection">
        <bpmn:outgoing>W3206_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3206_Task6" name="Property Compliance Mgr/Legal verify zoning and land-use compliance for each…">
        <bpmn:documentation>Step 1: Property Compliance Mgr/Legal verify zoning and land-use compliance for each property: LGU comprehensive land-use plan (CLUP) conformity (commercial use), building height/density/setback compliance, environmental compliance certificate (ECC) where required (DENR), tree-cutting permits, water/discharge permits; maintain compliance register per property
Responsible (R): Property Compliance Mgr / Legal
Accountable (A): Director, Facilities &amp; Real Estate
Duration: Per property + periodic</bpmn:documentation>
        <bpmn:incoming>W3206_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3206_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3206_Task7" name="Environmental (links to VS-25.1/VS-73.2) manage environmental obligations…">
        <bpmn:documentation>Step 2: Environmental (links to VS-25.1/VS-73.2) manage environmental obligations: hazardous-materials disclosure (asbestos/lead in older structures, paint/chemical storage per VS-24.3), soil/groundwater if contaminated site (links to W3191 Phase II), waste-water and air-quality permits; coordinate VS-73 hazardous-waste and VS-25 ESG monitoring
Responsible (R): Environmental Eng / Property Compliance Mgr
Accountable (A): Director, Facilities &amp; Real Estate
Duration: Event-driven</bpmn:documentation>
        <bpmn:incoming>W3206_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3206_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3206_Task8" name="Respond to LGU/DENR inspections and notices (links to VS-22.2/VS-76): document…">
        <bpmn:documentation>Step 3: Respond to LGU/DENR inspections and notices (links to VS-22.2/VS-76): document compliance, correct violations within cure period, appeal where warranted; manage zoning/variance applications for repositioning/redevelopment (links to W3188)
Responsible (R): Legal / Property Compliance Mgr
Accountable (A): Director, Facilities &amp; Real Estate
Duration: Event-driven</bpmn:documentation>
        <bpmn:incoming>W3206_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3206_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3206_End9" name="Complete">
        <bpmn:incoming>W3206_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3206_Annotation10">
        <bpmn:text>Controls: - CTL-522 (ensure controlled execution — Property Accounting, Compliance &amp; Portfolio Analytics (PA-97.3).) | - operational: compliance register and variances; operational: W3191 ESA and remediation reserves
Owner: Property Compliance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3206_Assoc11" sourceRef="W3206_Annotation10" targetRef="W3206_Start5" associationDirection="None" />
