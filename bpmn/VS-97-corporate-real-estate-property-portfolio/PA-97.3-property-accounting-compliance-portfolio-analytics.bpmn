    <bpmn:process id="W_W3205" name="W3205. Common Area, Grounds &amp; Facility Operations Oversight" isExecutable="false">
      <bpmn:documentation>Trigger: Daily operations; scheduled maintenance; tenant service (W3196)
Frequency: Continuous + scheduled
Volume: ~205+ properties with common areas, parking, grounds
Owner: Property Manager
Participants: Property Mgr, Facilities (links to VS-20.3), Janitorial/Security (links to VS-98), Landscaping Vendor, Store Ops (links to VS-07)
Source: workflow W3205 — Common Area, Grounds &amp; Facility Operations Oversight</bpmn:documentation>
      <bpmn:laneSet id="W3205_LaneSet2">
        <bpmn:lane id="W3205_Lane1" name="Property Mgr">
