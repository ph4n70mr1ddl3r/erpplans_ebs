    <bpmn:process id="W_W3208" name="W3208. Portfolio Performance, Valuation &amp; ESG Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly portfolio review; annual reporting; board/investor reporting
Frequency: Quarterly + annual
Volume: Portfolio-wide
Owner: Director, Facilities &amp; Real Estate
Participants: Director, Facilities &amp; Real Estate, Finance (links to VS-17), Valuation (links to W3189), ESG/Sustainability (links to VS-25), Strategy (links to VS-33)
Source: workflow W3208 — Portfolio Performance, Valuation &amp; ESG Reporting</bpmn:documentation>
      <bpmn:laneSet id="W3208_LaneSet4">
        <bpmn:lane id="W3208_Lane1" name="Finance Analyst">
        <bpmn:flowNodeRef>W3208_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3208_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3208_Lane2" name="Valuation Mgr">
        <bpmn:flowNodeRef>W3208_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3208_Lane3" name="Director, Facilities &amp; Real Estate">
        <bpmn:flowNodeRef>W3208_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3208_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3208_Start5" name="Quarterly portfolio review; annual reporting; board/investor reporting">
        <bpmn:outgoing>W3208_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3208_Task6" name="Finance/Director, Facilities &amp; Real Estate produce portfolio performance pack…">
        <bpmn:documentation>Step 1: Finance/Director, Facilities &amp; Real Estate produce portfolio performance pack: NOI by property/cluster/region, occupancy, WAL (weighted-average lease term), collection, cap rate movement vs W3189 fair value, debt metrics (W3190), capex vs reserve (W3203), watchlist; benchmark to budget (links to VS-33) and market
Responsible (R): Finance Analyst / Director, Facilities &amp; Real Estate
Accountable (A): CEO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3208_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3208_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3208_Task7" name="Valuation/ESG (links to VS-25/W3189) report portfolio valuation roll-forward…">
        <bpmn:documentation>Step 2: Valuation/ESG (links to VS-25/W3189) report portfolio valuation roll-forward: opening fair value, additions (W3187/W3188), disposals (W3192), fair-value movement, transfers, closing fair value; ESG metrics — green-building certifications (links to VS-78), energy/carbon (links to VS-25.1/W1563), climate-risk exposure (typhoon/seismic per VS-69), social/community impact
Responsible (R): Valuation Mgr / ESG Lead
Accountable (A): CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3208_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3208_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3208_Task8" name="Director, Facilities &amp; Real Estate/Strategy present to Board (links to VS-36.1)…">
        <bpmn:documentation>Step 3: Director, Facilities &amp; Real Estate/Strategy present to Board (links to VS-36.1) and Holdings: portfolio strategy execution, key deals, risk register (links to VS-21.2), outlook; integrate findings into next-strategic-cycle (W3185) and group consolidation/disclosure (links to VS-17.2/VS-17.4)
Responsible (R): Director, Facilities &amp; Real Estate / Strategy
Accountable (A): CEO
Duration: Quarterly/Annual</bpmn:documentation>
        <bpmn:incoming>W3208_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3208_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3208_End9" name="Complete">
        <bpmn:incoming>W3208_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3208_Annotation10">
        <bpmn:text>Controls: - CTL-522 (ensure controlled execution — Property Accounting, Compliance &amp; Portfolio Analytics (PA-97.3).) | - operational: BI automation (links to VS-28) and monthly close discipline (W3201); operational: auditable metrics
Owner: Director, Facilities &amp; Real Estate</bpmn:text>
      </bpmn:textAnnotation>
