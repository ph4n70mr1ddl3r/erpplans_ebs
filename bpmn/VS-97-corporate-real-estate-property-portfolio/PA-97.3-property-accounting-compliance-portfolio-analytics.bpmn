      <bpmn:sequenceFlow id="W3204_Flow13" sourceRef="W3204_Task6" targetRef="W3204_Task7" />
      <bpmn:sequenceFlow id="W3204_Flow14" sourceRef="W3204_Task7" targetRef="W3204_End8" />
    </bpmn:process>
