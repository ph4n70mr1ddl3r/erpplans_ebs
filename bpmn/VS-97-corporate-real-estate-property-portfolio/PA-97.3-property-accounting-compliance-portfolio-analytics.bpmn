      <bpmn:startEvent id="W3205_Start3" name="Daily operations; scheduled maintenance; tenant service (W3196)">
        <bpmn:outgoing>W3205_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3205_Task4" name="Property Mgr/Facilities operate common areas: parking lot maintenance (line…">
        <bpmn:documentation>Step 1: Property Mgr/Facilities operate common areas: parking lot maintenance (line marking, lighting, drainage — critical in PH rainy season), landscaping, signage, exterior lighting, waste collection (links to VS-73); schedule preventive maintenance in Oracle eAM (fit-gap F5; links to VS-20.3)
Responsible (R): Property Mgr / Facilities
Accountable (A): Property Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3205_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3205_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3205_Task5" name="Property Mgr manage service vendors: security (links to VS-98 contingent…">
        <bpmn:documentation>Step 2: Property Mgr manage service vendors: security (links to VS-98 contingent workforce), janitorial (links to VS-98), landscaping, pest control, fire-life-safety inspections; SLA and invoice validation (links to VS-15/VS-34); allocate vendor cost to CAM recoverable vs landlord-responsibility for billing (W3195)
Responsible (R): Property Mgr / Finance
Accountable (A): Director, Facilities &amp; Real Estate
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W3205_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3205_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3205_Task6" name="Property Mgr coordinate with Store Ops (links to VS-07) for shared facility…">
        <bpmn:documentation>Step 3: Property Mgr coordinate with Store Ops (links to VS-07) for shared facility operations (loading dock, customer entrance, utilities) and with tenants (W3196); maintain property logbook and inspection records; feed issues to capital plan (W3203)
Responsible (R): Property Mgr / Store Ops
Accountable (A): Director, Facilities &amp; Real Estate
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W3205_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3205_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3205_End7" name="Complete">
        <bpmn:incoming>W3205_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3205_Annotation8">
        <bpmn:text>Controls: - CTL-522 (ensure controlled execution — Property Accounting, Compliance &amp; Portfolio Analytics (PA-97.3).) | - operational: inspection and preventive maintenance; operational: lease definitions and transparent CAM ledger (W3195)
Owner: Property Manager</bpmn:text>
      </bpmn:textAnnotation>
