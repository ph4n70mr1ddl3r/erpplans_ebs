    <bpmn:process id="W_W3189" name="W3189. Investment Property Valuation &amp; Fair-Value Measurement (PFRS 40)" isExecutable="false">
      <bpmn:documentation>Trigger: Annual reporting cycle; acquisition/disposition (W3187/W3192); impairment indicator; financing/refinance event
Frequency: Annual (fair-value measurement) + event-driven
Volume: ~205+ investment properties in portfolio
Owner: Valuation Manager
Participants: Valuation Mgr, External Valuer, Finance (links to VS-17), Director, Facilities &amp; Real Estate, Auditor (links to VS-22.2)
Source: workflow W3189 — Investment Property Valuation &amp; Fair-Value Measurement (PFRS 40)</bpmn:documentation>
      <bpmn:laneSet id="W3189_LaneSet4">
        <bpmn:lane id="W3189_Lane1" name="Valuation Mgr">
        <bpmn:flowNodeRef>W3189_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3189_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3189_Lane2" name="Finance Analyst">
        <bpmn:flowNodeRef>W3189_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3189_Lane3" name="External Auditor">
        <bpmn:flowNodeRef>W3189_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3189_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3189_Start5" name="Annual reporting cycle; acquisition/disposition (W3187/W3192); impairment indicator…">
        <bpmn:outgoing>W3189_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3189_Task6" name="Valuation Mgr engage independent, PRC-accredited appraiser (independence per…">
        <bpmn:documentation>Step 1: Valuation Mgr engage independent, PRC-accredited appraiser (independence per audit requirements, links to VS-22.2) to value each investment property at fair value under PFRS 40; provide lease, rent-roll, NOI, cap-rate comps, and market data; specify valuation date and basis (highest-and-best-use, existing-use)
Responsible (R): Valuation Mgr
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 4–8 weeks</bpmn:documentation>
        <bpmn:incoming>W3189_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3189_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3189_Task7" name="Finance/Valuation (links to VS-17) record fair-value movement: gain/loss to P&amp;L…">
        <bpmn:documentation>Step 2: Finance/Valuation (links to VS-17) record fair-value movement: gain/loss to P&amp;L (PFRS 40 fair-value model) or disclosure under cost model; reconcile to prior period; perform impairment review where indicators exist (vacancy, seismic/typhoon damage per VS-69, market decline)
Responsible (R): Finance Analyst / Valuation Mgr
Accountable (A): Controller
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W3189_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3189_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3189_Task8" name="Auditor (links to VS-22.2) reviews valuation methodology, appraiser…">
        <bpmn:documentation>Step 3: Auditor (links to VS-22.2) reviews valuation methodology, appraiser credentials, and key assumptions (cap rate, discount rate, terminal value); finance responds to audit findings; final fair values incorporated into consolidated FS (links to VS-17.2)
Responsible (R): External Auditor / Finance
Accountable (A): CFO
Duration: At audit</bpmn:documentation>
        <bpmn:incoming>W3189_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3189_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3189_End9" name="Complete">
        <bpmn:incoming>W3189_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3189_Annotation10">
        <bpmn:text>Controls: - CTL-520 (ensure controlled execution — Property Acquisition, Investment &amp; Portfolio Strategy (PA-97.1).) | - operational: independent appraiser, market-data benchmarking, and audit challenge; operational: transparent disclosure and sensitivity analysis
Owner: Valuation Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3189_Assoc11" sourceRef="W3189_Annotation10" targetRef="W3189_Start5" associationDirection="None" />
