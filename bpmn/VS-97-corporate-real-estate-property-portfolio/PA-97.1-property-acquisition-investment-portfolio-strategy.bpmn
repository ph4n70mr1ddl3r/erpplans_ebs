        <bpmndi:BPMNEdge id="W3186_Flow13_di" bpmnElement="W3186_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3186_Flow14_di" bpmnElement="W3186_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3186_Flow15_di" bpmnElement="W3186_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3186_Assoc11_di" bpmnElement="W3186_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3187" name="W3187. Land &amp; Building Purchase and Sale-and-Leaseback Origination" isExecutable="false">
      <bpmn:documentation>Trigger: Approved acquisition (W3186); leasehold-to-freehold conversion; sale-and-leaseback (SLB) offer from an operating counterparty
Frequency: Per transaction
Volume: ~5–10 transactions/year
Owner: Real Estate Investment Manager
Participants: Real Estate Investment Mgr, Legal, Finance/Treasury (links to VS-18), Tax (links to VS-79/VS-87), Broker, Seller
Source: workflow W3187 — Land &amp; Building Purchase and Sale-and-Leaseback Origination</bpmn:documentation>
      <bpmn:laneSet id="W3187_LaneSet4">
        <bpmn:lane id="W3187_Lane1" name="Real Estate Investment Mgr">
        <bpmn:flowNodeRef>W3187_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3187_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3187_Lane2" name="Legal Counsel">
        <bpmn:flowNodeRef>W3187_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3187_Lane3" name="Legal">
        <bpmn:flowNodeRef>W3187_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3187_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3187_Start5" name="Approved acquisition (W3186); leasehold-to-freehold conversion; sale-and-leaseback (SLB)…">
        <bpmn:outgoing>W3187_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3187_Task6" name="Real Estate Investment Mgr structure the deal: outright purchase…">
        <bpmn:documentation>Step 1: Real Estate Investment Mgr structure the deal: outright purchase (land/building), sale-and-leaseback (acquire from owner-operator and lease back — links to VS-96 equipment leasing for asset-finance parallel), joint venture, or ground lease; price per appraisal (W3189) and underwriting (W3186); negotiate price, deposit, conditions, and timeline
Responsible (R): Real Estate Investment Mgr / Broker
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 2–6 weeks</bpmn:documentation>
        <bpmn:incoming>W3187_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3187_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3187_Task7" name="Legal/Tax (links to VS-79/VS-87) structure for tax efficiency: DST (documentary…">
        <bpmn:documentation>Step 2: Legal/Tax (links to VS-79/VS-87) structure for tax efficiency: DST (documentary stamp tax on real-estate conveyance), VAT on sale (if seller is VAT-registered — pass-through analysis), capital-gains tax borne by seller (verify), CGT/estate/transfer-tax exposure, holding-entity selection (Property Mgmt Inc. vs Holdings); draft/review Deed of Absolute Sale, sale-and-leaseback lease, and conditions
Responsible (R): Legal Counsel / Tax
Accountable (A): VP Legal &amp; Compliance
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W3187_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3187_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3187_Task8" name="Execute closing: title transfer (Register of Deeds), tax payment (CGT, DST…">
        <bpmn:documentation>Step 3: Execute closing: title transfer (Register of Deeds), tax payment (CGT, DST, transfer tax to LGU/BIR), possession handover, payment release via escrow (links to VS-18); book acquisition at cost (W3189/VS-35)
Responsible (R): Legal / Treasury / Title Officer
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W3187_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3187_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3187_End9" name="Complete">
        <bpmn:incoming>W3187_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3187_Annotation10">
        <bpmn:text>Controls: - CTL-520 (ensure controlled execution — Property Acquisition, Investment &amp; Portfolio Strategy (PA-97.1).) | - operational: W3191 title insurance and ENC verification; operational: upfront tax planning (links to VS-79)
Owner: Real Estate Investment Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3187_Assoc11" sourceRef="W3187_Annotation10" targetRef="W3187_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3187_Flow12" sourceRef="W3187_Start5" targetRef="W3187_Task6" />
      <bpmn:sequenceFlow id="W3187_Flow13" sourceRef="W3187_Task6" targetRef="W3187_Task7" />
      <bpmn:sequenceFlow id="W3187_Flow14" sourceRef="W3187_Task7" targetRef="W3187_Task8" />
      <bpmn:sequenceFlow id="W3187_Flow15" sourceRef="W3187_Task8" targetRef="W3187_End9" />
    </bpmn:process>
