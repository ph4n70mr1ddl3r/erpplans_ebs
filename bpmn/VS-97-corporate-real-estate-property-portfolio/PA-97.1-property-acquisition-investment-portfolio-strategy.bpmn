        <bpmndi:BPMNEdge id="W3187_Assoc11_di" bpmnElement="W3187_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3188" name="W3188. Property Development, Ground-Up Construction &amp; Tenant-Improvement Build-Out" isExecutable="false">
      <bpmn:documentation>Trigger: Approved development (W3186) or tenant-improvement (TI) requirement for a leased-up property
Frequency: Per project
Volume: ~10–15 developments/year (aligned to store openings per VS-37) + ad-hoc TI
Owner: Property Development Manager
Participants: Property Development Mgr, Construction (links to VS-20.2), Store Ops (links to VS-37), Finance/Project Accounting (links to VS-40), Permitting (links to VS-22/VS-76), Design/Architecture
Source: workflow W3188 — Property Development, Ground-Up Construction &amp; Tenant-Improvement Build-Out</bpmn:documentation>
      <bpmn:laneSet id="W3188_LaneSet4">
        <bpmn:lane id="W3188_Lane1" name="Property Development Mgr">
        <bpmn:flowNodeRef>W3188_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3188_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3188_Lane2" name="Construction Mgr">
        <bpmn:flowNodeRef>W3188_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3188_Lane3" name="Project Accountant">
        <bpmn:flowNodeRef>W3188_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3188_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3188_Start5" name="Approved development (W3186) or tenant-improvement (TI) requirement for a leased-up…">
        <bpmn:outgoing>W3188_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3188_Task6" name="Property Development Mgr/Design finalize development brief: site plan, building…">
        <bpmn:documentation>Step 1: Property Development Mgr/Design finalize development brief: site plan, building program (selling area, backroom, yard, parking, loading), sustainability targets (green-building per VS-78), budget and schedule, phasing for operating sites; obtain design approvals (links to VS-20.2 W223 new store design)
Responsible (R): Property Development Mgr / Architect
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 4–8 weeks</bpmn:documentation>
        <bpmn:incoming>W3188_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3188_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3188_Task7" name="Construction (links to VS-20.2) execute: bid/buy (W224), build (W225)…">
        <bpmn:documentation>Step 2: Construction (links to VS-20.2) execute: bid/buy (W224), build (W225), commissioning/handover (W227); track costs against budget via VS-40 project accounting; manage change orders, RFIs, and TI allowance; ensure LGU building permits and occupancy certificate (links to VS-22/VS-76)
Responsible (R): Construction Mgr / GC
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 6–12 months</bpmn:documentation>
        <bpmn:incoming>W3188_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3188_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3188_Task8" name="Finance (links to VS-40) capitalize qualifying costs to investment property…">
        <bpmn:documentation>Step 3: Finance (links to VS-40) capitalize qualifying costs to investment property (land, hard costs, directly attributable soft costs, borrowing costs per PFRS 23 where applicable); at substantial completion, transition to investment-property accounting (W3189) and activate depreciation for owner-occupied portions (links to VS-35)
Responsible (R): Project Accountant / Finance
Accountable (A): Controller
Duration: At completion</bpmn:documentation>
        <bpmn:incoming>W3188_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3188_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3188_End9" name="Complete">
        <bpmn:incoming>W3188_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3188_Annotation10">
        <bpmn:text>Controls: - CTL-520 (ensure controlled execution — Property Acquisition, Investment &amp; Portfolio Strategy (PA-97.1).) | - operational: GC bond, milestone payments, and VS-40 cost control; operational: capitalization policy (links to VS-35/VS-40)
Owner: Property Development Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3188_Assoc11" sourceRef="W3188_Annotation10" targetRef="W3188_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3188_Flow12" sourceRef="W3188_Start5" targetRef="W3188_Task6" />
      <bpmn:sequenceFlow id="W3188_Flow13" sourceRef="W3188_Task6" targetRef="W3188_Task7" />
      <bpmn:sequenceFlow id="W3188_Flow14" sourceRef="W3188_Task7" targetRef="W3188_Task8" />
      <bpmn:sequenceFlow id="W3188_Flow15" sourceRef="W3188_Task8" targetRef="W3188_End9" />
    </bpmn:process>
