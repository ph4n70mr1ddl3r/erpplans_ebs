<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-97.1-property-acquisition-investment-portfolio-strategy" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3185" name="W3185. Property Portfolio Strategy &amp; Investment Plan" isExecutable="false">
      <bpmn:documentation>Trigger: Strategic cycle (links to VS-33); store-growth pipeline (10–15 new stores/year per profile); financing-window opportunity
Frequency: Annual + event-driven
Volume: ~205+ owned/controlled properties; ~10–15 acquisitions/developments/year
Owner: Director, Facilities &amp; Real Estate
Participants: Director, Facilities &amp; Real Estate, Real Estate Investment Mgr, Finance/Treasury (links to VS-18), Strategy (links to VS-33), Store Ops (links to VS-37), Legal, Real-Estate &amp; Site-Selection Analyst
Source: workflow W3185 — Property Portfolio Strategy &amp; Investment Plan</bpmn:documentation>
      <bpmn:laneSet id="W3185_LaneSet4">
        <bpmn:lane id="W3185_Lane1" name="Real Estate Investment Mgr">
        <bpmn:flowNodeRef>W3185_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3185_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3185_Lane2" name="Finance Analyst">
        <bpmn:flowNodeRef>W3185_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3185_Lane3" name="Investment Committee">
        <bpmn:flowNodeRef>W3185_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3185_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3185_Start5" name="Strategic cycle (links to VS-33); store-growth pipeline (10–15 new stores/year per…">
        <bpmn:outgoing>W3185_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3185_Task6" name="Real Estate Investment Mgr maintain portfolio strategy: own-vs-lease decision…">
        <bpmn:documentation>Step 1: Real Estate Investment Mgr maintain portfolio strategy: own-vs-lease decision framework per site (links to VS-42 lease/buy analysis), target ownership mix, geographic concentration limits (Mindanao/Visayas/Luzon/NCR), yield/NOI targets, capital deployment envelope; align to VS-33 strategic plan and VS-37 store-opening pipeline
Responsible (R): Real Estate Investment Mgr / Strategy
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 4–6 weeks/cycle</bpmn:documentation>
        <bpmn:incoming>W3185_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3185_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3185_Task7" name="Finance/Treasury (links to VS-18/VS-40) model portfolio capital plan…">
        <bpmn:documentation>Step 2: Finance/Treasury (links to VS-18/VS-40) model portfolio capital plan: acquisition capex, development capex, recurring capex (TI/RC), debt capacity, cash-flow waterfall, target leverage and coverage ratios; integrate with group capex envelope (links to VS-40) and VS-72 intercompany framework
Responsible (R): Finance Analyst / Treasury
Accountable (A): CFO
Duration: 4–6 weeks/cycle</bpmn:documentation>
        <bpmn:incoming>W3185_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3185_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3185_Task8" name="Investment committee (CEO/CFO/COO/Board where required by VS-36 governance…">
        <bpmn:documentation>Step 3: Investment committee (CEO/CFO/COO/Board where required by VS-36 governance authority matrix) approves strategy, ownership thresholds, and delegation of authority; feed approved pipeline to VS-37 store-opening and VS-20 site-selection processes
Responsible (R): Investment Committee / Board
Accountable (A): CEO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W3185_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3185_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3185_End9" name="Complete">
        <bpmn:incoming>W3185_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3185_Annotation10">
        <bpmn:text>Controls: - CTL-520 (ensure controlled execution — Property Acquisition, Investment &amp; Portfolio Strategy (PA-97.1).) | - operational: geographic diversification and VS-69 disaster-resilience standards; operational: disciplined underwriting (W3186) and exit-option analysis (W3192)
Owner: Director, Facilities &amp; Real Estate</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3185_Assoc11" sourceRef="W3185_Annotation10" targetRef="W3185_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3185_Flow12" sourceRef="W3185_Start5" targetRef="W3185_Task6" />
      <bpmn:sequenceFlow id="W3185_Flow13" sourceRef="W3185_Task6" targetRef="W3185_Task7" />
      <bpmn:sequenceFlow id="W3185_Flow14" sourceRef="W3185_Task7" targetRef="W3185_Task8" />
      <bpmn:sequenceFlow id="W3185_Flow15" sourceRef="W3185_Task8" targetRef="W3185_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3185_diag">
      <bpmndi:BPMNPlane id="W3185_plane" bpmnElement="W_W3185">
