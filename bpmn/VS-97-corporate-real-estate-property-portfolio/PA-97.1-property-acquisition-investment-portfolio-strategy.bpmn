    <bpmn:process id="W_W3191" name="W3191. Property Due Diligence, Title Transfer &amp; ENC Acquisition" isExecutable="false">
      <bpmn:documentation>Trigger: LOI acceptance / pre-closing (W3187)
Frequency: Per transaction
Volume: ~10–15 transactions/year
Owner: Real Estate Investment Manager
Participants: Real Estate Investment Mgr, Legal, Title Officer, Surveyor, Environmental Engr (links to VS-24/VS-73), Finance, Broker
Source: workflow W3191 — Property Due Diligence, Title Transfer &amp; ENC Acquisition</bpmn:documentation>
      <bpmn:laneSet id="W3191_LaneSet3">
        <bpmn:lane id="W3191_Lane1" name="Legal">
        <bpmn:flowNodeRef>W3191_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3191_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3191_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3191_Lane2" name="Environmental Engineer">
        <bpmn:flowNodeRef>W3191_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3191_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3191_Start4" name="LOI acceptance / pre-closing (W3187)">
        <bpmn:outgoing>W3191_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3191_Task5" name="Legal/Title conduct title due diligence: Certified True Copy of…">
        <bpmn:documentation>Step 1: Legal/Title conduct title due diligence: Certified True Copy of Original/Transfer Certificate of Title (TCT/OCT) from Register of Deeds, trace title chain, identify encumbrances (mortgages, liens, easements, adverse claims, annotations), verify tax declarations and real-property-tax clearance (links to W3202), confirm lot boundaries via geodetic surveyor, check DENR/ LGU land-use and zoning (links to W3206)
Responsible (R): Legal / Title Officer / Surveyor
Accountable (A): VP Legal &amp; Compliance
Duration: 3–6 weeks</bpmn:documentation>
        <bpmn:incoming>W3191_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3191_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3191_Task6" name="Environmental Engineer (links to VS-24/VS-73) conduct Phase I environmental…">
        <bpmn:documentation>Step 2: Environmental Engineer (links to VS-24/VS-73) conduct Phase I environmental site assessment: historical land use (contamination risk — paints, chemicals, fuel), wetland/floodplain, asbestos/lead in existing structures; escalate to Phase II sampling if warranted; engineering due diligence (structural, geotechnical, utilities)
Responsible (R): Environmental Engineer
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W3191_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3191_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3191_Task7" name="Acquire clean title and ENC: clear identified encumbrances prior to close…">
        <bpmn:documentation>Step 3: Acquire clean title and ENC: clear identified encumbrances prior to close, obtain title insurance where available, execute Deed of Sale, register transfer at Register of Deeds, secure new TCT in Property Mgmt Inc. name; archive all DD documentation (links to VS-88)
Responsible (R): Legal / Title Officer
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 3–6 weeks</bpmn:documentation>
        <bpmn:incoming>W3191_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3191_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3191_End8" name="Complete">
        <bpmn:incoming>W3191_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3191_Annotation9">
        <bpmn:text>Controls: - CTL-520 (ensure controlled execution — Property Acquisition, Investment &amp; Portfolio Strategy (PA-97.1).) | - operational: title search, insurance, and indemnities from seller; operational: Phase I/II ESA and contractual indemnity
Owner: Real Estate Investment Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3191_Assoc10" sourceRef="W3191_Annotation9" targetRef="W3191_Start4" associationDirection="None" />
