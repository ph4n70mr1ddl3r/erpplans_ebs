    <bpmn:process id="W_W3190" name="W3190. Real Estate Capital Stack &amp; Financing Structuring" isExecutable="false">
      <bpmn:documentation>Trigger: Acquisition (W3187); development (W3188); refinance; debt maturity
Frequency: Per transaction + portfolio-level review
Volume: Portfolio-level debt program; ~3–8 facility events/year
Owner: Treasury Manager
Participants: Treasury (links to VS-18), Director, Facilities &amp; Real Estate, Finance, Legal, Lenders, Investment Committee
Source: workflow W3190 — Real Estate Capital Stack &amp; Financing Structuring</bpmn:documentation>
      <bpmn:laneSet id="W3190_LaneSet4">
        <bpmn:lane id="W3190_Lane1" name="Treasury">
        <bpmn:flowNodeRef>W3190_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3190_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3190_Lane2" name="Legal">
        <bpmn:flowNodeRef>W3190_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3190_Lane3" name="Finance Analyst">
        <bpmn:flowNodeRef>W3190_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3190_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3190_Start5" name="Acquisition (W3187); development (W3188); refinance; debt maturity">
        <bpmn:outgoing>W3190_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3190_Task6" name="Treasury (links to VS-18) structure capital stack: equity (Property Mgmt…">
        <bpmn:documentation>Step 1: Treasury (links to VS-18) structure capital stack: equity (Property Mgmt Inc./Holdings), senior debt (bank loan, bond), mezzanine if any; LTV, DSCR, and covenant targets; select funding instrument (term loan, revolving, project finance, sale-and-leaseback proceeds (W3187)); assess intercompany funding vs external
Responsible (R): Treasury / Finance
Accountable (A): CFO
Duration: 3–6 weeks</bpmn:documentation>
        <bpmn:incoming>W3190_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3190_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3190_Task7" name="Legal/Treasury negotiate facility documentation: loan agreement…">
        <bpmn:documentation>Step 2: Legal/Treasury negotiate facility documentation: loan agreement, mortgage/real-estate mortgage (REM), assignment of leases and rents, guarantees (Holdings), covenants, events of default; perfect REM with Register of Deeds; coordinate DST on mortgage (links to VS-79)
Responsible (R): Legal / Treasury
Accountable (A): VP Legal &amp; Compliance
Duration: 4–8 weeks</bpmn:documentation>
        <bpmn:incoming>W3190_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3190_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3190_Task8" name="Finance (links to VS-17/VS-18) book debt, capitalize borrowing costs (PFRS 23…">
        <bpmn:documentation>Step 3: Finance (links to VS-17/VS-18) book debt, capitalize borrowing costs (PFRS 23 where directly attributable to qualifying assets per W3188), set up amortization, and integrate debt service into property-level cash flow (W3201) and treasury forecasting (links to VS-18.1)
Responsible (R): Finance Analyst / Treasury
Accountable (A): Controller
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W3190_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3190_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3190_End9" name="Complete">
        <bpmn:incoming>W3190_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3190_Annotation10">
        <bpmn:text>Controls: - CTL-520 (ensure controlled execution — Property Acquisition, Investment &amp; Portfolio Strategy (PA-97.1).) | - operational: headroom, hedging (links to VS-18); operational: board leverage limits
Owner: Treasury Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3190_Assoc11" sourceRef="W3190_Annotation10" targetRef="W3190_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3190_Flow12" sourceRef="W3190_Start5" targetRef="W3190_Task6" />
      <bpmn:sequenceFlow id="W3190_Flow13" sourceRef="W3190_Task6" targetRef="W3190_Task7" />
      <bpmn:sequenceFlow id="W3190_Flow14" sourceRef="W3190_Task7" targetRef="W3190_Task8" />
      <bpmn:sequenceFlow id="W3190_Flow15" sourceRef="W3190_Task8" targetRef="W3190_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3190_diag">
