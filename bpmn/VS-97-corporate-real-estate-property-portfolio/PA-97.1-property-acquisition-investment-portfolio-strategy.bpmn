      <bpmndi:BPMNPlane id="W3187_plane" bpmnElement="W_W3187">
        <bpmndi:BPMNShape id="W3187_Lane1_di" bpmnElement="W3187_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3187_Lane2_di" bpmnElement="W3187_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3187_Lane3_di" bpmnElement="W3187_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3187_Task6_di" bpmnElement="W3187_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
