      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3186" name="W3186. Site Acquisition &amp; Real Estate Investment Underwriting" isExecutable="false">
      <bpmn:documentation>Trigger: Identified acquisition opportunity from VS-37 store pipeline or broker/off-market
Frequency: Per opportunity
Volume: ~20–30 underwritten opportunities/year; ~10–15 pursued to close
Owner: Real Estate Investment Manager
Participants: Real Estate Investment Mgr, Store Ops (links to VS-37), Finance, Legal, Construction (links to VS-20.2), Category/Trade Area (links to VS-01/VS-44)
Source: workflow W3186 — Site Acquisition &amp; Real Estate Investment Underwriting</bpmn:documentation>
      <bpmn:laneSet id="W3186_LaneSet4">
        <bpmn:lane id="W3186_Lane1" name="Real Estate Investment Mgr">
        <bpmn:flowNodeRef>W3186_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3186_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3186_Lane2" name="Construction Mgr">
        <bpmn:flowNodeRef>W3186_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3186_Lane3" name="Investment Committee">
        <bpmn:flowNodeRef>W3186_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3186_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3186_Start5" name="Identified acquisition opportunity from VS-37 store pipeline or broker/off-market">
        <bpmn:outgoing>W3186_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3186_Task6" name="Real Estate Investment Mgr underwrite the opportunity: trade-area analysis…">
        <bpmn:documentation>Step 1: Real Estate Investment Mgr underwrite the opportunity: trade-area analysis (population, income, competitor proximity, demand drivers per VS-44), site physical characteristics (lot size, frontage, zoning, access, parking, flood/seismic exposure per VS-69), projected store revenue (links to VS-33), development cost (links to VS-20.2), NOI, cap rate / IRR / yield-on-cost, sensitivity to rent and occupancy
Responsible (R): Real Estate Investment Mgr / Finance
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W3186_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3186_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3186_Task7" name="Construction (links to VS-20.2) / Engineering assess physical feasibility…">
        <bpmn:documentation>Step 2: Construction (links to VS-20.2) / Engineering assess physical feasibility: geotechnical, environmental, utilities, permitting complexity (links to VS-22/VS-76), demolition/abatement, construction cost and schedule; flag deal-breakers
Responsible (R): Construction Mgr / Engineer
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 1–3 weeks</bpmn:documentation>
        <bpmn:incoming>W3186_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3186_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3186_Task8" name="Investment committee approves/rejects per authority matrix (VS-36); on…">
        <bpmn:documentation>Step 3: Investment committee approves/rejects per authority matrix (VS-36); on approval, authorize due diligence (W3191), LOI/offer, and exclusivity; on rejection, archive and capture learning
Responsible (R): Investment Committee
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W3186_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3186_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3186_End9" name="Complete">
        <bpmn:incoming>W3186_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3186_Annotation10">
        <bpmn:text>Controls: - CTL-520 (ensure controlled execution — Property Acquisition, Investment &amp; Portfolio Strategy (PA-97.1).) | - operational: benchmarking to comparable BuildRight stores and third-party demographic data; operational: W3191 due-diligence gating
Owner: Real Estate Investment Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3186_Assoc11" sourceRef="W3186_Annotation10" targetRef="W3186_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3186_Flow12" sourceRef="W3186_Start5" targetRef="W3186_Task6" />
      <bpmn:sequenceFlow id="W3186_Flow13" sourceRef="W3186_Task6" targetRef="W3186_Task7" />
      <bpmn:sequenceFlow id="W3186_Flow14" sourceRef="W3186_Task7" targetRef="W3186_Task8" />
      <bpmn:sequenceFlow id="W3186_Flow15" sourceRef="W3186_Task8" targetRef="W3186_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3186_diag">
      <bpmndi:BPMNPlane id="W3186_plane" bpmnElement="W_W3186">
        <bpmndi:BPMNShape id="W3186_Lane1_di" bpmnElement="W3186_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3186_Lane2_di" bpmnElement="W3186_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3186_Lane3_di" bpmnElement="W3186_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3186_Task6_di" bpmnElement="W3186_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3186_Task7_di" bpmnElement="W3186_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
