        <bpmndi:BPMNShape id="W3190_Lane1_di" bpmnElement="W3190_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3190_Lane2_di" bpmnElement="W3190_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
