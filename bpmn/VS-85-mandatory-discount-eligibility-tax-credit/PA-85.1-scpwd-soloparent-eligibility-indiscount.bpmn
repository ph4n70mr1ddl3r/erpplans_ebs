      <bpmn:userTask id="W2904_Task6" name="Customer Service logs complaint; investigates root cause (staff error, system…">
        <bpmn:documentation>Step 1: Customer Service logs complaint; investigates root cause (staff error, system, policy misunderstanding); documents
Responsible (R): Customer Service
Accountable (A): Customer Service Lead
Duration: Per complaint</bpmn:documentation>
        <bpmn:incoming>W2904_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2904_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2904_Task7" name="Store Manager/Compliance resolves with customer; provides remedy (refund…">
        <bpmn:documentation>Step 2: Store Manager/Compliance resolves with customer; provides remedy (refund, apology) where warranted; responds to DTI/NCSC referral
Responsible (R): Store Manager / Compliance
Accountable (A): Compliance Officer
Duration: Per complaint</bpmn:documentation>
        <bpmn:incoming>W2904_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2904_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2904_Task8" name="Compliance reports recurring issues; recommends training/config changes; tracks…">
        <bpmn:documentation>Step 3: Compliance reports recurring issues; recommends training/config changes; tracks DTI/NCSC case outcomes
Responsible (R): Compliance
Accountable (A): Compliance Officer
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2904_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2904_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2904_End9" name="Complete">
        <bpmn:incoming>W2904_Flow15</bpmn:incoming>
      </bpmn:endEvent>
