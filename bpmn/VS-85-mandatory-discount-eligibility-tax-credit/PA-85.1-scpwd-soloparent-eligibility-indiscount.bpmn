    <bpmn:process id="W_W2898" name="W2898. Mandatory Discount Computation, Stack Rules &amp; Basket Validation" isExecutable="false">
      <bpmn:documentation>Trigger: Discount applied at POS
Frequency: Per transaction
Volume: ~140K–225K transactions/month
Owner: Pricing Analyst
Participants: Pricing, IT, Store Ops
Source: workflow W2898 — Mandatory Discount Computation, Stack Rules &amp; Basket Validation</bpmn:documentation>
      <bpmn:laneSet id="W2898_LaneSet4">
        <bpmn:lane id="W2898_Lane1" name="Pricing">
        <bpmn:flowNodeRef>W2898_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2898_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2898_Lane2" name="IT">
        <bpmn:flowNodeRef>W2898_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2898_Lane3" name="Store Ops">
        <bpmn:flowNodeRef>W2898_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2898_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2898_Start5" name="Discount applied at POS">
        <bpmn:outgoing>W2898_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2898_Task6" name="Pricing configures discount rules: 20% SC/PWD (5% for groceries per RA 9994 for…">
        <bpmn:documentation>Step 1: Pricing configures discount rules: 20% SC/PWD (5% for groceries per RA 9994 for selected prime commodities; 32% for medicines under RA 10754 = 20% discount + 12% VAT-exempt); 10% Solo Parent on selected goods/baby items
Responsible (R): Pricing
Accountable (A): VP Merchandising
Duration: Per rule</bpmn:documentation>
        <bpmn:incoming>W2898_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2898_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2898_Task7" name="IT implements stack-prevention logic (cannot combine SC + PWD; cannot combine…">
        <bpmn:documentation>Step 2: IT implements stack-prevention logic (cannot combine SC + PWD; cannot combine statutory + promotional beyond allowed); validates eligible-SKU basket
Responsible (R): IT
Accountable (A): Pricing Analyst
Duration: Per rule</bpmn:documentation>
        <bpmn:incoming>W2898_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2898_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2898_Task8" name="Store Ops audits POS application vs. rule monthly; investigates computation…">
        <bpmn:documentation>Step 3: Store Ops audits POS application vs. rule monthly; investigates computation errors; corrects configuration
Responsible (R): Store Ops
Accountable (A): Store Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2898_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2898_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2898_End9" name="Complete">
        <bpmn:incoming>W2898_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2898_Annotation10">
        <bpmn:text>Controls: - CTL-236 (ensure mandatory-discount &amp; VAT-exemption compliance.) | - operational: rule engine and audit
Owner: Pricing Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2898_Assoc11" sourceRef="W2898_Annotation10" targetRef="W2898_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2898_Flow12" sourceRef="W2898_Start5" targetRef="W2898_Task6" />
      <bpmn:sequenceFlow id="W2898_Flow13" sourceRef="W2898_Task6" targetRef="W2898_Task7" />
      <bpmn:sequenceFlow id="W2898_Flow14" sourceRef="W2898_Task7" targetRef="W2898_Task8" />
      <bpmn:sequenceFlow id="W2898_Flow15" sourceRef="W2898_Task8" targetRef="W2898_End9" />
    </bpmn:process>
