    <bpmn:process id="W_W2900" name="W2900. Discount Abuse, ID Sharing &amp; Fraud Prevention Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Anomaly detection or LP review
Frequency: Weekly review
Volume: ~50–200 flagged events/month
Owner: LP Analyst
Participants: LP, Store Manager, IT
Source: workflow W2900 — Discount Abuse, ID Sharing &amp; Fraud Prevention Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W2900_LaneSet4">
        <bpmn:lane id="W2900_Lane1" name="LP Analyst">
        <bpmn:flowNodeRef>W2900_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2900_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2900_Lane2" name="LP">
        <bpmn:flowNodeRef>W2900_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2900_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W2900_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2900_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2900_Start5" name="Anomaly detection or LP review">
        <bpmn:outgoing>W2900_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2900_Task6" name="IT/LP monitors for fraud signals: same ID used across multiple…">
        <bpmn:documentation>Step 1: IT/LP monitors for fraud signals: same ID used across multiple transactions/stores, frequent high-value purchases, ID photo mismatch
Responsible (R): LP Analyst
Accountable (A): LP Manager
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W2900_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2900_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2900_Task7" name="LP investigates flagged events; reviews CCTV; refers suspected ID-sharing/fraud…">
        <bpmn:documentation>Step 2: LP investigates flagged events; reviews CCTV; refers suspected ID-sharing/fraud to OSCA/NCDA/PNP where warranted
Responsible (R): LP
Accountable (A): LP Manager
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W2900_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2900_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2900_Task8" name="Store Manager reinforces cashier vigilance; LP trends abuse by store and…">
        <bpmn:documentation>Step 3: Store Manager reinforces cashier vigilance; LP trends abuse by store and recommends controls (ID-scan, frequency caps)
Responsible (R): Store Manager / LP
Accountable (A): LP Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2900_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2900_Flow15</bpmn:outgoing>
