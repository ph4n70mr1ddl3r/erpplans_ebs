    <bpmn:process id="W_W2897" name="W2897. SC/PWD/Solo Parent ID Validation &amp; Eligibility Verification at POS" isExecutable="false">
      <bpmn:documentation>Trigger: Customer presents discount ID at checkout
Frequency: ~140,000–225,000 transactions/month (5–8% of POS)
Volume: 600 POS terminals; 200 stores
Owner: Store Manager
Participants: Cashier, Customer, Store Manager
Source: workflow W2897 — SC/PWD/Solo Parent ID Validation &amp; Eligibility Verification at POS</bpmn:documentation>
      <bpmn:laneSet id="W2897_LaneSet3">
        <bpmn:lane id="W2897_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W2897_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2897_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2897_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2897_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W2897_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2897_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2897_Start4" name="Customer presents discount ID at checkout">
        <bpmn:outgoing>W2897_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2897_Task5" name="Cashier validates ID: OSCA Senior ID / PhilSys for seniors; PWD ID from…">
        <bpmn:documentation>Step 1: Cashier validates ID: OSCA Senior ID / PhilSys for seniors; PWD ID from NCDA-accredited LGU; Solo Parent ID from LGU; checks photo, validity, and ownership
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: Per transaction</bpmn:documentation>
        <bpmn:incoming>W2897_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2897_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2897_Task6" name="Cashier captures ID number and customer name in POS; ERP applies statutory…">
        <bpmn:documentation>Step 2: Cashier captures ID number and customer name in POS; ERP applies statutory discount and records transaction in mandatory-discount register
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: Per transaction</bpmn:documentation>
        <bpmn:incoming>W2897_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2897_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2897_Task7" name="Store Manager resolves disputes (expired ID, eligibility question) per…">
        <bpmn:documentation>Step 3: Store Manager resolves disputes (expired ID, eligibility question) per protocol; denies discount with courteous explanation where invalid
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: Per dispute</bpmn:documentation>
        <bpmn:incoming>W2897_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2897_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2897_End8" name="Complete">
        <bpmn:incoming>W2897_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2897_Annotation9">
        <bpmn:text>Controls: - CTL-236 (ensure mandatory-discount &amp; VAT-exemption compliance.) | - operational: mandatory ID capture in POS
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2897_Assoc10" sourceRef="W2897_Annotation9" targetRef="W2897_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2897_Flow11" sourceRef="W2897_Start4" targetRef="W2897_Task5" />
      <bpmn:sequenceFlow id="W2897_Flow12" sourceRef="W2897_Task5" targetRef="W2897_Task6" />
      <bpmn:sequenceFlow id="W2897_Flow13" sourceRef="W2897_Task6" targetRef="W2897_Task7" />
      <bpmn:sequenceFlow id="W2897_Flow14" sourceRef="W2897_Task7" targetRef="W2897_End8" />
    </bpmn:process>
