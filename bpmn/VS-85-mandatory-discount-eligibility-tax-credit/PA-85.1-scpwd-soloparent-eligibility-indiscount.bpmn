    <bpmn:process id="W_W2899" name="W2899. SC/PWD Purchase Book of Sales Transaction Recording" isExecutable="false">
      <bpmn:documentation>Trigger: Each SC/PWD transaction
Frequency: Continuous; aggregated monthly
Volume: ~140K–225K transactions/month
Owner: Tax Accountant
Participants: Tax Accountant, Store Manager, IT
Source: workflow W2899 — SC/PWD Purchase Book of Sales Transaction Recording</bpmn:documentation>
      <bpmn:laneSet id="W2899_LaneSet3">
        <bpmn:lane id="W2899_Lane1" name="ERP automation">
        <bpmn:flowNodeRef>W2899_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2899_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2899_Lane2" name="Tax Accountant">
        <bpmn:flowNodeRef>W2899_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2899_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2899_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2899_Start4" name="Each SC/PWD transaction">
        <bpmn:outgoing>W2899_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2899_Task5" name="ERP auto-records each SC/PWD transaction in mandatory Book of…">
        <bpmn:documentation>Step 1: ERP auto-records each SC/PWD transaction in mandatory Book of Sales/Transactions (per RA 9994 IRR): date, customer name, ID number, gross amount, discount, VAT component
Responsible (R): ERP automation
Accountable (A): Tax Accountant
Duration: Per transaction</bpmn:documentation>
        <bpmn:incoming>W2899_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2899_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2899_Task6" name="Tax Accountant validates book completeness monthly per store; reconciles to POS…">
        <bpmn:documentation>Step 2: Tax Accountant validates book completeness monthly per store; reconciles to POS sales register; investigates gaps
Responsible (R): Tax Accountant
Accountable (A): Tax Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2899_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2899_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2899_Task7" name="Tax Accountant archives book per location for BIR inspection; maintains 10-year…">
        <bpmn:documentation>Step 3: Tax Accountant archives book per location for BIR inspection; maintains 10-year retention
Responsible (R): Tax Accountant
Accountable (A): Tax Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2899_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2899_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2899_End8" name="Complete">
        <bpmn:incoming>W2899_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2899_Annotation9">
        <bpmn:text>Controls: - CTL-236 (ensure mandatory-discount &amp; VAT-exemption compliance.) | - operational: auto-recording and monthly reconciliation
Owner: Tax Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2899_Assoc10" sourceRef="W2899_Annotation9" targetRef="W2899_Start4" associationDirection="None" />
