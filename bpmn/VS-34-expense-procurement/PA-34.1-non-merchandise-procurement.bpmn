    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1669" name="W1669. IT Equipment &amp; Software Procurement" isExecutable="false">
      <bpmn:documentation>Trigger: IT procurement plan, equipment replacement cycle, or ad-hoc request
Frequency: Quarterly planned procurement; ad-hoc for replacements
Volume: ~50–100 IT purchase orders/quarter
Owner: IT Procurement Manager
Participants: IT Procurement Manager, CIO, IT team, Finance
Source: workflow W1669 — IT Equipment &amp; Software Procurement</bpmn:documentation>
      <bpmn:laneSet id="W1669_LaneSet3">
        <bpmn:lane id="W1669_Lane1" name="CIO">
        <bpmn:flowNodeRef>W1669_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1669_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1669_Lane2" name="IT Procurement Manager">
        <bpmn:flowNodeRef>W1669_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1669_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1669_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1669_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1669_Start4" name="IT procurement plan, equipment replacement cycle, or ad-hoc request">
        <bpmn:outgoing>W1669_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1669_Task5" name="CIO develops annual IT procurement plan: (a) POS hardware refresh schedule (600…">
        <bpmn:documentation>Step 1: CIO develops annual IT procurement plan: (a) POS hardware refresh schedule (600 terminals; target 5-year lifecycle = ~120 replacements/year), (b) server and network infrastructure upgrades, (c) employee laptop/desktop refresh (532 HQ + DC office staff), (d) software license renewals (annual), (e) new technology projects (per strategic plan W1645), (f) barcode scanners, RF guns, printers for stores and DCs
Responsible (R): CIO
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1669_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1669_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1669_Task6" name="IT Procurement Manager executes procurement: (a) obtain 3 quotes for items &gt;…">
        <bpmn:documentation>Step 2: IT Procurement Manager executes procurement: (a) obtain 3 quotes for items &gt; PHP 50K, (b) evaluate: specifications, total cost of ownership, warranty, vendor support capability in Philippines, (c) recommend vendor to CIO, (d) create purchase requisition per W1675
Responsible (R): IT Procurement Manager
Accountable (A): CIO
Duration: 2 hours/PO</bpmn:documentation>
        <bpmn:incoming>W1669_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1669_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1669_Task7" name="Software procurement specifics: (a) SaaS subscriptions: annual license cost…">
        <bpmn:documentation>Step 3: Software procurement specifics: (a) SaaS subscriptions: annual license cost, user count, renewal date, auto-renewal flag, (b) perpetual licenses: maintenance and support fees, upgrade rights, (c) open source: license compliance review by IT, (d) all software procurement requires IT security review before purchase
Responsible (R): IT Procurement Manager
Accountable (A): CIO
Duration: Per item</bpmn:documentation>
        <bpmn:incoming>W1669_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1669_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1669_Task8" name="IT asset tracking: all IT equipment recorded in asset register with: (a) asset…">
        <bpmn:documentation>Step 4: IT asset tracking: all IT equipment recorded in asset register with: (a) asset tag, (b) assigned user/location, (c) warranty expiry, (d) depreciation schedule, (e) maintenance schedule
Responsible (R): IT Procurement Manager / IT Team
Accountable (A): CIO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1669_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1669_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1669_End9" name="Complete">
        <bpmn:incoming>W1669_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1669_Annotation10">
        <bpmn:text>Controls: - CTL-343 (ensure controlled execution — Non-Merchandise Procurement Operations (PA-34.1).) | - operational: IT Procurement Manager review and approval gate
Owner: IT Procurement Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1669_Assoc11" sourceRef="W1669_Annotation10" targetRef="W1669_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1669_Flow12" sourceRef="W1669_Start4" targetRef="W1669_Task5" />
      <bpmn:sequenceFlow id="W1669_Flow13" sourceRef="W1669_Task5" targetRef="W1669_Task6" />
      <bpmn:sequenceFlow id="W1669_Flow14" sourceRef="W1669_Task6" targetRef="W1669_Task7" />
      <bpmn:sequenceFlow id="W1669_Flow15" sourceRef="W1669_Task7" targetRef="W1669_Task8" />
      <bpmn:sequenceFlow id="W1669_Flow16" sourceRef="W1669_Task8" targetRef="W1669_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1669_diag">
      <bpmndi:BPMNPlane id="W1669_plane" bpmnElement="W_W1669">
        <bpmndi:BPMNShape id="W1669_Lane1_di" bpmnElement="W1669_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1669_Lane2_di" bpmnElement="W1669_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1669_Task5_di" bpmnElement="W1669_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1669_Task6_di" bpmnElement="W1669_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1669_Task7_di" bpmnElement="W1669_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1669_Task8_di" bpmnElement="W1669_Task8"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1669_Start4_di" bpmnElement="W1669_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1669_End9_di" bpmnElement="W1669_End9"><dc:Bounds x="1260" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1669_Annotation10_di" bpmnElement="W1669_Annotation10"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1669_Flow12_di" bpmnElement="W1669_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1669_Flow13_di" bpmnElement="W1669_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1669_Flow14_di" bpmnElement="W1669_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1669_Flow15_di" bpmnElement="W1669_Flow15"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1669_Flow16_di" bpmnElement="W1669_Flow16"><di:waypoint x="1210" y="335" /><di:waypoint x="1260" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1669_Assoc11_di" bpmnElement="W1669_Assoc11"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1670" name="W1670. Uniform, PPE &amp; Safety Equipment Procurement" isExecutable="false">
      <bpmn:documentation>Trigger: Annual uniform refresh, new hire onboarding, or PPE replenishment
Frequency: Quarterly bulk orders; ad-hoc for new hires
Volume: ~1,200–1,600 new hires/year × 3 sets uniform + quarterly PPE replenishment
Owner: HR Operations
Participants: HR Operations, Procurement Specialist, Store Managers, Safety Officer
Source: workflow W1670 — Uniform, PPE &amp; Safety Equipment Procurement</bpmn:documentation>
      <bpmn:laneSet id="W1670_LaneSet4">
        <bpmn:lane id="W1670_Lane1" name="HR Operations">
        <bpmn:flowNodeRef>W1670_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1670_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1670_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1670_Lane2" name="Procurement Specialist">
        <bpmn:flowNodeRef>W1670_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1670_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W1670_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1670_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1670_Start5" name="Annual uniform refresh, new hire onboarding, or PPE replenishment">
        <bpmn:outgoing>W1670_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1670_Task6" name="HR Operations manages uniform and PPE catalog: (a) uniforms: polo shirts (3 per…">
        <bpmn:documentation>Step 1: HR Operations manages uniform and PPE catalog: (a) uniforms: polo shirts (3 per employee), slacks/pants (2 per employee), safety shoes (1 per employee), ID lanyards, name badges, (b) PPE per role: hard hats (lumber yard staff), gloves (receiving clerks), safety goggles (cutting services), masks (paint mixing), high-visibility vests (stockroom), harnesses (high-bay access), (c) seasonal PPE: raincoats (monsoon season), cooling towels (summer)
Responsible (R): HR Operations
Accountable (A): CHRO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1670_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1670_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1670_Task7" name="Quarterly: HR Operations forecasts uniform and PPE needs: (a) new hire demand…">
        <bpmn:documentation>Step 2: Quarterly: HR Operations forecasts uniform and PPE needs: (a) new hire demand (from recruitment pipeline per W292), (b) replacement demand (wear/tear cycle ~6 months for active roles), (c) regulatory PPE replenishment (per DOLE requirements), (d) creates purchase requisition per W1675
Responsible (R): HR Operations
Accountable (A): Procurement Specialist
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W1670_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1670_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1670_Task8" name="Procurement Specialist sources from contracted uniform supplier and PPE…">
        <bpmn:documentation>Step 3: Procurement Specialist sources from contracted uniform supplier and PPE suppliers; manages delivery to DC for distribution to stores and HQ
Responsible (R): Procurement Specialist
Accountable (A): VP Store Operations
Duration: 2 days/quarter</bpmn:documentation>
        <bpmn:incoming>W1670_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1670_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1670_Task9" name="Store Manager distributes uniforms to new hires during onboarding (W292); PPE…">
        <bpmn:documentation>Step 4: Store Manager distributes uniforms to new hires during onboarding (W292); PPE issued per role and tracked per employee in system (W1670.4 of HR-017); issues draw from an expense subinventory per requisition — never capitalized — under the store&#x27;s named storeroom custodian, with balances counted quarterly against issues and returns, and separated employees&#x27; uniforms and PPE recovered or written off per policy
Responsible (R): Store Manager
Accountable (A): HR Operations
Duration: 15 min/new hire</bpmn:documentation>
        <bpmn:incoming>W1670_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1670_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1670_End10" name="Complete">
        <bpmn:incoming>W1670_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1670_Annotation11">
        <bpmn:text>Controls: - CTL-343 (ensure controlled execution — Non-Merchandise Procurement Operations (PA-34.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: HR Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1670_Assoc12" sourceRef="W1670_Annotation11" targetRef="W1670_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1670_Flow13" sourceRef="W1670_Start5" targetRef="W1670_Task6" />
      <bpmn:sequenceFlow id="W1670_Flow14" sourceRef="W1670_Task6" targetRef="W1670_Task7" />
      <bpmn:sequenceFlow id="W1670_Flow15" sourceRef="W1670_Task7" targetRef="W1670_Task8" />
      <bpmn:sequenceFlow id="W1670_Flow16" sourceRef="W1670_Task8" targetRef="W1670_Task9" />
      <bpmn:sequenceFlow id="W1670_Flow17" sourceRef="W1670_Task9" targetRef="W1670_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1670_diag">
      <bpmndi:BPMNPlane id="W1670_plane" bpmnElement="W_W1670">
        <bpmndi:BPMNShape id="W1670_Lane1_di" bpmnElement="W1670_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1670_Lane2_di" bpmnElement="W1670_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1670_Lane3_di" bpmnElement="W1670_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
