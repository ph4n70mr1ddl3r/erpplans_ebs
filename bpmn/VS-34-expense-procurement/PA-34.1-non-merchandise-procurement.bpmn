      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1675" name="W1675. Non-Merchandise Purchase Requisition to Payment Workflow" isExecutable="false">
      <bpmn:documentation>Trigger: Any non-merchandise purchase need identified
Frequency: ~1,500–2,000 non-merchandise purchase requisitions/month
Volume: ~8–10 per location/month + HQ departmental purchases
Owner: Procurement Specialist
Participants: Requesting employee, Approving manager, Procurement Specialist, AP Clerk
Source: workflow W1675 — Non-Merchandise Purchase Requisition to Payment Workflow</bpmn:documentation>
      <bpmn:laneSet id="W1675_LaneSet5">
        <bpmn:lane id="W1675_Lane1" name="Requesting Employee">
        <bpmn:flowNodeRef>W1675_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1675_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1675_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1675_Lane2" name="System">
        <bpmn:flowNodeRef>W1675_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1675_Lane3" name="Procurement Specialist">
        <bpmn:flowNodeRef>W1675_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1675_Lane4" name="AP Clerk">
        <bpmn:flowNodeRef>W1675_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1675_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1675_Start6" name="Any non-merchandise purchase need identified">
        <bpmn:outgoing>W1675_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1675_Task7" name="Requesting employee creates purchase requisition in system: (a) item/service…">
        <bpmn:documentation>Step 1: Requesting employee creates purchase requisition in system: (a) item/service description, (b) quantity and estimated cost, (c) preferred vendor (if known), (d) delivery location, (e) required-by date, (f) budget category and cost center
Responsible (R): Requesting Employee
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1675_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1675_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1675_Task8" name="Approval workflow (tiered by amount): (a) &lt; PHP 5K: direct supervisor, (b) PHP…">
        <bpmn:documentation>Step 2: Approval workflow (tiered by amount): (a) &lt; PHP 5K: direct supervisor, (b) PHP 5–50K: department head, (c) PHP 50–500K: VP + Finance Manager, (d) &gt; PHP 500K: CFO + CEO, (e) budget check: system verifies spend against departmental budget; over-budget requisitions require VP + Finance approval
Responsible (R): System / Approver
Accountable (A): —
Duration: Per SLA (24 hours standard)</bpmn:documentation>
        <bpmn:incoming>W1675_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1675_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1675_Task9" name="Procurement Specialist processes approved requisition: (a) &lt; PHP 50K: order…">
        <bpmn:documentation>Step 3: Procurement Specialist processes approved requisition: (a) &lt; PHP 50K: order from contracted or preferred vendor (no competitive quote required), (b) PHP 50–500K: obtain minimum 3 quotes, (c) &gt; PHP 500K: formal bidding process with bid evaluation committee, (d) create PO and send to vendor
Responsible (R): Procurement Specialist
Accountable (A): Finance Manager
Duration: 1–5 days</bpmn:documentation>
        <bpmn:incoming>W1675_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1675_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1675_Task10" name="Goods/service received: (a) requesting employee confirms receipt and quality in…">
        <bpmn:documentation>Step 4: Goods/service received: (a) requesting employee confirms receipt and quality in system, (b) for services: confirm service completion and satisfaction, (c) system performs 2-way match (PO → Invoice) for non-merchandise purchases (no GR for services)
Responsible (R): Requesting Employee
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1675_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1675_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1675_Task11" name="AP Clerk processes payment per standard P2P workflow (W89/W90) — 2-way match…">
        <bpmn:documentation>Step 5: AP Clerk processes payment per standard P2P workflow (W89/W90) — 2-way match for non-PO items; 3-way match for PO-based items with goods receipt
Responsible (R): AP Clerk
Accountable (A): Controller
Duration: Per W89</bpmn:documentation>
        <bpmn:incoming>W1675_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1675_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1675_End12" name="Complete">
        <bpmn:incoming>W1675_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1675_Annotation13">
        <bpmn:text>Controls: - CTL-207 (prevent unauthorized non-merchandise spend.) | - operational: Procurement Specialist review and approval gate
Owner: Procurement Specialist</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1675_Assoc14" sourceRef="W1675_Annotation13" targetRef="W1675_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1675_Flow15" sourceRef="W1675_Start6" targetRef="W1675_Task7" />
      <bpmn:sequenceFlow id="W1675_Flow16" sourceRef="W1675_Task7" targetRef="W1675_Task8" />
      <bpmn:sequenceFlow id="W1675_Flow17" sourceRef="W1675_Task8" targetRef="W1675_Task9" />
      <bpmn:sequenceFlow id="W1675_Flow18" sourceRef="W1675_Task9" targetRef="W1675_Task10" />
      <bpmn:sequenceFlow id="W1675_Flow19" sourceRef="W1675_Task10" targetRef="W1675_Task11" />
      <bpmn:sequenceFlow id="W1675_Flow20" sourceRef="W1675_Task11" targetRef="W1675_End12" />
    </bpmn:process>
