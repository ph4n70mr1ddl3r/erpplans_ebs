    <bpmn:process id="W_W1671" name="W1671. Marketing Materials &amp; Print Procurement" isExecutable="false">
      <bpmn:documentation>Trigger: Promotional calendar event, campaign launch, or in-store signage refresh
Frequency: 6 major promotional events/year + monthly marketing activities
Volume: ~20–30 marketing procurement orders/year
Owner: Marketing Operations Manager
Participants: Marketing Operations, CMO, Procurement Specialist
Source: workflow W1671 — Marketing Materials &amp; Print Procurement</bpmn:documentation>
      <bpmn:laneSet id="W1671_LaneSet4">
        <bpmn:lane id="W1671_Lane1" name="Marketing Operations">
        <bpmn:flowNodeRef>W1671_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1671_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1671_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1671_Lane2" name="Procurement Specialist">
        <bpmn:flowNodeRef>W1671_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1671_Lane3" name="DC Operations">
        <bpmn:flowNodeRef>W1671_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1671_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1671_Start5" name="Promotional calendar event, campaign launch, or in-store signage refresh">
        <bpmn:outgoing>W1671_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1671_Task6" name="Marketing Operations Manager manages marketing materials procurement: (a)…">
        <bpmn:documentation>Step 1: Marketing Operations Manager manages marketing materials procurement: (a) promotional flyers and catalogs (6 major sale events × 200 stores = 1,200 print runs), (b) in-store signage: banners, shelf talkers, danglers, window displays, (c) outdoor signage: tarpaulins, billboards, (d) digital assets: not physical procurement but vendor management for creative agency, photography, video production, (e) loyalty program materials: membership cards, welcome kits, (f) brand materials: store exterior signage (for new stores), uniforms (coordinated with HR)
Responsible (R): Marketing Operations
Accountable (A): CMO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1671_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1671_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1671_Task7" name="Per campaign: Marketing Operations creates print specification: (a) quantity…">
        <bpmn:documentation>Step 2: Per campaign: Marketing Operations creates print specification: (a) quantity per store (varies by store size and traffic), (b) total print run (200 stores × allocation + 10% buffer), (c) paper quality, dimensions, finish, (d) delivery deadline (must arrive at DC 5 days before campaign launch for distribution to stores), (e) creates purchase requisition per W1675
Responsible (R): Marketing Operations
Accountable (A): CMO
Duration: 2 hours/campaign</bpmn:documentation>
        <bpmn:incoming>W1671_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1671_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1671_Task8" name="Procurement Specialist obtains quotes from contracted print vendors; evaluates…">
        <bpmn:documentation>Step 3: Procurement Specialist obtains quotes from contracted print vendors; evaluates quality, price, and delivery timeline; places order
Responsible (R): Procurement Specialist
Accountable (A): Marketing Operations
Duration: 1 day/campaign</bpmn:documentation>
        <bpmn:incoming>W1671_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1671_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1671_Task9" name="Print materials delivered to DC; consolidated with store replenishment…">
        <bpmn:documentation>Step 4: Print materials delivered to DC; consolidated with store replenishment shipments; Store Manager receives and deploys per marketing instructions
Responsible (R): DC Operations / Store Manager
Accountable (A): Marketing Operations
Duration: Per campaign</bpmn:documentation>
        <bpmn:incoming>W1671_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1671_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1671_End10" name="Complete">
        <bpmn:incoming>W1671_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1671_Annotation11">
        <bpmn:text>Controls: - CTL-343 (ensure controlled execution — Non-Merchandise Procurement Operations (PA-34.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Marketing Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1671_Assoc12" sourceRef="W1671_Annotation11" targetRef="W1671_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1671_Flow13" sourceRef="W1671_Start5" targetRef="W1671_Task6" />
      <bpmn:sequenceFlow id="W1671_Flow14" sourceRef="W1671_Task6" targetRef="W1671_Task7" />
      <bpmn:sequenceFlow id="W1671_Flow15" sourceRef="W1671_Task7" targetRef="W1671_Task8" />
      <bpmn:sequenceFlow id="W1671_Flow16" sourceRef="W1671_Task8" targetRef="W1671_Task9" />
      <bpmn:sequenceFlow id="W1671_Flow17" sourceRef="W1671_Task9" targetRef="W1671_End10" />
    </bpmn:process>
