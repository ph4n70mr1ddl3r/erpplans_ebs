<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-34.1-non-merchandise-procurement" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1668" name="W1668. Store Supplies &amp; Consumables Procurement" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly replenishment cycle or low stock alert
Frequency: Monthly blanket PO releases; weekly ad-hoc requests
Volume: ~200 stores × ~50 supply SKUs = ~10,000 supply items/month
Owner: Procurement Specialist — Non-Merchandise
Participants: Procurement Specialist, Store Managers, AP Clerk
Source: workflow W1668 — Store Supplies &amp; Consumables Procurement</bpmn:documentation>
      <bpmn:laneSet id="W1668_LaneSet4">
        <bpmn:lane id="W1668_Lane1" name="Procurement Specialist">
        <bpmn:flowNodeRef>W1668_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1668_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1668_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1668_Lane2" name="System">
        <bpmn:flowNodeRef>W1668_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1668_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W1668_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1668_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1668_Start5" name="Monthly replenishment cycle or low stock alert">
        <bpmn:outgoing>W1668_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1668_Task6" name="Procurement Specialist manages store supplies catalog: (a) shelf labels and…">
        <bpmn:documentation>Step 1: Procurement Specialist manages store supplies catalog: (a) shelf labels and price tags, (b) receipt paper rolls (thermal), (c) shopping bags (paper and plastic per LGU regulations — some Philippine cities ban plastic bags), (d) cleaning supplies, (e) cash register tape, (f) signage materials, (g) go-bags (security bags for cash transport), (h) first aid kit supplies, (i) packing materials (stretch wrap, boxes for ecommerce)
Responsible (R): Procurement Specialist
Accountable (A): VP Store Operations
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1668_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1668_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1668_Task7" name="Monthly: system generates store supply replenishment suggestions based on: (a)…">
        <bpmn:documentation>Step 2: Monthly: system generates store supply replenishment suggestions based on: (a) standard supply allocation per store (e.g., 10 rolls of receipt paper per POS terminal per month), (b) usage rate from prior months, (c) special events (promotional signage materials for sale events)
Responsible (R): System
Accountable (A): Procurement Specialist
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1668_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1668_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1668_Task8" name="Procurement Specialist reviews and adjusts replenishment quantities; releases…">
        <bpmn:documentation>Step 3: Procurement Specialist reviews and adjusts replenishment quantities; releases blanket PO to contracted suppliers; suppliers deliver to DC for consolidation with merchandise shipments to stores
Responsible (R): Procurement Specialist
Accountable (A): VP Store Operations
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W1668_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1668_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1668_Task9" name="Store Managers submit ad-hoc supply requests through system (e.g., unexpected…">
        <bpmn:documentation>Step 4: Store Managers submit ad-hoc supply requests through system (e.g., unexpected supply consumption, broken equipment replacement); approved by Regional Manager; Procurement Specialist processes via express order
Responsible (R): Store Manager / Regional Manager
Accountable (A): Procurement Specialist
Duration: 15 min/request</bpmn:documentation>
        <bpmn:incoming>W1668_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1668_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1668_End10" name="Complete">
        <bpmn:incoming>W1668_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1668_Annotation11">
        <bpmn:text>Controls: - CTL-343 (ensure controlled execution — Non-Merchandise Procurement Operations (PA-34.1).) | - operational: Procurement Specialist — Non-Merchandise review and approval gate
Owner: Procurement Specialist — Non-Merchandise</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1668_Assoc12" sourceRef="W1668_Annotation11" targetRef="W1668_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1668_Flow13" sourceRef="W1668_Start5" targetRef="W1668_Task6" />
      <bpmn:sequenceFlow id="W1668_Flow14" sourceRef="W1668_Task6" targetRef="W1668_Task7" />
      <bpmn:sequenceFlow id="W1668_Flow15" sourceRef="W1668_Task7" targetRef="W1668_Task8" />
      <bpmn:sequenceFlow id="W1668_Flow16" sourceRef="W1668_Task8" targetRef="W1668_Task9" />
      <bpmn:sequenceFlow id="W1668_Flow17" sourceRef="W1668_Task9" targetRef="W1668_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1668_diag">
      <bpmndi:BPMNPlane id="W1668_plane" bpmnElement="W_W1668">
        <bpmndi:BPMNShape id="W1668_Lane1_di" bpmnElement="W1668_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
