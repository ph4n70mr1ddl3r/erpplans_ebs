    <bpmn:process id="W_W1672" name="W1672. Facility Maintenance Supplies &amp; Services Procurement" isExecutable="false">
      <bpmn:documentation>Trigger: Maintenance schedule, equipment failure, or seasonal maintenance needs
Frequency: Monthly recurring services; ad-hoc for repairs
Volume: ~500–700 maintenance POs/month across 205 locations
Owner: Facilities Manager
Participants: Facilities Manager, Store Managers, DC Supervisor, Procurement Specialist
Source: workflow W1672 — Facility Maintenance Supplies &amp; Services Procurement</bpmn:documentation>
      <bpmn:laneSet id="W1672_LaneSet3">
        <bpmn:lane id="W1672_Lane1" name="Facilities Manager">
        <bpmn:flowNodeRef>W1672_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1672_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1672_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1672_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1672_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W1672_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1672_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1672_Start4" name="Maintenance schedule, equipment failure, or seasonal maintenance needs">
        <bpmn:outgoing>W1672_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1672_Task5" name="Facilities Manager manages contracted maintenance services: (a) aircon/HVAC…">
        <bpmn:documentation>Step 1: Facilities Manager manages contracted maintenance services: (a) aircon/HVAC cleaning and maintenance (quarterly per store — 200 stores × 4 = 800 service visits/year), (b) elevator/escalator maintenance (stores with multi-level format), (c) fire suppression system inspection (annual per BFP requirement), (d) pest control (monthly per store/DC — 205 locations × 12 = 2,460 service visits/year), (e) generator maintenance (per W808), (f) plumbing and electrical repairs, (g) floor maintenance (polishing, repair)
Responsible (R): Facilities Manager
Accountable (A): VP Store Operations
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1672_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1672_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1672_Task6" name="Store Managers submit maintenance service requests through system: (a) describe…">
        <bpmn:documentation>Step 2: Store Managers submit maintenance service requests through system: (a) describe issue with photo, (b) urgency level: routine (7-day SLA), urgent (48-hour SLA), emergency (4-hour SLA), (c) system routes to Facilities Manager for approval and vendor dispatch
Responsible (R): Store Manager
Accountable (A): Facilities Manager
Duration: 10 min/request</bpmn:documentation>
        <bpmn:incoming>W1672_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1672_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1672_Task7" name="Facilities Manager dispatches contracted vendor; tracks service completion…">
        <bpmn:documentation>Step 3: Facilities Manager dispatches contracted vendor; tracks service completion; vendor submits service report and invoice; Facilities Manager confirms completion and approves invoice for payment
Responsible (R): Facilities Manager
Accountable (A): VP Store Operations
Duration: 15 min/request</bpmn:documentation>
        <bpmn:incoming>W1672_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1672_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1672_Task8" name="Maintenance supplies procurement: (a) light bulbs (LED replacements), (b)…">
        <bpmn:documentation>Step 4: Maintenance supplies procurement: (a) light bulbs (LED replacements), (b) cleaning chemicals, (c) paint for touch-ups, (d) plumbing fittings, (e) electrical components (switches, breakers), (f) ordered monthly through blanket PO from contracted suppliers
Responsible (R): Facilities Manager
Accountable (A): Procurement Specialist
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W1672_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1672_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1672_End9" name="Complete">
        <bpmn:incoming>W1672_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1672_Annotation10">
        <bpmn:text>Controls: - CTL-343 (ensure controlled execution — Non-Merchandise Procurement Operations (PA-34.1).) | - operational: Facilities Manager review and approval gate
Owner: Facilities Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1672_Assoc11" sourceRef="W1672_Annotation10" targetRef="W1672_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1672_Flow12" sourceRef="W1672_Start4" targetRef="W1672_Task5" />
      <bpmn:sequenceFlow id="W1672_Flow13" sourceRef="W1672_Task5" targetRef="W1672_Task6" />
      <bpmn:sequenceFlow id="W1672_Flow14" sourceRef="W1672_Task6" targetRef="W1672_Task7" />
      <bpmn:sequenceFlow id="W1672_Flow15" sourceRef="W1672_Task7" targetRef="W1672_Task8" />
      <bpmn:sequenceFlow id="W1672_Flow16" sourceRef="W1672_Task8" targetRef="W1672_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1672_diag">
      <bpmndi:BPMNPlane id="W1672_plane" bpmnElement="W_W1672">
        <bpmndi:BPMNShape id="W1672_Lane1_di" bpmnElement="W1672_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1672_Lane2_di" bpmnElement="W1672_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1672_Task5_di" bpmnElement="W1672_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1672_Task6_di" bpmnElement="W1672_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1672_Task7_di" bpmnElement="W1672_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1672_Task8_di" bpmnElement="W1672_Task8"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1672_Start4_di" bpmnElement="W1672_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1672_End9_di" bpmnElement="W1672_End9"><dc:Bounds x="1260" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1672_Annotation10_di" bpmnElement="W1672_Annotation10"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1672_Flow12_di" bpmnElement="W1672_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1672_Flow13_di" bpmnElement="W1672_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1672_Flow14_di" bpmnElement="W1672_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1672_Flow15_di" bpmnElement="W1672_Flow15"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1672_Flow16_di" bpmnElement="W1672_Flow16"><di:waypoint x="1210" y="165" /><di:waypoint x="1260" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1672_Assoc11_di" bpmnElement="W1672_Assoc11"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1673" name="W1673. Office Supplies &amp; Administrative Procurement" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly replenishment cycle
Frequency: Monthly
Volume: ~1 blanket PO release/month to office supply vendor
Owner: Admin Manager
Participants: Admin Manager, HQ staff, Procurement Specialist
Source: workflow W1673 — Office Supplies &amp; Administrative Procurement</bpmn:documentation>
      <bpmn:laneSet id="W1673_LaneSet3">
        <bpmn:lane id="W1673_Lane1" name="HQ Staff">
        <bpmn:flowNodeRef>W1673_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1673_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1673_Lane2" name="Admin Manager">
        <bpmn:flowNodeRef>W1673_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1673_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1673_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1673_Start4" name="Monthly replenishment cycle">
        <bpmn:outgoing>W1673_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1673_Task5" name="HQ departments submit monthly office supply requests to Admin Manager: (a)…">
        <bpmn:documentation>Step 1: HQ departments submit monthly office supply requests to Admin Manager: (a) paper, pens, folders, binders, (b) printer toner and cartridges, (c) pantry supplies (coffee, water, utensils), (d) meeting room supplies (whiteboard markers, projector bulbs)
Responsible (R): HQ Staff
Accountable (A): Admin Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W1673_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1673_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1673_Task6" name="Admin Manager consolidates requests; creates monthly blanket PO release from…">
        <bpmn:documentation>Step 2: Admin Manager consolidates requests; creates monthly blanket PO release from contracted office supply vendor
Responsible (R): Admin Manager
Accountable (A): Procurement Specialist
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1673_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1673_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1673_Task7" name="Vendor delivers to HQ; Admin Manager distributes to departments; tracks usage…">
        <bpmn:documentation>Step 3: Vendor delivers to HQ; Admin Manager distributes to departments; tracks usage against budget; controlled items — toner, projector bulbs, company-grade equipment below the capitalization threshold — are issued per requisition from the supplies storeroom custodian and counted quarterly: expensed in the books, accountable in custody
Responsible (R): Admin Manager
Accountable (A): —
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W1673_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1673_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1673_End8" name="Complete">
        <bpmn:incoming>W1673_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1673_Annotation9">
        <bpmn:text>Controls: - CTL-343 (ensure controlled execution — Non-Merchandise Procurement Operations (PA-34.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Admin Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1673_Assoc10" sourceRef="W1673_Annotation9" targetRef="W1673_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1673_Flow11" sourceRef="W1673_Start4" targetRef="W1673_Task5" />
      <bpmn:sequenceFlow id="W1673_Flow12" sourceRef="W1673_Task5" targetRef="W1673_Task6" />
      <bpmn:sequenceFlow id="W1673_Flow13" sourceRef="W1673_Task6" targetRef="W1673_Task7" />
      <bpmn:sequenceFlow id="W1673_Flow14" sourceRef="W1673_Task7" targetRef="W1673_End8" />
