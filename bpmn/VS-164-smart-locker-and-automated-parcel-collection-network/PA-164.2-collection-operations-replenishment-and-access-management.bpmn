        <bpmn:outgoing>W4805_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4805_Task4" name="Manage the customer pickup journey: ready-notification (app/SMS/email per…">
        <bpmn:documentation>Step 1: Manage the customer pickup journey: ready-notification (app/SMS/email per VS-75), access-code/QR delivery (W4802), in-app locker location/wayfinding (VS-14 signage), the pickup (open compartment → confirm), and the thank-you/cross-sell; track pickup-success and time-to-pickup
Responsible (R): CX / App team / Locker Platform
Accountable (A): Locker Program Manager / CX Lead
Duration: Per pickup</bpmn:documentation>
        <bpmn:incoming>W4805_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4805_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4805_Task5" name="Provide support for pickup friction: code-not-working, compartment-won&#x27;t-open…">
        <bpmn:documentation>Step 2: Provide support for pickup friction: code-not-working, compartment-won&#x27;t-open, wrong-item, item-damaged, lost-code — via app chat/call-center (VS-13.1 W258/W259) or an on-site help button → store-team assist or authenticated override (W4802); resolve within SLA (VS-13.1 W597)
Responsible (R): CX / Store Ops / IT
Accountable (A): Locker Program Manager / Store Manager
Duration: Per support event</bpmn:documentation>
        <bpmn:incoming>W4805_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4805_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4805_Task6" name="Capture the locker-channel CX feedback/NPS (VS-13), drive cross-sell during…">
        <bpmn:documentation>Step 3: Capture the locker-channel CX feedback/NPS (VS-13), drive cross-sell during pickup (basket link W4793), and feed recurring issues to improvement (VS-133) and analytics (W4815)
Responsible (R): CX / Analytics / Marketing
Accountable (A): Locker Program Manager / CX Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4805_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4805_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4805_End7" name="Complete">
        <bpmn:incoming>W4805_Flow13</bpmn:incoming>
      </bpmn:endEvent>
