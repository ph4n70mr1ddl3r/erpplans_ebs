    <bpmn:process id="W_W4806" name="W4806. Oversize / Bulky &amp; Refrigerated Locker Handling" isExecutable="false">
      <bpmn:documentation>Trigger: Bulky BOPIS order (lumber/tile/appliance per profile §6.2); refrigerated/sensitive item
Frequency: Per oversize/refrigerated order
Volume: ~20–30% of BOPIS orders (bulky items dominate BuildRight&#x27;s basket)
Owner: Locker Program Manager / Store Ops (VS-07)
Participants: Store Ops (VS-07), Facilities (VS-138), CX (VS-13)
Source: workflow W4806 — Oversize / Bulky &amp; Refrigerated Locker Handling</bpmn:documentation>
      <bpmn:laneSet id="W4806_LaneSet4">
        <bpmn:lane id="W4806_Lane1" name="OMS">
        <bpmn:flowNodeRef>W4806_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4806_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
