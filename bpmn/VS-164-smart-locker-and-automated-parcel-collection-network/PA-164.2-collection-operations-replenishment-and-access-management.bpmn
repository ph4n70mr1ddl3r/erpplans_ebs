<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-164.2-collection-operations-replenishment-and-access-management" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4801" name="W4801. BOPIS-to-Locker Staging, Compartment Assignment &amp; Replenishment" isExecutable="false">
      <bpmn:documentation>Trigger: BOPIS order ready (VS-10); locker compartment available
Frequency: Per order (continuous)
Volume: ~BOPIS-to-locker orders scaling with adoption (subset of ~42,900 BOPIS orders/month per profile §8.5)
Owner: Locker Program Manager / Store Ops (VS-07)
Participants: Ecommerce/OMS (VS-10), Stock Associate (VS-07), Store Ops (VS-07)
Source: workflow W4801 — BOPIS-to-Locker Staging, Compartment Assignment &amp; Replenishment</bpmn:documentation>
      <bpmn:laneSet id="W4801_LaneSet4">
        <bpmn:lane id="W4801_Lane1" name="OMS">
        <bpmn:flowNodeRef>W4801_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4801_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4801_Lane2" name="Stock Associate">
        <bpmn:flowNodeRef>W4801_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4801_Lane3" name="Store Ops">
        <bpmn:flowNodeRef>W4801_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4801_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4801_Start5" name="BOPIS order ready (VS-10); locker compartment available">
        <bpmn:outgoing>W4801_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4801_Task6" name="On BOPIS order ready (VS-10), route eligible orders to the locker channel (vs…">
        <bpmn:documentation>Step 1: On BOPIS order ready (VS-10), route eligible orders to the locker channel (vs counter pickup): select the right compartment size from the order&#x27;s item dimensions (W4796 mix), auto-assign an available compartment via the locker/OMS integration (W4807), and generate the pick task for the stock associate
Responsible (R): OMS / Locker Platform / Stock Associate
Accountable (A): Locker Program Manager
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W4801_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4801_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4801_Task7" name="Pick &amp; stage the order into the assigned compartment: scan items into the…">
        <bpmn:documentation>Step 2: Pick &amp; stage the order into the assigned compartment: scan items into the compartment, lock it, trigger the access-code/QR delivery to the customer (W4802) and the pickup-ready notification (W4805); manage the SLA (profile §8.2 BOPIS pick SLA 4 hrs)
Responsible (R): Stock Associate / OMS
Accountable (A): Store Manager
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W4801_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4801_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4801_Task8" name="Replenish &amp; rebalance compartments continuously: free compartments on pickup…">
        <bpmn:documentation>Step 3: Replenish &amp; rebalance compartments continuously: free compartments on pickup (W4805), re-assign overflow (W4804), and maintain availability for peak BOPIS windows; coordinate with the counter-pickup fallback when lockers are full
Responsible (R): Store Ops / Locker Platform
Accountable (A): Store Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4801_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4801_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4801_End9" name="Complete">
        <bpmn:incoming>W4801_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4801_Annotation10">
        <bpmn:text>Controls: - CTL-723 (ensure controlled execution — Collection Operations, Replenishment &amp; Access Management (PA-164.2).) | - CTL-723: compartment assigned by item dimensions; staging within BOPIS SLA; availability rebalanced
Owner: Locker Program Manager / Store Ops (VS-07)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4801_Assoc11" sourceRef="W4801_Annotation10" targetRef="W4801_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W4801_Flow12" sourceRef="W4801_Start5" targetRef="W4801_Task6" />
      <bpmn:sequenceFlow id="W4801_Flow13" sourceRef="W4801_Task6" targetRef="W4801_Task7" />
      <bpmn:sequenceFlow id="W4801_Flow14" sourceRef="W4801_Task7" targetRef="W4801_Task8" />
      <bpmn:sequenceFlow id="W4801_Flow15" sourceRef="W4801_Task8" targetRef="W4801_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4801_diag">
      <bpmndi:BPMNPlane id="W4801_plane" bpmnElement="W_W4801">
        <bpmndi:BPMNShape id="W4801_Lane1_di" bpmnElement="W4801_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4801_Lane2_di" bpmnElement="W4801_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4801_Lane3_di" bpmnElement="W4801_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4801_Task6_di" bpmnElement="W4801_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4801_Task7_di" bpmnElement="W4801_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4801_Task8_di" bpmnElement="W4801_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4801_Start5_di" bpmnElement="W4801_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4801_End9_di" bpmnElement="W4801_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
