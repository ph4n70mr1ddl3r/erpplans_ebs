      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4802" name="W4802. Access-Code/QR Generation, Delivery &amp; Pickup Authentication" isExecutable="false">
      <bpmn:documentation>Trigger: Order staged in a compartment (W4801); returns drop-off (W4803); 3P parcel (W4799)
Frequency: Per compartment event
Volume: ~every locker pickup/drop-off
Owner: Locker Program Manager / IT (VS-27) / Cyber (VS-27.3)
Participants: IT (VS-27), App (VS-75), Privacy (VS-91), Customer
Source: workflow W4802 — Access-Code/QR Generation, Delivery &amp; Pickup Authentication</bpmn:documentation>
      <bpmn:laneSet id="W4802_LaneSet2">
        <bpmn:lane id="W4802_Lane1" name="IT">
        <bpmn:flowNodeRef>W4802_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4802_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4802_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4802_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4802_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4802_Start3" name="Order staged in a compartment (W4801); returns drop-off (W4803); 3P parcel (W4799)">
        <bpmn:outgoing>W4802_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4802_Task4" name="Generate the secure access credential (time-limited PIN/QR via app VS-75, or…">
        <bpmn:documentation>Step 1: Generate the secure access credential (time-limited PIN/QR via app VS-75, or RFID/loyalty-card tap VS-13) tied to the specific compartment + order + customer; deliver via the app/SMS/email; ensure one-time/time-bound use and the customer-authentication binding (links VS-13/VS-126 single-customer-view)
Responsible (R): IT / App team / Locker Platform
Accountable (A): Locker Program Manager / CIO
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4802_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4802_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4802_Task5" name="Authenticate the pickup: customer scans/taps/PINs at the locker, the locker…">
        <bpmn:documentation>Step 2: Authenticate the pickup: customer scans/taps/PINs at the locker, the locker validates against the platform, opens the compartment, and confirms pickup → updates the OMS/inventory (VS-10/VS-05) and triggers the fulfillment-complete event; manage multi-method fallback if the primary method fails
Responsible (R): IT / Locker Platform / OMS
Accountable (A): Locker Program Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4802_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4802_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4802_Task6" name="Govern the security/privacy: prevent credential sharing/fraud (the wrong person…">
        <bpmn:documentation>Step 3: Govern the security/privacy: prevent credential sharing/fraud (the wrong person opening a compartment — links VS-125), secure the access data (VS-27.3), and the consent/data for the recipient (VS-91); handle lost/failed access via customer-service override (W4805) with authentication
Responsible (R): IT / Cyber / Privacy / CX
Accountable (A): Locker Program Manager / DPO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4802_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4802_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4802_End7" name="Complete">
        <bpmn:incoming>W4802_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4802_Annotation8">
        <bpmn:text>Controls: - CTL-723 (ensure controlled execution — Collection Operations, Replenishment &amp; Access Management (PA-164.2).) | - CTL-723: one-time/time-bound authenticated credentials; multi-method fallback; access data secured (VS-27.3/VS-91); override authenticated
Owner: Locker Program Manager / IT (VS-27) / Cyber (VS-27.3)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4802_Assoc9" sourceRef="W4802_Annotation8" targetRef="W4802_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4802_Flow10" sourceRef="W4802_Start3" targetRef="W4802_Task4" />
      <bpmn:sequenceFlow id="W4802_Flow11" sourceRef="W4802_Task4" targetRef="W4802_Task5" />
      <bpmn:sequenceFlow id="W4802_Flow12" sourceRef="W4802_Task5" targetRef="W4802_Task6" />
      <bpmn:sequenceFlow id="W4802_Flow13" sourceRef="W4802_Task6" targetRef="W4802_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4802_diag">
      <bpmndi:BPMNPlane id="W4802_plane" bpmnElement="W_W4802">
        <bpmndi:BPMNShape id="W4802_Lane1_di" bpmnElement="W4802_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4802_Task4_di" bpmnElement="W4802_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4802_Task5_di" bpmnElement="W4802_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4802_Task6_di" bpmnElement="W4802_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4802_Start3_di" bpmnElement="W4802_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4802_End7_di" bpmnElement="W4802_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4802_Annotation8_di" bpmnElement="W4802_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4802_Flow10_di" bpmnElement="W4802_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4802_Flow11_di" bpmnElement="W4802_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4802_Flow12_di" bpmnElement="W4802_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4802_Flow13_di" bpmnElement="W4802_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4802_Assoc9_di" bpmnElement="W4802_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4803" name="W4803. Returns Drop-Off via Locker &amp; Reverse-Logistics Handoff" isExecutable="false">
      <bpmn:documentation>Trigger: Customer initiates a locker return (VS-32); return-eligible item
Frequency: Per return
Volume: ~1,500–3,000 locker returns/month at maturity (subset of returns volume VS-32)
Owner: Locker Program Manager / Returns (VS-32)
Participants: Returns/Reverse-Logistics (VS-32), Store Ops (VS-07), CX (VS-13)
Source: workflow W4803 — Returns Drop-Off via Locker &amp; Reverse-Logistics Handoff</bpmn:documentation>
      <bpmn:laneSet id="W4803_LaneSet3">
        <bpmn:lane id="W4803_Lane1" name="Returns">
        <bpmn:flowNodeRef>W4803_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4803_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4803_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4803_Lane2" name="Stock Associate">
        <bpmn:flowNodeRef>W4803_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4803_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4803_Start4" name="Customer initiates a locker return (VS-32); return-eligible item">
        <bpmn:outgoing>W4803_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4803_Task5" name="On a customer-initiated locker return (online/app per VS-32), validate return…">
        <bpmn:documentation>Step 1: On a customer-initiated locker return (online/app per VS-32), validate return eligibility (item, condition, policy), assign a compartment, and generate the drop-off access credential (W4802) + return label/instructions; communicate the return window
Responsible (R): Returns / OMS / Locker Platform
Accountable (A): Locker Program Manager / Returns Lead
Duration: Per return</bpmn:documentation>
        <bpmn:incoming>W4803_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4803_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4803_Task6" name="Customer drops the item into the compartment; the locker confirms drop-off →…">
        <bpmn:documentation>Step 2: Customer drops the item into the compartment; the locker confirms drop-off → updates the return/OMS (VS-32), triggers refund/credit per policy, and creates the reverse-logistics pick task; manage the condition/contents verification when the item is retrieved
Responsible (R): Returns / Stock Associate / OMS
Accountable (A): Returns Lead
Duration: Per return</bpmn:documentation>
        <bpmn:incoming>W4803_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4803_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4803_Task7" name="Retrieve the returned item from the locker, verify contents/condition (vs the…">
        <bpmn:documentation>Step 3: Retrieve the returned item from the locker, verify contents/condition (vs the claimed return), and hand off to reverse-logistics (VS-32) for restock/RTV/refurbish/disposal; manage mismatch/fraud (empty box, wrong item — links VS-125)
Responsible (R): Stock Associate / Returns / LP
Accountable (A): Returns Lead / LP
Duration: Per return</bpmn:documentation>
        <bpmn:incoming>W4803_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4803_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4803_End8" name="Complete">
        <bpmn:incoming>W4803_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4803_Annotation9">
        <bpmn:text>Controls: - CTL-723 (ensure controlled execution — Collection Operations, Replenishment &amp; Access Management (PA-164.2).) | - CTL-723: eligibility validated; retrieve-then-verify sequencing; refund per policy after verification; mismatch investigated (VS-125)
Owner: Locker Program Manager / Returns (VS-32)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4803_Assoc10" sourceRef="W4803_Annotation9" targetRef="W4803_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4803_Flow11" sourceRef="W4803_Start4" targetRef="W4803_Task5" />
      <bpmn:sequenceFlow id="W4803_Flow12" sourceRef="W4803_Task5" targetRef="W4803_Task6" />
      <bpmn:sequenceFlow id="W4803_Flow13" sourceRef="W4803_Task6" targetRef="W4803_Task7" />
      <bpmn:sequenceFlow id="W4803_Flow14" sourceRef="W4803_Task7" targetRef="W4803_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4803_diag">
      <bpmndi:BPMNPlane id="W4803_plane" bpmnElement="W_W4803">
        <bpmndi:BPMNShape id="W4803_Lane1_di" bpmnElement="W4803_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4803_Lane2_di" bpmnElement="W4803_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4803_Task5_di" bpmnElement="W4803_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4803_Task6_di" bpmnElement="W4803_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4803_Task7_di" bpmnElement="W4803_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4803_Start4_di" bpmnElement="W4803_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4803_End8_di" bpmnElement="W4803_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4803_Annotation9_di" bpmnElement="W4803_Annotation9"><dc:Bounds x="160" y="460" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4803_Flow11_di" bpmnElement="W4803_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4803_Flow12_di" bpmnElement="W4803_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4803_Flow13_di" bpmnElement="W4803_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4803_Flow14_di" bpmnElement="W4803_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4803_Assoc10_di" bpmnElement="W4803_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4804" name="W4804. Overflow Management, Abandonment &amp; Compartment Reclaim" isExecutable="false">
      <bpmn:documentation>Trigger: Compartment hold-period expiry (profile §8.2 BOPIS hold 5 days); locker at capacity
Frequency: Per expiry + continuous capacity management
Volume: ~300–800 overflow/abandonment events/month at maturity (hold-expiry driven)
Owner: Locker Program Manager / Store Ops (VS-07)
Participants: Store Ops (VS-07), CX (VS-13), Returns (VS-32)
Source: workflow W4804 — Overflow Management, Abandonment &amp; Compartment Reclaim</bpmn:documentation>
      <bpmn:laneSet id="W4804_LaneSet4">
        <bpmn:lane id="W4804_Lane1" name="Locker Platform">
        <bpmn:flowNodeRef>W4804_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4804_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4804_Lane2" name="Stock Associate">
        <bpmn:flowNodeRef>W4804_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4804_Lane3" name="Locker Program">
        <bpmn:flowNodeRef>W4804_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4804_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4804_Start5" name="Compartment hold-period expiry (profile §8.2 BOPIS hold 5 days); locker at capacity">
        <bpmn:outgoing>W4804_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4804_Task6" name="Monitor compartment occupancy and the hold-period countdown; send reminders to…">
        <bpmn:documentation>Step 1: Monitor compartment occupancy and the hold-period countdown; send reminders to customers as the hold approaches expiry (profile §8.2 5-day hold → auto-cancel &amp; refund after); manage capacity alerts when a locker bank nears full
Responsible (R): Locker Platform / Store Ops / CX
Accountable (A): Locker Program Manager / Store Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4804_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4804_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4804_Task7" name="On expiry, reclaim the compartment: remove the uncollected order, process the…">
        <bpmn:documentation>Step 2: On expiry, reclaim the compartment: remove the uncollected order, process the auto-cancel &amp; refund per BOPIS policy (VS-10), and return the item to sellable stock or to the returns/disposition chain (VS-05.3/VS-32); free the compartment for new orders
Responsible (R): Stock Associate / OMS / Returns
Accountable (A): Store Manager
Duration: Per expiry</bpmn:documentation>
        <bpmn:incoming>W4804_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4804_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4804_Task8" name="Manage overflow: when a bank is at capacity, route new BOPIS to the counter…">
        <bpmn:documentation>Step 3: Manage overflow: when a bank is at capacity, route new BOPIS to the counter (VS-10) or an adjacent locker, manage 3P-parcel compartment priority (W4799), and tune compartment mix (W4795) to reduce future overflow; track abandonment rate as a KPI (W4815)
Responsible (R): Locker Program / Store Ops / OMS
Accountable (A): Locker Program Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4804_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4804_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4804_End9" name="Complete">
        <bpmn:incoming>W4804_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4804_Annotation10">
        <bpmn:text>Controls: - CTL-723 (ensure controlled execution — Collection Operations, Replenishment &amp; Access Management (PA-164.2).) | - CTL-723: hold-period enforced; reminders before expiry; reclaim-then-refund/restock; abandonment rate tracked
Owner: Locker Program Manager / Store Ops (VS-07)</bpmn:text>
      </bpmn:textAnnotation>
