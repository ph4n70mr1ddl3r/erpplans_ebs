<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-95.1-marketplace-platform-strategy-seller-onboarding" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3137" name="W3137. Marketplace Platform Strategy, Business Model &amp; Catalog Coverage" isExecutable="false">
      <bpmn:documentation>Trigger: Strategic planning cycle (links to VS-33); assortment gap analysis; competitive move
Frequency: Annual + event-driven
Volume: Enterprise-wide; target ~1,000–5,000 3P sellers and ~10K–50K 3P SKUs at maturity
Owner: Marketplace Director
Participants: Marketplace Director, GM, Digital Commerce Inc. (links to VS-10), Category (links to VS-01), Finance, Legal, IT
Source: workflow W3137 — Marketplace Platform Strategy, Business Model &amp; Catalog Coverage</bpmn:documentation>
      <bpmn:laneSet id="W3137_LaneSet3">
        <bpmn:lane id="W3137_Lane1" name="Marketplace Director">
        <bpmn:flowNodeRef>W3137_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3137_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3137_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3137_Lane2" name="GM, Digital Commerce Inc.">
        <bpmn:flowNodeRef>W3137_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3137_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3137_Start4" name="Strategic planning cycle (links to VS-33); assortment gap analysis; competitive move">
        <bpmn:outgoing>W3137_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3137_Task5" name="Marketplace Director/Category (links to VS-01) identify assortment gaps that 3P…">
        <bpmn:documentation>Step 1: Marketplace Director/Category (links to VS-01) identify assortment gaps that 3P fills: niche/specialty, regional brands, vendor direct-ship, refurbished (links to VS-09 trade-in), long-tail SKUs; size opportunity (incremental GMV, customer acquisition, take-rate revenue)
Responsible (R): Marketplace Director / Category
Accountable (A): GM, Digital Commerce Inc.
Duration: 3–4 weeks</bpmn:documentation>
        <bpmn:incoming>W3137_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3137_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3137_Task6" name="Define business model: open marketplace vs. curated; commission % by category…">
        <bpmn:documentation>Step 2: Define business model: open marketplace vs. curated; commission % by category; fulfillment options (seller-fulfilled vs. BuildRight fulfillment / Fulfilled by BuildRight — links to VS-93); buyer protection fund; advertising integration (links to VS-48)
Responsible (R): Marketplace Director / Finance
Accountable (A): GM, Digital Commerce Inc.
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W3137_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3137_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3137_Task7" name="Steering committee approves strategy, capex (links to VS-40), 24-month P&amp;L, and…">
        <bpmn:documentation>Step 3: Steering committee approves strategy, capex (links to VS-40), 24-month P&amp;L, and launch phasing; integrate to VS-33 strategic plan and VS-30 innovation pipeline
Responsible (R): GM, Digital Commerce Inc. / CFO
Accountable (A): CEO
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W3137_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3137_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3137_End8" name="Complete">
        <bpmn:incoming>W3137_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3137_Annotation9">
        <bpmn:text>Controls: - CTL-514 (ensure controlled execution — Marketplace Platform Strategy &amp; Seller Onboarding (PA-95.1).) | - operational: category-level 1P/3P rules and buy-box logic (W3146)
Owner: Marketplace Director</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3137_Assoc10" sourceRef="W3137_Annotation9" targetRef="W3137_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3137_Flow11" sourceRef="W3137_Start4" targetRef="W3137_Task5" />
      <bpmn:sequenceFlow id="W3137_Flow12" sourceRef="W3137_Task5" targetRef="W3137_Task6" />
      <bpmn:sequenceFlow id="W3137_Flow13" sourceRef="W3137_Task6" targetRef="W3137_Task7" />
      <bpmn:sequenceFlow id="W3137_Flow14" sourceRef="W3137_Task7" targetRef="W3137_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3137_diag">
      <bpmndi:BPMNPlane id="W3137_plane" bpmnElement="W_W3137">
        <bpmndi:BPMNShape id="W3137_Lane1_di" bpmnElement="W3137_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3137_Lane2_di" bpmnElement="W3137_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
