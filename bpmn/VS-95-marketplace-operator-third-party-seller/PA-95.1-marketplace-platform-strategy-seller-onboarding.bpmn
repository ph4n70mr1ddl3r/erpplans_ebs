      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3139" name="W3139. Seller Onboarding, Contracting &amp; KYB" isExecutable="false">
      <bpmn:documentation>Trigger: Seller approved (W3138)
Frequency: Per onboarding
Volume: Per seller
Owner: Marketplace Manager
Participants: Marketplace Mgr, Seller Operations, Legal, Finance, IT, Seller
Source: workflow W3139 — Seller Onboarding, Contracting &amp; KYB</bpmn:documentation>
      <bpmn:laneSet id="W3139_LaneSet4">
        <bpmn:lane id="W3139_Lane1" name="Legal Counsel">
        <bpmn:flowNodeRef>W3139_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3139_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3139_Lane2" name="Finance Analyst">
        <bpmn:flowNodeRef>W3139_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3139_Lane3" name="IT">
        <bpmn:flowNodeRef>W3139_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3139_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3139_Start5" name="Seller approved (W3138)">
        <bpmn:outgoing>W3139_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3139_Task6" name="Legal/Seller Operations execute marketplace seller agreement: commission/fees…">
        <bpmn:documentation>Step 1: Legal/Seller Operations execute marketplace seller agreement: commission/fees (W3141), fulfillment SLA, returns policy, IP/anti-counterfeit obligations, data terms (links to VS-91), termination, audit rights, jurisdiction
Responsible (R): Legal Counsel / Seller Operations
Accountable (A): VP Legal &amp; Compliance
Duration: Per onboarding</bpmn:documentation>
        <bpmn:incoming>W3139_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3139_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3139_Task7" name="Finance complete Know-Your-Business (KYB): business docs, beneficial ownership…">
        <bpmn:documentation>Step 2: Finance complete Know-Your-Business (KYB): business docs, beneficial ownership, bank account verification, VAT status (links to VS-79), payout account setup; integrate to AP/payout (links to VS-15/VS-18)
Responsible (R): Finance Analyst
Accountable (A): Finance Manager
Duration: Per onboarding</bpmn:documentation>
        <bpmn:incoming>W3139_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3139_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3139_Task8" name="IT/Seller Operations provision seller account: marketplace seller portal…">
        <bpmn:documentation>Step 3: IT/Seller Operations provision seller account: marketplace seller portal credentials, catalog API or manual listing tool, order management access, settlement/payout view, training materials (W3142)
Responsible (R): IT / Seller Operations
Accountable (A): Marketplace Manager
Duration: Per onboarding</bpmn:documentation>
        <bpmn:incoming>W3139_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3139_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3139_End9" name="Complete">
        <bpmn:incoming>W3139_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3139_Annotation10">
        <bpmn:text>Controls: - CTL-514 (ensure controlled execution — Marketplace Platform Strategy &amp; Seller Onboarding (PA-95.1).) | - operational: KYB, beneficial-ownership screening (links to VS-86), and holdback reserve (W3153)
Owner: Marketplace Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3139_Assoc11" sourceRef="W3139_Annotation10" targetRef="W3139_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3139_Flow12" sourceRef="W3139_Start5" targetRef="W3139_Task6" />
      <bpmn:sequenceFlow id="W3139_Flow13" sourceRef="W3139_Task6" targetRef="W3139_Task7" />
      <bpmn:sequenceFlow id="W3139_Flow14" sourceRef="W3139_Task7" targetRef="W3139_Task8" />
      <bpmn:sequenceFlow id="W3139_Flow15" sourceRef="W3139_Task8" targetRef="W3139_End9" />
    </bpmn:process>
