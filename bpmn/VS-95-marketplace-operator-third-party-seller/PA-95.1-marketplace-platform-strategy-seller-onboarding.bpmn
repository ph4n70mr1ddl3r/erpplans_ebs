        </bpmn:lane>
        <bpmn:lane id="W3144_Lane3" name="CS">
        <bpmn:flowNodeRef>W3144_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3144_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3144_Start5" name="Seller request; performance termination (links to W3156); seller bankruptcy; contract…">
        <bpmn:outgoing>W3144_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3144_Task6" name="Marketplace Mgr documents offboarding rationale (voluntary exit, performance…">
        <bpmn:documentation>Step 1: Marketplace Mgr documents offboarding rationale (voluntary exit, performance, policy violation, bankruptcy); for performance/policy, follows termination process per contract (cure period, written notice)
Responsible (R): Marketplace Mgr / Legal
Accountable (A): Marketplace Manager
Duration: Per exit</bpmn:documentation>
        <bpmn:incoming>W3144_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3144_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3144_Task7" name="IT/Seller Operations execute offboarding: delist SKUs (preserve active orders…">
        <bpmn:documentation>Step 2: IT/Seller Operations execute offboarding: delist SKUs (preserve active orders for fulfillment), wind down open POs/payouts, settle final payout net of fees/returns/claims (W3153), return seller data per data-portability right (links to VS-91)
Responsible (R): IT / Seller Operations / Finance
Accountable (A): Marketplace Manager
Duration: Per exit</bpmn:documentation>
        <bpmn:incoming>W3144_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3144_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3144_Task8" name="CS (links to VS-13) manage customer impact: notify buyers of any unfulfilled…">
        <bpmn:documentation>Step 3: CS (links to VS-13) manage customer impact: notify buyers of any unfulfilled orders, process refunds (links to VS-80), alternative-product suggestions; preserve records for warranty/returns (links to VS-53/VS-32) and audit (links to VS-88)
Responsible (R): CS / Finance
Accountable (A): Marketplace Manager
Duration: Per exit</bpmn:documentation>
        <bpmn:incoming>W3144_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3144_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3144_End9" name="Complete">
        <bpmn:incoming>W3144_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3144_Annotation10">
        <bpmn:text>Controls: - CTL-514 (ensure controlled execution — Marketplace Platform Strategy &amp; Seller Onboarding (PA-95.1).) | - operational: Fulfill-by-BuildRight backstop and buyer-protection fund (W3158)
Owner: Marketplace Manager</bpmn:text>
      </bpmn:textAnnotation>
