      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3140" name="W3140. Seller Catalog Integration, Mapping &amp; Listing Quality" isExecutable="false">
      <bpmn:documentation>Trigger: New seller onboarded; new SKU; catalog refresh
Frequency: Per SKU + periodic refresh
Volume: ~10K–50K 3P SKUs at maturity
Owner: Marketplace Manager
Participants: Marketplace Mgr, Seller Operations, Catalog Ops (links to VS-01/VS-10), Quality
Source: workflow W3140 — Seller Catalog Integration, Mapping &amp; Listing Quality</bpmn:documentation>
      <bpmn:laneSet id="W3140_LaneSet4">
        <bpmn:lane id="W3140_Lane1" name="Seller">
        <bpmn:flowNodeRef>W3140_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3140_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3140_Lane2" name="Catalog Ops">
        <bpmn:flowNodeRef>W3140_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3140_Lane3" name="System">
        <bpmn:flowNodeRef>W3140_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3140_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3140_Start5" name="New seller onboarded; new SKU; catalog refresh">
        <bpmn:outgoing>W3140_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3140_Task6" name="Seller submits catalog via API (bulk), spreadsheet, or manual portal entry; map…">
        <bpmn:documentation>Step 1: Seller submits catalog via API (bulk), spreadsheet, or manual portal entry; map to BuildRight product taxonomy (links to VS-01); match to existing SKU record where overlapping 1P offer (links to W3146 buy-box)
Responsible (R): Seller / Catalog Ops
Accountable (A): Marketplace Manager
Duration: Per catalog</bpmn:documentation>
        <bpmn:incoming>W3140_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3140_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3140_Task7" name="Catalog Ops/QA enforce listing quality: required attributes (title, image…">
        <bpmn:documentation>Step 2: Catalog Ops/QA enforce listing quality: required attributes (title, image, spec, dimensions, hazmat flag — links to VS-24), BIR-compliant invoice description (links to VS-79), keyword SEO, image standards; reject non-compliant listings
Responsible (R): Catalog Ops / QA
Accountable (A): Marketplace Manager
Duration: Per SKU batch</bpmn:documentation>
        <bpmn:incoming>W3140_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3140_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W3140_Task8" name="System computes listing completeness/quality score; surfaced in search ranking…">
        <bpmn:documentation>Step 3: System computes listing completeness/quality score; surfaced in search ranking (links to W3145) and seller scorecard (links to W3154); continuous monitoring for drift/changes
Responsible (R): System
Accountable (A): Marketplace Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3140_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3140_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
