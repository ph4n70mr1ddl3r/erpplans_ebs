        <bpmndi:BPMNEdge id="W3137_Flow14_di" bpmnElement="W3137_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3137_Assoc10_di" bpmnElement="W3137_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3138" name="W3138. Third-Party Seller Recruitment &amp; Vetting" isExecutable="false">
      <bpmn:documentation>Trigger: Category gap (W3137); seller application; vendor-direct conversion (links to VS-03)
Frequency: Continuous
Volume: ~50–200 seller applications/month; ~10–30% approved
Owner: Marketplace Manager
Participants: Marketplace Mgr, Seller Operations, Legal, Finance, Quality, Brand Protection (links to VS-71)
Source: workflow W3138 — Third-Party Seller Recruitment &amp; Vetting</bpmn:documentation>
      <bpmn:laneSet id="W3138_LaneSet4">
        <bpmn:lane id="W3138_Lane1" name="Seller Operations">
        <bpmn:flowNodeRef>W3138_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3138_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3138_Lane2" name="Marketplace Mgr">
        <bpmn:flowNodeRef>W3138_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3138_Lane3" name="Quality">
        <bpmn:flowNodeRef>W3138_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3138_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3138_Start5" name="Category gap (W3137); seller application; vendor-direct conversion (links to VS-03)">
        <bpmn:outgoing>W3138_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3138_Task6" name="Seller Operations recruits through: open application, vendor-direct conversion…">
        <bpmn:documentation>Step 1: Seller Operations recruits through: open application, vendor-direct conversion (links to VS-03), category-targeted outreach, brand outreach, distributor referrals; capture seller profile, categories, catalog size, fulfillment capability
Responsible (R): Seller Operations
Accountable (A): Marketplace Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3138_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3138_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3138_Task7" name="Marketplace Mgr/Legal vet seller: business registration (SEC/DTI), tax…">
        <bpmn:documentation>Step 2: Marketplace Mgr/Legal vet seller: business registration (SEC/DTI), tax compliance (BIR — links to VS-79), beneficial ownership &amp; sanctions screening (links to VS-86), brand authorization/IP (links to VS-71 anti-counterfeit), product safety history (links to VS-89), references
Responsible (R): Marketplace Mgr / Legal
Accountable (A): Marketplace Manager
Duration: Per application (3–5 days)</bpmn:documentation>
        <bpmn:incoming>W3138_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3138_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3138_Task8" name="Quality/Brand Protection validate sample products: authenticity (links to…">
        <bpmn:documentation>Step 3: Quality/Brand Protection validate sample products: authenticity (links to VS-71), product safety (links to VS-31/VS-89), spec match; Marketplace Mgr approves/rejects/defers with documented rationale
Responsible (R): Quality / Brand Protection
Accountable (A): Marketplace Manager
Duration: Per application</bpmn:documentation>
        <bpmn:incoming>W3138_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3138_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3138_End9" name="Complete">
        <bpmn:incoming>W3138_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3138_Annotation10">
        <bpmn:text>Controls: - CTL-514 (ensure controlled execution — Marketplace Platform Strategy &amp; Seller Onboarding (PA-95.1).) | - operational: KYB, brand-authorization check, and ongoing monitoring (W3156)
Owner: Marketplace Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3138_Assoc11" sourceRef="W3138_Annotation10" targetRef="W3138_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3138_Flow12" sourceRef="W3138_Start5" targetRef="W3138_Task6" />
      <bpmn:sequenceFlow id="W3138_Flow13" sourceRef="W3138_Task6" targetRef="W3138_Task7" />
      <bpmn:sequenceFlow id="W3138_Flow14" sourceRef="W3138_Task7" targetRef="W3138_Task8" />
      <bpmn:sequenceFlow id="W3138_Flow15" sourceRef="W3138_Task8" targetRef="W3138_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3138_diag">
      <bpmndi:BPMNPlane id="W3138_plane" bpmnElement="W_W3138">
        <bpmndi:BPMNShape id="W3138_Lane1_di" bpmnElement="W3138_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
