      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3746" name="W3746. Investment-Grade Energy Audit &amp; ECM Identification" isExecutable="false">
      <bpmn:documentation>Trigger: ECM pipeline need; major system replacement; conservation plan (W3748)
Frequency: Per major site/project
Volume: Investment-grade audits per priority site
Owner: EEO / Facilities
Participants: EEO, Facilities (links to VS-20.3), Energy Consultant/Auditor, Store Ops (links to VS-07), DC Ops (links to VS-04), Finance (links to VS-17.4), Sustainability (links to VS-25), PMO (links to VS-112)
Source: workflow W3746 — Investment-Grade Energy Audit &amp; ECM Identification</bpmn:documentation>
      <bpmn:laneSet id="W3746_LaneSet2">
        <bpmn:lane id="W3746_Lane1" name="EEO">
        <bpmn:flowNodeRef>W3746_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3746_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3746_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3746_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3746_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3746_Start3" name="ECM pipeline need; major system replacement; conservation plan (W3748)">
        <bpmn:outgoing>W3746_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3746_Task4" name="EEO/Facilities/Energy Consultant conduct investment-grade energy audits (IGA)…">
        <bpmn:documentation>Step 1: EEO/Facilities/Energy Consultant conduct investment-grade energy audits (IGA) beyond the statutory minimum: detailed analysis of significant energy uses (HVAC, refrigeration, lighting, process), identify and quantify ECMs (savings, cost, payback, GHG), and develop the ECM register per site
Responsible (R): EEO / Facilities / Energy Consultant
Accountable (A): EEO
Duration: Per site</bpmn:documentation>
        <bpmn:incoming>W3746_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3746_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3746_Task5" name="EEO/Facilities evaluate ECMs: technical feasibility, interaction/sequence…">
        <bpmn:documentation>Step 2: EEO/Facilities evaluate ECMs: technical feasibility, interaction/sequence, risk, and the prioritized ECM pipeline; integrate with facility-renewal/store-remodel plans (links to VS-20.3/VS-109) to bundle energy work into capital projects
Responsible (R): EEO / Facilities / Store Ops
Accountable (A): EEO
Duration: Per site</bpmn:documentation>
        <bpmn:incoming>W3746_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3746_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3746_Task6" name="EEO/Sustainability feed the ECM pipeline to business-case/investment governance…">
        <bpmn:documentation>Step 3: EEO/Sustainability feed the ECM pipeline to business-case/investment governance (W3749) and the conservation plan (W3748); track ECMs from identification to delivery (W3753) and verify savings (W3747)
Responsible (R): EEO / Sustainability / PMO
Accountable (A): EEO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3746_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3746_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3746_End7" name="Complete">
        <bpmn:incoming>W3746_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3746_Annotation8">
        <bpmn:text>Controls: - CTL-138 (ensure RA 11285 energy compliance &amp; M&amp;V integrity.) | - operational: investment-grade depth; operational: remodel integration
Owner: EEO / Facilities</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3746_Assoc9" sourceRef="W3746_Annotation8" targetRef="W3746_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3746_Flow10" sourceRef="W3746_Start3" targetRef="W3746_Task4" />
      <bpmn:sequenceFlow id="W3746_Flow11" sourceRef="W3746_Task4" targetRef="W3746_Task5" />
      <bpmn:sequenceFlow id="W3746_Flow12" sourceRef="W3746_Task5" targetRef="W3746_Task6" />
      <bpmn:sequenceFlow id="W3746_Flow13" sourceRef="W3746_Task6" targetRef="W3746_End7" />
    </bpmn:process>
