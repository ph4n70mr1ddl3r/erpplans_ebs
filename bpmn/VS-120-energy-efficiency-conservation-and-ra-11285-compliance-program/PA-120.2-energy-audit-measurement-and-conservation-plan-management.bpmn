      <bpmndi:BPMNPlane id="W3746_plane" bpmnElement="W_W3746">
        <bpmndi:BPMNShape id="W3746_Lane1_di" bpmnElement="W3746_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
