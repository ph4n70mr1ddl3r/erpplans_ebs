      <bpmn:sequenceFlow id="W3747_Flow11" sourceRef="W3747_Task4" targetRef="W3747_Task5" />
      <bpmn:sequenceFlow id="W3747_Flow12" sourceRef="W3747_Task5" targetRef="W3747_Task6" />
      <bpmn:sequenceFlow id="W3747_Flow13" sourceRef="W3747_Task6" targetRef="W3747_End7" />
    </bpmn:process>
