    <bpmn:process id="W_W3745" name="W3745. Mandatory Energy Audit &amp; Audit-Firm Management" isExecutable="false">
      <bpmn:documentation>Trigger: RA 11285 audit cycle (Type-1 every 3 yrs; Type-2 annually for largest consumers); designation (W3738)
Frequency: Per audit cycle
Volume: Per designated site/entity
Owner: EEO / Facilities
Participants: EEO, Facilities (links to VS-20.3), DOE-accredited Energy Auditor/Firm, Compliance (links to VS-22), Sustainability (links to VS-25), Procurement (links to VS-34), Records (links to VS-88)
Source: workflow W3745 — Mandatory Energy Audit &amp; Audit-Firm Management</bpmn:documentation>
      <bpmn:laneSet id="W3745_LaneSet2">
        <bpmn:lane id="W3745_Lane1" name="EEO">
        <bpmn:flowNodeRef>W3745_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3745_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3745_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3745_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3745_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3745_Start3" name="RA 11285 audit cycle (Type-1 every 3 yrs; Type-2 annually for largest consumers)…">
        <bpmn:outgoing>W3745_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3745_Task4" name="EEO/Facilities/Procurement plan and source the mandatory energy audit: schedule…">
        <bpmn:documentation>Step 1: EEO/Facilities/Procurement plan and source the mandatory energy audit: schedule per RA 11285 cycle per designated site/entity, select a DOE-accredited energy auditor/firm, scope the audit (Type-1 walk-through / Type-2 detailed), and contract (links to VS-34)
Responsible (R): EEO / Facilities / Procurement
Accountable (A): EEO
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W3745_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3745_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3745_Task5" name="EEO/Facilities support the energy audit: provide consumption data (links to…">
        <bpmn:documentation>Step 2: EEO/Facilities support the energy audit: provide consumption data (links to W3741), facility access, system documentation, and operational context; coordinate with store/DC teams (links to VS-07/VS-04); manage audit findings
Responsible (R): EEO / Facilities / Store Ops
Accountable (A): EEO
Duration: Per audit</bpmn:documentation>
        <bpmn:incoming>W3745_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3745_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3745_Task6" name="EEO/Compliance submit the audit report and certification to DOE per the IRR…">
        <bpmn:documentation>Step 3: EEO/Compliance submit the audit report and certification to DOE per the IRR, manage any DOE follow-up, archive to records (links to VS-88/W3744), and feed findings/ECMs to the conservation plan (W3748) and ECM pipeline (W3749)
Responsible (R): EEO / Compliance / Records
Accountable (A): EEO
Duration: Per audit</bpmn:documentation>
        <bpmn:incoming>W3745_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3745_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3745_End7" name="Complete">
        <bpmn:incoming>W3745_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3745_Annotation8">
        <bpmn:text>Controls: - CTL-138 (ensure RA 11285 energy compliance &amp; M&amp;V integrity.) | - operational: cycle tracking (W3738); operational: audit not conducted within the cycle → DOE non-compliance; operational: DOE-accreditation and scope
Owner: EEO / Facilities</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3745_Assoc9" sourceRef="W3745_Annotation8" targetRef="W3745_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3745_Flow10" sourceRef="W3745_Start3" targetRef="W3745_Task4" />
      <bpmn:sequenceFlow id="W3745_Flow11" sourceRef="W3745_Task4" targetRef="W3745_Task5" />
      <bpmn:sequenceFlow id="W3745_Flow12" sourceRef="W3745_Task5" targetRef="W3745_Task6" />
      <bpmn:sequenceFlow id="W3745_Flow13" sourceRef="W3745_Task6" targetRef="W3745_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3745_diag">
      <bpmndi:BPMNPlane id="W3745_plane" bpmnElement="W_W3745">
        <bpmndi:BPMNShape id="W3745_Lane1_di" bpmnElement="W3745_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
