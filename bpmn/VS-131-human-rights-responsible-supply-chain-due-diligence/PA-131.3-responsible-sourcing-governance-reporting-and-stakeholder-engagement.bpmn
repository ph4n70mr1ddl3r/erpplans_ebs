      <bpmn:sequenceFlow id="W4019_Flow11" sourceRef="W4019_Task4" targetRef="W4019_Task5" />
      <bpmn:sequenceFlow id="W4019_Flow12" sourceRef="W4019_Task5" targetRef="W4019_Task6" />
      <bpmn:sequenceFlow id="W4019_Flow13" sourceRef="W4019_Task6" targetRef="W4019_End7" />
    </bpmn:process>
