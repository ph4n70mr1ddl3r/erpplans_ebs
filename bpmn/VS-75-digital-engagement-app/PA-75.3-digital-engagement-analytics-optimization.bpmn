      <bpmn:sequenceFlow id="W2664_Flow12" sourceRef="W2664_Task5" targetRef="W2664_Task6" />
      <bpmn:sequenceFlow id="W2664_Flow13" sourceRef="W2664_Task6" targetRef="W2664_Task7" />
      <bpmn:sequenceFlow id="W2664_Flow14" sourceRef="W2664_Task7" targetRef="W2664_End8" />
    </bpmn:process>
