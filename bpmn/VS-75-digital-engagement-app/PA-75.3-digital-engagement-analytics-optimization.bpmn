      <bpmn:startEvent id="W2669_Start4" name="Annual strategy cycle">
        <bpmn:outgoing>W2669_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2669_Task5" name="CIO and CMO prepare review: performance YoY, digital revenue growth, adoption…">
        <bpmn:documentation>Step 1: CIO and CMO prepare review: performance YoY, digital revenue growth, adoption metrics, tech debt, competitive benchmarking, emerging tech (AR/VR, voice, AI shopping)
Responsible (R): CIO / CMO / Digital Product Manager
Accountable (A): CEO
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W2669_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2669_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2669_Task6" name="Cross-functional review: evaluate ROI, approve roadmap, set targets, allocate…">
        <bpmn:documentation>Step 2: Cross-functional review: evaluate ROI, approve roadmap, set targets, allocate resources, determine platform investments
Responsible (R): CEO / CFO / CIO / CMO
Accountable (A): Board
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2669_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2669_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2669_Task7" name="CIO develops implementation plan: quarterly releases, infrastructure upgrades…">
        <bpmn:documentation>Step 3: CIO develops implementation plan: quarterly releases, infrastructure upgrades, staffing, vendor selection, budget; CMO develops adoption plan; combined to CEO for approval
Responsible (R): CIO / CMO
Accountable (A): CEO
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W2669_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2669_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2669_End8" name="Complete">
        <bpmn:incoming>W2669_Flow14</bpmn:incoming>
      </bpmn:endEvent>
