<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-75.3-digital-engagement-analytics-optimization" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2662" name="W2662. Digital Channel Attribution &amp; Customer Journey Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly analytics cycle
Frequency: Monthly
Volume: ~300K app users + ~5M web visits/month
Owner: Digital Analytics Manager
Participants: Digital Analytics Manager, Marketing, CMO, CFO
Source: workflow W2662 — Digital Channel Attribution &amp; Customer Journey Analytics</bpmn:documentation>
      <bpmn:laneSet id="W2662_LaneSet3">
        <bpmn:lane id="W2662_Lane1" name="Digital Analytics Manager">
        <bpmn:flowNodeRef>W2662_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2662_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2662_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2662_Lane2" name="CFO">
        <bpmn:flowNodeRef>W2662_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2662_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2662_Start4" name="Monthly analytics cycle">
        <bpmn:outgoing>W2662_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2662_Task5" name="Digital Analytics Manager maps customer journey: web → app → in-store → BOPIS…">
        <bpmn:documentation>Step 1: Digital Analytics Manager maps customer journey: web → app → in-store → BOPIS; tracks cross-channel attribution; builds unified customer view
Responsible (R): Digital Analytics Manager
Accountable (A): CMO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2662_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2662_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2662_Task6" name="Manager analyzes attribution: app-driven in-store sales, web-to-store…">
        <bpmn:documentation>Step 2: Manager analyzes attribution: app-driven in-store sales, web-to-store conversion, digital promo redemption, notification influence on purchase
Responsible (R): Digital Analytics Manager
Accountable (A): CMO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2662_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2662_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2662_Task7" name="CFO reviews digital ROI: acquisition cost per channel, lifetime value per…">
        <bpmn:documentation>Step 3: CFO reviews digital ROI: acquisition cost per channel, lifetime value per digital vs. non-digital customer, marketing spend effectiveness; adjusts investment allocation
Responsible (R): CFO / Digital Analytics Manager
Accountable (A): CEO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2662_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2662_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2662_End8" name="Complete">
        <bpmn:incoming>W2662_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2662_Annotation9">
        <bpmn:text>Controls: - CTL-456 (ensure controlled execution — Digital Engagement Analytics &amp; Optimization (PA-75.3).) | - CTL-456 (data-privacy — links to VS-91 / W53, RA 10173); Operational: Digital Analytics Manager sign-off on the workflow output
Owner: Digital Analytics Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2662_Assoc10" sourceRef="W2662_Annotation9" targetRef="W2662_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2662_Flow11" sourceRef="W2662_Start4" targetRef="W2662_Task5" />
      <bpmn:sequenceFlow id="W2662_Flow12" sourceRef="W2662_Task5" targetRef="W2662_Task6" />
      <bpmn:sequenceFlow id="W2662_Flow13" sourceRef="W2662_Task6" targetRef="W2662_Task7" />
      <bpmn:sequenceFlow id="W2662_Flow14" sourceRef="W2662_Task7" targetRef="W2662_End8" />
    </bpmn:process>
