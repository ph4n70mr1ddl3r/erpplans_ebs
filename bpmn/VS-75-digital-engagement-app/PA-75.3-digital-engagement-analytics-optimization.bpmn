    <bpmn:process id="W_W2664" name="W2664. In-Store Digital Feature Usage Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly analytics
Frequency: Monthly
Volume: ~50K–100K in-store digital interactions/month
Owner: Digital Product Manager
Participants: Digital Product Mgr, Store Ops VP, CMO
Source: workflow W2664 — In-Store Digital Feature Usage Analytics</bpmn:documentation>
      <bpmn:laneSet id="W2664_LaneSet3">
        <bpmn:lane id="W2664_Lane1" name="Digital Product Manager">
        <bpmn:flowNodeRef>W2664_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2664_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2664_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2664_Lane2" name="VP Store Operations">
        <bpmn:flowNodeRef>W2664_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2664_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2664_Start4" name="Monthly analytics">
        <bpmn:outgoing>W2664_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2664_Task5" name="Product Manager compiles in-store digital usage: QR scans, kiosk interactions…">
        <bpmn:documentation>Step 1: Product Manager compiles in-store digital usage: QR scans, kiosk interactions, self-checkout volume, in-store mode activations, digital receipt opt-in, associate app usage
Responsible (R): Digital Product Manager
Accountable (A): CMO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2664_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2664_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2664_Task6" name="Manager correlates with store performance: high QR scans → higher basket?…">
        <bpmn:documentation>Step 2: Manager correlates with store performance: high QR scans → higher basket? Self-checkout → satisfaction? Digital adoption vs. sales growth
Responsible (R): Digital Product Manager / Digital Analytics Manager
Accountable (A): CMO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2664_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2664_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2664_Task7" name="VP Store Operations reviews: identifies stores needing promotion, reallocates…">
        <bpmn:documentation>Step 3: VP Store Operations reviews: identifies stores needing promotion, reallocates kiosks, expands self-checkout; reports to COO quarterly
Responsible (R): VP Store Operations / Digital Product Manager
Accountable (A): COO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2664_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2664_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2664_End8" name="Complete">
        <bpmn:incoming>W2664_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2664_Annotation9">
        <bpmn:text>Controls: - CTL-456 (ensure controlled execution — Digital Engagement Analytics &amp; Optimization (PA-75.3).) | - operational: Digital Product Manager sign-off on the workflow output
Owner: Digital Product Manager</bpmn:text>
      </bpmn:textAnnotation>
