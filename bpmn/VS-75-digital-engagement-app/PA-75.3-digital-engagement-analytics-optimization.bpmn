    <bpmn:process id="W_W2663" name="W2663. App User Acquisition &amp; Retention Funnel Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly analytics
Frequency: Monthly
Volume: ~300K MAU; ~20K–30K downloads/month
Owner: Digital Product Manager
Participants: Digital Product Mgr, Marketing, Digital Analytics Manager
Source: workflow W2663 — App User Acquisition &amp; Retention Funnel Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2663_LaneSet3">
        <bpmn:lane id="W2663_Lane1" name="Digital Product Manager">
        <bpmn:flowNodeRef>W2663_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2663_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2663_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2663_Lane2" name="Marketing">
        <bpmn:flowNodeRef>W2663_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2663_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2663_Start4" name="Monthly analytics">
        <bpmn:outgoing>W2663_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2663_Task5" name="Product Manager analyzes acquisition funnel: impressions → downloads →…">
        <bpmn:documentation>Step 1: Product Manager analyzes acquisition funnel: impressions → downloads → registrations → first purchase → repeat; calculates CPI and CPA per channel
Responsible (R): Digital Product Manager
Accountable (A): CIO / CMO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2663_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2663_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2663_Task6" name="Manager analyzes retention: Day 1/7/30 rates; compares by source, segment…">
        <bpmn:documentation>Step 2: Manager analyzes retention: Day 1/7/30 rates; compares by source, segment, feature usage; identifies churn signals
Responsible (R): Digital Product Manager / Digital Analytics Manager
Accountable (A): CMO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2663_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2663_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2663_Task7" name="Marketing implements retention campaigns: re-engagement push, personalized…">
        <bpmn:documentation>Step 3: Marketing implements retention campaigns: re-engagement push, personalized recommendations, app-only offers, points acceleration; Product Manager measures impact
Responsible (R): Marketing / Digital Product Manager
Accountable (A): CMO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2663_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2663_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2663_End8" name="Complete">
        <bpmn:incoming>W2663_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2663_Annotation9">
        <bpmn:text>Controls: - CTL-456 (ensure controlled execution — Digital Engagement Analytics &amp; Optimization (PA-75.3).) | - operational: Digital Product Manager sign-off on the workflow output
Owner: Digital Product Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2663_Assoc10" sourceRef="W2663_Annotation9" targetRef="W2663_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2663_Flow11" sourceRef="W2663_Start4" targetRef="W2663_Task5" />
      <bpmn:sequenceFlow id="W2663_Flow12" sourceRef="W2663_Task5" targetRef="W2663_Task6" />
      <bpmn:sequenceFlow id="W2663_Flow13" sourceRef="W2663_Task6" targetRef="W2663_Task7" />
      <bpmn:sequenceFlow id="W2663_Flow14" sourceRef="W2663_Task7" targetRef="W2663_End8" />
    </bpmn:process>
