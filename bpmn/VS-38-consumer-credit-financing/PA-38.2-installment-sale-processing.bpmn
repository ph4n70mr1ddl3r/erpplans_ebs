    <bpmn:process id="W_W1775" name="W1775. Installment Sale Returns &amp; Cancellation Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer returns merchandise purchased on installment; or cancels order before delivery
Frequency: ~2–3% of installment transactions (~200–350 returns/month)
Volume: ~2–3% of installment transactions
Owner: Store Manager
Participants: Store Manager, Cashier, Credit Manager, Financing Partner, Customer
Source: workflow W1775 — Installment Sale Returns &amp; Cancellation Processing</bpmn:documentation>
      <bpmn:laneSet id="W1775_LaneSet5">
        <bpmn:lane id="W1775_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W1775_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1775_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1775_Lane2" name="Cashier">
        <bpmn:flowNodeRef>W1775_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1775_Lane3" name="Credit Manager">
        <bpmn:flowNodeRef>W1775_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1775_Lane4" name="Receiving Clerk">
        <bpmn:flowNodeRef>W1775_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1775_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1775_Start6" name="Customer returns merchandise purchased on installment; or cancels order before delivery">
        <bpmn:outgoing>W1775_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1775_Task7" name="Customer requests return of item purchased on installment: (a) standard return…">
        <bpmn:documentation>Step 1: Customer requests return of item purchased on installment: (a) standard return policy applies (7-day return for non-defective items; longer for defective), (b) Store Manager verifies return eligibility per W1622
Responsible (R): Store Manager
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1775_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1775_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1775_Task8" name="For third-party financed purchases: (a) return processed in POS; system sends…">
        <bpmn:documentation>Step 2: For third-party financed purchases: (a) return processed in POS; system sends refund instruction to financing partner, (b) financing partner reverses installment plan (or adjusts remaining balance), (c) MDR charged on original transaction may not be refundable — absorbed as cost, (d) if customer has already made installment payments: financing partner handles refund to customer
Responsible (R): Cashier / System
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1775_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1775_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1775_Task9" name="For in-house installment (trade accounts): (a) Credit Manager reviews return…">
        <bpmn:documentation>Step 3: For in-house installment (trade accounts): (a) Credit Manager reviews return; if legitimate: credit note issued to reduce AR balance, (b) if return is partial: AR reduced by returned amount; remaining installments continue, (c) if return is full and customer made payments: credit note for payments received; any balance refunded
Responsible (R): Credit Manager / Store Manager
Accountable (A): Accounting Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1775_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1775_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1775_Task10" name="Inventory returned to stock per W1626 (disposition); cost of goods sold reversed">
        <bpmn:documentation>Step 4: Inventory returned to stock per W1626 (disposition); cost of goods sold reversed
Responsible (R): Receiving Clerk / System
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1775_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1775_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1775_End11" name="Complete">
        <bpmn:incoming>W1775_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1775_Annotation12">
        <bpmn:text>Controls: - CTL-356 (ensure controlled execution — Installment Sale Processing &amp; Monitoring (PA-38.2).) | - operational: Store Manager review and approval gate
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
