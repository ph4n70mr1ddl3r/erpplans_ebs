        <bpmndi:BPMNEdge id="W1772_Flow14_di" bpmnElement="W1772_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1772_Flow15_di" bpmnElement="W1772_Flow15"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1772_Flow16_di" bpmnElement="W1772_Flow16"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1772_Flow17_di" bpmnElement="W1772_Flow17"><di:waypoint x="1210" y="505" /><di:waypoint x="1260" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1772_Assoc12_di" bpmnElement="W1772_Assoc12"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1773" name="W1773. Installment Payment Collection &amp; Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Installment due date (monthly for in-house installments)
Frequency: ~200–300 collections/month
Volume: ~PHP 50–100M in monthly in-house installment collections (the ~200–300 active trade arrangements of W1772, avg. arrangement PHP 1M–3M amortizing over 3–12 months; consumer card/BNPL installments are partner-settled per W1771 and are not collected by BuildRight)
Owner: AR Collector
Participants: AR Collector, Customer, Treasury
Source: workflow W1773 — Installment Payment Collection &amp; Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W1773_LaneSet4">
        <bpmn:lane id="W1773_Lane1" name="System">
        <bpmn:flowNodeRef>W1773_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1773_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1773_Lane2" name="Treasury">
        <bpmn:flowNodeRef>W1773_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1773_Lane3" name="AR Collector">
        <bpmn:flowNodeRef>W1773_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1773_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1773_Start5" name="Installment due date (monthly for in-house installments)">
        <bpmn:outgoing>W1773_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1773_Task6" name="System generates installment due reminders: (a) 5 days before due date…">
        <bpmn:documentation>Step 1: System generates installment due reminders: (a) 5 days before due date: SMS/email reminder to customer, (b) due date: payment expected (PDC deposited or customer pays online), (c) 1 day past due: follow-up call from AR Collector
Responsible (R): System / AR Collector
Accountable (A): Credit Manager
Duration: Automated + manual</bpmn:documentation>
        <bpmn:incoming>W1773_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1773_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1773_Task7" name="Payment received: (a) PDC deposited on due date; cleared in bank → system…">
        <bpmn:documentation>Step 2: Payment received: (a) PDC deposited on due date; cleared in bank → system auto-applies to AR, (b) online payment (bank transfer, GCash) → Treasury applies to AR, (c) walk-in payment at store → cashier processes → system applies to AR, (d) system updates AR balance and generates receipt
Responsible (R): Treasury / Cashier / System
Accountable (A): AR Collector
Duration: Per payment</bpmn:documentation>
        <bpmn:incoming>W1773_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1773_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1773_Task8" name="Monthly: AR Collector reviews installment portfolio: (a) payment adherence rate…">
        <bpmn:documentation>Step 3: Monthly: AR Collector reviews installment portfolio: (a) payment adherence rate (% of installments paid on time), (b) upcoming large payments (flag for proactive follow-up), (c) customers with history of late payments (tighten terms on future purchases)
Responsible (R): AR Collector
Accountable (A): Credit Manager
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W1773_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1773_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1773_End9" name="Complete">
        <bpmn:incoming>W1773_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1773_Annotation10">
        <bpmn:text>Controls: - CTL-356 (ensure controlled execution — Installment Sale Processing &amp; Monitoring (PA-38.2).) | - operational: AR Collector review and approval gate
Owner: AR Collector</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1773_Assoc11" sourceRef="W1773_Annotation10" targetRef="W1773_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1773_Flow12" sourceRef="W1773_Start5" targetRef="W1773_Task6" />
      <bpmn:sequenceFlow id="W1773_Flow13" sourceRef="W1773_Task6" targetRef="W1773_Task7" />
      <bpmn:sequenceFlow id="W1773_Flow14" sourceRef="W1773_Task7" targetRef="W1773_Task8" />
      <bpmn:sequenceFlow id="W1773_Flow15" sourceRef="W1773_Task8" targetRef="W1773_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1773_diag">
      <bpmndi:BPMNPlane id="W1773_plane" bpmnElement="W_W1773">
        <bpmndi:BPMNShape id="W1773_Lane1_di" bpmnElement="W1773_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1773_Lane2_di" bpmnElement="W1773_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1773_Lane3_di" bpmnElement="W1773_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
