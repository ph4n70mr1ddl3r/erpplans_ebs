      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1772" name="W1772. In-House Installment Receivable Management (Trade Accounts)" isExecutable="false">
      <bpmn:documentation>Trigger: Trade or corporate account customer requests installment payment terms for project purchase
Frequency: ~200–300 in-house installment arrangements active at any time
Volume: ~50–100 new arrangements/month
Owner: Credit Manager
Participants: Credit Manager, Sales Team, Customer, Accounting Manager
Source: workflow W1772 — In-House Installment Receivable Management (Trade Accounts)</bpmn:documentation>
      <bpmn:laneSet id="W1772_LaneSet4">
        <bpmn:lane id="W1772_Lane1" name="Sales Team">
        <bpmn:flowNodeRef>W1772_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1772_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1772_Lane2" name="Credit Manager">
        <bpmn:flowNodeRef>W1772_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1772_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1772_Lane3" name="AR Accountant">
        <bpmn:flowNodeRef>W1772_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1772_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1772_Start5" name="Trade or corporate account customer requests installment payment terms for project…">
        <bpmn:outgoing>W1772_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1772_Task6" name="Trade/B2B customer requests installment terms for large project: (a) contractor…">
        <bpmn:documentation>Step 1: Trade/B2B customer requests installment terms for large project: (a) contractor building a residential project: PHP 200K materials, requests 3-month payment, (b) developer outfitting 50 units: PHP 5M, requests 6-month payment, (c) government project: PHP 10M, requests payment upon project milestone
Responsible (R): Sales Team
Accountable (A): Credit Manager
Duration: During sales</bpmn:documentation>
        <bpmn:incoming>W1772_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1772_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1772_Task7" name="Credit Manager evaluates request: (a) customer credit score and payment history…">
        <bpmn:documentation>Step 2: Credit Manager evaluates request: (a) customer credit score and payment history per W16.1, (b) project viability assessment, (c) determines terms: down payment % (typically 20–30%), installment period (3–12 months), interest rate (if applicable per credit policy), (d) for amounts &gt; PHP 500K: CFO approval required
Responsible (R): Credit Manager
Accountable (A): CFO (large amounts)
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1772_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1772_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1772_Task8" name="Installment agreement executed: (a) signed agreement with payment schedule, (b)…">
        <bpmn:documentation>Step 3: Installment agreement executed: (a) signed agreement with payment schedule, (b) post-dated checks (PDCs) collected from customer per Philippine practice, (c) AR invoice created in system with installment schedule, (d) system auto-generates AR entries as each installment due date arrives
Responsible (R): Credit Manager / Customer
Accountable (A): Accounting Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1772_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1772_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1772_Task9" name="In-house installment receivable tracked in AR aging with separate…">
        <bpmn:documentation>Step 4: In-house installment receivable tracked in AR aging with separate classification from standard trade AR; collection monitored per W1773–1774
Responsible (R): AR Accountant
Accountable (A): Credit Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W1772_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1772_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1772_End10" name="Complete">
        <bpmn:incoming>W1772_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1772_Annotation11">
        <bpmn:text>Controls: - CTL-356 (ensure controlled execution — Installment Sale Processing &amp; Monitoring (PA-38.2).) | - operational: Credit Manager review and approval gate
Owner: Credit Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1772_Assoc12" sourceRef="W1772_Annotation11" targetRef="W1772_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1772_Flow13" sourceRef="W1772_Start5" targetRef="W1772_Task6" />
      <bpmn:sequenceFlow id="W1772_Flow14" sourceRef="W1772_Task6" targetRef="W1772_Task7" />
      <bpmn:sequenceFlow id="W1772_Flow15" sourceRef="W1772_Task7" targetRef="W1772_Task8" />
      <bpmn:sequenceFlow id="W1772_Flow16" sourceRef="W1772_Task8" targetRef="W1772_Task9" />
      <bpmn:sequenceFlow id="W1772_Flow17" sourceRef="W1772_Task9" targetRef="W1772_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1772_diag">
      <bpmndi:BPMNPlane id="W1772_plane" bpmnElement="W_W1772">
        <bpmndi:BPMNShape id="W1772_Lane1_di" bpmnElement="W1772_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1772_Lane2_di" bpmnElement="W1772_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1772_Lane3_di" bpmnElement="W1772_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
