    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1778" name="W1778. Installment Portfolio Reporting &amp; Aging Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly management reporting
Frequency: Monthly
Volume: 1 report covering all in-house installment receivables
Owner: Credit Manager
Participants: Credit Manager, FP&amp;A, CFO
Source: workflow W1778 — Installment Portfolio Reporting &amp; Aging Analysis</bpmn:documentation>
      <bpmn:laneSet id="W1778_LaneSet3">
        <bpmn:lane id="W1778_Lane1" name="Credit Manager">
        <bpmn:flowNodeRef>W1778_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1778_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1778_Lane2" name="CFO">
        <bpmn:flowNodeRef>W1778_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1778_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1778_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1778_Start4" name="Monthly management reporting">
        <bpmn:outgoing>W1778_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1778_Task5" name="Monthly installment portfolio report: (a) total installment receivable…">
        <bpmn:documentation>Step 1: Monthly installment portfolio report: (a) total installment receivable outstanding, (b) aging: current, 1–30 days, 31–60 days, 61–90 days, &gt; 90 days, (c) aging as % of total portfolio, (d) provision for bad debts: current provision rate × aging buckets (e.g., 1% current, 5% for 31–60, 25% for 61–90, 50% for &gt; 90), (e) top 20 largest installment accounts with status, (f) write-offs for the month, (g) new installment arrangements for the month
Responsible (R): Credit Manager / AR Collector
Accountable (A): CFO
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W1778_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1778_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1778_Task6" name="CFO reviews portfolio health: (a) target: &gt; 95% of portfolio current (not past…">
        <bpmn:documentation>Step 2: CFO reviews portfolio health: (a) target: &gt; 95% of portfolio current (not past due), (b) if delinquency rate increasing: tighten credit approval criteria, (c) if portfolio growing rapidly: assess concentration risk (single customer or project &gt; 10% of portfolio)
Responsible (R): CFO
Accountable (A): CEO
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W1778_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1778_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1778_Task7" name="Quarterly: CFO presents installment portfolio summary to Board as part of…">
        <bpmn:documentation>Step 3: Quarterly: CFO presents installment portfolio summary to Board as part of financial review
Responsible (R): CFO
Accountable (A): Board
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W1778_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1778_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1778_End8" name="Complete">
        <bpmn:incoming>W1778_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1778_Annotation9">
        <bpmn:text>Controls: - CTL-356 (ensure controlled execution — Installment Sale Processing &amp; Monitoring (PA-38.2).) | - operational: Credit Manager review and approval gate
Owner: Credit Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1778_Assoc10" sourceRef="W1778_Annotation9" targetRef="W1778_Start4" associationDirection="None" />
