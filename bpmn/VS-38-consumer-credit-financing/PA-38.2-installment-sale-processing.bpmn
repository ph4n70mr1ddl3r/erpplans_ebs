    <bpmn:process id="W_W1777" name="W1777. Installment Sale Tax Compliance (VAT, WHT)" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly tax filing
Frequency: Monthly
Volume: Part of regular tax filing
Owner: Tax Accountant
Participants: Tax Accountant, Revenue Accountant, CFO
Source: workflow W1777 — Installment Sale Tax Compliance (VAT, WHT)</bpmn:documentation>
      <bpmn:laneSet id="W1777_LaneSet2">
        <bpmn:lane id="W1777_Lane1" name="Tax Accountant">
        <bpmn:flowNodeRef>W1777_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1777_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1777_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1777_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1777_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1777_Start3" name="Monthly tax filing">
        <bpmn:outgoing>W1777_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1777_Task4" name="VAT on installment sales: (a) output VAT recognized at point of sale (full…">
        <bpmn:documentation>Step 1: VAT on installment sales: (a) output VAT recognized at point of sale (full selling price × 12%), not over the installment period — per Philippine VAT rules (gross receipt is taxable upon sale, not upon collection), (b) for third-party financed sales: BuildRight receives net amount (gross minus MDR) but remits VAT on gross selling price, (c) input VAT on cost of goods sold claimed normally
Responsible (R): Tax Accountant
Accountable (A): CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W1777_Flow10</bpmn:incoming>
        <bpmn:outgoing>W1777_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1777_Task5" name="MDR VAT treatment: (a) MDR paid to financing partner includes 12% VAT, (b)…">
        <bpmn:documentation>Step 2: MDR VAT treatment: (a) MDR paid to financing partner includes 12% VAT, (b) BuildRight can claim input VAT on MDR as the service was used in the course of business, (c) financing partner issues VAT invoice for MDR charged
Responsible (R): Tax Accountant
Accountable (A): CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W1777_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1777_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1777_Task6" name="In-house installment interest income (if applicable): (a) interest earned on…">
        <bpmn:documentation>Step 3: In-house installment interest income (if applicable): (a) interest earned on in-house installment plans forms part of the gross selling price and is subject to VAT (12%), (b) interest income reported in monthly VAT return (BIR Form 2550M)
Responsible (R): Tax Accountant
Accountable (A): CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W1777_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1777_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1777_End7" name="Complete">
        <bpmn:incoming>W1777_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1777_Annotation8">
        <bpmn:text>Controls: - CTL-208 (ensure consumer-financing settlement &amp; compliance.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Tax Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1777_Assoc9" sourceRef="W1777_Annotation8" targetRef="W1777_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W1777_Flow10" sourceRef="W1777_Start3" targetRef="W1777_Task4" />
      <bpmn:sequenceFlow id="W1777_Flow11" sourceRef="W1777_Task4" targetRef="W1777_Task5" />
      <bpmn:sequenceFlow id="W1777_Flow12" sourceRef="W1777_Task5" targetRef="W1777_Task6" />
      <bpmn:sequenceFlow id="W1777_Flow13" sourceRef="W1777_Task6" targetRef="W1777_End7" />
    </bpmn:process>
