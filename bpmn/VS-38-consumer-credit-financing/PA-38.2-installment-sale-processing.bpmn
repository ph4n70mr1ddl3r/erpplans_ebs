        <bpmndi:BPMNShape id="W1773_Task7_di" bpmnElement="W1773_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1773_Task8_di" bpmnElement="W1773_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1773_Start5_di" bpmnElement="W1773_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1773_End9_di" bpmnElement="W1773_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1773_Annotation10_di" bpmnElement="W1773_Annotation10"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1773_Flow12_di" bpmnElement="W1773_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1773_Flow13_di" bpmnElement="W1773_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1773_Flow14_di" bpmnElement="W1773_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1773_Flow15_di" bpmnElement="W1773_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1773_Assoc11_di" bpmnElement="W1773_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1774" name="W1774. Installment Delinquency Tracking &amp; Collection Action" isExecutable="false">
      <bpmn:documentation>Trigger: Installment payment &gt; 30 days past due
Frequency: ~20–50 delinquent accounts/month
Volume: Target: &lt; 5% delinquency rate
Owner: Credit Manager
Participants: Credit Manager, AR Collector, Legal Counsel, Customer
Source: workflow W1774 — Installment Delinquency Tracking &amp; Collection Action</bpmn:documentation>
      <bpmn:laneSet id="W1774_LaneSet3">
        <bpmn:lane id="W1774_Lane1" name="AR Collector">
        <bpmn:flowNodeRef>W1774_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1774_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1774_Lane2" name="Credit Manager">
        <bpmn:flowNodeRef>W1774_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1774_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1774_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1774_Start4" name="Installment payment &gt; 30 days past due">
        <bpmn:outgoing>W1774_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1774_Task5" name="Delinquency tiers and actions: (a) 1–30 days past due: reminder calls and SMS…">
        <bpmn:documentation>Step 1: Delinquency tiers and actions: (a) 1–30 days past due: reminder calls and SMS; friendly follow-up; understand reason for delay (common: customer waiting for own project payment), (b) 31–60 days: formal demand letter; hold on new orders; Credit Manager calls customer; negotiate restructuring if customer has genuine difficulty, (c) 61–90 days: legal demand letter; restrict account; engage collection agency or Legal Counsel for legal action, (d) &gt; 90 days: write-off consideration per policy; legal action; report to credit bureaus (if BuildRight participates)
Responsible (R): AR Collector / Credit Manager
Accountable (A): CFO
Duration: Per account</bpmn:documentation>
        <bpmn:incoming>W1774_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1774_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1774_Task6" name="Restructuring: for customers with good history but temporary difficulty: (a)…">
        <bpmn:documentation>Step 2: Restructuring: for customers with good history but temporary difficulty: (a) extend payment period, (b) reduce monthly amount, (c) waive late fees (if prompt payment resumes), (d) document restructured terms
Responsible (R): Credit Manager
Accountable (A): CFO
Duration: Per account</bpmn:documentation>
        <bpmn:incoming>W1774_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1774_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1774_Task7" name="Write-off: accounts &gt; 180 days delinquent and all collection efforts exhausted…">
        <bpmn:documentation>Step 3: Write-off: accounts &gt; 180 days delinquent and all collection efforts exhausted: (a) Credit Manager recommends write-off, (b) CFO approves (&lt; PHP 500K) or CEO approves (&gt; PHP 500K), (c) bad debt expense recorded, (d) account sent to external collection agency on contingency basis
Responsible (R): Credit Manager
Accountable (A): CFO
Duration: Per account</bpmn:documentation>
        <bpmn:incoming>W1774_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1774_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1774_End8" name="Complete">
        <bpmn:incoming>W1774_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1774_Annotation9">
        <bpmn:text>Controls: - CTL-356 (ensure controlled execution — Installment Sale Processing &amp; Monitoring (PA-38.2).) | - operational: Credit Manager review and approval gate
Owner: Credit Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1774_Assoc10" sourceRef="W1774_Annotation9" targetRef="W1774_Start4" associationDirection="None" />
