<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-38.2-installment-sale-processing" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1771" name="W1771. Installment Sale Transaction Recording &amp; Revenue Recognition" isExecutable="false">
      <bpmn:documentation>Trigger: Consumer installment transaction completed at POS or ecommerce
Frequency: ~90,000–120,000 installment transactions/month (~3–5% of POS, per the canon; consumer card/BNPL stream — settled by the financing partner T+1–T+3, never collected by BuildRight; the in-house trade stream collected by BuildRight is the separate ~200–300-collections/month basis of W1773)
Volume: ~3–5% of all sales transactions
Owner: Revenue Accountant
Participants: Revenue Accountant, Cashier (in-store), System (ecommerce)
Source: workflow W1771 — Installment Sale Transaction Recording &amp; Revenue Recognition</bpmn:documentation>
      <bpmn:laneSet id="W1771_LaneSet3">
        <bpmn:lane id="W1771_Lane1" name="System">
        <bpmn:flowNodeRef>W1771_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1771_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1771_Lane2" name="Revenue Accountant">
        <bpmn:flowNodeRef>W1771_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1771_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1771_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1771_Start4" name="Consumer installment transaction completed at POS or ecommerce">
        <bpmn:outgoing>W1771_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1771_Task5" name="POS records installment sale transaction: (a) revenue recognized at full…">
        <bpmn:documentation>Step 1: POS records installment sale transaction: (a) revenue recognized at full selling price at point of sale (BuildRight sells to customer; financing partner pays BuildRight), (b) VAT output recorded at 12% on selling price, (c) cost of goods sold recorded (standard margin), (d) MDR (merchant discount rate) recorded as selling expense, (e) for third-party financing: BuildRight receives full amount from partner (net of MDR) within T+1 to T+3, (f) for in-house trade account installments: AR recognized per W1772
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1771_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1771_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1771_Task6" name="Revenue recognition per PFRS 15: (a) control transfers to customer at point of…">
        <bpmn:documentation>Step 2: Revenue recognition per PFRS 15: (a) control transfers to customer at point of sale (or delivery for ecommerce), (b) revenue = gross transaction amount, (c) MDR = transaction cost (selling expense), (d) no financing component in revenue (third-party financing), (e) for in-house deferred payment: assess if significant financing component exists (if payment term &gt; 12 months, may need to discount revenue to present value)
Responsible (R): Revenue Accountant
Accountable (A): Accounting Manager
Duration: Monthly review</bpmn:documentation>
        <bpmn:incoming>W1771_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1771_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1771_Task7" name="Daily reconciliation: installment transactions in POS vs. settlement expected…">
        <bpmn:documentation>Step 3: Daily reconciliation: installment transactions in POS vs. settlement expected from financing partners; discrepancies investigated within 24 hours
Responsible (R): Revenue Accountant
Accountable (A): Accounting Manager
Duration: 30 min/day</bpmn:documentation>
        <bpmn:incoming>W1771_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1771_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1771_End8" name="Complete">
        <bpmn:incoming>W1771_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1771_Annotation9">
        <bpmn:text>Controls: - CTL-356 (ensure controlled execution — Installment Sale Processing &amp; Monitoring (PA-38.2).) | - operational: periodic reconciliation against source documents
Owner: Revenue Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1771_Assoc10" sourceRef="W1771_Annotation9" targetRef="W1771_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1771_Flow11" sourceRef="W1771_Start4" targetRef="W1771_Task5" />
      <bpmn:sequenceFlow id="W1771_Flow12" sourceRef="W1771_Task5" targetRef="W1771_Task6" />
      <bpmn:sequenceFlow id="W1771_Flow13" sourceRef="W1771_Task6" targetRef="W1771_Task7" />
      <bpmn:sequenceFlow id="W1771_Flow14" sourceRef="W1771_Task7" targetRef="W1771_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1771_diag">
      <bpmndi:BPMNPlane id="W1771_plane" bpmnElement="W_W1771">
        <bpmndi:BPMNShape id="W1771_Lane1_di" bpmnElement="W1771_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
