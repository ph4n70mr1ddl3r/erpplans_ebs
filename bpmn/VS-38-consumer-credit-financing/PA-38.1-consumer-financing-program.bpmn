    <bpmn:process id="W_W1767" name="W1767. Home Improvement Loan Referral Program" isExecutable="false">
      <bpmn:documentation>Trigger: Customer inquires about financing for large home improvement project (kitchen, bathroom renovation, whole-house build)
Frequency: ~500–1,000 referrals/year
Volume: ~2–5 referrals per store per year (~500–1,000/year per the Frequency)
Owner: Department Supervisor
Participants: Department Supervisor, Customer, Bank/Financing Partner
Source: workflow W1767 — Home Improvement Loan Referral Program</bpmn:documentation>
      <bpmn:laneSet id="W1767_LaneSet4">
        <bpmn:lane id="W1767_Lane1" name="Department Supervisor">
        <bpmn:flowNodeRef>W1767_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1767_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1767_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
