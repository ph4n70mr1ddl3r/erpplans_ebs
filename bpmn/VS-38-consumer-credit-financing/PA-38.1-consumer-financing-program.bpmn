<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-38.1-consumer-financing-program" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1763" name="W1763. Financing Partner Selection &amp; Agreement Negotiation" isExecutable="false">
      <bpmn:documentation>Trigger: Annual financing partner review or new partner needed
Frequency: Annual review; new agreements every 2–3 years
Volume: ~5–8 active financing partnerships
Owner: CFO
Participants: CFO, Treasury, VP Merchandising, CMO, Legal Counsel
Source: workflow W1763 — Financing Partner Selection &amp; Agreement Negotiation</bpmn:documentation>
      <bpmn:laneSet id="W1763_LaneSet4">
        <bpmn:lane id="W1763_Lane1" name="CFO">
        <bpmn:flowNodeRef>W1763_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1763_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1763_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1763_Lane2" name="Legal Counsel">
        <bpmn:flowNodeRef>W1763_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1763_Lane3" name="IT">
        <bpmn:flowNodeRef>W1763_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1763_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1763_Start5" name="Annual financing partner review or new partner needed">
        <bpmn:outgoing>W1763_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1763_Task6" name="CFO identifies financing partner categories needed: (a) bank installment…">
        <bpmn:documentation>Step 1: CFO identifies financing partner categories needed: (a) bank installment partners: BDO, BPI, Metrobank, Chinabank, EastWest (credit card installment conversion), (b) financing companies: Home Credit, RFC, Savers (for non-card installment), (c) BNPL providers: GCash GGives, Maya (digital-first installment), (d) government housing loan programs: Pag-IBIG Fund (home improvement loans), (e) in-house deferred payment for trade accounts (covered by VS-16)
Responsible (R): CFO
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1763_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1763_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1763_Task7" name="Negotiate terms with each partner: (a) merchant discount rate (MDR): % of…">
        <bpmn:documentation>Step 2: Negotiate terms with each partner: (a) merchant discount rate (MDR): % of transaction paid to partner (target: 1.5–3.5% depending on promo), (b) 0% interest promotional periods: partner subsidizes interest for 3/6/12-month terms (higher MDR for longer 0% periods), (c) settlement period: days until BuildRight receives payment (target: T+1 to T+3), (d) minimum transaction amount for installment (typically PHP 3,000–5,000), (e) maximum installment term (6/12/18/24/36 months), (f) chargeback and dispute resolution process, (g) marketing co-op fund contribution from partner
Responsible (R): CFO / Treasury
Accountable (A): CEO
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W1763_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1763_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1763_Task8" name="Legal Counsel reviews and executes financing agreement: (a) BSP compliance (if…">
        <bpmn:documentation>Step 3: Legal Counsel reviews and executes financing agreement: (a) BSP compliance (if partner is regulated financial institution), (b) Data Privacy Act compliance for customer data sharing, (c) liability and indemnification terms, (d) termination provisions
Responsible (R): Legal Counsel
Accountable (A): CFO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1763_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1763_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1763_Task9" name="IT integrates partner into POS system: (a) installment payment method added to…">
        <bpmn:documentation>Step 4: IT integrates partner into POS system: (a) installment payment method added to POS terminal, (b) real-time approval interface with financing partner, (c) settlement reconciliation automated, (d) promotional rate tables configured in POS
Responsible (R): IT / SSP (the in-house POS platform team)
Accountable (A): CIO
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W1763_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1763_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1763_End10" name="Complete">
        <bpmn:incoming>W1763_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1763_Annotation11">
        <bpmn:text>Controls: - CTL-355 (ensure controlled execution — Consumer Financing Program Management (PA-38.1).) | - operational: CFO review and approval gate; periodic reconciliation against source documents
Owner: CFO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1763_Assoc12" sourceRef="W1763_Annotation11" targetRef="W1763_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1763_Flow13" sourceRef="W1763_Start5" targetRef="W1763_Task6" />
      <bpmn:sequenceFlow id="W1763_Flow14" sourceRef="W1763_Task6" targetRef="W1763_Task7" />
      <bpmn:sequenceFlow id="W1763_Flow15" sourceRef="W1763_Task7" targetRef="W1763_Task8" />
      <bpmn:sequenceFlow id="W1763_Flow16" sourceRef="W1763_Task8" targetRef="W1763_Task9" />
      <bpmn:sequenceFlow id="W1763_Flow17" sourceRef="W1763_Task9" targetRef="W1763_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1763_diag">
      <bpmndi:BPMNPlane id="W1763_plane" bpmnElement="W_W1763">
        <bpmndi:BPMNShape id="W1763_Lane1_di" bpmnElement="W1763_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
