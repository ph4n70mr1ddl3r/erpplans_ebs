    <bpmn:process id="W_W1770" name="W1770. Financing Compliance &amp; BSP Regulatory Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Regulatory change from BSP, DTI, or financing partner requirements
Frequency: Continuous monitoring; ad-hoc for regulatory changes
Volume: ~3–5 regulatory updates/year
Owner: Legal Counsel
Participants: Legal Counsel, Compliance Officer, CFO, DPO
Source: workflow W1770 — Financing Compliance &amp; BSP Regulatory Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W1770_LaneSet3">
        <bpmn:lane id="W1770_Lane1" name="Legal Counsel">
        <bpmn:flowNodeRef>W1770_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1770_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1770_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1770_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1770_Lane2" name="DPO">
        <bpmn:flowNodeRef>W1770_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1770_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1770_Start4" name="Regulatory change from BSP, DTI, or financing partner requirements">
        <bpmn:outgoing>W1770_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1770_Task5" name="Legal Counsel monitors regulatory environment for consumer financing: (a) BSP…">
        <bpmn:documentation>Step 1: Legal Counsel monitors regulatory environment for consumer financing: (a) BSP regulations on installment sales and credit, (b) DTI consumer protection requirements (Truth in Lending Act), (c) Data Privacy Act requirements for customer financial data sharing, (d) Anti-Money Laundering (AMLA) requirements for large cash transactions, (e) financing company licensing requirements (BuildRight is merchant, not lender — but must verify partners are properly licensed)
Responsible (R): Legal Counsel
Accountable (A): VP Legal
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W1770_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1770_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1770_Task6" name="Compliance with Truth in Lending Act (RA 3765): (a) ensure all promotional…">
        <bpmn:documentation>Step 2: Compliance with Truth in Lending Act (RA 3765): (a) ensure all promotional financing displays clearly state: principal amount, interest rate (or &quot;0% interest&quot;), installment term, monthly amortization, total amount payable, (b) no hidden fees passed to customer, (c) promotional terms clearly communicated at POS and in marketing materials
Responsible (R): Legal Counsel / Marketing
Accountable (A): CMO
Duration: Per promotion</bpmn:documentation>
        <bpmn:incoming>W1770_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1770_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1770_Task7" name="Data privacy compliance for financing applications: (a) customer consent…">
        <bpmn:documentation>Step 3: Data privacy compliance for financing applications: (a) customer consent obtained before sharing personal data with financing partner, (b) financing partner data processing agreement in place, (c) customer data retained only per retention policy, (d) DPO monitors financing data flows per W1735
Responsible (R): DPO / Legal Counsel
Accountable (A): VP Legal
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W1770_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1770_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1770_Task8" name="Annual review: Legal Counsel assesses all financing partnerships for regulatory…">
        <bpmn:documentation>Step 4: Annual review: Legal Counsel assesses all financing partnerships for regulatory compliance; flags any partner concerns (license status, complaint patterns, regulatory actions) to CFO
Responsible (R): Legal Counsel
Accountable (A): CFO
Duration: 1 day/year</bpmn:documentation>
        <bpmn:incoming>W1770_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1770_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1770_End9" name="Complete">
        <bpmn:incoming>W1770_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1770_Annotation10">
        <bpmn:text>Controls: - CTL-355 (ensure controlled execution — Consumer Financing Program Management (PA-38.1).) | - operational: Legal Counsel review and approval gate
Owner: Legal Counsel</bpmn:text>
      </bpmn:textAnnotation>
