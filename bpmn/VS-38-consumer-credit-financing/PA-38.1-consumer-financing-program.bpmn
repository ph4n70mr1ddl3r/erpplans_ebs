      <bpmn:sequenceFlow id="W1766_Flow15" sourceRef="W1766_Task7" targetRef="W1766_Task8" />
      <bpmn:sequenceFlow id="W1766_Flow16" sourceRef="W1766_Task8" targetRef="W1766_Task9" />
      <bpmn:sequenceFlow id="W1766_Flow17" sourceRef="W1766_Task9" targetRef="W1766_End10" />
    </bpmn:process>
