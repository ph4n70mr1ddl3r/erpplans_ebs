        </bpmn:lane>
        <bpmn:lane id="W1767_Lane3" name="VP Merchandising">
        <bpmn:flowNodeRef>W1767_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1767_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1767_Start5" name="Customer inquires about financing for large home improvement project (kitchen, bathroom…">
        <bpmn:outgoing>W1767_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1767_Task6" name="Customer discusses large project with Department Supervisor (e.g., full kitchen…">
        <bpmn:documentation>Step 1: Customer discusses large project with Department Supervisor (e.g., full kitchen renovation ~PHP 100–300K); Supervisor identifies financing need and presents loan referral option
Responsible (R): Department Supervisor
Accountable (A): —
Duration: During sales interaction</bpmn:documentation>
        <bpmn:incoming>W1767_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1767_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1767_Task7" name="Supervisor refers customer to partner bank or Pag-IBIG for home improvement…">
        <bpmn:documentation>Step 2: Supervisor refers customer to partner bank or Pag-IBIG for home improvement loan: (a) Pag-IBIG Fund home improvement loan (for members, up to PHP 3M, 2–30 year terms), (b) bank personal/home improvement loans (BDO, BPI), (c) provides customer with referral information and partner contact, (d) BuildRight earns referral fee (if applicable per partner agreement)
Responsible (R): Department Supervisor
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1767_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1767_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1767_Task8" name="Customer obtains loan approval independently from financing partner; returns to…">
        <bpmn:documentation>Step 3: Customer obtains loan approval independently from financing partner; returns to BuildRight to make purchase; transaction processed as standard sale (cash or bank transfer from loan proceeds)
Responsible (R): Customer / Cashier
Accountable (A): —
Duration: Variable</bpmn:documentation>
        <bpmn:incoming>W1767_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1767_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1767_Task9" name="Monthly: VP Merchandising tracks referral volume and conversion rate; assesses…">
        <bpmn:documentation>Step 4: Monthly: VP Merchandising tracks referral volume and conversion rate; assesses referral program effectiveness
Responsible (R): VP Merchandising
Accountable (A): CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W1767_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1767_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1767_End10" name="Complete">
        <bpmn:incoming>W1767_Flow17</bpmn:incoming>
      </bpmn:endEvent>
