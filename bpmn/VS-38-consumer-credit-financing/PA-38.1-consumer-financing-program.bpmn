    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1764" name="W1764. In-Store Financing Desk Setup &amp; Staff Training" isExecutable="false">
      <bpmn:documentation>Trigger: Financing partner agreement executed (W1763)
Frequency: Per partner setup + annual refresher training
Volume: 200 stores × training per new partner
Owner: CMO
Participants: CMO, Marketing Team, Store Managers, Sales Associates
Source: workflow W1764 — In-Store Financing Desk Setup &amp; Staff Training</bpmn:documentation>
      <bpmn:laneSet id="W1764_LaneSet3">
        <bpmn:lane id="W1764_Lane1" name="Marketing Team">
        <bpmn:flowNodeRef>W1764_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1764_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1764_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1764_Lane2" name="IT">
        <bpmn:flowNodeRef>W1764_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1764_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1764_Start4" name="Financing partner agreement executed (W1763)">
        <bpmn:outgoing>W1764_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1764_Task5" name="Marketing creates financing information kit per store: (a) financing partner…">
        <bpmn:documentation>Step 1: Marketing creates financing information kit per store: (a) financing partner brochure display at checkout and appliance section, (b) promotional signage (e.g., &quot;0% Interest for 12 Months on Appliances&quot;), (c) quick reference card for Sales Associates: available terms, minimum purchase, eligible categories, how to process, (d) financing desk setup at high-value product areas (appliances, power tools, bathroom/kitchen packages)
Responsible (R): Marketing Team
Accountable (A): CMO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1764_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1764_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1764_Task6" name="Sales Associate training on financing offerings: (a) how to present financing…">
        <bpmn:documentation>Step 2: Sales Associate training on financing offerings: (a) how to present financing options to customers (&quot;Did you know you can pay in 12 months with 0% interest?&quot;), (b) which products are eligible for financing, (c) how to process installment payment at POS, (d) required customer documents for financing application (valid ID, proof of income for non-card installment), (e) common customer questions and responses
Responsible (R): Marketing Team / HR
Accountable (A): Store Manager
Duration: 2 hours/store</bpmn:documentation>
        <bpmn:incoming>W1764_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1764_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1764_Task7" name="POS system updated: financing payment method appears as option; cashier selects…">
        <bpmn:documentation>Step 3: POS system updated: financing payment method appears as option; cashier selects installment term; system sends approval request to financing partner; approval received in real-time; transaction completed
Responsible (R): IT
Accountable (A): —
Duration: Per partner setup</bpmn:documentation>
        <bpmn:incoming>W1764_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1764_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1764_End8" name="Complete">
        <bpmn:incoming>W1764_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1764_Annotation9">
        <bpmn:text>Controls: - CTL-355 (ensure controlled execution — Consumer Financing Program Management (PA-38.1).) | - operational: CMO review and approval gate
Owner: CMO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1764_Assoc10" sourceRef="W1764_Annotation9" targetRef="W1764_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1764_Flow11" sourceRef="W1764_Start4" targetRef="W1764_Task5" />
      <bpmn:sequenceFlow id="W1764_Flow12" sourceRef="W1764_Task5" targetRef="W1764_Task6" />
      <bpmn:sequenceFlow id="W1764_Flow13" sourceRef="W1764_Task6" targetRef="W1764_Task7" />
      <bpmn:sequenceFlow id="W1764_Flow14" sourceRef="W1764_Task7" targetRef="W1764_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1764_diag">
      <bpmndi:BPMNPlane id="W1764_plane" bpmnElement="W_W1764">
        <bpmndi:BPMNShape id="W1764_Lane1_di" bpmnElement="W1764_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
