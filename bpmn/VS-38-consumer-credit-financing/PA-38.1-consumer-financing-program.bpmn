    <bpmn:process id="W_W1769" name="W1769. Financing Program Performance Monitoring &amp; Partner Review" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly performance review cycle
Frequency: Monthly dashboard; quarterly partner review; annual renegotiation
Volume: ~5–8 partner reviews
Owner: FP&amp;A
Participants: FP&amp;A, CFO, VP Merchandising, CMO
Source: workflow W1769 — Financing Program Performance Monitoring &amp; Partner Review</bpmn:documentation>
      <bpmn:laneSet id="W1769_LaneSet3">
        <bpmn:lane id="W1769_Lane1" name="FP&amp;A">
        <bpmn:flowNodeRef>W1769_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1769_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1769_Lane2" name="CFO">
        <bpmn:flowNodeRef>W1769_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1769_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1769_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1769_Start4" name="Monthly performance review cycle">
        <bpmn:outgoing>W1769_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1769_Task5" name="Monthly financing dashboard: (a) total financed sales (PHP amount and % of…">
        <bpmn:documentation>Step 1: Monthly financing dashboard: (a) total financed sales (PHP amount and % of total sales), (b) financed sales by partner, (c) financed sales by category (appliances, power tools, home packages), (d) average financed transaction value vs. non-financed ATV, (e) financing penetration rate by store, (f) MDR cost by partner, (g) promotional financing effectiveness (incremental sales vs. MDR subsidy cost), (h) customer adoption rate by payment method (card installment vs. BNPL vs. non-card)
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W1769_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1769_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1769_Task6" name="Quarterly partner review: (a) settlement accuracy (discrepancies, chargebacks)…">
        <bpmn:documentation>Step 2: Quarterly partner review: (a) settlement accuracy (discrepancies, chargebacks), (b) approval rates (% of applications approved by partner), (c) customer satisfaction with financing process, (d) competitive benchmarking (what financing terms do competitors offer?), (e) partner compliance with agreement terms
Responsible (R): CFO / Treasury
Accountable (A): CEO
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W1769_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1769_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1769_Task7" name="Annual renegotiation: CFO uses performance data to negotiate better MDR rates…">
        <bpmn:documentation>Step 3: Annual renegotiation: CFO uses performance data to negotiate better MDR rates, longer promotional terms, or improved settlement periods; underperforming partners may be replaced
Responsible (R): CFO
Accountable (A): CEO
Duration: 2–4 weeks/year</bpmn:documentation>
        <bpmn:incoming>W1769_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1769_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1769_End8" name="Complete">
        <bpmn:incoming>W1769_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1769_Annotation9">
        <bpmn:text>Controls: - CTL-355 (ensure controlled execution — Consumer Financing Program Management (PA-38.1).) | - operational: FP&amp;A review and approval gate
Owner: FP&amp;A</bpmn:text>
      </bpmn:textAnnotation>
