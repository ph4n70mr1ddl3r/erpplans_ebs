    <bpmn:process id="W_W1768" name="W1768. Buy-Now-Pay-Later (BNPL) Integration &amp; Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer selects BNPL payment at POS or ecommerce checkout
Frequency: ~2,000–4,000 BNPL transactions/month (growing rapidly)
Volume: ~0.1–0.15% of total transactions (~2,000–4,000 BNPL transactions/month per the Frequency; increasing trend)
Owner: CMO (digital channels) / VP Store Operations (in-store)
Participants: Cashier, Customer, BNPL Provider (GCash GGives, Maya, etc.)
Source: workflow W1768 — Buy-Now-Pay-Later (BNPL) Integration &amp; Processing</bpmn:documentation>
      <bpmn:laneSet id="W1768_LaneSet4">
        <bpmn:lane id="W1768_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W1768_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1768_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1768_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1768_Lane2" name="System">
        <bpmn:flowNodeRef>W1768_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1768_Lane3" name="Treasury">
        <bpmn:flowNodeRef>W1768_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1768_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1768_Start5" name="Customer selects BNPL payment at POS or ecommerce checkout">
        <bpmn:outgoing>W1768_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1768_Task6" name="Customer selects BNPL at checkout: (a) in-store: Cashier selects BNPL payment…">
        <bpmn:documentation>Step 1: Customer selects BNPL at checkout: (a) in-store: Cashier selects BNPL payment method in POS, generates QR code or asks customer to open BNPL app, (b) ecommerce: customer selects BNPL at payment page, redirected to BNPL provider for approval, (c) customer authenticates with BNPL provider (biometric/PIN), (d) BNPL provider approves transaction (instant for existing users; new user onboarding 3–5 minutes)
Responsible (R): Cashier / System
Accountable (A): —
Duration: 3–5 min</bpmn:documentation>
        <bpmn:incoming>W1768_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1768_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1768_Task7" name="Transaction completed: (a) BuildRight receives payment from BNPL provider at…">
        <bpmn:documentation>Step 2: Transaction completed: (a) BuildRight receives payment from BNPL provider at T+1 settlement, minus BNPL fee (typically 2–4%), (b) customer&#x27;s repayment obligation is with BNPL provider, (c) no AR risk for BuildRight
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1768_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1768_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1768_Task8" name="Returns on BNPL transactions: (a) customer returns item at store, (b)…">
        <bpmn:documentation>Step 3: Returns on BNPL transactions: (a) customer returns item at store, (b) BuildRight processes return in POS, (c) system sends refund instruction to BNPL provider, (d) BNPL provider adjusts customer&#x27;s payment schedule or issues refund, (e) BuildRight receives credit note from BNPL provider
Responsible (R): Cashier / System
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1768_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1768_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1768_Task9" name="Monthly reconciliation: Treasury reconciles BNPL settlement statements with POS…">
        <bpmn:documentation>Step 4: Monthly reconciliation: Treasury reconciles BNPL settlement statements with POS transaction records per W1779
Responsible (R): Treasury
Accountable (A): CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W1768_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1768_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1768_End10" name="Complete">
        <bpmn:incoming>W1768_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1768_Annotation11">
        <bpmn:text>Controls: - CTL-355 (ensure controlled execution — Consumer Financing Program Management (PA-38.1).) | - operational: CMO (digital channels) / VP Store Operations (in-store) review and approval gate; periodic reconciliation against source documents
Owner: CMO (digital channels) / VP Store Operations (in-store)</bpmn:text>
      </bpmn:textAnnotation>
