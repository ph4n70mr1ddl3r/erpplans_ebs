        <bpmndi:BPMNEdge id="W1764_Flow12_di" bpmnElement="W1764_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1764_Flow13_di" bpmnElement="W1764_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1764_Flow14_di" bpmnElement="W1764_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1764_Assoc10_di" bpmnElement="W1764_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1765" name="W1765. Promotional Financing Campaign Planning (0% Installment)" isExecutable="false">
      <bpmn:documentation>Trigger: Seasonal promotional calendar (6 major events/year per merchandising strategy)
Frequency: 6 major campaigns/year + monthly hot deals
Volume: ~10–20 financing promotions/year
Owner: VP Merchandising
Participants: VP Merchandising, Category Managers, CMO, CFO, Financing Partners
Source: workflow W1765 — Promotional Financing Campaign Planning (0% Installment)</bpmn:documentation>
      <bpmn:laneSet id="W1765_LaneSet5">
        <bpmn:lane id="W1765_Lane1" name="Category Managers">
        <bpmn:flowNodeRef>W1765_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1765_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1765_Lane2" name="CFO">
        <bpmn:flowNodeRef>W1765_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1765_Lane3" name="Marketing Team">
        <bpmn:flowNodeRef>W1765_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1765_Lane4" name="FP&amp;A">
        <bpmn:flowNodeRef>W1765_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1765_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1765_Start6" name="Seasonal promotional calendar (6 major events/year per merchandising strategy)">
        <bpmn:outgoing>W1765_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1765_Task7" name="Category Managers propose financing-supported promotions per seasonal calendar…">
        <bpmn:documentation>Step 1: Category Managers propose financing-supported promotions per seasonal calendar: (a) summer (Mar–Apr): aircon and cooling — 0% for 12 months on aircon purchases &gt; PHP 15K, (b) back-to-school (May–Jun): paint and electrical for school builds — 6-month installment, (c) ber-months (Sep–Dec): appliances and home décor — extended 24-month terms, (d) year-round: power tool bundles — 6-month installment, (e) each promotion includes: eligible products, financing terms, partner bank, promotional period, MDR subsidy split between BuildRight and partner
Responsible (R): Category Managers
Accountable (A): VP Merchandising
Duration: 1 week/campaign</bpmn:documentation>
        <bpmn:incoming>W1765_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1765_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1765_Task8" name="CFO negotiates promotional MDR with financing partner: (a) standard MDR may…">
        <bpmn:documentation>Step 2: CFO negotiates promotional MDR with financing partner: (a) standard MDR may increase for 0% promotions (partner absorbs interest cost), (b) split: BuildRight absorbs X% of additional MDR, partner absorbs (100-X)%, (c) volume commitment: minimum transaction volume expected during promo period, (d) exclusivity: partner may request exclusive installment rights for the promotion
Responsible (R): CFO
Accountable (A): VP Merchandising
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1765_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1765_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1765_Task9" name="Marketing launches promotional campaign: (a) in-store signage and displays, (b)…">
        <bpmn:documentation>Step 3: Marketing launches promotional campaign: (a) in-store signage and displays, (b) social media and digital advertising highlighting financing terms, (c) SMS/email to loyalty members, (d) financing partner co-markets to their cardholders, (e) promotional rates configured in POS system for automatic application during promo period
Responsible (R): Marketing Team
Accountable (A): CMO
Duration: Campaign duration</bpmn:documentation>
        <bpmn:incoming>W1765_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1765_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1765_Task10" name="Post-promotion review: (a) incremental sales attributable to financing…">
        <bpmn:documentation>Step 4: Post-promotion review: (a) incremental sales attributable to financing promotion, (b) financing penetration rate (% of eligible sales using installment), (c) cost of financing subsidy vs. incremental gross margin, (d) partner settlement accuracy, (e) ROI assessment for future campaigns
Responsible (R): FP&amp;A / VP Merchandising
Accountable (A): CFO
Duration: 1 week post-promo</bpmn:documentation>
        <bpmn:incoming>W1765_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1765_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1765_End11" name="Complete">
        <bpmn:incoming>W1765_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1765_Annotation12">
        <bpmn:text>Controls: - CTL-355 (ensure controlled execution — Consumer Financing Program Management (PA-38.1).) | - operational: VP Merchandising review and approval gate
Owner: VP Merchandising</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1765_Assoc13" sourceRef="W1765_Annotation12" targetRef="W1765_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1765_Flow14" sourceRef="W1765_Start6" targetRef="W1765_Task7" />
      <bpmn:sequenceFlow id="W1765_Flow15" sourceRef="W1765_Task7" targetRef="W1765_Task8" />
      <bpmn:sequenceFlow id="W1765_Flow16" sourceRef="W1765_Task8" targetRef="W1765_Task9" />
      <bpmn:sequenceFlow id="W1765_Flow17" sourceRef="W1765_Task9" targetRef="W1765_Task10" />
      <bpmn:sequenceFlow id="W1765_Flow18" sourceRef="W1765_Task10" targetRef="W1765_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1765_diag">
      <bpmndi:BPMNPlane id="W1765_plane" bpmnElement="W_W1765">
        <bpmndi:BPMNShape id="W1765_Lane1_di" bpmnElement="W1765_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1765_Lane2_di" bpmnElement="W1765_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1765_Lane3_di" bpmnElement="W1765_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1765_Lane4_di" bpmnElement="W1765_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1765_Task7_di" bpmnElement="W1765_Task7"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1765_Task8_di" bpmnElement="W1765_Task8"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1765_Task9_di" bpmnElement="W1765_Task9"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1765_Task10_di" bpmnElement="W1765_Task10"><dc:Bounds x="1030" y="635" width="180" height="80" /></bpmndi:BPMNShape>
