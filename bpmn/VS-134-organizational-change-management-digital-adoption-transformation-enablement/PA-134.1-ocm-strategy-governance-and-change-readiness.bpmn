        <bpmndi:BPMNShape id="W4075_End8_di" bpmnElement="W4075_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4075_Annotation9_di" bpmnElement="W4075_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4075_Flow11_di" bpmnElement="W4075_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4075_Flow12_di" bpmnElement="W4075_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4075_Flow13_di" bpmnElement="W4075_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4075_Flow14_di" bpmnElement="W4075_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4075_Assoc10_di" bpmnElement="W4075_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4076" name="W4076. Change Impact Assessment &amp; Affected-Person Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Initiative scope/design defined
Frequency: Per initiative + at design changes
Volume: Per major initiative (process, role, system, KPI, location impacts)
Owner: OCM Lead / Process Owner
Participants: Initiative team, affected process owners, HR role design (VS-102.1), OpEx (VS-133)
Source: workflow W4076 — Change Impact Assessment &amp; Affected-Person Analysis</bpmn:documentation>
      <bpmn:laneSet id="W4076_LaneSet2">
        <bpmn:lane id="W4076_Lane1" name="OCM">
        <bpmn:flowNodeRef>W4076_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4076_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4076_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4076_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4076_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4076_Start3" name="Initiative scope/design defined">
        <bpmn:outgoing>W4076_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4076_Task4" name="OCM/process owner assess impacts: which processes (W4050), roles, systems…">
        <bpmn:documentation>Step 1: OCM/process owner assess impacts: which processes (W4050), roles, systems, KPIs, locations, and behaviors change, and the magnitude (incremental vs transformational)
Responsible (R): OCM / Process Owner / Initiative Team
Accountable (A): OCM Lead
Duration: Per initiative</bpmn:documentation>
        <bpmn:incoming>W4076_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4076_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4076_Task5" name="OCM/HR quantify affected people by role/location (e.g., 200 store managers…">
        <bpmn:documentation>Step 2: OCM/HR quantify affected people by role/location (e.g., 200 store managers, ~5,800 associates, 600 DC staff), and identify role/job-design changes (links to VS-102.1)
Responsible (R): OCM / HR
Accountable (A): OCM Lead / CHRO
Duration: Per initiative</bpmn:documentation>
        <bpmn:incoming>W4076_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4076_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4076_Task6" name="OCM translate impacts into the training/enablement plan (W4090), comms plan…">
        <bpmn:documentation>Step 3: OCM translate impacts into the training/enablement plan (W4090), comms plan (W4081), and resistance-focus (W4085)
Responsible (R): OCM / HR / Comms
Accountable (A): Sponsor
Duration: Per initiative</bpmn:documentation>
        <bpmn:incoming>W4076_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4076_Flow13</bpmn:outgoing>
      </bpmn:userTask>
