        <bpmndi:BPMNShape id="W4074_End7_di" bpmnElement="W4074_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4074_Annotation8_di" bpmnElement="W4074_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
