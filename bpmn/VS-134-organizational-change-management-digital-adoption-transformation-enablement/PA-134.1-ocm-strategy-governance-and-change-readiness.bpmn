<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-134.1-ocm-strategy-governance-and-change-readiness" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4073" name="W4073. OCM Strategy, Operating Model &amp; Transformation Governance" isExecutable="false">
      <bpmn:documentation>Trigger: Program stand-up; transformation portfolio established; annual review
Frequency: Annual + on major transformation
Volume: Enterprise OCM function (5 entities, ~6,911 employees, 200 stores)
Owner: CHRO
Participants: CEO, CHRO (links to VS-103), PMO (VS-112), Innovation/Digital (VS-30), OpEx (VS-133), Communications (VS-14.3/VS-103.1)
Source: workflow W4073 — OCM Strategy, Operating Model &amp; Transformation Governance</bpmn:documentation>
      <bpmn:laneSet id="W4073_LaneSet3">
        <bpmn:lane id="W4073_Lane1" name="CHRO">
        <bpmn:flowNodeRef>W4073_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4073_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4073_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4073_Lane2" name="CEO">
        <bpmn:flowNodeRef>W4073_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4073_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4073_Start4" name="Program stand-up; transformation portfolio established; annual review">
        <bpmn:outgoing>W4073_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4073_Task5" name="CHRO define the OCM operating model: a central CoE with embedded change leads…">
        <bpmn:documentation>Step 1: CHRO define the OCM operating model: a central CoE with embedded change leads on major programs; the relationship to the PMO (VS-112), OpEx (VS-133), HR (VS-103), and Comms (VS-14.3); and the enterprise change taxonomy
Responsible (R): CHRO
Accountable (A): CEO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4073_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4073_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4073_Task6" name="CHRO author the change governance: the transformation board, decision rights…">
        <bpmn:documentation>Step 2: CHRO author the change governance: the transformation board, decision rights, stage-gates that include change-readiness criteria, and benefit-realization linkage (VS-112/VS-133)
Responsible (R): CHRO / PMO
Accountable (A): CEO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4073_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4073_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4073_Task7" name="CEO/Board ratify and cascade; integrate change-readiness reporting into…">
        <bpmn:documentation>Step 3: CEO/Board ratify and cascade; integrate change-readiness reporting into governance (VS-36)
Responsible (R): CEO / Board
Accountable (A): Board
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4073_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4073_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4073_End8" name="Complete">
        <bpmn:incoming>W4073_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4073_Annotation9">
        <bpmn:text>Controls: - CTL-126 (ensure change adoption &amp; sustainment.) | - CTL-632: change-readiness gate before go-live; transformation-board oversight
Owner: CHRO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4073_Assoc10" sourceRef="W4073_Annotation9" targetRef="W4073_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4073_Flow11" sourceRef="W4073_Start4" targetRef="W4073_Task5" />
      <bpmn:sequenceFlow id="W4073_Flow12" sourceRef="W4073_Task5" targetRef="W4073_Task6" />
      <bpmn:sequenceFlow id="W4073_Flow13" sourceRef="W4073_Task6" targetRef="W4073_Task7" />
      <bpmn:sequenceFlow id="W4073_Flow14" sourceRef="W4073_Task7" targetRef="W4073_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4073_diag">
      <bpmndi:BPMNPlane id="W4073_plane" bpmnElement="W_W4073">
        <bpmndi:BPMNShape id="W4073_Lane1_di" bpmnElement="W4073_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4073_Lane2_di" bpmnElement="W4073_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
