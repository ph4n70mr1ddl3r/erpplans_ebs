        <bpmndi:BPMNEdge id="W4074_Flow11_di" bpmnElement="W4074_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4074_Flow12_di" bpmnElement="W4074_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4074_Flow13_di" bpmnElement="W4074_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4074_Assoc9_di" bpmnElement="W4074_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4075" name="W4075. Stakeholder Mapping, Analysis &amp; Engagement Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Initiative charter; major change
Frequency: Per initiative + maintained
Volume: Per major initiative (audiences: executives, store managers, associates, DC staff, vendors, B2B customers)
Owner: OCM Lead
Participants: Sponsor, initiative team, HR (VS-103), Comms (VS-14.3)
Source: workflow W4075 — Stakeholder Mapping, Analysis &amp; Engagement Planning</bpmn:documentation>
      <bpmn:laneSet id="W4075_LaneSet3">
        <bpmn:lane id="W4075_Lane1" name="OCM Lead">
        <bpmn:flowNodeRef>W4075_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4075_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4075_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4075_Lane2" name="OCM">
        <bpmn:flowNodeRef>W4075_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4075_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4075_Start4" name="Initiative charter; major change">
        <bpmn:outgoing>W4075_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4075_Task5" name="OCM map stakeholders (influence × interest), identify…">
        <bpmn:documentation>Step 1: OCM map stakeholders (influence × interest), identify champions/resistors/key-influencers, and segment audiences by impact and readiness
Responsible (R): OCM Lead / Initiative Team
Accountable (A): OCM Lead
Duration: Per initiative</bpmn:documentation>
        <bpmn:incoming>W4075_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4075_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4075_Task6" name="OCM build the engagement plan per segment (what they need to know/feel/do…">
        <bpmn:documentation>Step 2: OCM build the engagement plan per segment (what they need to know/feel/do, channel, cadence, owner) and align to comms (VS-14.3)
Responsible (R): OCM / Comms / HR
Accountable (A): Sponsor
Duration: Per initiative</bpmn:documentation>
        <bpmn:incoming>W4075_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4075_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4075_Task7" name="OCM validate with sponsors/managers, refine through the change, and feed…">
        <bpmn:documentation>Step 3: OCM validate with sponsors/managers, refine through the change, and feed insights to resistance management (W4085)
Responsible (R): OCM Lead
Accountable (A): Sponsor
Duration: Per initiative</bpmn:documentation>
        <bpmn:incoming>W4075_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4075_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4075_End8" name="Complete">
        <bpmn:incoming>W4075_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4075_Annotation9">
        <bpmn:text>Controls: - CTL-632 (ensure controlled execution — OCM Strategy, Governance &amp; Change Readiness Assessment (PA-134.1).) | - CTL-632: engagement plan approved by sponsor; segment coverage validated
Owner: OCM Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4075_Assoc10" sourceRef="W4075_Annotation9" targetRef="W4075_Start4" associationDirection="None" />
