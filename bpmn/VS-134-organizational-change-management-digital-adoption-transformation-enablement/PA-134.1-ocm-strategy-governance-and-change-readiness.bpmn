    <bpmn:process id="W_W4074" name="W4074. Change Portfolio Prioritization &amp; Capacity Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Portfolio intake; capacity strain; quarterly planning
Frequency: Continuous + quarterly
Volume: Enterprise change portfolio (ERP, omnichannel, remodels VS-109, net-zero VS-108, statutory, process improvements VS-133)
Owner: CHRO / Transformation Board
Participants: PMO (VS-112), function VPs, HR workforce planning (VS-103.3), OpEx (VS-133)
Source: workflow W4074 — Change Portfolio Prioritization &amp; Capacity Planning</bpmn:documentation>
      <bpmn:laneSet id="W4074_LaneSet2">
        <bpmn:lane id="W4074_Lane1" name="CHRO">
        <bpmn:flowNodeRef>W4074_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4074_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4074_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4074_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4074_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4074_Start3" name="Portfolio intake; capacity strain; quarterly planning">
        <bpmn:outgoing>W4074_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4074_Task4" name="CHRO/PMO maintain the enterprise change portfolio (every initiative changing…">
        <bpmn:documentation>Step 1: CHRO/PMO maintain the enterprise change portfolio (every initiative changing how people work), assess cumulative change load by audience (store/DC/HQ/function), and identify saturation/overload
Responsible (R): CHRO / PMO / HR
Accountable (A): Transformation Board
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4074_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4074_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4074_Task5" name="CHRO lead prioritization and sequencing: sequence to absorb capacity…">
        <bpmn:documentation>Step 2: CHRO lead prioritization and sequencing: sequence to absorb capacity, de-conflict simultaneous impacts on the same audience, and protect frontline trading (peak seasons links to VS-07)
Responsible (R): CHRO / PMO
Accountable (A): CEO / COO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4074_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4074_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4074_Task6" name="CHRO report change load and capacity to the transformation board, and recommend…">
        <bpmn:documentation>Step 3: CHRO report change load and capacity to the transformation board, and recommend defer/accelerate/combine decisions
Responsible (R): CHRO
Accountable (A): Transformation Board
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4074_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4074_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4074_End7" name="Complete">
        <bpmn:incoming>W4074_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4074_Annotation8">
        <bpmn:text>Controls: - CTL-632 (ensure controlled execution — OCM Strategy, Governance &amp; Change Readiness Assessment (PA-134.1).) | - CTL-632: change-window policy; transformation-board sequencing approval
Owner: CHRO / Transformation Board</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4074_Assoc9" sourceRef="W4074_Annotation8" targetRef="W4074_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4074_Flow10" sourceRef="W4074_Start3" targetRef="W4074_Task4" />
      <bpmn:sequenceFlow id="W4074_Flow11" sourceRef="W4074_Task4" targetRef="W4074_Task5" />
      <bpmn:sequenceFlow id="W4074_Flow12" sourceRef="W4074_Task5" targetRef="W4074_Task6" />
      <bpmn:sequenceFlow id="W4074_Flow13" sourceRef="W4074_Task6" targetRef="W4074_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4074_diag">
      <bpmndi:BPMNPlane id="W4074_plane" bpmnElement="W_W4074">
        <bpmndi:BPMNShape id="W4074_Lane1_di" bpmnElement="W4074_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
