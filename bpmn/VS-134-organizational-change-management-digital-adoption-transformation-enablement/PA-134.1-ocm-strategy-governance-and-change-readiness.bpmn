      <bpmn:sequenceFlow id="W4075_Flow12" sourceRef="W4075_Task5" targetRef="W4075_Task6" />
      <bpmn:sequenceFlow id="W4075_Flow13" sourceRef="W4075_Task6" targetRef="W4075_Task7" />
      <bpmn:sequenceFlow id="W4075_Flow14" sourceRef="W4075_Task7" targetRef="W4075_End8" />
    </bpmn:process>
