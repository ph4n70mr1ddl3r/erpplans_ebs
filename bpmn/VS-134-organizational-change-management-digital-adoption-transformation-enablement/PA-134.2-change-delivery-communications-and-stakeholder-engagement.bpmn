    <bpmn:process id="W_W4083" name="W4083. Leadership &amp; Manager Change Cascade &amp; &quot;Equip-the-Manager&quot; Program" isExecutable="false">
      <bpmn:documentation>Trigger: Major change requiring manager-led rollout
Frequency: Per initiative + ongoing
Volume: ~200 store managers, DC managers, HQ managers, supervisors
Owner: OCM Lead / CHRO
Participants: HR (VS-103), L&amp;D (VS-19.4), leaders/managers, comms (VS-14.3)
Source: workflow W4083 — Leadership &amp; Manager Change Cascade &amp; &quot;Equip-the-Manager&quot; Program</bpmn:documentation>
      <bpmn:laneSet id="W4083_LaneSet2">
        <bpmn:lane id="W4083_Lane1" name="OCM">
        <bpmn:flowNodeRef>W4083_Task4</bpmn:flowNodeRef>
