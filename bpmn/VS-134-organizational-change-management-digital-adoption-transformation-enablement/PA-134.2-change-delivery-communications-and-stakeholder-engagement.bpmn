      <bpmn:startEvent id="W4083_Start3" name="Major change requiring manager-led rollout">
        <bpmn:outgoing>W4083_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4083_Task4" name="OCM/HR build the equip-the-manager program: manager toolkits (FAQ, talking…">
        <bpmn:documentation>Step 1: OCM/HR build the equip-the-manager program: manager toolkits (FAQ, talking points, training, FAQs), cascade sessions, and the expectation that managers own local adoption
Responsible (R): OCM / HR / L&amp;D
Accountable (A): CHRO
Duration: Per initiative</bpmn:documentation>
        <bpmn:incoming>W4083_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4083_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4083_Task5" name="OCM/HR deliver cascade sessions (manager→team), equip managers to handle team…">
        <bpmn:documentation>Step 2: OCM/HR deliver cascade sessions (manager→team), equip managers to handle team questions/resistance (W4085), and provide manager-only channels for their own concerns
Responsible (R): OCM / L&amp;D
Accountable (A): OCM Lead
Duration: Per initiative</bpmn:documentation>
        <bpmn:incoming>W4083_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4083_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4083_Task6" name="OCM/HR measure manager engagement/effectiveness, support struggling managers…">
        <bpmn:documentation>Step 3: OCM/HR measure manager engagement/effectiveness, support struggling managers, and recognize strong change leaders (links to VS-102)
Responsible (R): OCM / HR
Accountable (A): CHRO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W4083_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4083_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4083_End7" name="Complete">
        <bpmn:incoming>W4083_Flow13</bpmn:incoming>
      </bpmn:endEvent>
