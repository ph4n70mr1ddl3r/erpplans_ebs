<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-42.1-lease-negotiation-administration" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1854" name="W1854. New Site Lease Negotiation &amp; Execution" isExecutable="false">
      <bpmn:documentation>Trigger: New store or DC location approved by real estate team (W1652 site selection)
Frequency: ~10–15 new leases/year (aligned with 10–15 new stores/year growth target)
Volume: Each lease negotiation covers 1 property; lease term typically 5–15 years
Owner: COO / Legal Counsel
Participants: COO, Legal Counsel, CFO, VP Store Operations, Landlord
Source: workflow W1854 — New Site Lease Negotiation &amp; Execution</bpmn:documentation>
      <bpmn:laneSet id="W1854_LaneSet4">
        <bpmn:lane id="W1854_Lane1" name="COO">
        <bpmn:flowNodeRef>W1854_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1854_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1854_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1854_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1854_Lane2" name="Legal Counsel">
        <bpmn:flowNodeRef>W1854_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1854_Lane3" name="CFO">
        <bpmn:flowNodeRef>W1854_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1854_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1854_Start5" name="New store or DC location approved by real estate team (W1652 site selection)">
        <bpmn:outgoing>W1854_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1854_Task6" name="COO identifies and shortlists candidate properties per W1652 (site selection)…">
        <bpmn:documentation>Step 1: COO identifies and shortlists candidate properties per W1652 (site selection): (a) location criteria: population density, trade area demographics, accessibility (highway frontage, public transport), proximity to competitors, (b) property specifications: selling area 8,000–15,000 sqm, adequate parking (100–200 slots), loading dock access for delivery trucks, zoning compliance (commercial), (c) ownership verification: clean title, no encumbrances, tax declarations current
Responsible (R): COO
Accountable (A): COO
Duration: Per W1652</bpmn:documentation>
        <bpmn:incoming>W1854_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1854_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1854_Task7" name="COO conducts preliminary lease negotiation with landlord: (a) rental rate per…">
        <bpmn:documentation>Step 2: COO conducts preliminary lease negotiation with landlord: (a) rental rate per sqm (benchmark: PHP 300–800/sqm/month depending on location; Metro Manila premium), (b) lease term and renewal options (target: 10–15 years with 5-year renewal options), (c) annual escalation rate (typical: 3–5% per annum or CPI-linked), (d) tenant improvement allowance (landlord contribution to store fit-out), (e) common area maintenance (CAM) charges, (f) exclusivity clause (no competing hardware/home improvement tenant in same development), (g) early termination provisions, (h) assignment and subleasing rights
Responsible (R): COO
Accountable (A): CFO
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W1854_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1854_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1854_Task8" name="Legal Counsel drafts/reviews lease agreement: (a) Philippine legal compliance…">
        <bpmn:documentation>Step 3: Legal Counsel drafts/reviews lease agreement: (a) Philippine legal compliance: Civil Code provisions on lease contracts, (b) IFRS 16 / PFRS 16 implications: classification as operating lease vs. finance lease, right-of-use (ROU) asset and lease liability accounting, (c) force majeure clause: typhoon, earthquake, pandemic provisions, (d) dispute resolution: arbitration vs. litigation, jurisdiction, (e) building permits and occupancy permits: landlord responsibility for securing, (f) insurance requirements: fire, earthquake, liability coverage minimums, (g) data privacy: landlord access to tenant premises and customer data considerations
Responsible (R): Legal Counsel
Accountable (A): VP Legal
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1854_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1854_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1854_Task9" name="CFO reviews financial terms: (a) total lease obligation: monthly rent × 12…">
        <bpmn:documentation>Step 4: CFO reviews financial terms: (a) total lease obligation: monthly rent × 12 months × lease term + escalation, (b) NPV of lease payments for PFRS 16 lease liability calculation, (c) impact on BuildRight Property Management, Inc. cash flow and intercompany settlement with BuildRight Depot, Inc., (d) comparison to benchmark rents in same area, (e) approval: lease commitments &gt; PHP 50M require CEO approval; &gt; PHP 200M require Board approval
Responsible (R): CFO
Accountable (A): CEO / Board
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1854_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1854_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1854_Task10" name="Lease execution: (a) COO and Legal Counsel coordinate lease signing with…">
        <bpmn:documentation>Step 5: Lease execution: (a) COO and Legal Counsel coordinate lease signing with landlord, (b) notarization per Philippine legal requirements, (c) lease agreement registered in Oracle Property Manager (fit-gap F3), (d) Finance creates lease liability and ROU asset per PFRS 16 in BuildRight Property Management, Inc. books, (e) COO coordinates tenant fit-out with landlord and store construction team per W20 (real estate &amp; construction)
Responsible (R): COO / Legal / Finance
Accountable (A): CFO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1854_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1854_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1854_End11" name="Complete">
        <bpmn:incoming>W1854_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1854_Annotation12">
        <bpmn:text>Controls: - CTL-367 (ensure controlled execution — Lease Negotiation &amp; Administration (PA-42.1).) | - operational: COO / Legal Counsel review and approval gate
Owner: COO / Legal Counsel</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1854_Assoc13" sourceRef="W1854_Annotation12" targetRef="W1854_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1854_Flow14" sourceRef="W1854_Start5" targetRef="W1854_Task6" />
      <bpmn:sequenceFlow id="W1854_Flow15" sourceRef="W1854_Task6" targetRef="W1854_Task7" />
      <bpmn:sequenceFlow id="W1854_Flow16" sourceRef="W1854_Task7" targetRef="W1854_Task8" />
      <bpmn:sequenceFlow id="W1854_Flow17" sourceRef="W1854_Task8" targetRef="W1854_Task9" />
      <bpmn:sequenceFlow id="W1854_Flow18" sourceRef="W1854_Task9" targetRef="W1854_Task10" />
      <bpmn:sequenceFlow id="W1854_Flow19" sourceRef="W1854_Task10" targetRef="W1854_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1854_diag">
      <bpmndi:BPMNPlane id="W1854_plane" bpmnElement="W_W1854">
        <bpmndi:BPMNShape id="W1854_Lane1_di" bpmnElement="W1854_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
