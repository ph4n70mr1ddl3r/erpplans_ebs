    <bpmn:process id="W_W1857" name="W1857. Lease Termination &amp; Move-Out Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Store closure decision (W703); lease expiry without renewal; early termination per lease clause
Frequency: ~2–5 lease terminations/year
Volume: 1 property per termination
Owner: COO
Participants: COO, Legal Counsel, Store Operations, Finance, VP Store Operations
Source: workflow W1857 — Lease Termination &amp; Move-Out Coordination</bpmn:documentation>
      <bpmn:laneSet id="W1857_LaneSet5">
        <bpmn:lane id="W1857_Lane1" name="COO">
        <bpmn:flowNodeRef>W1857_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1857_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1857_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1857_Lane2" name="Store Operations">
        <bpmn:flowNodeRef>W1857_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1857_Lane3" name="Finance">
        <bpmn:flowNodeRef>W1857_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1857_Lane4" name="Legal">
        <bpmn:flowNodeRef>W1857_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1857_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1857_Start6" name="Store closure decision (W703); lease expiry without renewal; early termination per lease…">
        <bpmn:outgoing>W1857_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1857_Task7" name="COO reviews termination provisions in lease agreement: (a) notice period…">
        <bpmn:documentation>Step 1: COO reviews termination provisions in lease agreement: (a) notice period required (typically 6–12 months for early termination; 3–6 months for non-renewal at expiry), (b) early termination penalty (if applicable): typically 3–6 months&#x27; rent or unamortized TI allowance, (c) restoration obligations: condition in which property must be returned to landlord (original condition minus fair wear and tear), (d) security deposit return conditions
Responsible (R): COO
Accountable (A): Legal Counsel
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1857_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1857_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1857_Task8" name="COO issues formal termination notice to landlord per lease provisions; Legal…">
        <bpmn:documentation>Step 2: COO issues formal termination notice to landlord per lease provisions; Legal Counsel reviews notice for compliance with lease terms and Civil Code requirements
Responsible (R): COO / Legal
Accountable (A): COO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1857_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1857_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1857_Task9" name="Store Operations coordinates move-out: (a) store closure per W703 (store…">
        <bpmn:documentation>Step 3: Store Operations coordinates move-out: (a) store closure per W703 (store closure, consolidation &amp; asset recovery), (b) inventory redistribution to other stores or DC per W45 (closure redistribution), (c) fixture and equipment removal: reusable fixtures relocated; permanent modifications restored per landlord requirements, (d) property handover walkthrough with landlord representative: document condition, agree on restoration scope, (e) coordinate security deposit return
Responsible (R): Store Operations
Accountable (A): VP Store Operations
Duration: 4–8 weeks</bpmn:documentation>
        <bpmn:incoming>W1857_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1857_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1857_Task10" name="Finance processes termination accounting: (a) derecognize PFRS 16 ROU asset and…">
        <bpmn:documentation>Step 4: Finance processes termination accounting: (a) derecognize PFRS 16 ROU asset and lease liability, (b) recognize termination gain/loss, (c) process early termination penalty payment if applicable, (d) process security deposit return, (e) update lease register: close lease record
Responsible (R): Finance
Accountable (A): CFO
Duration: Per accounting close</bpmn:documentation>
        <bpmn:incoming>W1857_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1857_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1857_Task11" name="Post-termination: (a) Legal Counsel confirms all obligations fulfilled…">
        <bpmn:documentation>Step 5: Post-termination: (a) Legal Counsel confirms all obligations fulfilled; landlord provides written release, (b) COO archives terminated lease file, (c) if relocation: coordinate with W702 (new store opening) for replacement location
Responsible (R): Legal / COO
Accountable (A): COO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1857_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1857_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1857_End12" name="Complete">
        <bpmn:incoming>W1857_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1857_Annotation13">
        <bpmn:text>Controls: - CTL-367 (ensure controlled execution — Lease Negotiation &amp; Administration (PA-42.1).) | - operational: COO review and approval gate
Owner: COO</bpmn:text>
      </bpmn:textAnnotation>
