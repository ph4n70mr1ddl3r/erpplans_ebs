    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1855" name="W1855. Lease Agreement Registration, Document Management &amp; Key Date Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Lease agreement executed (W1854)
Frequency: ~10–15 new leases/year; ongoing management of ~205 active leases
Volume: ~205 active lease agreements
Owner: Lease Administrator (Finance / Real Estate)
Participants: Lease Administrator, Legal Counsel, COO, Finance
Source: workflow W1855 — Lease Agreement Registration, Document Management &amp; Key Date Tracking</bpmn:documentation>
      <bpmn:laneSet id="W1855_LaneSet3">
        <bpmn:lane id="W1855_Lane1" name="Lease Administrator">
        <bpmn:flowNodeRef>W1855_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1855_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1855_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1855_Lane2" name="System">
        <bpmn:flowNodeRef>W1855_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1855_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1855_Start4" name="Lease agreement executed (W1854)">
        <bpmn:outgoing>W1855_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1855_Task5" name="Lease Administrator registers new lease in Oracle Property Manager (fit-gap…">
        <bpmn:documentation>Step 1: Lease Administrator registers new lease in Oracle Property Manager (fit-gap F3): (a) lease number, landlord, property address, entity (BuildRight Property Management, Inc.), (b) key dates: commencement, expiry, renewal option deadline, rent escalation dates, break clause dates, (c) financial terms: base rent, CAM charges, escalation schedule, security deposit, (d) special conditions: exclusivity, TI allowance, maintenance responsibilities, (e) document attachment: scanned signed lease agreement, notarized copy
Responsible (R): Lease Administrator
Accountable (A): COO
Duration: 1–2 hours/lease</bpmn:documentation>
        <bpmn:incoming>W1855_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1855_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1855_Task6" name="System generates automated alerts for key lease dates: (a) renewal option…">
        <bpmn:documentation>Step 2: System generates automated alerts for key lease dates: (a) renewal option deadline: 12 months before lease expiry (option exercise deadline typically 6–9 months before expiry), (b) rent escalation: 90 days before escalation effective date, (c) lease expiry: 18 months before expiry for renewal or relocation planning, (d) break clause window: 6 months before break option deadline, (e) insurance renewal: 60 days before property insurance expiry, (f) landlord permit/license expiry: 60 days before expiry
Responsible (R): System
Accountable (A): Lease Administrator
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1855_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1855_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1855_Task7" name="Lease Administrator conducts annual lease file audit: (a) verify all key dates…">
        <bpmn:documentation>Step 3: Lease Administrator conducts annual lease file audit: (a) verify all key dates are current and accurate, (b) verify all amendments and modifications are recorded, (c) verify rent schedule matches current lease terms (including all escalations applied), (d) verify landlord contact information is current, (e) verify insurance certificates on file and current, (f) flag any leases with upcoming critical dates for action
Responsible (R): Lease Administrator
Accountable (A): COO
Duration: 1 week/year</bpmn:documentation>
        <bpmn:incoming>W1855_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1855_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1855_End8" name="Complete">
        <bpmn:incoming>W1855_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1855_Annotation9">
        <bpmn:text>Controls: - CTL-220 (ensure lease-administration &amp; PFRS 16 integrity.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Lease Administrator (Finance / Real Estate)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1855_Assoc10" sourceRef="W1855_Annotation9" targetRef="W1855_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1855_Flow11" sourceRef="W1855_Start4" targetRef="W1855_Task5" />
      <bpmn:sequenceFlow id="W1855_Flow12" sourceRef="W1855_Task5" targetRef="W1855_Task6" />
      <bpmn:sequenceFlow id="W1855_Flow13" sourceRef="W1855_Task6" targetRef="W1855_Task7" />
      <bpmn:sequenceFlow id="W1855_Flow14" sourceRef="W1855_Task7" targetRef="W1855_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1855_diag">
      <bpmndi:BPMNPlane id="W1855_plane" bpmnElement="W_W1855">
        <bpmndi:BPMNShape id="W1855_Lane1_di" bpmnElement="W1855_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1855_Lane2_di" bpmnElement="W1855_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1855_Task5_di" bpmnElement="W1855_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1855_Task6_di" bpmnElement="W1855_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1855_Task7_di" bpmnElement="W1855_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1855_Start4_di" bpmnElement="W1855_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1855_End8_di" bpmnElement="W1855_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1855_Annotation9_di" bpmnElement="W1855_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1855_Flow11_di" bpmnElement="W1855_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1855_Flow12_di" bpmnElement="W1855_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1855_Flow13_di" bpmnElement="W1855_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1855_Flow14_di" bpmnElement="W1855_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1855_Assoc10_di" bpmnElement="W1855_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1856" name="W1856. Lease Renewal Negotiation &amp; Extension Processing" isExecutable="false">
      <bpmn:documentation>Trigger: System alert: renewal option deadline approaching (12 months before lease expiry)
Frequency: ~15–25 lease renewals/year (based on ~205 active leases with 10–15 year terms; some shorter)
Volume: 1 property per renewal; renewal typically 5–10 years
Owner: COO
Participants: COO, Legal Counsel, CFO, Store Operations, Landlord
Source: workflow W1856 — Lease Renewal Negotiation &amp; Extension Processing</bpmn:documentation>
      <bpmn:laneSet id="W1856_LaneSet3">
        <bpmn:lane id="W1856_Lane1" name="COO">
        <bpmn:flowNodeRef>W1856_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1856_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1856_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1856_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1856_Lane2" name="Legal">
        <bpmn:flowNodeRef>W1856_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1856_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1856_Start4" name="System alert: renewal option deadline approaching (12 months before lease expiry)">
        <bpmn:outgoing>W1856_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1856_Task5" name="COO evaluates renewal options 12 months before lease expiry: (a) store…">
        <bpmn:documentation>Step 1: COO evaluates renewal options 12 months before lease expiry: (a) store performance: sales per sqm, profitability, foot traffic trends — is this store worth renewing? (b) market rent benchmarking: has the area appreciated? What are current market rents for comparable properties? (c) landlord relationship: any recurring issues (maintenance, disputes, access problems)? (d) alternative locations: are there better properties available in the same trade area? (e) decision: (i) renew at current location, (ii) renegotiate terms, (iii) relocate to alternative, (iv) close store (if underperforming per W703)
Responsible (R): COO
Accountable (A): COO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1856_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1856_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1856_Task6" name="If renewing: COO negotiates renewal terms with landlord: (a) target: maintain…">
        <bpmn:documentation>Step 2: If renewing: COO negotiates renewal terms with landlord: (a) target: maintain or reduce current rent; leverage store improvement to area (increased foot traffic, commercial activity) as negotiation tool, (b) renewal rent escalation: negotiate cap on escalation increase for renewal term, (c) TI refresh: request landlord contribution to store renovation/refresh for renewal commitment, (d) extended term: negotiate longer renewal term (10+ years) for rent stability
Responsible (R): COO
Accountable (A): CFO
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W1856_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1856_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1856_Task7" name="Legal Counsel reviews and executes renewal agreement; Finance updates lease…">
        <bpmn:documentation>Step 3: Legal Counsel reviews and executes renewal agreement; Finance updates lease terms in system: (a) update lease end date and financial schedule, (b) recalculate PFRS 16 ROU asset and lease liability for renewed term, (c) update key date alerts in Oracle Property Manager (fit-gap F3)
Responsible (R): Legal / Finance
Accountable (A): CFO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1856_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1856_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1856_Task8" name="If relocating: COO initiates W1854 (new site lease negotiation) for alternative…">
        <bpmn:documentation>Step 4: If relocating: COO initiates W1854 (new site lease negotiation) for alternative location and coordinates W1857 (lease termination) for current location; Store Operations coordinates store transition per W703 (store closure) and W702 (new store opening)
Responsible (R): COO
Accountable (A): COO
Duration: Per W1854 + W1857</bpmn:documentation>
        <bpmn:incoming>W1856_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1856_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1856_End9" name="Complete">
        <bpmn:incoming>W1856_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1856_Annotation10">
        <bpmn:text>Controls: - CTL-367 (ensure controlled execution — Lease Negotiation &amp; Administration (PA-42.1).) | - operational: COO review and approval gate
Owner: COO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1856_Assoc11" sourceRef="W1856_Annotation10" targetRef="W1856_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1856_Flow12" sourceRef="W1856_Start4" targetRef="W1856_Task5" />
      <bpmn:sequenceFlow id="W1856_Flow13" sourceRef="W1856_Task5" targetRef="W1856_Task6" />
      <bpmn:sequenceFlow id="W1856_Flow14" sourceRef="W1856_Task6" targetRef="W1856_Task7" />
      <bpmn:sequenceFlow id="W1856_Flow15" sourceRef="W1856_Task7" targetRef="W1856_Task8" />
