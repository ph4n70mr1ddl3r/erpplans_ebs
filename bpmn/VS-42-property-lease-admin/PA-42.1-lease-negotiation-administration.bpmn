      <bpmndi:BPMNPlane id="W1861_plane" bpmnElement="W_W1861">
        <bpmndi:BPMNShape id="W1861_Lane1_di" bpmnElement="W1861_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1861_Task4_di" bpmnElement="W1861_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1861_Task5_di" bpmnElement="W1861_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1861_Task6_di" bpmnElement="W1861_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1861_Start3_di" bpmnElement="W1861_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1861_End7_di" bpmnElement="W1861_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
