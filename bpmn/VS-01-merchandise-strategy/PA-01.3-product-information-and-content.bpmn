<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-01.3-product-information-and-content" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W50" name="W50. Product Information Management (PIM)" isExecutable="false">
      <bpmn:documentation>Trigger: New SKU creation (W1), seasonal item setup (W32), product content refresh cycle, vendor product update
Frequency: Continuous; ~1,500–2,500 new SKUs/year + seasonal rotations + content refreshes
Volume: 35,000 active SKUs requiring product content; ~55,000 total in item master
Owner: Marketing — Content Manager
Participants: Content Manager, Content Specialist, Merchandise Planner, Category Manager, Ecom Team, Photographer
Source: workflow W50 — Product Information Management (PIM)</bpmn:documentation>
      <bpmn:laneSet id="W50_LaneSet4">
        <bpmn:lane id="W50_Lane1" name="System">
        <bpmn:flowNodeRef>W50_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W50_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W50_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W50_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W50_Lane2" name="Content Manager">
        <bpmn:flowNodeRef>W50_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W50_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W50_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W50_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W50_Lane3" name="Content Specialist">
        <bpmn:flowNodeRef>W50_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W50_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W50_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W50_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W50_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W50_Start5" name="New SKU creation (W1), seasonal item setup (W32), product content refresh cycle, vendor…">
        <bpmn:outgoing>W50_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W50_Task6" name="Trigger: Merchandise Planner creates new SKU in item master per W1.7 (or…">
        <bpmn:documentation>Step 1: Trigger: Merchandise Planner creates new SKU in item master per W1.7 (or seasonal setup per W32); system flags SKU as &quot;content pending&quot; — item cannot be published to ecommerce until content is complete
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W50_Flow20</bpmn:incoming>
        <bpmn:outgoing>W50_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W50_Task7" name="Content Manager receives new SKU content request from system queue; assigns to…">
        <bpmn:documentation>Step 2: Content Manager receives new SKU content request from system queue; assigns to Content Specialist by category
Responsible (R): Content Manager
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W50_Flow21</bpmn:incoming>
        <bpmn:outgoing>W50_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W50_Task8" name="Content Specialist gathers product information: (a) vendor product data sheet…">
        <bpmn:documentation>Step 3: Content Specialist gathers product information: (a) vendor product data sheet (specs, dimensions, weight, material, finish, color options), (b) Category Manager input (key selling points, target customer, recommended use), (c) competitive product content benchmarking
Responsible (R): Content Specialist
Accountable (A): Content Manager
Duration: 15–30 min/SKU</bpmn:documentation>
        <bpmn:incoming>W50_Flow22</bpmn:incoming>
        <bpmn:outgoing>W50_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W50_Task9" name="Content Specialist enriches product data in PIM/ERP: (a) completes all…">
        <bpmn:documentation>Step 4: Content Specialist enriches product data in PIM/ERP: (a) completes all mandatory attributes per category schema (e.g., tiles: material, size mm, thickness, finish, PEI rating, pieces per sqm; lumber: species, dimensions, treatment, grade; paint: base type, coverage area, drying time, finish), (b) writes short description (50–100 chars for search results), (c) writes long description (200–500 chars for product page — features, benefits, application), (d) maps to category navigation path, (e) assigns search keywords and synonyms, (f) links related accessories and cross-sell items
Responsible (R): Content Specialist
Accountable (A): Content Manager
Duration: 20–30 min/SKU</bpmn:documentation>
        <bpmn:incoming>W50_Flow23</bpmn:incoming>
        <bpmn:outgoing>W50_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W50_Task10" name="Product photography: (a) for new SKUs with high online potential (A/B items)…">
        <bpmn:documentation>Step 5: Product photography: (a) for new SKUs with high online potential (A/B items): schedule product shoot with photographer (studio or on-location for large items); produce 3–5 images per SKU (front, detail, lifestyle/context, dimensions reference, packaging), (b) for C-items and low online potential: use vendor-provided images or placeholder category image with &quot;image coming soon&quot; flag; system marks these items for prioritized photography during quarterly content refresh
Responsible (R): Content Specialist / Photographer
Accountable (A): Content Manager
Duration: Shoot: 5–10 min/SKU</bpmn:documentation>
        <bpmn:incoming>W50_Flow24</bpmn:incoming>
        <bpmn:outgoing>W50_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W50_Task11" name="Content Specialist uploads and links digital assets (images, PDFs for spec…">
        <bpmn:documentation>Step 6: Content Specialist uploads and links digital assets (images, PDFs for spec sheets, installation guides, safety data sheets) to SKU record in PIM/ERP
Responsible (R): Content Specialist
Accountable (A): Content Manager
Duration: 5 min/SKU</bpmn:documentation>
        <bpmn:incoming>W50_Flow25</bpmn:incoming>
        <bpmn:outgoing>W50_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W50_Task12" name="Content Manager reviews and approves completed content per SKU; checks…">
        <bpmn:documentation>Step 7: Content Manager reviews and approves completed content per SKU; checks attribute completeness, description quality, image quality, and keyword relevance
Responsible (R): Content Manager
Accountable (A): CMO
Duration: 5 min/SKU</bpmn:documentation>
        <bpmn:incoming>W50_Flow26</bpmn:incoming>
        <bpmn:outgoing>W50_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W50_Task13" name="System publishes approved content to ecommerce platform (catalog sync); updates…">
        <bpmn:documentation>Step 8: System publishes approved content to ecommerce platform (catalog sync); updates in-store kiosk and POS product lookup if applicable; clears &quot;content pending&quot; flag
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W50_Flow27</bpmn:incoming>
        <bpmn:outgoing>W50_Flow28</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W50_Task14" name="For items with vendor-provided content only: system publishes with &quot;vendor…">
        <bpmn:documentation>Step 9: For items with vendor-provided content only: system publishes with &quot;vendor content — not verified&quot; tag visible to Content Manager; these items prioritized for enrichment during quarterly refresh
Responsible (R): System
Accountable (A): Content Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W50_Flow28</bpmn:incoming>
        <bpmn:outgoing>W50_Flow29</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W50_Task15" name="Quarterly content refresh">
        <bpmn:documentation>Step 10: Quarterly content refresh: Content Manager reviews content quality metrics (incomplete attributes, missing images, low search ranking, high bounce rate on product pages); prioritizes 500–1,000 SKUs for content improvement per quarter
Responsible (R): Content Manager
Accountable (A): CMO
Duration: 8 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W50_Flow29</bpmn:incoming>
        <bpmn:outgoing>W50_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W50_Task16" name="Seasonal catalog refresh">
        <bpmn:documentation>Step 11: Seasonal catalog refresh: before each major promotional period (W13), Content Manager coordinates with Marketing for seasonal landing pages, featured product collections, and updated lifestyle imagery
Responsible (R): Content Manager
Accountable (A): CMO
Duration: Per W13 lead time</bpmn:documentation>
        <bpmn:incoming>W50_Flow30</bpmn:incoming>
        <bpmn:outgoing>W50_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W50_End17" name="Complete">
        <bpmn:incoming>W50_Flow31</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W50_Annotation18">
        <bpmn:text>Controls: - CTL-242 (ensure controlled execution — Product Information &amp; Content (PA-01.3).) | - operational: Marketing — Content Manager review and approval gate
Owner: Marketing — Content Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W50_Assoc19" sourceRef="W50_Annotation18" targetRef="W50_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W50_Flow20" sourceRef="W50_Start5" targetRef="W50_Task6" />
      <bpmn:sequenceFlow id="W50_Flow21" sourceRef="W50_Task6" targetRef="W50_Task7" />
      <bpmn:sequenceFlow id="W50_Flow22" sourceRef="W50_Task7" targetRef="W50_Task8" />
      <bpmn:sequenceFlow id="W50_Flow23" sourceRef="W50_Task8" targetRef="W50_Task9" />
      <bpmn:sequenceFlow id="W50_Flow24" sourceRef="W50_Task9" targetRef="W50_Task10" />
      <bpmn:sequenceFlow id="W50_Flow25" sourceRef="W50_Task10" targetRef="W50_Task11" />
      <bpmn:sequenceFlow id="W50_Flow26" sourceRef="W50_Task11" targetRef="W50_Task12" />
      <bpmn:sequenceFlow id="W50_Flow27" sourceRef="W50_Task12" targetRef="W50_Task13" />
      <bpmn:sequenceFlow id="W50_Flow28" sourceRef="W50_Task13" targetRef="W50_Task14" />
      <bpmn:sequenceFlow id="W50_Flow29" sourceRef="W50_Task14" targetRef="W50_Task15" />
      <bpmn:sequenceFlow id="W50_Flow30" sourceRef="W50_Task15" targetRef="W50_Task16" />
      <bpmn:sequenceFlow id="W50_Flow31" sourceRef="W50_Task16" targetRef="W50_End17" />
    </bpmn:process>
