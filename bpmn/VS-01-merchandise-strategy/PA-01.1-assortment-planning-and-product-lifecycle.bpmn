        <bpmndi:BPMNEdge id="W279_Flow17_di" bpmnElement="W279_Flow17"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W279_Flow18_di" bpmnElement="W279_Flow18"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W279_Flow19_di" bpmnElement="W279_Flow19"><di:waypoint x="1210" y="675" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W279_Flow20_di" bpmnElement="W279_Flow20"><di:waypoint x="1420" y="165" /><di:waypoint x="1470" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W279_Assoc14_di" bpmnElement="W279_Assoc14"><di:waypoint x="340" y="800" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W564" name="W564. New Product Introduction (NPI) &amp; Full Store Rollout" isExecutable="false">
      <bpmn:documentation>Trigger: Category Manager approves national rollout after successful pilot completion per W64; or urgent market response to competitor/trend requires expedited launch
Frequency: ~15–20 NPI rollouts per year (major category introductions); ~100–200 minor SKU additions per month (routine assortment expansion)
Volume: Each major rollout affects 200 stores with 3–50 new SKUs; annual new SKU introduction ~1,500–2,500 (replacing discontinued items; the corpus canon per W50/W68 and the 125–210/month band)
Owner: Category Manager / VP Merchandising
Participants: Category Manager, Buyer, Pricing Analyst, Supply Planning Manager, Visual Merchandising Lead (C), Store Operations Coordinator (C), IT (C for master data), Marketing Specialist (C for launch campaign)
Source: workflow W564 — New Product Introduction (NPI) &amp; Full Store Rollout</bpmn:documentation>
      <bpmn:laneSet id="W564_LaneSet11">
        <bpmn:lane id="W564_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W564_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W564_Task25</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W564_Task26</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W564_Start12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W564_Lane2" name="VP Merchandising">
        <bpmn:flowNodeRef>W564_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W564_Lane3" name="Buyer">
        <bpmn:flowNodeRef>W564_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W564_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W564_Lane4" name="Pricing Analyst">
        <bpmn:flowNodeRef>W564_Task17</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W564_Lane5" name="Supply Planning Manager">
        <bpmn:flowNodeRef>W564_Task18</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W564_Lane6" name="Visual Merchandising Lead">
        <bpmn:flowNodeRef>W564_Task19</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W564_Lane7" name="Marketing Specialist">
        <bpmn:flowNodeRef>W564_Task20</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W564_Lane8" name="Store Operations Coordinator">
        <bpmn:flowNodeRef>W564_Task21</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W564_Lane9" name="Department Supervisors">
        <bpmn:flowNodeRef>W564_Task22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W564_Task23</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W564_Lane10" name="System">
        <bpmn:flowNodeRef>W564_Task24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W564_End27</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W564_Start12" name="Category Manager approves national rollout after successful pilot completion per W64; or…">
        <bpmn:outgoing>W564_Flow30</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W564_Task13" name="Rollout decision">
        <bpmn:documentation>Step 1: Rollout decision: Category Manager reviews W64 pilot results (sell-through rate, margin, customer feedback, operational issues) and recommends national rollout with target store count and timeline
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W564_Flow30</bpmn:incoming>
        <bpmn:outgoing>W564_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W564_Task14" name="VP Merchandising approves rollout and assigns launch budget (product cost…">
        <bpmn:documentation>Step 2: VP Merchandising approves rollout and assigns launch budget (product cost, marketing spend, store setup materials)
Responsible (R): VP Merchandising
Accountable (A): CEO (if budget &gt; threshold)
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W564_Flow31</bpmn:incoming>
        <bpmn:outgoing>W564_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W564_Task15" name="Vendor negotiation">
        <bpmn:documentation>Step 3: Vendor negotiation: Buyer negotiates national volume pricing with vendor — confirm supply capacity for 200-store demand (lead time, minimum order quantity, delivery schedule)
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W564_Flow32</bpmn:incoming>
        <bpmn:outgoing>W564_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W564_Task16" name="Item master creation per W252">
        <bpmn:documentation>Step 4: Item master creation per W252: new SKUs created with full attributes, pricing, UOM, barcode per W311, vendor linkage, replenishment parameters per W312, and product lifecycle status &quot;New&quot; per W315
Responsible (R): Buyer / IT
Accountable (A): Category Manager
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W564_Flow33</bpmn:incoming>
        <bpmn:outgoing>W564_Flow34</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W564_Task17" name="Pricing configuration">
        <bpmn:documentation>Step 5: Pricing configuration: Pricing Analyst configures pricing hierarchy: SRP, trade price, quantity breaks, promotional launch pricing (if applicable) per W289 and W40
Responsible (R): Pricing Analyst
Accountable (A): Category Manager
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W564_Flow34</bpmn:incoming>
        <bpmn:outgoing>W564_Flow35</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W564_Task18" name="Supply chain ramp-up">
        <bpmn:documentation>Step 6: Supply chain ramp-up: Supply Planning Manager creates initial purchase order for national rollout quantity (200 stores × allocation per store × buffer); schedule DC inbound per W3
Responsible (R): Supply Planning Manager
Accountable (A): Category Manager
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W564_Flow35</bpmn:incoming>
        <bpmn:outgoing>W564_Flow36</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W564_Task19" name="Planogram integration">
        <bpmn:documentation>Step 7: Planogram integration: Visual Merchandising Lead assigns new SKUs to planogram positions per W314; determine which existing SKUs are displaced (discontinuation per W68 or shelf position swap)
Responsible (R): Visual Merchandising Lead
Accountable (A): Category Manager
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W564_Flow36</bpmn:incoming>
        <bpmn:outgoing>W564_Flow37</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W564_Task20" name="Launch materials preparation">
        <bpmn:documentation>Step 8: Launch materials preparation: Marketing Specialist prepares shelf talkers, POS display materials, digital content per W316, social media posts per W142, and campaign setup per W83
Responsible (R): Marketing Specialist
Accountable (A): Category Manager
Duration: 4–6 hours</bpmn:documentation>
        <bpmn:incoming>W564_Flow37</bpmn:incoming>
        <bpmn:outgoing>W564_Flow38</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W564_Task21" name="Store communication per W571">
        <bpmn:documentation>Step 9: Store communication per W571: Store Operations Coordinator distributes NPI package to stores — product information sheet, planogram change instructions, pricing update, launch date, and staff talking points
Responsible (R): Store Operations Coordinator
Accountable (A): VP Store Operations
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W564_Flow38</bpmn:incoming>
        <bpmn:outgoing>W564_Flow39</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W564_Task22" name="Store setup execution (T-7 days before launch)">
        <bpmn:documentation>Step 10: Store setup execution (T-7 days before launch): Department Supervisors prepare shelf space per planogram update, Stock Associates print and install shelf labels per W181, and POS promotional setup per W523
Responsible (R): Department Supervisors / Stock Associates
Accountable (A): Store Manager
Duration: 2–4 hours/store</bpmn:documentation>
        <bpmn:incoming>W564_Flow39</bpmn:incoming>
        <bpmn:outgoing>W564_Flow40</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W564_Task23" name="Staff training">
        <bpmn:documentation>Step 11: Staff training: Department Supervisors brief Sales Associates on new products — key features, selling points, common customer questions, and competitive positioning per W51
Responsible (R): Department Supervisors
Accountable (A): Store Manager
Duration: 30–60 min/department</bpmn:documentation>
        <bpmn:incoming>W564_Flow40</bpmn:incoming>
        <bpmn:outgoing>W564_Flow41</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W564_Task24" name="Launch day">
        <bpmn:documentation>Step 12: Launch day: new SKUs activated in POS and e-commerce simultaneously; marketing campaign goes live per W83; real-time sell-through monitoring begins
Responsible (R): System / Category Manager
Accountable (A): VP Merchandising
Duration: Monitoring: continuous</bpmn:documentation>
        <bpmn:incoming>W564_Flow41</bpmn:incoming>
        <bpmn:outgoing>W564_Flow42</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W564_Task25" name="Post-launch monitoring (T+7 days)">
        <bpmn:documentation>Step 13: Post-launch monitoring (T+7 days): daily sell-through data by store; identify slow-adopting stores for additional support; monitor inventory levels for reorder per W2A
Responsible (R): Category Manager / Supply Planning
Accountable (A): VP Merchandising
Duration: 1 hour/day for 7 days</bpmn:documentation>
        <bpmn:incoming>W564_Flow42</bpmn:incoming>
        <bpmn:outgoing>W564_Flow43</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W564_Task26" name="Post-launch review (T+30 days)">
        <bpmn:documentation>Step 14: Post-launch review (T+30 days): Category Manager evaluates rollout performance vs. pilot benchmarks — sell-through rate, margin, store compliance, customer feedback; recommend continue, adjust, or discontinue
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W564_Flow43</bpmn:incoming>
        <bpmn:outgoing>W564_Flow44</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W564_End27" name="Complete">
        <bpmn:incoming>W564_Flow44</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W564_Annotation28">
        <bpmn:text>Controls: - CTL-240 (ensure controlled execution — Assortment Planning &amp; Product Lifecycle (PA-01.1).) | - operational: Category Manager / VP Merchandising review and approval gate
Owner: Category Manager / VP Merchandising</bpmn:text>
      </bpmn:textAnnotation>
