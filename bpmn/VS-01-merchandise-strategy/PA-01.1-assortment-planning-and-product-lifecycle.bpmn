      <bpmn:sequenceFlow id="W1220_Flow22" sourceRef="W1220_Task11" targetRef="W1220_Task12" />
      <bpmn:sequenceFlow id="W1220_Flow23" sourceRef="W1220_Task12" targetRef="W1220_End13" />
    </bpmn:process>
