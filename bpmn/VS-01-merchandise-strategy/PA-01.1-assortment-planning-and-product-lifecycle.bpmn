<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-01.1-assortment-planning-and-product-lifecycle" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1" name="W1. Merchandise Planning &amp; Assortment Review" isExecutable="false">
      <bpmn:documentation>Trigger: Seasonal calendar and quarterly business review
Frequency: Quarterly (4×/year)
Volume: ~8,750 SKUs reviewed per quarter (35,000 ÷ 4)
Owner: VP Merchandising
Participants: Category Managers, Buyers, Pricing Analysts, Merchandise Planners, Store Operations rep
Source: workflow W1 — Merchandise Planning &amp; Assortment Review</bpmn:documentation>
      <bpmn:laneSet id="W1_LaneSet5">
        <bpmn:lane id="W1_Lane1" name="Pricing Analyst">
        <bpmn:flowNodeRef>W1_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W1_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1_Lane3" name="Buyer">
        <bpmn:flowNodeRef>W1_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1_Lane4" name="Merchandise Planner">
        <bpmn:flowNodeRef>W1_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1_Start6" name="Seasonal calendar and quarterly business review">
        <bpmn:outgoing>W1_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1_Task7" name="Pull category performance report (sales, margin, turns, sell-through)">
        <bpmn:documentation>Step 1: Pull category performance report (sales, margin, turns, sell-through)
Responsible (R): Pricing Analyst
Accountable (A): Category Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W1_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1_Task8" name="Identify underperformers (bottom 10% by revenue/sqm, negative margin, &lt; 2…">
        <bpmn:documentation>Step 2: Identify underperformers (bottom 10% by revenue/sqm, negative margin, &lt; 2 turns/year)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 3 hours</bpmn:documentation>
        <bpmn:incoming>W1_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1_Task9" name="Review seasonal calendar and upcoming promotional events">
        <bpmn:documentation>Step 3: Review seasonal calendar and upcoming promotional events
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W1_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1_Task10" name="Propose assortment changes: add new SKUs, discontinue slow movers, adjust…">
        <bpmn:documentation>Step 4: Propose assortment changes: add new SKUs, discontinue slow movers, adjust depth/breadth
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W1_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1_Task11" name="Validate proposed changes against vendor contracts and minimum order quantities">
        <bpmn:documentation>Step 5: Validate proposed changes against vendor contracts and minimum order quantities
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W1_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1_Task12" name="Present assortment plan to VP Merchandising for approval">
        <bpmn:documentation>Step 6: Present assortment plan to VP Merchandising for approval
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 2 hours (meeting)</bpmn:documentation>
        <bpmn:incoming>W1_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1_Task13" name="Update item master: create new SKUs, flag discontinued items, set…">
        <bpmn:documentation>Step 7: Update item master: create new SKUs, flag discontinued items, set discontinuation dates
Responsible (R): Merchandise Planner
Accountable (A): Category Manager
Duration: 3 hours</bpmn:documentation>
        <bpmn:incoming>W1_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1_Task14" name="Communicate changes to stores via bulletin / system alert">
        <bpmn:documentation>Step 8: Communicate changes to stores via bulletin / system alert
Responsible (R): Merchandise Planner
Accountable (A): VP Merchandising
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W1_Flow25</bpmn:incoming>
        <bpmn:outgoing>W1_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1_End15" name="Complete">
        <bpmn:incoming>W1_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1_Annotation16">
        <bpmn:text>Controls: - CTL-240 (ensure controlled execution — Assortment Planning &amp; Product Lifecycle (PA-01.1).) | - operational: VP Merchandising review and approval gate
Owner: VP Merchandising</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1_Assoc17" sourceRef="W1_Annotation16" targetRef="W1_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1_Flow18" sourceRef="W1_Start6" targetRef="W1_Task7" />
      <bpmn:sequenceFlow id="W1_Flow19" sourceRef="W1_Task7" targetRef="W1_Task8" />
      <bpmn:sequenceFlow id="W1_Flow20" sourceRef="W1_Task8" targetRef="W1_Task9" />
      <bpmn:sequenceFlow id="W1_Flow21" sourceRef="W1_Task9" targetRef="W1_Task10" />
      <bpmn:sequenceFlow id="W1_Flow22" sourceRef="W1_Task10" targetRef="W1_Task11" />
      <bpmn:sequenceFlow id="W1_Flow23" sourceRef="W1_Task11" targetRef="W1_Task12" />
      <bpmn:sequenceFlow id="W1_Flow24" sourceRef="W1_Task12" targetRef="W1_Task13" />
      <bpmn:sequenceFlow id="W1_Flow25" sourceRef="W1_Task13" targetRef="W1_Task14" />
      <bpmn:sequenceFlow id="W1_Flow26" sourceRef="W1_Task14" targetRef="W1_End15" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1_diag">
      <bpmndi:BPMNPlane id="W1_plane" bpmnElement="W_W1">
        <bpmndi:BPMNShape id="W1_Lane1_di" bpmnElement="W1_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2000" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1_Lane2_di" bpmnElement="W1_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="2000" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1_Lane3_di" bpmnElement="W1_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="2000" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1_Lane4_di" bpmnElement="W1_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="2000" height="170" /></bpmndi:BPMNShape>
