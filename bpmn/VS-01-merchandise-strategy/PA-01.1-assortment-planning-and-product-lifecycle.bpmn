    <bpmn:process id="W_W679" name="W679. Assortment Optimization &amp; Rationalization Review" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly assortment review cycle; seasonal transition planning
Frequency: Quarterly comprehensive review; monthly performance monitoring
Volume: 35,000 active SKUs across 13 product categories; ~2,000–3,000 SKUs deep-reviewed each quarter (the full base rotates through W1&#x27;s quarterly cycle at ~8,750/quarter)
Owner: Category Manager
Participants: Buyer, Pricing Analyst, Space Planning Analyst, VP Merchandising
Source: workflow W679 — Assortment Optimization &amp; Rationalization Review</bpmn:documentation>
      <bpmn:laneSet id="W679_LaneSet6">
        <bpmn:lane id="W679_Lane1" name="System">
        <bpmn:flowNodeRef>W679_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W679_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W679_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W679_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W679_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W679_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W679_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W679_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W679_Lane3" name="Buyer">
        <bpmn:flowNodeRef>W679_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W679_Lane4" name="Pricing Analyst">
        <bpmn:flowNodeRef>W679_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W679_Lane5" name="Space Planning Analyst">
        <bpmn:flowNodeRef>W679_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W679_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W679_Start7" name="Quarterly assortment review cycle; seasonal transition planning">
        <bpmn:outgoing>W679_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W679_Task8" name="System generates assortment performance report per category: SKU-level sales…">
        <bpmn:documentation>Step 1: System generates assortment performance report per category: SKU-level sales velocity (units/week), gross margin contribution, inventory turns, shelf space productivity (revenue per sqm per SKU), and assortment breadth vs. competitor benchmark per W624
Responsible (R): System (automated)
Accountable (A): Category Manager
Duration: Overnight</bpmn:documentation>
        <bpmn:incoming>W679_Flow20</bpmn:incoming>
        <bpmn:outgoing>W679_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W679_Task9" name="Category Manager identifies rationalization candidates: SKUs with sales…">
        <bpmn:documentation>Step 2: Category Manager identifies rationalization candidates: SKUs with sales velocity below category threshold (bottom 10% by units), SKUs with negative margin after markdown, duplicate/substitute SKUs with &lt; 5% unique sales, and SKUs with declining trend &gt; 3 consecutive months
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W679_Flow21</bpmn:incoming>
        <bpmn:outgoing>W679_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W679_Task10" name="Category Manager identifies assortment gaps: sub-categories where BuildRight…">
        <bpmn:documentation>Step 3: Category Manager identifies assortment gaps: sub-categories where BuildRight has fewer SKUs than competitor benchmark, high-search/zero-result queries from ecommerce per W563, customer requests logged via W41/W507, and vendor new product proposals
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W679_Flow22</bpmn:incoming>
        <bpmn:outgoing>W679_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W679_Task11" name="Buyer evaluates vendor landscape for gap filling: identifies potential new…">
        <bpmn:documentation>Step 4: Buyer evaluates vendor landscape for gap filling: identifies potential new vendors per W36, requests product samples, negotiates introductory pricing
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W679_Flow23</bpmn:incoming>
        <bpmn:outgoing>W679_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W679_Task12" name="Pricing Analyst performs margin analysis on proposed new SKUs: landed cost…">
        <bpmn:documentation>Step 5: Pricing Analyst performs margin analysis on proposed new SKUs: landed cost estimation per FIN-013, target margin calculation, competitive price positioning per W130, and projected sales volume based on category benchmarks
Responsible (R): Pricing Analyst
Accountable (A): Category Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W679_Flow24</bpmn:incoming>
        <bpmn:outgoing>W679_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W679_Task13" name="Space Planning Analyst assesses shelf space impact: planogram capacity per…">
        <bpmn:documentation>Step 6: Space Planning Analyst assesses shelf space impact: planogram capacity per W314, displacement analysis (which existing SKUs lose space), and total category space productivity projection
Responsible (R): Space Planning Analyst
Accountable (A): Category Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W679_Flow25</bpmn:incoming>
        <bpmn:outgoing>W679_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W679_Task14" name="Category Manager presents assortment change proposal to VP Merchandising…">
        <bpmn:documentation>Step 7: Category Manager presents assortment change proposal to VP Merchandising: recommended additions (with projected incremental revenue and margin), recommended discontinuations (with inventory disposition plan per W587/W588), and net impact on category P&amp;L per W102
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W679_Flow26</bpmn:incoming>
        <bpmn:outgoing>W679_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W679_Task15" name="VP Merchandising approves assortment changes; Category Manager executes…">
        <bpmn:documentation>Step 8: VP Merchandising approves assortment changes; Category Manager executes: creates new item masters per W252, initiates discontinuation per W68, updates planograms per W314, coordinates first PO and DC receiving
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W679_Flow27</bpmn:incoming>
        <bpmn:outgoing>W679_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W679_Task16" name="Monthly: Category Manager monitors new SKU performance (sell-through rate vs…">
        <bpmn:documentation>Step 9: Monthly: Category Manager monitors new SKU performance (sell-through rate vs. projection at T+30/T+60/T+90) and discontinued SKU sell-down progress
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W679_Flow28</bpmn:incoming>
        <bpmn:outgoing>W679_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W679_End17" name="Complete">
        <bpmn:incoming>W679_Flow29</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W679_Annotation18">
        <bpmn:text>Controls: - CTL-240 (ensure controlled execution — Assortment Planning &amp; Product Lifecycle (PA-01.1).) | - operational: Category Manager review and approval gate
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W679_Assoc19" sourceRef="W679_Annotation18" targetRef="W679_Start7" associationDirection="None" />
