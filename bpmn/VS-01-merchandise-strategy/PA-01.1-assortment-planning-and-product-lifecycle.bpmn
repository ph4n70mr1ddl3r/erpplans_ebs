        <bpmndi:BPMNEdge id="W1_Flow26_di" bpmnElement="W1_Flow26"><di:waypoint x="2050" y="675" /><di:waypoint x="2100" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1_Assoc17_di" bpmnElement="W1_Assoc17"><di:waypoint x="340" y="800" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W64" name="W64. New Product Pilot / Store Test" isExecutable="false">
      <bpmn:documentation>Trigger: Buyer or Category Manager proposes new SKU for chain-wide rollout but wants to validate demand before committing to full distribution
Frequency: ~20–30 product pilots/year
Volume: Typically 5–20 SKUs per pilot; tested in 10–20 stores for 4–8 weeks
Owner: Category Manager
Participants: Category Manager, Buyer, Pricing Analyst, Supply Planner, Store Managers (pilot stores)
Source: workflow W64 — New Product Pilot / Store Test</bpmn:documentation>
      <bpmn:laneSet id="W64_LaneSet6">
        <bpmn:lane id="W64_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W64_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W64_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W64_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W64_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W64_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W64_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W64_Lane2" name="Buyer">
        <bpmn:flowNodeRef>W64_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W64_Lane3" name="Supply Planner">
        <bpmn:flowNodeRef>W64_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W64_Lane4" name="Pricing Analyst">
        <bpmn:flowNodeRef>W64_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W64_Lane5" name="Merchandise Planner">
        <bpmn:flowNodeRef>W64_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W64_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W64_Start7" name="Buyer or Category Manager proposes new SKU for chain-wide rollout but wants to validate…">
        <bpmn:outgoing>W64_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W64_Task8" name="Category Manager identifies new SKU for pilot testing; defines hypothesis…">
        <bpmn:documentation>Step 1: Category Manager identifies new SKU for pilot testing; defines hypothesis: target customer segment, expected sell-through rate, margin target, shelf space requirement, and success criteria (units/week/store above threshold)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1–2 hours/pilot</bpmn:documentation>
        <bpmn:incoming>W64_Flow20</bpmn:incoming>
        <bpmn:outgoing>W64_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W64_Task9" name="Category Manager selects pilot stores: criteria include (a) representative mix…">
        <bpmn:documentation>Step 2: Category Manager selects pilot stores: criteria include (a) representative mix of store sizes and locations, (b) region diversity (Luzon/Visayas/Mindanao), (c) store manager capability and willingness, (d) existing demand for similar items in the category
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1 hour/pilot</bpmn:documentation>
        <bpmn:incoming>W64_Flow21</bpmn:incoming>
        <bpmn:outgoing>W64_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W64_Task10" name="Buyer sources pilot quantity from vendor (may negotiate consignment or…">
        <bpmn:documentation>Step 3: Buyer sources pilot quantity from vendor (may negotiate consignment or vendor-funded trial terms); Merchandise Planner creates SKU in item master with &quot;Pilot&quot; status flag
Responsible (R): Buyer / Merchandise Planner
Accountable (A): Category Manager
Duration: Per W2/W1</bpmn:documentation>
        <bpmn:incoming>W64_Flow22</bpmn:incoming>
        <bpmn:outgoing>W64_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W64_Task11" name="Supply Planner allocates pilot stock to selected stores only; system restricts…">
        <bpmn:documentation>Step 4: Supply Planner allocates pilot stock to selected stores only; system restricts SKU visibility and ordering to pilot stores (non-pilot stores cannot see or order the item during pilot phase)
Responsible (R): Supply Planner
Accountable (A): Supply Planning Manager
Duration: 30 min/pilot</bpmn:documentation>
        <bpmn:incoming>W64_Flow23</bpmn:incoming>
        <bpmn:outgoing>W64_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W64_Task12" name="Store Managers at pilot stores receive pilot communication: product details…">
        <bpmn:documentation>Step 5: Store Managers at pilot stores receive pilot communication: product details, target customer, shelf placement recommendation, any special handling instructions
Responsible (R): Category Manager
Accountable (A): Store Managers
Duration: 15 min/store</bpmn:documentation>
        <bpmn:incoming>W64_Flow24</bpmn:incoming>
        <bpmn:outgoing>W64_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W64_Task13" name="During pilot (4–8 weeks): Pricing Analyst monitors weekly sell-through per…">
        <bpmn:documentation>Step 6: During pilot (4–8 weeks): Pricing Analyst monitors weekly sell-through per pilot store; compares to success criteria and to similar items in the category; tracks customer feedback via Sales Associates and loyalty data
Responsible (R): Pricing Analyst
Accountable (A): Category Manager
Duration: 30 min/week</bpmn:documentation>
        <bpmn:incoming>W64_Flow25</bpmn:incoming>
        <bpmn:outgoing>W64_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W64_Task14" name="Go">
        <bpmn:documentation>Step 7: At pilot conclusion: Category Manager conducts go/no-go review with Buyer and Pricing Analyst: (a) Go — meets or exceeds success criteria; proceed with chain-wide rollout (add to assortment per W1, create standard replenishment parameters per W31), (b) No-Go — fails to meet criteria; discontinue item; disposition remaining stock per W13.9a/b (clearance/RTV), (c) Conditional Go — meets some criteria; extend pilot or modify (adjust price, change assortment depth, restrict to specific store formats)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 2 hours/pilot</bpmn:documentation>
        <bpmn:incoming>W64_Flow26</bpmn:incoming>
        <bpmn:outgoing>W64_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W64_Task15" name="If Go: Merchandise Planner removes &quot;Pilot&quot; status flag; assigns standard…">
        <bpmn:documentation>Step 8: If Go: Merchandise Planner removes &quot;Pilot&quot; status flag; assigns standard replenishment parameters (ROP, safety stock, order multiple); adds SKU to standard assortment for all stores; Supply Planner plans chain-wide distribution
Responsible (R): Merchandise Planner / Supply Planner
Accountable (A): Category Manager
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W64_Flow27</bpmn:incoming>
        <bpmn:outgoing>W64_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W64_Task16" name="Post-rollout: Category Manager monitors chain-wide performance for 2–3 months…">
        <bpmn:documentation>Step 9: Post-rollout: Category Manager monitors chain-wide performance for 2–3 months; compares to pilot results; validates that pilot learnings scale
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W64_Flow28</bpmn:incoming>
        <bpmn:outgoing>W64_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W64_End17" name="Complete">
        <bpmn:incoming>W64_Flow29</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W64_Annotation18">
        <bpmn:text>Controls: - CTL-240 (ensure controlled execution — Assortment Planning &amp; Product Lifecycle (PA-01.1).) | - operational: Category Manager review and approval gate
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W64_Assoc19" sourceRef="W64_Annotation18" targetRef="W64_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W64_Flow20" sourceRef="W64_Start7" targetRef="W64_Task8" />
      <bpmn:sequenceFlow id="W64_Flow21" sourceRef="W64_Task8" targetRef="W64_Task9" />
      <bpmn:sequenceFlow id="W64_Flow22" sourceRef="W64_Task9" targetRef="W64_Task10" />
      <bpmn:sequenceFlow id="W64_Flow23" sourceRef="W64_Task10" targetRef="W64_Task11" />
      <bpmn:sequenceFlow id="W64_Flow24" sourceRef="W64_Task11" targetRef="W64_Task12" />
      <bpmn:sequenceFlow id="W64_Flow25" sourceRef="W64_Task12" targetRef="W64_Task13" />
      <bpmn:sequenceFlow id="W64_Flow26" sourceRef="W64_Task13" targetRef="W64_Task14" />
      <bpmn:sequenceFlow id="W64_Flow27" sourceRef="W64_Task14" targetRef="W64_Task15" />
      <bpmn:sequenceFlow id="W64_Flow28" sourceRef="W64_Task15" targetRef="W64_Task16" />
      <bpmn:sequenceFlow id="W64_Flow29" sourceRef="W64_Task16" targetRef="W64_End17" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W64_diag">
      <bpmndi:BPMNPlane id="W64_plane" bpmnElement="W_W64">
        <bpmndi:BPMNShape id="W64_Lane1_di" bpmnElement="W64_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2210" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W64_Lane2_di" bpmnElement="W64_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="2210" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W64_Lane3_di" bpmnElement="W64_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="2210" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W64_Lane4_di" bpmnElement="W64_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="2210" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W64_Lane5_di" bpmnElement="W64_Lane5" isHorizontal="true"><dc:Bounds x="160" y="760" width="2210" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W64_Task8_di" bpmnElement="W64_Task8"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W64_Task9_di" bpmnElement="W64_Task9"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W64_Task10_di" bpmnElement="W64_Task10"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W64_Task11_di" bpmnElement="W64_Task11"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W64_Task12_di" bpmnElement="W64_Task12"><dc:Bounds x="1240" y="125" width="180" height="80" /></bpmndi:BPMNShape>
