    <bpmn:process id="W_W5274" name="W5274. Rapid Structural Integrity and Safety Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: Established physical site access control (W5273)
Frequency: Per disaster site deployment
Volume: ~3-5 structural reviews annually
Owner: Director, Facilities &amp; Real Estate (dual-hat GM, BuildRight Property Mgmt, Inc.)
Participants: Structural Engineer, Geodetic Engineer, Store Manager, Safety Officer
Source: workflow W5274 — Rapid Structural Integrity and Safety Assessment</bpmn:documentation>
      <bpmn:laneSet id="W5274_LaneSet3">
        <bpmn:lane id="W5274_Lane1" name="Structural Engineer">
        <bpmn:flowNodeRef>W5274_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5274_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5274_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5274_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5274_Lane2" name="Safety Officer">
        <bpmn:flowNodeRef>W5274_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5274_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5274_Start4" name="Established physical site access control (W5273)">
        <bpmn:outgoing>W5274_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5274_Task5" name="Conduct visual check of structural elements (roof, beams, load-bearing walls…">
        <bpmn:documentation>Step 1: Conduct visual check of structural elements (roof, beams, load-bearing walls, foundations).
Responsible (R): Structural Engineer
Accountable (A): Director, Facilities &amp; Real Estate, Facilities &amp; Real Estate
Duration: 3-5 hours</bpmn:documentation>
        <bpmn:incoming>W5274_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5274_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5274_Task6" name="Verify structural safety using specialized testing equipment (Schmidt rebound…">
        <bpmn:documentation>Step 2: Verify structural safety using specialized testing equipment (Schmidt rebound hammer, ultrasonic).
Responsible (R): Structural Engineer
Accountable (A): Director, Facilities &amp; Real Estate, Facilities &amp; Real Estate
Duration: 2-4 hours</bpmn:documentation>
        <bpmn:incoming>W5274_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5274_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5274_Task7" name="Assess secondary hazards: electrical wire grounding, gas leaks, water main…">
        <bpmn:documentation>Step 3: Assess secondary hazards: electrical wire grounding, gas leaks, water main bursts.
Responsible (R): Safety Officer
Accountable (A): Director, Facilities &amp; Real Estate, Facilities &amp; Real Estate
Duration: 2-3 hours</bpmn:documentation>
        <bpmn:incoming>W5274_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5274_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5274_Task8" name="Draft and sign Rapid Structural Integrity Assessment Report; tag site status…">
        <bpmn:documentation>Step 4: Draft and sign Rapid Structural Integrity Assessment Report; tag site status (Green, Yellow, Red).
Responsible (R): Structural Engineer
Accountable (A): Director, Facilities &amp; Real Estate, Facilities &amp; Real Estate
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5274_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5274_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5274_End9" name="Complete">
        <bpmn:incoming>W5274_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5274_Annotation10">
        <bpmn:text>Controls: - CTL-782 (ensure controlled execution — Structural Damage &amp; Insurance Appraisal Coordination (PA-184.1).) | - operational: OHS incident prevention; facilities standards verification.
Owner: Director, Facilities &amp; Real Estate (dual-hat GM, BuildRight Property Mgmt, Inc.)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5274_Assoc11" sourceRef="W5274_Annotation10" targetRef="W5274_Start4" associationDirection="None" />
