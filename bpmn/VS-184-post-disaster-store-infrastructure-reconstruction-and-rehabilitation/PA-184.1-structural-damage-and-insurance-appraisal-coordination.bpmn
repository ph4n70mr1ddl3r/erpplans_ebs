      <bpmn:sequenceFlow id="W5275_Flow13" sourceRef="W5275_Start5" targetRef="W5275_Task6" />
      <bpmn:sequenceFlow id="W5275_Flow14" sourceRef="W5275_Task6" targetRef="W5275_Task7" />
      <bpmn:sequenceFlow id="W5275_Flow15" sourceRef="W5275_Task7" targetRef="W5275_Task8" />
      <bpmn:sequenceFlow id="W5275_Flow16" sourceRef="W5275_Task8" targetRef="W5275_Task9" />
      <bpmn:sequenceFlow id="W5275_Flow17" sourceRef="W5275_Task9" targetRef="W5275_End10" />
    </bpmn:process>
