    <bpmn:process id="W_W5275" name="W5275. Detailed Technical Damage Quantification and Geodetic Survey" isExecutable="false">
      <bpmn:documentation>Trigger: Rapid Structural Assessment tagged Yellow or Red (W5274)
Frequency: Per yellow/red tagged site
Volume: ~2-3 detailed quantifications annually
Owner: Quantity Surveyor / Project Engineer
Participants: Structural Engineer, Geodetic Engineer, Finance Analyst
Source: workflow W5275 — Detailed Technical Damage Quantification and Geodetic Survey</bpmn:documentation>
      <bpmn:laneSet id="W5275_LaneSet4">
        <bpmn:lane id="W5275_Lane1" name="Quantity Surveyor">
        <bpmn:flowNodeRef>W5275_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5275_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5275_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5275_Lane2" name="Geodetic Engineer">
        <bpmn:flowNodeRef>W5275_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5275_Lane3" name="Finance Analyst">
        <bpmn:flowNodeRef>W5275_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5275_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5275_Start5" name="Rapid Structural Assessment tagged Yellow or Red (W5274)">
        <bpmn:outgoing>W5275_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5275_Task6" name="Conduct detailed measurement of damaged structural and architectural elements.">
        <bpmn:documentation>Step 1: Conduct detailed measurement of damaged structural and architectural elements.
Responsible (R): Quantity Surveyor / Project Engineer
Accountable (A): Quantity Surveyor / Project Engineer
Duration: 4-6 hours</bpmn:documentation>
        <bpmn:incoming>W5275_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5275_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5275_Task7" name="Perform geodetic slope and soil shift surveys to check for land subsidence.">
        <bpmn:documentation>Step 2: Perform geodetic slope and soil shift surveys to check for land subsidence.
Responsible (R): Geodetic Engineer
Accountable (A): Quantity Surveyor / Project Engineer
Duration: 3-5 hours</bpmn:documentation>
        <bpmn:incoming>W5275_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5275_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5275_Task8" name="Compile Detailed Bill of Quantities (BOQ) mapping replacement materials, steel…">
        <bpmn:documentation>Step 3: Compile Detailed Bill of Quantities (BOQ) mapping replacement materials, steel, and concrete volumes.
Responsible (R): Quantity Surveyor / Project Engineer
Accountable (A): Quantity Surveyor / Project Engineer
Duration: 1-2 days</bpmn:documentation>
        <bpmn:incoming>W5275_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5275_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5275_Task9" name="Verify BOQ material costs with current price matrices and generate project…">
        <bpmn:documentation>Step 4: Verify BOQ material costs with current price matrices and generate project estimate.
Responsible (R): Finance Analyst
Accountable (A): Quantity Surveyor / Project Engineer
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W5275_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5275_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5275_End10" name="Complete">
        <bpmn:incoming>W5275_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5275_Annotation11">
        <bpmn:text>Controls: - CTL-782: ensure controlled execution — Structural Damage &amp; Insurance Appraisal Coordination (PA-184.1). — CAPA authorization controls; Director, Facilities &amp; Real Estate sign-off required.
Owner: Quantity Surveyor / Project Engineer</bpmn:text>
      </bpmn:textAnnotation>
