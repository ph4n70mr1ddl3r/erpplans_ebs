        <bpmn:documentation>Step 2: Segregate scrap steel, lumber, and copper wire; contact scrap dealer.
Responsible (R): Stock Associate
Accountable (A): Store Manager / DC Supervisor
Duration: 3-5 hours</bpmn:documentation>
        <bpmn:incoming>W5277_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5277_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5277_Task8" name="Identify hazardous materials (damaged paints, solvents) and route to certified…">
