    <bpmn:process id="W_W5278" name="W5278. Insurance Settlement Negotiation and Recovery Accounting" isExecutable="false">
      <bpmn:documentation>Trigger: Proof of Loss submitted (W5276) and adjuster evaluation report received
Frequency: Per settlement cycle
Volume: ~3-5 settlements annually
Owner: Finance Controller
Participants: Insurance Administrator, CFO, Chief Accountant (VS-17.1)
Source: workflow W5278 — Insurance Settlement Negotiation and Recovery Accounting</bpmn:documentation>
      <bpmn:laneSet id="W5278_LaneSet5">
        <bpmn:lane id="W5278_Lane1" name="Insurance Administrator">
        <bpmn:flowNodeRef>W5278_Task7</bpmn:flowNodeRef>
