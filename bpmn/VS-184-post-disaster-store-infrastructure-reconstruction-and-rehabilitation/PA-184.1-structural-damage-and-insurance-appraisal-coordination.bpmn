    <bpmn:process id="W_W5273" name="W5273. Disaster Incident Staging and Physical Site Access Control" isExecutable="false">
      <bpmn:documentation>Trigger: Typhoon, fire, or earthquake incident occurrence with structural store impact (VS-69)
Frequency: Ad-hoc per disaster incident
Volume: ~3-5 major incident staging events annually
Owner: Loss Prevention Manager
Participants: Store Manager, Assistant SM, Security Guard, HSE Specialist (VS-24)
Source: workflow W5273 — Disaster Incident Staging and Physical Site Access Control</bpmn:documentation>
      <bpmn:laneSet id="W5273_LaneSet4">
        <bpmn:lane id="W5273_Lane1" name="Security Guard">
        <bpmn:flowNodeRef>W5273_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5273_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5273_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5273_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W5273_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5273_Lane3" name="Assistant SM">
        <bpmn:flowNodeRef>W5273_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5273_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5273_Start5" name="Typhoon, fire, or earthquake incident occurrence with structural store impact (VS-69)">
        <bpmn:outgoing>W5273_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5273_Task6" name="Assess immediate threat levels and secure the perimeter with safety barriers.">
        <bpmn:documentation>Step 1: Assess immediate threat levels and secure the perimeter with safety barriers.
Responsible (R): Security Guard
Accountable (A): Loss Prevention Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5273_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5273_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5273_Task7" name="Verify that all customers and personnel are accounted for per W471.">
        <bpmn:documentation>Step 2: Verify that all customers and personnel are accounted for per W471.
Responsible (R): Store Manager
Accountable (A): Loss Prevention Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5273_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5273_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5273_Task8" name="Deploy temporary signage restricting public entry and establish secure security…">
        <bpmn:documentation>Step 3: Deploy temporary signage restricting public entry and establish secure security staging gates.
Responsible (R): Assistant SM
Accountable (A): Loss Prevention Manager
Duration: 2-3 hours</bpmn:documentation>
        <bpmn:incoming>W5273_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5273_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5273_Task9" name="Issue temporary access badges to certified emergency assessment personnel only.">
        <bpmn:documentation>Step 4: Issue temporary access badges to certified emergency assessment personnel only.
Responsible (R): Security Guard
Accountable (A): Loss Prevention Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W5273_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5273_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5273_End10" name="Complete">
        <bpmn:incoming>W5273_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5273_Annotation11">
        <bpmn:text>Controls: - CTL-311: detect physical security breaches — disaster-site access control; LP Manager access approvals.
Owner: Loss Prevention Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5273_Assoc12" sourceRef="W5273_Annotation11" targetRef="W5273_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W5273_Flow13" sourceRef="W5273_Start5" targetRef="W5273_Task6" />
      <bpmn:sequenceFlow id="W5273_Flow14" sourceRef="W5273_Task6" targetRef="W5273_Task7" />
