      <bpmn:userTask id="W5276_Task5" name="Compile insurance claim packet: incident reports, photos, rapid assessments…">
        <bpmn:documentation>Step 1: Compile insurance claim packet: incident reports, photos, rapid assessments, BOQ.
Responsible (R): Insurance Administrator
Accountable (A): Insurance Administrator
Duration: 4-6 hours</bpmn:documentation>
        <bpmn:incoming>W5276_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5276_Flow13</bpmn:outgoing>
      </bpmn:userTask>
