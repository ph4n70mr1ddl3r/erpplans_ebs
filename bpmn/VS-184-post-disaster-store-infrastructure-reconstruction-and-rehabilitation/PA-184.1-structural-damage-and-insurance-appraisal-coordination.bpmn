      <bpmn:sequenceFlow id="W5274_Flow13" sourceRef="W5274_Task5" targetRef="W5274_Task6" />
      <bpmn:sequenceFlow id="W5274_Flow14" sourceRef="W5274_Task6" targetRef="W5274_Task7" />
