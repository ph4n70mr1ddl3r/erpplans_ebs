        <bpmn:flowNodeRef>W4050_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4050_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4050_Start4" name="Program stand-up; major re-org; new capability">
        <bpmn:outgoing>W4050_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4050_Task5" name="OpEx maintain the enterprise process architecture (value streams → process…">
        <bpmn:documentation>Step 1: OpEx maintain the enterprise process architecture (value streams → process areas → workflows) mapped to the value-stream-index, assign a single process owner (RACI A) per end-to-end process, and resolve ownership gaps/overlaps
Responsible (R): OpEx CoE / Process Owners
Accountable (A): COO
Duration: Maintained</bpmn:documentation>
        <bpmn:incoming>W4050_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4050_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4050_Task6" name="OpEx/EA document the process-to-system and process-to-data mapping (which ERP…">
        <bpmn:documentation>Step 2: OpEx/EA document the process-to-system and process-to-data mapping (which ERP modules/objects each process touches) to anchor mining (W4058) and automation scoping (W4062)
Responsible (R): OpEx / Enterprise Architecture
Accountable (A): COO / CIO
Duration: Maintained</bpmn:documentation>
        <bpmn:incoming>W4050_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4050_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4050_Task7" name="OpEx publish the architecture, onboard new value streams/processes on change…">
        <bpmn:documentation>Step 3: OpEx publish the architecture, onboard new value streams/processes on change, and review ownership annually with the executive team
Responsible (R): OpEx CoE
Accountable (A): COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4050_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4050_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4050_End8" name="Complete">
        <bpmn:incoming>W4050_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4050_Annotation9">
        <bpmn:text>Controls: - CTL-162 (ensure improvement benefit realization.) | - CTL-629: single accountable owner per end-to-end process; architecture-change approval by COO
Owner: COO</bpmn:text>
      </bpmn:textAnnotation>
