    <bpmn:process id="W_W4050" name="W4050. Enterprise Process Architecture, Ownership &amp; RACI Governance" isExecutable="false">
      <bpmn:documentation>Trigger: Program stand-up; major re-org; new capability
Frequency: Maintained + annual refresh
Volume: ~5,432 workflows across 188 value streams (single enterprise process map)
Owner: COO
Participants: All process owners (function VPs), Enterprise Architecture (links to VS-113), Master Data (links to VS-29)
Source: workflow W4050 — Enterprise Process Architecture, Ownership &amp; RACI Governance</bpmn:documentation>
      <bpmn:laneSet id="W4050_LaneSet3">
        <bpmn:lane id="W4050_Lane1" name="OpEx CoE">
        <bpmn:flowNodeRef>W4050_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4050_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4050_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
