        <bpmn:outgoing>W4065_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4065_Task5" name="OpEx/Finance build the benefit case at charter (hard/soft, P&amp;L vs…">
        <bpmn:documentation>Step 1: OpEx/Finance build the benefit case at charter (hard/soft, P&amp;L vs balance-sheet, baseline, annualization, confidence), with Finance sign-off on the model
Responsible (R): OpEx Finance Partner / Finance
Accountable (A): COO / CFO
Duration: Per project</bpmn:documentation>
        <bpmn:incoming>W4065_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4065_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4065_Task6" name="OpEx/Finance track realization monthly/quarterly against the case, distinguish…">
        <bpmn:documentation>Step 2: OpEx/Finance track realization monthly/quarterly against the case, distinguish run-rate vs one-time, and reconcile to the P&amp;L (links to VS-17.4)
Responsible (R): OpEx Finance Partner / Finance
Accountable (A): COO
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W4065_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4065_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4065_Task7" name="OpEx report realized benefit to the executive/Board (links to VS-33/VS-36), and…">
        <bpmn:documentation>Step 3: OpEx report realized benefit to the executive/Board (links to VS-33/VS-36), and flag shortfalls for action
Responsible (R): OpEx / Finance
Accountable (A): COO / CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4065_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4065_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4065_End8" name="Complete">
        <bpmn:incoming>W4065_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4065_Annotation9">
        <bpmn:text>Controls: - CTL-162 (ensure improvement benefit realization.) | - CTL-631: benefit case approved by Finance (segregation from OpEx sponsor); realized benefit reconciled to P&amp;L
Owner: OpEx Finance Partner / COO</bpmn:text>
      </bpmn:textAnnotation>
