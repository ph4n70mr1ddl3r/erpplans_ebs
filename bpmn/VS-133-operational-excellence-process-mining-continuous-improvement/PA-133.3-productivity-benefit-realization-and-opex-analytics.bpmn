    <bpmn:process id="W_W4065" name="W4065. Benefit Case Modeling, Tracking &amp; Realization Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Project charter; benefit realization cycle
Frequency: Per project + monthly/quarterly realization review
Volume: Enterprise benefit portfolio (margin, cost, working-capital, NPS)
Owner: OpEx Finance Partner / COO
Participants: Finance (links to VS-17.4), process owners, sponsors, Audit (links to VS-21)
Source: workflow W4065 — Benefit Case Modeling, Tracking &amp; Realization Reporting</bpmn:documentation>
      <bpmn:laneSet id="W4065_LaneSet3">
        <bpmn:lane id="W4065_Lane1" name="OpEx Finance Partner">
