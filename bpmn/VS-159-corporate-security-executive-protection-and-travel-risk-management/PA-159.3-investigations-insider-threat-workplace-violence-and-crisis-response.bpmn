        <bpmn:outgoing>W4693_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4693_Task5" name="Conduct lawful surveillance/evidence collection (CCTV W4677, digital forensics…">
        <bpmn:documentation>Step 1: Conduct lawful surveillance/evidence collection (CCTV W4677, digital forensics VS-27.3, document, witness) within legal/privacy limits (VS-91/VS-100.3); maintain chain-of-custody and evidence integrity
Responsible (R): Investigations Manager / Digital Forensics
Accountable (A): CSO / VP Legal
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4693_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4693_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4693_Task6" name="Coordinate with law enforcement (PNP/NBI) for criminal matters: report, share…">
        <bpmn:documentation>Step 2: Coordinate with law enforcement (PNP/NBI) for criminal matters: report, share evidence, support investigation/prosecution (VS-100 legal ops); manage information-sharing within legal limits
Responsible (R): CSO / Legal
Accountable (A): CSO / VP Legal
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4693_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4693_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4693_Task7" name="Preserve evidence and the investigation record for litigation/prosecution…">
        <bpmn:documentation>Step 3: Preserve evidence and the investigation record for litigation/prosecution (VS-100) and insurance (VS-26); manage privacy of subject/non-subject data (VS-91)
Responsible (R): CSO / Legal / Records
Accountable (A): CSO / VP Legal
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4693_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4693_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4693_End8" name="Complete">
