    <bpmn:process id="W_W4691" name="W4691. Workplace-Violence Threat Assessment, Intervention &amp; De-escalation" isExecutable="false">
      <bpmn:documentation>Trigger: Threat indicator (disgruntled employee, domestic-violence spillover, harassment VS-84, terminations)
Frequency: Per indicator
Volume: ~20–40 threat indicators/year across the workforce
Owner: CSO / Threat Assessment Team Lead
Participants: HR (VS-19/VS-84), OH/EAP (VS-83), Legal (VS-100.3), management, law enforcement
Source: workflow W4691 — Workplace-Violence Threat Assessment, Intervention &amp; De-escalation</bpmn:documentation>
      <bpmn:laneSet id="W4691_LaneSet3">
        <bpmn:lane id="W4691_Lane1" name="Threat Assessment Team">
        <bpmn:flowNodeRef>W4691_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4691_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4691_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4691_Lane2" name="CSO">
        <bpmn:flowNodeRef>W4691_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4691_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4691_Start4" name="Threat indicator (disgruntled employee, domestic-violence spillover, harassment VS-84…">
        <bpmn:outgoing>W4691_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4691_Task5" name="Operate a multi-disciplinary Threat Assessment Team (security + HR + OH/EAP +…">
        <bpmn:documentation>Step 1: Operate a multi-disciplinary Threat Assessment Team (security + HR + OH/EAP + Legal) for workplace-violence indicators; assess threat level using a structured methodology (proximity, intent, capability, stressors)
Responsible (R): Threat Assessment Team / CSO
Accountable (A): CSO / CHRO
Duration: Per indicator</bpmn:documentation>
        <bpmn:incoming>W4691_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4691_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4691_Task6" name="Intervene proportionately: EAP/counseling (VS-83), mediation, administrative…">
        <bpmn:documentation>Step 2: Intervene proportionately: EAP/counseling (VS-83), mediation, administrative leave, restraining order, enhanced security, law-enforcement referral; manage high-risk terminations (VS-19 W43) with security presence
Responsible (R): Threat Assessment Team / HR / Legal
Accountable (A): CSO / CHRO / VP Legal
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4691_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4691_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4691_Task7" name="De-escalate and monitor post-intervention; brief affected managers/workplaces…">
        <bpmn:documentation>Step 3: De-escalate and monitor post-intervention; brief affected managers/workplaces discreetly; review and adjust on new information
Responsible (R): CSO / HR
Accountable (A): CSO
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4691_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4691_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4691_End8" name="Complete">
        <bpmn:incoming>W4691_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4691_Annotation9">
        <bpmn:text>Controls: - CTL-709 (ensure controlled execution — Investigations, Insider Threat, Workplace Violence &amp; Crisis Response (PA-159.3).) | - CTL-709: structured threat assessment by multi-disciplinary team; proportionate intervention; discreet/privacy-compliant handling (VS-91)
Owner: CSO / Threat Assessment Team Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4691_Assoc10" sourceRef="W4691_Annotation9" targetRef="W4691_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4691_Flow11" sourceRef="W4691_Start4" targetRef="W4691_Task5" />
      <bpmn:sequenceFlow id="W4691_Flow12" sourceRef="W4691_Task5" targetRef="W4691_Task6" />
      <bpmn:sequenceFlow id="W4691_Flow13" sourceRef="W4691_Task6" targetRef="W4691_Task7" />
      <bpmn:sequenceFlow id="W4691_Flow14" sourceRef="W4691_Task7" targetRef="W4691_End8" />
    </bpmn:process>
