    <bpmn:process id="W_W4689" name="W4689. Corporate Investigations: Fraud, Theft, Embezzlement &amp; IP Misappropriation" isExecutable="false">
      <bpmn:documentation>Trigger: Allegation/tip (whistleblower VS-119, audit VS-21, LP VS-23, anomaly)
Frequency: Per case
Volume: ~dozens of significant corporate investigations/yr
Owner: CSO / Corporate Investigations Manager
Participants: Internal Audit (VS-21), LP (VS-23), Fraud (VS-125), Legal (VS-100.3), HR (VS-19/VS-84), Ethics (VS-119), law enforcement
Source: workflow W4689 — Corporate Investigations: Fraud, Theft, Embezzlement &amp; IP Misappropriation</bpmn:documentation>
      <bpmn:laneSet id="W4689_LaneSet3">
        <bpmn:lane id="W4689_Lane1" name="Investigations Manager">
        <bpmn:flowNodeRef>W4689_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4689_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4689_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4689_Lane2" name="CSO">
        <bpmn:flowNodeRef>W4689_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4689_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4689_Start4" name="Allegation/tip (whistleblower VS-119, audit VS-21, LP VS-23, anomaly)">
        <bpmn:outgoing>W4689_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4689_Task5" name="Intake and triage allegations of corporate crime (executive/employee fraud…">
        <bpmn:documentation>Step 1: Intake and triage allegations of corporate crime (executive/employee fraud, embezzlement, IP theft/trade-secret misappropriation, vendor collusion, bribery VS-86); assess credibility and scope; preserve evidence immediately
Responsible (R): Investigations Manager / CSO
Accountable (A): CSO / VP Legal
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4689_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4689_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4689_Task6" name="Conduct the investigation: interviews, digital forensics (with cyber VS-27.3)…">
        <bpmn:documentation>Step 2: Conduct the investigation: interviews, digital forensics (with cyber VS-27.3), document review, surveillance (W4693) within legal limits; coordinate with Legal (privilege VS-100.3) and HR (discipline/termination VS-19)
Responsible (R): Investigations Manager / Legal / HR
Accountable (A): CSO / VP Legal
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4689_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4689_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4689_Task7" name="Conclude with findings, recovery/restitution, discipline/termination (VS-19)…">
        <bpmn:documentation>Step 3: Conclude with findings, recovery/restitution, discipline/termination (VS-19), insurance claim (VS-26 crime policy), and law-enforcement referral/prosecution (VS-100) where warranted; capture lessons (W4696)
Responsible (R): CSO / Legal / HR / Insurance
Accountable (A): CSO / VP Legal / CFO
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4689_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4689_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4689_End8" name="Complete">
        <bpmn:incoming>W4689_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4689_Annotation9">
        <bpmn:text>Controls: - CTL-709 (ensure controlled execution — Investigations, Insider Threat, Workplace Violence &amp; Crisis Response (PA-159.3).) | - CTL-709: evidence preserved with chain-of-custody; Legal-privileged and rights-compliant (VS-91/VS-84); recovery/insurance pursued
Owner: CSO / Corporate Investigations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4689_Assoc10" sourceRef="W4689_Annotation9" targetRef="W4689_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4689_Flow11" sourceRef="W4689_Start4" targetRef="W4689_Task5" />
      <bpmn:sequenceFlow id="W4689_Flow12" sourceRef="W4689_Task5" targetRef="W4689_Task6" />
      <bpmn:sequenceFlow id="W4689_Flow13" sourceRef="W4689_Task6" targetRef="W4689_Task7" />
      <bpmn:sequenceFlow id="W4689_Flow14" sourceRef="W4689_Task7" targetRef="W4689_End8" />
    </bpmn:process>
