      <bpmndi:BPMNPlane id="W1736_plane" bpmnElement="W_W1736">
        <bpmndi:BPMNShape id="W1736_Lane1_di" bpmnElement="W1736_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1736_Lane2_di" bpmnElement="W1736_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
