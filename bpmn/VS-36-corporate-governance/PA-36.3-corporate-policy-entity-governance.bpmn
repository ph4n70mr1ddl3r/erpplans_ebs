    <bpmn:process id="W_W1730" name="W1730. Annual Corporate Governance Self-Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: Annual governance review cycle (Q4)
Frequency: Annual
Volume: 1 assessment/year
Owner: Corporate Secretary
Participants: Corporate Secretary, Board Chair, CEO, all directors
Source: workflow W1730 — Annual Corporate Governance Self-Assessment</bpmn:documentation>
      <bpmn:laneSet id="W1730_LaneSet4">
        <bpmn:lane id="W1730_Lane1" name="Corporate Secretary">
        <bpmn:flowNodeRef>W1730_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1730_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1730_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1730_Lane2" name="Directors">
        <bpmn:flowNodeRef>W1730_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1730_Lane3" name="Board">
        <bpmn:flowNodeRef>W1730_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1730_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1730_Start5" name="Annual governance review cycle (Q4)">
        <bpmn:outgoing>W1730_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1730_Task6" name="Corporate Secretary distributes governance self-assessment questionnaire to all…">
        <bpmn:documentation>Step 1: Corporate Secretary distributes governance self-assessment questionnaire to all directors: (a) board composition and independence, (b) board meeting effectiveness, (c) information quality and timeliness, (d) committee functioning, (e) risk oversight, (f) management-board relationship, (g) corporate culture and ethics, (h) director time commitment, (i) board succession planning
Responsible (R): Corporate Secretary
Accountable (A): Board Chair
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1730_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1730_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1730_Task7" name="Directors complete assessment individually (confidential); Corporate Secretary…">
        <bpmn:documentation>Step 2: Directors complete assessment individually (confidential); Corporate Secretary aggregates results
Responsible (R): Directors
Accountable (A): —
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1730_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1730_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1730_Task8" name="Corporate Secretary presents aggregate results to Board (no individual…">
        <bpmn:documentation>Step 3: Corporate Secretary presents aggregate results to Board (no individual attribution): (a) strengths and positive practices, (b) areas for improvement, (c) comparison to prior year (trend), (d) specific recommendations
Responsible (R): Corporate Secretary
Accountable (A): Board Chair
Duration: 1 hour at board meeting</bpmn:documentation>
        <bpmn:incoming>W1730_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1730_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1730_Task9" name="Board discusses results and agrees on improvement actions: (a) assign owners…">
        <bpmn:documentation>Step 4: Board discusses results and agrees on improvement actions: (a) assign owners and timelines for each action, (b) track implementation at subsequent meetings, (c) report to stockholders in annual report (if voluntary disclosure desired)
Responsible (R): Board
Accountable (A): Board Chair
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W1730_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1730_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1730_End10" name="Complete">
        <bpmn:incoming>W1730_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1730_Annotation11">
        <bpmn:text>Controls: - CTL-351 (ensure controlled execution — Corporate Policy &amp; Entity Governance (PA-36.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Corporate Secretary</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1730_Assoc12" sourceRef="W1730_Annotation11" targetRef="W1730_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1730_Flow13" sourceRef="W1730_Start5" targetRef="W1730_Task6" />
      <bpmn:sequenceFlow id="W1730_Flow14" sourceRef="W1730_Task6" targetRef="W1730_Task7" />
      <bpmn:sequenceFlow id="W1730_Flow15" sourceRef="W1730_Task7" targetRef="W1730_Task8" />
      <bpmn:sequenceFlow id="W1730_Flow16" sourceRef="W1730_Task8" targetRef="W1730_Task9" />
      <bpmn:sequenceFlow id="W1730_Flow17" sourceRef="W1730_Task9" targetRef="W1730_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1730_diag">
      <bpmndi:BPMNPlane id="W1730_plane" bpmnElement="W_W1730">
        <bpmndi:BPMNShape id="W1730_Lane1_di" bpmnElement="W1730_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1730_Lane2_di" bpmnElement="W1730_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1730_Lane3_di" bpmnElement="W1730_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1730_Task6_di" bpmnElement="W1730_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1730_Task7_di" bpmnElement="W1730_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1730_Task8_di" bpmnElement="W1730_Task8"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1730_Task9_di" bpmnElement="W1730_Task9"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1730_Start5_di" bpmnElement="W1730_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1730_End10_di" bpmnElement="W1730_End10"><dc:Bounds x="1260" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1730_Annotation11_di" bpmnElement="W1730_Annotation11"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1730_Flow13_di" bpmnElement="W1730_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1730_Flow14_di" bpmnElement="W1730_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1730_Flow15_di" bpmnElement="W1730_Flow15"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1730_Flow16_di" bpmnElement="W1730_Flow16"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1730_Flow17_di" bpmnElement="W1730_Flow17"><di:waypoint x="1210" y="505" /><di:waypoint x="1260" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1730_Assoc12_di" bpmnElement="W1730_Assoc12"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1731" name="W1731. Intercompany Service Agreement Governance, Transfer Pricing &amp; Board Authorization" isExecutable="false">
      <bpmn:documentation>Trigger: New service relationship between BuildRight entities; annual renewal
Frequency: ~20 IC service agreements maintained; annual review
Volume: Core intercompany services: (1) Depot → Logistics: warehousing fees, (2) Depot → Digital Commerce: ecommerce fulfillment fees, (3) Depot → Property Mgmt: lease payments, (4) Holdings → all subsidiaries: management fees
Owner: CFO
Participants: CFO, Corporate Secretary, Legal Counsel, Transfer Pricing Advisor
Source: workflow W1731 — Intercompany Service Agreement Governance, Transfer Pricing &amp; Board Authorization</bpmn:documentation>
      <bpmn:laneSet id="W1731_LaneSet5">
        <bpmn:lane id="W1731_Lane1" name="CFO">
        <bpmn:flowNodeRef>W1731_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1731_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1731_Lane2" name="External TP Advisor">
        <bpmn:flowNodeRef>W1731_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1731_Lane3" name="Corporate Secretary">
        <bpmn:flowNodeRef>W1731_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1731_Lane4" name="Accounting Manager">
        <bpmn:flowNodeRef>W1731_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1731_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1731_Start6" name="New service relationship between BuildRight entities; annual renewal">
        <bpmn:outgoing>W1731_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1731_Task7" name="CFO and Legal Counsel maintain intercompany service agreements: (a) warehousing…">
        <bpmn:documentation>Step 1: CFO and Legal Counsel maintain intercompany service agreements: (a) warehousing and distribution services (Logistics → Depot), (b) ecommerce platform services (Digital Commerce → Depot), (c) property lease agreements (Property Management → Depot/Logistics/Digital Commerce), (d) management and shared services (Holdings → all subsidiaries), (e) IT services (Holdings or Depot → all entities), (f) HR and payroll services (Holdings → all entities)
Responsible (R): CFO / Legal Counsel
Accountable (A): CEO
Duration: Annual review</bpmn:documentation>
        <bpmn:incoming>W1731_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1731_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1731_Task8" name="Transfer pricing documentation: (a) engage external transfer pricing advisor…">
        <bpmn:documentation>Step 2: Transfer pricing documentation: (a) engage external transfer pricing advisor for annual study, (b) benchmark intercompany pricing against comparable market rates (arm&#x27;s length principle), (c) document pricing methodology, comparables, and economic analysis, (d) maintain documentation per BIR Revenue Regulations No. 34-2022 (Philippine TP rules)
Responsible (R): External TP Advisor / CFO
Accountable (A): CFO
Duration: 2–4 weeks/year</bpmn:documentation>
        <bpmn:incoming>W1731_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1731_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1731_Task9" name="Agreements updated with approved pricing; board resolutions authorizing…">
        <bpmn:documentation>Step 3: Agreements updated with approved pricing; board resolutions authorizing intercompany arrangements per W1717; signed agreements filed per W1719
Responsible (R): Corporate Secretary / CFO
Accountable (A): Board
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1731_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1731_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1731_Task10" name="Monthly: Accounting Manager ensures intercompany transactions are recorded per…">
        <bpmn:documentation>Step 4: Monthly: Accounting Manager ensures intercompany transactions are recorded per agreed pricing; quarterly reconciliation per PA-17.2
Responsible (R): Accounting Manager
Accountable (A): CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W1731_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1731_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1731_End11" name="Complete">
        <bpmn:incoming>W1731_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1731_Annotation12">
        <bpmn:text>Controls: - CTL-351 (ensure controlled execution — Corporate Policy &amp; Entity Governance (PA-36.3).) | - operational: CFO review and approval gate; operational: periodic reconciliation against source documents
Owner: CFO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1731_Assoc13" sourceRef="W1731_Annotation12" targetRef="W1731_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1731_Flow14" sourceRef="W1731_Start6" targetRef="W1731_Task7" />
      <bpmn:sequenceFlow id="W1731_Flow15" sourceRef="W1731_Task7" targetRef="W1731_Task8" />
