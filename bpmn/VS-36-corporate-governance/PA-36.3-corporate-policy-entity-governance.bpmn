    <bpmn:process id="W_W1732" name="W1732. Corporate Signing Authority &amp; Delegation of Authority Matrix" isExecutable="false">
      <bpmn:documentation>Trigger: Organizational change, policy review, or new officer appointment
Frequency: Annual review; ad-hoc updates for organizational changes
Volume: 1 master authority matrix maintained
Owner: Corporate Secretary
Participants: Corporate Secretary, CEO, CFO, all department heads, IT (system configuration)
Source: workflow W1732 — Corporate Signing Authority &amp; Delegation of Authority Matrix</bpmn:documentation>
      <bpmn:laneSet id="W1732_LaneSet4">
        <bpmn:lane id="W1732_Lane1" name="Corporate Secretary">
        <bpmn:flowNodeRef>W1732_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1732_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1732_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1732_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1732_Lane2" name="IT">
        <bpmn:flowNodeRef>W1732_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1732_Lane3" name="CFO">
        <bpmn:flowNodeRef>W1732_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1732_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1732_Start5" name="Organizational change, policy review, or new officer appointment">
        <bpmn:outgoing>W1732_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1732_Task6" name="Corporate Secretary maintains the Delegation of Authority (DOA) matrix: (a)…">
        <bpmn:documentation>Step 1: Corporate Secretary maintains the Delegation of Authority (DOA) matrix: (a) financial approvals: purchase orders, vendor payments, expense reimbursements, capex requests, (b) contractual authority: contract execution, lease signing, vendor agreements, (c) banking authority: account opening, fund transfers, check signing, (d) HR authority: hiring, salary changes, termination, (e) operational authority: inventory adjustments, pricing overrides, markdown approvals
Responsible (R): Corporate Secretary
Accountable (A): CEO / CFO
Duration: Continuously</bpmn:documentation>
        <bpmn:incoming>W1732_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1732_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1732_Task7" name="DOA tiers by value: (a) &lt; PHP 50K: Department Manager, (b) PHP 50K–200K…">
        <bpmn:documentation>Step 2: DOA tiers by value: (a) &lt; PHP 50K: Department Manager, (b) PHP 50K–200K: Department Head / VP, (c) PHP 200K–1M: C-Suite member, (d) PHP 1M–10M: CEO, (e) &gt; PHP 10M: Board approval, (f) dual signature for bank transactions &gt; PHP 500K
Responsible (R): Corporate Secretary / CFO
Accountable (A): Board
Duration: Annual approval</bpmn:documentation>
        <bpmn:incoming>W1732_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1732_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1732_Task8" name="System configuration: IT configures approval workflows in ERP per DOA matrix…">
        <bpmn:documentation>Step 3: System configuration: IT configures approval workflows in ERP per DOA matrix: (a) PO approval limits per user role, (b) capex approval workflow per W1811, (c) payment approval limits, (d) contract execution limits, (e) system enforces limits (cannot approve beyond authority)
Responsible (R): IT
Accountable (A): CFO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1732_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1732_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1732_Task9" name="Annual review: CFO and Corporate Secretary review DOA matrix for…">
        <bpmn:documentation>Step 4: Annual review: CFO and Corporate Secretary review DOA matrix for appropriateness: (a) adjustments for inflation (thresholds may need increase), (b) changes for new roles or organizational restructuring, (c) board approval for changes to Board-level thresholds
Responsible (R): CFO / Corporate Secretary
Accountable (A): Board
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1732_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1732_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1732_Task10" name="DOA matrix distributed to all managers; training on approval limits; Corporate…">
        <bpmn:documentation>Step 5: DOA matrix distributed to all managers; training on approval limits; Corporate Secretary maintains signed acknowledgment copies
Responsible (R): Corporate Secretary / CHRO
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1732_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1732_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1732_End11" name="Complete">
        <bpmn:incoming>W1732_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1732_Annotation12">
        <bpmn:text>Controls: - CTL-351 (ensure controlled execution — Corporate Policy &amp; Entity Governance (PA-36.3).) | - operational: Corporate Secretary review and approval gate
Owner: Corporate Secretary</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1732_Assoc13" sourceRef="W1732_Annotation12" targetRef="W1732_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1732_Flow14" sourceRef="W1732_Start5" targetRef="W1732_Task6" />
