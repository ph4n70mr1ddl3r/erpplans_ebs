    <bpmn:process id="W_W1736" name="W1736. Corporate Social Responsibility Oversight" isExecutable="false">
      <bpmn:documentation>Trigger: Annual CSR planning (Q4); community engagement events; disaster response needs
Frequency: Annual planning; quarterly activities; event-driven for disaster response
Volume: ~20–30 CSR activities/year
Owner: Corporate Secretary
Participants: Corporate Secretary, CEO, CHRO, CMO, affected communities
Source: workflow W1736 — Corporate Social Responsibility Oversight</bpmn:documentation>
      <bpmn:laneSet id="W1736_LaneSet3">
        <bpmn:lane id="W1736_Lane1" name="Corporate Secretary">
        <bpmn:flowNodeRef>W1736_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1736_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1736_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1736_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1736_Lane2" name="CMO">
        <bpmn:flowNodeRef>W1736_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1736_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1736_Start4" name="Annual CSR planning (Q4); community engagement events; disaster response needs">
        <bpmn:outgoing>W1736_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1736_Task5" name="Annual CSR plan development: (a) aligned to BuildRight&#x27;s community presence in…">
        <bpmn:documentation>Step 1: Annual CSR plan development: (a) aligned to BuildRight&#x27;s community presence in 200+ locations across the Philippines, (b) focus areas: (i) housing/building assistance (core competency as hardware retailer), (ii) community safety and disaster preparedness, (iii) skills training (construction, DIY workshops for communities), (iv) environmental initiatives (tree planting, waste reduction), (v) employee volunteerism, (c) budget: typically 1–2% of net income
Responsible (R): Corporate Secretary / CMO
Accountable (A): CEO
Duration: 1 week (Q4)</bpmn:documentation>
        <bpmn:incoming>W1736_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1736_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1736_Task6" name="CSR activity execution: (a) community build projects (partner with LGUs for…">
        <bpmn:documentation>Step 2: CSR activity execution: (a) community build projects (partner with LGUs for housing materials donation), (b) disaster response (rapid mobilization of building materials for affected communities — Philippines experiences ~20 typhoons/year), (c) skills training workshops (free community DIY clinics at stores), (d) employee volunteer days (1 paid volunteer day per employee per year)
Responsible (R): CMO / CHRO / Store Managers
Accountable (A): Corporate Secretary
Duration: Quarterly activities</bpmn:documentation>
        <bpmn:incoming>W1736_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1736_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1736_Task7" name="CSR reporting: (a) annual CSR report (may be part of ESG reporting per VS-25)…">
        <bpmn:documentation>Step 3: CSR reporting: (a) annual CSR report (may be part of ESG reporting per VS-25), (b) activity tracking: number of beneficiaries, volunteer hours, donations made, (c) budget vs. actual tracking, (d) communication to stakeholders (internal newsletter, social media, community acknowledgment)
Responsible (R): Corporate Secretary / CMO
Accountable (A): CEO
Duration: Quarterly updates</bpmn:documentation>
        <bpmn:incoming>W1736_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1736_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1736_Task8" name="Board oversight: CSR activities and budget presented to Board annually…">
        <bpmn:documentation>Step 4: Board oversight: CSR activities and budget presented to Board annually; significant disaster response commitments (&gt; PHP 1M) approved by CEO; &gt; PHP 5M reported to Board
Responsible (R): Corporate Secretary
Accountable (A): Board
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W1736_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1736_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1736_End9" name="Complete">
        <bpmn:incoming>W1736_Flow16</bpmn:incoming>
      </bpmn:endEvent>
