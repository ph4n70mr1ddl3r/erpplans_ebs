<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-36.3-corporate-policy-entity-governance" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1729" name="W1729. Corporate Policy Development &amp; Approval" isExecutable="false">
      <bpmn:documentation>Trigger: New regulation, operational need, audit finding, or periodic policy review
Frequency: ~10–15 policy updates/year + 3–5 new policies/year
Volume: ~40–50 active corporate policies
Owner: Corporate Secretary
Participants: Corporate Secretary, Policy Owner (department head), Legal Counsel, CHRO, Board
Source: workflow W1729 — Corporate Policy Development &amp; Approval</bpmn:documentation>
      <bpmn:laneSet id="W1729_LaneSet5">
        <bpmn:lane id="W1729_Lane1" name="Policy Owner">
        <bpmn:flowNodeRef>W1729_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1729_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1729_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1729_Lane2" name="Legal Counsel">
        <bpmn:flowNodeRef>W1729_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1729_Lane3" name="Approver per policy type">
        <bpmn:flowNodeRef>W1729_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1729_Lane4" name="CHRO">
        <bpmn:flowNodeRef>W1729_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1729_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1729_Start6" name="New regulation, operational need, audit finding, or periodic policy review">
        <bpmn:outgoing>W1729_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1729_Task7" name="Policy owner identifies need for new or revised policy: (a) regulatory change…">
        <bpmn:documentation>Step 1: Policy owner identifies need for new or revised policy: (a) regulatory change (e.g., new BIR regulation, NPC circular), (b) operational incident revealing policy gap, (c) internal audit recommendation, (d) industry best practice adoption, (e) periodic review (all policies reviewed at least every 2 years)
Responsible (R): Policy Owner
Accountable (A): Corporate Secretary
Duration: Event-driven</bpmn:documentation>
        <bpmn:incoming>W1729_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1729_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1729_Task8" name="Policy owner drafts policy using standard template: (a) purpose and scope, (b)…">
        <bpmn:documentation>Step 2: Policy owner drafts policy using standard template: (a) purpose and scope, (b) definitions, (c) policy statement (clear, actionable rules), (d) procedures for implementation, (e) roles and responsibilities, (f) exceptions and approval process, (g) monitoring and enforcement, (h) related documents, (i) version history
Responsible (R): Policy Owner
Accountable (A): Department Head
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1729_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1729_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1729_Task9" name="Review and consultation: (a) Legal Counsel reviews for legal compliance, (b)…">
        <bpmn:documentation>Step 3: Review and consultation: (a) Legal Counsel reviews for legal compliance, (b) CHRO reviews for employee impact and communication plan, (c) affected departments provide feedback, (d) Corporate Secretary reviews for consistency with existing policies
Responsible (R): Legal Counsel / CHRO / Corporate Secretary
Accountable (A): Policy Owner
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1729_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1729_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1729_Task10" name="Approval: (a) operational policies: CEO approval, (b) financial policies…">
        <bpmn:documentation>Step 4: Approval: (a) operational policies: CEO approval, (b) financial policies (procurement, expense, capex): CFO approval, (c) HR policies: CHRO + CEO approval, (d) governance policies: Board or Audit Committee approval, (e) critical policies (code of conduct, anti-fraud, whistleblower): Board approval
Responsible (R): Approver per policy type
Accountable (A): Board / CEO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1729_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1729_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1729_Task11" name="Communication and implementation: (a) CHRO distributes to all employees via…">
        <bpmn:documentation>Step 5: Communication and implementation: (a) CHRO distributes to all employees via company portal, (b) training sessions for significant policy changes, (c) acknowledgment collected from all employees (digital signature), (d) effective date clearly stated, (e) previous version archived
Responsible (R): CHRO / Policy Owner
Accountable (A): Corporate Secretary
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1729_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1729_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1729_End12" name="Complete">
        <bpmn:incoming>W1729_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1729_Annotation13">
        <bpmn:text>Controls: - CTL-351 (ensure controlled execution — Corporate Policy &amp; Entity Governance (PA-36.3).) | - operational: Corporate Secretary review and approval gate
Owner: Corporate Secretary</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1729_Assoc14" sourceRef="W1729_Annotation13" targetRef="W1729_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1729_Flow15" sourceRef="W1729_Start6" targetRef="W1729_Task7" />
      <bpmn:sequenceFlow id="W1729_Flow16" sourceRef="W1729_Task7" targetRef="W1729_Task8" />
      <bpmn:sequenceFlow id="W1729_Flow17" sourceRef="W1729_Task8" targetRef="W1729_Task9" />
      <bpmn:sequenceFlow id="W1729_Flow18" sourceRef="W1729_Task9" targetRef="W1729_Task10" />
      <bpmn:sequenceFlow id="W1729_Flow19" sourceRef="W1729_Task10" targetRef="W1729_Task11" />
      <bpmn:sequenceFlow id="W1729_Flow20" sourceRef="W1729_Task11" targetRef="W1729_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1729_diag">
      <bpmndi:BPMNPlane id="W1729_plane" bpmnElement="W_W1729">
        <bpmndi:BPMNShape id="W1729_Lane1_di" bpmnElement="W1729_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
