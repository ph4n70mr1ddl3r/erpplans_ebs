        <bpmn:flowNodeRef>W1734_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1734_Start4" name="Annual disclosure requirement; new hire; triggered by specific situation">
        <bpmn:outgoing>W1734_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1734_Task5" name="Annual conflict of interest disclosure: (a) all managers and above (Store…">
        <bpmn:documentation>Step 1: Annual conflict of interest disclosure: (a) all managers and above (Store Managers, DC Supervisors, Department Heads, C-Suite, Directors): complete detailed COI questionnaire, (b) all other employees: acknowledge COI policy and report any actual conflicts, (c) questionnaire covers: (i) financial interests in vendors/suppliers/competitors, (ii) employment by or consulting for related entities, (iii) family members in competing or supplying businesses, (iv) outside business interests that may conflict, (v) gifts and entertainment received beyond policy limits
Responsible (R): Corporate Secretary / CHRO
Accountable (A): CEO
Duration: Annual (January)</bpmn:documentation>
        <bpmn:incoming>W1734_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1734_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1734_Task6" name="Corporate Secretary reviews disclosures: (a) identified conflicts assessed for…">
        <bpmn:documentation>Step 2: Corporate Secretary reviews disclosures: (a) identified conflicts assessed for materiality, (b) potential mitigation: recusal from related decisions, divestiture of conflicting interest, reassignment of duties, (c) senior management and director conflicts escalated to Board Chair or Audit Committee
Responsible (R): Corporate Secretary
Accountable (A): CEO / Board Chair
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W1734_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1734_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1734_Task7" name="Conflict management plan documented and tracked: (a) agreed mitigation…">
        <bpmn:documentation>Step 3: Conflict management plan documented and tracked: (a) agreed mitigation measures, (b) monitoring responsibilities, (c) annual reassessment
Responsible (R): Corporate Secretary
Accountable (A): —
Duration: As needed</bpmn:documentation>
        <bpmn:incoming>W1734_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1734_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1734_Task8" name="Non-disclosure consequences: failure to disclose a material conflict of…">
        <bpmn:documentation>Step 4: Non-disclosure consequences: failure to disclose a material conflict of interest is a disciplinary offense per employee handbook; substantiated undisclosed conflicts may result in termination
Responsible (R): CHRO / Legal Counsel
Accountable (A): CEO
Duration: As needed</bpmn:documentation>
        <bpmn:incoming>W1734_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1734_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1734_End9" name="Complete">
        <bpmn:incoming>W1734_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1734_Annotation10">
        <bpmn:text>Controls: - CTL-351 (ensure controlled execution — Corporate Policy &amp; Entity Governance (PA-36.3).) | - operational: Corporate Secretary review and approval gate
Owner: Corporate Secretary</bpmn:text>
      </bpmn:textAnnotation>
