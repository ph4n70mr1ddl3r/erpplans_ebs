    <bpmn:process id="W_W1718" name="W1718. SEC Annual Filing &amp; Corporate Information Update" isExecutable="false">
      <bpmn:documentation>Trigger: Annual filing deadline (within 30 days of stockholders&#x27; meeting per SEC requirements)
Frequency: Annual (5 entities × 1 filing = 5 filings)
Volume: 5 filings/year
Owner: Corporate Secretary
Participants: Corporate Secretary, CFO, External Auditor, Legal Counsel
Source: workflow W1718 — SEC Annual Filing &amp; Corporate Information Update</bpmn:documentation>
      <bpmn:laneSet id="W1718_LaneSet3">
        <bpmn:lane id="W1718_Lane1" name="Corporate Secretary">
        <bpmn:flowNodeRef>W1718_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1718_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1718_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1718_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1718_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1718_Lane2" name="CEO">
        <bpmn:flowNodeRef>W1718_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1718_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1718_Start4" name="Annual filing deadline (within 30 days of stockholders&#x27; meeting per SEC requirements)">
        <bpmn:outgoing>W1718_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1718_Task5" name="Corporate Secretary prepares annual SEC filing package per entity: (a) General…">
        <bpmn:documentation>Step 1: Corporate Secretary prepares annual SEC filing package per entity: (a) General Information Sheet (GIS): directors, officers, stockholders, corporate secretary, principal office, (b) audited financial statements (prepared by CFO and external auditor per W17.1), (c) annual report: company operations, financial highlights, management discussion, (d) sworn statement of assets, liabilities, and net worth (SALN for officers, if applicable)
Responsible (R): Corporate Secretary
Accountable (A): CEO / CFO
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W1718_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1718_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1718_Task6" name="Corporate Secretary verifies corporate information accuracy: (a) directors and…">
        <bpmn:documentation>Step 2: Corporate Secretary verifies corporate information accuracy: (a) directors and officers match board resolutions per W1717, (b) stockholder register matches equity ledger per W1722, (c) corporate structure matches SEC registration, (d) any changes during the year (officer changes, address changes, capital changes) are reflected
Responsible (R): Corporate Secretary
Accountable (A): Legal Counsel
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W1718_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1718_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1718_Task7" name="CEO and CFO review and sign SEC filing package; External Auditor signs audit…">
        <bpmn:documentation>Step 3: CEO and CFO review and sign SEC filing package; External Auditor signs audit report
Responsible (R): CEO / CFO / External Auditor
Accountable (A): Board
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W1718_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1718_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1718_Task8" name="Corporate Secretary files with SEC (electronic filing via SEC API or physical…">
        <bpmn:documentation>Step 4: Corporate Secretary files with SEC (electronic filing via SEC API or physical submission): (a) GIS filed within 30 days of annual stockholders&#x27; meeting, (b) AFS filed per SEC deadline (typically 120 days after fiscal year-end for stock corporations), (c) receive SEC confirmation of acceptance
Responsible (R): Corporate Secretary
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1718_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1718_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1718_Task9" name="Maintain SEC filing archive: copies of all filed documents, SEC confirmation…">
        <bpmn:documentation>Step 5: Maintain SEC filing archive: copies of all filed documents, SEC confirmation receipts, and supporting resolutions retained per W1719
Responsible (R): Corporate Secretary
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1718_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1718_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1718_End10" name="Complete">
        <bpmn:incoming>W1718_Flow18</bpmn:incoming>
      </bpmn:endEvent>
