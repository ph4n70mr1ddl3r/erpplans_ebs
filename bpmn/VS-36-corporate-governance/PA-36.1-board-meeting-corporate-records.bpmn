    <bpmn:process id="W_W1721" name="W1721. Board Committee Management &amp; Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Annual committee formation; quarterly committee meetings
Frequency: 3–4 committee meetings/year per committee
Volume: 3 standing committees × 3–4 meetings/year = 9–12 meetings/year
Owner: Corporate Secretary
Participants: Committee chairs, committee members, management presenters, Corporate Secretary
Source: workflow W1721 — Board Committee Management &amp; Reporting</bpmn:documentation>
      <bpmn:laneSet id="W1721_LaneSet4">
        <bpmn:lane id="W1721_Lane1" name="Board Chair">
        <bpmn:flowNodeRef>W1721_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1721_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1721_Lane2" name="Committee Chair">
        <bpmn:flowNodeRef>W1721_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1721_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1721_Lane3" name="Corporate Secretary">
        <bpmn:flowNodeRef>W1721_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1721_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1721_Start5" name="Annual committee formation; quarterly committee meetings">
        <bpmn:outgoing>W1721_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1721_Task6" name="Audit Committee">
        <bpmn:documentation>Step 1: BuildRight maintains 3 standing board committees (per corporate governance best practice for privately held corporations): (a) Audit Committee: reviews financial statements, internal audit reports, external auditor engagement, risk management; chaired by independent director (if any) or non-executive director; meets quarterly, (b) Executive Committee: acts on behalf of board between meetings for urgent matters; composed of Board Chair, CEO, and 1–2 directors; meets as needed, (c) Compensation &amp; Governance Committee: reviews executive compensation, director compensation, corporate governance policies, board evaluation; meets annually
Responsible (R): Board Chair / Corporate Secretary
Accountable (A): Board
Duration: Annual formation</bpmn:documentation>
        <bpmn:incoming>W1721_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1721_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1721_Task7" name="Committee chair sets agenda; Corporate Secretary prepares materials specific to…">
        <bpmn:documentation>Step 2: Committee chair sets agenda; Corporate Secretary prepares materials specific to committee mandate: (a) Audit Committee: internal audit reports (VS-21), external audit findings, management letter responses, financial statement review, risk dashboard, (b) Executive Committee: urgent matters requiring board action between meetings, (c) Compensation &amp; Governance: compensation benchmarking, policy updates, governance assessment results
Responsible (R): Committee Chair / Corporate Secretary
Accountable (A): Board Chair
Duration: 3–5 days before meeting</bpmn:documentation>
        <bpmn:incoming>W1721_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1721_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1721_Task8" name="Committee meetings conducted; minutes recorded; committee reports prepared for…">
        <bpmn:documentation>Step 3: Committee meetings conducted; minutes recorded; committee reports prepared for full board presentation at next board meeting
Responsible (R): Corporate Secretary
Accountable (A): Committee Chair
Duration: 1–3 hours/meeting</bpmn:documentation>
        <bpmn:incoming>W1721_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1721_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1721_Task9" name="Committee recommendations presented to full board; board considers and votes on…">
        <bpmn:documentation>Step 4: Committee recommendations presented to full board; board considers and votes on committee recommendations; committee decisions ratified or modified by full board as needed
Responsible (R): Committee Chair
Accountable (A): Board
Duration: 15–30 min at board meeting</bpmn:documentation>
        <bpmn:incoming>W1721_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1721_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1721_End10" name="Complete">
        <bpmn:incoming>W1721_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1721_Annotation11">
        <bpmn:text>Controls: - CTL-349 (ensure controlled execution — Board Meeting Management &amp; Corporate Records (PA-36.1).) | - operational: Corporate Secretary review and approval gate
Owner: Corporate Secretary</bpmn:text>
      </bpmn:textAnnotation>
