<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-36.1-board-meeting-corporate-records" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1714" name="W1714. Quarterly Board Meeting Scheduling &amp; Agenda Preparation" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly board calendar (Q1–Q4 meetings) + ad-hoc meetings for urgent matters
Frequency: 4 regular meetings/year + 2–4 ad-hoc meetings/year
Volume: 6–10 board meetings/year
Owner: Corporate Secretary
Participants: Corporate Secretary, CEO, CFO, Board Chair
Source: workflow W1714 — Quarterly Board Meeting Scheduling &amp; Agenda Preparation</bpmn:documentation>
      <bpmn:laneSet id="W1714_LaneSet4">
        <bpmn:lane id="W1714_Lane1" name="Corporate Secretary">
        <bpmn:flowNodeRef>W1714_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1714_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1714_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1714_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1714_Lane2" name="CEO">
        <bpmn:flowNodeRef>W1714_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1714_Lane3" name="Board Chair">
        <bpmn:flowNodeRef>W1714_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1714_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1714_Start5" name="Quarterly board calendar (Q1–Q4 meetings) + ad-hoc meetings for urgent matters">
        <bpmn:outgoing>W1714_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1714_Task6" name="Corporate Secretary maintains annual board meeting calendar: (a) Q1 meeting…">
        <bpmn:documentation>Step 1: Corporate Secretary maintains annual board meeting calendar: (a) Q1 meeting (February): previous year financial results, external audit report, dividend declaration, (b) Q2 meeting (May): Q1 results, annual strategy review, (c) Q3 meeting (August): H1 results, mid-year budget review, capex progress, (d) Q4 meeting (November): next year budget approval, strategic priorities, (e) ad-hoc: material acquisitions, officer changes, emergency matters
Responsible (R): Corporate Secretary
Accountable (A): Board Chair
Duration: Annual calendar</bpmn:documentation>
        <bpmn:incoming>W1714_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1714_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1714_Task7" name="30 days before meeting: Corporate Secretary solicits agenda items from Board…">
        <bpmn:documentation>Step 2: 30 days before meeting: Corporate Secretary solicits agenda items from Board Chair, CEO, CFO, and committee chairs; compiles draft agenda
Responsible (R): Corporate Secretary
Accountable (A): Board Chair
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W1714_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1714_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1714_Task8" name="CEO and CFO review draft agenda; add operational updates, financial reports…">
        <bpmn:documentation>Step 3: CEO and CFO review draft agenda; add operational updates, financial reports, and action items from previous meeting; propose presenters for each agenda item
Responsible (R): CEO / CFO
Accountable (A): Board Chair
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W1714_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1714_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1714_Task9" name="Board Chair approves final agenda; Corporate Secretary distributes to all board…">
        <bpmn:documentation>Step 4: Board Chair approves final agenda; Corporate Secretary distributes to all board members with meeting notice (minimum 5 business days before meeting per corporate by-laws)
Responsible (R): Board Chair / Corporate Secretary
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1714_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1714_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1714_Task10" name="For ad-hoc meetings: Corporate Secretary convenes upon request of Board Chair…">
        <bpmn:documentation>Step 5: For ad-hoc meetings: Corporate Secretary convenes upon request of Board Chair, CEO, or 2+ directors; notice period may be shortened for urgent matters; minutes must document urgency justification
Responsible (R): Corporate Secretary
Accountable (A): Board Chair
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1714_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1714_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1714_End11" name="Complete">
        <bpmn:incoming>W1714_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1714_Annotation12">
        <bpmn:text>Controls: - CTL-349 (ensure controlled execution — Board Meeting Management &amp; Corporate Records (PA-36.1).) | - operational: Corporate Secretary review and approval gate
Owner: Corporate Secretary</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1714_Assoc13" sourceRef="W1714_Annotation12" targetRef="W1714_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1714_Flow14" sourceRef="W1714_Start5" targetRef="W1714_Task6" />
      <bpmn:sequenceFlow id="W1714_Flow15" sourceRef="W1714_Task6" targetRef="W1714_Task7" />
      <bpmn:sequenceFlow id="W1714_Flow16" sourceRef="W1714_Task7" targetRef="W1714_Task8" />
      <bpmn:sequenceFlow id="W1714_Flow17" sourceRef="W1714_Task8" targetRef="W1714_Task9" />
      <bpmn:sequenceFlow id="W1714_Flow18" sourceRef="W1714_Task9" targetRef="W1714_Task10" />
      <bpmn:sequenceFlow id="W1714_Flow19" sourceRef="W1714_Task10" targetRef="W1714_End11" />
    </bpmn:process>
