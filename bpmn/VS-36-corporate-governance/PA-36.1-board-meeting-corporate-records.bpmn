    <bpmn:process id="W_W1720" name="W1720. Related-Party Transaction Identification &amp; Disclosure" isExecutable="false">
      <bpmn:documentation>Trigger: Any transaction between BuildRight entities or between the company and its directors, officers, or significant stockholders
Frequency: Continuous monitoring; quarterly disclosure review
Volume: ~50–100 related-party transactions/quarter (primarily intercompany between 5 entities)
Owner: Corporate Secretary
Participants: Corporate Secretary, CFO, Accounting Manager, External Auditor
Source: workflow W1720 — Related-Party Transaction Identification &amp; Disclosure</bpmn:documentation>
      <bpmn:laneSet id="W1720_LaneSet5">
        <bpmn:lane id="W1720_Lane1" name="System">
        <bpmn:flowNodeRef>W1720_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1720_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1720_Lane2" name="Corporate Secretary">
        <bpmn:flowNodeRef>W1720_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1720_Lane3" name="CFO">
        <bpmn:flowNodeRef>W1720_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1720_Lane4" name="External Auditor">
        <bpmn:flowNodeRef>W1720_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1720_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1720_Start6" name="Any transaction between BuildRight entities or between the company and its directors…">
        <bpmn:outgoing>W1720_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1720_Task7" name="System identifies related-party transactions: (a) intercompany transactions…">
        <bpmn:documentation>Step 1: System identifies related-party transactions: (a) intercompany transactions between the 5 BuildRight entities (warehousing fees, ecommerce fees, lease payments, management fees, loans), (b) transactions with directors, officers, and their family members (e.g., director-owned company supplying goods/services), (c) transactions with significant stockholders (&gt; 20% ownership), (d) joint venture or associate entity transactions
Responsible (R): System / Accounting Manager
Accountable (A): Corporate Secretary
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W1720_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1720_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1720_Task8" name="Corporate Secretary reviews related-party transaction register: (a) identifies…">
        <bpmn:documentation>Step 2: Corporate Secretary reviews related-party transaction register: (a) identifies transactions requiring board approval per Revised Corporation Code (certain related-party transactions require 2/3 board approval and disclosure to SEC), (b) verifies arm&#x27;s-length pricing documentation for intercompany transactions (transfer pricing study by external advisor), (c) ensures related-party transactions are properly recorded in board minutes
Responsible (R): Corporate Secretary
Accountable (A): Legal Counsel
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W1720_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1720_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1720_Task9" name="CFO ensures proper accounting: (a) intercompany transactions recorded in each…">
        <bpmn:documentation>Step 3: CFO ensures proper accounting: (a) intercompany transactions recorded in each entity&#x27;s books, (b) elimination entries during consolidation per PA-17.2, (c) related-party disclosures in financial statement notes per PFRS 124 (nature of relationship, amounts, outstanding balances, terms and conditions)
Responsible (R): CFO
Accountable (A): External Auditor
Duration: Part of financial close</bpmn:documentation>
        <bpmn:incoming>W1720_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1720_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1720_Task10" name="External auditor reviews related-party disclosures during annual audit…">
        <bpmn:documentation>Step 4: External auditor reviews related-party disclosures during annual audit; confirms completeness and PFRS 124 compliance
Responsible (R): External Auditor
Accountable (A): —
Duration: During annual audit</bpmn:documentation>
        <bpmn:incoming>W1720_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1720_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1720_End11" name="Complete">
        <bpmn:incoming>W1720_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1720_Annotation12">
        <bpmn:text>Controls: - CTL-231 (ensure corporate-governance compliance.) | - operational: Corporate Secretary review and approval gate
Owner: Corporate Secretary</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1720_Assoc13" sourceRef="W1720_Annotation12" targetRef="W1720_Start6" associationDirection="None" />
