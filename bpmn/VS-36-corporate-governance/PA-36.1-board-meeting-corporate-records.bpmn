    <bpmn:process id="W_W1715" name="W1715. Board Meeting Materials Preparation &amp; Distribution" isExecutable="false">
      <bpmn:documentation>Trigger: Board meeting agenda finalized (W1714)
Frequency: 6–10 times/year
Volume: ~50–100 pages of materials per meeting
Owner: Corporate Secretary
Participants: Corporate Secretary, CEO, CFO, all C-Suite, Department Heads (as presenters)
Source: workflow W1715 — Board Meeting Materials Preparation &amp; Distribution</bpmn:documentation>
      <bpmn:laneSet id="W1715_LaneSet4">
        <bpmn:lane id="W1715_Lane1" name="Corporate Secretary">
        <bpmn:flowNodeRef>W1715_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1715_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1715_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1715_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1715_Lane2" name="C-Suite">
        <bpmn:flowNodeRef>W1715_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1715_Lane3" name="CEO">
        <bpmn:flowNodeRef>W1715_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1715_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1715_Start5" name="Board meeting agenda finalized (W1714)">
        <bpmn:outgoing>W1715_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1715_Task6" name="Corporate Secretary assigns material preparation to responsible parties per…">
        <bpmn:documentation>Step 1: Corporate Secretary assigns material preparation to responsible parties per agenda: (a) CFO: financial statements, management discussion &amp; analysis, budget vs. actual, cash position, capex status, (b) COO: store operations update, new store pipeline, supply chain status, (c) CIO: IT project status, cybersecurity posture, (d) CMO: marketing performance, ecommerce metrics, (e) CHRO: headcount, turnover, key hires, organizational changes, (f) VP Legal: litigation update, regulatory changes, compliance status
Responsible (R): Corporate Secretary
Accountable (A): CEO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1715_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1715_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1715_Task7" name="Each presenter prepares section materials: (a) standardized format (executive…">
        <bpmn:documentation>Step 2: Each presenter prepares section materials: (a) standardized format (executive summary + detailed appendix), (b) comparison to prior period / budget, (c) action items and decisions required from board (clearly flagged), (d) submitted to Corporate Secretary 5 business days before meeting
Responsible (R): C-Suite / Department Heads
Accountable (A): Corporate Secretary
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W1715_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1715_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1715_Task8" name="Corporate Secretary compiles board book: (a) meeting agenda, (b) minutes of…">
        <bpmn:documentation>Step 3: Corporate Secretary compiles board book: (a) meeting agenda, (b) minutes of previous meeting (for approval), (c) action item tracker (status of prior board decisions), (d) financial package, (e) operational updates, (f) proposals requiring board action (with recommendation), (g) committee reports (audit, governance, compensation)
Responsible (R): Corporate Secretary
Accountable (A): CEO
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W1715_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1715_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1715_Task9" name="CEO reviews complete board book for consistency and completeness; provides…">
        <bpmn:documentation>Step 4: CEO reviews complete board book for consistency and completeness; provides final approval
Responsible (R): CEO
Accountable (A): Board Chair
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1715_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1715_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1715_Task10" name="Corporate Secretary distributes board book to directors: (a) secure electronic…">
        <bpmn:documentation>Step 5: Corporate Secretary distributes board book to directors: (a) secure electronic distribution (encrypted PDF or board portal), (b) physical copies for directors who prefer paper, (c) distributed minimum 3 business days before meeting, (d) confidential items (e.g., executive compensation, M&amp;A) distributed separately in sealed envelopes or secure portal section
Responsible (R): Corporate Secretary
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1715_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1715_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1715_End11" name="Complete">
        <bpmn:incoming>W1715_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1715_Annotation12">
        <bpmn:text>Controls: - CTL-231 (ensure corporate-governance compliance.) | - operational: Corporate Secretary review and approval gate
Owner: Corporate Secretary</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1715_Assoc13" sourceRef="W1715_Annotation12" targetRef="W1715_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1715_Flow14" sourceRef="W1715_Start5" targetRef="W1715_Task6" />
      <bpmn:sequenceFlow id="W1715_Flow15" sourceRef="W1715_Task6" targetRef="W1715_Task7" />
      <bpmn:sequenceFlow id="W1715_Flow16" sourceRef="W1715_Task7" targetRef="W1715_Task8" />
      <bpmn:sequenceFlow id="W1715_Flow17" sourceRef="W1715_Task8" targetRef="W1715_Task9" />
      <bpmn:sequenceFlow id="W1715_Flow18" sourceRef="W1715_Task9" targetRef="W1715_Task10" />
      <bpmn:sequenceFlow id="W1715_Flow19" sourceRef="W1715_Task10" targetRef="W1715_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1715_diag">
      <bpmndi:BPMNPlane id="W1715_plane" bpmnElement="W_W1715">
        <bpmndi:BPMNShape id="W1715_Lane1_di" bpmnElement="W1715_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1715_Lane2_di" bpmnElement="W1715_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1715_Lane3_di" bpmnElement="W1715_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1715_Task6_di" bpmnElement="W1715_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1715_Task7_di" bpmnElement="W1715_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
