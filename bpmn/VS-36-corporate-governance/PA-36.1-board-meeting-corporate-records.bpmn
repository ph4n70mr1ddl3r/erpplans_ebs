        <bpmndi:BPMNShape id="W1715_Start5_di" bpmnElement="W1715_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1715_End11_di" bpmnElement="W1715_End11"><dc:Bounds x="1470" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1715_Annotation12_di" bpmnElement="W1715_Annotation12"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1715_Flow14_di" bpmnElement="W1715_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1715_Flow15_di" bpmnElement="W1715_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1715_Flow16_di" bpmnElement="W1715_Flow16"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1715_Flow17_di" bpmnElement="W1715_Flow17"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1715_Flow18_di" bpmnElement="W1715_Flow18"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1715_Flow19_di" bpmnElement="W1715_Flow19"><di:waypoint x="1420" y="165" /><di:waypoint x="1470" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1715_Assoc13_di" bpmnElement="W1715_Assoc13"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1716" name="W1716. Board Meeting Minutes Recording &amp; Approval" isExecutable="false">
      <bpmn:documentation>Trigger: Board meeting convened
Frequency: 6–10 times/year
Volume: 1 set of minutes per meeting
Owner: Corporate Secretary
Participants: Corporate Secretary, Board Chair, all Directors
Source: workflow W1716 — Board Meeting Minutes Recording &amp; Approval</bpmn:documentation>
      <bpmn:laneSet id="W1716_LaneSet3">
        <bpmn:lane id="W1716_Lane1" name="Corporate Secretary">
        <bpmn:flowNodeRef>W1716_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1716_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1716_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1716_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1716_Lane2" name="Board Chair">
        <bpmn:flowNodeRef>W1716_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1716_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1716_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1716_Start4" name="Board meeting convened">
        <bpmn:outgoing>W1716_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1716_Task5" name="Corporate Secretary records minutes during meeting: (a) attendance (directors…">
        <bpmn:documentation>Step 1: Corporate Secretary records minutes during meeting: (a) attendance (directors present, absent, invited guests, management presenters), (b) quorum confirmed per by-laws, (c) key discussion points (summarized, not verbatim), (d) motions made and seconded, (e) vote results (unanimous, majority, dissenting opinions noted if director requests), (f) resolutions passed with exact wording, (g) action items assigned with owners and due dates, (h) time of adjournment
Responsible (R): Corporate Secretary
Accountable (A): —
Duration: During meeting</bpmn:documentation>
        <bpmn:incoming>W1716_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1716_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1716_Task6" name="Within 5 business days of meeting: Corporate Secretary prepares draft minutes…">
        <bpmn:documentation>Step 2: Within 5 business days of meeting: Corporate Secretary prepares draft minutes; circulates to Board Chair and CEO for review and accuracy confirmation
Responsible (R): Corporate Secretary
Accountable (A): Board Chair
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W1716_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1716_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1716_Task7" name="Board Chair approves draft minutes for circulation to all directors; directors…">
        <bpmn:documentation>Step 3: Board Chair approves draft minutes for circulation to all directors; directors review and may suggest corrections (factual only, not substantive changes to resolutions)
Responsible (R): Board Chair
Accountable (A): —
Duration: 5 days</bpmn:documentation>
        <bpmn:incoming>W1716_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1716_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1716_Task8" name="Minutes presented for formal approval at next board meeting; approved minutes…">
        <bpmn:documentation>Step 4: Minutes presented for formal approval at next board meeting; approved minutes signed by Board Chair and Corporate Secretary; become official corporate record
Responsible (R): Board Chair / Corporate Secretary
Accountable (A): —
Duration: At next meeting</bpmn:documentation>
        <bpmn:incoming>W1716_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1716_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1716_Task9" name="Signed minutes filed in corporate records per W1719; resolutions extracted and…">
        <bpmn:documentation>Step 5: Signed minutes filed in corporate records per W1719; resolutions extracted and distributed for execution per W1717
Responsible (R): Corporate Secretary
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1716_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1716_Flow18</bpmn:outgoing>
      </bpmn:userTask>
