<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-06.1-outbound-distribution" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W196" name="W196. Route Planning &amp; Dispatch Optimization" isExecutable="false">
      <bpmn:documentation>Trigger: Released Home Delivery orders (W19) or Store Replenishment orders (W4)
Frequency: Daily (Morning and Evening waves)
Volume: ~80–90 home deliveries/DC/day (the ~10,000 deliveries/month canon); ~55–60 store replenishments/DC/day (the ~5,000 replenishment orders/month canon)
Owner: Logistics Planner
Participants: Logistics Planner, DC Dispatch, Drivers, 3PL Partners
Source: workflow W196 — Route Planning &amp; Dispatch Optimization</bpmn:documentation>
      <bpmn:laneSet id="W196_LaneSet4">
        <bpmn:lane id="W196_Lane1" name="System">
        <bpmn:flowNodeRef>W196_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W196_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W196_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W196_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W196_Lane2" name="Logistics Planner">
        <bpmn:flowNodeRef>W196_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W196_Lane3" name="Driver">
        <bpmn:flowNodeRef>W196_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W196_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W196_Start5" name="Released Home Delivery orders (W19) or Store Replenishment orders (W4)">
        <bpmn:outgoing>W196_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W196_Task6" name="Batching">
        <bpmn:documentation>Step 1: Batching: System aggregates all pending deliveries by zone, weight, and volume (CBM)
Responsible (R): System
Accountable (A): Logistics Planner
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W196_Flow14</bpmn:incoming>
        <bpmn:outgoing>W196_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W196_Task7" name="Vehicle Allocation">
        <bpmn:documentation>Step 2: Vehicle Allocation: System recommends vehicle type (10-wheeler vs. 6-wheeler vs. small van) based on load and delivery access restrictions (e.g., &quot;Truck Ban&quot; zones)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W196_Flow15</bpmn:incoming>
        <bpmn:outgoing>W196_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W196_Task8" name="Optimization">
        <bpmn:documentation>Step 3: Optimization: Route Optimization Engine (in-house build — fit-gap C14) calculates most efficient sequence to minimize kilometers and fuel; accounts for traffic patterns and delivery windows
Responsible (R): System
Accountable (A): Logistics Planner
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W196_Flow16</bpmn:incoming>
        <bpmn:outgoing>W196_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W196_Task9" name="Manifest Generation">
        <bpmn:documentation>Step 4: Manifest Generation: Finalize route; system generates Trip Manifest and Load List; assigns to Driver/Vehicle
Responsible (R): Logistics Planner
Accountable (A): DC Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W196_Flow17</bpmn:incoming>
        <bpmn:outgoing>W196_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W196_Task10" name="Driver Briefing">
        <bpmn:documentation>Step 5: Driver Briefing: Driver receives digital manifest on mobile app; verifies load; starts trip
Responsible (R): Driver
Accountable (A): DC Dispatch
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W196_Flow18</bpmn:incoming>
        <bpmn:outgoing>W196_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W196_End11" name="Complete">
        <bpmn:incoming>W196_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W196_Annotation12">
        <bpmn:text>Controls: - CTL-178 (ensure fleet compliance &amp; freight-cost integrity.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Logistics Planner</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W196_Assoc13" sourceRef="W196_Annotation12" targetRef="W196_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W196_Flow14" sourceRef="W196_Start5" targetRef="W196_Task6" />
      <bpmn:sequenceFlow id="W196_Flow15" sourceRef="W196_Task6" targetRef="W196_Task7" />
      <bpmn:sequenceFlow id="W196_Flow16" sourceRef="W196_Task7" targetRef="W196_Task8" />
      <bpmn:sequenceFlow id="W196_Flow17" sourceRef="W196_Task8" targetRef="W196_Task9" />
      <bpmn:sequenceFlow id="W196_Flow18" sourceRef="W196_Task9" targetRef="W196_Task10" />
      <bpmn:sequenceFlow id="W196_Flow19" sourceRef="W196_Task10" targetRef="W196_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W196_diag">
      <bpmndi:BPMNPlane id="W196_plane" bpmnElement="W_W196">
        <bpmndi:BPMNShape id="W196_Lane1_di" bpmnElement="W196_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W196_Lane2_di" bpmnElement="W196_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W196_Lane3_di" bpmnElement="W196_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W196_Task6_di" bpmnElement="W196_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W196_Task7_di" bpmnElement="W196_Task7"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W196_Task8_di" bpmnElement="W196_Task8"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W196_Task9_di" bpmnElement="W196_Task9"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W196_Task10_di" bpmnElement="W196_Task10"><dc:Bounds x="1240" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W196_Start5_di" bpmnElement="W196_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W196_End11_di" bpmnElement="W196_End11"><dc:Bounds x="1470" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W196_Annotation12_di" bpmnElement="W196_Annotation12"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W196_Flow14_di" bpmnElement="W196_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W196_Flow15_di" bpmnElement="W196_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W196_Flow16_di" bpmnElement="W196_Flow16"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W196_Flow17_di" bpmnElement="W196_Flow17"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W196_Flow18_di" bpmnElement="W196_Flow18"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W196_Flow19_di" bpmnElement="W196_Flow19"><di:waypoint x="1420" y="505" /><di:waypoint x="1470" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W196_Assoc13_di" bpmnElement="W196_Assoc13"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W431" name="W431. LGU-Specific &quot;Truck Ban&quot; &amp; Route Governance" isExecutable="false">
      <bpmn:documentation>Trigger: Daily route planning (W196) for deliveries in Metro Manila or provincial cities with active truck bans
Frequency: Daily
Volume: ~150 delivery trips/day (DC to Store and DC to Customer)
Owner: Logistics Planner
Participants: DC Dispatch, Driver, Regional Manager, MMDA / LGU Traffic Enforcers
Source: workflow W431 — LGU-Specific &quot;Truck Ban&quot; &amp; Route Governance</bpmn:documentation>
      <bpmn:laneSet id="W431_LaneSet6">
        <bpmn:lane id="W431_Lane1" name="Logistics Planner">
        <bpmn:flowNodeRef>W431_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W431_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W431_Lane2" name="System">
        <bpmn:flowNodeRef>W431_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W431_Lane3" name="DC Dispatch">
        <bpmn:flowNodeRef>W431_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W431_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W431_Lane4" name="Regional Manager">
        <bpmn:flowNodeRef>W431_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W431_Lane5" name="Driver">
        <bpmn:flowNodeRef>W431_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W431_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W431_Start7" name="Daily route planning (W196) for deliveries in Metro Manila or provincial cities with…">
        <bpmn:outgoing>W431_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W431_Task8" name="Truck Ban Database Maintenance">
        <bpmn:documentation>Step 1: Truck Ban Database Maintenance: Logistics Planner updates the ERP &quot;Truck Ban Master&quot; with current ban hours per city, vehicle type (e.g., 6-wheeler vs. 10-wheeler), and exemption status (e.g., refrigerated or essential goods)
Responsible (R): Logistics Planner
Accountable (A): —
Duration: 1 hour/week</bpmn:documentation>
        <bpmn:incoming>W431_Flow17</bpmn:incoming>
        <bpmn:outgoing>W431_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W431_Task9" name="Route Constraint Input">
        <bpmn:documentation>Step 2: Route Constraint Input: Route optimization engine (W196) pulls active ban hours from the Master; system blocks delivery windows that fall within ban periods for specific zones
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W431_Flow18</bpmn:incoming>
        <bpmn:outgoing>W431_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W431_Task10" name="Dispatch Timing">
        <bpmn:documentation>Step 3: Dispatch Timing: DC Dispatch adjusts the &quot;Release Time&quot; for trucks to ensure they reach their destination before the morning ban starts (typically 6:00 AM) or after the afternoon ban ends
Responsible (R): DC Dispatch
Accountable (A): DC Manager
Duration: 10 min/trip</bpmn:documentation>
        <bpmn:incoming>W431_Flow19</bpmn:incoming>
        <bpmn:outgoing>W431_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W431_Task11" name="Exemption Management">
        <bpmn:documentation>Step 4: Exemption Management: For &quot;Essential Relief&quot; goods (W428), Regional Manager applies for special LGU &quot;Truck Ban Exemptions&quot;; system tags specific vehicles with the exemption permit number
Responsible (R): Regional Manager
Accountable (A): Logistics Mgr
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W431_Flow20</bpmn:incoming>
        <bpmn:outgoing>W431_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W431_Task12" name="Real-Time Diversion">
        <bpmn:documentation>Step 5: Real-Time Diversion: If a truck is delayed (traffic/accident) and risks being caught in the ban, DC Dispatch sends an &quot;Immediate Stop&quot; alert via the Driver App; Driver parks at a pre-designated &quot;Safe Zone&quot; until the ban lifts
Responsible (R): DC Dispatch
Accountable (A): Driver
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W431_Flow21</bpmn:incoming>
        <bpmn:outgoing>W431_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W431_Task13" name="Fine &amp; Impound Handling">
        <bpmn:documentation>Step 6: Fine &amp; Impound Handling: In case of apprehension, Driver logs the incident in the Fleet App; Logistics Manager coordinates with the LGU/MMDA for fine payment and vehicle release
Responsible (R): Driver / Logistics Mgr
Accountable (A): —
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W431_Flow22</bpmn:incoming>
        <bpmn:outgoing>W431_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W431_End14" name="Complete">
        <bpmn:incoming>W431_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W431_Annotation15">
        <bpmn:text>Controls: - CTL-178 (ensure fleet compliance &amp; freight-cost integrity.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Logistics Planner</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W431_Assoc16" sourceRef="W431_Annotation15" targetRef="W431_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W431_Flow17" sourceRef="W431_Start7" targetRef="W431_Task8" />
      <bpmn:sequenceFlow id="W431_Flow18" sourceRef="W431_Task8" targetRef="W431_Task9" />
      <bpmn:sequenceFlow id="W431_Flow19" sourceRef="W431_Task9" targetRef="W431_Task10" />
      <bpmn:sequenceFlow id="W431_Flow20" sourceRef="W431_Task10" targetRef="W431_Task11" />
      <bpmn:sequenceFlow id="W431_Flow21" sourceRef="W431_Task11" targetRef="W431_Task12" />
      <bpmn:sequenceFlow id="W431_Flow22" sourceRef="W431_Task12" targetRef="W431_Task13" />
      <bpmn:sequenceFlow id="W431_Flow23" sourceRef="W431_Task13" targetRef="W431_End14" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W431_diag">
      <bpmndi:BPMNPlane id="W431_plane" bpmnElement="W_W431">
        <bpmndi:BPMNShape id="W431_Lane1_di" bpmnElement="W431_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W431_Lane2_di" bpmnElement="W431_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W431_Lane3_di" bpmnElement="W431_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W431_Lane4_di" bpmnElement="W431_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W431_Lane5_di" bpmnElement="W431_Lane5" isHorizontal="true"><dc:Bounds x="160" y="760" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W431_Task8_di" bpmnElement="W431_Task8"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W431_Task9_di" bpmnElement="W431_Task9"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W431_Task10_di" bpmnElement="W431_Task10"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W431_Task11_di" bpmnElement="W431_Task11"><dc:Bounds x="1030" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W431_Task12_di" bpmnElement="W431_Task12"><dc:Bounds x="1240" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W431_Task13_di" bpmnElement="W431_Task13"><dc:Bounds x="1450" y="805" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W431_Start7_di" bpmnElement="W431_Start7"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W431_End14_di" bpmnElement="W431_End14"><dc:Bounds x="1680" y="827" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W431_Annotation15_di" bpmnElement="W431_Annotation15"><dc:Bounds x="160" y="970" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W431_Flow17_di" bpmnElement="W431_Flow17"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W431_Flow18_di" bpmnElement="W431_Flow18"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W431_Flow19_di" bpmnElement="W431_Flow19"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W431_Flow20_di" bpmnElement="W431_Flow20"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W431_Flow21_di" bpmnElement="W431_Flow21"><di:waypoint x="1210" y="675" /><di:waypoint x="1240" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W431_Flow22_di" bpmnElement="W431_Flow22"><di:waypoint x="1420" y="505" /><di:waypoint x="1450" y="845" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W431_Flow23_di" bpmnElement="W431_Flow23"><di:waypoint x="1630" y="845" /><di:waypoint x="1680" y="845" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W431_Assoc16_di" bpmnElement="W431_Assoc16"><di:waypoint x="340" y="970" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1167" name="W1167. Reverse Logistics &amp; Vendor Return Shipment Management" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor return authorization created in W88 (RTV Processing) or product recall per W622; or DC-initiated return for damaged/defective/overstock goods
Frequency: ~200–300 vendor return shipments/month across all DCs
Volume: ~50–75 return shipments per DC per month; average 8–12 lines per return
Owner: DC Returns Coordinator
Participants: DC Returns Coordinator, Category Manager (return authorization), DC Dispatch, Logistics Planner, AP Clerk
Source: workflow W1167 — Reverse Logistics &amp; Vendor Return Shipment Management</bpmn:documentation>
      <bpmn:laneSet id="W1167_LaneSet4">
        <bpmn:lane id="W1167_Lane1" name="DC Returns Coordinator">
        <bpmn:flowNodeRef>W1167_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1167_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1167_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1167_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1167_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1167_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1167_Lane2" name="Logistics Planner">
        <bpmn:flowNodeRef>W1167_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1167_Lane3" name="AP Clerk">
        <bpmn:flowNodeRef>W1167_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1167_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1167_Start5" name="Vendor return authorization created in W88 (RTV Processing) or product recall per W622…">
        <bpmn:outgoing>W1167_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1167_Task6" name="Return consolidation at DC">
        <bpmn:documentation>Step 1: Return consolidation at DC: Store-returned goods (per W91, W12) arrive at DC via backhaul on regular store replenishment trucks; DC Returns Coordinator segregates return items into designated &quot;Return Staging Area&quot; by vendor and return reason; scan each item into return staging location in WMS
Responsible (R): DC Returns Coordinator
Accountable (A): DC Supervisor
Duration: 30 min/truck</bpmn:documentation>
        <bpmn:incoming>W1167_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1167_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1167_Task7" name="Return shipment planning">
        <bpmn:documentation>Step 2: Return shipment planning: Weekly, DC Returns Coordinator reviews accumulated return inventory by vendor; group returns into full-pallet or LTL shipments based on volume and vendor location; coordinate with Logistics Planner to schedule pickup during DC dock off-peak hours per W585
Responsible (R): DC Returns Coordinator
Accountable (A): DC Manager
Duration: 2 hours/week</bpmn:documentation>
        <bpmn:incoming>W1167_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1167_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1167_Task8" name="Documentation &amp; authorization">
        <bpmn:documentation>Step 3: Documentation &amp; authorization: For each return shipment: (a) generate Return Shipment Advance Shipping Notice (ASN) with item list, quantities, and return reason codes per W88 authorization; (b) attach vendor Return Merchandise Authorization (RMA) number; (c) for recalled items per W622, include recall reference and safety compliance documentation; (d) for import returns, prepare customs re-export documentation if duty recovery applies
Responsible (R): DC Returns Coordinator
Accountable (A): Category Manager
Duration: 30 min/shipment</bpmn:documentation>
        <bpmn:incoming>W1167_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1167_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1167_Task9" name="Carrier booking &amp; dispatch">
        <bpmn:documentation>Step 4: Carrier booking &amp; dispatch: Logistics Planner books carrier for return shipment pickup; for local vendors, arrange vendor&#x27;s own pickup or BuildRight&#x27;s backhaul truck; for import vendors, book freight forwarder for return shipment; generate Return Manifest; DC Dispatch coordinates dock appointment per W585
Responsible (R): Logistics Planner / DC Dispatch
Accountable (A): DC Manager
Duration: 30 min/shipment</bpmn:documentation>
        <bpmn:incoming>W1167_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1167_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1167_Task10" name="Loading &amp; dispatch">
        <bpmn:documentation>Step 5: Loading &amp; dispatch: DC loaders stage return pallets on dock; verify items against Return Manifest; photograph pallet condition for proof; carrier signs Bill of Lading; system updates return order status to &quot;Shipped to Vendor&quot;; inventory relieved from DC
Responsible (R): DC Returns Coordinator / Loader
Accountable (A): DC Supervisor
Duration: 30 min/shipment</bpmn:documentation>
        <bpmn:incoming>W1167_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1167_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1167_Task11" name="Vendor credit follow-up">
        <bpmn:documentation>Step 6: Vendor credit follow-up: AP Clerk tracks return shipment delivery to vendor; if vendor does not issue credit within 30 days of receipt, escalate to Category Manager per W244 invoice dispute; for recalled items, track vendor reimbursement per W1151 recall cost recovery
Responsible (R): AP Clerk
Accountable (A): Category Manager
Duration: 15 min/return</bpmn:documentation>
        <bpmn:incoming>W1167_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1167_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1167_Task12" name="Monthly reverse logistics analytics">
        <bpmn:documentation>Step 7: Monthly reverse logistics analytics: DC Returns Coordinator compiles monthly report: return volume by reason (defective, overstock, recall, consignment), return-to-vendor cycle time, carrier cost per return shipment, DC staging area utilization, vendor credit realization rate
Responsible (R): DC Returns Coordinator
Accountable (A): VP Supply Chain
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1167_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1167_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1167_End13" name="Complete">
        <bpmn:incoming>W1167_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1167_Annotation14">
        <bpmn:text>Controls: - CTL-256 (ensure controlled execution — Outbound Distribution (PA-06.1).) | - operational: DC Returns Coordinator review and approval gate
Owner: DC Returns Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1167_Assoc15" sourceRef="W1167_Annotation14" targetRef="W1167_Start5" associationDirection="None" />
