    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1255_diag">
      <bpmndi:BPMNPlane id="W1255_plane" bpmnElement="W_W1255">
        <bpmndi:BPMNShape id="W1255_Lane1_di" bpmnElement="W1255_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1255_Lane2_di" bpmnElement="W1255_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1255_Task5_di" bpmnElement="W1255_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1255_Task6_di" bpmnElement="W1255_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1255_Task7_di" bpmnElement="W1255_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1255_Task8_di" bpmnElement="W1255_Task8"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1255_Task9_di" bpmnElement="W1255_Task9"><dc:Bounds x="1240" y="125" width="180" height="80" /></bpmndi:BPMNShape>
