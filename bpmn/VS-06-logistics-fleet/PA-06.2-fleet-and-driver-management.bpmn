    <bpmn:process id="W_W197" name="W197. Driver Performance &amp; Safety Management" isExecutable="false">
      <bpmn:documentation>Trigger: New driver onboarding; or monthly performance review cycle
Frequency: Continuous monitoring; Monthly review
Volume: ~250–300 company drivers
Owner: Fleet Manager
Participants: Driver, Fleet Manager, Safety Officer, HR
Source: workflow W197 — Driver Performance &amp; Safety Management</bpmn:documentation>
      <bpmn:laneSet id="W197_LaneSet4">
        <bpmn:lane id="W197_Lane1" name="System">
        <bpmn:flowNodeRef>W197_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W197_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W197_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W197_Lane2" name="Safety Officer">
        <bpmn:flowNodeRef>W197_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W197_Lane3" name="Fleet Manager">
        <bpmn:flowNodeRef>W197_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W197_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W197_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W197_Start5" name="New driver onboarding; or monthly performance review cycle">
        <bpmn:outgoing>W197_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W197_Task6" name="Licensing &amp; Compliance">
        <bpmn:documentation>Step 1: Licensing &amp; Compliance: System tracks Driver License expiries and professional certifications (e.g., Hazmat for paint)
Responsible (R): System
Accountable (A): Fleet Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W197_Flow14</bpmn:incoming>
        <bpmn:outgoing>W197_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W197_Task7" name="Safety Monitoring">
        <bpmn:documentation>Step 2: Safety Monitoring: Telematics system logs events: Harsh braking, over-speeding, idling, and unauthorized stops
Responsible (R): System
Accountable (A): —
Duration: Real-time</bpmn:documentation>
        <bpmn:incoming>W197_Flow15</bpmn:incoming>
        <bpmn:outgoing>W197_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W197_Task8" name="Incident Review">
        <bpmn:documentation>Step 3: Incident Review: Safety Officer reviews telematics alerts daily; conducts &quot;Coaching Session&quot; for frequent offenders
Responsible (R): Safety Officer
Accountable (A): —
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W197_Flow16</bpmn:incoming>
        <bpmn:outgoing>W197_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W197_Task9" name="Performance Scoring">
        <bpmn:documentation>Step 4: Performance Scoring: Monthly &quot;Driver Scorecard&quot; based on: On-time delivery %, fuel efficiency (km/L), and safety incidents
Responsible (R): Fleet Manager
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W197_Flow17</bpmn:incoming>
        <bpmn:outgoing>W197_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W197_Task10" name="Rewards/Discipline">
        <bpmn:documentation>Step 5: Rewards/Discipline: High scorers eligible for &quot;Safety Bonus&quot;; low scorers trigger HR counseling (W72)
Responsible (R): Fleet Manager
Accountable (A): CHRO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W197_Flow18</bpmn:incoming>
        <bpmn:outgoing>W197_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W197_End11" name="Complete">
        <bpmn:incoming>W197_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W197_Annotation12">
        <bpmn:text>Controls: - CTL-257 (ensure controlled execution — Fleet &amp; Driver Management (PA-06.2).) | - operational: Fleet Manager review and approval gate
Owner: Fleet Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W197_Assoc13" sourceRef="W197_Annotation12" targetRef="W197_Start5" associationDirection="None" />
