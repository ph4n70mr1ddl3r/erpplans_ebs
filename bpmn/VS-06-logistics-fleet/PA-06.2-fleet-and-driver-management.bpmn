    <bpmn:process id="W_W653" name="W653. Fleet Accident &amp; Incident Management" isExecutable="false">
      <bpmn:documentation>Trigger: Vehicle accident, cargo damage incident, or third-party property damage during delivery operations
Frequency: ~10–15 incidents/month across fleet
Volume: ~2–4 per week
Owner: Fleet Safety Officer
Participants: Driver, Fleet Manager, Insurance Claims Coordinator, LP Analyst, HR Business Partner (if driver injury)
Source: workflow W653 — Fleet Accident &amp; Incident Management</bpmn:documentation>
      <bpmn:laneSet id="W653_LaneSet5">
        <bpmn:lane id="W653_Lane1" name="Driver">
        <bpmn:flowNodeRef>W653_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W653_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W653_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W653_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W653_Lane2" name="Fleet Safety Officer">
        <bpmn:flowNodeRef>W653_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W653_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W653_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W653_Lane3" name="Fleet Manager">
        <bpmn:flowNodeRef>W653_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W653_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W653_Lane4" name="Insurance Claims Coordinator">
        <bpmn:flowNodeRef>W653_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W653_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W653_Start6" name="Vehicle accident, cargo damage incident, or third-party property damage during delivery…">
        <bpmn:outgoing>W653_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W653_Task7" name="Driver activates incident protocol: stops vehicle, secures scene, checks for…">
        <bpmn:documentation>Step 1: Driver activates incident protocol: stops vehicle, secures scene, checks for injuries, calls emergency services if needed, notifies Fleet Manager via mobile app within 15 minutes
Responsible (R): Driver
Accountable (A): Fleet Safety Officer
Duration: Immediate</bpmn:documentation>
        <bpmn:incoming>W653_Flow19</bpmn:incoming>
        <bpmn:outgoing>W653_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W653_Task8" name="Driver collects evidence: photographs of vehicle damage, third-party…">
        <bpmn:documentation>Step 2: Driver collects evidence: photographs of vehicle damage, third-party vehicle/property damage, road conditions, cargo condition; obtains third-party information (name, contact, vehicle details, insurance); identifies witnesses; does NOT admit fault
Responsible (R): Driver
Accountable (A): Fleet Safety Officer
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W653_Flow20</bpmn:incoming>
        <bpmn:outgoing>W653_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W653_Task9" name="For accidents with injuries or significant property damage: Driver files police…">
        <bpmn:documentation>Step 3: For accidents with injuries or significant property damage: Driver files police report at nearest PNP station; obtains police blotter reference number
Responsible (R): Driver
Accountable (A): Fleet Safety Officer
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W653_Flow21</bpmn:incoming>
        <bpmn:outgoing>W653_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W653_Task10" name="Fleet Safety Officer receives incident report; classifies severity (Minor…">
        <bpmn:documentation>Step 4: Fleet Safety Officer receives incident report; classifies severity (Minor: cosmetic damage only, Moderate: functional damage, cargo affected, Major: injury, total loss, third-party claim); activates appropriate response level
Responsible (R): Fleet Safety Officer
Accountable (A): Fleet Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W653_Flow22</bpmn:incoming>
        <bpmn:outgoing>W653_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W653_Task11" name="Fleet Manager arranges: vehicle recovery/towing if undrivable, cargo…">
        <bpmn:documentation>Step 5: Fleet Manager arranges: vehicle recovery/towing if undrivable, cargo salvage/transfer to backup vehicle for delivery completion, driver medical assessment if injured
Responsible (R): Fleet Manager
Accountable (A): Fleet Safety Officer
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W653_Flow23</bpmn:incoming>
        <bpmn:outgoing>W653_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W653_Task12" name="Insurance Claims Coordinator initiates insurance claim per W610: submits…">
        <bpmn:documentation>Step 6: Insurance Claims Coordinator initiates insurance claim per W610: submits incident report with evidence, obtains repair estimate from accredited shop, tracks claim to settlement
Responsible (R): Insurance Claims Coordinator
Accountable (A): Fleet Manager
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W653_Flow24</bpmn:incoming>
        <bpmn:outgoing>W653_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W653_Task13" name="Fleet Safety Officer conducts investigation: reviews telematics data (speed…">
        <bpmn:documentation>Step 7: Fleet Safety Officer conducts investigation: reviews telematics data (speed, braking, location), driver history, route conditions; determines root cause (driver error, vehicle failure, third-party fault, road hazard); classifies preventability
Responsible (R): Fleet Safety Officer
Accountable (A): Fleet Manager
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W653_Flow25</bpmn:incoming>
        <bpmn:outgoing>W653_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W653_Task14" name="For preventable accidents: Fleet Manager applies progressive discipline per…">
        <bpmn:documentation>Step 8: For preventable accidents: Fleet Manager applies progressive discipline per driver safety program (W197); assigns remedial training; adjusts driver safety score
Responsible (R): Fleet Manager
Accountable (A): VP Supply Chain
Duration: Per W197</bpmn:documentation>
        <bpmn:incoming>W653_Flow26</bpmn:incoming>
        <bpmn:outgoing>W653_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W653_Task15" name="Monthly: Fleet Safety Officer produces incident analytics: incident rate per…">
        <bpmn:documentation>Step 9: Monthly: Fleet Safety Officer produces incident analytics: incident rate per 100,000 km, preventability rate, cost per incident, trend by driver/route/vehicle/time; feeds driver performance dashboard (W197)
Responsible (R): Fleet Safety Officer
Accountable (A): Fleet Manager
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W653_Flow27</bpmn:incoming>
        <bpmn:outgoing>W653_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W653_End16" name="Complete">
        <bpmn:incoming>W653_Flow28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W653_Annotation17">
        <bpmn:text>Controls: - CTL-257 (ensure controlled execution — Fleet &amp; Driver Management (PA-06.2).) | - operational: Fleet Safety Officer review and approval gate
Owner: Fleet Safety Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W653_Assoc18" sourceRef="W653_Annotation17" targetRef="W653_Start6" associationDirection="None" />
