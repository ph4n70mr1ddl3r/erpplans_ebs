    <bpmn:process id="W_W199" name="W199. Fleet Telematics &amp; Real-Time Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Vehicle starts trip
Frequency: Real-time
Volume: Continuous tracking of ~100–150 active delivery vehicles daily
Owner: DC Dispatch
Participants: DC Dispatch, Customer Service, Customer
Source: workflow W199 — Fleet Telematics &amp; Real-Time Tracking</bpmn:documentation>
      <bpmn:laneSet id="W199_LaneSet3">
        <bpmn:lane id="W199_Lane1" name="System">
        <bpmn:flowNodeRef>W199_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W199_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W199_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W199_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W199_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W199_Lane2" name="DC Dispatch">
        <bpmn:flowNodeRef>W199_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W199_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W199_Start4" name="Vehicle starts trip">
        <bpmn:outgoing>W199_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W199_Task5" name="GPS Tracking">
        <bpmn:documentation>Step 1: GPS Tracking: System tracks vehicle location, speed, and status (moving/stopped/idle)
Responsible (R): System
Accountable (A): —
Duration: Real-time</bpmn:documentation>
        <bpmn:incoming>W199_Flow13</bpmn:incoming>
        <bpmn:outgoing>W199_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W199_Task6" name="Dynamic ETA">
        <bpmn:documentation>Step 2: Dynamic ETA: System recalculates Estimated Time of Arrival (ETA) based on live traffic; updates customer via SMS/App
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W199_Flow14</bpmn:incoming>
        <bpmn:outgoing>W199_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W199_Task7" name="Geofencing">
        <bpmn:documentation>Step 3: Geofencing: System alerts DC Dispatch when vehicle arrives at or leaves a store/customer site; logs &quot;Time on Site&quot;
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W199_Flow15</bpmn:incoming>
        <bpmn:outgoing>W199_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W199_Task8" name="Dispatch Dashboard">
        <bpmn:documentation>Step 4: Dispatch Dashboard: DC Dispatch monitors all active vehicles on map; identifies delays or breakdowns
Responsible (R): DC Dispatch
Accountable (A): —
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W199_Flow16</bpmn:incoming>
        <bpmn:outgoing>W199_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W199_Task9" name="Maintenance Integration">
        <bpmn:documentation>Step 5: Maintenance Integration: Odometer data from telematics auto-triggers &quot;Preventive Maintenance&quot; in W188 when thresholds reached
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W199_Flow17</bpmn:incoming>
        <bpmn:outgoing>W199_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W199_End10" name="Complete">
        <bpmn:incoming>W199_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W199_Annotation11">
        <bpmn:text>Controls: - CTL-257 (ensure controlled execution — Fleet &amp; Driver Management (PA-06.2).) | - operational: DC Dispatch continuous monitoring with delay/breakdown alert handling and carrier escalation
Owner: DC Dispatch</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W199_Assoc12" sourceRef="W199_Annotation11" targetRef="W199_Start4" associationDirection="None" />
