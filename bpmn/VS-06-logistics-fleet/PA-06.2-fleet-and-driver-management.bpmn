<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-06.2-fleet-and-driver-management" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1348" name="W1348. Fleet Vehicle Preventive Maintenance Scheduling, Work Order &amp; Parts Management" isExecutable="false">
      <bpmn:documentation>Trigger: Vehicle odometer or engine-hours threshold reached; or calendar-based service interval due
Frequency: Per-vehicle: every 10,000 km or 6 months (whichever comes first); ~20% owned fleet (40 trucks) + 80% third-party (160 trucks, third-party maintenance outside scope)
Volume: ~40 owned trucks × 2–3 services/year = ~80–120 preventive maintenance (PM) events/year; ~7–10 PM events/month
Owner: Fleet Maintenance Supervisor
Participants: Fleet Maintenance Supervisor, Mechanic, Parts Coordinator, Logistics Planner, Finance (capex approval for major services)
Source: workflow W1348 — Fleet Vehicle Preventive Maintenance Scheduling, Work Order &amp; Parts Management</bpmn:documentation>
      <bpmn:laneSet id="W1348_LaneSet6">
        <bpmn:lane id="W1348_Lane1" name="System">
        <bpmn:flowNodeRef>W1348_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1348_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1348_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1348_Lane2" name="Fleet Maintenance Supervisor">
        <bpmn:flowNodeRef>W1348_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1348_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1348_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1348_Lane3" name="Parts Coordinator">
        <bpmn:flowNodeRef>W1348_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1348_Lane4" name="Mechanic">
        <bpmn:flowNodeRef>W1348_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1348_Lane5" name="Finance">
        <bpmn:flowNodeRef>W1348_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1348_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1348_Start7" name="Vehicle odometer or engine-hours threshold reached; or calendar-based service interval due">
        <bpmn:outgoing>W1348_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1348_Task8" name="System tracks vehicle odometer and engine-hours via telematics (W199)…">
        <bpmn:documentation>Step 1: System tracks vehicle odometer and engine-hours via telematics (W199); auto-generates PM alert when threshold is within 500 km or 2 weeks of due date
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1348_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1348_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1348_Task9" name="Fleet Maintenance Supervisor reviews upcoming PM schedule against delivery…">
        <bpmn:documentation>Step 2: Fleet Maintenance Supervisor reviews upcoming PM schedule against delivery dispatch plan; selects service window that minimizes fleet impact (typically between dispatch waves or on low-demand days)
Responsible (R): Fleet Maintenance Supervisor
Accountable (A): Logistics Manager
Duration: 30 min/week</bpmn:documentation>
        <bpmn:incoming>W1348_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1348_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1348_Task10" name="Fleet Maintenance Supervisor creates digital PM work order: standard service…">
        <bpmn:documentation>Step 3: Fleet Maintenance Supervisor creates digital PM work order: standard service checklist (oil change, brake inspection, tire rotation, fluid top-up, belt/hose inspection, electrical system check)
Responsible (R): Fleet Maintenance Supervisor
Accountable (A): —
Duration: 15 min/work order</bpmn:documentation>
        <bpmn:incoming>W1348_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1348_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1348_Task11" name="Parts Coordinator checks parts availability for scheduled PM items; orders…">
        <bpmn:documentation>Step 4: Parts Coordinator checks parts availability for scheduled PM items; orders parts if not in stock from approved automotive suppliers (lead time: 2–5 days for common parts)
Responsible (R): Parts Coordinator
Accountable (A): Fleet Maintenance Supervisor
Duration: 30 min/work order</bpmn:documentation>
        <bpmn:incoming>W1348_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1348_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1348_Task12" name="Mechanic performs PM per work order checklist; records findings, parts used…">
        <bpmn:documentation>Step 5: Mechanic performs PM per work order checklist; records findings, parts used, and labor hours in system; flags any issues requiring follow-up repair
Responsible (R): Mechanic
Accountable (A): Fleet Maintenance Supervisor
Duration: 4–8 hours/truck</bpmn:documentation>
        <bpmn:incoming>W1348_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1348_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1348_Task13" name="Fleet Maintenance Supervisor reviews completed work order; approves or…">
        <bpmn:documentation>Step 6: Fleet Maintenance Supervisor reviews completed work order; approves or schedules follow-up repair for flagged issues; updates vehicle maintenance history
Responsible (R): Fleet Maintenance Supervisor
Accountable (A): —
Duration: 15 min/work order</bpmn:documentation>
        <bpmn:incoming>W1348_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1348_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1348_Task14" name="Finance receives completed work order with parts and labor costs; processes…">
        <bpmn:documentation>Step 7: Finance receives completed work order with parts and labor costs; processes vendor payment for externally sourced parts; records maintenance cost against vehicle asset
Responsible (R): Finance (AP)
Accountable (A): Controller
Duration: Per W7</bpmn:documentation>
        <bpmn:incoming>W1348_Flow25</bpmn:incoming>
        <bpmn:outgoing>W1348_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1348_Task15" name="System updates vehicle availability status back to &quot;active&quot; in dispatch…">
        <bpmn:documentation>Step 8: System updates vehicle availability status back to &quot;active&quot; in dispatch planning module
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1348_Flow26</bpmn:incoming>
        <bpmn:outgoing>W1348_Flow27</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1348_End16" name="Complete">
        <bpmn:incoming>W1348_Flow27</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1348_Annotation17">
        <bpmn:text>Controls: - CTL-257 (ensure controlled execution — Fleet &amp; Driver Management (PA-06.2).) | - operational: Fleet Maintenance Supervisor review and approval gate
Owner: Fleet Maintenance Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1348_Assoc18" sourceRef="W1348_Annotation17" targetRef="W1348_Start7" associationDirection="None" />
