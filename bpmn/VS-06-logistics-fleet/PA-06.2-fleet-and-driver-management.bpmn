    <bpmn:process id="W_W198" name="W198. Fuel Management &amp; Consumption Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Fueling event; or end of month
Frequency: Ongoing
Volume: ~PHP 10M–15M monthly fuel spend
Owner: Fleet Accountant
Participants: Driver, Gas Station (Vendor), Fleet Accountant, Finance
Source: workflow W198 — Fuel Management &amp; Consumption Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W198_LaneSet5">
        <bpmn:lane id="W198_Lane1" name="Driver">
        <bpmn:flowNodeRef>W198_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W198_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W198_Lane2" name="System">
        <bpmn:flowNodeRef>W198_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W198_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W198_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W198_Lane3" name="Fleet Manager">
        <bpmn:flowNodeRef>W198_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W198_Lane4" name="Finance">
        <bpmn:flowNodeRef>W198_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W198_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W198_Start6" name="Fueling event; or end of month">
        <bpmn:outgoing>W198_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W198_Task7" name="Fueling">
        <bpmn:documentation>Step 1: Fueling: Driver uses company Fuel Card; enters odometer reading at pump
Responsible (R): Driver
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W198_Flow16</bpmn:incoming>
        <bpmn:outgoing>W198_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W198_Task8" name="Data Integration">
        <bpmn:documentation>Step 2: Data Integration: Fuel vendor (Shell/Petron) sends daily electronic file of all transactions
Responsible (R): System
Accountable (A): Fleet Accountant
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W198_Flow17</bpmn:incoming>
        <bpmn:outgoing>W198_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W198_Task9" name="Reconciliation">
        <bpmn:documentation>Step 3: Reconciliation: System matches fuel transaction to vehicle and compares odometer jump vs. fuel volume to calculate actual km/L
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W198_Flow18</bpmn:incoming>
        <bpmn:outgoing>W198_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W198_Task10" name="Exception Alert">
        <bpmn:documentation>Step 4: Exception Alert: System flags anomalies: (a) Fuel volume &gt; Tank capacity; (b) Low km/L (potential fuel siphoning); (c) Fueling far from assigned route
Responsible (R): System
Accountable (A): Fleet Accountant
Duration: Real-time</bpmn:documentation>
        <bpmn:incoming>W198_Flow19</bpmn:incoming>
        <bpmn:outgoing>W198_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W198_Task11" name="Investigation">
        <bpmn:documentation>Step 5: Investigation: Fleet Manager investigates flagged transactions; if fraud confirmed, trigger W123 (Fraud Protocol)
Responsible (R): Fleet Manager
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W198_Flow20</bpmn:incoming>
        <bpmn:outgoing>W198_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W198_Task12" name="Payment">
        <bpmn:documentation>Step 6: Payment: Finance processes monthly fuel invoice; system allocates costs to specific vehicles and cost centers
Responsible (R): Finance
Accountable (A): Controller
Duration: Per W7</bpmn:documentation>
        <bpmn:incoming>W198_Flow21</bpmn:incoming>
        <bpmn:outgoing>W198_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W198_End13" name="Complete">
        <bpmn:incoming>W198_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W198_Annotation14">
        <bpmn:text>Controls: - CTL-178 (ensure fleet compliance &amp; freight-cost integrity.) | - operational: periodic reconciliation against source documents
Owner: Fleet Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W198_Assoc15" sourceRef="W198_Annotation14" targetRef="W198_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W198_Flow16" sourceRef="W198_Start6" targetRef="W198_Task7" />
