    <bpmn:process id="W_W1536" name="W1536. Fleet Vehicle Registration Renewal, LTO Compliance &amp; LTFRB Cargo Freight License Management" isExecutable="false">
      <bpmn:documentation>Trigger: Vehicle registration renewal due (annual); or LTFRB freight license renewal (every 3–5 years); or new vehicle acquisition
Frequency: ~40–60 vehicle registrations/year (owned fleet of ~20% of total truck requirement); ~5–10 LTFRB renewals/year
Volume: Critical for BuildRight Logistics, Inc. owned fleet operations
Owner: Fleet Manager
Participants: Fleet Manager, Fleet Assistant, Logistics Planner, LTO/LTFRB liaison
Source: workflow W1536 — Fleet Vehicle Registration Renewal, LTO Compliance &amp; LTFRB Cargo Freight License Management</bpmn:documentation>
      <bpmn:laneSet id="W1536_LaneSet4">
        <bpmn:lane id="W1536_Lane1" name="System">
        <bpmn:flowNodeRef>W1536_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1536_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1536_Lane2" name="Fleet Assistant">
        <bpmn:flowNodeRef>W1536_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1536_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1536_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1536_Lane3" name="Fleet Manager">
        <bpmn:flowNodeRef>W1536_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1536_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1536_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1536_Start5" name="Vehicle registration renewal due (annual); or LTFRB freight license renewal (every 3–5…">
        <bpmn:outgoing>W1536_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1536_Task6" name="Renewal calendar management">
        <bpmn:documentation>Step 1: Renewal calendar management: System maintains vehicle registration master with plate number, renewal month (based on LTO plate ending schedule), LTFRB franchise expiry, and insurance expiry; generates automated alerts at 60 days and 30 days before each renewal due date
Responsible (R): System / Fleet Assistant
Accountable (A): Fleet Manager
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1536_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1536_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1536_Task7" name="Pre-inspection preparation">
        <bpmn:documentation>Step 2: Pre-inspection preparation: Fleet Assistant schedules vehicle for mechanical inspection — brakes, tires, lights, body condition, emission testing (required by LTO); coordinates with maintenance workshop (W188) for any needed repairs before LTO inspection
Responsible (R): Fleet Assistant
Accountable (A): Fleet Manager
Duration: 1–2 days/vehicle</bpmn:documentation>
        <bpmn:incoming>W1536_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1536_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1536_Task8" name="LTO transaction processing">
        <bpmn:documentation>Step 3: LTO transaction processing: Fleet Assistant (or authorized liaison) processes registration renewal at LTO — submits required documents (OR/CR, insurance policy, emission test result, stencil of engine/chassis number), pays fees; for vehicles requiring physical inspection, brings vehicle to LTO inspection center
Responsible (R): Fleet Assistant
Accountable (A): —
Duration: 4–8 hours/vehicle</bpmn:documentation>
        <bpmn:incoming>W1536_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1536_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1536_Task9" name="LTFRB compliance">
        <bpmn:documentation>Step 4: LTFRB compliance: For vehicles requiring LTFRB franchise renewal, Fleet Manager prepares application — proof of financial capacity, vehicle maintenance records, driver qualifications, insurance coverage; attends LTFRB hearing if required; CPC renewal typically takes 30–60 days
Responsible (R): Fleet Manager
Accountable (A): VP Supply Chain
Duration: 2–3 days/application</bpmn:documentation>
        <bpmn:incoming>W1536_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1536_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1536_Task10" name="System update &amp; documentation">
        <bpmn:documentation>Step 5: System update &amp; documentation: Upon successful renewal, Fleet Assistant updates fleet master (W401) with new registration expiry, new OR/CR details, updated insurance policy; uploads scanned copies of all renewed documents to document management system (W255)
Responsible (R): Fleet Assistant
Accountable (A): Fleet Manager
Duration: 15 min/vehicle</bpmn:documentation>
        <bpmn:incoming>W1536_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1536_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1536_Task11" name="Compliance monitoring">
        <bpmn:documentation>Step 6: Compliance monitoring: Fleet Manager runs monthly fleet compliance dashboard — vehicles with current vs. expired registration, upcoming renewals, vehicles out of service for non-compliance; any expired vehicle is blocked from dispatch assignment in routing system (W196)
Responsible (R): Fleet Manager
Accountable (A): VP Supply Chain
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W1536_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1536_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1536_End12" name="Complete">
        <bpmn:incoming>W1536_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1536_Annotation13">
        <bpmn:text>Controls: - CTL-257 (ensure controlled execution — Fleet &amp; Driver Management (PA-06.2).) | - operational: downtime and processing backlogs
Owner: Fleet Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1536_Assoc14" sourceRef="W1536_Annotation13" targetRef="W1536_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1536_Flow15" sourceRef="W1536_Start5" targetRef="W1536_Task6" />
      <bpmn:sequenceFlow id="W1536_Flow16" sourceRef="W1536_Task6" targetRef="W1536_Task7" />
      <bpmn:sequenceFlow id="W1536_Flow17" sourceRef="W1536_Task7" targetRef="W1536_Task8" />
