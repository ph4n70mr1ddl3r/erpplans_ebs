        <bpmn:flowNodeRef>W1400_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1400_Lane2" name="System">
        <bpmn:flowNodeRef>W1400_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1400_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1400_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1400_Lane3" name="Driver">
        <bpmn:flowNodeRef>W1400_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1400_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1400_Start5" name="Monthly compliance review cycle; or LTO license expiration approaching (system alert at…">
        <bpmn:outgoing>W1400_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1400_Task6" name="System maintains driver license master record per driver: full name, LTO…">
        <bpmn:documentation>Step 1: System maintains driver license master record per driver: full name, LTO license number, PDL restriction codes, expiration date, Conduction Stick Number; Fleet Maintenance Supervisor enters new license data upon driver onboarding (W654) and upon renewal
Responsible (R): Fleet Maintenance Supervisor / System
Accountable (A): —
Duration: 10 min/driver</bpmn:documentation>
        <bpmn:incoming>W1400_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1400_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1400_Task7" name="System automatically checks driver license expiration dates daily; generates…">
        <bpmn:documentation>Step 2: System automatically checks driver license expiration dates daily; generates alerts at 60-day (yellow), 30-day (orange), and 7-day (red) pre-expiration thresholds; dashboard shows all drivers sorted by days-to-expiration
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1400_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1400_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1400_Task8" name="At 60-day alert: Fleet Maintenance Supervisor notifies driver verbally and via…">
        <bpmn:documentation>Step 3: At 60-day alert: Fleet Maintenance Supervisor notifies driver verbally and via SMS/email to begin LTO renewal process; driver instructed to schedule LTO appointment (walk-in or online via LTO portal)
Responsible (R): Fleet Maintenance Supervisor
Accountable (A): —
Duration: 5 min/driver</bpmn:documentation>
        <bpmn:incoming>W1400_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1400_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1400_Task9" name="At 30-day alert: Fleet Maintenance Supervisor sends written reminder to driver…">
        <bpmn:documentation>Step 4: At 30-day alert: Fleet Maintenance Supervisor sends written reminder to driver with copy to HR; HR verifies driver has not received any LTO notice of suspension or revocation; if driver has pending LTO violations, HR flags for resolution before renewal
Responsible (R): Fleet Maintenance Supervisor / HR Assistant
Accountable (A): Logistics Manager
Duration: 10 min/driver</bpmn:documentation>
        <bpmn:incoming>W1400_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1400_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1400_Task10" name="Driver completes LTO renewal: (a) medical examination at LTO-accredited clinic…">
        <bpmn:documentation>Step 5: Driver completes LTO renewal: (a) medical examination at LTO-accredited clinic, (b) written examination (if required per LTO rules), (c) practical driving test (if required), (d) biometrics and photo capture, (e) payment of renewal fee (~PHP 500–800)
Responsible (R): Driver
Accountable (A): Fleet Maintenance Supervisor
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1400_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1400_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1400_Task11" name="Driver returns with renewed PDL; Fleet Maintenance Supervisor verifies new…">
        <bpmn:documentation>Step 6: Driver returns with renewed PDL; Fleet Maintenance Supervisor verifies new license: validates restriction codes match assigned vehicle type, confirms new expiration date, scans and uploads front/back of renewed license to driver master record in ERP
Responsible (R): Fleet Maintenance Supervisor
Accountable (A): —
Duration: 10 min/driver</bpmn:documentation>
        <bpmn:incoming>W1400_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1400_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1400_Task12" name="System updates driver master with new license details and resets expiration…">
        <bpmn:documentation>Step 7: System updates driver master with new license details and resets expiration alert calendar
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1400_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1400_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1400_Task13" name="If driver fails to renew before expiration: system automatically flags driver…">
        <bpmn:documentation>Step 8: If driver fails to renew before expiration: system automatically flags driver as &quot;License Expired — Do Not Dispatch&quot;; dispatch system (W196) prevents assignment of any shipment to this driver; Logistics Manager notified for immediate action
Responsible (R): System / Logistics Planner
Accountable (A): Logistics Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1400_Flow25</bpmn:incoming>
        <bpmn:outgoing>W1400_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1400_Task14" name="Monthly: Fleet Maintenance Supervisor runs LTO compliance report showing all…">
        <bpmn:documentation>Step 9: Monthly: Fleet Maintenance Supervisor runs LTO compliance report showing all drivers with licenses expiring within 90 days, drivers with restriction code mismatches, and any drivers currently blocked from dispatch; submits report to Logistics Manager
Responsible (R): Fleet Maintenance Supervisor
Accountable (A): Logistics Manager
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W1400_Flow26</bpmn:incoming>
        <bpmn:outgoing>W1400_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1400_End15" name="Complete">
        <bpmn:incoming>W1400_Flow27</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1400_Annotation16">
        <bpmn:text>Controls: - CTL-257 (ensure controlled execution — Fleet &amp; Driver Management (PA-06.2).) | - operational: downtime, long queues, and limited appointment slots
Owner: Fleet Maintenance Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1400_Assoc17" sourceRef="W1400_Annotation16" targetRef="W1400_Start5" associationDirection="None" />
