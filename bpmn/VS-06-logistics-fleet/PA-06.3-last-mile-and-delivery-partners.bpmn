    <bpmn:process id="W_W1164" name="W1164. Inter-Island Logistics Coordination &amp; Shipping Management" isExecutable="false">
      <bpmn:documentation>Trigger: DC replenishment order requiring inter-island transfer; or vendor DSD to island store bypassing nearest DC
Frequency: ~30–40 inter-island shipments/month
Volume: ~5–10 ferry/ro-ro shipments/week across 3 island groups (Luzon, Visayas, Mindanao)
Owner: Inter-Island Logistics Coordinator
Participants: Supply Planner, DC Dispatch, Shipping Line Coordinator, Customs (if applicable), Receiving Store
Source: workflow W1164 — Inter-Island Logistics Coordination &amp; Shipping Management</bpmn:documentation>
      <bpmn:laneSet id="W1164_LaneSet5">
        <bpmn:lane id="W1164_Lane1" name="Supply Planner">
        <bpmn:flowNodeRef>W1164_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1164_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1164_Lane2" name="Logistics Coordinator">
        <bpmn:flowNodeRef>W1164_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1164_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1164_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1164_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1164_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1164_Lane3" name="DC Dispatch">
        <bpmn:flowNodeRef>W1164_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1164_Lane4" name="Driver">
        <bpmn:flowNodeRef>W1164_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1164_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1164_Start6" name="DC replenishment order requiring inter-island transfer; or vendor DSD to island store…">
        <bpmn:outgoing>W1164_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1164_Task7" name="Shipment Planning">
        <bpmn:documentation>Step 1: Shipment Planning: Supply Planner identifies inter-island transfer need from W22 or W214; creates transfer order in ERP with origin DC, destination store/DC, and required delivery date
Responsible (R): Supply Planner
Accountable (A): Logistics Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1164_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1164_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1164_Task8" name="Route &amp; Carrier Selection">
        <bpmn:documentation>Step 2: Route &amp; Carrier Selection: Inter-Island Logistics Coordinator selects optimal route (direct ferry vs. multi-hop) and shipping line based on: transit time, schedule frequency, cargo type compatibility, cost per CBM, and historical reliability per W727
Responsible (R): Logistics Coordinator
Accountable (A): Logistics Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1164_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1164_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1164_Task9" name="Booking &amp; Documentation">
        <bpmn:documentation>Step 3: Booking &amp; Documentation: Coordinator books cargo space with shipping line; prepares shipping documents: bill of lading, cargo manifest, packing list; for hazmat shipments per W699, obtains Dangerous Goods Declaration
Responsible (R): Logistics Coordinator
Accountable (A): Logistics Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W1164_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1164_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1164_Task10" name="Loading &amp; Dispatch">
        <bpmn:documentation>Step 4: Loading &amp; Dispatch: DC loads goods onto truck; truck driven to port; cargo loaded onto ferry/ship (ro-ro for truck-on-board or containerized); system updates transfer order status to &quot;In Transit — At Sea&quot;
Responsible (R): DC Dispatch / Driver
Accountable (A): Logistics Coordinator
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W1164_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1164_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1164_Task11" name="In-Transit Monitoring">
        <bpmn:documentation>Step 5: In-Transit Monitoring: System tracks shipment via shipping line API or manual status updates; Coordinator monitors weather advisories (PAGASA) for potential delays; provides ETA updates to receiving location
Responsible (R): Logistics Coordinator
Accountable (A): Logistics Manager
Duration: 15 min/day per shipment</bpmn:documentation>
        <bpmn:incoming>W1164_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1164_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1164_Task12" name="Port Arrival &amp; Delivery">
        <bpmn:documentation>Step 6: Port Arrival &amp; Delivery: Truck offloads at destination port; drives to receiving store or DC; Receiving Clerk processes goods receipt per W109 or W3; system updates inventory and closes transfer order
Responsible (R): Driver / Receiving Clerk
Accountable (A): DC Manager / Store Manager
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W1164_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1164_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1164_Task13" name="Transit Damage &amp; Loss Handling">
        <bpmn:documentation>Step 7: Transit Damage &amp; Loss Handling: Receiving location documents any damage or shortage with photos; Coordinator files claim with shipping line per W500; tracks claim to resolution
Responsible (R): Logistics Coordinator
Accountable (A): Logistics Manager
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1164_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1164_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1164_Task14" name="Monthly Route Analytics">
        <bpmn:documentation>Step 8: Monthly Route Analytics: Coordinator compiles inter-island logistics report: transit time by route, on-time delivery rate, cost per CBM by lane, damage/loss rate, carrier reliability ranking
Responsible (R): Logistics Coordinator
Accountable (A): VP Supply Chain
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W1164_Flow25</bpmn:incoming>
        <bpmn:outgoing>W1164_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1164_End15" name="Complete">
        <bpmn:incoming>W1164_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1164_Annotation16">
        <bpmn:text>Controls: - CTL-258 (ensure controlled execution — Last-Mile &amp; Delivery Partners (PA-06.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Inter-Island Logistics Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1164_Assoc17" sourceRef="W1164_Annotation16" targetRef="W1164_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1164_Flow18" sourceRef="W1164_Start6" targetRef="W1164_Task7" />
