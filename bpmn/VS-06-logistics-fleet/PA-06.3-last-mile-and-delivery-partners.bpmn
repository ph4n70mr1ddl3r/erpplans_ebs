    <bpmn:process id="W_W1208" name="W1208. Customer Home Delivery White-Glove Service &amp; Installation Add-On Dispatch" isExecutable="false">
      <bpmn:documentation>Trigger: Customer purchases large/bulky item (appliance, aircon, water heater, bathroom set) with delivery + optional installation add-on at POS or ecommerce
Frequency: ~2,000–3,000 white-glove deliveries per month across 200 stores
Volume: ~10–15 per store per month (2,000–3,000/month chain-wide per the Frequency); higher in Metro Manila and urban stores
Owner: Logistics Dispatcher
Participants: Logistics Dispatcher, Sales Associate, Installation Technician (per W600 accredited), Customer, Delivery Driver, 3PL Provider
Source: workflow W1208 — Customer Home Delivery White-Glove Service &amp; Installation Add-On Dispatch</bpmn:documentation>
      <bpmn:laneSet id="W1208_LaneSet6">
        <bpmn:lane id="W1208_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W1208_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1208_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1208_Lane2" name="System">
        <bpmn:flowNodeRef>W1208_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1208_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1208_Task17</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1208_Lane3" name="Logistics Dispatcher">
        <bpmn:flowNodeRef>W1208_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1208_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1208_Lane4" name="Driver">
        <bpmn:flowNodeRef>W1208_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1208_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1208_Lane5" name="Technician">
        <bpmn:flowNodeRef>W1208_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1208_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1208_End18</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1208_Start7" name="Customer purchases large/bulky item (appliance, aircon, water heater, bathroom set) with…">
        <bpmn:outgoing>W1208_Flow21</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1208_Task8" name="Customer purchases bulky item at POS or ecommerce with delivery selected; Sales…">
        <bpmn:documentation>Step 1: Customer purchases bulky item at POS or ecommerce with delivery selected; Sales Associate or system captures: (a) delivery address, (b) preferred delivery date and time window (morning 8–12 / afternoon 1–5), (c) floor level and elevator access, (d) installation add-on selection (Yes/No), (e) site preparation status (plumbing rough-in complete? electrical outlet ready?), (f) contact number and alternate contact
Responsible (R): Sales Associate / Customer
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1208_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1208_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1208_Task9" name="System validates delivery address against serviceable coverage areas; estimates…">
        <bpmn:documentation>Step 2: System validates delivery address against serviceable coverage areas; estimates delivery fee based on distance zone and item weight/dimensions; if installation add-on selected: system checks technician availability for requested date using technician scheduling calendar; system confirms or proposes alternative date
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1208_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1208_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1208_Task10" name="Logistics Dispatcher reviews delivery queue for the day; groups white-glove…">
        <bpmn:documentation>Step 3: Logistics Dispatcher reviews delivery queue for the day; groups white-glove deliveries by geographic zone to optimize routing; assigns deliveries to drivers and 3PL partners with appropriate vehicle type (6-wheeler for appliances, wing van for construction materials)
Responsible (R): Logistics Dispatcher
Accountable (A): Logistics Manager
Duration: 30 min/day</bpmn:documentation>
        <bpmn:incoming>W1208_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1208_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1208_Task11" name="If installation add-on: Logistics Dispatcher assigns accredited Installation…">
        <bpmn:documentation>Step 4: If installation add-on: Logistics Dispatcher assigns accredited Installation Technician from scheduling pool; system sends technician a job notification with: order details, item specifications, site access notes, customer contact, estimated arrival window
Responsible (R): Logistics Dispatcher / System
Accountable (A): Installation Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1208_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1208_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1208_Task12" name="System sends customer automated delivery confirmation via SMS/email: delivery…">
        <bpmn:documentation>Step 5: System sends customer automated delivery confirmation via SMS/email: delivery date, time window, driver name and contact, technician name (if installation), preparation checklist (clear pathway, measure doorways, verify electrical/plumbing readiness)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1208_Flow25</bpmn:incoming>
        <bpmn:outgoing>W1208_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1208_Task13" name="Delivery driver and technician arrive at customer site; driver unloads and…">
        <bpmn:documentation>Step 6: Delivery driver and technician arrive at customer site; driver unloads and carries item to specified room (white-glove: in-home placement, not curbside); technician inspects site readiness: (a) measurements match product dimensions, (b) electrical/plumbing connections accessible, (c) wall/floor conditions suitable for installation
Responsible (R): Driver / Technician
Accountable (A): Logistics Dispatcher
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W1208_Flow26</bpmn:incoming>
        <bpmn:outgoing>W1208_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1208_Task14" name="If site is NOT ready (missing electrical outlet, plumbing not roughed-in…">
        <bpmn:documentation>Step 7: If site is NOT ready (missing electrical outlet, plumbing not roughed-in, access too narrow): technician documents issue with photos; communicates to customer what preparation is needed; Logistics Dispatcher reschedules delivery/installation; delivery fee may still apply per service terms
Responsible (R): Technician / Logistics Dispatcher
Accountable (A): Installation Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1208_Flow27</bpmn:incoming>
        <bpmn:outgoing>W1208_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1208_Task15" name="If site is ready: technician proceeds with installation per W138; upon…">
        <bpmn:documentation>Step 8: If site is ready: technician proceeds with installation per W138; upon completion: demonstrates product operation to customer; customer signs acceptance form on technician&#x27;s tablet; system records installation completion with photo documentation
Responsible (R): Technician / Customer
Accountable (A): Installation Manager
Duration: 1–3 hours</bpmn:documentation>
        <bpmn:incoming>W1208_Flow28</bpmn:incoming>
        <bpmn:outgoing>W1208_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1208_Task16" name="Driver collects payment if COD; system processes payment if prepaid; system…">
        <bpmn:documentation>Step 9: Driver collects payment if COD; system processes payment if prepaid; system triggers delivery confirmation to customer via SMS/email with: digital receipt, installation warranty card, customer satisfaction survey link
Responsible (R): Driver / System
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1208_Flow29</bpmn:incoming>
        <bpmn:outgoing>W1208_Flow30</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1208_Task17" name="Post-delivery: system sends follow-up SMS/email at 48 hours: satisfaction…">
        <bpmn:documentation>Step 10: Post-delivery: system sends follow-up SMS/email at 48 hours: satisfaction check, product care tips, and offer for related products (e.g., aircon maintenance kit, water filter replacement)
Responsible (R): System
Accountable (A): CX Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1208_Flow30</bpmn:incoming>
        <bpmn:outgoing>W1208_Flow31</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1208_End18" name="Complete">
        <bpmn:incoming>W1208_Flow31</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1208_Annotation19">
        <bpmn:text>Controls: - CTL-258 (ensure controlled execution — Last-Mile &amp; Delivery Partners (PA-06.3).) | - operational: Logistics Dispatcher review and approval gate
Owner: Logistics Dispatcher</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1208_Assoc20" sourceRef="W1208_Annotation19" targetRef="W1208_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W1208_Flow21" sourceRef="W1208_Start7" targetRef="W1208_Task8" />
      <bpmn:sequenceFlow id="W1208_Flow22" sourceRef="W1208_Task8" targetRef="W1208_Task9" />
      <bpmn:sequenceFlow id="W1208_Flow23" sourceRef="W1208_Task9" targetRef="W1208_Task10" />
