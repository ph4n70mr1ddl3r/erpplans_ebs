    <bpmn:process id="W_W1371" name="W1371. 3PL Carrier Onboarding, Qualification Audit &amp; Service Level Agreement Management" isExecutable="false">
      <bpmn:documentation>Trigger: New 3PL carrier needed due to geographic expansion, capacity shortfall, or carrier termination; or annual carrier requalification cycle
Frequency: 5–10 new carrier onboardings/year; all carriers requalified annually
Volume: ~30–40 active 3PL carrier contracts chain-wide (80% of fleet capacity); each carrier operates 2–10 trucks
Owner: Logistics Manager (HQ)
Participants: Logistics Manager, VP Supply Chain, Legal Counsel, Finance, Safety Officer, Insurance Provider
Source: workflow W1371 — 3PL Carrier Onboarding, Qualification Audit &amp; Service Level Agreement Management</bpmn:documentation>
      <bpmn:laneSet id="W1371_LaneSet6">
        <bpmn:lane id="W1371_Lane1" name="Logistics Manager">
        <bpmn:flowNodeRef>W1371_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1371_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1371_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1371_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1371_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1371_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1371_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1371_Lane2" name="Carrier">
        <bpmn:flowNodeRef>W1371_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1371_Lane3" name="Safety Officer">
        <bpmn:flowNodeRef>W1371_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1371_Lane4" name="Legal Counsel">
        <bpmn:flowNodeRef>W1371_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1371_Lane5" name="Finance">
        <bpmn:flowNodeRef>W1371_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1371_End18</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1371_Start7" name="New 3PL carrier needed due to geographic expansion, capacity shortfall, or carrier…">
        <bpmn:outgoing>W1371_Flow21</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1371_Task8" name="Logistics Manager identifies need for new carrier: (a) capacity gap (new store…">
        <bpmn:documentation>Step 1: Logistics Manager identifies need for new carrier: (a) capacity gap (new store openings, seasonal peak); (b) geographic coverage gap (new region); (c) replacement for underperforming carrier per W1166
Responsible (R): Logistics Manager
Accountable (A): VP Supply Chain
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1371_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1371_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1371_Task9" name="Logistics Manager sources carrier candidates: (a) Philippine trucking industry…">
        <bpmn:documentation>Step 2: Logistics Manager sources carrier candidates: (a) Philippine trucking industry referrals; (b) BuildRight carrier portal application (carriers can apply online); (c) DTI-registered freight forwarders in target region; (d) minimum requirement: valid LTFRB (Land Transportation Franchising and Regulatory Board) franchise or CPC (Certificate of Public Convenience) for cargo transport
Responsible (R): Logistics Manager
Accountable (A): —
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W1371_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1371_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1371_Task10" name="Candidate carrier submits qualification documents: (a) business registration…">
        <bpmn:documentation>Step 3: Candidate carrier submits qualification documents: (a) business registration (DTI/SEC, BIR TIN, mayor&#x27;s permit); (b) LTFRB franchise/CPC; (c) fleet list with vehicle plate numbers, vehicle types, and vehicle ages; (d) driver roster with valid professional driver&#x27;s licenses (restriction codes 2 and 3 for trucks); (e) vehicle insurance (comprehensive, third-party liability, cargo insurance); (f) safety record and any incident history; (g) financial references or bank certificate
Responsible (R): Carrier / Logistics Manager
Accountable (A): —
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1371_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1371_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1371_Task11" name="Logistics Manager conducts qualification audit: (a) desk review of submitted…">
        <bpmn:documentation>Step 4: Logistics Manager conducts qualification audit: (a) desk review of submitted documents for completeness and validity; (b) calls financial references; (c) checks LTFRB franchise validity online; (d) reviews carrier&#x27;s existing client portfolio (other retail/FMCG clients preferred); (e) if carrier passes desk review: schedules on-site visit to carrier&#x27;s yard/office for vehicle inspection and operational assessment
Responsible (R): Logistics Manager
Accountable (A): VP Supply Chain
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1371_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1371_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1371_Task12" name="Safety Officer conducts on-site vehicle and safety assessment: (a) physical…">
        <bpmn:documentation>Step 5: Safety Officer conducts on-site vehicle and safety assessment: (a) physical inspection of sample vehicles (brakes, tires, lights, cargo tie-down equipment, tarpaulins for weather protection); (b) verifies vehicle insurance validity; (c) reviews carrier&#x27;s safety policies (driver fatigue management, load securing procedures, incident reporting); (d) for carriers handling hazardous materials (paint, chemicals): verifies Hazmat transport permit per W3607
Responsible (R): Safety Officer
Accountable (A): VP Supply Chain
Duration: Half day</bpmn:documentation>
        <bpmn:incoming>W1371_Flow25</bpmn:incoming>
        <bpmn:outgoing>W1371_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1371_Task13" name="If carrier passes qualification: Legal Counsel prepares 3PL Service Agreement…">
        <bpmn:documentation>Step 6: If carrier passes qualification: Legal Counsel prepares 3PL Service Agreement covering: (a) scope of services (routes, delivery frequency, truck types); (b) service level targets (on-time delivery rate ≥ 95%, damage rate &lt; 0.5%, POD completion 100%); (c) rate card (per-trip, per-km, or per-pallet rates with fuel surcharge adjustment clause); (d) penalty/bonus structure (penalty for SLA breaches, bonus for exceeding targets); (e) insurance requirements (cargo insurance covering full value of BuildRight merchandise); (f) termination clause (30-day notice for underperformance, immediate termination for safety violations); (g) data privacy and confidentiality obligations
Responsible (R): Legal Counsel / Logistics Manager
Accountable (A): VP Supply Chain
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1371_Flow26</bpmn:incoming>
        <bpmn:outgoing>W1371_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1371_Task14" name="Finance reviews carrier financial stability: verifies carrier can sustain…">
        <bpmn:documentation>Step 7: Finance reviews carrier financial stability: verifies carrier can sustain operations on BuildRight&#x27;s payment terms (Net 30); confirms carrier&#x27;s cargo insurance coverage is adequate for average load value (~PHP 500,000–2,000,000 per truckload of BuildRight merchandise)
Responsible (R): Finance
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1371_Flow27</bpmn:incoming>
        <bpmn:outgoing>W1371_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1371_Task15" name="VP Supply Chain approves carrier; Logistics Manager activates carrier in ERP…">
        <bpmn:documentation>Step 8: VP Supply Chain approves carrier; Logistics Manager activates carrier in ERP system: (a) creates carrier master record with complete documentation; (b) configures carrier rate card per route/zone; (c) assigns carrier to eligible delivery zones; (d) sets up carrier portal access for order acceptance, POD upload, and invoice submission; (e) carrier added to dispatch rotation per W1163
Responsible (R): Logistics Manager
Accountable (A): VP Supply Chain
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1371_Flow28</bpmn:incoming>
        <bpmn:outgoing>W1371_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1371_Task16" name="Logistics Manager conducts carrier orientation: (a) BuildRight delivery…">
        <bpmn:documentation>Step 9: Logistics Manager conducts carrier orientation: (a) BuildRight delivery standards (dock procedures, store receiving protocol, POD requirements); (b) carrier portal/app training; (c) escalation procedures for breakdowns, accidents, delivery failures; (d) assigns initial routes under supervision (first 2 weeks monitored closely)
Responsible (R): Logistics Manager
Accountable (A): —
Duration: Half day</bpmn:documentation>
        <bpmn:incoming>W1371_Flow29</bpmn:incoming>
        <bpmn:outgoing>W1371_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1371_Task17" name="Annual requalification: for each active carrier, Logistics Manager repeats…">
        <bpmn:documentation>Step 10: Annual requalification: for each active carrier, Logistics Manager repeats qualification audit (Steps 3–5) in abbreviated form: (a) updated business registration and insurance documents; (b) fleet and driver roster update; (c) SLA performance review (on-time rate, damage rate, POD completion, incident count); (d) carriers below SLA thresholds receive 90-day improvement notice or contract termination per Step 6(f)
Responsible (R): Logistics Manager
Accountable (A): VP Supply Chain
Duration: 1–2 days/carrier</bpmn:documentation>
        <bpmn:incoming>W1371_Flow30</bpmn:incoming>
        <bpmn:outgoing>W1371_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1371_End18" name="Complete">
        <bpmn:incoming>W1371_Flow31</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1371_Annotation19">
        <bpmn:text>Controls: - CTL-258 (ensure controlled execution — Last-Mile &amp; Delivery Partners (PA-06.3).) | - operational: Logistics Manager review and approval gate
Owner: Logistics Manager (HQ)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1371_Assoc20" sourceRef="W1371_Annotation19" targetRef="W1371_Start7" associationDirection="None" />
