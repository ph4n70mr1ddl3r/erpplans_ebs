        <bpmndi:BPMNEdge id="W1164_Assoc17_di" bpmnElement="W1164_Assoc17"><di:waypoint x="340" y="800" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1165" name="W1165. Last-Mile Delivery Dispatch, Tracking &amp; SLA Management" isExecutable="false">
      <bpmn:documentation>Trigger: Customer home delivery order from ecommerce (W19) or POS (POS-023)
Frequency: ~570 ecommerce home deliveries/day (17,200/month ÷ 30) + ~86 store-originated deliveries/day
Volume: ~42,900 ecommerce orders/month (~40% home delivery = ~17,200); plus store bulky deliveries
Owner: Last-Mile Dispatch Coordinator
Participants: Last-Mile Dispatch Coordinator, Delivery Rider/Driver, Customer, Ecommerce Operations
Source: workflow W1165 — Last-Mile Delivery Dispatch, Tracking &amp; SLA Management</bpmn:documentation>
      <bpmn:laneSet id="W1165_LaneSet3">
        <bpmn:lane id="W1165_Lane1" name="System">
        <bpmn:flowNodeRef>W1165_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1165_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1165_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1165_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1165_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1165_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1165_Lane2" name="Driver">
        <bpmn:flowNodeRef>W1165_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1165_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1165_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1165_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1165_Start4" name="Customer home delivery order from ecommerce (W19) or POS (POS-023)">
        <bpmn:outgoing>W1165_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1165_Task5" name="Order Batch &amp; Route">
        <bpmn:documentation>Step 1: Order Batch &amp; Route: System batches home delivery orders by fulfillment origin (DC or store) and delivery zone; generates optimized last-mile delivery routes per W196 with time windows
Responsible (R): System
Accountable (A): Dispatch Coordinator
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1165_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1165_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1165_Task6" name="Carrier Assignment">
        <bpmn:documentation>Step 2: Carrier Assignment: System assigns orders to delivery partners based on: item type (standard vs. bulky vs. hazmat per W237), delivery zone, partner capacity, and SLA tier (same-day, next-day, 3-day provincial)
Responsible (R): System
Accountable (A): Dispatch Coordinator
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1165_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1165_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1165_Task7" name="Driver/Rider Dispatch">
        <bpmn:documentation>Step 3: Driver/Rider Dispatch: Partner or own-fleet driver receives delivery manifest via mobile app; confirms pickup from fulfillment location; system sends customer notification &quot;Out for Delivery&quot; per W708
Responsible (R): Driver / Partner
Accountable (A): Dispatch Coordinator
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1165_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1165_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1165_Task8" name="Real-Time Tracking">
        <bpmn:documentation>Step 4: Real-Time Tracking: Customer tracks delivery via app/website with live map; system provides estimated delivery time window; Dispatch Coordinator monitors all active deliveries on dashboard
Responsible (R): System / Dispatch Coordinator
Accountable (A): Ecommerce Operations
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W1165_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1165_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1165_Task9" name="Delivery Attempt">
        <bpmn:documentation>Step 5: Delivery Attempt: Driver arrives at customer location; verifies customer identity; captures electronic POD (signature + photo); system updates order status to &quot;Delivered&quot;
Responsible (R): Driver
Accountable (A): Dispatch Coordinator
Duration: 10 min/delivery</bpmn:documentation>
        <bpmn:incoming>W1165_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1165_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1165_Task10" name="Failed Delivery Handling">
        <bpmn:documentation>Step 6: Failed Delivery Handling: If customer unavailable: Driver contacts customer via app/phone; options: (a) leave with authorized person, (b) reschedule within 48 hours, (c) return to origin; system auto-processes reschedule or return per W592
Responsible (R): Driver / Dispatch Coordinator
Accountable (A): Ecommerce Operations
Duration: 15 min/failed delivery</bpmn:documentation>
        <bpmn:incoming>W1165_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1165_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1165_Task11" name="SLA Monitoring">
        <bpmn:documentation>Step 7: SLA Monitoring: System calculates SLA compliance: order-to-delivery time vs. target (same-day &lt; 8 hours, next-day metro &lt; 24 hours, 3-day provincial &lt; 72 hours); breaches auto-escalated per severity per W591
Responsible (R): System
Accountable (A): Ecommerce Operations
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1165_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1165_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1165_Task12" name="Daily SLA Report">
        <bpmn:documentation>Step 8: Daily SLA Report: Overnight SLA performance calculation per W591; daily dashboard by partner, zone, and SLA tier; weekly partner performance feed to W242 and SCP-020
Responsible (R): System / Dispatch Coordinator
Accountable (A): Logistics Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1165_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1165_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1165_End13" name="Complete">
        <bpmn:incoming>W1165_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1165_Annotation14">
        <bpmn:text>Controls: - CTL-258 (ensure controlled execution — Last-Mile &amp; Delivery Partners (PA-06.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Last-Mile Dispatch Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1165_Assoc15" sourceRef="W1165_Annotation14" targetRef="W1165_Start4" associationDirection="None" />
