        <bpmndi:BPMNEdge id="W1371_Assoc20_di" bpmnElement="W1371_Assoc20"><di:waypoint x="340" y="970" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1372" name="W1372. Customer Delivery Damage, Loss &amp; Shortage Claim Processing &amp; Carrier Liability Settlement" isExecutable="false">
      <bpmn:documentation>Trigger: Customer reports delivery damage, loss, or shortage upon receipt of ecommerce home delivery (W19); or store reports inbound shipment damage during receiving (W109/W666); or customer reports damage from in-store delivery (W5D)
Frequency: ~200–350 delivery incidents/month chain-wide (per the Volume&#x27;s damage-rate derivation)
Volume: Damage rate target &lt; 0.5% of shipments; at ~5,000 store replenishment + ~42,900 ecommerce deliveries/month, expected incidents ~240–350/month
Owner: DC Dispatch Coordinator (store deliveries); Ecommerce Operations (ecommerce deliveries)
Participants: Store Receiving Clerk, Store Manager, Carrier, Customer, Ecommerce Team, Finance, Insurance Provider
Source: workflow W1372 — Customer Delivery Damage, Loss &amp; Shortage Claim Processing &amp; Carrier Liability Settlement</bpmn:documentation>
      <bpmn:laneSet id="W1372_LaneSet7">
        <bpmn:lane id="W1372_Lane1" name="Store Receiving Clerk">
        <bpmn:flowNodeRef>W1372_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1372_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1372_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1372_Lane2" name="System">
        <bpmn:flowNodeRef>W1372_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1372_Lane3" name="Ecommerce Team">
        <bpmn:flowNodeRef>W1372_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1372_Lane4" name="DC Dispatch Coordinator">
        <bpmn:flowNodeRef>W1372_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1372_Lane5" name="Logistics Manager">
        <bpmn:flowNodeRef>W1372_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1372_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1372_Lane6" name="Finance">
        <bpmn:flowNodeRef>W1372_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1372_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1372_Start8" name="Customer reports delivery damage, loss, or shortage upon receipt of ecommerce home…">
        <bpmn:outgoing>W1372_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1372_Task9" name="Incident reported: (a) store delivery: Store Receiving Clerk identifies…">
        <bpmn:documentation>Step 1: Incident reported: (a) store delivery: Store Receiving Clerk identifies damage/shortage during receiving per W109, records on handheld with photos and variance quantities; (b) ecommerce delivery: Customer reports damage via call center, chat, or website with photos; (c) in-store delivery: Customer contacts store CSR per W5D
Responsible (R): Store Receiving Clerk / Customer / CSR
Accountable (A): Store Manager / Ecommerce Team
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W1372_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1372_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1372_Task10" name="System creates delivery incident record: (a) linked to shipment ID (W1370); (b)…">
        <bpmn:documentation>Step 2: System creates delivery incident record: (a) linked to shipment ID (W1370); (b) carrier name, driver, vehicle plate; (c) incident type: damage, shortage, loss, wrong item; (d) affected items with quantities and value; (e) customer photos (if applicable) or Store Receiving Clerk photos uploaded; (f) POD status (signed, unsigned, signed with notation)
Responsible (R): System / Reporter
Accountable (A): DC Dispatch Coordinator
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1372_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1372_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1372_Task11" name="For customer-facing deliveries (ecommerce, in-store delivery): immediate…">
        <bpmn:documentation>Step 3: For customer-facing deliveries (ecommerce, in-store delivery): immediate customer resolution takes priority — (a) if damage: Ecommerce Team/CSR offers replacement shipment (expedited per W19) or refund per W12; (b) if shortage: system checks if shorted items are available at nearest store or DC for immediate re-shipment; (c) if total loss: full refund or reorder processed; (d) customer resolution must occur within 24 hours of incident report
Responsible (R): Ecommerce Team / CSR
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1372_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1372_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1372_Task12" name="DC Dispatch Coordinator (or Ecommerce Ops) determines carrier liability: (a)…">
        <bpmn:documentation>Step 4: DC Dispatch Coordinator (or Ecommerce Ops) determines carrier liability: (a) reviews POD documentation — if carrier driver signed clean POD (no damage notation), carrier is liable; if POD noted damage at pickup, liability shifts to DC (poor loading per W836); if no POD captured, carrier is presumed liable per contract terms; (b) for shortage: carrier liable if dispatch quantities (W1370.1) match DC pick confirmation (W1352) but receipt is short — indicates pilferage or loss in transit; (c) for loss (entire shipment): carrier liable unless force majeure (typhoon, accident with police report)
Responsible (R): DC Dispatch Coordinator / Ecommerce Ops
Accountable (A): Logistics Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1372_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1372_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1372_Task13" name="If carrier liable: (a) system generates carrier claim with supporting…">
        <bpmn:documentation>Step 5: If carrier liable: (a) system generates carrier claim with supporting documentation (shipment record, POD, photos, item values); (b) claim submitted to carrier via carrier portal; (c) carrier has 5 business days to accept or dispute claim; (d) if accepted: carrier pays deduction amount or BuildRight offsets against next payment per W7; (e) if disputed: Logistics Manager mediates with carrier using evidence from POD, GPS tracking, and photos
Responsible (R): Logistics Manager / System
Accountable (A): VP Supply Chain
Duration: 30 min/claim</bpmn:documentation>
        <bpmn:incoming>W1372_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1372_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1372_Task14" name="If claim exceeds carrier&#x27;s cargo insurance deductible or carrier disputes…">
        <bpmn:documentation>Step 6: If claim exceeds carrier&#x27;s cargo insurance deductible or carrier disputes liability: (a) Finance files claim with BuildRight&#x27;s goods-in-transit insurance per W863; (b) insurance adjuster may inspect damaged goods; (c) insurance payout processed per policy terms; (d) BuildRight retains right to pursue carrier for insurer&#x27;s subrogation
Responsible (R): Finance / Insurance Provider
Accountable (A): CFO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1372_Flow25</bpmn:incoming>
        <bpmn:outgoing>W1372_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1372_Task15" name="Damaged goods disposition per W91: (a) if resalable at discount: reprocessed…">
        <bpmn:documentation>Step 7: Damaged goods disposition per W91: (a) if resalable at discount: reprocessed and marked down per W93; (b) if repairable: sent to vendor for repair or disposed; (c) if total loss: written off per W92 with carrier/insurance recovery tracked separately; (d) damaged goods must be physically segregated and documented for carrier/insurance inspection before disposition
Responsible (R): Store Receiving Clerk / DC Team
Accountable (A): DC Manager
Duration: Per W91</bpmn:documentation>
        <bpmn:incoming>W1372_Flow26</bpmn:incoming>
        <bpmn:outgoing>W1372_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1372_Task16" name="Monthly: Logistics Manager reviews delivery incident analytics: (a) incident…">
        <bpmn:documentation>Step 8: Monthly: Logistics Manager reviews delivery incident analytics: (a) incident rate by carrier, route, and merchandise category; (b) average claim value and recovery rate; (c) carriers exceeding damage rate threshold (&gt; 0.5%) flagged for improvement notice or contract review per W1371; (d) top damaged categories (tiles, glass, appliances) reviewed for packaging improvement with Merchandising
Responsible (R): Logistics Manager
Accountable (A): VP Supply Chain
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1372_Flow27</bpmn:incoming>
        <bpmn:outgoing>W1372_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1372_End17" name="Complete">
        <bpmn:incoming>W1372_Flow28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1372_Annotation18">
        <bpmn:text>Controls: - CTL-258 (ensure controlled execution — Last-Mile &amp; Delivery Partners (PA-06.3).) | - operational: DC Dispatch Coordinator (store deliveries); Ecommerce Operations (ecommerce deliveries) review and approval gate
Owner: DC Dispatch Coordinator (store deliveries); Ecommerce Operations (ecommerce deliveries)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1372_Assoc19" sourceRef="W1372_Annotation18" targetRef="W1372_Start8" associationDirection="None" />
      <bpmn:sequenceFlow id="W1372_Flow20" sourceRef="W1372_Start8" targetRef="W1372_Task9" />
      <bpmn:sequenceFlow id="W1372_Flow21" sourceRef="W1372_Task9" targetRef="W1372_Task10" />
      <bpmn:sequenceFlow id="W1372_Flow22" sourceRef="W1372_Task10" targetRef="W1372_Task11" />
      <bpmn:sequenceFlow id="W1372_Flow23" sourceRef="W1372_Task11" targetRef="W1372_Task12" />
      <bpmn:sequenceFlow id="W1372_Flow24" sourceRef="W1372_Task12" targetRef="W1372_Task13" />
      <bpmn:sequenceFlow id="W1372_Flow25" sourceRef="W1372_Task13" targetRef="W1372_Task14" />
      <bpmn:sequenceFlow id="W1372_Flow26" sourceRef="W1372_Task14" targetRef="W1372_Task15" />
      <bpmn:sequenceFlow id="W1372_Flow27" sourceRef="W1372_Task15" targetRef="W1372_Task16" />
      <bpmn:sequenceFlow id="W1372_Flow28" sourceRef="W1372_Task16" targetRef="W1372_End17" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1372_diag">
