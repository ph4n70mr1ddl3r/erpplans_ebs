<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-06.3-last-mile-and-delivery-partners" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1163" name="W1163. 3PL &amp; Delivery Partner Daily Operations Management" isExecutable="false">
      <bpmn:documentation>Trigger: Daily operations cycle; partner performance threshold breach
Frequency: Daily monitoring; monthly formal review
Volume: ~80% of outbound deliveries handled by 3PL partners (8–10 strategic partners; ~30–40 contracted carriers/forwarders in total per W1371)
Owner: Logistics Manager
Participants: Logistics Manager, 3PL Dispatch Coordinator, DC Dispatch, AP Clerk
Source: workflow W1163 — 3PL &amp; Delivery Partner Daily Operations Management</bpmn:documentation>
      <bpmn:laneSet id="W1163_LaneSet5">
        <bpmn:lane id="W1163_Lane1" name="Logistics Manager">
        <bpmn:flowNodeRef>W1163_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1163_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1163_Lane2" name="DC Dispatch">
        <bpmn:flowNodeRef>W1163_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1163_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1163_Lane3" name="System">
        <bpmn:flowNodeRef>W1163_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1163_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1163_Lane4" name="Partner Driver">
        <bpmn:flowNodeRef>W1163_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1163_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1163_Start6" name="Daily operations cycle; partner performance threshold breach">
        <bpmn:outgoing>W1163_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1163_Task7" name="Daily Partner Availability Check">
        <bpmn:documentation>Step 1: Daily Partner Availability Check: Logistics Manager confirms 3PL partner vehicle availability for the day via partner portal or messaging; updates dispatch planning with confirmed truck count
Responsible (R): Logistics Manager
Accountable (A): VP Supply Chain
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1163_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1163_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1163_Task8" name="Dispatch Coordination">
        <bpmn:documentation>Step 2: Dispatch Coordination: DC Dispatch assigns deliveries to 3PL partners alongside owned fleet per W196; system generates partner-specific trip manifests; partner driver receives manifest via partner mobile app
Responsible (R): DC Dispatch
Accountable (A): Logistics Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1163_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1163_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1163_Task9" name="Real-Time Tracking">
        <bpmn:documentation>Step 3: Real-Time Tracking: System ingests 3PL partner GPS/telematics data via API; DC Dispatch monitors partner vehicle locations alongside owned fleet on unified dashboard; delays flagged automatically
Responsible (R): System / DC Dispatch
Accountable (A): Logistics Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W1163_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1163_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1163_Task10" name="Delivery Confirmation">
        <bpmn:documentation>Step 4: Delivery Confirmation: Partner driver captures POD (signature + photo) via partner app; system updates order status in ERP; customer notification triggered per W708
Responsible (R): Partner Driver
Accountable (A): DC Dispatch
Duration: 5 min/delivery</bpmn:documentation>
        <bpmn:incoming>W1163_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1163_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1163_Task11" name="Exception Handling">
        <bpmn:documentation>Step 5: Exception Handling: For failed deliveries (customer unavailable, access denied, vehicle breakdown): DC Dispatch coordinates with partner for same-day reattempt or next-day reschedule; customer notified per W708
Responsible (R): DC Dispatch
Accountable (A): Logistics Manager
Duration: 15 min/exception</bpmn:documentation>
        <bpmn:incoming>W1163_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1163_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1163_Task12" name="Daily Settlement Reconciliation">
        <bpmn:documentation>Step 6: Daily Settlement Reconciliation: System matches partner delivery records against ERP dispatch manifest; flags unmatched deliveries for investigation; feeds weekly partner scorecard per W242
Responsible (R): System / AP Clerk
Accountable (A): Logistics Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1163_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1163_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1163_End13" name="Complete">
        <bpmn:incoming>W1163_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1163_Annotation14">
        <bpmn:text>Controls: - CTL-258 (ensure controlled execution — Last-Mile &amp; Delivery Partners (PA-06.3).) | - operational: periodic reconciliation against source documents
Owner: Logistics Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1163_Assoc15" sourceRef="W1163_Annotation14" targetRef="W1163_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1163_Flow16" sourceRef="W1163_Start6" targetRef="W1163_Task7" />
      <bpmn:sequenceFlow id="W1163_Flow17" sourceRef="W1163_Task7" targetRef="W1163_Task8" />
      <bpmn:sequenceFlow id="W1163_Flow18" sourceRef="W1163_Task8" targetRef="W1163_Task9" />
      <bpmn:sequenceFlow id="W1163_Flow19" sourceRef="W1163_Task9" targetRef="W1163_Task10" />
      <bpmn:sequenceFlow id="W1163_Flow20" sourceRef="W1163_Task10" targetRef="W1163_Task11" />
      <bpmn:sequenceFlow id="W1163_Flow21" sourceRef="W1163_Task11" targetRef="W1163_Task12" />
      <bpmn:sequenceFlow id="W1163_Flow22" sourceRef="W1163_Task12" targetRef="W1163_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1163_diag">
