        <bpmndi:BPMNShape id="W1166_Task11_di" bpmnElement="W1166_Task11"><dc:Bounds x="1450" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1166_Start5_di" bpmnElement="W1166_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1166_End12_di" bpmnElement="W1166_End12"><dc:Bounds x="1680" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1166_Annotation13_di" bpmnElement="W1166_Annotation13"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1166_Flow15_di" bpmnElement="W1166_Flow15"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1166_Flow16_di" bpmnElement="W1166_Flow16"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1166_Flow17_di" bpmnElement="W1166_Flow17"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1166_Flow18_di" bpmnElement="W1166_Flow18"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1166_Flow19_di" bpmnElement="W1166_Flow19"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1166_Flow20_di" bpmnElement="W1166_Flow20"><di:waypoint x="1420" y="165" /><di:waypoint x="1450" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1166_Flow21_di" bpmnElement="W1166_Flow21"><di:waypoint x="1630" y="505" /><di:waypoint x="1680" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1166_Assoc14_di" bpmnElement="W1166_Assoc14"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1191" name="W1191. Construction Site Delivery Coordination, Access Assessment &amp; Crane/Boom Truck Scheduling" isExecutable="false">
      <bpmn:documentation>Trigger: Customer places delivery order for heavy/bulky construction materials (cement, steel rebar, lumber, tiles, sand, gravel) to a construction site address
Frequency: ~3,000–4,000 construction site deliveries/month across all channels (B2B trade, B2C retail, ecommerce)
Volume: ~15% of total deliveries involve construction site destinations (vs. residential/commercial addresses)
Owner: Delivery Dispatch Coordinator
Participants: Delivery Dispatch Coordinator, 3PL Partner Driver, Store Manager, Customer (site contact), Category Manager (heavy materials)
Source: workflow W1191 — Construction Site Delivery Coordination, Access Assessment &amp; Crane/Boom Truck Scheduling</bpmn:documentation>
      <bpmn:laneSet id="W1191_LaneSet5">
        <bpmn:lane id="W1191_Lane1" name="Delivery Dispatch Coordinator">
        <bpmn:flowNodeRef>W1191_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1191_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1191_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1191_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1191_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1191_Lane2" name="System">
        <bpmn:flowNodeRef>W1191_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1191_Lane3" name="DC Warehouse Crew">
        <bpmn:flowNodeRef>W1191_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1191_Lane4" name="Driver">
        <bpmn:flowNodeRef>W1191_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1191_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1191_Start6" name="Customer places delivery order for heavy/bulky construction materials (cement, steel…">
        <bpmn:outgoing>W1191_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1191_Task7" name="Site access assessment at order entry">
        <bpmn:documentation>Step 1: Site access assessment at order entry: When customer provides a construction site delivery address: (a) system checks delivery address against &quot;Site Access Profile&quot; database (pre-assessed sites with known constraints); (b) if site is new or unprofiled, Delivery Dispatch Coordinator calls customer/site foreman to assess: (i) road accessibility (paved/unpaved, bridge weight limits), (ii) gate width (minimum 3 meters for 10-wheeler), (iii) unloading area availability, (iv) floor-level delivery requirement, (v) crane/boom truck requirement for multi-story or heavy items; (c) creates Site Access Profile in system for future reference
Responsible (R): Delivery Dispatch Coordinator
Accountable (A): Logistics Manager
Duration: 15 min/new site</bpmn:documentation>
        <bpmn:incoming>W1191_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1191_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1191_Task8" name="Vehicle assignment based on site profile">
        <bpmn:documentation>Step 2: Vehicle assignment based on site profile: System recommends vehicle type based on site access profile: (a) standard 10-wheeler wing van for paved-road sites with dock/ground-level unloading, (b) 6-wheeler truck for narrow-access sites, (c) boom truck/crane truck for multi-story delivery, (d) mini-dump truck for sand/gravel delivery; Logistics Manager confirms vehicle assignment and selects appropriate 3PL partner from approved heavy-haul partners
Responsible (R): System / Delivery Dispatch Coordinator
Accountable (A): Logistics Manager
Duration: 15 min/delivery</bpmn:documentation>
        <bpmn:incoming>W1191_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1191_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1191_Task9" name="Delivery scheduling with site contact">
        <bpmn:documentation>Step 3: Delivery scheduling with site contact: Delivery Dispatch Coordinator schedules delivery date/time with site foreman; confirms: (a) site will be accessible on delivery date (no concrete pouring or excavation blocking access), (b) unloading crew available at site, (c) site safety requirements (PPE required, prohibited areas); sends SMS/email confirmation with delivery window and vehicle type
Responsible (R): Delivery Dispatch Coordinator
Accountable (A): —
Duration: 10 min/delivery</bpmn:documentation>
        <bpmn:incoming>W1191_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1191_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1191_Task10" name="Load securing for construction materials">
        <bpmn:documentation>Step 4: Load securing for construction materials: At dispatch, driver and warehouse crew follow special load-securing protocols for construction materials: (a) cement bags stacked on pallets, wrapped in plastic (moisture protection), (b) rebar bundles secured with steel strapping, (c) lumber loaded lengthwise with end flags for overhang, (d) tiles in original cartons, no more than 4 pallets high; weight distribution verified
Responsible (R): DC Warehouse Crew / Driver
Accountable (A): DC Supervisor
Duration: 30 min/load</bpmn:documentation>
        <bpmn:incoming>W1191_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1191_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1191_Task11" name="On-site delivery execution">
        <bpmn:documentation>Step 5: On-site delivery execution: Driver arrives at construction site; (a) dons required PPE (hard hat, safety vest — mandatory on construction sites per DOLE), (b) coordinates with site foreman for unloading location, (c) if boom truck: operates boom crane to deliver materials to specified floor; (d) if ground-level: unloads with site crew assistance; (e) captures POD (signature + photo of delivered materials at site)
Responsible (R): Driver / Site Foreman
Accountable (A): Delivery Dispatch Coordinator
Duration: 30–90 min/delivery</bpmn:documentation>
        <bpmn:incoming>W1191_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1191_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1191_Task12" name="Shortage and damage resolution">
        <bpmn:documentation>Step 6: Shortage and damage resolution: If delivery is short-loaded or materials are damaged during transit/unloading: (a) driver notes discrepancy on delivery receipt, (b) Delivery Dispatch Coordinator notifies Store Manager and customer within 2 hours, (c) replacement delivery scheduled within 48 hours for critical materials (cement, rebar — construction timeline dependent), (d) damage claim filed with 3PL partner if applicable per W1166
Responsible (R): Delivery Dispatch Coordinator
Accountable (A): Logistics Manager
Duration: 15 min/exception</bpmn:documentation>
        <bpmn:incoming>W1191_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1191_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1191_Task13" name="Site Access Profile update">
        <bpmn:documentation>Step 7: Site Access Profile update: After delivery, Delivery Dispatch Coordinator updates Site Access Profile with delivery notes: (a) actual access conditions encountered, (b) any issues or delays, (c) recommended vehicle type for future deliveries, (d) site contact updates; profile available for future orders to the same site
Responsible (R): Delivery Dispatch Coordinator
Accountable (A): —
Duration: 5 min/delivery</bpmn:documentation>
        <bpmn:incoming>W1191_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1191_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1191_End14" name="Complete">
        <bpmn:incoming>W1191_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1191_Annotation15">
        <bpmn:text>Controls: - CTL-258 (ensure controlled execution — Last-Mile &amp; Delivery Partners (PA-06.3).) | - operational: re-confirming access 24 hours before delivery; operational: mandatory PPE, site safety briefing from foreman, and company insurance coverage for delivery personnel
Owner: Delivery Dispatch Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1191_Assoc16" sourceRef="W1191_Annotation15" targetRef="W1191_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1191_Flow17" sourceRef="W1191_Start6" targetRef="W1191_Task7" />
      <bpmn:sequenceFlow id="W1191_Flow18" sourceRef="W1191_Task7" targetRef="W1191_Task8" />
      <bpmn:sequenceFlow id="W1191_Flow19" sourceRef="W1191_Task8" targetRef="W1191_Task9" />
      <bpmn:sequenceFlow id="W1191_Flow20" sourceRef="W1191_Task9" targetRef="W1191_Task10" />
      <bpmn:sequenceFlow id="W1191_Flow21" sourceRef="W1191_Task10" targetRef="W1191_Task11" />
      <bpmn:sequenceFlow id="W1191_Flow22" sourceRef="W1191_Task11" targetRef="W1191_Task12" />
      <bpmn:sequenceFlow id="W1191_Flow23" sourceRef="W1191_Task12" targetRef="W1191_Task13" />
      <bpmn:sequenceFlow id="W1191_Flow24" sourceRef="W1191_Task13" targetRef="W1191_End14" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1191_diag">
      <bpmndi:BPMNPlane id="W1191_plane" bpmnElement="W_W1191">
