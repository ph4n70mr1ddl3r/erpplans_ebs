    <bpmn:process id="W_W4451" name="W4451. SCO Refund, Return &amp; Void Integrity" isExecutable="false">
      <bpmn:documentation>Trigger: SCO refund/return/void request; reversal
Frequency: Per event (~0.04% return rate × SCO volume)
Volume: SCO refund/return/void events
Owner: Frontend / Customer Service (VS-09/VS-32) / LP (VS-23)
Participants: Frontend (VS-08), Customer Service (VS-09), Returns (VS-32), LP (VS-23), Finance (VS-17), Compliance (VS-22)
Source: workflow W4451 — SCO Refund, Return &amp; Void Integrity</bpmn:documentation>
      <bpmn:laneSet id="W4451_LaneSet4">
        <bpmn:lane id="W4451_Lane1" name="Frontend">
        <bpmn:flowNodeRef>W4451_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4451_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4451_Lane2" name="LP">
