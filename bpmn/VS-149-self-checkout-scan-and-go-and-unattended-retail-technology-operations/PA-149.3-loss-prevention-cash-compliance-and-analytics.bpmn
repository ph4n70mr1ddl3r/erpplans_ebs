        <bpmn:flowNodeRef>W4451_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4451_Start5" name="SCO refund/return/void request; reversal">
        <bpmn:outgoing>W4451_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4451_Task6" name="Frontend/Customer Service process SCO refund/return/void with attendant/manager…">
        <bpmn:documentation>Step 1: Frontend/Customer Service process SCO refund/return/void with attendant/manager authorization (SoD, W4443), validate the original transaction, and reverse inventory/loyalty
Responsible (R): Frontend / Customer Service / Attendant
Accountable (A): Frontend Supervisor / Store Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4451_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4451_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4451_Task7" name="LP/Finance flag SCO refund/void anomalies (excessive voids…">
        <bpmn:documentation>Step 2: LP/Finance flag SCO refund/void anomalies (excessive voids, refund-to-cash-pattern, fake-receipt) for investigation (W4449/W4450) — a common SCO fraud vector
Responsible (R): LP / Finance
Accountable (A): LP Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4451_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4451_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4451_Task8" name="Finance/Compliance reconcile reversals to GL/AR (VS-17/VS-16), ensure tax/VAT…">
        <bpmn:documentation>Step 3: Finance/Compliance reconcile reversals to GL/AR (VS-17/VS-16), ensure tax/VAT reversal correctness (VS-79), and retain evidence (VS-88)
Responsible (R): Finance / Compliance
Accountable (A): Controller
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4451_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4451_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4451_End9" name="Complete">
        <bpmn:incoming>W4451_Flow15</bpmn:incoming>
      </bpmn:endEvent>
