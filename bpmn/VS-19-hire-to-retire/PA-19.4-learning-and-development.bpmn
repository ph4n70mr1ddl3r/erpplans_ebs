        <bpmndi:BPMNEdge id="W5526_Flow17_di" bpmnElement="W5526_Flow17"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5526_Flow18_di" bpmnElement="W5526_Flow18"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
