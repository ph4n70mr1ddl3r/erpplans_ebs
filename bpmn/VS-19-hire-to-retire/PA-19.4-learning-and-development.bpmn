    <bpmn:process id="W_W1500" name="W1500. Store New Employee Shadow Training Program, Buddy Assignment &amp; 90-Day Competency Checklist" isExecutable="false">
      <bpmn:documentation>Trigger: New store employee completes HR onboarding (PA-19.1) and reports to assigned store for first day of operational training
Frequency: Per new hire; ~100–130 new hires/month chain-wide (per profile §11.4 — turnover replacement plus new-store openings)
Volume: ~200–300 employees going through shadow training at any given time across the chain
Owner: Department Supervisor
Participants: New Employee, Assigned Buddy (tenured associate), Department Supervisor, Store Manager, L&amp;D Coordinator
Source: workflow W1500 — Store New Employee Shadow Training Program, Buddy Assignment &amp; 90-Day Competency Checklist</bpmn:documentation>
      <bpmn:laneSet id="W1500_LaneSet5">
        <bpmn:lane id="W1500_Lane1" name="Department Supervisor">
        <bpmn:flowNodeRef>W1500_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1500_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1500_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1500_Lane2" name="Buddy">
        <bpmn:flowNodeRef>W1500_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1500_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1500_Lane3" name="New Employee">
        <bpmn:flowNodeRef>W1500_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1500_Lane4" name="L&amp;D Coordinator">
        <bpmn:flowNodeRef>W1500_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1500_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1500_Start6" name="New store employee completes HR onboarding (PA-19.1) and reports to assigned store for…">
        <bpmn:outgoing>W1500_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1500_Task7" name="Buddy assignment &amp; preparation">
        <bpmn:documentation>Step 1: Buddy assignment &amp; preparation: Before new hire&#x27;s first day: (a) Department Supervisor selects a Buddy: criteria — (i) minimum 6 months tenure in the same department; (ii) consistently meets or exceeds performance targets; (iii) positive attitude and patience; (iv) completed Buddy Training certification (4-hour module); (b) Supervisor briefs Buddy on: new hire&#x27;s name, start date, assigned department, any relevant background; (c) Buddy reviews the 90-Day Competency Checklist to plan the first week&#x27;s focus areas; (d) system sends Buddy a &quot;New Hire Alert&quot; with the checklist link and a summary of Buddy responsibilities
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 30 min per new hire</bpmn:documentation>
        <bpmn:incoming>W1500_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1500_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1500_Task8" name="Week 1 — Observation &amp; orientation">
        <bpmn:documentation>Step 2: Week 1 — Observation &amp; orientation: Days 1–5: (a) new hire shadows Buddy through entire shift; (b) Buddy explains: store layout, department locations, break room, emergency exits, key contacts; (c) daily focus areas per the checklist: (i) Day 1: store tour, safety orientation, meet the team, learn opening procedures; (ii) Day 2: observe customer interactions, learn product location in assigned department; (iii) Day 3: observe POS transactions (if cashier) or stock receiving (if stock associate); (iv) Day 4: observe a full customer service interaction from greeting to close; (v) Day 5: first assisted task — new hire performs a simple task with Buddy observing; (d) Buddy completes daily observation notes in the system
Responsible (R): Buddy / New Employee
Accountable (A): Department Supervisor
Duration: Full shift × 5 days</bpmn:documentation>
        <bpmn:incoming>W1500_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1500_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1500_Task9" name="Days 8–30 — Assisted practice">
        <bpmn:documentation>Step 3: Days 8–30 — Assisted practice: Weeks 2–4: (a) new hire performs tasks with Buddy available for questions: (i) POS transactions (cashier): Buddy monitors from adjacent register, intervenes only for errors; (ii) stock receiving: new hire processes receipts with Buddy checking accuracy; (iii) customer assistance: new hire handles routine customer questions, escalates complex ones to Buddy; (b) competency checklist items progressively checked off as new hire demonstrates proficiency; (c) Department Supervisor conducts 15-min check-in with new hire at end of each week; (d) if new hire struggles with specific competency: Buddy provides additional focused practice sessions
Responsible (R): Buddy / New Employee
Accountable (A): Department Supervisor
Duration: Full shift × ~20 days</bpmn:documentation>
        <bpmn:incoming>W1500_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1500_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1500_Task10" name="Days 31–60 — Supervised independence">
        <bpmn:documentation>Step 4: Days 31–60 — Supervised independence: Months 2: (a) new hire works independently for most of the shift; Buddy stationed in same department but not directly shadowing; (b) new hire handles: standard transactions, routine customer inquiries, basic stock tasks, opening/closing duties for their station; (c) Buddy conducts 10-min end-of-day debrief: what went well, what needs improvement; (d) remaining checklist items completed; (e) Department Supervisor conducts formal 30-day review with new hire and Buddy: competency progress, attitude, attendance, areas for improvement
Responsible (R): New Employee / Buddy
Accountable (A): Department Supervisor
Duration: Full shift with decreasing supervision</bpmn:documentation>
        <bpmn:incoming>W1500_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1500_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1500_Task11" name="Days 61–90 — Full independence &amp; assessment">
        <bpmn:documentation>Step 5: Days 61–90 — Full independence &amp; assessment: Month 3: (a) new hire works independently; Buddy relationship transitions to &quot;available mentor&quot; — new hire can ask questions but is expected to handle most situations alone; (b) Department Supervisor conducts 60-day mid-point check; (c) at Day 90: formal competency assessment: (i) Department Supervisor and Buddy review completed 90-Day Checklist; (ii) Supervisor evaluates new hire on: task proficiency, customer service quality, teamwork, attendance, safety compliance; (iii) new hire self-assesses their confidence level on each competency; (iv) assessment result: (A) &quot;Passed&quot; — completes probation, becomes regular employee; (B) &quot;Needs Improvement&quot; — 30-day extension with focused development plan; (C) &quot;Not Meeting Standards&quot; — recommendation for separation per PA-19.5; (d) Buddy recognition: Buddy receives a &quot;Training Completion&quot; credit in their performance record
Responsible (R): Department Supervisor / Buddy
Accountable (A): Store Manager
Duration: Assessment: 1–2 hours; ongoing independence</bpmn:documentation>
        <bpmn:incoming>W1500_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1500_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1500_Task12" name="Buddy program administration">
        <bpmn:documentation>Step 6: Buddy program administration: (a) L&amp;D Coordinator maintains a pool of certified Buddies per store (target: 1 Buddy per 5 department associates); (b) Buddy certification: 4-hour training module covering coaching techniques, feedback delivery, and patience management; (c) Buddy workload monitoring: Department Supervisor ensures Buddy is not overloaded with too many trainees simultaneously (max 1 trainee at a time); (d) Buddy incentive: PHP 500/quarter &quot;Buddy Allowance&quot; for each successfully trained new hire who passes 90-day assessment; (e) quarterly review of program effectiveness: 90-day pass rate, 6-month retention of trained employees, Buddy satisfaction survey
Responsible (R): L&amp;D Coordinator / Department Supervisor
Accountable (A): CHRO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1500_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1500_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1500_End13" name="Complete">
        <bpmn:incoming>W1500_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1500_Annotation14">
        <bpmn:text>Controls: - CTL-299 (ensure controlled execution — Learning &amp; Development (PA-19.4).) | - operational: Department Supervisor review and approval gate
Owner: Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1500_Assoc15" sourceRef="W1500_Annotation14" targetRef="W1500_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1500_Flow16" sourceRef="W1500_Start6" targetRef="W1500_Task7" />
      <bpmn:sequenceFlow id="W1500_Flow17" sourceRef="W1500_Task7" targetRef="W1500_Task8" />
      <bpmn:sequenceFlow id="W1500_Flow18" sourceRef="W1500_Task8" targetRef="W1500_Task9" />
      <bpmn:sequenceFlow id="W1500_Flow19" sourceRef="W1500_Task9" targetRef="W1500_Task10" />
      <bpmn:sequenceFlow id="W1500_Flow20" sourceRef="W1500_Task10" targetRef="W1500_Task11" />
      <bpmn:sequenceFlow id="W1500_Flow21" sourceRef="W1500_Task11" targetRef="W1500_Task12" />
      <bpmn:sequenceFlow id="W1500_Flow22" sourceRef="W1500_Task12" targetRef="W1500_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1500_diag">
      <bpmndi:BPMNPlane id="W1500_plane" bpmnElement="W_W1500">
        <bpmndi:BPMNShape id="W1500_Lane1_di" bpmnElement="W1500_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1500_Lane2_di" bpmnElement="W1500_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1500_Lane3_di" bpmnElement="W1500_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1500_Lane4_di" bpmnElement="W1500_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1580" height="170" /></bpmndi:BPMNShape>
