      <bpmn:sequenceFlow id="W5527_Flow18" sourceRef="W5527_Task8" targetRef="W5527_Task9" />
      <bpmn:sequenceFlow id="W5527_Flow19" sourceRef="W5527_Task9" targetRef="W5527_Task10" />
      <bpmn:sequenceFlow id="W5527_Flow20" sourceRef="W5527_Task10" targetRef="W5527_Task11" />
      <bpmn:sequenceFlow id="W5527_Flow21" sourceRef="W5527_Task11" targetRef="W5527_End12" />
    </bpmn:process>
