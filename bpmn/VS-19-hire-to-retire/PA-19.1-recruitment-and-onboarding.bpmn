    <bpmn:process id="W_W994" name="W994. Employee Typhoon Disaster Relief Emergency Assistance &amp; No-Interest Loan Program" isExecutable="false">
      <bpmn:documentation>Trigger: Typhoon Signal No. 3 or above impacts employee&#x27;s area of residence; or employee&#x27;s home is damaged by natural disaster
Frequency: ~4–6 activations/year (PH typhoon season June–November); individual claims: ~50–200 employees per major typhoon
Volume: 1 claim per affected employee per typhoon event
Owner: HR Manager
Participants: Store Manager (if store-level employee), HR Department, Finance Department (treasury), CHRO
Source: workflow W994 — Employee Typhoon Disaster Relief Emergency Assistance &amp; No-Interest Loan Program</bpmn:documentation>
      <bpmn:laneSet id="W994_LaneSet6">
        <bpmn:lane id="W994_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W994_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W994_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W994_Lane2" name="Employee">
        <bpmn:flowNodeRef>W994_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W994_Lane3" name="HR Manager">
        <bpmn:flowNodeRef>W994_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W994_Lane4" name="Finance Department">
        <bpmn:flowNodeRef>W994_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W994_Lane5" name="Sales Associate">
        <bpmn:flowNodeRef>W994_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W994_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W994_Start7" name="Typhoon Signal No. 3 or above impacts employee&#x27;s area of residence; or employee&#x27;s home is…">
        <bpmn:outgoing>W994_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W994_Task8" name="Disaster Declaration &amp; Employee Impact Assessment">
        <bpmn:documentation>Step 1: Disaster Declaration &amp; Employee Impact Assessment: After typhoon impact: (a) HR Department monitors PAGASA typhoon advisories and identifies affected areas (Signal No. 3+ or reported flooding/landslide); (b) Store Manager in affected areas conducts employee headcount within 24 hours — confirms all employees are safe, identifies employees with home damage or displacement; (c) Store Manager reports affected employee count and damage severity to HR Department via emergency communication tree; (d) CHRO declares Disaster Relief Activation for affected areas; (e) system sends notification to all affected employees with relief program information and claim instructions
Responsible (R): Store Manager / HR Manager
Accountable (A): CHRO
Duration: 24–48 hours post-typhoon</bpmn:documentation>
        <bpmn:incoming>W994_Flow16</bpmn:incoming>
        <bpmn:outgoing>W994_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W994_Task9" name="Employee Claim Submission">
        <bpmn:documentation>Step 2: Employee Claim Submission: Affected employee submits disaster relief claim via: (a) mobile app disaster relief form — describes damage (minor: partial roof/wall damage, moderate: significant structural damage, severe: home destroyed/uninhabitable), estimated repair cost, photos of damage; (b) in-person at store HR desk if mobile/app not accessible; (c) HR Department receives and logs claim; (d) system automatically verifies employee status (active, regular employee ≥6 months tenure) and assigns claim number
Responsible (R): Employee / HR Department
Accountable (A): HR Manager
Duration: 15–30 min per claim</bpmn:documentation>
        <bpmn:incoming>W994_Flow17</bpmn:incoming>
        <bpmn:outgoing>W994_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W994_Task10" name="Damage Verification &amp; Assistance Determination">
        <bpmn:documentation>Step 3: Damage Verification &amp; Assistance Determination: HR Department validates: (a) damage severity — based on employee photos, Store Manager verification (phone call or in-person visit for severe cases), and barangay/municipal disaster reports; (b) assistance tier — Tier 1 (minor damage): PHP 5,000 emergency cash grant + PHP 15,000 no-interest loan; Tier 2 (moderate damage): PHP 10,000 emergency cash grant + PHP 30,000 no-interest loan; Tier 3 (severe/uninhabitable): PHP 20,000 emergency cash grant + PHP 50,000 no-interest loan + temporary housing assistance (company-arranged or PHP 5,000/month housing subsidy for 3 months); (c) for claims above Tier 2: HR Manager approves; for Tier 3: CHRO approves
Responsible (R): HR Manager / Store Manager
Accountable (A): CHRO (for Tier 3)
Duration: 2–5 business days</bpmn:documentation>
        <bpmn:incoming>W994_Flow18</bpmn:incoming>
        <bpmn:outgoing>W994_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W994_Task11" name="Cash Grant Disbursement &amp; Loan Processing">
        <bpmn:documentation>Step 4: Cash Grant Disbursement &amp; Loan Processing: Finance Department processes: (a) emergency cash grant — disbursed within 3 business days of approval via bank transfer to employee&#x27;s payroll account; (b) no-interest loan — loan agreement signed (digital or paper); loan amount deducted from employee&#x27;s semi-monthly payroll over 12–24 months (payroll deduction per W10); no interest charged; no penalty for early repayment; (c) employee receives loan proceeds via bank transfer within 5 business days of agreement signing; (d) system records loan in employee advance/loan register per W76 and creates payroll deduction schedule
Responsible (R): Finance Department / HR Department
Accountable (A): HR Manager
Duration: 3–5 business days</bpmn:documentation>
        <bpmn:incoming>W994_Flow19</bpmn:incoming>
        <bpmn:outgoing>W994_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W994_Task12" name="Building Material Assistance &amp; Follow-Up">
        <bpmn:documentation>Step 5: Building Material Assistance &amp; Follow-Up: (a) affected employee receives priority access to BuildRight building materials (GI sheets, cement, lumber, nails, paint) at employee discount per W205 (additional 10% off employee price for disaster relief claims); (b) employee selects materials and Store Manager approves priority allocation from store inventory; (c) if store inventory insufficient, inter-store transfer per W22 expedited; (d) delivery to employee&#x27;s home provided free of charge within store&#x27;s delivery radius; (e) HR Department follows up at 30 days and 90 days post-disaster to verify employee recovery and assess need for additional assistance
Responsible (R): Sales Associate / Store Manager / HR Department
Accountable (A): HR Manager
Duration: 30 min per employee</bpmn:documentation>
        <bpmn:incoming>W994_Flow20</bpmn:incoming>
        <bpmn:outgoing>W994_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W994_End13" name="Complete">
        <bpmn:incoming>W994_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W994_Annotation14">
        <bpmn:text>Controls: - CTL-296 (ensure controlled execution — Recruitment &amp; Onboarding (PA-19.1).) | - operational: HR Manager review and approval gate
Owner: HR Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W994_Assoc15" sourceRef="W994_Annotation14" targetRef="W994_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W994_Flow16" sourceRef="W994_Start7" targetRef="W994_Task8" />
