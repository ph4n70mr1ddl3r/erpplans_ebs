<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-19.1-recruitment-and-onboarding" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W15" name="W15. Recruitment &amp; Employee Onboarding" isExecutable="false">
      <bpmn:documentation>Trigger: Vacancy created (resignation, new position, new store opening)
Frequency: ~100–130 hires/month (1,200–1,600/year including turnover + growth)
Volume: Peaks during new store openings (30 hires per new store)
Owner: HR Recruitment Officer
Participants: Recruitment Officer, HR Assistant, Hiring Manager, HR Head
Source: workflow W15 — Recruitment &amp; Employee Onboarding</bpmn:documentation>
      <bpmn:laneSet id="W15_LaneSet8">
        <bpmn:lane id="W15_Lane1" name="Hiring Manager">
        <bpmn:flowNodeRef>W15_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W15_Start9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W15_Lane2" name="Recruitment Officer">
        <bpmn:flowNodeRef>W15_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W15_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W15_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W15_Lane3" name="Recruitment Officer + Hiring Manager">
        <bpmn:flowNodeRef>W15_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W15_Lane4" name="New Hire">
        <bpmn:flowNodeRef>W15_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W15_Lane5" name="HR Assistant">
        <bpmn:flowNodeRef>W15_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W15_Task18</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W15_Lane6" name="System">
        <bpmn:flowNodeRef>W15_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W15_Task20</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W15_Lane7" name="Dept. Supervisor + HR">
        <bpmn:flowNodeRef>W15_Task19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W15_End21</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W15_Start9" name="Vacancy created (resignation, new position, new store opening)">
        <bpmn:outgoing>W15_Flow24</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W15_Task10" name="Hiring Manager submits staffing request with role, department, justification">
        <bpmn:documentation>Step 1: Hiring Manager submits staffing request with role, department, justification
Responsible (R): Hiring Manager
Accountable (A): Dept. Head
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W15_Flow24</bpmn:incoming>
        <bpmn:outgoing>W15_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W15_Task11" name="HR Recruitment Officer posts job on job boards, social media, walk-in postings">
        <bpmn:documentation>Step 2: HR Recruitment Officer posts job on job boards, social media, walk-in postings
Responsible (R): Recruitment Officer
Accountable (A): HR Head
Duration: 30 min/role</bpmn:documentation>
        <bpmn:incoming>W15_Flow25</bpmn:incoming>
        <bpmn:outgoing>W15_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W15_Task12" name="Screen applications; shortlist candidates">
        <bpmn:documentation>Step 3: Screen applications; shortlist candidates
Responsible (R): Recruitment Officer
Accountable (A): HR Head
Duration: 2–4 hours/role</bpmn:documentation>
        <bpmn:incoming>W15_Flow26</bpmn:incoming>
        <bpmn:outgoing>W15_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W15_Task13" name="Conduct interviews (1st: HR; 2nd: Hiring Manager)">
        <bpmn:documentation>Step 4: Conduct interviews (1st: HR; 2nd: Hiring Manager)
Responsible (R): Recruitment Officer + Hiring Manager
Accountable (A): Dept. Head
Duration: 1 hour/candidate</bpmn:documentation>
        <bpmn:incoming>W15_Flow27</bpmn:incoming>
        <bpmn:outgoing>W15_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W15_Task14" name="Select candidate; extend offer">
        <bpmn:documentation>Step 5: Select candidate; extend offer
Responsible (R): Recruitment Officer
Accountable (A): HR Head
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W15_Flow28</bpmn:incoming>
        <bpmn:outgoing>W15_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W15_Task15" name="New hire completes pre-employment requirements (SSS, PhilHealth, Pag-IBIG, TIN…">
        <bpmn:documentation>Step 6: New hire completes pre-employment requirements (SSS, PhilHealth, Pag-IBIG, TIN, medical, NBI clearance)
Responsible (R): New Hire
Accountable (A): Recruitment Officer
Duration: —</bpmn:documentation>
        <bpmn:incoming>W15_Flow29</bpmn:incoming>
        <bpmn:outgoing>W15_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W15_Task16" name="HR Assistant creates employee record in system (personal info, position…">
        <bpmn:documentation>Step 7: HR Assistant creates employee record in system (personal info, position, salary, entity, tax status); employee type classified as regular, probationary, fixed-term, or project-based with contract start/end dates for non-regular employees
Responsible (R): HR Assistant
Accountable (A): HR Head
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W15_Flow30</bpmn:incoming>
        <bpmn:outgoing>W15_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W15_Task17" name="System generates employee ID; enrolls in payroll with correct statutory…">
        <bpmn:documentation>Step 8: System generates employee ID; enrolls in payroll with correct statutory deductions
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W15_Flow31</bpmn:incoming>
        <bpmn:outgoing>W15_Flow32</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W15_Task18" name="Assign biometric/RFID credentials for time &amp; attendance">
        <bpmn:documentation>Step 9: Assign biometric/RFID credentials for time &amp; attendance
Responsible (R): HR Assistant
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W15_Flow32</bpmn:incoming>
        <bpmn:outgoing>W15_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W15_Task19" name="Onboarding: safety orientation, company policies, POS/system training">
        <bpmn:documentation>Step 10: Onboarding: safety orientation, company policies, POS/system training
Responsible (R): Dept. Supervisor + HR
Accountable (A): Hiring Manager
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W15_Flow33</bpmn:incoming>
        <bpmn:outgoing>W15_Flow34</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W15_Task20" name="First payroll: system computes pro-rated salary for partial month">
        <bpmn:documentation>Step 11: First payroll: system computes pro-rated salary for partial month
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W15_Flow34</bpmn:incoming>
        <bpmn:outgoing>W15_Flow35</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W15_End21" name="Complete">
        <bpmn:incoming>W15_Flow35</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W15_Annotation22">
        <bpmn:text>Controls: - CTL-296 (ensure controlled execution — Recruitment &amp; Onboarding (PA-19.1).) | - operational: training
Owner: HR Recruitment Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W15_Assoc23" sourceRef="W15_Annotation22" targetRef="W15_Start9" associationDirection="None" />
      <bpmn:sequenceFlow id="W15_Flow24" sourceRef="W15_Start9" targetRef="W15_Task10" />
