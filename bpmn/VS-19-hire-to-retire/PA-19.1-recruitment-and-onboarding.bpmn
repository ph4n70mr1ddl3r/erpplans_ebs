        <bpmn:flowNodeRef>W269_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W269_Lane4" name="Promodizer">
        <bpmn:flowNodeRef>W269_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W269_Lane5" name="Store Manager">
        <bpmn:flowNodeRef>W269_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W269_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W269_Start7" name="Vendor assigns a promodizer to a specific store location.">
        <bpmn:outgoing>W269_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W269_Task8" name="Vendor submits promodizer credentials and schedule to HR.">
        <bpmn:documentation>Step 1: Vendor submits promodizer credentials and schedule to HR.
Responsible (R): Vendor Account Mgr
Accountable (A): HR Admin
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W269_Flow16</bpmn:incoming>
        <bpmn:outgoing>W269_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W269_Task9" name="Store Admin creates a non-employee profile in the system.">
        <bpmn:documentation>Step 2: Store Admin creates a non-employee profile in the system.
Responsible (R): Store Admin
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W269_Flow17</bpmn:incoming>
        <bpmn:outgoing>W269_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W269_Task10" name="System provisions limited POS access (for sales attribution) and biometric…">
        <bpmn:documentation>Step 3: System provisions limited POS access (for sales attribution) and biometric attendance profile.
Responsible (R): System
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W269_Flow18</bpmn:incoming>
        <bpmn:outgoing>W269_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W269_Task11" name="Promodizer logs time in/out; data is shared with vendor for their payroll.">
        <bpmn:documentation>Step 4: Promodizer logs time in/out; data is shared with vendor for their payroll.
Responsible (R): Promodizer
Accountable (A): HR Admin
Duration: 5 min/day</bpmn:documentation>
        <bpmn:incoming>W269_Flow19</bpmn:incoming>
        <bpmn:outgoing>W269_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W269_Task12" name="Store Manager reviews promodizer sales performance and revokes access upon…">
        <bpmn:documentation>Step 5: Store Manager reviews promodizer sales performance and revokes access upon offboarding.
Responsible (R): Store Manager
Accountable (A): CHRO
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W269_Flow20</bpmn:incoming>
        <bpmn:outgoing>W269_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W269_End13" name="Complete">
        <bpmn:incoming>W269_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W269_Annotation14">
        <bpmn:text>Controls: - CTL-296 (ensure controlled execution — Recruitment &amp; Onboarding (PA-19.1).) | - operational: Store Manager review and approval gate
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
