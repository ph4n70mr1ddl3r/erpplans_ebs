    <bpmn:process id="W_W429" name="W429. Vendor-Funded Promodizer Incentive Management" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor launches a sales incentive program (SPIFF) for their promodizers
Frequency: Monthly or per promotional event
Volume: ~500–1,000 active promodizers across 200 stores
Owner: HR Operations Manager
Participants: Store Manager, Category Manager, Vendor Account Manager, Payroll Officer
Source: workflow W429 — Vendor-Funded Promodizer Incentive Management</bpmn:documentation>
      <bpmn:laneSet id="W429_LaneSet7">
        <bpmn:lane id="W429_Lane1" name="Vendor Account Mgr">
        <bpmn:flowNodeRef>W429_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W429_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W429_Lane2" name="HR Assistant">
        <bpmn:flowNodeRef>W429_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W429_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W429_Lane3" name="System">
        <bpmn:flowNodeRef>W429_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W429_Lane4" name="AR Clerk">
        <bpmn:flowNodeRef>W429_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W429_Lane5" name="Payroll Officer">
        <bpmn:flowNodeRef>W429_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W429_Lane6" name="Compliance Manager">
        <bpmn:flowNodeRef>W429_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W429_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W429_Start8" name="Vendor launches a sales incentive program (SPIFF) for their promodizers">
        <bpmn:outgoing>W429_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W429_Task9" name="Incentive Declaration">
        <bpmn:documentation>Step 1: Incentive Declaration: Vendor Account Manager submits the &quot;Promodizer Incentive Program&quot; mechanics (SKUs, target levels, payout rates) to the Category Manager for approval
Responsible (R): Vendor Account Mgr
Accountable (A): Category Mgr
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W429_Flow19</bpmn:incoming>
        <bpmn:outgoing>W429_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W429_Task10" name="System Configuration">
        <bpmn:documentation>Step 2: System Configuration: HR Assistant tags the approved promodizers and the covered SKUs in the &quot;Incentive Tracking Module&quot; (linked to W269 sales attribution)
Responsible (R): HR Assistant
Accountable (A): HR Ops Manager
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W429_Flow20</bpmn:incoming>
        <bpmn:outgoing>W429_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W429_Task11" name="Monthly Sales Validation">
        <bpmn:documentation>Step 3: Monthly Sales Validation: System generates a &quot;Promodizer Sales Achievement Report&quot; showing actual POS sales for the target SKUs attributed to each promodizer ID (W269.3)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W429_Flow21</bpmn:incoming>
        <bpmn:outgoing>W429_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W429_Task12" name="Incentive Computation">
        <bpmn:documentation>Step 4: Incentive Computation: HR Assistant computes the incentive payout per promodizer based on the validated POS data; Vendor verifies the total
Responsible (R): HR Assistant
Accountable (A): Vendor Account Mgr
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W429_Flow22</bpmn:incoming>
        <bpmn:outgoing>W429_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W429_Task13" name="Vendor Billing">
        <bpmn:documentation>Step 5: Vendor Billing: Finance generates a &quot;Service Invoice&quot; to the Vendor for the total incentive amount + an administrative fee (e.g., 5%) for processing
Responsible (R): AR Clerk
Accountable (A): Finance Mgr
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W429_Flow23</bpmn:incoming>
        <bpmn:outgoing>W429_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W429_Task14" name="Payout Execution">
        <bpmn:documentation>Step 6: Payout Execution: Upon receipt of vendor payment, BuildRight dispatches the incentive to promodizers (either via a separate payroll run or via the Vendor&#x27;s agency)
Responsible (R): Payroll Officer
Accountable (A): HR Ops Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W429_Flow24</bpmn:incoming>
        <bpmn:outgoing>W429_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W429_Task15" name="Audit &amp; Integrity Check">
        <bpmn:documentation>Step 7: Audit &amp; Integrity Check: Compliance Manager reviews a sample of payouts to ensure no unauthorized &quot;direct-to-promodizer&quot; cash payments were made by vendors in violation of the &quot;No-Gift Policy&quot; (W426)
Responsible (R): Compliance Manager
Accountable (A): CHRO
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W429_Flow25</bpmn:incoming>
        <bpmn:outgoing>W429_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W429_End16" name="Complete">
        <bpmn:incoming>W429_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W429_Annotation17">
        <bpmn:text>Controls: - CTL-296 (ensure controlled execution — Recruitment &amp; Onboarding (PA-19.1).) | - operational: HR Operations Manager review and approval gate
Owner: HR Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W429_Assoc18" sourceRef="W429_Annotation17" targetRef="W429_Start8" associationDirection="None" />
      <bpmn:sequenceFlow id="W429_Flow19" sourceRef="W429_Start8" targetRef="W429_Task9" />
      <bpmn:sequenceFlow id="W429_Flow20" sourceRef="W429_Task9" targetRef="W429_Task10" />
      <bpmn:sequenceFlow id="W429_Flow21" sourceRef="W429_Task10" targetRef="W429_Task11" />
      <bpmn:sequenceFlow id="W429_Flow22" sourceRef="W429_Task11" targetRef="W429_Task12" />
