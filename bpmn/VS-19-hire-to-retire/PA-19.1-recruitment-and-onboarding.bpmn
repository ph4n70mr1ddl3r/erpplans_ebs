    <bpmn:process id="W_W629" name="W629. Store-Level Employee Engagement Survey &amp; Action Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Semi-annual survey calendar; annual comprehensive survey
Frequency: Semi-annual pulse surveys; annual comprehensive engagement survey
Volume: ~6,911 employees across 200 stores, 4 DCs, HQ
Owner: HR Business Partner
Participants: HR Business Partner, CHRO, Store/DC Managers, Department Heads, all employees
Source: workflow W629 — Store-Level Employee Engagement Survey &amp; Action Planning</bpmn:documentation>
      <bpmn:laneSet id="W629_LaneSet6">
        <bpmn:lane id="W629_Lane1" name="HR Business Partner">
        <bpmn:flowNodeRef>W629_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W629_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W629_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W629_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W629_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W629_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W629_Lane2" name="CHRO">
        <bpmn:flowNodeRef>W629_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W629_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W629_Lane3" name="Employee">
        <bpmn:flowNodeRef>W629_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W629_Lane4" name="System">
        <bpmn:flowNodeRef>W629_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W629_Lane5" name="Store">
        <bpmn:flowNodeRef>W629_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W629_End18</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W629_Start7" name="Semi-annual survey calendar; annual comprehensive survey">
        <bpmn:outgoing>W629_Flow21</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W629_Task8" name="HR Business Partner configures engagement survey in survey platform: selects…">
        <bpmn:documentation>Step 1: HR Business Partner configures engagement survey in survey platform: selects question set (comprehensive: 40-50 questions across 10 dimensions; pulse: 10-15 questions on focus areas), configures demographics (location, department, tenure, role level — no individually identifying data to protect anonymity), sets survey period (2 weeks), and sends launch communication
Responsible (R): HR Business Partner
Accountable (A): CHRO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W629_Flow21</bpmn:incoming>
        <bpmn:outgoing>W629_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W629_Task9" name="Survey communication cascade: CHRO sends company-wide email announcing survey…">
        <bpmn:documentation>Step 2: Survey communication cascade: CHRO sends company-wide email announcing survey purpose and confidentiality; Store/DC Managers announce in team huddles; system sends personalized survey link to each employee via email and SMS; reminder sent at Day 7 for non-respondents
Responsible (R): CHRO / Store Managers
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W629_Flow22</bpmn:incoming>
        <bpmn:outgoing>W629_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W629_Task10" name="Employees complete survey on mobile device, POS terminal (during non-selling…">
        <bpmn:documentation>Step 3: Employees complete survey on mobile device, POS terminal (during non-selling time), shared store tablet, or personal phone; estimated completion time: 10-15 minutes (comprehensive), 5 minutes (pulse); survey platform ensures anonymity (no IP tracking, no timestamps linked to individuals)
Responsible (R): Employee
Accountable (A): —
Duration: 10-15 min</bpmn:documentation>
        <bpmn:incoming>W629_Flow23</bpmn:incoming>
        <bpmn:outgoing>W629_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W629_Task11" name="HR Business Partner monitors response rate daily; targets ≥ 80% response rate…">
        <bpmn:documentation>Step 4: HR Business Partner monitors response rate daily; targets ≥ 80% response rate; sends targeted reminders to locations/departments below 60% at Day 5 and Day 10; extends survey period by 3 days if overall response rate &lt; 70% at Day 12
Responsible (R): HR Business Partner
Accountable (A): —
Duration: 15 min/day</bpmn:documentation>
        <bpmn:incoming>W629_Flow24</bpmn:incoming>
        <bpmn:outgoing>W629_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W629_Task12" name="Survey platform auto-generates results: (a) overall engagement score (0-100)…">
        <bpmn:documentation>Step 5: Survey platform auto-generates results: (a) overall engagement score (0-100), (b) dimension scores (leadership, communication, career development, compensation, work environment, teamwork, recognition, well-being, safety, company pride), (c) scores by demographic segment, (d) open-ended response themes (NLP-based sentiment analysis), (e) comparison to prior period and external benchmarks
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W629_Flow25</bpmn:incoming>
        <bpmn:outgoing>W629_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W629_Task13" name="HR Business Partner prepares engagement results presentation: company-wide…">
        <bpmn:documentation>Step 6: HR Business Partner prepares engagement results presentation: company-wide results, location-level breakdown (store/DC/HQ), dimension analysis, strongest and weakest areas, verbatim theme summary, and action planning framework
Responsible (R): HR Business Partner
Accountable (A): CHRO
Duration: 8 hours</bpmn:documentation>
        <bpmn:incoming>W629_Flow26</bpmn:incoming>
        <bpmn:outgoing>W629_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W629_Task14" name="CHRO presents company-wide results to C-suite and Department Heads; each…">
        <bpmn:documentation>Step 7: CHRO presents company-wide results to C-suite and Department Heads; each Department Head receives their department-specific results with action planning template; Store Managers receive store-specific results via Regional Manager
Responsible (R): CHRO
Accountable (A): CEO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W629_Flow27</bpmn:incoming>
        <bpmn:outgoing>W629_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W629_Task15" name="Action planning: each Store Manager and Department Head identifies top 3…">
        <bpmn:documentation>Step 8: Action planning: each Store Manager and Department Head identifies top 3 engagement actions for their area (using action planning template); actions must be specific, measurable, and achievable within 6 months; system tracks action plan submission and completion
Responsible (R): Store/DC Managers / Dept. Heads
Accountable (A): HR Business Partner
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W629_Flow28</bpmn:incoming>
        <bpmn:outgoing>W629_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W629_Task16" name="Monthly: HR Business Partner tracks action plan execution; facilitates peer…">
        <bpmn:documentation>Step 9: Monthly: HR Business Partner tracks action plan execution; facilitates peer learning among Store Managers on effective engagement practices; updates engagement dashboard with action completion rates
Responsible (R): HR Business Partner
Accountable (A): —
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W629_Flow29</bpmn:incoming>
        <bpmn:outgoing>W629_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W629_Task17" name="Semi-annual: pulse survey measures progress on focus areas from previous…">
        <bpmn:documentation>Step 10: Semi-annual: pulse survey measures progress on focus areas from previous comprehensive survey; results compared to baseline to validate improvement
Responsible (R): HR Business Partner
Accountable (A): CHRO
Duration: Per Steps 1-8</bpmn:documentation>
        <bpmn:incoming>W629_Flow30</bpmn:incoming>
        <bpmn:outgoing>W629_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W629_End18" name="Complete">
        <bpmn:incoming>W629_Flow31</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W629_Annotation19">
        <bpmn:text>Controls: - CTL-296 (ensure controlled execution — Recruitment &amp; Onboarding (PA-19.1).) | - operational: visible action on prior survey results, clear communication of changes made, and limiting survey frequency; operational: third-party survey administration, suppression of results for groups &lt; 5 respondents, and transparent anonymity methodology; operational: dedicated survey time during shift, tablet access in break room, and response rate targets tied to Store Manager accountability
Owner: HR Business Partner</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W629_Assoc20" sourceRef="W629_Annotation19" targetRef="W629_Start7" associationDirection="None" />
