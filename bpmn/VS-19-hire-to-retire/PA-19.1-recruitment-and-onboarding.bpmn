        <bpmndi:BPMNShape id="W172_Task10_di" bpmnElement="W172_Task10"><dc:Bounds x="1450" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W172_Start4_di" bpmnElement="W172_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W172_End11_di" bpmnElement="W172_End11"><dc:Bounds x="1680" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W172_Annotation12_di" bpmnElement="W172_Annotation12"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W172_Flow14_di" bpmnElement="W172_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W172_Flow15_di" bpmnElement="W172_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W172_Flow16_di" bpmnElement="W172_Flow16"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W172_Flow17_di" bpmnElement="W172_Flow17"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W172_Flow18_di" bpmnElement="W172_Flow18"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W172_Flow19_di" bpmnElement="W172_Flow19"><di:waypoint x="1420" y="165" /><di:waypoint x="1450" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W172_Flow20_di" bpmnElement="W172_Flow20"><di:waypoint x="1630" y="335" /><di:waypoint x="1680" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W172_Assoc13_di" bpmnElement="W172_Assoc13"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W178" name="W178. Employee Succession &amp; Internal Mobility" isExecutable="false">
      <bpmn:documentation>Trigger: Retirement of key leader; store expansion; or high-potential (HiPo) identification
Frequency: Annual HiPo review and succession mapping; ongoing internal postings per vacancy
Volume: ~200 Store Manager and ~30 Department Head/Manager roles requiring succession plans; ~30–50 internal promotions/transfers per year
Owner: CHRO
Participants: CEO, Department Heads, HR Manager, High-Potential Employees
Source: workflow W178 — Employee Succession &amp; Internal Mobility</bpmn:documentation>
      <bpmn:laneSet id="W178_LaneSet4">
        <bpmn:lane id="W178_Lane1" name="HR Manager">
        <bpmn:flowNodeRef>W178_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W178_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W178_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W178_Lane2" name="Department Head">
        <bpmn:flowNodeRef>W178_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W178_Lane3" name="System">
        <bpmn:flowNodeRef>W178_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W178_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W178_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W178_Start5" name="Retirement of key leader; store expansion; or high-potential (HiPo) identification">
        <bpmn:outgoing>W178_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W178_Task6" name="HiPo Identification">
        <bpmn:documentation>Step 1: HiPo Identification: Annual review of performance (W72) and potential; tag employees for &quot;Internal Mobility&quot; in ERP
Responsible (R): HR Manager
Accountable (A): CHRO
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W178_Flow14</bpmn:incoming>
        <bpmn:outgoing>W178_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W178_Task7" name="Succession Mapping">
        <bpmn:documentation>Step 2: Succession Mapping: Identify &quot;Ready Now&quot; and &quot;Ready in 1–2 Years&quot; successors for all Store Manager and Department Head roles
Responsible (R): Department Head
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W178_Flow15</bpmn:incoming>
        <bpmn:outgoing>W178_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W178_Task8" name="Individual Development Plan (IDP)">
        <bpmn:documentation>Step 3: Individual Development Plan (IDP): Successors assigned to specific training (W51) and cross-functional rotations
Responsible (R): HR Manager
Accountable (A): —
Duration: 1 year</bpmn:documentation>
        <bpmn:incoming>W178_Flow16</bpmn:incoming>
        <bpmn:outgoing>W178_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W178_Task9" name="Internal Posting">
        <bpmn:documentation>Step 4: Internal Posting: Vacancies posted internally for 5 days before external search; system alerts eligible internal candidates
Responsible (R): System
Accountable (A): HR Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W178_Flow17</bpmn:incoming>
        <bpmn:outgoing>W178_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W178_Task10" name="Transfer/Promotion">
        <bpmn:documentation>Step 5: Transfer/Promotion: Selected candidate&#x27;s contract and payroll (W10) updated; system auto-triggers offboarding from old role and onboarding to new
Responsible (R): System / HR
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W178_Flow18</bpmn:incoming>
        <bpmn:outgoing>W178_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W178_End11" name="Complete">
        <bpmn:incoming>W178_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W178_Annotation12">
        <bpmn:text>Controls: - CTL-296 (ensure controlled execution — Recruitment &amp; Onboarding (PA-19.1).) | - operational: CHRO review and approval gate
Owner: CHRO</bpmn:text>
      </bpmn:textAnnotation>
