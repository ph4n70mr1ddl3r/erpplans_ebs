    <bpmn:process id="W_W755" name="W755. Store-Level Employee Internal Theft Prevention Awareness &amp; Compliance Daily Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Daily LP operations; monthly awareness topic rotation; new hire onboarding
Frequency: Daily awareness operations; monthly topic focus
Volume: 200 stores × daily awareness touchpoints
Owner: Store Manager (Operations); LP Analyst (Oversight)
Participants: Store Manager, Floor Associates, LP Team, HR
Source: workflow W755 — Store-Level Employee Internal Theft Prevention Awareness &amp; Compliance Daily Operations</bpmn:documentation>
      <bpmn:laneSet id="W755_LaneSet7">
        <bpmn:lane id="W755_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W755_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W755_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W755_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W755_Lane2" name="Department Supervisor">
        <bpmn:flowNodeRef>W755_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W755_Lane3" name="LP Analyst">
        <bpmn:flowNodeRef>W755_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W755_Lane4" name="System">
        <bpmn:flowNodeRef>W755_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W755_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W755_Lane5" name="LP Team">
        <bpmn:flowNodeRef>W755_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W755_Lane6" name="LP Manager">
        <bpmn:flowNodeRef>W755_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W755_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W755_Start8" name="Daily LP operations; monthly awareness topic rotation; new hire onboarding">
        <bpmn:outgoing>W755_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W755_Task9" name="Daily awareness touchpoint — During morning huddle (W739), Store Manager…">
        <bpmn:documentation>Step 1: Daily awareness touchpoint — During morning huddle (W739), Store Manager includes one internal theft prevention tip or reminder: reporting procedures, policy highlights, consequence reminders, or recent case studies (anonymized)
Responsible (R): Store Manager
Accountable (A): —
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W755_Flow20</bpmn:incoming>
        <bpmn:outgoing>W755_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W755_Task10" name="Cash handling compliance verification — Daily: Department Supervisor verifies…">
        <bpmn:documentation>Step 2: Cash handling compliance verification — Daily: Department Supervisor verifies cash handling procedures are followed: (a) only one cashier per drawer (W517), (b) no unauthorized voids (W529), (c) personal purchases processed through separate transaction (W205), (d) no personal bags at register
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W755_Flow21</bpmn:incoming>
        <bpmn:outgoing>W755_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W755_Task11" name="Stockroom access monitoring — Daily: Stockroom access log reviewed for unusual…">
        <bpmn:documentation>Step 3: Stockroom access monitoring — Daily: Stockroom access log reviewed for unusual patterns: (a) access outside scheduled shift, (b) extended dwell time, (c) access by non-authorized personnel
Responsible (R): LP Analyst
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W755_Flow22</bpmn:incoming>
        <bpmn:outgoing>W755_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W755_Task12" name="Employee purchase verification — System flags employee purchases (W205) for…">
        <bpmn:documentation>Step 4: Employee purchase verification — System flags employee purchases (W205) for monthly review: (a) purchases exceeding monthly limit, (b) purchases of items outside normal pattern, (c) purchases during shift with unusual timing
Responsible (R): System / LP Analyst
Accountable (A): —
Duration: Automated + 15 min/week</bpmn:documentation>
        <bpmn:incoming>W755_Flow23</bpmn:incoming>
        <bpmn:outgoing>W755_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W755_Task13" name="Monthly awareness campaign — LP team designs monthly awareness topic: poster…">
        <bpmn:documentation>Step 5: Monthly awareness campaign — LP team designs monthly awareness topic: poster for break room, email to all store associates, quiz for completion; topics rotate through: refund fraud, sweethearting, coupon abuse, merchandise concealment, time theft
Responsible (R): LP Team
Accountable (A): HR
Duration: 4 hours/month design + 5 min/associate for quiz</bpmn:documentation>
        <bpmn:incoming>W755_Flow24</bpmn:incoming>
        <bpmn:outgoing>W755_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W755_Task14" name="Anonymous reporting promotion — Monthly: Store Manager reminds associates of…">
        <bpmn:documentation>Step 6: Anonymous reporting promotion — Monthly: Store Manager reminds associates of anonymous reporting channel (W79 grievance/whistleblower); ensures reporting posters are visible in break room
Responsible (R): Store Manager
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W755_Flow25</bpmn:incoming>
        <bpmn:outgoing>W755_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W755_Task15" name="Monthly compliance scorecard — LP generates monthly internal controls…">
        <bpmn:documentation>Step 7: Monthly compliance scorecard — LP generates monthly internal controls compliance scorecard per store: cash handling compliance rate, stockroom access anomalies, employee purchase flags, awareness quiz completion rate
Responsible (R): System / LP Analyst
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W755_Flow26</bpmn:incoming>
        <bpmn:outgoing>W755_Flow27</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W755_Task16" name="Quarterly LP meeting — Quarterly: LP Manager presents internal theft trends…">
        <bpmn:documentation>Step 8: Quarterly LP meeting — Quarterly: LP Manager presents internal theft trends, case studies, and prevention strategy updates to Store Managers at regional meeting
Responsible (R): LP Manager
Accountable (A): VP Store Operations
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W755_Flow27</bpmn:incoming>
        <bpmn:outgoing>W755_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W755_End17" name="Complete">
        <bpmn:incoming>W755_Flow28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W755_Annotation18">
        <bpmn:text>Controls: - CTL-296 (ensure controlled execution — Recruitment &amp; Onboarding (PA-19.1).) | - operational: Store Manager (Operations); LP Analyst (Oversight) review and approval gate
Owner: Store Manager (Operations); LP Analyst (Oversight)</bpmn:text>
      </bpmn:textAnnotation>
