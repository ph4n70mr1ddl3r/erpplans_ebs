      <bpmn:startEvent id="W179_Start6" name="Annual corporate strategy (10–15 new stores/year growth)">
        <bpmn:outgoing>W179_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W179_Task7" name="Recruitment">
        <bpmn:documentation>Step 1: Recruitment: Campus hiring and assessment centers targeting fresh graduates
Responsible (R): HR Manager
Accountable (A): —
Duration: 2 months</bpmn:documentation>
        <bpmn:incoming>W179_Flow15</bpmn:incoming>
        <bpmn:outgoing>W179_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W179_Task8" name="Orientation">
        <bpmn:documentation>Step 2: Orientation: 1-week corporate orientation at HQ
Responsible (R): L&amp;D Team
Accountable (A): CHRO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W179_Flow16</bpmn:incoming>
        <bpmn:outgoing>W179_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W179_Task9" name="Rotational Training">
        <bpmn:documentation>Step 3: Rotational Training: 6-month rotation through all store departments (Receiving, Sales, Cashier, Operations)
Responsible (R): Trainee
Accountable (A): Store Manager
Duration: 6 months</bpmn:documentation>
        <bpmn:incoming>W179_Flow17</bpmn:incoming>
        <bpmn:outgoing>W179_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W179_Task10" name="Project Assignment">
        <bpmn:documentation>Step 4: Project Assignment: Trainees assigned a &quot;Process Improvement&quot; project in a specific store
Responsible (R): Trainee
Accountable (A): Dept Head
Duration: 2 months</bpmn:documentation>
        <bpmn:incoming>W179_Flow18</bpmn:incoming>
        <bpmn:outgoing>W179_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W179_Task11" name="Graduation &amp; Deployment">
        <bpmn:documentation>Step 5: Graduation &amp; Deployment: Successful trainees deployed as &quot;Assistant Store Managers&quot; or &quot;Department Supervisors&quot; in new stores
Responsible (R): CHRO
Accountable (A): CEO
Duration: —</bpmn:documentation>
        <bpmn:incoming>W179_Flow19</bpmn:incoming>
        <bpmn:outgoing>W179_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W179_End12" name="Complete">
        <bpmn:incoming>W179_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W179_Annotation13">
        <bpmn:text>Controls: - CTL-296 (ensure controlled execution — Recruitment &amp; Onboarding (PA-19.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: CHRO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W179_Assoc14" sourceRef="W179_Annotation13" targetRef="W179_Start6" associationDirection="None" />
