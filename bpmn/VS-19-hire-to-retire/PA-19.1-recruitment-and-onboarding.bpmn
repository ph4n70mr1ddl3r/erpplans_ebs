      <bpmndi:BPMNPlane id="W429_plane" bpmnElement="W_W429">
        <bpmndi:BPMNShape id="W429_Lane1_di" bpmnElement="W429_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
