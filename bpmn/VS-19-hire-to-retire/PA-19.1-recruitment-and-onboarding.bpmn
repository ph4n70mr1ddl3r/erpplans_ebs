    <bpmn:process id="W_W449" name="W449. Promodizer Labor Compliance &amp; DOLE 174 Governance" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly HR Compliance Audit cycle
Frequency: Quarterly
Volume: ~500–1,000 active promodizers across 200 stores
Owner: HR Compliance Manager
Participants: Store Manager, HR Assistant, Legal, Vendor Account Manager
Source: workflow W449 — Promodizer Labor Compliance &amp; DOLE 174 Governance</bpmn:documentation>
      <bpmn:laneSet id="W449_LaneSet3">
        <bpmn:lane id="W449_Lane1" name="HR Compliance Mgr">
        <bpmn:flowNodeRef>W449_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W449_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W449_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W449_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W449_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W449_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W449_Lane2" name="HR Assistant">
        <bpmn:flowNodeRef>W449_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W449_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W449_Start4" name="Quarterly HR Compliance Audit cycle">
        <bpmn:outgoing>W449_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W449_Task5" name="Desk Audit">
        <bpmn:documentation>Step 1: Desk Audit: Review current promodizer list (W269) and vendor service agreements for compliant DOLE-174 clauses
Responsible (R): HR Compliance Mgr
Accountable (A): CHRO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W449_Flow14</bpmn:incoming>
        <bpmn:outgoing>W449_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W449_Task6" name="On-site Observation">
        <bpmn:documentation>Step 2: On-site Observation: Randomly visit stores to observe promodizer activities; ensure they are not performing cashiering, inventory receiving, or store cleaning
Responsible (R): HR Compliance Mgr
Accountable (A): Store Manager
Duration: 4 hours/site</bpmn:documentation>
        <bpmn:incoming>W449_Flow15</bpmn:incoming>
        <bpmn:outgoing>W449_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W449_Task7" name="Interview">
        <bpmn:documentation>Step 3: Interview: Conduct brief interviews with promodizers to confirm they receive instructions from their agency, not BuildRight
Responsible (R): HR Compliance Mgr
Accountable (A): —
Duration: 15 min/person</bpmn:documentation>
        <bpmn:incoming>W449_Flow16</bpmn:incoming>
        <bpmn:outgoing>W449_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W449_Task8" name="Documentation Review">
        <bpmn:documentation>Step 4: Documentation Review: Verify that vendors submit monthly proof of SSS/PhilHealth/Pag-IBIG remittances for their deployed staff
Responsible (R): HR Assistant
Accountable (A): HR Compliance Mgr
Duration: 1 hour/vendor</bpmn:documentation>
        <bpmn:incoming>W449_Flow17</bpmn:incoming>
        <bpmn:outgoing>W449_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W449_Task9" name="Gap Analysis">
        <bpmn:documentation>Step 5: Gap Analysis: Document any &quot;co-employment&quot; risks (e.g., BuildRight managers issuing disciplinary memos to promodizers)
Responsible (R): HR Compliance Mgr
Accountable (A): Legal
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W449_Flow18</bpmn:incoming>
        <bpmn:outgoing>W449_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W449_Task10" name="Remediation">
        <bpmn:documentation>Step 6: Remediation: Issue &quot;Corrective Action Request&quot; to Store Managers or Vendors found in violation of DOLE-174 guidelines
Responsible (R): HR Compliance Mgr
Accountable (A): CHRO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W449_Flow19</bpmn:incoming>
        <bpmn:outgoing>W449_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W449_End11" name="Complete">
        <bpmn:incoming>W449_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W449_Annotation12">
        <bpmn:text>Controls: - CTL-296 (ensure controlled execution — Recruitment &amp; Onboarding (PA-19.1).) | - operational: quarterly DOLE-174 desk audit and on-site observation with corrective-action tracking
Owner: HR Compliance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W449_Assoc13" sourceRef="W449_Annotation12" targetRef="W449_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W449_Flow14" sourceRef="W449_Start4" targetRef="W449_Task5" />
      <bpmn:sequenceFlow id="W449_Flow15" sourceRef="W449_Task5" targetRef="W449_Task6" />
      <bpmn:sequenceFlow id="W449_Flow16" sourceRef="W449_Task6" targetRef="W449_Task7" />
      <bpmn:sequenceFlow id="W449_Flow17" sourceRef="W449_Task7" targetRef="W449_Task8" />
      <bpmn:sequenceFlow id="W449_Flow18" sourceRef="W449_Task8" targetRef="W449_Task9" />
      <bpmn:sequenceFlow id="W449_Flow19" sourceRef="W449_Task9" targetRef="W449_Task10" />
      <bpmn:sequenceFlow id="W449_Flow20" sourceRef="W449_Task10" targetRef="W449_End11" />
    </bpmn:process>
