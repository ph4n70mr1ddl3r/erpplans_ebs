      <bpmn:sequenceFlow id="W647_Flow15" sourceRef="W647_Task4" targetRef="W647_Task5" />
      <bpmn:sequenceFlow id="W647_Flow16" sourceRef="W647_Task5" targetRef="W647_Task6" />
