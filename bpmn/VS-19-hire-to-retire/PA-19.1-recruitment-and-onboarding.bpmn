        <bpmndi:BPMNShape id="W777_Start7_di" bpmnElement="W777_Start7"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W777_End15_di" bpmnElement="W777_End15"><dc:Bounds x="1890" y="827" width="36" height="36" /></bpmndi:BPMNShape>
