        <bpmndi:BPMNEdge id="W512_Flow22_di" bpmnElement="W512_Flow22"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W512_Flow23_di" bpmnElement="W512_Flow23"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W512_Flow24_di" bpmnElement="W512_Flow24"><di:waypoint x="1420" y="335" /><di:waypoint x="1450" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W512_Flow25_di" bpmnElement="W512_Flow25"><di:waypoint x="1630" y="165" /><di:waypoint x="1660" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W512_Flow26_di" bpmnElement="W512_Flow26"><di:waypoint x="1840" y="505" /><di:waypoint x="1870" y="675" /></bpmndi:BPMNEdge>
