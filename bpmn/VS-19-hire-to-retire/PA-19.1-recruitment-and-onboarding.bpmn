      <bpmndi:BPMNPlane id="W994_plane" bpmnElement="W_W994">
        <bpmndi:BPMNShape id="W994_Lane1_di" bpmnElement="W994_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
