      <bpmn:sequenceFlow id="W647_Flow18" sourceRef="W647_Task7" targetRef="W647_Task8" />
      <bpmn:sequenceFlow id="W647_Flow19" sourceRef="W647_Task8" targetRef="W647_Task9" />
      <bpmn:sequenceFlow id="W647_Flow20" sourceRef="W647_Task9" targetRef="W647_Task10" />
      <bpmn:sequenceFlow id="W647_Flow21" sourceRef="W647_Task10" targetRef="W647_End11" />
    </bpmn:process>
