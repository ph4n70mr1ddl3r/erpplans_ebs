    <bpmn:process id="W_W682" name="W682. Employee Career Development &amp; Internal Job Posting Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly internal job posting cycle; employee career development plan review
Frequency: Monthly job posting; quarterly career development review; annual talent review
Volume: ~50–80 internal job postings/year; ~1,200–1,600 external hires/year (internal fill target: 30%)
Owner: HR Business Partner
Participants: Hiring Manager, HR Coordinator, Department Head, Employee
Source: workflow W682 — Employee Career Development &amp; Internal Job Posting Operations</bpmn:documentation>
      <bpmn:laneSet id="W682_LaneSet6">
        <bpmn:lane id="W682_Lane1" name="Hiring Manager">
        <bpmn:flowNodeRef>W682_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W682_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W682_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W682_Lane2" name="HR Coordinator">
        <bpmn:flowNodeRef>W682_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W682_Lane3" name="Employee">
        <bpmn:flowNodeRef>W682_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W682_Lane4" name="HR Business Partner">
        <bpmn:flowNodeRef>W682_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W682_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W682_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W682_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W682_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W682_Lane5" name="HR Manager">
        <bpmn:flowNodeRef>W682_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W682_End18</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W682_Start7" name="Monthly internal job posting cycle; employee career development plan review">
        <bpmn:outgoing>W682_Flow21</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W682_Task8" name="Hiring Manager submits job requisition for open position; HR Coordinator checks…">
        <bpmn:documentation>Step 1: Hiring Manager submits job requisition for open position; HR Coordinator checks if position is eligible for internal posting first per company policy (all non-entry-level positions posted internally for 5 business days before external sourcing)
Responsible (R): Hiring Manager
Accountable (A): HR Coordinator
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W682_Flow21</bpmn:incoming>
        <bpmn:outgoing>W682_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W682_Task9" name="HR Coordinator posts position on internal job board (ERP self-service portal)…">
        <bpmn:documentation>Step 2: HR Coordinator posts position on internal job board (ERP self-service portal): job description, required qualifications, location, department, salary range indication, and application deadline
Responsible (R): HR Coordinator
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W682_Flow22</bpmn:incoming>
        <bpmn:outgoing>W682_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W682_Task10" name="Employee submits internal application with current resume, manager endorsement…">
        <bpmn:documentation>Step 3: Employee submits internal application with current resume, manager endorsement (or confidential application for sensitive situations), and statement of interest
Responsible (R): Employee
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W682_Flow23</bpmn:incoming>
        <bpmn:outgoing>W682_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W682_Task11" name="HR Business Partner screens internal applications: verifies minimum…">
        <bpmn:documentation>Step 4: HR Business Partner screens internal applications: verifies minimum qualifications met, confirms employee is off probation (≥ 6 months in current role), checks performance rating (≥ satisfactory), validates no active disciplinary actions per W603
Responsible (R): HR Business Partner
Accountable (A): —
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W682_Flow24</bpmn:incoming>
        <bpmn:outgoing>W682_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W682_Task12" name="HR Business Partner coordinates interview with Hiring Manager; for cross-entity…">
        <bpmn:documentation>Step 5: HR Business Partner coordinates interview with Hiring Manager; for cross-entity transfers, ensures payroll entity change feasibility per HR-018
Responsible (R): HR Business Partner
Accountable (A): Hiring Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W682_Flow25</bpmn:incoming>
        <bpmn:outgoing>W682_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W682_Task13" name="Hiring Manager interviews internal candidates alongside external candidates (if…">
        <bpmn:documentation>Step 6: Hiring Manager interviews internal candidates alongside external candidates (if external sourcing initiated after internal posting period); gives preference to equally qualified internal candidates per policy
Responsible (R): Hiring Manager
Accountable (A): —
Duration: 1-2 hours per candidate</bpmn:documentation>
        <bpmn:incoming>W682_Flow26</bpmn:incoming>
        <bpmn:outgoing>W682_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W682_Task14" name="If internal candidate selected: HR Business Partner processes transfer per W511…">
        <bpmn:documentation>Step 7: If internal candidate selected: HR Business Partner processes transfer per W511 (cross-entity) or department change; current manager receives 30-day transition period notification; effective date coordinated between departments
Responsible (R): HR Business Partner
Accountable (A): Department Head
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W682_Flow27</bpmn:incoming>
        <bpmn:outgoing>W682_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W682_Task15" name="If internal candidate not selected: HR Business Partner provides constructive…">
        <bpmn:documentation>Step 8: If internal candidate not selected: HR Business Partner provides constructive feedback to employee; suggests development areas per W683 competency assessment; updates career development plan
Responsible (R): HR Business Partner
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W682_Flow28</bpmn:incoming>
        <bpmn:outgoing>W682_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W682_Task16" name="Quarterly: HR Business Partner reviews career development plans for…">
        <bpmn:documentation>Step 9: Quarterly: HR Business Partner reviews career development plans for high-potential employees per W178 succession plan; identifies readiness for promotion; coordinates stretch assignments and cross-training per W567
Responsible (R): HR Business Partner
Accountable (A): Department Head
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W682_Flow29</bpmn:incoming>
        <bpmn:outgoing>W682_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W682_Task17" name="Annual: HR Manager conducts talent review with Department Heads: succession…">
        <bpmn:documentation>Step 10: Annual: HR Manager conducts talent review with Department Heads: succession pipeline strength, internal promotion rate, internal mobility heat map, and career development program effectiveness metrics
Responsible (R): HR Manager
Accountable (A): Department Heads
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W682_Flow30</bpmn:incoming>
        <bpmn:outgoing>W682_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W682_End18" name="Complete">
        <bpmn:incoming>W682_Flow31</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W682_Annotation19">
        <bpmn:text>Controls: - CTL-296 (ensure controlled execution — Recruitment &amp; Onboarding (PA-19.1).) | - operational: HR Business Partner review and approval gate
Owner: HR Business Partner</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W682_Assoc20" sourceRef="W682_Annotation19" targetRef="W682_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W682_Flow21" sourceRef="W682_Start7" targetRef="W682_Task8" />
      <bpmn:sequenceFlow id="W682_Flow22" sourceRef="W682_Task8" targetRef="W682_Task9" />
      <bpmn:sequenceFlow id="W682_Flow23" sourceRef="W682_Task9" targetRef="W682_Task10" />
