    <bpmn:process id="W_W642" name="W642. HMO &amp; Private Benefits Administration" isExecutable="false">
      <bpmn:documentation>Trigger: New hire enrollment (W15); annual renewal; qualifying life event (marriage, birth, dependent change); employee separation (W43)
Frequency: ~100–130 enrollment/changes/month (new hires + events); annual renewal for 6,911 employees
Volume: ~6,911 covered employees + ~2,000 dependents across 5 entities
Owner: HR Benefits Specialist
Participants: HR Business Partner, Employee, HMO Provider Representative, Finance Analyst
Source: workflow W642 — HMO &amp; Private Benefits Administration</bpmn:documentation>
      <bpmn:laneSet id="W642_LaneSet4">
        <bpmn:lane id="W642_Lane1" name="HR Benefits Specialist">
        <bpmn:flowNodeRef>W642_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W642_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W642_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W642_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W642_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W642_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W642_Lane2" name="Finance Analyst">
        <bpmn:flowNodeRef>W642_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W642_Lane3" name="HR Manager">
        <bpmn:flowNodeRef>W642_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W642_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W642_Start5" name="New hire enrollment (W15); annual renewal; qualifying life event (marriage, birth…">
        <bpmn:outgoing>W642_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W642_Task6" name="For new hire enrollment: HR Benefits Specialist enrolls employee in HMO plan…">
        <bpmn:documentation>Step 1: For new hire enrollment: HR Benefits Specialist enrolls employee in HMO plan within 5 business days of onboarding (W15); selects plan tier based on job level (executive, managerial, staff); collects dependent information and supporting documents (marriage certificate, birth certificates)
Responsible (R): HR Benefits Specialist
Accountable (A): HR Manager
Duration: 20 min/employee</bpmn:documentation>
        <bpmn:incoming>W642_Flow16</bpmn:incoming>
        <bpmn:outgoing>W642_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W642_Task7" name="For qualifying life events: Employee submits life event notification within 30…">
        <bpmn:documentation>Step 2: For qualifying life events: Employee submits life event notification within 30 days of event with supporting documentation; HR Benefits Specialist updates enrollment; HMO provider adds/removes dependents
Responsible (R): HR Benefits Specialist
Accountable (A): HR Manager
Duration: 15 min/change</bpmn:documentation>
        <bpmn:incoming>W642_Flow17</bpmn:incoming>
        <bpmn:outgoing>W642_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W642_Task8" name="Monthly: HR Benefits Specialist reconciles HMO enrollment roster against…">
        <bpmn:documentation>Step 3: Monthly: HR Benefits Specialist reconciles HMO enrollment roster against employee master (W292) to identify coverage gaps (un-enrolled new hires, terminated employees still covered)
Responsible (R): HR Benefits Specialist
Accountable (A): HR Manager
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W642_Flow18</bpmn:incoming>
        <bpmn:outgoing>W642_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W642_Task9" name="Monthly: Finance Analyst verifies HMO premium invoice against enrollment roster…">
        <bpmn:documentation>Step 4: Monthly: Finance Analyst verifies HMO premium invoice against enrollment roster and contracted rates; approves for payment
Responsible (R): Finance Analyst
Accountable (A): Finance Manager
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W642_Flow19</bpmn:incoming>
        <bpmn:outgoing>W642_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W642_Task10" name="Quarterly: HR Benefits Specialist compiles HMO utilization report from provider…">
        <bpmn:documentation>Step 5: Quarterly: HR Benefits Specialist compiles HMO utilization report from provider (consultations, hospitalizations, max benefit limit utilization, top conditions); identifies trends and recommendations for plan design changes
Responsible (R): HR Benefits Specialist
Accountable (A): HR Manager
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W642_Flow20</bpmn:incoming>
        <bpmn:outgoing>W642_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W642_Task11" name="Annual renewal: HR Manager negotiates premium rates and plan design with HMO…">
        <bpmn:documentation>Step 6: Annual renewal: HR Manager negotiates premium rates and plan design with HMO provider based on utilization data and market benchmarking; obtains competitive quotes from 2 alternative providers; presents recommendation to CHRO
Responsible (R): HR Manager
Accountable (A): CHRO
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W642_Flow21</bpmn:incoming>
        <bpmn:outgoing>W642_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W642_Task12" name="For separation (W43): HR Benefits Specialist processes HMO coverage termination…">
        <bpmn:documentation>Step 7: For separation (W43): HR Benefits Specialist processes HMO coverage termination effective last day of employment; provides conversion option information to separating employee (individual continuation per HMO policy)
Responsible (R): HR Benefits Specialist
Accountable (A): HR Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W642_Flow22</bpmn:incoming>
        <bpmn:outgoing>W642_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W642_End13" name="Complete">
        <bpmn:incoming>W642_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W642_Annotation14">
        <bpmn:text>Controls: - CTL-296 (ensure controlled execution — Recruitment &amp; Onboarding (PA-19.1).) | - operational: HR Manager approval gate for enrollment changes; monthly roster reconciliation; annual competitive bidding with ≥2 alternative HMO providers | ---
Owner: HR Benefits Specialist</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W642_Assoc15" sourceRef="W642_Annotation14" targetRef="W642_Start5" associationDirection="None" />
