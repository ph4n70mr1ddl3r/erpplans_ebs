    <bpmn:process id="W_W172" name="W172. Employee PPE &amp; Uniform Lifecycle" isExecutable="false">
      <bpmn:documentation>Trigger: New hire onboarding; or periodic replacement schedule; or damage/loss report
Frequency: Annual mass distribution; semi-annual replenishment; ad-hoc for new hires
Volume: ~6,911 employees; ~20,700 sets of uniforms (3 per employee) + safety gear
Owner: HR Operations Manager
Participants: HR Assistant, Store/DC Manager, Procurement, Vendor, Employee
Source: workflow W172 — Employee PPE &amp; Uniform Lifecycle</bpmn:documentation>
      <bpmn:laneSet id="W172_LaneSet3">
        <bpmn:lane id="W172_Lane1" name="HR Assistant">
        <bpmn:flowNodeRef>W172_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W172_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W172_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W172_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W172_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W172_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W172_Lane2" name="HR Ops Mgr">
        <bpmn:flowNodeRef>W172_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W172_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W172_Start4" name="New hire onboarding; or periodic replacement schedule; or damage/loss report">
        <bpmn:outgoing>W172_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W172_Task5" name="Sizing &amp; Allocation">
        <bpmn:documentation>Step 1: Sizing &amp; Allocation: During onboarding (W15), HR Assistant captures employee sizes (shirt, pants, shoes); system assigns standard entitlement (e.g., 3 shirts, 2 pants, 1 pair of safety shoes, 1 helmet)
Responsible (R): HR Assistant
Accountable (A): HR Ops Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W172_Flow14</bpmn:incoming>
        <bpmn:outgoing>W172_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W172_Task6" name="Issuance">
        <bpmn:documentation>Step 2: Issuance: HR Assistant issues gear from store/DC stock; employee signs &quot;Property Acknowledgment&quot; in the system/portal; system links items to employee ID for accountability
Responsible (R): HR Assistant
Accountable (A): Store/DC Mgr
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W172_Flow15</bpmn:incoming>
        <bpmn:outgoing>W172_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W172_Task7" name="Inventory Tracking">
        <bpmn:documentation>Step 3: Inventory Tracking: System tracks PPE/Uniform stock as &quot;Internal Use Inventory&quot;; replenishment triggered via W4 when stock falls below reorder point
Responsible (R): HR Assistant
Accountable (A): Procurement
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W172_Flow16</bpmn:incoming>
        <bpmn:outgoing>W172_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W172_Task8" name="Replacement">
        <bpmn:documentation>Step 4: Replacement: (a) Periodic: Every 12 months, employees are eligible for a new set; (b) Damage: If gear is damaged in the line of duty, employee returns old item for a free replacement; (c) Loss: If lost, employee pays a replacement fee via payroll deduction (W10)
Responsible (R): HR Assistant
Accountable (A): Store/DC Mgr
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W172_Flow17</bpmn:incoming>
        <bpmn:outgoing>W172_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W172_Task9" name="Return at Separation">
        <bpmn:documentation>Step 5: Return at Separation: Upon separation (W43), employee must return all non-consumable gear (helmets, vests, badges); HR Assistant verifies return before final clearance approval
Responsible (R): HR Assistant
Accountable (A): Dept Head
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W172_Flow18</bpmn:incoming>
        <bpmn:outgoing>W172_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W172_Task10" name="Audit">
        <bpmn:documentation>Step 6: Audit: Quarterly: HR Ops Manager audits PPE compliance on the floor (ensuring correct shoes/helmets worn); feeds into W72 Performance Review
Responsible (R): HR Ops Mgr
Accountable (A): Store/DC Mgr
Duration: 2 hours/site</bpmn:documentation>
        <bpmn:incoming>W172_Flow19</bpmn:incoming>
        <bpmn:outgoing>W172_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W172_End11" name="Complete">
        <bpmn:incoming>W172_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W172_Annotation12">
        <bpmn:text>Controls: - CTL-296 (ensure controlled execution — Recruitment &amp; Onboarding (PA-19.1).) | - operational: HR Operations Manager review and approval gate
Owner: HR Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W172_Assoc13" sourceRef="W172_Annotation12" targetRef="W172_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W172_Flow14" sourceRef="W172_Start4" targetRef="W172_Task5" />
      <bpmn:sequenceFlow id="W172_Flow15" sourceRef="W172_Task5" targetRef="W172_Task6" />
      <bpmn:sequenceFlow id="W172_Flow16" sourceRef="W172_Task6" targetRef="W172_Task7" />
      <bpmn:sequenceFlow id="W172_Flow17" sourceRef="W172_Task7" targetRef="W172_Task8" />
      <bpmn:sequenceFlow id="W172_Flow18" sourceRef="W172_Task8" targetRef="W172_Task9" />
      <bpmn:sequenceFlow id="W172_Flow19" sourceRef="W172_Task9" targetRef="W172_Task10" />
      <bpmn:sequenceFlow id="W172_Flow20" sourceRef="W172_Task10" targetRef="W172_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W172_diag">
      <bpmndi:BPMNPlane id="W172_plane" bpmnElement="W_W172">
        <bpmndi:BPMNShape id="W172_Lane1_di" bpmnElement="W172_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
