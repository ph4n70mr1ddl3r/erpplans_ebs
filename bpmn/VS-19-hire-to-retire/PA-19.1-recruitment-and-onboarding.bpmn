        <bpmndi:BPMNShape id="W719_Task9_di" bpmnElement="W719_Task9"><dc:Bounds x="1450" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W719_Task10_di" bpmnElement="W719_Task10"><dc:Bounds x="1660" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W719_Start3_di" bpmnElement="W719_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W719_End11_di" bpmnElement="W719_End11"><dc:Bounds x="1890" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W719_Annotation12_di" bpmnElement="W719_Annotation12"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W719_Flow14_di" bpmnElement="W719_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W719_Flow15_di" bpmnElement="W719_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W719_Flow16_di" bpmnElement="W719_Flow16"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W719_Flow17_di" bpmnElement="W719_Flow17"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W719_Flow18_di" bpmnElement="W719_Flow18"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W719_Flow19_di" bpmnElement="W719_Flow19"><di:waypoint x="1420" y="165" /><di:waypoint x="1450" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W719_Flow20_di" bpmnElement="W719_Flow20"><di:waypoint x="1630" y="165" /><di:waypoint x="1660" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W719_Flow21_di" bpmnElement="W719_Flow21"><di:waypoint x="1840" y="165" /><di:waypoint x="1890" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W719_Assoc13_di" bpmnElement="W719_Assoc13"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W754" name="W754. Store-Level New Hire First-30-Day Performance Check-In &amp; Early Intervention" isExecutable="false">
      <bpmn:documentation>Trigger: New hire completes 7, 15, and 30 days of employment
Frequency: 3 check-ins per new hire within first 30 days
Volume: ~200 new hires chain-wide at any given time (based on annual turnover ~40% × 6,911 employees / 12 months)
Owner: Department Supervisor
Participants: New Hire, Department Supervisor, Store Manager, HR (W15 onboarding)
Source: workflow W754 — Store-Level New Hire First-30-Day Performance Check-In &amp; Early Intervention</bpmn:documentation>
      <bpmn:laneSet id="W754_LaneSet5">
        <bpmn:lane id="W754_Lane1" name="Department Supervisor">
        <bpmn:flowNodeRef>W754_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W754_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W754_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W754_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W754_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W754_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W754_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W754_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W754_Lane3" name="System">
        <bpmn:flowNodeRef>W754_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W754_Lane4" name="HR">
        <bpmn:flowNodeRef>W754_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W754_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W754_Start6" name="New hire completes 7, 15, and 30 days of employment">
        <bpmn:outgoing>W754_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W754_Task7" name="Day-7 check-in — Department Supervisor conducts 15-minute structured check-in…">
        <bpmn:documentation>Step 1: Day-7 check-in — Department Supervisor conducts 15-minute structured check-in: (a) comfort with POS systems, (b) product knowledge assessment for assigned department, (c) integration with team, (d) any concerns or questions; Supervisor rates confidence level (1–5)
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W754_Flow18</bpmn:incoming>
        <bpmn:outgoing>W754_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W754_Task8" name="Day-7 intervention trigger — If confidence rating ≤ 2 in any area: Supervisor…">
        <bpmn:documentation>Step 2: Day-7 intervention trigger — If confidence rating ≤ 2 in any area: Supervisor creates targeted support plan: additional shadow shifts with buddy (W609), focused product training (W51), or schedule adjustment
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W754_Flow19</bpmn:incoming>
        <bpmn:outgoing>W754_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W754_Task9" name="Day-15 check-in — Department Supervisor conducts 20-minute check-in: (a) sales…">
        <bpmn:documentation>Step 3: Day-15 check-in — Department Supervisor conducts 20-minute check-in: (a) sales performance vs. peer benchmark, (b) customer interaction quality, (c) attendance and punctuality record (W561), (d) progress on Day-7 support plan (if any); rates overall progress (On Track / Needs Support / At Risk)
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W754_Flow20</bpmn:incoming>
        <bpmn:outgoing>W754_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W754_Task10" name="Day-15 intervention — If &quot;At Risk&quot;: Store Manager conducts 1-on-1 with new…">
        <bpmn:documentation>Step 4: Day-15 intervention — If &quot;At Risk&quot;: Store Manager conducts 1-on-1 with new hire; develops Performance Improvement Plan (PIP) with specific, measurable goals for next 15 days; HR notified
Responsible (R): Store Manager
Accountable (A): HR
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W754_Flow21</bpmn:incoming>
        <bpmn:outgoing>W754_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W754_Task11" name="Day-30 check-in — Store Manager conducts 30-minute comprehensive review: (a)…">
        <bpmn:documentation>Step 5: Day-30 check-in — Store Manager conducts 30-minute comprehensive review: (a) performance metrics vs. department standards, (b) cross-training progress (W567), (c) cultural fit and teamwork, (d) career interests; rates: Proceed to Regular / Extend Probation / Separate
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W754_Flow22</bpmn:incoming>
        <bpmn:outgoing>W754_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W754_Task12" name="Probation completion recommendation — Store Manager records recommendation in…">
        <bpmn:documentation>Step 6: Probation completion recommendation — Store Manager records recommendation in system with supporting evidence; HR reviews for DOLE compliance (probationary employment rules per Labor Code)
Responsible (R): Store Manager
Accountable (A): HR
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W754_Flow23</bpmn:incoming>
        <bpmn:outgoing>W754_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W754_Task13" name="Data analytics — System aggregates first-30-day outcomes: pass rate by…">
        <bpmn:documentation>Step 7: Data analytics — System aggregates first-30-day outcomes: pass rate by department, by store, by hiring source, by training approach; HR uses data to optimize W15 onboarding and W34 scheduling practices
Responsible (R): System / HR
Accountable (A): HR
Duration: Automated + 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W754_Flow24</bpmn:incoming>
        <bpmn:outgoing>W754_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W754_Task14" name="Exit interview trigger — If separation during first 30 days: mandatory…">
        <bpmn:documentation>Step 8: Exit interview trigger — If separation during first 30 days: mandatory early-exit interview (distinct from W628) focused on onboarding experience; data feeds W15 onboarding improvement
Responsible (R): HR
Accountable (A): Store Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W754_Flow25</bpmn:incoming>
        <bpmn:outgoing>W754_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W754_End15" name="Complete">
        <bpmn:incoming>W754_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W754_Annotation16">
        <bpmn:text>Controls: - CTL-296 (ensure controlled execution — Recruitment &amp; Onboarding (PA-19.1).) | - operational: enforcement (mandatory check-in before timesheet approval) may be needed
Owner: Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W754_Assoc17" sourceRef="W754_Annotation16" targetRef="W754_Start6" associationDirection="None" />
