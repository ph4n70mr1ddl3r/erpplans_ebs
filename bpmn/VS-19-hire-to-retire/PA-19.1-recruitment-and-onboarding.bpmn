    <bpmn:process id="W_W646" name="W646. HR Service Desk Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Employee inquiry or request received via any channel (walk-in, phone, email, chat, self-service ticket)
Frequency: ~400–600 inquiries/week across all entities (~20,000–30,000/year)
Volume: ~80–120 per day
Owner: HR Service Desk Lead
Participants: HR Assistant (Tier 1), HR Business Partner (Tier 2), HR Manager (Tier 3), Employee (inquirer)
Source: workflow W646 — HR Service Desk Operations</bpmn:documentation>
      <bpmn:laneSet id="W646_LaneSet5">
        <bpmn:lane id="W646_Lane1" name="HR Assistant">
        <bpmn:flowNodeRef>W646_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W646_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W646_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W646_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W646_Lane2" name="HR Business Partner">
        <bpmn:flowNodeRef>W646_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W646_Lane3" name="HR Manager">
        <bpmn:flowNodeRef>W646_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W646_Lane4" name="HR Service Desk Lead">
        <bpmn:flowNodeRef>W646_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W646_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W646_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W646_Start6" name="Employee inquiry or request received via any channel (walk-in, phone, email, chat…">
        <bpmn:outgoing>W646_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W646_Task7" name="HR Assistant receives and logs inquiry in HR ticketing system; classifies by…">
        <bpmn:documentation>Step 1: HR Assistant receives and logs inquiry in HR ticketing system; classifies by category (policy question, benefit inquiry, payroll concern, leave issue, document request, complaint, other) and entity; assigns priority (standard: 3-day SLA, urgent: 1-day SLA, emergency: 4-hour SLA)
Responsible (R): HR Assistant
Accountable (A): HR Service Desk Lead
Duration: 5 min/ticket</bpmn:documentation>
        <bpmn:incoming>W646_Flow17</bpmn:incoming>
        <bpmn:outgoing>W646_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W646_Task8" name="HR Assistant resolves Tier 1 inquiries from knowledge base: standard policy…">
        <bpmn:documentation>Step 2: HR Assistant resolves Tier 1 inquiries from knowledge base: standard policy questions, FAQ responses, document request fulfillment (COE per W43, employment verification, payslip reprint), leave balance inquiry, benefit coverage inquiry
Responsible (R): HR Assistant
Accountable (A): HR Service Desk Lead
Duration: 10–20 min/ticket</bpmn:documentation>
        <bpmn:incoming>W646_Flow18</bpmn:incoming>
        <bpmn:outgoing>W646_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W646_Task9" name="For Tier 1 resolution: HR Assistant closes ticket with resolution notes and…">
        <bpmn:documentation>Step 3: For Tier 1 resolution: HR Assistant closes ticket with resolution notes and sends satisfaction survey to employee
Responsible (R): HR Assistant
Accountable (A): HR Service Desk Lead
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W646_Flow19</bpmn:incoming>
        <bpmn:outgoing>W646_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W646_Task10" name="For Tier 2 escalation (complex benefit claims, payroll discrepancies, policy…">
        <bpmn:documentation>Step 4: For Tier 2 escalation (complex benefit claims, payroll discrepancies, policy interpretation, leave disputes): HR Business Partner investigates and resolves within category SLA
Responsible (R): HR Business Partner
Accountable (A): HR Manager
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W646_Flow20</bpmn:incoming>
        <bpmn:outgoing>W646_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W646_Task11" name="For Tier 3 escalation (complaints, disciplinary matters, union grievances…">
        <bpmn:documentation>Step 5: For Tier 3 escalation (complaints, disciplinary matters, union grievances, legal inquiries): HR Manager handles per relevant policy; coordinates with Legal (W125) or Compliance (W79) as needed
Responsible (R): HR Manager
Accountable (A): CHRO
Duration: 3–10 days</bpmn:documentation>
        <bpmn:incoming>W646_Flow21</bpmn:incoming>
        <bpmn:outgoing>W646_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W646_Task12" name="Weekly: HR Service Desk Lead reviews ticket analytics: volume by category and…">
        <bpmn:documentation>Step 6: Weekly: HR Service Desk Lead reviews ticket analytics: volume by category and entity, SLA compliance rate, average resolution time, escalation rate, employee satisfaction score, knowledge base gaps
Responsible (R): HR Service Desk Lead
Accountable (A): HR Manager
Duration: 2 hours/week</bpmn:documentation>
        <bpmn:incoming>W646_Flow22</bpmn:incoming>
        <bpmn:outgoing>W646_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W646_Task13" name="Monthly: HR Service Desk Lead updates knowledge base with new FAQs, policy…">
        <bpmn:documentation>Step 7: Monthly: HR Service Desk Lead updates knowledge base with new FAQs, policy changes, and resolution patterns; identifies training needs for Tier 1 staff
Responsible (R): HR Service Desk Lead
Accountable (A): HR Manager
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W646_Flow23</bpmn:incoming>
        <bpmn:outgoing>W646_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W646_End14" name="Complete">
        <bpmn:incoming>W646_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W646_Annotation15">
        <bpmn:text>Controls: - CTL-296 (ensure controlled execution — Recruitment &amp; Onboarding (PA-19.1).) | - operational: HR Service Desk Lead weekly ticket audit; satisfaction-survey feedback loop; knowledge-base review and approval gate before publication | ---
Owner: HR Service Desk Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W646_Assoc16" sourceRef="W646_Annotation15" targetRef="W646_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W646_Flow17" sourceRef="W646_Start6" targetRef="W646_Task7" />
