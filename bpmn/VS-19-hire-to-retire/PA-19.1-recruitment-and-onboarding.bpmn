    <bpmn:process id="W_W269" name="W269. Vendor Promodizer &amp; Third-Party Staff Management" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor assigns a promodizer to a specific store location.
Frequency: Daily / As needed
Volume: 2-10 promodizers per store
Owner: Store Manager
Participants: Promodizer, Vendor Account Manager, Store Admin
Source: workflow W269 — Vendor Promodizer &amp; Third-Party Staff Management</bpmn:documentation>
      <bpmn:laneSet id="W269_LaneSet6">
        <bpmn:lane id="W269_Lane1" name="Vendor Account Mgr">
        <bpmn:flowNodeRef>W269_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W269_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W269_Lane2" name="Store Admin">
        <bpmn:flowNodeRef>W269_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
