      <bpmn:sequenceFlow id="W15_Flow32" sourceRef="W15_Task17" targetRef="W15_Task18" />
      <bpmn:sequenceFlow id="W15_Flow33" sourceRef="W15_Task18" targetRef="W15_Task19" />
      <bpmn:sequenceFlow id="W15_Flow34" sourceRef="W15_Task19" targetRef="W15_Task20" />
      <bpmn:sequenceFlow id="W15_Flow35" sourceRef="W15_Task20" targetRef="W15_End21" />
    </bpmn:process>
