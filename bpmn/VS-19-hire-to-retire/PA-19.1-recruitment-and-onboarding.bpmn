        <bpmndi:BPMNEdge id="W994_Flow20_di" bpmnElement="W994_Flow20"><di:waypoint x="1210" y="675" /><di:waypoint x="1240" y="845" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W994_Flow21_di" bpmnElement="W994_Flow21"><di:waypoint x="1420" y="845" /><di:waypoint x="1470" y="845" /></bpmndi:BPMNEdge>
