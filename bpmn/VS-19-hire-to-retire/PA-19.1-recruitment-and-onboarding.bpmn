      <bpmndi:BPMNPlane id="W717_plane" bpmnElement="W_W717">
        <bpmndi:BPMNShape id="W717_Lane1_di" bpmnElement="W717_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2000" height="170" /></bpmndi:BPMNShape>
