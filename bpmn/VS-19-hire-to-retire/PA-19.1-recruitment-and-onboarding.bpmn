    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W555" name="W555. Seasonal &amp; Temporary Staffing Process" isExecutable="false">
      <bpmn:documentation>Trigger: Seasonal peak forecast (Christmas October–January, summer March–May, back-to-school May–June); new store opening schedule; or special event staffing need
Frequency: 2–3 major seasonal peaks per year plus ad-hoc store openings (~10–15 new stores/year)
Volume: ~500–800 seasonal hires per Christmas peak across 200 stores; ~50–80 per new store opening
Owner: HR Business Partner / Store Manager (store-level coordination)
Participants: HR Business Partner, Recruitment Specialist, Store Manager (A/C), CHRO (A for policy), Payroll Specialist (I), Training Coordinator (C)
Source: workflow W555 — Seasonal &amp; Temporary Staffing Process</bpmn:documentation>
      <bpmn:laneSet id="W555_LaneSet6">
        <bpmn:lane id="W555_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W555_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W555_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W555_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W555_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W555_Lane2" name="HR Business Partner">
        <bpmn:flowNodeRef>W555_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W555_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W555_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W555_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W555_Task19</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W555_Lane3" name="Recruitment Specialist">
        <bpmn:flowNodeRef>W555_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W555_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W555_Lane4" name="Training Coordinator">
        <bpmn:flowNodeRef>W555_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W555_Lane5" name="Payroll Specialist">
        <bpmn:flowNodeRef>W555_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W555_End20</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W555_Start7" name="Seasonal peak forecast (Christmas October–January, summer March–May, back-to-school…">
        <bpmn:outgoing>W555_Flow23</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W555_Task8" name="Store Manager submits seasonal staffing request to HR: headcount by role (sales…">
        <bpmn:documentation>Step 1: Store Manager submits seasonal staffing request to HR: headcount by role (sales associate, cashier, stockroom), start and end dates, justification (seasonal peak, new store opening, special event), budget impact estimate
Responsible (R): Store Manager
Accountable (A): HR Business Partner
Duration: 30 min/request</bpmn:documentation>
        <bpmn:incoming>W555_Flow23</bpmn:incoming>
        <bpmn:outgoing>W555_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W555_Task9" name="HR Business Partner validates request against seasonal demand forecast (W31)…">
        <bpmn:documentation>Step 2: HR Business Partner validates request against seasonal demand forecast (W31) and historical staffing data (previous year&#x27;s seasonal headcount, sales-per-employee ratios, customer traffic patterns); confirms or adjusts headcount
Responsible (R): HR Business Partner
Accountable (A): CHRO
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W555_Flow24</bpmn:incoming>
        <bpmn:outgoing>W555_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W555_Task10" name="HR classifies employment type per Labor Code Arts. 295–296: (a) seasonal…">
        <bpmn:documentation>Step 3: HR classifies employment type per Labor Code Arts. 295–296: (a) seasonal employment — recurring seasonal work (Christmas, summer) with expected recall next season; (b) project employment — fixed-term for specific project (new store opening); (c) probationary employment — if there is intent for permanent employment after probationary period; classification determines statutory benefits, termination rules, and documentation requirements
Responsible (R): HR Business Partner
Accountable (A): CHRO
Duration: 15 min/request</bpmn:documentation>
        <bpmn:incoming>W555_Flow25</bpmn:incoming>
        <bpmn:outgoing>W555_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W555_Task11" name="Abbreviated recruitment: HR posts job listing (store-level bulletin, local…">
        <bpmn:documentation>Step 4: Abbreviated recruitment: HR posts job listing (store-level bulletin, local barangay, social media, job boards); conducts 1-round interview (vs. 3 rounds for permanent per W15) focused on availability, physical capability, basic customer service aptitude; performs reference check (1 reference vs. 3 for permanent); recruitment cycle target: 5–7 days (vs. 21 days for permanent)
Responsible (R): Recruitment Specialist
Accountable (A): HR Business Partner
Duration: 5–7 days elapsed</bpmn:documentation>
        <bpmn:incoming>W555_Flow26</bpmn:incoming>
        <bpmn:outgoing>W555_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W555_Task12" name="Pre-employment requirements: SSS/PhilHealth/Pag-IBIG registration for new…">
        <bpmn:documentation>Step 5: Pre-employment requirements: SSS/PhilHealth/Pag-IBIG registration for new workers or re-activation for returning seasonal workers (system checks employee master for previous employment record); medical clearance (basic physical for manual roles); NBI clearance (or barangay clearance as alternative in provincial areas where NBI processing exceeds 5 days)
Responsible (R): Recruitment Specialist
Accountable (A): HR Business Partner
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W555_Flow27</bpmn:incoming>
        <bpmn:outgoing>W555_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W555_Task13" name="Abbreviated onboarding (1 day vs. 3 days for permanent): (a) store tour and…">
        <bpmn:documentation>Step 6: Abbreviated onboarding (1 day vs. 3 days for permanent): (a) store tour and department layout; (b) safety briefing — emergency exits, fire extinguisher locations, first aid kit, hazard reporting per W512; (c) POS basics — log-in, item lookup, tender types, void transaction per W1; (d) department-specific product knowledge — top 50 SKUs, basic customer scenarios; (e) HR policies — attendance rules, dress code, code of conduct, anti-sexual harassment policy
Responsible (R): Training Coordinator / Store Manager
Accountable (A): HR Business Partner
Duration: 1 day (8 hours)</bpmn:documentation>
        <bpmn:incoming>W555_Flow28</bpmn:incoming>
        <bpmn:outgoing>W555_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W555_Task14" name="Payroll setup with correct employment classification: seasonal employment…">
        <bpmn:documentation>Step 7: Payroll setup with correct employment classification: seasonal employment status in HR master, statutory deduction enrollment (SSS, PhilHealth, Pag-IBIG, withholding tax per TRAIN law), pro-rated 13th month pay accrual activated; Payroll Specialist confirms setup per W10 requirements
Responsible (R): Payroll Specialist
Accountable (A): HR Business Partner
Duration: 15 min/employee</bpmn:documentation>
        <bpmn:incoming>W555_Flow29</bpmn:incoming>
        <bpmn:outgoing>W555_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W555_Task15" name="Shift assignment per W34 scheduling with seasonal shift patterns: Store Manager…">
        <bpmn:documentation>Step 8: Shift assignment per W34 scheduling with seasonal shift patterns: Store Manager assigns seasonal workers to high-traffic shifts (weekends, payday weekends, holiday rush); biometric enrollment (HR-005) for time &amp; attendance; system ensures seasonal workers are scheduled within legal working hour limits (8 hours/day, 40 hours/week per Labor Code)
Responsible (R): Store Manager
Accountable (A): HR Business Partner
Duration: 30 min/employee</bpmn:documentation>
        <bpmn:incoming>W555_Flow30</bpmn:incoming>
        <bpmn:outgoing>W555_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W555_Task16" name="Mid-season performance check (at ~60% of seasonal employment period): Store…">
        <bpmn:documentation>Step 9: Mid-season performance check (at ~60% of seasonal employment period): Store Manager conducts brief performance review — customer service quality, attendance record, POS accuracy, teamwork; for underperformers: additional coaching or early termination per Labor Code Art. 297 just-cause provisions; for top performers: flag for potential permanent employment conversion or returning worker priority
Responsible (R): Store Manager
Accountable (A): HR Business Partner
Duration: 15 min/employee</bpmn:documentation>
        <bpmn:incoming>W555_Flow31</bpmn:incoming>
        <bpmn:outgoing>W555_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W555_Task17" name="Pre-end-of-season offboarding plan (2 weeks before seasonal end date): HR…">
        <bpmn:documentation>Step 10: Pre-end-of-season offboarding plan (2 weeks before seasonal end date): HR Business Partner prepares offboarding checklist — last payroll computation including pro-rated 13th month pay (1/12 × monthly basic salary × months worked), certificate of employment issuance, return of uniforms/PPE per W172, SSS/PhilHealth/Pag-IBIG final reporting
Responsible (R): HR Business Partner
Accountable (A): CHRO
Duration: 30 min/batch</bpmn:documentation>
        <bpmn:incoming>W555_Flow32</bpmn:incoming>
        <bpmn:outgoing>W555_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W555_Task18" name="End-of-season offboarding execution (abbreviated W43 — no garden leave, no…">
        <bpmn:documentation>Step 11: End-of-season offboarding execution (abbreviated W43 — no garden leave, no knowledge transfer, no exit interview required for seasonal workers): final clearance sign-off by Store Manager (uniform returned, no pending cash accountability); final payslip generated; certificate of employment issued; system updates employment status to &quot;separated — end of seasonal engagement&quot;
Responsible (R): HR Business Partner / Store Manager
Accountable (A): CHRO
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W555_Flow33</bpmn:incoming>
        <bpmn:outgoing>W555_Flow34</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W555_Task19" name="Returning seasonal worker database update: system flags separated seasonal…">
        <bpmn:documentation>Step 12: Returning seasonal worker database update: system flags separated seasonal workers as eligible for re-hire next season; stores performance rating and re-hire eligibility (eligible / not eligible / eligible with conditions); next season recruitment priority: returning eligible workers contacted first (re-activation of SSS/PhilHealth/Pag-IBIG only, no repeat NBI clearance if within 12 months)
Responsible (R): HR Business Partner
Accountable (A): CHRO
Duration: 15 min/employee</bpmn:documentation>
        <bpmn:incoming>W555_Flow34</bpmn:incoming>
        <bpmn:outgoing>W555_Flow35</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W555_End20" name="Complete">
        <bpmn:incoming>W555_Flow35</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W555_Annotation21">
        <bpmn:text>Controls: - CTL-296 (ensure controlled execution — Recruitment &amp; Onboarding (PA-19.1).) | - operational: pre-season batch re-activation; operational: system-enforced end date tracking with 30-day advance warning; operational: early recruitment (August–September for Christmas) and returning worker priority
Owner: HR Business Partner / Store Manager (store-level coordination)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W555_Assoc22" sourceRef="W555_Annotation21" targetRef="W555_Start7" associationDirection="None" />
