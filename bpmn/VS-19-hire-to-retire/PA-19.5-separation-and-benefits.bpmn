      <bpmn:sequenceFlow id="W1384_Flow19" sourceRef="W1384_Task8" targetRef="W1384_Task9" />
      <bpmn:sequenceFlow id="W1384_Flow20" sourceRef="W1384_Task9" targetRef="W1384_Task10" />
      <bpmn:sequenceFlow id="W1384_Flow21" sourceRef="W1384_Task10" targetRef="W1384_Task11" />
      <bpmn:sequenceFlow id="W1384_Flow22" sourceRef="W1384_Task11" targetRef="W1384_Task12" />
      <bpmn:sequenceFlow id="W1384_Flow23" sourceRef="W1384_Task12" targetRef="W1384_Task13" />
      <bpmn:sequenceFlow id="W1384_Flow24" sourceRef="W1384_Task13" targetRef="W1384_End14" />
    </bpmn:process>
