    <bpmn:process id="W_W1383" name="W1383. Employee Resignation Processing, Clearance &amp; Final Pay Computation (Philippine Labor Code)" isExecutable="false">
      <bpmn:documentation>Trigger: Employee submits written resignation letter (30-day notice per Philippine Labor Code, Article 300) or initiates resignation via HR self-service portal
Frequency: ~60–80 resignations/month across all entities (based on ~15% annual turnover rate × ~5,800 employees ÷ 12)
Volume: ~720–960 resignations/year
Owner: HR Specialist (HR Operations)
Participants: HR Specialist, HR Manager, resigned employee, Department Manager, IT, Finance, Store Manager (if store-based)
Source: workflow W1383 — Employee Resignation Processing, Clearance &amp; Final Pay Computation (Philippine Labor Code)</bpmn:documentation>
      <bpmn:laneSet id="W1383_LaneSet6">
        <bpmn:lane id="W1383_Lane1" name="Employee">
        <bpmn:flowNodeRef>W1383_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1383_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1383_Lane2" name="Department Manager">
        <bpmn:flowNodeRef>W1383_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1383_Lane3" name="HR Specialist">
        <bpmn:flowNodeRef>W1383_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1383_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1383_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1383_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1383_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1383_Lane4" name="HR Manager">
        <bpmn:flowNodeRef>W1383_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1383_Lane5" name="Payroll">
        <bpmn:flowNodeRef>W1383_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1383_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1383_Start7" name="Employee submits written resignation letter (30-day notice per Philippine Labor Code…">
        <bpmn:outgoing>W1383_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1383_Task8" name="Employee submits resignation letter to immediate supervisor and HR; HR…">
        <bpmn:documentation>Step 1: Employee submits resignation letter to immediate supervisor and HR; HR Specialist logs resignation in HRIS with: employee name, ID, department, position, entity, resignation reason, effective date (last working day), date of notice; system calculates required 30-day notice period and validates effective date
Responsible (R): Employee / HR Specialist
Accountable (A): HR Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1383_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1383_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1383_Task9" name="Department Manager conducts retention discussion: (a) for high-performing…">
        <bpmn:documentation>Step 2: Department Manager conducts retention discussion: (a) for high-performing employees, Manager may offer counter-offer (salary increase, promotion, transfer); (b) for store-based employees, Store Manager coordinates with HR; (c) if counter-offer accepted, HR cancels resignation in HRIS; if declined, proceed to clearance
Responsible (R): Department Manager
Accountable (A): HR Manager
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W1383_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1383_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1383_Task10" name="IT">
        <bpmn:documentation>Step 3: HR Specialist initiates clearance process 2 weeks before last day: system generates clearance checklist customized by employee type — (a) IT: return laptop, mobile phone, VPN tokens; deprovision email, ERP access, POS access; (b) Finance: liquidate all cash advances, petty cash fund, travel expense reports; clear outstanding loans or salary advance balances; (c) HR: return company ID, uniforms, locker key; complete exit interview (W628); confirm 13th month pay status; (d) Department Manager: hand over work assignments, files, and ongoing projects; confirm no pending disciplinary cases; (e) Store Manager (if store-based): return keys, access cards, alarm codes; confirm no outstanding store-level accountability (cash variance, inventory shortage)
Responsible (R): HR Specialist
Accountable (A): HR Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1383_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1383_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1383_Task11" name="Each clearance sign-off is recorded in HRIS with approver name, date, and…">
        <bpmn:documentation>Step 4: Each clearance sign-off is recorded in HRIS with approver name, date, and status; system tracks outstanding clearance items; HR Specialist follows up daily on pending items
Responsible (R): HR Specialist / Clearing Officers
Accountable (A): HR Manager
Duration: 5 min/day</bpmn:documentation>
        <bpmn:incoming>W1383_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1383_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1383_Task12" name="Final pay computation">
        <bpmn:documentation>Step 5: Final pay computation (within 5 business days of last day): HR/Payroll computes: (a) Unpaid salary: pro-rated salary from last payroll cutoff to last working day; (b) Unused vacation leave (SL/VL): Philippine law does not require conversion of unused sick leave; unused service incentive leave (SIL — 5 days/year after 1 year of service) is convertible to cash; company policy may provide additional vacation leave conversion; (c) 13th month pay: pro-rated from January to last month of employment (see W1384); (d) Tax withholdings: final withholding tax computed using graduated tax table; prior year-to-date compensation considered; (e) SSS, PhilHealth, Pag-IBIG deductions: final month contributions computed; (f) Less deductions: unliquidated cash advances, outstanding loans, unpaid cash bond (if applicable), shortage/damage accountability (if any, per store clearance), withheld amount for unrendered 30-day notice (if applicable per company policy); (g) Net final pay = (a + b + c) − (d + e + f)
Responsible (R): HR Specialist / Payroll
Accountable (A): HR Manager
Duration: 30 min/employee</bpmn:documentation>
        <bpmn:incoming>W1383_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1383_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1383_Task13" name="HR Manager reviews and approves final pay computation; Finance Manager approves…">
        <bpmn:documentation>Step 6: HR Manager reviews and approves final pay computation; Finance Manager approves final pay release for amounts &gt; PHP 100,000
Responsible (R): HR Manager / Finance Manager
Accountable (A): CHRO
Duration: 10 min/employee</bpmn:documentation>
        <bpmn:incoming>W1383_Flow25</bpmn:incoming>
        <bpmn:outgoing>W1383_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1383_Task14" name="Payroll processes final pay: (a) if clearance complete and no pending items —…">
        <bpmn:documentation>Step 7: Payroll processes final pay: (a) if clearance complete and no pending items — release final pay via bank transfer on next payroll run or within 30 days of last day (per DOLE Advisory); (b) if clearance incomplete — final pay is held until all clearance items resolved; (c) system posts final pay through the W10.9 costing chain: Dr. Salary Expense / Cr. Cash; Dr. Final Pay Liability / Cr. Cash
Responsible (R): Payroll
Accountable (A): Finance Manager
Duration: 5 min/employee</bpmn:documentation>
        <bpmn:incoming>W1383_Flow26</bpmn:incoming>
        <bpmn:outgoing>W1383_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1383_Task15" name="HR Specialist issues Certificate of Employment (COE) per DOLE requirement — COE…">
        <bpmn:documentation>Step 8: HR Specialist issues Certificate of Employment (COE) per DOLE requirement — COE must state dates of employment and position(s) held; COE issued within 3 days of request per Labor Code; system generates COE template with employee data
Responsible (R): HR Specialist
Accountable (A): —
Duration: 5 min/employee</bpmn:documentation>
        <bpmn:incoming>W1383_Flow27</bpmn:incoming>
        <bpmn:outgoing>W1383_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1383_Task16" name="30-day compliance tracking">
        <bpmn:documentation>Step 9: 30-day compliance tracking: HR Specialist monitors that all final pays are released within 30 days of last working day per DOLE Advisory; if delayed due to pending clearance, HR documents reason and follows up daily; unresolved final pay delays escalated to CHRO
Responsible (R): HR Specialist
Accountable (A): CHRO
Duration: 15 min/week</bpmn:documentation>
        <bpmn:incoming>W1383_Flow28</bpmn:incoming>
        <bpmn:outgoing>W1383_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1383_End17" name="Complete">
        <bpmn:incoming>W1383_Flow29</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1383_Annotation18">
        <bpmn:text>Controls: - CTL-300 (ensure controlled execution — Separation &amp; Benefits (PA-19.5).) | - operational: HR Specialist (HR Operations) review and approval gate
Owner: HR Specialist (HR Operations)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1383_Assoc19" sourceRef="W1383_Annotation18" targetRef="W1383_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W1383_Flow20" sourceRef="W1383_Start7" targetRef="W1383_Task8" />
      <bpmn:sequenceFlow id="W1383_Flow21" sourceRef="W1383_Task8" targetRef="W1383_Task9" />
      <bpmn:sequenceFlow id="W1383_Flow22" sourceRef="W1383_Task9" targetRef="W1383_Task10" />
      <bpmn:sequenceFlow id="W1383_Flow23" sourceRef="W1383_Task10" targetRef="W1383_Task11" />
      <bpmn:sequenceFlow id="W1383_Flow24" sourceRef="W1383_Task11" targetRef="W1383_Task12" />
      <bpmn:sequenceFlow id="W1383_Flow25" sourceRef="W1383_Task12" targetRef="W1383_Task13" />
      <bpmn:sequenceFlow id="W1383_Flow26" sourceRef="W1383_Task13" targetRef="W1383_Task14" />
      <bpmn:sequenceFlow id="W1383_Flow27" sourceRef="W1383_Task14" targetRef="W1383_Task15" />
      <bpmn:sequenceFlow id="W1383_Flow28" sourceRef="W1383_Task15" targetRef="W1383_Task16" />
      <bpmn:sequenceFlow id="W1383_Flow29" sourceRef="W1383_Task16" targetRef="W1383_End17" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1383_diag">
      <bpmndi:BPMNPlane id="W1383_plane" bpmnElement="W_W1383">
        <bpmndi:BPMNShape id="W1383_Lane1_di" bpmnElement="W1383_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2210" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1383_Lane2_di" bpmnElement="W1383_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="2210" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1383_Lane3_di" bpmnElement="W1383_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="2210" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1383_Lane4_di" bpmnElement="W1383_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="2210" height="170" /></bpmndi:BPMNShape>
