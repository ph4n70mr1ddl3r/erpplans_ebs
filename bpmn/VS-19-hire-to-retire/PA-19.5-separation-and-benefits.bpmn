      <bpmn:sequenceFlow id="W977_Flow17" sourceRef="W977_Task8" targetRef="W977_Task9" />
      <bpmn:sequenceFlow id="W977_Flow18" sourceRef="W977_Task9" targetRef="W977_Task10" />
      <bpmn:sequenceFlow id="W977_Flow19" sourceRef="W977_Task10" targetRef="W977_Task11" />
      <bpmn:sequenceFlow id="W977_Flow20" sourceRef="W977_Task11" targetRef="W977_End12" />
    </bpmn:process>
