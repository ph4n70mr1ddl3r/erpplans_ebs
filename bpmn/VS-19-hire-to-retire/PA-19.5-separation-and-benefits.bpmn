<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-19.5-separation-and-benefits" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W43" name="W43. Employee Separation &amp; Offboarding" isExecutable="false">
      <bpmn:documentation>Trigger: Employee submits resignation, or management initiates termination, or employee retires
Frequency: ~100–130 separations/month (1,200–1,600/year at 15–20% annual turnover)
Volume: Peaks in January (post-13th month pay resignations) and during store opening months (transfer to new store vs. separation)
Owner: HR Assistant
Participants: HR Assistant, HR Head, Department Head, Payroll Officer, IT, Employee
Source: workflow W43 — Employee Separation &amp; Offboarding</bpmn:documentation>
      <bpmn:laneSet id="W43_LaneSet10">
        <bpmn:lane id="W43_Lane1" name="Employee">
        <bpmn:flowNodeRef>W43_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W43_Start11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W43_Lane2" name="HR Assistant">
        <bpmn:flowNodeRef>W43_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W43_Task20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W43_Task26</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W43_Lane3" name="Dept. Head">
        <bpmn:flowNodeRef>W43_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W43_Task17</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W43_Lane4" name="System">
        <bpmn:flowNodeRef>W43_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W43_Task22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W43_Task23</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W43_Task24</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W43_Lane5" name="IT Team">
        <bpmn:flowNodeRef>W43_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W43_Lane6" name="AP">
        <bpmn:flowNodeRef>W43_Task18</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W43_Lane7" name="Store Manager">
        <bpmn:flowNodeRef>W43_Task19</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W43_Lane8" name="Payroll Officer">
        <bpmn:flowNodeRef>W43_Task21</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W43_Lane9" name="HR Head">
        <bpmn:flowNodeRef>W43_Task25</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W43_End27</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W43_Start11" name="Employee submits resignation, or management initiates termination, or employee retires">
        <bpmn:outgoing>W43_Flow30</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W43_Task12" name="Employee submits resignation letter (or management issues termination notice)">
        <bpmn:documentation>Step 1: Employee submits resignation letter (or management issues termination notice)
Responsible (R): Employee / Dept. Head
Accountable (A): Dept. Head
Duration: —</bpmn:documentation>
        <bpmn:incoming>W43_Flow30</bpmn:incoming>
        <bpmn:outgoing>W43_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W43_Task13" name="HR Assistant creates separation record in system: resignation date, last…">
        <bpmn:documentation>Step 2: HR Assistant creates separation record in system: resignation date, last working day (30-day notice per Labor Code or garden leave), separation type (resignation, termination, retirement, end of contract)
Responsible (R): HR Assistant
Accountable (A): HR Head
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W43_Flow31</bpmn:incoming>
        <bpmn:outgoing>W43_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W43_Task14" name="Department Head conducts exit interview; documents feedback (work conditions…">
        <bpmn:documentation>Step 3: Department Head conducts exit interview; documents feedback (work conditions, compensation, management, reason for leaving)
Responsible (R): Dept. Head
Accountable (A): HR Head
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W43_Flow32</bpmn:incoming>
        <bpmn:outgoing>W43_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W43_Task15" name="HR Assistant initiates clearance process: system generates clearance form…">
        <bpmn:documentation>Step 4: HR Assistant initiates clearance process: system generates clearance form routed to all relevant departments
Responsible (R): System
Accountable (A): HR Assistant
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W43_Flow33</bpmn:incoming>
        <bpmn:outgoing>W43_Flow34</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W43_Task16" name="IT clearance">
        <bpmn:documentation>Step 5: IT clearance: IT confirms return of laptop/tablet/phone (if issued); deactivates system accounts (ERP, POS, email, VPN); revokes access badges
Responsible (R): IT Team
Accountable (A): CIO
Duration: 15 min/employee</bpmn:documentation>
        <bpmn:incoming>W43_Flow34</bpmn:incoming>
        <bpmn:outgoing>W43_Flow35</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W43_Task17" name="Department clearance">
        <bpmn:documentation>Step 6: Department clearance: Dept. Head confirms return of company property (uniforms, tools, keys); approves final leave usage
Responsible (R): Dept. Head
Accountable (A): Dept. Head
Duration: 10 min/employee</bpmn:documentation>
        <bpmn:incoming>W43_Flow35</bpmn:incoming>
        <bpmn:outgoing>W43_Flow36</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W43_Task18" name="Finance clearance">
        <bpmn:documentation>Step 7: Finance clearance: AP Clerk confirms no outstanding cash advances or loans; AR confirms no corporate account exposure
Responsible (R): AP / AR Clerk
Accountable (A): AP/AR Supervisor
Duration: 10 min/employee</bpmn:documentation>
        <bpmn:incoming>W43_Flow36</bpmn:incoming>
        <bpmn:outgoing>W43_Flow37</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W43_Task19" name="Store Operations clearance">
        <bpmn:documentation>Step 8: Store Operations clearance (if store employee): Store Manager confirms no pending inventory accountability issues, cash drawer reconciled
Responsible (R): Store Manager
Accountable (A): VP Store Operations
Duration: 10 min/employee</bpmn:documentation>
        <bpmn:incoming>W43_Flow37</bpmn:incoming>
        <bpmn:outgoing>W43_Flow38</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W43_Task20" name="HR Assistant collects all signed clearances; marks clearance as complete in…">
        <bpmn:documentation>Step 9: HR Assistant collects all signed clearances; marks clearance as complete in system
Responsible (R): HR Assistant
Accountable (A): HR Head
Duration: 10 min/employee</bpmn:documentation>
        <bpmn:incoming>W43_Flow38</bpmn:incoming>
        <bpmn:outgoing>W43_Flow39</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W43_Task21" name="Payroll Officer computes final pay per W10 step 12: pro-rated salary for final…">
        <bpmn:documentation>Step 10: Payroll Officer computes final pay per W10 step 12: pro-rated salary for final pay period, pro-rated 13th month pay (1/12 of annual basic salary × months worked ÷ 12), converted unused leave credits (VL to cash per company policy), less outstanding loans/advances and clearance deductions; final pay computation varies by separation type — resignation: pro-rated salary + 13th month + VL conversion; termination for cause: pro-rated salary + 13th month (VL conversion per company discretion); retirement: pro-rated salary + 13th month + VL conversion + retirement pay per Labor Code or company plan (whichever is higher); end of contract: pro-rated salary + 13th month + VL conversion + separation pay if applicable per DOLE; system auto-calculates final pay based on separation type classification from W43.2 with Payroll Officer review and validation
Responsible (R): Payroll Officer
Accountable (A): Payroll Manager
Duration: Per W10</bpmn:documentation>
        <bpmn:incoming>W43_Flow39</bpmn:incoming>
        <bpmn:outgoing>W43_Flow40</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W43_Task22" name="System generates final pay as separate payroll run or adjustment; final payslip…">
        <bpmn:documentation>Step 11: System generates final pay as separate payroll run or adjustment; final payslip issued (W10 step 13)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W43_Flow40</bpmn:incoming>
        <bpmn:outgoing>W43_Flow41</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W43_Task23" name="System updates employee status to &quot;Separated&quot;; deactivates payroll processing…">
        <bpmn:documentation>Step 12: System updates employee status to &quot;Separated&quot;; deactivates payroll processing; retains record for regulatory retention (10 years)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W43_Flow41</bpmn:incoming>
        <bpmn:outgoing>W43_Flow42</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W43_Task24" name="System generates COE (Certificate of Employment) on request: dates of…">
        <bpmn:documentation>Step 13: System generates COE (Certificate of Employment) on request: dates of employment, position, compensation range (optional)
Responsible (R): System / HR Assistant
Accountable (A): HR Head
Duration: 5 min/request</bpmn:documentation>
        <bpmn:incoming>W43_Flow42</bpmn:incoming>
        <bpmn:outgoing>W43_Flow43</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W43_Task25" name="HR Head includes separation data in monthly turnover report: rate by…">
        <bpmn:documentation>Step 14: HR Head includes separation data in monthly turnover report: rate by department, store, and separation type; exit interview themes
Responsible (R): HR Head
Accountable (A): CHRO
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W43_Flow43</bpmn:incoming>
        <bpmn:outgoing>W43_Flow44</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W43_Task26" name="Cross-entity employee transfer (between legal entities, e.g., Depot Inc. →…">
        <bpmn:documentation>Step 15: Cross-entity employee transfer (between legal entities, e.g., Depot Inc. → Logistics Inc.): HR Assistant initiates transfer with effective date, destination entity, and new position; system processes as simultaneous separation from source entity and onboarding in destination entity with continuity of service — accumulated leave credits, 13th month pay pro-ration, and seniority carry forward; system deactivates employee in source entity payroll, creates employee record in destination entity with transferred balances, reassigns SSS/PhilHealth/Pag-IBIG to new entity&#x27;s remittance, and switches BIR withholding tax to new entity&#x27;s TIN registration; final pay computed at source entity (pro-rated) and first pay at destination entity for the same period; no break in employment continuity
Responsible (R): HR Assistant / Payroll Officer
Accountable (A): HR Head
Duration: 30 min/transfer</bpmn:documentation>
        <bpmn:incoming>W43_Flow44</bpmn:incoming>
        <bpmn:outgoing>W43_Flow45</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W43_End27" name="Complete">
        <bpmn:incoming>W43_Flow45</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W43_Annotation28">
        <bpmn:text>Controls: - CTL-300 (ensure controlled execution — Separation &amp; Benefits (PA-19.5).) | - operational: HR Assistant review and approval gate; operational: periodic reconciliation against source documents
Owner: HR Assistant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W43_Assoc29" sourceRef="W43_Annotation28" targetRef="W43_Start11" associationDirection="None" />
