      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1324" name="W1324. Employee Retrenchment &amp; Redundancy Processing (Labor Code Art. 298–299 Compliance)" isExecutable="false">
      <bpmn:documentation>Trigger: Management decision to reduce workforce due to economic downturn, store closure (W45/W703), redundancy from automation (W30.2), or organizational restructuring
Frequency: Ad-hoc; estimated 1–2 retrenchment exercises per year (historical Philippine retail context)
Volume: Variable: from individual position redundancy to mass retrenchment affecting 20+ employees per event
Owner: HR Head (CHRO)
Participants: HR Head, VP Legal, Department Head, Payroll Officer, DOLE Regional Director, Finance, Affected Employees, Employee Representatives (if unionized or elected)
Source: workflow W1324 — Employee Retrenchment &amp; Redundancy Processing (Labor Code Art. 298–299 Compliance)</bpmn:documentation>
      <bpmn:laneSet id="W1324_LaneSet7">
        <bpmn:lane id="W1324_Lane1" name="Department Head">
        <bpmn:flowNodeRef>W1324_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1324_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1324_Lane2" name="VP Legal">
        <bpmn:flowNodeRef>W1324_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1324_Lane3" name="HR Head">
        <bpmn:flowNodeRef>W1324_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1324_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1324_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1324_Lane4" name="Payroll Officer">
        <bpmn:flowNodeRef>W1324_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1324_Lane5" name="HR Assistant">
        <bpmn:flowNodeRef>W1324_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1324_Lane6" name="CHRO">
        <bpmn:flowNodeRef>W1324_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1324_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1324_Start8" name="Management decision to reduce workforce due to economic downturn, store closure…">
        <bpmn:outgoing>W1324_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1324_Task9" name="Business case &amp; justification">
        <bpmn:documentation>Step 1: Business case &amp; justification: Department Head or COO prepares retrenchment/redundancy business case: (a) Retrenchment: documented financial necessity — declining revenue, sustained losses, or imminent closure of business unit; supported by financial statements per W35; (b) Redundancy: documented operational justification — position elimination due to automation (per W30.2 AI/ML implementation), merger of roles, store closure (per W45/W703), or organizational restructuring; (c) business case includes: affected positions, number of employees, estimated cost (separation pay + benefits + DOLE filing), expected savings, timeline, and alternative measures considered and rejected (e.g., reduced hours, hiring freeze, attrition, redeployment to new stores per W16); (d) CHRO reviews business case for legal sufficiency per DOLE DO 174 requirements
Responsible (R): Department Head / COO
Accountable (A): CEO
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W1324_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1324_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1324_Task10" name="Legal review &amp; compliance assessment">
        <bpmn:documentation>Step 2: Legal review &amp; compliance assessment: VP Legal reviews retrenchment plan for Labor Code compliance: (a) verify grounds: retrenchment requires proof of financial necessity (audited financial statements); redundancy requires proof that position is genuinely excess; (b) confirm procedural requirements: (i) 30-day advance written notice to affected employees and DOLE Regional Director, (ii) good faith consultation with employees (or employee representatives/union), (iii) payment of separation pay: 1 month per year of service (retrenchment) or 1 month per year of service (redundancy), (c) assess NLRC litigation risk: retrenchment is the most litigated labor issue in the Philippines; employers bear burden of proving good faith and necessity; (d) VP Legal prepares retrenchment notice template and DOLE notification letter
Responsible (R): VP Legal
Accountable (A): CHRO
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W1324_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1324_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1324_Task11" name="Employee selection &amp; notification">
        <bpmn:documentation>Step 3: Employee selection &amp; notification: HR identifies affected employees based on approved criteria: (a) selection criteria must be fair and non-discriminatory: (i) performance-based (lowest performers per W72 annual review), (ii) skills/role-based (specific redundant positions), (iii) seniority (last-in, first-out for similar roles — subject to legal review); (b) HR cross-checks: no pregnant employees (protected per RA 11210), no employees on authorized leave, no employees with pending labor cases; (c) HR prepares individual retrenchment/redundancy notices for each affected employee: (i) reason for retrenchment/redundancy, (ii) effective date (30 days from receipt of notice), (iii) separation pay computation, (iv) available options: (a) accept retrenchment with separation pay, (b) apply for redeployment to another position/store, (c) apply for early retirement per W977 if eligible; (d) Department Head or HR delivers notice in person to each affected employee (individual meeting, not group announcement); simultaneous notice sent to DOLE Regional Director
Responsible (R): HR Head / Department Head
Accountable (A): CEO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1324_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1324_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1324_Task12" name="30-day consultation period">
        <bpmn:documentation>Step 4: 30-day consultation period: During the mandatory 30-day notice period: (a) HR conducts individual consultations with each affected employee: (i) explain separation pay computation in detail, (ii) discuss redeployment options (other stores with vacancies per W16, other roles within the entity, transfer to another BuildRight entity per W43.15), (iii) provide outplacement support: resume preparation, job search assistance, referral to BuildRight vendor partners with hiring needs; (b) for mass retrenchment (10+ employees): HR facilitates employee representative consultation (elected employee representative or union representative, if applicable); (c) HR documents all consultation meetings with attendance and discussion notes (critical evidence in case of NLRC dispute); (d) affected employee may choose redeployment: HR processes internal transfer per W43.15 to available position; retrenchment notice withdrawn if redeployment accepted
Responsible (R): HR Head / HR Business Partner
Accountable (A): CHRO
Duration: 30 days (elapsed)</bpmn:documentation>
        <bpmn:incoming>W1324_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1324_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1324_Task13" name="Separation pay computation &amp; processing">
        <bpmn:documentation>Step 5: Separation pay computation &amp; processing: Payroll computes separation package per affected employee: (a) Separation pay: 1 month salary per year of service (per Labor Code); service computation from hire date to retrenchment effective date; monthly salary = basic salary + regularly received allowances per DOLE guidelines; (b) Pro-rated 13th month pay: 1/12 of annual basic salary × months worked in current year; (c) Unused leave monetization: VL conversion per company policy per W777; (d) Tax treatment: separation pay due to retrenchment/redundancy is tax-exempt up to PHP 50,000 per year of service per BIR rules (similar to W977 retirement pay); excess taxable per graduated tax table; (e) Statutory benefits: SSS, PhilHealth, Pag-IBIG contributions updated through last working day; certificates of contribution issued; (f) Final pay: last salary for hours worked through effective date; (g) Payroll Officer reviews computation; Finance validates; CHRO approves per authorization matrix
Responsible (R): Payroll Officer / Finance
Accountable (A): CHRO
Duration: 2–4 hours/employee</bpmn:documentation>
        <bpmn:incoming>W1324_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1324_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1324_Task14" name="DOLE reporting &amp; documentation">
        <bpmn:documentation>Step 6: DOLE reporting &amp; documentation: HR submits required documentation to DOLE: (a) written notice to DOLE Regional Director (30 days before effectivity per Step 3); (b) post-retrenchment report: list of affected employees, positions, separation pay paid, and notice compliance documentation; (c) if mass retrenchment: additional reporting per DOLE DO 174 requirements; (d) VP Legal retains complete documentation file for each affected employee: notice, consultation records, separation pay computation, signed receipt, and DOLE correspondence; (e) documentation retained for 5 years per NLRC procedural rules for potential labor case defense
Responsible (R): HR Head / VP Legal
Accountable (A): CHRO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1324_Flow25</bpmn:incoming>
        <bpmn:outgoing>W1324_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1324_Task15" name="Offboarding execution">
        <bpmn:documentation>Step 7: Offboarding execution: Affected employees processed through modified offboarding per W43: (a) clearance process per W43.4–9; (b) IT deactivation per W43.5; (c) company property return per W43.6; (d) final pay and separation pay disbursed on effective date via bank transfer; (e) Certificate of Employment issued per W43.13 with separation type documented as &quot;Retrenchment&quot; or &quot;Redundancy&quot; (accurate documentation protects both employee and employer); (f) HR updates employee status to &quot;Separated — Retrenchment&quot; or &quot;Separated — Redundancy&quot; in system; (g) system deactivates payroll processing per W43.12
Responsible (R): HR Assistant / Payroll / IT
Accountable (A): HR Head
Duration: Per W43 (1–2 hours/employee)</bpmn:documentation>
        <bpmn:incoming>W1324_Flow26</bpmn:incoming>
        <bpmn:outgoing>W1324_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1324_Task16" name="Post-retrenchment organizational review">
        <bpmn:documentation>Step 8: Post-retrenchment organizational review: CHRO conducts post-retrenchment review with Department Head: (a) workload redistribution: verify remaining employees can absorb responsibilities of eliminated positions; (b) morale assessment: retrenchment affects morale of remaining employees — HR Business Partner conducts stay conversations per W628 with key retainers; (c) organizational chart update: remove redundant positions, update reporting lines; (d) budget recast: Finance adjusts department budget for reduced headcount; (e) rebuilding plan: timeline and strategy for rebuilding team when business conditions improve (e.g., new store openings per W16 create redeployment/rehiring opportunities)
Responsible (R): CHRO / Department Head / Finance
Accountable (A): CEO
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W1324_Flow27</bpmn:incoming>
        <bpmn:outgoing>W1324_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1324_End17" name="Complete">
        <bpmn:incoming>W1324_Flow28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1324_Annotation18">
        <bpmn:text>Controls: - CTL-300 (ensure controlled execution — Separation &amp; Benefits (PA-19.5).) | - operational: strict compliance with this workflow and VP Legal review at every step; operational: matching redeployment options to employee skills and providing training per W51 for new role requirements; operational: transparent communication (within legal limits), reaffirming job security for remaining staff, and accelerating workload redistribution to demonstrate operational continuity
Owner: HR Head (CHRO)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1324_Assoc19" sourceRef="W1324_Annotation18" targetRef="W1324_Start8" associationDirection="None" />
      <bpmn:sequenceFlow id="W1324_Flow20" sourceRef="W1324_Start8" targetRef="W1324_Task9" />
      <bpmn:sequenceFlow id="W1324_Flow21" sourceRef="W1324_Task9" targetRef="W1324_Task10" />
      <bpmn:sequenceFlow id="W1324_Flow22" sourceRef="W1324_Task10" targetRef="W1324_Task11" />
      <bpmn:sequenceFlow id="W1324_Flow23" sourceRef="W1324_Task11" targetRef="W1324_Task12" />
      <bpmn:sequenceFlow id="W1324_Flow24" sourceRef="W1324_Task12" targetRef="W1324_Task13" />
      <bpmn:sequenceFlow id="W1324_Flow25" sourceRef="W1324_Task13" targetRef="W1324_Task14" />
      <bpmn:sequenceFlow id="W1324_Flow26" sourceRef="W1324_Task14" targetRef="W1324_Task15" />
      <bpmn:sequenceFlow id="W1324_Flow27" sourceRef="W1324_Task15" targetRef="W1324_Task16" />
      <bpmn:sequenceFlow id="W1324_Flow28" sourceRef="W1324_Task16" targetRef="W1324_End17" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1324_diag">
      <bpmndi:BPMNPlane id="W1324_plane" bpmnElement="W_W1324">
