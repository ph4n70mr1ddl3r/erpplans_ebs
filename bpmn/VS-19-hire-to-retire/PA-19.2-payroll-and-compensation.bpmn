      <bpmn:sequenceFlow id="W10_Flow36" sourceRef="W10_Task19" targetRef="W10_Task20" />
      <bpmn:sequenceFlow id="W10_Flow37" sourceRef="W10_Task20" targetRef="W10_End21" />
    </bpmn:process>
