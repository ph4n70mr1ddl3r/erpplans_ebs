    <bpmn:process id="W_W644" name="W644. 13th Month Pay Reconciliation &amp; Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly accrual cycle; December payment preparation
Frequency: Monthly accrual booking; November review and reconciliation; December payment
Volume: 6,911 employees across 5 entities
Owner: Payroll Specialist
Participants: Payroll Manager, Finance Analyst, HR Business Partner
Source: workflow W644 — 13th Month Pay Reconciliation &amp; Compliance</bpmn:documentation>
      <bpmn:laneSet id="W644_LaneSet5">
        <bpmn:lane id="W644_Lane1" name="System">
        <bpmn:flowNodeRef>W644_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W644_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W644_Lane2" name="Payroll Specialist">
        <bpmn:flowNodeRef>W644_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W644_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W644_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W644_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W644_Lane3" name="Finance Analyst">
        <bpmn:flowNodeRef>W644_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W644_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W644_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W644_Lane4" name="Payroll Manager">
        <bpmn:flowNodeRef>W644_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W644_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W644_Start6" name="Monthly accrual cycle; December payment preparation">
        <bpmn:outgoing>W644_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W644_Task7" name="Monthly: System auto-accrues 13th month pay per employee based on basic salary…">
        <bpmn:documentation>Step 1: Monthly: System auto-accrues 13th month pay per employee based on basic salary earned during the month (1/12 of total basic salary earned from January 1); excludes allowances, overtime pay, night differential, and non-taxable benefits per PD 851 and DOLE guidelines
Responsible (R): System
Accountable (A): Payroll Specialist
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W644_Flow19</bpmn:incoming>
        <bpmn:outgoing>W644_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W644_Task8" name="Monthly: Payroll Specialist reviews accrual computation: validates base salary…">
        <bpmn:documentation>Step 2: Monthly: Payroll Specialist reviews accrual computation: validates base salary definition (basic salary only — excludes COLA, hazard pay, overtime, commissions unless mandated by CBA per W493); flags employees with mid-year salary changes for correct pro-ration
Responsible (R): Payroll Specialist
Accountable (A): Payroll Manager
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W644_Flow20</bpmn:incoming>
        <bpmn:outgoing>W644_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W644_Task9" name="Monthly: Finance Analyst posts accrual journal entry (DR 13th Month Pay Expense…">
        <bpmn:documentation>Step 3: Monthly: Finance Analyst posts accrual journal entry (DR 13th Month Pay Expense / CR 13th Month Pay Accrued Liability) per entity; verifies total accrual against payroll register
Responsible (R): Finance Analyst
Accountable (A): Finance Manager
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W644_Flow21</bpmn:incoming>
        <bpmn:outgoing>W644_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W644_Task10" name="November: Payroll Specialist performs comprehensive reconciliation: total…">
        <bpmn:documentation>Step 4: November: Payroll Specialist performs comprehensive reconciliation: total accrued 13th month per employee vs. YTD basic salary ÷ 12; identifies discrepancies from mid-year salary changes, leaves without pay, absences, and split-entity employment
Responsible (R): Payroll Specialist
Accountable (A): Payroll Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W644_Flow22</bpmn:incoming>
        <bpmn:outgoing>W644_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W644_Task11" name="November: Payroll Specialist adjusts accruals for: (a) separating employees who…">
        <bpmn:documentation>Step 5: November: Payroll Specialist adjusts accruals for: (a) separating employees who already received proportionate 13th month in final pay (W643), (b) employees who received employer&#x27;s elected half payment in May (if BuildRight practices May + December split), (c) employees with salary adjustments requiring retroactive accrual correction
Responsible (R): Payroll Specialist
Accountable (A): Payroll Manager
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W644_Flow23</bpmn:incoming>
        <bpmn:outgoing>W644_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W644_Task12" name="November: Payroll Specialist computes tax impact: 13th month pay is tax-exempt…">
        <bpmn:documentation>Step 6: November: Payroll Specialist computes tax impact: 13th month pay is tax-exempt up to PHP 90,000 threshold per TRAIN law Section 32(B)(6)(e); excess amount subject to graduated withholding tax; generates report of employees exceeding threshold for Finance Manager review
Responsible (R): Payroll Specialist
Accountable (A): Finance Manager
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W644_Flow24</bpmn:incoming>
        <bpmn:outgoing>W644_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W644_Task13" name="December 1–15: Payroll Manager prepares 13th month payment batch: confirms…">
        <bpmn:documentation>Step 7: December 1–15: Payroll Manager prepares 13th month payment batch: confirms final amounts per employee, validates bank account details, generates bank file, routes for approval
Responsible (R): Payroll Manager
Accountable (A): Finance Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W644_Flow25</bpmn:incoming>
        <bpmn:outgoing>W644_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W644_Task14" name="December 15–24: Finance Analyst executes payment via bank transfer; ensures all…">
        <bpmn:documentation>Step 8: December 15–24: Finance Analyst executes payment via bank transfer; ensures all 6,911 employees receive payment by December 24 deadline per PD 851
Responsible (R): Finance Analyst
Accountable (A): Finance Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W644_Flow26</bpmn:incoming>
        <bpmn:outgoing>W644_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W644_Task15" name="December 31: System reverses remaining accrual balance to actual payment…">
        <bpmn:documentation>Step 9: December 31: System reverses remaining accrual balance to actual payment; Finance Analyst reconciles GL accrual account to zero
Responsible (R): Finance Analyst
Accountable (A): Finance Manager
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W644_Flow27</bpmn:incoming>
        <bpmn:outgoing>W644_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W644_End16" name="Complete">
        <bpmn:incoming>W644_Flow28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W644_Annotation17">
        <bpmn:text>Controls: - CTL-297 (ensure controlled execution — Payroll &amp; Compensation (PA-19.2).) | - operational: Payroll Manager monthly accrual review; Finance Manager GL reconciliation; DOLE December 24 payment-deadline compliance tracking; PHP 90,000 tax-exemption threshold monitoring | ---
Owner: Payroll Specialist</bpmn:text>
      </bpmn:textAnnotation>
