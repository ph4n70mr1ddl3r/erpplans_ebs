      <bpmn:sequenceFlow id="W779_Flow23" sourceRef="W779_Task10" targetRef="W779_Task11" />
      <bpmn:sequenceFlow id="W779_Flow24" sourceRef="W779_Task11" targetRef="W779_Task12" />
      <bpmn:sequenceFlow id="W779_Flow25" sourceRef="W779_Task12" targetRef="W779_Task13" />
      <bpmn:sequenceFlow id="W779_Flow26" sourceRef="W779_Task13" targetRef="W779_Task14" />
      <bpmn:sequenceFlow id="W779_Flow27" sourceRef="W779_Task14" targetRef="W779_Task15" />
      <bpmn:sequenceFlow id="W779_Flow28" sourceRef="W779_Task15" targetRef="W779_Task16" />
