<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-19.2-payroll-and-compensation" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W10" name="W10. Payroll Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Semi-monthly payroll calendar (15th and 30th)
Frequency: 10 payroll runs/month (5 entities × 2)
Volume: ~6,911 employees total
Owner: Payroll Manager
Participants: Payroll Officer, HR Assistant, Department Heads (OT/leave approval), Finance (bank file)
Source: workflow W10 — Payroll Processing</bpmn:documentation>
      <bpmn:laneSet id="W10_LaneSet6">
        <bpmn:lane id="W10_Lane1" name="Payroll Officer">
        <bpmn:flowNodeRef>W10_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W10_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W10_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W10_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W10_Task19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W10_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W10_Lane2" name="HR Assistant">
        <bpmn:flowNodeRef>W10_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W10_Lane3" name="System">
        <bpmn:flowNodeRef>W10_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W10_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W10_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W10_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W10_Task20</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W10_Lane4" name="Payroll Manager">
        <bpmn:flowNodeRef>W10_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W10_Lane5" name="Treasury Analyst">
        <bpmn:flowNodeRef>W10_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W10_End21</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W10_Start7" name="Semi-monthly payroll calendar (15th and 30th)">
        <bpmn:outgoing>W10_Flow24</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W10_Task8" name="Payroll Officer pulls time &amp; attendance data from biometric/RFID system">
        <bpmn:documentation>Step 1: Payroll Officer pulls time &amp; attendance data from biometric/RFID system
Responsible (R): Payroll Officer
Accountable (A): Payroll Manager
Duration: 30 min/run</bpmn:documentation>
        <bpmn:incoming>W10_Flow24</bpmn:incoming>
        <bpmn:outgoing>W10_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W10_Task9" name="HR Assistant verifies approved leaves, overtime, and schedule adjustments are…">
        <bpmn:documentation>Step 2: HR Assistant verifies approved leaves, overtime, and schedule adjustments are posted
Responsible (R): HR Assistant
Accountable (A): Payroll Manager
Duration: 2 hours/run</bpmn:documentation>
        <bpmn:incoming>W10_Flow25</bpmn:incoming>
        <bpmn:outgoing>W10_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W10_Task10" name="Payroll Officer validates: basic salary + OT + night differential + holiday pay…">
        <bpmn:documentation>Step 3: Payroll Officer validates: basic salary + OT + night differential + holiday pay + allowances
Responsible (R): Payroll Officer
Accountable (A): Payroll Manager
Duration: 1 hour/run</bpmn:documentation>
        <bpmn:incoming>W10_Flow26</bpmn:incoming>
        <bpmn:outgoing>W10_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W10_Task11" name="System calculates deductions: SSS, PhilHealth, Pag-IBIG, withholding tax (TRAIN…">
        <bpmn:documentation>Step 4: System calculates deductions: SSS, PhilHealth, Pag-IBIG, withholding tax (TRAIN law), loans, advances
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W10_Flow27</bpmn:incoming>
        <bpmn:outgoing>W10_Flow28</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W10_Task12" name="Payroll Officer reviews computed payroll for anomalies (negative net pay…">
        <bpmn:documentation>Step 5: Payroll Officer reviews computed payroll for anomalies (negative net pay, unusually high OT)
Responsible (R): Payroll Officer
Accountable (A): Payroll Manager
Duration: 1 hour/run</bpmn:documentation>
        <bpmn:incoming>W10_Flow28</bpmn:incoming>
        <bpmn:outgoing>W10_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W10_Task13" name="Payroll Manager reviews and approves payroll register">
        <bpmn:documentation>Step 6: Payroll Manager reviews and approves payroll register
Responsible (R): Payroll Manager
Accountable (A): CHRO
Duration: 30 min/run</bpmn:documentation>
        <bpmn:incoming>W10_Flow29</bpmn:incoming>
        <bpmn:outgoing>W10_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W10_Task14" name="System generates bank file for payroll crediting (BDO, BPI, etc.)">
        <bpmn:documentation>Step 7: System generates bank file for payroll crediting (BDO, BPI, etc.)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W10_Flow30</bpmn:incoming>
        <bpmn:outgoing>W10_Flow31</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W10_Task15" name="Finance/Treasury reviews bank file; transmits to bank">
        <bpmn:documentation>Step 8: Finance/Treasury reviews bank file; transmits to bank
Responsible (R): Treasury Analyst
Accountable (A): CFO
Duration: 30 min/run</bpmn:documentation>
        <bpmn:incoming>W10_Flow31</bpmn:incoming>
        <bpmn:outgoing>W10_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W10_Task16" name="System posts payroll journal entries to GL (salary expense, payable, deductions)">
        <bpmn:documentation>Step 9: System posts payroll journal entries to GL (salary expense, payable, deductions)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W10_Flow32</bpmn:incoming>
        <bpmn:outgoing>W10_Flow33</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W10_Task17" name="Payslips generated; distributed via email or employee self-service portal">
        <bpmn:documentation>Step 10: Payslips generated; distributed via email or employee self-service portal
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W10_Flow33</bpmn:incoming>
        <bpmn:outgoing>W10_Flow34</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W10_Task18" name="Monthly: generate SSS PRN, PhilHealth contribution, Pag-IBIG contribution files…">
        <bpmn:documentation>Step 11: Monthly: generate SSS PRN, PhilHealth contribution, Pag-IBIG contribution files for remittance
Responsible (R): Payroll Officer
Accountable (A): Payroll Manager
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W10_Flow34</bpmn:incoming>
        <bpmn:outgoing>W10_Flow35</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W10_Task19" name="Final pay computation (upon employee separation): system calculates pro-rated…">
        <bpmn:documentation>Step 12: Final pay computation (upon employee separation): system calculates pro-rated 13th month pay, converted unused leave credits, less outstanding loans/advances and clearance deductions
Responsible (R): Payroll Officer
Accountable (A): Payroll Manager
Duration: 30 min/employee</bpmn:documentation>
        <bpmn:incoming>W10_Flow35</bpmn:incoming>
        <bpmn:outgoing>W10_Flow36</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W10_Task20" name="System posts final pay as separate payroll run or adjustment; generates final…">
        <bpmn:documentation>Step 13: System posts final pay as separate payroll run or adjustment; generates final payslip
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W10_Flow36</bpmn:incoming>
        <bpmn:outgoing>W10_Flow37</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W10_End21" name="Complete">
        <bpmn:incoming>W10_Flow37</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W10_Annotation22">
        <bpmn:text>Controls: - CTL-13 (separate payroll computation from approval.); CTL-34 (ensure complete tax compliance.) | - operational: must dynamically cap deductions, but manual overrides can bypass this safeguard
Owner: Payroll Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W10_Assoc23" sourceRef="W10_Annotation22" targetRef="W10_Start7" associationDirection="None" />
