    <bpmn:process id="W_W280" name="W280. Court-Ordered Wage Garnishment &amp; Third-Party Deductions" isExecutable="false">
      <bpmn:documentation>Trigger: HR receives a legal order or authorized request to deduct funds directly from an employee&#x27;s net pay (e.g., child support, cooperative loan, union dues).
Frequency: Semi-monthly payroll cycle
Volume: 50-100 employees affected
Owner: Payroll Manager
Participants: HR Admin, Legal, Employee, Third-Party Payee
Source: workflow W280 — Court-Ordered Wage Garnishment &amp; Third-Party Deductions</bpmn:documentation>
      <bpmn:laneSet id="W280_LaneSet5">
        <bpmn:lane id="W280_Lane1" name="Payroll Admin">
        <bpmn:flowNodeRef>W280_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W280_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W280_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W280_Lane2" name="Legal Counsel">
        <bpmn:flowNodeRef>W280_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W280_Lane3" name="Payroll Manager">
        <bpmn:flowNodeRef>W280_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W280_Lane4" name="HR Admin">
        <bpmn:flowNodeRef>W280_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W280_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W280_Start6" name="HR receives a legal order or authorized request to deduct funds directly from an…">
        <bpmn:outgoing>W280_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W280_Task7" name="Legal/HR receives and verifies the garnishment order or loan agreement.">
        <bpmn:documentation>Step 1: Legal/HR receives and verifies the garnishment order or loan agreement.
Responsible (R): Payroll Admin
Accountable (A): Payroll Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W280_Flow15</bpmn:incoming>
        <bpmn:outgoing>W280_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W280_Task8" name="Payroll Admin configures a recurring deduction wage type in the employee&#x27;s…">
        <bpmn:documentation>Step 2: Payroll Admin configures a recurring deduction wage type in the employee&#x27;s compensation profile.
Responsible (R): Legal Counsel
Accountable (A): CHRO
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W280_Flow16</bpmn:incoming>
        <bpmn:outgoing>W280_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W280_Task9" name="System logic applies prioritization rules (e.g., statutory taxes first, court…">
        <bpmn:documentation>Step 3: System logic applies prioritization rules (e.g., statutory taxes first, court orders second, voluntary loans third) to ensure net pay does not fall below legal minimums.
Responsible (R): Payroll Manager
Accountable (A): CFO
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W280_Flow17</bpmn:incoming>
        <bpmn:outgoing>W280_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W280_Task10" name="Payroll runs; funds are deducted and booked to a specific AP liability account.">
        <bpmn:documentation>Step 4: Payroll runs; funds are deducted and booked to a specific AP liability account.
Responsible (R): Payroll Admin
Accountable (A): Payroll Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W280_Flow18</bpmn:incoming>
        <bpmn:outgoing>W280_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W280_Task11" name="Finance remits the consolidated deducted funds to the court, union, or…">
        <bpmn:documentation>Step 5: Finance remits the consolidated deducted funds to the court, union, or cooperative.
Responsible (R): HR Admin
Accountable (A): CHRO
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W280_Flow19</bpmn:incoming>
        <bpmn:outgoing>W280_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W280_End12" name="Complete">
        <bpmn:incoming>W280_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W280_Annotation13">
        <bpmn:text>Controls: - CTL-297 (ensure controlled execution — Payroll &amp; Compensation (PA-19.2).) | - operational: must apply strict prioritization rules while ensuring net pay does not fall below minimum wage
Owner: Payroll Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W280_Assoc14" sourceRef="W280_Annotation13" targetRef="W280_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W280_Flow15" sourceRef="W280_Start6" targetRef="W280_Task7" />
      <bpmn:sequenceFlow id="W280_Flow16" sourceRef="W280_Task7" targetRef="W280_Task8" />
      <bpmn:sequenceFlow id="W280_Flow17" sourceRef="W280_Task8" targetRef="W280_Task9" />
      <bpmn:sequenceFlow id="W280_Flow18" sourceRef="W280_Task9" targetRef="W280_Task10" />
      <bpmn:sequenceFlow id="W280_Flow19" sourceRef="W280_Task10" targetRef="W280_Task11" />
      <bpmn:sequenceFlow id="W280_Flow20" sourceRef="W280_Task11" targetRef="W280_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W280_diag">
      <bpmndi:BPMNPlane id="W280_plane" bpmnElement="W_W280">
