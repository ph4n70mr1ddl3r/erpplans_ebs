    <bpmn:process id="W_W641" name="W641. Off-Cycle &amp; Ad-Hoc Payment Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Off-cycle payment request (DOLE order for back-pay, NLRC decision, retroactive wage adjustment, corrected payslip, emergency salary release, final pay outside regular payroll run)
Frequency: ~75–100 off-cycle payments/month
Volume: ~15–20 per entity per month
Owner: Payroll Manager
Participants: HR Business Partner (requester), Finance Manager (approver), Payroll Specialist (processor), Employee (payee)
Source: workflow W641 — Off-Cycle &amp; Ad-Hoc Payment Processing</bpmn:documentation>
      <bpmn:laneSet id="W641_LaneSet6">
        <bpmn:lane id="W641_Lane1" name="HR Business Partner">
        <bpmn:flowNodeRef>W641_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W641_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W641_Lane2" name="Payroll Manager">
        <bpmn:flowNodeRef>W641_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W641_Lane3" name="Finance Manager">
        <bpmn:flowNodeRef>W641_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W641_Lane4" name="Payroll Specialist">
        <bpmn:flowNodeRef>W641_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W641_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W641_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W641_Lane5" name="System">
        <bpmn:flowNodeRef>W641_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W641_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W641_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W641_Start7" name="Off-cycle payment request (DOLE order for back-pay, NLRC decision, retroactive wage…">
        <bpmn:outgoing>W641_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W641_Task8" name="HR Business Partner or Department Head submits off-cycle payment request via…">
        <bpmn:documentation>Step 1: HR Business Partner or Department Head submits off-cycle payment request via self-service portal with: employee ID, payment type (back-pay, wage adjustment, corrected payslip, emergency release, court-ordered), amount or basis of computation, supporting documentation (DOLE order, NLRC decision, management memo), and urgency classification (standard 3-day, urgent next-business-day)
Responsible (R): HR Business Partner
Accountable (A): Payroll Manager
Duration: 15 min/request</bpmn:documentation>
        <bpmn:incoming>W641_Flow19</bpmn:incoming>
        <bpmn:outgoing>W641_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W641_Task9" name="Payroll Manager validates request: confirms employee status (active, on-leave…">
        <bpmn:documentation>Step 2: Payroll Manager validates request: confirms employee status (active, on-leave, separated), verifies supporting documentation completeness, confirms correct payment type classification
Responsible (R): Payroll Manager
Accountable (A): Finance Manager
Duration: 30 min/request</bpmn:documentation>
        <bpmn:incoming>W641_Flow20</bpmn:incoming>
        <bpmn:outgoing>W641_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W641_Task10" name="For amounts &gt; PHP 50,000 or retroactive periods &gt; 6 months: route to Finance…">
        <bpmn:documentation>Step 3: For amounts &gt; PHP 50,000 or retroactive periods &gt; 6 months: route to Finance Manager for approval before processing
Responsible (R): Finance Manager
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W641_Flow21</bpmn:incoming>
        <bpmn:outgoing>W641_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W641_Task11" name="Payroll Specialist processes off-cycle payment: computes gross amount, applies…">
        <bpmn:documentation>Step 4: Payroll Specialist processes off-cycle payment: computes gross amount, applies statutory deductions (SSS, PhilHealth, Pag-IBIG, BIR withholding tax) per TRAIN law tables, nets to take-home pay
Responsible (R): Payroll Specialist
Accountable (A): Payroll Manager
Duration: 30 min/payment</bpmn:documentation>
        <bpmn:incoming>W641_Flow22</bpmn:incoming>
        <bpmn:outgoing>W641_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W641_Task12" name="System validates minimum wage protection (net pay cannot fall below applicable…">
        <bpmn:documentation>Step 5: System validates minimum wage protection (net pay cannot fall below applicable regional minimum wage for the period); flags if violation detected
Responsible (R): System
Accountable (A): Payroll Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W641_Flow23</bpmn:incoming>
        <bpmn:outgoing>W641_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W641_Task13" name="Payroll Specialist generates bank file for off-cycle crediting or manual check…">
        <bpmn:documentation>Step 6: Payroll Specialist generates bank file for off-cycle crediting or manual check preparation; routes for bank file approval
Responsible (R): Payroll Specialist
Accountable (A): Payroll Manager
Duration: 15 min/batch</bpmn:documentation>
        <bpmn:incoming>W641_Flow24</bpmn:incoming>
        <bpmn:outgoing>W641_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W641_Task14" name="System auto-adjusts next regular payroll run to reflect off-cycle payment…">
        <bpmn:documentation>Step 7: System auto-adjusts next regular payroll run to reflect off-cycle payment: updated YTD totals, adjusted tax withholding for remaining periods, corrected statutory deduction brackets
Responsible (R): System
Accountable (A): Payroll Specialist
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W641_Flow25</bpmn:incoming>
        <bpmn:outgoing>W641_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W641_Task15" name="Payroll Specialist generates corrected payslip (if applicable) or supplementary…">
        <bpmn:documentation>Step 8: Payroll Specialist generates corrected payslip (if applicable) or supplementary payslip with detailed computation; distributes to employee
Responsible (R): Payroll Specialist
Accountable (A): Payroll Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W641_Flow26</bpmn:incoming>
        <bpmn:outgoing>W641_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W641_End16" name="Complete">
        <bpmn:incoming>W641_Flow27</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W641_Annotation17">
        <bpmn:text>Controls: - CTL-297 (ensure controlled execution — Payroll &amp; Compensation (PA-19.2).) | - operational: Payroll Manager validation gate; Finance Manager approval for payments &gt;PHP 50,000; minimum-wage-protection system guardrail; DOLE deadline compliance tracking | ---
Owner: Payroll Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W641_Assoc18" sourceRef="W641_Annotation17" targetRef="W641_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W641_Flow19" sourceRef="W641_Start7" targetRef="W641_Task8" />
      <bpmn:sequenceFlow id="W641_Flow20" sourceRef="W641_Task8" targetRef="W641_Task9" />
      <bpmn:sequenceFlow id="W641_Flow21" sourceRef="W641_Task9" targetRef="W641_Task10" />
      <bpmn:sequenceFlow id="W641_Flow22" sourceRef="W641_Task10" targetRef="W641_Task11" />
      <bpmn:sequenceFlow id="W641_Flow23" sourceRef="W641_Task11" targetRef="W641_Task12" />
      <bpmn:sequenceFlow id="W641_Flow24" sourceRef="W641_Task12" targetRef="W641_Task13" />
      <bpmn:sequenceFlow id="W641_Flow25" sourceRef="W641_Task13" targetRef="W641_Task14" />
      <bpmn:sequenceFlow id="W641_Flow26" sourceRef="W641_Task14" targetRef="W641_Task15" />
      <bpmn:sequenceFlow id="W641_Flow27" sourceRef="W641_Task15" targetRef="W641_End16" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W641_diag">
      <bpmndi:BPMNPlane id="W641_plane" bpmnElement="W_W641">
        <bpmndi:BPMNShape id="W641_Lane1_di" bpmnElement="W641_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2000" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W641_Lane2_di" bpmnElement="W641_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="2000" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W641_Lane3_di" bpmnElement="W641_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="2000" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W641_Lane4_di" bpmnElement="W641_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="2000" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W641_Lane5_di" bpmnElement="W641_Lane5" isHorizontal="true"><dc:Bounds x="160" y="760" width="2000" height="170" /></bpmndi:BPMNShape>
