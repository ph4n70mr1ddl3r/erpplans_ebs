        <bpmn:flowNodeRef>W1358_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1358_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1358_Start8" name="Seasonal demand forecast indicating &gt; 20% sales uplift during a defined period (e.g., Q4…">
        <bpmn:outgoing>W1358_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1358_Task9" name="Supply Planning Manager and VP Store Operations agree on seasonal demand…">
        <bpmn:documentation>Step 1: Supply Planning Manager and VP Store Operations agree on seasonal demand forecast; translate sales uplift into incremental FTE needs by store and DC (e.g., +2 Sales Associates per high-volume store, +1 per standard store, +20 pickers per DC)
Responsible (R): Supply Planning Manager / VP Store Operations
Accountable (A): COO
Duration: 4–6 hours/season</bpmn:documentation>
        <bpmn:incoming>W1358_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1358_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1358_Task10" name="HR Manager develops seasonal staffing plan: headcount by role, location, and…">
        <bpmn:documentation>Step 2: HR Manager develops seasonal staffing plan: headcount by role, location, and duration (start/end dates); determines mix of fixed-term vs. agency-provided workers
Responsible (R): HR Manager
Accountable (A): CHRO
Duration: 4–6 hours/season</bpmn:documentation>
        <bpmn:incoming>W1358_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1358_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1358_Task11" name="Recruitment Specialist executes hiring campaign: job postings, walk-in…">
        <bpmn:documentation>Step 3: Recruitment Specialist executes hiring campaign: job postings, walk-in interview days at stores, coordination with manpower agencies for DC roles; target: fill 80% of positions 2 weeks before season start
Responsible (R): Recruitment Specialist
Accountable (A): HR Manager
Duration: 20–30 hours/season</bpmn:documentation>
        <bpmn:incoming>W1358_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1358_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1358_Task12" name="Training Coordinator delivers accelerated orientation: 1-day store onboarding…">
        <bpmn:documentation>Step 4: Training Coordinator delivers accelerated orientation: 1-day store onboarding (POS basics, safety, product knowledge for top 100 seasonal SKUs) vs. 2–3-day standard onboarding (W15); issues temporary employee ID
Responsible (R): Training Coordinator
Accountable (A): HR Manager
Duration: 1 day/temporary employee cohort</bpmn:documentation>
        <bpmn:incoming>W1358_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1358_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1358_Task13" name="Payroll Specialist configures fixed-term employment contracts with correct wage…">
        <bpmn:documentation>Step 5: Payroll Specialist configures fixed-term employment contracts with correct wage rates (regional minimum wage varies), statutory benefit enrollment (SSS, PhilHealth, Pag-IBIG pro-rated), and 13th month pay computation for contract duration
Responsible (R): Payroll Specialist
Accountable (A): HR Manager
Duration: 2–3 hours/season setup</bpmn:documentation>
        <bpmn:incoming>W1358_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1358_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1358_Task14" name="During season: HR monitors temporary employee performance and attendance…">
        <bpmn:documentation>Step 6: During season: HR monitors temporary employee performance and attendance; replaces underperformers within the season window
Responsible (R): HR Manager / Store Manager
Accountable (A): HR Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1358_Flow25</bpmn:incoming>
        <bpmn:outgoing>W1358_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1358_Task15" name="Post-season: HR Manager executes right-sizing plan — non-renewal of fixed-term…">
        <bpmn:documentation>Step 7: Post-season: HR Manager executes right-sizing plan — non-renewal of fixed-term contracts per DOLE regulations (no termination required for end-of-contract); agency workers returned to agency; retained high-performers offered permanent positions if vacancies exist
Responsible (R): HR Manager
Accountable (A): CHRO
Duration: 4–6 hours/season</bpmn:documentation>
        <bpmn:incoming>W1358_Flow26</bpmn:incoming>
        <bpmn:outgoing>W1358_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1358_Task16" name="Finance calculates seasonal labor cost vs. incremental revenue contribution…">
        <bpmn:documentation>Step 8: Finance calculates seasonal labor cost vs. incremental revenue contribution; produces ROI analysis for seasonal staffing program
Responsible (R): Finance (FP&amp;A)
Accountable (A): CFO
Duration: 2–3 hours/season</bpmn:documentation>
        <bpmn:incoming>W1358_Flow27</bpmn:incoming>
        <bpmn:outgoing>W1358_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1358_End17" name="Complete">
        <bpmn:incoming>W1358_Flow28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1358_Annotation18">
        <bpmn:text>Controls: - CTL-298 (ensure controlled execution — Workforce Management (PA-19.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: HR Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1358_Assoc19" sourceRef="W1358_Annotation18" targetRef="W1358_Start8" associationDirection="None" />
