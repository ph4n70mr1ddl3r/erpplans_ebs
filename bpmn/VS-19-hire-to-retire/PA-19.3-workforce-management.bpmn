        <bpmn:outgoing>W753_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W753_Task7" name="Break schedule generation — System auto-generates break schedule based on shift…">
        <bpmn:documentation>Step 1: Break schedule generation — System auto-generates break schedule based on shift roster (W34): staggers breaks to maintain minimum staffing per department; ensures no more than 30% of department staff on break simultaneously
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W753_Flow18</bpmn:incoming>
        <bpmn:outgoing>W753_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W753_Task8" name="Pre-shift break schedule communication — During morning huddle (W739), Store…">
        <bpmn:documentation>Step 2: Pre-shift break schedule communication — During morning huddle (W739), Store Manager confirms break schedule; Department Supervisors receive their zone&#x27;s break schedule on handheld device
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W753_Flow19</bpmn:incoming>
        <bpmn:outgoing>W753_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W753_Task9" name="Meal break execution — Employee clocks out for 60-minute meal break at…">
        <bpmn:documentation>Step 3: Meal break execution — Employee clocks out for 60-minute meal break at scheduled time; system monitors break start time; employee must clock back in within 65 minutes (5-minute grace period)
Responsible (R): Employee
Accountable (A): Department Supervisor
Duration: 60 min</bpmn:documentation>
        <bpmn:incoming>W753_Flow20</bpmn:incoming>
        <bpmn:outgoing>W753_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W753_Task10" name="Rest break execution — Two paid 5-minute rest breaks per 8-hour shift; employee…">
        <bpmn:documentation>Step 4: Rest break execution — Two paid 5-minute rest breaks per 8-hour shift; employee takes break at designated time; no clock-out required (paid break); Department Supervisor tracks completion
Responsible (R): Employee
Accountable (A): Department Supervisor
Duration: 5 min each</bpmn:documentation>
        <bpmn:incoming>W753_Flow21</bpmn:incoming>
        <bpmn:outgoing>W753_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W753_Task11" name="Break coverage verification — Department Supervisor confirms replacement…">
        <bpmn:documentation>Step 5: Break coverage verification — Department Supervisor confirms replacement coverage before releasing employee for break; if coverage unavailable, reschedules break within compliance window
Responsible (R): Department Supervisor
Accountable (A): Department Supervisor
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W753_Flow22</bpmn:incoming>
        <bpmn:outgoing>W753_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W753_Task12" name="Compliance monitoring — System flags: (a) missed meal break (no clock-out…">
        <bpmn:documentation>Step 6: Compliance monitoring — System flags: (a) missed meal break (no clock-out within 5 hours of shift start), (b) shortened meal break (&lt; 45 minutes), (c) late meal break (&gt; 6 hours after shift start), (d) missed rest break
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W753_Flow23</bpmn:incoming>
        <bpmn:outgoing>W753_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W753_Task13" name="Non-compliance escalation — System sends compliance alert to Store Manager for…">
        <bpmn:documentation>Step 7: Non-compliance escalation — System sends compliance alert to Store Manager for any flagged violations; Store Manager investigates and documents corrective action; repeat violations escalated to HR
Responsible (R): Store Manager
Accountable (A): HR
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W753_Flow24</bpmn:incoming>
        <bpmn:outgoing>W753_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W753_Task14" name="Monthly compliance report — System generates monthly break compliance report…">
        <bpmn:documentation>Step 8: Monthly compliance report — System generates monthly break compliance report per store: compliance rate, violation count by type, repeat offenders; HR reviews for DOLE inspection preparation (W505)
Responsible (R): System / HR
Accountable (A): HR
Duration: Automated + 30 min review</bpmn:documentation>
        <bpmn:incoming>W753_Flow25</bpmn:incoming>
        <bpmn:outgoing>W753_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W753_End15" name="Complete">
        <bpmn:incoming>W753_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W753_Annotation16">
        <bpmn:text>Controls: - CTL-298 (ensure controlled execution — Workforce Management (PA-19.3).) | - operational: Store Manager / Department Supervisor review and approval gate
Owner: Store Manager / Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
