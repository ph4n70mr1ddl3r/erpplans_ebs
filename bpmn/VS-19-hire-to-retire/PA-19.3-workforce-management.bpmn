    <bpmn:process id="W_W645" name="W645. Strategic Workforce Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Annual planning cycle aligned with budget (W26); triggered by new store opening plan (10–15/year) or significant business change
Frequency: Annual comprehensive plan; quarterly progress review; monthly headcount tracking
Volume: 6,911 current headcount; ~10–15 new stores/year requiring ~290–435 net new hires; ~1,200–1,600 turnover replacements/year
Owner: HR Manager (Workforce Planning)
Participants: CHRO, VP Store Operations, VP Supply Chain, FP&amp;A Manager, Regional Managers
Source: workflow W645 — Strategic Workforce Planning</bpmn:documentation>
      <bpmn:laneSet id="W645_LaneSet6">
        <bpmn:lane id="W645_Lane1" name="FP&amp;A Manager">
        <bpmn:flowNodeRef>W645_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W645_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W645_Lane2" name="VP Store Operations">
        <bpmn:flowNodeRef>W645_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W645_Lane3" name="VP Supply Chain">
        <bpmn:flowNodeRef>W645_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W645_Lane4" name="HR Manager">
        <bpmn:flowNodeRef>W645_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W645_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W645_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W645_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W645_Lane5" name="CHRO">
        <bpmn:flowNodeRef>W645_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W645_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W645_Start7" name="Annual planning cycle aligned with budget (W26); triggered by new store opening plan…">
        <bpmn:outgoing>W645_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W645_Task8" name="FP&amp;A Manager provides business growth plan: new store openings by quarter…">
        <bpmn:documentation>Step 1: FP&amp;A Manager provides business growth plan: new store openings by quarter, revenue targets by region, capex plan for new locations, and projected channel mix shifts
Responsible (R): FP&amp;A Manager
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W645_Flow19</bpmn:incoming>
        <bpmn:outgoing>W645_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W645_Task9" name="VP Store Operations provides new store staffing requirements: 29 positions per…">
        <bpmn:documentation>Step 2: VP Store Operations provides new store staffing requirements: 29 positions per new store (per company profile); ramp curve (Month 1: 80% staffing, Month 3: 100%); geographic distribution of new stores
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W645_Flow20</bpmn:incoming>
        <bpmn:outgoing>W645_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W645_Task10" name="VP Supply Chain provides DC and logistics headcount requirements: new DC…">
        <bpmn:documentation>Step 3: VP Supply Chain provides DC and logistics headcount requirements: new DC activation plans, DC expansion staffing, fleet expansion requirements
Responsible (R): VP Supply Chain
Accountable (A): COO
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W645_Flow21</bpmn:incoming>
        <bpmn:outgoing>W645_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W645_Task11" name="HR Manager analyzes current workforce supply: headcount by entity, location…">
        <bpmn:documentation>Step 4: HR Manager analyzes current workforce supply: headcount by entity, location, department, job family, and employment type; identifies retirement eligibility within 12 months; analyzes turnover trends by location and department (W628 data); assesses internal pipeline from succession plans (W178) and cadetship (W179)
Responsible (R): HR Manager
Accountable (A): CHRO
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W645_Flow22</bpmn:incoming>
        <bpmn:outgoing>W645_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W645_Task12" name="HR Manager performs gap analysis: demand (steps 1–3) minus supply (step 4) =…">
        <bpmn:documentation>Step 5: HR Manager performs gap analysis: demand (steps 1–3) minus supply (step 4) = hiring gap by role, location, and quarter; identifies critical roles with longest time-to-fill; quantifies headcount shortfall by entity
Responsible (R): HR Manager
Accountable (A): CHRO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W645_Flow23</bpmn:incoming>
        <bpmn:outgoing>W645_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W645_Task13" name="HR Manager develops hiring plan: recruitment volume by role and quarter…">
        <bpmn:documentation>Step 6: HR Manager develops hiring plan: recruitment volume by role and quarter; identifies sourcing channels (campus, referral, agency, direct); estimates recruitment budget (job board fees, agency fees, relocation costs, training costs per W51); proposes seasonal staffing plan (W555)
Responsible (R): HR Manager
Accountable (A): CHRO
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W645_Flow24</bpmn:incoming>
        <bpmn:outgoing>W645_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W645_Task14" name="CHRO presents workforce plan and budget to CEO and CFO for approval; integrates…">
        <bpmn:documentation>Step 7: CHRO presents workforce plan and budget to CEO and CFO for approval; integrates with annual operating budget (W26) and capex plan (W21)
Responsible (R): CHRO
Accountable (A): CEO
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W645_Flow25</bpmn:incoming>
        <bpmn:outgoing>W645_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W645_Task15" name="Monthly: HR Manager tracks actual hiring vs. plan; flags gaps to CHRO with…">
        <bpmn:documentation>Step 8: Monthly: HR Manager tracks actual hiring vs. plan; flags gaps to CHRO with corrective action recommendations (accelerate recruitment, redeploy from other locations, adjust new store timeline)
Responsible (R): HR Manager
Accountable (A): CHRO
Duration: 0.5 day/month</bpmn:documentation>
        <bpmn:incoming>W645_Flow26</bpmn:incoming>
        <bpmn:outgoing>W645_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W645_End16" name="Complete">
        <bpmn:incoming>W645_Flow27</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W645_Annotation17">
        <bpmn:text>Controls: - CTL-298 (ensure controlled execution — Workforce Management (PA-19.3).) | - operational: CHRO annual workforce-plan approval gate; monthly actual-vs-plan review by HR Manager; integration with annual operating budget (W26) for headcount-cost consistency | ---
Owner: HR Manager (Workforce Planning)</bpmn:text>
      </bpmn:textAnnotation>
