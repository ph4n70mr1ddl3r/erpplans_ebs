    <bpmn:process id="W_W1410" name="W1410. Store Employee Inter-Location Transfer Processing, Labor Cost Reallocation &amp; Benefit Continuity" isExecutable="false">
      <bpmn:documentation>Trigger: Employee transfer request (employee-initiated or management-initiated); or operational need (new store opening staffed from existing stores, underperforming store excess headcount redistributed, regional manager restructuring)
Frequency: ~100–200 transfers/year (driven by 10–15 new store openings/year each requiring 5–8 transfers from nearby stores + ad-hoc transfers for performance, personal, or operational reasons)
Volume: ~10–15 transfers/month chain-wide; spikes to ~50–75/month during new store opening periods
Owner: HR Manager
Participants: HR Manager, HR Assistant, Sending Store Manager, Receiving Store Manager, Regional Manager, Payroll Officer, IT Helpdesk
Source: workflow W1410 — Store Employee Inter-Location Transfer Processing, Labor Cost Reallocation &amp; Benefit Continuity</bpmn:documentation>
      <bpmn:laneSet id="W1410_LaneSet8">
        <bpmn:lane id="W1410_Lane1" name="Employee">
        <bpmn:flowNodeRef>W1410_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1410_Start9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1410_Lane2" name="HR Manager">
        <bpmn:flowNodeRef>W1410_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1410_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1410_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1410_Lane3" name="HR Assistant">
        <bpmn:flowNodeRef>W1410_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1410_Task19</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1410_Lane4" name="Payroll Officer">
        <bpmn:flowNodeRef>W1410_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1410_Lane5" name="IT Helpdesk">
        <bpmn:flowNodeRef>W1410_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1410_Lane6" name="Receiving Store Manager">
        <bpmn:flowNodeRef>W1410_Task17</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1410_Lane7" name="Sending Store Manager">
        <bpmn:flowNodeRef>W1410_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1410_End20</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1410_Start9" name="Employee transfer request (employee-initiated or management-initiated); or operational…">
        <bpmn:outgoing>W1410_Flow23</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1410_Task10" name="Employee-initiated">
        <bpmn:documentation>Step 1: Transfer request initiated: (a) Employee-initiated: employee submits transfer request via HR portal stating desired location and reason; (b) Management-initiated: Regional Manager or HR identifies need for transfer (new store staffing, performance management, headcount rebalancing); request documented in HR system with justification
Responsible (R): Employee / Regional Manager
Accountable (A): HR Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1410_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1410_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1410_Task11" name="HR Manager reviews transfer request: (a) verifies employee is in good standing…">
        <bpmn:documentation>Step 2: HR Manager reviews transfer request: (a) verifies employee is in good standing (no active disciplinary actions, no pending investigation per W37), (b) confirms receiving store has headcount budget availability (within 29 FTE per store), (c) confirms receiving store has a vacant position matching the employee&#x27;s current role or a comparable role, (d) assesses impact on sending store (minimum staffing levels per W34 must be maintained), (e) for management-initiated transfers: verifies compliance with DOLE rules on transfer without diminution
Responsible (R): HR Manager
Accountable (A): Regional Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1410_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1410_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1410_Task12" name="If same-entity transfer (BuildRight Depot Inc. → BuildRight Depot Inc.): HR…">
        <bpmn:documentation>Step 3: If same-entity transfer (BuildRight Depot Inc. → BuildRight Depot Inc.): HR Manager sends transfer approval to both Store Managers; Sending Store Manager prepares handover checklist (assigned tasks, open issues, department-specific knowledge); Receiving Store Manager prepares onboarding plan for the new location
Responsible (R): HR Manager
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1410_Flow25</bpmn:incoming>
        <bpmn:outgoing>W1410_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1410_Task13" name="If cross-entity transfer (e.g., BuildRight Depot Inc. → BuildRight Logistics…">
        <bpmn:documentation>Step 4: If cross-entity transfer (e.g., BuildRight Depot Inc. → BuildRight Logistics Inc.): HR processes as separation from original entity (W43) and rehire at new entity (W15); employee receives final pay from original entity with prorated 13th month pay (W644); new entity hires employee with fresh contract and seniority reset (or negotiated carryover per management discretion); statutory benefits (SSS, PhilHealth, Pag-IBIG) continue under same member number but employer ID changes
Responsible (R): HR Manager / Payroll Officer
Accountable (A): CHRO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W1410_Flow26</bpmn:incoming>
        <bpmn:outgoing>W1410_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1410_Task14" name="HR Assistant updates employee master record (W292): (a) same-entity transfer —…">
        <bpmn:documentation>Step 5: HR Assistant updates employee master record (W292): (a) same-entity transfer — change location assignment, update cost center from sending store to receiving store, update direct report line from sending Store Manager to receiving Store Manager, update shift schedule assignment per W34; (b) cross-entity — create new employee record in receiving entity, close original employee record with transfer reason code
Responsible (R): HR Assistant
Accountable (A): HR Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1410_Flow27</bpmn:incoming>
        <bpmn:outgoing>W1410_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1410_Task15" name="Payroll Officer updates payroll allocation: employee&#x27;s labor cost transfers…">
        <bpmn:documentation>Step 6: Payroll Officer updates payroll allocation: employee&#x27;s labor cost transfers from sending store&#x27;s cost center to receiving store&#x27;s cost center effective the transfer date; if mid-pay-period: prorate labor cost between stores for that semi-monthly run
Responsible (R): Payroll Officer
Accountable (A): HR Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1410_Flow28</bpmn:incoming>
        <bpmn:outgoing>W1410_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1410_Task16" name="IT Helpdesk updates system access per W152: (a) revoke sending store-specific…">
        <bpmn:documentation>Step 7: IT Helpdesk updates system access per W152: (a) revoke sending store-specific access (receiving dock system access, sending store shift schedule), (b) grant receiving store-specific access, (c) retain role-based ERP access (POS operator, stock associate, etc.), (d) update email distribution lists and store communication groups
Responsible (R): IT Helpdesk
Accountable (A): IT Security Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1410_Flow29</bpmn:incoming>
        <bpmn:outgoing>W1410_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1410_Task17" name="Employee reports to receiving store; Receiving Store Manager conducts…">
        <bpmn:documentation>Step 8: Employee reports to receiving store; Receiving Store Manager conducts orientation: store layout, local procedures, team introductions, assigned department, shift schedule confirmation; employee retains existing role, rank, and pay rate (no diminution per DOLE rules)
Responsible (R): Receiving Store Manager
Accountable (A): —
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W1410_Flow30</bpmn:incoming>
        <bpmn:outgoing>W1410_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1410_Task18" name="Sending Store Manager backfills the vacated position: (a) if transfer creates a…">
        <bpmn:documentation>Step 9: Sending Store Manager backfills the vacated position: (a) if transfer creates a vacancy, initiates recruitment per W15 (internal posting first, then external), (b) if temporary, arranges cross-training coverage from existing staff, (c) updates shift schedule per W34 to maintain coverage during vacancy
Responsible (R): Sending Store Manager
Accountable (A): Regional Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W1410_Flow31</bpmn:incoming>
        <bpmn:outgoing>W1410_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1410_Task19" name="30-day post-transfer check-in">
        <bpmn:documentation>Step 10: 30-day post-transfer check-in: HR Assistant contacts transferred employee and receiving Store Manager to assess transfer success; documents any issues (role mismatch, cultural fit, commute challenges); if issues identified, HR Manager mediates resolution
Responsible (R): HR Assistant / HR Manager
Accountable (A): Regional Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1410_Flow32</bpmn:incoming>
        <bpmn:outgoing>W1410_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1410_End20" name="Complete">
        <bpmn:incoming>W1410_Flow33</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1410_Annotation21">
        <bpmn:text>Controls: - CTL-298 (ensure controlled execution — Workforce Management (PA-19.3).) | - operational: HR Manager review and approval gate
Owner: HR Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1410_Assoc22" sourceRef="W1410_Annotation21" targetRef="W1410_Start9" associationDirection="None" />
      <bpmn:sequenceFlow id="W1410_Flow23" sourceRef="W1410_Start9" targetRef="W1410_Task10" />
      <bpmn:sequenceFlow id="W1410_Flow24" sourceRef="W1410_Task10" targetRef="W1410_Task11" />
      <bpmn:sequenceFlow id="W1410_Flow25" sourceRef="W1410_Task11" targetRef="W1410_Task12" />
