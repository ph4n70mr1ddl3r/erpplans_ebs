<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-19.3-workforce-management" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W34" name="W34. Store Shift Scheduling" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly schedule creation cycle
Frequency: Weekly per store; published 1 week in advance
Volume: ~29 staff × 200 stores = ~5,800 weekly shift assignments (per profile §4); 2–3 shifts per day (opening: 7 AM–2 PM, mid: 10 AM–6 PM, closing: 2 PM–10 PM)
Owner: Store Manager
Participants: Store Manager, Assistant Store Manager, Department Supervisors, HR Assistant, Timekeeping &amp; Attendance Analyst
Source: workflow W34 — Store Shift Scheduling</bpmn:documentation>
      <bpmn:laneSet id="W34_LaneSet6">
        <bpmn:lane id="W34_Lane1" name="System">
        <bpmn:flowNodeRef>W34_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W34_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W34_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W34_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W34_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W34_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W34_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W34_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W34_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W34_Lane3" name="Dept. Supervisor">
        <bpmn:flowNodeRef>W34_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W34_Lane4" name="Employee">
        <bpmn:flowNodeRef>W34_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W34_Lane5" name="Regional Manager">
        <bpmn:flowNodeRef>W34_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W34_End18</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W34_Start7" name="Weekly schedule creation cycle">
        <bpmn:outgoing>W34_Flow21</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W34_Task8" name="System generates draft schedule based on: (a) store operating hours, (b)…">
        <bpmn:documentation>Step 1: System generates draft schedule based on: (a) store operating hours, (b) staffing model per shift (min cashiers, floor associates, receiving), (c) historical sales volume by day and hour, (d) approved leave requests, (e) labor budget (max hours per employee per week)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W34_Flow21</bpmn:incoming>
        <bpmn:outgoing>W34_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W34_Task9" name="Store Manager reviews draft schedule; adjusts for: expected delivery days (DSD…">
        <bpmn:documentation>Step 2: Store Manager reviews draft schedule; adjusts for: expected delivery days (DSD receiving), upcoming promotions, special events, employee skill mix per shift
Responsible (R): Store Manager
Accountable (A): VP Store Operations
Duration: 1 hour/week</bpmn:documentation>
        <bpmn:incoming>W34_Flow22</bpmn:incoming>
        <bpmn:outgoing>W34_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W34_Task10" name="Department Supervisors review shift assignments for their departments; flag…">
        <bpmn:documentation>Step 3: Department Supervisors review shift assignments for their departments; flag conflicts or coverage gaps
Responsible (R): Dept. Supervisor
Accountable (A): Store Manager
Duration: 30 min/week</bpmn:documentation>
        <bpmn:incoming>W34_Flow23</bpmn:incoming>
        <bpmn:outgoing>W34_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W34_Task11" name="Store Manager finalizes and publishes schedule in system; employees receive…">
        <bpmn:documentation>Step 4: Store Manager finalizes and publishes schedule in system; employees receive notification (mobile app, SMS, or bulletin board)
Responsible (R): Store Manager
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W34_Flow24</bpmn:incoming>
        <bpmn:outgoing>W34_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W34_Task12" name="Employee views schedule; submits swap requests to Store Manager if needed">
        <bpmn:documentation>Step 5: Employee views schedule; submits swap requests to Store Manager if needed
Responsible (R): Employee
Accountable (A): —
Duration: Self-service</bpmn:documentation>
        <bpmn:incoming>W34_Flow25</bpmn:incoming>
        <bpmn:outgoing>W34_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W34_Task13" name="Store Manager approves or denies shift swap requests; updates schedule">
        <bpmn:documentation>Step 6: Store Manager approves or denies shift swap requests; updates schedule
Responsible (R): Store Manager
Accountable (A): —
Duration: 15 min/week</bpmn:documentation>
        <bpmn:incoming>W34_Flow26</bpmn:incoming>
        <bpmn:outgoing>W34_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W34_Task14" name="During the week: if unplanned absence (sick leave, emergency): Store Manager…">
        <bpmn:documentation>Step 7: During the week: if unplanned absence (sick leave, emergency): Store Manager activates contingency (call in off-duty employee, redistribute floor staff, cover cashier shift personally)
Responsible (R): Store Manager
Accountable (A): —
Duration: Ad hoc</bpmn:documentation>
        <bpmn:incoming>W34_Flow27</bpmn:incoming>
        <bpmn:outgoing>W34_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W34_Task15" name="System tracks actual hours worked (biometric/RFID clock-in/out) vs. scheduled…">
        <bpmn:documentation>Step 8: System tracks actual hours worked (biometric/RFID clock-in/out) vs. scheduled hours; flags overtime and undertime
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W34_Flow28</bpmn:incoming>
        <bpmn:outgoing>W34_Flow29</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W34_Task16" name="Weekly: Store Manager reviews schedule adherence report; adjusts next week&#x27;s…">
        <bpmn:documentation>Step 9: Weekly: Store Manager reviews schedule adherence report; adjusts next week&#x27;s plan based on actuals
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 15 min/week</bpmn:documentation>
        <bpmn:incoming>W34_Flow29</bpmn:incoming>
        <bpmn:outgoing>W34_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W34_Task17" name="Monthly: Regional Manager reviews overtime hours per store vs. labor budget…">
        <bpmn:documentation>Step 10: Monthly: Regional Manager reviews overtime hours per store vs. labor budget; flags stores consistently exceeding targets
Responsible (R): Regional Manager
Accountable (A): VP Store Operations
Duration: 2 hours/month (across 50 stores)</bpmn:documentation>
        <bpmn:incoming>W34_Flow30</bpmn:incoming>
        <bpmn:outgoing>W34_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W34_End18" name="Complete">
        <bpmn:incoming>W34_Flow31</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W34_Annotation19">
        <bpmn:text>Controls: - CTL-298 (ensure controlled execution — Workforce Management (PA-19.3).)
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W34_Assoc20" sourceRef="W34_Annotation19" targetRef="W34_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W34_Flow21" sourceRef="W34_Start7" targetRef="W34_Task8" />
