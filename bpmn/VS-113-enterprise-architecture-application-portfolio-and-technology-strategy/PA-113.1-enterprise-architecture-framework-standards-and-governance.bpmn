        <bpmndi:BPMNShape id="W3570_Start3_di" bpmnElement="W3570_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3570_End7_di" bpmnElement="W3570_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3570_Annotation8_di" bpmnElement="W3570_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3570_Flow10_di" bpmnElement="W3570_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3570_Flow11_di" bpmnElement="W3570_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3570_Flow12_di" bpmnElement="W3570_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3570_Flow13_di" bpmnElement="W3570_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3570_Assoc9_di" bpmnElement="W3570_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3571" name="W3571. Architecture Review Board &amp; Solution Architecture Review" isExecutable="false">
      <bpmn:documentation>Trigger: New initiative/project intake (links to VS-112/W3546); significant change request
Frequency: Per project + recurring ARB cycle
Volume: All in-flight and proposed initiatives
Owner: Architecture Review Board (ARB)
Participants: ARB (Chief Enterprise Architect + Domain Architects + Security links to VS-27.3 + Data links to VS-28.2), Project/Solution Architects, PMO (links to VS-112), Sponsor, IT Operations (links to VS-27.1)
Source: workflow W3571 — Architecture Review Board &amp; Solution Architecture Review</bpmn:documentation>
      <bpmn:laneSet id="W3571_LaneSet3">
        <bpmn:lane id="W3571_Lane1" name="Solution Architect">
        <bpmn:flowNodeRef>W3571_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3571_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3571_Lane2" name="ARB">
        <bpmn:flowNodeRef>W3571_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3571_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3571_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3571_Start4" name="New initiative/project intake (links to VS-112/W3546); significant change request">
        <bpmn:outgoing>W3571_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3571_Task5" name="Solution Architect/Project prepare the solution-architecture artifact for the…">
        <bpmn:documentation>Step 1: Solution Architect/Project prepare the solution-architecture artifact for the initiative: business context, requirements, proposed solution (applications, integration, data, deployment, security), alignment to principles/reference-architectures (W3570) and standards (W3572), alternatives considered, and risks/assumptions; submit to ARB
Responsible (R): Solution Architect / Project
Accountable (A): Chief Enterprise Architect
Duration: Per initiative</bpmn:documentation>
        <bpmn:incoming>W3571_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3571_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3571_Task6" name="ARB review the solution architecture: principle/standard conformance…">
        <bpmn:documentation>Step 2: ARB review the solution architecture: principle/standard conformance (W3570/W3572), reuse vs. build/buy, integration approach (W3579), data implications (W3581), security posture (W3583), operational readiness (links to VS-27.1), and total cost (links to W3588); decision — approve, approve-with-conditions, revise, or reject; capture conditions and waivers (W3573)
Responsible (R): ARB
Accountable (A): Chief Enterprise Architect
Duration: Per initiative</bpmn:documentation>
        <bpmn:incoming>W3571_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3571_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3571_Task7" name="ARB/Solution Architect track conformance to the approved architecture through…">
        <bpmn:documentation>Step 3: ARB/Solution Architect track conformance to the approved architecture through delivery (links to VS-112/W3554), capture deviations and waivers (W3573), update the repository (W3575) and reference architectures (W3570) with learnings, and feed maturity/CI (W3576)
Responsible (R): ARB / Solution Architect
Accountable (A): Chief Enterprise Architect
Duration: Initiative life</bpmn:documentation>
        <bpmn:incoming>W3571_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3571_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3571_End8" name="Complete">
        <bpmn:incoming>W3571_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3571_Annotation9">
        <bpmn:text>Controls: - CTL-568 (ensure controlled execution — Enterprise Architecture Framework, Standards &amp; Governance (PA-113.1).) | - operational: clear criteria and quorum; operational: tiered review (light for minor, full for major) and cadence
Owner: Architecture Review Board (ARB)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3571_Assoc10" sourceRef="W3571_Annotation9" targetRef="W3571_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3571_Flow11" sourceRef="W3571_Start4" targetRef="W3571_Task5" />
      <bpmn:sequenceFlow id="W3571_Flow12" sourceRef="W3571_Task5" targetRef="W3571_Task6" />
      <bpmn:sequenceFlow id="W3571_Flow13" sourceRef="W3571_Task6" targetRef="W3571_Task7" />
      <bpmn:sequenceFlow id="W3571_Flow14" sourceRef="W3571_Task7" targetRef="W3571_End8" />
    </bpmn:process>
