<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-113.2-application-portfolio-integration-and-solution-architecture" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3577" name="W3577. Application Portfolio Management &amp; Rationalization" isExecutable="false">
      <bpmn:documentation>Trigger: Annual portfolio review; strategy/roadmap change; acquisition/decommission
Frequency: Annual + on change
Volume: Enterprise application portfolio (~ERP + ~20–40 surrounding applications)
Owner: Enterprise Architects
Participants: Enterprise Architects, Application Owners, Business Capability Owners, IT Operations (links to VS-27), ITAM (links to VS-99), Finance (links to VS-17.4), Procurement (links to VS-34), BI (links to VS-28.1)
Source: workflow W3577 — Application Portfolio Management &amp; Rationalization</bpmn:documentation>
      <bpmn:laneSet id="W3577_LaneSet2">
        <bpmn:lane id="W3577_Lane1" name="Enterprise Architects">
        <bpmn:flowNodeRef>W3577_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3577_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3577_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3577_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3577_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3577_Start3" name="Annual portfolio review; strategy/roadmap change; acquisition/decommission">
        <bpmn:outgoing>W3577_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3577_Task4" name="Enterprise Architects/Application Owners maintain the application portfolio…">
        <bpmn:documentation>Step 1: Enterprise Architects/Application Owners maintain the application portfolio inventory: each application&#x27;s business capability, owner, business value, cost (TCO links to VS-99.3/W3588), technology/health, risk, usage, integrations (links to W3579), and lifecycle stage; reconcile to discovery/CMDB (links to VS-99/VS-27.2) and SaaS estate (links to VS-99.2)
Responsible (R): Enterprise Architects / Application Owners
Accountable (A): Chief Enterprise Architect
Duration: Continuous + annual</bpmn:documentation>
        <bpmn:incoming>W3577_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3577_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3577_Task5" name="Enterprise Architects assess each application on a TIME matrix (Tolerate /…">
        <bpmn:documentation>Step 2: Enterprise Architects assess each application on a TIME matrix (Tolerate / Invest / Migrate / Eliminate) using business value vs. technical-health: identify duplicates/overlaps, under-used applications, end-of-life risks, consolidation opportunities, and cloud/SaaS migration candidates; produce the rationalization roadmap
Responsible (R): Enterprise Architects / Finance
Accountable (A): Chief Enterprise Architect
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3577_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3577_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3577_Task6" name="Enterprise Architects/IT Leadership execute the rationalization roadmap via the…">
        <bpmn:documentation>Step 3: Enterprise Architects/IT Leadership execute the rationalization roadmap via the PMO (links to VS-112/W3546), retire applications (W3578), consolidate/merge duplicates, and report portfolio health/cost/reduction to governance (W3592) and finance (links to VS-17.4); refresh the portfolio annually
Responsible (R): Enterprise Architects / IT Leadership / PMO
Accountable (A): CIO
Duration: Annual + ongoing</bpmn:documentation>
        <bpmn:incoming>W3577_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3577_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3577_End7" name="Complete">
        <bpmn:incoming>W3577_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3577_Annotation8">
        <bpmn:text>Controls: - CTL-569 (ensure controlled execution — Application Portfolio, Integration &amp; Solution Architecture (PA-113.2).) | - operational: TIME rationalization; operational: ownership discipline and retirement
Owner: Enterprise Architects</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3577_Assoc9" sourceRef="W3577_Annotation8" targetRef="W3577_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3577_Flow10" sourceRef="W3577_Start3" targetRef="W3577_Task4" />
      <bpmn:sequenceFlow id="W3577_Flow11" sourceRef="W3577_Task4" targetRef="W3577_Task5" />
      <bpmn:sequenceFlow id="W3577_Flow12" sourceRef="W3577_Task5" targetRef="W3577_Task6" />
      <bpmn:sequenceFlow id="W3577_Flow13" sourceRef="W3577_Task6" targetRef="W3577_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3577_diag">
      <bpmndi:BPMNPlane id="W3577_plane" bpmnElement="W_W3577">
        <bpmndi:BPMNShape id="W3577_Lane1_di" bpmnElement="W3577_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3577_Task4_di" bpmnElement="W3577_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3577_Task5_di" bpmnElement="W3577_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3577_Task6_di" bpmnElement="W3577_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3577_Start3_di" bpmnElement="W3577_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3577_End7_di" bpmnElement="W3577_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3577_Annotation8_di" bpmnElement="W3577_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
