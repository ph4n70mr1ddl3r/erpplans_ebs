        <bpmndi:BPMNEdge id="W3577_Flow11_di" bpmnElement="W3577_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3577_Flow12_di" bpmnElement="W3577_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3577_Flow13_di" bpmnElement="W3577_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3577_Assoc9_di" bpmnElement="W3577_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3578" name="W3578. Application Lifecycle, Retirement &amp; Technical Debt Management" isExecutable="false">
      <bpmn:documentation>Trigger: End-of-life/support; rationalization (W3577); accumulated waivers (W3573)
Frequency: Per application + continuous debt management
Volume: Enterprise applications + technical-debt backlog
Owner: Enterprise Architects / Application Owners
Participants: Enterprise Architects, Application Owners, IT Operations (links to VS-27.1), ITAM (links to VS-99), PMO (links to VS-112), Finance (links to VS-17.4), Security (links to VS-27.3)
Source: workflow W3578 — Application Lifecycle, Retirement &amp; Technical Debt Management</bpmn:documentation>
      <bpmn:laneSet id="W3578_LaneSet2">
        <bpmn:lane id="W3578_Lane1" name="Enterprise Architects">
        <bpmn:flowNodeRef>W3578_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3578_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3578_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3578_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3578_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3578_Start3" name="End-of-life/support; rationalization (W3577); accumulated waivers (W3573)">
        <bpmn:outgoing>W3578_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3578_Task4" name="Enterprise Architects/Application Owners manage the application lifecycle…">
        <bpmn:documentation>Step 1: Enterprise Architects/Application Owners manage the application lifecycle: version/upgrade cadence, end-of-support monitoring, dependency mapping (links to W3579), migration/upgrade planning, and sunset criteria; align to the ATL (W3572) and roadmap (W3585)
Responsible (R): Enterprise Architects / Application Owners
Accountable (A): Chief Enterprise Architect
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3578_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3578_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3578_Task5" name="Enterprise Architects maintain the technical-debt register: sources (waivers…">
        <bpmn:documentation>Step 2: Enterprise Architects maintain the technical-debt register: sources (waivers W3573, deferred upgrades, workarounds, legacy patterns, knowledge gaps), impact (cost, risk, velocity, security), and remediation cost; prioritize by risk/value and sequence into the roadmap (W3585) and PMO (links to VS-112)
Responsible (R): Enterprise Architects
Accountable (A): Chief Enterprise Architect
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3578_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3578_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3578_Task6" name="Enterprise Architects/Application Owners execute application…">
        <bpmn:documentation>Step 3: Enterprise Architects/Application Owners execute application retirement/decommission: data extraction/migration/archive (links to VS-88/VS-28.2), integration retirement (W3579), user migration, license/SAM closeout (links to VS-99.2), secure disposal (links to VS-99.1), and service handoff; validate no orphaned integrations or data
Responsible (R): Enterprise Architects / Application Owners / ITAM
Accountable (A): CIO
Duration: Per retirement</bpmn:documentation>
        <bpmn:incoming>W3578_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3578_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3578_End7" name="Complete">
        <bpmn:incoming>W3578_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3578_Annotation8">
        <bpmn:text>Controls: - CTL-569 (ensure controlled execution — Application Portfolio, Integration &amp; Solution Architecture (PA-113.2).) | - operational: lifecycle discipline and sunset criteria; operational: debt register and prioritized remediation
Owner: Enterprise Architects / Application Owners</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3578_Assoc9" sourceRef="W3578_Annotation8" targetRef="W3578_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3578_Flow10" sourceRef="W3578_Start3" targetRef="W3578_Task4" />
      <bpmn:sequenceFlow id="W3578_Flow11" sourceRef="W3578_Task4" targetRef="W3578_Task5" />
      <bpmn:sequenceFlow id="W3578_Flow12" sourceRef="W3578_Task5" targetRef="W3578_Task6" />
      <bpmn:sequenceFlow id="W3578_Flow13" sourceRef="W3578_Task6" targetRef="W3578_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3578_diag">
      <bpmndi:BPMNPlane id="W3578_plane" bpmnElement="W_W3578">
        <bpmndi:BPMNShape id="W3578_Lane1_di" bpmnElement="W3578_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3578_Task4_di" bpmnElement="W3578_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3578_Task5_di" bpmnElement="W3578_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3578_Task6_di" bpmnElement="W3578_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3578_Start3_di" bpmnElement="W3578_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3578_End7_di" bpmnElement="W3578_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3578_Annotation8_di" bpmnElement="W3578_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3578_Flow10_di" bpmnElement="W3578_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3578_Flow11_di" bpmnElement="W3578_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3578_Flow12_di" bpmnElement="W3578_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3578_Flow13_di" bpmnElement="W3578_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3578_Assoc9_di" bpmnElement="W3578_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3579" name="W3579. Integration Architecture &amp; API Strategy" isExecutable="false">
      <bpmn:documentation>Trigger: New integration need; portfolio change (W3577); integration-failure/spaghetti analysis
Frequency: Per integration + strategy refresh
Volume: ~10+ active touchpoints (POS, ecommerce, payments, bank, BIR, SSS/PhilHealth/Pag-IBIG, delivery, loyalty, WMS, supplier portal) + internal
Owner: Enterprise Architects (Integration)
Participants: Enterprise Architects, Integration Developers, IT Operations (links to VS-27), Security (links to VS-27.3), Data Office (links to VS-28.2), Application Owners, PMO (links to VS-112)
Source: workflow W3579 — Integration Architecture &amp; API Strategy</bpmn:documentation>
      <bpmn:laneSet id="W3579_LaneSet2">
        <bpmn:lane id="W3579_Lane1" name="Enterprise Architects">
        <bpmn:flowNodeRef>W3579_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3579_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3579_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3579_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3579_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3579_Start3" name="New integration need; portfolio change (W3577); integration-failure/spaghetti analysis">
        <bpmn:outgoing>W3579_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3579_Task4" name="Enterprise Architects define the integration architecture and API strategy…">
        <bpmn:documentation>Step 1: Enterprise Architects define the integration architecture and API strategy: integration patterns (API-led, event-driven for POS/real-time links to model-company §14.3, batch/file for BIR/bank, real-time for loyalty/payment), the API gateway/management platform, the event bus/streaming platform, message formats/standards (JSON, EDI for some vendors), and the integration reference architecture (W3570)
Responsible (R): Enterprise Architects (Integration)
Accountable (A): Chief Enterprise Architect
Duration: Strategy + maintained</bpmn:documentation>
        <bpmn:incoming>W3579_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3579_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3579_Task5" name="Enterprise Architects maintain the integration inventory and contract catalog…">
        <bpmn:documentation>Step 2: Enterprise Architects maintain the integration inventory and contract catalog: each integration&#x27;s source/target, pattern, protocol, data, SLA, owner, monitoring, and dependency (links to W3577); identify point-to-point sprawl, redundant integrations, and fragile patterns; rationalize to the standard
Responsible (R): Enterprise Architects / Integration Developers
Accountable (A): Chief Enterprise Architect
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3579_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3579_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3579_Task6" name="Enterprise Architects/Integration Developers design and review each new…">
        <bpmn:documentation>Step 3: Enterprise Architects/Integration Developers design and review each new integration via the ARB (W3571): contract-first/API design, security (links to VS-27.3), error/retry/idempotency, observability (links to VS-27.1), and alignment to reference patterns; retire legacy point-to-point as part of rationalization
Responsible (R): Enterprise Architects / Integration Developers
Accountable (A): Chief Enterprise Architect
Duration: Per integration</bpmn:documentation>
        <bpmn:incoming>W3579_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3579_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3579_End7" name="Complete">
        <bpmn:incoming>W3579_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3579_Annotation8">
        <bpmn:text>Controls: - CTL-569 (ensure controlled execution — Application Portfolio, Integration &amp; Solution Architecture (PA-113.2).) | - operational: API-led patterns and rationalization; operational: event-driven architecture and observability
Owner: Enterprise Architects (Integration)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3579_Assoc9" sourceRef="W3579_Annotation8" targetRef="W3579_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3579_Flow10" sourceRef="W3579_Start3" targetRef="W3579_Task4" />
      <bpmn:sequenceFlow id="W3579_Flow11" sourceRef="W3579_Task4" targetRef="W3579_Task5" />
      <bpmn:sequenceFlow id="W3579_Flow12" sourceRef="W3579_Task5" targetRef="W3579_Task6" />
      <bpmn:sequenceFlow id="W3579_Flow13" sourceRef="W3579_Task6" targetRef="W3579_End7" />
    </bpmn:process>
