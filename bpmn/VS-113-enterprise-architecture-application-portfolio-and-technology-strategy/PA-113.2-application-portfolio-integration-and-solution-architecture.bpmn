      <bpmndi:BPMNPlane id="W3579_plane" bpmnElement="W_W3579">
        <bpmndi:BPMNShape id="W3579_Lane1_di" bpmnElement="W3579_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3579_Task4_di" bpmnElement="W3579_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3579_Task5_di" bpmnElement="W3579_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3579_Task6_di" bpmnElement="W3579_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3579_Start3_di" bpmnElement="W3579_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3579_End7_di" bpmnElement="W3579_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3579_Annotation8_di" bpmnElement="W3579_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3579_Flow10_di" bpmnElement="W3579_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3579_Flow11_di" bpmnElement="W3579_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3579_Flow12_di" bpmnElement="W3579_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3579_Flow13_di" bpmnElement="W3579_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3579_Assoc9_di" bpmnElement="W3579_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3580" name="W3580. Solution Architecture for New Initiatives &amp; Projects" isExecutable="false">
      <bpmn:documentation>Trigger: Project intake/approval (links to VS-112/W3546–W3551)
Frequency: Per initiative
Volume: All PMO-portfolio projects (capex + transformation + IT + regulatory)
Owner: Solution Architect
Participants: Solution Architect, Enterprise Architects, Business Sponsor, PMO (links to VS-112), Security (links to VS-27.3), Data (links to VS-28.2), IT Operations (links to VS-27.1), ITAM (links to VS-99), Vendor Mgmt (links to VS-03/VS-34)
Source: workflow W3580 — Solution Architecture for New Initiatives &amp; Projects</bpmn:documentation>
      <bpmn:laneSet id="W3580_LaneSet2">
        <bpmn:lane id="W3580_Lane1" name="Solution Architect">
        <bpmn:flowNodeRef>W3580_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3580_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3580_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3580_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3580_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3580_Start3" name="Project intake/approval (links to VS-112/W3546–W3551)">
        <bpmn:outgoing>W3580_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3580_Task4" name="Solution Architect engage the initiative at intake (links to VS-112/W3546)…">
        <bpmn:documentation>Step 1: Solution Architect engage the initiative at intake (links to VS-112/W3546): understand business outcomes, requirements, constraints, and success criteria; align to strategy (links to VS-33), capabilities (W3570), and the portfolio (W3577); determine the architecture effort/tier
Responsible (R): Solution Architect
Accountable (A): Chief Enterprise Architect
Duration: Per initiative</bpmn:documentation>
        <bpmn:incoming>W3580_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3580_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3580_Task5" name="Solution Architect develop the solution architecture: options…">
        <bpmn:documentation>Step 2: Solution Architect develop the solution architecture: options (build/buy/reuse), applications/integration/data/deployment/security design, alignment to principles/standards/reference architectures (W3570/W3572), reuse of existing capabilities, total cost (links to W3588), risks/assumptions, and the operations handoff plan (links to VS-27.1)
Responsible (R): Solution Architect / Enterprise Architects
Accountable (A): Chief Enterprise Architect
Duration: Per initiative</bpmn:documentation>
        <bpmn:incoming>W3580_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3580_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3580_Task6" name="Solution Architect present to the ARB for review (W3571), capture…">
        <bpmn:documentation>Step 3: Solution Architect present to the ARB for review (W3571), capture approval/conditions/waivers (W3573), support delivery (links to VS-112/W3554) ensuring conformance, and hand off to operations (links to VS-27.1) and ITAM (links to VS-99) at closure (links to VS-112/W3560); update the repository (W3575)
Responsible (R): Solution Architect
Accountable (A): Chief Enterprise Architect
Duration: Initiative life</bpmn:documentation>
        <bpmn:incoming>W3580_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3580_Flow13</bpmn:outgoing>
      </bpmn:userTask>
