        <bpmndi:BPMNShape id="W3594_Start3_di" bpmnElement="W3594_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3594_End7_di" bpmnElement="W3594_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
