        <bpmndi:BPMNShape id="W3595_Start3_di" bpmnElement="W3595_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3595_End7_di" bpmnElement="W3595_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3595_Annotation8_di" bpmnElement="W3595_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3595_Flow10_di" bpmnElement="W3595_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3595_Flow11_di" bpmnElement="W3595_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3595_Flow12_di" bpmnElement="W3595_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3595_Flow13_di" bpmnElement="W3595_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3595_Assoc9_di" bpmnElement="W3595_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3596" name="W3596. DG Regulatory Intelligence &amp; Compliance Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Regulatory monitoring cycle; regulatory change notice
Frequency: Continuous + quarterly review
Volume: Multi-regulator DG landscape
Owner: DG/Hazmat Compliance Officer / Compliance
Participants: DG/Hazmat Compliance Officer, Compliance/Regulatory (links to VS-22), Legal (links to VS-100.3), Government Affairs (links to VS-104), Import (links to VS-87), HSE (links to VS-24), Logistics (links to VS-06/VS-110)
Source: workflow W3596 — DG Regulatory Intelligence &amp; Compliance Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W3596_LaneSet2">
        <bpmn:lane id="W3596_Lane1" name="DG">
        <bpmn:flowNodeRef>W3596_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3596_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3596_Task6</bpmn:flowNodeRef>
