        <bpmndi:BPMNEdge id="W3594_Flow10_di" bpmnElement="W3594_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3594_Flow11_di" bpmnElement="W3594_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3594_Flow12_di" bpmnElement="W3594_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3594_Flow13_di" bpmnElement="W3594_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3594_Assoc9_di" bpmnElement="W3594_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3595" name="W3595. Hazmat Inventory, SDS &amp; Chemical Information Management" isExecutable="false">
      <bpmn:documentation>Trigger: SKU classification (W3594); SDS update; regulatory change
Frequency: Per SKU + maintained
Volume: ~3,000+ chemical/DG SKUs with SDS
Owner: DG/Hazmat Compliance Officer / Quality
Participants: DG/Hazmat Compliance Officer, Quality (links to VS-31), HSE (links to VS-24.3), Merchandising (links to VS-01), Master Data (links to VS-29), Supplier, Store/DC Operations
Source: workflow W3595 — Hazmat Inventory, SDS &amp; Chemical Information Management</bpmn:documentation>
      <bpmn:laneSet id="W3595_LaneSet2">
        <bpmn:lane id="W3595_Lane1" name="DG">
        <bpmn:flowNodeRef>W3595_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3595_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3595_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3595_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3595_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3595_Start3" name="SKU classification (W3594); SDS update; regulatory change">
        <bpmn:outgoing>W3595_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3595_Task4" name="DG/Hazmat Compliance Officer/Quality obtain and maintain the Safety Data Sheet…">
        <bpmn:documentation>Step 1: DG/Hazmat Compliance Officer/Quality obtain and maintain the Safety Data Sheet (SDS) for each chemical/DG SKU: GHS-compliant SDS (16-section), hazard identification, composition, first-aid, fire-fighting, accidental-release, handling/storage, exposure/PPE, stability, toxicology, ecological, disposal, transport (links to W3594), regulatory; multi-language where imported; supplier-sourced
Responsible (R): DG/Hazmat Compliance Officer / Quality / Supplier
Accountable (A): DG/Hazmat Compliance Officer
Duration: Per SKU + maintained</bpmn:documentation>
        <bpmn:incoming>W3595_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3595_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3595_Task5" name="DG/Hazmat Compliance Officer/HSE maintain the chemical inventory and register…">
        <bpmn:documentation>Step 2: DG/Hazmat Compliance Officer/HSE maintain the chemical inventory and register (DENR-EMB Chemical Inventory Report under RA 6969, Priority Chemical List where applicable), the SDS library (accessible to DC/store/workers links to VS-24.3), and the chemical information feed to transport/storage/ecommerce compliance; reconcile to the hazmat master (W3594)
Responsible (R): DG/Hazmat Compliance Officer / HSE
Accountable (A): DG/Hazmat Compliance Officer
Duration: Maintained</bpmn:documentation>
        <bpmn:incoming>W3595_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3595_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3595_Task6" name="DG/Hazmat Compliance Officer/Quality manage SDS updates on…">
        <bpmn:documentation>Step 3: DG/Hazmat Compliance Officer/Quality manage SDS updates on formulation/regulatory change, supplier SDS accuracy audit (links to VS-31/VS-67), and SDS availability/acknowledgement by workers (links to VS-24/W3597); report SDS coverage and gaps to governance (W3616)
Responsible (R): DG/Hazmat Compliance Officer / Quality
Accountable (A): DG/Hazmat Compliance Officer
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3595_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3595_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3595_End7" name="Complete">
        <bpmn:incoming>W3595_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3595_Annotation8">
        <bpmn:text>Controls: - CTL-571 (ensure controlled execution — DG Classification, Inventory &amp; Program Governance (PA-114.1).) | - operational: coverage KPIs and supplier obligation; operational: register and reporting discipline
Owner: DG/Hazmat Compliance Officer / Quality</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3595_Assoc9" sourceRef="W3595_Annotation8" targetRef="W3595_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3595_Flow10" sourceRef="W3595_Start3" targetRef="W3595_Task4" />
      <bpmn:sequenceFlow id="W3595_Flow11" sourceRef="W3595_Task4" targetRef="W3595_Task5" />
      <bpmn:sequenceFlow id="W3595_Flow12" sourceRef="W3595_Task5" targetRef="W3595_Task6" />
      <bpmn:sequenceFlow id="W3595_Flow13" sourceRef="W3595_Task6" targetRef="W3595_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3595_diag">
      <bpmndi:BPMNPlane id="W3595_plane" bpmnElement="W_W3595">
        <bpmndi:BPMNShape id="W3595_Lane1_di" bpmnElement="W3595_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3595_Task4_di" bpmnElement="W3595_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3595_Task5_di" bpmnElement="W3595_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
