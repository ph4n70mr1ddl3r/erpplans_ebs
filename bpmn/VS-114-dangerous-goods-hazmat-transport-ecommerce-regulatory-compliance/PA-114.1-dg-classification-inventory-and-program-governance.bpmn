        <bpmn:outgoing>W3597_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3597_Task4" name="DG/Hazmat Compliance Officer/HSE define DG training and certification…">
        <bpmn:documentation>Step 1: DG/Hazmat Compliance Officer/HSE define DG training and certification requirements by role: hazmat handler, DG driver (hazmat endorsement), DG shipper/consignor (IATA/IMDG certified), ecommerce DG packer, supervisor, and emergency responder; align to DOLE OSH and modal rules (IATA requires trained shippers)
Responsible (R): DG/Hazmat Compliance Officer / HSE
Accountable (A): VP Legal
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3597_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3597_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3597_Task5" name="DG/Hazmat Compliance Officer/L&amp;D deliver the DG training: classroom/e-learning…">
        <bpmn:documentation>Step 2: DG/Hazmat Compliance Officer/L&amp;D deliver the DG training: classroom/e-learning, hands-on handling/PPE (links to VS-24), spill response (W3611), documentation (W3602), and modal-specific (IMDG/IATA/ADR); certify and record completion; manage external certifications (IATA shipper, DENR-accredited training)
Responsible (R): DG/Hazmat Compliance Officer / L&amp;D
Accountable (A): VP Legal
Duration: Per role + recurring</bpmn:documentation>
        <bpmn:incoming>W3597_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3597_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3597_Task6" name="DG/Hazmat Compliance Officer/HSE maintain the DG training/competency register…">
        <bpmn:documentation>Step 3: DG/Hazmat Compliance Officer/HSE maintain the DG training/competency register, track certifications/expiry, manage refresher/re-certification, and audit competency coverage; feed gaps to L&amp;D (links to VS-19.3) and HR (links to VS-103); report to governance (W3616) and audit (links to VS-88)
Responsible (R): DG/Hazmat Compliance Officer / HSE / HR
Accountable (A): VP Legal
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3597_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3597_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3597_End7" name="Complete">
        <bpmn:incoming>W3597_Flow13</bpmn:incoming>
      </bpmn:endEvent>
