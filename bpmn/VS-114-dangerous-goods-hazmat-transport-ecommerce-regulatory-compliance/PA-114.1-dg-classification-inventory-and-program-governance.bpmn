    <bpmn:process id="W_W3600" name="W3600. DG Program Audit, Documentation &amp; Records" isExecutable="false">
      <bpmn:documentation>Trigger: Annual audit cycle; regulatory inspection; incident
Frequency: Annual + on inspection/incident
Volume: DG program and records
Owner: DG/Hazmat Compliance Officer / Audit
Participants: DG/Hazmat Compliance Officer, Audit (links to VS-21), Compliance (links to VS-22), Records (links to VS-88), HSE (links to VS-24), Logistics (links to VS-06), Legal (links to VS-100.3)
Source: workflow W3600 — DG Program Audit, Documentation &amp; Records</bpmn:documentation>
      <bpmn:laneSet id="W3600_LaneSet2">
        <bpmn:lane id="W3600_Lane1" name="DG">
