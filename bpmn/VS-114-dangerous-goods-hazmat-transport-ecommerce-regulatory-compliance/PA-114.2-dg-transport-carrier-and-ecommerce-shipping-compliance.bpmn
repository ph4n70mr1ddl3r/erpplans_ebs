<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-114.2-dg-transport-carrier-and-ecommerce-shipping-compliance" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3601" name="W3601. DG Transport Carrier Qualification &amp; Contracting" isExecutable="false">
      <bpmn:documentation>Trigger: Carrier sourcing (links to VS-110); DG carrier need; carrier performance review
Frequency: Per carrier + ongoing
Volume: DG-capable carriers (sea, air, road, last-mile)
Owner: DG/Hazmat Compliance Officer / Logistics
Participants: DG/Hazmat Compliance Officer, Logistics/Freight (links to VS-06/VS-110), Procurement (links to VS-34), HSE (links to VS-24), Legal (links to VS-100.3), Insurance (links to VS-26), Vendor Mgmt (links to VS-03)
Source: workflow W3601 — DG Transport Carrier Qualification &amp; Contracting</bpmn:documentation>
      <bpmn:laneSet id="W3601_LaneSet2">
        <bpmn:lane id="W3601_Lane1" name="DG">
        <bpmn:flowNodeRef>W3601_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3601_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3601_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3601_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3601_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3601_Start3" name="Carrier sourcing (links to VS-110); DG carrier need; carrier performance review">
        <bpmn:outgoing>W3601_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3601_Task4" name="DG/Hazmat Compliance Officer/Logistics define DG carrier qualification…">
        <bpmn:documentation>Step 1: DG/Hazmat Compliance Officer/Logistics define DG carrier qualification criteria: modal DG authorization (MARINA/Coast Guard sea, CAB air, LTFRB/DOTr road hazmat permit links to W3607), DG driver training/cert (W3597), DG equipment (placards, spill kits, PPE), DG insurance (links to VS-26), incident history, and capacity for BuildRight&#x27;s DG classes
Responsible (R): DG/Hazmat Compliance Officer / Logistics
Accountable (A): VP Supply Chain / VP Legal
Duration: Per carrier</bpmn:documentation>
        <bpmn:incoming>W3601_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3601_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3601_Task5" name="DG/Hazmat Compliance Officer/Logistics/Procurement qualify and contract DG…">
        <bpmn:documentation>Step 2: DG/Hazmat Compliance Officer/Logistics/Procurement qualify and contract DG carriers: due diligence, DG capability assessment, contract terms (DG scope, liability, insurance, documentation obligations, incident notification, sub-contracting rules), rate/surcharges (DG premium), and the DG service-level agreement; integrate to the carrier scorecard (links to VS-110/VS-67)
Responsible (R): DG/Hazmat Compliance Officer / Logistics / Procurement / Legal
Accountable (A): VP Supply Chain / VP Legal
Duration: Per carrier</bpmn:documentation>
        <bpmn:incoming>W3601_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3601_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3601_Task6" name="DG/Hazmat Compliance Officer/Logistics manage DG carrier performance: monitor…">
        <bpmn:documentation>Step 3: DG/Hazmat Compliance Officer/Logistics manage DG carrier performance: monitor compliance/incidents/documentation quality, conduct periodic re-qualification, manage the approved DG carrier list, and remove/replace non-compliant carriers; report DG carrier performance to governance (W3608)
Responsible (R): DG/Hazmat Compliance Officer / Logistics
Accountable (A): VP Supply Chain / VP Legal
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W3601_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3601_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3601_End7" name="Complete">
        <bpmn:incoming>W3601_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3601_Annotation8">
        <bpmn:text>Controls: - CTL-572 (ensure controlled execution — DG Transport, Carrier &amp; Ecommerce Shipping Compliance (PA-114.2).) | - operational: approved-list gating; operational: legal-reviewed DG terms
Owner: DG/Hazmat Compliance Officer / Logistics</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3601_Assoc9" sourceRef="W3601_Annotation8" targetRef="W3601_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3601_Flow10" sourceRef="W3601_Start3" targetRef="W3601_Task4" />
      <bpmn:sequenceFlow id="W3601_Flow11" sourceRef="W3601_Task4" targetRef="W3601_Task5" />
      <bpmn:sequenceFlow id="W3601_Flow12" sourceRef="W3601_Task5" targetRef="W3601_Task6" />
      <bpmn:sequenceFlow id="W3601_Flow13" sourceRef="W3601_Task6" targetRef="W3601_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3601_diag">
      <bpmndi:BPMNPlane id="W3601_plane" bpmnElement="W_W3601">
        <bpmndi:BPMNShape id="W3601_Lane1_di" bpmnElement="W3601_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3601_Task4_di" bpmnElement="W3601_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3601_Task5_di" bpmnElement="W3601_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3601_Task6_di" bpmnElement="W3601_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3601_Start3_di" bpmnElement="W3601_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3601_End7_di" bpmnElement="W3601_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3601_Annotation8_di" bpmnElement="W3601_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3601_Flow10_di" bpmnElement="W3601_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3601_Flow11_di" bpmnElement="W3601_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3601_Flow12_di" bpmnElement="W3601_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3601_Flow13_di" bpmnElement="W3601_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3601_Assoc9_di" bpmnElement="W3601_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3602" name="W3602. DG Transport Documentation &amp; Manifest Management" isExecutable="false">
      <bpmn:documentation>Trigger: DG shipment (inbound/inter-DC/store-replenishment/ecommerce/customer-delivery)
Frequency: Per DG shipment
Volume: All DG shipments (subset of ~6.5K receipts/month (~72K/year), ~50K replenishment orders/month, ~42.9K ecommerce orders/month)
Owner: DG Shipper / Logistics
Participants: DG Shipper (certified W3597), Logistics (links to VS-06/VS-110), DC Operations (links to VS-04), Ecommerce (links to VS-10), Import (links to VS-02.2), DG/Hazmat Compliance Officer, Carrier
Source: workflow W3602 — DG Transport Documentation &amp; Manifest Management</bpmn:documentation>
      <bpmn:laneSet id="W3602_LaneSet2">
        <bpmn:lane id="W3602_Lane1" name="DG Shipper">
        <bpmn:flowNodeRef>W3602_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3602_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3602_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3602_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3602_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3602_Start3" name="DG shipment (inbound/inter-DC/store-replenishment/ecommerce/customer-delivery)">
        <bpmn:outgoing>W3602_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3602_Task4" name="DG Shipper/Logistics prepare the DG transport documentation per shipment…">
        <bpmn:documentation>Step 1: DG Shipper/Logistics prepare the DG transport documentation per shipment: Shipper&#x27;s Declaration for Dangerous Goods (IATA air), DG manifest/multimodal DG form (IMDG sea), transport document (ADR road), the consignment detail (UN number, proper shipping name, class, packing group, quantity, packing instruction), and emergency-response telephone/reference; verify classification (W3594) and packaging/marking (W3598)
Responsible (R): DG Shipper / Logistics
Accountable (A): DG/Hazmat Compliance Officer
Duration: Per shipment</bpmn:documentation>
        <bpmn:incoming>W3602_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3602_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3602_Task5" name="DG Shipper/Logistics generate the load/vehicle manifest, placarding plan…">
        <bpmn:documentation>Step 2: DG Shipper/Logistics generate the load/vehicle manifest, placarding plan (placards per transport unit per class), segregation/compatibility check (incompatible DG separated), and the carrier handoff with documentation; ensure the driver/crew is DG-briefed and equipped (spill kit, PPE)
Responsible (R): DG Shipper / Logistics / Carrier
Accountable (A): DG/Hazmat Compliance Officer
Duration: Per shipment</bpmn:documentation>
        <bpmn:incoming>W3602_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3602_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3602_Task6" name="DG Shipper/Logistics retain the DG transport documents (retention per…">
        <bpmn:documentation>Step 3: DG Shipper/Logistics retain the DG transport documents (retention per W3600/VS-88), transmit electronic manifests where required, and feed DG shipment data to analytics (W3608) and incident readiness (W3606); manage document exceptions and rejections
Responsible (R): DG Shipper / Logistics
Accountable (A): DG/Hazmat Compliance Officer
Duration: Per shipment</bpmn:documentation>
        <bpmn:incoming>W3602_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3602_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3602_End7" name="Complete">
        <bpmn:incoming>W3602_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3602_Annotation8">
        <bpmn:text>Controls: - CTL-572 (ensure controlled execution — DG Transport, Carrier &amp; Ecommerce Shipping Compliance (PA-114.2).) | - operational: certified shipper and verification; operational: segregation check
Owner: DG Shipper / Logistics</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3602_Assoc9" sourceRef="W3602_Annotation8" targetRef="W3602_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3602_Flow10" sourceRef="W3602_Start3" targetRef="W3602_Task4" />
      <bpmn:sequenceFlow id="W3602_Flow11" sourceRef="W3602_Task4" targetRef="W3602_Task5" />
      <bpmn:sequenceFlow id="W3602_Flow12" sourceRef="W3602_Task5" targetRef="W3602_Task6" />
      <bpmn:sequenceFlow id="W3602_Flow13" sourceRef="W3602_Task6" targetRef="W3602_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3602_diag">
      <bpmndi:BPMNPlane id="W3602_plane" bpmnElement="W_W3602">
        <bpmndi:BPMNShape id="W3602_Lane1_di" bpmnElement="W3602_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3602_Task4_di" bpmnElement="W3602_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3602_Task5_di" bpmnElement="W3602_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3602_Task6_di" bpmnElement="W3602_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3602_Start3_di" bpmnElement="W3602_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3602_End7_di" bpmnElement="W3602_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3602_Annotation8_di" bpmnElement="W3602_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3602_Flow10_di" bpmnElement="W3602_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3602_Flow11_di" bpmnElement="W3602_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3602_Flow12_di" bpmnElement="W3602_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3602_Flow13_di" bpmnElement="W3602_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3602_Assoc9_di" bpmnElement="W3602_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3603" name="W3603. DG Ocean / Air / Road Modal Transport Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: DG shipment by mode (import ocean, inter-island sea, air, road)
Frequency: Per mode + per shipment
Volume: DG shipments across modes
Owner: DG/Hazmat Compliance Officer / Logistics
Participants: DG/Hazmat Compliance Officer, Logistics/Freight (links to VS-06/VS-110), Import (links to VS-02.2/VS-87), Carrier, HSE (links to VS-24), DG Shipper
Source: workflow W3603 — DG Ocean / Air / Road Modal Transport Compliance</bpmn:documentation>
      <bpmn:laneSet id="W3603_LaneSet2">
        <bpmn:lane id="W3603_Lane1" name="DG">
        <bpmn:flowNodeRef>W3603_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3603_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3603_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3603_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3603_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3603_Start3" name="DG shipment by mode (import ocean, inter-island sea, air, road)">
        <bpmn:outgoing>W3603_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3603_Task4" name="DG/Hazmat Compliance Officer/Logistics apply the modal transport regulations…">
        <bpmn:documentation>Step 1: DG/Hazmat Compliance Officer/Logistics apply the modal transport regulations per shipment: IMDG Code for sea (import ocean links to VS-02.2, inter-island domestic sea), IATA DGR for air, ADR/DOT/LTFRB for road; verify modal-specific packing instructions, quantity limits, and prohibitions (some DG prohibited by air, e.g., certain flammables/lithium-battery limits)
Responsible (R): DG/Hazmat Compliance Officer / DG Shipper / Logistics
Accountable (A): DG/Hazmat Compliance Officer
Duration: Per shipment</bpmn:documentation>
        <bpmn:incoming>W3603_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3603_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3603_Task5" name="DG/Hazmat Compliance Officer/Logistics ensure modal carrier/terminal…">
        <bpmn:documentation>Step 2: DG/Hazmat Compliance Officer/Logistics ensure modal carrier/terminal compliance: sea-terminal DG acceptance and stowage segregation, air-carrier operator variations and acceptance, road route/tunnel restrictions and hazmat-route permits; coordinate port/airport handling (W3607)
Responsible (R): DG/Hazmat Compliance Officer / Logistics / Carrier
Accountable (A): DG/Hazmat Compliance Officer
Duration: Per shipment</bpmn:documentation>
        <bpmn:incoming>W3603_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3603_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3603_Task6" name="DG/Hazmat Compliance Officer manage modal-specific incidents and regulatory…">
        <bpmn:documentation>Step 3: DG/Hazmat Compliance Officer manage modal-specific incidents and regulatory engagement (links to W3606/W3596), track modal compliance KPIs, and feed learnings to classification (W3594) and carrier management (W3601); report modal compliance to governance (W3608)
Responsible (R): DG/Hazmat Compliance Officer / Logistics
Accountable (A): VP Supply Chain / VP Legal
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3603_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3603_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3603_End7" name="Complete">
        <bpmn:incoming>W3603_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3603_Annotation8">
        <bpmn:text>Controls: - CTL-156 (ensure dangerous-goods transport &amp; training compliance.) | - operational: modal eligibility check; operational: IMDG/IATA stowage rules
Owner: DG/Hazmat Compliance Officer / Logistics</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3603_Assoc9" sourceRef="W3603_Annotation8" targetRef="W3603_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3603_Flow10" sourceRef="W3603_Start3" targetRef="W3603_Task4" />
      <bpmn:sequenceFlow id="W3603_Flow11" sourceRef="W3603_Task4" targetRef="W3603_Task5" />
      <bpmn:sequenceFlow id="W3603_Flow12" sourceRef="W3603_Task5" targetRef="W3603_Task6" />
      <bpmn:sequenceFlow id="W3603_Flow13" sourceRef="W3603_Task6" targetRef="W3603_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3603_diag">
      <bpmndi:BPMNPlane id="W3603_plane" bpmnElement="W_W3603">
        <bpmndi:BPMNShape id="W3603_Lane1_di" bpmnElement="W3603_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3603_Task4_di" bpmnElement="W3603_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3603_Task5_di" bpmnElement="W3603_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3603_Task6_di" bpmnElement="W3603_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3603_Start3_di" bpmnElement="W3603_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3603_End7_di" bpmnElement="W3603_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3603_Annotation8_di" bpmnElement="W3603_Annotation8"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3603_Flow10_di" bpmnElement="W3603_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3603_Flow11_di" bpmnElement="W3603_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3603_Flow12_di" bpmnElement="W3603_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3603_Flow13_di" bpmnElement="W3603_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3603_Assoc9_di" bpmnElement="W3603_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3604" name="W3604. DG Ecommerce Ship-Eligibility &amp; Channel Rules" isExecutable="false">
      <bpmn:documentation>Trigger: Ecommerce listing (links to VS-10); DG SKU setup; carrier/channel change
Frequency: Per SKU + on change
Volume: DG-intensive ecommerce SKUs (~subset of 35K catalog online)
Owner: DG/Hazmat Compliance Officer / Ecommerce
Participants: DG/Hazmat Compliance Officer, Ecommerce (links to VS-10), Merchandising (links to VS-01), Logistics/Last-Mile (links to VS-06.3/VS-56/VS-110), Legal (links to VS-100.3), Customer Service (links to VS-13), Master Data (links to VS-29)
Source: workflow W3604 — DG Ecommerce Ship-Eligibility &amp; Channel Rules</bpmn:documentation>
      <bpmn:laneSet id="W3604_LaneSet2">
        <bpmn:lane id="W3604_Lane1" name="DG">
        <bpmn:flowNodeRef>W3604_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3604_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3604_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3604_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3604_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3604_Start3" name="Ecommerce listing (links to VS-10); DG SKU setup; carrier/channel change">
        <bpmn:outgoing>W3604_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3604_Task4" name="DG/Hazmat Compliance Officer/Ecommerce determine DG ship-eligibility per…">
        <bpmn:documentation>Step 1: DG/Hazmat Compliance Officer/Ecommerce determine DG ship-eligibility per SKU/channel: which DG SKUs can ship ecommerce, by which carrier/mode (last-mile road, inter-island sea, air-prohibited), under limited-quantity/excepted-quantity thresholds, and the channel rules (own site links to VS-10, marketplaces links to VS-65/VS-95 each have DG policies); set the ecommerce ship-eligibility flag on the hazmat master (W3594)
Responsible (R): DG/Hazmat Compliance Officer / Ecommerce / Merchandising
Accountable (A): GM, Digital Commerce Inc. / VP Legal
Duration: Per SKU</bpmn:documentation>
        <bpmn:incoming>W3604_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3604_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3604_Task5" name="DG/Hazmat Compliance Officer/Ecommerce enforce ship-eligibility at the…">
        <bpmn:documentation>Step 2: DG/Hazmat Compliance Officer/Ecommerce enforce ship-eligibility at the storefront and order-routing: block/flag DG-in-cart, restrict by ship-to region (inter-island, NCR-only, pickup-only for high-hazard), apply the DG-capable fulfillment-source filter (links to VS-60 routing), and present the customer with DG handling/terms where required
Responsible (R): DG/Hazmat Compliance Officer / Ecommerce / Logistics
Accountable (A): GM, Digital Commerce Inc.
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3604_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3604_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3604_Task6" name="DG/Hazmat Compliance Officer/Ecommerce manage DG ecommerce packaging/marking…">
        <bpmn:documentation>Step 3: DG/Hazmat Compliance Officer/Ecommerce manage DG ecommerce packaging/marking (W3598), documentation (W3602), last-mile carrier selection (W3605), and customer communication (links to VS-13) for DG shipments; monitor DG ecommerce compliance and adjust rules on carrier/regulatory change (W3596); report to governance (W3608)
Responsible (R): DG/Hazmat Compliance Officer / Ecommerce
Accountable (A): GM, Digital Commerce Inc. / VP Legal
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3604_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3604_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3604_End7" name="Complete">
        <bpmn:incoming>W3604_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3604_Annotation8">
        <bpmn:text>Controls: - CTL-572 (ensure controlled execution — DG Transport, Carrier &amp; Ecommerce Shipping Compliance (PA-114.2).) | - operational: ship-eligibility enforcement; operational: channel rule mapping
Owner: DG/Hazmat Compliance Officer / Ecommerce</bpmn:text>
      </bpmn:textAnnotation>
