        <bpmn:outgoing>W3608_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3608_Task4" name="DG/Hazmat Compliance Officer/BI define and instrument DG transport metrics: DG…">
        <bpmn:documentation>Step 1: DG/Hazmat Compliance Officer/BI define and instrument DG transport metrics: DG shipment volume by mode/class, carrier compliance %, documentation accuracy, incidents/near-misses (W3606), carrier refusals/detentions, ecommerce ship-eligibility coverage (W3604), and cost (DG premium, demurrage, remediation)
Responsible (R): DG/Hazmat Compliance Officer / BI
Accountable (A): VP Legal
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3608_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3608_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3608_Task5" name="DG/Hazmat Compliance Officer/Logistics produce the DG transport dashboards…">
        <bpmn:documentation>Step 2: DG/Hazmat Compliance Officer/Logistics produce the DG transport dashboards: carrier scorecard (links to VS-67/VS-110), compliance status, incident trend, cost, and channel (ecommerce) DG coverage; tailored views per audience
Responsible (R): DG/Hazmat Compliance Officer / BI
Accountable (A): VP Legal / VP Supply Chain
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3608_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3608_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3608_Task6" name="DG/Hazmat Compliance Officer report DG transport posture, carrier performance…">
        <bpmn:documentation>Step 3: DG/Hazmat Compliance Officer report DG transport posture, carrier performance, incidents, and risk to governance (W3616), the risk committee (links to VS-21.2/VS-36), and ExCo (links to VS-33.2); drive corrective action and continuous improvement
Responsible (R): DG/Hazmat Compliance Officer
Accountable (A): VP Legal / COO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3608_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3608_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3608_End7" name="Complete">
        <bpmn:incoming>W3608_Flow13</bpmn:incoming>
      </bpmn:endEvent>
