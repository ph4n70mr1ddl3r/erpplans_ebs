      <bpmn:sequenceFlow id="W4930_Flow11" sourceRef="W4930_Task4" targetRef="W4930_Task5" />
      <bpmn:sequenceFlow id="W4930_Flow12" sourceRef="W4930_Task5" targetRef="W4930_Task6" />
      <bpmn:sequenceFlow id="W4930_Flow13" sourceRef="W4930_Task6" targetRef="W4930_End7" />
    </bpmn:process>
