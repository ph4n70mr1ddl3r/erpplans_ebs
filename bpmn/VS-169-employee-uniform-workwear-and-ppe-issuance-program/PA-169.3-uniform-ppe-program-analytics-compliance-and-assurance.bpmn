    <bpmn:process id="W_W4931" name="W4931. Uniform Quality, Vendor SLA &amp; Performance Governance" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor contract active (W4917); SLA review; quality/cost issue
Frequency: Continuous governance + periodic business review
Volume: ~2–5 uniform/workwear/PPE suppliers + laundry vendor group-wide
Owner: Uniform Program Manager / Procurement (VS-03/VS-34) / TPRM (VS-161)
Participants: Procurement (VS-03/VS-34), Quality (VS-31), HR (VS-19), Finance (VS-17), TPRM (VS-161), Suppliers
Source: workflow W4931 — Uniform Quality, Vendor SLA &amp; Performance Governance</bpmn:documentation>
      <bpmn:laneSet id="W4931_LaneSet4">
        <bpmn:lane id="W4931_Lane1" name="Program Manager">
        <bpmn:flowNodeRef>W4931_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4931_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4931_Lane2" name="TPRM">
        <bpmn:flowNodeRef>W4931_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4931_Lane3" name="Procurement">
        <bpmn:flowNodeRef>W4931_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4931_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4931_Start5" name="Vendor contract active (W4917); SLA review; quality/cost issue">
        <bpmn:outgoing>W4931_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4931_Task6" name="Govern vendor SLA &amp; performance: lead time (onboarding kit W4921), quality…">
        <bpmn:documentation>Step 1: Govern vendor SLA &amp; performance: lead time (onboarding kit W4921), quality (defect rate W4919), sizing accuracy (W4918), laundering turnaround/loss (W4924), PPE certification (W4915/VS-117), and ethical-sourcing compliance (VS-131); run periodic business reviews
Responsible (R): Program Manager / Procurement / Quality / Analytics
Accountable (A): Program Manager / CHRO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4931_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4931_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4931_Task7" name="Manage TPRM (VS-161): financial DD on uniform/laundry suppliers, ethical/labor…">
        <bpmn:documentation>Step 2: Manage TPRM (VS-161): financial DD on uniform/laundry suppliers, ethical/labor compliance (VS-131 — uniform-industry labor risk), cyber for RFID-tracked-uniform platforms (VS-27.3), concentration (single-supplier dependency), and DPA/privacy for sizing data (VS-91)
Responsible (R): TPRM / Procurement / Legal / Privacy
Accountable (A): Program Manager
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W4931_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4931_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4931_Task8" name="Manage contract lifecycle: renewals, re-competes (W4917), performance-based fee…">
        <bpmn:documentation>Step 3: Manage contract lifecycle: renewals, re-competes (W4917), performance-based fee adjustments, quality/SLA disputes, and exit/transition (uniform-spec portability, avoid supplier lock-in); feed performance to sourcing decisions
Responsible (R): Procurement / Legal / Program Manager
Accountable (A): Program Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4931_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4931_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4931_End9" name="Complete">
        <bpmn:incoming>W4931_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4931_Annotation10">
        <bpmn:text>Controls: - CTL-132 (ensure PPE issuance &amp; DOLE compliance.) | - CTL-739: SLA + quality + lead-time tracked; ethical-sourcing DD (VS-131); TPRM + DPA; buffer-stock contingency (W4932)
Owner: Uniform Program Manager / Procurement (VS-03/VS-34) / TPRM (VS-161)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4931_Assoc11" sourceRef="W4931_Annotation10" targetRef="W4931_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W4931_Flow12" sourceRef="W4931_Start5" targetRef="W4931_Task6" />
      <bpmn:sequenceFlow id="W4931_Flow13" sourceRef="W4931_Task6" targetRef="W4931_Task7" />
      <bpmn:sequenceFlow id="W4931_Flow14" sourceRef="W4931_Task7" targetRef="W4931_Task8" />
      <bpmn:sequenceFlow id="W4931_Flow15" sourceRef="W4931_Task8" targetRef="W4931_End9" />
    </bpmn:process>
