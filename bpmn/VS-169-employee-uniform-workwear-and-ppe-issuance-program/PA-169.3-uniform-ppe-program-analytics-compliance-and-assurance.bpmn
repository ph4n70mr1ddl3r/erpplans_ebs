<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-169.3-uniform-ppe-program-analytics-compliance-and-assurance" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4929" name="W4929. Uniform / PPE Program Cost, Spend &amp; TCO Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Program live (W4913); monthly/quarterly review; FP&amp;A cycle (VS-17.4)
Frequency: Continuous analytics + monthly/quarterly review
Volume: 1 group cost/TCO program × ~6,925 employees + contingent
Owner: Uniform Program Manager / Finance (VS-17.4) / HR Finance / Analytics
Participants: Finance (VS-17.4), HR (VS-19/VS-102), Procurement (VS-03/VS-34), Analytics (VS-28), Shared Services (VS-72)
Source: workflow W4929 — Uniform / PPE Program Cost, Spend &amp; TCO Analytics</bpmn:documentation>
      <bpmn:laneSet id="W4929_LaneSet4">
        <bpmn:lane id="W4929_Lane1" name="HR Finance">
        <bpmn:flowNodeRef>W4929_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4929_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4929_Lane2" name="Finance">
        <bpmn:flowNodeRef>W4929_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4929_Lane3" name="Program Manager">
        <bpmn:flowNodeRef>W4929_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4929_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4929_Start5" name="Program live (W4913); monthly/quarterly review; FP&amp;A cycle (VS-17.4)">
        <bpmn:outgoing>W4929_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4929_Task6" name="Build the TCO model: purchase (W4919), allowance (W4916), laundering (W4924)…">
        <bpmn:documentation>Step 1: Build the TCO model: purchase (W4919), allowance (W4916), laundering (W4924), PPE (W4915/W4925), distribution (W4932), damage/loss (W4926), and end-of-life (W4934) — per employee/role/entity; reconcile allowance-paid vs uniforms-issued (W4916 double-dip) and the cross-entity chargeback (VS-72)
Responsible (R): HR Finance / Program Manager / Analytics
Accountable (A): Program Manager / CFO
Duration: Per program</bpmn:documentation>
        <bpmn:incoming>W4929_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4929_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4929_Task7" name="Track spend vs budget &amp; variance: actual cost/employee, cost/role, laundering…">
        <bpmn:documentation>Step 2: Track spend vs budget &amp; variance: actual cost/employee, cost/role, laundering cost, PPE cost, damage/loss rate, and vendor cost; flag variance and leakage (allowance double-dip, supplier price-creep, laundering loss)
Responsible (R): Finance / Analytics / Program Manager
Accountable (A): Program Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4929_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4929_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4929_Task8" name="Review &amp; act: quarterly HR/finance review (links VS-33.2), reallocate budget…">
        <bpmn:documentation>Step 3: Review &amp; act: quarterly HR/finance review (links VS-33.2), reallocate budget, drive cost-out (vendor re-compete W4917, laundering-model optimization W4924, durability improvement W4919), and report to CHRO/CFO
Responsible (R): Program Manager / HR Finance / Procurement
Accountable (A): CHRO / CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4929_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4929_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4929_End9" name="Complete">
        <bpmn:incoming>W4929_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4929_Annotation10">
        <bpmn:text>Controls: - CTL-739 (ensure controlled execution — Uniform/PPE Program Analytics, Compliance &amp; Assurance (PA-169.3).) | - CTL-739: full TCO model; allowance vs issue reconciled; variance reviewed monthly; cross-entity chargeback correct
Owner: Uniform Program Manager / Finance (VS-17.4) / HR Finance / Analytics</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4929_Assoc11" sourceRef="W4929_Annotation10" targetRef="W4929_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W4929_Flow12" sourceRef="W4929_Start5" targetRef="W4929_Task6" />
      <bpmn:sequenceFlow id="W4929_Flow13" sourceRef="W4929_Task6" targetRef="W4929_Task7" />
      <bpmn:sequenceFlow id="W4929_Flow14" sourceRef="W4929_Task7" targetRef="W4929_Task8" />
      <bpmn:sequenceFlow id="W4929_Flow15" sourceRef="W4929_Task8" targetRef="W4929_End9" />
    </bpmn:process>
