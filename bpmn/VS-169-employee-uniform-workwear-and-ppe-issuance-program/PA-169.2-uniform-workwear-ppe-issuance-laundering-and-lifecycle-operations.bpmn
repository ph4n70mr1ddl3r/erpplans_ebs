    <bpmn:process id="W_W4925" name="W4925. PPE Inspection, Maintenance, Replacement &amp; End-of-Life" isExecutable="false">
      <bpmn:documentation>Trigger: Inspection schedule; damage/wear; expiry; incident (VS-24)
Frequency: Periodic inspection + on-condition + on expiry
Volume: ~6,911 employees&#x27; PPE × inspection/replacement cycle
Owner: HSE (VS-24) / Site Supervisor / Uniform Program Manager
Participants: HSE (VS-24), Site Supervisors (VS-07/VS-04), Occupational Health (VS-83), Supplier (W4917), Asset Mgmt (VS-35)
Source: workflow W4925 — PPE Inspection, Maintenance, Replacement &amp; End-of-Life</bpmn:documentation>
      <bpmn:laneSet id="W4925_LaneSet2">
        <bpmn:lane id="W4925_Lane1" name="HSE">
