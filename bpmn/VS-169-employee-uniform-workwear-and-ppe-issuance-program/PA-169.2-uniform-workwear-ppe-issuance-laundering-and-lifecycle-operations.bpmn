    <bpmn:process id="W_W4926" name="W4926. Uniform Damage, Loss &amp; Replacement Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Employee damage/loss/theft report; wear-out; laundering loss (W4924)
Frequency: Continuous (~thousands of occurrences/yr)
Volume: ~6,911 employees × damage/loss/replacement occurrences
Owner: HR Shared Services (VS-103) / Uniform Program Manager / Site Supervisor
Participants: HRSS (VS-103), Store Ops (VS-07), Employee, Supplier (W4917), Finance (W4916)
Source: workflow W4926 — Uniform Damage, Loss &amp; Replacement Processing</bpmn:documentation>
      <bpmn:laneSet id="W4926_LaneSet3">
        <bpmn:lane id="W4926_Lane1" name="HRSS">
        <bpmn:flowNodeRef>W4926_Task5</bpmn:flowNodeRef>
