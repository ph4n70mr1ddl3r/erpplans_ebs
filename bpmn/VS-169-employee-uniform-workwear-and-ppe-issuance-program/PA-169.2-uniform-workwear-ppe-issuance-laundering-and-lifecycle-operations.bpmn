      <bpmn:sequenceFlow id="W4922_Flow13" sourceRef="W4922_Task6" targetRef="W4922_Task7" />
      <bpmn:sequenceFlow id="W4922_Flow14" sourceRef="W4922_Task7" targetRef="W4922_End8" />
    </bpmn:process>
