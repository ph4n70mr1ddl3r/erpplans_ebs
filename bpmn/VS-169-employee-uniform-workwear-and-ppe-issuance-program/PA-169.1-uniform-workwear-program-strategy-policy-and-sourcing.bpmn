<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-169.1-uniform-workwear-program-strategy-policy-and-sourcing" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4913" name="W4913. Uniform, Workwear &amp; PPE Program Strategy &amp; Operating Model" isExecutable="false">
      <bpmn:documentation>Trigger: Program launch; annual HR/brand review; format evolution (VS-109); cost-pressure
Frequency: Annual + on launch
Volume: 1 group program applied to ~6,932 employees + ~10–20% contingent + vendor personnel across 205 sites
Owner: CHRO / Uniform &amp; Workwear Program Manager (HR Shared Services VS-103)
Participants: HR (VS-19/VS-103), HSE (VS-24), Brand/Marketing (VS-14), Procurement (VS-03/VS-34), Finance (VS-17.4), Store Ops (VS-07)
Source: workflow W4913 — Uniform, Workwear &amp; PPE Program Strategy &amp; Operating Model</bpmn:documentation>
      <bpmn:laneSet id="W4913_LaneSet2">
        <bpmn:lane id="W4913_Lane1" name="Program Manager">
        <bpmn:flowNodeRef>W4913_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4913_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4913_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4913_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4913_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4913_Start3" name="Program launch; annual HR/brand review; format evolution (VS-109); cost-pressure">
        <bpmn:outgoing>W4913_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4913_Task4" name="Set the uniform/workwear/PPE program strategy &amp; operating model: the…">
        <bpmn:documentation>Step 1: Set the uniform/workwear/PPE program strategy &amp; operating model: the brand-appearance standard aligned to &quot;Your Home Building Partner&quot;, the own-issue vs allowance decision, the in-house vs vendor-laundering model, the role-based coverage (store floor, lumber yard, paint/chemical, DC, drivers, HQ, contingent), and the program owner (HR Shared Services VS-103)
Responsible (R): Program Manager / HR / Brand / HSE
Accountable (A): CHRO / COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4913_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4913_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4913_Task5" name="Build the strategic case &amp; budget: CX/brand-consistency across 200 stores…">
        <bpmn:documentation>Step 2: Build the strategic case &amp; budget: CX/brand-consistency across 200 stores, DOLE-OSH PPE compliance, employee-experience/retention impact (links VS-141/VS-144 EX), the opex/allowance/laundering/PPE envelope (~PHP 20–55M/yr), and KPIs (compliance %, cost/employee, satisfaction, PPE-failure rate); sequence into the HR &amp; capex plans
Responsible (R): Program Manager / Finance / Analytics
Accountable (A): CHRO / CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4913_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4913_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4913_Task6" name="Approve the program charter, policy (W4916), and governance (W4920); integrate…">
        <bpmn:documentation>Step 3: Approve the program charter, policy (W4916), and governance (W4920); integrate into HR operations (VS-19/VS-103), HSE (VS-24), procurement (VS-03/VS-34), and the store-remodel/new-store programs (VS-109/VS-37)
Responsible (R): Program Manager / Strategy / HR
Accountable (A): CHRO / COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4913_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4913_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4913_End7" name="Complete">
        <bpmn:incoming>W4913_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4913_Annotation8">
        <bpmn:text>Controls: - CTL-737 (ensure controlled execution — Uniform &amp; Workwear Program Strategy, Policy &amp; Sourcing (PA-169.1).) | - CTL-737: annual business case reviewed by CHRO/CFO; operating model documented; coverage model defined
Owner: CHRO / Uniform &amp; Workwear Program Manager (HR Shared Services VS-103)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4913_Assoc9" sourceRef="W4913_Annotation8" targetRef="W4913_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4913_Flow10" sourceRef="W4913_Start3" targetRef="W4913_Task4" />
      <bpmn:sequenceFlow id="W4913_Flow11" sourceRef="W4913_Task4" targetRef="W4913_Task5" />
      <bpmn:sequenceFlow id="W4913_Flow12" sourceRef="W4913_Task5" targetRef="W4913_Task6" />
      <bpmn:sequenceFlow id="W4913_Flow13" sourceRef="W4913_Task6" targetRef="W4913_End7" />
    </bpmn:process>
