    <bpmn:process id="W_W4914" name="W4914. Role-Based Uniform / Workwear Standards &amp; Brand-Guideline Design" isExecutable="false">
      <bpmn:documentation>Trigger: Strategy set (W4913); brand refresh (VS-14); role/structure change
Frequency: Per refresh + on role change
Volume: ~15–20 role-types (store floor, supervisor, cashier, lumber-yard, paint, receiving, DC)
Owner: Uniform &amp; Workwear Program Manager / Brand / HR
Participants: Brand/Marketing (VS-14), HR (VS-19), HSE (VS-24), Store Ops (VS-07), Supplier (W4917)
Source: workflow W4914 — Role-Based Uniform / Workwear Standards &amp; Brand-Guideline Design</bpmn:documentation>
      <bpmn:laneSet id="W4914_LaneSet3">
        <bpmn:lane id="W4914_Lane1" name="Brand">
        <bpmn:flowNodeRef>W4914_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4914_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4914_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4914_Lane2" name="Program Manager">
        <bpmn:flowNodeRef>W4914_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4914_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4914_Start4" name="Strategy set (W4913); brand refresh (VS-14); role/structure change">
        <bpmn:outgoing>W4914_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4914_Task5" name="Define the role-based uniform/workwear standard per brand guidelines (VS-14)…">
        <bpmn:documentation>Step 1: Define the role-based uniform/workwear standard per brand guidelines (VS-14): garment types (polo/tee, trousers, jacket/rainwear for yard/outdoor, hi-vis for DC/yard, smock for paint, anti-static where needed), fabric/durability (heavy-use, wash-frequency, tropical-climate breathability), color/branding/logo placement, footwear, and name/role identification
Responsible (R): Brand / Program Manager / HR / HSE
Accountable (A): CHRO / VP Marketing
Duration: Per refresh</bpmn:documentation>
        <bpmn:incoming>W4914_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4914_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4914_Task6" name="Map standards to roles &amp; work-zones: store-floor vs lumber-yard…">
        <bpmn:documentation>Step 2: Map standards to roles &amp; work-zones: store-floor vs lumber-yard (hi-vis/steel-toe) vs paint/chemical (smock + PPE W4915) vs DC (hi-vis/steel-toe) vs delivery driver (branded + hi-vis) vs HQ; define the onboarding kit quantity &amp; replenishment cycle (W4916)
Responsible (R): Program Manager / Store Ops / HSE / HR
Accountable (A): Program Manager
Duration: Per refresh</bpmn:documentation>
        <bpmn:incoming>W4914_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4914_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4914_Task7" name="Publish &amp; train: issue the uniform standard to HR/stores/suppliers (links…">
        <bpmn:documentation>Step 3: Publish &amp; train: issue the uniform standard to HR/stores/suppliers (links VS-63), brief managers on enforcement &amp; the appearance policy (grooming, accessories, PPE-compliance), and audit adherence (W4930)
Responsible (R): Brand / HR / Store Ops / Training
Accountable (A): Program Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4914_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4914_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4914_End8" name="Complete">
        <bpmn:incoming>W4914_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4914_Annotation9">
        <bpmn:text>Controls: - CTL-737 (ensure controlled execution — Uniform &amp; Workwear Program Strategy, Policy &amp; Sourcing (PA-169.1).) | - CTL-737: brand-guideline-aligned standard; role-zone coverage complete; climate-appropriate fabric; adherence-audited
Owner: Uniform &amp; Workwear Program Manager / Brand / HR</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4914_Assoc10" sourceRef="W4914_Annotation9" targetRef="W4914_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4914_Flow11" sourceRef="W4914_Start4" targetRef="W4914_Task5" />
      <bpmn:sequenceFlow id="W4914_Flow12" sourceRef="W4914_Task5" targetRef="W4914_Task6" />
      <bpmn:sequenceFlow id="W4914_Flow13" sourceRef="W4914_Task6" targetRef="W4914_Task7" />
      <bpmn:sequenceFlow id="W4914_Flow14" sourceRef="W4914_Task7" targetRef="W4914_End8" />
    </bpmn:process>
