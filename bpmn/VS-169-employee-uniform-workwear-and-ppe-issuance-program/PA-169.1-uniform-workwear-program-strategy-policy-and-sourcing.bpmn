        <bpmn:flowNodeRef>W4918_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4918_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4918_Start4" name="New-hire onboarding (VS-121/VS-19); vendor change (W4917); fit-complaint">
        <bpmn:outgoing>W4918_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4918_Task5" name="Establish the sizing program: standard size-chart per garment (aligned to the…">
        <bpmn:documentation>Step 1: Establish the sizing program: standard size-chart per garment (aligned to the supplier W4917), the measurement method (self-measure kit / in-store fitting / body-scan opt-in), the inclusive size range (including maternity, PWD-adaptive), and the data-privacy handling of body-measurement data (RA 10173 — minimize, consent, limited retention)
Responsible (R): Program Manager / HRSS / Privacy / Supplier
Accountable (A): Program Manager
Duration: Per program</bpmn:documentation>
        <bpmn:incoming>W4918_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4918_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4918_Task6" name="Capture sizing at onboarding (links VS-121): measure/fit each new hire against…">
        <bpmn:documentation>Step 2: Capture sizing at onboarding (links VS-121): measure/fit each new hire against the chart, capture into HRIS/ESS (VS-29/VS-103) under privacy controls, order the right-size onboarding kit (W4921), and handle fit-issues/exchanges (W4926)
Responsible (R): HRSS / Supplier / Store Ops
Accountable (A): Program Manager
Duration: Per hire</bpmn:documentation>
        <bpmn:incoming>W4918_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4918_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4918_Task7" name="Manage vendor fit &amp; size-range: validate the supplier&#x27;s sizing against the…">
        <bpmn:documentation>Step 3: Manage vendor fit &amp; size-range: validate the supplier&#x27;s sizing against the actual workforce (avoid systemic mis-fit), expand the size range for inclusivity, and use body-measurement data only for fit (privacy-minimized, no other HR use)
Responsible (R): Program Manager / Supplier / Privacy
Accountable (A): Program Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4918_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4918_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4918_End8" name="Complete">
        <bpmn:incoming>W4918_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4918_Annotation9">
        <bpmn:text>Controls: - CTL-737 (ensure controlled execution — Uniform &amp; Workwear Program Strategy, Policy &amp; Sourcing (PA-169.1).) | - CTL-737: RA 10173-compliant sizing data (minimize/consent/retain-limited); validated size chart; inclusive range
Owner: Uniform &amp; Workwear Program Manager / HR Shared Services (VS-103)</bpmn:text>
      </bpmn:textAnnotation>
