      <bpmn:sequenceFlow id="W4915_Flow11" sourceRef="W4915_Task4" targetRef="W4915_Task5" />
      <bpmn:sequenceFlow id="W4915_Flow12" sourceRef="W4915_Task5" targetRef="W4915_Task6" />
      <bpmn:sequenceFlow id="W4915_Flow13" sourceRef="W4915_Task6" targetRef="W4915_End7" />
    </bpmn:process>
