    <bpmn:process id="W_W2852" name="W2852. SSS EC / Sickness Benefit &amp; PhilHealth Claim Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Work-connected injury/illness or hospitalization
Frequency: Event-driven; ~60–120 claims/year (per the Volume)
Volume: ~5–10 claims/month
Owner: Benefits Specialist
Participants: Benefits, OH Nurse, Employee, SSS, PhilHealth, HMO
Source: workflow W2852 — SSS EC / Sickness Benefit &amp; PhilHealth Claim Coordination</bpmn:documentation>
      <bpmn:laneSet id="W2852_LaneSet2">
        <bpmn:lane id="W2852_Lane1" name="Benefits">
        <bpmn:flowNodeRef>W2852_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2852_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2852_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2852_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2852_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2852_Start3" name="Work-connected injury/illness or hospitalization">
        <bpmn:outgoing>W2852_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2852_Task4" name="Benefits/OH Nurse compiles SSS Employees&#x27; Compensation (EC) claim or Sickness…">
        <bpmn:documentation>Step 1: Benefits/OH Nurse compiles SSS Employees&#x27; Compensation (EC) claim or Sickness Benefit documentation: medical records, employer certification, attendance
Responsible (R): Benefits / OH Nurse
Accountable (A): Benefits Manager
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W2852_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2852_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2852_Task5" name="Benefits files SSS EC/Sickness or PhilHealth claim; tracks adjudication; remits…">
        <bpmn:documentation>Step 2: Benefits files SSS EC/Sickness or PhilHealth claim; tracks adjudication; remits necessary employer documents
Responsible (R): Benefits
Accountable (A): Benefits Manager
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W2852_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2852_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2852_Task6" name="Benefits reconciles claim proceeds to employee salary continuation and HMO…">
        <bpmn:documentation>Step 3: Benefits reconciles claim proceeds to employee salary continuation and HMO payments; closes case with employee communication
Responsible (R): Benefits
Accountable (A): Benefits Manager
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W2852_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2852_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2852_End7" name="Complete">
        <bpmn:incoming>W2852_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2852_Annotation8">
