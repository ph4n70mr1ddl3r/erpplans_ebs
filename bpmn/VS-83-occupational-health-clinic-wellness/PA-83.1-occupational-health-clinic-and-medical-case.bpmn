    <bpmn:process id="W_W2850" name="W2850. Workplace Injury / Illness First Aid &amp; Medical Case Opening" isExecutable="false">
      <bpmn:documentation>Trigger: Employee injury or illness at work
Frequency: Event-driven; ~5–15 cases/month
Volume: All locations
Owner: OH Nurse
Participants: OH Nurse, Store/DC Manager, Employee, HSE
Source: workflow W2850 — Workplace Injury / Illness First Aid &amp; Medical Case Opening</bpmn:documentation>
      <bpmn:laneSet id="W2850_LaneSet3">
        <bpmn:lane id="W2850_Lane1" name="OH Nurse">
        <bpmn:flowNodeRef>W2850_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2850_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2850_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2850_Lane2" name="HSE">
        <bpmn:flowNodeRef>W2850_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2850_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2850_Start4" name="Employee injury or illness at work">
        <bpmn:outgoing>W2850_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2850_Task5" name="OH Nurse/first-aider provides immediate first aid; stabilizes; transports to…">
        <bpmn:documentation>Step 1: OH Nurse/first-aider provides immediate first aid; stabilizes; transports to network hospital if needed; notifies manager and HSE
Responsible (R): OH Nurse
Accountable (A): OH Nurse Manager
Duration: Immediate</bpmn:documentation>
        <bpmn:incoming>W2850_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2850_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2850_Task6" name="OH Nurse opens medical case in record system: incident description, body part…">
        <bpmn:documentation>Step 2: OH Nurse opens medical case in record system: incident description, body part, severity, witness, work-relatedness indicator
Responsible (R): OH Nurse
Accountable (A): OH Nurse Manager
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W2850_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2850_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2850_Task7" name="HSE links medical case to OHS incident (W140 linkage); coordinates…">
        <bpmn:documentation>Step 3: HSE links medical case to OHS incident (W140 linkage); coordinates investigation; tracks recovery and case closure
Responsible (R): HSE
Accountable (A): HSE Manager
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W2850_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2850_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2850_End8" name="Complete">
        <bpmn:incoming>W2850_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2850_Annotation9">
        <bpmn:text>Controls: - CTL-216 (ensure occupational-health record &amp; claim compliance.) | - operational: trained first-aiders at every location
Owner: OH Nurse</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2850_Assoc10" sourceRef="W2850_Annotation9" targetRef="W2850_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2850_Flow11" sourceRef="W2850_Start4" targetRef="W2850_Task5" />
      <bpmn:sequenceFlow id="W2850_Flow12" sourceRef="W2850_Task5" targetRef="W2850_Task6" />
      <bpmn:sequenceFlow id="W2850_Flow13" sourceRef="W2850_Task6" targetRef="W2850_Task7" />
      <bpmn:sequenceFlow id="W2850_Flow14" sourceRef="W2850_Task7" targetRef="W2850_End8" />
    </bpmn:process>
