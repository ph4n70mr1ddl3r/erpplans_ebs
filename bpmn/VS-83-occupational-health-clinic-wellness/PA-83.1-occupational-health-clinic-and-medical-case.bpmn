    <bpmn:process id="W_W2849" name="W2849. Company Clinic Operations &amp; Occupational Health Nurse Coverage" isExecutable="false">
      <bpmn:documentation>Trigger: Continuous clinic operations
Frequency: Daily
Volume: 200 stores + 4 DCs + HQ; ~6,932 employees
Owner: Occupational Health Nurse Manager
Participants: OH Nurse, Company Physician, HR
Source: workflow W2849 — Company Clinic Operations &amp; Occupational Health Nurse Coverage</bpmn:documentation>
      <bpmn:laneSet id="W2849_LaneSet4">
        <bpmn:lane id="W2849_Lane1" name="OH Nurse Manager">
        <bpmn:flowNodeRef>W2849_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2849_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2849_Lane2" name="OH Nurse">
        <bpmn:flowNodeRef>W2849_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2849_Lane3" name="Company Physician">
        <bpmn:flowNodeRef>W2849_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2849_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2849_Start5" name="Continuous clinic operations">
        <bpmn:outgoing>W2849_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2849_Task6" name="OH Nurse Manager maintains nurse/doctor coverage plan: resident nurse at large…">
        <bpmn:documentation>Step 1: OH Nurse Manager maintains nurse/doctor coverage plan: resident nurse at large DCs/HQ, rotating coverage at regional store clusters per DOLE Clinic Ratio (1 nurse per 200–300 employees)
Responsible (R): OH Nurse Manager
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2849_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2849_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2849_Task7" name="OH Nurse operates clinic: walk-in consultations, vital signs, dispensing…">
        <bpmn:documentation>Step 2: OH Nurse operates clinic: walk-in consultations, vital signs, dispensing, emergency first aid, referral; logs every case in occupational health record system
Responsible (R): OH Nurse
Accountable (A): OH Nurse Manager
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W2849_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2849_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2849_Task8" name="Company Physician conducts scheduled consults and oversees clinical protocols…">
        <bpmn:documentation>Step 3: Company Physician conducts scheduled consults and oversees clinical protocols; reviews complex cases; signs medical clearances
Responsible (R): Company Physician
Accountable (A): OH Nurse Manager
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W2849_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2849_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2849_End9" name="Complete">
        <bpmn:incoming>W2849_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2849_Annotation10">
        <bpmn:text>Controls: - CTL-478 (ensure controlled execution — Occupational Health Clinic &amp; Medical Case Management (PA-83.1).) | - operational: ratio-based staffing plan and third-party coverage contracts
Owner: Occupational Health Nurse Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2849_Assoc11" sourceRef="W2849_Annotation10" targetRef="W2849_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2849_Flow12" sourceRef="W2849_Start5" targetRef="W2849_Task6" />
      <bpmn:sequenceFlow id="W2849_Flow13" sourceRef="W2849_Task6" targetRef="W2849_Task7" />
      <bpmn:sequenceFlow id="W2849_Flow14" sourceRef="W2849_Task7" targetRef="W2849_Task8" />
      <bpmn:sequenceFlow id="W2849_Flow15" sourceRef="W2849_Task8" targetRef="W2849_End9" />
    </bpmn:process>
