    <bpmn:process id="W_W2851" name="W2851. Referral to Network Hospital, Specialist &amp; Diagnostics Management" isExecutable="false">
      <bpmn:documentation>Trigger: Case requires care beyond clinic capacity
Frequency: Event-driven; ~2–8 referrals/month
Volume: ~20–30 network hospitals/clinics
Owner: OH Nurse
Participants: OH Nurse, Company Physician, HMO, Employee
Source: workflow W2851 — Referral to Network Hospital, Specialist &amp; Diagnostics Management</bpmn:documentation>
      <bpmn:laneSet id="W2851_LaneSet3">
        <bpmn:lane id="W2851_Lane1" name="OH Nurse">
        <bpmn:flowNodeRef>W2851_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2851_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2851_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2851_Lane2" name="Company Physician">
        <bpmn:flowNodeRef>W2851_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2851_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2851_Start4" name="Case requires care beyond clinic capacity">
        <bpmn:outgoing>W2851_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2851_Task5" name="OH Nurse/Physician refers to accredited network hospital/specialist…">
        <bpmn:documentation>Step 1: OH Nurse/Physician refers to accredited network hospital/specialist; coordinates appointment and pre-authorization with HMO
Responsible (R): OH Nurse / Company Physician
Accountable (A): OH Nurse Manager
Duration: Per referral</bpmn:documentation>
        <bpmn:incoming>W2851_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2851_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2851_Task6" name="Employee attends referral; OH Nurse tracks diagnostics, specialist report, and…">
        <bpmn:documentation>Step 2: Employee attends referral; OH Nurse tracks diagnostics, specialist report, and treatment plan in medical case file
Responsible (R): OH Nurse
Accountable (A): OH Nurse Manager
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W2851_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2851_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2851_Task7" name="Company Physician reviews specialist findings; adjusts work restrictions…">
        <bpmn:documentation>Step 3: Company Physician reviews specialist findings; adjusts work restrictions; coordinates treatment escalation if needed
Responsible (R): Company Physician
Accountable (A): OH Nurse Manager
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W2851_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2851_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2851_End8" name="Complete">
        <bpmn:incoming>W2851_Flow14</bpmn:incoming>
      </bpmn:endEvent>
