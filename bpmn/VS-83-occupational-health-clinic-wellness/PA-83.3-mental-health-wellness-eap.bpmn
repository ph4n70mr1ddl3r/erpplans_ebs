    <bpmn:process id="W_W2865" name="W2865. Employee Assistance Program (EAP) Provision &amp; Confidential Counseling" isExecutable="false">
      <bpmn:documentation>Trigger: Employee self-referral or manager referral
Frequency: Continuous; ~2–5% utilization/year
Volume: ~6,911 employees + dependents
Owner: EAP Manager
Participants: EAP Mgr, EAP Provider, HR, OH Nurse
Source: workflow W2865 — Employee Assistance Program (EAP) Provision &amp; Confidential Counseling</bpmn:documentation>
      <bpmn:laneSet id="W2865_LaneSet4">
        <bpmn:lane id="W2865_Lane1" name="EAP Manager">
        <bpmn:flowNodeRef>W2865_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2865_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2865_Lane2" name="Employee">
        <bpmn:flowNodeRef>W2865_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2865_Lane3" name="EAP Provider">
        <bpmn:flowNodeRef>W2865_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2865_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2865_Start5" name="Employee self-referral or manager referral">
        <bpmn:outgoing>W2865_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2865_Task6" name="EAP Manager contracts accredited EAP provider (counseling hotline…">
        <bpmn:documentation>Step 1: EAP Manager contracts accredited EAP provider (counseling hotline, in-person/tele-counseling sessions, financial/legal advisory); structures confidentiality
Responsible (R): EAP Manager
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2865_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2865_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2865_Task7" name="Employee self-refers (or manager refers with consent) for personal/work stress…">
        <bpmn:documentation>Step 2: Employee self-refers (or manager refers with consent) for personal/work stress, family, financial, grief, conflict; accesses sessions confidentially
Responsible (R): Employee / Manager
Accountable (A): EAP Manager
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W2865_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2865_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2865_Task8" name="EAP Provider reports aggregate utilization and trend themes (no individual…">
        <bpmn:documentation>Step 3: EAP Provider reports aggregate utilization and trend themes (no individual detail) to EAP Manager; recommends workplace interventions
Responsible (R): EAP Provider / EAP Manager
Accountable (A): CHRO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2865_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2865_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2865_End9" name="Complete">
        <bpmn:incoming>W2865_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2865_Annotation10">
        <bpmn:text>Controls: - CTL-480 (ensure controlled execution — Mental Health, Wellness &amp; Employee Assistance Program (PA-83.3).) | - operational: confidentiality assurance and awareness campaigns
Owner: EAP Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2865_Assoc11" sourceRef="W2865_Annotation10" targetRef="W2865_Start5" associationDirection="None" />
