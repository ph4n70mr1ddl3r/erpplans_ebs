        </bpmn:lane>
        <bpmn:lane id="W2872_Lane3" name="OH Nurse Manager">
        <bpmn:flowNodeRef>W2872_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2872_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2872_Start5" name="Quarterly/annual program review">
        <bpmn:outgoing>W2872_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2872_Task6" name="HR Analytics compiles wellness metrics: absenteeism, healthcare cost, APE…">
        <bpmn:documentation>Step 1: HR Analytics compiles wellness metrics: absenteeism, healthcare cost, APE finding rates, EAP utilization, engagement, attrition
Responsible (R): HR Analytics Lead
Accountable (A): CHRO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2872_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2872_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2872_Task7" name="Finance computes wellness program ROI (cost vs. reduced…">
        <bpmn:documentation>Step 2: Finance computes wellness program ROI (cost vs. reduced absenteeism/healthcare/attrition); benchmarks vs. industry
Responsible (R): Finance
Accountable (A): CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2872_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2872_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2872_Task8" name="OH Nurse Manager/EAP Manager refine program based on ROI and impact data…">
        <bpmn:documentation>Step 3: OH Nurse Manager/EAP Manager refine program based on ROI and impact data; prioritize high-ROI interventions
Responsible (R): OH Nurse Manager / EAP Manager
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2872_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2872_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2872_End9" name="Complete">
        <bpmn:incoming>W2872_Flow15</bpmn:incoming>
      </bpmn:endEvent>
