    <bpmn:process id="W_W2872" name="W2872. Wellness Program Effectiveness Analytics &amp; ROI" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly/annual program review
Frequency: Quarterly
Volume: Program-wide
Owner: HR Analytics Lead
Participants: HR Analytics, OH Nurse Manager, Finance, EAP Manager
Source: workflow W2872 — Wellness Program Effectiveness Analytics &amp; ROI</bpmn:documentation>
      <bpmn:laneSet id="W2872_LaneSet4">
        <bpmn:lane id="W2872_Lane1" name="HR Analytics Lead">
        <bpmn:flowNodeRef>W2872_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2872_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
