    <bpmn:process id="W_W2868" name="W2868. Substance Abuse Policy, Testing &amp; Rehabilitation Support" isExecutable="false">
      <bpmn:documentation>Trigger: Pre-employment, random, or for-cause testing
Frequency: Annual random + event-driven
Volume: Safety-sensitive roles (drivers, equipment operators)
Owner: OH Nurse Manager
Participants: OH Nurse, HR, Legal, DOH-accredited Lab
Source: workflow W2868 — Substance Abuse Policy, Testing &amp; Rehabilitation Support</bpmn:documentation>
      <bpmn:laneSet id="W2868_LaneSet4">
        <bpmn:lane id="W2868_Lane1" name="HR">
        <bpmn:flowNodeRef>W2868_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2868_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2868_Lane2" name="OH Nurse">
        <bpmn:flowNodeRef>W2868_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2868_Lane3" name="EAP Manager">
        <bpmn:flowNodeRef>W2868_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2868_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2868_Start5" name="Pre-employment, random, or for-cause testing">
        <bpmn:outgoing>W2868_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2868_Task6" name="HR/OH Nurse administers drug testing per company policy (pre-employment, random…">
        <bpmn:documentation>Step 1: HR/OH Nurse administers drug testing per company policy (pre-employment, random for safety-sensitive, for-cause); uses DOH-accredited lab
Responsible (R): HR / OH Nurse
Accountable (A): OH Nurse Manager
Duration: Per test</bpmn:documentation>
        <bpmn:incoming>W2868_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2868_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2868_Task7" name="OH Nurse/HR handles positive result per due process: confirmatory test…">
        <bpmn:documentation>Step 2: OH Nurse/HR handles positive result per due process: confirmatory test, hearing, disciplinary or rehabilitation pathway
Responsible (R): OH Nurse / HR / Legal
Accountable (A): OH Nurse Manager
Duration: Per case</bpmn:documentation>
