    <bpmn:process id="W_W2866" name="W2866. Mental Health Act (RA 11036) Compliance &amp; DOH Mental Health Program" isExecutable="false">
      <bpmn:documentation>Trigger: Regulatory requirement; program design
Frequency: Continuous compliance
Volume: All establishments
Owner: EAP Manager
Participants: EAP Mgr, HR, Legal, OH Nurse, DOH
Source: workflow W2866 — Mental Health Act (RA 11036) Compliance &amp; DOH Mental Health Program</bpmn:documentation>
      <bpmn:laneSet id="W2866_LaneSet4">
        <bpmn:lane id="W2866_Lane1" name="EAP Manager">
        <bpmn:flowNodeRef>W2866_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2866_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2866_Lane2" name="HR">
        <bpmn:flowNodeRef>W2866_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2866_Lane3" name="Legal">
        <bpmn:flowNodeRef>W2866_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2866_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2866_Start5" name="Regulatory requirement; program design">
        <bpmn:outgoing>W2866_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2866_Task6" name="EAP Manager designs workplace mental health program per RA 11036 and IRR…">
        <bpmn:documentation>Step 1: EAP Manager designs workplace mental health program per RA 11036 and IRR: mental health policy, awareness training, anti-stigma, referral pathway
Responsible (R): EAP Manager
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2866_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2866_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2866_Task7" name="HR delivers mental health literacy training to managers and employees; trains…">
        <bpmn:documentation>Step 2: HR delivers mental health literacy training to managers and employees; trains managers to recognize distress and refer appropriately
Responsible (R): HR
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2866_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2866_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2866_Task8" name="Legal/EAP Manager ensures compliance with DOH mental health program standards…">
        <bpmn:documentation>Step 3: Legal/EAP Manager ensures compliance with DOH mental health program standards; supports any DOH inspection; reports program metrics
Responsible (R): Legal / EAP Manager
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2866_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2866_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2866_End9" name="Complete">
        <bpmn:incoming>W2866_Flow15</bpmn:incoming>
      </bpmn:endEvent>
