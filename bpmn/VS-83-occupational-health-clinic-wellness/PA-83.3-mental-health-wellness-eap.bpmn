    <bpmn:process id="W_W2867" name="W2867. Critical Incident Stress Debriefing &amp; Crisis Support" isExecutable="false">
      <bpmn:documentation>Trigger: Robbery, fatality, disaster, violence at workplace
Frequency: Event-driven; rare
Volume: ~5–15 critical incidents/year
Owner: EAP Manager
Participants: EAP Mgr, EAP Provider, OH Nurse, HR, Store/DC Manager
Source: workflow W2867 — Critical Incident Stress Debriefing &amp; Crisis Support</bpmn:documentation>
      <bpmn:laneSet id="W2867_LaneSet4">
        <bpmn:lane id="W2867_Lane1" name="Store">
        <bpmn:flowNodeRef>W2867_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2867_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2867_Lane2" name="EAP Provider">
        <bpmn:flowNodeRef>W2867_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2867_Lane3" name="OH Nurse">
        <bpmn:flowNodeRef>W2867_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2867_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2867_Start5" name="Robbery, fatality, disaster, violence at workplace">
        <bpmn:outgoing>W2867_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2867_Task6" name="Store/DC Manager triggers CISD request following critical incident; EAP Manager…">
        <bpmn:documentation>Step 1: Store/DC Manager triggers CISD request following critical incident; EAP Manager mobilizes accredited counselor within 24–72 hours
Responsible (R): Store/DC Manager / EAP Manager
Accountable (A): EAP Manager
Duration: Immediate</bpmn:documentation>
        <bpmn:incoming>W2867_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2867_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2867_Task7" name="EAP Provider conducts group debrief and individual follow-up for affected…">
        <bpmn:documentation>Step 2: EAP Provider conducts group debrief and individual follow-up for affected employees; assesses PTSD risk; refers for ongoing care
Responsible (R): EAP Provider
Accountable (A): EAP Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W2867_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2867_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2867_Task8" name="OH Nurse/HR monitors affected employees&#x27; recovery; arranges work accommodation…">
        <bpmn:documentation>Step 3: OH Nurse/HR monitors affected employees&#x27; recovery; arranges work accommodation; tracks return-to-stability
Responsible (R): OH Nurse / HR
Accountable (A): EAP Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W2867_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2867_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2867_End9" name="Complete">
        <bpmn:incoming>W2867_Flow15</bpmn:incoming>
      </bpmn:endEvent>
