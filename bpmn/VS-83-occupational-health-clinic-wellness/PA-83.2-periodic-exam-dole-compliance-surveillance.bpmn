    <bpmn:process id="W_W2859" name="W2859. DOLE-Required Periodic Exam by Hazard Category (Chemical/Physical/Biological)" isExecutable="false">
      <bpmn:documentation>Trigger: Annual cycle or hazard exposure change
Frequency: Annual + event-driven
Volume: Exposed roles: paint mixers, lumber yard, hazmat handlers, drivers, noise-exposed
Owner: Company Physician
Participants: Company Physician, OH Nurse, HSE, HR
Source: workflow W2859 — DOLE-Required Periodic Exam by Hazard Category (Chemical/Physical/Biological)</bpmn:documentation>
      <bpmn:laneSet id="W2859_LaneSet4">
        <bpmn:lane id="W2859_Lane1" name="HSE">
        <bpmn:flowNodeRef>W2859_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2859_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2859_Lane2" name="OH Nurse">
        <bpmn:flowNodeRef>W2859_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2859_Lane3" name="Company Physician">
        <bpmn:flowNodeRef>W2859_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2859_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2859_Start5" name="Annual cycle or hazard exposure change">
        <bpmn:outgoing>W2859_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2859_Task6" name="HSE/Company Physician identifies hazard-exposed roles per DOLE D.O. 198-18…">
        <bpmn:documentation>Step 1: HSE/Company Physician identifies hazard-exposed roles per DOLE D.O. 198-18; defines role-specific periodic exam (audiometry for noise, spirometry for chemical, vision for drivers)
Responsible (R): HSE / Company Physician
Accountable (A): OH Nurse Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2859_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2859_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2859_Task7" name="OH Nurse schedules and tracks hazard-specific exams; ensures completion for all…">
        <bpmn:documentation>Step 2: OH Nurse schedules and tracks hazard-specific exams; ensures completion for all exposed employees
Responsible (R): OH Nurse
Accountable (A): OH Nurse Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2859_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2859_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2859_Task8" name="Company Physician reviews results; recommends exposure reduction, PPE upgrade…">
        <bpmn:documentation>Step 3: Company Physician reviews results; recommends exposure reduction, PPE upgrade, or job transfer for abnormal findings
Responsible (R): Company Physician / HSE
Accountable (A): OH Nurse Manager
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W2859_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2859_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2859_End9" name="Complete">
        <bpmn:incoming>W2859_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2859_Annotation10">
        <bpmn:text>Controls: - CTL-479 (ensure controlled execution — Periodic Examination, DOLE Compliance &amp; Disease Surveillance (PA-83.2).) | - operational: exposure-role register and tracking
Owner: Company Physician</bpmn:text>
      </bpmn:textAnnotation>
