    <bpmn:process id="W_W2864" name="W2864. Workplace Exposure Monitoring (Noise/Air/Chemical) &amp; DOLE Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: Annual cycle or process change
Frequency: Annual + event-driven
Volume: High-exposure zones (lumber yard, paint, DC machinery)
Owner: HSE Manager
Participants: HSE, OH Nurse, Accredited Lab
Source: workflow W2864 — Workplace Exposure Monitoring (Noise/Air/Chemical) &amp; DOLE Compliance</bpmn:documentation>
      <bpmn:laneSet id="W2864_LaneSet3">
        <bpmn:lane id="W2864_Lane1" name="HSE">
        <bpmn:flowNodeRef>W2864_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2864_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2864_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2864_Lane2" name="OH Nurse">
        <bpmn:flowNodeRef>W2864_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2864_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2864_Start4" name="Annual cycle or process change">
        <bpmn:outgoing>W2864_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2864_Task5" name="HSE contracts DOH/DOLE-accredited lab to measure noise, air quality, chemical…">
        <bpmn:documentation>Step 1: HSE contracts DOH/DOLE-accredited lab to measure noise, air quality, chemical exposure in identified zones per OHS standard
Responsible (R): HSE
Accountable (A): HSE Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2864_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2864_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2864_Task6" name="HSE compares results to Permissible Exposure Limits (PEL); implements controls…">
        <bpmn:documentation>Step 2: HSE compares results to Permissible Exposure Limits (PEL); implements controls if exceeded (ventilation, PPE, enclosure)
Responsible (R): HSE
Accountable (A): HSE Manager
Duration: Per measurement</bpmn:documentation>
        <bpmn:incoming>W2864_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2864_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2864_Task7" name="OH Nurse links exposure data to hazard-specific periodic exam results; reports…">
        <bpmn:documentation>Step 3: OH Nurse links exposure data to hazard-specific periodic exam results; reports exposure-trend to management
Responsible (R): OH Nurse
Accountable (A): OH Nurse Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2864_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2864_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2864_End8" name="Complete">
        <bpmn:incoming>W2864_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2864_Annotation9">
        <bpmn:text>Controls: - CTL-479 (ensure controlled execution — Periodic Examination, DOLE Compliance &amp; Disease Surveillance (PA-83.2).) | - operational: accredited annual monitoring
Owner: HSE Manager</bpmn:text>
      </bpmn:textAnnotation>
