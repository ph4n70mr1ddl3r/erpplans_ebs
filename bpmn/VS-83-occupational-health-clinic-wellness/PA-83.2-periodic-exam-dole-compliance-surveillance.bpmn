    <bpmn:process id="W_W2858" name="W2858. Annual / Periodic Medical Examination (APE) Program Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Annual APE cycle (employee anniversary or fiscal cycle)
Frequency: Annual per employee
Volume: ~6,932 employees
Owner: OH Nurse Manager
Participants: OH Nurse, HR, HMO, Employee
Source: workflow W2858 — Annual / Periodic Medical Examination (APE) Program Execution</bpmn:documentation>
      <bpmn:laneSet id="W2858_LaneSet4">
        <bpmn:lane id="W2858_Lane1" name="OH Nurse Manager">
        <bpmn:flowNodeRef>W2858_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2858_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2858_Lane2" name="Employee">
        <bpmn:flowNodeRef>W2858_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2858_Lane3" name="Company Physician">
        <bpmn:flowNodeRef>W2858_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2858_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2858_Start5" name="Annual APE cycle (employee anniversary or fiscal cycle)">
        <bpmn:outgoing>W2858_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2858_Task6" name="OH Nurse Manager plans annual APE schedule by location; contracts accredited…">
        <bpmn:documentation>Step 1: OH Nurse Manager plans annual APE schedule by location; contracts accredited clinic; communicates schedule and requirements to employees
Responsible (R): OH Nurse Manager
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2858_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2858_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2858_Task7" name="Employee completes APE (physical, lab, ECG for &gt;40, chest X-ray); clinic…">
        <bpmn:documentation>Step 2: Employee completes APE (physical, lab, ECG for &gt;40, chest X-ray); clinic transmits results to occupational health record system
Responsible (R): Employee / Clinic
Accountable (A): OH Nurse Manager
Duration: Per employee</bpmn:documentation>
        <bpmn:incoming>W2858_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2858_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2858_Task8" name="Company Physician reviews APE; flags health risks; refers for follow-up…">
        <bpmn:documentation>Step 3: Company Physician reviews APE; flags health risks; refers for follow-up; recommends workplace accommodation if needed
Responsible (R): Company Physician
Accountable (A): OH Nurse Manager
Duration: Per employee</bpmn:documentation>
        <bpmn:incoming>W2858_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2858_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2858_End9" name="Complete">
        <bpmn:incoming>W2858_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2858_Annotation10">
        <bpmn:text>Controls: - CTL-479 (ensure controlled execution — Periodic Examination, DOLE Compliance &amp; Disease Surveillance (PA-83.2).) | - operational: tracked completion and reminders
Owner: OH Nurse Manager</bpmn:text>
      </bpmn:textAnnotation>
