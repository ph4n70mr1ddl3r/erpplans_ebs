    <bpmn:process id="W_W2857" name="W2857. Pre-Employment Medical Examination &amp; Fitness-to-Work Clearance" isExecutable="false">
      <bpmn:documentation>Trigger: Conditional job offer
Frequency: ~1,200–1,600 hires/year
Volume: All new hires
Owner: OH Nurse
Participants: OH Nurse, HR, Company Physician, HMO
Source: workflow W2857 — Pre-Employment Medical Examination &amp; Fitness-to-Work Clearance</bpmn:documentation>
      <bpmn:laneSet id="W2857_LaneSet3">
        <bpmn:lane id="W2857_Lane1" name="HR">
        <bpmn:flowNodeRef>W2857_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2857_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2857_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2857_Lane2" name="OH Nurse">
        <bpmn:flowNodeRef>W2857_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2857_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2857_Start4" name="Conditional job offer">
        <bpmn:outgoing>W2857_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2857_Task5" name="HR refers conditional hire for pre-employment medical exam (physical, chest…">
        <bpmn:documentation>Step 1: HR refers conditional hire for pre-employment medical exam (physical, chest X-ray, drug test, lab work) at accredited clinic
Responsible (R): HR
Accountable (A): OH Nurse Manager
Duration: Per hire</bpmn:documentation>
        <bpmn:incoming>W2857_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2857_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2857_Task6" name="OH Nurse/Physician reviews results; determines fitness-to-work for specific…">
        <bpmn:documentation>Step 2: OH Nurse/Physician reviews results; determines fitness-to-work for specific role (lifting requirements, hazmat handling, driving)
Responsible (R): OH Nurse / Company Physician
Accountable (A): OH Nurse Manager
Duration: Per hire</bpmn:documentation>
        <bpmn:incoming>W2857_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2857_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2857_Task7" name="HR clears hire for onboarding or rescinds offer per medical findings (subject…">
        <bpmn:documentation>Step 3: HR clears hire for onboarding or rescinds offer per medical findings (subject to anti-discrimination law); archives record confidentially
Responsible (R): HR
Accountable (A): HR Manager
Duration: Per hire</bpmn:documentation>
        <bpmn:incoming>W2857_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2857_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2857_End8" name="Complete">
        <bpmn:incoming>W2857_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2857_Annotation9">
        <bpmn:text>Controls: - CTL-479 (ensure controlled execution — Periodic Examination, DOLE Compliance &amp; Disease Surveillance (PA-83.2).) | - operational: accredited-clinic SLA and batched scheduling
Owner: OH Nurse</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2857_Assoc10" sourceRef="W2857_Annotation9" targetRef="W2857_Start4" associationDirection="None" />
