      <bpmn:sequenceFlow id="W3000_Flow12" sourceRef="W3000_Task5" targetRef="W3000_Task6" />
      <bpmn:sequenceFlow id="W3000_Flow13" sourceRef="W3000_Task6" targetRef="W3000_Task7" />
      <bpmn:sequenceFlow id="W3000_Flow14" sourceRef="W3000_Task7" targetRef="W3000_End8" />
    </bpmn:process>
