        <bpmndi:BPMNShape id="W2995_Annotation10_di" bpmnElement="W2995_Annotation10"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2995_Flow12_di" bpmnElement="W2995_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2995_Flow13_di" bpmnElement="W2995_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2995_Flow14_di" bpmnElement="W2995_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2995_Flow15_di" bpmnElement="W2995_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2995_Assoc11_di" bpmnElement="W2995_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2996" name="W2996. Recall Strategy, Scope &amp; Lot/Shipment Traceability Definition" isExecutable="false">
      <bpmn:documentation>Trigger: Recall decision + regulatory notification filed
Frequency: Per recall event
Volume: ~3–8 recalls/year
Owner: Supply Chain Planning Manager
Participants: Supply Planning, Quality, Merchandising, IT, Store Ops, Ecommerce
Source: workflow W2996 — Recall Strategy, Scope &amp; Lot/Shipment Traceability Definition</bpmn:documentation>
      <bpmn:laneSet id="W2996_LaneSet4">
        <bpmn:lane id="W2996_Lane1" name="Supply Planning">
        <bpmn:flowNodeRef>W2996_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2996_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2996_Lane2" name="IT">
        <bpmn:flowNodeRef>W2996_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2996_Lane3" name="Merchandising">
        <bpmn:flowNodeRef>W2996_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2996_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2996_Start5" name="Recall decision + regulatory notification filed">
        <bpmn:outgoing>W2996_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2996_Task6" name="Supply Planning defines recall scope: affected SKU(s), lots/batches, date…">
        <bpmn:documentation>Step 1: Supply Planning defines recall scope: affected SKU(s), lots/batches, date ranges, receiving locations (DCs, stores), and sales channel exposure (in-store, ecommerce, marketplace, B2B)
Responsible (R): Supply Planning
Accountable (A): Supply Chain Planning Manager
Duration: Per recall</bpmn:documentation>
