      <bpmndi:BPMNPlane id="W2995_plane" bpmnElement="W_W2995">
        <bpmndi:BPMNShape id="W2995_Lane1_di" bpmnElement="W2995_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2995_Lane2_di" bpmnElement="W2995_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2995_Lane3_di" bpmnElement="W2995_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2995_Task6_di" bpmnElement="W2995_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2995_Task7_di" bpmnElement="W2995_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
