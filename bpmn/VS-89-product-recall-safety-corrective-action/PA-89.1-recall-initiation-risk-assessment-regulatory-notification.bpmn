<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-89.1-recall-initiation-risk-assessment-regulatory-notification" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2993" name="W2993. Product Safety Issue Intake, Triage &amp; Hazard Classification" isExecutable="false">
      <bpmn:documentation>Trigger: Safety complaint, regulator alert, vendor notice, or field incident
Frequency: Event-driven (~30–60 candidate issues/year)
Volume: ~30–60 issues triaged; ~3–8 escalate to formal recall
Owner: Product Safety &amp; Compliance Manager
Participants: Product Safety Mgr, Quality, Customer Service, Vendor Mgmt, Legal, Store Ops
Source: workflow W2993 — Product Safety Issue Intake, Triage &amp; Hazard Classification</bpmn:documentation>
      <bpmn:laneSet id="W2993_LaneSet4">
        <bpmn:lane id="W2993_Lane1" name="Customer Service">
        <bpmn:flowNodeRef>W2993_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2993_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2993_Lane2" name="Product Safety &amp; Compliance Manager">
        <bpmn:flowNodeRef>W2993_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2993_Lane3" name="Quality">
        <bpmn:flowNodeRef>W2993_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2993_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2993_Start5" name="Safety complaint, regulator alert, vendor notice, or field incident">
        <bpmn:outgoing>W2993_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2993_Task6" name="Customer Service / Store Ops / Quality logs safety issue in recall case system…">
        <bpmn:documentation>Step 1: Customer Service / Store Ops / Quality logs safety issue in recall case system (source, SKU, lot, incident description, photos, injury/property damage flag)
Responsible (R): Customer Service / Store Ops / Quality
Accountable (A): Product Safety &amp; Compliance Manager
Duration: Per issue (&lt;24 hr)</bpmn:documentation>
        <bpmn:incoming>W2993_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2993_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2993_Task7" name="Product Safety Mgr triages and classifies hazard (electrical/fire…">
        <bpmn:documentation>Step 2: Product Safety Mgr triages and classifies hazard (electrical/fire, chemical/toxic, mechanical/laceration, structural/failure, labeling/allergen) and assigns preliminary severity (Class I–III per Consumer Act / DTI-BPS)
Responsible (R): Product Safety &amp; Compliance Manager
Accountable (A): Quality Manager
Duration: Per issue</bpmn:documentation>
        <bpmn:incoming>W2993_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2993_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2993_Task8" name="Quality/Vendor Mgmt confirms affected SKU, lot, vendor, and whether the issue…">
        <bpmn:documentation>Step 3: Quality/Vendor Mgmt confirms affected SKU, lot, vendor, and whether the issue is isolated or systemic; duplicates against existing open recalls
Responsible (R): Quality / Vendor Mgmt
Accountable (A): Product Safety &amp; Compliance Manager
Duration: Per issue</bpmn:documentation>
        <bpmn:incoming>W2993_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2993_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2993_End9" name="Complete">
        <bpmn:incoming>W2993_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2993_Annotation10">
        <bpmn:text>Controls: - CTL-496 (ensure controlled execution — Recall Initiation, Risk Assessment &amp; Regulatory Notification (PA-89.1).) | - operational: mandatory hazard-classification field and dedicated triage queue
Owner: Product Safety &amp; Compliance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2993_Assoc11" sourceRef="W2993_Annotation10" targetRef="W2993_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2993_Flow12" sourceRef="W2993_Start5" targetRef="W2993_Task6" />
      <bpmn:sequenceFlow id="W2993_Flow13" sourceRef="W2993_Task6" targetRef="W2993_Task7" />
      <bpmn:sequenceFlow id="W2993_Flow14" sourceRef="W2993_Task7" targetRef="W2993_Task8" />
      <bpmn:sequenceFlow id="W2993_Flow15" sourceRef="W2993_Task8" targetRef="W2993_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2993_diag">
      <bpmndi:BPMNPlane id="W2993_plane" bpmnElement="W_W2993">
        <bpmndi:BPMNShape id="W2993_Lane1_di" bpmnElement="W2993_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2993_Lane2_di" bpmnElement="W2993_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2993_Lane3_di" bpmnElement="W2993_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2993_Task6_di" bpmnElement="W2993_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2993_Task7_di" bpmnElement="W2993_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2993_Task8_di" bpmnElement="W2993_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2993_Start5_di" bpmnElement="W2993_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2993_End9_di" bpmnElement="W2993_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2993_Annotation10_di" bpmnElement="W2993_Annotation10"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2993_Flow12_di" bpmnElement="W2993_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2993_Flow13_di" bpmnElement="W2993_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2993_Flow14_di" bpmnElement="W2993_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2993_Flow15_di" bpmnElement="W2993_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2993_Assoc11_di" bpmnElement="W2993_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2994" name="W2994. Recall Risk Assessment &amp; Corrective Action Decision" isExecutable="false">
      <bpmn:documentation>Trigger: Triaged issue flagged Class I/II or systemic
Frequency: Event-driven
Volume: ~8–15 risk assessments/year
Owner: Product Safety &amp; Compliance Manager
Participants: Product Safety Mgr, Quality, Legal, Merchandising, Insurance, DPO
Source: workflow W2994 — Recall Risk Assessment &amp; Corrective Action Decision</bpmn:documentation>
      <bpmn:laneSet id="W2994_LaneSet4">
        <bpmn:lane id="W2994_Lane1" name="Product Safety &amp; Compliance Manager">
        <bpmn:flowNodeRef>W2994_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2994_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2994_Lane2" name="Legal">
        <bpmn:flowNodeRef>W2994_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2994_Lane3" name="Recall Committee">
        <bpmn:flowNodeRef>W2994_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2994_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2994_Start5" name="Triaged issue flagged Class I/II or systemic">
        <bpmn:outgoing>W2994_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2994_Task6" name="Product Safety Mgr performs risk assessment: probability of harm × severity ×…">
        <bpmn:documentation>Step 1: Product Safety Mgr performs risk assessment: probability of harm × severity × exposure (units in market, time since sale); documents likelihood of regulatory mandatory action
Responsible (R): Product Safety &amp; Compliance Manager
Accountable (A): Quality Manager
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W2994_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2994_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2994_Task7" name="Legal/Insurance assesses liability, product-liability exposure, and policy…">
        <bpmn:documentation>Step 2: Legal/Insurance assesses liability, product-liability exposure, and policy notification triggers; DPO screens affected-customer data needed for notification
Responsible (R): Legal / Insurance / DPO
Accountable (A): VP Legal &amp; Compliance
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2994_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2994_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2994_Task8" name="Recall Committee reviews assessment; decides corrective action type (full…">
        <bpmn:documentation>Step 3: Recall Committee reviews assessment; decides corrective action type (full recall, stop-sale, field repair, consumer notice, no-action); documents rationale and decision authority
Responsible (R): Recall Committee
Accountable (A): VP Legal &amp; Compliance / COO
Duration: Per decision</bpmn:documentation>
        <bpmn:incoming>W2994_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2994_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2994_End9" name="Complete">
        <bpmn:incoming>W2994_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2994_Annotation10">
        <bpmn:text>Controls: - CTL-152 (ensure recall regulatory reporting &amp; closure.) | - operational: documented severity matrix and committee review
Owner: Product Safety &amp; Compliance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2994_Assoc11" sourceRef="W2994_Annotation10" targetRef="W2994_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2994_Flow12" sourceRef="W2994_Start5" targetRef="W2994_Task6" />
      <bpmn:sequenceFlow id="W2994_Flow13" sourceRef="W2994_Task6" targetRef="W2994_Task7" />
      <bpmn:sequenceFlow id="W2994_Flow14" sourceRef="W2994_Task7" targetRef="W2994_Task8" />
      <bpmn:sequenceFlow id="W2994_Flow15" sourceRef="W2994_Task8" targetRef="W2994_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2994_diag">
      <bpmndi:BPMNPlane id="W2994_plane" bpmnElement="W_W2994">
        <bpmndi:BPMNShape id="W2994_Lane1_di" bpmnElement="W2994_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2994_Lane2_di" bpmnElement="W2994_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2994_Lane3_di" bpmnElement="W2994_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2994_Task6_di" bpmnElement="W2994_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2994_Task7_di" bpmnElement="W2994_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2994_Task8_di" bpmnElement="W2994_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2994_Start5_di" bpmnElement="W2994_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2994_End9_di" bpmnElement="W2994_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2994_Annotation10_di" bpmnElement="W2994_Annotation10"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2994_Flow12_di" bpmnElement="W2994_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2994_Flow13_di" bpmnElement="W2994_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2994_Flow14_di" bpmnElement="W2994_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2994_Flow15_di" bpmnElement="W2994_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2994_Assoc11_di" bpmnElement="W2994_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2995" name="W2995. DTI-BPS / FDA Regulatory Notification &amp; Filing" isExecutable="false">
      <bpmn:documentation>Trigger: Recall decision confirmed (Class I/II)
Frequency: Per recall event
Volume: ~3–8 recalls/year
Owner: Regulatory Compliance Officer
Participants: Regulatory Officer, Product Safety Mgr, Legal, Tax/Records
Source: workflow W2995 — DTI-BPS / FDA Regulatory Notification &amp; Filing</bpmn:documentation>
      <bpmn:laneSet id="W2995_LaneSet4">
        <bpmn:lane id="W2995_Lane1" name="Regulatory Compliance Officer">
        <bpmn:flowNodeRef>W2995_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2995_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2995_Lane2" name="Legal">
        <bpmn:flowNodeRef>W2995_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2995_Lane3" name="Records Manager">
        <bpmn:flowNodeRef>W2995_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2995_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2995_Start5" name="Recall decision confirmed (Class I/II)">
        <bpmn:outgoing>W2995_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2995_Task6" name="Regulatory Compliance Officer prepares and files notification with DTI-BPS…">
        <bpmn:documentation>Step 1: Regulatory Compliance Officer prepares and files notification with DTI-BPS (consumer product safety) and/or FDA (regulated goods), within mandated timelines, including product, hazard, scope, and remedy
Responsible (R): Regulatory Compliance Officer
Accountable (A): Regulatory Compliance Manager
Duration: Per filing (&lt;48 hr for mandatory, per the W1618 convention)</bpmn:documentation>
        <bpmn:incoming>W2995_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2995_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2995_Task7" name="Legal/Regulatory notifies relevant LGUs and, for imports, Bureau of Customs and…">
        <bpmn:documentation>Step 2: Legal/Regulatory notifies relevant LGUs and, for imports, Bureau of Customs and country-of-origin regulators; confirms any PS/ICC mark suspension
Responsible (R): Legal / Regulatory
Accountable (A): Regulatory Compliance Manager
Duration: Per recall</bpmn:documentation>
        <bpmn:incoming>W2995_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2995_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2995_Task8" name="Records Mgr retains regulatory correspondence and filings per BIR/SEC 10-year…">
        <bpmn:documentation>Step 3: Records Mgr retains regulatory correspondence and filings per BIR/SEC 10-year and Consumer Act retention rules
Responsible (R): Records Manager
Accountable (A): Regulatory Compliance Manager
Duration: Per recall</bpmn:documentation>
        <bpmn:incoming>W2995_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2995_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2995_End9" name="Complete">
        <bpmn:incoming>W2995_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2995_Annotation10">
        <bpmn:text>Controls: - CTL-496 (ensure controlled execution — Recall Initiation, Risk Assessment &amp; Regulatory Notification (PA-89.1).) | - operational: compliance calendar and pre-cleared templates
Owner: Regulatory Compliance Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2995_Assoc11" sourceRef="W2995_Annotation10" targetRef="W2995_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2995_Flow12" sourceRef="W2995_Start5" targetRef="W2995_Task6" />
      <bpmn:sequenceFlow id="W2995_Flow13" sourceRef="W2995_Task6" targetRef="W2995_Task7" />
      <bpmn:sequenceFlow id="W2995_Flow14" sourceRef="W2995_Task7" targetRef="W2995_Task8" />
      <bpmn:sequenceFlow id="W2995_Flow15" sourceRef="W2995_Task8" targetRef="W2995_End9" />
    </bpmn:process>
