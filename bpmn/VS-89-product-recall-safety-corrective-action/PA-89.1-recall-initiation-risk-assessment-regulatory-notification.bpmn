    <bpmn:process id="W_W3000" name="W3000. Stop-Sale, Quarantine &amp; Inventory Hold Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Recall decision (or pre-decision precautionary hold)
Frequency: Per recall event
Volume: ~3–8 holds/year affecting 200 stores + 4 DCs + ecommerce
Owner: Inventory Control Manager
Participants: Inventory Control, DC Ops, Store Ops, Ecommerce, IT
Source: workflow W3000 — Stop-Sale, Quarantine &amp; Inventory Hold Execution</bpmn:documentation>
      <bpmn:laneSet id="W3000_LaneSet3">
        <bpmn:lane id="W3000_Lane1" name="Inventory Control">
        <bpmn:flowNodeRef>W3000_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3000_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3000_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3000_Lane2" name="DC Ops">
        <bpmn:flowNodeRef>W3000_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3000_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3000_Start4" name="Recall decision (or pre-decision precautionary hold)">
        <bpmn:outgoing>W3000_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3000_Task5" name="Inventory Control/IT places system-wide stop-sale (POS block…">
        <bpmn:documentation>Step 1: Inventory Control/IT places system-wide stop-sale (POS block, ecommerce/marketplace listing suspension, PO/replenishment freeze) on affected SKU/lot across all locations
Responsible (R): Inventory Control / IT
Accountable (A): Inventory Control Manager
Duration: &lt;4 hr</bpmn:documentation>
        <bpmn:incoming>W3000_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3000_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3000_Task6" name="DC Ops/Store Ops physically quarantine on-hand stock to segregated recall…">
        <bpmn:documentation>Step 2: DC Ops/Store Ops physically quarantine on-hand stock to segregated recall bin/area; apply recall hold labels; prevent sale or shipment
Responsible (R): DC Ops / Store Ops
Accountable (A): DC Operations Manager / Store Manager
Duration: &lt;24 hr</bpmn:documentation>
        <bpmn:incoming>W3000_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3000_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3000_Task7" name="Inventory Control reconciles quarantined quantities vs. system stock…">
        <bpmn:documentation>Step 3: Inventory Control reconciles quarantined quantities vs. system stock; investigates variances; secures high-value/regulated goods under additional LP control
Responsible (R): Inventory Control / Loss Prevention
Accountable (A): Inventory Control Manager
Duration: Per recall</bpmn:documentation>
        <bpmn:incoming>W3000_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3000_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3000_End8" name="Complete">
        <bpmn:incoming>W3000_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3000_Annotation9">
        <bpmn:text>Controls: - CTL-496 (ensure controlled execution — Recall Initiation, Risk Assessment &amp; Regulatory Notification (PA-89.1).) | - operational: immediate system-wide block before physical quarantine
Owner: Inventory Control Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3000_Assoc10" sourceRef="W3000_Annotation9" targetRef="W3000_Start4" associationDirection="None" />
