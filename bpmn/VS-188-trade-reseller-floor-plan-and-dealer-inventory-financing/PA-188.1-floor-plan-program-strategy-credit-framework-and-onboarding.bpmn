    <bpmn:process id="W_W5370" name="W5370. Dealer Eligibility, Credit Underwriting &amp; Floor-Plan Limit Setting" isExecutable="false">
      <bpmn:documentation>Trigger: Dealer applies for floor-plan; annual limit review
Frequency: Per dealer onboarding; annual review
Volume: ~1,000 active floor-plan dealers (the program register); ~50 new onboardings/yr replacing churned dealers
Owner: Credit Analyst (Dealer Finance)
Participants: Credit Manager, Trade Account Manager (VS-107), Compliance/AML (VS-86)
Source: workflow W5370 — Dealer Eligibility, Credit Underwriting &amp; Floor-Plan Limit Setting</bpmn:documentation>
      <bpmn:laneSet id="W5370_LaneSet3">
        <bpmn:lane id="W5370_Lane1" name="Credit Analyst">
        <bpmn:flowNodeRef>W5370_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5370_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5370_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5370_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5370_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5370_Lane2" name="Credit Manager">
        <bpmn:flowNodeRef>W5370_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5370_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5370_Start4" name="Dealer applies for floor-plan; annual limit review">
        <bpmn:outgoing>W5370_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5370_Task5" name="Collect dealer KYB: business registration (SEC/DTI/CDA), financials, trade…">
        <bpmn:documentation>Step 1: Collect dealer KYB: business registration (SEC/DTI/CDA), financials, trade references, and existing trade-account history (VS-11/VS-68).
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W5370_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5370_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5370_Task6" name="Run credit underwriting: financial ratios, payment history, sales velocity, and…">
        <bpmn:documentation>Step 2: Run credit underwriting: financial ratios, payment history, sales velocity, and KYC/AML/sanctions (VS-86).
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W5370_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5370_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5370_Task7" name="Set the floor-plan limit per dealer based on stocking need, sales velocity, and…">
        <bpmn:documentation>Step 3: Set the floor-plan limit per dealer based on stocking need, sales velocity, and risk grade; apply program ceilings (W5369).
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W5370_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5370_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5370_Task8" name="Document the credit decision and approval per the credit-authority matrix…">
        <bpmn:documentation>Step 4: Document the credit decision and approval per the credit-authority matrix (separation CTL-12).
Responsible (R): Credit Manager
Accountable (A): Credit Manager
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W5370_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5370_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5370_Task9" name="Communicate the limit and terms to the dealer; set up in the floor-plan system…">
        <bpmn:documentation>Step 5: Communicate the limit and terms to the dealer; set up in the floor-plan system (W5374).
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W5370_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5370_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5370_End10" name="Complete">
        <bpmn:incoming>W5370_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5370_Annotation11">
        <bpmn:text>Controls: - CTL-794 (ensure controlled execution — Program Strategy, Credit Framework &amp; Dealer Onboarding (PA-188.1).) | - operational: credit approval separated from sales execution (authority matrix); dealer/KYB onboarding records complete before limit setting.
Owner: Credit Analyst (Dealer Finance)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5370_Assoc12" sourceRef="W5370_Annotation11" targetRef="W5370_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5370_Flow13" sourceRef="W5370_Start4" targetRef="W5370_Task5" />
      <bpmn:sequenceFlow id="W5370_Flow14" sourceRef="W5370_Task5" targetRef="W5370_Task6" />
