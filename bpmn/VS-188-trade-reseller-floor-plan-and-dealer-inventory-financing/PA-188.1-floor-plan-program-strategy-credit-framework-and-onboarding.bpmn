Responsible (R): Credit Manager
Accountable (A): CFO
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W5375_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5375_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5375_Task9" name="Negotiate manufacturer/brand subvention (rate buy-down) on eligible categories…">
