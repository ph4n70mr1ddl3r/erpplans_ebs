      <bpmn:sequenceFlow id="W5370_Flow16" sourceRef="W5370_Task7" targetRef="W5370_Task8" />
      <bpmn:sequenceFlow id="W5370_Flow17" sourceRef="W5370_Task8" targetRef="W5370_Task9" />
      <bpmn:sequenceFlow id="W5370_Flow18" sourceRef="W5370_Task9" targetRef="W5370_End10" />
    </bpmn:process>
