      </bpmn:startEvent>
      <bpmn:userTask id="W5372_Task5" name="Verify the dealer&#x27;s physical inventory against the floor-plan stocking list…">
        <bpmn:documentation>Step 1: Verify the dealer&#x27;s physical inventory against the floor-plan stocking list (serial/VIN/lot per funded unit).
Responsible (R): Field Examiner
Accountable (A): Credit Manager
Duration: per exam</bpmn:documentation>
        <bpmn:incoming>W5372_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5372_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5372_Task6" name="Confirm BuildRight&#x27;s collateral is identifiable, present, and not…">
        <bpmn:documentation>Step 2: Confirm BuildRight&#x27;s collateral is identifiable, present, and not commingled/sold-out-of-trust.
Responsible (R): Field Examiner
Accountable (A): Credit Manager
Duration: per exam</bpmn:documentation>
        <bpmn:incoming>W5372_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5372_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5372_Task7" name="Reconcile stocking list ↔ floor-plan ledger ↔ dealer&#x27;s own inventory system.">
        <bpmn:documentation>Step 3: Reconcile stocking list ↔ floor-plan ledger ↔ dealer&#x27;s own inventory system.
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: per exam</bpmn:documentation>
        <bpmn:incoming>W5372_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5372_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5372_Task8" name="Document findings, exceptions (missing/sold units), and required cures; rate…">
        <bpmn:documentation>Step 4: Document findings, exceptions (missing/sold units), and required cures; rate the collateral coverage.
Responsible (R): Field Examiner
Accountable (A): Credit Manager
Duration: per exam</bpmn:documentation>
        <bpmn:incoming>W5372_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5372_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5372_Task9" name="Feed exceptions to curtailment/collections (W5382/W5385) and adjust the dealer…">
