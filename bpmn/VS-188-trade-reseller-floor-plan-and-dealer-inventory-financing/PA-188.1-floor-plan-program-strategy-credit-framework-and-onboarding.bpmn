<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-188.1-floor-plan-program-strategy-credit-framework-and-onboarding" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W5369" name="W5369. Floor-Plan &amp; Dealer Financing Program Strategy, Product Design &amp; Risk Appetite" isExecutable="false">
      <bpmn:documentation>Trigger: Executive decision to launch/expand dealer inventory financing
Frequency: Annual strategy refresh
Volume: 1 program strategy/yr
Owner: Treasury/Working-Capital Lead
Participants: CFO, VP Legal &amp; Compliance, Credit Manager (VS-68), Merchandising/Trade (VS-11)
Source: workflow W5369 — Floor-Plan &amp; Dealer Financing Program Strategy, Product Design &amp; Risk Appetite</bpmn:documentation>
      <bpmn:laneSet id="W5369_LaneSet6">
        <bpmn:lane id="W5369_Lane1" name="Treasury Lead">
        <bpmn:flowNodeRef>W5369_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5369_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5369_Lane2" name="Credit Manager">
        <bpmn:flowNodeRef>W5369_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5369_Lane3" name="Finance Business Partner">
        <bpmn:flowNodeRef>W5369_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5369_Lane4" name="Legal Counsel">
        <bpmn:flowNodeRef>W5369_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5369_Lane5" name="CFO">
        <bpmn:flowNodeRef>W5369_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5369_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5369_Start7" name="Executive decision to launch/expand dealer inventory financing">
        <bpmn:outgoing>W5369_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5369_Task8" name="Define the eligible reseller segments (sub-distributors, larger sari-sari/MSME…">
        <bpmn:documentation>Step 1: Define the eligible reseller segments (sub-distributors, larger sari-sari/MSME per VS-82, cooperatives per VS-94/VS-185) and eligible product categories (high-value, resalable, identifiable — appliances, power tools, equipment).
Responsible (R): Treasury Lead
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5369_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5369_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5369_Task9" name="Set the risk appetite: max program exposure, per-dealer limit ceilings, advance…">
        <bpmn:documentation>Step 2: Set the risk appetite: max program exposure, per-dealer limit ceilings, advance rates, and target NPL/loss rate.
Responsible (R): Credit Manager
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5369_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5369_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5369_Task10" name="Build the business case: financing margin vs. funding cost, wholesale-volume…">
        <bpmn:documentation>Step 3: Build the business case: financing margin vs. funding cost, wholesale-volume lift, default/loss assumption, and capital allocation.
Responsible (R): Finance Business Partner
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5369_Flow18</bpmn:incoming>
        <bpmn:outgoing>W5369_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5369_Task11" name="Confirm the legal/regulatory vehicle (in-house AR/lending vs. lending-company…">
        <bpmn:documentation>Step 4: Confirm the legal/regulatory vehicle (in-house AR/lending vs. lending-company structure under RA 9474 / BSP or financing-company structure under RA 8556 / SEC) and BSP/SEC implications.
Responsible (R): Legal Counsel
Accountable (A): VP Legal &amp; Compliance
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5369_Flow19</bpmn:incoming>
        <bpmn:outgoing>W5369_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5369_Task12" name="Approve at the capital/credit committee and board reporting (VS-36/VS-173).">
        <bpmn:documentation>Step 5: Approve at the capital/credit committee and board reporting (VS-36/VS-173).
Responsible (R): CFO
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5369_Flow20</bpmn:incoming>
        <bpmn:outgoing>W5369_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5369_End13" name="Complete">
        <bpmn:incoming>W5369_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5369_Annotation14">
        <bpmn:text>Controls: - CTL-794 (ensure controlled execution — Program Strategy, Credit Framework &amp; Dealer Onboarding (PA-188.1).) | - operational: capital/program approval with exposure-limit and budget adherence at Board/ExComm gates.
Owner: Treasury/Working-Capital Lead</bpmn:text>
      </bpmn:textAnnotation>
