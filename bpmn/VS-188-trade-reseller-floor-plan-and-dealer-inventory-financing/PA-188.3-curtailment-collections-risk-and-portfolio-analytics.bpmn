    <bpmn:process id="W_W5385" name="W5385. Dealer Aging, Curtailment Default &amp; Out-of-Trust (OOT) Detection" isExecutable="false">
      <bpmn:documentation>Trigger: Daily aging run; curtailment-period expiry; sold-but-not-curtailed flag (W5382)
Frequency: Daily
Volume: ~1,000 active dealers monitored daily
Owner: Credit Manager (Dealer Finance)
Participants: Credit Analyst, Collections, Field Examiner
Source: workflow W5385 — Dealer Aging, Curtailment Default &amp; Out-of-Trust (OOT) Detection</bpmn:documentation>
      <bpmn:laneSet id="W5385_LaneSet4">
        <bpmn:lane id="W5385_Lane1" name="Credit Analyst">
        <bpmn:flowNodeRef>W5385_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5385_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5385_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5385_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5385_Lane2" name="Collections">
        <bpmn:flowNodeRef>W5385_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5385_Lane3" name="Credit Manager">
        <bpmn:flowNodeRef>W5385_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5385_End11</bpmn:flowNodeRef>
        </bpmn:lane>
