      <bpmn:startEvent id="W5385_Start5" name="Daily aging run; curtailment-period expiry; sold-but-not-curtailed flag (W5382)">
        <bpmn:outgoing>W5385_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5385_Task6" name="Run daily aging on curtailment and interest balances by dealer and bucket…">
        <bpmn:documentation>Step 1: Run daily aging on curtailment and interest balances by dealer and bucket (current/30/60/90+).
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: daily</bpmn:documentation>
        <bpmn:incoming>W5385_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5385_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5385_Task7" name="Flag curtailment defaults (units sold but unpaid past period) and OOT exposure…">
        <bpmn:documentation>Step 2: Flag curtailment defaults (units sold but unpaid past period) and OOT exposure per dealer.
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: daily</bpmn:documentation>
        <bpmn:incoming>W5385_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5385_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5385_Task8" name="Triage: contact dealer, confirm cause, and set a cure timeline (pay-down or…">
        <bpmn:documentation>Step 3: Triage: contact dealer, confirm cause, and set a cure timeline (pay-down or collateral substitution).
Responsible (R): Collections
Accountable (A): Credit Manager
Duration: per flag</bpmn:documentation>
        <bpmn:incoming>W5385_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5385_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5385_Task9" name="Escalate repeat/serious OOT to workout (W5386) and risk-grade downgrade (W5388).">
        <bpmn:documentation>Step 4: Escalate repeat/serious OOT to workout (W5386) and risk-grade downgrade (W5388).
Responsible (R): Credit Manager
Accountable (A): Credit Manager
Duration: per escalation</bpmn:documentation>
        <bpmn:incoming>W5385_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5385_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5385_Task10" name="Report portfolio aging and OOT exposure to the credit committee (W5391).">
        <bpmn:documentation>Step 5: Report portfolio aging and OOT exposure to the credit committee (W5391).
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: weekly</bpmn:documentation>
        <bpmn:incoming>W5385_Flow18</bpmn:incoming>
        <bpmn:outgoing>W5385_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5385_End11" name="Complete">
        <bpmn:incoming>W5385_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5385_Annotation12">
        <bpmn:text>Controls: - CTL-796: OOT/fraud detection; CTL-796 (aging accuracy); CTL-796 (cure-authority separation).
Owner: Credit Manager (Dealer Finance)</bpmn:text>
      </bpmn:textAnnotation>
