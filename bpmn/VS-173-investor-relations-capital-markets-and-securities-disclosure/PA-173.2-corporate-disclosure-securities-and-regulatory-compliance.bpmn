      <bpmndi:BPMNPlane id="W5018_plane" bpmnElement="W_W5018">
        <bpmndi:BPMNShape id="W5018_Lane1_di" bpmnElement="W5018_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5018_Lane2_di" bpmnElement="W5018_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
