        <bpmndi:BPMNEdge id="W5018_Flow12_di" bpmnElement="W5018_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5018_Flow13_di" bpmnElement="W5018_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5018_Flow14_di" bpmnElement="W5018_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5018_Assoc10_di" bpmnElement="W5018_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5019" name="W5019. Material-Event / Ad-Hoc Disclosure, Press-Release Control &amp; Rumor-Response Protocol" isExecutable="false">
      <bpmn:documentation>Trigger: Material event (operational/financial/legal/ESG); market rumor; guidance update; transaction (VS-130)
Frequency: Event-driven
Volume: ~5–15 material events per year + rumor incidents
Owner: VP Investor Relations / VP Legal &amp; Compliance (VS-100) / CFO
Participants: Legal (VS-100), Compliance (VS-22), CFO/CEO, Crisis Comms (VS-14), Corporate Security (VS-159), HSE (VS-24), Strategy (VS-33)
Source: workflow W5019 — Material-Event / Ad-Hoc Disclosure, Press-Release Control &amp; Rumor-Response Protocol</bpmn:documentation>
      <bpmn:laneSet id="W5019_LaneSet2">
        <bpmn:lane id="W5019_Lane1" name="VP IR">
        <bpmn:flowNodeRef>W5019_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5019_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5019_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5019_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5019_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5019_Start3" name="Material event (operational/financial/legal/ESG); market rumor; guidance update…">
        <bpmn:outgoing>W5019_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5019_Task4" name="Assess &amp; decide on material events: when a material event occurs (incident…">
        <bpmn:documentation>Step 1: Assess &amp; decide on material events: when a material event occurs (incident, major loss, litigation, leadership change, transaction VS-130, rating action), assess materiality (W5017), decide timing/form of disclosure, and convene the disclosure committee / crisis comms (links VS-14 W1562, VS-26 BC)
Responsible (R): VP IR / Legal / CFO / Crisis Comms
Accountable (A): Disclosure Committee / CEO
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W5019_Flow10</bpmn:incoming>
        <bpmn:outgoing>W5019_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5019_Task5" name="Issue the ad-hoc disclosure &amp; press release: draft (legal-reviewed…">
        <bpmn:documentation>Step 2: Issue the ad-hoc disclosure &amp; press release: draft (legal-reviewed, disclosure-controlled W5017), approve, and release simultaneously to public/SEC/IR website (W5014) within the required timeframe — no selective pre-notification
Responsible (R): VP IR / Legal / Comms
Accountable (A): CFO / VP Legal &amp; Compliance
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W5019_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5019_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5019_Task6" name="Run the rumor-response protocol: monitor market/media/social rumor (links VS-14…">
        <bpmn:documentation>Step 3: Run the rumor-response protocol: monitor market/media/social rumor (links VS-14 reputation), assess whether a public statement/confirmation/correction is required (duty to correct under RA 8799/SEC), and respond fairly &amp; timely (W5015)
Responsible (R): VP IR / Legal / Compliance
Accountable (A): Disclosure Committee
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W5019_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5019_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5019_End7" name="Complete">
        <bpmn:incoming>W5019_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5019_Annotation8">
        <bpmn:text>Controls: - CTL-117 (ensure disclosure &amp; insider-trading compliance.) | - CTL-750: material events assessed &amp; disclosed timely; duty-to-correct honored; simultaneous release (W5017); legal-reviewed
Owner: VP Investor Relations / VP Legal &amp; Compliance (VS-100) / CFO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5019_Assoc9" sourceRef="W5019_Annotation8" targetRef="W5019_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W5019_Flow10" sourceRef="W5019_Start3" targetRef="W5019_Task4" />
      <bpmn:sequenceFlow id="W5019_Flow11" sourceRef="W5019_Task4" targetRef="W5019_Task5" />
      <bpmn:sequenceFlow id="W5019_Flow12" sourceRef="W5019_Task5" targetRef="W5019_Task6" />
      <bpmn:sequenceFlow id="W5019_Flow13" sourceRef="W5019_Task6" targetRef="W5019_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5019_diag">
      <bpmndi:BPMNPlane id="W5019_plane" bpmnElement="W_W5019">
        <bpmndi:BPMNShape id="W5019_Lane1_di" bpmnElement="W5019_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5019_Task4_di" bpmnElement="W5019_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5019_Task5_di" bpmnElement="W5019_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5019_Task6_di" bpmnElement="W5019_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5019_Start3_di" bpmnElement="W5019_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5019_End7_di" bpmnElement="W5019_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5019_Annotation8_di" bpmnElement="W5019_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W5019_Flow10_di" bpmnElement="W5019_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5019_Flow11_di" bpmnElement="W5019_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5019_Flow12_di" bpmnElement="W5019_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5019_Flow13_di" bpmnElement="W5019_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5019_Assoc9_di" bpmnElement="W5019_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5020" name="W5020. Annual Stockholders&#x27; Meeting (ASHM) Investor Notice, Proxy Statement &amp; Information Circular" isExecutable="false">
      <bpmn:documentation>Trigger: Annual ASHM cycle; special stockholders&#x27; meeting; resolution
Frequency: Annual + special meetings
Volume: ~1 ASHM + occasional special meetings × 5 entities
Owner: VP Investor Relations / Company Secretary (VS-36) / VP Legal &amp; Compliance (VS-100)
Participants: Governance (VS-36), Legal (VS-100), R2R (VS-17/W482 logistics), Corporate Security (VS-159/W4684), Compliance (VS-22)
Source: workflow W5020 — Annual Stockholders&#x27; Meeting (ASHM) Investor Notice, Proxy Statement &amp; Information Circular</bpmn:documentation>
      <bpmn:laneSet id="W5020_LaneSet3">
        <bpmn:lane id="W5020_Lane1" name="VP IR">
        <bpmn:flowNodeRef>W5020_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5020_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5020_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5020_Lane2" name="Company Secretary">
        <bpmn:flowNodeRef>W5020_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5020_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5020_Start4" name="Annual ASHM cycle; special stockholders&#x27; meeting; resolution">
        <bpmn:outgoing>W5020_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5020_Task5" name="Prepare the ASHM investor/proxy materials: the meeting notice…">
        <bpmn:documentation>Step 1: Prepare the ASHM investor/proxy materials: the meeting notice, agenda/resolutions, proxy statement/information circular, annual-report linkage (W5018), director/election &amp; audit/compensation disclosures, and related-party/special-business items (W5023) — all disclosure-controlled (W5017) and statutory-compliant
Responsible (R): VP IR / Company Secretary / Legal
Accountable (A): Company Secretary / VP Legal &amp; Compliance
Duration: Per meeting</bpmn:documentation>
        <bpmn:incoming>W5020_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5020_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5020_Task6" name="Distribute &amp; manage voting/proxy: notice &amp; circular distribution to…">
        <bpmn:documentation>Step 2: Distribute &amp; manage voting/proxy: notice &amp; circular distribution to shareholders of record (links W5025 register), proxy solicitation/collection, e-voting/quorum, and fair access (links VS-36 governance, VS-159/W4684 security)
Responsible (R): Company Secretary / VP IR / IT
Accountable (A): Company Secretary
Duration: Per meeting</bpmn:documentation>
        <bpmn:incoming>W5020_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5020_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5020_Task7" name="Conduct the ASHM &amp; report outcomes: the investor-facing meeting (narrative…">
        <bpmn:documentation>Step 3: Conduct the ASHM &amp; report outcomes: the investor-facing meeting (narrative W5009, Q&amp;A on fair-disclosure W5017), resolution recording, outcome disclosure (W5019), and minutes/governance feed (VS-36) — distinct from the meeting logistics (W482) and security (W4684)
Responsible (R): VP IR / Company Secretary / CEO
Accountable (A): Company Secretary / CEO
Duration: Per meeting</bpmn:documentation>
        <bpmn:incoming>W5020_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5020_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5020_End8" name="Complete">
        <bpmn:incoming>W5020_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5020_Annotation9">
        <bpmn:text>Controls: - CTL-750 (ensure controlled execution — Corporate Disclosure, Securities &amp; SEC/Regulatory Compliance (PA-173.2).) | - CTL-750: notice/circular legally compliant; fair-disclosure (W5017); proxy/voting integrity; outcomes disclosed (W5019)
Owner: VP Investor Relations / Company Secretary (VS-36) / VP Legal &amp; Compliance (VS-100)</bpmn:text>
      </bpmn:textAnnotation>
