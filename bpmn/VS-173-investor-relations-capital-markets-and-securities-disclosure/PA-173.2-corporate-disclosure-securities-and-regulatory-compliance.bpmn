        <bpmn:outgoing>W5021_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5021_Task4" name="Prepare transaction disclosure: for a debt/equity/securities offering or…">
        <bpmn:documentation>Step 1: Prepare transaction disclosure: for a debt/equity/securities offering or refinancing (links VS-18 facility, VS-170 ABL/collateral), the offering memorandum/circular/term-sheet narrative, use-of-proceeds, risk factors, and capital-structure impact — disclosure-controlled (W5017) and consistent with accounts (VS-17)
Responsible (R): VP IR / Treasury / Legal / Finance
Accountable (A): CFO / Treasurer
Duration: Per transaction</bpmn:documentation>
        <bpmn:incoming>W5021_Flow10</bpmn:incoming>
        <bpmn:outgoing>W5021_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5021_Task5" name="Manage transaction communications &amp; filing: SEC/securities-offering filing…">
        <bpmn:documentation>Step 2: Manage transaction communications &amp; filing: SEC/securities-offering filing (links VS-100, VS-166), investor/lender marketing (roadshow W5012, fair-disclosure W5017), rating-agency briefing (W5013), and simultaneous public disclosure (W5014)
Responsible (R): VP IR / Treasury / Legal
Accountable (A): CFO / Treasurer
Duration: Per transaction</bpmn:documentation>
        <bpmn:incoming>W5021_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5021_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5021_Task6" name="Report post-transaction: closing disclosure (W5019), ongoing…">
        <bpmn:documentation>Step 3: Report post-transaction: closing disclosure (W5019), ongoing covenant/listing/indenture reporting (links VS-18 W319, VS-170), and integration into annual report (W5018) and cap-table (W5025)
Responsible (R): VP IR / Treasury / Legal
Accountable (A): CFO
Duration: Per transaction</bpmn:documentation>
        <bpmn:incoming>W5021_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5021_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5021_End7" name="Complete">
        <bpmn:incoming>W5021_Flow13</bpmn:incoming>
      </bpmn:endEvent>
