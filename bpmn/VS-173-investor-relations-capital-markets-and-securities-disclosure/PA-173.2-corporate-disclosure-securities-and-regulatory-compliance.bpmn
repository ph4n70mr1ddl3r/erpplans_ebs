        <bpmndi:BPMNShape id="W5018_Start4_di" bpmnElement="W5018_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5018_End8_di" bpmnElement="W5018_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
