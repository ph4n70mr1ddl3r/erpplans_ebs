<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-173.2-corporate-disclosure-securities-and-regulatory-compliance" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W5017" name="W5017. Corporate Disclosure Controls, Materiality Assessment &amp; Selective-Disclosure / Fair-Disclosure Program" isExecutable="false">
      <bpmn:documentation>Trigger: Any potential external statement/disclosure; program setup; regulatory change (RA 8799/SEC rules)
Frequency: Continuous + per-disclosure
Volume: ~every investor-facing statement × disclosure events
Owner: VP Investor Relations / VP Legal &amp; Compliance (VS-100) / CFO
Participants: Legal (VS-100), Compliance (VS-22), CFO/CEO, Disclosure Committee, Internal Audit (VS-21), Corporate Secretary Analyst
Source: workflow W5017 — Corporate Disclosure Controls, Materiality Assessment &amp; Selective-Disclosure / Fair-Disclosure Program</bpmn:documentation>
      <bpmn:laneSet id="W5017_LaneSet2">
        <bpmn:lane id="W5017_Lane1" name="VP IR">
        <bpmn:flowNodeRef>W5017_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5017_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5017_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5017_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5017_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5017_Start3" name="Any potential external statement/disclosure; program setup; regulatory change (RA…">
        <bpmn:outgoing>W5017_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5017_Task4" name="Operate the disclosure-controls framework: the disclosure committee, the…">
        <bpmn:documentation>Step 1: Operate the disclosure-controls framework: the disclosure committee, the material-information register, the who-can-speak-to-investors policy, the pre-clearance of external statements (earnings W5011, events W5012, ESG W5016), and the evidence/audit trail that every disclosure was reviewed and approved
Responsible (R): VP IR / Legal / Compliance, Corporate Secretary Analyst
Accountable (A): CFO / VP Legal &amp; Compliance
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W5017_Flow10</bpmn:incoming>
        <bpmn:outgoing>W5017_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5017_Task5" name="Run materiality assessment: for any development (operational, financial, legal…">
        <bpmn:documentation>Step 2: Run materiality assessment: for any development (operational, financial, legal, ESG, transaction), assess materiality to investors/lenders under SEC/securities standards, decide disclose/withhold, and time the disclosure (links W5019 ad-hoc)
Responsible (R): VP IR / Legal / CFO
Accountable (A): Disclosure Committee
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W5017_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5017_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5017_Task6" name="Enforce fair-disclosure (Reg-FD-equivalent / RA 8799): ensure material info is…">
        <bpmn:documentation>Step 3: Enforce fair-disclosure (Reg-FD-equivalent / RA 8799): ensure material info is disclosed publicly and simultaneously (no selective disclosure to favored analysts/investors), manage the public-release channel (W5014), and train spokespeople
Responsible (R): VP IR / Legal / Compliance
Accountable (A): CFO / VP Legal &amp; Compliance
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W5017_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5017_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5017_End7" name="Complete">
        <bpmn:incoming>W5017_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5017_Annotation8">
        <bpmn:text>Controls: - CTL-117 (ensure disclosure &amp; insider-trading compliance.) | - CTL-750: disclosure committee; material-info register; pre-clearance; simultaneous public release; spokespeople trained
Owner: VP Investor Relations / VP Legal &amp; Compliance (VS-100) / CFO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5017_Assoc9" sourceRef="W5017_Annotation8" targetRef="W5017_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W5017_Flow10" sourceRef="W5017_Start3" targetRef="W5017_Task4" />
      <bpmn:sequenceFlow id="W5017_Flow11" sourceRef="W5017_Task4" targetRef="W5017_Task5" />
      <bpmn:sequenceFlow id="W5017_Flow12" sourceRef="W5017_Task5" targetRef="W5017_Task6" />
      <bpmn:sequenceFlow id="W5017_Flow13" sourceRef="W5017_Task6" targetRef="W5017_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5017_diag">
      <bpmndi:BPMNPlane id="W5017_plane" bpmnElement="W_W5017">
