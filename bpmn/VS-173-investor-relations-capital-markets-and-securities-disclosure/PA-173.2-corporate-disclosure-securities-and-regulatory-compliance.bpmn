      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5018" name="W5018. Annual Report, General Information Sheet &amp; Statutory SEC/Commissioner Investor Disclosure" isExecutable="false">
      <bpmn:documentation>Trigger: Annual close (VS-17); SEC filing calendar; statutory deadline
Frequency: Annual + periodic statutory filings
Volume: ~1 annual report + GIS + periodic statutory filings × 5 entities
Owner: VP Investor Relations / CFO / VP Legal &amp; Compliance (VS-100)
Participants: R2R (VS-17), Legal (VS-100), Compliance (VS-22), Treasury (VS-18), ESG (VS-25), External Auditor, Governance (VS-36), Corporate Secretary Analyst
Source: workflow W5018 — Annual Report, General Information Sheet &amp; Statutory SEC/Commissioner Investor Disclosure</bpmn:documentation>
      <bpmn:laneSet id="W5018_LaneSet3">
        <bpmn:lane id="W5018_Lane1" name="VP IR">
        <bpmn:flowNodeRef>W5018_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5018_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5018_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5018_Lane2" name="Legal">
        <bpmn:flowNodeRef>W5018_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5018_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5018_Start4" name="Annual close (VS-17); SEC filing calendar; statutory deadline">
        <bpmn:outgoing>W5018_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5018_Task5" name="Prepare the annual report &amp; investor disclosures: the audited financial…">
        <bpmn:documentation>Step 1: Prepare the annual report &amp; investor disclosures: the audited financial statements (links VS-17 external audit), MD&amp;A/group narrative, segment &amp; multi-entity/intercompany disclosure (links VS-72), ESG/sustainability sections (links VS-25), related-party &amp; governance sections (links VS-36/W5023), and the equity-story alignment (W5009)
Responsible (R): VP IR / Finance / Legal / ESG / Governance
Accountable (A): CFO / VP Legal &amp; Compliance
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W5018_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5018_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5018_Task6" name="File statutory SEC/commissioner disclosures: the General Information Sheet…">
        <bpmn:documentation>Step 2: File statutory SEC/commissioner disclosures: the General Information Sheet (GIS), annual report, and entity-level filings for each of the 5 entities (links VS-166 license/permit portfolio, VS-79 BIR), within statutory deadlines
Responsible (R): Legal / Compliance / VP IR / Company Secretary
Accountable (A): VP Legal &amp; Compliance
Duration: Annual + periodic</bpmn:documentation>
        <bpmn:incoming>W5018_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5018_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5018_Task7" name="Publish &amp; archive: publish to the IR website (W5014) and SEC/electronic system…">
        <bpmn:documentation>Step 3: Publish &amp; archive: publish to the IR website (W5014) and SEC/electronic system, archive per retention (VS-88), and reconcile every figure to the audited accounts (VS-17) and disclosure controls (W5017)
Responsible (R): VP IR / IT / Legal
Accountable (A): VP IR
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W5018_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5018_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5018_End8" name="Complete">
        <bpmn:incoming>W5018_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5018_Annotation9">
        <bpmn:text>Controls: - CTL-117 (ensure disclosure &amp; insider-trading compliance.) | - CTL-750: figures reconciled to audit (VS-17); disclosure-controlled (W5017); filed on time (VS-166); retained (VS-88)
Owner: VP Investor Relations / CFO / VP Legal &amp; Compliance (VS-100)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5018_Assoc10" sourceRef="W5018_Annotation9" targetRef="W5018_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5018_Flow11" sourceRef="W5018_Start4" targetRef="W5018_Task5" />
      <bpmn:sequenceFlow id="W5018_Flow12" sourceRef="W5018_Task5" targetRef="W5018_Task6" />
      <bpmn:sequenceFlow id="W5018_Flow13" sourceRef="W5018_Task6" targetRef="W5018_Task7" />
      <bpmn:sequenceFlow id="W5018_Flow14" sourceRef="W5018_Task7" targetRef="W5018_End8" />
    </bpmn:process>
