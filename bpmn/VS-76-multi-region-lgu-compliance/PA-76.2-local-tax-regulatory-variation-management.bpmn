    <bpmn:process id="W_W2683" name="W2683. Philippine Competition Law Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: New business practice or regulatory inquiry
Frequency: Continuous; periodic training
Volume: 5 legal entities
Owner: VP Legal
Participants: VP Legal, Compliance Team, Category Manager, Procurement
Source: workflow W2683 — Philippine Competition Law Compliance</bpmn:documentation>
      <bpmn:laneSet id="W2683_LaneSet3">
        <bpmn:lane id="W2683_Lane1" name="VP Legal">
        <bpmn:flowNodeRef>W2683_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2683_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2683_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2683_Lane2" name="Legal">
        <bpmn:flowNodeRef>W2683_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2683_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2683_Start4" name="New business practice or regulatory inquiry">
        <bpmn:outgoing>W2683_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2683_Task5" name="VP Legal ensures compliance with the Philippine Competition Act (RA 10667)…">
        <bpmn:documentation>Step 1: VP Legal ensures compliance with the Philippine Competition Act (RA 10667): reviews vendor agreements for anti-competitive clauses (resale-price-maintenance, exclusive-dealing), reviews BuildRight&#x27;s pricing practices, evaluates market concentration in categories where BuildRight may hold a dominant position
Responsible (R): VP Legal / Legal
Accountable (A): CEO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2683_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2683_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2683_Task6" name="Legal trains Category Managers and Procurement annually: no price-fixing…">
        <bpmn:documentation>Step 2: Legal trains Category Managers and Procurement annually: no price-fixing discussions with competitors, no market-allocation agreements, no abuse-of-dominant-position conduct, proper conduct at industry-association meetings (a high-risk venue for inadvertent coordination); refresher delivered via OLA
Responsible (R): Legal
Accountable (A): VP Legal
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2683_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2683_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2683_Task7" name="VP Legal monitors Philippine Competition Commission (PCC) enforcement actions…">
        <bpmn:documentation>Step 3: VP Legal monitors Philippine Competition Commission (PCC) enforcement actions and guidance; reviews BuildRight practices against current PCC guidance; maintains the compliance documentation (links to VS-129 competition &amp; antitrust compliance, the dedicated VS for this domain)
Responsible (R): VP Legal
Accountable (A): CEO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2683_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2683_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2683_End8" name="Complete">
        <bpmn:incoming>W2683_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2683_Annotation9">
        <bpmn:text>Controls: - CTL-159: rebate-agreement review — rebate terms can have anti-competitive effect; operational: CEO sign-off on any practice flagged as dominant-position-sensitive
Owner: VP Legal</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2683_Assoc10" sourceRef="W2683_Annotation9" targetRef="W2683_Start4" associationDirection="None" />
