<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-76.2-local-tax-regulatory-variation-management" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2678" name="W2678. Local Business Tax Computation &amp; Payment Across LGUs" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly payment cycle
Frequency: Quarterly (or per LGU schedule)
Volume: ~205 locations across ~150 LGUs (per W54)
Owner: Tax Accountant
Participants: Tax Accountant, Finance Analyst, Store Managers, LGU Treasury
Source: workflow W2678 — Local Business Tax Computation &amp; Payment Across LGUs</bpmn:documentation>
      <bpmn:laneSet id="W2678_LaneSet3">
        <bpmn:lane id="W2678_Lane1" name="Tax Accountant">
        <bpmn:flowNodeRef>W2678_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2678_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2678_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2678_Lane2" name="Finance">
        <bpmn:flowNodeRef>W2678_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2678_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2678_Start4" name="Quarterly payment cycle">
        <bpmn:outgoing>W2678_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2678_Task5" name="Tax Accountant compiles the local business tax (LBT) liability per location per…">
        <bpmn:documentation>Step 1: Tax Accountant compiles the local business tax (LBT) liability per location per RA 7160: gross receipts per store per LGU (from the W2676 reconciled figure), the applicable rate per the LGU tax ordinance (0.5–2% varying by business activity and LGU), tax-base adjustments (exempt sales, intercompany elimination), quarterly installment computation
Responsible (R): Tax Accountant
Accountable (A): Tax Manager
Duration: 3–5 days per quarter</bpmn:documentation>
        <bpmn:incoming>W2678_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2678_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2678_Task6" name="Accountant prepares the LGU-format return per LGU (each LGU&#x27;s return template…">
        <bpmn:documentation>Step 2: Accountant prepares the LGU-format return per LGU (each LGU&#x27;s return template differs); Store Manager submits to the LGU Treasury; pays via cashier or LGU-accredited bank; obtains the official receipt and uploads it
Responsible (R): Tax Accountant / Store Manager
Accountable (A): Tax Manager
Duration: 5–10 days per quarter</bpmn:documentation>
        <bpmn:incoming>W2678_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2678_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2678_Task7" name="Finance reconciles actual vs. budgeted LBT, variance by LGU; identifies rate…">
        <bpmn:documentation>Step 3: Finance reconciles actual vs. budgeted LBT, variance by LGU; identifies rate increases or newly-enacted fees (links to W2680); Tax Manager incorporates the variance into the quarterly forecast and the next W2676 accrual true-up
Responsible (R): Finance / Tax Manager
Accountable (A): CFO
Duration: Per quarter</bpmn:documentation>
        <bpmn:incoming>W2678_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2678_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2678_End8" name="Complete">
        <bpmn:incoming>W2678_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2678_Annotation9">
        <bpmn:text>Controls: - CTL-458 (tax-payment accuracy and timeliness — the 2%/month surcharge on late LBT is the penalty control); CTL-44 (duplicate-payment guard on the quarterly installments)
Owner: Tax Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2678_Assoc10" sourceRef="W2678_Annotation9" targetRef="W2678_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2678_Flow11" sourceRef="W2678_Start4" targetRef="W2678_Task5" />
      <bpmn:sequenceFlow id="W2678_Flow12" sourceRef="W2678_Task5" targetRef="W2678_Task6" />
      <bpmn:sequenceFlow id="W2678_Flow13" sourceRef="W2678_Task6" targetRef="W2678_Task7" />
      <bpmn:sequenceFlow id="W2678_Flow14" sourceRef="W2678_Task7" targetRef="W2678_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2678_diag">
      <bpmndi:BPMNPlane id="W2678_plane" bpmnElement="W_W2678">
        <bpmndi:BPMNShape id="W2678_Lane1_di" bpmnElement="W2678_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2678_Lane2_di" bpmnElement="W2678_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2678_Task5_di" bpmnElement="W2678_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2678_Task6_di" bpmnElement="W2678_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2678_Task7_di" bpmnElement="W2678_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2678_Start4_di" bpmnElement="W2678_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2678_End8_di" bpmnElement="W2678_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2678_Annotation9_di" bpmnElement="W2678_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2678_Flow11_di" bpmnElement="W2678_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2678_Flow12_di" bpmnElement="W2678_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2678_Flow13_di" bpmnElement="W2678_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2678_Flow14_di" bpmnElement="W2678_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2678_Assoc10_di" bpmnElement="W2678_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2679" name="W2679. Real Property Tax Assessment &amp; Payment" isExecutable="false">
      <bpmn:documentation>Trigger: Annual assessment cycle
Frequency: Annual assessment; quarterly payments
Volume: 209 properties
Owner: Tax Accountant
Participants: Tax Accountant, Property Manager, LGU Assessor
Source: workflow W2679 — Real Property Tax Assessment &amp; Payment</bpmn:documentation>
      <bpmn:laneSet id="W2679_LaneSet3">
        <bpmn:lane id="W2679_Lane1" name="Tax Accountant">
        <bpmn:flowNodeRef>W2679_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2679_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2679_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2679_Lane2" name="Property Manager">
        <bpmn:flowNodeRef>W2679_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2679_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2679_Start4" name="Annual assessment cycle">
        <bpmn:outgoing>W2679_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2679_Task5" name="Tax Accountant reviews the real property tax (RPT) assessment per location…">
        <bpmn:documentation>Step 1: Tax Accountant reviews the real property tax (RPT) assessment per location: assessed value, the LGU tax rate (1–3% depending on province/city/municipality and use class), the Special Education Fund add-on (additional 1% per RA 7160), exemptions (where the property qualifies); compares vs. prior year to catch unexpected re-assessments/increases
Responsible (R): Tax Accountant
Accountable (A): Tax Manager
Duration: 1–2 months after assessment</bpmn:documentation>
        <bpmn:incoming>W2679_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2679_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2679_Task6" name="For disputes (over-assessment): Property Manager files a protest with the Local…">
        <bpmn:documentation>Step 2: For disputes (over-assessment): Property Manager files a protest with the Local Board of Assessment Appeals within 60 days of receipt; provides evidence of overvaluation (recent market comparables, condition evidence); Tax Accountant pays the undisputed amount to avoid penalty while the protest is pending
Responsible (R): Property Manager / Tax Accountant / Legal
Accountable (A): VP Legal
Duration: Within 60 days</bpmn:documentation>
        <bpmn:incoming>W2679_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2679_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2679_Task7" name="Tax Accountant schedules the quarterly RPT payments and captures the…">
        <bpmn:documentation>Step 3: Tax Accountant schedules the quarterly RPT payments and captures the early-payment discount (LGUs offer 10–20% for advance annual payment per RA 7160); ensures timely payment to avoid the 2%/month surcharge and the 2-year lien-risk on delinquent property
Responsible (R): Tax Accountant
Accountable (A): Tax Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2679_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2679_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2679_End8" name="Complete">
        <bpmn:incoming>W2679_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2679_Annotation9">
        <bpmn:text>Controls: - CTL-458 (ensure controlled execution — Local Tax &amp; Regulatory Variation Management (PA-76.2).) | - CTL-458 (fixed-asset/property-record accuracy — links to VS-35 / W184 fixed-asset audit); operational: Tax Manager sign-off on any protest filed (legal-materiality control)
Owner: Tax Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2679_Assoc10" sourceRef="W2679_Annotation9" targetRef="W2679_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2679_Flow11" sourceRef="W2679_Start4" targetRef="W2679_Task5" />
      <bpmn:sequenceFlow id="W2679_Flow12" sourceRef="W2679_Task5" targetRef="W2679_Task6" />
      <bpmn:sequenceFlow id="W2679_Flow13" sourceRef="W2679_Task6" targetRef="W2679_Task7" />
      <bpmn:sequenceFlow id="W2679_Flow14" sourceRef="W2679_Task7" targetRef="W2679_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2679_diag">
      <bpmndi:BPMNPlane id="W2679_plane" bpmnElement="W_W2679">
        <bpmndi:BPMNShape id="W2679_Lane1_di" bpmnElement="W2679_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2679_Lane2_di" bpmnElement="W2679_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2679_Task5_di" bpmnElement="W2679_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2679_Task6_di" bpmnElement="W2679_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2679_Task7_di" bpmnElement="W2679_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2679_Start4_di" bpmnElement="W2679_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2679_End8_di" bpmnElement="W2679_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2679_Annotation9_di" bpmnElement="W2679_Annotation9"><dc:Bounds x="160" y="460" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2679_Flow11_di" bpmnElement="W2679_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2679_Flow12_di" bpmnElement="W2679_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2679_Flow13_di" bpmnElement="W2679_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2679_Flow14_di" bpmnElement="W2679_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2679_Assoc10_di" bpmnElement="W2679_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2680" name="W2680. LGU Regulatory Change Monitoring &amp; Impact Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: LGU ordinance or regulatory change
Frequency: Continuous monitoring; ~20–30 changes/year
Volume: ~150 LGUs (per W54)
Owner: Legal Compliance Officer
Participants: Legal Compliance Officer, Legal, Tax Manager, VP Legal
Source: workflow W2680 — LGU Regulatory Change Monitoring &amp; Impact Assessment</bpmn:documentation>
      <bpmn:laneSet id="W2680_LaneSet3">
        <bpmn:lane id="W2680_Lane1" name="Legal Compliance Officer">
        <bpmn:flowNodeRef>W2680_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2680_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2680_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2680_Lane2" name="All Affected">
        <bpmn:flowNodeRef>W2680_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2680_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2680_Start4" name="LGU ordinance or regulatory change">
        <bpmn:outgoing>W2680_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2680_Task5" name="Legal Compliance Officer monitors regulatory changes across the ~150 LGUs (per…">
        <bpmn:documentation>Step 1: Legal Compliance Officer monitors regulatory changes across the ~150 LGUs (per W54) where BuildRight operates: new ordinances (single-use-plastic bans, store-hour limits, signage rules), tax-rate changes (links to W2676/W2678), zoning amendments, environmental regulations; sources: LGU websites, Sangguniang session minutes, retail-association bulletins, VS-166 regulatory-intelligence feed
Responsible (R): Legal Compliance Officer
Accountable (A): VP Legal
Duration: Continuous (~6 hours/week)</bpmn:documentation>
        <bpmn:incoming>W2680_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2680_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2680_Task6" name="Officer assesses each change&#x27;s impact on BuildRight: new costs, required…">
        <bpmn:documentation>Step 2: Officer assesses each change&#x27;s impact on BuildRight: new costs, required operational changes, compliance deadlines, the affected stores; prepares an impact memo for VP Legal and the affected departments (Tax, HR, Facilities, Store Ops)
Responsible (R): Legal Compliance Officer / Legal
Accountable (A): VP Legal
Duration: Per change event (~4–8 hours)</bpmn:documentation>
        <bpmn:incoming>W2680_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2680_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2680_Task7" name="Affected departments implement the changes; Officer monitors compliance across…">
        <bpmn:documentation>Step 3: Affected departments implement the changes; Officer monitors compliance across stores; documents the change-and-response for inspection readiness (links to VS-22 / W95 external-audit coordination)
Responsible (R): All Affected / Legal Compliance Officer
Accountable (A): COO / VP Legal
Duration: Per change timeline</bpmn:documentation>
        <bpmn:incoming>W2680_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2680_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2680_End8" name="Complete">
        <bpmn:incoming>W2680_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2680_Annotation9">
        <bpmn:text>Controls: - CTL-235 (ensure multi-LGU license compliance.) | - Operational: VP Legal quarterly review of the change log + implementation status (audit trail for the Board Audit Committee)
Owner: Legal Compliance Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2680_Assoc10" sourceRef="W2680_Annotation9" targetRef="W2680_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2680_Flow11" sourceRef="W2680_Start4" targetRef="W2680_Task5" />
      <bpmn:sequenceFlow id="W2680_Flow12" sourceRef="W2680_Task5" targetRef="W2680_Task6" />
      <bpmn:sequenceFlow id="W2680_Flow13" sourceRef="W2680_Task6" targetRef="W2680_Task7" />
      <bpmn:sequenceFlow id="W2680_Flow14" sourceRef="W2680_Task7" targetRef="W2680_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2680_diag">
      <bpmndi:BPMNPlane id="W2680_plane" bpmnElement="W_W2680">
        <bpmndi:BPMNShape id="W2680_Lane1_di" bpmnElement="W2680_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2680_Lane2_di" bpmnElement="W2680_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2680_Task5_di" bpmnElement="W2680_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2680_Task6_di" bpmnElement="W2680_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2680_Task7_di" bpmnElement="W2680_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2680_Start4_di" bpmnElement="W2680_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2680_End8_di" bpmnElement="W2680_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2680_Annotation9_di" bpmnElement="W2680_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2680_Flow11_di" bpmnElement="W2680_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2680_Flow12_di" bpmnElement="W2680_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2680_Flow13_di" bpmnElement="W2680_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2680_Flow14_di" bpmnElement="W2680_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2680_Assoc10_di" bpmnElement="W2680_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2681" name="W2681. DOLE Regional Labor Standard Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: DOLE inspection or regional regulation change
Frequency: Ad-hoc inspections; annual review
Volume: ~205 locations across 6 regions
Owner: HR Compliance Manager
Participants: HR Compliance Mgr, Regional HR, Store Managers, DOLE
Source: workflow W2681 — DOLE Regional Labor Standard Compliance</bpmn:documentation>
      <bpmn:laneSet id="W2681_LaneSet4">
        <bpmn:lane id="W2681_Lane1" name="HR Compliance Mgr">
        <bpmn:flowNodeRef>W2681_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2681_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2681_Lane2" name="Regional HR">
        <bpmn:flowNodeRef>W2681_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2681_Lane3" name="HR Compliance Manager">
        <bpmn:flowNodeRef>W2681_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2681_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2681_Start5" name="DOLE inspection or regional regulation change">
        <bpmn:outgoing>W2681_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2681_Task6" name="HR Compliance Manager monitors the regional labor-standard variations: minimum…">
        <bpmn:documentation>Step 1: HR Compliance Manager monitors the regional labor-standard variations: minimum wage rates per Regional Tripartite Wages and Productivity Board (NCR ~PHP 610/day; BARMM ~PHP 361/day — large spread), 13th-month pay (prorated, per PD 851), holiday pay, overtime, night-shift differential, 5/6-day-workweek rules per DOLE advisory
Responsible (R): HR Compliance Mgr
Accountable (A): CHRO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2681_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2681_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2681_Task7" name="Regional HR ensures compliance per the applicable regional rate: DOLE-required…">
        <bpmn:documentation>Step 2: Regional HR ensures compliance per the applicable regional rate: DOLE-required workplace postings, written contracts, the correct wage per the regional rate, mandatory-benefits enrollment (SSS, PhilHealth, Pag-IBIG per the relevant laws)
Responsible (R): Regional HR / Store Manager
Accountable (A): CHRO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2681_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2681_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2681_Task8" name="HR Compliance Manager prepares the documentation package for DOLE inspections…">
        <bpmn:documentation>Step 3: HR Compliance Manager prepares the documentation package for DOLE inspections (under RA 11058 OSH law and DO 183-18 for general labor standards): employment records, payroll registers, benefits enrollment proof, working-hours/attendance logs, leave records, safety-committee minutes
Responsible (R): HR Compliance Manager
Accountable (A): CHRO
Duration: Ongoing + pre-inspection</bpmn:documentation>
        <bpmn:incoming>W2681_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2681_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2681_End9" name="Complete">
        <bpmn:incoming>W2681_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2681_Annotation10">
        <bpmn:text>Controls: - CTL-458 (ensure controlled execution — Local Tax &amp; Regulatory Variation Management (PA-76.2).) | - CTL-458 (payroll-statutory accuracy — links to VS-19 / W10, W337 payroll &amp; statutory compliance audit); operational: HR Compliance Manager pre-inspection self-audit sign-off
Owner: HR Compliance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2681_Assoc11" sourceRef="W2681_Annotation10" targetRef="W2681_Start5" associationDirection="None" />
