    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2684_diag">
      <bpmndi:BPMNPlane id="W2684_plane" bpmnElement="W_W2684">
        <bpmndi:BPMNShape id="W2684_Lane1_di" bpmnElement="W2684_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
