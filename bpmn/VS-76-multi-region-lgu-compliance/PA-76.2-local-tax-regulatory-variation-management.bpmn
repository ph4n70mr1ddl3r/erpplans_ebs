    <bpmn:process id="W_W2684" name="W2684. LGU Disaster &amp; Emergency Response Regulatory Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: LGU emergency preparedness requirement
Frequency: Annual; event-driven during typhoon season
Volume: ~205 locations
Owner: Safety Officer
Participants: Safety Officer, Legal Compliance Officer, Store Manager, LGU DRRMO
Source: workflow W2684 — LGU Disaster &amp; Emergency Response Regulatory Compliance</bpmn:documentation>
      <bpmn:laneSet id="W2684_LaneSet4">
        <bpmn:lane id="W2684_Lane1" name="Safety Officer">
        <bpmn:flowNodeRef>W2684_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2684_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2684_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W2684_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2684_Lane3" name="Legal Compliance Officer">
        <bpmn:flowNodeRef>W2684_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2684_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2684_Start5" name="LGU emergency preparedness requirement">
        <bpmn:outgoing>W2684_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2684_Task6" name="Safety Officer ensures each location meets the LGU disaster-preparedness…">
        <bpmn:documentation>Step 1: Safety Officer ensures each location meets the LGU disaster-preparedness requirements under RA 10121 (DRRM Act): an emergency action plan registered with the LGU Disaster Risk Reduction and Management Office (DRRMO), a designated evacuation area, Go Bag supplies, a trained disaster-response team per store
Responsible (R): Safety Officer
Accountable (A): COO
Duration: Annual review</bpmn:documentation>
        <bpmn:incoming>W2684_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2684_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2684_Task7" name="Store Manager participates in LGU-conducted disaster drills (earthquake, fire…">
        <bpmn:documentation>Step 2: Store Manager participates in LGU-conducted disaster drills (earthquake, fire, typhoon); coordinates with the DRRMO on evacuation procedures; aligns the store plan with the barangay disaster plan (links to W2673 community relations)
Responsible (R): Store Manager / Safety Officer
Accountable (A): Regional Manager
Duration: Per drill schedule</bpmn:documentation>
        <bpmn:incoming>W2684_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2684_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2684_Task8" name="Legal Compliance Officer tracks DRRM compliance per LGU: updated plans filed…">
        <bpmn:documentation>Step 3: Legal Compliance Officer tracks DRRM compliance per LGU: updated plans filed, drill-participation certificates, equipment-inspection records; identifies high-risk LGUs (typhoon-prone Visayas, flood-prone Metro Manila) for enhanced requirements
Responsible (R): Legal Compliance Officer / Safety Officer
Accountable (A): VP Legal
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2684_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2684_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2684_End9" name="Complete">
        <bpmn:incoming>W2684_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2684_Annotation10">
        <bpmn:text>Controls: - CTL-458 (ensure controlled execution — Local Tax &amp; Regulatory Variation Management (PA-76.2).) | - CTL-458 (emergency-preparedness — links to VS-26 / W158 BCP drill &amp; DR testing); operational: Safety Officer annual sign-off on each location&#x27;s plan-filing + drill completion
Owner: Safety Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2684_Assoc11" sourceRef="W2684_Annotation10" targetRef="W2684_Start5" associationDirection="None" />
