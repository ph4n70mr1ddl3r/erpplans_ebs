    <bpmn:process id="W_W2685" name="W2685. BIR CAS Registration Per Location" isExecutable="false">
      <bpmn:documentation>Trigger: New store opening or re-registration
Frequency: Per new location; updates per system change
Volume: ~205 locations across ~30 RDOs
Owner: Tax Manager
Participants: Tax Manager, IT, Legal Compliance Officer, BIR RDO
Source: workflow W2685 — BIR CAS Registration Per Location</bpmn:documentation>
      <bpmn:laneSet id="W2685_LaneSet3">
        <bpmn:lane id="W2685_Lane1" name="Tax Manager">
        <bpmn:flowNodeRef>W2685_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2685_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2685_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2685_Lane2" name="IT">
        <bpmn:flowNodeRef>W2685_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2685_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2685_Start4" name="New store opening or re-registration">
        <bpmn:outgoing>W2685_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2685_Task5" name="Tax Manager ensures the Computerized Accounting System (CAS) registration for…">
        <bpmn:documentation>Step 1: Tax Manager ensures the Computerized Accounting System (CAS) registration for each location: registers the ERP with the BIR Revenue District Office (RDO) having jurisdiction over the location; submits the system documentation per BIR Revenue Memorandum; obtains the BIR CAS Certificate (a precondition for issuing BIR-compliant invoices from that location)
Responsible (R): Tax Manager / IT
Accountable (A): CFO
Duration: Per new location</bpmn:documentation>
        <bpmn:incoming>W2685_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2685_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2685_Task6" name="IT provides the documentation: system flowchart, data-security description…">
        <bpmn:documentation>Step 2: IT provides the documentation: system flowchart, data-security description, 10-year record-retention capability (per TRAIN law NIRC Sec. 235), audit-trail features, sample invoices/receipts with all BIR-required information (TIN, serial number, &quot;VAT Registered&quot; marker, QR code per the e-invoicing requirement)
Responsible (R): IT / Tax Manager
Accountable (A): CIO
Duration: Per registration/update</bpmn:documentation>
        <bpmn:incoming>W2685_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2685_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2685_Task7" name="Tax Manager maintains the CAS records: RDO assignments per location, the CAS…">
        <bpmn:documentation>Step 3: Tax Manager maintains the CAS records: RDO assignments per location, the CAS certificate renewal/re-validation dates, system-change notifications to BIR (any ERP upgrade affecting invoicing must be reported to the relevant RDOs)
Responsible (R): Tax Manager
Accountable (A): CFO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2685_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2685_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2685_End8" name="Complete">
        <bpmn:incoming>W2685_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2685_Annotation9">
        <bpmn:text>Controls: - CTL-458 (ensure controlled execution — Local Tax &amp; Regulatory Variation Management (PA-76.2).) | - operational: the CAS certificate as a permit-validity control — no CAS, no active-invoicing status; operational: CFO sign-off on the per-location CAS registration before opening
Owner: Tax Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2685_Assoc10" sourceRef="W2685_Annotation9" targetRef="W2685_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2685_Flow11" sourceRef="W2685_Start4" targetRef="W2685_Task5" />
      <bpmn:sequenceFlow id="W2685_Flow12" sourceRef="W2685_Task5" targetRef="W2685_Task6" />
      <bpmn:sequenceFlow id="W2685_Flow13" sourceRef="W2685_Task6" targetRef="W2685_Task7" />
      <bpmn:sequenceFlow id="W2685_Flow14" sourceRef="W2685_Task7" targetRef="W2685_End8" />
    </bpmn:process>
