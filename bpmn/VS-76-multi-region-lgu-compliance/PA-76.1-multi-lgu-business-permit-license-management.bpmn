    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2671" name="W2671. New Store Business Permit Application" isExecutable="false">
      <bpmn:documentation>Trigger: New store construction approaching completion
Frequency: Per new store; 10–15/year
Volume: 10–15 new stores/year
Owner: Legal Compliance Officer
Participants: Legal Compliance Officer, Store Opening Team, Legal
Source: workflow W2671 — New Store Business Permit Application</bpmn:documentation>
      <bpmn:laneSet id="W2671_LaneSet2">
        <bpmn:lane id="W2671_Lane1" name="Legal Compliance Officer">
        <bpmn:flowNodeRef>W2671_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2671_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2671_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2671_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2671_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2671_Start3" name="New store construction approaching completion">
        <bpmn:outgoing>W2671_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2671_Task4" name="Officer researches the specific LGU&#x27;s new-business requirements (each LGU&#x27;s…">
        <bpmn:documentation>Step 1: Officer researches the specific LGU&#x27;s new-business requirements (each LGU&#x27;s BPLO checklist differs): application forms, SEC/DTI registration certificates, barangay clearance, BFP fire-safety, sanitary, environmental (DENR ECC where required), zoning, occupancy/certificate-of-completion, sign permits (W2674)
Responsible (R): Legal Compliance Officer
Accountable (A): VP Legal
Duration: 3–4 months before opening</bpmn:documentation>
        <bpmn:incoming>W2671_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2671_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2671_Task5" name="Officer coordinates the multi-agency parallel submissions: SEC/DTI…">
        <bpmn:documentation>Step 2: Officer coordinates the multi-agency parallel submissions: SEC/DTI (entity-level), LGU BPLO (mayor&#x27;s permit), BFP (FSIC), City/Municipal Engineering (occupancy), DENR (environmental compliance), barangay (clearance); manages parallel tracks so no single agency is on the critical path to opening
Responsible (R): Legal Compliance Officer / Legal
Accountable (A): VP Legal
Duration: 2–3 months before opening</bpmn:documentation>
        <bpmn:incoming>W2671_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2671_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2671_Task6" name="Officer obtains all permits before opening (a hard gate — the store cannot…">
        <bpmn:documentation>Step 3: Officer obtains all permits before opening (a hard gate — the store cannot legally trade without the mayor&#x27;s permit and FSIC); coordinates final inspections; uploads the full permit set to ERP; sets the renewal reminders (W2670 calendar) for each permit&#x27;s distinct expiry
Responsible (R): Legal Compliance Officer
Accountable (A): VP Legal
Duration: Before opening</bpmn:documentation>
        <bpmn:incoming>W2671_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2671_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2671_End7" name="Complete">
        <bpmn:incoming>W2671_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2671_Annotation8">
        <bpmn:text>Controls: - CTL-41: new location cannot trade without the permit set — system-enforced opening gate (locations blocked if permits lapse); operational: VP Legal sign-off that all permits are in hand before the VS-37 soft-opening milestone
Owner: Legal Compliance Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2671_Assoc9" sourceRef="W2671_Annotation8" targetRef="W2671_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2671_Flow10" sourceRef="W2671_Start3" targetRef="W2671_Task4" />
      <bpmn:sequenceFlow id="W2671_Flow11" sourceRef="W2671_Task4" targetRef="W2671_Task5" />
      <bpmn:sequenceFlow id="W2671_Flow12" sourceRef="W2671_Task5" targetRef="W2671_Task6" />
      <bpmn:sequenceFlow id="W2671_Flow13" sourceRef="W2671_Task6" targetRef="W2671_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2671_diag">
      <bpmndi:BPMNPlane id="W2671_plane" bpmnElement="W_W2671">
        <bpmndi:BPMNShape id="W2671_Lane1_di" bpmnElement="W2671_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2671_Task4_di" bpmnElement="W2671_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2671_Task5_di" bpmnElement="W2671_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2671_Task6_di" bpmnElement="W2671_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2671_Start3_di" bpmnElement="W2671_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2671_End7_di" bpmnElement="W2671_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2671_Annotation8_di" bpmnElement="W2671_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2671_Flow10_di" bpmnElement="W2671_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2671_Flow11_di" bpmnElement="W2671_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2671_Flow12_di" bpmnElement="W2671_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2671_Flow13_di" bpmnElement="W2671_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2671_Assoc9_di" bpmnElement="W2671_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2672" name="W2672. Fire Safety Inspection &amp; BFP Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: Annual fire safety inspection
Frequency: Annual per location; ~205 locations
Volume: ~205 locations
Owner: Safety Officer
Participants: Safety Officer, Store Manager, BFP, Facilities
Source: workflow W2672 — Fire Safety Inspection &amp; BFP Compliance</bpmn:documentation>
      <bpmn:laneSet id="W2672_LaneSet3">
        <bpmn:lane id="W2672_Lane1" name="Safety Officer">
        <bpmn:flowNodeRef>W2672_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2672_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2672_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2672_Lane2" name="BFP Inspector">
        <bpmn:flowNodeRef>W2672_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2672_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2672_Start4" name="Annual fire safety inspection">
        <bpmn:outgoing>W2672_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2672_Task5" name="Safety Officer prepares for the BFP inspection per RA 9514 (Fire Code)…">
        <bpmn:documentation>Step 1: Safety Officer prepares for the BFP inspection per RA 9514 (Fire Code): fire-extinguisher maintenance and tagging, fire-exit accessibility and clear egress, alarm functionality test, sprinkler/standpipe testing where fitted, emergency-lighting test, fire-drill documentation (links to VS-24 W582), signage (exit, fire-rated doors, occupancy load)
Responsible (R): Safety Officer
Accountable (A): COO
Duration: 1 month before</bpmn:documentation>
        <bpmn:incoming>W2672_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2672_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2672_Task6" name="BFP inspector conducts the inspection: reviews the fire-safety plan, inspects…">
        <bpmn:documentation>Step 2: BFP inspector conducts the inspection: reviews the fire-safety plan, inspects equipment, tests the alarm, verifies exits and signage; issues the Fire Safety Inspection Certificate (FSIC) if passed, or lists deficiencies (Notice of Violation) if failed
Responsible (R): BFP Inspector / Safety Officer
Accountable (A): COO
Duration: Per inspection</bpmn:documentation>
        <bpmn:incoming>W2672_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2672_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2672_Task7" name="Safety Officer addresses any deficiencies within the 30-day cure period…">
        <bpmn:documentation>Step 3: Safety Officer addresses any deficiencies within the 30-day cure period; requests re-inspection; obtains the FSIC; uploads to ERP; Store Manager displays the FSIC at the store entrance (regulatory visibility requirement); tracks the FSIC expiry for the W2670 renewal cycle
Responsible (R): Safety Officer / Store Manager
Accountable (A): COO
Duration: 30 days post-inspection</bpmn:documentation>
        <bpmn:incoming>W2672_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2672_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2672_End8" name="Complete">
        <bpmn:incoming>W2672_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2672_Annotation9">
        <bpmn:text>Controls: - CTL-219: fire-safety equipment tracked as maintained assets; operational: Safety Officer self-test sign-off before requesting the BFP inspection
Owner: Safety Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2672_Assoc10" sourceRef="W2672_Annotation9" targetRef="W2672_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2672_Flow11" sourceRef="W2672_Start4" targetRef="W2672_Task5" />
      <bpmn:sequenceFlow id="W2672_Flow12" sourceRef="W2672_Task5" targetRef="W2672_Task6" />
      <bpmn:sequenceFlow id="W2672_Flow13" sourceRef="W2672_Task6" targetRef="W2672_Task7" />
      <bpmn:sequenceFlow id="W2672_Flow14" sourceRef="W2672_Task7" targetRef="W2672_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2672_diag">
      <bpmndi:BPMNPlane id="W2672_plane" bpmnElement="W_W2672">
        <bpmndi:BPMNShape id="W2672_Lane1_di" bpmnElement="W2672_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2672_Lane2_di" bpmnElement="W2672_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2672_Task5_di" bpmnElement="W2672_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2672_Task6_di" bpmnElement="W2672_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2672_Task7_di" bpmnElement="W2672_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2672_Start4_di" bpmnElement="W2672_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2672_End8_di" bpmnElement="W2672_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2672_Annotation9_di" bpmnElement="W2672_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2672_Flow11_di" bpmnElement="W2672_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2672_Flow12_di" bpmnElement="W2672_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2672_Flow13_di" bpmnElement="W2672_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2672_Flow14_di" bpmnElement="W2672_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2672_Assoc10_di" bpmnElement="W2672_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2673" name="W2673. Barangay Clearance &amp; Community Relations Management" isExecutable="false">
      <bpmn:documentation>Trigger: Barangay clearance renewal
Frequency: Annual clearance; ongoing engagement
Volume: ~205 locations across ~150 barangays
Owner: Store Manager
Participants: Store Manager, Legal Compliance Officer
Source: workflow W2673 — Barangay Clearance &amp; Community Relations Management</bpmn:documentation>
      <bpmn:laneSet id="W2673_LaneSet3">
        <bpmn:lane id="W2673_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W2673_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2673_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2673_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2673_Lane2" name="Legal Compliance Officer">
        <bpmn:flowNodeRef>W2673_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2673_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2673_Start4" name="Barangay clearance renewal">
        <bpmn:outgoing>W2673_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2673_Task5" name="Store Manager maintains the barangay relationship year-round: attends council…">
        <bpmn:documentation>Step 1: Store Manager maintains the barangay relationship year-round: attends council meetings when invited, participates in barangay clean-up drives and community events, supports the barangay disaster-preparedness program (links to VS-69 typhoon response); the relationship is the lubricant that makes permit and clearance processing straightforward
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: Ongoing (~2–4 hours/month)</bpmn:documentation>
        <bpmn:incoming>W2673_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2673_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2673_Task6" name="Store Manager obtains the annual barangay clearance (a prerequisite for the LGU…">
        <bpmn:documentation>Step 2: Store Manager obtains the annual barangay clearance (a prerequisite for the LGU mayor&#x27;s permit per RA 7160): submits the application, pays the barangay clearance fee, obtains the barangay captain&#x27;s signature; typically straightforward but can be delayed by local politics or unresolved resident complaints
Responsible (R): Store Manager
Accountable (A): Legal Compliance Officer
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2673_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2673_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2673_Task7" name="Legal Compliance Officer tracks clearance status per store; identifies stores…">
        <bpmn:documentation>Step 3: Legal Compliance Officer tracks clearance status per store; identifies stores with relationship issues (repeated delays, complaints); coordinates with VP Legal for dispute resolution; maintains the barangay-official contact database per location
Responsible (R): Legal Compliance Officer
Accountable (A): VP Legal
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2673_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2673_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2673_End8" name="Complete">
        <bpmn:incoming>W2673_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2673_Annotation9">
        <bpmn:text>Controls: - CTL-457 (ensure controlled execution — Multi-LGU Business Permit &amp; License Management (PA-76.1).) | - CTL-457 (ABC / anti-bribery — links to VS-86.3 / W159): no facilitation payments; operational: Regional Manager visibility on any store with a clearance delay &gt;2 weeks
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
