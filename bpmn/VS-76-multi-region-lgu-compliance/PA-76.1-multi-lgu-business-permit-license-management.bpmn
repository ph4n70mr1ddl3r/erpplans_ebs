<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-76.1-multi-lgu-business-permit-license-management" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2670" name="W2670. Multi-Location Business Permit Renewal Calendar" isExecutable="false">
      <bpmn:documentation>Trigger: Annual renewal season (January)
Frequency: Annual; ~205 locations across ~150 LGUs (per W54)
Volume: ~205 locations
Owner: Legal Compliance Officer
Participants: Legal Compliance Officer, Store Managers, DC Ops, Legal
Source: workflow W2670 — Multi-Location Business Permit Renewal Calendar</bpmn:documentation>
      <bpmn:laneSet id="W2670_LaneSet3">
        <bpmn:lane id="W2670_Lane1" name="Legal Compliance Officer">
        <bpmn:flowNodeRef>W2670_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2670_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2670_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2670_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W2670_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2670_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2670_Start4" name="Annual renewal season (January)">
        <bpmn:outgoing>W2670_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2670_Task5" name="Legal Compliance Officer maintains the master permit calendar: renewal…">
        <bpmn:documentation>Step 1: Legal Compliance Officer maintains the master permit calendar: renewal deadlines per LGU (the RA 7160 standard is &quot;on or before Jan 20&quot; but several LGUs vary); tracks mayor&#x27;s/business permit, BFP FSIC (W2672), barangay clearance (W2673), DENR clearance where applicable, sanitary permit (W2675)
Responsible (R): Legal Compliance Officer
Accountable (A): VP Legal
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2670_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2670_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2670_Task6" name="Officer initiates renewal 60 days before each deadline: prepares the…">
        <bpmn:documentation>Step 2: Officer initiates renewal 60 days before each deadline: prepares the LGU-specific requirement pack (SEC certificates, prior-year gross receipts for the local business-tax computation, barangay clearance, fire cert, sanitary permit); coordinates with Store Managers on local-submission logistics
Responsible (R): Legal Compliance Officer / Store Managers
Accountable (A): VP Legal
Duration: 60 days before</bpmn:documentation>
        <bpmn:incoming>W2670_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2670_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2670_Task7" name="Store Manager submits to the LGU Business Permit and Licensing Office (BPLO)…">
        <bpmn:documentation>Step 3: Store Manager submits to the LGU Business Permit and Licensing Office (BPLO): pays the local business tax (0.5–2% of gross receipts per the LGU tax ordinance — varies by LGU per W2676), obtains the mayor&#x27;s permit; uploads the issued permit to ERP; Officer confirms all ~205 locations renewed before the Jan 20 deadline
Responsible (R): Store Manager / Legal Compliance Officer
Accountable (A): VP Legal
Duration: January each year</bpmn:documentation>
        <bpmn:incoming>W2670_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2670_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2670_End8" name="Complete">
        <bpmn:incoming>W2670_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2670_Annotation9">
        <bpmn:text>Controls: - CTL-41: applies to permit-document validity — expired permits block active trading status in the location master; operational: VP Legal sign-off on the all-locations-renewed confirmation each January
Owner: Legal Compliance Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2670_Assoc10" sourceRef="W2670_Annotation9" targetRef="W2670_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2670_Flow11" sourceRef="W2670_Start4" targetRef="W2670_Task5" />
      <bpmn:sequenceFlow id="W2670_Flow12" sourceRef="W2670_Task5" targetRef="W2670_Task6" />
      <bpmn:sequenceFlow id="W2670_Flow13" sourceRef="W2670_Task6" targetRef="W2670_Task7" />
      <bpmn:sequenceFlow id="W2670_Flow14" sourceRef="W2670_Task7" targetRef="W2670_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2670_diag">
      <bpmndi:BPMNPlane id="W2670_plane" bpmnElement="W_W2670">
        <bpmndi:BPMNShape id="W2670_Lane1_di" bpmnElement="W2670_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2670_Lane2_di" bpmnElement="W2670_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2670_Task5_di" bpmnElement="W2670_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2670_Task6_di" bpmnElement="W2670_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
