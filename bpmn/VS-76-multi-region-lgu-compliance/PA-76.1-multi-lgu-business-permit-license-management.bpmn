      <bpmn:sequenceFlow id="W2676_Flow13" sourceRef="W2676_Task6" targetRef="W2676_Task7" />
      <bpmn:sequenceFlow id="W2676_Flow14" sourceRef="W2676_Task7" targetRef="W2676_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2676_diag">
      <bpmndi:BPMNPlane id="W2676_plane" bpmnElement="W_W2676">
        <bpmndi:BPMNShape id="W2676_Lane1_di" bpmnElement="W2676_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2676_Lane2_di" bpmnElement="W2676_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2676_Task5_di" bpmnElement="W2676_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
