    <bpmn:process id="W_W2677" name="W2677. Multi-LGU Compliance Dashboard &amp; Alert Management" isExecutable="false">
      <bpmn:documentation>Trigger: Continuous monitoring; monthly review
Frequency: Continuous; monthly dashboard
Volume: ~205 locations
Owner: Legal Compliance Officer
Participants: Legal Compliance Officer, VP Legal, COO
Source: workflow W2677 — Multi-LGU Compliance Dashboard &amp; Alert Management</bpmn:documentation>
      <bpmn:laneSet id="W2677_LaneSet4">
        <bpmn:lane id="W2677_Lane1" name="Legal Compliance Officer">
        <bpmn:flowNodeRef>W2677_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2677_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2677_Lane2" name="System">
        <bpmn:flowNodeRef>W2677_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2677_Lane3" name="VP Legal">
        <bpmn:flowNodeRef>W2677_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2677_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2677_Start5" name="Continuous monitoring; monthly review">
        <bpmn:outgoing>W2677_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2677_Task6" name="Legal Compliance Officer maintains the compliance dashboard: permit status per…">
        <bpmn:documentation>Step 1: Legal Compliance Officer maintains the compliance dashboard: permit status per location (active / expiring / expired / pending) across all permit types (mayor&#x27;s, FSIC, barangay, sanitary, sign), deadlines (60/30/0-day countdowns), renewal cost, and an issue log for in-progress disputes or delays
Responsible (R): Legal Compliance Officer
Accountable (A): VP Legal
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W2677_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2677_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2677_Task7" name="System generates the automated alert ladder: 60 days out → initiate renewal…">
        <bpmn:documentation>Step 2: System generates the automated alert ladder: 60 days out → initiate renewal notification to the Store Manager; 30 days out → escalate to VP Legal; expired → critical alert for immediate action and trade-suspension risk flag
Responsible (R): System / Legal Compliance Officer
Accountable (A): VP Legal
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2677_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2677_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2677_Task8" name="VP Legal reviews the dashboard monthly: identifies patterns (a slow LGU, a…">
        <bpmn:documentation>Step 3: VP Legal reviews the dashboard monthly: identifies patterns (a slow LGU, a recurring deficiency type), allocates Officer resources to the at-risk renewals, escalates political issues to the CEO; reports the compliance posture quarterly to the Board Audit Committee (links to VS-21 / W120 audit)
Responsible (R): VP Legal
Accountable (A): CEO
Duration: Monthly + quarterly</bpmn:documentation>
        <bpmn:incoming>W2677_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2677_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2677_End9" name="Complete">
        <bpmn:incoming>W2677_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2677_Annotation10">
        <bpmn:text>Controls: - CTL-41: permit-validity is the register control the dashboard surfaces (LGU permit compliance); operational: VP Legal quarterly attestation of the compliance posture to the Board Audit Committee
Owner: Legal Compliance Officer</bpmn:text>
      </bpmn:textAnnotation>
