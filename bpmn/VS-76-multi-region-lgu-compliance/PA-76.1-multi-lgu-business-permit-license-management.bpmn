    <bpmn:process id="W_W2676" name="W2676. Store Location Tax &amp; Fee Variance Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: New store opening or annual assessment
Frequency: Per new store; annual review
Volume: ~205 locations across ~150 LGUs (per W54)
Owner: Finance Analyst
Participants: Finance Analyst, Tax Manager, Legal Compliance Officer
Source: workflow W2676 — Store Location Tax &amp; Fee Variance Tracking</bpmn:documentation>
      <bpmn:laneSet id="W2676_LaneSet3">
        <bpmn:lane id="W2676_Lane1" name="Finance Analyst">
        <bpmn:flowNodeRef>W2676_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2676_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2676_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2676_Lane2" name="Tax Manager">
        <bpmn:flowNodeRef>W2676_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2676_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2676_Start4" name="New store opening or annual assessment">
        <bpmn:outgoing>W2676_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2676_Task5" name="Finance Analyst maintains the LGU tax/fee database: local business tax rates…">
        <bpmn:documentation>Step 1: Finance Analyst maintains the LGU tax/fee database: local business tax rates (0.5–2% of gross receipts per the LGU tax ordinance under RA 7160), real property tax rates, permit fees (mayor&#x27;s, fire/sanitary/barangay), community tax rates; updates annually as LGUs amend ordinances
Responsible (R): Finance Analyst
Accountable (A): Tax Manager
Duration: Ongoing (~4 hours/month)</bpmn:documentation>
        <bpmn:incoming>W2676_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2676_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2676_Task6" name="Analyst calculates the location-specific cost: total LGU fees per store per…">
        <bpmn:documentation>Step 2: Analyst calculates the location-specific cost: total LGU fees per store per year, comparison across LGUs, impact on store P&amp;L; identifies high-cost LGUs as a site-selection avoidance input (links to VS-20 / W116 site selection)
Responsible (R): Finance Analyst
Accountable (A): Finance Controller
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2676_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2676_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2676_Task7" name="Tax Manager incorporates the local-tax figures into store-level budgeting…">
        <bpmn:documentation>Step 3: Tax Manager incorporates the local-tax figures into store-level budgeting: adjusts P&amp;L projections for local business tax, real property tax, permit costs; ensures the accurate accrual per location so no year-end LGU-tax surprise
Responsible (R): Tax Manager / Finance Controller
Accountable (A): CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2676_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2676_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2676_End8" name="Complete">
        <bpmn:incoming>W2676_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2676_Annotation9">
        <bpmn:text>Controls: - CTL-457 (ensure controlled execution — Multi-LGU Business Permit &amp; License Management (PA-76.1).) | - operational: local-tax accrual reviewed by Tax Manager quarterly (per VS-79 / W90 indirect-tax); operational: Finance Controller sign-off on the annual store-P&amp;L local-tax line
Owner: Finance Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2676_Assoc10" sourceRef="W2676_Annotation9" targetRef="W2676_Start4" associationDirection="None" />
