    <bpmn:process id="W_W2675" name="W2675. Sanitary &amp; Health Permit Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: Annual sanitary permit renewal
Frequency: Annual per location
Volume: 200 stores
Owner: Store Manager
Participants: Store Manager, Maintenance Staff, LGU Health Office
Source: workflow W2675 — Sanitary &amp; Health Permit Compliance</bpmn:documentation>
      <bpmn:laneSet id="W2675_LaneSet3">
        <bpmn:lane id="W2675_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W2675_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2675_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2675_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2675_Lane2" name="LGU Health Inspector">
        <bpmn:flowNodeRef>W2675_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2675_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2675_Start4" name="Annual sanitary permit renewal">
        <bpmn:outgoing>W2675_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2675_Task5" name="Store Manager ensures ongoing sanitary conditions per PD 856 (Sanitary Code)…">
        <bpmn:documentation>Step 1: Store Manager ensures ongoing sanitary conditions per PD 856 (Sanitary Code): clean restrooms, potable water supply, pest-control program with documented service, waste management (links to VS-73 / W2598), food-handling hygiene where a concessionaire operates
Responsible (R): Store Manager / Maintenance Staff
Accountable (A): Regional Manager
Duration: Ongoing (daily ops)</bpmn:documentation>
        <bpmn:incoming>W2675_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2675_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2675_Task6" name="LGU Health Office conducts the annual inspection: verifies facilities, reviews…">
        <bpmn:documentation>Step 2: LGU Health Office conducts the annual inspection: verifies facilities, reviews the pest-control service records, inspects waste practices and restroom condition; issues the sanitary permit if compliant, or cites deficiencies
Responsible (R): LGU Health Inspector / Store Manager
Accountable (A): Regional Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2675_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2675_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2675_Task7" name="Store Manager uploads the sanitary permit to ERP; Legal Compliance Officer…">
        <bpmn:documentation>Step 3: Store Manager uploads the sanitary permit to ERP; Legal Compliance Officer tracks expiry across 200 stores; ensures renewal before expiry (a lapsed sanitary permit is a trade-suspension risk)
Responsible (R): Store Manager / Legal Compliance Officer
Accountable (A): COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2675_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2675_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2675_End8" name="Complete">
        <bpmn:incoming>W2675_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2675_Annotation9">
        <bpmn:text>Controls: - CTL-06 (permit validity); operational: Store Manager daily restroom/waste-condition check (part of VS-07 daily ops)
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2675_Assoc10" sourceRef="W2675_Annotation9" targetRef="W2675_Start4" associationDirection="None" />
