        <bpmndi:BPMNEdge id="W2670_Flow14_di" bpmnElement="W2670_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2670_Assoc10_di" bpmnElement="W2670_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
