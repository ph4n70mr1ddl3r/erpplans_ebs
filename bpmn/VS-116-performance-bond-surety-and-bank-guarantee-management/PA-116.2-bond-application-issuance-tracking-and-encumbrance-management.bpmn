    <bpmn:process id="W_W3654" name="W3654. Bond/Guarantee Tracking, Encumbrance &amp; Register Management" isExecutable="false">
      <bpmn:documentation>Trigger: Bond issuance (W3649–W3652); monthly cycle; reporting
Frequency: Continuous + monthly
Volume: Outstanding bond/guarantee portfolio
Owner: Surety Program Manager
Participants: Surety Program Manager, Treasury (links to VS-18), Finance (links to VS-17), Legal (links to VS-100.3), PMO (links to VS-112), BI (links to VS-28.1)
Source: workflow W3654 — Bond/Guarantee Tracking, Encumbrance &amp; Register Management</bpmn:documentation>
      <bpmn:laneSet id="W3654_LaneSet2">
        <bpmn:lane id="W3654_Lane1" name="Surety Program Manager">
        <bpmn:flowNodeRef>W3654_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3654_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3654_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3654_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3654_End7</bpmn:flowNodeRef>
        </bpmn:lane>
