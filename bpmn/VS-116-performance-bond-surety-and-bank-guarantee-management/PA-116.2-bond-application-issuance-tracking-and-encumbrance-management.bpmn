      <bpmn:sequenceFlow id="W3651_Flow11" sourceRef="W3651_Task4" targetRef="W3651_Task5" />
      <bpmn:sequenceFlow id="W3651_Flow12" sourceRef="W3651_Task5" targetRef="W3651_Task6" />
      <bpmn:sequenceFlow id="W3651_Flow13" sourceRef="W3651_Task6" targetRef="W3651_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3651_diag">
      <bpmndi:BPMNPlane id="W3651_plane" bpmnElement="W_W3651">
        <bpmndi:BPMNShape id="W3651_Lane1_di" bpmnElement="W3651_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3651_Task4_di" bpmnElement="W3651_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3651_Task5_di" bpmnElement="W3651_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3651_Task6_di" bpmnElement="W3651_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3651_Start3_di" bpmnElement="W3651_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3651_End7_di" bpmnElement="W3651_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3651_Annotation8_di" bpmnElement="W3651_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3651_Flow10_di" bpmnElement="W3651_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3651_Flow11_di" bpmnElement="W3651_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3651_Flow12_di" bpmnElement="W3651_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3651_Flow13_di" bpmnElement="W3651_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3651_Assoc9_di" bpmnElement="W3651_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3652" name="W3652. Bank Guarantee Issuance &amp; LC-for-Guarantee Management" isExecutable="false">
      <bpmn:documentation>Trigger: Bank-guarantee or LC requirement (customer/regulatory); instrument-mix decision (W3641)
Frequency: Per instrument
Volume: Bank guarantees and standby LCs
Owner: Treasury / Surety Program Manager
Participants: Treasury (links to VS-18), Surety Program Manager, Finance (links to VS-17), Legal (links to VS-100.3), Bank, B2G/B2B Sales (links to VS-46/VS-11)
Source: workflow W3652 — Bank Guarantee Issuance &amp; LC-for-Guarantee Management</bpmn:documentation>
      <bpmn:laneSet id="W3652_LaneSet2">
        <bpmn:lane id="W3652_Lane1" name="Treasury">
        <bpmn:flowNodeRef>W3652_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3652_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3652_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3652_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3652_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3652_Start3" name="Bank-guarantee or LC requirement (customer/regulatory); instrument-mix decision (W3641)">
        <bpmn:outgoing>W3652_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3652_Task4" name="Treasury/Surety Program Manager arrange the bank guarantee or standby LC…">
        <bpmn:documentation>Step 1: Treasury/Surety Program Manager arrange the bank guarantee or standby LC: confirm the instrument-mix decision (bank guarantee where the beneficiary requires it or surety is unavailable), the facility/line encumbrance (W3642/W3646), the margin/collateral (W3644), and the beneficiary/validity/terms
Responsible (R): Treasury / Surety Program Manager
Accountable (A): CFO
Duration: Per instrument</bpmn:documentation>
        <bpmn:incoming>W3652_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3652_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3652_Task5" name="Treasury/Bank issue the bank guarantee / standby LC: application, the facility…">
        <bpmn:documentation>Step 2: Treasury/Bank issue the bank guarantee / standby LC: application, the facility utilization (encumbering the credit line links to VS-18.2), fee/margin (W3645), the SWIFT/instrument issuance, and the beneficiary delivery; manage the BSP/banking compliance (links to VS-80)
Responsible (R): Treasury / Bank
Accountable (A): CFO
Duration: Per instrument (days)</bpmn:documentation>
        <bpmn:incoming>W3652_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3652_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3652_Task6" name="Treasury/Surety Program Manager record the bank guarantee in the encumbrance…">
        <bpmn:documentation>Step 3: Treasury/Surety Program Manager record the bank guarantee in the encumbrance register (W3654) with the credit-line encumbrance, manage through the contract term (amendments W3656, release W3657), and report credit-line encumbrance to treasury/cash planning (links to VS-18.1) and governance (W3661)
Responsible (R): Treasury / Surety Program Manager
Accountable (A): CFO
Duration: Per instrument + ongoing</bpmn:documentation>
        <bpmn:incoming>W3652_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3652_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3652_End7" name="Complete">
        <bpmn:incoming>W3652_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3652_Annotation8">
        <bpmn:text>Controls: - CTL-578 (ensure controlled execution — Bond/Guarantee Application, Issuance, Tracking &amp; Encumbrance Management (PA-116.2).) | - operational: instrument-mix (surety bond frees credit) and capacity planning (W3646); operational: collateral optimization (W3645)
Owner: Treasury / Surety Program Manager</bpmn:text>
      </bpmn:textAnnotation>
