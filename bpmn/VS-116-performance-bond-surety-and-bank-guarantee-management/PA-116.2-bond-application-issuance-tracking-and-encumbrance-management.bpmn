        <bpmndi:BPMNShape id="W3650_Task6_di" bpmnElement="W3650_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3650_Start3_di" bpmnElement="W3650_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3650_End7_di" bpmnElement="W3650_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3650_Annotation8_di" bpmnElement="W3650_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3650_Flow10_di" bpmnElement="W3650_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3650_Flow11_di" bpmnElement="W3650_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3650_Flow12_di" bpmnElement="W3650_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3650_Flow13_di" bpmnElement="W3650_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3650_Assoc9_di" bpmnElement="W3650_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3651" name="W3651. Warranty &amp; Retention Bond Management" isExecutable="false">
      <bpmn:documentation>Trigger: Contract completion / warranty period (links to VS-46/VS-11/VS-53)
Frequency: Per contract entering warranty
Volume: Warranty/retention bonds for completed contracts
Owner: Surety Program Manager / Finance
Participants: Surety Program Manager, B2G/B2B Sales (links to VS-46/VS-11), Legal (links to VS-100.3), PMO (links to VS-112), Warranty Mgmt (links to VS-53), Surety/Bank, Finance (links to VS-17)
Source: workflow W3651 — Warranty &amp; Retention Bond Management</bpmn:documentation>
      <bpmn:laneSet id="W3651_LaneSet2">
        <bpmn:lane id="W3651_Lane1" name="Surety Program Manager">
        <bpmn:flowNodeRef>W3651_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3651_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3651_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3651_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3651_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3651_Start3" name="Contract completion / warranty period (links to VS-46/VS-11/VS-53)">
        <bpmn:outgoing>W3651_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3651_Task4" name="Surety Program Manager/Legal identify the warranty/retention requirement at…">
        <bpmn:documentation>Step 1: Surety Program Manager/Legal identify the warranty/retention requirement at contract completion: the warranty period (e.g., 1–5 years for construction/B2G), the warranty bond/maintenance-money requirement (often 10% retention), and whether retention can be substituted by a bond (freeing cash W3653); verify against the contract
Responsible (R): Surety Program Manager / Legal / Sales
Accountable (A): CFO
Duration: Per completion</bpmn:documentation>
        <bpmn:incoming>W3651_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3651_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3651_Task5" name="Surety Program Manager/Treasury arrange the warranty/retention bond: apply to…">
        <bpmn:documentation>Step 2: Surety Program Manager/Treasury arrange the warranty/retention bond: apply to surety/bank, provide the completion/warranty detail, pay premium/fee (W3645), secure counter-indemnity (W3644), and obtain the instrument; substitute cash retention with bond where economic (W3653/W3645)
Responsible (R): Surety Program Manager / Treasury / Surety/Bank
Accountable (A): CFO
Duration: Per completion</bpmn:documentation>
        <bpmn:incoming>W3651_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3651_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3651_Task6" name="Surety Program Manager manage the warranty bond through the warranty period…">
        <bpmn:documentation>Step 3: Surety Program Manager manage the warranty bond through the warranty period (link to VS-53 warranty), reduce/release on warranty milestones (W3657), manage warranty claims (links to VS-53/W3658), and capture records (W3648); report to governance (W3661)
Responsible (R): Surety Program Manager / Warranty Mgmt
Accountable (A): CFO
Duration: Warranty period</bpmn:documentation>
        <bpmn:incoming>W3651_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3651_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3651_End7" name="Complete">
        <bpmn:incoming>W3651_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3651_Annotation8">
        <bpmn:text>Controls: - CTL-578 (ensure controlled execution — Bond/Guarantee Application, Issuance, Tracking &amp; Encumbrance Management (PA-116.2).) | - operational: bond-substitution analysis; operational: warranty delivery (links to VS-53)
Owner: Surety Program Manager / Finance</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3651_Assoc9" sourceRef="W3651_Annotation8" targetRef="W3651_Start3" associationDirection="None" />
