      <bpmn:sequenceFlow id="W3656_Flow12" sourceRef="W3656_Task5" targetRef="W3656_Task6" />
      <bpmn:sequenceFlow id="W3656_Flow13" sourceRef="W3656_Task6" targetRef="W3656_End7" />
    </bpmn:process>
