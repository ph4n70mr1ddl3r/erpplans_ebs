<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-116.2-bond-application-issuance-tracking-and-encumbrance-management" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3649" name="W3649. Bid Bond Application &amp; Issuance" isExecutable="false">
      <bpmn:documentation>Trigger: B2G bid/tender decision (links to VS-46/W1759/W1899); B2B tender requiring bid security
Frequency: Per bid (~5–10 concurrent bids)
Volume: Bid bonds per tender cycle
Owner: Surety Program Manager / B2G Sales
Participants: Surety Program Manager, B2G/B2B Sales (links to VS-46/VS-11), Treasury (links to VS-18), Legal (links to VS-100.3), Surety/Bank, Finance (links to VS-17)
Source: workflow W3649 — Bid Bond Application &amp; Issuance</bpmn:documentation>
      <bpmn:laneSet id="W3649_LaneSet3">
        <bpmn:lane id="W3649_Lane1" name="B2G">
        <bpmn:flowNodeRef>W3649_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3649_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3649_Lane2" name="Surety Program Manager">
        <bpmn:flowNodeRef>W3649_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3649_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3649_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3649_Start4" name="B2G bid/tender decision (links to VS-46/W1759/W1899); B2B tender requiring bid security">
        <bpmn:outgoing>W3649_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3649_Task5" name="B2G/B2B Sales/Surety Program Manager initiate the bid-bond request upon…">
        <bpmn:documentation>Step 1: B2G/B2B Sales/Surety Program Manager initiate the bid-bond request upon Go/No-Go decision (links to VS-46): tender/bid value, required bid security % (typically 1–2% per RA 9184, or per tender), acceptable instrument (surety bond/bank guarantee/cash), beneficiary (government agency/customer), validity period, and the bid deadline; verify authority (W3647) and capacity (W3646)
Responsible (R): B2G/B2B Sales / Surety Program Manager
Accountable (A): CFO
Duration: Per bid</bpmn:documentation>
        <bpmn:incoming>W3649_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3649_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3649_Task6" name="Surety Program Manager/Treasury arrange the bid bond: apply to the surety…">
        <bpmn:documentation>Step 2: Surety Program Manager/Treasury arrange the bid bond: apply to the surety company or bank (W3642/W3643), provide the bid/tender detail and corporate authorization, pay the premium/fee (W3645), secure the counter-indemnity/collateral (W3644), and obtain the issued instrument in the required format/beneficiary/validity
Responsible (R): Surety Program Manager / Treasury / Surety/Bank
Accountable (A): CFO
Duration: Per bid (days)</bpmn:documentation>
        <bpmn:incoming>W3649_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3649_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3649_Task7" name="Surety Program Manager record the bid bond in the encumbrance register (W3654)…">
        <bpmn:documentation>Step 3: Surety Program Manager record the bid bond in the encumbrance register (W3654), deliver to Sales for bid submission, manage the bid outcome (release W3657 if not won, convert to performance bond W3650 if won), and capture the record (W3648); report bid-bond activity to governance (W3661)
Responsible (R): Surety Program Manager / Sales
Accountable (A): CFO
Duration: Per bid</bpmn:documentation>
        <bpmn:incoming>W3649_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3649_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3649_End8" name="Complete">
        <bpmn:incoming>W3649_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3649_Annotation9">
        <bpmn:text>Controls: - CTL-578 (ensure controlled execution — Bond/Guarantee Application, Issuance, Tracking &amp; Encumbrance Management (PA-116.2).) | - operational: lead-time and pre-arranged facility; operational: format review
Owner: Surety Program Manager / B2G Sales</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3649_Assoc10" sourceRef="W3649_Annotation9" targetRef="W3649_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3649_Flow11" sourceRef="W3649_Start4" targetRef="W3649_Task5" />
      <bpmn:sequenceFlow id="W3649_Flow12" sourceRef="W3649_Task5" targetRef="W3649_Task6" />
      <bpmn:sequenceFlow id="W3649_Flow13" sourceRef="W3649_Task6" targetRef="W3649_Task7" />
      <bpmn:sequenceFlow id="W3649_Flow14" sourceRef="W3649_Task7" targetRef="W3649_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3649_diag">
      <bpmndi:BPMNPlane id="W3649_plane" bpmnElement="W_W3649">
        <bpmndi:BPMNShape id="W3649_Lane1_di" bpmnElement="W3649_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3649_Lane2_di" bpmnElement="W3649_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3649_Task5_di" bpmnElement="W3649_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3649_Task6_di" bpmnElement="W3649_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3649_Task7_di" bpmnElement="W3649_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3649_Start4_di" bpmnElement="W3649_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3649_End8_di" bpmnElement="W3649_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3649_Annotation9_di" bpmnElement="W3649_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3649_Flow11_di" bpmnElement="W3649_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3649_Flow12_di" bpmnElement="W3649_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3649_Flow13_di" bpmnElement="W3649_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3649_Flow14_di" bpmnElement="W3649_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3649_Assoc10_di" bpmnElement="W3649_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3650" name="W3650. Performance &amp; Payment Bond Application &amp; Issuance" isExecutable="false">
      <bpmn:documentation>Trigger: Contract award (links to VS-46/VS-11); performance-security requirement
Frequency: Per awarded contract
Volume: Performance/payment bonds for awarded B2G/B2B contracts
Owner: Surety Program Manager / Finance
Participants: Surety Program Manager, B2G/B2B Sales (links to VS-46/VS-11), Treasury (links to VS-18), Legal (links to VS-100.3), PMO/Project Delivery (links to VS-112), Surety/Bank, Finance (links to VS-17)
Source: workflow W3650 — Performance &amp; Payment Bond Application &amp; Issuance</bpmn:documentation>
      <bpmn:laneSet id="W3650_LaneSet2">
        <bpmn:lane id="W3650_Lane1" name="Surety Program Manager">
        <bpmn:flowNodeRef>W3650_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3650_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3650_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3650_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3650_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3650_Start3" name="Contract award (links to VS-46/VS-11); performance-security requirement">
        <bpmn:outgoing>W3650_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3650_Task4" name="Surety Program Manager/Sales initiate the performance/payment bond on contract…">
        <bpmn:documentation>Step 1: Surety Program Manager/Sales initiate the performance/payment bond on contract award: contract value, required performance security % (typically 5% goods / 10% infrastructure in cash or bank guarantee per the RA 9184 IRR (higher percentages apply to surety-bond forms)), the contract term and milestones, beneficiary, validity (often 10% beyond contract completion), and the contract-risk assessment (links to VS-21.2); verify authority (W3647) and capacity (W3646)
Responsible (R): Surety Program Manager / Sales / Legal
Accountable (A): CFO
Duration: Per award</bpmn:documentation>
        <bpmn:incoming>W3650_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3650_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3650_Task5" name="Surety Program Manager/Treasury/Legal arrange the performance and payment…">
        <bpmn:documentation>Step 2: Surety Program Manager/Treasury/Legal arrange the performance and payment bonds: apply to surety/bank, provide the contract detail and corporate authorization, complete the contract-risk underwriting with the surety, pay premium/fee (W3645), secure counter-indemnity/collateral (W3644), and obtain the issued instruments; link to the contract/PO
Responsible (R): Surety Program Manager / Treasury / Legal / Surety/Bank
Accountable (A): CFO
Duration: Per award (days–weeks)</bpmn:documentation>
        <bpmn:incoming>W3650_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3650_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3650_Task6" name="Surety Program Manager record the bonds in the encumbrance register (W3654)…">
        <bpmn:documentation>Step 3: Surety Program Manager record the bonds in the encumbrance register (W3654), link to the contract and PMO delivery (links to VS-112), manage the bond through delivery (amendments W3656, milestone-linked reductions), and plan the release at completion (W3657); report to governance (W3661)
Responsible (R): Surety Program Manager / PMO
Accountable (A): CFO
Duration: Per contract</bpmn:documentation>
        <bpmn:incoming>W3650_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3650_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3650_End7" name="Complete">
        <bpmn:incoming>W3650_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3650_Annotation8">
        <bpmn:text>Controls: - CTL-578 (ensure controlled execution — Bond/Guarantee Application, Issuance, Tracking &amp; Encumbrance Management (PA-116.2).) | - operational: requirement verification; operational: accurate requirement
Owner: Surety Program Manager / Finance</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3650_Assoc9" sourceRef="W3650_Annotation8" targetRef="W3650_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3650_Flow10" sourceRef="W3650_Start3" targetRef="W3650_Task4" />
      <bpmn:sequenceFlow id="W3650_Flow11" sourceRef="W3650_Task4" targetRef="W3650_Task5" />
      <bpmn:sequenceFlow id="W3650_Flow12" sourceRef="W3650_Task5" targetRef="W3650_Task6" />
      <bpmn:sequenceFlow id="W3650_Flow13" sourceRef="W3650_Task6" targetRef="W3650_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3650_diag">
      <bpmndi:BPMNPlane id="W3650_plane" bpmnElement="W_W3650">
        <bpmndi:BPMNShape id="W3650_Lane1_di" bpmnElement="W3650_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3650_Task4_di" bpmnElement="W3650_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
