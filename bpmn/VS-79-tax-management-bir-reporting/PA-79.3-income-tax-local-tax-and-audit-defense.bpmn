      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2770" name="W2770. Tax-Adjusted Financial Income (TAFI) Schedule &amp; Permanent/Temporary Differences" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly and annual tax return preparation
Frequency: Quarterly
Volume: 5 entities; ~150 adjustment items/year
Owner: Tax Manager
Participants: Tax Manager, Tax Accountant, GL
Source: workflow W2770 — Tax-Adjusted Financial Income (TAFI) Schedule &amp; Permanent/Temporary Differences</bpmn:documentation>
      <bpmn:laneSet id="W2770_LaneSet3">
        <bpmn:lane id="W2770_Lane1" name="Tax Accountant">
        <bpmn:flowNodeRef>W2770_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2770_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2770_Lane2" name="Tax Manager">
        <bpmn:flowNodeRef>W2770_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2770_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2770_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2770_Start4" name="Quarterly and annual tax return preparation">
        <bpmn:outgoing>W2770_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2770_Task5" name="Tax Accountant maintains TAFI schedule: adds back non-deductible items…">
        <bpmn:documentation>Step 1: Tax Accountant maintains TAFI schedule: adds back non-deductible items (penalties, excessive interest, undocumented expenses), subtracts tax-exempt income (13th month up to PHP 90K, de minimis benefits)
Responsible (R): Tax Accountant
Accountable (A): Tax Manager
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W2770_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2770_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2770_Task6" name="Tax Manager tracks temporary differences (depreciation, bad debt provision…">
        <bpmn:documentation>Step 2: Tax Manager tracks temporary differences (depreciation, bad debt provision, leave pay accrual) for deferred tax computation; documents each position
Responsible (R): Tax Manager
Accountable (A): CFO
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W2770_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2770_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2770_Task7" name="Tax Manager validates documentation support (receipts, BIR-compliant invoices)…">
        <bpmn:documentation>Step 3: Tax Manager validates documentation support (receipts, BIR-compliant invoices) for deductibility; identifies and cures unsupported items before filing
Responsible (R): Tax Manager / GL
Accountable (A): CFO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W2770_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2770_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2770_End8" name="Complete">
        <bpmn:incoming>W2770_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2770_Annotation9">
        <bpmn:text>Controls: - CTL-468 (ensure controlled execution — Corporate Income Tax, Local Tax, DST &amp; BIR Audit Defense (PA-79.3).) | - operational: pre-filing documentation scrub
Owner: Tax Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2770_Assoc10" sourceRef="W2770_Annotation9" targetRef="W2770_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2770_Flow11" sourceRef="W2770_Start4" targetRef="W2770_Task5" />
      <bpmn:sequenceFlow id="W2770_Flow12" sourceRef="W2770_Task5" targetRef="W2770_Task6" />
      <bpmn:sequenceFlow id="W2770_Flow13" sourceRef="W2770_Task6" targetRef="W2770_Task7" />
      <bpmn:sequenceFlow id="W2770_Flow14" sourceRef="W2770_Task7" targetRef="W2770_End8" />
    </bpmn:process>
