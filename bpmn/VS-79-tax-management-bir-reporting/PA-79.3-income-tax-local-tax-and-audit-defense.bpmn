    <bpmn:process id="W_W2772" name="W2772. Documentary Stamp Tax (DST) on Leases, Loans &amp; Documents" isExecutable="false">
      <bpmn:documentation>Trigger: Lease execution, loan drawdown, share issuance, promissory note
Frequency: Event-driven; ~50–100 DST events/year
Volume: ~200 leases + debt facility activity
Owner: Tax Manager
Participants: Tax Manager, Treasury, Legal, AP
Source: workflow W2772 — Documentary Stamp Tax (DST) on Leases, Loans &amp; Documents</bpmn:documentation>
      <bpmn:laneSet id="W2772_LaneSet4">
        <bpmn:lane id="W2772_Lane1" name="Legal">
        <bpmn:flowNodeRef>W2772_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2772_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2772_Lane2" name="Tax Manager">
        <bpmn:flowNodeRef>W2772_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2772_Lane3" name="Tax Accountant">
        <bpmn:flowNodeRef>W2772_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2772_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2772_Start5" name="Lease execution, loan drawdown, share issuance, promissory note">
        <bpmn:outgoing>W2772_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2772_Task6" name="Legal/Treasury identifies DST-applicable document at execution (lease PHP 5/yr…">
        <bpmn:documentation>Step 1: Legal/Treasury identifies DST-applicable document at execution (lease PHP 5/yr per PHP 2K rent, loan/debt instrument PHP 1.50 per PHP 200 (TRAIN/RR 4-2018), share issuance); captures tax base
Responsible (R): Legal / Treasury
Accountable (A): Tax Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W2772_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2772_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2772_Task7" name="Tax Manager computes DST due; books liability; remits via 2000-OT filing within…">
        <bpmn:documentation>Step 2: Tax Manager computes DST due; books liability; remits via 2000-OT filing within 5 days after the close of the month of document execution
Responsible (R): Tax Manager / AP
Accountable (A): CFO
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W2772_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2772_Flow14</bpmn:outgoing>
      </bpmn:userTask>
