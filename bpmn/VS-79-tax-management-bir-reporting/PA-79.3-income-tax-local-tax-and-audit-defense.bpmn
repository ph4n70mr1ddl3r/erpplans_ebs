      <bpmndi:BPMNPlane id="W2769_plane" bpmnElement="W_W2769">
        <bpmndi:BPMNShape id="W2769_Lane1_di" bpmnElement="W2769_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2769_Lane2_di" bpmnElement="W2769_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
