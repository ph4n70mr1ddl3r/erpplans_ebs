<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-79.3-income-tax-local-tax-and-audit-defense" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2769" name="W2769. Quarterly Corporate Income Tax (1702Q) &amp; Annual Return (1702RT) Preparation" isExecutable="false">
      <bpmn:documentation>Trigger: Quarter-end / year-end close
Frequency: Quarterly + annual per entity
Volume: 5 entities; ~PHP 62.3B consolidated revenue
Owner: Tax Manager
Participants: Tax Manager, GL, Tax Accountant, External Auditor, Tax Compliance &amp; eFPS Specialist
Source: workflow W2769 — Quarterly Corporate Income Tax (1702Q) &amp; Annual Return (1702RT) Preparation</bpmn:documentation>
      <bpmn:laneSet id="W2769_LaneSet3">
        <bpmn:lane id="W2769_Lane1" name="GL">
        <bpmn:flowNodeRef>W2769_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2769_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2769_Lane2" name="Tax Manager">
        <bpmn:flowNodeRef>W2769_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2769_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2769_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2769_Start4" name="Quarter-end / year-end close">
        <bpmn:outgoing>W2769_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2769_Task5" name="GL closes books per entity; Tax Accountant derives taxable income from…">
        <bpmn:documentation>Step 1: GL closes books per entity; Tax Accountant derives taxable income from financial income using TAFI schedule; nets prior-quarter over/under payments
Responsible (R): GL / Tax Accountant
Accountable (A): Tax Manager
Duration: 5–7 days/entity</bpmn:documentation>
        <bpmn:incoming>W2769_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2769_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2769_Task6" name="Tax Manager applies corporate income tax rate (25% regular; 20% under CREATE…">
        <bpmn:documentation>Step 2: Tax Manager applies corporate income tax rate (25% regular; 20% under CREATE for net taxable income ≤ PHP 5M and total assets ≤ PHP 100M); computes quarterly tax due
Responsible (R): Tax Manager
Accountable (A): CFO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2769_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2769_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2769_Task7" name="Tax Manager files 1702Q (quarterly) and 1702RT (annual) via eFPS with AFS…">
        <bpmn:documentation>Step 3: Tax Manager files 1702Q (quarterly) and 1702RT (annual) via eFPS with AFS attachments; coordinates external auditor sign-off on annual
Responsible (R): Tax Manager / External Auditor
Accountable (A): CFO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2769_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2769_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2769_End8" name="Complete">
        <bpmn:incoming>W2769_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2769_Annotation9">
        <bpmn:text>Controls: - CTL-468 (ensure controlled execution — Corporate Income Tax, Local Tax, DST &amp; BIR Audit Defense (PA-79.3).) | - operational: entity-level eligibility testing each quarter
Owner: Tax Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2769_Assoc10" sourceRef="W2769_Annotation9" targetRef="W2769_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2769_Flow11" sourceRef="W2769_Start4" targetRef="W2769_Task5" />
      <bpmn:sequenceFlow id="W2769_Flow12" sourceRef="W2769_Task5" targetRef="W2769_Task6" />
      <bpmn:sequenceFlow id="W2769_Flow13" sourceRef="W2769_Task6" targetRef="W2769_Task7" />
      <bpmn:sequenceFlow id="W2769_Flow14" sourceRef="W2769_Task7" targetRef="W2769_End8" />
    </bpmn:process>
