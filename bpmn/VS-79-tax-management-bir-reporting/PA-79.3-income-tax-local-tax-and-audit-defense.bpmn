        <bpmn:flowNodeRef>W2776_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2776_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2776_Start4" name="Quarterly governance review; new BIR issuance">
        <bpmn:outgoing>W2776_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2776_Task5" name="Tax Manager maintains enterprise tax calendar (entity × tax type × deadline) in…">
        <bpmn:documentation>Step 1: Tax Manager maintains enterprise tax calendar (entity × tax type × deadline) in ERP workflow; assigns preparer/reviewer; auto-escalates overdue items
Responsible (R): Tax Manager
Accountable (A): CFO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W2776_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2776_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2776_Task6" name="Tax Manager maintains tax risk register (uncertain tax positions, transfer…">
        <bpmn:documentation>Step 2: Tax Manager maintains tax risk register (uncertain tax positions, transfer pricing exposure, pending assessments); rates likelihood/impact; reports to Audit Committee
Responsible (R): Tax Manager
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2776_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2776_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2776_Task7" name="Internal Audit performs annual tax control review (segregation of duties…">
        <bpmn:documentation>Step 3: Internal Audit performs annual tax control review (segregation of duties, filing completeness, documentation); External Advisor validates methodology
Responsible (R): Internal Audit / External Advisor
Accountable (A): Audit Committee
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2776_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2776_Flow14</bpmn:outgoing>
      </bpmn:userTask>
