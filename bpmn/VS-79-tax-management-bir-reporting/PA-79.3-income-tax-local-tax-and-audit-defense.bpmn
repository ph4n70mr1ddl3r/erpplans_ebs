        <bpmndi:BPMNEdge id="W2770_Flow12_di" bpmnElement="W2770_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2770_Flow13_di" bpmnElement="W2770_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2770_Flow14_di" bpmnElement="W2770_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2770_Assoc10_di" bpmnElement="W2770_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2771" name="W2771. Local Business Tax (LBT) Computation &amp; LGU Filing per Location" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly LBT installment; annual LGU renewal
Frequency: Quarterly + annual per LGU
Volume: ~80 LGUs (multiple stores per city/municipality); 205 locations
Owner: Tax Manager
Participants: Tax Manager, Regulatory Officer, Treasury
Source: workflow W2771 — Local Business Tax (LBT) Computation &amp; LGU Filing per Location</bpmn:documentation>
      <bpmn:laneSet id="W2771_LaneSet4">
        <bpmn:lane id="W2771_Lane1" name="Regulatory Officer">
        <bpmn:flowNodeRef>W2771_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2771_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2771_Lane2" name="Tax Manager">
        <bpmn:flowNodeRef>W2771_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2771_Lane3" name="Treasury">
        <bpmn:flowNodeRef>W2771_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2771_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2771_Start5" name="Quarterly LBT installment; annual LGU renewal">
        <bpmn:outgoing>W2771_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2771_Task6" name="Regulatory Officer maintains LGU business permit register per store/DC; tracks…">
        <bpmn:documentation>Step 1: Regulatory Officer maintains LGU business permit register per store/DC; tracks LBT method (gross receipts vs. gross sales) per LGU code
Responsible (R): Regulatory Officer
Accountable (A): Tax Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W2771_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2771_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2771_Task7" name="Tax Manager computes quarterly LBT per location based on prior-year gross…">
        <bpmn:documentation>Step 2: Tax Manager computes quarterly LBT per location based on prior-year gross receipts/sales apportionment; prepares LGU form; coordinates with Regional Managers for submission
Responsible (R): Tax Manager
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2771_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2771_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2771_Task8" name="Treasury remits LBT to LGU Treasurer; Regulatory Officer obtains official…">
        <bpmn:documentation>Step 3: Treasury remits LBT to LGU Treasurer; Regulatory Officer obtains official receipt and attaches to permit file; tracks renewal calendar
Responsible (R): Treasury / Regulatory Officer
Accountable (A): Tax Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2771_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2771_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2771_End9" name="Complete">
        <bpmn:incoming>W2771_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2771_Annotation10">
        <bpmn:text>Controls: - CTL-468 (ensure controlled execution — Corporate Income Tax, Local Tax, DST &amp; BIR Audit Defense (PA-79.3).) | - operational: LGU-specific rule library
Owner: Tax Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2771_Assoc11" sourceRef="W2771_Annotation10" targetRef="W2771_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2771_Flow12" sourceRef="W2771_Start5" targetRef="W2771_Task6" />
      <bpmn:sequenceFlow id="W2771_Flow13" sourceRef="W2771_Task6" targetRef="W2771_Task7" />
