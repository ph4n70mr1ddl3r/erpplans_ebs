    <bpmn:process id="W_W2776" name="W2776. Tax Risk Register, Tax Calendar &amp; Tax Controversy Governance" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly governance review; new BIR issuance
Frequency: Quarterly + continuous
Volume: ~80 filing obligations/year; ~20 tax risks tracked
Owner: Tax Manager
Participants: Tax Manager, CFO, Internal Audit, External Advisor
Source: workflow W2776 — Tax Risk Register, Tax Calendar &amp; Tax Controversy Governance</bpmn:documentation>
      <bpmn:laneSet id="W2776_LaneSet3">
