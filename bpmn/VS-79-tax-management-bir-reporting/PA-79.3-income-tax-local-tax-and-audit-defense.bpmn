        <bpmn:flowNodeRef>W5546_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5546_Lane2" name="Tax Manager">
        <bpmn:flowNodeRef>W5546_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5546_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5546_Lane3" name="IT">
        <bpmn:flowNodeRef>W5546_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5546_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5546_Start5" name="eFPS, eBIRForms, or the BIR ePayment gateway (or an SSS/PhilHealth/Pag-IBIG/LGU portal on…">
        <bpmn:outgoing>W5546_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5546_Task6" name="Outage confirmation &amp; clock">
        <bpmn:documentation>Step 1: Outage confirmation &amp; clock: confirm the outage is portal-side (BIS advisory, acquirer-of-record status page, peer confirmation) vs local connectivity; open the event log with timestamped screenshots of each filing attempt — this evidence pack is the later abatement basis; list every return/payment with a deadline inside the outage window across all 5 entities
Responsible (R): Entity Tax Specialist
Accountable (A): Tax Manager
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W5546_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5546_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5546_Task7" name="Filing-path decision tree per return">
        <bpmn:documentation>Step 2: Filing-path decision tree per return: (a) retry eFPS through the deadline day (including off-peak windows); (b) prepare the return in eBIRForms offline and file manually at the RDO; (c) where manual filing is unavailable, file at any Authorized Agent Bank (AAB) together with payment — the AAB-received return+payment is the statutory fallback; decision rule: never let the day end with neither an electronic attempt nor a manual/AAB filing
Responsible (R): Entity Tax Specialist
Accountable (A): Tax Manager
Duration: Same day</bpmn:documentation>
        <bpmn:incoming>W5546_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5546_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5546_Task8" name="Payment protection">
        <bpmn:documentation>Step 3: Payment protection: where only payment is at risk, pay via AAB (or GCash/bank-channel instruments the BIR accepts) even if the return itself must follow — failure-to-pay carries the harsher exposure; Treasury confirms fund positioning per the payment calendar; keep deposit slips/validation as primary evidence
Responsible (R): Entity Tax Specialist / Treasury
Accountable (A): Finance Controller
Duration: Same day</bpmn:documentation>
        <bpmn:incoming>W5546_Flow18</bpmn:incoming>
        <bpmn:outgoing>W5546_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5546_Task9" name="Penalty-relief documentation">
        <bpmn:documentation>Step 4: Penalty-relief documentation: assemble the abatement/relief request per the governing BIR issuance for system-downtime relief — the timestamped attempt log, BIR advisories, screenshots, manual/AAB proofs; calendar the follow-up; where penalties are assessed despite relief, elevate per the W2773 controversy framework
Responsible (R): Tax Manager / Tax Counsel
Accountable (A): CFO
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W5546_Flow19</bpmn:incoming>
        <bpmn:outgoing>W5546_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5546_Task10" name="CAS/e-invoicing outage branch">
        <bpmn:documentation>Step 5: CAS/e-invoicing outage branch: if the accredited CAS cannot transmit sales-invoice data — notify BIR per accreditation rules, operate the approved manual/invoice-book fallback, log the outage window, and batch-transmit the backlog on recovery with BIR acknowledgment retained (links to W473-class e-invoicing operations)
Responsible (R): IT / Entity Tax Specialist
Accountable (A): Tax Manager
Duration: Outage window</bpmn:documentation>
        <bpmn:incoming>W5546_Flow20</bpmn:incoming>
        <bpmn:outgoing>W5546_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5546_Task11" name="Recovery reconciliation">
        <bpmn:documentation>Step 6: Recovery reconciliation: once portals recover — verify each return shows as filed and each payment as applied in BIR records; chase &quot;successful submission without acknowledgment&quot; cases; reconcile postings against books per the W590 close linkage; confirm no duplicate filing from the retry sequence
Responsible (R): Entity Tax Specialist
Accountable (A): Tax Manager
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W5546_Flow21</bpmn:incoming>
        <bpmn:outgoing>W5546_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5546_Task12" name="Deadline-hygiene update">
        <bpmn:documentation>Step 7: Deadline-hygiene update: post-event, enforce the early-filing buffer policy (≥ 3 days before deadline per the PA-79.1 mitigation) with the W2776 calendar engine flagging returns filed inside the buffer; recurrence pattern (same portal, same deadline) feeds the calendar&#x27;s pre-deadline alerts
Responsible (R): Tax Manager
Accountable (A): Tax Manager
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5546_Flow22</bpmn:incoming>
        <bpmn:outgoing>W5546_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5546_End13" name="Complete">
        <bpmn:incoming>W5546_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5546_Annotation14">
        <bpmn:text>Controls: - CTL-468 (ensure controlled execution — Corporate Income Tax, Local Tax, DST &amp; BIR Audit Defense (PA-79.3).); CTL-34 (ensure complete tax compliance.) | - operational: no deadline day closes with neither an electronic attempt nor a manual/AAB filing evidenced in the event log | - operational: every assessed penalty following an outage event carries an abatement decision (filed or consciously waived) before write-off approval
Owner: Tax Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5546_Assoc15" sourceRef="W5546_Annotation14" targetRef="W5546_Start5" associationDirection="None" />
