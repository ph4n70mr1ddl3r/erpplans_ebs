      <bpmn:sequenceFlow id="W5546_Flow18" sourceRef="W5546_Task7" targetRef="W5546_Task8" />
      <bpmn:sequenceFlow id="W5546_Flow19" sourceRef="W5546_Task8" targetRef="W5546_Task9" />
      <bpmn:sequenceFlow id="W5546_Flow20" sourceRef="W5546_Task9" targetRef="W5546_Task10" />
      <bpmn:sequenceFlow id="W5546_Flow21" sourceRef="W5546_Task10" targetRef="W5546_Task11" />
      <bpmn:sequenceFlow id="W5546_Flow22" sourceRef="W5546_Task11" targetRef="W5546_Task12" />
      <bpmn:sequenceFlow id="W5546_Flow23" sourceRef="W5546_Task12" targetRef="W5546_End13" />
    </bpmn:process>
