      <bpmndi:BPMNPlane id="W2771_plane" bpmnElement="W_W2771">
        <bpmndi:BPMNShape id="W2771_Lane1_di" bpmnElement="W2771_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2771_Lane2_di" bpmnElement="W2771_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2771_Lane3_di" bpmnElement="W2771_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
