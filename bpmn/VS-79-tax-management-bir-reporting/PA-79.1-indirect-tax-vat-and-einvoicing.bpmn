    <bpmn:process id="W_W2755" name="W2755. BIR eFPS Filing, e-Payment (PESONet/InstaPay) &amp; Validation" isExecutable="false">
      <bpmn:documentation>Trigger: Statutory deadline (per BIR filing calendar)
Frequency: Monthly/quarterly/annual — ~80+ filings/year across all taxes
Volume: 5 entities × ~16 filings/year ≈ 80 filings
Owner: Tax Accountant
Participants: Tax Accountant, Tax Manager, Treasury
Source: workflow W2755 — BIR eFPS Filing, e-Payment (PESONet/InstaPay) &amp; Validation</bpmn:documentation>
      <bpmn:laneSet id="W2755_LaneSet3">
        <bpmn:lane id="W2755_Lane1" name="Tax Accountant">
        <bpmn:flowNodeRef>W2755_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2755_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2755_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2755_Lane2" name="Treasury">
        <bpmn:flowNodeRef>W2755_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2755_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2755_Start4" name="Statutory deadline (per BIR filing calendar)">
        <bpmn:outgoing>W2755_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2755_Task5" name="Tax Accountant logs into BIR eFPS, selects return type and tax period…">
        <bpmn:documentation>Step 1: Tax Accountant logs into BIR eFPS, selects return type and tax period, uploads/generated data; validates auto-computed fields vs. ERP workpapers before submission
Responsible (R): Tax Accountant
Accountable (A): Tax Manager
Duration: 30–60 min/filing</bpmn:documentation>
        <bpmn:incoming>W2755_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2755_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2755_Task6" name="Treasury initiates e-Payment via Authorized Agent Bank (AAB) PESONet/InstaPay…">
        <bpmn:documentation>Step 2: Treasury initiates e-Payment via Authorized Agent Bank (AAB) PESONet/InstaPay or revenue collection officer; captures payment confirmation/reference number
Responsible (R): Treasury
Accountable (A): CFO
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W2755_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2755_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2755_Task7" name="Tax Accountant attaches proof of filing and payment to ERP tax document…">
        <bpmn:documentation>Step 3: Tax Accountant attaches proof of filing and payment to ERP tax document repository; updates tax calendar tracker; flags any rejection for re-filing before deadline
Responsible (R): Tax Accountant
Accountable (A): Tax Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W2755_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2755_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2755_End8" name="Complete">
        <bpmn:incoming>W2755_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2755_Annotation9">
        <bpmn:text>Controls: - CTL-214 (ensure BIR tax compliance &amp; filing integrity.) | - operational: filing 3+ days early and maintaining offline computation backups
Owner: Tax Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2755_Assoc10" sourceRef="W2755_Annotation9" targetRef="W2755_Start4" associationDirection="None" />
