    <bpmn:process id="W_W2753" name="W2753. VAT Output/Input Ledger Reconciliation &amp; Monthly Form 2550M Preparation" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly VAT close-and-file cycle (2550M statutory deadline: 20th of following month, or the 25th for later eFPS groups)
Frequency: Monthly per entity (5 entities)
Volume: 5 returns/month; ~PHP 5.19B monthly revenue at 12% output VAT
Owner: Tax Manager
Participants: Tax Manager, GL Accountant, AP/AR, Tax Accountant, Tax Compliance &amp; eFPS Specialist
Source: workflow W2753 — VAT Output/Input Ledger Reconciliation &amp; Monthly Form 2550M Preparation</bpmn:documentation>
      <bpmn:laneSet id="W2753_LaneSet4">
        <bpmn:lane id="W2753_Lane1" name="GL Accountant">
        <bpmn:flowNodeRef>W2753_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2753_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2753_Lane2" name="Tax Manager">
        <bpmn:flowNodeRef>W2753_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2753_Lane3" name="Tax Accountant">
        <bpmn:flowNodeRef>W2753_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2753_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2753_Start5" name="Monthly VAT close-and-file cycle (2550M statutory deadline: 20th of following month, or…">
        <bpmn:outgoing>W2753_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2753_Task6" name="GL Accountant reconciles VAT output (sales) vs. input (purchases) ledgers from…">
        <bpmn:documentation>Step 1: GL Accountant reconciles VAT output (sales) vs. input (purchases) ledgers from ERP tax registers per entity; validates VAT treatment on every taxable line; flags mixed-tender and exempt sales
Responsible (R): GL Accountant / Tax Accountant
Accountable (A): Tax Manager
Duration: 2–3 days/entity</bpmn:documentation>
        <bpmn:incoming>W2753_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2753_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2753_Task7" name="Tax Manager computes net VAT payable/refundable; reconciles to GL VAT control…">
        <bpmn:documentation>Step 2: Tax Manager computes net VAT payable/refundable; reconciles to GL VAT control accounts; investigates variances &gt; PHP 50K; books adjusting journal entries
Responsible (R): Tax Manager
Accountable (A): CFO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2753_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2753_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2753_Task8" name="Tax Accountant prepares BIR Form 2550M with supporting schedules; routes for…">
        <bpmn:documentation>Step 3: Tax Accountant prepares BIR Form 2550M with supporting schedules; routes for CFO sign-off; archives computation workpapers for 10-year BIR retention
Responsible (R): Tax Accountant
Accountable (A): Tax Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2753_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2753_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2753_End9" name="Complete">
        <bpmn:incoming>W2753_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2753_Annotation10">
        <bpmn:text>Controls: - CTL-214 (ensure BIR tax compliance &amp; filing integrity.) | - operational: automated tax determination rules and monthly reconciliation
Owner: Tax Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2753_Assoc11" sourceRef="W2753_Annotation10" targetRef="W2753_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2753_Flow12" sourceRef="W2753_Start5" targetRef="W2753_Task6" />
      <bpmn:sequenceFlow id="W2753_Flow13" sourceRef="W2753_Task6" targetRef="W2753_Task7" />
      <bpmn:sequenceFlow id="W2753_Flow14" sourceRef="W2753_Task7" targetRef="W2753_Task8" />
      <bpmn:sequenceFlow id="W2753_Flow15" sourceRef="W2753_Task8" targetRef="W2753_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2753_diag">
      <bpmndi:BPMNPlane id="W2753_plane" bpmnElement="W_W2753">
        <bpmndi:BPMNShape id="W2753_Lane1_di" bpmnElement="W2753_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
