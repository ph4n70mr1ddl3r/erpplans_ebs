    <bpmn:process id="W_W2754" name="W2754. Quarterly VAT Return (2550Q) &amp; Transitional Input Tax Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly close (25 days after quarter-end)
Frequency: Quarterly per entity
Volume: 5 returns/quarter
Owner: Tax Manager
Participants: Tax Manager, Tax Accountant, External Tax Advisor
Source: workflow W2754 — Quarterly VAT Return (2550Q) &amp; Transitional Input Tax Processing</bpmn:documentation>
      <bpmn:laneSet id="W2754_LaneSet3">
        <bpmn:lane id="W2754_Lane1" name="Tax Accountant">
        <bpmn:flowNodeRef>W2754_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2754_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2754_Lane2" name="Tax Manager">
        <bpmn:flowNodeRef>W2754_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2754_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2754_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2754_Start4" name="Quarterly close (25 days after quarter-end)">
        <bpmn:outgoing>W2754_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2754_Task5" name="Tax Accountant consolidates three monthly 2550M filings into quarterly summary…">
        <bpmn:documentation>Step 1: Tax Accountant consolidates three monthly 2550M filings into quarterly summary; reconciles cumulative output/input VAT; validates against GL quarterly trial balance
Responsible (R): Tax Accountant
Accountable (A): Tax Manager
Duration: 2 days/entity</bpmn:documentation>
        <bpmn:incoming>W2754_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2754_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2754_Task6" name="Tax Manager processes transitional input VAT on capital asset acquisitions…">
        <bpmn:documentation>Step 2: Tax Manager processes transitional input VAT on capital asset acquisitions (fully creditable in the acquisition month since 1 Jan 2022 per the TRAIN phase-out; residual 60-month schedules only for grandfathered pre-2022 assets per RMC 21-2022); coordinates with external advisor on contentious items
Responsible (R): Tax Manager / External Tax Advisor
Accountable (A): CFO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2754_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2754_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2754_Task7" name="Tax Manager files 2550Q via eFPS; settles any quarterly true-up; documents…">
        <bpmn:documentation>Step 3: Tax Manager files 2550Q via eFPS; settles any quarterly true-up; documents positions taken for future audit defensibility
Responsible (R): Tax Manager
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2754_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2754_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2754_End8" name="Complete">
        <bpmn:incoming>W2754_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2754_Annotation9">
        <bpmn:text>Controls: - CTL-466 (ensure controlled execution — Indirect Tax (VAT &amp; Percentage Tax) &amp; BIR E-Invoicing (PA-79.1).) | - operational: advisor review and rule-versioning
Owner: Tax Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2754_Assoc10" sourceRef="W2754_Annotation9" targetRef="W2754_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2754_Flow11" sourceRef="W2754_Start4" targetRef="W2754_Task5" />
      <bpmn:sequenceFlow id="W2754_Flow12" sourceRef="W2754_Task5" targetRef="W2754_Task6" />
      <bpmn:sequenceFlow id="W2754_Flow13" sourceRef="W2754_Task6" targetRef="W2754_Task7" />
      <bpmn:sequenceFlow id="W2754_Flow14" sourceRef="W2754_Task7" targetRef="W2754_End8" />
    </bpmn:process>
