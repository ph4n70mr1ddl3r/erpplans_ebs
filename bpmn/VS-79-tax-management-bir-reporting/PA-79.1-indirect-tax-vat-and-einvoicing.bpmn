    <bpmn:process id="W_W2760" name="W2760. POS BIR-Registered Accreditation, CAS Registration &amp; Compliance Audit" isExecutable="false">
      <bpmn:documentation>Trigger: New POS rollout, system upgrade, or annual BIR audit
Frequency: Event-driven + annual review
Volume: 205 locations; 600 POS terminals
Owner: Tax Manager
Participants: Tax Manager, IT, Store Ops, Legal
Source: workflow W2760 — POS BIR-Registered Accreditation, CAS Registration &amp; Compliance Audit</bpmn:documentation>
      <bpmn:laneSet id="W2760_LaneSet4">
        <bpmn:lane id="W2760_Lane1" name="Tax Manager">
        <bpmn:flowNodeRef>W2760_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2760_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2760_Lane2" name="IT">
        <bpmn:flowNodeRef>W2760_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2760_Lane3" name="Legal">
        <bpmn:flowNodeRef>W2760_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2760_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2760_Start5" name="New POS rollout, system upgrade, or annual BIR audit">
        <bpmn:outgoing>W2760_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2760_Task6" name="Tax Manager maintains BIR Computerized Accounting System (CAS)/POS permit…">
        <bpmn:documentation>Step 1: Tax Manager maintains BIR Computerized Accounting System (CAS)/POS permit inventory per location; processes new/refresh permits (BIR Form 1907) for every terminal swap or software upgrade
Responsible (R): Tax Manager / IT
Accountable (A): CFO
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W2760_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2760_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2760_Task7" name="IT ensures POS firmware/software matches BIR-accredited configuration (PTU)…">
        <bpmn:documentation>Step 2: IT ensures POS firmware/software matches BIR-accredited configuration (PTU); logs any deviation through change-control re-accreditation
Responsible (R): IT
Accountable (A): Tax Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W2760_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2760_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2760_Task8" name="Legal/Tax Manager supports BIR annual LOI inspection of CAS; demonstrates…">
        <bpmn:documentation>Step 3: Legal/Tax Manager supports BIR annual LOI inspection of CAS; demonstrates invoice numbering, TIN, sequential integrity, and tamper-evident logs across sample locations
Responsible (R): Legal / Tax Manager
Accountable (A): CFO
Duration: 1–2 weeks/audit</bpmn:documentation>
        <bpmn:incoming>W2760_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2760_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2760_End9" name="Complete">
        <bpmn:incoming>W2760_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2760_Annotation10">
        <bpmn:text>Controls: - CTL-214 (ensure BIR tax compliance &amp; filing integrity.) | - operational: permit-master gating of go-lives
Owner: Tax Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2760_Assoc11" sourceRef="W2760_Annotation10" targetRef="W2760_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2760_Flow12" sourceRef="W2760_Start5" targetRef="W2760_Task6" />
      <bpmn:sequenceFlow id="W2760_Flow13" sourceRef="W2760_Task6" targetRef="W2760_Task7" />
      <bpmn:sequenceFlow id="W2760_Flow14" sourceRef="W2760_Task7" targetRef="W2760_Task8" />
      <bpmn:sequenceFlow id="W2760_Flow15" sourceRef="W2760_Task8" targetRef="W2760_End9" />
    </bpmn:process>
