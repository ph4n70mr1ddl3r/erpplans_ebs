    <bpmn:process id="W_W2756" name="W2756. BIR EIS E-Invoicing Transmission &amp; Daily Sales Report Sync" isExecutable="false">
      <bpmn:documentation>Trigger: Continuous (real-time/near-real-time per BIR EIS mandate)
Frequency: Daily per location
Volume: 2.8M POS transactions/month across 205 locations
Owner: Tax Technology Lead
Participants: Tax Tech Lead, IT Integration, POS Team, Tax Manager
Source: workflow W2756 — BIR EIS E-Invoicing Transmission &amp; Daily Sales Report Sync</bpmn:documentation>
      <bpmn:laneSet id="W2756_LaneSet4">
        <bpmn:lane id="W2756_Lane1" name="IT Integration">
        <bpmn:flowNodeRef>W2756_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2756_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2756_Lane2" name="Tax Tech Lead">
        <bpmn:flowNodeRef>W2756_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2756_Lane3" name="Tax Manager">
        <bpmn:flowNodeRef>W2756_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2756_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2756_Start5" name="Continuous (real-time/near-real-time per BIR EIS mandate)">
        <bpmn:outgoing>W2756_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2756_Task6" name="IT Integration ensures daily Sales Data Transmission (Sales Report + e-Invoice…">
        <bpmn:documentation>Step 1: IT Integration ensures daily Sales Data Transmission (Sales Report + e-Invoice JSON) from ERP/POS to BIR EIS via API; monitors acknowledgment receipts per location
Responsible (R): IT Integration / Tax Tech Lead
Accountable (A): Tax Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W2756_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2756_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2756_Task7" name="Tax Tech Lead reconciles transmitted line count vs. ERP sales register daily…">
        <bpmn:documentation>Step 2: Tax Tech Lead reconciles transmitted line count vs. ERP sales register daily; investigates missing/failed transmissions (offline POS recovery); triggers re-transmission
Responsible (R): Tax Tech Lead
Accountable (A): Tax Manager
