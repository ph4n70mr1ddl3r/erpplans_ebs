    <bpmn:process id="W_W2764" name="W2764. Compensation Withholding Tax (1601C) &amp; TRAIN Tax Table Maintenance" isExecutable="false">
      <bpmn:documentation>Trigger: Semi-monthly payroll run; monthly close
Frequency: Semi-monthly withholding; monthly filing
Volume: 6,925 employees across 5 entities
Owner: Payroll Manager
Participants: Payroll Mgr, Tax Accountant, HR
Source: workflow W2764 — Compensation Withholding Tax (1601C) &amp; TRAIN Tax Table Maintenance</bpmn:documentation>
      <bpmn:laneSet id="W2764_LaneSet4">
        <bpmn:lane id="W2764_Lane1" name="Payroll Manager">
        <bpmn:flowNodeRef>W2764_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2764_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2764_Lane2" name="Payroll">
        <bpmn:flowNodeRef>W2764_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2764_Lane3" name="Tax Accountant">
        <bpmn:flowNodeRef>W2764_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2764_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2764_Start5" name="Semi-monthly payroll run; monthly close">
        <bpmn:outgoing>W2764_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2764_Task6" name="Payroll Manager maintains TRAIN-law graduated withholding tax table in payroll…">
        <bpmn:documentation>Step 1: Payroll Manager maintains TRAIN-law graduated withholding tax table in payroll engine per latest BIR revenue regulations; validates per-pay-period computation against manual sample
Responsible (R): Payroll Manager
Accountable (A): Tax Manager
Duration: Per payroll cycle</bpmn:documentation>
        <bpmn:incoming>W2764_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2764_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2764_Task7" name="Payroll withholds compensation tax semi-monthly; remits via 1601C monthly…">
        <bpmn:documentation>Step 2: Payroll withholds compensation tax semi-monthly; remits via 1601C monthly; reconciles withholding register to payroll register and GL liability
Responsible (R): Payroll / Tax Accountant
Accountable (A): Payroll Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2764_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2764_Flow14</bpmn:outgoing>
      </bpmn:userTask>
