        <bpmndi:BPMNEdge id="W2762_Flow13_di" bpmnElement="W2762_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2762_Flow14_di" bpmnElement="W2762_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2762_Assoc10_di" bpmnElement="W2762_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2763" name="W2763. Customer CWT Collection (2307) &amp; AR Application" isExecutable="false">
      <bpmn:documentation>Trigger: Government/corporate customer withholds tax on payment
Frequency: Event-driven; ~1,500–2,000 AR receipts/month
Volume: ~5,200 AR trade/corporate accounts
Owner: AR Manager
Participants: AR, Tax Accountant, Customer, Collector
Source: workflow W2763 — Customer CWT Collection (2307) &amp; AR Application</bpmn:documentation>
      <bpmn:laneSet id="W2763_LaneSet3">
        <bpmn:lane id="W2763_Lane1" name="AR">
        <bpmn:flowNodeRef>W2763_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2763_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2763_Lane2" name="Tax Accountant">
        <bpmn:flowNodeRef>W2763_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2763_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2763_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2763_Start4" name="Government/corporate customer withholds tax on payment">
        <bpmn:outgoing>W2763_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2763_Task5" name="Collector obtains customer-issued BIR Form 2307 at collection; AR matches…">
        <bpmn:documentation>Step 1: Collector obtains customer-issued BIR Form 2307 at collection; AR matches withholding to open invoice(s); applies as credit to customer&#x27;s withholding tax receivable
Responsible (R): AR / Collector
Accountable (A): AR Manager
Duration: Per receipt</bpmn:documentation>
        <bpmn:incoming>W2763_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2763_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2763_Task6" name="Tax Accountant validates customer 2307 authenticity and ATC; reconciles to…">
        <bpmn:documentation>Step 2: Tax Accountant validates customer 2307 authenticity and ATC; reconciles to customer&#x27;s withholding against books; flags missing certificates for follow-up
Responsible (R): Tax Accountant
Accountable (A): Tax Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2763_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2763_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2763_Task7" name="Tax Accountant uses accumulated customer CWT certificates to reduce income tax…">
        <bpmn:documentation>Step 3: Tax Accountant uses accumulated customer CWT certificates to reduce income tax payable on 1702Q/1702RT; files refund/TCC claim for excess creditable withholding
Responsible (R): Tax Accountant / Tax Manager
Accountable (A): CFO
Duration: Quarterly/Annual</bpmn:documentation>
        <bpmn:incoming>W2763_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2763_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2763_End8" name="Complete">
        <bpmn:incoming>W2763_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2763_Annotation9">
        <bpmn:text>Controls: - CTL-467 (ensure controlled execution — Withholding Tax (EWT/CWT) &amp; Form 2307 Management (PA-79.2).) | - operational: aggressive 2307 collection and TCC claim-back
Owner: AR Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2763_Assoc10" sourceRef="W2763_Annotation9" targetRef="W2763_Start4" associationDirection="None" />
