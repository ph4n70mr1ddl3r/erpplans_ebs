    <bpmn:process id="W_W2762" name="W2762. Creditable Withholding Tax (CWT) at Source &amp; Vendor 2307 Issuance" isExecutable="false">
      <bpmn:documentation>Trigger: Each taxable vendor/contractor payment subject to CWT
Frequency: Continuous; ~3,000–4,000 payments/month
Volume: ~800–1,000 active vendors
Owner: AP Manager
Participants: AP, Tax Accountant, Vendor
Source: workflow W2762 — Creditable Withholding Tax (CWT) at Source &amp; Vendor 2307 Issuance</bpmn:documentation>
      <bpmn:laneSet id="W2762_LaneSet3">
        <bpmn:lane id="W2762_Lane1" name="AP">
        <bpmn:flowNodeRef>W2762_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2762_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2762_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2762_Lane2" name="Tax Accountant">
        <bpmn:flowNodeRef>W2762_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2762_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2762_Start4" name="Each taxable vendor/contractor payment subject to CWT">
        <bpmn:outgoing>W2762_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2762_Task5" name="AP withholds CWT at payment per vendor&#x27;s ATC (Alphanumeric Tax Code); generates…">
        <bpmn:documentation>Step 1: AP withholds CWT at payment per vendor&#x27;s ATC (Alphanumeric Tax Code); generates BIR Form 2307 (Certificate of Tax Withheld) from ERP per payee/quarter
Responsible (R): AP
Accountable (A): AP Manager
Duration: Per payment</bpmn:documentation>
        <bpmn:incoming>W2762_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2762_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2762_Task6" name="AP submits 2307 to vendor via portal/email; tracks acknowledgment; handles…">
        <bpmn:documentation>Step 2: AP submits 2307 to vendor via portal/email; tracks acknowledgment; handles vendor disputes over amount/tax base
Responsible (R): AP
Accountable (A): AP Manager
Duration: Per payment</bpmn:documentation>
        <bpmn:incoming>W2762_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2762_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2762_Task7" name="Tax Accountant rolls up 2307 totals into the quarterly 1601-EQ filings and the…">
        <bpmn:documentation>Step 3: Tax Accountant rolls up 2307 totals into the quarterly 1601-EQ filings and the annual 1604E information return; reconciles sum of issued 2307 to GL withholding; archives certificates
Responsible (R): Tax Accountant
Accountable (A): Tax Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2762_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2762_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2762_End8" name="Complete">
        <bpmn:incoming>W2762_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2762_Annotation9">
        <bpmn:text>Controls: - CTL-467 (ensure controlled execution — Withholding Tax (EWT/CWT) &amp; Form 2307 Management (PA-79.2).) | - operational: automated generation and portal delivery
Owner: AP Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2762_Assoc10" sourceRef="W2762_Annotation9" targetRef="W2762_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2762_Flow11" sourceRef="W2762_Start4" targetRef="W2762_Task5" />
      <bpmn:sequenceFlow id="W2762_Flow12" sourceRef="W2762_Task5" targetRef="W2762_Task6" />
