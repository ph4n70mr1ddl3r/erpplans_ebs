<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-79.2-withholding-tax-and-2307-management" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2761" name="W2761. Expanded Withholding Tax (EWT) Determination &amp; Quarterly Form 1601EQ" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly close; vendor payment run
Frequency: Monthly per entity
Volume: ~8,500 AP invoices/month; ~PHP 42–45B annual COGS from which EWT-applicable payments (services, rent, contractors) are screened at payment
Owner: Tax Manager
Participants: Tax Manager, AP, Tax Accountant
Source: workflow W2761 — Expanded Withholding Tax (EWT) Determination &amp; Quarterly Form 1601EQ</bpmn:documentation>
      <bpmn:laneSet id="W2761_LaneSet4">
        <bpmn:lane id="W2761_Lane1" name="AP">
        <bpmn:flowNodeRef>W2761_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2761_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2761_Lane2" name="Tax Accountant">
        <bpmn:flowNodeRef>W2761_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2761_Lane3" name="Tax Manager">
        <bpmn:flowNodeRef>W2761_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2761_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2761_Start5" name="Monthly close; vendor payment run">
        <bpmn:outgoing>W2761_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2761_Task6" name="AP applies EWT rate per nature-of-payment (rent 5%, professional 10–15%…">
        <bpmn:documentation>Step 1: AP applies EWT rate per nature-of-payment (rent 5%, professional 10–15%, supplies 1%, contractors 2% etc.) at invoice entry via ERP tax code; withholds at payment
Responsible (R): AP
Accountable (A): Tax Manager
Duration: Per payment</bpmn:documentation>
        <bpmn:incoming>W2761_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2761_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2761_Task7" name="Tax Accountant reconciles monthly EWT withheld ledger to GL withholding…">
        <bpmn:documentation>Step 2: Tax Accountant reconciles monthly EWT withheld ledger to GL withholding liability; investigates un-withheld payments; books accruals for late-detected under-withholding
Responsible (R): Tax Accountant
Accountable (A): Tax Manager
Duration: 1–2 days/entity</bpmn:documentation>
        <bpmn:incoming>W2761_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2761_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2761_Task8" name="Tax Manager prepares and files BIR Form 1601-EQ (quarterly, due the last day of…">
        <bpmn:documentation>Step 3: Tax Manager prepares and files BIR Form 1601-EQ (quarterly, due the last day of the month following quarter close) via eFPS; remits withheld amounts; archives schedules
Responsible (R): Tax Manager
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2761_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2761_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2761_End9" name="Complete">
        <bpmn:incoming>W2761_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2761_Annotation10">
        <bpmn:text>Controls: - CTL-214 (ensure BIR tax compliance &amp; filing integrity.) | - operational: automated tax-code mapping and payment-run validation
Owner: Tax Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2761_Assoc11" sourceRef="W2761_Annotation10" targetRef="W2761_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2761_Flow12" sourceRef="W2761_Start5" targetRef="W2761_Task6" />
      <bpmn:sequenceFlow id="W2761_Flow13" sourceRef="W2761_Task6" targetRef="W2761_Task7" />
      <bpmn:sequenceFlow id="W2761_Flow14" sourceRef="W2761_Task7" targetRef="W2761_Task8" />
      <bpmn:sequenceFlow id="W2761_Flow15" sourceRef="W2761_Task8" targetRef="W2761_End9" />
    </bpmn:process>
