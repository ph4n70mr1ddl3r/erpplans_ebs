      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4868" name="W4868. Consent, RA 10173 Privacy &amp; Data-Minimization Governance" isExecutable="false">
      <bpmn:documentation>Trigger: Screening initiation; privacy-program cycle (VS-91); DSAR; regulatory change
Frequency: Per screen + continuous governance
Volume: All screened individuals (~thousands/yr)
Owner: Screening Program Manager / Privacy Officer (DPO) (VS-91)
Participants: Legal (VS-100.3), HR, Screening vendor, Labor Relations (VS-84)
Source: workflow W4868 — Consent, RA 10173 Privacy &amp; Data-Minimization Governance</bpmn:documentation>
      <bpmn:laneSet id="W4868_LaneSet3">
        <bpmn:lane id="W4868_Lane1" name="Screening Program Manager">
        <bpmn:flowNodeRef>W4868_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4868_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4868_Lane2" name="DPO">
        <bpmn:flowNodeRef>W4868_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4868_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4868_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4868_Start4" name="Screening initiation; privacy-program cycle (VS-91); DSAR; regulatory change">
        <bpmn:outgoing>W4868_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4868_Task5" name="Govern consent: each screened individual provides informed, specific, RA…">
        <bpmn:documentation>Step 1: Govern consent: each screened individual provides informed, specific, RA 10173-compliant consent before screening (purpose, scope, data, recipient, retention, rights); capture and retain the consent record; ensure the lawful basis (consent and/or legitimate-interest/role-related per policy W4866)
Responsible (R): Screening Program Manager / DPO / HR
Accountable (A): VP Legal &amp; Compliance / DPO
Duration: Per screen</bpmn:documentation>
        <bpmn:incoming>W4868_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4868_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4868_Task6" name="Enforce data minimization: collect only the screening data the role-package…">
        <bpmn:documentation>Step 2: Enforce data minimization: collect only the screening data the role-package (W4866/W4869) requires, no more; limit access (need-to-know), secure storage/transfer, and the screening-vendor data-handling (DPA W4867); conduct a screening-specific PIA/DPIA
Responsible (R): DPO / Screening Program Manager / Legal
Accountable (A): DPO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4868_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4868_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4868_Task7" name="Honor data-subject rights: access, rectification, erasure (where applicable)…">
        <bpmn:documentation>Step 3: Honor data-subject rights: access, rectification, erasure (where applicable), objection, and DSAR (links to VS-91); manage the 72-hour breach-notification obligation for any screening-data breach (vendor or internal)
Responsible (R): DPO / Legal / Screening Program Manager
Accountable (A): DPO
Duration: Per request/event</bpmn:documentation>
        <bpmn:incoming>W4868_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4868_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4868_End8" name="Complete">
        <bpmn:incoming>W4868_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4868_Annotation9">
        <bpmn:text>Controls: - CTL-131 (ensure lawful &amp; consented personnel vetting.) | - CTL-731: RA 10173 consent before screening; data minimization by role-package; DSAR honored; breach notified
Owner: Screening Program Manager / Privacy Officer (DPO) (VS-91)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4868_Assoc10" sourceRef="W4868_Annotation9" targetRef="W4868_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4868_Flow11" sourceRef="W4868_Start4" targetRef="W4868_Task5" />
      <bpmn:sequenceFlow id="W4868_Flow12" sourceRef="W4868_Task5" targetRef="W4868_Task6" />
      <bpmn:sequenceFlow id="W4868_Flow13" sourceRef="W4868_Task6" targetRef="W4868_Task7" />
      <bpmn:sequenceFlow id="W4868_Flow14" sourceRef="W4868_Task7" targetRef="W4868_End8" />
    </bpmn:process>
