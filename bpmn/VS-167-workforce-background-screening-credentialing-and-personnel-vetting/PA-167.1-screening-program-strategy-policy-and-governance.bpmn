      <bpmn:sequenceFlow id="W4870_Flow11" sourceRef="W4870_Task4" targetRef="W4870_Task5" />
      <bpmn:sequenceFlow id="W4870_Flow12" sourceRef="W4870_Task5" targetRef="W4870_Task6" />
      <bpmn:sequenceFlow id="W4870_Flow13" sourceRef="W4870_Task6" targetRef="W4870_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4870_diag">
      <bpmndi:BPMNPlane id="W4870_plane" bpmnElement="W_W4870">
        <bpmndi:BPMNShape id="W4870_Lane1_di" bpmnElement="W4870_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4870_Task4_di" bpmnElement="W4870_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
