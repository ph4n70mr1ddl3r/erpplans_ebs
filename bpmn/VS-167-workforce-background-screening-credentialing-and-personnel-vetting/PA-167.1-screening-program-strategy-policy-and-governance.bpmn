        <bpmndi:BPMNEdge id="W4869_Flow12_di" bpmnElement="W4869_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4869_Flow13_di" bpmnElement="W4869_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4869_Assoc9_di" bpmnElement="W4869_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4870" name="W4870. Screening Quality Standards, SLA &amp; Evidence Chain-of-Custody" isExecutable="false">
      <bpmn:documentation>Trigger: Screening operations; SLA review; audit; quality issue
Frequency: Continuous + periodic review
Volume: All screens (~thousands/yr)
Owner: Screening Program Manager / Quality / Vendor (W4867)
Participants: HR, Security, Legal (VS-100.3), Internal Audit (VS-21)
Source: workflow W4870 — Screening Quality Standards, SLA &amp; Evidence Chain-of-Custody</bpmn:documentation>
      <bpmn:laneSet id="W4870_LaneSet2">
        <bpmn:lane id="W4870_Lane1" name="Screening Program Manager">
        <bpmn:flowNodeRef>W4870_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4870_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4870_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4870_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4870_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4870_Start3" name="Screening operations; SLA review; audit; quality issue">
        <bpmn:outgoing>W4870_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4870_Task4" name="Maintain screening quality standards: completeness (all package checks done)…">
        <bpmn:documentation>Step 1: Maintain screening quality standards: completeness (all package checks done), accuracy (correct individual, no false-merge), verification (source-authenticated), TAT (SLA per check-type), and the evidence standard (what record proves the screen was done)
Responsible (R): Screening Program Manager / Quality / Vendor
Accountable (A): CHRO / VP Legal &amp; Compliance
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4870_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4870_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4870_Task5" name="Maintain the evidence chain-of-custody: from consent → screening-order →…">
        <bpmn:documentation>Step 2: Maintain the evidence chain-of-custody: from consent → screening-order → vendor-result → verification → decision → retention, tamper-evident and audit-ready; reconcile to the HRIS and the legal/regulatory record (VS-88)
Responsible (R): Screening Program Manager / Records / Legal
Accountable (A): CHRO / VP Legal &amp; Compliance
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4870_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4870_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4870_Task6" name="Monitor SLA/quality: track TAT, accuracy, completeness, vendor performance…">
        <bpmn:documentation>Step 3: Monitor SLA/quality: track TAT, accuracy, completeness, vendor performance (W4867), exceptions, and audit findings; remediate quality issues; report quality-health to governance (W4888) and analytics (W4881)
Responsible (R): Screening Program Manager / Quality / Internal Audit
Accountable (A): CHRO / VP Legal &amp; Compliance
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4870_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4870_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4870_End7" name="Complete">
        <bpmn:incoming>W4870_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4870_Annotation8">
        <bpmn:text>Controls: - CTL-731 (ensure controlled execution — Screening Program Strategy, Policy &amp; Governance (PA-167.1).) | - CTL-731: quality standards enforced; tamper-evident chain-of-custody; SLA monitored
Owner: Screening Program Manager / Quality / Vendor (W4867)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4870_Assoc9" sourceRef="W4870_Annotation8" targetRef="W4870_Start3" associationDirection="None" />
