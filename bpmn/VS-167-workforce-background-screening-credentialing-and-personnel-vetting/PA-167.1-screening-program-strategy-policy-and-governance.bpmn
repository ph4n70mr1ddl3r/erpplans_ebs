        <bpmndi:BPMNShape id="W4870_Start3_di" bpmnElement="W4870_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4870_End7_di" bpmnElement="W4870_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4870_Annotation8_di" bpmnElement="W4870_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4870_Flow10_di" bpmnElement="W4870_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4870_Flow11_di" bpmnElement="W4870_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4870_Flow12_di" bpmnElement="W4870_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4870_Flow13_di" bpmnElement="W4870_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4870_Assoc9_di" bpmnElement="W4870_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4871" name="W4871. Program Governance, Separation-of-Duties, Adverse-Action Review Board &amp; Appeals" isExecutable="false">
      <bpmn:documentation>Trigger: Adverse finding requiring decision; governance cycle; appeal/dispute
Frequency: Per adverse finding + continuous governance
Volume: ~80–150 adverse findings/year (subset of screens)
Owner: Screening Program Manager / Adverse-Action Review Board / Legal (VS-100.3)
Participants: HR, Security (VS-159), Labor Relations (VS-84), Privacy (VS-91)
Source: workflow W4871 — Program Governance, Separation-of-Duties, Adverse-Action Review Board &amp; Appeals</bpmn:documentation>
      <bpmn:laneSet id="W4871_LaneSet3">
        <bpmn:lane id="W4871_Lane1" name="Screening Program Manager">
        <bpmn:flowNodeRef>W4871_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4871_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4871_Lane2" name="Review Board">
        <bpmn:flowNodeRef>W4871_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4871_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4871_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4871_Start4" name="Adverse finding requiring decision; governance cycle; appeal/dispute">
        <bpmn:outgoing>W4871_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4871_Task5" name="Govern the program with separation-of-duties: the screening function…">
        <bpmn:documentation>Step 1: Govern the program with separation-of-duties: the screening function (orders/checks) is separate from the adverse-action decision (review board) and from the hiring/assignment decision — preventing conflict-of-interest and bias; document the SoD in the governance framework
Responsible (R): Screening Program Manager / Legal / HR
Accountable (A): CHRO / VP Legal &amp; Compliance
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4871_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4871_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4871_Task6" name="Operate the Adverse-Action Review Board: on an adverse finding, conduct the…">
        <bpmn:documentation>Step 2: Operate the Adverse-Action Review Board: on an adverse finding, conduct the individualized assessment (W4866 — nature/gravity/time-since/relevance to role), issue the pre-adverse-action notice, allow the individual to respond/dispute/evidence rehabilitation, decide, and notify; ensure NLRC/due-process alignment (VS-84)
Responsible (R): Review Board / Legal / HR / Security
Accountable (A): CHRO / VP Legal &amp; Compliance
Duration: Per finding</bpmn:documentation>
        <bpmn:incoming>W4871_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4871_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4871_Task7" name="Manage appeals &amp; disputes: a defined appeal path, escalation to HR/Legal, and…">
        <bpmn:documentation>Step 3: Manage appeals &amp; disputes: a defined appeal path, escalation to HR/Legal, and where unresolved, NLRC/labor-relations handling (VS-84); document all decisions in the chain-of-custody (W4870) and report adverse-action outcomes/bias indicators to governance (W4888) and analytics (W4881)
Responsible (R): Review Board / Legal / Labor Relations
Accountable (A): CHRO / VP Legal &amp; Compliance
Duration: Per appeal</bpmn:documentation>
        <bpmn:incoming>W4871_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4871_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4871_End8" name="Complete">
        <bpmn:incoming>W4871_Flow14</bpmn:incoming>
      </bpmn:endEvent>
