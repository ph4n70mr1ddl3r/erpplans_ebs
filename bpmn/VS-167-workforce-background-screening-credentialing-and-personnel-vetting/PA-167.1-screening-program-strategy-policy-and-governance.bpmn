      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4866" name="W4866. Screening Policy, Role-Based Screening Matrix &amp; Adverse-Action/Fair-Chance Framework" isExecutable="false">
      <bpmn:documentation>Trigger: Strategy (W4865); regulatory change (DOLE/NPC); legal/HR-policy refresh; adverse-action dispute
Frequency: Annual + on change
Volume: 1 policy; 1 role-based matrix; 1 adverse-action framework
Owner: Screening Program Manager / Legal (VS-100.3) / HR Policy
Participants: CHRO, Security (VS-159), Labor Relations (VS-84), Privacy (VS-91)
Source: workflow W4866 — Screening Policy, Role-Based Screening Matrix &amp; Adverse-Action/Fair-Chance Framework</bpmn:documentation>
      <bpmn:laneSet id="W4866_LaneSet3">
        <bpmn:lane id="W4866_Lane1" name="Screening Program Manager">
        <bpmn:flowNodeRef>W4866_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4866_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4866_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4866_Lane2" name="Legal">
        <bpmn:flowNodeRef>W4866_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4866_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4866_Start4" name="Strategy (W4865); regulatory change (DOLE/NPC); legal/HR-policy refresh; adverse-action…">
        <bpmn:outgoing>W4866_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4866_Task5" name="Maintain the screening policy: when screening occurs…">
        <bpmn:documentation>Step 1: Maintain the screening policy: when screening occurs (pre-offer/offer-conditional, periodic re-screen, trigger-based), what is screened per role tier (W4865), consent requirements (W4868), data minimization, retention (W4872), and the lawful basis (RA 10173, DOLE, role-related/legitimate interest)
Responsible (R): Screening Program Manager / Legal / HR Policy
Accountable (A): CHRO / VP Legal &amp; Compliance
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4866_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4866_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4866_Task6" name="Maintain the role-based screening matrix: every role (cashier, finance…">
        <bpmn:documentation>Step 2: Maintain the role-based screening matrix: every role (cashier, finance, security guard, CIT, IT-admin, child-adjacent, forklift/driver, executive) mapped to required checks (NBI, police, court, prior-employment, education, credit, sanctions/PEP, drug W150, license W1400); review with Security and Legal
Responsible (R): Screening Program Manager / Security / Legal / HR
Accountable (A): CHRO / Chief Compliance &amp; Security Officer
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4866_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4866_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4866_Task7" name="Maintain the adverse-action/fair-chance framework: individualized assessment of…">
        <bpmn:documentation>Step 3: Maintain the adverse-action/fair-chance framework: individualized assessment of criminal history vs role, the pre-adverse-action notice, the candidate&#x27;s right to respond/dispute, the decision and notice, and appeal; align to DOLE/NLRC due process (VS-84) and avoid blanket bans (fair-chance/bias risk)
Responsible (R): Legal / HR Policy / Screening Program Manager
Accountable (A): VP Legal &amp; Compliance / CHRO
Duration: Annual + on dispute</bpmn:documentation>
        <bpmn:incoming>W4866_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4866_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4866_End8" name="Complete">
        <bpmn:incoming>W4866_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4866_Annotation9">
        <bpmn:text>Controls: - CTL-731 (ensure controlled execution — Screening Program Strategy, Policy &amp; Governance (PA-167.1).) | - CTL-731: policy lawful &amp; current; role-based matrix applied; adverse-action due process followed
Owner: Screening Program Manager / Legal (VS-100.3) / HR Policy</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4866_Assoc10" sourceRef="W4866_Annotation9" targetRef="W4866_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4866_Flow11" sourceRef="W4866_Start4" targetRef="W4866_Task5" />
      <bpmn:sequenceFlow id="W4866_Flow12" sourceRef="W4866_Task5" targetRef="W4866_Task6" />
      <bpmn:sequenceFlow id="W4866_Flow13" sourceRef="W4866_Task6" targetRef="W4866_Task7" />
      <bpmn:sequenceFlow id="W4866_Flow14" sourceRef="W4866_Task7" targetRef="W4866_End8" />
    </bpmn:process>
