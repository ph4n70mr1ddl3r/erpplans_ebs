        <bpmndi:BPMNEdge id="W4866_Flow12_di" bpmnElement="W4866_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4866_Flow13_di" bpmnElement="W4866_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4866_Flow14_di" bpmnElement="W4866_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4866_Assoc10_di" bpmnElement="W4866_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4867" name="W4867. Screening-Vendor Selection, PNP-SOSIA Licensing &amp; Contracting" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor selection/RFP; contract expiry; performance review; TPRM refresh
Frequency: Per sourcing event + multi-year contract + ongoing governance
Volume: ~1–3 screening vendors/providers group-wide
Owner: Screening Program Manager / Procurement (VS-03/VS-34) / Legal (VS-100.3)
Participants: TPRM (VS-161), Privacy (VS-91), Security (VS-159), Finance
Source: workflow W4867 — Screening-Vendor Selection, PNP-SOSIA Licensing &amp; Contracting</bpmn:documentation>
      <bpmn:laneSet id="W4867_LaneSet3">
        <bpmn:lane id="W4867_Lane1" name="Screening Program Manager">
        <bpmn:flowNodeRef>W4867_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4867_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4867_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4867_Lane2" name="Procurement">
        <bpmn:flowNodeRef>W4867_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4867_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4867_Start4" name="Vendor selection/RFP; contract expiry; performance review; TPRM refresh">
        <bpmn:outgoing>W4867_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4867_Task5" name="Define vendor requirements: licensing (PNP-SOSIA under RA 5487 for…">
        <bpmn:documentation>Step 1: Define vendor requirements: licensing (PNP-SOSIA under RA 5487 for investigation agencies; PBSA/BSAAP accreditation where held), coverage (NBI/police/court/education/credit/sanctions access), TAT, data security, RA 10173 compliance, integrations (HRIS/ATS), and pricing model
Responsible (R): Screening Program Manager / Procurement / Legal / Privacy
Accountable (A): CHRO / VP Legal &amp; Compliance
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4867_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4867_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4867_Task6" name="Run sourcing &amp; contract: RFP, evaluate (capability, TPRM cyber &amp; financial DD…">
        <bpmn:documentation>Step 2: Run sourcing &amp; contract: RFP, evaluate (capability, TPRM cyber &amp; financial DD VS-161, privacy/DPA VS-91, references), negotiate the agreement (SLA, data-handling, DPA, breach notice, audit rights, term/exit), and contract via Legal
Responsible (R): Procurement / Legal / TPRM / Privacy
Accountable (A): CHRO / VP Legal &amp; Compliance
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4867_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4867_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4867_Task7" name="Onboard &amp; govern: integrate to HRIS/ATS (VS-121), set SLA monitoring, conduct…">
        <bpmn:documentation>Step 3: Onboard &amp; govern: integrate to HRIS/ATS (VS-121), set SLA monitoring, conduct periodic performance/quality review (W4870), manage re-compete at term, and feed vendor performance to TPRM (VS-161) and analytics (W4885)
Responsible (R): Screening Program Manager / Procurement / TPRM
Accountable (A): CHRO / VP Legal &amp; Compliance
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4867_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4867_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4867_End8" name="Complete">
        <bpmn:incoming>W4867_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4867_Annotation9">
        <bpmn:text>Controls: - CTL-731 (ensure controlled execution — Screening Program Strategy, Policy &amp; Governance (PA-167.1).) | - CTL-731: vendor accredited + DPA + TPRM DD; SLA monitored; re-compete at term
Owner: Screening Program Manager / Procurement (VS-03/VS-34) / Legal (VS-100.3)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4867_Assoc10" sourceRef="W4867_Annotation9" targetRef="W4867_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4867_Flow11" sourceRef="W4867_Start4" targetRef="W4867_Task5" />
      <bpmn:sequenceFlow id="W4867_Flow12" sourceRef="W4867_Task5" targetRef="W4867_Task6" />
      <bpmn:sequenceFlow id="W4867_Flow13" sourceRef="W4867_Task6" targetRef="W4867_Task7" />
      <bpmn:sequenceFlow id="W4867_Flow14" sourceRef="W4867_Task7" targetRef="W4867_End8" />
    </bpmn:process>
