    <bpmn:process id="W_W1445" name="W1445. New Store Site Feasibility Assessment, Traffic Analysis, Competitive Mapping &amp; Real Estate Due Diligence" isExecutable="false">
      <bpmn:documentation>Trigger: Expansion pipeline milestone (10–15 new stores/year target); or broker/landlord inbound proposal for new location
Frequency: 10–15 site assessments per year; each assessment takes 4–6 weeks from initial screening to go/no-go recommendation
Volume: Each assessment covers 1 candidate site; typically 2–3 candidate sites evaluated per approved new store location; ~20–45 site assessments/year total
Owner: COO &amp; Construction
Participants: COO, Real Estate Manager, VP Store Operations, Finance Controller, Category Manager (local demand assessment), Legal Counsel, External Real Estate Broker, LGU Planning Office
Source: workflow W1445 — New Store Site Feasibility Assessment, Traffic Analysis, Competitive Mapping &amp; Real Estate Due Diligence</bpmn:documentation>
      <bpmn:laneSet id="W1445_LaneSet5">
        <bpmn:lane id="W1445_Lane1" name="Real Estate Manager">
        <bpmn:flowNodeRef>W1445_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1445_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1445_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1445_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1445_Lane2" name="Finance Controller">
        <bpmn:flowNodeRef>W1445_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1445_Lane3" name="Legal Counsel">
        <bpmn:flowNodeRef>W1445_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1445_Lane4" name="COO">
        <bpmn:flowNodeRef>W1445_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1445_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1445_Start6" name="Expansion pipeline milestone (10–15 new stores/year target); or broker/landlord inbound…">
        <bpmn:outgoing>W1445_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1445_Task7" name="Market opportunity screening">
        <bpmn:documentation>Step 1: Market opportunity screening: Real Estate Manager conducts initial market screening: (a) identify high-growth municipalities/cities using: (i) Philippine Statistics Authority population and household growth data, (ii) DTI registered construction permits (proxy for construction activity), (iii) residential development pipeline (new subdivisions, condominiums = future customers), (iv) existing BuildRight store coverage map — identify gaps in the network (&gt; 30-minute drive to nearest BuildRight = underserved), (b) prioritize regions aligned with BuildRight expansion strategy: North/Central Luzon (20 stores → 40+ target) and Visayas (40 stores → 60+ target), (c) produce shortlist of 5–10 candidate municipalities for deeper analysis
Responsible (R): Real Estate Manager
Accountable (A): COO
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W1445_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1445_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1445_Task8" name="Candidate site identification and traffic analysis">
        <bpmn:documentation>Step 2: Candidate site identification and traffic analysis: For shortlisted municipalities: (a) Real Estate Manager identifies 2–3 candidate sites per municipality via: (i) broker network, (ii) property listings, (iii) direct landlord/developer outreach, (iv) LGU economic zone inquiries, (b) conduct traffic and accessibility analysis for each candidate site: (i) vehicle traffic count (DTI/LGU traffic data + manual count during peak hours), (ii) pedestrian foot traffic (proxy for walk-in potential), (iii) road network accessibility: major road frontage, highway proximity, truck accessibility for DC deliveries, (iv) public transportation access (jeepney/bus routes), (c) minimum site requirements: 8,000–15,000 sqm selling area + parking + loading dock; standalone or end-cap in retail park preferred
Responsible (R): Real Estate Manager / External Broker
Accountable (A): COO
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W1445_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1445_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1445_Task9" name="Competitive mapping">
        <bpmn:documentation>Step 3: Competitive mapping: For each candidate site: (a) map all competing hardware/home improvement retailers within 10 km radius: (i) other hardware chains (Wilcon, CitiHardware, Truworths), (ii) independent hardware stores, (iii) building material dealers, (iv) online competitors (Lazada, Shopee delivery coverage), (b) assess competitive intensity: (i) number of competitors, (ii) estimated competitor revenue per store, (iii) BuildRight&#x27;s differentiation opportunity (wider assortment, lower prices, better service, BOPIS), (c) estimate BuildRight&#x27;s addressable market share based on competitive landscape
Responsible (R): Real Estate Manager / Category Manager
Accountable (A): VP Merchandising
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1445_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1445_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1445_Task10" name="Financial feasibility modeling">
        <bpmn:documentation>Step 4: Financial feasibility modeling: Finance Controller builds store-level financial model: (a) revenue projection: (i) estimated monthly sales based on catchment population, household income, construction activity, and competitive share, (ii) Year 1–5 revenue ramp (typical: 60% of mature store revenue in Year 1, 80% in Year 2, 95% in Year 3, 100% in Year 4), (b) cost projection: (i) lease cost (base rent + CAM + escalation), (ii) fit-out and capex amortization, (iii) staffing cost (29 employees), (iv) inventory carrying cost, (v) DC delivery cost, (c) profitability analysis: (i) gross margin estimate (28–32%), (ii) store-level EBITDA breakeven timeline, (iii) NPV and IRR over lease term, (d) minimum investment criteria: NPV &gt; 0 at 15% discount rate; EBITDA positive by Year 3; payback period &lt; 5 years
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1445_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1445_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1445_Task11" name="Real estate due diligence and LGU navigation">
        <bpmn:documentation>Step 5: Real estate due diligence and LGU navigation: For sites passing financial feasibility: (a) Legal Counsel conducts due diligence: (i) title verification (Registry of Deeds), (ii) zoning compliance (residential/commercial/mixed-use), (iii) tax declaration and real property tax status, (iv) environmental compliance (DENR clearance if applicable), (v) access rights and easements, (b) LGU engagement: (i) secure locational clearance from municipal/city planning office, (ii) confirm building permit requirements and timeline, (iii) identify local business tax rates and incentives (some LGUs offer tax holidays for new investors), (iv) assess political support (meeting with mayor/economic development office), (c) Real Estate Manager negotiates Letter of Intent (LOI) with landlord: (i) lease rate, (ii) lease term (5–10 years + renewal options), (iii) tenant improvement allowance, (iv) escalation terms, (v) exclusivity clause (prevent competing hardware tenant in same development)
Responsible (R): Legal Counsel / Real Estate Manager
Accountable (A): COO
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W1445_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1445_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1445_Task12" name="Go/no-go decision and lease execution">
        <bpmn:documentation>Step 6: Go/no-go decision and lease execution: (a) COO presents complete feasibility package to CEO/CFO: market analysis, site specifics, competitive assessment, financial model, due diligence findings, lease terms, (b) CEO approves or rejects; if approved, Legal Counsel executes lease agreement, (c) VP Store Operations activates new store opening project per W702 (target: 4–6 months from lease signing to store opening)
Responsible (R): COO
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1445_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1445_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1445_End13" name="Complete">
        <bpmn:incoming>W1445_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1445_Annotation14">
        <bpmn:text>Controls: - CTL-301 (ensure controlled execution — Site Selection &amp; Lease Management (PA-20.1).) | - operational: COO &amp; Construction review and approval gate
Owner: COO &amp; Construction</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1445_Assoc15" sourceRef="W1445_Annotation14" targetRef="W1445_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1445_Flow16" sourceRef="W1445_Start6" targetRef="W1445_Task7" />
      <bpmn:sequenceFlow id="W1445_Flow17" sourceRef="W1445_Task7" targetRef="W1445_Task8" />
      <bpmn:sequenceFlow id="W1445_Flow18" sourceRef="W1445_Task8" targetRef="W1445_Task9" />
      <bpmn:sequenceFlow id="W1445_Flow19" sourceRef="W1445_Task9" targetRef="W1445_Task10" />
      <bpmn:sequenceFlow id="W1445_Flow20" sourceRef="W1445_Task10" targetRef="W1445_Task11" />
      <bpmn:sequenceFlow id="W1445_Flow21" sourceRef="W1445_Task11" targetRef="W1445_Task12" />
      <bpmn:sequenceFlow id="W1445_Flow22" sourceRef="W1445_Task12" targetRef="W1445_End13" />
    </bpmn:process>
