        <bpmn:documentation>Step 2: Receive Tax Bill from LGU (Provincial/City Treasurer)
Responsible (R): Tax Manager
Accountable (A): —
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W119_Flow16</bpmn:incoming>
        <bpmn:outgoing>W119_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W119_Task8" name="Validate assessment against previous year and improvements made">
        <bpmn:documentation>Step 3: Validate assessment against previous year and improvements made
Responsible (R): Tax Manager
Accountable (A): CFO
Duration: 1 hour/site</bpmn:documentation>
        <bpmn:incoming>W119_Flow17</bpmn:incoming>
        <bpmn:outgoing>W119_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W119_Task9" name="Calculate prompt-payment discounts (if applicable)">
        <bpmn:documentation>Step 4: Calculate prompt-payment discounts (if applicable)
Responsible (R): Tax Manager
Accountable (A): Tax Manager
Duration: 15 min/site</bpmn:documentation>
        <bpmn:incoming>W119_Flow18</bpmn:incoming>
        <bpmn:outgoing>W119_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W119_Task10" name="Process payment via manager&#x27;s check or bank transfer to LGU">
        <bpmn:documentation>Step 5: Process payment via manager&#x27;s check or bank transfer to LGU
Responsible (R): Treasury
Accountable (A): CFO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W119_Flow19</bpmn:incoming>
        <bpmn:outgoing>W119_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W119_Task11" name="File receipt and update property records in ERP (Fixed Asset module)">
