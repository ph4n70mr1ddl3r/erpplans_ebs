    <bpmn:process id="W_W119" name="W119. Real Property Tax (Amillaramiento) Management" isExecutable="false">
      <bpmn:documentation>Trigger: Annual/Quarterly tax assessment from LGU
Frequency: Annual (with quarterly installment options)
Volume: ~50 owned sites (Land/Building)
Owner: Tax Manager
Participants: Lease Admin (for records), Finance
Source: workflow W119 — Real Property Tax (Amillaramiento) Management</bpmn:documentation>
      <bpmn:laneSet id="W119_LaneSet4">
