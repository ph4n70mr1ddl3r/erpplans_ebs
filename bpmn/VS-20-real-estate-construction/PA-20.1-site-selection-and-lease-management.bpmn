    <bpmn:process id="W_W116" name="W116. Site Selection &amp; Feasibility Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Strategic growth plan (10–15 new stores/year target)
Frequency: Ongoing; ~15–20 sites evaluated monthly
Volume: ~10–15 approved sites/year
Owner: VP for Property Management
Participants: Property Acquisition Manager, Finance (ROI analysis), CEO/Board (approval), Real-Estate &amp; Site-Selection Analyst
Source: workflow W116 — Site Selection &amp; Feasibility Analysis</bpmn:documentation>
      <bpmn:laneSet id="W116_LaneSet5">
        <bpmn:lane id="W116_Lane1" name="Property Manager">
        <bpmn:flowNodeRef>W116_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W116_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W116_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W116_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W116_Lane2" name="Finance Analyst">
        <bpmn:flowNodeRef>W116_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W116_Lane3" name="Director, Facilities &amp; Real Estate">
        <bpmn:flowNodeRef>W116_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W116_Lane4" name="Legal">
        <bpmn:flowNodeRef>W116_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W116_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W116_Start6" name="Strategic growth plan (10–15 new stores/year target)">
        <bpmn:outgoing>W116_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W116_Task7" name="Identify potential site (greenfield or existing building) based on catchment…">
        <bpmn:documentation>Step 1: Identify potential site (greenfield or existing building) based on catchment analysis
Responsible (R): Property Manager
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W116_Flow16</bpmn:incoming>
        <bpmn:outgoing>W116_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W116_Task8" name="Conduct site survey: size (8k–15k sqm), zoning, access, utilities, competitors">
        <bpmn:documentation>Step 2: Conduct site survey: size (8k–15k sqm), zoning, access, utilities, competitors
Responsible (R): Property Manager
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W116_Flow17</bpmn:incoming>
        <bpmn:outgoing>W116_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W116_Task9" name="Financial Feasibility: Calculate projected store sales (W13) vs. build/lease…">
        <bpmn:documentation>Step 3: Financial Feasibility: Calculate projected store sales (W13) vs. build/lease cost
Responsible (R): Finance Analyst
Accountable (A): CFO
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W116_Flow18</bpmn:incoming>
        <bpmn:outgoing>W116_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W116_Task10" name="Draft Letter of Intent (LOI) and initial lease terms">
        <bpmn:documentation>Step 4: Draft Letter of Intent (LOI) and initial lease terms
Responsible (R): Property Manager
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W116_Flow19</bpmn:incoming>
        <bpmn:outgoing>W116_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W116_Task11" name="Present Site Selection Memo to Board/CEO for approval">
        <bpmn:documentation>Step 5: Present Site Selection Memo to Board/CEO for approval
Responsible (R): Director, Facilities &amp; Real Estate
Accountable (A): CEO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W116_Flow20</bpmn:incoming>
        <bpmn:outgoing>W116_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W116_Task12" name="Execute Lease Agreement (W117)">
        <bpmn:documentation>Step 6: Execute Lease Agreement (W117)
Responsible (R): Legal / Director, Facilities &amp; Real Estate
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W116_Flow21</bpmn:incoming>
        <bpmn:outgoing>W116_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W116_End13" name="Complete">
        <bpmn:incoming>W116_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W116_Annotation14">
        <bpmn:text>Controls: - CTL-301 (ensure controlled execution — Site Selection &amp; Lease Management (PA-20.1).) | - operational: VP for Property Management review and approval gate
Owner: VP for Property Management</bpmn:text>
      </bpmn:textAnnotation>
