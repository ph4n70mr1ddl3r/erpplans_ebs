    <bpmn:process id="W_W118" name="W118. Rent &amp; CAM Payment Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly billing or lease schedule
Frequency: Monthly
Volume: ~250 payments/month (Stores, DCs, Offices, Parking)
Owner: AP Specialist (Lease)
Participants: Lease Administrator, Finance
Source: workflow W118 — Rent &amp; CAM Payment Processing</bpmn:documentation>
      <bpmn:laneSet id="W118_LaneSet6">
        <bpmn:lane id="W118_Lane1" name="System">
        <bpmn:flowNodeRef>W118_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W118_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W118_Lane2" name="Lease Admin">
        <bpmn:flowNodeRef>W118_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W118_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W118_Lane3" name="AP Specialist">
        <bpmn:flowNodeRef>W118_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W118_Lane4" name="AP Supervisor">
        <bpmn:flowNodeRef>W118_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W118_Lane5" name="Treasury">
        <bpmn:flowNodeRef>W118_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W118_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W118_Start7" name="Monthly billing or lease schedule">
        <bpmn:outgoing>W118_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W118_Task8" name="System generates payment schedule for base rent per lease master">
        <bpmn:documentation>Step 1: System generates payment schedule for base rent per lease master
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W118_Flow17</bpmn:incoming>
        <bpmn:outgoing>W118_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W118_Task9" name="Receive lessor invoice for Common Area Maintenance (CAM) and utility recharges">
        <bpmn:documentation>Step 2: Receive lessor invoice for Common Area Maintenance (CAM) and utility recharges
Responsible (R): Lease Admin
Accountable (A): —
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W118_Flow18</bpmn:incoming>
        <bpmn:outgoing>W118_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W118_Task10" name="Validate CAM charges against lease caps/clauses">
