    <bpmn:process id="W_W441" name="W441. Corporate Staff Housing &amp; Billeting Management" isExecutable="false">
      <bpmn:documentation>Trigger: Assignment/relocation of management staff to a provincial store; or assignment of specialist audit/project teams
Frequency: Monthly (occupancy changes); Weekly (utility payments)
Volume: ~100–150 active staff houses/leases chain-wide
Owner: Property Manager
Participants: HR, Store Manager, Finance, Property Admin
Source: workflow W441 — Corporate Staff Housing &amp; Billeting Management</bpmn:documentation>
      <bpmn:laneSet id="W441_LaneSet4">
        <bpmn:lane id="W441_Lane1" name="HR">
        <bpmn:flowNodeRef>W441_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W441_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W441_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W441_Lane2" name="Property Admin">
        <bpmn:flowNodeRef>W441_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W441_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W441_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W441_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W441_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W441_Lane3" name="Occupant">
        <bpmn:flowNodeRef>W441_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W441_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W441_Start5" name="Assignment/relocation of management staff to a provincial store; or assignment of…">
        <bpmn:outgoing>W441_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W441_Task6" name="Request for Housing">
        <bpmn:documentation>Step 1: Request for Housing: HR triggers request based on approved relocation or project deployment
Responsible (R): HR
Accountable (A): Property Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W441_Flow17</bpmn:incoming>
        <bpmn:outgoing>W441_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W441_Task7" name="Lease Identification">
        <bpmn:documentation>Step 2: Lease Identification: Property Admin sources local apartment/house; verifies safety/proximity to store
Responsible (R): Property Admin
Accountable (A): Property Mgr
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W441_Flow18</bpmn:incoming>
        <bpmn:outgoing>W441_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W441_Task8" name="Contracting">
        <bpmn:documentation>Step 3: Contracting: System generates Lease Agreement; Finance processes security deposit and advance rent
Responsible (R): Property Admin
Accountable (A): Property Mgr
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W441_Flow19</bpmn:incoming>
        <bpmn:outgoing>W441_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W441_Task9" name="Inventory/Turnover">
        <bpmn:documentation>Step 4: Inventory/Turnover: Admin performs move-in inspection; documents condition and provided furniture/appliances
Responsible (R): Property Admin
Accountable (A): Property Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W441_Flow20</bpmn:incoming>
        <bpmn:outgoing>W441_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W441_Task10" name="Utility Management">
        <bpmn:documentation>Step 5: Utility Management: Admin sets up accounts (Water, Electricity, Internet); sets up recurring payment in ERP
Responsible (R): Property Admin
Accountable (A): Finance
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W441_Flow21</bpmn:incoming>
        <bpmn:outgoing>W441_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W441_Task11" name="Occupancy Tracking">
        <bpmn:documentation>Step 6: Occupancy Tracking: HR updates &quot;Billeting Log&quot; with staff names and expected duration
Responsible (R): HR
Accountable (A): Property Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W441_Flow22</bpmn:incoming>
        <bpmn:outgoing>W441_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W441_Task12" name="Maintenance">
        <bpmn:documentation>Step 7: Maintenance: Occupant submits maintenance request (W47); Admin coordinates with landlord/contractor
Responsible (R): Occupant / Admin
Accountable (A): Property Manager
Duration: Varies</bpmn:documentation>
        <bpmn:incoming>W441_Flow23</bpmn:incoming>
        <bpmn:outgoing>W441_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W441_Task13" name="Closure/Move-out">
        <bpmn:documentation>Step 8: Closure/Move-out: Admin performs move-out inspection; calculates utility prorations; Finance processes deposit recovery
Responsible (R): Property Admin
Accountable (A): Property Mgr
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W441_Flow24</bpmn:incoming>
        <bpmn:outgoing>W441_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W441_End14" name="Complete">
        <bpmn:incoming>W441_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W441_Annotation15">
        <bpmn:text>Controls: - CTL-301 (ensure controlled execution — Site Selection &amp; Lease Management (PA-20.1).) | - operational: Property Manager review and approval gate
Owner: Property Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W441_Assoc16" sourceRef="W441_Annotation15" targetRef="W441_Start5" associationDirection="None" />
