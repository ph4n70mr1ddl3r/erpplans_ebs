    <bpmn:process id="W_W430" name="W430. LGU Business Permit &amp; &quot;Amillaramiento&quot; (RPT) On-Site Inspection" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled or surprise inspection by LGU (Bureau of Fire Protection, Sanitary, Building Official)
Frequency: Annual (for renewal) or ad-hoc
Volume: 200 stores × ~3–4 inspection types/year = ~600–800 inspections
Owner: Store Manager
Participants: Store Admin, Facilities Coordinator, LGU Inspector, Regional Manager
Source: workflow W430 — LGU Business Permit &amp; &quot;Amillaramiento&quot; (RPT) On-Site Inspection</bpmn:documentation>
      <bpmn:laneSet id="W430_LaneSet3">
        <bpmn:lane id="W430_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W430_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W430_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W430_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W430_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W430_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W430_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W430_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W430_Lane2" name="Store Admin">
        <bpmn:flowNodeRef>W430_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W430_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W430_Start4" name="Scheduled or surprise inspection by LGU (Bureau of Fire Protection, Sanitary, Building…">
        <bpmn:outgoing>W430_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W430_Task5" name="Inspector Arrival">
        <bpmn:documentation>Step 1: Inspector Arrival: LGU inspector arrives at the store; Store Manager verifies inspector credentials (Mission Order) and registers them in the Compliance Log
Responsible (R): Store Manager
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W430_Flow15</bpmn:incoming>
        <bpmn:outgoing>W430_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W430_Task6" name="On-Site Walkthrough">
        <bpmn:documentation>Step 2: On-Site Walkthrough: Store Manager and Store Admin accompany the inspector through the premises: (a) fire exits, (b) extinguisher pressure/maintenance, (c) sanitary conditions in restrooms/canteen, (d) structural safety of lumber yard racks
Responsible (R): Store Manager
Accountable (A): Regional Mgr
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W430_Flow16</bpmn:incoming>
        <bpmn:outgoing>W430_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W430_Task7" name="Inspection Report">
        <bpmn:documentation>Step 3: Inspection Report: Inspector issues an &quot;After Mission Report&quot; or &quot;Notice of Inspection&quot;; Store Manager scans and uploads the document to the Compliance Portal
Responsible (R): Store Manager
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W430_Flow17</bpmn:incoming>
        <bpmn:outgoing>W430_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W430_Task8" name="Notice of Violation (NOV) Intake">
        <bpmn:documentation>Step 4: Notice of Violation (NOV) Intake: If violations are found (e.g., blocked fire exit, expired extinguisher), the inspector issues an NOV with a 5-to-15 day correction period
Responsible (R): Store Manager
Accountable (A): Regional Mgr
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W430_Flow18</bpmn:incoming>
        <bpmn:outgoing>W430_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W430_Task9" name="Correction Action">
        <bpmn:documentation>Step 5: Correction Action: Store Manager triggers an &quot;Emergency Work Order&quot; (W47) to fix the violation; Facilities Coordinator manages the contractor/maintenance team
Responsible (R): Store Manager / Facilities
Accountable (A): VP Store Operations
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W430_Flow19</bpmn:incoming>
        <bpmn:outgoing>W430_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W430_Task10" name="Re-Inspection &amp; Clearing">
        <bpmn:documentation>Step 6: Re-Inspection &amp; Clearing: Store Manager notifies LGU of correction; inspector returns for re-inspection; Store Manager receives the &quot;Cleared&quot; status and pays any required fines
Responsible (R): Store Manager
Accountable (A): Finance Mgr
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W430_Flow20</bpmn:incoming>
        <bpmn:outgoing>W430_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W430_Task11" name="Permit Renewal Linkage">
        <bpmn:documentation>Step 7: Permit Renewal Linkage: Cleared inspection reports are attached to the &quot;LGU Permit Renewal&quot; workflow (W54) to ensure the Mayor&#x27;s Permit can be renewed the following year
Responsible (R): Store Admin
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W430_Flow21</bpmn:incoming>
        <bpmn:outgoing>W430_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W430_End12" name="Complete">
        <bpmn:incoming>W430_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W430_Annotation13">
        <bpmn:text>Controls: - CTL-218 (ensure facility compliance &amp; lease-cost integrity.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W430_Assoc14" sourceRef="W430_Annotation13" targetRef="W430_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W430_Flow15" sourceRef="W430_Start4" targetRef="W430_Task5" />
      <bpmn:sequenceFlow id="W430_Flow16" sourceRef="W430_Task5" targetRef="W430_Task6" />
      <bpmn:sequenceFlow id="W430_Flow17" sourceRef="W430_Task6" targetRef="W430_Task7" />
      <bpmn:sequenceFlow id="W430_Flow18" sourceRef="W430_Task7" targetRef="W430_Task8" />
      <bpmn:sequenceFlow id="W430_Flow19" sourceRef="W430_Task8" targetRef="W430_Task9" />
      <bpmn:sequenceFlow id="W430_Flow20" sourceRef="W430_Task9" targetRef="W430_Task10" />
      <bpmn:sequenceFlow id="W430_Flow21" sourceRef="W430_Task10" targetRef="W430_Task11" />
      <bpmn:sequenceFlow id="W430_Flow22" sourceRef="W430_Task11" targetRef="W430_End12" />
    </bpmn:process>
