        <bpmn:outgoing>W119_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W119_Task6" name="Consolidate list of owned properties and current tax declarations">
        <bpmn:documentation>Step 1: Consolidate list of owned properties and current tax declarations
Responsible (R): Lease Admin
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W119_Flow15</bpmn:incoming>
        <bpmn:outgoing>W119_Flow16</bpmn:outgoing>
      </bpmn:userTask>
