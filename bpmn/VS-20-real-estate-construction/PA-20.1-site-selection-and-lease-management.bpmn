        <bpmndi:BPMNEdge id="W1445_Flow20_di" bpmnElement="W1445_Flow20"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1445_Flow21_di" bpmnElement="W1445_Flow21"><di:waypoint x="1420" y="505" /><di:waypoint x="1450" y="675" /></bpmndi:BPMNEdge>
