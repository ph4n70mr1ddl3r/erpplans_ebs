      <bpmn:startEvent id="W117_Start7" name="Signed lease or upcoming expiry (12–18 months prior)">
        <bpmn:outgoing>W117_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W117_Task8" name="Input new lease into ERP: terms, escalations (e.g., 5% every 2 years), grace…">
        <bpmn:documentation>Step 1: Input new lease into ERP: terms, escalations (e.g., 5% every 2 years), grace periods
Responsible (R): Lease Admin
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W117_Flow17</bpmn:incoming>
        <bpmn:outgoing>W117_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W117_Task9" name="System flags upcoming expiry (T-minus 18 months)">
        <bpmn:documentation>Step 2: System flags upcoming expiry (T-minus 18 months)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W117_Flow18</bpmn:incoming>
        <bpmn:outgoing>W117_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W117_Task10" name="Evaluate store performance and strategic value of location">
        <bpmn:documentation>Step 3: Evaluate store performance and strategic value of location
Responsible (R): Store Ops / Finance
Accountable (A): COO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W117_Flow19</bpmn:incoming>
        <bpmn:outgoing>W117_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W117_Task11" name="Negotiate renewal terms with lessor">
        <bpmn:documentation>Step 4: Negotiate renewal terms with lessor
Responsible (R): Director, Facilities &amp; Real Estate
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W117_Flow20</bpmn:incoming>
        <bpmn:outgoing>W117_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W117_Task12" name="Legal review of renewal addendum">
        <bpmn:documentation>Step 5: Legal review of renewal addendum
Responsible (R): Legal Counsel
Accountable (A): VP Legal
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W117_Flow21</bpmn:incoming>
        <bpmn:outgoing>W117_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W117_Task13" name="Update ERP with new lease end date and revised escalation schedule">
        <bpmn:documentation>Step 6: Update ERP with new lease end date and revised escalation schedule
Responsible (R): Lease Admin
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W117_Flow22</bpmn:incoming>
        <bpmn:outgoing>W117_Flow23</bpmn:outgoing>
      </bpmn:userTask>
