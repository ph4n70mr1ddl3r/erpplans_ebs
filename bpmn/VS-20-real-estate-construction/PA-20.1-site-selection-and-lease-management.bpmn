    <bpmn:process id="W_W117" name="W117. Lease Administration &amp; Renewal" isExecutable="false">
      <bpmn:documentation>Trigger: Signed lease or upcoming expiry (12–18 months prior)
Frequency: Managed per contract; ~200+ active leases
Volume: ~20–30 renewals/year
Owner: Lease Administrator
Participants: Director, Facilities &amp; Real Estate, Legal, Finance
Source: workflow W117 — Lease Administration &amp; Renewal</bpmn:documentation>
      <bpmn:laneSet id="W117_LaneSet6">
        <bpmn:lane id="W117_Lane1" name="Lease Admin">
        <bpmn:flowNodeRef>W117_Task8</bpmn:flowNodeRef>
