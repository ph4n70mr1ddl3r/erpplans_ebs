        <bpmndi:BPMNShape id="W808_Start5_di" bpmnElement="W808_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W808_End12_di" bpmnElement="W808_End12"><dc:Bounds x="1680" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W808_Annotation13_di" bpmnElement="W808_Annotation13"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W808_Flow15_di" bpmnElement="W808_Flow15"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W808_Flow16_di" bpmnElement="W808_Flow16"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W808_Flow17_di" bpmnElement="W808_Flow17"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W808_Flow18_di" bpmnElement="W808_Flow18"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W808_Flow19_di" bpmnElement="W808_Flow19"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W808_Flow20_di" bpmnElement="W808_Flow20"><di:waypoint x="1420" y="165" /><di:waypoint x="1450" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W808_Flow21_di" bpmnElement="W808_Flow21"><di:waypoint x="1630" y="335" /><di:waypoint x="1680" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W808_Assoc14_di" bpmnElement="W808_Assoc14"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1403" name="W1403. Store-Level Material Handling Equipment Inspection, Preventive Maintenance &amp; Operator Safety Certification" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly inspection calendar; or post-incident equipment check; or new equipment commissioning
Frequency: Monthly visual inspection per store; quarterly preventive maintenance per equipment; annual certification of operators
Volume: ~200 stores × ~3–5 material handling equipment (MHE) units per store (typically 2–3 pallet jacks, 1 hand truck/dolly, 1 manual stacker or small forklift for receiving area) = ~600–1,000 MHE units chain-wide
Owner: Store Manager
Participants: Store Manager, Receiving Clerk, Facilities Coordinator (HQ), MHE Service Vendor, DOLE Compliance Officer
Source: workflow W1403 — Store-Level Material Handling Equipment Inspection, Preventive Maintenance &amp; Operator Safety Certification</bpmn:documentation>
      <bpmn:laneSet id="W1403_LaneSet6">
        <bpmn:lane id="W1403_Lane1" name="Facilities Coordinator">
        <bpmn:flowNodeRef>W1403_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1403_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1403_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1403_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1403_Lane2" name="Receiving Clerk">
        <bpmn:flowNodeRef>W1403_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1403_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1403_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W1403_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1403_Lane4" name="MHE Service Vendor">
        <bpmn:flowNodeRef>W1403_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1403_Lane5" name="System">
        <bpmn:flowNodeRef>W1403_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1403_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1403_Start7" name="Monthly inspection calendar; or post-incident equipment check; or new equipment…">
        <bpmn:outgoing>W1403_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1403_Task8" name="System maintains MHE registry per store: equipment ID, type (pallet jack, hand…">
        <bpmn:documentation>Step 1: System maintains MHE registry per store: equipment ID, type (pallet jack, hand truck, manual stacker, forklift), manufacturer, model, serial number, purchase date, warranty expiry, last inspection date, next PM due date; Facilities Coordinator creates record upon equipment purchase or store opening (W16)
Responsible (R): Facilities Coordinator / System
Accountable (A): —
Duration: 10 min/unit</bpmn:documentation>
        <bpmn:incoming>W1403_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1403_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1403_Task9" name="Pallet jacks">
        <bpmn:documentation>Step 2: Monthly: Receiving Clerk performs visual inspection of each MHE unit per standardized checklist: (a) Pallet jacks — hydraulic fluid level, wheel condition (no flat spots or bearing noise), handle operation (smooth up/down), fork tips (not bent), load capacity label legible; (b) Hand trucks/dollies — wheel condition, frame integrity (no cracks or bends), tire inflation (if pneumatic); (c) Manual stackers/small forklifts — hydraulic system (no leaks), mast operation (smooth raise/lower), forks (straight, no cracks), battery charge level and electrolyte (if electric), safety warning devices (horn, beacon) functional
Responsible (R): Receiving Clerk
Accountable (A): Store Manager
Duration: 15 min/unit</bpmn:documentation>
        <bpmn:incoming>W1403_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1403_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1403_Task10" name="Receiving Clerk enters inspection results into system: Pass / Needs Attention /…">
        <bpmn:documentation>Step 3: Receiving Clerk enters inspection results into system: Pass / Needs Attention / Unsafe — Do Not Use; if &quot;Unsafe&quot;: equipment immediately tagged out with red &quot;DO NOT USE&quot; tag, removed from service area, and reported to Store Manager
Responsible (R): Receiving Clerk
Accountable (A): Store Manager
Duration: 5 min/unit</bpmn:documentation>
        <bpmn:incoming>W1403_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1403_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1403_Task11" name="Store Manager reviews inspection results; for &quot;Needs Attention&quot; items…">
        <bpmn:documentation>Step 4: Store Manager reviews inspection results; for &quot;Needs Attention&quot; items: schedules repair with MHE service vendor or internal maintenance; for &quot;Unsafe&quot; items: initiates emergency repair or replacement; system tracks open repair work orders per store
Responsible (R): Store Manager
Accountable (A): Facilities Coordinator
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W1403_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1403_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1403_Task12" name="Quarterly: external MHE service vendor performs preventive maintenance per…">
        <bpmn:documentation>Step 5: Quarterly: external MHE service vendor performs preventive maintenance per equipment: lubrication of moving parts, hydraulic system check and fluid top-up, wheel bearing inspection and replacement if needed, battery load test (electric equipment), structural weld inspection, safety device testing; vendor provides PM service report uploaded to equipment master
Responsible (R): MHE Service Vendor / Facilities Coordinator
Accountable (A): Store Manager
Duration: 1–2 hours/store</bpmn:documentation>
        <bpmn:incoming>W1403_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1403_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1403_Task13" name="Annual: Facilities Coordinator coordinates operator safety certification…">
        <bpmn:documentation>Step 6: Annual: Facilities Coordinator coordinates operator safety certification training for all Receiving Clerks and Stock Associates who operate MHE; training covers proper lifting techniques, equipment pre-use inspection, load capacity limits, pedestrian safety, and emergency procedures; DOLE-compliant training certificate issued per employee; certification recorded in employee training log (W51)
Responsible (R): Facilities Coordinator / HR Training Coordinator
Accountable (A): Store Manager
Duration: 4 hours/person</bpmn:documentation>
        <bpmn:incoming>W1403_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1403_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1403_Task14" name="System alerts Facilities Coordinator when equipment approaches end of useful…">
        <bpmn:documentation>Step 7: System alerts Facilities Coordinator when equipment approaches end of useful life (based on age, repair frequency, and PM cost history); Facilities Coordinator evaluates repair vs. replacement and submits capex request (W21) if replacement warranted
Responsible (R): System / Facilities Coordinator
Accountable (A): VP Store Operations
Duration: Automated alert</bpmn:documentation>
        <bpmn:incoming>W1403_Flow25</bpmn:incoming>
        <bpmn:outgoing>W1403_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1403_Task15" name="Monthly: Facilities Coordinator generates chain-wide MHE health dashboard: %…">
        <bpmn:documentation>Step 8: Monthly: Facilities Coordinator generates chain-wide MHE health dashboard: % pass rate by store, open repair work orders, average equipment age, upcoming PM schedules, overdue inspections; escalates stores with persistent equipment issues to VP Store Operations
Responsible (R): Facilities Coordinator
Accountable (A): VP Store Operations
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W1403_Flow26</bpmn:incoming>
        <bpmn:outgoing>W1403_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1403_End16" name="Complete">
        <bpmn:incoming>W1403_Flow27</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1403_Annotation17">
        <bpmn:text>Controls: - CTL-303 (ensure controlled execution — Facility Maintenance &amp; Equipment (PA-20.3).) | - operational: Store Manager review and approval gate
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1403_Assoc18" sourceRef="W1403_Annotation17" targetRef="W1403_Start7" associationDirection="None" />
