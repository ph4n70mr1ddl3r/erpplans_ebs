    <bpmn:process id="W_W242" name="W242. 3PL &amp; Logistics Partner Performance Review" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly review calendar
Frequency: Quarterly
Volume: ~5–10 key logistics partners
Owner: Fleet Manager
Participants: DC Dispatch, Customer Experience, Finance
Source: workflow W242 — 3PL &amp; Logistics Partner Performance Review</bpmn:documentation>
      <bpmn:laneSet id="W242_LaneSet4">
        <bpmn:lane id="W242_Lane1" name="System">
        <bpmn:flowNodeRef>W242_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W242_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W242_Lane2" name="CX Manager">
        <bpmn:flowNodeRef>W242_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W242_Lane3" name="Fleet Manager">
        <bpmn:flowNodeRef>W242_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W242_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W242_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W242_Start5" name="Quarterly review calendar">
        <bpmn:outgoing>W242_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W242_Task6" name="KPI Aggregation">
        <bpmn:documentation>Step 1: KPI Aggregation: Compile On-Time Delivery (OTD), Damage Rate, and Billing Accuracy for the 3PL
Responsible (R): System
Accountable (A): Fleet Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W242_Flow13</bpmn:incoming>
        <bpmn:outgoing>W242_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W242_Task7" name="CX Feedback">
        <bpmn:documentation>Step 2: CX Feedback: Review customer complaints/satisfaction related to 3PL deliveries (W41)
Responsible (R): CX Manager
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W242_Flow14</bpmn:incoming>
        <bpmn:outgoing>W242_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W242_Task8" name="Review Meeting">
        <bpmn:documentation>Step 3: Review Meeting: Present findings to 3PL executives; identify improvement areas
Responsible (R): Fleet Manager
Accountable (A): VP Supply Chain
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W242_Flow15</bpmn:incoming>
        <bpmn:outgoing>W242_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W242_Task9" name="Rate Review">
        <bpmn:documentation>Step 4: Rate Review: Compare 3PL performance vs. contract rates; initiate re-negotiation if needed
Responsible (R): Fleet Manager
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W242_Flow16</bpmn:incoming>
        <bpmn:outgoing>W242_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W242_End10" name="Complete">
        <bpmn:incoming>W242_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W242_Annotation11">
        <bpmn:text>Controls: - CTL-303 (ensure controlled execution — Facility Maintenance &amp; Equipment (PA-20.3).) | - operational: Fleet Manager review and approval gate
Owner: Fleet Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W242_Assoc12" sourceRef="W242_Annotation11" targetRef="W242_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W242_Flow13" sourceRef="W242_Start5" targetRef="W242_Task6" />
      <bpmn:sequenceFlow id="W242_Flow14" sourceRef="W242_Task6" targetRef="W242_Task7" />
      <bpmn:sequenceFlow id="W242_Flow15" sourceRef="W242_Task7" targetRef="W242_Task8" />
      <bpmn:sequenceFlow id="W242_Flow16" sourceRef="W242_Task8" targetRef="W242_Task9" />
      <bpmn:sequenceFlow id="W242_Flow17" sourceRef="W242_Task9" targetRef="W242_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W242_diag">
