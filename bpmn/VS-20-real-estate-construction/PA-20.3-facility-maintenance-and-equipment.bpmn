    <bpmn:process id="W_W243" name="W243. Power of Attorney (POA) &amp; Board Resolution Lifecycle" isExecutable="false">
      <bpmn:documentation>Trigger: Need for specific authorization (Bank, Government, Contracts)
Frequency: Ad-hoc; ~10–20 per month
Volume: ~10–20 POAs and Board Resolutions per month
Owner: Corporate Secretary
Participants: Board of Directors, Legal, Authorized Signatories
Source: workflow W243 — Power of Attorney (POA) &amp; Board Resolution Lifecycle</bpmn:documentation>
      <bpmn:laneSet id="W243_LaneSet4">
        <bpmn:lane id="W243_Lane1" name="Dept Head">
        <bpmn:flowNodeRef>W243_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W243_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W243_Lane2" name="Corp Sec">
        <bpmn:flowNodeRef>W243_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W243_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W243_Lane3" name="Legal Assistant">
        <bpmn:flowNodeRef>W243_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W243_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W243_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W243_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W243_Start5" name="Need for specific authorization (Bank, Government, Contracts)">
        <bpmn:outgoing>W243_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W243_Task6" name="Request">
        <bpmn:documentation>Step 1: Request: Dept Head requests specific authority (e.g., to sign LTO documents or open bank account)
Responsible (R): Dept Head
Accountable (A): Legal Counsel
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W243_Flow15</bpmn:incoming>
        <bpmn:outgoing>W243_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W243_Task7" name="Drafting">
        <bpmn:documentation>Step 2: Drafting: Corp Sec drafts Board Resolution or Secretary&#x27;s Certificate
Responsible (R): Corp Sec
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W243_Flow16</bpmn:incoming>
        <bpmn:outgoing>W243_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W243_Task8" name="Approval">
        <bpmn:documentation>Step 3: Approval: Circulate to Board for signature (Digital or Physical)
Responsible (R): Corp Sec
Accountable (A): Chairman
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W243_Flow17</bpmn:incoming>
        <bpmn:outgoing>W243_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W243_Task9" name="Notarization">
        <bpmn:documentation>Step 4: Notarization: Obtain notarization (Mandatory for PH legal documents)
Responsible (R): Legal Assistant
Accountable (A): —
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W243_Flow18</bpmn:incoming>
        <bpmn:outgoing>W243_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W243_Task10" name="Register">
        <bpmn:documentation>Step 5: Register: Upload scanned copy to &quot;Authority Matrix&quot; / POA Register; issue to requestor
Responsible (R): Legal Assistant
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W243_Flow19</bpmn:incoming>
        <bpmn:outgoing>W243_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W243_Task11" name="Expiry Tracking">
        <bpmn:documentation>Step 6: Expiry Tracking: Monitor expiry of specific POAs; trigger renewal 30 days before
Responsible (R): Legal Assistant
Accountable (A): —
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W243_Flow20</bpmn:incoming>
        <bpmn:outgoing>W243_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W243_End12" name="Complete">
        <bpmn:incoming>W243_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W243_Annotation13">
        <bpmn:text>Controls: - CTL-303 (ensure controlled execution — Facility Maintenance &amp; Equipment (PA-20.3).) | - operational: Corporate Secretary review and approval gate
Owner: Corporate Secretary</bpmn:text>
      </bpmn:textAnnotation>
