    <bpmn:process id="W_W241" name="W241. HQ Office Facility &amp; Executive Asset Maintenance" isExecutable="false">
      <bpmn:documentation>Trigger: Employee request; or scheduled lease/utility review
Frequency: Ongoing
Volume: ~200 requests/month
Owner: HQ Facilities Manager
Participants: Office Admin, IT, Vendors
Source: workflow W241 — HQ Office Facility &amp; Executive Asset Maintenance</bpmn:documentation>
      <bpmn:laneSet id="W241_LaneSet5">
        <bpmn:lane id="W241_Lane1" name="Employee">
        <bpmn:flowNodeRef>W241_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W241_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W241_Lane2" name="Office Admin">
        <bpmn:flowNodeRef>W241_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W241_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W241_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W241_Lane3" name="Facilities Mgr">
        <bpmn:flowNodeRef>W241_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W241_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W241_Lane4" name="Vendor">
        <bpmn:flowNodeRef>W241_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W241_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W241_Start6" name="Employee request; or scheduled lease/utility review">
        <bpmn:outgoing>W241_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W241_Task7" name="Request Intake">
        <bpmn:documentation>Step 1: Request Intake: Employee submits HQ facility request (AC cooling, lighting, furniture) via service portal
Responsible (R): Employee
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W241_Flow17</bpmn:incoming>
        <bpmn:outgoing>W241_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W241_Task8" name="Priority Triage">
        <bpmn:documentation>Step 2: Priority Triage: Categorize request by urgency — Critical (safety/HVAC failure), High (executive boardroom), Normal (routine), Low (aesthetic)
Responsible (R): Office Admin
Accountable (A): Facilities Mgr
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W241_Flow18</bpmn:incoming>
        <bpmn:outgoing>W241_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W241_Task9" name="Vendor Dispatch">
        <bpmn:documentation>Step 3: Vendor Dispatch: For complex repairs (elevator, centralized AC, electrical), dispatch contracted vendor with SLA commitment
Responsible (R): Facilities Mgr
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W241_Flow19</bpmn:incoming>
        <bpmn:outgoing>W241_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W241_Task10" name="Execution &amp; Verification">
        <bpmn:documentation>Step 4: Execution &amp; Verification: Vendor or in-house team completes repair; requestor confirms resolution
Responsible (R): Vendor / Office Admin
Accountable (A): Facilities Mgr
Duration: 1-4 hours</bpmn:documentation>
        <bpmn:incoming>W241_Flow20</bpmn:incoming>
        <bpmn:outgoing>W241_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W241_Task11" name="SLA Tracking &amp; Escalation">
        <bpmn:documentation>Step 5: SLA Tracking &amp; Escalation: Monitor resolution against SLA targets; escalate overdue items to COO if Critical/High exceeds 24 hours
Responsible (R): Facilities Mgr
Accountable (A): COO
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W241_Flow21</bpmn:incoming>
        <bpmn:outgoing>W241_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W241_Task12" name="Budget Coding">
        <bpmn:documentation>Step 6: Budget Coding: Assign completed work order cost to requesting department&#x27;s cost center; reconcile against facilities budget
Responsible (R): Office Admin
Accountable (A): Finance
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W241_Flow22</bpmn:incoming>
        <bpmn:outgoing>W241_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W241_Task13" name="Asset Tracking &amp; Quarterly Deep-Clean">
        <bpmn:documentation>Step 7: Asset Tracking &amp; Quarterly Deep-Clean: Maintain register of HQ-specific assets (Boardroom AV, Gym equipment, Executive vehicles); schedule quarterly deep-clean/sanitization of pantry, restrooms, and boardrooms
Responsible (R): Office Admin
Accountable (A): Facilities Mgr
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W241_Flow23</bpmn:incoming>
        <bpmn:outgoing>W241_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W241_End14" name="Complete">
        <bpmn:incoming>W241_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W241_Annotation15">
        <bpmn:text>Controls: - CTL-303 (ensure controlled execution — Facility Maintenance &amp; Equipment (PA-20.3).) | - operational: periodic reconciliation against source documents
Owner: HQ Facilities Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W241_Assoc16" sourceRef="W241_Annotation15" targetRef="W241_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W241_Flow17" sourceRef="W241_Start6" targetRef="W241_Task7" />
      <bpmn:sequenceFlow id="W241_Flow18" sourceRef="W241_Task7" targetRef="W241_Task8" />
      <bpmn:sequenceFlow id="W241_Flow19" sourceRef="W241_Task8" targetRef="W241_Task9" />
      <bpmn:sequenceFlow id="W241_Flow20" sourceRef="W241_Task9" targetRef="W241_Task10" />
      <bpmn:sequenceFlow id="W241_Flow21" sourceRef="W241_Task10" targetRef="W241_Task11" />
      <bpmn:sequenceFlow id="W241_Flow22" sourceRef="W241_Task11" targetRef="W241_Task12" />
      <bpmn:sequenceFlow id="W241_Flow23" sourceRef="W241_Task12" targetRef="W241_Task13" />
      <bpmn:sequenceFlow id="W241_Flow24" sourceRef="W241_Task13" targetRef="W241_End14" />
    </bpmn:process>
