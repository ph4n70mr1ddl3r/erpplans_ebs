      <bpmn:sequenceFlow id="W700_Flow17" sourceRef="W700_Task7" targetRef="W700_Task8" />
      <bpmn:sequenceFlow id="W700_Flow18" sourceRef="W700_Task8" targetRef="W700_Task9" />
      <bpmn:sequenceFlow id="W700_Flow19" sourceRef="W700_Task9" targetRef="W700_Task10" />
      <bpmn:sequenceFlow id="W700_Flow20" sourceRef="W700_Task10" targetRef="W700_Task11" />
      <bpmn:sequenceFlow id="W700_Flow21" sourceRef="W700_Task11" targetRef="W700_End12" />
    </bpmn:process>
