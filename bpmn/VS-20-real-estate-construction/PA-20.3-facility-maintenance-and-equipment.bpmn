    <bpmn:process id="W_W240" name="W240. DC Facility &amp; Warehouse Equipment Maintenance" isExecutable="false">
      <bpmn:documentation>Trigger: Odometer/Hour-meter reading (Forklifts); or scheduled facility audit
Frequency: Weekly/Monthly/Quarterly
Volume: ~4 DCs, ~20 PM events/month
Owner: DC Maintenance Supervisor
Participants: DC Staff, External Technicians
Source: workflow W240 — DC Facility &amp; Warehouse Equipment Maintenance</bpmn:documentation>
      <bpmn:laneSet id="W240_LaneSet4">
        <bpmn:lane id="W240_Lane1" name="Maint Supervisor">
        <bpmn:flowNodeRef>W240_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W240_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W240_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W240_Lane2" name="Technician">
        <bpmn:flowNodeRef>W240_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W240_Lane3" name="Ext Auditor">
        <bpmn:flowNodeRef>W240_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W240_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W240_Start5" name="Odometer/Hour-meter reading (Forklifts); or scheduled facility audit">
        <bpmn:outgoing>W240_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W240_Task6" name="Inspection">
        <bpmn:documentation>Step 1: Inspection: Weekly walk-through of DC (Racking, Lighting, Flooring, Fire Sprinklers)
Responsible (R): Maint Supervisor
Accountable (A): —
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W240_Flow13</bpmn:incoming>
        <bpmn:outgoing>W240_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W240_Task7" name="Equipment PM">
        <bpmn:documentation>Step 2: Equipment PM: Preventive Maintenance (PM) for Forklifts, Conveyors, and Dock Levelers
Responsible (R): Technician
Accountable (A): Maint Supervisor
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W240_Flow14</bpmn:incoming>
        <bpmn:outgoing>W240_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W240_Task8" name="Racking Audit">
        <bpmn:documentation>Step 3: Racking Audit: Annual structural audit of pallet racking (Philippine Seismic Code compliance)
Responsible (R): Ext Auditor
Accountable (A): DC Manager
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W240_Flow15</bpmn:incoming>
        <bpmn:outgoing>W240_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W240_Task9" name="Work Order">
        <bpmn:documentation>Step 4: Work Order: Create repairs in W47 system for any failures
Responsible (R): Maint Supervisor
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W240_Flow16</bpmn:incoming>
        <bpmn:outgoing>W240_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W240_End10" name="Complete">
        <bpmn:incoming>W240_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W240_Annotation11">
        <bpmn:text>Controls: - CTL-218 (ensure facility compliance &amp; lease-cost integrity.) | - operational: standard operating procedures; system-enforced validation rules
Owner: DC Maintenance Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W240_Assoc12" sourceRef="W240_Annotation11" targetRef="W240_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W240_Flow13" sourceRef="W240_Start5" targetRef="W240_Task6" />
      <bpmn:sequenceFlow id="W240_Flow14" sourceRef="W240_Task6" targetRef="W240_Task7" />
      <bpmn:sequenceFlow id="W240_Flow15" sourceRef="W240_Task7" targetRef="W240_Task8" />
      <bpmn:sequenceFlow id="W240_Flow16" sourceRef="W240_Task8" targetRef="W240_Task9" />
      <bpmn:sequenceFlow id="W240_Flow17" sourceRef="W240_Task9" targetRef="W240_End10" />
    </bpmn:process>
