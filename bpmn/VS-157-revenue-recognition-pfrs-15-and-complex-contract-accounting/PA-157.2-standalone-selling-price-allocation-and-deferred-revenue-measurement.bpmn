        <bpmndi:BPMNShape id="W4634_Start3_di" bpmnElement="W4634_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4634_End7_di" bpmnElement="W4634_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4634_Annotation8_di" bpmnElement="W4634_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4634_Flow10_di" bpmnElement="W4634_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4634_Flow11_di" bpmnElement="W4634_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4634_Flow12_di" bpmnElement="W4634_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4634_Flow13_di" bpmnElement="W4634_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4634_Assoc9_di" bpmnElement="W4634_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4635" name="W4635. Gift-Card Breakage Estimation, Recognition &amp; Remote-Redemption Testing" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly gift-card liability review (VS-54); annual breakage recalc
Frequency: Monthly + annual comprehensive
Volume: Outstanding gift-card liability (VS-54 W28); ~ gift cards sold/redeemed monthly
Owner: Revenue Accounting Manager
Participants: Gift-card ops (VS-54), Analytics (VS-28), Controller, External Auditor
Source: workflow W4635 — Gift-Card Breakage Estimation, Recognition &amp; Remote-Redemption Testing</bpmn:documentation>
      <bpmn:laneSet id="W4635_LaneSet2">
        <bpmn:lane id="W4635_Lane1" name="Revenue Accounting">
        <bpmn:flowNodeRef>W4635_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4635_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4635_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4635_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4635_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4635_Start3" name="Monthly gift-card liability review (VS-54); annual breakage recalc">
        <bpmn:outgoing>W4635_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4635_Task4" name="Compute the historical redemption pattern (aging of unredeemed balances…">
        <bpmn:documentation>Step 1: Compute the historical redemption pattern (aging of unredeemed balances, redemption curve) from gift-card transaction history; estimate the breakage rate (portion expected never to be redeemed)
Responsible (R): Revenue Accounting / Analytics
Accountable (A): Controller
Duration: Annual + quarterly</bpmn:documentation>
        <bpmn:incoming>W4635_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4635_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4635_Task5" name="Recognize breakage revenue ONLY when the likelihood of redemption becomes…">
        <bpmn:documentation>Step 2: Recognize breakage revenue ONLY when the likelihood of redemption becomes remote (per PFRS 15 ¶B43) — proportionally based on the redemption pattern, not on a fixed time; document the remote-redemption determination
Responsible (R): Revenue Accounting
Accountable (A): Controller / CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4635_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4635_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4635_Task6" name="Reconcile the gift-card liability GL (W28) to the gift-card outstanding-balance…">
        <bpmn:documentation>Step 3: Reconcile the gift-card liability GL (W28) to the gift-card outstanding-balance feed; post breakage revenue journal during month-end close (W9A); re-assess the estimate with full-year data at year-end
Responsible (R): Revenue Accounting
Accountable (A): Controller
Duration: Monthly + annual</bpmn:documentation>
        <bpmn:incoming>W4635_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4635_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4635_End7" name="Complete">
        <bpmn:incoming>W4635_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4635_Annotation8">
        <bpmn:text>Controls: - CTL-702 (ensure controlled execution — Standalone Selling Price, Allocation &amp; Deferred-Revenue Measurement (PA-157.2).) | - CTL-702: breakage recognized only at remote-redemption (proportionate); methodology auditor-reviewed; liability GL reconciled monthly
Owner: Revenue Accounting Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4635_Assoc9" sourceRef="W4635_Annotation8" targetRef="W4635_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4635_Flow10" sourceRef="W4635_Start3" targetRef="W4635_Task4" />
      <bpmn:sequenceFlow id="W4635_Flow11" sourceRef="W4635_Task4" targetRef="W4635_Task5" />
      <bpmn:sequenceFlow id="W4635_Flow12" sourceRef="W4635_Task5" targetRef="W4635_Task6" />
      <bpmn:sequenceFlow id="W4635_Flow13" sourceRef="W4635_Task6" targetRef="W4635_End7" />
    </bpmn:process>
