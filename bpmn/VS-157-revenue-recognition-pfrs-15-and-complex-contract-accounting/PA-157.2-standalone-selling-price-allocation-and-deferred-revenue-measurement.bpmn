        <bpmn:flowNodeRef>W4637_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4637_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4637_Start3" name="Subscription/warranty sale (VS-47/VS-53); monthly amortization cycle">
        <bpmn:outgoing>W4637_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4637_Task4" name="For subscription services (VS-47) and extended warranties (VS-53), recognize…">
        <bpmn:documentation>Step 1: For subscription services (VS-47) and extended warranties (VS-53), recognize revenue over the coverage/service period (straight-line unless usage-based is more faithful); defer the full consideration at sale
Responsible (R): Revenue Accounting
Accountable (A): Controller
Duration: Per sale + monthly</bpmn:documentation>
        <bpmn:incoming>W4637_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4637_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4637_Task5" name="Run the monthly deferred-revenue amortization schedule (per contract, by…">
        <bpmn:documentation>Step 2: Run the monthly deferred-revenue amortization schedule (per contract, by period); post the amortization journal during close (W9A); handle renewals, cancellations, and refunds as estimate updates (W4638)
Responsible (R): Revenue Accounting
Accountable (A): Controller
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4637_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4637_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4637_Task6" name="Reconcile the subscription/warranty deferred-revenue GL to the active-contract…">
        <bpmn:documentation>Step 3: Reconcile the subscription/warranty deferred-revenue GL to the active-contract schedule; investigate contracts with no amortization or abnormal patterns
Responsible (R): Revenue Accounting
Accountable (A): Controller
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4637_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4637_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4637_End7" name="Complete">
        <bpmn:incoming>W4637_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4637_Annotation8">
        <bpmn:text>Controls: - CTL-702 (ensure controlled execution — Standalone Selling Price, Allocation &amp; Deferred-Revenue Measurement (PA-157.2).) | - CTL-702: revenue deferred and amortized over the coverage period; schedule reconciled to GL monthly; cancellations routed to estimate-update
Owner: Revenue Accounting Manager</bpmn:text>
      </bpmn:textAnnotation>
