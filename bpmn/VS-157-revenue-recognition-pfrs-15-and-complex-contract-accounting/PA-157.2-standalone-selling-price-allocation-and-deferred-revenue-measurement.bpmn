      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4634" name="W4634. Transaction-Price Allocation Across Performance Obligations" isExecutable="false">
      <bpmn:documentation>Trigger: Each multi-element sale (bundle/kit, product+install, product+warranty+points); SSP refresh
Frequency: Per transaction (system) + periodic review
Volume: Every bundle/kit sale (VS-92); every product+installation sale (VS-12); points earned on every POS sale
Owner: Revenue Accounting Manager
Participants: Merchandising (VS-92), Services (VS-12), IT (VS-27/VS-113), Controller
Source: workflow W4634 — Transaction-Price Allocation Across Performance Obligations</bpmn:documentation>
      <bpmn:laneSet id="W4634_LaneSet2">
        <bpmn:lane id="W4634_Lane1" name="Revenue Accounting">
        <bpmn:flowNodeRef>W4634_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4634_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4634_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4634_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4634_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4634_Start3" name="Each multi-element sale (bundle/kit, product+install, product+warranty+points); SSP…">
        <bpmn:outgoing>W4634_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4634_Task4" name="Configure the allocation engine: distribute the transaction price across each…">
        <bpmn:documentation>Step 1: Configure the allocation engine: distribute the transaction price across each performance obligation based on relative SSP (W4633); apply any allocation-specific discount to the obligations to which it relates
Responsible (R): Revenue Accounting / IT
Accountable (A): Controller / CIO
Duration: Per setup</bpmn:documentation>
        <bpmn:incoming>W4634_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4634_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4634_Task5" name="Validate allocation on sample transactions (bundle, product+install…">
        <bpmn:documentation>Step 2: Validate allocation on sample transactions (bundle, product+install, product+warranty+points) — confirm the sum of allocations equals transaction price and each obligation&#x27;s allocation is within SSP range; investigate out-of-range allocations
Responsible (R): Revenue Accounting / Analytics
Accountable (A): Controller
Duration: Quarterly sample</bpmn:documentation>
        <bpmn:incoming>W4634_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4634_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4634_Task6" name="Post each allocation to the correct revenue/deferred-revenue GL by obligation…">
        <bpmn:documentation>Step 3: Post each allocation to the correct revenue/deferred-revenue GL by obligation and period; route exceptions (manual override, non-standard contract) to Revenue Accounting review
Responsible (R): Revenue Accounting / IT
Accountable (A): Controller
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4634_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4634_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4634_End7" name="Complete">
        <bpmn:incoming>W4634_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4634_Annotation8">
        <bpmn:text>Controls: - CTL-702 (ensure controlled execution — Standalone Selling Price, Allocation &amp; Deferred-Revenue Measurement (PA-157.2).) | - CTL-702: allocation engine Controller-approved; sample-tested quarterly; SSP within range; exceptions reviewed
Owner: Revenue Accounting Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4634_Assoc9" sourceRef="W4634_Annotation8" targetRef="W4634_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4634_Flow10" sourceRef="W4634_Start3" targetRef="W4634_Task4" />
      <bpmn:sequenceFlow id="W4634_Flow11" sourceRef="W4634_Task4" targetRef="W4634_Task5" />
      <bpmn:sequenceFlow id="W4634_Flow12" sourceRef="W4634_Task5" targetRef="W4634_Task6" />
      <bpmn:sequenceFlow id="W4634_Flow13" sourceRef="W4634_Task6" targetRef="W4634_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4634_diag">
      <bpmndi:BPMNPlane id="W4634_plane" bpmnElement="W_W4634">
        <bpmndi:BPMNShape id="W4634_Lane1_di" bpmnElement="W4634_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
