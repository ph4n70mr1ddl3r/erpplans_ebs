        <bpmndi:BPMNShape id="W4635_Task6_di" bpmnElement="W4635_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4635_Start3_di" bpmnElement="W4635_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4635_End7_di" bpmnElement="W4635_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4635_Annotation8_di" bpmnElement="W4635_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4635_Flow10_di" bpmnElement="W4635_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4635_Flow11_di" bpmnElement="W4635_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4635_Flow12_di" bpmnElement="W4635_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4635_Flow13_di" bpmnElement="W4635_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4635_Assoc9_di" bpmnElement="W4635_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4636" name="W4636. Loyalty-Points Liability Measurement, Fair-Value &amp; Forfeiture Adjustment" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly points-accounting cycle; redemption-rate drift
Frequency: Quarterly estimate + monthly release
Volume: Points earned on 2.8M monthly POS transactions (600K members); points liability GL
Owner: Revenue Accounting Manager
Participants: Loyalty (VS-13), Analytics (VS-28), Actuarial support, Controller, External Auditor
Source: workflow W4636 — Loyalty-Points Liability Measurement, Fair-Value &amp; Forfeiture Adjustment</bpmn:documentation>
      <bpmn:laneSet id="W4636_LaneSet2">
        <bpmn:lane id="W4636_Lane1" name="Revenue Accounting">
        <bpmn:flowNodeRef>W4636_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4636_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4636_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4636_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4636_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4636_Start3" name="Quarterly points-accounting cycle; redemption-rate drift">
        <bpmn:outgoing>W4636_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4636_Task4" name="Determine the per-point fair value (standalone selling price of points) and the…">
        <bpmn:documentation>Step 1: Determine the per-point fair value (standalone selling price of points) and the redemption-rate/forfeiture estimate; refresh quarterly using actual redemption behavior and tier mix
Responsible (R): Revenue Accounting / Analytics
Accountable (A): Controller / CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4636_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4636_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4636_Task5" name="Recognize deferred revenue to revenue as points are redeemed; for points…">
        <bpmn:documentation>Step 2: Recognize deferred revenue to revenue as points are redeemed; for points expected to forfeit, recognize the breakage-style portion when redemption is remote (mirroring W4635); true-up cumulative catch-up each period
Responsible (R): Revenue Accounting
Accountable (A): Controller
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4636_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4636_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4636_Task6" name="Reconcile the points-deferred-revenue GL to the loyalty-engine liability…">
        <bpmn:documentation>Step 3: Reconcile the points-deferred-revenue GL to the loyalty-engine liability (W104/W17) monthly; investigate redemption-rate drift &gt; threshold and re-estimate
Responsible (R): Revenue Accounting / Loyalty ops
Accountable (A): Controller
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4636_Flow12</bpmn:incoming>
