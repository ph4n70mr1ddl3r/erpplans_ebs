    <bpmn:process id="W_W1642" name="W1642. Returned Product Liquidation &amp; Channel Management" isExecutable="false">
      <bpmn:documentation>Trigger: Accumulated returned/dispositioned inventory designated for liquidation
Frequency: Monthly liquidation cycle
Volume: ~500–1,000 items/month across all locations
Owner: Category Manager
Participants: Category Manager, Marketing, Store Operations, DC Returns Coordinator
Source: workflow W1642 — Returned Product Liquidation &amp; Channel Management</bpmn:documentation>
      <bpmn:laneSet id="W1642_LaneSet3">
        <bpmn:lane id="W1642_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W1642_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1642_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1642_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1642_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1642_Lane2" name="System">
        <bpmn:flowNodeRef>W1642_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1642_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1642_Start4" name="Accumulated returned/dispositioned inventory designated for liquidation">
        <bpmn:outgoing>W1642_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1642_Task5" name="Category Manager reviews liquidation-eligible inventory monthly: (a) returned…">
        <bpmn:documentation>Step 1: Category Manager reviews liquidation-eligible inventory monthly: (a) returned items not resaleable at full price, (b) refurbished items (W1640), (c) damaged packaging items, (d) end-of-season clearance items
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1642_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1642_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1642_Task6" name="In-store clearance section">
        <bpmn:documentation>Step 2: Category Manager assigns liquidation channel: (a) In-store clearance section — dedicated markdown area per store; priced at 30–50% discount, (b) Ecommerce clearance — online &quot;Deals&quot; section with clearance pricing, (c) Bulk liquidation to jobbers — sell in bulk to discount retailers or scrap buyers at 10–20% of cost, (d) Employee sale — periodic employee-only clearance events at deep discount, (e) Donation — functional items donated to community organizations (BuildRight CSR program)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1642_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1642_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1642_Task7" name="System updates pricing for liquidation channel; inventory moved to clearance…">
        <bpmn:documentation>Step 3: System updates pricing for liquidation channel; inventory moved to clearance SKU or liquidation batch; markdown recorded in GL (inventory write-down + markdown expense)
Responsible (R): System
Accountable (A): Controller
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1642_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1642_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1642_Task8" name="Track liquidation sell-through: weekly monitoring of clearance inventory…">
        <bpmn:documentation>Step 4: Track liquidation sell-through: weekly monitoring of clearance inventory velocity; remaining items after 60 days moved to next liquidation tier (deeper discount or bulk sale)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 30 min/week</bpmn:documentation>
        <bpmn:incoming>W1642_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1642_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1642_End9" name="Complete">
        <bpmn:incoming>W1642_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1642_Annotation10">
        <bpmn:text>Controls: - CTL-339 (ensure controlled execution — Reverse Logistics &amp; Disposition (PA-32.3).) | - operational: Category Manager review and approval gate
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1642_Assoc11" sourceRef="W1642_Annotation10" targetRef="W1642_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1642_Flow12" sourceRef="W1642_Start4" targetRef="W1642_Task5" />
      <bpmn:sequenceFlow id="W1642_Flow13" sourceRef="W1642_Task5" targetRef="W1642_Task6" />
