<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-32.3-reverse-logistics-disposition" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1638" name="W1638. Store-to-DC Reverse Logistics Consolidation Program, In-Transit Tracking &amp; DC Hand-Off" isExecutable="false">
      <bpmn:documentation>Trigger: Accumulated returns at store level reach consolidation threshold (~20 items or the bi-weekly cycle)
Frequency: Bi-weekly per store, aligned to the canonical store-side consolidation cycle (W176); ~400 reverse-logistics shipments/month across 200 stores
Volume: ~2 shipments/store/month
Owner: Store Manager
Participants: Store Manager, Stock Associate, DC Returns Coordinator, Logistics Coordinator
Source: workflow W1638 — Store-to-DC Reverse Logistics Consolidation Program, In-Transit Tracking &amp; DC Hand-Off</bpmn:documentation>
      <bpmn:laneSet id="W1638_LaneSet5">
        <bpmn:lane id="W1638_Lane1" name="Stock Associate">
        <bpmn:flowNodeRef>W1638_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1638_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1638_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1638_Lane2" name="Driver">
        <bpmn:flowNodeRef>W1638_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1638_Lane3" name="DC Receiving Clerk">
        <bpmn:flowNodeRef>W1638_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1638_Lane4" name="System">
        <bpmn:flowNodeRef>W1638_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1638_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1638_Start6" name="Accumulated returns at store level reach consolidation threshold (~20 items or the…">
        <bpmn:outgoing>W1638_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1638_Task7" name="Bi-weekly (per the Frequency, aligned to W176): Stock Associate consolidates…">
        <bpmn:documentation>Step 1: Bi-weekly (per the Frequency, aligned to W176): Stock Associate consolidates items in store returns staging area: (a) groups by disposition type (RTV, quality hold, damaged/defective, recall), (b) groups RTV items by vendor, (c) packs items securely with packing slip listing each item, disposition type, and original transaction reference
Responsible (R): Stock Associate
Accountable (A): Store Manager
Duration: ~2 hours/event</bpmn:documentation>
        <bpmn:incoming>W1638_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1638_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1638_Task8" name="Store Manager or Stock Associate creates reverse shipment in system: (a)…">
        <bpmn:documentation>Step 2: Store Manager or Stock Associate creates reverse shipment in system: (a) selects items from returns staging inventory, (b) system generates reverse shipping order with destination DC, (c) assigns to scheduled outbound delivery truck (driver picks up returns during regular DC-to-store delivery — backhaul optimization)
Responsible (R): Stock Associate
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1638_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1638_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1638_Task9" name="Driver picks up consolidated returns from store during scheduled delivery run…">
        <bpmn:documentation>Step 3: Driver picks up consolidated returns from store during scheduled delivery run; signs for returned items; items enter in-transit reverse logistics tracking
Responsible (R): Driver
Accountable (A): Logistics Coordinator
Duration: 10 min/store</bpmn:documentation>
        <bpmn:incoming>W1638_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1638_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1638_Task10" name="DC Receiving Clerk receives reverse shipment: (a) scans shipment barcode, (b)…">
        <bpmn:documentation>Step 4: DC Receiving Clerk receives reverse shipment: (a) scans shipment barcode, (b) verifies items against packing slip, (c) routes items to DC returns processing area per disposition type
Responsible (R): DC Receiving Clerk
Accountable (A): DC Returns Coordinator
Duration: 20 min/shipment</bpmn:documentation>
        <bpmn:incoming>W1638_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1638_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1638_Task11" name="System updates inventory location from store to DC; updates reverse logistics…">
        <bpmn:documentation>Step 5: System updates inventory location from store to DC; updates reverse logistics in-transit status; items remain in their disposition status (RTV, damaged, recall, etc.)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1638_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1638_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1638_End12" name="Complete">
        <bpmn:incoming>W1638_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1638_Annotation13">
        <bpmn:text>Controls: - CTL-339 (ensure controlled execution — Reverse Logistics &amp; Disposition (PA-32.3).) | - operational: standard operating procedures; system-enforced validation rules | ---
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1638_Assoc14" sourceRef="W1638_Annotation13" targetRef="W1638_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1638_Flow15" sourceRef="W1638_Start6" targetRef="W1638_Task7" />
      <bpmn:sequenceFlow id="W1638_Flow16" sourceRef="W1638_Task7" targetRef="W1638_Task8" />
      <bpmn:sequenceFlow id="W1638_Flow17" sourceRef="W1638_Task8" targetRef="W1638_Task9" />
      <bpmn:sequenceFlow id="W1638_Flow18" sourceRef="W1638_Task9" targetRef="W1638_Task10" />
      <bpmn:sequenceFlow id="W1638_Flow19" sourceRef="W1638_Task10" targetRef="W1638_Task11" />
      <bpmn:sequenceFlow id="W1638_Flow20" sourceRef="W1638_Task11" targetRef="W1638_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1638_diag">
      <bpmndi:BPMNPlane id="W1638_plane" bpmnElement="W_W1638">
        <bpmndi:BPMNShape id="W1638_Lane1_di" bpmnElement="W1638_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
