        <bpmndi:BPMNEdge id="W1638_Flow20_di" bpmnElement="W1638_Flow20"><di:waypoint x="1420" y="675" /><di:waypoint x="1470" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1638_Assoc14_di" bpmnElement="W1638_Assoc14"><di:waypoint x="340" y="800" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1639" name="W1639. Returns Processing Center Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Reverse logistics shipments received at DC returns processing area
Frequency: ~800 reverse shipments/month across 4 DCs (~200/DC)
Volume: ~50 shipments/DC/week
Owner: DC Returns Coordinator
Participants: DC Returns Coordinator, DC Quality Inspector, DC Supervisor
Source: workflow W1639 — Returns Processing Center Operations</bpmn:documentation>
      <bpmn:laneSet id="W1639_LaneSet3">
        <bpmn:lane id="W1639_Lane1" name="DC Returns Coordinator">
        <bpmn:flowNodeRef>W1639_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1639_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1639_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1639_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1639_Lane2" name="DC Quality Inspector">
        <bpmn:flowNodeRef>W1639_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1639_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1639_Start4" name="Reverse logistics shipments received at DC returns processing area">
        <bpmn:outgoing>W1639_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1639_Task5" name="DC Returns Coordinator receives reverse shipments; sorts by disposition type…">
        <bpmn:documentation>Step 1: DC Returns Coordinator receives reverse shipments; sorts by disposition type: (a) RTV — route to vendor return staging per W1631, (b) Quality Hold — route to quality inspection per W1603, (c) Damaged/Defective — route to damage disposition per W91, (d) Recall — route to recall staging per W1616, (e) Resaleable — route to restock (putaway per W18)
Responsible (R): DC Returns Coordinator
Accountable (A): DC Supervisor
Duration: 20 min/shipment</bpmn:documentation>
        <bpmn:incoming>W1639_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1639_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1639_Task6" name="For items requiring further assessment: DC Quality Inspector performs secondary…">
        <bpmn:documentation>Step 2: For items requiring further assessment: DC Quality Inspector performs secondary quality check; determines final disposition per W1626
Responsible (R): DC Quality Inspector
Accountable (A): DC Returns Coordinator
Duration: 10 min/item</bpmn:documentation>
        <bpmn:incoming>W1639_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1639_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1639_Task7" name="DC Returns Coordinator updates system with final disposition for each item…">
        <bpmn:documentation>Step 3: DC Returns Coordinator updates system with final disposition for each item; inventory moved from &quot;Returns Processing&quot; to final status
Responsible (R): DC Returns Coordinator
Accountable (A): DC Supervisor
Duration: 5 min/item</bpmn:documentation>
        <bpmn:incoming>W1639_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1639_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1639_Task8" name="Weekly: DC Returns Coordinator generates returns processing summary: (a) items…">
        <bpmn:documentation>Step 4: Weekly: DC Returns Coordinator generates returns processing summary: (a) items received, processed, and dispositioned by type, (b) processing cycle time (receipt to final disposition), (c) backlog items (&gt; 5 days unprocessed), (d) DC Supervisor reviews backlog and allocates resources
Responsible (R): DC Returns Coordinator
Accountable (A): DC Supervisor
Duration: 1 hour/week</bpmn:documentation>
        <bpmn:incoming>W1639_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1639_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1639_End9" name="Complete">
        <bpmn:incoming>W1639_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1639_Annotation10">
        <bpmn:text>Controls: - CTL-339 (ensure controlled execution — Reverse Logistics &amp; Disposition (PA-32.3).) | - operational: DC Returns Coordinator review and approval gate
Owner: DC Returns Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1639_Assoc11" sourceRef="W1639_Annotation10" targetRef="W1639_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1639_Flow12" sourceRef="W1639_Start4" targetRef="W1639_Task5" />
      <bpmn:sequenceFlow id="W1639_Flow13" sourceRef="W1639_Task5" targetRef="W1639_Task6" />
      <bpmn:sequenceFlow id="W1639_Flow14" sourceRef="W1639_Task6" targetRef="W1639_Task7" />
      <bpmn:sequenceFlow id="W1639_Flow15" sourceRef="W1639_Task7" targetRef="W1639_Task8" />
      <bpmn:sequenceFlow id="W1639_Flow16" sourceRef="W1639_Task8" targetRef="W1639_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1639_diag">
      <bpmndi:BPMNPlane id="W1639_plane" bpmnElement="W_W1639">
        <bpmndi:BPMNShape id="W1639_Lane1_di" bpmnElement="W1639_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1639_Lane2_di" bpmnElement="W1639_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1639_Task5_di" bpmnElement="W1639_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1639_Task6_di" bpmnElement="W1639_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1639_Task7_di" bpmnElement="W1639_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1639_Task8_di" bpmnElement="W1639_Task8"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1639_Start4_di" bpmnElement="W1639_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1639_End9_di" bpmnElement="W1639_End9"><dc:Bounds x="1260" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1639_Annotation10_di" bpmnElement="W1639_Annotation10"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1639_Flow12_di" bpmnElement="W1639_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1639_Flow13_di" bpmnElement="W1639_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1639_Flow14_di" bpmnElement="W1639_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1639_Flow15_di" bpmnElement="W1639_Flow15"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1639_Flow16_di" bpmnElement="W1639_Flow16"><di:waypoint x="1210" y="165" /><di:waypoint x="1260" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1639_Assoc11_di" bpmnElement="W1639_Assoc11"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1640" name="W1640. Refurbishment &amp; Repackaging Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Returned item assessed as &quot;Refurbishable&quot; during quality assessment (W1626 or W1639)
Frequency: ~180–300 items/month eligible for refurbishment (the damaged-packaging-functional share of the ~1,200/month returns canon, assessed at DC quality check)
Volume: ~45–75 per DC/month (180–300 ÷ 4 DCs)
Owner: DC Returns Coordinator
Participants: DC Returns Coordinator, DC Quality Inspector, Category Manager (pricing)
Source: workflow W1640 — Refurbishment &amp; Repackaging Operations</bpmn:documentation>
      <bpmn:laneSet id="W1640_LaneSet4">
        <bpmn:lane id="W1640_Lane1" name="DC Quality Inspector">
        <bpmn:flowNodeRef>W1640_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1640_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1640_Lane2" name="DC Returns Coordinator">
        <bpmn:flowNodeRef>W1640_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1640_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1640_Lane3" name="System">
        <bpmn:flowNodeRef>W1640_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1640_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1640_Start5" name="Returned item assessed as &quot;Refurbishable&quot; during quality assessment (W1626 or W1639)">
        <bpmn:outgoing>W1640_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1640_Task6" name="DC Quality Inspector identifies refurbishable items: (a) item is functional but…">
        <bpmn:documentation>Step 1: DC Quality Inspector identifies refurbishable items: (a) item is functional but packaging damaged, (b) item has minor cosmetic imperfection that doesn&#x27;t affect functionality, (c) item is missing minor accessories that can be replaced (screws, manual), (d) item needs cleaning or re-boxing
Responsible (R): DC Quality Inspector
Accountable (A): DC Returns Coordinator
Duration: 5 min/item</bpmn:documentation>
        <bpmn:incoming>W1640_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1640_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1640_Task7" name="DC Returns Coordinator performs refurbishment: (a) repack in new box or rewrap…">
        <bpmn:documentation>Step 2: DC Returns Coordinator performs refurbishment: (a) repack in new box or rewrap, (b) replace missing accessories from spare parts inventory, (c) clean and polish, (d) apply &quot;Refurbished&quot; or &quot;Open Box&quot; label per Category Manager pricing policy
Responsible (R): DC Returns Coordinator
Accountable (A): DC Supervisor
Duration: 15 min/item</bpmn:documentation>
        <bpmn:incoming>W1640_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1640_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1640_Task8" name="System creates refurbishment record: (a) original item linked to refurbished…">
        <bpmn:documentation>Step 3: System creates refurbishment record: (a) original item linked to refurbished item, (b) refurbished item priced at discount (typically 10–20% below retail), (c) sold through specific channels: in-store clearance section, ecommerce &quot;Open Box&quot; category, or designated outlet store
Responsible (R): System / Category Manager
Accountable (A): VP Merchandising
Duration: 5 min/item</bpmn:documentation>
        <bpmn:incoming>W1640_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1640_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1640_Task9" name="Monthly: DC Returns Coordinator reports refurbishment metrics: (a) items…">
        <bpmn:documentation>Step 4: Monthly: DC Returns Coordinator reports refurbishment metrics: (a) items refurbished vs. scrapped, (b) recovery value (refurbished sale price minus refurbishment cost), (c) recovery rate as % of original product cost
Responsible (R): DC Returns Coordinator
Accountable (A): VP Supply Chain
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W1640_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1640_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1640_End10" name="Complete">
        <bpmn:incoming>W1640_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1640_Annotation11">
        <bpmn:text>Controls: - CTL-339 (ensure controlled execution — Reverse Logistics &amp; Disposition (PA-32.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: DC Returns Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1640_Assoc12" sourceRef="W1640_Annotation11" targetRef="W1640_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1640_Flow13" sourceRef="W1640_Start5" targetRef="W1640_Task6" />
      <bpmn:sequenceFlow id="W1640_Flow14" sourceRef="W1640_Task6" targetRef="W1640_Task7" />
      <bpmn:sequenceFlow id="W1640_Flow15" sourceRef="W1640_Task7" targetRef="W1640_Task8" />
      <bpmn:sequenceFlow id="W1640_Flow16" sourceRef="W1640_Task8" targetRef="W1640_Task9" />
