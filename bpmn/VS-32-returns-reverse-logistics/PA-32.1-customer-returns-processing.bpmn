<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-32.1-customer-returns-processing" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1622" name="W1622. In-Store Customer Return Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer brings purchased item(s) to customer service counter for return
Frequency: ~56,000 returns/month across 200 stores (~2% return rate on 2.8M transactions)
Volume: ~280 returns/store/month (~9/day); seasonal spikes post-promotion
Owner: Customer Service Rep
Participants: CSR, Customer Service Manager, Store Manager (overrides)
Source: workflow W1622 — In-Store Customer Return Processing</bpmn:documentation>
      <bpmn:laneSet id="W1622_LaneSet3">
        <bpmn:lane id="W1622_Lane1" name="CSR">
        <bpmn:flowNodeRef>W1622_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1622_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1622_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1622_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1622_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1622_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1622_Lane2" name="System">
        <bpmn:flowNodeRef>W1622_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1622_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1622_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1622_Start4" name="Customer brings purchased item(s) to customer service counter for return">
        <bpmn:outgoing>W1622_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1622_Task5" name="Customer presents item(s) and receipt (or loyalty card/transaction reference)…">
        <bpmn:documentation>Step 1: Customer presents item(s) and receipt (or loyalty card/transaction reference) at customer service counter; CSR scans receipt barcode or looks up transaction by date/loyalty card/amount
Responsible (R): CSR
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W1622_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1622_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1622_Task6" name="System retrieves original transaction: (a) verifies item was purchased at this…">
        <bpmn:documentation>Step 2: System retrieves original transaction: (a) verifies item was purchased at this store (or BuildRight network — cross-store returns accepted), (b) checks return eligibility: (i) within 30-day return window (standard items), (ii) 7-day return window for appliances and power tools, (iii) non-returnable items: paint (custom mixed), cut-to-length items (wire, lumber, pipe), clearance/final sale items, (c) checks item has not been previously returned for same transaction
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1622_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1622_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1622_Task7" name="CSR inspects returned item: (a) matches item to receipt line (SKU…">
        <bpmn:documentation>Step 3: CSR inspects returned item: (a) matches item to receipt line (SKU, description), (b) checks condition: unused, original packaging, all accessories included, (c) checks for damage (if damaged: route to W1626 for quality assessment), (d) for electrical items: verifies safety seals intact, (e) for power tools: checks for signs of use (bit wear, scratches on chuck)
Responsible (R): CSR
Accountable (A): Customer Service Manager
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W1622_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1622_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1622_Task8" name="Accept">
        <bpmn:documentation>Step 4: Accept: CSR processes return in system: (a) scans item barcode, (b) selects return reason code (14 codes: unwanted, wrong size, found cheaper, defective, damaged in transit, wrong item, missing parts, not as described, quality issue, duplicate purchase, gift return, installation incompatibility, buyer&#x27;s remorse, other), (c) system creates return receipt with authorization number
Responsible (R): CSR
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W1622_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1622_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1622_Task9" name="Refund method selection (per BuildRight policy): (a) original tender refund —…">
        <bpmn:documentation>Step 5: Refund method selection (per BuildRight policy): (a) original tender refund — cash for cash purchase, card refund for card purchase, (b) store credit (gift card) for returns &gt; 30 days or without receipt (per W1625), (c) exchange for different item (per W1624)
Responsible (R): CSR
Accountable (A): Customer Service Manager
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W1622_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1622_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1622_Task10" name="System processes: (a) inventory added back to store available stock (if…">
        <bpmn:documentation>Step 6: System processes: (a) inventory added back to store available stock (if resaleable condition — &quot;Return to Stock&quot; status), or moved to &quot;Damaged/Defective&quot; status (per W91), or moved to &quot;Quarantine&quot; for quality review (per W1626), (b) refund/payment reversal processed, (c) return transaction posted to GL (contra-revenue, inventory adjustment), (d) loyalty points reversed if points were earned on original purchase
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1622_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1622_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1622_Task11" name="Customer signs return receipt (digital signature pad or paper); CSR returns…">
        <bpmn:documentation>Step 7: Customer signs return receipt (digital signature pad or paper); CSR returns item to designated returns staging area; resaleable items returned to shelf within 2 hours by Stock Associate
Responsible (R): CSR / Stock Associate
Accountable (A): Customer Service Manager
Duration: 2 min + restock time</bpmn:documentation>
        <bpmn:incoming>W1622_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1622_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1622_End12" name="Complete">
        <bpmn:incoming>W1622_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1622_Annotation13">
        <bpmn:text>Controls: - CTL-179 (ensure returns integrity &amp; refund-fraud prevention.) | - operational: Customer Service Rep review and approval gate
Owner: Customer Service Rep</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1622_Assoc14" sourceRef="W1622_Annotation13" targetRef="W1622_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1622_Flow15" sourceRef="W1622_Start4" targetRef="W1622_Task5" />
      <bpmn:sequenceFlow id="W1622_Flow16" sourceRef="W1622_Task5" targetRef="W1622_Task6" />
      <bpmn:sequenceFlow id="W1622_Flow17" sourceRef="W1622_Task6" targetRef="W1622_Task7" />
      <bpmn:sequenceFlow id="W1622_Flow18" sourceRef="W1622_Task7" targetRef="W1622_Task8" />
      <bpmn:sequenceFlow id="W1622_Flow19" sourceRef="W1622_Task8" targetRef="W1622_Task9" />
      <bpmn:sequenceFlow id="W1622_Flow20" sourceRef="W1622_Task9" targetRef="W1622_Task10" />
      <bpmn:sequenceFlow id="W1622_Flow21" sourceRef="W1622_Task10" targetRef="W1622_Task11" />
      <bpmn:sequenceFlow id="W1622_Flow22" sourceRef="W1622_Task11" targetRef="W1622_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1622_diag">
      <bpmndi:BPMNPlane id="W1622_plane" bpmnElement="W_W1622">
