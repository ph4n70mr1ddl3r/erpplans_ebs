    <bpmn:process id="W_W1625" name="W1625. Customer Return Without Receipt Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer presents item for return without receipt or proof of purchase
Frequency: ~8,000–10,000 no-receipt returns/month (~15–18% of all returns)
Volume: ~45–50 per store/month
Owner: Customer Service Manager
Participants: Customer Service Manager, Store Manager (authorization)
Source: workflow W1625 — Customer Return Without Receipt Processing</bpmn:documentation>
      <bpmn:laneSet id="W1625_LaneSet3">
        <bpmn:lane id="W1625_Lane1" name="CSR">
        <bpmn:flowNodeRef>W1625_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1625_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1625_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1625_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1625_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1625_Lane2" name="System">
        <bpmn:flowNodeRef>W1625_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1625_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1625_Start4" name="Customer presents item for return without receipt or proof of purchase">
        <bpmn:outgoing>W1625_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1625_Task5" name="CSR attempts to locate transaction: (a) scan loyalty card if customer is a…">
        <bpmn:documentation>Step 1: CSR attempts to locate transaction: (a) scan loyalty card if customer is a member, (b) search by customer name/phone in system, (c) search by credit/debit card last 4 digits, (d) search by transaction date and amount estimate
Responsible (R): CSR
Accountable (A): Customer Service Manager
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W1625_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1625_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1625_Task6" name="If transaction found: process as standard return per W1622">
        <bpmn:documentation>Step 2: If transaction found: process as standard return per W1622
Responsible (R): CSR
Accountable (A): —
Duration: Per W1622</bpmn:documentation>
        <bpmn:incoming>W1625_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1625_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1625_Task7" name="If transaction not found: CSR processes no-receipt return: (a) verify item is a…">
        <bpmn:documentation>Step 3: If transaction not found: CSR processes no-receipt return: (a) verify item is a BuildRight-carried SKU (system lookup), (b) check item condition (unused, original packaging), (c) system applies no-receipt return policy: (i) refund limited to current selling price or lowest price in last 90 days (whichever is lower) to prevent fraud, (ii) refund issued as store credit only (no cash/card refund), (iii) customer must present valid government ID (recorded in system for fraud tracking), (iv) limit: max 3 no-receipt returns per customer per 6-month period
Responsible (R): CSR
Accountable (A): Customer Service Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1625_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1625_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1625_Task8" name="System records no-receipt return against customer ID (government ID number)…">
        <bpmn:documentation>Step 4: System records no-receipt return against customer ID (government ID number); updates no-receipt return counter; blocks further no-receipt returns if limit exceeded
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1625_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1625_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1625_Task9" name="Store credit (gift card) issued for refund amount; customer can use immediately">
        <bpmn:documentation>Step 5: Store credit (gift card) issued for refund amount; customer can use immediately
Responsible (R): CSR
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W1625_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1625_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1625_End10" name="Complete">
        <bpmn:incoming>W1625_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1625_Annotation11">
        <bpmn:text>Controls: - CTL-179 (ensure returns integrity &amp; refund-fraud prevention.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Customer Service Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1625_Assoc12" sourceRef="W1625_Annotation11" targetRef="W1625_Start4" associationDirection="None" />
