        <bpmndi:BPMNEdge id="W1622_Flow17_di" bpmnElement="W1622_Flow17"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1622_Flow18_di" bpmnElement="W1622_Flow18"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
