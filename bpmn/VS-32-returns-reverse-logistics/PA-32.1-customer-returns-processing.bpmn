    <bpmn:process id="W_W1630" name="W1630. Customer Warranty Claim Processing &amp; Vendor Claim Initiation" isExecutable="false">
      <bpmn:documentation>Trigger: Customer reports product failure within warranty period; or warranty claim registered at POS per POS-019
Frequency: ~2,000–3,000 warranty claims/month
Volume: ~10–15 per store/month; highest for power tools and appliances
Owner: Customer Service Manager
Participants: CSR, Customer Service Manager, Department Supervisor, Buyer, vendor service center
Source: workflow W1630 — Customer Warranty Claim Processing &amp; Vendor Claim Initiation</bpmn:documentation>
      <bpmn:laneSet id="W1630_LaneSet4">
        <bpmn:lane id="W1630_Lane1" name="CSR">
        <bpmn:flowNodeRef>W1630_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1630_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1630_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1630_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1630_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1630_Lane2" name="Buyer">
        <bpmn:flowNodeRef>W1630_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1630_Lane3" name="Customer Service Manager">
        <bpmn:flowNodeRef>W1630_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1630_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1630_Start5" name="Customer reports product failure within warranty period; or warranty claim registered at…">
        <bpmn:outgoing>W1630_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1630_Task6" name="Customer presents product with warranty claim at customer service counter: (a)…">
        <bpmn:documentation>Step 1: Customer presents product with warranty claim at customer service counter: (a) CSR looks up original purchase transaction (receipt, loyalty card, or transaction number), (b) verifies warranty eligibility: (i) within warranty period (power tools: 6–12 months; appliances: 12–24 months per manufacturer), (ii) warranty covers reported failure type (manufacturing defect; excludes misuse, accidental damage, normal wear), (c) inspects product for misuse indicators (water damage on power tool, impact damage on appliance)
Responsible (R): CSR
Accountable (A): Customer Service Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1630_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1630_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1630_Task7" name="Repair">
        <bpmn:documentation>Step 2: CSR creates warranty claim in system: (a) records product details, failure description, purchase date, warranty period, (b) attaches photos of product and defect, (c) classifies claim type: (i) Repair — product can be repaired at vendor service center, (ii) Replacement — product is beyond repair; vendor provides replacement unit, (iii) Refund — product is discontinued and no replacement available; process refund per W1627
Responsible (R): CSR
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1630_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1630_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1630_Task8" name="Repair path">
        <bpmn:documentation>Step 3: Repair path: (a) system generates shipping label to vendor service center, (b) customer leaves product at store, (c) store consolidates warranty repair shipments weekly (sent to vendor service center), (d) vendor repairs and returns to store, (e) CSR notifies customer to pick up repaired product, (f) SLA: repair turnaround 14–21 business days
Responsible (R): CSR / Buyer
Accountable (A): Customer Service Manager
Duration: 5 min + waiting</bpmn:documentation>
        <bpmn:incoming>W1630_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1630_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1630_Task9" name="Replacement path">
        <bpmn:documentation>Step 4: Replacement path: (a) system checks replacement inventory at store; if available, immediate exchange per W1624, (b) if not available: Buyer contacts vendor for replacement unit; customer offered store credit (per W1627) or wait for replacement, (c) replacement unit received from vendor: CSR notifies customer for pickup
Responsible (R): CSR / Buyer
Accountable (A): Customer Service Manager
Duration: 5 min + waiting</bpmn:documentation>
        <bpmn:incoming>W1630_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1630_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1630_Task10" name="Vendor recovery">
        <bpmn:documentation>Step 5: Vendor recovery: (a) Buyer files warranty claim with vendor for all warranty repairs/replacements, (b) tracks vendor warranty claim status and recovery amount, (c) vendor provides: repair at no cost, replacement unit at no cost, or credit note, (d) unrecovered warranty costs tracked per vendor as quality cost per W1614
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 30 min/week</bpmn:documentation>
        <bpmn:incoming>W1630_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1630_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1630_Task11" name="Monthly: Customer Service Manager generates warranty claim report: (a) claims…">
        <bpmn:documentation>Step 6: Monthly: Customer Service Manager generates warranty claim report: (a) claims by product category and vendor, (b) claim rate as % of sales by SKU, (c) average turnaround time by vendor, (d) customer satisfaction with warranty process, (e) feeds into vendor quality scorecard per W1608
Responsible (R): Customer Service Manager
Accountable (A): VP Store Operations
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1630_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1630_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1630_End12" name="Complete">
        <bpmn:incoming>W1630_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1630_Annotation13">
        <bpmn:text>Controls: - CTL-179 (ensure returns integrity &amp; refund-fraud prevention.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Customer Service Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1630_Assoc14" sourceRef="W1630_Annotation13" targetRef="W1630_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1630_Flow15" sourceRef="W1630_Start5" targetRef="W1630_Task6" />
      <bpmn:sequenceFlow id="W1630_Flow16" sourceRef="W1630_Task6" targetRef="W1630_Task7" />
