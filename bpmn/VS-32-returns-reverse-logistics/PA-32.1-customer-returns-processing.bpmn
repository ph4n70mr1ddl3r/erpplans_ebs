    <bpmn:process id="W_W1623" name="W1623. Ecommerce Customer Return Initiation &amp; Authorization" isExecutable="false">
      <bpmn:documentation>Trigger: Customer initiates return request via buildright.com.ph or mobile app
Frequency: ~4,000–5,000 ecommerce return requests/month (~10–12% ecommerce return rate)
Volume: Variable by category; highest for appliances and power tools
Owner: Customer Service — Ecommerce Returns Specialist
Participants: Customer, Ecommerce Returns Specialist, Store CSR, DC Returns Processing
Source: workflow W1623 — Ecommerce Customer Return Initiation &amp; Authorization</bpmn:documentation>
      <bpmn:laneSet id="W1623_LaneSet5">
        <bpmn:lane id="W1623_Lane1" name="Customer">
        <bpmn:flowNodeRef>W1623_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1623_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1623_Lane2" name="System">
        <bpmn:flowNodeRef>W1623_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1623_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1623_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1623_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1623_Lane3" name="Store CSR">
        <bpmn:flowNodeRef>W1623_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1623_Lane4" name="Courier">
        <bpmn:flowNodeRef>W1623_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1623_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1623_Start6" name="Customer initiates return request via buildright.com.ph or mobile app">
        <bpmn:outgoing>W1623_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1623_Task7" name="Customer logs into ecommerce account, selects order, initiates return: (a)…">
        <bpmn:documentation>Step 1: Customer logs into ecommerce account, selects order, initiates return: (a) selects items to return, (b) selects return reason from dropdown, (c) uploads photos of item condition (required for damaged/defective claims), (d) selects preferred resolution: refund, exchange, or store credit
Responsible (R): Customer
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1623_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1623_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1623_Task8" name="System auto-assesses return eligibility: (a) order within 30-day return window…">
        <bpmn:documentation>Step 2: System auto-assesses return eligibility: (a) order within 30-day return window, (b) item is returnable category, (c) item has not been previously returned, (d) auto-approve for standard returns (unwanted, wrong size); route to Ecommerce Returns Specialist review for: (i) high-value items &gt; PHP 10K, (ii) damaged/defective claims, (iii) return requests &gt; 30 days
Responsible (R): System
Accountable (A): Ecommerce Returns Specialist
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1623_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1623_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1623_Task9" name="Drop-off at any BuildRight store">
        <bpmn:documentation>Step 3: System generates Return Merchandise Authorization (RMA) number; provides customer with return options: (a) Drop-off at any BuildRight store: customer brings item + RMA to customer service counter, (b) Courier pickup: for items &gt; PHP 5K or bulky items; system generates courier pickup scheduling link with partner (Lalamove, Transportify), (c) DC drop-off: not customer-facing; for B2B large orders only
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1623_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1623_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1623_Task10" name="Customer selects return method; system provides return shipping label (for…">
        <bpmn:documentation>Step 4: Customer selects return method; system provides return shipping label (for courier pickup) or QR code for in-store drop-off
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1623_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1623_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1623_Task11" name="For in-store drop-off: Customer brings item to any BuildRight store; Store CSR…">
        <bpmn:documentation>Step 5: For in-store drop-off: Customer brings item to any BuildRight store; Store CSR scans RMA QR code; verifies item matches RMA (SKU, quantity, condition); processes return per W1622 steps 3–7 with RMA reference
Responsible (R): Store CSR
Accountable (A): Customer Service Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1623_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1623_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1623_Task12" name="For courier pickup: Courier collects item from customer; delivers to designated…">
        <bpmn:documentation>Step 6: For courier pickup: Courier collects item from customer; delivers to designated DC returns processing area; DC Returns Processing verifies item against RMA; processes return
Responsible (R): Courier / DC Returns Processing
Accountable (A): Ecommerce Returns Specialist
Duration: Variable</bpmn:documentation>
        <bpmn:incoming>W1623_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1623_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1623_Task13" name="Refund processing: (a) system triggers refund upon return receipt confirmation…">
        <bpmn:documentation>Step 7: Refund processing: (a) system triggers refund upon return receipt confirmation, (b) card refund: 3–5 business days processing, (c) e-wallet refund: 1–2 business days, (d) store credit: immediate, (e) COD refund: bank transfer to customer account within 5 business days
Responsible (R): System / Ecommerce Returns Specialist
Accountable (A): Finance
Duration: 5 min + processing time</bpmn:documentation>
        <bpmn:incoming>W1623_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1623_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1623_End14" name="Complete">
        <bpmn:incoming>W1623_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1623_Annotation15">
        <bpmn:text>Controls: - CTL-337 (ensure controlled execution — Customer Returns Processing (PA-32.1).) | - operational: Customer Service — Ecommerce Returns Specialist review and approval gate
Owner: Customer Service — Ecommerce Returns Specialist</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1623_Assoc16" sourceRef="W1623_Annotation15" targetRef="W1623_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1623_Flow17" sourceRef="W1623_Start6" targetRef="W1623_Task7" />
      <bpmn:sequenceFlow id="W1623_Flow18" sourceRef="W1623_Task7" targetRef="W1623_Task8" />
      <bpmn:sequenceFlow id="W1623_Flow19" sourceRef="W1623_Task8" targetRef="W1623_Task9" />
      <bpmn:sequenceFlow id="W1623_Flow20" sourceRef="W1623_Task9" targetRef="W1623_Task10" />
      <bpmn:sequenceFlow id="W1623_Flow21" sourceRef="W1623_Task10" targetRef="W1623_Task11" />
      <bpmn:sequenceFlow id="W1623_Flow22" sourceRef="W1623_Task11" targetRef="W1623_Task12" />
      <bpmn:sequenceFlow id="W1623_Flow23" sourceRef="W1623_Task12" targetRef="W1623_Task13" />
      <bpmn:sequenceFlow id="W1623_Flow24" sourceRef="W1623_Task13" targetRef="W1623_End14" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1623_diag">
      <bpmndi:BPMNPlane id="W1623_plane" bpmnElement="W_W1623">
        <bpmndi:BPMNShape id="W1623_Lane1_di" bpmnElement="W1623_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1623_Lane2_di" bpmnElement="W1623_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1623_Lane3_di" bpmnElement="W1623_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1623_Lane4_di" bpmnElement="W1623_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1623_Task7_di" bpmnElement="W1623_Task7"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1623_Task8_di" bpmnElement="W1623_Task8"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1623_Task9_di" bpmnElement="W1623_Task9"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1623_Task10_di" bpmnElement="W1623_Task10"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1623_Task11_di" bpmnElement="W1623_Task11"><dc:Bounds x="1240" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1623_Task12_di" bpmnElement="W1623_Task12"><dc:Bounds x="1450" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1623_Task13_di" bpmnElement="W1623_Task13"><dc:Bounds x="1660" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1623_Start6_di" bpmnElement="W1623_Start6"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1623_End14_di" bpmnElement="W1623_End14"><dc:Bounds x="1890" y="657" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1623_Annotation15_di" bpmnElement="W1623_Annotation15"><dc:Bounds x="160" y="800" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1623_Flow17_di" bpmnElement="W1623_Flow17"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1623_Flow18_di" bpmnElement="W1623_Flow18"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1623_Flow19_di" bpmnElement="W1623_Flow19"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
