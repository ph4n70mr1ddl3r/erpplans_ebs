    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1629" name="W1629. B2B Trade Account Return &amp; Credit Note Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Trade or corporate account customer requests return of purchased goods
Frequency: ~500–700 B2B returns/month (~5% of B2B order volume)
Volume: ~100–150 consolidated monthly credit notes (covering the ~500–700 B2B returns/month, one per account per month)
Owner: AR Clerk
Participants: AR Clerk, Customer Service Manager, Sales Manager, Controller
Source: workflow W1629 — B2B Trade Account Return &amp; Credit Note Processing</bpmn:documentation>
      <bpmn:laneSet id="W1629_LaneSet5">
        <bpmn:lane id="W1629_Lane1" name="Sales Manager">
        <bpmn:flowNodeRef>W1629_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1629_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1629_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1629_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1629_Lane2" name="Receiving Clerk">
        <bpmn:flowNodeRef>W1629_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1629_Lane3" name="AR Clerk">
        <bpmn:flowNodeRef>W1629_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1629_Lane4" name="Controller">
        <bpmn:flowNodeRef>W1629_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1629_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1629_Start6" name="Trade or corporate account customer requests return of purchased goods">
        <bpmn:outgoing>W1629_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1629_Task7" name="Trade customer contacts Sales Manager or Customer Service to request return…">
        <bpmn:documentation>Step 1: Trade customer contacts Sales Manager or Customer Service to request return: (a) provides invoice number, item details, quantity, return reason, (b) for defective claims: provides photos and defect description
Responsible (R): Sales Manager / CSR
Accountable (A): Customer Service Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1629_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1629_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1629_Task8" name="Sales Manager reviews return request: (a) validates against original invoice…">
        <bpmn:documentation>Step 2: Sales Manager reviews return request: (a) validates against original invoice (within return window, item match), (b) assesses return reason — defective product, over-ordering, project cancellation, wrong specification, (c) for project accounts: checks if return is partial delivery from larger project order (may indicate project delay rather than product issue)
Responsible (R): Sales Manager
Accountable (A): VP Store Operations
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1629_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1629_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1629_Task9" name="Approve">
        <bpmn:documentation>Step 3: Sales Manager approves or denies return: (a) Approve: creates Return Authorization in system; customer arranges delivery of returned goods to designated store or DC, (b) Deny: provides reason to customer; escalates to VP Store Operations if customer disputes
Responsible (R): Sales Manager
Accountable (A): VP Store Operations
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1629_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1629_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1629_Task10" name="Returned goods received at store or DC: Receiving Clerk verifies against Return…">
        <bpmn:documentation>Step 4: Returned goods received at store or DC: Receiving Clerk verifies against Return Authorization (items, quantities, condition); processes GR for returned items
Responsible (R): Receiving Clerk
Accountable (A): DC Supervisor / Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1629_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1629_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1629_Task11" name="AR Clerk processes credit note: (a) system generates credit note against…">
        <bpmn:documentation>Step 5: AR Clerk processes credit note: (a) system generates credit note against customer account for returned goods value, (b) credit note references original invoice and Return Authorization, (c) credit note reduces AR balance, (d) BIR-compliant credit note generated (per Philippine tax requirements — credit note must reference original invoice number and include VAT adjustment)
Responsible (R): AR Clerk / System
Accountable (A): Controller
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1629_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1629_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1629_Task12" name="Monthly: Controller reviews B2B credit note register — (a) total credit notes…">
        <bpmn:documentation>Step 6: Monthly: Controller reviews B2B credit note register — (a) total credit notes issued, (b) credit note rate as % of B2B revenue, (c) top 10 customers by credit note volume, (d) top 10 items by B2B return frequency
Responsible (R): Controller
Accountable (A): CFO
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W1629_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1629_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1629_End13" name="Complete">
        <bpmn:incoming>W1629_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1629_Annotation14">
        <bpmn:text>Controls: - CTL-337 (ensure controlled execution — Customer Returns Processing (PA-32.1).) | - operational: AR Clerk review and approval gate
Owner: AR Clerk</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1629_Assoc15" sourceRef="W1629_Annotation14" targetRef="W1629_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1629_Flow16" sourceRef="W1629_Start6" targetRef="W1629_Task7" />
      <bpmn:sequenceFlow id="W1629_Flow17" sourceRef="W1629_Task7" targetRef="W1629_Task8" />
      <bpmn:sequenceFlow id="W1629_Flow18" sourceRef="W1629_Task8" targetRef="W1629_Task9" />
      <bpmn:sequenceFlow id="W1629_Flow19" sourceRef="W1629_Task9" targetRef="W1629_Task10" />
