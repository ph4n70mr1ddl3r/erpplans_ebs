    <bpmn:process id="W_W1626" name="W1626. Customer Return Quality Assessment &amp; Disposition" isExecutable="false">
      <bpmn:documentation>Trigger: Returned item fails visual inspection during return processing (W1622 step 3)
Frequency: ~8,000–10,000 returns/month require quality assessment (~15–18% of returns)
Volume: ~40–50 per store/month
Owner: Department Supervisor
Participants: Department Supervisor, CSR, Quality Manager (escalated)
Source: workflow W1626 — Customer Return Quality Assessment &amp; Disposition</bpmn:documentation>
      <bpmn:laneSet id="W1626_LaneSet5">
        <bpmn:lane id="W1626_Lane1" name="CSR">
        <bpmn:flowNodeRef>W1626_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1626_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1626_Lane2" name="Department Supervisor">
        <bpmn:flowNodeRef>W1626_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1626_Lane3" name="System">
        <bpmn:flowNodeRef>W1626_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1626_Lane4" name="Store Manager">
        <bpmn:flowNodeRef>W1626_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1626_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1626_Start6" name="Returned item fails visual inspection during return processing (W1622 step 3)">
        <bpmn:outgoing>W1626_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1626_Task7" name="CSR flags returned item as &quot;Condition Issue&quot; during return processing; routes…">
        <bpmn:documentation>Step 1: CSR flags returned item as &quot;Condition Issue&quot; during return processing; routes to Department Supervisor for quality assessment instead of immediate restock
Responsible (R): CSR
Accountable (A): Department Supervisor
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W1626_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1626_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1626_Task8" name="Resaleable">
        <bpmn:documentation>Step 2: Department Supervisor assesses returned item: (a) Resaleable: item is unused, packaging intact, all accessories present — return to stock at full price, (b) Resaleable at discount: minor cosmetic damage (scratched box, dented can) — route to markdown per W93, (c) Defective — vendor liability: product malfunction due to manufacturing defect — route to RTV per W88/W1280, (d) Defective — customer caused: damage clearly caused by customer misuse — deny return or issue partial store credit at Store Manager discretion, (e) Unsaleable: item cannot be resold (used, damaged, incomplete) — route to disposition per W91 (donate, scrap, or vendor return)
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 5 min/item</bpmn:documentation>
        <bpmn:incoming>W1626_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1626_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1626_Task9" name="System updates inventory status based on disposition: &quot;Available&quot; (resaleable)…">
        <bpmn:documentation>Step 3: System updates inventory status based on disposition: &quot;Available&quot; (resaleable), &quot;Markdown&quot; (discount), &quot;Damaged/Defective&quot; (RTV or scrap), &quot;Quarantine&quot; (pending vendor decision)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1626_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1626_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1626_Task10" name="Weekly: Store Manager reviews items in &quot;Quarantine&quot; status &gt; 7 days; escalates…">
        <bpmn:documentation>Step 4: Weekly: Store Manager reviews items in &quot;Quarantine&quot; status &gt; 7 days; escalates unresolved items to Buyer for vendor disposition decision
Responsible (R): Store Manager
Accountable (A): VP Merchandising
Duration: 30 min/week</bpmn:documentation>
        <bpmn:incoming>W1626_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1626_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1626_End11" name="Complete">
        <bpmn:incoming>W1626_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1626_Annotation12">
        <bpmn:text>Controls: - CTL-337 (ensure controlled execution — Customer Returns Processing (PA-32.1).) | - operational: Department Supervisor review and approval gate
Owner: Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
