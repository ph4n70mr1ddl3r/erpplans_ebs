        <bpmn:documentation>Step 1: Review developer request for direct billing: verify subcontractor credentials and project details.
Responsible (R): Legal &amp; Compliance Counsel / Credit Manager
Accountable (A): Legal &amp; Compliance Counsel / Credit Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5221_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5221_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5221_Task5" name="Draft Tripartite Payment Agreement: define direct payment terms, developer…">
        <bpmn:documentation>Step 2: Draft Tripartite Payment Agreement: define direct payment terms, developer guarantee of liability, and subcontractor delivery verification protocols.
Responsible (R): Legal &amp; Compliance Counsel / Credit Manager
Accountable (A): Legal &amp; Compliance Counsel / Credit Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5221_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5221_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5221_Task6" name="Execute agreement: configure ERP billing rules to route invoices directly to…">
