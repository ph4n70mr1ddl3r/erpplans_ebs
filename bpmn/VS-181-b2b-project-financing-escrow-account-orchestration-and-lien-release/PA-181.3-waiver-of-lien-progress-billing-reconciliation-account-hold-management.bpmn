        <bpmn:outgoing>W5224_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5224_Task4" name="Perform final reconciliation: match all billing invoices, JQS worksheets…">
        <bpmn:documentation>Step 1: Perform final reconciliation: match all billing invoices, JQS worksheets, credit notes, and escrow draws; resolve outstanding balance to zero.
Responsible (R): B2B Accounts Receivable Supervisor / Legal Operations (VS-100)
Accountable (A): B2B Accounts Receivable Supervisor / Legal Operations (VS-100)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5224_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5224_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5224_Task5" name="Prepare the Final Waiver of Lien and Release of Escrow letter.">
        <bpmn:documentation>Step 2: Prepare the Final Waiver of Lien and Release of Escrow letter.
Responsible (R): B2B Accounts Receivable Supervisor / Legal Operations (VS-100)
Accountable (A): B2B Accounts Receivable Supervisor / Legal Operations (VS-100)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5224_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5224_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5224_Task6" name="Execute final waiver: secure CEO/CFO signatures, notarize the document, and…">
        <bpmn:documentation>Step 3: Execute final waiver: secure CEO/CFO signatures, notarize the document, and deliver to bank escrow agent to release remaining escrow balance and retainage.
Responsible (R): B2B Accounts Receivable Supervisor / Legal Operations (VS-100)
Accountable (A): B2B Accounts Receivable Supervisor / Legal Operations (VS-100)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5224_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5224_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5224_Task7" name="Deactivate the project code and billing pricing lists in ERP.">
        <bpmn:documentation>Step 4: Deactivate the project code and billing pricing lists in ERP.
Responsible (R): B2B Accounts Receivable Supervisor / Legal Operations (VS-100)
Accountable (A): B2B Accounts Receivable Supervisor / Legal Operations (VS-100)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5224_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5224_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5224_End8" name="Complete">
        <bpmn:incoming>W5224_Flow15</bpmn:incoming>
      </bpmn:endEvent>
