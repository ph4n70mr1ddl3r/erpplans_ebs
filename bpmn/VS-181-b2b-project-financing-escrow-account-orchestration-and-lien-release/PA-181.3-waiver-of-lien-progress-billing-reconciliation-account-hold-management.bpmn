    <bpmn:process id="W_W5219" name="W5219. Project Material Return, Credit Note &amp; Reconciliation with Escrow draws" isExecutable="false">
      <bpmn:documentation>Trigger: Developer returning unused/surplus materials post-project phase (VS-32)
Frequency: Event-driven per return request
Volume: ~20–30 returns managed monthly across projects
Owner: Store Returns Clerk / B2B AR Specialist
Participants: Site Engineer, Store Manager, DC receiver (VS-04)
Source: workflow W5219 — Project Material Return, Credit Note &amp; Reconciliation with Escrow draws</bpmn:documentation>
      <bpmn:laneSet id="W5219_LaneSet2">
        <bpmn:lane id="W5219_Lane1" name="Store Returns Clerk">
        <bpmn:flowNodeRef>W5219_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5219_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5219_Task6</bpmn:flowNodeRef>
