      </bpmn:laneSet>
      <bpmn:startEvent id="W5219_Start3" name="Developer returning unused/surplus materials post-project phase (VS-32)">
        <bpmn:outgoing>W5219_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5219_Task4" name="Inspect returned materials: check for damage, grade changes, and verify matches…">
        <bpmn:documentation>Step 1: Inspect returned materials: check for damage, grade changes, and verify matches against original delivery receipts.
Responsible (R): Store Returns Clerk / B2B AR Specialist
Accountable (A): Store Returns Clerk / B2B AR Specialist
Duration: 10-15 min</bpmn:documentation>
        <bpmn:incoming>W5219_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5219_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5219_Task5" name="Generate Credit Note in ERP: calculate refund value at contracted prices…">
        <bpmn:documentation>Step 2: Generate Credit Note in ERP: calculate refund value at contracted prices (W5202).
Responsible (R): Store Returns Clerk / B2B AR Specialist
Accountable (A): Store Returns Clerk / B2B AR Specialist
Duration: 10-15 min</bpmn:documentation>
        <bpmn:incoming>W5219_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5219_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5219_Task6" name="Match credit note to project escrow draws: deduct credit amount from the next…">
        <bpmn:documentation>Step 3: Match credit note to project escrow draws: deduct credit amount from the next scheduled escrow draw request or apply as offset to outstanding AR balance.
Responsible (R): Store Returns Clerk / B2B AR Specialist
Accountable (A): Store Returns Clerk / B2B AR Specialist
Duration: 10-15 min</bpmn:documentation>
        <bpmn:incoming>W5219_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5219_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5219_Task7" name="Report adjustments to bank escrow agent to update trust ledger balance.">
        <bpmn:documentation>Step 4: Report adjustments to bank escrow agent to update trust ledger balance.
Responsible (R): Store Returns Clerk / B2B AR Specialist
Accountable (A): Store Returns Clerk / B2B AR Specialist
Duration: 10-15 min</bpmn:documentation>
        <bpmn:incoming>W5219_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5219_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5219_End8" name="Complete">
        <bpmn:incoming>W5219_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5219_Annotation9">
        <bpmn:text>Controls: - CTL-775 (ensure controlled execution — Waiver of Lien, Progress Billing Reconciliation &amp; Account Hold Management (PA-181.3).) | - CTL-775: Credit notes above PHP 100K require Controller approval; physical goods receipt verified before posting.
Owner: Store Returns Clerk / B2B AR Specialist</bpmn:text>
      </bpmn:textAnnotation>
