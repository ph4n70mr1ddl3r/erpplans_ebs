Responsible (R): Legal &amp; Compliance Counsel / Credit Manager
Accountable (A): Legal &amp; Compliance Counsel / Credit Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5221_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5221_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5221_Task7" name="Audit monthly payments: match direct developer escrow draw releases to…">
