    <bpmn:process id="W_W4255" name="W4255. Transport Incident, Breakdown &amp; Passenger-Safety Response" isExecutable="false">
      <bpmn:documentation>Trigger: Vehicle breakdown; road accident; medical/security incident en route
Frequency: Incident-driven (~few/month at scale)
Volume: Incidents across the shuttle network
Owner: Transport Lead / HSE (VS-24) / Fleet (VS-06)
Participants: Driver, HSE (VS-24), Security (VS-23), Insurance (VS-26), HR (VS-83), Legal (VS-100)
Source: workflow W4255 — Transport Incident, Breakdown &amp; Passenger-Safety Response</bpmn:documentation>
      <bpmn:laneSet id="W4255_LaneSet4">
        <bpmn:lane id="W4255_Lane1" name="Driver">
        <bpmn:flowNodeRef>W4255_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4255_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4255_Lane2" name="HSE">
