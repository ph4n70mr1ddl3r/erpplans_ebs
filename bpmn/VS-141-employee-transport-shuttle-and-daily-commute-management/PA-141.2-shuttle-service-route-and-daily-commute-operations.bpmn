    <bpmn:process id="W_W4252" name="W4252. Driver Roster, Qualification &amp; Daily Pre-Trip Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Daily operations; driver hire (VS-19.1); compliance cycle
Frequency: Daily pre-trip + ongoing roster
Volume: Driver pool covering all routes × shifts
Owner: Transport Dispatcher / Fleet Driver Mgmt (VS-06.2)
Participants: Drivers, Fleet (VS-06.2), HSE (VS-24), HR (VS-19), Security (VS-23)
Source: workflow W4252 — Driver Roster, Qualification &amp; Daily Pre-Trip Operations</bpmn:documentation>
      <bpmn:laneSet id="W4252_LaneSet4">
        <bpmn:lane id="W4252_Lane1" name="Fleet">
        <bpmn:flowNodeRef>W4252_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4252_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4252_Lane2" name="Driver">
        <bpmn:flowNodeRef>W4252_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4252_Lane3" name="Dispatcher">
        <bpmn:flowNodeRef>W4252_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4252_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4252_Start5" name="Daily operations; driver hire (VS-19.1); compliance cycle">
        <bpmn:outgoing>W4252_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4252_Task6" name="Fleet/Transport maintain the driver roster and qualifications (professional…">
        <bpmn:documentation>Step 1: Fleet/Transport maintain the driver roster and qualifications (professional driver&#x27;s license, PNP/LTO clearance, medical/DOLE fitness, defensive-driving training), with re-credentialing tracking
Responsible (R): Fleet / HR / HSE
Accountable (A): Transport Lead
Duration: Ongoing</bpmn:documentation>
