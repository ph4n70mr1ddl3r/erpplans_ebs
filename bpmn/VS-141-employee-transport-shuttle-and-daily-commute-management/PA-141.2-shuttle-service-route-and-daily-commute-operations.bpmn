        <bpmn:flowNodeRef>W4255_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4255_Start5" name="Vehicle breakdown; road accident; medical/security incident en route">
        <bpmn:outgoing>W4255_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4255_Task6" name="Driver/Coordinator execute the incident response (secure scene, passenger…">
        <bpmn:documentation>Step 1: Driver/Coordinator execute the incident response (secure scene, passenger safety first-aid, notify Dispatcher/HSE/Security, call emergency services if needed) per the transport incident SOP
Responsible (R): Driver / Dispatcher
Accountable (A): Transport Lead
Duration: Immediate</bpmn:documentation>
        <bpmn:incoming>W4255_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4255_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4255_Task7" name="HSE/Fleet investigate (root cause, driver/vehicle factors, road/weather)…">
        <bpmn:documentation>Step 2: HSE/Fleet investigate (root cause, driver/vehicle factors, road/weather), arrange alternate transport for stranded passengers, and log to the HSE/incident system (VS-24)
Responsible (R): HSE / Fleet / Transport Lead
Accountable (A): COO
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W4255_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4255_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4255_Task8" name="Insurance/Legal handle claims/passenger-injury (VS-26), corrective action…">
        <bpmn:documentation>Step 3: Insurance/Legal handle claims/passenger-injury (VS-26), corrective action (driver retraining/vehicle repair W4260), and reporting/CAPA (links VS-24/VS-133)
Responsible (R): Insurance / Legal / Fleet
Accountable (A): CFO / COO
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W4255_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4255_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4255_End9" name="Complete">
        <bpmn:incoming>W4255_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4255_Annotation10">
        <bpmn:text>Controls: - CTL-654 (ensure controlled execution — Shuttle Service, Route &amp; Daily Commute Operations (PA-141.2).) | - CTL-654: incident SOP followed; passenger-liability insured (VS-26); root-cause CAPA logged (VS-24/VS-133)
