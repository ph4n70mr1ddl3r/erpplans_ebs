<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-141.2-shuttle-service-route-and-daily-commute-operations" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4249" name="W4249. Shuttle Route Design, Shift Schedule &amp; Pickup-Point Network" isExecutable="false">
      <bpmn:documentation>Trigger: Need assessment (W4241); route review; new-store opening (VS-37)
Frequency: Periodic + on shift/footprint change
Volume: Routes per site × shift; pickup points across the employee catchment
Owner: Transport Lead / Fleet Planning (VS-06)
Participants: Site Managers (VS-07/VS-04), Analytics (VS-28), Workforce Planning (VS-103.3)
Source: workflow W4249 — Shuttle Route Design, Shift Schedule &amp; Pickup-Point Network</bpmn:documentation>
      <bpmn:laneSet id="W4249_LaneSet2">
        <bpmn:lane id="W4249_Lane1" name="Transport Lead">
        <bpmn:flowNodeRef>W4249_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4249_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4249_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4249_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4249_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4249_Start3" name="Need assessment (W4241); route review; new-store opening (VS-37)">
        <bpmn:outgoing>W4249_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4249_Task4" name="Transport/Analytics design routes balancing employee home-cluster coverage…">
        <bpmn:documentation>Step 1: Transport/Analytics design routes balancing employee home-cluster coverage, pickup-point safety/accessibility, travel time, shift start/end alignment, and vehicle capacity — using the geocoded need (W4241) and traffic/route data
Responsible (R): Transport Lead / Analytics
Accountable (A): Head of HR Shared Services
Duration: Per review</bpmn:documentation>
        <bpmn:incoming>W4249_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4249_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4249_Task5" name="Transport define the published schedule (route, stops, times) per shift…">
        <bpmn:documentation>Step 2: Transport define the published schedule (route, stops, times) per shift, communicate to riders and site managers, and align arrival/departure to shift roster (VS-19.3)
Responsible (R): Transport Lead / Site Mgrs
Accountable (A): Transport Lead
Duration: Per review</bpmn:documentation>
        <bpmn:incoming>W4249_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4249_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4249_Task6" name="Transport periodically re-optimize routes on ridership/traffic change (W4263)…">
        <bpmn:documentation>Step 3: Transport periodically re-optimize routes on ridership/traffic change (W4263), manage route changes/disruptions, and keep the pickup-point network documented
Responsible (R): Transport Lead / Analytics
Accountable (A): Head of HR Shared Services
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4249_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4249_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4249_End7" name="Complete">
        <bpmn:incoming>W4249_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4249_Annotation8">
        <bpmn:text>Controls: - CTL-654 (ensure controlled execution — Shuttle Service, Route &amp; Daily Commute Operations (PA-141.2).) | - CTL-654: routes evidence-designed (geocoded); schedule shift-aligned; reviewed periodically
Owner: Transport Lead / Fleet Planning (VS-06)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4249_Assoc9" sourceRef="W4249_Annotation8" targetRef="W4249_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4249_Flow10" sourceRef="W4249_Start3" targetRef="W4249_Task4" />
      <bpmn:sequenceFlow id="W4249_Flow11" sourceRef="W4249_Task4" targetRef="W4249_Task5" />
      <bpmn:sequenceFlow id="W4249_Flow12" sourceRef="W4249_Task5" targetRef="W4249_Task6" />
      <bpmn:sequenceFlow id="W4249_Flow13" sourceRef="W4249_Task6" targetRef="W4249_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4249_diag">
      <bpmndi:BPMNPlane id="W4249_plane" bpmnElement="W_W4249">
        <bpmndi:BPMNShape id="W4249_Lane1_di" bpmnElement="W4249_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
