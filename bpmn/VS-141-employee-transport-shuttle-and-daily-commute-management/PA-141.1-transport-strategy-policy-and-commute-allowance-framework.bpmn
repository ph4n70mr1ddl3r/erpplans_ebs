    <bpmn:process id="W_W4247" name="W4247. Transport Governance, DOLE/LTFRB Compliance Framework &amp; Insurance" isExecutable="false">
      <bpmn:documentation>Trigger: Operating model (W4244); regulatory change; annual review
Frequency: Annual + on regulatory change
Volume: One transport governance/compliance framework + insurance program
Owner: Transport Lead / Legal (VS-100.3) / Compliance (VS-22) / HSE (VS-24)
Participants: Legal (VS-100.3), Compliance (VS-22), HSE (VS-24), Insurance (VS-26), Fleet (VS-06)
Source: workflow W4247 — Transport Governance, DOLE/LTFRB Compliance Framework &amp; Insurance</bpmn:documentation>
      <bpmn:laneSet id="W4247_LaneSet4">
        <bpmn:lane id="W4247_Lane1" name="Legal">
        <bpmn:flowNodeRef>W4247_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4247_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
