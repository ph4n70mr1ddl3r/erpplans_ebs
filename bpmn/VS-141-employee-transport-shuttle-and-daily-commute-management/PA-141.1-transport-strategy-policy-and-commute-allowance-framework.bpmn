      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4244" name="W4244. Transport Operating-Model Decision (Owned vs Leased vs Contracted vs Allowance)" isExecutable="false">
      <bpmn:documentation>Trigger: Strategy (W4241); cost review; vendor-market change
Frequency: Annual + on material change
Volume: Operating-model decision per site-cluster (owned shuttle, leased, contracted charter, rideshare/vanpool, or allowance-only)
Owner: Transport Lead / Procurement (VS-34) / Fleet (VS-06) / Finance (VS-17.4)
Participants: Fleet (VS-06), Procurement (VS-34), Finance (VS-17.4), Legal (VS-100.3), Insurance (VS-26)
Source: workflow W4244 — Transport Operating-Model Decision (Owned vs Leased vs Contracted vs Allowance)</bpmn:documentation>
      <bpmn:laneSet id="W4244_LaneSet3">
        <bpmn:lane id="W4244_Lane1" name="Transport Lead">
        <bpmn:flowNodeRef>W4244_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4244_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4244_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4244_Lane2" name="Procurement">
        <bpmn:flowNodeRef>W4244_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4244_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4244_Start4" name="Strategy (W4241); cost review; vendor-market change">
        <bpmn:outgoing>W4244_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4244_Task5" name="Transport/Finance build the TCO comparison per option (owned fleet incl…">
        <bpmn:documentation>Step 1: Transport/Finance build the TCO comparison per option (owned fleet incl. driver/depreciation/maintenance/insurance per VS-06/VS-35; leased; contracted charter per-trip; rideshare/vanpool per-employee; vs pure allowance per W4243)
