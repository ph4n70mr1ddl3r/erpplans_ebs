      <bpmn:sequenceFlow id="W4243_Flow13" sourceRef="W4243_Task6" targetRef="W4243_Task7" />
      <bpmn:sequenceFlow id="W4243_Flow14" sourceRef="W4243_Task7" targetRef="W4243_Task8" />
      <bpmn:sequenceFlow id="W4243_Flow15" sourceRef="W4243_Task8" targetRef="W4243_End9" />
    </bpmn:process>
