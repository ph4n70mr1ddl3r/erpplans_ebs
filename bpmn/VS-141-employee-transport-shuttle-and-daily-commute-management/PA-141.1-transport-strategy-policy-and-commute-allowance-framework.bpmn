        <bpmndi:BPMNEdge id="W4242_Flow11_di" bpmnElement="W4242_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4242_Flow12_di" bpmnElement="W4242_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4242_Flow13_di" bpmnElement="W4242_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4242_Assoc9_di" bpmnElement="W4242_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4243" name="W4243. Transport-Allowance Design, Rate Setting &amp; Tax Treatment" isExecutable="false">
      <bpmn:documentation>Trigger: Policy (W4242); annual comp cycle; fuel/price change
Frequency: Annual + on material cost change
Volume: Allowance rates per site-zone × shift-type, paid to eligible employees
Owner: Compensation (VS-102) / Finance (VS-17.4) / Payroll (VS-19.2)
Participants: HR Shared Services (VS-103), Payroll (VS-19.2), Legal/Tax (VS-100.3/VS-79), Finance (VS-17.4)
Source: workflow W4243 — Transport-Allowance Design, Rate Setting &amp; Tax Treatment</bpmn:documentation>
      <bpmn:laneSet id="W4243_LaneSet4">
        <bpmn:lane id="W4243_Lane1" name="Comp">
        <bpmn:flowNodeRef>W4243_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4243_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4243_Lane2" name="Tax">
        <bpmn:flowNodeRef>W4243_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4243_Lane3" name="Payroll">
        <bpmn:flowNodeRef>W4243_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4243_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4243_Start5" name="Policy (W4242); annual comp cycle; fuel/price change">
        <bpmn:outgoing>W4243_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4243_Task6" name="Comp/Finance set allowance rates by site-zone (distance band), shift type, and…">
        <bpmn:documentation>Step 1: Comp/Finance set allowance rates by site-zone (distance band), shift type, and mode, benchmarked to local transport cost (fuel, jeepney/tricycle fare, ride-share), and modeled vs the cost of operating a shuttle (W4244)
Responsible (R): Comp / Finance
Accountable (A): CHRO / CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4243_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4243_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4243_Task7" name="Tax/Legal determine BIR treatment (de minimis/non-taxable transport allowance…">
        <bpmn:documentation>Step 2: Tax/Legal determine BIR treatment (de minimis/non-taxable transport allowance limits under TRAIN, or taxable if exceeding), coordinate with VS-79 (EWT/compensation) and VS-19.2 payroll coding
Responsible (R): Tax (VS-79) / Legal
Accountable (A): VP Legal / CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4243_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4243_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4243_Task8" name="Payroll/Comp configure the allowance in the payroll engine (rate table by…">
        <bpmn:documentation>Step 3: Payroll/Comp configure the allowance in the payroll engine (rate table by zone×shift, eligibility from W4242), test, and launch; monitor cost and tax impact
Responsible (R): Payroll (VS-19.2) / Comp
Accountable (A): CHRO
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W4243_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4243_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4243_End9" name="Complete">
        <bpmn:incoming>W4243_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4243_Annotation10">
        <bpmn:text>Controls: - CTL-653 (ensure controlled execution — Transport Strategy, Policy &amp; Commute-Allowance Framework (PA-141.1).) | - CTL-653: rates Finance-justified; BIR tax treatment documented (VS-79); payroll-coded &amp; tested (VS-19.2)
Owner: Compensation (VS-102) / Finance (VS-17.4) / Payroll (VS-19.2)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4243_Assoc11" sourceRef="W4243_Annotation10" targetRef="W4243_Start5" associationDirection="None" />
