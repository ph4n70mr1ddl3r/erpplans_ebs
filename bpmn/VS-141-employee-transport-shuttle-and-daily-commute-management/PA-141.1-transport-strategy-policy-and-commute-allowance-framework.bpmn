      <bpmn:startEvent id="W4247_Start5" name="Operating model (W4244); regulatory change; annual review">
        <bpmn:outgoing>W4247_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4247_Task6" name="Legal/Transport map the regulatory regime: LTFRB franchise for any…">
        <bpmn:documentation>Step 1: Legal/Transport map the regulatory regime: LTFRB franchise for any operated/contracted common-carrier passenger service, LTO vehicle registration/inspection, DOLE OSH duty of care for employee transport, and driver licensing (professional license, PNP/LTO clearances)
Responsible (R): Legal / Transport Lead
Accountable (A): VP Legal / COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4247_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4247_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4247_Task7" name="Insurance/HSE structure the coverage (passenger- liability / vehicle insurance…">
        <bpmn:documentation>Step 2: Insurance/HSE structure the coverage (passenger- liability / vehicle insurance via VS-26, own-damage, acts-of-nature for typhoon-prone routes) and the HSE transport-safety standard (pre-trip inspection, speed, fatigue, no-phone)
Responsible (R): Insurance / HSE
Accountable (A): CFO / COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4247_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4247_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4247_Task8" name="Compliance document the framework, lodge any required permits/franchise filings…">
        <bpmn:documentation>Step 3: Compliance document the framework, lodge any required permits/franchise filings (VS-22), train drivers/managers, and schedule periodic compliance review (W4260)
Responsible (R): Compliance / Transport Lead
Accountable (A): VP Legal
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4247_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4247_Flow15</bpmn:outgoing>
