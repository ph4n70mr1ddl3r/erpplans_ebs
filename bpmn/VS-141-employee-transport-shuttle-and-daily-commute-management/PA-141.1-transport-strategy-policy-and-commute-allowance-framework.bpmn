      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4242" name="W4242. Transport Policy, Eligibility &amp; Shift-Coverage Rules" isExecutable="false">
      <bpmn:documentation>Trigger: Strategy (W4241); policy review; DOLE/labor change
Frequency: Annual + on change
Volume: One enterprise transport policy governing ~6,932 employees
Owner: Head of HR Shared Services / HR Policy (VS-103.1)
Participants: Labor Relations (VS-84), Legal (VS-100.3), Comp (VS-102), Contingent Workforce (VS-98)
Source: workflow W4242 — Transport Policy, Eligibility &amp; Shift-Coverage Rules</bpmn:documentation>
      <bpmn:laneSet id="W4242_LaneSet2">
        <bpmn:lane id="W4242_Lane1" name="HR Policy">
        <bpmn:flowNodeRef>W4242_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4242_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4242_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4242_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4242_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4242_Start3" name="Strategy (W4241); policy review; DOLE/labor change">
        <bpmn:outgoing>W4242_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4242_Task4" name="HR Policy author the transport policy: who is eligible (shift, role, site…">
        <bpmn:documentation>Step 1: HR Policy author the transport policy: who is eligible (shift, role, site, distance, contingent-worker parity per VS-98), service vs allowance rules, late/early-shift coverage windows, no-show/cancellation rules, and guest/visitor rules
Responsible (R): HR Policy / Transport Lead
Accountable (A): Head of HR Shared Services
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4242_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4242_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4242_Task5" name="HR Policy/Legal align the policy to DOLE Labor Code (not a wage/benefit…">
        <bpmn:documentation>Step 2: HR Policy/Legal align the policy to DOLE Labor Code (not a wage/benefit guarantee unless CBA — coordinate VS-84), BIR tax treatment of transport allowance (de minimis / non-taxable limits), and contingent-worker co-employment guardrails (VS-98)
Responsible (R): HR Policy / Legal / Comp
Accountable (A): CHRO / VP Legal
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4242_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4242_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4242_Task6" name="HR Policy publish the policy (employee handbook / ESS VS-103.1), train site…">
        <bpmn:documentation>Step 3: HR Policy publish the policy (employee handbook / ESS VS-103.1), train site managers on enforcement, and establish the exception/approval path
Responsible (R): HR Policy / Site Mgrs
Accountable (A): Head of HR Shared Services
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4242_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4242_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4242_End7" name="Complete">
        <bpmn:incoming>W4242_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4242_Annotation8">
        <bpmn:text>Controls: - CTL-653 (ensure controlled execution — Transport Strategy, Policy &amp; Commute-Allowance Framework (PA-141.1).) | - CTL-653: policy Legal/Comp-reviewed; tax treatment documented (W4243); CBA-consistent (VS-84); published &amp; acknowledged
Owner: Head of HR Shared Services / HR Policy (VS-103.1)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4242_Assoc9" sourceRef="W4242_Annotation8" targetRef="W4242_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4242_Flow10" sourceRef="W4242_Start3" targetRef="W4242_Task4" />
      <bpmn:sequenceFlow id="W4242_Flow11" sourceRef="W4242_Task4" targetRef="W4242_Task5" />
      <bpmn:sequenceFlow id="W4242_Flow12" sourceRef="W4242_Task5" targetRef="W4242_Task6" />
      <bpmn:sequenceFlow id="W4242_Flow13" sourceRef="W4242_Task6" targetRef="W4242_End7" />
    </bpmn:process>
