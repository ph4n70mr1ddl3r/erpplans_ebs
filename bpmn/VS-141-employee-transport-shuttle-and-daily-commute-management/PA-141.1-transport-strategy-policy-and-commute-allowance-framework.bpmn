<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-141.1-transport-strategy-policy-and-commute-allowance-framework" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4241" name="W4241. Employee Commute-Need Assessment &amp; Transport Strategy" isExecutable="false">
      <bpmn:documentation>Trigger: Annual workforce/transport planning; new-store opening (VS-37); shift-pattern change
Frequency: Annual + on major footprint/shift change
Volume: Enterprise: ~6,932 employees across 205 sites; ~5,800 store staff on 2–3 shifts
Owner: Head of HR Shared Services / Transport Lead (VS-103)
Participants: Store/DC Ops (VS-07/VS-04), Workforce Planning (VS-103.3), Finance (VS-17.4), Strategy (VS-33), Real Estate (VS-97)
Source: workflow W4241 — Employee Commute-Need Assessment &amp; Transport Strategy</bpmn:documentation>
      <bpmn:laneSet id="W4241_LaneSet2">
        <bpmn:lane id="W4241_Lane1" name="Transport Lead">
        <bpmn:flowNodeRef>W4241_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4241_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4241_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4241_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4241_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4241_Start3" name="Annual workforce/transport planning; new-store opening (VS-37); shift-pattern change">
        <bpmn:outgoing>W4241_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4241_Task4" name="HR/Ops run an annual commute-need assessment per site: employee home-location…">
        <bpmn:documentation>Step 1: HR/Ops run an annual commute-need assessment per site: employee home-location distribution (geocoded), shift roster start/end times vs local public-transport availability, after-dark safety exposure, and ride-share/jeepney/tricycle feasibility
Responsible (R): Transport Lead / Workforce Planning / Site Mgrs
Accountable (A): Head of HR Shared Services
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4241_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4241_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4241_Task5" name="HR/Ops quantify the transport gap (employees per site needing assisted commute…">
        <bpmn:documentation>Step 2: HR/Ops quantify the transport gap (employees per site needing assisted commute, by shift), size the service need (routes, seats, trips/shift), and prioritize sites (after-hours shifts, unsafe corridors, high-attrition stores)
Responsible (R): Transport Lead / Analytics (VS-28)
Accountable (A): Head of HR Shared Services
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4241_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4241_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4241_Task6" name="HR/Strategy set the transport strategy (service tiers, owned vs contracted mix…">
        <bpmn:documentation>Step 3: HR/Strategy set the transport strategy (service tiers, owned vs contracted mix, allowance vs shuttle, ESG/rideshare goals), obtain approval, and cascade to operating-model (W4244) and route design (W4250)
Responsible (R): Transport Lead / Strategy / Finance
Accountable (A): CHRO / COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4241_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4241_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4241_End7" name="Complete">
        <bpmn:incoming>W4241_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4241_Annotation8">
        <bpmn:text>Controls: - CTL-653 (ensure controlled execution — Transport Strategy, Policy &amp; Commute-Allowance Framework (PA-141.1).) | - CTL-653: need-assessment evidence-based (geocoded); strategy approved (CHRO/COO); aligned to workforce plan (VS-103.3)
Owner: Head of HR Shared Services / Transport Lead (VS-103)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4241_Assoc9" sourceRef="W4241_Annotation8" targetRef="W4241_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4241_Flow10" sourceRef="W4241_Start3" targetRef="W4241_Task4" />
      <bpmn:sequenceFlow id="W4241_Flow11" sourceRef="W4241_Task4" targetRef="W4241_Task5" />
      <bpmn:sequenceFlow id="W4241_Flow12" sourceRef="W4241_Task5" targetRef="W4241_Task6" />
      <bpmn:sequenceFlow id="W4241_Flow13" sourceRef="W4241_Task6" targetRef="W4241_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4241_diag">
      <bpmndi:BPMNPlane id="W4241_plane" bpmnElement="W_W4241">
