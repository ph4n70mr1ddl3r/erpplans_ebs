    <bpmn:process id="W_W2745" name="W2745. Customer AR Payment Application &amp; Unapplied Cash Resolution" isExecutable="false">
      <bpmn:documentation>Trigger: Customer payment received (bank transfer, check, cash deposit, e-wallet)
Frequency: Daily
Volume: ~3,500 AR invoices/month; ~1,500–2,000 customer payments/month
Owner: AR Clerk
Participants: AR Clerk, AR Supervisor, Treasury Analyst
Source: workflow W2745 — Customer AR Payment Application &amp; Unapplied Cash Resolution</bpmn:documentation>
      <bpmn:laneSet id="W2745_LaneSet3">
        <bpmn:lane id="W2745_Lane1" name="AR Clerk">
        <bpmn:flowNodeRef>W2745_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2745_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2745_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2745_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2745_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2745_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2745_Lane2" name="AR Supervisor">
        <bpmn:flowNodeRef>W2745_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2745_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2745_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2745_Start4" name="Customer payment received (bank transfer, check, cash deposit, e-wallet)">
        <bpmn:outgoing>W2745_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2745_Task5" name="AR Clerk receives payment notification: bank statement auto-import, check…">
        <bpmn:documentation>Step 1: AR Clerk receives payment notification: bank statement auto-import, check deposit slip, or manual notification from store/DC
Responsible (R): AR Clerk
Accountable (A): —
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2745_Flow15</bpmn:incoming>
        <bpmn:outgoing>W2745_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2745_Task6" name="AR Clerk applies payment to customer account: (a) match payment to specific…">
        <bpmn:documentation>Step 2: AR Clerk applies payment to customer account: (a) match payment to specific invoice(s) by reference number, (b) if no reference: match by amount, date, and customer name, (c) system posts: Dr. Cash/Bank / Cr. Accounts Receivable
Responsible (R): AR Clerk
Accountable (A): —
Duration: 5 min/payment</bpmn:documentation>
        <bpmn:incoming>W2745_Flow16</bpmn:incoming>
        <bpmn:outgoing>W2745_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2745_Task7" name="Partial payment">
        <bpmn:documentation>Step 3: Partial payment: system applies proportionally across open invoices unless customer specifies allocation; remaining balance stays in AR aging
Responsible (R): AR Clerk
Accountable (A): —
Duration: 5 min/payment</bpmn:documentation>
        <bpmn:incoming>W2745_Flow17</bpmn:incoming>
        <bpmn:outgoing>W2745_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2745_Task8" name="Overpayment">
        <bpmn:documentation>Step 4: Overpayment: system creates on-account credit; AR Clerk contacts customer for disposition (apply to future invoice, refund, or offset against other open items)
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 10 min/event</bpmn:documentation>
        <bpmn:incoming>W2745_Flow18</bpmn:incoming>
        <bpmn:outgoing>W2745_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2745_Task9" name="Unapplied cash">
        <bpmn:documentation>Step 5: Unapplied cash: payments received that cannot be matched to a customer or invoice are posted to unapplied cash suspense account; AR Clerk investigates within 5 business days using bank reference, customer communication, and Sales Rep confirmation
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 15 min/item</bpmn:documentation>
        <bpmn:incoming>W2745_Flow19</bpmn:incoming>
        <bpmn:outgoing>W2745_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2745_Task10" name="Weekly: AR Supervisor reviews unapplied cash aging; items &gt; 10 days escalated…">
        <bpmn:documentation>Step 6: Weekly: AR Supervisor reviews unapplied cash aging; items &gt; 10 days escalated; items &gt; 30 days reported to Finance Manager
Responsible (R): AR Supervisor
Accountable (A): Finance Manager
Duration: 30 min/week</bpmn:documentation>
        <bpmn:incoming>W2745_Flow20</bpmn:incoming>
        <bpmn:outgoing>W2745_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2745_Task11" name="Monthly: unapplied cash balance must reconcile to GL suspense account; variance…">
        <bpmn:documentation>Step 7: Monthly: unapplied cash balance must reconcile to GL suspense account; variance investigated
Responsible (R): AR Supervisor
Accountable (A): Controller
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W2745_Flow21</bpmn:incoming>
        <bpmn:outgoing>W2745_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2745_End12" name="Complete">
        <bpmn:incoming>W2745_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2745_Annotation13">
        <bpmn:text>Controls: - CTL-287 (ensure controlled execution — AR &amp; Collections (PA-16.2).) | - operational: AR Clerk review and approval gate; periodic reconciliation against source documents
Owner: AR Clerk</bpmn:text>
      </bpmn:textAnnotation>
