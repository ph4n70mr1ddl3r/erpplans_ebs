    <bpmn:process id="W_W812" name="W812. Customer Credit Field Collection Operations &amp; Legal Escalation" isExecutable="false">
      <bpmn:documentation>Trigger: Account &gt; 90 days overdue and all standard collection efforts exhausted per W890
Frequency: ~5–10 escalation events/month
Volume: ~50–100 accounts/year reaching legal escalation stage
Owner: AR Supervisor
Participants: AR Supervisor, Finance Manager, Legal Counsel, Collection Agency, Sales Rep
Source: workflow W812 — Customer Credit Field Collection Operations &amp; Legal Escalation</bpmn:documentation>
      <bpmn:laneSet id="W812_LaneSet3">
        <bpmn:lane id="W812_Lane1" name="AR Supervisor">
        <bpmn:flowNodeRef>W812_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W812_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W812_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W812_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W812_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W812_Lane2" name="Finance Manager">
        <bpmn:flowNodeRef>W812_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W812_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W812_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W812_Start4" name="Account &gt; 90 days overdue and all standard collection efforts exhausted per W890">
        <bpmn:outgoing>W812_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W812_Task5" name="AR Supervisor identifies accounts &gt; 90 days overdue where: (a) 3+ collection…">
        <bpmn:documentation>Step 1: AR Supervisor identifies accounts &gt; 90 days overdue where: (a) 3+ collection calls attempted with no payment, OR (b) 2+ broken payment promises, OR (c) customer disputing without engaging in resolution
Responsible (R): AR Supervisor
Accountable (A): Finance Manager
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W812_Flow14</bpmn:incoming>
        <bpmn:outgoing>W812_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W812_Task6" name="AR Supervisor prepares demand letter on company letterhead: outstanding amount…">
        <bpmn:documentation>Step 2: AR Supervisor prepares demand letter on company letterhead: outstanding amount, invoice references, payment deadline (10 business days), and statement of legal action if unresolved
Responsible (R): AR Supervisor
Accountable (A): Finance Manager
Duration: 30 min/account</bpmn:documentation>
        <bpmn:incoming>W812_Flow15</bpmn:incoming>
        <bpmn:outgoing>W812_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W812_Task7" name="Finance Manager approves and signs demand letter; sent via registered mail with…">
        <bpmn:documentation>Step 3: Finance Manager approves and signs demand letter; sent via registered mail with return card and email
Responsible (R): Finance Manager
Accountable (A): —
Duration: 15 min/account</bpmn:documentation>
        <bpmn:incoming>W812_Flow16</bpmn:incoming>
        <bpmn:outgoing>W812_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W812_Task8" name="If no response within deadline: AR Supervisor engages external collection…">
        <bpmn:documentation>Step 4: If no response within deadline: AR Supervisor engages external collection agency for field visit; system logs agency referral with expected recovery timeline
Responsible (R): AR Supervisor
Accountable (A): Finance Manager
Duration: 30 min/account</bpmn:documentation>
        <bpmn:incoming>W812_Flow17</bpmn:incoming>
        <bpmn:outgoing>W812_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W812_Task9" name="If collection agency unsuccessful: Finance Manager and Legal Counsel evaluate…">
        <bpmn:documentation>Step 5: If collection agency unsuccessful: Finance Manager and Legal Counsel evaluate legal action — (a) file small claims case (≤ PHP 400K) in Municipal Trial Court, (b) file regular civil case for collection in Regional Trial Court, (c) assess cost-benefit of litigation vs. write-off per W81
Responsible (R): Finance Manager / Legal
Accountable (A): CFO
Duration: 1 hour/account</bpmn:documentation>
        <bpmn:incoming>W812_Flow18</bpmn:incoming>
        <bpmn:outgoing>W812_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W812_Task10" name="All escalation actions and legal proceedings documented in customer account for…">
        <bpmn:documentation>Step 6: All escalation actions and legal proceedings documented in customer account for audit trail and potential BIR write-off substantiation per W81
Responsible (R): AR Supervisor / Legal
Accountable (A): Finance Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W812_Flow19</bpmn:incoming>
        <bpmn:outgoing>W812_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W812_End11" name="Complete">
        <bpmn:incoming>W812_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W812_Annotation12">
        <bpmn:text>Controls: - CTL-287 (ensure controlled execution — AR &amp; Collections (PA-16.2).) | - operational: AR Supervisor review and approval gate
Owner: AR Supervisor</bpmn:text>
      </bpmn:textAnnotation>
