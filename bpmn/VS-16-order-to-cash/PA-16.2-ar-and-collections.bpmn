    <bpmn:process id="W_W890" name="W890. Customer Collection Call Execution &amp; Promise Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Accounts identified in weekly aging review (W889)
Frequency: Daily (ongoing collection activity)
Volume: ~150–200 collection calls/week; ~30–40 promise-to-pay tracking entries/week
Owner: AR Clerk
Participants: AR Clerk, Sales Rep, AR Supervisor
Source: workflow W890 — Customer Collection Call Execution &amp; Promise Tracking</bpmn:documentation>
      <bpmn:laneSet id="W890_LaneSet4">
        <bpmn:lane id="W890_Lane1" name="AR Clerk">
        <bpmn:flowNodeRef>W890_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W890_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W890_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W890_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W890_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W890_Lane2" name="System">
        <bpmn:flowNodeRef>W890_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W890_Lane3" name="AR Supervisor">
        <bpmn:flowNodeRef>W890_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W890_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W890_Start5" name="Accounts identified in weekly aging review (W889)">
        <bpmn:outgoing>W890_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W890_Task6" name="AR Clerk reviews assigned collection queue with customer aging detail…">
        <bpmn:documentation>Step 1: AR Clerk reviews assigned collection queue with customer aging detail, outstanding invoices, and prior collection history
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 5 min/account</bpmn:documentation>
        <bpmn:incoming>W890_Flow15</bpmn:incoming>
        <bpmn:outgoing>W890_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W890_Task7" name="AR Clerk executes collection call: (a) confirms identity and authorized…">
        <bpmn:documentation>Step 2: AR Clerk executes collection call: (a) confirms identity and authorized contact, (b) states outstanding amount and invoice references, (c) inquires on payment status and reason for delay, (d) negotiates payment commitment date
Responsible (R): AR Clerk
Accountable (A): —
Duration: 10–15 min/call</bpmn:documentation>
        <bpmn:incoming>W890_Flow16</bpmn:incoming>
        <bpmn:outgoing>W890_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W890_Task8" name="Promise to Pay">
        <bpmn:documentation>Step 3: AR Clerk logs call outcome in system: (a) Promise to Pay — customer commits to specific date and amount, (b) Dispute — customer disputes invoice (route to W2746), (c) Partial Payment — customer offers partial settlement, (d) No Response — customer unreachable after 3 attempts, (e) Broken Promise — previously committed date missed
Responsible (R): AR Clerk
Accountable (A): —
Duration: 5 min/call</bpmn:documentation>
        <bpmn:incoming>W890_Flow17</bpmn:incoming>
        <bpmn:outgoing>W890_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W890_Task9" name="For promises: system creates promise-to-pay record with committed date, amount…">
        <bpmn:documentation>Step 4: For promises: system creates promise-to-pay record with committed date, amount, and AR Clerk notes; system auto-flags broken promises on the committed date + 1 business day
Responsible (R): System / AR Clerk
Accountable (A): —
Duration: 2 min/promise</bpmn:documentation>
        <bpmn:incoming>W890_Flow18</bpmn:incoming>
        <bpmn:outgoing>W890_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W890_Task10" name="Follow-up cadence: (a) 1–30 days overdue — call or email every 7 days, (b)…">
        <bpmn:documentation>Step 5: Follow-up cadence: (a) 1–30 days overdue — call or email every 7 days, (b) 31–60 days — call every 3–5 business days, (c) 61–90 days — call every 2–3 business days + Sales Rep involvement, (d) &gt; 90 days — demand letter + legal escalation per W812
Responsible (R): AR Clerk / Sales Rep
Accountable (A): AR Supervisor
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W890_Flow19</bpmn:incoming>
        <bpmn:outgoing>W890_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W890_Task11" name="Weekly: AR Supervisor reviews broken promise report and escalates chronic…">
        <bpmn:documentation>Step 6: Weekly: AR Supervisor reviews broken promise report and escalates chronic non-payers to Finance Manager for demand letter or legal referral
Responsible (R): AR Supervisor
Accountable (A): Finance Manager
Duration: 30 min/week</bpmn:documentation>
        <bpmn:incoming>W890_Flow20</bpmn:incoming>
        <bpmn:outgoing>W890_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W890_End12" name="Complete">
        <bpmn:incoming>W890_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W890_Annotation13">
        <bpmn:text>Controls: - CTL-287 (ensure controlled execution — AR &amp; Collections (PA-16.2).) | - operational: AR Clerk review and approval gate
Owner: AR Clerk</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W890_Assoc14" sourceRef="W890_Annotation13" targetRef="W890_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W890_Flow15" sourceRef="W890_Start5" targetRef="W890_Task6" />
      <bpmn:sequenceFlow id="W890_Flow16" sourceRef="W890_Task6" targetRef="W890_Task7" />
