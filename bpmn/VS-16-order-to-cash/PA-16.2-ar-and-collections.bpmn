    <bpmn:process id="W_W2746" name="W2746. Customer AR Dispute Resolution &amp; Credit Note Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer disputes invoice amount, quality, quantity, or pricing
Frequency: ~50–80 disputes/month
Volume: ~1.5% of AR invoices result in disputes
Owner: AR Clerk
Participants: AR Clerk, AR Supervisor, Sales Rep, Category Manager, Warehouse Supervisor
Source: workflow W2746 — Customer AR Dispute Resolution &amp; Credit Note Processing</bpmn:documentation>
      <bpmn:laneSet id="W2746_LaneSet4">
        <bpmn:lane id="W2746_Lane1" name="AR Clerk">
        <bpmn:flowNodeRef>W2746_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2746_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2746_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2746_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2746_Lane2" name="Investigator">
        <bpmn:flowNodeRef>W2746_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2746_Lane3" name="AR Supervisor">
        <bpmn:flowNodeRef>W2746_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2746_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2746_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2746_Start5" name="Customer disputes invoice amount, quality, quantity, or pricing">
        <bpmn:outgoing>W2746_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2746_Task6" name="Customer raises dispute via Sales Rep, email, or phone; AR Clerk logs dispute…">
        <bpmn:documentation>Step 1: Customer raises dispute via Sales Rep, email, or phone; AR Clerk logs dispute in system with: invoice reference, disputed amount, reason code (pricing, quantity, quality, delivery, duplicate, other), and customer documentation
Responsible (R): AR Clerk
Accountable (A): —
Duration: 10 min/dispute</bpmn:documentation>
        <bpmn:incoming>W2746_Flow15</bpmn:incoming>
        <bpmn:outgoing>W2746_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2746_Task7" name="pricing">
        <bpmn:documentation>Step 2: AR Clerk classifies dispute type and routes for investigation: (a) pricing — route to Category Manager, (b) quantity/delivery — route to Warehouse Supervisor or DC, (c) quality — route to Quality per W110, (d) duplicate invoice — verify in system
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 5 min/dispute</bpmn:documentation>
        <bpmn:incoming>W2746_Flow16</bpmn:incoming>
        <bpmn:outgoing>W2746_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2746_Task8" name="Investigating party responds within 5 business days with findings: dispute…">
        <bpmn:documentation>Step 3: Investigating party responds within 5 business days with findings: dispute valid, partially valid, or not valid
Responsible (R): Investigator
Accountable (A): AR Supervisor
Duration: Varies</bpmn:documentation>
        <bpmn:incoming>W2746_Flow17</bpmn:incoming>
        <bpmn:outgoing>W2746_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2746_Task9" name="If dispute valid: AR Supervisor approves credit note issuance — system…">
        <bpmn:documentation>Step 4: If dispute valid: AR Supervisor approves credit note issuance — system generates BIR-compliant credit note referencing original sales invoice, with VAT adjustment; GL posts: Dr. Sales Returns / Cr. AR; Dr. Output VAT (reversal)
Responsible (R): AR Supervisor
Accountable (A): Finance Manager
Duration: 10 min/dispute</bpmn:documentation>
        <bpmn:incoming>W2746_Flow18</bpmn:incoming>
        <bpmn:outgoing>W2746_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2746_Task10" name="If dispute not valid: AR Clerk communicates decision to customer with…">
        <bpmn:documentation>Step 5: If dispute not valid: AR Clerk communicates decision to customer with supporting evidence; payment expected per original terms
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 10 min/dispute</bpmn:documentation>
        <bpmn:incoming>W2746_Flow19</bpmn:incoming>
        <bpmn:outgoing>W2746_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2746_Task11" name="Monthly: AR Supervisor reviews dispute analytics — top reasons, resolution…">
        <bpmn:documentation>Step 6: Monthly: AR Supervisor reviews dispute analytics — top reasons, resolution time, disputed amount as % of AR, repeat customers
Responsible (R): AR Supervisor
Accountable (A): Finance Manager
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W2746_Flow20</bpmn:incoming>
        <bpmn:outgoing>W2746_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2746_End12" name="Complete">
        <bpmn:incoming>W2746_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2746_Annotation13">
        <bpmn:text>Controls: - CTL-287 (ensure controlled execution — AR &amp; Collections (PA-16.2).) | - operational: AR Clerk review and approval gate
Owner: AR Clerk</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2746_Assoc14" sourceRef="W2746_Annotation13" targetRef="W2746_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2746_Flow15" sourceRef="W2746_Start5" targetRef="W2746_Task6" />
      <bpmn:sequenceFlow id="W2746_Flow16" sourceRef="W2746_Task6" targetRef="W2746_Task7" />
      <bpmn:sequenceFlow id="W2746_Flow17" sourceRef="W2746_Task7" targetRef="W2746_Task8" />
      <bpmn:sequenceFlow id="W2746_Flow18" sourceRef="W2746_Task8" targetRef="W2746_Task9" />
