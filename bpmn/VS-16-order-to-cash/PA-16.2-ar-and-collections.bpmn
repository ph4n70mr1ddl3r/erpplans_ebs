    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2745_diag">
      <bpmndi:BPMNPlane id="W2745_plane" bpmnElement="W_W2745">
        <bpmndi:BPMNShape id="W2745_Lane1_di" bpmnElement="W2745_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2745_Lane2_di" bpmnElement="W2745_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2745_Task5_di" bpmnElement="W2745_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2745_Task6_di" bpmnElement="W2745_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2745_Task7_di" bpmnElement="W2745_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2745_Task8_di" bpmnElement="W2745_Task8"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2745_Task9_di" bpmnElement="W2745_Task9"><dc:Bounds x="1240" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2745_Task10_di" bpmnElement="W2745_Task10"><dc:Bounds x="1450" y="295" width="180" height="80" /></bpmndi:BPMNShape>
