    <bpmn:process id="W_W1540" name="W1540. Trade Account Monthly Statement Generation, Aging Analysis &amp; Collection Priority Scoring" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly statement cycle (1st business day of month); or ad-hoc request from Trade Account Manager
Frequency: Monthly statements for ~5,200 trade accounts; aging analysis weekly
Volume: ~3,500 AR invoices/month generating ~5,200 statements
Owner: AR Supervisor
Participants: AR Supervisor, AR Clerk, Collection Agent, Trade Account Manager, Credit Manager
Source: workflow W1540 — Trade Account Monthly Statement Generation, Aging Analysis &amp; Collection Priority Scoring</bpmn:documentation>
      <bpmn:laneSet id="W1540_LaneSet4">
        <bpmn:lane id="W1540_Lane1" name="System">
        <bpmn:flowNodeRef>W1540_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1540_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1540_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1540_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1540_Lane2" name="AR Supervisor">
        <bpmn:flowNodeRef>W1540_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1540_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1540_Lane3" name="Collection Agents">
        <bpmn:flowNodeRef>W1540_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1540_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1540_Start5" name="Monthly statement cycle (1st business day of month); or ad-hoc request from Trade Account…">
        <bpmn:outgoing>W1540_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1540_Task6" name="Monthly statement generation">
        <bpmn:documentation>Step 1: Monthly statement generation: System generates statements for all active trade accounts — opening balance, all invoices and credit memos for the month, payments received, closing balance, current amount due, overdue amount by aging bucket (Current, 1–30 days, 31–60 days, 61–90 days, &gt; 90 days); statements formatted per BIR requirements with BuildRight TIN, customer TIN, and invoice references
Responsible (R): System
Accountable (A): AR Supervisor
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1540_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1540_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1540_Task7" name="Statement distribution">
        <bpmn:documentation>Step 2: Statement distribution: System distributes statements via email (PDF attachment with digital signature); for customers requesting physical statements, AR Clerk prints and mails; high-value Platinum/Gold accounts receive personal statement delivery through Trade Account Manager
Responsible (R): System / AR Clerk
Accountable (A): AR Supervisor
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1540_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1540_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1540_Task8" name="Aging analysis">
        <bpmn:documentation>Step 3: Aging analysis: AR Supervisor reviews weekly AR aging report — total receivables by aging bucket, aging trend vs. prior week, top 50 accounts by outstanding balance, accounts newly entering 60+ day aging, bad debt exposure estimate; system auto-calculates DSO (Days Sales Outstanding) and CEI (Collection Effectiveness Index)
Responsible (R): AR Supervisor
Accountable (A): Credit Manager
Duration: 2 hours/week</bpmn:documentation>
        <bpmn:incoming>W1540_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1540_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1540_Task9" name="Collection priority scoring">
        <bpmn:documentation>Step 4: Collection priority scoring: System assigns collection priority score to each overdue account based on: (a) aging days (longer overdue = higher priority), (b) outstanding amount (higher amount = higher priority), (c) payment history score (chronic late payer = higher priority), (d) customer tier (Platinum/Gold accounts get dedicated attention), (e) recent order activity (active accounts prioritized over dormant); generates prioritized collection queue for Collection Agents
Responsible (R): System
Accountable (A): AR Supervisor
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1540_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1540_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1540_Task10" name="Collection activity execution">
        <bpmn:documentation>Step 5: Collection activity execution: Collection Agents work the prioritized queue — (a) send automated reminder for 1–30 day aging (email + SMS), (b) phone call for 31–60 day aging with promise-to-pay tracking, (c) formal demand letter for 61–90 day aging, (d) credit hold and escalation to Credit Manager for &gt; 90 day aging; all activities logged in collection system with timestamps and outcomes
Responsible (R): Collection Agents
Accountable (A): AR Supervisor
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1540_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1540_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1540_Task11" name="Trade Account Manager coordination">
        <bpmn:documentation>Step 6: Trade Account Manager coordination: For high-priority accounts (top 50 by exposure) and Platinum/Gold accounts in aging, AR Supervisor coordinates with Trade Account Manager — leverages relationship for collection while maintaining commercial relationship; joint call strategy for disputed accounts
Responsible (R): AR Supervisor / Trade Account Manager
Accountable (A): CFO
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W1540_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1540_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1540_End12" name="Complete">
        <bpmn:incoming>W1540_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1540_Annotation13">
        <bpmn:text>Controls: - CTL-287 (ensure controlled execution — AR &amp; Collections (PA-16.2).) | - operational: AR Supervisor review and approval gate
Owner: AR Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1540_Assoc14" sourceRef="W1540_Annotation13" targetRef="W1540_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1540_Flow15" sourceRef="W1540_Start5" targetRef="W1540_Task6" />
      <bpmn:sequenceFlow id="W1540_Flow16" sourceRef="W1540_Task6" targetRef="W1540_Task7" />
      <bpmn:sequenceFlow id="W1540_Flow17" sourceRef="W1540_Task7" targetRef="W1540_Task8" />
      <bpmn:sequenceFlow id="W1540_Flow18" sourceRef="W1540_Task8" targetRef="W1540_Task9" />
      <bpmn:sequenceFlow id="W1540_Flow19" sourceRef="W1540_Task9" targetRef="W1540_Task10" />
      <bpmn:sequenceFlow id="W1540_Flow20" sourceRef="W1540_Task10" targetRef="W1540_Task11" />
      <bpmn:sequenceFlow id="W1540_Flow21" sourceRef="W1540_Task11" targetRef="W1540_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1540_diag">
      <bpmndi:BPMNPlane id="W1540_plane" bpmnElement="W_W1540">
        <bpmndi:BPMNShape id="W1540_Lane1_di" bpmnElement="W1540_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
