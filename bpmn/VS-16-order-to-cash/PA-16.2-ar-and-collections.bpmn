    <bpmn:process id="W_W1200" name="W1200. Trade Account Monthly Statement Review, Credit Limit Recalibration &amp; Churn Prevention" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly trade account review cycle (first week of month)
Frequency: Monthly comprehensive review; weekly for high-risk accounts
Volume: ~5,200 active trade accounts; ~200 corporate accounts
Owner: AR Supervisor
Participants: AR Supervisor, Credit Analyst, Trade Sales Manager, Store Manager, Controller
Source: workflow W1200 — Trade Account Monthly Statement Review, Credit Limit Recalibration &amp; Churn Prevention</bpmn:documentation>
      <bpmn:laneSet id="W1200_LaneSet7">
        <bpmn:lane id="W1200_Lane1" name="System">
        <bpmn:flowNodeRef>W1200_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1200_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1200_Lane2" name="AR Supervisor">
        <bpmn:flowNodeRef>W1200_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1200_Lane3" name="Credit Analyst">
        <bpmn:flowNodeRef>W1200_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1200_Lane4" name="Trade Sales Manager">
        <bpmn:flowNodeRef>W1200_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1200_Lane5" name="Store Manager">
        <bpmn:flowNodeRef>W1200_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1200_Lane6" name="Controller">
        <bpmn:flowNodeRef>W1200_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1200_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1200_Start8" name="Monthly trade account review cycle (first week of month)">
        <bpmn:outgoing>W1200_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1200_Task9" name="Monthly trade account health report">
        <bpmn:documentation>Step 1: Monthly trade account health report: System generates &quot;Trade Account Health Report&quot; for all active trade and corporate accounts: (a) current balance and aging (30/60/90/120+ days), (b) credit utilization (outstanding ÷ credit limit), (c) payment behavior score (on-time % over trailing 6 months), (d) purchase volume trend (current month vs. trailing 3-month average), (e) days sales outstanding (DSO), (f) accounts flagged for: (i) credit utilization &gt; 80%, (ii) payment score &lt; 70%, (iii) purchase volume decline &gt; 30%, (iv) new account &lt; 6 months with first late payment
Responsible (R): System
Accountable (A): AR Supervisor
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1200_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1200_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1200_Task10" name="Account segmentation and prioritization">
        <bpmn:documentation>Step 2: Account segmentation and prioritization: AR Supervisor categorizes accounts into four segments: (a) Healthy (green): utilization &lt; 60%, payment score &gt; 90%, stable or growing purchases → standard monitoring, (b) Watch (yellow): utilization 60–80% or payment score 70–90% or purchase decline 15–30% → proactive outreach and possible credit limit review, (c) At Risk (orange): utilization &gt; 80% or payment score &lt; 70% or purchase decline &gt; 30% → immediate credit limit review and collection escalation per W889, (d) Churn Risk (blue): previously healthy account with sudden purchase volume decline &gt; 40% over 2 months → sales outreach for retention
Responsible (R): AR Supervisor
Accountable (A): Controller
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1200_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1200_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1200_Task11" name="Credit limit recalibration">
        <bpmn:documentation>Step 3: Credit limit recalibration: For Watch and At Risk accounts: Credit Analyst reviews account profile: (a) updates financial standing based on recent payment behavior and trade references, (b) recalculates appropriate credit limit based on: (i) trailing 6-month average monthly purchases, (ii) payment history, (iii) years of relationship, (iv) external credit data if available, (c) recommends: (i) credit limit increase (for healthy growing accounts), (ii) credit limit decrease (for deteriorating accounts), (iii) credit hold (for accounts with 120+ day overdue per W229), (d) Controller approves changes &gt; 20% or &gt; PHP 500K
Responsible (R): Credit Analyst
Accountable (A): Controller
Duration: 15 min/account</bpmn:documentation>
        <bpmn:incoming>W1200_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1200_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1200_Task12" name="Churn prevention outreach">
        <bpmn:documentation>Step 4: Churn prevention outreach: For Churn Risk accounts: Trade Sales Manager contacts customer within 5 business days: (a) determines reason for volume decline (project completed, competitor switch, financial difficulty, seasonal slowdown), (b) for competitor switch: offers competitive re-engagement package (discount, extended terms, or loyalty bonus points), (c) for financial difficulty: explores restructured payment plan or reduced credit limit, (d) for project completion: discusses upcoming project pipeline and material needs; documents outcome in CRM
Responsible (R): Trade Sales Manager
Accountable (A): VP Store Operations
Duration: 20 min/account</bpmn:documentation>
        <bpmn:incoming>W1200_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1200_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1200_Task13" name="Store-level account relationship review">
        <bpmn:documentation>Step 5: Store-level account relationship review: For trade accounts serviced primarily through specific stores: Store Manager reviews top 10 trade accounts at their store monthly: (a) discusses account health with Sales Associates who interact with the customer, (b) identifies opportunities for cross-sell or upsell based on purchase history, (c) escalates any relationship concerns (complaints, competitor interest) to Trade Sales Manager
Responsible (R): Store Manager
Accountable (A): Trade Sales Manager
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W1200_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1200_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1200_Task14" name="Executive review">
        <bpmn:documentation>Step 6: Executive review: Quarterly: Controller presents trade portfolio summary to CFO: (a) total trade receivable balance and aging distribution, (b) bad debt expense trend and allowance adequacy, (c) portfolio quality distribution (Healthy/Watch/At Risk/Default), (d) credit limit changes summary, (e) churn rate and recovery rate, (f) recommended reserve adjustments and write-off proposals
Responsible (R): Controller
Accountable (A): CFO
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1200_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1200_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1200_End15" name="Complete">
        <bpmn:incoming>W1200_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1200_Annotation16">
        <bpmn:text>Controls: - CTL-287 (ensure controlled execution — AR &amp; Collections (PA-16.2).) | - operational: conservative initial credit limits (W160), regular recalibration, and credit insurance for limits &gt; PHP 1M; operational: system-driven segmentation in Step 2 and Controller approval requirement in Step 3; operational: comparing to same-month prior year rather than trailing 3-month average
Owner: AR Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1200_Assoc17" sourceRef="W1200_Annotation16" targetRef="W1200_Start8" associationDirection="None" />
      <bpmn:sequenceFlow id="W1200_Flow18" sourceRef="W1200_Start8" targetRef="W1200_Task9" />
      <bpmn:sequenceFlow id="W1200_Flow19" sourceRef="W1200_Task9" targetRef="W1200_Task10" />
      <bpmn:sequenceFlow id="W1200_Flow20" sourceRef="W1200_Task10" targetRef="W1200_Task11" />
      <bpmn:sequenceFlow id="W1200_Flow21" sourceRef="W1200_Task11" targetRef="W1200_Task12" />
      <bpmn:sequenceFlow id="W1200_Flow22" sourceRef="W1200_Task12" targetRef="W1200_Task13" />
      <bpmn:sequenceFlow id="W1200_Flow23" sourceRef="W1200_Task13" targetRef="W1200_Task14" />
      <bpmn:sequenceFlow id="W1200_Flow24" sourceRef="W1200_Task14" targetRef="W1200_End15" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1200_diag">
      <bpmndi:BPMNPlane id="W1200_plane" bpmnElement="W_W1200">
        <bpmndi:BPMNShape id="W1200_Lane1_di" bpmnElement="W1200_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1200_Lane2_di" bpmnElement="W1200_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1200_Lane3_di" bpmnElement="W1200_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1580" height="170" /></bpmndi:BPMNShape>
