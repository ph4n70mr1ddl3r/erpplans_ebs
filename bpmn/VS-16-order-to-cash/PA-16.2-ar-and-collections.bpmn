<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-16.2-ar-and-collections" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W889" name="W889. Customer AR Aging Analysis &amp; Collection Prioritization" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly collection cycle; daily for high-risk accounts
Frequency: Weekly (comprehensive); daily (exception monitoring)
Volume: ~5,200 trade accounts + ~200 corporate accounts; ~3,500 AR invoices/month
Owner: AR Supervisor
Participants: AR Clerk, Sales Rep, Finance Manager
Source: workflow W889 — Customer AR Aging Analysis &amp; Collection Prioritization</bpmn:documentation>
      <bpmn:laneSet id="W889_LaneSet4">
        <bpmn:lane id="W889_Lane1" name="System">
        <bpmn:flowNodeRef>W889_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W889_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W889_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W889_Lane2" name="AR Clerk">
        <bpmn:flowNodeRef>W889_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W889_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W889_Lane3" name="AR Supervisor">
        <bpmn:flowNodeRef>W889_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W889_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W889_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W889_Start5" name="Weekly collection cycle; daily for high-risk accounts">
        <bpmn:outgoing>W889_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W889_Task6" name="System generates AR aging report by bucket (current, 1–30, 31–60, 61–90…">
        <bpmn:documentation>Step 1: System generates AR aging report by bucket (current, 1–30, 31–60, 61–90, 91–120, &gt; 120 days) segmented by entity, customer tier, and collection officer
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W889_Flow15</bpmn:incoming>
        <bpmn:outgoing>W889_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W889_Task7" name="AR Clerk reviews aging and flags accounts requiring action: (a) accounts…">
        <bpmn:documentation>Step 2: AR Clerk reviews aging and flags accounts requiring action: (a) accounts crossing 30-day threshold for first reminder, (b) accounts in 61–90 day bucket for escalation, (c) accounts &gt; 90 days for write-off assessment per W81
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 1 hour/week</bpmn:documentation>
        <bpmn:incoming>W889_Flow16</bpmn:incoming>
        <bpmn:outgoing>W889_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W889_Task8" name="AR Clerk prioritizes collection queue by: (a) amount at risk (largest balances…">
        <bpmn:documentation>Step 3: AR Clerk prioritizes collection queue by: (a) amount at risk (largest balances first), (b) aging severity, (c) customer tier (corporate &gt; trade), (d) payment history score, (e) sales rep input on customer situation
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 30 min/week</bpmn:documentation>
        <bpmn:incoming>W889_Flow17</bpmn:incoming>
        <bpmn:outgoing>W889_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W889_Task9" name="AR Supervisor assigns collection accounts to AR Clerks balanced by load and…">
        <bpmn:documentation>Step 4: AR Supervisor assigns collection accounts to AR Clerks balanced by load and territory
Responsible (R): AR Supervisor
Accountable (A): —
Duration: 15 min/week</bpmn:documentation>
        <bpmn:incoming>W889_Flow18</bpmn:incoming>
        <bpmn:outgoing>W889_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W889_Task10" name="Weekly collection review meeting: AR Supervisor, AR Clerks, and Sales Reps…">
        <bpmn:documentation>Step 5: Weekly collection review meeting: AR Supervisor, AR Clerks, and Sales Reps review top 20 overdue accounts, agree on action plan per account (call, visit, demand letter, legal referral)
Responsible (R): AR Supervisor
Accountable (A): Finance Manager
Duration: 1 hour/week</bpmn:documentation>
        <bpmn:incoming>W889_Flow19</bpmn:incoming>
        <bpmn:outgoing>W889_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W889_Task11" name="System generates DSO (Days Sales Outstanding) and collection effectiveness…">
        <bpmn:documentation>Step 6: System generates DSO (Days Sales Outstanding) and collection effectiveness index (CEI) metrics for management reporting per W35
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W889_Flow20</bpmn:incoming>
        <bpmn:outgoing>W889_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W889_End12" name="Complete">
        <bpmn:incoming>W889_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W889_Annotation13">
        <bpmn:text>Controls: - CTL-287 (ensure controlled execution — AR &amp; Collections (PA-16.2).) | - operational: AR Supervisor review and approval gate
Owner: AR Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W889_Assoc14" sourceRef="W889_Annotation13" targetRef="W889_Start5" associationDirection="None" />
