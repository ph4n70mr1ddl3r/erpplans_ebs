        <bpmndi:BPMNShape id="W1200_Task10_di" bpmnElement="W1200_Task10"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1200_Task11_di" bpmnElement="W1200_Task11"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1200_Task12_di" bpmnElement="W1200_Task12"><dc:Bounds x="1030" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1200_Task13_di" bpmnElement="W1200_Task13"><dc:Bounds x="1240" y="805" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1200_Task14_di" bpmnElement="W1200_Task14"><dc:Bounds x="1450" y="975" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1200_Start8_di" bpmnElement="W1200_Start8"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
