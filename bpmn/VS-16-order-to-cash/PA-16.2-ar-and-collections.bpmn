        <bpmndi:BPMNEdge id="W1200_Flow21_di" bpmnElement="W1200_Flow21"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1200_Flow22_di" bpmnElement="W1200_Flow22"><di:waypoint x="1210" y="675" /><di:waypoint x="1240" y="845" /></bpmndi:BPMNEdge>
