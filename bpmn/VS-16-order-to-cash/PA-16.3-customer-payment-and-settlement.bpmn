      <bpmn:sequenceFlow id="W1326_Flow17" sourceRef="W1326_Task7" targetRef="W1326_Task8" />
      <bpmn:sequenceFlow id="W1326_Flow18" sourceRef="W1326_Task8" targetRef="W1326_Task9" />
      <bpmn:sequenceFlow id="W1326_Flow19" sourceRef="W1326_Task9" targetRef="W1326_Task10" />
      <bpmn:sequenceFlow id="W1326_Flow20" sourceRef="W1326_Task10" targetRef="W1326_Task11" />
      <bpmn:sequenceFlow id="W1326_Flow21" sourceRef="W1326_Task11" targetRef="W1326_Task12" />
      <bpmn:sequenceFlow id="W1326_Flow22" sourceRef="W1326_Task12" targetRef="W1326_End13" />
    </bpmn:process>
