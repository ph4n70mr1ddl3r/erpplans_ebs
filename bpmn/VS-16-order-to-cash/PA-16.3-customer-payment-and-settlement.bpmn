      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1380" name="W1380. Customer Post-Dated Check (PDC) Receipt, Register Management &amp; Bank Deposit Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Trade or corporate account customer tenders post-dated check(s) as payment for outstanding AR invoices
Frequency: Daily; ~50–80 PDCs received per week across 5 entities
Volume: ~2,500–4,000 PDCs/year; average PDC value PHP 30,000–200,000
Owner: AR Clerk
Participants: AR Clerk, AR Supervisor, Treasury Analyst, Bank
Source: workflow W1380 — Customer Post-Dated Check (PDC) Receipt, Register Management &amp; Bank Deposit Processing</bpmn:documentation>
      <bpmn:laneSet id="W1380_LaneSet5">
        <bpmn:lane id="W1380_Lane1" name="AR Clerk">
        <bpmn:flowNodeRef>W1380_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1380_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1380_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1380_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1380_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1380_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1380_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1380_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1380_Lane2" name="System">
        <bpmn:flowNodeRef>W1380_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1380_Lane3" name="Treasury Analyst">
        <bpmn:flowNodeRef>W1380_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1380_Lane4" name="AR Supervisor">
        <bpmn:flowNodeRef>W1380_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1380_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1380_Start6" name="Trade or corporate account customer tenders post-dated check(s) as payment for…">
        <bpmn:outgoing>W1380_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1380_Task7" name="AR Clerk receives PDC from customer (mail, courier, or in-person); verifies…">
        <bpmn:documentation>Step 1: AR Clerk receives PDC from customer (mail, courier, or in-person); verifies: (a) check is properly filled out (payee = correct BuildRight entity, amount matches invoice, signature present), (b) check date is in the future, (c) check is not stale-dated (Philippine checks valid for 6 months from date), (d) bank name and branch are legible, (e) amount in words matches amount in figures
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 3 min/PDC</bpmn:documentation>
        <bpmn:incoming>W1380_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1380_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1380_Task8" name="AR Clerk records PDC in system: (a) check number, bank, branch, date, amount…">
        <bpmn:documentation>Step 2: AR Clerk records PDC in system: (a) check number, bank, branch, date, amount, customer account, invoice reference(s), receipt date; (b) system creates PDC register entry with status &quot;Held&quot;; (c) system posts entry: Dr. PDC Receivable (asset) / Cr. Accounts Receivable — Customer; this removes the invoice from AR aging and moves it to PDC held status; (d) allocation rules — a PDC covering multiple invoices is applied per the customer&#x27;s remittance advice, or oldest-invoice-first (FIFO) if unspecified, with any residual held on-account; (e) on-account PDCs (no invoice reference — e.g., security for future purchases or a payment-plan installment) are recorded as an on-account credit (Dr. PDC Receivable / Cr. Customer on-account credit) and do not touch AR aging; (f) credit-limit relief rule — invoices covered by a registered PDC restore available credit up to the applied amount (consumed by W572 credit monitoring); on-account PDCs restore credit only when applied to invoices
Responsible (R): AR Clerk
Accountable (A): —
Duration: 3 min/PDC</bpmn:documentation>
        <bpmn:incoming>W1380_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1380_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1380_Task9" name="AR Clerk stores physical PDC in secure PDC vault/cabinet at HQ or shared…">
        <bpmn:documentation>Step 3: AR Clerk stores physical PDC in secure PDC vault/cabinet at HQ or shared services; vault access restricted to AR Supervisor and authorized AR Clerks; PDCs organized by deposit month for easy retrieval
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 2 min/PDC</bpmn:documentation>
        <bpmn:incoming>W1380_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1380_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1380_Task10" name="System generates PDC maturity reports from the register: a weekly…">
        <bpmn:documentation>Step 4: System generates PDC maturity reports from the register: a weekly 7-business-day look-ahead (all PDCs maturing in the next 7 business days, sorted by entity and bank) for deposit planning, and a daily T-1 execution list of checks maturing tomorrow (worked by Treasury per W423)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1380_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1380_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1380_Task11" name="AR Clerk retrieves maturing PDCs from vault; prepares bank deposit slip per…">
        <bpmn:documentation>Step 5: AR Clerk retrieves maturing PDCs from vault; prepares bank deposit slip per bank; endorses checks (signs back); bundles by deposit bank; takes to bank for deposit
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 1 hour/week</bpmn:documentation>
        <bpmn:incoming>W1380_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1380_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1380_Task12" name="Bank processes deposit; AR Clerk obtains deposit confirmation; system updates…">
        <bpmn:documentation>Step 6: Bank processes deposit; AR Clerk obtains deposit confirmation; system updates PDC register status to &quot;Deposited&quot;; system posts: Dr. Cash in Bank / Cr. PDC Receivable
Responsible (R): AR Clerk / System
Accountable (A): —
Duration: 5 min/batch</bpmn:documentation>
        <bpmn:incoming>W1380_Flow25</bpmn:incoming>
        <bpmn:outgoing>W1380_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1380_Task13" name="PDC clearance matching (feeds W89): Treasury Analyst matches bank clearance of…">
        <bpmn:documentation>Step 7: PDC clearance matching (feeds W89): Treasury Analyst matches bank clearance of deposited PDCs against the GL Accountant&#x27;s W89 statement lines; if check clears — status updated to &quot;Cleared&quot;; if check bounces (DAIF/DAUD) — route to W1381
Responsible (R): Treasury Analyst
Accountable (A): —
Duration: Part of W89</bpmn:documentation>
        <bpmn:incoming>W1380_Flow26</bpmn:incoming>
        <bpmn:outgoing>W1380_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1380_Task14" name="Stale-Date Watch">
        <bpmn:documentation>Step 8: Stale-Date Watch: monthly (plus automated alert 60 days ahead), AR Clerk reviews warehoused PDCs whose 6-month validity horizon approaches without deposit (held back for dispute, lost, or customer request); escalates to the customer for replacement; if not replaced before expiry, system reverses the receipt (Dr. Accounts Receivable / Cr. PDC Receivable), reinstating the invoice in AR aging, and notifies W572 credit monitoring
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W1380_Flow27</bpmn:incoming>
        <bpmn:outgoing>W1380_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1380_Task15" name="Customer-Requested Return / Replacement / Stop-Payment">
        <bpmn:documentation>Step 9: Customer-Requested Return / Replacement / Stop-Payment: (a) pre-maturity return at customer request (e.g., switching to electronic payment): register status &quot;Returned&quot;; GL Dr. Accounts Receivable / Cr. PDC Receivable (reinstates covered invoices); physical handover against a customer-signed acknowledgment receipt; (b) lost/damaged PDC or customer stop-payment: original marked &quot;Cancelled — Replaced&quot; (or &quot;Cancelled — Stop Payment&quot;), replacement check processed per steps 1–3
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 15 min/case</bpmn:documentation>
        <bpmn:incoming>W1380_Flow28</bpmn:incoming>
        <bpmn:outgoing>W1380_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1380_Task16" name="Monthly Vault Count">
        <bpmn:documentation>Step 10: Monthly Vault Count: AR Supervisor and Treasury jointly count physical PDCs against the register (executed as W423 step 7); count sheet retained as audit evidence; discrepancies investigated same day
Responsible (R): AR Supervisor
Accountable (A): Controller
Duration: Part of W423</bpmn:documentation>
        <bpmn:incoming>W1380_Flow29</bpmn:incoming>
        <bpmn:outgoing>W1380_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1380_End17" name="Complete">
        <bpmn:incoming>W1380_Flow30</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1380_Annotation18">
        <bpmn:text>Controls: - CTL-288 (ensure controlled execution — Customer Payment &amp; Settlement (PA-16.3).) | - operational: periodic reconciliation against source documents
Owner: AR Clerk</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1380_Assoc19" sourceRef="W1380_Annotation18" targetRef="W1380_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1380_Flow20" sourceRef="W1380_Start6" targetRef="W1380_Task7" />
      <bpmn:sequenceFlow id="W1380_Flow21" sourceRef="W1380_Task7" targetRef="W1380_Task8" />
      <bpmn:sequenceFlow id="W1380_Flow22" sourceRef="W1380_Task8" targetRef="W1380_Task9" />
      <bpmn:sequenceFlow id="W1380_Flow23" sourceRef="W1380_Task9" targetRef="W1380_Task10" />
      <bpmn:sequenceFlow id="W1380_Flow24" sourceRef="W1380_Task10" targetRef="W1380_Task11" />
      <bpmn:sequenceFlow id="W1380_Flow25" sourceRef="W1380_Task11" targetRef="W1380_Task12" />
      <bpmn:sequenceFlow id="W1380_Flow26" sourceRef="W1380_Task12" targetRef="W1380_Task13" />
      <bpmn:sequenceFlow id="W1380_Flow27" sourceRef="W1380_Task13" targetRef="W1380_Task14" />
      <bpmn:sequenceFlow id="W1380_Flow28" sourceRef="W1380_Task14" targetRef="W1380_Task15" />
      <bpmn:sequenceFlow id="W1380_Flow29" sourceRef="W1380_Task15" targetRef="W1380_Task16" />
      <bpmn:sequenceFlow id="W1380_Flow30" sourceRef="W1380_Task16" targetRef="W1380_End17" />
    </bpmn:process>
