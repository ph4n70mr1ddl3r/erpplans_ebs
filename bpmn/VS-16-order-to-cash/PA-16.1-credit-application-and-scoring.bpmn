      <bpmn:sequenceFlow id="W886_Flow21" sourceRef="W886_Task10" targetRef="W886_Task11" />
      <bpmn:sequenceFlow id="W886_Flow22" sourceRef="W886_Task11" targetRef="W886_Task12" />
      <bpmn:sequenceFlow id="W886_Flow23" sourceRef="W886_Task12" targetRef="W886_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W886_diag">
      <bpmndi:BPMNPlane id="W886_plane" bpmnElement="W_W886">
        <bpmndi:BPMNShape id="W886_Lane1_di" bpmnElement="W886_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W886_Lane2_di" bpmnElement="W886_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W886_Lane3_di" bpmnElement="W886_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W886_Task6_di" bpmnElement="W886_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W886_Task7_di" bpmnElement="W886_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W886_Task8_di" bpmnElement="W886_Task8"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W886_Task9_di" bpmnElement="W886_Task9"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
