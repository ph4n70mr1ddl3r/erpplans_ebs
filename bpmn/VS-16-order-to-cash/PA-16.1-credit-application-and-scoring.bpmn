    <bpmn:process id="W_W663" name="W663. Customer Credit Portfolio Periodic Review &amp; Collection Strategy" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly credit portfolio review cycle
Frequency: Monthly operational review; quarterly strategic review
Volume: ~5,200 trade accounts + ~200 corporate accounts; ~PHP 1.5–2.0B total AR portfolio (per W1300)
Owner: Credit Manager
Participants: Credit Analyst, Collection Officer, Finance Manager, Head of Trade / Account Management
Source: workflow W663 — Customer Credit Portfolio Periodic Review &amp; Collection Strategy</bpmn:documentation>
      <bpmn:laneSet id="W663_LaneSet4">
        <bpmn:lane id="W663_Lane1" name="Credit Manager">
        <bpmn:flowNodeRef>W663_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W663_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W663_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W663_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W663_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W663_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W663_Lane2" name="Credit Analyst">
        <bpmn:flowNodeRef>W663_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W663_Lane3" name="Collection Officer">
        <bpmn:flowNodeRef>W663_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W663_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W663_Start5" name="Monthly credit portfolio review cycle">
        <bpmn:outgoing>W663_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W663_Task6" name="System generates credit portfolio dashboard: total AR, aging distribution, DSO…">
        <bpmn:documentation>Step 1: System generates credit portfolio dashboard: total AR, aging distribution, DSO, bad debt provision, credit utilization rate, portfolio concentration (top 20 accounts as % of total AR)
Responsible (R): Credit Manager
Accountable (A): Credit Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W663_Flow16</bpmn:incoming>
        <bpmn:outgoing>W663_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W663_Task7" name="Credit Manager reviews portfolio health metrics vs. policy targets: DSO target…">
        <bpmn:documentation>Step 2: Credit Manager reviews portfolio health metrics vs. policy targets: DSO target ≤ 45 days, 90+ aging ≤ 8%, annual bad debt ≤ 0.5% of revenue
Responsible (R): Credit Manager
Accountable (A): Finance Manager
Duration: 1 hr</bpmn:documentation>
        <bpmn:incoming>W663_Flow17</bpmn:incoming>
        <bpmn:outgoing>W663_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W663_Task8" name="Credit Analyst identifies accounts requiring individual review: accounts…">
        <bpmn:documentation>Step 3: Credit Analyst identifies accounts requiring individual review: accounts approaching credit limit (&gt; 85% utilization), accounts with aging &gt; 60 days, accounts with recent bounced checks per W1381, accounts with declining order frequency
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: 2 hrs</bpmn:documentation>
        <bpmn:incoming>W663_Flow18</bpmn:incoming>
        <bpmn:outgoing>W663_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W663_Task9" name="Collection Officer reviews active collection actions per W108: promise-to-pay…">
        <bpmn:documentation>Step 4: Collection Officer reviews active collection actions per W108: promise-to-pay compliance, legal collection status, write-off candidates per W81
Responsible (R): Collection Officer
Accountable (A): Credit Manager
Duration: 1 hr</bpmn:documentation>
        <bpmn:incoming>W663_Flow19</bpmn:incoming>
        <bpmn:outgoing>W663_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W663_Task10" name="Credit Manager develops collection strategy adjustments: tighten terms for…">
        <bpmn:documentation>Step 5: Credit Manager develops collection strategy adjustments: tighten terms for high-risk segments, offer early payment incentives for 90+ accounts, escalate top 20 overdue accounts to Head of Trade / Account Management for relationship intervention
Responsible (R): Credit Manager
Accountable (A): Head of Trade / Account Management
Duration: 1 hr</bpmn:documentation>
        <bpmn:incoming>W663_Flow20</bpmn:incoming>
        <bpmn:outgoing>W663_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W663_Task11" name="Monthly: Credit Manager produces portfolio report for Finance Manager…">
        <bpmn:documentation>Step 6: Monthly: Credit Manager produces portfolio report for Finance Manager; Quarterly: strategic review with Head of Trade / Account Management and CFO including portfolio risk assessment, industry sector analysis (construction, government, developer), and provision adequacy review
Responsible (R): Credit Manager
Accountable (A): Finance Manager
Duration: 2 hrs</bpmn:documentation>
        <bpmn:incoming>W663_Flow21</bpmn:incoming>
        <bpmn:outgoing>W663_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W663_Task12" name="Credit Manager updates credit policy parameters based on portfolio review…">
        <bpmn:documentation>Step 7: Credit Manager updates credit policy parameters based on portfolio review findings (risk scoring model thresholds, sector limits, automatic hold triggers)
Responsible (R): Credit Manager
Accountable (A): Finance Manager
Duration: 1 hr</bpmn:documentation>
        <bpmn:incoming>W663_Flow22</bpmn:incoming>
        <bpmn:outgoing>W663_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W663_End13" name="Complete">
        <bpmn:incoming>W663_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W663_Annotation14">
        <bpmn:text>Controls: - CTL-286 (ensure controlled execution — Credit Application &amp; Scoring (PA-16.1).) | - operational: Credit Manager review and approval gate
Owner: Credit Manager</bpmn:text>
      </bpmn:textAnnotation>
