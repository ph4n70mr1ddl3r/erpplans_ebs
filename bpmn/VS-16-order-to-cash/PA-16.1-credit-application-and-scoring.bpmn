      <bpmn:sequenceFlow id="W887_Flow19" sourceRef="W887_Task8" targetRef="W887_Task9" />
      <bpmn:sequenceFlow id="W887_Flow20" sourceRef="W887_Task9" targetRef="W887_Task10" />
      <bpmn:sequenceFlow id="W887_Flow21" sourceRef="W887_Task10" targetRef="W887_Task11" />
      <bpmn:sequenceFlow id="W887_Flow22" sourceRef="W887_Task11" targetRef="W887_End12" />
    </bpmn:process>
