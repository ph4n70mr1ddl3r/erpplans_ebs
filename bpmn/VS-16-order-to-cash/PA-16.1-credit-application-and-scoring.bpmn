      <bpmn:sequenceFlow id="W24_Flow24" sourceRef="W24_Task12" targetRef="W24_Task13" />
      <bpmn:sequenceFlow id="W24_Flow25" sourceRef="W24_Task13" targetRef="W24_End14" />
    </bpmn:process>
