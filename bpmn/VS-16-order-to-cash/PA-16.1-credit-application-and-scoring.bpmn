<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-16.1-credit-application-and-scoring" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W24" name="W24. Trade &amp; Corporate Credit Application" isExecutable="false">
      <bpmn:documentation>Trigger: Customer applies for trade or corporate credit account
Frequency: ~100–150 new credit applications/month
Volume: ~5,200 active trade accounts; ~200 corporate accounts
Owner: AR Supervisor
Participants: Sales Rep, AR Clerk, AR Supervisor, Finance Manager, Credit Committee
Source: workflow W24 — Trade &amp; Corporate Credit Application</bpmn:documentation>
      <bpmn:laneSet id="W24_LaneSet4">
        <bpmn:lane id="W24_Lane1" name="Customer">
        <bpmn:flowNodeRef>W24_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W24_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W24_Lane2" name="AR Clerk">
        <bpmn:flowNodeRef>W24_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W24_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W24_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W24_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W24_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W24_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W24_Lane3" name="Approver">
        <bpmn:flowNodeRef>W24_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W24_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W24_Start5" name="Customer applies for trade or corporate credit account">
        <bpmn:outgoing>W24_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W24_Task6" name="Customer submits credit application (in-store, via Sales Rep, or online form)">
        <bpmn:documentation>Step 1: Customer submits credit application (in-store, via Sales Rep, or online form)
Responsible (R): Customer / Sales Rep
Accountable (A): AR Clerk
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W24_Flow17</bpmn:incoming>
        <bpmn:outgoing>W24_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W24_Task7" name="AR Clerk verifies application completeness: business registration, financial…">
        <bpmn:documentation>Step 2: AR Clerk verifies application completeness: business registration, financial statements, trade references
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W24_Flow18</bpmn:incoming>
        <bpmn:outgoing>W24_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W24_Task8" name="AR Clerk runs credit check (bank references, trade references, external credit…">
        <bpmn:documentation>Step 3: AR Clerk runs credit check (bank references, trade references, external credit bureau if available)
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W24_Flow19</bpmn:incoming>
        <bpmn:outgoing>W24_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W24_Task9" name="AR Clerk prepares credit assessment with recommended limit and terms">
        <bpmn:documentation>Step 4: AR Clerk prepares credit assessment with recommended limit and terms
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W24_Flow20</bpmn:incoming>
        <bpmn:outgoing>W24_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W24_Task10" name="Approval per tier (see matrix below)">
        <bpmn:documentation>Step 5: Approval per tier (see matrix below)
Responsible (R): Approver
Accountable (A): Approver
Duration: 10–30 min</bpmn:documentation>
        <bpmn:incoming>W24_Flow21</bpmn:incoming>
        <bpmn:outgoing>W24_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W24_Task11" name="System creates customer account with approved credit limit, payment terms, and…">
        <bpmn:documentation>Step 6: System creates customer account with approved credit limit, payment terms, and entity assignment
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W24_Flow22</bpmn:incoming>
        <bpmn:outgoing>W24_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W24_Task12" name="Customer notified of approval; account activated">
        <bpmn:documentation>Step 7: Customer notified of approval; account activated
Responsible (R): AR Clerk
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W24_Flow23</bpmn:incoming>
        <bpmn:outgoing>W24_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W24_Task13" name="Annual credit review: AR Clerk reviews all accounts for limit adjustment…">
        <bpmn:documentation>Step 8: Annual credit review: AR Clerk reviews all accounts for limit adjustment (increase, decrease, or suspension)
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 5 min/account</bpmn:documentation>
        <bpmn:incoming>W24_Flow24</bpmn:incoming>
        <bpmn:outgoing>W24_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W24_End14" name="Complete">
        <bpmn:incoming>W24_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W24_Annotation15">
        <bpmn:text>Controls: - CTL-12 (separate credit approval from sales execution.); CTL-43 (prevent Sales Rep self-approval of credit limits on own accounts.) | - operational: AR Supervisor review and approval gate
Owner: AR Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W24_Assoc16" sourceRef="W24_Annotation15" targetRef="W24_Start5" associationDirection="None" />
