        <bpmndi:BPMNShape id="W663_Annotation14_di" bpmnElement="W663_Annotation14"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W663_Flow16_di" bpmnElement="W663_Flow16"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W663_Flow17_di" bpmnElement="W663_Flow17"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W663_Flow18_di" bpmnElement="W663_Flow18"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W663_Flow19_di" bpmnElement="W663_Flow19"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W663_Flow20_di" bpmnElement="W663_Flow20"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W663_Flow21_di" bpmnElement="W663_Flow21"><di:waypoint x="1420" y="165" /><di:waypoint x="1450" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W663_Flow22_di" bpmnElement="W663_Flow22"><di:waypoint x="1630" y="165" /><di:waypoint x="1660" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W663_Flow23_di" bpmnElement="W663_Flow23"><di:waypoint x="1840" y="165" /><di:waypoint x="1890" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W663_Assoc15_di" bpmnElement="W663_Assoc15"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W712" name="W712. Financial Restatement &amp; Prior-Year Adjustment Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Discovery of material error in posted financial statements; external auditor adjustment during annual audit per W351; BIR assessment requiring correction of prior-period tax filing; management-initiated correction of accounting policy misapplication
Frequency: Ad-hoc (rare)
Volume: ~5–10 material restatements per year
Owner: Controller
Participants: Finance Manager, Tax Accountant, External Auditor, CFO, VP Legal
Source: workflow W712 — Financial Restatement &amp; Prior-Year Adjustment Processing</bpmn:documentation>
      <bpmn:laneSet id="W712_LaneSet4">
        <bpmn:lane id="W712_Lane1" name="Controller">
        <bpmn:flowNodeRef>W712_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W712_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W712_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W712_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W712_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W712_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W712_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W712_Lane2" name="CFO">
        <bpmn:flowNodeRef>W712_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W712_Lane3" name="Finance Manager">
        <bpmn:flowNodeRef>W712_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W712_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W712_Start5" name="Discovery of material error in posted financial statements; external auditor adjustment…">
        <bpmn:outgoing>W712_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W712_Task6" name="Error identification and assessment">
        <bpmn:documentation>Step 1: Error identification and assessment: (a) source identifies error: internal discovery (month-end review, internal audit per W121, reconciliation per W636), external auditor per W351, or BIR assessment per W77; (b) Controller performs materiality assessment: quantify financial impact on each affected entity and consolidated group; (c) determine if error is material (requires restatement) or immaterial (prospectively corrected per W638); (d) if material: escalate to CFO with written assessment
Responsible (R): Controller
Accountable (A): CFO
Duration: 2-4 hours</bpmn:documentation>
        <bpmn:incoming>W712_Flow17</bpmn:incoming>
        <bpmn:outgoing>W712_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W712_Task7" name="Restatement scoping">
        <bpmn:documentation>Step 2: Restatement scoping: Controller and Finance Manager define scope: (a) identify all affected periods (current year, prior years); (b) identify all affected entities (1-5 entities depending on error); (c) map impact to: income statement lines, balance sheet accounts, cash flow items, equity changes; (d) assess tax impact: VAT, income tax, withholding tax, local business tax; (e) identify downstream impacts: budget variance per W26, management reporting per W35, KPI calculations per W665; (f) prepare restatement memo documenting error, impact, and proposed correction
Responsible (R): Controller / Finance Manager
Accountable (A): CFO
Duration: 4-8 hours</bpmn:documentation>
        <bpmn:incoming>W712_Flow18</bpmn:incoming>
        <bpmn:outgoing>W712_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W712_Task8" name="CFO and Audit Committee approval">
        <bpmn:documentation>Step 3: CFO and Audit Committee approval: (a) CFO reviews restatement memo; (b) if error affects consolidated financial statements: present to Audit Committee for approval before execution; (c) if error affects BIR filings: engage VP Legal for assessment of penalty exposure and voluntary disclosure strategy; (d) approved restatement plan documented with authorization signatures
Responsible (R): CFO
Accountable (A): Audit Committee
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W712_Flow19</bpmn:incoming>
        <bpmn:outgoing>W712_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W712_Task9" name="Journal entry preparation">
        <bpmn:documentation>Step 4: Journal entry preparation: Tax Accountant / Finance Manager prepares correcting entries: (a) prior-year adjustments posted to retained earnings (per PFRS/PAS 8 retrospective application); (b) current-year corrections posted to affected accounts with detailed supporting schedules; (c) multi-entity entries: IC adjustments if error affected intercompany transactions per W14; (d) tax adjustments: correcting entries for VAT, income tax, withholding tax as needed; (e) all entries reviewed by Controller before posting
Responsible (R): Finance Manager / Tax Accountant
Accountable (A): Controller
Duration: 4-8 hours per entity</bpmn:documentation>
        <bpmn:incoming>W712_Flow20</bpmn:incoming>
        <bpmn:outgoing>W712_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W712_Task10" name="Period-end journal entry review per W638">
        <bpmn:documentation>Step 5: Period-end journal entry review per W638: correcting entries submitted through W638 review and approval process with enhanced scrutiny: (a) Controller reviews all restatement journal entries; (b) dual approval required: Controller + CFO; (c) entries posted with special &quot;Restatement&quot; flag in audit trail; (d) system generates restatement-specific audit log
Responsible (R): Controller / CFO
Accountable (A): CFO
Duration: 2-4 hours</bpmn:documentation>
        <bpmn:incoming>W712_Flow21</bpmn:incoming>
        <bpmn:outgoing>W712_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W712_Task11" name="Financial statement revision and re-issuance">
        <bpmn:documentation>Step 6: Financial statement revision and re-issuance: (a) revise affected financial statements for all impacted periods; (b) update comparative figures (prior year columns) per PFRS/PAS 8; (c) prepare revised notes to financial statements with restatement disclosure; (d) if previously filed with SEC: prepare and file amended AFS per W481; (e) if previously filed with BIR: prepare and file amended tax returns per W260; (f) re-issue internal management reports for affected periods per W35
Responsible (R): Controller / Finance Manager
Accountable (A): CFO
Duration: 1-2 days</bpmn:documentation>
        <bpmn:incoming>W712_Flow22</bpmn:incoming>
        <bpmn:outgoing>W712_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W712_Task12" name="External auditor communication">
        <bpmn:documentation>Step 7: External auditor communication: (a) notify external auditor of restatement per W351 coordination; (b) provide restatement memo, supporting schedules, and corrected financial statements; (c) external auditor assesses restatement impact on their audit opinion; (d) if restatement affects current-year audit: adjust audit plan and timeline; (e) obtain external auditor sign-off on restated figures
Responsible (R): Controller
Accountable (A): CFO
Duration: 2-4 hours</bpmn:documentation>
        <bpmn:incoming>W712_Flow23</bpmn:incoming>
        <bpmn:outgoing>W712_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W712_Task13" name="Root cause analysis and controls remediation">
        <bpmn:documentation>Step 8: Root cause analysis and controls remediation: (a) Controller conducts RCA to determine how the error occurred and why it was not detected; (b) identify control failures: preventive, detective, or monitoring; (c) implement remediation: process changes, system validations, additional review steps; (d) update financial controls testing per W637; (e) document lessons learned and communicate to finance team
Responsible (R): Controller
Accountable (A): CFO
Duration: 4-8 hours</bpmn:documentation>
        <bpmn:incoming>W712_Flow24</bpmn:incoming>
        <bpmn:outgoing>W712_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W712_End14" name="Complete">
        <bpmn:incoming>W712_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W712_Annotation15">
        <bpmn:text>Controls: - CTL-286 (ensure controlled execution — Credit Application &amp; Scoring (PA-16.1).) | - operational: Controller review and approval gate; operational: periodic reconciliation against source documents
Owner: Controller</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W712_Assoc16" sourceRef="W712_Annotation15" targetRef="W712_Start5" associationDirection="None" />
