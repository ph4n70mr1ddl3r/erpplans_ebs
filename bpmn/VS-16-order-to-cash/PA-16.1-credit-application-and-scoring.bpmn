    <bpmn:process id="W_W174" name="W174. Store-Level Cash-in-Transit (CIT) &amp; Armored Car Management" isExecutable="false">
      <bpmn:documentation>Trigger: Daily store cash accumulation exceeds threshold; scheduled armoured car pickup
Frequency: Daily per store (365 days/year)
Volume: ~PHP 350K/day average cash per store (42% of ~PHP 5B monthly retail sales ÷ 200 stores ÷ 30 days)
Owner: Treasury Manager
Participants: Store Manager, Lead Cashier, Armoured Car Vendor, Treasury Analyst
Source: workflow W174 — Store-Level Cash-in-Transit (CIT) &amp; Armored Car Management</bpmn:documentation>
      <bpmn:laneSet id="W174_LaneSet5">
        <bpmn:lane id="W174_Lane1" name="Lead Cashier">
        <bpmn:flowNodeRef>W174_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W174_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W174_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W174_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W174_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W174_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W174_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W174_Lane3" name="CIT Vendor">
        <bpmn:flowNodeRef>W174_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W174_Lane4" name="Treasury Analyst">
        <bpmn:flowNodeRef>W174_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W174_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W174_Start6" name="Daily store cash accumulation exceeds threshold; scheduled armoured car pickup">
        <bpmn:outgoing>W174_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W174_Task7" name="Cash Consolidation">
        <bpmn:documentation>Step 1: Cash Consolidation: Lead Cashier performs EOD cash count; reconciles with POS Z-reports (W5F)
Responsible (R): Lead Cashier
Accountable (A): Store Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W174_Flow17</bpmn:incoming>
        <bpmn:outgoing>W174_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W174_Task8" name="Secure Bagging">
        <bpmn:documentation>Step 2: Secure Bagging: Reconciled cash placed in tamper-evident CIT bags with serialized seals; system logs seal numbers
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W174_Flow18</bpmn:incoming>
        <bpmn:outgoing>W174_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W174_Task9" name="Pickup Verification">
        <bpmn:documentation>Step 3: Pickup Verification: Armoured car arrives; Store Manager verifies guard IDs and vehicle number against authorized list
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W174_Flow19</bpmn:incoming>
        <bpmn:outgoing>W174_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W174_Task10" name="Handover">
        <bpmn:documentation>Step 4: Handover: Guard scans CIT bags; Store Manager and Guard sign electronic/physical manifest; copy stored in ERP
Responsible (R): Store Manager / Guard
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W174_Flow20</bpmn:incoming>
        <bpmn:outgoing>W174_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W174_Task11" name="System Posting">
        <bpmn:documentation>Step 5: System Posting: Store Manager marks cash as &quot;In-Transit to Bank&quot;; ERP reduces Store Cash account, increases CIT account
Responsible (R): Store Manager
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W174_Flow21</bpmn:incoming>
        <bpmn:outgoing>W174_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W174_Task12" name="Bank Acknowledgment">
        <bpmn:documentation>Step 6: Bank Acknowledgment: Bank/CIT vendor processes cash; sends daily credit report
Responsible (R): CIT Vendor
Accountable (A): —
Duration: Next Day</bpmn:documentation>
        <bpmn:incoming>W174_Flow22</bpmn:incoming>
        <bpmn:outgoing>W174_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W174_Task13" name="Reconciliation">
        <bpmn:documentation>Step 7: Reconciliation: Treasury Analyst matches Bank Credit to Store CIT record; investigates variances &gt; PHP 100
Responsible (R): Treasury Analyst
Accountable (A): Treasury Mgr
Duration: 2 hours/day</bpmn:documentation>
        <bpmn:incoming>W174_Flow23</bpmn:incoming>
        <bpmn:outgoing>W174_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W174_End14" name="Complete">
        <bpmn:incoming>W174_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W174_Annotation15">
        <bpmn:text>Controls: - CTL-286 (ensure controlled execution — Credit Application &amp; Scoring (PA-16.1).) | - operational: periodic reconciliation against source documents
Owner: Treasury Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W174_Assoc16" sourceRef="W174_Annotation15" targetRef="W174_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W174_Flow17" sourceRef="W174_Start6" targetRef="W174_Task7" />
