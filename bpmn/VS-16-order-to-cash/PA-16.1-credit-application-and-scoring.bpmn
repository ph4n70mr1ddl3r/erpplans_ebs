      <bpmn:sequenceFlow id="W888_Flow21" sourceRef="W888_Task11" targetRef="W888_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W888_diag">
      <bpmndi:BPMNPlane id="W888_plane" bpmnElement="W_W888">
        <bpmndi:BPMNShape id="W888_Lane1_di" bpmnElement="W888_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W888_Lane2_di" bpmnElement="W888_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W888_Lane3_di" bpmnElement="W888_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W888_Task6_di" bpmnElement="W888_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W888_Task7_di" bpmnElement="W888_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W888_Task8_di" bpmnElement="W888_Task8"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W888_Task9_di" bpmnElement="W888_Task9"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W888_Task10_di" bpmnElement="W888_Task10"><dc:Bounds x="1240" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W888_Task11_di" bpmnElement="W888_Task11"><dc:Bounds x="1450" y="295" width="180" height="80" /></bpmndi:BPMNShape>
