    <bpmn:process id="W_W887" name="W887. Customer Credit Limit Review, Adjustment &amp; Approval" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled review (semi-annual for new accounts, annual for established); or triggered by credit limit utilization &gt; 85%, payment pattern deterioration, or customer request for increase
Frequency: ~430 credit limit reviews per month (annual cycle for 5,200 accounts, plus ad-hoc reviews)
Volume: ~15–20% of reviews result in limit adjustment (increase or decrease)
Owner: Credit Manager / Finance Controller
Participants: Credit Analyst, Sales Representative, Customer Contact, Finance Controller
Source: workflow W887 — Customer Credit Limit Review, Adjustment &amp; Approval</bpmn:documentation>
      <bpmn:laneSet id="W887_LaneSet3">
        <bpmn:lane id="W887_Lane1" name="Credit Analyst">
        <bpmn:flowNodeRef>W887_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W887_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W887_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W887_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W887_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W887_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W887_Lane2" name="Credit Manager">
        <bpmn:flowNodeRef>W887_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W887_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W887_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W887_Start4" name="Scheduled review (semi-annual for new accounts, annual for established); or triggered by…">
        <bpmn:outgoing>W887_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W887_Task5" name="Identify accounts due for review — system generates review list based on: (a)…">
        <bpmn:documentation>Step 1: Identify accounts due for review — system generates review list based on: (a) scheduled review date, (b) limit utilization &gt; 85% for 3 consecutive months, (c) payment delinquency (any invoice &gt; 30 days past due), (d) customer request for increase, (e) significant order exceeding current limit
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: 30 min (automated list generation)</bpmn:documentation>
        <bpmn:incoming>W887_Flow15</bpmn:incoming>
        <bpmn:outgoing>W887_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W887_Task6" name="Compile review data package — for each account: (a) 12-month payment history…">
        <bpmn:documentation>Step 2: Compile review data package — for each account: (a) 12-month payment history, (b) average days-to-pay, (c) credit utilization trend, (d) order frequency and value trend, (e) any disputes or credit memos, (f) updated financial information (if available), (g) industry/economic conditions
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: 30 min per account</bpmn:documentation>
        <bpmn:incoming>W887_Flow16</bpmn:incoming>
        <bpmn:outgoing>W887_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W887_Task7" name="Assess creditworthiness update — recalculate credit score with current data…">
        <bpmn:documentation>Step 3: Assess creditworthiness update — recalculate credit score with current data: (a) payment behavior change (improving or deteriorating), (b) order volume trend, (c) outstanding AR aging, (d) any collection activity, (e) external factors (construction industry outlook, regional economic conditions)
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: 15–30 min per account</bpmn:documentation>
        <bpmn:incoming>W887_Flow17</bpmn:incoming>
        <bpmn:outgoing>W887_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W887_Task8" name="Determine credit limit recommendation — options: (a) Maintain current limit…">
        <bpmn:documentation>Step 4: Determine credit limit recommendation — options: (a) Maintain current limit, (b) Increase (if utilization consistently high and payment is timely — typically 20–50% increase), (c) Decrease (if payment deterioration — typically to 50–75% of current), (d) Suspend credit (convert to cash terms), (e) Close account (if inactive &gt; 12 months or severe default)
Responsible (R): Credit Manager
Accountable (A): Finance Controller
Duration: 15 min per account</bpmn:documentation>
        <bpmn:incoming>W887_Flow18</bpmn:incoming>
        <bpmn:outgoing>W887_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W887_Task9" name="Obtain approval — per W24&#x27;s canonical matrix (≤ PHP 200K: AR Supervisor; PHP…">
        <bpmn:documentation>Step 5: Obtain approval — per W24&#x27;s canonical matrix (≤ PHP 200K: AR Supervisor; PHP 200K–1M: Finance Manager; &gt; PHP 1M: Credit Committee); for limit decreases, Credit Manager can approve all; for suspensions, Finance Controller approval required
Responsible (R): Credit Manager
Accountable (A): Finance Controller
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W887_Flow19</bpmn:incoming>
        <bpmn:outgoing>W887_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W887_Task10" name="Communicate decision — notify Sales Representative and customer of any limit…">
        <bpmn:documentation>Step 6: Communicate decision — notify Sales Representative and customer of any limit change; for decreases: explain reason and remediation path; for increases: confirm new terms; for suspensions: coordinate transition to cash terms
Responsible (R): Credit Analyst
Accountable (A): Sales Representative
Duration: 15 min per account</bpmn:documentation>
        <bpmn:incoming>W887_Flow20</bpmn:incoming>
        <bpmn:outgoing>W887_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W887_Task11" name="Update AR module — adjust credit limit, update review date, record review…">
        <bpmn:documentation>Step 7: Update AR module — adjust credit limit, update review date, record review notes; if suspended: apply credit hold (W888)
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: 10 min per account</bpmn:documentation>
        <bpmn:incoming>W887_Flow21</bpmn:incoming>
        <bpmn:outgoing>W887_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W887_End12" name="Complete">
        <bpmn:incoming>W887_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W887_Annotation13">
        <bpmn:text>Controls: - CTL-286 (ensure controlled execution — Credit Application &amp; Scoring (PA-16.1).) | - operational: Credit Manager / Finance Controller review and approval gate
Owner: Credit Manager / Finance Controller</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W887_Assoc14" sourceRef="W887_Annotation13" targetRef="W887_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W887_Flow15" sourceRef="W887_Start4" targetRef="W887_Task5" />
