      <bpmn:sequenceFlow id="W712_Flow19" sourceRef="W712_Task7" targetRef="W712_Task8" />
      <bpmn:sequenceFlow id="W712_Flow20" sourceRef="W712_Task8" targetRef="W712_Task9" />
      <bpmn:sequenceFlow id="W712_Flow21" sourceRef="W712_Task9" targetRef="W712_Task10" />
      <bpmn:sequenceFlow id="W712_Flow22" sourceRef="W712_Task10" targetRef="W712_Task11" />
      <bpmn:sequenceFlow id="W712_Flow23" sourceRef="W712_Task11" targetRef="W712_Task12" />
      <bpmn:sequenceFlow id="W712_Flow24" sourceRef="W712_Task12" targetRef="W712_Task13" />
      <bpmn:sequenceFlow id="W712_Flow25" sourceRef="W712_Task13" targetRef="W712_End14" />
    </bpmn:process>
