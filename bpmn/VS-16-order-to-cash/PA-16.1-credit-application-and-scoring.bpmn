    <bpmn:process id="W_W886" name="W886. Customer Credit Application Processing &amp; Scoring" isExecutable="false">
      <bpmn:documentation>Trigger: New B2B customer applies for credit terms; or existing cash customer requests credit line
Frequency: ~100–150 new credit applications per month (one register with W24)
Volume: ~5,200 active AR accounts; approval rate: ~60–70% of applications
Owner: Credit Analyst / Finance Controller
Participants: Sales Representative, Credit Analyst, Credit Manager, Finance Controller, Customer Contact
Source: workflow W886 — Customer Credit Application Processing &amp; Scoring</bpmn:documentation>
      <bpmn:laneSet id="W886_LaneSet4">
        <bpmn:lane id="W886_Lane1" name="Sales Representative">
        <bpmn:flowNodeRef>W886_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W886_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W886_Lane2" name="Credit Analyst">
        <bpmn:flowNodeRef>W886_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W886_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W886_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W886_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W886_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W886_Lane3" name="Credit Manager">
        <bpmn:flowNodeRef>W886_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W886_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W886_Start5" name="New B2B customer applies for credit terms; or existing cash customer requests credit line">
        <bpmn:outgoing>W886_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W886_Task6" name="Receive credit application — Sales Representative or customer submits…">
        <bpmn:documentation>Step 1: Receive credit application — Sales Representative or customer submits application: (a) company/legal entity details (SEC/DTI registration), (b) trade references (3 minimum), (c) bank references, (d) financial statements (audited if available), (e) authorized signatories, (f) requested credit limit and terms, (g) BIR TIN, (h) business permit
Responsible (R): Sales Representative
Accountable (A): Credit Analyst
Duration: 30 min (intake)</bpmn:documentation>
        <bpmn:incoming>W886_Flow16</bpmn:incoming>
        <bpmn:outgoing>W886_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W886_Task7" name="Verify applicant documentation — validate: (a) SEC/DTI registration via online…">
        <bpmn:documentation>Step 2: Verify applicant documentation — validate: (a) SEC/DTI registration via online verification, (b) BIR TIN via the BIR TIN Validation System / eRegistration, (c) Mayor&#x27;s permit validity, (d) trade reference legitimacy (call each reference), (e) bank reference verification, (f) financial statement reasonableness; flag discrepancies
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W886_Flow17</bpmn:incoming>
        <bpmn:outgoing>W886_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W886_Task8" name="Conduct credit scoring — apply internal credit scoring model: (a) years in…">
        <bpmn:documentation>Step 3: Conduct credit scoring — apply internal credit scoring model: (a) years in business (&gt; 5 years: positive), (b) industry risk (construction: moderate), (c) financial ratios (current ratio, debt-to-equity, net margin), (d) trade reference feedback, (e) banking relationship, (f) geographic risk (Mindanao vs. Luzon), (g) BuildRight relationship history (if existing cash customer); calculate composite score (0–100)
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W886_Flow18</bpmn:incoming>
        <bpmn:outgoing>W886_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W886_Task9" name="Determine credit recommendation — based on score: (a) Score ≥ 75: approve at…">
        <bpmn:documentation>Step 4: Determine credit recommendation — based on score: (a) Score ≥ 75: approve at requested limit or 80% of requested, (b) Score 50–74: approve at reduced limit (50% of requested) with shorter terms (15 days vs. 30), (c) Score 30–49: approve with COD or secured terms (post-dated checks per W1380), (d) Score &lt; 30: decline with counter-offer for cash terms only
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W886_Flow19</bpmn:incoming>
        <bpmn:outgoing>W886_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W886_Task10" name="Credit approval authorization per W24&#x27;s canonical matrix — (a) ≤ PHP 200,000…">
        <bpmn:documentation>Step 5: Credit approval authorization per W24&#x27;s canonical matrix — (a) ≤ PHP 200,000: AR Supervisor, (b) PHP 200,001–1,000,000: Finance Manager, (c) &gt; PHP 1,000,000: Credit Committee (CFO + Finance Manager + AR Supervisor)
Responsible (R): Credit Manager
Accountable (A): CFO
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W886_Flow20</bpmn:incoming>
        <bpmn:outgoing>W886_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W886_Task11" name="Notify customer and Sales Representative — communicate credit decision…">
        <bpmn:documentation>Step 6: Notify customer and Sales Representative — communicate credit decision: approved (with limit, terms, and conditions), conditionally approved (with counter-offer), or declined (with reason and reapplication eligibility); send credit agreement for signature
Responsible (R): Credit Analyst
Accountable (A): Sales Representative
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W886_Flow21</bpmn:incoming>
        <bpmn:outgoing>W886_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W886_Task12" name="Set up customer in AR module — create customer account with: approved credit…">
        <bpmn:documentation>Step 7: Set up customer in AR module — create customer account with: approved credit limit, payment terms (net 15/30/45/60), credit score, review date (6 months for new accounts), authorized signatories, and billing address; activate for credit sales
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W886_Flow22</bpmn:incoming>
        <bpmn:outgoing>W886_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W886_End13" name="Complete">
        <bpmn:incoming>W886_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W886_Annotation14">
        <bpmn:text>Controls: - CTL-286 (ensure controlled execution — Credit Application &amp; Scoring (PA-16.1).) | - operational: Credit Analyst / Finance Controller review and approval gate
Owner: Credit Analyst / Finance Controller</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W886_Assoc15" sourceRef="W886_Annotation14" targetRef="W886_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W886_Flow16" sourceRef="W886_Start5" targetRef="W886_Task6" />
      <bpmn:sequenceFlow id="W886_Flow17" sourceRef="W886_Task6" targetRef="W886_Task7" />
      <bpmn:sequenceFlow id="W886_Flow18" sourceRef="W886_Task7" targetRef="W886_Task8" />
      <bpmn:sequenceFlow id="W886_Flow19" sourceRef="W886_Task8" targetRef="W886_Task9" />
