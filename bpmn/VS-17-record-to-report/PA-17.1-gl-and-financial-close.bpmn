      <bpmn:userTask id="W127_Task8" name="Environmental Scan">
        <bpmn:documentation>Step 1: Environmental Scan: Analyze market trends, macroeconomics, and SWOT
Responsible (R): Strategy Team
Accountable (A): CEO
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W127_Flow17</bpmn:incoming>
        <bpmn:outgoing>W127_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W127_Task9" name="Strategy Offsite">
        <bpmn:documentation>Step 2: Strategy Offsite: Define 3-year vision and Top 5 Objectives for the coming year
Responsible (R): Executive Team
Accountable (A): CEO
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W127_Flow18</bpmn:incoming>
        <bpmn:outgoing>W127_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W127_Task10" name="OKR Cascading">
        <bpmn:documentation>Step 3: OKR Cascading: Departments define Key Results (KRs) aligned to corporate Objectives
Responsible (R): Dept Heads
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W127_Flow19</bpmn:incoming>
        <bpmn:outgoing>W127_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W127_Task11" name="Budget Alignment">
