    <bpmn:process id="W_W128" name="W128. Enterprise Project Management (EPM) Lifecycle" isExecutable="false">
      <bpmn:documentation>Trigger: Approved strategic initiative (e.g., ERP implementation, new DC)
Frequency: Ongoing
Volume: 5–10 major capital/IT projects active
Owner: Project Management Office (PMO) Lead
Participants: Project Manager, SteerCo (Sponsors), Dept Heads
Source: workflow W128 — Enterprise Project Management (EPM) Lifecycle</bpmn:documentation>
