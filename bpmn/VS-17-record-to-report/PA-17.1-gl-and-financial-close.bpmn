    <bpmn:process id="W_W25" name="W25. Petty Cash Management" isExecutable="false">
      <bpmn:documentation>Trigger: Small expense incurred at store or DC that cannot go through standard PO/AP process
Frequency: ~10–15 petty cash disbursements per store per month; ~2,000–3,000/month chain-wide
Volume: PHP 20,000 float per store; PHP 50,000 float per DC
Owner: Store Manager / DC Supervisor
Participants: Employee (requestor), Store Manager, Petty Cash Custodian, AP Clerk
Source: workflow W25 — Petty Cash Management</bpmn:documentation>
      <bpmn:laneSet id="W25_LaneSet6">
        <bpmn:lane id="W25_Lane1" name="Employee">
        <bpmn:flowNodeRef>W25_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W25_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W25_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W25_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W25_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W25_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W25_Lane3" name="Custodian">
        <bpmn:flowNodeRef>W25_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W25_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W25_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W25_Task17</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W25_Lane4" name="AP Clerk">
        <bpmn:flowNodeRef>W25_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W25_Lane5" name="Treasury Analyst">
        <bpmn:flowNodeRef>W25_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W25_End18</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W25_Start7" name="Small expense incurred at store or DC that cannot go through standard PO/AP process">
        <bpmn:outgoing>W25_Flow21</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W25_Task8" name="Employee requests petty cash for small expense (supplies, minor repairs…">
        <bpmn:documentation>Step 1: Employee requests petty cash for small expense (supplies, minor repairs, transport, miscellaneous)
Responsible (R): Employee
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W25_Flow21</bpmn:incoming>
        <bpmn:outgoing>W25_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W25_Task9" name="Store Manager approves request (verifies business purpose)">
        <bpmn:documentation>Step 2: Store Manager approves request (verifies business purpose)
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W25_Flow22</bpmn:incoming>
        <bpmn:outgoing>W25_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W25_Task10" name="Petty Cash Custodian disburses cash; employee signs petty cash voucher">
        <bpmn:documentation>Step 3: Petty Cash Custodian disburses cash; employee signs petty cash voucher
Responsible (R): Custodian
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W25_Flow23</bpmn:incoming>
        <bpmn:outgoing>W25_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W25_Task11" name="Employee provides receipt and any change back to Custodian">
        <bpmn:documentation>Step 4: Employee provides receipt and any change back to Custodian
Responsible (R): Employee
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W25_Flow24</bpmn:incoming>
        <bpmn:outgoing>W25_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W25_Task12" name="Custodian records transaction in petty cash log (physical or system)">
        <bpmn:documentation>Step 5: Custodian records transaction in petty cash log (physical or system)
Responsible (R): Custodian
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W25_Flow25</bpmn:incoming>
        <bpmn:outgoing>W25_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W25_Task13" name="When fund runs low (~70% disbursed): Custodian prepares replenishment request…">
        <bpmn:documentation>Step 6: When fund runs low (~70% disbursed): Custodian prepares replenishment request with all vouchers
Responsible (R): Custodian
Accountable (A): Store Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W25_Flow26</bpmn:incoming>
        <bpmn:outgoing>W25_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W25_Task14" name="Store Manager reviews vouchers; approves replenishment">
        <bpmn:documentation>Step 7: Store Manager reviews vouchers; approves replenishment
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W25_Flow27</bpmn:incoming>
        <bpmn:outgoing>W25_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W25_Task15" name="AP Clerk processes replenishment; creates petty cash voucher in system; posts…">
        <bpmn:documentation>Step 8: AP Clerk processes replenishment; creates petty cash voucher in system; posts expense to GL
Responsible (R): AP Clerk
Accountable (A): AP Supervisor
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W25_Flow28</bpmn:incoming>
        <bpmn:outgoing>W25_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W25_Task16" name="Treasury / bank transfers replenishment amount to store custodian">
        <bpmn:documentation>Step 9: Treasury / bank transfers replenishment amount to store custodian
Responsible (R): Treasury Analyst
Accountable (A): CFO
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W25_Flow29</bpmn:incoming>
        <bpmn:outgoing>W25_Flow30</bpmn:outgoing>
