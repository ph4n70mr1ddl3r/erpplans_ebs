    <bpmn:process id="W_W124" name="W124. Corporate Secretarial &amp; Entity Management" isExecutable="false">
      <bpmn:documentation>Trigger: Statutory requirement or Board request
Frequency: Quarterly Board meetings; Annual Stockholders&#x27; Meeting
Volume: 5 legal entities
Owner: Corporate Secretary
Participants: Board of Directors, CEO, Legal Department, Finance
Source: workflow W124 — Corporate Secretarial &amp; Entity Management</bpmn:documentation>
      <bpmn:laneSet id="W124_LaneSet3">
        <bpmn:lane id="W124_Lane1" name="Corp Sec">
        <bpmn:flowNodeRef>W124_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W124_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W124_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W124_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W124_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W124_Lane2" name="Legal Counsel">
        <bpmn:flowNodeRef>W124_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W124_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W124_Start4" name="Statutory requirement or Board request">
        <bpmn:outgoing>W124_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W124_Task5" name="Meeting Prep">
        <bpmn:documentation>Step 1: Meeting Prep: Issue notices for Board/Stockholder meetings; prepare agenda and board packs
Responsible (R): Corp Sec
Accountable (A): Chairman
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W124_Flow13</bpmn:incoming>
        <bpmn:outgoing>W124_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W124_Task6" name="Minutes">
        <bpmn:documentation>Step 2: Minutes: Attend meetings and record minutes; obtain signatures
Responsible (R): Corp Sec
Accountable (A): Chairman
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W124_Flow14</bpmn:incoming>
        <bpmn:outgoing>W124_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W124_Task7" name="GIS Filing">
        <bpmn:documentation>Step 3: GIS Filing: Prepare and file General Information Sheet (GIS) with SEC within 30 days of meeting
Responsible (R): Corp Sec
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W124_Flow15</bpmn:incoming>
        <bpmn:outgoing>W124_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W124_Task8" name="Stock Ledger">
        <bpmn:documentation>Step 4: Stock Ledger: Maintain Stock and Transfer Book; record any share issuances or transfers
Responsible (R): Corp Sec
Accountable (A): —
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W124_Flow16</bpmn:incoming>
        <bpmn:outgoing>W124_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W124_Task9" name="Compliance">
        <bpmn:documentation>Step 5: Compliance: Monitor compliance with Revised Corporation Code and SEC regulations
Responsible (R): Legal Counsel
Accountable (A): Corp Sec
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W124_Flow17</bpmn:incoming>
        <bpmn:outgoing>W124_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W124_End10" name="Complete">
        <bpmn:incoming>W124_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W124_Annotation11">
        <bpmn:text>Controls: - CTL-289 (ensure controlled execution — GL &amp; Financial Close (PA-17.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Corporate Secretary</bpmn:text>
      </bpmn:textAnnotation>
