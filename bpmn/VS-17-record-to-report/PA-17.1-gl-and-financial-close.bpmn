        <bpmndi:BPMNShape id="W8_Task10_di" bpmnElement="W8_Task10"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W8_Task11_di" bpmnElement="W8_Task11"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W8_Task12_di" bpmnElement="W8_Task12"><dc:Bounds x="1240" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W8_Task13_di" bpmnElement="W8_Task13"><dc:Bounds x="1450" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W8_Task14_di" bpmnElement="W8_Task14"><dc:Bounds x="1660" y="635" width="180" height="80" /></bpmndi:BPMNShape>
