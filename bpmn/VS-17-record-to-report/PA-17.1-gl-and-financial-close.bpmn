      <bpmn:startEvent id="W186_Start9" name="Need for new process, regulatory change, or periodic review">
        <bpmn:outgoing>W186_Flow21</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W186_Task10" name="SOP Draft: SME drafts process steps using standard corporate template">
        <bpmn:documentation>Step 1: SOP Draft: SME drafts process steps using standard corporate template
Responsible (R): SME
Accountable (A): Dept Head
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W186_Flow21</bpmn:incoming>
        <bpmn:outgoing>W186_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W186_Task11" name="Compliance Review: Legal/Compliance checks for regulatory alignment">
        <bpmn:documentation>Step 2: Compliance Review: Legal/Compliance checks for regulatory alignment
Responsible (R): Compliance Mgr
Accountable (A): VP Legal
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W186_Flow22</bpmn:incoming>
        <bpmn:outgoing>W186_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W186_Task12" name="Stakeholder Review: Cross-functional review for handoff alignment">
        <bpmn:documentation>Step 3: Stakeholder Review: Cross-functional review for handoff alignment
Responsible (R): Dept Heads
Accountable (A): —
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W186_Flow23</bpmn:incoming>
        <bpmn:outgoing>W186_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W186_Task13" name="Approval: Executive Sponsor or VP Legal approves the final version">
        <bpmn:documentation>Step 4: Approval: Executive Sponsor or VP Legal approves the final version
Responsible (R): VP Legal
Accountable (A): —
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W186_Flow24</bpmn:incoming>
        <bpmn:outgoing>W186_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W186_Task14" name="Publication: Upload to Corporate Portal/Intranet; notify all staff">
        <bpmn:documentation>Step 5: Publication: Upload to Corporate Portal/Intranet; notify all staff
Responsible (R): Admin
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W186_Flow25</bpmn:incoming>
        <bpmn:outgoing>W186_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W186_Task15" name="Training: Relevant staff complete training and digital acknowledgement">
        <bpmn:documentation>Step 6: Training: Relevant staff complete training and digital acknowledgement
Responsible (R): HR / Dept Head
Accountable (A): —
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W186_Flow26</bpmn:incoming>
        <bpmn:outgoing>W186_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W186_Task16" name="Enforcement &amp; Audit: Internal Audit checks compliance during audits">
        <bpmn:documentation>Step 7: Enforcement &amp; Audit: Internal Audit checks compliance during audits
Responsible (R): Internal Audit
Accountable (A): —
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W186_Flow27</bpmn:incoming>
        <bpmn:outgoing>W186_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W186_Task17" name="Retirement/Update: Archive old versions; trigger update every 2 years">
