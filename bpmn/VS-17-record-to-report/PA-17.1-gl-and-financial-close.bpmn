    <bpmn:process id="W_W230" name="W230. Legal Contract Review &amp; Approval" isExecutable="false">
      <bpmn:documentation>Trigger: Request for contract review from any department (Procurement, Property, Marketing)
Frequency: High; ~40–60 contracts/month
Volume: Lease agreements, vendor master contracts, service agreements
Owner: Legal Counsel
Participants: Requesting Dept, Legal, External Party, Contracts &amp; Commercial Manager (Senior Counsel)
Source: workflow W230 — Legal Contract Review &amp; Approval</bpmn:documentation>
      <bpmn:laneSet id="W230_LaneSet5">
        <bpmn:lane id="W230_Lane1" name="Dept Manager">
        <bpmn:flowNodeRef>W230_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W230_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W230_Lane2" name="Legal Counsel, Contracts &amp; Commercial Manager">
        <bpmn:flowNodeRef>W230_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W230_Lane3" name="Legal Counsel">
        <bpmn:flowNodeRef>W230_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W230_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W230_Lane4" name="Legal Assistant">
        <bpmn:flowNodeRef>W230_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W230_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W230_Start6" name="Request for contract review from any department (Procurement, Property, Marketing)">
        <bpmn:outgoing>W230_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W230_Task7" name="Submission">
        <bpmn:documentation>Step 1: Submission: Dept submits draft contract or request via Legal Portal with business terms
Responsible (R): Dept Manager
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W230_Flow15</bpmn:incoming>
        <bpmn:outgoing>W230_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W230_Task8" name="Review">
        <bpmn:documentation>Step 2: Review: Legal reviews for risks, compliance, and alignment with company standards
Responsible (R): Legal Counsel, Contracts &amp; Commercial Manager (Senior Counsel)
Accountable (A): VP Legal
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W230_Flow16</bpmn:incoming>
        <bpmn:outgoing>W230_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W230_Task9" name="Negotiation">
        <bpmn:documentation>Step 3: Negotiation: Collaborative editing with external party to finalize terms
Responsible (R): Legal Counsel
Accountable (A): Dept Manager
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W230_Flow17</bpmn:incoming>
        <bpmn:outgoing>W230_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W230_Task10" name="Finalization">
        <bpmn:documentation>Step 4: Finalization: Generate final execution version; obtain internal signatures per Matrix
Responsible (R): Legal Counsel
Accountable (A): CEO/CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W230_Flow18</bpmn:incoming>
        <bpmn:outgoing>W230_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W230_Task11" name="Archiving">
        <bpmn:documentation>Step 5: Archiving: Scan and file executed contract in Document Management System (DMS)
Responsible (R): Legal Assistant
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W230_Flow19</bpmn:incoming>
        <bpmn:outgoing>W230_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W230_End12" name="Complete">
        <bpmn:incoming>W230_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W230_Annotation13">
        <bpmn:text>Controls: - CTL-154 (ensure legal matter &amp; IP portfolio control — contract obligations tracked to fulfillment) | - operational: authority-matrix sign-off gate — CLM blocks contract execution absent the required VP/CEO approval
Owner: Legal Counsel</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W230_Assoc14" sourceRef="W230_Annotation13" targetRef="W230_Start6" associationDirection="None" />
