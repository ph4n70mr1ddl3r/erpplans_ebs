    <bpmn:process id="W_W460" name="W460. Corporate &amp; Trade Account Onboarding" isExecutable="false">
      <bpmn:documentation>Trigger: B2B Sales Rep submits new customer application
Frequency: ~10–20 per month
Volume: High-value accounts (PHP 1M+ potential annual spend)
Owner: Credit Manager
Participants: B2B Sales Rep, Credit Analyst, Legal, Tax Manager, Customer
Source: workflow W460 — Corporate &amp; Trade Account Onboarding</bpmn:documentation>
      <bpmn:laneSet id="W460_LaneSet8">
        <bpmn:lane id="W460_Lane1" name="Sales Rep">
        <bpmn:flowNodeRef>W460_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W460_Start9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W460_Lane2" name="Credit Analyst">
        <bpmn:flowNodeRef>W460_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W460_Lane3" name="Tax Manager">
        <bpmn:flowNodeRef>W460_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W460_Lane4" name="System">
        <bpmn:flowNodeRef>W460_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W460_Lane5" name="Credit Manager">
        <bpmn:flowNodeRef>W460_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W460_Lane6" name="Legal">
        <bpmn:flowNodeRef>W460_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W460_Lane7" name="AR Clerk">
        <bpmn:flowNodeRef>W460_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W460_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W460_Start9" name="B2B Sales Rep submits new customer application">
        <bpmn:outgoing>W460_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W460_Task10" name="Document Collection">
        <bpmn:documentation>Step 1: Document Collection: Sales Rep collects SEC/DTI registration, BIR 2303, latest FS, and signed Credit Application Form
Responsible (R): Sales Rep
Accountable (A): —
Duration: 2-3 days</bpmn:documentation>
        <bpmn:incoming>W460_Flow20</bpmn:incoming>
        <bpmn:outgoing>W460_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W460_Task11" name="KYC &amp; Due Diligence">
        <bpmn:documentation>Step 2: KYC &amp; Due Diligence: Credit Analyst verifies business existence, checks credit references, and performs a litigation search
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W460_Flow21</bpmn:incoming>
        <bpmn:outgoing>W460_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W460_Task12" name="Tax Verification">
        <bpmn:documentation>Step 3: Tax Verification: Tax Manager verifies BIR registration and confirms &quot;Withholding Agent&quot; status for EWT compliance
Responsible (R): Tax Manager
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W460_Flow22</bpmn:incoming>
        <bpmn:outgoing>W460_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W460_Task13" name="Credit Limit Scoring">
        <bpmn:documentation>Step 4: Credit Limit Scoring: System calculates suggested credit limit based on FS ratios and trade references
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W460_Flow23</bpmn:incoming>
        <bpmn:outgoing>W460_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W460_Task14" name="Approval">
        <bpmn:documentation>Step 5: Approval: Credit Manager reviews the pack; approves credit limit and payment terms (Net 30/60)
Responsible (R): Credit Manager
Accountable (A): CFO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W460_Flow24</bpmn:incoming>
        <bpmn:outgoing>W460_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W460_Task15" name="Contract Execution">
        <bpmn:documentation>Step 6: Contract Execution: Legal prepares the Master Sales Agreement (MSA); customer signs
Responsible (R): Legal / Customer
Accountable (A): VP Legal
Duration: 3-5 days</bpmn:documentation>
        <bpmn:incoming>W460_Flow25</bpmn:incoming>
        <bpmn:outgoing>W460_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W460_Task16" name="Account Activation">
        <bpmn:documentation>Step 7: Account Activation: AR Clerk creates Customer Master in ERP; attaches MSA and BIR documents; enables B2B Portal access
Responsible (R): AR Clerk
Accountable (A): Credit Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W460_Flow26</bpmn:incoming>
        <bpmn:outgoing>W460_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W460_End17" name="Complete">
        <bpmn:incoming>W460_Flow27</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W460_Annotation18">
        <bpmn:text>Controls: - CTL-289 (ensure controlled execution — GL &amp; Financial Close (PA-17.1).) | - operational: Credit Manager review and approval gate
Owner: Credit Manager</bpmn:text>
      </bpmn:textAnnotation>
