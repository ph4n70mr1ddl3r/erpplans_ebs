    <bpmn:process id="W_W285" name="W285. Public Liability &amp; Customer Incident Claims Management" isExecutable="false">
      <bpmn:documentation>Trigger: Customer injury, slip/trip/fall, property damage, or product liability incident occurring on store/DC premises, or caused by a product sold by the company
Frequency: Ad-hoc; ~5–10 incidents reported monthly across 200 stores
Volume: ~60–120 cases per year
Owner: Legal Counsel (Claims/Litigation)
Participants: Store Manager, Loss Prevention Officer, Customer Experience Team, VP Legal &amp; Compliance, Insurance Provider, External Legal Counsel
Source: workflow W285 — Public Liability &amp; Customer Incident Claims Management</bpmn:documentation>
      <bpmn:laneSet id="W285_LaneSet6">
        <bpmn:lane id="W285_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W285_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W285_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W285_Lane2" name="LP Officer">
        <bpmn:flowNodeRef>W285_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W285_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W285_Lane3" name="Legal Assistant">
        <bpmn:flowNodeRef>W285_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W285_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W285_Lane4" name="Store Mgr">
        <bpmn:flowNodeRef>W285_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W285_Lane5" name="Legal Counsel">
        <bpmn:flowNodeRef>W285_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W285_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W285_Start7" name="Customer injury, slip/trip/fall, property damage, or product liability incident occurring…">
        <bpmn:outgoing>W285_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W285_Task8" name="Incident Intake &amp; Reporting">
        <bpmn:documentation>Step 1: Incident Intake &amp; Reporting: Store Manager logs details of the incident (e.g. customer slip/fall, merchandise falling, property damage) in the Incident Portal within 2 hours of occurrence; uploads photos, witness contact info, and initial description.
Responsible (R): Store Manager
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W285_Flow18</bpmn:incoming>
        <bpmn:outgoing>W285_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W285_Task9" name="Evidence Preservation">
        <bpmn:documentation>Step 2: Evidence Preservation: Loss Prevention Officer secures and archives CCTV footage (W71 integration) covering 1 hour before and after the incident; logs evidence in the security incident register.
Responsible (R): LP Officer
Accountable (A): Store Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W285_Flow19</bpmn:incoming>
        <bpmn:outgoing>W285_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W285_Task10" name="Liability Assessment">
        <bpmn:documentation>Step 3: Liability Assessment: Legal Assistant reviews incident report and evidence; classifies the case under public liability or product liability; notifies VP Legal &amp; Compliance.
Responsible (R): Legal Assistant
Accountable (A): VP Legal
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W285_Flow20</bpmn:incoming>
        <bpmn:outgoing>W285_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W285_Task11" name="Insurance Claim Initiation">
        <bpmn:documentation>Step 4: Insurance Claim Initiation: Legal Assistant files a claim with the insurance provider via the Insurance Portal (W59 linkage), attaching the incident report, CCTV footage, and police/barangay blotters (W471 linkage).
Responsible (R): Legal Assistant
Accountable (A): —
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W285_Flow21</bpmn:incoming>
        <bpmn:outgoing>W285_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W285_Task12" name="Settlement Negotiation">
        <bpmn:documentation>Step 5: Settlement Negotiation: For minor claims, Store Manager or Customer Experience Lead conducts initial settlement talks (e.g. medical expense reimbursement, store credit) within approved thresholds. For major claims, Legal Counsel leads negotiations.
Responsible (R): Store Mgr / Legal Counsel
Accountable (A): VP Legal
Duration: 2–5 days</bpmn:documentation>
        <bpmn:incoming>W285_Flow22</bpmn:incoming>
        <bpmn:outgoing>W285_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W285_Task13" name="Resolution &amp; Release">
        <bpmn:documentation>Step 6: Resolution &amp; Release: Legal Counsel drafts the Release and Waiver agreement; routes for signature; initiates customer refund or settlement payment execution (W101 linkage). Unresolved claims escalate to active litigation (W125).
Responsible (R): Legal Counsel
Accountable (A): VP Legal
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W285_Flow23</bpmn:incoming>
        <bpmn:outgoing>W285_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W285_Task14" name="Preventive Review">
        <bpmn:documentation>Step 7: Preventive Review: LP Officer and Facilities Coordinator review incident patterns to identify store hazard trends (e.g. poor lighting, wet floors during rotational brownouts per W470) and trigger store maintenance work orders (W47).
Responsible (R): LP Officer / Facilities Coord
Accountable (A): —
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W285_Flow24</bpmn:incoming>
        <bpmn:outgoing>W285_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W285_End15" name="Complete">
        <bpmn:incoming>W285_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W285_Annotation16">
        <bpmn:text>Controls: - CTL-289 (ensure controlled execution — GL &amp; Financial Close (PA-17.1).) | - operational: Legal Counsel (Claims/Litigation) review and approval gate
Owner: Legal Counsel (Claims/Litigation)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W285_Assoc17" sourceRef="W285_Annotation16" targetRef="W285_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W285_Flow18" sourceRef="W285_Start7" targetRef="W285_Task8" />
      <bpmn:sequenceFlow id="W285_Flow19" sourceRef="W285_Task8" targetRef="W285_Task9" />
      <bpmn:sequenceFlow id="W285_Flow20" sourceRef="W285_Task9" targetRef="W285_Task10" />
      <bpmn:sequenceFlow id="W285_Flow21" sourceRef="W285_Task10" targetRef="W285_Task11" />
      <bpmn:sequenceFlow id="W285_Flow22" sourceRef="W285_Task11" targetRef="W285_Task12" />
      <bpmn:sequenceFlow id="W285_Flow23" sourceRef="W285_Task12" targetRef="W285_Task13" />
      <bpmn:sequenceFlow id="W285_Flow24" sourceRef="W285_Task13" targetRef="W285_Task14" />
      <bpmn:sequenceFlow id="W285_Flow25" sourceRef="W285_Task14" targetRef="W285_End15" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W285_diag">
      <bpmndi:BPMNPlane id="W285_plane" bpmnElement="W_W285">
        <bpmndi:BPMNShape id="W285_Lane1_di" bpmnElement="W285_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W285_Lane2_di" bpmnElement="W285_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W285_Lane3_di" bpmnElement="W285_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W285_Lane4_di" bpmnElement="W285_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W285_Lane5_di" bpmnElement="W285_Lane5" isHorizontal="true"><dc:Bounds x="160" y="760" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W285_Task8_di" bpmnElement="W285_Task8"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W285_Task9_di" bpmnElement="W285_Task9"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W285_Task10_di" bpmnElement="W285_Task10"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W285_Task11_di" bpmnElement="W285_Task11"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W285_Task12_di" bpmnElement="W285_Task12"><dc:Bounds x="1240" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W285_Task13_di" bpmnElement="W285_Task13"><dc:Bounds x="1450" y="805" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W285_Task14_di" bpmnElement="W285_Task14"><dc:Bounds x="1660" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W285_Start7_di" bpmnElement="W285_Start7"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W285_End15_di" bpmnElement="W285_End15"><dc:Bounds x="1890" y="827" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W285_Annotation16_di" bpmnElement="W285_Annotation16"><dc:Bounds x="160" y="970" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W285_Flow18_di" bpmnElement="W285_Flow18"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W285_Flow19_di" bpmnElement="W285_Flow19"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W285_Flow20_di" bpmnElement="W285_Flow20"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W285_Flow21_di" bpmnElement="W285_Flow21"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W285_Flow22_di" bpmnElement="W285_Flow22"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W285_Flow23_di" bpmnElement="W285_Flow23"><di:waypoint x="1420" y="675" /><di:waypoint x="1450" y="845" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W285_Flow24_di" bpmnElement="W285_Flow24"><di:waypoint x="1630" y="845" /><di:waypoint x="1660" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W285_Flow25_di" bpmnElement="W285_Flow25"><di:waypoint x="1840" y="335" /><di:waypoint x="1890" y="845" /></bpmndi:BPMNEdge>
