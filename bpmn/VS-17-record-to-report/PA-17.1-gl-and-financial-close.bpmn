<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-17.1-gl-and-financial-close" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W8" name="W8. Accounts Receivable — Trade &amp; Corporate Accounts" isExecutable="false">
      <bpmn:documentation>Trigger: Sales invoice generated for trade/corporate account at POS or by Sales Rep
Frequency: ~3,500 AR invoices/month
Volume: ~117 invoices/day; ~5,200 active AR accounts
Owner: AR Supervisor
Participants: AR Clerk, Sales Rep (trade accounts), AR Supervisor, Finance Manager
Source: workflow W8 — Accounts Receivable — Trade &amp; Corporate Accounts</bpmn:documentation>
      <bpmn:laneSet id="W8_LaneSet6">
        <bpmn:lane id="W8_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W8_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W8_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W8_Lane2" name="System">
        <bpmn:flowNodeRef>W8_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W8_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W8_Lane3" name="AR Clerk">
        <bpmn:flowNodeRef>W8_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W8_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W8_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W8_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W8_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W8_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W8_Task19</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W8_Lane4" name="Sales Rep">
        <bpmn:flowNodeRef>W8_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W8_Lane5" name="Finance Manager">
        <bpmn:flowNodeRef>W8_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W8_End20</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W8_Start7" name="Sales invoice generated for trade/corporate account at POS or by Sales Rep">
        <bpmn:outgoing>W8_Flow23</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W8_Task8" name="Customer purchase on trade/corporate account; invoice created at POS or by…">
        <bpmn:documentation>Step 1: Customer purchase on trade/corporate account; invoice created at POS or by Sales Rep
Responsible (R): Cashier / Sales Rep
Accountable (A): Department Supervisor
Duration: Part of sale</bpmn:documentation>
        <bpmn:incoming>W8_Flow23</bpmn:incoming>
        <bpmn:outgoing>W8_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W8_Task9" name="System posts AR invoice; updates customer balance">
        <bpmn:documentation>Step 2: System posts AR invoice; updates customer balance
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W8_Flow24</bpmn:incoming>
        <bpmn:outgoing>W8_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W8_Task10" name="System checks customer credit limit; blocks further sales if exceeded">
        <bpmn:documentation>Step 3: System checks customer credit limit; blocks further sales if exceeded
Responsible (R): System
Accountable (A): AR Supervisor
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W8_Flow25</bpmn:incoming>
        <bpmn:outgoing>W8_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W8_Task11" name="AR Clerk sends monthly statement to each active account (1st of month)">
        <bpmn:documentation>Step 4: AR Clerk sends monthly statement to each active account (1st of month)
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 4 hours/month (batch)</bpmn:documentation>
        <bpmn:incoming>W8_Flow26</bpmn:incoming>
        <bpmn:outgoing>W8_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W8_Task12" name="AR Clerk reviews aging report weekly; flags accounts &gt; 30 days past due">
        <bpmn:documentation>Step 5: AR Clerk reviews aging report weekly; flags accounts &gt; 30 days past due
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 1 hour/week</bpmn:documentation>
        <bpmn:incoming>W8_Flow27</bpmn:incoming>
        <bpmn:outgoing>W8_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W8_Task13" name="For 30-day overdue: AR Clerk contacts customer (phone/email) for follow-up">
        <bpmn:documentation>Step 6: For 30-day overdue: AR Clerk contacts customer (phone/email) for follow-up
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 15 min/account</bpmn:documentation>
        <bpmn:incoming>W8_Flow28</bpmn:incoming>
        <bpmn:outgoing>W8_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W8_Task14" name="For 60-day overdue: escalate to Sales Rep for relationship-based collection">
        <bpmn:documentation>Step 7: For 60-day overdue: escalate to Sales Rep for relationship-based collection
Responsible (R): Sales Rep
Accountable (A): AR Supervisor
Duration: 15 min/account</bpmn:documentation>
        <bpmn:incoming>W8_Flow29</bpmn:incoming>
        <bpmn:outgoing>W8_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W8_Task15" name="For 90-day overdue: escalate to Finance Manager; consider credit hold">
        <bpmn:documentation>Step 8: For 90-day overdue: escalate to Finance Manager; consider credit hold
Responsible (R): Finance Manager
Accountable (A): CFO
Duration: 30 min/account</bpmn:documentation>
        <bpmn:incoming>W8_Flow30</bpmn:incoming>
        <bpmn:outgoing>W8_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W8_Task16" name="Customer payment received; AR Clerk applies payment to open invoices">
        <bpmn:documentation>Step 9: Customer payment received; AR Clerk applies payment to open invoices
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 5 min/payment</bpmn:documentation>
        <bpmn:incoming>W8_Flow31</bpmn:incoming>
        <bpmn:outgoing>W8_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W8_Task17" name="Monthly reconciliation of AR sub-ledger to GL">
        <bpmn:documentation>Step 10: Monthly reconciliation of AR sub-ledger to GL
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W8_Flow32</bpmn:incoming>
        <bpmn:outgoing>W8_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W8_Task18" name="Customer credit memo: AR Clerk creates credit memo with reason code and source…">
        <bpmn:documentation>Step 11: Customer credit memo: AR Clerk creates credit memo with reason code and source reference (pricing error, volume discount adjustment, short delivery, service failure, promotional adjustment); tiered approval (AR Supervisor ≤ PHP 10,000; Finance Manager ≤ PHP 50,000; CFO &gt; PHP 50,000); system applies credit to oldest open invoice or creates credit balance; posts GL entry (Dr. Revenue or appropriate expense / Cr. Accounts Receivable); customer notified of credit
Responsible (R): AR Clerk / AR Supervisor
Accountable (A): Finance Manager
Duration: 10 min/credit memo</bpmn:documentation>
        <bpmn:incoming>W8_Flow33</bpmn:incoming>
        <bpmn:outgoing>W8_Flow34</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W8_Task19" name="Customer account closure">
        <bpmn:documentation>Step 12: Customer account closure: customer requests trade/corporate account closure; AR Clerk verifies zero outstanding balance — if balance outstanding, arranges final payment or collection per W8.6–8; system settles any open credit memos (applies to outstanding invoices or processes refund); loyalty points: if customer has unredeemed points, system offers redemption before closure or forfeits per W17 terms; AR Clerk deactivates account in system; account status changed to &quot;Closed&quot;; system retains transaction history for 10-year BIR retention; PII anonymized after retention period per RA 10173 and W53 data retention policy; account closure logged with reason, date, and AR Clerk ID
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 15 min/closure</bpmn:documentation>
        <bpmn:incoming>W8_Flow34</bpmn:incoming>
        <bpmn:outgoing>W8_Flow35</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W8_End20" name="Complete">
        <bpmn:incoming>W8_Flow35</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W8_Annotation21">
        <bpmn:text>Controls: - CTL-05 (prevent unauthorized credit limit overrides.); CTL-12 (separate credit approval from sales execution.) | - operational: AR Supervisor review and approval gate; operational: periodic reconciliation against source documents
Owner: AR Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W8_Assoc22" sourceRef="W8_Annotation21" targetRef="W8_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W8_Flow23" sourceRef="W8_Start7" targetRef="W8_Task8" />
      <bpmn:sequenceFlow id="W8_Flow24" sourceRef="W8_Task8" targetRef="W8_Task9" />
      <bpmn:sequenceFlow id="W8_Flow25" sourceRef="W8_Task9" targetRef="W8_Task10" />
      <bpmn:sequenceFlow id="W8_Flow26" sourceRef="W8_Task10" targetRef="W8_Task11" />
      <bpmn:sequenceFlow id="W8_Flow27" sourceRef="W8_Task11" targetRef="W8_Task12" />
      <bpmn:sequenceFlow id="W8_Flow28" sourceRef="W8_Task12" targetRef="W8_Task13" />
      <bpmn:sequenceFlow id="W8_Flow29" sourceRef="W8_Task13" targetRef="W8_Task14" />
      <bpmn:sequenceFlow id="W8_Flow30" sourceRef="W8_Task14" targetRef="W8_Task15" />
      <bpmn:sequenceFlow id="W8_Flow31" sourceRef="W8_Task15" targetRef="W8_Task16" />
      <bpmn:sequenceFlow id="W8_Flow32" sourceRef="W8_Task16" targetRef="W8_Task17" />
      <bpmn:sequenceFlow id="W8_Flow33" sourceRef="W8_Task17" targetRef="W8_Task18" />
      <bpmn:sequenceFlow id="W8_Flow34" sourceRef="W8_Task18" targetRef="W8_Task19" />
      <bpmn:sequenceFlow id="W8_Flow35" sourceRef="W8_Task19" targetRef="W8_End20" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W8_diag">
      <bpmndi:BPMNPlane id="W8_plane" bpmnElement="W_W8">
        <bpmndi:BPMNShape id="W8_Lane1_di" bpmnElement="W8_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2840" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W8_Lane2_di" bpmnElement="W8_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="2840" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W8_Lane3_di" bpmnElement="W8_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="2840" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W8_Lane4_di" bpmnElement="W8_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="2840" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W8_Lane5_di" bpmnElement="W8_Lane5" isHorizontal="true"><dc:Bounds x="160" y="760" width="2840" height="170" /></bpmndi:BPMNShape>
