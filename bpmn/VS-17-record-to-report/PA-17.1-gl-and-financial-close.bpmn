        <bpmndi:BPMNEdge id="W474_Flow16_di" bpmnElement="W474_Flow16"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W474_Flow17_di" bpmnElement="W474_Flow17"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
