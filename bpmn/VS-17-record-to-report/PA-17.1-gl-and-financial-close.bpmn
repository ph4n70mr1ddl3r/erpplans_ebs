        <bpmn:outgoing>W128_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W128_Task7" name="Project Charter: Define scope, budget, timeline, and ROI">
        <bpmn:documentation>Step 1: Project Charter: Define scope, budget, timeline, and ROI
Responsible (R): Project Manager
Accountable (A): Sponsor
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W128_Flow16</bpmn:incoming>
        <bpmn:outgoing>W128_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W128_Task8" name="Team Mobilization: Assign internal resources and onboard vendors">
        <bpmn:documentation>Step 2: Team Mobilization: Assign internal resources and onboard vendors
Responsible (R): PMO Lead
Accountable (A): Sponsor
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W128_Flow17</bpmn:incoming>
        <bpmn:outgoing>W128_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W128_Task9" name="Execution &amp; Monitoring: Weekly status reports vs. milestones">
        <bpmn:documentation>Step 3: Execution &amp; Monitoring: Weekly status reports vs. milestones
Responsible (R): Project Manager
Accountable (A): PMO Lead
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W128_Flow18</bpmn:incoming>
        <bpmn:outgoing>W128_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W128_Task10" name="Change Control: Approve deviations in scope or budget (W21)">
        <bpmn:documentation>Step 4: Change Control: Approve deviations in scope or budget (W21)
Responsible (R): SteerCo
Accountable (A): Sponsor
Duration: Ad-hoc</bpmn:documentation>
        <bpmn:incoming>W128_Flow19</bpmn:incoming>
        <bpmn:outgoing>W128_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W128_Task11" name="UAT &amp; Go-Live: Final validation (W73 for IT)">
        <bpmn:documentation>Step 5: UAT &amp; Go-Live: Final validation (W73 for IT)
Responsible (R): Dept Users
Accountable (A): Sponsor
Duration: 1–4 weeks</bpmn:documentation>
        <bpmn:incoming>W128_Flow20</bpmn:incoming>
        <bpmn:outgoing>W128_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W128_Task12" name="Post-Implementation Review (PIR): Capture lessons learned">
        <bpmn:documentation>Step 6: Post-Implementation Review (PIR): Capture lessons learned
Responsible (R): PMO Lead
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W128_Flow21</bpmn:incoming>
        <bpmn:outgoing>W128_Flow22</bpmn:outgoing>
      </bpmn:userTask>
