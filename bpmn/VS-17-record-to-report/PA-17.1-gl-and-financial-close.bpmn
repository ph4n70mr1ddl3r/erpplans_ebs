    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W610" name="W610. Insurance Claims Processing &amp; Recovery Management" isExecutable="false">
      <bpmn:documentation>Trigger: Insurable incident occurs: property damage, theft, vehicle accident, cargo damage, customer injury, business interruption
Frequency: As needed; estimated ~12–18 formal claims/month (≈150–210/year per the Volume) across 200 stores, 4 DCs, fleet
Volume: ~500–700 incidents/year; ~30% become formal insurance claims
Owner: Insurance &amp; Risk Manager
Participants: Store/DC Manager, Insurance &amp; Risk Manager, insurance adjuster, legal counsel, Treasury Analyst, affected department head
Source: workflow W610 — Insurance Claims Processing &amp; Recovery Management</bpmn:documentation>
      <bpmn:laneSet id="W610_LaneSet4">
        <bpmn:lane id="W610_Lane1" name="Location Manager">
        <bpmn:flowNodeRef>W610_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W610_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W610_Lane2" name="Insurance &amp; Risk Manager">
        <bpmn:flowNodeRef>W610_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W610_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W610_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W610_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W610_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W610_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W610_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W610_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W610_Lane3" name="Treasury Analyst">
        <bpmn:flowNodeRef>W610_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W610_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W610_Start5" name="Insurable incident occurs: property damage, theft, vehicle accident, cargo damage…">
        <bpmn:outgoing>W610_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W610_Task6" name="Incident occurs: location Manager documents incident with date, time, location…">
        <bpmn:documentation>Step 1: Incident occurs: location Manager documents incident with date, time, location, description, photos, estimated damage value, and witness statements; system creates insurance incident record linked to location master and policy registry (per W59)
Responsible (R): Location Manager
Accountable (A): Insurance &amp; Risk Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W610_Flow19</bpmn:incoming>
        <bpmn:outgoing>W610_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W610_Task7" name="Insurance &amp; Risk Manager reviews incident report; determines if incident falls…">
        <bpmn:documentation>Step 2: Insurance &amp; Risk Manager reviews incident report; determines if incident falls within policy coverage; verifies deductible amount and coverage limits; classifies claim type: property, liability, cargo, vehicle, business interruption
Responsible (R): Insurance &amp; Risk Manager
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W610_Flow20</bpmn:incoming>
        <bpmn:outgoing>W610_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W610_Task8" name="For incidents below deductible or non-covered: Insurance &amp; Risk Manager advises…">
        <bpmn:documentation>Step 3: For incidents below deductible or non-covered: Insurance &amp; Risk Manager advises location Manager to process as operational loss; GL posting to appropriate expense account; no formal claim filed
Responsible (R): Insurance &amp; Risk Manager
Accountable (A): Controller
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W610_Flow21</bpmn:incoming>
        <bpmn:outgoing>W610_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W610_Task9" name="For covered incidents above deductible: Insurance &amp; Risk Manager prepares claim…">
        <bpmn:documentation>Step 4: For covered incidents above deductible: Insurance &amp; Risk Manager prepares claim documentation package: incident report, photos, police report (if theft/vandalism per W471), repair estimates, replacement quotes, loss of revenue calculation (for business interruption)
Responsible (R): Insurance &amp; Risk Manager
Accountable (A): —
Duration: 60 min</bpmn:documentation>
        <bpmn:incoming>W610_Flow22</bpmn:incoming>
        <bpmn:outgoing>W610_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W610_Task10" name="Claim filed with insurance provider via broker portal or direct submission…">
        <bpmn:documentation>Step 5: Claim filed with insurance provider via broker portal or direct submission; system tracks claim number, submission date, estimated recovery amount, and expected settlement timeline
Responsible (R): Insurance &amp; Risk Manager
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W610_Flow23</bpmn:incoming>
        <bpmn:outgoing>W610_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W610_Task11" name="Insurance adjuster inspection scheduled and conducted; Insurance &amp; Risk Manager…">
        <bpmn:documentation>Step 6: Insurance adjuster inspection scheduled and conducted; Insurance &amp; Risk Manager coordinates site access, documentation, and witness availability; adjuster provides assessment report
Responsible (R): Insurance &amp; Risk Manager
Accountable (A): —
Duration: 2-4 hours</bpmn:documentation>
        <bpmn:incoming>W610_Flow24</bpmn:incoming>
        <bpmn:outgoing>W610_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W610_Task12" name="Claim settlement negotiation: Insurance &amp; Risk Manager reviews adjuster…">
        <bpmn:documentation>Step 7: Claim settlement negotiation: Insurance &amp; Risk Manager reviews adjuster assessment vs. actual loss; negotiates settlement amount; involves legal counsel for disputed claims &gt; PHP 500K
Responsible (R): Insurance &amp; Risk Manager
Accountable (A): CFO
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W610_Flow25</bpmn:incoming>
        <bpmn:outgoing>W610_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W610_Task13" name="Settlement received: Treasury posts recovery to insurance recovery GL account…">
        <bpmn:documentation>Step 8: Settlement received: Treasury posts recovery to insurance recovery GL account; system reconciles claim record; GL posting: DR Cash / CR Insurance Recovery (gain) or DR Insurance Recovery / CR Asset/Expense (reimbursement)
Responsible (R): Treasury Analyst
Accountable (A): Controller
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W610_Flow26</bpmn:incoming>
        <bpmn:outgoing>W610_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W610_Task14" name="Monthly: Insurance &amp; Risk Manager generates claims dashboard — open claims by…">
        <bpmn:documentation>Step 9: Monthly: Insurance &amp; Risk Manager generates claims dashboard — open claims by type, aging, recovery rate, claim frequency trend by location; identifies locations with above-average claim frequency for risk mitigation review
Responsible (R): Insurance &amp; Risk Manager
Accountable (A): CFO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W610_Flow27</bpmn:incoming>
        <bpmn:outgoing>W610_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W610_Task15" name="Annual: Insurance &amp; Risk Manager conducts policy renewal review with claim…">
        <bpmn:documentation>Step 10: Annual: Insurance &amp; Risk Manager conducts policy renewal review with claim history analysis; presents claim frequency, severity, and recovery data to CFO; recommends policy adjustments, coverage changes, or new coverage requirements
Responsible (R): Insurance &amp; Risk Manager
Accountable (A): CFO
Duration: 8 hours</bpmn:documentation>
        <bpmn:incoming>W610_Flow28</bpmn:incoming>
        <bpmn:outgoing>W610_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W610_End16" name="Complete">
        <bpmn:incoming>W610_Flow29</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W610_Annotation17">
        <bpmn:text>Controls: - CTL-289 (ensure controlled execution — GL &amp; Financial Close (PA-17.1).) | - operational: annual coverage adequacy review in Step 10; operational: proactive adjuster follow-up and escalation to broker for delayed claims &gt; 90 days; operational: incident report template in mobile app and Store Manager training
Owner: Insurance &amp; Risk Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W610_Assoc18" sourceRef="W610_Annotation17" targetRef="W610_Start5" associationDirection="None" />
