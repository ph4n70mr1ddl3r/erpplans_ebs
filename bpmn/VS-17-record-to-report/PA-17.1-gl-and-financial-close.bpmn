      <bpmn:sequenceFlow id="W875_Flow22" sourceRef="W875_Task11" targetRef="W875_Task12" />
      <bpmn:sequenceFlow id="W875_Flow23" sourceRef="W875_Task12" targetRef="W875_Task13" />
      <bpmn:sequenceFlow id="W875_Flow24" sourceRef="W875_Task13" targetRef="W875_Task14" />
      <bpmn:sequenceFlow id="W875_Flow25" sourceRef="W875_Task14" targetRef="W875_End15" />
    </bpmn:process>
