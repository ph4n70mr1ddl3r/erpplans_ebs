    <bpmn:process id="W_W465" name="W465. Network-Wide Disaster Recovery &amp; BCP" isExecutable="false">
      <bpmn:documentation>Trigger: Natural disaster (Typhoon, Earthquake) or major system failure
Frequency: Ad-hoc (Emergency); Quarterly review
Volume: Regional (subset of stores) or National (entire group)
Owner: COO / Crisis Management Team
Participants: CIO, VP Supply Chain, VP Store Operations, CHRO, Legal
Source: workflow W465 — Network-Wide Disaster Recovery &amp; BCP</bpmn:documentation>
      <bpmn:laneSet id="W465_LaneSet7">
        <bpmn:lane id="W465_Lane1" name="CMT">
        <bpmn:flowNodeRef>W465_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W465_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W465_Lane2" name="Store">
        <bpmn:flowNodeRef>W465_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W465_Lane3" name="IT Team">
        <bpmn:flowNodeRef>W465_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W465_Lane4" name="VP Supply Chain">
        <bpmn:flowNodeRef>W465_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W465_Lane5" name="System">
        <bpmn:flowNodeRef>W465_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W465_Lane6" name="Marketing">
        <bpmn:flowNodeRef>W465_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W465_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W465_Start8" name="Natural disaster (Typhoon, Earthquake) or major system failure">
        <bpmn:outgoing>W465_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W465_Task9" name="Crisis Activation">
        <bpmn:documentation>Step 1: Crisis Activation: Crisis Management Team (CMT) convenes within 1 hour of incident detection
Responsible (R): CMT
Accountable (A): CEO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W465_Flow18</bpmn:incoming>
        <bpmn:outgoing>W465_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W465_Task10" name="Damage Assessment">
        <bpmn:documentation>Step 2: Damage Assessment: Stores/DCs report status via emergency satellite/LTE comms; assess staff safety and inventory
Responsible (R): Store/DC Mgr
Accountable (A): VP Store Operations
Duration: 2-4 hours</bpmn:documentation>
        <bpmn:incoming>W465_Flow19</bpmn:incoming>
        <bpmn:outgoing>W465_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W465_Task11" name="IT Fallback">
        <bpmn:documentation>Step 3: IT Fallback: If HQ/DC1 data center fails, IT triggers cloud failover to ensure POS and ERP availability
Responsible (R): IT Team
Accountable (A): CIO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W465_Flow20</bpmn:incoming>
        <bpmn:outgoing>W465_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W465_Task12" name="Supply Chain Rerouting">
        <bpmn:documentation>Step 4: Supply Chain Rerouting: If DC3 (Laguna) is blocked, Supply Chain redirects shipments from DC1 (Davao) or DC2 (Cebu)
Responsible (R): VP Supply Chain
Accountable (A): COO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W465_Flow21</bpmn:incoming>
        <bpmn:outgoing>W465_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W465_Task13" name="Emergency Inventory Push">
        <bpmn:documentation>Step 5: Emergency Inventory Push: Auto-replenishment overridden; push emergency goods (tarps, generators, water) to affected zones
Responsible (R): System / Planner
Accountable (A): VP Merch
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W465_Flow22</bpmn:incoming>
        <bpmn:outgoing>W465_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W465_Task14" name="Communication">
        <bpmn:documentation>Step 6: Communication: Internal (staff safety) and External (store status to customers/social media) messaging
Responsible (R): Marketing / HR
Accountable (A): CMO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W465_Flow23</bpmn:incoming>
        <bpmn:outgoing>W465_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W465_End15" name="Complete">
        <bpmn:incoming>W465_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W465_Annotation16">
        <bpmn:text>Controls: - CTL-289 (ensure controlled execution — GL &amp; Financial Close (PA-17.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: COO / Crisis Management Team</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W465_Assoc17" sourceRef="W465_Annotation16" targetRef="W465_Start8" associationDirection="None" />
      <bpmn:sequenceFlow id="W465_Flow18" sourceRef="W465_Start8" targetRef="W465_Task9" />
      <bpmn:sequenceFlow id="W465_Flow19" sourceRef="W465_Task9" targetRef="W465_Task10" />
      <bpmn:sequenceFlow id="W465_Flow20" sourceRef="W465_Task10" targetRef="W465_Task11" />
      <bpmn:sequenceFlow id="W465_Flow21" sourceRef="W465_Task11" targetRef="W465_Task12" />
