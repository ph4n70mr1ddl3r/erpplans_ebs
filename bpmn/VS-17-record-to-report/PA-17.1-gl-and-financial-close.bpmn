        <bpmn:flowNodeRef>W126_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W126_Start4" name="New private label brand launch (W1); or discovery of trademark infringement">
        <bpmn:outgoing>W126_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W126_Task5" name="Search">
        <bpmn:documentation>Step 1: Search: Conduct trademark availability search for new brands/logos
Responsible (R): Legal Counsel
Accountable (A): VP Legal
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W126_Flow13</bpmn:incoming>
        <bpmn:outgoing>W126_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W126_Task6" name="Filing">
        <bpmn:documentation>Step 2: Filing: Submit application to Intellectual Property Office (IPO) of the Philippines
Responsible (R): Legal Counsel
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W126_Flow14</bpmn:incoming>
        <bpmn:outgoing>W126_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W126_Task7" name="Monitoring">
        <bpmn:documentation>Step 3: Monitoring: Monitor for similar filings or unauthorized use of BuildRight brands
Responsible (R): Marketing
Accountable (A): Legal Counsel
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W126_Flow15</bpmn:incoming>
        <bpmn:outgoing>W126_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W126_Task8" name="Enforcement">
        <bpmn:documentation>Step 4: Enforcement: Issue Cease &amp; Desist notices to infringers; escalate to litigation (W125) if needed
Responsible (R): Legal Counsel
Accountable (A): VP Legal
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W126_Flow16</bpmn:incoming>
        <bpmn:outgoing>W126_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W126_Task9" name="Maintenance">
        <bpmn:documentation>Step 5: Maintenance: Pay maintenance fees and file Declaration of Actual Use (DAU) per IPO schedule
Responsible (R): Legal Counsel
Accountable (A): —
Duration: Per schedule</bpmn:documentation>
        <bpmn:incoming>W126_Flow17</bpmn:incoming>
        <bpmn:outgoing>W126_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W126_End10" name="Complete">
        <bpmn:incoming>W126_Flow18</bpmn:incoming>
      </bpmn:endEvent>
