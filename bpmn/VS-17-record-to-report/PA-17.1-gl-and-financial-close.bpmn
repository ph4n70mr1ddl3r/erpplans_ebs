    <bpmn:process id="W_W175" name="W175. Employee Gratuity &amp; Retirement Fund Management (RA 7641)" isExecutable="false">
      <bpmn:documentation>Trigger: Employee retirement; annual actuarial valuation; monthly fund contribution
Frequency: Monthly provision posting; quarterly fund remittance; annual actuarial valuation; retirement events as-needed (~50–80 retirements/year based on workforce demographics)
Volume: ~6,911 employees across 5 entities; retirement trust fund balance estimated PHP 150–250M
Owner: CFO
Participants: HR Manager, Controller, External Actuary, Trust Bank, Finance Clerk
Source: workflow W175 — Employee Gratuity &amp; Retirement Fund Management (RA 7641)</bpmn:documentation>
      <bpmn:laneSet id="W175_LaneSet6">
        <bpmn:lane id="W175_Lane1" name="System">
        <bpmn:flowNodeRef>W175_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W175_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W175_Lane2" name="Treasury Mgr">
        <bpmn:flowNodeRef>W175_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W175_Lane3" name="Actuary">
        <bpmn:flowNodeRef>W175_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W175_Lane4" name="HR Manager">
        <bpmn:flowNodeRef>W175_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W175_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W175_Lane5" name="Finance Clerk">
        <bpmn:flowNodeRef>W175_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W175_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W175_Start7" name="Employee retirement; annual actuarial valuation; monthly fund contribution">
        <bpmn:outgoing>W175_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W175_Task8" name="Provisioning">
        <bpmn:documentation>Step 1: Provisioning: Monthly: Finance calculates retirement expense provision based on salary and service years per RA 7641
Responsible (R): System
Accountable (A): Controller
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W175_Flow17</bpmn:incoming>
        <bpmn:outgoing>W175_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W175_Task9" name="Fund Contribution">
        <bpmn:documentation>Step 2: Fund Contribution: Quarterly: Treasury remits cash to the retirement trust fund managed by a Trust Bank
Responsible (R): Treasury Mgr
Accountable (A): CFO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W175_Flow18</bpmn:incoming>
        <bpmn:outgoing>W175_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W175_Task10" name="Annual Valuation">
        <bpmn:documentation>Step 3: Annual Valuation: External Actuary performs PFRS-compliant valuation (PAS 19) of the defined benefit obligation
Responsible (R): Actuary
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W175_Flow19</bpmn:incoming>
        <bpmn:outgoing>W175_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W175_Task11" name="Retirement Trigger">
        <bpmn:documentation>Step 4: Retirement Trigger: Employee reaches retirement age or qualifies for early retirement
Responsible (R): HR Manager
Accountable (A): —
Duration: —</bpmn:documentation>
        <bpmn:incoming>W175_Flow20</bpmn:incoming>
        <bpmn:outgoing>W175_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W175_Task12" name="Computation">
        <bpmn:documentation>Step 5: Computation: HR calculates retirement pay per law (at least 1/2 month salary per year of service)
Responsible (R): HR Manager
Accountable (A): CFO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W175_Flow21</bpmn:incoming>
        <bpmn:outgoing>W175_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W175_Task13" name="Disbursement">
        <bpmn:documentation>Step 6: Disbursement: Trust Bank releases funds to the employee; Finance adjusts the retirement liability in ERP
Responsible (R): Finance Clerk
Accountable (A): Controller
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W175_Flow22</bpmn:incoming>
        <bpmn:outgoing>W175_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W175_End14" name="Complete">
        <bpmn:incoming>W175_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W175_Annotation15">
        <bpmn:text>Controls: - CTL-289 (ensure controlled execution — GL &amp; Financial Close (PA-17.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: CFO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W175_Assoc16" sourceRef="W175_Annotation15" targetRef="W175_Start7" associationDirection="None" />
