    <bpmn:process id="W_W125" name="W125. Legal Case &amp; Litigation Management" isExecutable="false">
      <bpmn:documentation>Trigger: Receipt of legal notice, summons, or complaint; or internal decision to initiate legal action
Frequency: Ad-hoc; ~10–20 active cases at any time with material loss-contingency exposure (labor, consumer, commercial — the accrual-relevant subset of the ~30–80-case litigation docket per W3258)
Volume: Covers labor disputes, customer injury claims, and vendor disputes
Owner: VP Legal / VP Legal &amp; Compliance
Participants: Legal Counsel, HR (for labor), Finance (for provisioning), External Counsel
Source: workflow W125 — Legal Case &amp; Litigation Management</bpmn:documentation>
      <bpmn:laneSet id="W125_LaneSet4">
        <bpmn:lane id="W125_Lane1" name="Legal Assistant">
        <bpmn:flowNodeRef>W125_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W125_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W125_Lane2" name="Legal Counsel">
        <bpmn:flowNodeRef>W125_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W125_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W125_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W125_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W125_Lane3" name="VP Legal">
        <bpmn:flowNodeRef>W125_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W125_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W125_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W125_Start5" name="Receipt of legal notice, summons, or complaint; or internal decision to initiate legal…">
        <bpmn:outgoing>W125_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W125_Task6" name="Intake">
        <bpmn:documentation>Step 1: Intake: Receive and log new legal matter in Legal Tracker; scan and attach all documents
Responsible (R): Legal Assistant
Accountable (A): VP Legal
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W125_Flow16</bpmn:incoming>
        <bpmn:outgoing>W125_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W125_Task7" name="Assessment">
        <bpmn:documentation>Step 2: Assessment: Assign internal/external counsel; determine case strategy and potential liability
Responsible (R): Legal Counsel
Accountable (A): VP Legal
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W125_Flow17</bpmn:incoming>
        <bpmn:outgoing>W125_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W125_Task8" name="Provisioning">
        <bpmn:documentation>Step 3: Provisioning: For cases with probable loss, notify Finance to set up accounting provision (W81 linkage)
Responsible (R): VP Legal
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W125_Flow18</bpmn:incoming>
        <bpmn:outgoing>W125_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W125_Task9" name="Fieldwork">
        <bpmn:documentation>Step 4: Fieldwork: Gather evidence (CCTV, logs, witness statements) from Store/DC/Dept
Responsible (R): Legal Counsel
Accountable (A): —
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W125_Flow19</bpmn:incoming>
        <bpmn:outgoing>W125_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W125_Task10" name="Execution">
        <bpmn:documentation>Step 5: Execution: File response/pleadings; attend hearings; manage mediation/settlement negotiations
Responsible (R): Legal Counsel
Accountable (A): VP Legal
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W125_Flow20</bpmn:incoming>
        <bpmn:outgoing>W125_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W125_Task11" name="Closure">
        <bpmn:documentation>Step 6: Closure: Record final judgment or settlement; trigger payment (if loss) or recovery (if win)
Responsible (R): Legal Counsel
Accountable (A): VP Legal
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W125_Flow21</bpmn:incoming>
        <bpmn:outgoing>W125_Flow22</bpmn:outgoing>
      </bpmn:userTask>
