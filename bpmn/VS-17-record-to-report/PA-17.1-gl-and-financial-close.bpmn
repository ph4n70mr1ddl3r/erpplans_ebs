Responsible (R): CFO
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W127_Flow20</bpmn:incoming>
        <bpmn:outgoing>W127_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W127_Task12" name="Communication">
