      <bpmndi:BPMNPlane id="W875_plane" bpmnElement="W_W875">
        <bpmndi:BPMNShape id="W875_Lane1_di" bpmnElement="W875_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W875_Lane2_di" bpmnElement="W875_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W875_Lane3_di" bpmnElement="W875_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W875_Lane4_di" bpmnElement="W875_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W875_Lane5_di" bpmnElement="W875_Lane5" isHorizontal="true"><dc:Bounds x="160" y="760" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W875_Task8_di" bpmnElement="W875_Task8"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
