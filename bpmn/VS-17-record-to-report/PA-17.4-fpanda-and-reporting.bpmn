    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W638" name="W638. Period-End Journal Entry Review &amp; Approval" isExecutable="false">
      <bpmn:documentation>Trigger: Manual journal entry posted during period-end close (W9A)
Frequency: Monthly (~50–100 manual JEs per entity per month-end)
Volume: ~250–500 manual JEs across 5 entities per month-end
Owner: Accounting Manager
Participants: Senior Accountant (preparer), Finance Manager (reviewer/approver), CFO (material entry approver)
Source: workflow W638 — Period-End Journal Entry Review &amp; Approval</bpmn:documentation>
      <bpmn:laneSet id="W638_LaneSet5">
        <bpmn:lane id="W638_Lane1" name="Senior Accountant">
        <bpmn:flowNodeRef>W638_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W638_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W638_Lane2" name="System">
        <bpmn:flowNodeRef>W638_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W638_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W638_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W638_Lane3" name="Approver">
        <bpmn:flowNodeRef>W638_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W638_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W638_Lane4" name="Finance Manager">
        <bpmn:flowNodeRef>W638_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W638_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W638_Start6" name="Manual journal entry posted during period-end close (W9A)">
        <bpmn:outgoing>W638_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W638_Task7" name="Senior Accountant prepares manual journal entry with: debit/credit accounts…">
        <bpmn:documentation>Step 1: Senior Accountant prepares manual journal entry with: debit/credit accounts, amounts, business justification, supporting documentation attachment, and JE classification (standard, correcting, estimate, overriding)
Responsible (R): Senior Accountant
Accountable (A): Accounting Manager
Duration: 15 min/JE</bpmn:documentation>
        <bpmn:incoming>W638_Flow17</bpmn:incoming>
        <bpmn:outgoing>W638_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W638_Task8" name="System auto-routes JE for approval based on approval matrix: routine entries &lt;…">
        <bpmn:documentation>Step 2: System auto-routes JE for approval based on approval matrix: routine entries &lt; PHP 500K → Accounting Manager; entries PHP 500K–5M → Finance Manager; entries &gt; PHP 5M or top-side consolidation entries → CFO
Responsible (R): System
Accountable (A): Accounting Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W638_Flow18</bpmn:incoming>
        <bpmn:outgoing>W638_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W638_Task9" name="For correcting and overriding JEs: system flags for enhanced review; requires…">
        <bpmn:documentation>Step 3: For correcting and overriding JEs: system flags for enhanced review; requires original transaction reference and root cause documentation
Responsible (R): System
Accountable (A): Accounting Manager
Duration: Automated flag</bpmn:documentation>
        <bpmn:incoming>W638_Flow19</bpmn:incoming>
        <bpmn:outgoing>W638_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W638_Task10" name="Approver reviews JE: validates account coding, verifies supporting…">
        <bpmn:documentation>Step 4: Approver reviews JE: validates account coding, verifies supporting documentation, assesses business rationale, confirms amount accuracy, checks for proper period
Responsible (R): Approver
Accountable (A): Finance Manager
Duration: 10 min/JE</bpmn:documentation>
        <bpmn:incoming>W638_Flow20</bpmn:incoming>
        <bpmn:outgoing>W638_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W638_Task11" name="Approver approves or rejects JE; rejected JEs return to preparer with comments…">
        <bpmn:documentation>Step 5: Approver approves or rejects JE; rejected JEs return to preparer with comments; system prevents period-close until all pending JEs are resolved
Responsible (R): Approver
Accountable (A): Finance Manager
Duration: 5 min/JE</bpmn:documentation>
        <bpmn:incoming>W638_Flow21</bpmn:incoming>
        <bpmn:outgoing>W638_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W638_Task12" name="Post-close: Finance Manager reviews complete manual JE register for the period…">
        <bpmn:documentation>Step 6: Post-close: Finance Manager reviews complete manual JE register for the period; flags unusual patterns (late entries, high-value estimates, reversing entries that didn&#x27;t reverse)
Responsible (R): Finance Manager
Accountable (A): CFO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W638_Flow22</bpmn:incoming>
        <bpmn:outgoing>W638_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W638_Task13" name="System generates monthly JE analytics: manual JE count and value by type…">
        <bpmn:documentation>Step 7: System generates monthly JE analytics: manual JE count and value by type, preparer, and entity; auto-reversal tracking; override frequency
Responsible (R): System
Accountable (A): Accounting Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W638_Flow23</bpmn:incoming>
        <bpmn:outgoing>W638_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W638_End14" name="Complete">
        <bpmn:incoming>W638_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W638_Annotation15">
        <bpmn:text>Controls: - CTL-292 (ensure controlled execution — FP&amp;A &amp; Reporting (PA-17.4).) | - operational: tiered approval matrix, enhanced review for correcting/overriding entries, and post-close analytics; operational: system-enforced documentation requirements and post-close review in Step 6; operational: root cause documentation requirement and escalation to Finance Manager
Owner: Accounting Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W638_Assoc16" sourceRef="W638_Annotation15" targetRef="W638_Start6" associationDirection="None" />
