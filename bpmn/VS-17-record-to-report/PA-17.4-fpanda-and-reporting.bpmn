    <bpmn:process id="W_W661" name="W661. Fixed Asset Depreciation Run &amp; Component Accounting Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly period-end; annual revaluation
Frequency: Monthly depreciation run; quarterly component review; annual impairment testing
Volume: ~5,000–8,000 fixed assets across 5 entities; ~200 store build-outs with component depreciation
Owner: Fixed Asset Accountant
Participants: Cost Accountant, Finance Manager, VP Store Operations (for store assets), Engineering Manager
Source: workflow W661 — Fixed Asset Depreciation Run &amp; Component Accounting Operations</bpmn:documentation>
      <bpmn:laneSet id="W661_LaneSet4">
        <bpmn:lane id="W661_Lane1" name="Fixed Asset Accountant">
        <bpmn:flowNodeRef>W661_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W661_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W661_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W661_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W661_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W661_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W661_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W661_Lane2" name="Cost Accountant">
        <bpmn:flowNodeRef>W661_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W661_Lane3" name="Finance Manager">
        <bpmn:flowNodeRef>W661_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W661_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W661_Start5" name="Monthly period-end; annual revaluation">
        <bpmn:outgoing>W661_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W661_Task6" name="System auto-generates depreciation schedule for all asset classes per entity…">
        <bpmn:documentation>Step 1: System auto-generates depreciation schedule for all asset classes per entity using configured depreciation methods (straight-line for buildings/furniture, declining balance for IT equipment, units-of-production for fleet)
Responsible (R): Fixed Asset Accountant
Accountable (A): Fixed Asset Accountant
Duration: 2 hrs</bpmn:documentation>
        <bpmn:incoming>W661_Flow17</bpmn:incoming>
        <bpmn:outgoing>W661_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W661_Task7" name="Fixed Asset Accountant reviews depreciation run exceptions: new assets without…">
        <bpmn:documentation>Step 2: Fixed Asset Accountant reviews depreciation run exceptions: new assets without class assignment, disposed assets with remaining NBV, transferred assets between locations
Responsible (R): Fixed Asset Accountant
Accountable (A): Finance Manager
Duration: 3 hrs</bpmn:documentation>
        <bpmn:incoming>W661_Flow18</bpmn:incoming>
        <bpmn:outgoing>W661_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W661_Task8" name="For 200 store build-outs: verify component depreciation for significant…">
        <bpmn:documentation>Step 3: For 200 store build-outs: verify component depreciation for significant components (HVAC, electrical, flooring, racking, signage) with different useful lives per PFRS/PAS 16 component approach
Responsible (R): Fixed Asset Accountant
Accountable (A): Engineering Manager
Duration: 4 hrs</bpmn:documentation>
        <bpmn:incoming>W661_Flow19</bpmn:incoming>
        <bpmn:outgoing>W661_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W661_Task9" name="Fixed Asset Accountant reconciles depreciation expense to fixed asset register…">
        <bpmn:documentation>Step 4: Fixed Asset Accountant reconciles depreciation expense to fixed asset register — total accumulated depreciation per entity
Responsible (R): Fixed Asset Accountant
Accountable (A): Finance Manager
Duration: 2 hrs</bpmn:documentation>
        <bpmn:incoming>W661_Flow20</bpmn:incoming>
        <bpmn:outgoing>W661_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W661_Task10" name="Cost Accountant allocates depreciation to cost centers (store-level P&amp;L per…">
        <bpmn:documentation>Step 5: Cost Accountant allocates depreciation to cost centers (store-level P&amp;L per W489, DC, HQ)
Responsible (R): Cost Accountant
Accountable (A): Finance Manager
Duration: 2 hrs</bpmn:documentation>
        <bpmn:incoming>W661_Flow21</bpmn:incoming>
        <bpmn:outgoing>W661_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W661_Task11" name="Monthly: post depreciation journal entries per entity; quarterly: review…">
        <bpmn:documentation>Step 6: Monthly: post depreciation journal entries per entity; quarterly: review component split for accuracy; annually: perform impairment testing per PAS 36 on assets with indicators of impairment
Responsible (R): Fixed Asset Accountant
Accountable (A): Finance Manager
Duration: 2 hrs</bpmn:documentation>
        <bpmn:incoming>W661_Flow22</bpmn:incoming>
        <bpmn:outgoing>W661_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W661_Task12" name="Fixed Asset Accountant generates depreciation reports per entity per class for…">
        <bpmn:documentation>Step 7: Fixed Asset Accountant generates depreciation reports per entity per class for tax return support (BIR 1702)
Responsible (R): Fixed Asset Accountant
Accountable (A): Finance Manager
Duration: 2 hrs</bpmn:documentation>
        <bpmn:incoming>W661_Flow23</bpmn:incoming>
        <bpmn:outgoing>W661_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W661_Task13" name="Finance Manager reviews and approves depreciation entries">
        <bpmn:documentation>Step 8: Finance Manager reviews and approves depreciation entries
Responsible (R): Finance Manager
Accountable (A): CFO
Duration: 1 hr</bpmn:documentation>
        <bpmn:incoming>W661_Flow24</bpmn:incoming>
        <bpmn:outgoing>W661_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W661_End14" name="Complete">
        <bpmn:incoming>W661_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W661_Annotation15">
        <bpmn:text>Controls: - CTL-292 (ensure controlled execution — FP&amp;A &amp; Reporting (PA-17.4).) | - operational: Fixed Asset Accountant review and approval gate; operational: periodic reconciliation against source documents
Owner: Fixed Asset Accountant</bpmn:text>
      </bpmn:textAnnotation>
