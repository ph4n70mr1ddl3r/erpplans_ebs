    <bpmn:process id="W_W231" name="W231. Management Performance Reporting (QBR)" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly results availability
Frequency: Quarterly
Volume: Comprehensive review of all 200+ stores and 5 entities
Owner: CFO
Participants: Executive Team, Regional VPs, Department Heads
Source: workflow W231 — Management Performance Reporting (QBR)</bpmn:documentation>
      <bpmn:laneSet id="W231_LaneSet6">
        <bpmn:lane id="W231_Lane1" name="BI Analyst">
        <bpmn:flowNodeRef>W231_Task8</bpmn:flowNodeRef>
