        <bpmndi:BPMNEdge id="W637_Flow23_di" bpmnElement="W637_Flow23"><di:waypoint x="1840" y="165" /><di:waypoint x="1890" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W637_Assoc15_di" bpmnElement="W637_Assoc15"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
