      <bpmn:startEvent id="W9A_Start11" name="Last calendar day of the month">
        <bpmn:outgoing>W9A_Flow32</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W9A_Task12" name="Verify all store day-end closings are posted; follow up on any outstanding">
        <bpmn:documentation>Step 1: Verify all store day-end closings are posted; follow up on any outstanding
Responsible (R): Chief Accountant
Accountable (A): Controller
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W9A_Flow32</bpmn:incoming>
        <bpmn:outgoing>W9A_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W9A_Task13" name="AP: Ensure all vendor invoices received before cut-off are entered and matched">
        <bpmn:documentation>Step 2: AP: Ensure all vendor invoices received before cut-off are entered and matched
Responsible (R): AP Supervisor
Accountable (A): Controller
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W9A_Flow33</bpmn:incoming>
        <bpmn:outgoing>W9A_Flow34</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W9A_Task14" name="AR: Post all AR invoices and payments received through month-end">
        <bpmn:documentation>Step 3: AR: Post all AR invoices and payments received through month-end
Responsible (R): AR Clerk
Accountable (A): Controller
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W9A_Flow34</bpmn:incoming>
        <bpmn:outgoing>W9A_Flow35</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W9A_Task15" name="Accruals: Book accrual entries for expenses incurred but not yet invoiced…">
        <bpmn:documentation>Step 4: Accruals: Book accrual entries for expenses incurred but not yet invoiced (utilities, freight, rent)
Responsible (R): Chief Accountant
Accountable (A): Controller
Duration: 3 hours</bpmn:documentation>
        <bpmn:incoming>W9A_Flow35</bpmn:incoming>
        <bpmn:outgoing>W9A_Flow36</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W9A_Task16" name="Intercompany: Verify all IC transactions are posted; run IC matching">
        <bpmn:documentation>Step 5: Intercompany: Verify all IC transactions are posted; run IC matching
Responsible (R): Chief Accountant
Accountable (A): Controller
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W9A_Flow36</bpmn:incoming>
        <bpmn:outgoing>W9A_Flow37</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W9A_Task17" name="Inventory: Verify perpetual WAC (weighted average cost) calculations; post…">
        <bpmn:documentation>Step 6: Inventory: Verify perpetual WAC (weighted average cost) calculations; post adjustments from cycle counts
Responsible (R): Cost Accountant
Accountable (A): Controller
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W9A_Flow37</bpmn:incoming>
        <bpmn:outgoing>W9A_Flow38</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W9A_Task18" name="Fixed Assets: Post monthly depreciation">
        <bpmn:documentation>Step 7: Fixed Assets: Post monthly depreciation
Responsible (R): Cost Accountant
Accountable (A): Controller
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W9A_Flow38</bpmn:incoming>
        <bpmn:outgoing>W9A_Flow39</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W9A_Task19" name="Prepayments: Amortize prepaid expenses (insurance, rent)">
        <bpmn:documentation>Step 8: Prepayments: Amortize prepaid expenses (insurance, rent)
Responsible (R): Chief Accountant
Accountable (A): Controller
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W9A_Flow39</bpmn:incoming>
        <bpmn:outgoing>W9A_Flow40</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W9A_Task20" name="Bank reconciliation: Match bank statements to GL cash accounts (all bank…">
        <bpmn:documentation>Step 9: Bank reconciliation: Match bank statements to GL cash accounts (all bank accounts, all entities)
Responsible (R): Treasury Analyst
Accountable (A): Controller
Duration: 3 hours</bpmn:documentation>
        <bpmn:incoming>W9A_Flow40</bpmn:incoming>
        <bpmn:outgoing>W9A_Flow41</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W9A_Task21" name="Run trial balance per entity; review for unusual balances">
        <bpmn:documentation>Step 10: Run trial balance per entity; review for unusual balances
Responsible (R): Chief Accountant
Accountable (A): Controller
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W9A_Flow41</bpmn:incoming>
        <bpmn:outgoing>W9A_Flow42</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W9A_Task22" name="Post adjusting entries as needed">
        <bpmn:documentation>Step 11: Post adjusting entries as needed
Responsible (R): Chief Accountant
Accountable (A): Controller
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W9A_Flow42</bpmn:incoming>
        <bpmn:outgoing>W9A_Flow43</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W9A_Task23" name="Generate preliminary financial statements per entity (BS, IS, CF)">
        <bpmn:documentation>Step 12: Generate preliminary financial statements per entity (BS, IS, CF)
Responsible (R): System / Chief Accountant
Accountable (A): Controller
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W9A_Flow43</bpmn:incoming>
        <bpmn:outgoing>W9A_Flow44</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W9A_Task24" name="Run intercompany elimination entries for consolidation">
        <bpmn:documentation>Step 13: Run intercompany elimination entries for consolidation
Responsible (R): Chief Accountant
Accountable (A): CFO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W9A_Flow44</bpmn:incoming>
        <bpmn:outgoing>W9A_Flow45</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W9A_Task25" name="Generate consolidated financial statements (5 entities)">
        <bpmn:documentation>Step 14: Generate consolidated financial statements (5 entities)
Responsible (R): System / Chief Accountant
Accountable (A): CFO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W9A_Flow45</bpmn:incoming>
        <bpmn:outgoing>W9A_Flow46</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W9A_Task26" name="CFO reviews consolidated statements; queries variances">
        <bpmn:documentation>Step 15: CFO reviews consolidated statements; queries variances
Responsible (R): CFO
Accountable (A): CFO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W9A_Flow46</bpmn:incoming>
        <bpmn:outgoing>W9A_Flow47</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W9A_Task27" name="Tax Accountant prepares VAT return (BIR 2550M) and withholding tax returns…">
        <bpmn:documentation>Step 16: Tax Accountant prepares VAT return (BIR 2550M) and withholding tax returns (1601-EQ, 1601-C)
Responsible (R): Tax Accountant
Accountable (A): CFO
Duration: 3 hours</bpmn:documentation>
        <bpmn:incoming>W9A_Flow47</bpmn:incoming>
        <bpmn:outgoing>W9A_Flow48</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W9A_Task28" name="Final close: lock period in system">
        <bpmn:documentation>Step 17: Final close: lock period in system
Responsible (R): Controller
Accountable (A): CFO
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W9A_Flow48</bpmn:incoming>
        <bpmn:outgoing>W9A_Flow49</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W9A_End29" name="Complete">
        <bpmn:incoming>W9A_Flow49</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W9A_Annotation30">
        <bpmn:text>Controls: (none recorded)
Owner: Chief Accountant / Controller</bpmn:text>
      </bpmn:textAnnotation>
