        <bpmndi:BPMNEdge id="W5528_Flow19_di" bpmnElement="W5528_Flow19"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5528_Flow20_di" bpmnElement="W5528_Flow20"><di:waypoint x="1420" y="505" /><di:waypoint x="1450" y="335" /></bpmndi:BPMNEdge>
