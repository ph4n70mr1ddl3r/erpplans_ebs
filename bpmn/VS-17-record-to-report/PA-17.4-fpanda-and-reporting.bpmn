    <bpmn:process id="W_W184" name="W184. Fixed Asset Physical Verification (Audit)" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled annual or biennial fixed asset audit
Frequency: Annual (rolling per region)
Volume: ~205 locations (stores + DCs + HQ)
Owner: Fixed Asset Accountant
Participants: Store Manager, Internal Audit, IT Asset Manager (for IT equipment)
Source: workflow W184 — Fixed Asset Physical Verification (Audit)</bpmn:documentation>
      <bpmn:laneSet id="W184_LaneSet3">
        <bpmn:lane id="W184_Lane1" name="FA Accountant">
        <bpmn:flowNodeRef>W184_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W184_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W184_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W184_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W184_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W184_Lane2" name="Internal Audit">
        <bpmn:flowNodeRef>W184_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W184_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W184_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W184_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W184_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W184_Start4" name="Scheduled annual or biennial fixed asset audit">
        <bpmn:outgoing>W184_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W184_Task5" name="Fixed Asset Accountant generates &quot;Asset Audit List&quot; from ERP for a specific…">
        <bpmn:documentation>Step 1: Fixed Asset Accountant generates &quot;Asset Audit List&quot; from ERP for a specific location
Responsible (R): FA Accountant
Accountable (A): Controller
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W184_Flow16</bpmn:incoming>
        <bpmn:outgoing>W184_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W184_Task6" name="Audit team (Finance + Internal Audit) arrives at location; performs physical…">
        <bpmn:documentation>Step 2: Audit team (Finance + Internal Audit) arrives at location; performs physical count
Responsible (R): Internal Audit
Accountable (A): FA Accountant
Duration: 1-2 days</bpmn:documentation>
        <bpmn:incoming>W184_Flow17</bpmn:incoming>
        <bpmn:outgoing>W184_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W184_Task7" name="Use mobile scanner/RFID to scan asset tags (tagged per W21.7)">
        <bpmn:documentation>Step 3: Use mobile scanner/RFID to scan asset tags (tagged per W21.7)
Responsible (R): Internal Audit
Accountable (A): —
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W184_Flow18</bpmn:incoming>
        <bpmn:outgoing>W184_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W184_Task8" name="Record asset condition (Working, Needs Repair, Obsolescent, Missing)">
        <bpmn:documentation>Step 4: Record asset condition (Working, Needs Repair, Obsolescent, Missing)
Responsible (R): Internal Audit
Accountable (A): —
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W184_Flow19</bpmn:incoming>
        <bpmn:outgoing>W184_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W184_Task9" name="Reconcile physical count vs. ERP Asset Register">
        <bpmn:documentation>Step 5: Reconcile physical count vs. ERP Asset Register
Responsible (R): FA Accountant
Accountable (A): Controller
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W184_Flow20</bpmn:incoming>
        <bpmn:outgoing>W184_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W184_Task10" name="Investigate missing assets; interview location manager">
        <bpmn:documentation>Step 6: Investigate missing assets; interview location manager
Responsible (R): Internal Audit
Accountable (A): Store Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W184_Flow21</bpmn:incoming>
        <bpmn:outgoing>W184_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W184_Task11" name="Generate Audit Variance Report; obtain approvals for adjustments">
        <bpmn:documentation>Step 7: Generate Audit Variance Report; obtain approvals for adjustments
Responsible (R): FA Accountant
Accountable (A): CFO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W184_Flow22</bpmn:incoming>
        <bpmn:outgoing>W184_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W184_Task12" name="Update Asset Register">
        <bpmn:documentation>Step 8: Update Asset Register: change status, update location, or initiate disposal (W39)
Responsible (R): FA Accountant
Accountable (A): Controller
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W184_Flow23</bpmn:incoming>
        <bpmn:outgoing>W184_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W184_End13" name="Complete">
        <bpmn:incoming>W184_Flow24</bpmn:incoming>
      </bpmn:endEvent>
