    </bpmn:process>
    <bpmndi:BPMNDiagram id="W878_diag">
      <bpmndi:BPMNPlane id="W878_plane" bpmnElement="W_W878">
        <bpmndi:BPMNShape id="W878_Lane1_di" bpmnElement="W878_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W878_Lane2_di" bpmnElement="W878_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W878_Lane3_di" bpmnElement="W878_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W878_Lane4_di" bpmnElement="W878_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W878_Task7_di" bpmnElement="W878_Task7"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W878_Task8_di" bpmnElement="W878_Task8"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W878_Task9_di" bpmnElement="W878_Task9"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
