    <bpmn:process id="W_W637" name="W637. Financial Controls Testing &amp; Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly control testing cycle; triggered by control exception alerts
Frequency: Quarterly comprehensive testing; continuous monitoring for automated controls
Volume: 808 controls per Internal Controls Matrix (67 core + 172 domain anchors + 569 process-area operating); risk-based quarterly testing focuses on ~30 key/domain-anchor controls
Owner: Accounting Manager
Participants: Senior Accountant (tester), Finance Manager (reviewer), Internal Audit (independent validation per W331)
Source: workflow W637 — Financial Controls Testing &amp; Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W637_LaneSet4">
        <bpmn:lane id="W637_Lane1" name="Accounting Manager">
        <bpmn:flowNodeRef>W637_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W637_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W637_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W637_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W637_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W637_Lane2" name="Senior Accountant">
        <bpmn:flowNodeRef>W637_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W637_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W637_Lane3" name="Finance Manager">
        <bpmn:flowNodeRef>W637_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W637_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W637_Start5" name="Quarterly control testing cycle; triggered by control exception alerts">
        <bpmn:outgoing>W637_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W637_Task6" name="Accounting Manager prepares quarterly testing plan: selects controls for…">
        <bpmn:documentation>Step 1: Accounting Manager prepares quarterly testing plan: selects controls for testing per risk-based rotation (all key controls tested annually; high-risk controls tested quarterly)
Responsible (R): Accounting Manager
Accountable (A): Finance Manager
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W637_Flow16</bpmn:incoming>
        <bpmn:outgoing>W637_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W637_Task7" name="Senior Accountant executes testing per control: selects sample of transactions…">
        <bpmn:documentation>Step 2: Senior Accountant executes testing per control: selects sample of transactions (statistically valid sample size per population), verifies control operated as designed, documents test results with evidence
Responsible (R): Senior Accountant
Accountable (A): Accounting Manager
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W637_Flow17</bpmn:incoming>
        <bpmn:outgoing>W637_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W637_Task8" name="For automated controls: system generates exception report for control…">
        <bpmn:documentation>Step 3: For automated controls: system generates exception report for control overrides, late approvals, skipped authorizations, and tolerance threshold breaches; Senior Accountant investigates exceptions
Responsible (R): Senior Accountant
Accountable (A): Accounting Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W637_Flow18</bpmn:incoming>
        <bpmn:outgoing>W637_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W637_Task9" name="Accounting Manager classifies findings: operating effectively, deficiency…">
        <bpmn:documentation>Step 4: Accounting Manager classifies findings: operating effectively, deficiency (design or operating), significant deficiency, material weakness; documents root cause for any deficiency
Responsible (R): Accounting Manager
Accountable (A): Finance Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W637_Flow19</bpmn:incoming>
        <bpmn:outgoing>W637_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W637_Task10" name="For identified deficiencies: Accounting Manager creates remediation plan with…">
        <bpmn:documentation>Step 5: For identified deficiencies: Accounting Manager creates remediation plan with responsible owner, corrective action, and target date; tracks remediation to completion
Responsible (R): Accounting Manager
Accountable (A): Finance Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W637_Flow20</bpmn:incoming>
        <bpmn:outgoing>W637_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W637_Task11" name="Finance Manager reviews testing results and remediation status; escalates…">
        <bpmn:documentation>Step 6: Finance Manager reviews testing results and remediation status; escalates significant deficiencies to CFO and Audit Committee
Responsible (R): Finance Manager
Accountable (A): CFO
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W637_Flow21</bpmn:incoming>
        <bpmn:outgoing>W637_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W637_Task12" name="Quarterly results shared with Internal Audit (W331) for independent validation…">
        <bpmn:documentation>Step 7: Quarterly results shared with Internal Audit (W331) for independent validation and external audit coordination (W95)
Responsible (R): Accounting Manager
Accountable (A): Finance Manager
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W637_Flow22</bpmn:incoming>
        <bpmn:outgoing>W637_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W637_End13" name="Complete">
        <bpmn:incoming>W637_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W637_Annotation14">
        <bpmn:text>Controls: - CTL-292 (ensure controlled execution — FP&amp;A &amp; Reporting (PA-17.4).) | - operational: risk-based rotation and automated control monitoring; operational: continuous monitoring of automated controls in Step 3; operational: system-tracked remediation with escalation at 30/60/90 days
Owner: Accounting Manager</bpmn:text>
      </bpmn:textAnnotation>
