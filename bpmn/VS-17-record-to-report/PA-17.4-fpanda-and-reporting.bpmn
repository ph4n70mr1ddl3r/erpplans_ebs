    <bpmn:process id="W_W9A" name="W9A. Month-End Close" isExecutable="false">
      <bpmn:documentation>Trigger: Last calendar day of the month
Frequency: Monthly
Volume: 5 entities × 12 months = 60 entity-month closes/year
Owner: Chief Accountant / Controller
Participants: Chief Accountant, AP Supervisor, AR Supervisor, Treasury Analyst, Tax Accountant, Cost Accountant, CFO
Source: workflow W9A — Month-End Close</bpmn:documentation>
      <bpmn:laneSet id="W9A_LaneSet10">
        <bpmn:lane id="W9A_Lane1" name="Chief Accountant">
