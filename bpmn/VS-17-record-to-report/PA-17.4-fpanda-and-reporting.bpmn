        <bpmn:outgoing>W9B_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W9B_Task8" name="13th month pay accrual reconciliation">
        <bpmn:documentation>Step 1: 13th month pay accrual reconciliation
Responsible (R): Payroll Accountant
Accountable (A): Controller
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W9B_Flow17</bpmn:incoming>
        <bpmn:outgoing>W9B_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W9B_Task9" name="Physical inventory (wall-to-wall) count and adjustment">
        <bpmn:documentation>Step 2: Physical inventory (wall-to-wall) count and adjustment
Responsible (R): Cost Accountant + all store staff
Accountable (A): CFO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W9B_Flow18</bpmn:incoming>
        <bpmn:outgoing>W9B_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W9B_Task10" name="Year-end tax provisions and adjustments">
        <bpmn:documentation>Step 3: Year-end tax provisions and adjustments
Responsible (R): Tax Accountant
Accountable (A): Controller
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W9B_Flow19</bpmn:incoming>
        <bpmn:outgoing>W9B_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W9B_Task11" name="Annual income tax return preparation (BIR 1702RT)">
        <bpmn:documentation>Step 4: Annual income tax return preparation (BIR 1702RT)
Responsible (R): Tax Accountant
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W9B_Flow20</bpmn:incoming>
        <bpmn:outgoing>W9B_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W9B_Task12" name="External audit preparation and coordination">
        <bpmn:documentation>Step 5: External audit preparation and coordination
Responsible (R): Controller + CFO
Accountable (A): CEO
Duration: Ongoing (Q1)</bpmn:documentation>
        <bpmn:incoming>W9B_Flow21</bpmn:incoming>
        <bpmn:outgoing>W9B_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W9B_Task13" name="SEC annual report preparation">
        <bpmn:documentation>Step 6: SEC annual report preparation
Responsible (R): Controller
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W9B_Flow22</bpmn:incoming>
        <bpmn:outgoing>W9B_Flow23</bpmn:outgoing>
      </bpmn:userTask>
