    <bpmn:process id="W_W21" name="W21. Capital Expenditure (Capex) Request &amp; Approval" isExecutable="false">
      <bpmn:documentation>Trigger: Need identified for asset acquisition (equipment, vehicles, fixtures, IT hardware, store build-out)
Frequency: ~50–80 capex requests/year
Volume: Peaks during new store openings (W16) and annual budget cycle
Owner: Requesting Department Head
Participants: Requestor, Department Head, Finance (Capex Analyst), CFO, CEO/Board
Source: workflow W21 — Capital Expenditure (Capex) Request &amp; Approval</bpmn:documentation>
      <bpmn:laneSet id="W21_LaneSet8">
        <bpmn:lane id="W21_Lane1" name="Requestor">
        <bpmn:flowNodeRef>W21_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W21_Start9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W21_Lane2" name="Dept. Head">
        <bpmn:flowNodeRef>W21_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W21_Lane3" name="Capex Analyst">
        <bpmn:flowNodeRef>W21_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W21_Task18</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W21_Lane4" name="System">
        <bpmn:flowNodeRef>W21_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W21_Task17</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W21_Lane5" name="Buyer">
        <bpmn:flowNodeRef>W21_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W21_Lane6" name="Receiving Clerk">
        <bpmn:flowNodeRef>W21_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W21_Lane7" name="Cost Accountant">
        <bpmn:flowNodeRef>W21_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W21_End19</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W21_Start9" name="Need identified for asset acquisition (equipment, vehicles, fixtures, IT hardware, store…">
        <bpmn:outgoing>W21_Flow22</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W21_Task10" name="Requestor submits capex request: item description, justification, quotations…">
        <bpmn:documentation>Step 1: Requestor submits capex request: item description, justification, quotations (min. 3), expected useful life, budget code
Responsible (R): Requestor
Accountable (A): Dept. Head
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W21_Flow22</bpmn:incoming>
        <bpmn:outgoing>W21_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W21_Task11" name="Department Head reviews and approves or returns for revision">
        <bpmn:documentation>Step 2: Department Head reviews and approves or returns for revision
Responsible (R): Dept. Head
Accountable (A): Dept. Head
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W21_Flow23</bpmn:incoming>
        <bpmn:outgoing>W21_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W21_Task12" name="Finance (Capex Analyst) validates against approved annual budget; checks ROI…">
        <bpmn:documentation>Step 3: Finance (Capex Analyst) validates against approved annual budget; checks ROI calculation
Responsible (R): Capex Analyst
Accountable (A): CFO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W21_Flow24</bpmn:incoming>
        <bpmn:outgoing>W21_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W21_Task13" name="Route for approval per tiered matrix (see below)">
        <bpmn:documentation>Step 4: Route for approval per tiered matrix (see below)
Responsible (R): System
Accountable (A): As per tier
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W21_Flow25</bpmn:incoming>
        <bpmn:outgoing>W21_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W21_Task14" name="Approved capex → Purchase Order created (standard PO workflow W2) or direct…">
        <bpmn:documentation>Step 5: Approved capex → Purchase Order created (standard PO workflow W2) or direct purchase
Responsible (R): Buyer / Requestor
Accountable (A): Dept. Head
Duration: Per W2</bpmn:documentation>
        <bpmn:incoming>W21_Flow26</bpmn:incoming>
        <bpmn:outgoing>W21_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W21_Task15" name="Goods/asset received; Goods Receipt posted">
        <bpmn:documentation>Step 6: Goods/asset received; Goods Receipt posted
Responsible (R): Receiving Clerk / IT
Accountable (A): Dept. Head
Duration: Per W3</bpmn:documentation>
        <bpmn:incoming>W21_Flow27</bpmn:incoming>
        <bpmn:outgoing>W21_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W21_Task16" name="Finance capitalizes asset in Fixed Asset module: asset tag, location…">
        <bpmn:documentation>Step 7: Finance capitalizes asset in Fixed Asset module: asset tag, location, depreciation schedule, useful life
Responsible (R): Cost Accountant
Accountable (A): Controller
Duration: 15 min/asset</bpmn:documentation>
        <bpmn:incoming>W21_Flow28</bpmn:incoming>
        <bpmn:outgoing>W21_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W21_Task17" name="System begins monthly depreciation per schedule">
        <bpmn:documentation>Step 8: System begins monthly depreciation per schedule
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W21_Flow29</bpmn:incoming>
        <bpmn:outgoing>W21_Flow30</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W21_Task18" name="Post-implementation review: actual vs. budgeted cost; in-service date">
        <bpmn:documentation>Step 9: Post-implementation review: actual vs. budgeted cost; in-service date
Responsible (R): Capex Analyst
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W21_Flow30</bpmn:incoming>
        <bpmn:outgoing>W21_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W21_End19" name="Complete">
        <bpmn:incoming>W21_Flow31</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W21_Annotation20">
        <bpmn:text>Controls: - CTL-02 (prevent unauthorized capital expenditure.) | - operational: Requesting Department Head review and approval gate
Owner: Requesting Department Head</bpmn:text>
      </bpmn:textAnnotation>
