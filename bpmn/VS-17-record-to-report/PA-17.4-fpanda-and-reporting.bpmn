    <bpmn:process id="W_W639" name="W639. Rolling Forecast &amp; Financial Scenario Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly forecast update cycle; triggered by material business change (new store delay, major vendor disruption, FX shock)
Frequency: Monthly 12-month rolling forecast update; quarterly scenario analysis
Volume: 1 consolidated forecast per month; 3 scenarios (base, upside, downside) per quarter
Owner: FP&amp;A Manager
Participants: FP&amp;A Analyst, Category Managers (revenue input), HR Manager (labor cost input), VP Supply Chain (COGS input), CFO (review)
Source: workflow W639 — Rolling Forecast &amp; Financial Scenario Planning</bpmn:documentation>
      <bpmn:laneSet id="W639_LaneSet7">
        <bpmn:lane id="W639_Lane1" name="FP&amp;A Analyst">
        <bpmn:flowNodeRef>W639_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W639_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W639_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W639_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W639_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W639_Lane3" name="VP Supply Chain">
        <bpmn:flowNodeRef>W639_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W639_Lane4" name="HR Manager">
        <bpmn:flowNodeRef>W639_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W639_Lane5" name="FP&amp;A Manager">
        <bpmn:flowNodeRef>W639_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W639_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W639_Lane6" name="CFO">
        <bpmn:flowNodeRef>W639_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W639_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W639_Start8" name="Monthly forecast update cycle; triggered by material business change (new store delay…">
        <bpmn:outgoing>W639_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W639_Task9" name="FP&amp;A Analyst extracts actual month results and compares against prior forecast…">
        <bpmn:documentation>Step 1: FP&amp;A Analyst extracts actual month results and compares against prior forecast; identifies forecast vs. actual variances by major line item (revenue, gross margin, operating expenses, capex)
Responsible (R): FP&amp;A Analyst
Accountable (A): FP&amp;A Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W639_Flow20</bpmn:incoming>
        <bpmn:outgoing>W639_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W639_Task10" name="Category Managers provide updated revenue outlook by category considering…">
        <bpmn:documentation>Step 2: Category Managers provide updated revenue outlook by category considering: current sell-through trends, promotional calendar impact, new store ramp curves, competitive landscape
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W639_Flow21</bpmn:incoming>
        <bpmn:outgoing>W639_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W639_Task11" name="VP Supply Chain provides updated COGS outlook: commodity price trends, FX…">
        <bpmn:documentation>Step 3: VP Supply Chain provides updated COGS outlook: commodity price trends, FX forecast impact on imports, vendor price negotiations, and logistics cost changes
Responsible (R): VP Supply Chain
Accountable (A): COO
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W639_Flow22</bpmn:incoming>
        <bpmn:outgoing>W639_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W639_Task12" name="HR Manager provides updated labor cost outlook: hiring plan changes, wage rate…">
        <bpmn:documentation>Step 4: HR Manager provides updated labor cost outlook: hiring plan changes, wage rate adjustments, new store staffing
Responsible (R): HR Manager
Accountable (A): CHRO
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W639_Flow23</bpmn:incoming>
        <bpmn:outgoing>W639_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W639_Task13" name="FP&amp;A Analyst updates 12-month rolling forecast model incorporating all inputs…">
        <bpmn:documentation>Step 5: FP&amp;A Analyst updates 12-month rolling forecast model incorporating all inputs; calculates net income, EBITDA, and cash flow implications
Responsible (R): FP&amp;A Analyst
Accountable (A): FP&amp;A Manager
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W639_Flow24</bpmn:incoming>
        <bpmn:outgoing>W639_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W639_Task14" name="Quarterly: FP&amp;A Manager develops three scenarios — base (most likely), upside…">
        <bpmn:documentation>Step 6: Quarterly: FP&amp;A Manager develops three scenarios — base (most likely), upside (accelerated growth, favorable FX), downside (consumer spending decline, adverse FX, supply disruption) with probability weighting
Responsible (R): FP&amp;A Manager
Accountable (A): CFO
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W639_Flow25</bpmn:incoming>
        <bpmn:outgoing>W639_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W639_Task15" name="FP&amp;A Manager presents rolling forecast and scenario analysis to CFO and…">
        <bpmn:documentation>Step 7: FP&amp;A Manager presents rolling forecast and scenario analysis to CFO and executive team with key risks, sensitivities, and recommended management actions
Responsible (R): FP&amp;A Manager
Accountable (A): CFO
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W639_Flow26</bpmn:incoming>
        <bpmn:outgoing>W639_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W639_Task16" name="CFO approves forecast for Board reporting; updates cash flow projections for…">
        <bpmn:documentation>Step 8: CFO approves forecast for Board reporting; updates cash flow projections for treasury planning (W589/W233) and covenant compliance monitoring (W319)
Responsible (R): CFO
Accountable (A): CEO
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W639_Flow27</bpmn:incoming>
        <bpmn:outgoing>W639_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W639_End17" name="Complete">
        <bpmn:incoming>W639_Flow28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W639_Annotation18">
        <bpmn:text>Controls: - CTL-292 (ensure controlled execution — FP&amp;A &amp; Reporting (PA-17.4).) | - operational: structured input templates and deadline enforcement; operational: monthly re-forecasting and probability-weighted scenarios; operational: quarterly refresh and sensitivity analysis
Owner: FP&amp;A Manager</bpmn:text>
      </bpmn:textAnnotation>
