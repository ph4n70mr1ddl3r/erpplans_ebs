      <bpmn:startEvent id="W231_Start7" name="Quarterly results availability">
        <bpmn:outgoing>W231_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W231_Task8" name="Data Aggregation">
        <bpmn:documentation>Step 1: Data Aggregation: Pull financial and operational KPIs from ERP/BI (W113)
Responsible (R): BI Analyst
Accountable (A): CFO
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W231_Flow16</bpmn:incoming>
        <bpmn:outgoing>W231_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W231_Task9" name="Narrative Prep">
        <bpmn:documentation>Step 2: Narrative Prep: Dept Heads provide &quot;Variance Analysis&quot; (Actual vs. Budget/Target)
Responsible (R): Dept Heads
Accountable (A): —
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W231_Flow17</bpmn:incoming>
        <bpmn:outgoing>W231_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W231_Task10" name="QBR Meeting">
        <bpmn:documentation>Step 3: QBR Meeting: Present results to Executive Team; focus on underperforming areas
Responsible (R): Executive Team
Accountable (A): CEO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W231_Flow18</bpmn:incoming>
        <bpmn:outgoing>W231_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W231_Task11" name="Action Items">
        <bpmn:documentation>Step 4: Action Items: Document corrective actions and owners
Responsible (R): Strategy Team
Accountable (A): CEO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W231_Flow19</bpmn:incoming>
        <bpmn:outgoing>W231_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W231_Task12" name="Follow-up">
        <bpmn:documentation>Step 5: Follow-up: Track completion of QBR action items in next month&#x27;s review
Responsible (R): Chief of Staff
Accountable (A): CEO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W231_Flow20</bpmn:incoming>
        <bpmn:outgoing>W231_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W231_End13" name="Complete">
        <bpmn:incoming>W231_Flow21</bpmn:incoming>
      </bpmn:endEvent>
