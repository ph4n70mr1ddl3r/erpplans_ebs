      <bpmn:startEvent id="W35_Start16" name="Reporting calendar (daily, weekly, monthly, quarterly cadences)">
        <bpmn:outgoing>W35_Flow41</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W35_Task17" name="System generates daily flash report (auto-distributed by 7:00 AM): total chain…">
        <bpmn:documentation>Step 1: System generates daily flash report (auto-distributed by 7:00 AM): total chain revenue, transactions, avg ticket, same-store sales vs. prior year, top/bottom 10 stores
Responsible (R): System
Accountable (A): Controller
Duration: Daily (automated)</bpmn:documentation>
        <bpmn:incoming>W35_Flow41</bpmn:incoming>
        <bpmn:outgoing>W35_Flow42</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W35_Task18" name="CFO reviews daily flash on mobile dashboard">
        <bpmn:documentation>Step 2: CFO reviews daily flash on mobile dashboard
Responsible (R): CFO
Accountable (A): —
Duration: 5 min/day</bpmn:documentation>
        <bpmn:incoming>W35_Flow42</bpmn:incoming>
        <bpmn:outgoing>W35_Flow43</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W35_Task19" name="System generates daily inventory exception report: negative stock alerts…">
        <bpmn:documentation>Step 3: System generates daily inventory exception report: negative stock alerts, stockouts at store level, critical DC shortages
Responsible (R): System
Accountable (A): Supply Planning Manager
Duration: Daily (automated)</bpmn:documentation>
        <bpmn:incoming>W35_Flow43</bpmn:incoming>
        <bpmn:outgoing>W35_Flow44</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W35_Task20" name="Week-on-week sales report by store, category, and channel (POS vs. ecommerce)…">
        <bpmn:documentation>Step 4: Week-on-week sales report by store, category, and channel (POS vs. ecommerce); auto-distributed every Monday
Responsible (R): System
Accountable (A): Controller
Duration: Weekly (automated)</bpmn:documentation>
        <bpmn:incoming>W35_Flow44</bpmn:incoming>
        <bpmn:outgoing>W35_Flow45</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W35_Task21" name="Supply chain KPI report: fill rate, on-time delivery (DC→store), PO overdue…">
        <bpmn:documentation>Step 5: Supply chain KPI report: fill rate, on-time delivery (DC→store), PO overdue rate, forecast accuracy
Responsible (R): Demand Planner
Accountable (A): Supply Planning Manager
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W35_Flow45</bpmn:incoming>
        <bpmn:outgoing>W35_Flow46</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W35_Task22" name="AP aging summary: total payables, overdue invoices, payment run schedule">
        <bpmn:documentation>Step 6: AP aging summary: total payables, overdue invoices, payment run schedule
Responsible (R): AP Supervisor
Accountable (A): Controller
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W35_Flow46</bpmn:incoming>
        <bpmn:outgoing>W35_Flow47</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W35_Task23" name="Treasury: weekly cash flow forecast (W30 step 8)">
        <bpmn:documentation>Step 7: Treasury: weekly cash flow forecast (W30 step 8)
Responsible (R): Treasury Analyst
Accountable (A): CFO
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W35_Flow47</bpmn:incoming>
        <bpmn:outgoing>W35_Flow48</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W35_Task24" name="Financial statements per entity and consolidated (from W9 close process)">
        <bpmn:documentation>Step 8: Financial statements per entity and consolidated (from W9 close process)
Responsible (R): Chief Accountant
Accountable (A): Controller
Duration: Monthly (by day 5)</bpmn:documentation>
        <bpmn:incoming>W35_Flow48</bpmn:incoming>
        <bpmn:outgoing>W35_Flow49</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W35_Task25" name="Budget vs. actual variance report per entity, per department (from W26)">
        <bpmn:documentation>Step 9: Budget vs. actual variance report per entity, per department (from W26)
Responsible (R): Controller
Accountable (A): CFO
Duration: Monthly (by day 7)</bpmn:documentation>
        <bpmn:incoming>W35_Flow49</bpmn:incoming>
        <bpmn:outgoing>W35_Flow50</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W35_Task26" name="Store P&amp;L: revenue, COGS, gross margin, labor cost, occupancy, shrinkage…">
        <bpmn:documentation>Step 10: Store P&amp;L: revenue, COGS, gross margin, labor cost, occupancy, shrinkage, EBITDA per store
Responsible (R): System
Accountable (A): VP Store Operations
Duration: Monthly (by day 7)</bpmn:documentation>
        <bpmn:incoming>W35_Flow50</bpmn:incoming>
        <bpmn:outgoing>W35_Flow51</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W35_Task27" name="Merchandising performance: category sales, margin, inventory turns…">
        <bpmn:documentation>Step 11: Merchandising performance: category sales, margin, inventory turns, sell-through, vendor rebate realization
Responsible (R): Pricing Analyst
Accountable (A): VP Merchandising
Duration: Monthly (by day 7)</bpmn:documentation>
        <bpmn:incoming>W35_Flow51</bpmn:incoming>
        <bpmn:outgoing>W35_Flow52</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W35_Task28" name="AR aging and collections performance: DSO, overdue %, write-offs">
        <bpmn:documentation>Step 12: AR aging and collections performance: DSO, overdue %, write-offs
Responsible (R): AR Supervisor
Accountable (A): CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W35_Flow52</bpmn:incoming>
        <bpmn:outgoing>W35_Flow53</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W35_Task29" name="HR metrics: turnover rate, time-to-fill, absenteeism, overtime hours, headcount…">
        <bpmn:documentation>Step 13: HR metrics: turnover rate, time-to-fill, absenteeism, overtime hours, headcount vs. plan
Responsible (R): HR Head
Accountable (A): CHRO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W35_Flow53</bpmn:incoming>
        <bpmn:outgoing>W35_Flow54</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W35_Task30" name="Management committee meeting: CFO presents consolidated results; Department…">
        <bpmn:documentation>Step 14: Management committee meeting: CFO presents consolidated results; Department Heads present functional KPIs
Responsible (R): CFO / Dept. Heads
Accountable (A): CEO
Duration: Monthly (by day 10)</bpmn:documentation>
        <bpmn:incoming>W35_Flow54</bpmn:incoming>
        <bpmn:outgoing>W35_Flow55</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W35_Task31" name="Board pack preparation: consolidated financials, management discussion &amp;…">
        <bpmn:documentation>Step 15: Board pack preparation: consolidated financials, management discussion &amp; analysis, KPI scorecard, risk register update
Responsible (R): Controller + CFO
Accountable (A): CEO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W35_Flow55</bpmn:incoming>
        <bpmn:outgoing>W35_Flow56</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W35_Task32" name="Vendor performance scorecard review (W44)">
        <bpmn:documentation>Step 16: Vendor performance scorecard review (W44)
Responsible (R): Buyer
Accountable (A): VP Merchandising
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W35_Flow56</bpmn:incoming>
        <bpmn:outgoing>W35_Flow57</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W35_Task33" name="Budget revision (if material changes warranted) (W26 step 13)">
        <bpmn:documentation>Step 17: Budget revision (if material changes warranted) (W26 step 13)
Responsible (R): Controller
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W35_Flow57</bpmn:incoming>
        <bpmn:outgoing>W35_Flow58</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W35_Task34" name="Document retention compliance review">
        <bpmn:documentation>Step 18: Document retention compliance review: Controller verifies that all document types (invoices, receipts, delivery receipts, import docs, capex records) meet 10-year BIR retention requirements; confirms expired documents are archived and accessible; flags any gaps in document attachment compliance
Responsible (R): Controller
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W35_Flow58</bpmn:incoming>
        <bpmn:outgoing>W35_Flow59</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W35_Task35" name="Credit note / debit note aging review">
        <bpmn:documentation>Step 19: Credit note / debit note aging review: Chief Accountant presents summary of unapplied AP and AR credit memos &gt; 60 days; Controller reviews resolution status; material unresolved items escalated to CFO
Responsible (R): Chief Accountant / Controller
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W35_Flow59</bpmn:incoming>
        <bpmn:outgoing>W35_Flow60</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W35_Task36" name="Department Heads request ad-hoc reports from BI Analyst or self-service via…">
        <bpmn:documentation>Step 20: Department Heads request ad-hoc reports from BI Analyst or self-service via report builder
Responsible (R): Dept. Heads / BI Analyst
Accountable (A): —
Duration: As needed (~20/month)</bpmn:documentation>
        <bpmn:incoming>W35_Flow60</bpmn:incoming>
        <bpmn:outgoing>W35_Flow61</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W35_Task37" name="BI Analyst creates custom analyses: product affinity, customer segmentation…">
        <bpmn:documentation>Step 21: BI Analyst creates custom analyses: product affinity, customer segmentation, promotional lift analysis, geographic trends
Responsible (R): BI Analyst
Accountable (A): Requestor
Duration: As needed</bpmn:documentation>
        <bpmn:incoming>W35_Flow61</bpmn:incoming>
        <bpmn:outgoing>W35_Flow62</bpmn:outgoing>
      </bpmn:userTask>
