    <bpmn:process id="W_W636" name="W636. Standardized Balance Sheet Account Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly close calendar (day 1–3 of month-end close per W9A)
Frequency: Monthly for all accounts; daily for bank accounts (per W89)
Volume: ~50–80 balance sheet accounts per entity × 5 entities = ~250–400 reconciliations/month
Owner: Accounting Manager
Participants: Senior Accountant (per entity), Finance Manager (reviewer)
Source: workflow W636 — Standardized Balance Sheet Account Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W636_LaneSet5">
        <bpmn:lane id="W636_Lane1" name="System">
        <bpmn:flowNodeRef>W636_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W636_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W636_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W636_Lane2" name="Senior Accountant">
        <bpmn:flowNodeRef>W636_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W636_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W636_Lane3" name="Accounting Manager">
        <bpmn:flowNodeRef>W636_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W636_Lane4" name="Finance Manager">
        <bpmn:flowNodeRef>W636_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W636_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W636_Start6" name="Monthly close calendar (day 1–3 of month-end close per W9A)">
        <bpmn:outgoing>W636_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W636_Task7" name="System generates reconciliation templates for all balance sheet accounts with…">
        <bpmn:documentation>Step 1: System generates reconciliation templates for all balance sheet accounts with opening balance, period activity, closing balance, and supporting sub-ledger detail
Responsible (R): System
Accountable (A): Accounting Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W636_Flow16</bpmn:incoming>
        <bpmn:outgoing>W636_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W636_Task8" name="Senior Accountant completes reconciliation per account: verifies balance to…">
        <bpmn:documentation>Step 2: Senior Accountant completes reconciliation per account: verifies balance to supporting documentation (sub-ledger, third-party statements, schedules), identifies reconciling items, classifies items (timing difference, error, omission, unknown)
Responsible (R): Senior Accountant
Accountable (A): Accounting Manager
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W636_Flow17</bpmn:incoming>
        <bpmn:outgoing>W636_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W636_Task9" name="For reconciling items: Senior Accountant creates resolution task with owner…">
        <bpmn:documentation>Step 3: For reconciling items: Senior Accountant creates resolution task with owner, root cause, and target resolution date; items &gt; 90 days auto-escalate to Finance Manager
Responsible (R): Senior Accountant
Accountable (A): Accounting Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W636_Flow18</bpmn:incoming>
        <bpmn:outgoing>W636_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W636_Task10" name="Accounting Manager reviews all reconciliations for completeness and accuracy…">
        <bpmn:documentation>Step 4: Accounting Manager reviews all reconciliations for completeness and accuracy; verifies no accounts are unreconciled; signs off per entity
Responsible (R): Accounting Manager
Accountable (A): Finance Manager
Duration: 1 day/entity</bpmn:documentation>
        <bpmn:incoming>W636_Flow19</bpmn:incoming>
        <bpmn:outgoing>W636_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W636_Task11" name="Finance Manager reviews consolidated reconciliation dashboard: completion rate…">
        <bpmn:documentation>Step 5: Finance Manager reviews consolidated reconciliation dashboard: completion rate, reconciling item aging (current, 30, 60, 90+ days), high-risk accounts (cash, IC, VAT, inventory reserves)
Responsible (R): Finance Manager
Accountable (A): CFO
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W636_Flow20</bpmn:incoming>
        <bpmn:outgoing>W636_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W636_Task12" name="System auto-generates reconciliation completion tracker and aging report for…">
        <bpmn:documentation>Step 6: System auto-generates reconciliation completion tracker and aging report for month-end close package (W9A)
Responsible (R): System
Accountable (A): Accounting Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W636_Flow21</bpmn:incoming>
        <bpmn:outgoing>W636_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W636_End13" name="Complete">
        <bpmn:incoming>W636_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W636_Annotation14">
        <bpmn:text>Controls: - CTL-292 (ensure controlled execution — FP&amp;A &amp; Reporting (PA-17.4).) | - operational: system-generated templates and auto-matching for standard account types; operational: dedicated reconciliation procedures for high-risk accounts; operational: auto-escalation at 90 days and monthly aging review
Owner: Accounting Manager</bpmn:text>
      </bpmn:textAnnotation>
