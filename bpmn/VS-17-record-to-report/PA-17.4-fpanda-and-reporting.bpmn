    <bpmn:process id="W_W26" name="W26. Annual Budget Preparation &amp; Monthly Variance Review" isExecutable="false">
      <bpmn:documentation>Trigger: Annual budget calendar (typically Q4 for following year)
Frequency: Annual budget cycle; monthly variance review
Volume: 5 entities × 200+ cost centers; ~500–800 GL accounts per entity
Owner: Controller
Participants: Controller, CFO, Department Heads, Category Managers (merchandising budget), VP Store Operations (store-level budget), HR (payroll budget), IT (capex budget)
Source: workflow W26 — Annual Budget Preparation &amp; Monthly Variance Review</bpmn:documentation>
      <bpmn:laneSet id="W26_LaneSet8">
        <bpmn:lane id="W26_Lane1" name="CFO">
        <bpmn:flowNodeRef>W26_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W26_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W26_Task21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W26_Start9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W26_Lane2" name="Dept. Heads">
        <bpmn:flowNodeRef>W26_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W26_Task20</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W26_Lane3" name="Category Manager">
        <bpmn:flowNodeRef>W26_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W26_Lane4" name="VP Store Operations">
        <bpmn:flowNodeRef>W26_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W26_Lane5" name="HR Head">
        <bpmn:flowNodeRef>W26_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W26_Lane6" name="Controller">
        <bpmn:flowNodeRef>W26_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W26_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W26_Task19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W26_Task22</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W26_Lane7" name="Board">
        <bpmn:flowNodeRef>W26_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W26_End23</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W26_Start9" name="Annual budget calendar (typically Q4 for following year)">
        <bpmn:outgoing>W26_Flow26</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W26_Task10" name="CFO issues budget circular with guidelines, assumptions (revenue growth…">
        <bpmn:documentation>Step 1: CFO issues budget circular with guidelines, assumptions (revenue growth, inflation, headcount plan, new store openings)
Responsible (R): CFO
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W26_Flow26</bpmn:incoming>
        <bpmn:outgoing>W26_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W26_Task11" name="Department Heads prepare department-level budget: opex, headcount, capex…">
        <bpmn:documentation>Step 2: Department Heads prepare department-level budget: opex, headcount, capex requests
Responsible (R): Dept. Heads
Accountable (A): VP / C-Suite
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W26_Flow27</bpmn:incoming>
        <bpmn:outgoing>W26_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W26_Task12" name="Category Managers prepare merchandise purchase budget by category (COGS, margin…">
        <bpmn:documentation>Step 3: Category Managers prepare merchandise purchase budget by category (COGS, margin targets, inventory levels)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W26_Flow28</bpmn:incoming>
        <bpmn:outgoing>W26_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W26_Task13" name="VP Store Operations prepares store-level P&amp;L budgets (revenue per store, labor…">
        <bpmn:documentation>Step 4: VP Store Operations prepares store-level P&amp;L budgets (revenue per store, labor, utilities, shrinkage)
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W26_Flow29</bpmn:incoming>
        <bpmn:outgoing>W26_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W26_Task14" name="HR prepares payroll budget (salary adjustments, new hires, statutory increases)">
        <bpmn:documentation>Step 5: HR prepares payroll budget (salary adjustments, new hires, statutory increases)
Responsible (R): HR Head
Accountable (A): CHRO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W26_Flow30</bpmn:incoming>
        <bpmn:outgoing>W26_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W26_Task15" name="Controller consolidates all department budgets into draft company budget per…">
        <bpmn:documentation>Step 6: Controller consolidates all department budgets into draft company budget per entity
Responsible (R): Controller
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W26_Flow31</bpmn:incoming>
        <bpmn:outgoing>W26_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W26_Task16" name="CFO and CEO review consolidated draft; negotiate adjustments with Department…">
        <bpmn:documentation>Step 7: CFO and CEO review consolidated draft; negotiate adjustments with Department Heads
Responsible (R): CFO / CEO
Accountable (A): CEO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W26_Flow32</bpmn:incoming>
        <bpmn:outgoing>W26_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W26_Task17" name="Board approves annual budget">
        <bpmn:documentation>Step 8: Board approves annual budget
Responsible (R): Board
Accountable (A): CEO
Duration: 1 meeting</bpmn:documentation>
        <bpmn:incoming>W26_Flow33</bpmn:incoming>
        <bpmn:outgoing>W26_Flow34</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W26_Task18" name="System loads approved budget per entity, per cost center, per GL account…">
        <bpmn:documentation>Step 9: System loads approved budget per entity, per cost center, per GL account (monthly phasing)
Responsible (R): Controller / System
Accountable (A): CFO
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W26_Flow34</bpmn:incoming>
        <bpmn:outgoing>W26_Flow35</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W26_Task19" name="Monthly: Controller generates budget vs. actual report per entity and…">
        <bpmn:documentation>Step 10: Monthly: Controller generates budget vs. actual report per entity and consolidated
Responsible (R): Controller
Accountable (A): CFO
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W26_Flow35</bpmn:incoming>
        <bpmn:outgoing>W26_Flow36</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W26_Task20" name="Department Heads review their variances; provide explanations for material…">
        <bpmn:documentation>Step 11: Department Heads review their variances; provide explanations for material deviations (&gt; 10%)
Responsible (R): Dept. Heads
Accountable (A): VP / C-Suite
Duration: 1 hour/month each</bpmn:documentation>
        <bpmn:incoming>W26_Flow36</bpmn:incoming>
        <bpmn:outgoing>W26_Flow37</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W26_Task21" name="CFO reviews consolidated variance report; identifies risks and corrective…">
        <bpmn:documentation>Step 12: CFO reviews consolidated variance report; identifies risks and corrective actions
Responsible (R): CFO
Accountable (A): CEO
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W26_Flow37</bpmn:incoming>
        <bpmn:outgoing>W26_Flow38</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W26_Task22" name="Quarterly: if material changes warranted, Controller prepares budget revision…">
        <bpmn:documentation>Step 13: Quarterly: if material changes warranted, Controller prepares budget revision for CFO/Board approval
Responsible (R): Controller
Accountable (A): CFO
Duration: 4 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W26_Flow38</bpmn:incoming>
        <bpmn:outgoing>W26_Flow39</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W26_End23" name="Complete">
        <bpmn:incoming>W26_Flow39</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W26_Annotation24">
        <bpmn:text>Controls: - CTL-35 (ensure budget adherence.) | - operational: Controller review and approval gate
Owner: Controller</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W26_Assoc25" sourceRef="W26_Annotation24" targetRef="W26_Start9" associationDirection="None" />
