    <bpmn:process id="W_W137" name="W137. Intercompany Dividend &amp; Loan Management" isExecutable="false">
      <bpmn:documentation>Trigger: Cash flow optimization or profit distribution request
Frequency: Quarterly or Annual
Volume: ~10–20 intercompany loan/dividend movements per year; IC loan portfolio estimated PHP 500M–1B during peak expansion periods
Owner: Treasury Manager
Participants: CFO, CEO, Legal (W124), Tax Manager, Treasury Analyst, Chief Accountant, Board of Directors (for dividend declarations)
Source: workflow W137 — Intercompany Dividend &amp; Loan Management</bpmn:documentation>
      <bpmn:laneSet id="W137_LaneSet7">
        <bpmn:lane id="W137_Lane1" name="Treasury Mgr">
        <bpmn:flowNodeRef>W137_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W137_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W137_Lane2" name="Tax Manager">
        <bpmn:flowNodeRef>W137_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W137_Lane3" name="Legal Counsel">
        <bpmn:flowNodeRef>W137_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W137_Lane4" name="Treasury Analyst">
        <bpmn:flowNodeRef>W137_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W137_Lane5" name="GL Accountant">
        <bpmn:flowNodeRef>W137_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W137_Lane6" name="Consolidation Mgr">
        <bpmn:flowNodeRef>W137_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W137_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W137_Start8" name="Cash flow optimization or profit distribution request">
        <bpmn:outgoing>W137_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W137_Task9" name="Cash Surplus Identification: Determine excess cash in subsidiary entities">
        <bpmn:documentation>Step 1: Cash Surplus Identification: Determine excess cash in subsidiary entities
Responsible (R): Treasury Mgr
Accountable (A): CFO
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W137_Flow18</bpmn:incoming>
        <bpmn:outgoing>W137_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W137_Task10" name="Loan/Dividend Structuring: Determine optimal transfer method (Loan vs. Dividend)">
        <bpmn:documentation>Step 2: Loan/Dividend Structuring: Determine optimal transfer method (Loan vs. Dividend)
Responsible (R): Tax Manager
Accountable (A): CFO
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W137_Flow19</bpmn:incoming>
        <bpmn:outgoing>W137_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W137_Task11" name="Documentation: Draft loan agreement or board resolution (W124)">
        <bpmn:documentation>Step 3: Documentation: Draft loan agreement or board resolution (W124)
Responsible (R): Legal Counsel
Accountable (A): Corp Secretary
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W137_Flow20</bpmn:incoming>
        <bpmn:outgoing>W137_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W137_Task12" name="Execution: Process fund transfer and record in ERP (W14)">
        <bpmn:documentation>Step 4: Execution: Process fund transfer and record in ERP (W14)
Responsible (R): Treasury Analyst
Accountable (A): Treasury Mgr
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W137_Flow21</bpmn:incoming>
        <bpmn:outgoing>W137_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W137_Task13" name="Monitoring: Track interest accruals (for loans) and withholding tax (for…">
        <bpmn:documentation>Step 5: Monitoring: Track interest accruals (for loans) and withholding tax (for dividends)
Responsible (R): GL Accountant
Accountable (A): Tax Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W137_Flow22</bpmn:incoming>
        <bpmn:outgoing>W137_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W137_Task14" name="Elimination: Ensure intercompany loans/dividends are eliminated in…">
        <bpmn:documentation>Step 6: Elimination: Ensure intercompany loans/dividends are eliminated in consolidation (W9)
Responsible (R): Consolidation Mgr
Accountable (A): CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W137_Flow23</bpmn:incoming>
        <bpmn:outgoing>W137_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W137_End15" name="Complete">
        <bpmn:incoming>W137_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W137_Annotation16">
        <bpmn:text>Controls: - CTL-290 (ensure controlled execution — Consolidation &amp; Intercompany (PA-17.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Treasury Manager</bpmn:text>
      </bpmn:textAnnotation>
