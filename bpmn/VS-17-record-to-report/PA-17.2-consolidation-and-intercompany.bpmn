    <bpmn:process id="W_W612" name="W612. Intercompany Rate Setting &amp; Quarterly Transfer Pricing Review" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly calendar; annual review; or change in market conditions
Frequency: Quarterly formal review; annual comprehensive update
Volume: 5 legal entities; ~8–12 intercompany service/transaction types
Owner: Controller
Participants: Controller, CFO, Tax Accountant, Chief Accountant, external transfer pricing advisor
Source: workflow W612 — Intercompany Rate Setting &amp; Quarterly Transfer Pricing Review</bpmn:documentation>
      <bpmn:laneSet id="W612_LaneSet5">
        <bpmn:lane id="W612_Lane1" name="Controller">
        <bpmn:flowNodeRef>W612_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W612_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W612_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W612_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W612_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W612_Lane2" name="Tax Accountant">
        <bpmn:flowNodeRef>W612_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W612_Lane3" name="Chief Accountant">
        <bpmn:flowNodeRef>W612_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W612_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W612_Lane4" name="System">
        <bpmn:flowNodeRef>W612_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W612_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W612_Start6" name="Quarterly calendar; annual review; or change in market conditions">
        <bpmn:outgoing>W612_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W612_Task7" name="Controller prepares quarterly IC rate review package: current IC pricing for…">
        <bpmn:documentation>Step 1: Controller prepares quarterly IC rate review package: current IC pricing for all transaction types (warehousing fee per pallet, distribution fee per delivery, ecommerce fulfillment fee per order, property lease per sqm, management fees), actual costs incurred, comparison to prior period rates, and market benchmark data
Responsible (R): Controller
Accountable (A): CFO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W612_Flow18</bpmn:incoming>
        <bpmn:outgoing>W612_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W612_Task8" name="Controller validates arm&#x27;s-length compliance: compares IC rates to external…">
        <bpmn:documentation>Step 2: Controller validates arm&#x27;s-length compliance: compares IC rates to external market data (3PL warehousing rates, delivery service rates, commercial lease rates in same LGU); documents benchmark methodology per BIR Transfer Pricing guidelines (RR 02-2013) and PAS 24 disclosure requirements (per W486)
Responsible (R): Controller
Accountable (A): External TP Advisor
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W612_Flow19</bpmn:incoming>
        <bpmn:outgoing>W612_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W612_Task9" name="Tax Accountant reviews IC rate implications for tax compliance: (a) BIR…">
        <bpmn:documentation>Step 3: Tax Accountant reviews IC rate implications for tax compliance: (a) BIR scrutiny risk for IC rates significantly above or below market, (b) VAT treatment of IC services, (c) withholding tax obligations on cross-entity payments, (d) BOI/PEZA entity implications (per W472)
Responsible (R): Tax Accountant
Accountable (A): Controller
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W612_Flow20</bpmn:incoming>
        <bpmn:outgoing>W612_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W612_Task10" name="Quarterly meeting: Controller presents rate review to CFO; CFO approves or…">
        <bpmn:documentation>Step 4: Quarterly meeting: Controller presents rate review to CFO; CFO approves or adjusts IC rates; for rate changes &gt; 10%, external transfer pricing advisor provides written opinion; CFO approves with advisor concurrence
Responsible (R): Controller
Accountable (A): CFO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W612_Flow21</bpmn:incoming>
        <bpmn:outgoing>W612_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W612_Task11" name="Chief Accountant updates IC transfer pricing rule master in ERP (per W305)…">
        <bpmn:documentation>Step 5: Chief Accountant updates IC transfer pricing rule master in ERP (per W305); configures new rates with effective date; system validates rate change against defined tolerance thresholds (±15% from prior rate requires Controller re-approval)
Responsible (R): Chief Accountant
Accountable (A): Controller
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W612_Flow22</bpmn:incoming>
        <bpmn:outgoing>W612_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W612_Task12" name="System auto-generates IC invoices at new rates from effective date; IC…">
        <bpmn:documentation>Step 6: System auto-generates IC invoices at new rates from effective date; IC settlement process (per W14) applies updated rates; consolidation module (per W9A) uses updated rates for elimination entries
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W612_Flow23</bpmn:incoming>
        <bpmn:outgoing>W612_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W612_Task13" name="Annual: Controller engages external transfer pricing advisor for comprehensive…">
        <bpmn:documentation>Step 7: Annual: Controller engages external transfer pricing advisor for comprehensive TP documentation preparation — functional analysis, comparability analysis, benchmark study, and TP report per BIR requirements; estimated cost: PHP 500K-1M/year
Responsible (R): Controller
Accountable (A): CFO
Duration: 20 hours</bpmn:documentation>
        <bpmn:incoming>W612_Flow24</bpmn:incoming>
        <bpmn:outgoing>W612_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W612_Task14" name="Annual: Chief Accountant ensures PAS 24 related party disclosure in annual…">
        <bpmn:documentation>Step 8: Annual: Chief Accountant ensures PAS 24 related party disclosure in annual financial statements includes all IC transaction types, amounts, and pricing methods (per W486)
Responsible (R): Chief Accountant
Accountable (A): Controller
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W612_Flow25</bpmn:incoming>
        <bpmn:outgoing>W612_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W612_End15" name="Complete">
        <bpmn:incoming>W612_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W612_Annotation16">
        <bpmn:text>Controls: - CTL-290 (ensure controlled execution — Consolidation &amp; Intercompany (PA-17.2).) | - operational: annual TP documentation in Step 7; operational: quarterly review cadence and automatic escalation trigger if cost variance &gt; 10%
Owner: Controller</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W612_Assoc17" sourceRef="W612_Annotation16" targetRef="W612_Start6" associationDirection="None" />
