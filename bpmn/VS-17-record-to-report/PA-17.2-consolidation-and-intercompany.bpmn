<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-17.2-consolidation-and-intercompany" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W14" name="W14. Intercompany Transactions &amp; Settlement" isExecutable="false">
      <bpmn:documentation>Trigger: Subsidiary requires funding for working capital, capex, or seasonal cash flow needs beyond internal cash generation
Frequency: As needed; typically 5–10 IC loan events/year
Volume: ~100–200 IC transactions/month
Owner: CFO
Participants: CFO, Treasury Analyst, Chief Accountant, borrowing entity Finance lead
Source: workflow W14 — Intercompany Transactions &amp; Settlement</bpmn:documentation>
      <bpmn:laneSet id="W14_LaneSet10">
        <bpmn:lane id="W14_Lane1" name="System">
        <bpmn:flowNodeRef>W14_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W14_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W14_Task19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W14_Task22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W14_Task26</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W14_Task37</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W14_Task40</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W14_Start11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W14_Lane2" name="Chief Accountant">
        <bpmn:flowNodeRef>W14_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W14_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W14_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W14_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W14_Task20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W14_Task27</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W14_Task29</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W14_Task30</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W14_Task38</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W14_Lane3" name="Treasury Analyst">
        <bpmn:flowNodeRef>W14_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W14_Task36</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W14_Task39</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W14_Lane4" name="Requesting entity staff">
        <bpmn:flowNodeRef>W14_Task21</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W14_Lane5" name="Approver">
        <bpmn:flowNodeRef>W14_Task23</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W14_Lane6" name="DC">
        <bpmn:flowNodeRef>W14_Task24</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W14_Lane7" name="Receiving Staff">
        <bpmn:flowNodeRef>W14_Task25</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W14_Lane8" name="Entity Finance Lead">
        <bpmn:flowNodeRef>W14_Task28</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W14_Task34</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W14_Lane9" name="CFO">
        <bpmn:flowNodeRef>W14_Task31</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W14_Task32</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W14_Task33</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W14_Task35</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W14_Task41</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W14_End42</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W14_Start11" name="Subsidiary requires funding for working capital, capex, or seasonal cash flow needs…">
        <bpmn:outgoing>W14_Flow45</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W14_Task12" name="System auto-generates IC invoices based on configured transfer pricing rules">
        <bpmn:documentation>Step 1: System auto-generates IC invoices based on configured transfer pricing rules
Responsible (R): System
Accountable (A): Chief Accountant
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W14_Flow45</bpmn:incoming>
        <bpmn:outgoing>W14_Flow46</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W14_Task13" name="Chief Accountant reviews IC invoice batch for accuracy">
        <bpmn:documentation>Step 2: Chief Accountant reviews IC invoice batch for accuracy
Responsible (R): Chief Accountant
Accountable (A): Controller
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W14_Flow46</bpmn:incoming>
        <bpmn:outgoing>W14_Flow47</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W14_Task14" name="System posts IC AP in buying entity and IC AR in selling entity simultaneously">
        <bpmn:documentation>Step 3: System posts IC AP in buying entity and IC AR in selling entity simultaneously
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W14_Flow47</bpmn:incoming>
        <bpmn:outgoing>W14_Flow48</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W14_Task15" name="Monthly: run IC reconciliation report — verify balances match across all entity…">
        <bpmn:documentation>Step 4: Monthly: run IC reconciliation report — verify balances match across all entity pairs
Responsible (R): Chief Accountant
Accountable (A): Controller
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W14_Flow48</bpmn:incoming>
        <bpmn:outgoing>W14_Flow49</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W14_Task16" name="Resolve any IC mismatches (timing differences, missing entries)">
        <bpmn:documentation>Step 5: Resolve any IC mismatches (timing differences, missing entries)
Responsible (R): Chief Accountant
Accountable (A): Controller
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W14_Flow49</bpmn:incoming>
        <bpmn:outgoing>W14_Flow50</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W14_Task17" name="Prepare net settlement schedule (offset IC balances; only net amounts paid)">
        <bpmn:documentation>Step 6: Prepare net settlement schedule (offset IC balances; only net amounts paid)
Responsible (R): Chief Accountant
Accountable (A): CFO
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W14_Flow50</bpmn:incoming>
        <bpmn:outgoing>W14_Flow51</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W14_Task18" name="CFO approves IC settlement; Treasury executes bank transfers">
        <bpmn:documentation>Step 7: CFO approves IC settlement; Treasury executes bank transfers
Responsible (R): Treasury Analyst
Accountable (A): CFO
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W14_Flow51</bpmn:incoming>
        <bpmn:outgoing>W14_Flow52</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W14_Task19" name="At month-end close: system runs IC elimination entries for consolidation">
        <bpmn:documentation>Step 8: At month-end close: system runs IC elimination entries for consolidation
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W14_Flow52</bpmn:incoming>
        <bpmn:outgoing>W14_Flow53</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W14_Task20" name="Verify consolidation eliminates all IC revenue, expense, AP, AR">
        <bpmn:documentation>Step 9: Verify consolidation eliminates all IC revenue, expense, AP, AR
Responsible (R): Chief Accountant
Accountable (A): CFO
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W14_Flow53</bpmn:incoming>
        <bpmn:outgoing>W14_Flow54</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W14_Task21" name="Requesting entity creates IC Purchase Requisition in system: item(s), quantity…">
        <bpmn:documentation>Step 10: Requesting entity creates IC Purchase Requisition in system: item(s), quantity, justification, requesting entity, delivery location
Responsible (R): Requesting entity staff
Accountable (A): Requesting entity Dept. Head
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W14_Flow54</bpmn:incoming>
        <bpmn:outgoing>W14_Flow55</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W14_Task22" name="System checks Depot Inc. inventory availability at nearest DC/store with ATP…">
        <bpmn:documentation>Step 11: System checks Depot Inc. inventory availability at nearest DC/store with ATP; if available, auto-creates IC Sales Order in Depot Inc. and linked IC Purchase Order in requesting entity at configured transfer pricing rule (cost + 5% markup for materials; SRP for small office supplies)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W14_Flow55</bpmn:incoming>
        <bpmn:outgoing>W14_Flow56</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W14_Task23" name="If IC value &gt; PHP 50,000: approval required from requesting entity Finance…">
        <bpmn:documentation>Step 12: If IC value &gt; PHP 50,000: approval required from requesting entity Finance Manager and Depot Inc. Category Manager; if &lt; PHP 50,000: auto-approved within contract parameters
Responsible (R): Approver(s)
Accountable (A): CFO
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W14_Flow56</bpmn:incoming>
        <bpmn:outgoing>W14_Flow57</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W14_Task24" name="Depot Inc. DC or store picks goods; scan-confirms shipment; system reduces…">
        <bpmn:documentation>Step 13: Depot Inc. DC or store picks goods; scan-confirms shipment; system reduces Depot Inc. inventory, creates in-transit inventory
Responsible (R): DC/Store Staff
Accountable (A): DC Supervisor / Store Manager
Duration: Per W3/W22</bpmn:documentation>
        <bpmn:incoming>W14_Flow57</bpmn:incoming>
        <bpmn:outgoing>W14_Flow58</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W14_Task25" name="Requesting entity receives goods; scan-confirms receipt; system increases…">
        <bpmn:documentation>Step 14: Requesting entity receives goods; scan-confirms receipt; system increases requesting entity inventory (if applicable) or posts directly to expense/consumption
Responsible (R): Receiving Staff
Accountable (A): Dept. Head
Duration: Per W3/W18</bpmn:documentation>
        <bpmn:incoming>W14_Flow58</bpmn:incoming>
        <bpmn:outgoing>W14_Flow59</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W14_Task26" name="System auto-generates IC invoice from IC Sales Order at transfer price…">
        <bpmn:documentation>Step 15: System auto-generates IC invoice from IC Sales Order at transfer price; simultaneous posting: Depot Inc. Dr. IC Receivable / Cr. IC Revenue + Cr. Inventory (at cost); requesting entity Dr. Expense/Inventory / Cr. IC Payable
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W14_Flow59</bpmn:incoming>
        <bpmn:outgoing>W14_Flow60</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W14_Task27" name="IC invoice included in monthly W14 IC reconciliation and settlement cycle">
        <bpmn:documentation>Step 16: IC invoice included in monthly W14 IC reconciliation and settlement cycle
Responsible (R): Chief Accountant
Accountable (A): Controller
Duration: Per W14</bpmn:documentation>
        <bpmn:incoming>W14_Flow60</bpmn:incoming>
        <bpmn:outgoing>W14_Flow61</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W14_Task28" name="Receiving entity&#x27;s Finance lead identifies IC charge discrepancy: amount does…">
        <bpmn:documentation>Step 17: Receiving entity&#x27;s Finance lead identifies IC charge discrepancy: amount does not match agreed transfer pricing rule, volume calculation is incorrect, or charge was not anticipated
Responsible (R): Entity Finance Lead
Accountable (A): Chief Accountant
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W14_Flow61</bpmn:incoming>
        <bpmn:outgoing>W14_Flow62</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W14_Task29" name="Chief Accountant reviews the disputed IC invoice against the configured…">
        <bpmn:documentation>Step 18: Chief Accountant reviews the disputed IC invoice against the configured transfer pricing rule and underlying transaction data (e.g., number of orders fulfilled, square meters leased, payment collections remitted)
Responsible (R): Chief Accountant
Accountable (A): Controller
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W14_Flow62</bpmn:incoming>
        <bpmn:outgoing>W14_Flow63</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W14_Task30" name="If calculation error confirmed: Chief Accountant corrects the IC invoice in…">
        <bpmn:documentation>Step 19: If calculation error confirmed: Chief Accountant corrects the IC invoice in system; system reposts corrected entries in both entities; no further escalation needed
Responsible (R): Chief Accountant
Accountable (A): Controller
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W14_Flow63</bpmn:incoming>
        <bpmn:outgoing>W14_Flow64</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W14_Task31" name="If dispute is about pricing rule interpretation (not a calculation error)…">
        <bpmn:documentation>Step 20: If dispute is about pricing rule interpretation (not a calculation error): Chief Accountant escalates to CFO for ruling; CFO interprets the transfer pricing agreement per the documented IC framework (W14)
Responsible (R): CFO
Accountable (A): CEO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W14_Flow64</bpmn:incoming>
        <bpmn:outgoing>W14_Flow65</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W14_Task32" name="CFO decision is final; Chief Accountant adjusts IC invoice if needed…">
        <bpmn:documentation>Step 21: CFO decision is final; Chief Accountant adjusts IC invoice if needed; Controller documents the interpretation precedent for inclusion in annual IC transfer pricing review (W14 annual review)
Responsible (R): CFO / Chief Accountant
Accountable (A): Controller
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W14_Flow65</bpmn:incoming>
        <bpmn:outgoing>W14_Flow66</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W14_Task33" name="If dispute reveals a systemic issue with the IC pricing rule: CFO initiates an…">
        <bpmn:documentation>Step 22: If dispute reveals a systemic issue with the IC pricing rule: CFO initiates an early review of the applicable IC pricing rule (outside the annual cycle) and updates the system configuration
Responsible (R): CFO
Accountable (A): CEO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W14_Flow66</bpmn:incoming>
        <bpmn:outgoing>W14_Flow67</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W14_Task34" name="Subsidiary Finance lead identifies funding need; submits IC loan request to CFO…">
        <bpmn:documentation>Step 23: Subsidiary Finance lead identifies funding need; submits IC loan request to CFO with amount, purpose, proposed repayment schedule, and cash flow justification
Responsible (R): Entity Finance Lead
Accountable (A): CFO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W14_Flow67</bpmn:incoming>
        <bpmn:outgoing>W14_Flow68</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W14_Task35" name="CFO approves IC loan; defines terms: principal, interest rate (at minimum the…">
        <bpmn:documentation>Step 24: CFO approves IC loan; defines terms: principal, interest rate (at minimum the BIR-prescribed rate for related-party loans — currently ~12% per annum per the RR 14-2002 prescribed-rate practice — consistent with arm&#x27;s-length requirements under RR 02-2013), repayment schedule (lump sum or amortizing), and maturity date
Responsible (R): CFO
Accountable (A): CEO
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W14_Flow68</bpmn:incoming>
        <bpmn:outgoing>W14_Flow69</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W14_Task36" name="Treasury Analyst executes inter-entity bank transfer; system posts IC loan…">
        <bpmn:documentation>Step 25: Treasury Analyst executes inter-entity bank transfer; system posts IC loan entry (Dr. IC Loan Receivable in lending entity / Cr. Cash; Dr. Cash / Cr. IC Loan Payable in borrowing entity)
Responsible (R): Treasury Analyst
Accountable (A): CFO
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W14_Flow69</bpmn:incoming>
        <bpmn:outgoing>W14_Flow70</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W14_Task37" name="System calculates monthly interest accrual per loan terms: Dr. IC Interest…">
        <bpmn:documentation>Step 26: System calculates monthly interest accrual per loan terms: Dr. IC Interest Receivable / Cr. IC Interest Income in lending entity; Dr. Interest Expense / Cr. IC Interest Payable in borrowing entity; interest accrual posts automatically at month-end as part of W9A close
Responsible (R): System
Accountable (A): Controller
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W14_Flow70</bpmn:incoming>
        <bpmn:outgoing>W14_Flow71</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W14_Task38" name="Monthly: Chief Accountant reconciles IC loan balances (principal + accrued…">
        <bpmn:documentation>Step 27: Monthly: Chief Accountant reconciles IC loan balances (principal + accrued interest) across lending and borrowing entities as part of W14 step 4 IC reconciliation
Responsible (R): Chief Accountant
Accountable (A): Controller
Duration: Part of W14</bpmn:documentation>
        <bpmn:incoming>W14_Flow71</bpmn:incoming>
        <bpmn:outgoing>W14_Flow72</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W14_Task39" name="At repayment: Treasury Analyst executes repayment transfer; system posts…">
        <bpmn:documentation>Step 28: At repayment: Treasury Analyst executes repayment transfer; system posts principal repayment and any remaining accrued interest; IC loan balance reduced accordingly
Responsible (R): Treasury Analyst
Accountable (A): CFO
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W14_Flow72</bpmn:incoming>
        <bpmn:outgoing>W14_Flow73</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W14_Task40" name="At maturity: if loan not yet repaid, system alerts CFO 30 days before maturity…">
        <bpmn:documentation>Step 29: At maturity: if loan not yet repaid, system alerts CFO 30 days before maturity; CFO decides to extend, demand repayment, or convert to equity (with Board approval if applicable)
Responsible (R): System / CFO
Accountable (A): CEO
Duration: Automated + 15 min decision</bpmn:documentation>
        <bpmn:incoming>W14_Flow73</bpmn:incoming>
        <bpmn:outgoing>W14_Flow74</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W14_Task41" name="Annual: CFO reviews all IC loan balances and terms as part of W14 annual…">
        <bpmn:documentation>Step 30: Annual: CFO reviews all IC loan balances and terms as part of W14 annual transfer pricing review; confirms arm&#x27;s-length compliance; adjusts terms if regulatory rates change
Responsible (R): CFO
Accountable (A): CEO
Duration: Part of W14 annual review</bpmn:documentation>
        <bpmn:incoming>W14_Flow74</bpmn:incoming>
        <bpmn:outgoing>W14_Flow75</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W14_End42" name="Complete">
        <bpmn:incoming>W14_Flow75</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W14_Annotation43">
        <bpmn:text>Controls: - CTL-18 (ensure IC balance agreement.); CTL-63 (ensure FX exposure reporting accuracy.); CTL-66 (ensure treasury month-end close accuracy.) | - operational: Chief Accountant review and approval gate; operational: periodic reconciliation against source documents
Owner: CFO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W14_Assoc44" sourceRef="W14_Annotation43" targetRef="W14_Start11" associationDirection="None" />
      <bpmn:sequenceFlow id="W14_Flow45" sourceRef="W14_Start11" targetRef="W14_Task12" />
      <bpmn:sequenceFlow id="W14_Flow46" sourceRef="W14_Task12" targetRef="W14_Task13" />
      <bpmn:sequenceFlow id="W14_Flow47" sourceRef="W14_Task13" targetRef="W14_Task14" />
      <bpmn:sequenceFlow id="W14_Flow48" sourceRef="W14_Task14" targetRef="W14_Task15" />
      <bpmn:sequenceFlow id="W14_Flow49" sourceRef="W14_Task15" targetRef="W14_Task16" />
      <bpmn:sequenceFlow id="W14_Flow50" sourceRef="W14_Task16" targetRef="W14_Task17" />
      <bpmn:sequenceFlow id="W14_Flow51" sourceRef="W14_Task17" targetRef="W14_Task18" />
      <bpmn:sequenceFlow id="W14_Flow52" sourceRef="W14_Task18" targetRef="W14_Task19" />
      <bpmn:sequenceFlow id="W14_Flow53" sourceRef="W14_Task19" targetRef="W14_Task20" />
      <bpmn:sequenceFlow id="W14_Flow54" sourceRef="W14_Task20" targetRef="W14_Task21" />
      <bpmn:sequenceFlow id="W14_Flow55" sourceRef="W14_Task21" targetRef="W14_Task22" />
      <bpmn:sequenceFlow id="W14_Flow56" sourceRef="W14_Task22" targetRef="W14_Task23" />
      <bpmn:sequenceFlow id="W14_Flow57" sourceRef="W14_Task23" targetRef="W14_Task24" />
      <bpmn:sequenceFlow id="W14_Flow58" sourceRef="W14_Task24" targetRef="W14_Task25" />
      <bpmn:sequenceFlow id="W14_Flow59" sourceRef="W14_Task25" targetRef="W14_Task26" />
      <bpmn:sequenceFlow id="W14_Flow60" sourceRef="W14_Task26" targetRef="W14_Task27" />
      <bpmn:sequenceFlow id="W14_Flow61" sourceRef="W14_Task27" targetRef="W14_Task28" />
      <bpmn:sequenceFlow id="W14_Flow62" sourceRef="W14_Task28" targetRef="W14_Task29" />
      <bpmn:sequenceFlow id="W14_Flow63" sourceRef="W14_Task29" targetRef="W14_Task30" />
      <bpmn:sequenceFlow id="W14_Flow64" sourceRef="W14_Task30" targetRef="W14_Task31" />
      <bpmn:sequenceFlow id="W14_Flow65" sourceRef="W14_Task31" targetRef="W14_Task32" />
      <bpmn:sequenceFlow id="W14_Flow66" sourceRef="W14_Task32" targetRef="W14_Task33" />
      <bpmn:sequenceFlow id="W14_Flow67" sourceRef="W14_Task33" targetRef="W14_Task34" />
      <bpmn:sequenceFlow id="W14_Flow68" sourceRef="W14_Task34" targetRef="W14_Task35" />
      <bpmn:sequenceFlow id="W14_Flow69" sourceRef="W14_Task35" targetRef="W14_Task36" />
      <bpmn:sequenceFlow id="W14_Flow70" sourceRef="W14_Task36" targetRef="W14_Task37" />
      <bpmn:sequenceFlow id="W14_Flow71" sourceRef="W14_Task37" targetRef="W14_Task38" />
      <bpmn:sequenceFlow id="W14_Flow72" sourceRef="W14_Task38" targetRef="W14_Task39" />
      <bpmn:sequenceFlow id="W14_Flow73" sourceRef="W14_Task39" targetRef="W14_Task40" />
      <bpmn:sequenceFlow id="W14_Flow74" sourceRef="W14_Task40" targetRef="W14_Task41" />
      <bpmn:sequenceFlow id="W14_Flow75" sourceRef="W14_Task41" targetRef="W14_End42" />
    </bpmn:process>
