    <bpmn:process id="W_W217" name="W217. Senior Citizen &amp; PWD VAT-Exemption Audit &amp; Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly and Quarterly tax filing deadlines (BIR Form 2550M/Q)
Frequency: Monthly review; Quarterly reporting
Volume: ~2–5% of total retail transactions
Owner: Tax Manager
Participants: Store Managers (data source), AR Clerk, Controller, BIR
Source: workflow W217 — Senior Citizen &amp; PWD VAT-Exemption Audit &amp; Reporting</bpmn:documentation>
      <bpmn:laneSet id="W217_LaneSet5">
        <bpmn:lane id="W217_Lane1" name="AR Clerk">
        <bpmn:flowNodeRef>W217_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W217_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W217_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W217_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W217_Lane2" name="Tax Manager">
        <bpmn:flowNodeRef>W217_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W217_Lane3" name="Controller">
        <bpmn:flowNodeRef>W217_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W217_Lane4" name="Store Manager">
        <bpmn:flowNodeRef>W217_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W217_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W217_Start6" name="Monthly and Quarterly tax filing deadlines (BIR Form 2550M/Q)">
        <bpmn:outgoing>W217_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W217_Task7" name="Data Consolidation">
        <bpmn:documentation>Step 1: Data Consolidation: System pulls all POS transactions flagged as &quot;SC/PWD Discount&quot; across 200 stores
Responsible (R): AR Clerk
Accountable (A): Tax Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W217_Flow16</bpmn:incoming>
        <bpmn:outgoing>W217_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W217_Task8" name="ID Verification Audit">
        <bpmn:documentation>Step 2: ID Verification Audit: Sample review of captured ID numbers (OSCA/PWD ID) and customer signatures in the system to ensure compliance
Responsible (R): AR Clerk
Accountable (A): Tax Manager
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W217_Flow17</bpmn:incoming>
        <bpmn:outgoing>W217_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W217_Task9" name="VAT-Exemption Reconciliation">
        <bpmn:documentation>Step 3: VAT-Exemption Reconciliation: Reconcile the &quot;VAT-Exempt&quot; sales column in the Sales Journal against actual discounts given
Responsible (R): AR Clerk
Accountable (A): Controller
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W217_Flow18</bpmn:incoming>
        <bpmn:outgoing>W217_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W217_Task10" name="Report Generation">
        <bpmn:documentation>Step 4: Report Generation: Generate &quot;Summary List of Sales&quot; (SLS) and specific SC/PWD discount reports required for BIR filing
Responsible (R): Tax Manager
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W217_Flow19</bpmn:incoming>
        <bpmn:outgoing>W217_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W217_Task11" name="Accounting Entry">
        <bpmn:documentation>Step 5: Accounting Entry: Verify correct posting to &quot;Discounts - SC/PWD&quot; (Operating Expense) and &quot;VAT-Exempt Sales&quot; (Revenue)
Responsible (R): Controller
Accountable (A): CFO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W217_Flow20</bpmn:incoming>
        <bpmn:outgoing>W217_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W217_Task12" name="Document Archival">
        <bpmn:documentation>Step 6: Document Archival: Ensure digital/physical copies of SC/PWD booklets and transaction logs are archived for 10 years
Responsible (R): Store Manager
Accountable (A): Tax Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W217_Flow21</bpmn:incoming>
        <bpmn:outgoing>W217_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W217_End13" name="Complete">
        <bpmn:incoming>W217_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W217_Annotation14">
        <bpmn:text>Controls: - CTL-291 (ensure controlled execution — Tax &amp; Statutory (PA-17.3).) | - operational: Tax Manager review and approval gate; operational: periodic reconciliation against source documents
Owner: Tax Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W217_Assoc15" sourceRef="W217_Annotation14" targetRef="W217_Start6" associationDirection="None" />
