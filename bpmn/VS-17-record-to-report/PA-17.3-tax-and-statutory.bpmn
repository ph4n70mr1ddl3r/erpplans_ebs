    <bpmn:process id="W_W407" name="W407. Corporate Income Tax — Computation &amp; Deferred Tax (PAS 12)" isExecutable="false">
      <bpmn:documentation>Trigger: Quarter-end close (interim) or Year-end close (annual) (W9)
Frequency: Quarterly (interim provision); Annual (final return &amp; deferred tax measurement)
Volume: 5 legal entities; annual tax filings (1702RT); quarterly tax filings (1702Q)
Owner: Tax Manager
Participants: CFO, Controller, Tax Manager, Tax Accountant, External Audit Team (annual)
Source: workflow W407 — Corporate Income Tax — Computation &amp; Deferred Tax (PAS 12)</bpmn:documentation>
      <bpmn:laneSet id="W407_LaneSet3">
        <bpmn:lane id="W407_Lane1" name="Tax Accountant">
        <bpmn:flowNodeRef>W407_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W407_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W407_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W407_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W407_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W407_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W407_Lane2" name="Tax Manager">
        <bpmn:flowNodeRef>W407_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W407_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W407_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W407_Start4" name="Quarter-end close (interim) or Year-end close (annual) (W9)">
        <bpmn:outgoing>W407_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W407_Task5" name="Tax Provisioning">
        <bpmn:documentation>Step 1: Tax Provisioning: Tax Accountant computes current income tax liability based on quarterly pre-tax income per entity, adjusting for non-deductible expenses and tax-exempt income
Responsible (R): Tax Accountant
Accountable (A): Tax Manager
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W407_Flow15</bpmn:incoming>
        <bpmn:outgoing>W407_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W407_Task6" name="Temporary Differences Identification">
        <bpmn:documentation>Step 2: Temporary Differences Identification: Tax Accountant identifies temporary differences between accounting (PFRS) and tax carrying values (e.g., depreciation rates, SLOB provisions, bad debt provisions, accrued retirement benefits)
Responsible (R): Tax Accountant
Accountable (A): Tax Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W407_Flow16</bpmn:incoming>
        <bpmn:outgoing>W407_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W407_Task7" name="Deferred Tax Calculation">
        <bpmn:documentation>Step 3: Deferred Tax Calculation: Tax Manager calculates Deferred Tax Assets (DTA) and Deferred Tax Liabilities (DTL) using the enacted tax rate (e.g., 25% under CREATE Law)
Responsible (R): Tax Manager
Accountable (A): Controller
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W407_Flow17</bpmn:incoming>
        <bpmn:outgoing>W407_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W407_Task8" name="PFRS 16 Lease Adjustments">
        <bpmn:documentation>Step 4: PFRS 16 Lease Adjustments: Compute current and deferred tax adjustments arising from PFRS 16 lease assets (ROU) and liabilities
Responsible (R): Tax Accountant
Accountable (A): Tax Manager
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W407_Flow18</bpmn:incoming>
        <bpmn:outgoing>W407_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W407_Task9" name="Accrual Posting">
        <bpmn:documentation>Step 5: Accrual Posting: Post quarterly tax provision and deferred tax journal entries: Dr. Income Tax Expense (Current/Deferred) / Cr. Income Tax Payable / Cr. Net DTL
Responsible (R): Tax Accountant
Accountable (A): Controller
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W407_Flow19</bpmn:incoming>
        <bpmn:outgoing>W407_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W407_Task10" name="Annual Return Reconciliation">
        <bpmn:documentation>Step 6: Annual Return Reconciliation: During year-end (W9B), Tax Manager prepares comprehensive tax reconciliation (PFRS Net Income to Taxable Income); coordinates with external auditors for verification (W95)
Responsible (R): Tax Manager
Accountable (A): CFO
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W407_Flow20</bpmn:incoming>
        <bpmn:outgoing>W407_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W407_Task11" name="Filing &amp; Payment">
        <bpmn:documentation>Step 7: Filing &amp; Payment: Tax Accountant uploads the final return via eFPS (W260) and coordinates payment of the balance due
Responsible (R): Tax Accountant
Accountable (A): Tax Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W407_Flow21</bpmn:incoming>
        <bpmn:outgoing>W407_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W407_End12" name="Complete">
        <bpmn:incoming>W407_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W407_Annotation13">
        <bpmn:text>Controls: - CTL-291 (ensure controlled execution — Tax &amp; Statutory (PA-17.3).) | - operational: periodic reconciliation against source documents | ---
Owner: Tax Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W407_Assoc14" sourceRef="W407_Annotation13" targetRef="W407_Start4" associationDirection="None" />
