        <bpmndi:BPMNShape id="W876_Task10_di" bpmnElement="W876_Task10"><dc:Bounds x="1450" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W876_Start4_di" bpmnElement="W876_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W876_End11_di" bpmnElement="W876_End11"><dc:Bounds x="1680" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W876_Annotation12_di" bpmnElement="W876_Annotation12"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W876_Flow14_di" bpmnElement="W876_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W876_Flow15_di" bpmnElement="W876_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W876_Flow16_di" bpmnElement="W876_Flow16"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W876_Flow17_di" bpmnElement="W876_Flow17"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W876_Flow18_di" bpmnElement="W876_Flow18"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W876_Flow19_di" bpmnElement="W876_Flow19"><di:waypoint x="1420" y="165" /><di:waypoint x="1450" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W876_Flow20_di" bpmnElement="W876_Flow20"><di:waypoint x="1630" y="335" /><di:waypoint x="1680" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W876_Assoc13_di" bpmnElement="W876_Assoc13"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1181" name="W1181. BIR Point-of-Sale (POS) System Registration &amp; CAS Compliance Maintenance" isExecutable="false">
      <bpmn:documentation>Trigger: New store opening; POS system software update; BIR regulation change; annual CAS permit renewal
Frequency: Store openings: ~10–15/year; software updates: 2–4/year; regulation changes: ad-hoc; CAS renewal: annual
Volume: 600 POS terminals across 200 stores (3 per store); each requires BIR registration
Owner: Tax Accountant / IT Systems Administrator
Participants: Tax Accountant, IT Systems Administrator, BIR Revenue District Office (RDO), SSP (Store Systems &amp; POS — the in-house POS platform), Store Manager, Finance Controller
Source: workflow W1181 — BIR Point-of-Sale (POS) System Registration &amp; CAS Compliance Maintenance</bpmn:documentation>
      <bpmn:laneSet id="W1181_LaneSet3">
        <bpmn:lane id="W1181_Lane1" name="Tax Accountant">
        <bpmn:flowNodeRef>W1181_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1181_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1181_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1181_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1181_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1181_Lane2" name="IT Systems Admin">
        <bpmn:flowNodeRef>W1181_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1181_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1181_Start4" name="New store opening; POS system software update; BIR regulation change; annual CAS permit…">
        <bpmn:outgoing>W1181_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1181_Task5" name="Initial POS registration for new store">
        <bpmn:documentation>Step 1: Initial POS registration for new store: (a) before new store opening per W623: Tax Accountant prepares BIR registration documents for each POS terminal: Certificate of Registration (COR), BIR Form 1907 (Application for Permit to Use CAS/POS), system description and specification, sample receipts; (b) submit to BIR RDO with jurisdiction over store location; (c) BIR issues Permit to Use POS — valid until revoked; (d) register each terminal&#x27;s serial number; (e) program BIR-required fields into POS terminal configuration: TIN, business name, address, permit number; (f) test receipt printing to verify BIR compliance; (g) store cannot open for sales until all 3 POS terminals are BIR-registered
Responsible (R): Tax Accountant / IT Systems Admin
Accountable (A): Finance Controller
Duration: 2–4 weeks/store</bpmn:documentation>
        <bpmn:incoming>W1181_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1181_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1181_Task6" name="POS software update compliance">
        <bpmn:documentation>Step 2: POS software update compliance: When POS software is updated per IT change management: (a) IT Systems Administrator assesses if update changes receipt format, tax calculation logic, or transaction recording — if yes, BIR notification required; (b) for material changes: file BIR Form 1907 amendment with updated system description and sample receipts; (c) for minor changes (UI only, no receipt/tax impact): document in BIR compliance log; (d) after update: test all 600 terminals (or sample per BIR-approved testing protocol) to verify receipt compliance; (e) retain all update documentation for BIR audit
Responsible (R): IT Systems Admin / Tax Accountant
Accountable (A): Finance Controller
Duration: 1–2 weeks/update</bpmn:documentation>
        <bpmn:incoming>W1181_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1181_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1181_Task7" name="BIR regulation change response">
        <bpmn:documentation>Step 3: BIR regulation change response: When BIR issues new revenue regulations affecting POS/CAS: (a) Tax Accountant analyzes regulation impact on current POS configuration; (b) route required software changes to the in-house POS platform team (SSP — Store Systems &amp; POS) under IT change management; (c) test changes; (d) file BIR notification or re-registration; (e) deploy changes to all 600 terminals within BIR-mandated compliance timeline; (f) example: if BIR requires e-invoicing integration per RR 8-2020 (electronic receipts/invoices under NIRC §237 as amended by TRAIN), plan and execute system-wide implementation
Responsible (R): Tax Accountant / IT Systems Admin
Accountable (A): Finance Controller
Duration: Per regulation</bpmn:documentation>
        <bpmn:incoming>W1181_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1181_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1181_Task8" name="Ongoing compliance monitoring">
        <bpmn:documentation>Step 4: Ongoing compliance monitoring: (a) quarterly: Tax Accountant spot-checks receipts from randomly selected stores (5 stores/quarter) for BIR compliance — all required fields present, VAT correctly computed and stated, serial numbers match BIR registration; (b) IT monitors POS terminal uptime and generates transaction logs per BIR retention requirements (10 years); (c) immediately replace or repair any POS terminal that generates non-compliant receipts; (d) maintain master register of all 600 POS terminals: serial number, BIR permit number, RDO, store location, software version, registration date
Responsible (R): Tax Accountant / IT Systems Admin
Accountable (A): Finance Controller
Duration: 4 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1181_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1181_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1181_Task9" name="BIR audit preparation">
        <bpmn:documentation>Step 5: BIR audit preparation: When BIR conducts tax audit per W90: (a) provide POS registration documents for all terminals; (b) provide transaction logs and Z-readings (daily sales summaries) for audit period; (c) demonstrate POS compliance with CAS permit conditions; (d) Tax Accountant coordinates with BIR auditor for any POS-related queries; (e) resolve any compliance findings immediately
Responsible (R): Tax Accountant
Accountable (A): Finance Controller
Duration: Per audit</bpmn:documentation>
        <bpmn:incoming>W1181_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1181_Flow18</bpmn:outgoing>
      </bpmn:userTask>
