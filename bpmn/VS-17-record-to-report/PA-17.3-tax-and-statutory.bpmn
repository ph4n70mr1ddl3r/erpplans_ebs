      <bpmndi:BPMNPlane id="W260_plane" bpmnElement="W_W260">
        <bpmndi:BPMNShape id="W260_Lane1_di" bpmnElement="W260_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2000" height="170" /></bpmndi:BPMNShape>
