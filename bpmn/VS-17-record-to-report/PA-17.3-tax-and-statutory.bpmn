    <bpmn:process id="W_W876" name="W876. Product Recall Regulatory Reporting &amp; DTI/BIR/FDA Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: Recall decision approved (W873); mandatory reporting requirements triggered
Frequency: 3–5 regulatory reporting events per year
Volume: Each event requires submissions to 1–3 regulatory bodies
Owner: Quality Manager / Compliance Officer
Participants: Legal Counsel, Procurement Manager, Corporate Communications, External Regulatory Consultant
Source: workflow W876 — Product Recall Regulatory Reporting &amp; DTI/BIR/FDA Compliance</bpmn:documentation>
      <bpmn:laneSet id="W876_LaneSet3">
        <bpmn:lane id="W876_Lane1" name="Compliance Officer">
        <bpmn:flowNodeRef>W876_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W876_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W876_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W876_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W876_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W876_Lane2" name="Quality Manager">
        <bpmn:flowNodeRef>W876_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W876_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W876_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W876_Start4" name="Recall decision approved (W873); mandatory reporting requirements triggered">
        <bpmn:outgoing>W876_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W876_Task5" name="Identify regulatory reporting requirements — determine which agencies require…">
        <bpmn:documentation>Step 1: Identify regulatory reporting requirements — determine which agencies require notification: (a) DTI — Consumer Act (RA 7394) mandatory recall reporting for consumer products, (b) FDA — for regulated products (paints, chemicals, electrical), (c) DENR — for hazardous materials, (d) BIR — for inventory write-off documentation, (e) DOH — if public health risk; note reporting deadlines (DTI: within 48 hours of recall decision, per the W1618 convention)
Responsible (R): Compliance Officer
Accountable (A): Legal Counsel
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W876_Flow14</bpmn:incoming>
        <bpmn:outgoing>W876_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W876_Task6" name="Prepare regulatory submission — compile: (a) product identification and…">
        <bpmn:documentation>Step 2: Prepare regulatory submission — compile: (a) product identification and batch/lot details, (b) defect description and risk assessment, (c) number of affected units in market, (d) recall scope and remedy, (e) customer notification plan, (f) timeline of events, (g) corrective action plan; format per agency requirements
Responsible (R): Quality Manager
Accountable (A): Compliance Officer
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W876_Flow15</bpmn:incoming>
        <bpmn:outgoing>W876_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W876_Task7" name="Submit regulatory notification — file reports with required agencies within…">
        <bpmn:documentation>Step 3: Submit regulatory notification — file reports with required agencies within mandated timeframes; DTI typically requires formal letter + supporting documents; FDA may require online portal submission; obtain acknowledgment receipts
Responsible (R): Compliance Officer
Accountable (A): Legal Counsel
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W876_Flow16</bpmn:incoming>
        <bpmn:outgoing>W876_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W876_Task8" name="Respond to regulatory queries — agencies may request additional information…">
        <bpmn:documentation>Step 4: Respond to regulatory queries — agencies may request additional information, on-site inspection, or product sample submission; coordinate with Quality Manager and Legal for responses
Responsible (R): Compliance Officer
Accountable (A): Quality Manager
Duration: Variable</bpmn:documentation>
        <bpmn:incoming>W876_Flow17</bpmn:incoming>
        <bpmn:outgoing>W876_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W876_Task9" name="Submit progress reports — for ongoing recalls: file weekly/monthly progress…">
        <bpmn:documentation>Step 5: Submit progress reports — for ongoing recalls: file weekly/monthly progress reports to agencies showing: units recovered, customer notification reach, remaining inventory, and estimated completion date
Responsible (R): Compliance Officer
Accountable (A): Quality Manager
Duration: 2 hours per report</bpmn:documentation>
        <bpmn:incoming>W876_Flow18</bpmn:incoming>
        <bpmn:outgoing>W876_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W876_Task10" name="File final recall report — upon recall completion: submit comprehensive…">
        <bpmn:documentation>Step 6: File final recall report — upon recall completion: submit comprehensive close-out report with total units recovered, disposition method, effectiveness assessment, and corrective actions implemented; obtain agency clearance
Responsible (R): Quality Manager
Accountable (A): Compliance Officer
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W876_Flow19</bpmn:incoming>
        <bpmn:outgoing>W876_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W876_End11" name="Complete">
        <bpmn:incoming>W876_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W876_Annotation12">
        <bpmn:text>Controls: - CTL-291 (ensure controlled execution — Tax &amp; Statutory (PA-17.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Quality Manager / Compliance Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W876_Assoc13" sourceRef="W876_Annotation12" targetRef="W876_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W876_Flow14" sourceRef="W876_Start4" targetRef="W876_Task5" />
      <bpmn:sequenceFlow id="W876_Flow15" sourceRef="W876_Task5" targetRef="W876_Task6" />
      <bpmn:sequenceFlow id="W876_Flow16" sourceRef="W876_Task6" targetRef="W876_Task7" />
      <bpmn:sequenceFlow id="W876_Flow17" sourceRef="W876_Task7" targetRef="W876_Task8" />
      <bpmn:sequenceFlow id="W876_Flow18" sourceRef="W876_Task8" targetRef="W876_Task9" />
      <bpmn:sequenceFlow id="W876_Flow19" sourceRef="W876_Task9" targetRef="W876_Task10" />
      <bpmn:sequenceFlow id="W876_Flow20" sourceRef="W876_Task10" targetRef="W876_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W876_diag">
      <bpmndi:BPMNPlane id="W876_plane" bpmnElement="W_W876">
        <bpmndi:BPMNShape id="W876_Lane1_di" bpmnElement="W876_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
