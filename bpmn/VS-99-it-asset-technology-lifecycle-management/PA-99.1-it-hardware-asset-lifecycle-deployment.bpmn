    <bpmn:process id="W_W3240" name="W3240. Lost / Stolen Asset Recovery &amp; Loss Investigation" isExecutable="false">
      <bpmn:documentation>Trigger: Loss report; inventory discrepancy (W3233); theft/anomaly
Frequency: Event-driven
Volume: ~50–200 loss events/year
Owner: IT Asset Manager
Participants: IT Asset Mgr, Loss Prevention (links to VS-23), Security (links to VS-27.3), Legal, Insurance (links to VS-26)
Source: workflow W3240 — Lost / Stolen Asset Recovery &amp; Loss Investigation</bpmn:documentation>
      <bpmn:laneSet id="W3240_LaneSet4">
        <bpmn:lane id="W3240_Lane1" name="IT Ops">
        <bpmn:flowNodeRef>W3240_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3240_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3240_Lane2" name="Loss Prevention">
        <bpmn:flowNodeRef>W3240_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3240_Lane3" name="IT Asset Mgr">
        <bpmn:flowNodeRef>W3240_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3240_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3240_Start5" name="Loss report; inventory discrepancy (W3233); theft/anomaly">
        <bpmn:outgoing>W3240_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3240_Task6" name="On loss/theft: immediate containment — remote-wipe/lock via MDM (W3236)…">
        <bpmn:documentation>Step 1: On loss/theft: immediate containment — remote-wipe/lock via MDM (W3236), deactivate credentials and access (links to VS-27.3), report to local police (for theft) and Loss Prevention (links to VS-23); preserve evidence (last-known-location, access logs, CCTV)
Responsible (R): IT Ops / Loss Prevention / Security
Accountable (A): IT Asset Manager
Duration: Per event (immediate)</bpmn:documentation>
        <bpmn:incoming>W3240_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3240_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3240_Task7" name="Investigate: Loss Prevention (links to VS-23.1) determines cause/theft/fraud…">
        <bpmn:documentation>Step 2: Investigate: Loss Prevention (links to VS-23.1) determines cause/theft/fraud, interviews, reviews CCTV and access data; for high-value or data-bearing devices, assess data-breach risk (links to VS-91) and notify NPC if personal data compromised within 72 hours
Responsible (R): Loss Prevention / Security / Legal
Accountable (A): IT Asset Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3240_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3240_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3240_Task8" name="Recover/resolve: recover device where possible, file insurance claim (links to…">
        <bpmn:documentation>Step 3: Recover/resolve: recover device where possible, file insurance claim (links to VS-26.3) for unrecovered/insured assets, derecognize from CMDB/fixed assets (links to VS-35.3), replace (W3234/W3237); tighten controls (accountability, tracking, physical security per VS-23.2); capture lessons to risk register (links to VS-21.2)
Responsible (R): IT Asset Mgr / Loss Prevention / Finance
Accountable (A): IT Asset Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3240_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3240_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3240_End9" name="Complete">
        <bpmn:incoming>W3240_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3240_Annotation10">
        <bpmn:text>Controls: - CTL-143 (ensure IT asset &amp; license entitlement integrity.) | - operational: encryption, remote-wipe, and breach playbook; operational: accountability and analytics (W3251)
Owner: IT Asset Manager</bpmn:text>
      </bpmn:textAnnotation>
