      <bpmn:startEvent id="W3237_Start4" name="Incident (links to VS-27.1); warranty/RMA; preventive maintenance">
        <bpmn:outgoing>W3237_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3237_Task5" name="Service Desk (links to VS-27.1) triage break/fix: diagnose (remote first)…">
        <bpmn:documentation>Step 1: Service Desk (links to VS-27.1) triage break/fix: diagnose (remote first), attempt repair, escalate to Field IT or vendor where needed; for store/DC critical devices (POS, RF), prioritize and swap from spare pool to restore service rapidly
Responsible (R): Service Desk / Field IT
Accountable (A): IT Ops Manager
Duration: Per ticket</bpmn:documentation>
        <bpmn:incoming>W3237_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3237_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3237_Task6" name="Manage vendor warranty/RMA: log warranty status per asset (W3233), initiate RMA…">
        <bpmn:documentation>Step 2: Manage vendor warranty/RMA: log warranty status per asset (W3233), initiate RMA for covered failures, track turnaround, manage out-of-warranty repair/replacement decisions (repair vs replace); manage extended-warranty contracts
Responsible (R): IT Asset Mgr / Vendor
Accountable (A): IT Asset Manager
Duration: Per ticket</bpmn:documentation>
        <bpmn:incoming>W3237_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3237_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3237_Task7" name="Operate spare pool: maintain regional spare-stock levels (POS, RF, laptops) for…">
        <bpmn:documentation>Step 3: Operate spare pool: maintain regional spare-stock levels (POS, RF, laptops) for rapid swap, replenish per min/max, cycle spares to prevent obsolescence, reconcile spares inventory; analytics on failure rates (W3251) feed refresh (W3238) and catalog (W3234)
Responsible (R): IT Asset Mgr / Field IT
Accountable (A): IT Asset Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W3237_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3237_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3237_End8" name="Complete">
        <bpmn:incoming>W3237_Flow14</bpmn:incoming>
      </bpmn:endEvent>
