<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-99.1-it-hardware-asset-lifecycle-deployment" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3233" name="W3233. IT Asset Discovery, Inventory &amp; CMDB Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: Continuous discovery; periodic reconciliation; audit
Frequency: Continuous + quarterly reconciliation
Volume: ~2,500+ endpoints + 600 POS + network/storage/peripherals
Owner: IT Asset Manager
Participants: IT Asset Mgr, IT Ops (links to VS-27), Field IT, Finance (links to VS-35), Security (links to VS-27.3)
Source: workflow W3233 — IT Asset Discovery, Inventory &amp; CMDB Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W3233_LaneSet2">
        <bpmn:lane id="W3233_Lane1" name="IT Asset Mgr">
        <bpmn:flowNodeRef>W3233_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3233_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3233_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3233_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3233_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3233_Start3" name="Continuous discovery; periodic reconciliation; audit">
        <bpmn:outgoing>W3233_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3233_Task4" name="IT Asset Mgr/IT Ops (links to VS-27.2) maintain discovery tools (agent-based…">
        <bpmn:documentation>Step 1: IT Asset Mgr/IT Ops (links to VS-27.2) maintain discovery tools (agent-based and network scan) that automatically detect hardware/software on the network; capture device identity (hostname, serial, MAC), specs, location, user, status; load into CMDB as the single source of truth
Responsible (R): IT Asset Mgr / IT Ops
Accountable (A): IT Asset Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3233_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3233_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3233_Task5" name="Reconcile CMDB to procurement (links to VS-34), fixed-asset register (links to…">
        <bpmn:documentation>Step 2: Reconcile CMDB to procurement (links to VS-34), fixed-asset register (links to VS-35), and finance; identify discrepancies (ghost assets on books but missing, shadow/rogue devices on network but unbought/unknown); investigate and correct
Responsible (R): IT Asset Mgr / Finance
Accountable (A): IT Asset Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3233_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3233_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3233_Task6" name="Audit physical existence at sample locations (stores/DCs/HQ) vs CMDB (links to…">
        <bpmn:documentation>Step 3: Audit physical existence at sample locations (stores/DCs/HQ) vs CMDB (links to VS-35.3 physical verification methodology); address rogue/unmanaged devices (quarantine per VS-27.3); report CMDB accuracy KPI to IT governance
Responsible (R): IT Asset Mgr / Internal Audit (links to VS-21) / Field IT
Accountable (A): IT Asset Manager
Duration: Annual + spot</bpmn:documentation>
        <bpmn:incoming>W3233_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3233_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3233_End7" name="Complete">
        <bpmn:incoming>W3233_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3233_Annotation8">
        <bpmn:text>Controls: - CTL-526 (ensure controlled execution — IT Hardware Asset Lifecycle &amp; Deployment (PA-99.1).); CTL-143 (ensure IT asset &amp; license entitlement integrity — cross-reference.) | - operational: network discovery and quarantine; operational: CMDB–fixed-asset reconciliation
Owner: IT Asset Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3233_Assoc9" sourceRef="W3233_Annotation8" targetRef="W3233_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3233_Flow10" sourceRef="W3233_Start3" targetRef="W3233_Task4" />
      <bpmn:sequenceFlow id="W3233_Flow11" sourceRef="W3233_Task4" targetRef="W3233_Task5" />
      <bpmn:sequenceFlow id="W3233_Flow12" sourceRef="W3233_Task5" targetRef="W3233_Task6" />
      <bpmn:sequenceFlow id="W3233_Flow13" sourceRef="W3233_Task6" targetRef="W3233_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3233_diag">
      <bpmndi:BPMNPlane id="W3233_plane" bpmnElement="W_W3233">
        <bpmndi:BPMNShape id="W3233_Lane1_di" bpmnElement="W3233_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3233_Task4_di" bpmnElement="W3233_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3233_Task5_di" bpmnElement="W3233_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3233_Task6_di" bpmnElement="W3233_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3233_Start3_di" bpmnElement="W3233_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3233_End7_di" bpmnElement="W3233_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3233_Annotation8_di" bpmnElement="W3233_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3233_Flow10_di" bpmnElement="W3233_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3233_Flow11_di" bpmnElement="W3233_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3233_Flow12_di" bpmnElement="W3233_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3233_Flow13_di" bpmnElement="W3233_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3233_Assoc9_di" bpmnElement="W3233_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3234" name="W3234. Hardware Procurement, Standardization &amp; Catalog Management" isExecutable="false">
      <bpmn:documentation>Trigger: New-store opening (links to VS-37); refresh (W3238); ad-hoc demand
Frequency: Continuous + project-based
Volume: ~600 POS + ~2,500 endpoints + peripherals; ~10–15 new stores/year
Owner: IT Asset Manager
Participants: IT Asset Mgr, Procurement (links to VS-34), IT Ops (links to VS-27), Finance, Vendor
Source: workflow W3234 — Hardware Procurement, Standardization &amp; Catalog Management</bpmn:documentation>
      <bpmn:laneSet id="W3234_LaneSet3">
        <bpmn:lane id="W3234_Lane1" name="IT Asset Mgr">
        <bpmn:flowNodeRef>W3234_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3234_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3234_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3234_Lane2" name="Procurement">
        <bpmn:flowNodeRef>W3234_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3234_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3234_Start4" name="New-store opening (links to VS-37); refresh (W3238); ad-hoc demand">
        <bpmn:outgoing>W3234_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3234_Task5" name="IT Asset Mgr/IT Ops maintain the standard hardware catalog: approved…">
        <bpmn:documentation>Step 1: IT Asset Mgr/IT Ops maintain the standard hardware catalog: approved makes/models per device class (POS terminal, scanner, mobile, laptop, network, server, printer), standard configurations, lifecycle/roadmap, total-cost-of- ownership basis; standardization reduces support complexity and spare-pool breadth
Responsible (R): IT Asset Mgr / IT Ops
Accountable (A): IT Asset Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W3234_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3234_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3234_Task6" name="Procurement/IT (links to VS-34) source via framework agreements / preferred…">
        <bpmn:documentation>Step 2: Procurement/IT (links to VS-34) source via framework agreements / preferred vendors: negotiate price, warranty, lead time, RMA process, trade-in; consolidate demand for new-store openings (VS-37) and refresh waves (W3238); enforce catalog compliance (reject non-standard buys)
Responsible (R): Procurement / IT Asset Mgr
Accountable (A): IT Asset Manager
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W3234_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3234_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3234_Task7" name="Receive, asset-tag, and register: receive per the PO (three-way match for…">
        <bpmn:documentation>Step 3: Receive, asset-tag, and register: receive per the PO (three-way match for capitalizable lines); capitalizable purchases flow through the mass additions queue for Fixed Asset review before posting to the register (links to VS-35 W1690); assign unique asset tag/serial, record in CMDB (W3233) and fixed-asset master (links to VS-35), capture warranty and PO reference; assign the custodian of record into the Assigned-To field — a named individual for IT equipment per VS-35 custody policy; the tag-scan confirmation doubles as that custodian&#x27;s custody acceptance, so no device goes productive untagged or unowned; stage for provisioning (W3235)
Responsible (R): IT Asset Mgr / Receiving
Accountable (A): IT Asset Manager
Duration: Per delivery</bpmn:documentation>
        <bpmn:incoming>W3234_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3234_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3234_End8" name="Complete">
        <bpmn:incoming>W3234_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3234_Annotation9">
        <bpmn:text>Controls: - CTL-526 (ensure controlled execution — IT Hardware Asset Lifecycle &amp; Deployment (PA-99.1).) | - operational: catalog enforcement and approval gates; operational: framework agreements and safety stock
Owner: IT Asset Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3234_Assoc10" sourceRef="W3234_Annotation9" targetRef="W3234_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3234_Flow11" sourceRef="W3234_Start4" targetRef="W3234_Task5" />
      <bpmn:sequenceFlow id="W3234_Flow12" sourceRef="W3234_Task5" targetRef="W3234_Task6" />
      <bpmn:sequenceFlow id="W3234_Flow13" sourceRef="W3234_Task6" targetRef="W3234_Task7" />
      <bpmn:sequenceFlow id="W3234_Flow14" sourceRef="W3234_Task7" targetRef="W3234_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3234_diag">
      <bpmndi:BPMNPlane id="W3234_plane" bpmnElement="W_W3234">
        <bpmndi:BPMNShape id="W3234_Lane1_di" bpmnElement="W3234_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3234_Lane2_di" bpmnElement="W3234_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3234_Task5_di" bpmnElement="W3234_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3234_Task6_di" bpmnElement="W3234_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3234_Task7_di" bpmnElement="W3234_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3234_Start4_di" bpmnElement="W3234_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3234_End8_di" bpmnElement="W3234_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3234_Annotation9_di" bpmnElement="W3234_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3234_Flow11_di" bpmnElement="W3234_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3234_Flow12_di" bpmnElement="W3234_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3234_Flow13_di" bpmnElement="W3234_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3234_Flow14_di" bpmnElement="W3234_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3234_Assoc10_di" bpmnElement="W3234_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3235" name="W3235. Device Provisioning, Imaging &amp; Deployment" isExecutable="false">
      <bpmn:documentation>Trigger: New device (W3234); new store (VS-37); refresh (W3238)
Frequency: Project + ad-hoc
Volume: ~600 POS + ~2,500 endpoints deployed; ~10–15 new stores/year
Owner: IT Operations Manager
Participants: IT Ops Mgr (links to VS-27), Field IT, Store Ops (links to VS-07), IT Asset Mgr
Source: workflow W3235 — Device Provisioning, Imaging &amp; Deployment</bpmn:documentation>
      <bpmn:laneSet id="W3235_LaneSet3">
        <bpmn:lane id="W3235_Lane1" name="IT Ops">
        <bpmn:flowNodeRef>W3235_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3235_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3235_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3235_Lane2" name="Field IT">
        <bpmn:flowNodeRef>W3235_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3235_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3235_Start4" name="New device (W3234); new store (VS-37); refresh (W3238)">
        <bpmn:outgoing>W3235_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3235_Task5" name="IT Ops provision and image devices centrally: standard OS image, security…">
        <bpmn:documentation>Step 1: IT Ops provision and image devices centrally: standard OS image, security baseline (links to VS-27.3), required applications (POS software, WMS, MDM enrollment, antivirus, monitoring agents), configuration per device role (cashier vs back-office vs DC RF); automate via imaging/zero-touch deployment
Responsible (R): IT Ops / Desktop Support
Accountable (A): IT Ops Manager
Duration: Per device</bpmn:documentation>
        <bpmn:incoming>W3235_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3235_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3235_Task6" name="Deploy to site: ship to store/DC, Field IT or store staff install and connect…">
        <bpmn:documentation>Step 2: Deploy to site: ship to store/DC, Field IT or store staff install and connect (POS, scanner, printer, network), verify connectivity to ERP (links to VS-27.2), test offline POS capability (per POS-013 ≥8 hours offline); custody transfers as a release-and-accept event — the staging custodian releases the device and the site custodian of record accepts, and the deployment confirmation updates the asset register&#x27;s Assigned-To field so custody is never blank in transit; capture deployment confirmation in CMDB
Responsible (R): Field IT / Store Ops
Accountable (A): IT Ops Manager
Duration: Per site</bpmn:documentation>
        <bpmn:incoming>W3235_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3235_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3235_Task7" name="Onboard to support: register in monitoring/MDM, assign support owner, document…">
        <bpmn:documentation>Step 3: Onboard to support: register in monitoring/MDM, assign support owner, document site configuration; for new stores, integrate with VS-37 store-opening commissioning (W227 handover); confirm user acceptance — the site custodian of record&#x27;s acceptance scan is the custody acceptance on the register (links to VS-35 W1692)
Responsible (R): IT Ops / Store Ops
Accountable (A): IT Ops Manager
Duration: Per deployment</bpmn:documentation>
        <bpmn:incoming>W3235_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3235_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3235_End8" name="Complete">
        <bpmn:incoming>W3235_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3235_Annotation9">
        <bpmn:text>Controls: - CTL-526 (ensure controlled execution — IT Hardware Asset Lifecycle &amp; Deployment (PA-99.1).) | - operational: standardized imaging and automation; operational: VS-37 site-readiness checklist
Owner: IT Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3235_Assoc10" sourceRef="W3235_Annotation9" targetRef="W3235_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3235_Flow11" sourceRef="W3235_Start4" targetRef="W3235_Task5" />
      <bpmn:sequenceFlow id="W3235_Flow12" sourceRef="W3235_Task5" targetRef="W3235_Task6" />
      <bpmn:sequenceFlow id="W3235_Flow13" sourceRef="W3235_Task6" targetRef="W3235_Task7" />
      <bpmn:sequenceFlow id="W3235_Flow14" sourceRef="W3235_Task7" targetRef="W3235_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3235_diag">
      <bpmndi:BPMNPlane id="W3235_plane" bpmnElement="W_W3235">
        <bpmndi:BPMNShape id="W3235_Lane1_di" bpmnElement="W3235_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3235_Lane2_di" bpmnElement="W3235_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3235_Task5_di" bpmnElement="W3235_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3235_Task6_di" bpmnElement="W3235_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3235_Task7_di" bpmnElement="W3235_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3235_Start4_di" bpmnElement="W3235_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3235_End8_di" bpmnElement="W3235_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3235_Annotation9_di" bpmnElement="W3235_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3235_Flow11_di" bpmnElement="W3235_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3235_Flow12_di" bpmnElement="W3235_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3235_Flow13_di" bpmnElement="W3235_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3235_Flow14_di" bpmnElement="W3235_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3235_Assoc10_di" bpmnElement="W3235_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3236" name="W3236. Mobile Device, RF Gun &amp; Peripheral Management" isExecutable="false">
      <bpmn:documentation>Trigger: Deployment; loss/damage (W3240); refresh; policy update
Frequency: Continuous + event-driven
Volume: Hundreds of RF guns (DC/stores), mobile devices (managers, field), peripherals
Owner: IT Operations Manager
Participants: IT Ops Mgr (links to VS-27), DC Ops (links to VS-04), Store Ops (links to VS-07), Field IT
Source: workflow W3236 — Mobile Device, RF Gun &amp; Peripheral Management</bpmn:documentation>
      <bpmn:laneSet id="W3236_LaneSet2">
        <bpmn:lane id="W3236_Lane1" name="IT Ops">
        <bpmn:flowNodeRef>W3236_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3236_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3236_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3236_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3236_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3236_Start3" name="Deployment; loss/damage (W3240); refresh; policy update">
        <bpmn:outgoing>W3236_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3236_Task4" name="IT Ops manage mobile/RF estate via Mobile Device Management (MDM): enroll…">
        <bpmn:documentation>Step 1: IT Ops manage mobile/RF estate via Mobile Device Management (MDM): enroll devices, push apps/config (WMS client, task app per VS-63), enforce security (PIN, encryption, remote-wipe per VS-27.3), restrict to business use; geo-locate where enabled
Responsible (R): IT Ops / MDM Admin
Accountable (A): IT Ops Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W3236_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3236_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3236_Task5" name="Manage peripherals (scanners, printers, payment terminals per VS-80): firmware…">
        <bpmn:documentation>Step 2: Manage peripherals (scanners, printers, payment terminals per VS-80): firmware updates, consumables (receipt paper, labels), connectivity, compatibility with POS/WMS; maintain peripheral standard catalog (W3234)
Responsible (R): IT Ops / Field IT
Accountable (A): IT Ops Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W3236_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3236_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3236_Task6" name="Handle damage/loss/replacement: triage via service desk (links to VS-27.1)…">
        <bpmn:documentation>Step 3: Handle damage/loss/replacement: triage via service desk (links to VS-27.1), swap from spare pool (W3237), remote-wipe and deactivate lost devices (W3240), recover/decommission; track device failure rates by model to inform catalog (W3234)
Responsible (R): IT Ops / Service Desk
Accountable (A): IT Ops Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3236_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3236_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3236_End7" name="Complete">
        <bpmn:incoming>W3236_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3236_Annotation8">
        <bpmn:text>Controls: - CTL-526 (ensure controlled execution — IT Hardware Asset Lifecycle &amp; Deployment (PA-99.1).) | - operational: MDM remote-wipe and accountability; operational: spare pool (W3237) and rapid swap
Owner: IT Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
