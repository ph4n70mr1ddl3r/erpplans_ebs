        <bpmndi:BPMNEdge id="W3770_Assoc9_di" bpmnElement="W3770_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3771" name="W3771. Proactive Candidate Sourcing &amp; Talent Mining Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Hard-to-fill requisition; pipeline build; strategic role
Frequency: Continuous
Volume: Sourcing pipeline for priority roles
Owner: TA Sourcing / Recruiting
Participants: TA Sourcing, Recruiting (links to VS-19.1), Hiring Managers (links to VS-07/VS-19), Analytics (links to VS-28.1), Loyalty/CRM (links to VS-13), Sourcing &amp; Screening Coordinator
Source: workflow W3771 — Proactive Candidate Sourcing &amp; Talent Mining Operations</bpmn:documentation>
      <bpmn:laneSet id="W3771_LaneSet2">
        <bpmn:lane id="W3771_Lane1" name="TA Sourcing">
        <bpmn:flowNodeRef>W3771_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3771_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3771_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3771_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3771_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3771_Start3" name="Hard-to-fill requisition; pipeline build; strategic role">
        <bpmn:outgoing>W3771_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3771_Task4" name="TA Sourcing/Recruiting execute proactive sourcing for priority and hard-to-fill…">
        <bpmn:documentation>Step 1: TA Sourcing/Recruiting execute proactive sourcing for priority and hard-to-fill roles (trade-knowledgeable frontline, digital/IT, supply chain, specialized merchant/buyers): Boolean/LinkedIn-equivalent search, talent-map competitor employers, mine the talent CRM (links to W3770) and internal mobility (links to W682) first, and BuildRight&#x27;s own customer/trade-base where relevant (a loyal trade pro may be a future associate — links to VS-43)
Responsible (R): TA Sourcing / Recruiting
Accountable (A): TA Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3771_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3771_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3771_Task5" name="TA Sourcing engage sourced candidates: personalized outreach reflecting EVP…">
        <bpmn:documentation>Step 2: TA Sourcing engage sourced candidates: personalized outreach reflecting EVP (links to W3761), qualification against the role profile, and routing into the candidate journey (links to W3769/W3772)
Responsible (R): TA Sourcing
Accountable (A): TA Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3771_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3771_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3771_Task6" name="TA Sourcing/Recruiting build and maintain talent maps and pipelined candidate…">
        <bpmn:documentation>Step 3: TA Sourcing/Recruiting build and maintain talent maps and pipelined candidate slates for recurring critical roles (store-manager succession links to W178, category buyers, DC supervisors) so openings are filled from a warm pipeline
Responsible (R): TA Sourcing / Recruiting
Accountable (A): TA Lead
Duration: Maintained</bpmn:documentation>
        <bpmn:incoming>W3771_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3771_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3771_End7" name="Complete">
        <bpmn:incoming>W3771_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3771_Annotation8">
        <bpmn:text>Controls: - CTL-593 (ensure controlled execution — Candidate Experience, Sourcing &amp; Selection Operations (PA-121.2).) | - operational: pipelining and talent mapping; operational: internal-first and trade-base sourcing
Owner: TA Sourcing / Recruiting</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3771_Assoc9" sourceRef="W3771_Annotation8" targetRef="W3771_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3771_Flow10" sourceRef="W3771_Start3" targetRef="W3771_Task4" />
      <bpmn:sequenceFlow id="W3771_Flow11" sourceRef="W3771_Task4" targetRef="W3771_Task5" />
      <bpmn:sequenceFlow id="W3771_Flow12" sourceRef="W3771_Task5" targetRef="W3771_Task6" />
      <bpmn:sequenceFlow id="W3771_Flow13" sourceRef="W3771_Task6" targetRef="W3771_End7" />
    </bpmn:process>
