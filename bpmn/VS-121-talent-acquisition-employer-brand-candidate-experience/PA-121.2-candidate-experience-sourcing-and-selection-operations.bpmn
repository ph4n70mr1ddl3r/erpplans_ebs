      <bpmndi:BPMNPlane id="W3771_plane" bpmnElement="W_W3771">
        <bpmndi:BPMNShape id="W3771_Lane1_di" bpmnElement="W3771_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
