        <bpmndi:BPMNShape id="W3771_Start3_di" bpmnElement="W3771_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3771_End7_di" bpmnElement="W3771_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3771_Annotation8_di" bpmnElement="W3771_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3771_Flow10_di" bpmnElement="W3771_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3771_Flow11_di" bpmnElement="W3771_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3771_Flow12_di" bpmnElement="W3771_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3771_Flow13_di" bpmnElement="W3771_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3771_Assoc9_di" bpmnElement="W3771_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3772" name="W3772. Candidate Screening, Assessment &amp; Structured Interview Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Candidate in funnel (links to W3769)
Frequency: Per candidate
Volume: ~1,200–1,600 hires/yr; several× applicant volume
Owner: Recruiting / TA Operations
Participants: Recruiting, Hiring Managers (links to VS-07/VS-19), TA Operations, Trade/Technical assessors (links to VS-09/VS-12), Compliance (links to VS-22), Data Privacy (links to VS-91), TA Coordinator
Source: workflow W3772 — Candidate Screening, Assessment &amp; Structured Interview Operations</bpmn:documentation>
      <bpmn:laneSet id="W3772_LaneSet3">
        <bpmn:lane id="W3772_Lane1" name="Recruiting">
        <bpmn:flowNodeRef>W3772_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3772_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3772_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3772_Lane2" name="Hiring Managers">
        <bpmn:flowNodeRef>W3772_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3772_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3772_Start4" name="Candidate in funnel (links to W3769)">
        <bpmn:outgoing>W3772_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3772_Task5" name="Recruiting/TA Operations run consistent screening: application review…">
        <bpmn:documentation>Step 1: Recruiting/TA Operations run consistent screening: application review, knock-out criteria, phone/video screen, work-eligibility/right-to-work and statutory checks (links to VS-22), and role-family-specific trade/skill assessment for trade-knowledgeable roles (e.g., a lumber/tile/paint/electrical practical or knowledge check, links to VS-09/VS-19.4 competency framework)
Responsible (R): Recruiting / Hiring Managers, Sourcing &amp; Screening Coordinator
Accountable (A): TA Lead
Duration: Per candidate</bpmn:documentation>
        <bpmn:incoming>W3772_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3772_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3772_Task6" name="Hiring Managers/Recruiting run structured interviews: role-family interview…">
        <bpmn:documentation>Step 2: Hiring Managers/Recruiting run structured interviews: role-family interview kits, competency/behavioral questions, scorecards, multi-interviewer panels, and trade-mastery assessment for specialist roles; minimize bias (links to W3767) and capture structured feedback in the ATS (links to VS-103.3) within feedback SLA (links to W3774)
Responsible (R): Hiring Managers / Recruiting
Accountable (A): Hiring Manager
