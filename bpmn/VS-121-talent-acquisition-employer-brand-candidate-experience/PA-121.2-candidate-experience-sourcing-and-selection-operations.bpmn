    <bpmn:process id="W_W3770" name="W3770. Candidate Relationship Management (Talent CRM) &amp; Talent Community Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Candidate/lead capture; pipeline need
Frequency: Continuous
Volume: Talent CRM (silver-medal, past-applicant, prospect)
Owner: TA Operations / TA Marketing
Participants: TA Operations, TA Marketing, Recruiting (links to VS-19.1), IT (links to VS-103.3), Data Privacy (links to VS-91), Analytics (links to VS-28.1)
Source: workflow W3770 — Candidate Relationship Management (Talent CRM) &amp; Talent Community Operations</bpmn:documentation>
      <bpmn:laneSet id="W3770_LaneSet2">
        <bpmn:lane id="W3770_Lane1" name="TA Operations">
        <bpmn:flowNodeRef>W3770_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3770_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3770_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3770_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3770_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3770_Start3" name="Candidate/lead capture; pipeline need">
        <bpmn:outgoing>W3770_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3770_Task4" name="TA Operations/IT stand up and operate the talent CRM: capture silver-medal…">
        <bpmn:documentation>Step 1: TA Operations/IT stand up and operate the talent CRM: capture silver-medal (strong-but-not-hired) candidates, past employees (alumni links to VS-19.5), event/leads (links to W3777), and prospects; segment by role/region/skill; manage consent and retention per RA 10173 (links to VS-91)
Responsible (R): TA Operations / IT
Accountable (A): TA Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3770_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3770_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3770_Task5" name="TA Operations/TA Marketing nurture the talent community: segmented nurture…">
        <bpmn:documentation>Step 2: TA Operations/TA Marketing nurture the talent community: segmented nurture campaigns (relevant openings, BuildRight content links to W3766, event invitations), re-engagement of silver-medal candidates for new/fitting roles, and warm-pipeline building ahead of store openings (links to VS-37) and seasonal hiring (links to W555)
Responsible (R): TA Operations / TA Marketing
Accountable (A): TA Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3770_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3770_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3770_Task6" name="TA Operations/Analytics measure talent-community health (size, engagement…">
        <bpmn:documentation>Step 3: TA Operations/Analytics measure talent-community health (size, engagement, conversion to applicant/hire, reactivation rate) and report contribution to funnel economics (links to W3784)
Responsible (R): TA Operations / Analytics
Accountable (A): TA Lead
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3770_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3770_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3770_End7" name="Complete">
        <bpmn:incoming>W3770_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3770_Annotation8">
        <bpmn:text>Controls: - CTL-593 (ensure controlled execution — Candidate Experience, Sourcing &amp; Selection Operations (PA-121.2).) | - operational: nurture campaigns; operational: consent capture and retention limits
Owner: TA Operations / TA Marketing</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3770_Assoc9" sourceRef="W3770_Annotation8" targetRef="W3770_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3770_Flow10" sourceRef="W3770_Start3" targetRef="W3770_Task4" />
      <bpmn:sequenceFlow id="W3770_Flow11" sourceRef="W3770_Task4" targetRef="W3770_Task5" />
      <bpmn:sequenceFlow id="W3770_Flow12" sourceRef="W3770_Task5" targetRef="W3770_Task6" />
      <bpmn:sequenceFlow id="W3770_Flow13" sourceRef="W3770_Task6" targetRef="W3770_End7" />
    </bpmn:process>
