<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-121.2-candidate-experience-sourcing-and-selection-operations" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3769" name="W3769. Candidate Journey Design &amp; Candidate Experience Standard" isExecutable="false">
      <bpmn:documentation>Trigger: EVP launch (W3761); experience audit; candidate feedback
Frequency: Annual + continuous improvement
Volume: Enterprise candidate-journey standard
Owner: TA Marketing / TA Operations
Participants: TA Operations, TA Marketing, Recruiting (links to VS-19.1), HR Shared Services (links to VS-103.1), IT (links to VS-27/VS-103.3), Store Ops (links to VS-07), Compliance (links to VS-22)
Source: workflow W3769 — Candidate Journey Design &amp; Candidate Experience Standard</bpmn:documentation>
      <bpmn:laneSet id="W3769_LaneSet2">
        <bpmn:lane id="W3769_Lane1" name="TA Operations">
        <bpmn:flowNodeRef>W3769_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3769_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3769_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3769_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3769_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3769_Start3" name="EVP launch (W3761); experience audit; candidate feedback">
        <bpmn:outgoing>W3769_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3769_Task4" name="TA Operations/TA Marketing design the end-to-end candidate journey standard…">
        <bpmn:documentation>Step 1: TA Operations/TA Marketing design the end-to-end candidate journey standard: awareness → consideration → apply → screen → interview → offer → pre-board → hire (links to VS-19.1 onboarding), with defined SLAs (apply acknowledgement, screen, interview-schedule, feedback, offer), touchpoints, and the expected candidate experience at each stage, segmented by role family (store frontline, trade, DC, corporate)
Responsible (R): TA Operations / TA Marketing
Accountable (A): TA Lead
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3769_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3769_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3769_Task5" name="TA Operations/IT instrument the journey in the ATS/candidate portal (links to…">
        <bpmn:documentation>Step 2: TA Operations/IT instrument the journey in the ATS/candidate portal (links to W3762/VS-103.3), enable automated but personalized candidate communications, self-scheduling, and feedback capture, and ensure a single candidate view across all applications/entities
Responsible (R): TA Operations / IT
Accountable (A): TA Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3769_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3769_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3769_Task6" name="TA Operations train recruiters and hiring managers on the candidate-experience…">
        <bpmn:documentation>Step 3: TA Operations train recruiters and hiring managers on the candidate-experience standard, monitor adherence (SLA dashboards), and drive continuous improvement from candidate feedback (links to W3776)
Responsible (R): TA Operations / HR
Accountable (A): TA Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3769_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3769_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3769_End7" name="Complete">
        <bpmn:incoming>W3769_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3769_Annotation8">
        <bpmn:text>Controls: - CTL-593 (ensure controlled execution — Candidate Experience, Sourcing &amp; Selection Operations (PA-121.2).) | - operational: standard + SLA monitoring; operational: feedback SLA and automation
Owner: TA Marketing / TA Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3769_Assoc9" sourceRef="W3769_Annotation8" targetRef="W3769_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3769_Flow10" sourceRef="W3769_Start3" targetRef="W3769_Task4" />
      <bpmn:sequenceFlow id="W3769_Flow11" sourceRef="W3769_Task4" targetRef="W3769_Task5" />
      <bpmn:sequenceFlow id="W3769_Flow12" sourceRef="W3769_Task5" targetRef="W3769_Task6" />
      <bpmn:sequenceFlow id="W3769_Flow13" sourceRef="W3769_Task6" targetRef="W3769_End7" />
    </bpmn:process>
