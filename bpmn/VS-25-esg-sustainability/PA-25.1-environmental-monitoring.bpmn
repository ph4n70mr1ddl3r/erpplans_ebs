        <bpmndi:BPMNEdge id="W1261_Flow16_di" bpmnElement="W1261_Flow16"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1261_Flow17_di" bpmnElement="W1261_Flow17"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1261_Flow18_di" bpmnElement="W1261_Flow18"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1261_Flow19_di" bpmnElement="W1261_Flow19"><di:waypoint x="1420" y="505" /><di:waypoint x="1470" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1261_Assoc13_di" bpmnElement="W1261_Assoc13"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1262" name="W1262. Product Carbon Footprint Tracking, Green Product Labeling &amp; Sustainable Sourcing Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled — quarterly carbon footprint calculation; annual sustainable sourcing report; ad-hoc triggered by customer inquiry, regulatory requirement, or new product introduction
Frequency: Quarterly carbon footprint update; annual sustainable sourcing report; continuous green product labeling maintenance
Volume: 35,000 active SKUs assessed quarterly; ~500–1,000 SKUs qualifying for green product label; ~800–1,000 vendors assessed annually for sustainable sourcing score
Owner: ESG &amp; Sustainability Coordinator
Participants: Category Manager, Procurement Manager, Vendor, Quality Assurance, VP Merchandising, VP ESG
Source: workflow W1262 — Product Carbon Footprint Tracking, Green Product Labeling &amp; Sustainable Sourcing Analytics</bpmn:documentation>
      <bpmn:laneSet id="W1262_LaneSet4">
        <bpmn:lane id="W1262_Lane1" name="ESG Coordinator">
        <bpmn:flowNodeRef>W1262_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1262_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1262_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1262_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1262_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W1262_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1262_Lane3" name="Procurement Manager">
        <bpmn:flowNodeRef>W1262_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1262_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1262_Start5" name="Scheduled — quarterly carbon footprint calculation; annual sustainable sourcing report…">
        <bpmn:outgoing>W1262_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1262_Task6" name="Quarterly product carbon footprint calculation">
        <bpmn:documentation>Step 1: Quarterly product carbon footprint calculation: ESG Coordinator calculates carbon footprint per product category using spend-based LCA methodology: (a) categorize all 35,000 SKUs into 12 product categories; (b) for each category, estimate Scope 3 emissions: (i) raw material extraction (cement, steel, wood, plastic), (ii) manufacturing, (iii) transportation (import shipping, domestic trucking), (iv) end-of-life (landfill, recycle, reuse); (c) use emission factors from Philippine DOE, IPCC, and supplier-specific data where available; (d) calculate kgCO2e per PHP 1,000 of product sold; (e) rank categories by carbon intensity and identify top 5 emission hotspots
Responsible (R): ESG Coordinator
Accountable (A): VP ESG
Duration: 16 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1262_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1262_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1262_Task7" name="Green product identification &amp; labeling">
        <bpmn:documentation>Step 2: Green product identification &amp; labeling: Category Manager and ESG Coordinator identify products qualifying for &quot;BuildRight Green&quot; label: (a) criteria: (i) certified sustainable sourcing (FSC-certified lumber, recycled-content tiles, low-VOC paint), (ii) energy-efficient (inverter aircons, LED lighting), (iii) locally sourced (&lt; 200 km from BuildRight DC — lower transport emissions), (iv) durable/repairable (extended warranty, parts availability); (b) maintain green product list in item master with certification documentation; (c) generate in-store shelf labels with green badge; (d) flag green products on ecommerce platform with sustainability badge; (e) update quarterly as product catalog changes
Responsible (R): Category Manager / ESG Coordinator
Accountable (A): VP Merchandising
Duration: 8 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1262_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1262_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1262_Task8" name="Vendor sustainable sourcing scorecard">
        <bpmn:documentation>Step 3: Vendor sustainable sourcing scorecard: Annual assessment of top 200 vendors on sustainability: (a) score vendors on: (i) environmental management certification (ISO 14001), (ii) sustainable raw material sourcing (FSC, recycled content), (iii) carbon emissions reduction commitment, (iv) waste management and circular economy practices, (v) labor practices and social compliance per W160; (b) categorize vendors: Green (score ≥ 4/5), Yellow (2.5–3.9), Red (&lt; 2.5 — improvement required); (c) share scorecard results with vendors and agree on improvement plans for Yellow/Red vendors; (d) prefer Green vendors in procurement decisions for tie-breaker situations
Responsible (R): Procurement Manager / ESG Coordinator
Accountable (A): VP Merchandising
Duration: 40 hours/year</bpmn:documentation>
        <bpmn:incoming>W1262_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1262_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1262_Task9" name="B2B sustainability data provision">
        <bpmn:documentation>Step 4: B2B sustainability data provision: For corporate and government customers requesting sustainability data: (a) generate product sustainability datasheet for specified products: carbon footprint, certifications, recycled content %, local sourcing %; (b) provide vendor sustainability scorecard summary for project bids; (c) calculate and report Scope 3 emissions avoided by using BuildRight Green products vs. conventional alternatives; (d) support customer LEED/BERDE certification documentation with material sustainability data
Responsible (R): ESG Coordinator / Sales Associate (Trade)
Accountable (A): VP ESG
Duration: 4 hours per request</bpmn:documentation>
        <bpmn:incoming>W1262_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1262_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1262_Task10" name="Annual sustainable sourcing report">
        <bpmn:documentation>Step 5: Annual sustainable sourcing report: ESG Coordinator produces annual report: (a) total products with green label and revenue contribution; (b) Scope 3 emissions by category and trend vs. prior year; (c) vendor sustainability scorecard distribution; (d) B2B sustainability data requests fulfilled; (e) sustainable sourcing targets for next year; (f) include in annual ESG report per W194
Responsible (R): ESG Coordinator
Accountable (A): VP ESG
Duration: 24 hours/year</bpmn:documentation>
        <bpmn:incoming>W1262_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1262_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1262_End11" name="Complete">
        <bpmn:incoming>W1262_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1262_Annotation12">
        <bpmn:text>Controls: - CTL-227 (ensure ESG data integrity &amp; disclosure.) | - operational: standard operating procedures; system-enforced validation rules
Owner: ESG &amp; Sustainability Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1262_Assoc13" sourceRef="W1262_Annotation12" targetRef="W1262_Start5" associationDirection="None" />
