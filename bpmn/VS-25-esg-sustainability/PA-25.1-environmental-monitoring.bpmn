        <bpmndi:BPMNShape id="W192_Task11_di" bpmnElement="W192_Task11"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W192_Task12_di" bpmnElement="W192_Task12"><dc:Bounds x="1240" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W192_Task13_di" bpmnElement="W192_Task13"><dc:Bounds x="1450" y="805" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W192_Start7_di" bpmnElement="W192_Start7"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W192_End14_di" bpmnElement="W192_End14"><dc:Bounds x="1680" y="827" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W192_Annotation15_di" bpmnElement="W192_Annotation15"><dc:Bounds x="160" y="970" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W192_Flow17_di" bpmnElement="W192_Flow17"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W192_Flow18_di" bpmnElement="W192_Flow18"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W192_Flow19_di" bpmnElement="W192_Flow19"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W192_Flow20_di" bpmnElement="W192_Flow20"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W192_Flow21_di" bpmnElement="W192_Flow21"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W192_Flow22_di" bpmnElement="W192_Flow22"><di:waypoint x="1420" y="675" /><di:waypoint x="1450" y="845" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W192_Flow23_di" bpmnElement="W192_Flow23"><di:waypoint x="1630" y="845" /><di:waypoint x="1680" y="845" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W192_Assoc16_di" bpmnElement="W192_Assoc16"><di:waypoint x="340" y="970" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W193" name="W193. Waste Management &amp; Circular Economy" isExecutable="false">
      <bpmn:documentation>Trigger: Generation of scrap (W169), damaged goods (W91), or office waste
Frequency: Weekly collections
Volume: Significant wood, plastic, and metal scrap from 200 locations
Owner: Environmental Compliance Officer
Participants: Store/DC Manager, Scrap Vendor, Sustainability Lead
Source: workflow W193 — Waste Management &amp; Circular Economy</bpmn:documentation>
      <bpmn:laneSet id="W193_LaneSet6">
        <bpmn:lane id="W193_Lane1" name="Store">
        <bpmn:flowNodeRef>W193_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W193_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W193_Lane2" name="Cutter">
        <bpmn:flowNodeRef>W193_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W193_Lane3" name="Vendor">
        <bpmn:flowNodeRef>W193_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W193_Lane4" name="Environmental Officer">
        <bpmn:flowNodeRef>W193_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W193_Lane5" name="Sustainability Lead">
        <bpmn:flowNodeRef>W193_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W193_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W193_Start7" name="Generation of scrap (W169), damaged goods (W91), or office waste">
        <bpmn:outgoing>W193_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W193_Task8" name="Sorting">
        <bpmn:documentation>Step 1: Sorting: Store/DC staff sort waste at source: (a) Recyclables (Cardboard, Wood off-cuts, Plastic wrap); (b) Hazardous (W82); (c) General Waste
Responsible (R): Store/DC Staff
Accountable (A): Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W193_Flow16</bpmn:incoming>
        <bpmn:outgoing>W193_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W193_Task9" name="Recovery">
        <bpmn:documentation>Step 2: Recovery: Wood off-cuts from cutting services (W169) are moved to &quot;Remnant Sale&quot; or donated for community building
Responsible (R): Cutter
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W193_Flow17</bpmn:incoming>
        <bpmn:outgoing>W193_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W193_Task10" name="Vendor Collection">
        <bpmn:documentation>Step 3: Vendor Collection: Accredited recycling vendors collect sorted waste; record weights in the system
Responsible (R): Vendor / Manager
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W193_Flow18</bpmn:incoming>
        <bpmn:outgoing>W193_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W193_Task11" name="Waste Diversion Tracking">
        <bpmn:documentation>Step 4: Waste Diversion Tracking: System logs weight diverted from landfill vs. total waste generated
Responsible (R): Environmental Officer
Accountable (A): Sustainability Lead
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W193_Flow19</bpmn:incoming>
        <bpmn:outgoing>W193_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W193_Task12" name="Impact Reporting">
        <bpmn:documentation>Step 5: Impact Reporting: Calculate &quot;Trees Saved&quot; or &quot;Plastic Prevented&quot; for use in annual ESG report
Responsible (R): Sustainability Lead
Accountable (A): CMO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W193_Flow20</bpmn:incoming>
        <bpmn:outgoing>W193_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W193_End13" name="Complete">
        <bpmn:incoming>W193_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W193_Annotation14">
        <bpmn:text>Controls: - CTL-316 (ensure controlled execution — Environmental Monitoring (PA-25.1).) | - operational: reporting for large waste generators
Owner: Environmental Compliance Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W193_Assoc15" sourceRef="W193_Annotation14" targetRef="W193_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W193_Flow16" sourceRef="W193_Start7" targetRef="W193_Task8" />
      <bpmn:sequenceFlow id="W193_Flow17" sourceRef="W193_Task8" targetRef="W193_Task9" />
      <bpmn:sequenceFlow id="W193_Flow18" sourceRef="W193_Task9" targetRef="W193_Task10" />
      <bpmn:sequenceFlow id="W193_Flow19" sourceRef="W193_Task10" targetRef="W193_Task11" />
      <bpmn:sequenceFlow id="W193_Flow20" sourceRef="W193_Task11" targetRef="W193_Task12" />
      <bpmn:sequenceFlow id="W193_Flow21" sourceRef="W193_Task12" targetRef="W193_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W193_diag">
      <bpmndi:BPMNPlane id="W193_plane" bpmnElement="W_W193">
        <bpmndi:BPMNShape id="W193_Lane1_di" bpmnElement="W193_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W193_Lane2_di" bpmnElement="W193_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W193_Lane3_di" bpmnElement="W193_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W193_Lane4_di" bpmnElement="W193_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W193_Lane5_di" bpmnElement="W193_Lane5" isHorizontal="true"><dc:Bounds x="160" y="760" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W193_Task8_di" bpmnElement="W193_Task8"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W193_Task9_di" bpmnElement="W193_Task9"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W193_Task10_di" bpmnElement="W193_Task10"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W193_Task11_di" bpmnElement="W193_Task11"><dc:Bounds x="1030" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W193_Task12_di" bpmnElement="W193_Task12"><dc:Bounds x="1240" y="805" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W193_Start7_di" bpmnElement="W193_Start7"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W193_End13_di" bpmnElement="W193_End13"><dc:Bounds x="1470" y="827" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W193_Annotation14_di" bpmnElement="W193_Annotation14"><dc:Bounds x="160" y="970" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W193_Flow16_di" bpmnElement="W193_Flow16"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W193_Flow17_di" bpmnElement="W193_Flow17"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W193_Flow18_di" bpmnElement="W193_Flow18"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W193_Flow19_di" bpmnElement="W193_Flow19"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W193_Flow20_di" bpmnElement="W193_Flow20"><di:waypoint x="1210" y="675" /><di:waypoint x="1240" y="845" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W193_Flow21_di" bpmnElement="W193_Flow21"><di:waypoint x="1420" y="845" /><di:waypoint x="1470" y="845" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W193_Assoc15_di" bpmnElement="W193_Assoc15"><di:waypoint x="340" y="970" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W443" name="W443. Salvage &amp; Scrap Material Disposition (Waste-to-Cash)" isExecutable="false">
      <bpmn:documentation>Trigger: Accumulation of massive volumes of cardboard, broken pallets, rebar ends, or metal scrap
Frequency: Weekly (Stores); Daily (DCs)
Volume: ~500–1,000 tons of cardboard/year; ~1–5 tons of metal scrap/store/YEAR (≈0.1–0.4 t/month, within W1261&#x27;s 2–5 t/month total waste)
Owner: ESG Lead
Participants: Stock Associate, Security, Finance, Accredited Recycler / Scrap Buyer
Source: workflow W443 — Salvage &amp; Scrap Material Disposition (Waste-to-Cash)</bpmn:documentation>
      <bpmn:laneSet id="W443_LaneSet7">
        <bpmn:lane id="W443_Lane1" name="Stock Associate">
        <bpmn:flowNodeRef>W443_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W443_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W443_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W443_Lane2" name="Dept Supervisor">
        <bpmn:flowNodeRef>W443_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W443_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W443_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W443_Lane4" name="Recycler">
        <bpmn:flowNodeRef>W443_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W443_Lane5" name="Finance">
        <bpmn:flowNodeRef>W443_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W443_Lane6" name="System">
        <bpmn:flowNodeRef>W443_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W443_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W443_Start8" name="Accumulation of massive volumes of cardboard, broken pallets, rebar ends, or metal scrap">
        <bpmn:outgoing>W443_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W443_Task9" name="Segregation">
        <bpmn:documentation>Step 1: Segregation: Stock Associate separates cardboard, plastic wrap, broken pallets, rebar ends, and scrap metal into designated zones
Responsible (R): Stock Associate
Accountable (A): Dept Supervisor
Duration: 1 hour/day</bpmn:documentation>
        <bpmn:incoming>W443_Flow19</bpmn:incoming>
        <bpmn:outgoing>W443_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W443_Task10" name="Write-off">
        <bpmn:documentation>Step 2: Write-off: If scrap originated from inventory (e.g., damaged rebar), it is written off per W92 before disposal
Responsible (R): Dept Supervisor
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W443_Flow20</bpmn:incoming>
        <bpmn:outgoing>W443_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W443_Task11" name="Baling/Aggregation">
        <bpmn:documentation>Step 3: Baling/Aggregation: Cardboard compacted; metal scrap collected in bins; weight recorded
Responsible (R): Stock Associate
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W443_Flow21</bpmn:incoming>
        <bpmn:outgoing>W443_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W443_Task12" name="Buyer Bidding">
        <bpmn:documentation>Step 4: Buyer Bidding: Store Manager solicits bids from at least 2 accredited scrap buyers; selects highest bidder
Responsible (R): Store Manager
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W443_Flow22</bpmn:incoming>
        <bpmn:outgoing>W443_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W443_Task13" name="Weighing &amp; Pickup">
        <bpmn:documentation>Step 5: Weighing &amp; Pickup: Recycler arrives; scrap is weighed on-site using calibrated scales; Security witnesses weighing
Responsible (R): Recycler / Security
Accountable (A): Store Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W443_Flow23</bpmn:incoming>
        <bpmn:outgoing>W443_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W443_Task14" name="Invoicing">
        <bpmn:documentation>Step 6: Invoicing: Finance (AR) generates a &quot;Scrap Sale Invoice&quot; including 12% VAT; Buyer pays (cash/check/e-wallet)
Responsible (R): Finance (AR)
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W443_Flow24</bpmn:incoming>
        <bpmn:outgoing>W443_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W443_Task15" name="ESG Reporting">
        <bpmn:documentation>Step 7: ESG Reporting: Weight data auto-feeds into the ESG Dashboard for &quot;Circular Economy&quot; reporting
Responsible (R): System
Accountable (A): ESG Lead
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W443_Flow25</bpmn:incoming>
        <bpmn:outgoing>W443_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W443_End16" name="Complete">
        <bpmn:incoming>W443_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W443_Annotation17">
        <bpmn:text>Controls: - CTL-316 (ensure controlled execution — Environmental Monitoring (PA-25.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: ESG Lead</bpmn:text>
      </bpmn:textAnnotation>
