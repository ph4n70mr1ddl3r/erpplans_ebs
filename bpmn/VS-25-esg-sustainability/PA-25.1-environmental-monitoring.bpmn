    <bpmn:process id="W_W1261" name="W1261. Construction &amp; Renovation Waste Recycling, Circular Economy Program &amp; Salvage Revenue Management" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled — monthly recycling program reporting; quarterly salvage revenue reconciliation; ad-hoc triggered by large project completion, store renovation waste, or customer salvage material drop-off
Frequency: Monthly program reporting; quarterly revenue reconciliation; continuous drop-off at participating stores
Volume: ~200 stores generating ~2–5 tons of operational waste per month; ~50 tons of customer salvage material collected per month at participating stores; ~PHP 500K–1M salvage revenue per month chain-wide
Owner: ESG &amp; Sustainability Coordinator
Participants: Store Manager, Facilities/Maintenance Staff, Salvage Vendor, Finance Controller, Category Manager
Source: workflow W1261 — Construction &amp; Renovation Waste Recycling, Circular Economy Program &amp; Salvage Revenue Management</bpmn:documentation>
      <bpmn:laneSet id="W1261_LaneSet4">
        <bpmn:lane id="W1261_Lane1" name="Maintenance Staff">
        <bpmn:flowNodeRef>W1261_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1261_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1261_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1261_Lane2" name="Customer Service Representative">
        <bpmn:flowNodeRef>W1261_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1261_Lane3" name="ESG Coordinator">
        <bpmn:flowNodeRef>W1261_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1261_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1261_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1261_Start5" name="Scheduled — monthly recycling program reporting; quarterly salvage revenue…">
        <bpmn:outgoing>W1261_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1261_Task6" name="Store-level waste segregation &amp; collection">
        <bpmn:documentation>Step 1: Store-level waste segregation &amp; collection: Maintenance Staff manages daily waste segregation at each store: (a) separate waste into 5 streams: (i) cardboard/paper, (ii) plastic film and hard plastic, (iii) metals (steel, copper, aluminum, brass), (iv) wood/lumber off-cuts, (v) hazardous waste (paint, solvents, chemicals per W238); (b) dedicated bins/compactor areas for each stream in receiving dock; (c) weigh and log each waste stream in system — total weight by stream per day; (d) target: 80% diversion rate (recycled or salvaged vs. landfilled)
Responsible (R): Maintenance Staff
Accountable (A): Store Manager
Duration: 30 min/day</bpmn:documentation>
        <bpmn:incoming>W1261_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1261_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1261_Task7" name="Customer salvage material drop-off program">
        <bpmn:documentation>Step 2: Customer salvage material drop-off program: Participating stores (initially top 50) accept customer salvage materials: (a) customers bring unused tiles, lumber, fixtures, paint from home renovation projects; (b) store assesses condition: (i) resalable — add to clearance section at 30–50% discount, (ii) donatable — set aside for NGO partner collection, (iii) recyclable — add to appropriate waste stream; (c) customer receives 5% discount voucher for next purchase as incentive; (d) system tracks drop-off volume and voucher redemption rate
Responsible (R): Customer Service Representative
Accountable (A): Store Manager
Duration: 15 min per drop-off</bpmn:documentation>
        <bpmn:incoming>W1261_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1261_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1261_Task8" name="Salvage vendor coordination">
        <bpmn:documentation>Step 3: Salvage vendor coordination: Monthly pickup by contracted salvage/recycling vendors: (a) schedule pickup for metals, cardboard, and plastics — minimum 500 kg per pickup; (b) weigh outgoing salvage materials on store scale; (c) vendor provides weighing receipt and payment per agreed rates (metals: PHP 20–40/kg for copper, PHP 10–20/kg for steel; cardboard: PHP 3–5/kg); (d) system records salvage revenue by store and material type; (e) reconcile vendor payment against system records
Responsible (R): Maintenance Staff / Finance Analyst
Accountable (A): Store Manager
Duration: 2 hours/month per store</bpmn:documentation>
        <bpmn:incoming>W1261_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1261_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1261_Task9" name="Donation program management">
        <bpmn:documentation>Step 4: Donation program management: For undamaged but unsellable items (display samples, slow-moving but functional products): (a) ESG Coordinator maintains NGO partner list (Gawad Kalinga, Habitat for Humanity, local LGU housing programs); (b) Store Manager identifies donatable items monthly; (c) system generates donation receipt for tax deduction (up to 250% deduction per RA 8424 for qualified donations); (d) coordinate pickup with NGO partner; (e) track donation value by store and recipient for annual CSR reporting
Responsible (R): ESG Coordinator / Store Manager
Accountable (A): COO
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W1261_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1261_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1261_Task10" name="Quarterly circular economy reporting">
        <bpmn:documentation>Step 5: Quarterly circular economy reporting: ESG Coordinator produces quarterly program report: (a) total waste generated vs. diverted — diversion rate trend; (b) salvage revenue by material type and store; (c) donation value and recipient tracking; (d) cost savings from waste reduction (lower waste disposal fees, lower raw material cost from recycled inputs); (e) carbon offset estimate from recycling vs. landfilling; (f) include in ESG report per W194
Responsible (R): ESG Coordinator
Accountable (A): COO
Duration: 8 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1261_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1261_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1261_End11" name="Complete">
        <bpmn:incoming>W1261_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1261_Annotation12">
        <bpmn:text>Controls: - CTL-316 (ensure controlled execution — Environmental Monitoring (PA-25.1).) | - operational: periodic reconciliation against source documents
Owner: ESG &amp; Sustainability Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1261_Assoc13" sourceRef="W1261_Annotation12" targetRef="W1261_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1261_Flow14" sourceRef="W1261_Start5" targetRef="W1261_Task6" />
      <bpmn:sequenceFlow id="W1261_Flow15" sourceRef="W1261_Task6" targetRef="W1261_Task7" />
      <bpmn:sequenceFlow id="W1261_Flow16" sourceRef="W1261_Task7" targetRef="W1261_Task8" />
      <bpmn:sequenceFlow id="W1261_Flow17" sourceRef="W1261_Task8" targetRef="W1261_Task9" />
      <bpmn:sequenceFlow id="W1261_Flow18" sourceRef="W1261_Task9" targetRef="W1261_Task10" />
      <bpmn:sequenceFlow id="W1261_Flow19" sourceRef="W1261_Task10" targetRef="W1261_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1261_diag">
      <bpmndi:BPMNPlane id="W1261_plane" bpmnElement="W_W1261">
        <bpmndi:BPMNShape id="W1261_Lane1_di" bpmnElement="W1261_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
