    <bpmn:process id="W_W1212" name="W1212. Store-Level Construction &amp; Renovation Waste Recycling &amp; Scrap Revenue Management" isExecutable="false">
      <bpmn:documentation>Trigger: Store generates recyclable waste from: customer project remnants, damaged packaging, display teardown, seasonal reset, or renovation project; or scheduled monthly scrap collection
Frequency: Ongoing (daily waste generation); monthly scrap collection and revenue reconciliation
Volume: ~200–500 kg of recyclable materials per store per month (cardboard, scrap metal, broken tiles, plastic packaging); ~40–100 tons/month chain-wide
Owner: Store Manager
Participants: Maintenance/Utility Staff, Store Manager, ESG Coordinator, Accredited Scrap Buyer, Finance Clerk
Source: workflow W1212 — Store-Level Construction &amp; Renovation Waste Recycling &amp; Scrap Revenue Management</bpmn:documentation>
      <bpmn:laneSet id="W1212_LaneSet5">
        <bpmn:lane id="W1212_Lane1" name="Maintenance">
        <bpmn:flowNodeRef>W1212_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1212_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1212_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1212_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W1212_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1212_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1212_Lane3" name="Scrap Buyer">
        <bpmn:flowNodeRef>W1212_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1212_Lane4" name="ESG Coordinator">
        <bpmn:flowNodeRef>W1212_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1212_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1212_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1212_Start6" name="Store generates recyclable waste from: customer project remnants, damaged packaging…">
        <bpmn:outgoing>W1212_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1212_Task7" name="Daily waste segregation">
        <bpmn:documentation>Step 1: Daily waste segregation: Maintenance/Utility Staff segregates waste into designated bins in receiving/backroom area: (a) Scrap metal: rebar offcuts from W986, pipe remnants from W944, damaged metal hardware, wire offcuts; (b) Cardboard/Paper: collapsed boxes from merchandise unpacking, promotional display materials; (c) Broken tiles/ceramics: damaged tiles, display samples, customer project remnants; (d) Plastic: shrink wrap, packaging film, empty paint cans (drained); (e) General waste: non-recyclable materials for municipal collection
Responsible (R): Maintenance/Utility
Accountable (A): Store Manager
Duration: 30 min/day</bpmn:documentation>
        <bpmn:incoming>W1212_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1212_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1212_Task8" name="Segregated storage">
        <bpmn:documentation>Step 2: Segregated storage: Maintenance Staff stores segregated recyclables in designated backroom areas: scrap metal in locked cage (theft target), cardboard in baler area, tiles in bin, plastic in compactor bags; system tracks approximate weight by category via bin-level scale or visual estimation
Responsible (R): Maintenance/Utility
Accountable (A): Store Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1212_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1212_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1212_Task9" name="Monthly scrap collection">
        <bpmn:documentation>Step 3: Monthly scrap collection: Store Manager coordinates with accredited scrap buyer (1–2 buyers per region, accredited per ESG criteria — DENR-registered, fair trade pricing); buyer visits store on scheduled collection day
Responsible (R): Store Manager
Accountable (A): ESG Coordinator
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W1212_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1212_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1212_Task10" name="Accredited scrap buyer weighs each category: (a) scrap metal — weighed on…">
        <bpmn:documentation>Step 4: Accredited scrap buyer weighs each category: (a) scrap metal — weighed on portable scale, (b) cardboard — weighed or counted by bale, (c) broken tiles — weighed, (d) plastic — weighed; buyer and Maintenance Staff sign weight ticket with category breakdown
Responsible (R): Scrap Buyer / Maintenance
Accountable (A): Store Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1212_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1212_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1212_Task11" name="Store Manager enters scrap sale in system: (a) material category, weight, unit…">
        <bpmn:documentation>Step 5: Store Manager enters scrap sale in system: (a) material category, weight, unit price, total amount; (b) system generates scrap sales receipt; (c) buyer pays cash or check to store; (d) Finance Clerk records scrap revenue in &quot;Other Income — Scrap Sales&quot; GL account; (e) buyer issues DENR-compliant waste transport manifest (for applicable materials)
Responsible (R): Store Manager / Finance Clerk
Accountable (A): Finance Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1212_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1212_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1212_Task12" name="Quarterly ESG reporting">
        <bpmn:documentation>Step 6: Quarterly ESG reporting: ESG Coordinator aggregates scrap data across all stores: (a) total waste diverted from landfill (kg by category), (b) scrap revenue generated, (c) waste diversion rate vs. target (target: ≥ 60% of operational waste diverted), (d) stores not meeting monthly collection schedule — flagged for follow-up; includes in quarterly ESG report per W694
Responsible (R): ESG Coordinator
Accountable (A): COO
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1212_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1212_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1212_Task13" name="Annual scrap buyer accreditation renewal">
        <bpmn:documentation>Step 7: Annual scrap buyer accreditation renewal: ESG Coordinator reviews scrap buyers: (a) verify DENR registration current, (b) benchmark pricing against market rates, (c) assess buyer reliability and collection timeliness, (d) solicit competitive bids from alternative buyers in each region; renews or replaces underperforming buyers
Responsible (R): ESG Coordinator
Accountable (A): COO
Duration: 1 day/year</bpmn:documentation>
        <bpmn:incoming>W1212_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1212_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1212_End14" name="Complete">
        <bpmn:incoming>W1212_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1212_Annotation15">
        <bpmn:text>Controls: - CTL-316 (ensure controlled execution — Environmental Monitoring (PA-25.1).) | - operational: Store Manager review and approval gate
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1212_Assoc16" sourceRef="W1212_Annotation15" targetRef="W1212_Start6" associationDirection="None" />
