      <bpmn:sequenceFlow id="W1396_Flow18" sourceRef="W1396_Task8" targetRef="W1396_Task9" />
      <bpmn:sequenceFlow id="W1396_Flow19" sourceRef="W1396_Task9" targetRef="W1396_Task10" />
      <bpmn:sequenceFlow id="W1396_Flow20" sourceRef="W1396_Task10" targetRef="W1396_Task11" />
      <bpmn:sequenceFlow id="W1396_Flow21" sourceRef="W1396_Task11" targetRef="W1396_End12" />
    </bpmn:process>
