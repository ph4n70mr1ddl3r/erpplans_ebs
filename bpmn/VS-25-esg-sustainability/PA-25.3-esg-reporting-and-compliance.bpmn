      <bpmndi:BPMNPlane id="W1396_plane" bpmnElement="W_W1396">
        <bpmndi:BPMNShape id="W1396_Lane1_di" bpmnElement="W1396_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
