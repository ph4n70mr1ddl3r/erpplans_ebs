        <bpmndi:BPMNShape id="W1334_Task7_di" bpmnElement="W1334_Task7"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1334_Task8_di" bpmnElement="W1334_Task8"><dc:Bounds x="1240" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1334_Task9_di" bpmnElement="W1334_Task9"><dc:Bounds x="1450" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1334_Start3_di" bpmnElement="W1334_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1334_End10_di" bpmnElement="W1334_End10"><dc:Bounds x="1680" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1334_Annotation11_di" bpmnElement="W1334_Annotation11"><dc:Bounds x="160" y="290" width="360" height="114" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1334_Flow13_di" bpmnElement="W1334_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1334_Flow14_di" bpmnElement="W1334_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1334_Flow15_di" bpmnElement="W1334_Flow15"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1334_Flow16_di" bpmnElement="W1334_Flow16"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1334_Flow17_di" bpmnElement="W1334_Flow17"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1334_Flow18_di" bpmnElement="W1334_Flow18"><di:waypoint x="1420" y="165" /><di:waypoint x="1450" y="165" /></bpmndi:BPMNEdge>
