<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-25.2-social-impact-and-governance" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W194" name="W194. Social Impact &amp; Community Development (CSR)" isExecutable="false">
      <bpmn:documentation>Trigger: Approved CSR initiative (e.g., &quot;BuildRight Homes for Mindanao&quot;)
Frequency: Quarterly projects
Volume: ~1 major corporate CSR project/quarter; ~1–2 local community outreach events per store/year
Owner: CSR Coordinator (within Marketing)
Participants: HR (Volunteers), Finance (Donations), Partner NGOs
Source: workflow W194 — Social Impact &amp; Community Development (CSR)</bpmn:documentation>
      <bpmn:laneSet id="W194_LaneSet4">
        <bpmn:lane id="W194_Lane1" name="CSR Coordinator">
        <bpmn:flowNodeRef>W194_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W194_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W194_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W194_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W194_Lane2" name="Project Team">
        <bpmn:flowNodeRef>W194_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W194_Lane3" name="Social Mgr">
        <bpmn:flowNodeRef>W194_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W194_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W194_Start5" name="Approved CSR initiative (e.g., &quot;BuildRight Homes for Mindanao&quot;)">
        <bpmn:outgoing>W194_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W194_Task6" name="Project Selection">
        <bpmn:documentation>Step 1: Project Selection: Align CSR activity with company mission (Building supplies → Habitat for Humanity, etc.)
Responsible (R): CSR Coordinator
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W194_Flow14</bpmn:incoming>
        <bpmn:outgoing>W194_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W194_Task7" name="Resource Allocation">
        <bpmn:documentation>Step 2: Resource Allocation: (a) Materials: Donate near-expiry or slow-moving stock (W93); (b) Cash: Direct donation per board-approved budget; (c) Time: Employee volunteer hours
Responsible (R): CSR Coordinator
Accountable (A): CFO / CHRO
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W194_Flow15</bpmn:incoming>
        <bpmn:outgoing>W194_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W194_Task8" name="Execution">
        <bpmn:documentation>Step 3: Execution: Distribute materials or conduct volunteer activity; capture impact metrics (houses built, families helped)
Responsible (R): Project Team
Accountable (A): —
Duration: Varies</bpmn:documentation>
        <bpmn:incoming>W194_Flow16</bpmn:incoming>
        <bpmn:outgoing>W194_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W194_Task9" name="Communication">
        <bpmn:documentation>Step 4: Communication: PR &amp; Social Media coverage of the initiative (W142)
Responsible (R): Social Mgr
Accountable (A): CMO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W194_Flow17</bpmn:incoming>
        <bpmn:outgoing>W194_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W194_Task10" name="Reporting">
        <bpmn:documentation>Step 5: Reporting: Document in ESG Report: PHP value donated, volunteer hours, and community impact
Responsible (R): CSR Coordinator
Accountable (A): Sustainability Lead
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W194_Flow18</bpmn:incoming>
        <bpmn:outgoing>W194_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W194_End11" name="Complete">
        <bpmn:incoming>W194_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W194_Annotation12">
        <bpmn:text>Controls: - CTL-317 (ensure controlled execution — Social Impact &amp; Governance (PA-25.2).) | - operational: CSR Coordinator (within Marketing) review and approval gate
Owner: CSR Coordinator (within Marketing)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W194_Assoc13" sourceRef="W194_Annotation12" targetRef="W194_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W194_Flow14" sourceRef="W194_Start5" targetRef="W194_Task6" />
      <bpmn:sequenceFlow id="W194_Flow15" sourceRef="W194_Task6" targetRef="W194_Task7" />
      <bpmn:sequenceFlow id="W194_Flow16" sourceRef="W194_Task7" targetRef="W194_Task8" />
      <bpmn:sequenceFlow id="W194_Flow17" sourceRef="W194_Task8" targetRef="W194_Task9" />
      <bpmn:sequenceFlow id="W194_Flow18" sourceRef="W194_Task9" targetRef="W194_Task10" />
      <bpmn:sequenceFlow id="W194_Flow19" sourceRef="W194_Task10" targetRef="W194_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W194_diag">
      <bpmndi:BPMNPlane id="W194_plane" bpmnElement="W_W194">
        <bpmndi:BPMNShape id="W194_Lane1_di" bpmnElement="W194_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W194_Lane2_di" bpmnElement="W194_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W194_Lane3_di" bpmnElement="W194_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W194_Task6_di" bpmnElement="W194_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W194_Task7_di" bpmnElement="W194_Task7"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W194_Task8_di" bpmnElement="W194_Task8"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W194_Task9_di" bpmnElement="W194_Task9"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W194_Task10_di" bpmnElement="W194_Task10"><dc:Bounds x="1240" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W194_Start5_di" bpmnElement="W194_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W194_End11_di" bpmnElement="W194_End11"><dc:Bounds x="1470" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W194_Annotation12_di" bpmnElement="W194_Annotation12"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W194_Flow14_di" bpmnElement="W194_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W194_Flow15_di" bpmnElement="W194_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W194_Flow16_di" bpmnElement="W194_Flow16"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W194_Flow17_di" bpmnElement="W194_Flow17"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W194_Flow18_di" bpmnElement="W194_Flow18"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W194_Flow19_di" bpmnElement="W194_Flow19"><di:waypoint x="1420" y="165" /><di:waypoint x="1470" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W194_Assoc13_di" bpmnElement="W194_Assoc13"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W195" name="W195. Sustainable Sourcing &amp; Ethical Vendor Audit" isExecutable="false">
      <bpmn:documentation>Trigger: New vendor onboarding (W36); or annual high-risk vendor review
Frequency: Annual for top 20 vendors
Volume: ~20 audits/year (focused on top 20 vendors + high-risk categories)
Owner: Sustainability Lead
Participants: Procurement (Buyer), Sustainability Lead, Internal Audit
Source: workflow W195 — Sustainable Sourcing &amp; Ethical Vendor Audit</bpmn:documentation>
      <bpmn:laneSet id="W195_LaneSet3">
        <bpmn:lane id="W195_Lane1" name="Vendor">
        <bpmn:flowNodeRef>W195_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W195_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W195_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W195_Lane2" name="Sustainability Lead">
        <bpmn:flowNodeRef>W195_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W195_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W195_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W195_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W195_Start4" name="New vendor onboarding (W36); or annual high-risk vendor review">
        <bpmn:outgoing>W195_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W195_Task5" name="Self-Assessment">
        <bpmn:documentation>Step 1: Self-Assessment: Vendor completes &quot;BuildRight Ethical Sourcing Questionnaire&quot; covering child labor, safety, and environmental permits
Responsible (R): Vendor
Accountable (A): Buyer
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W195_Flow13</bpmn:incoming>
        <bpmn:outgoing>W195_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W195_Task6" name="Risk Screening">
        <bpmn:documentation>Step 2: Risk Screening: Sustainability Lead flags vendors based on category (e.g., lumber/quarry = high risk) or geography
Responsible (R): Sustainability Lead
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W195_Flow14</bpmn:incoming>
        <bpmn:outgoing>W195_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W195_Task7" name="Audit">
        <bpmn:documentation>Step 3: Audit: Sustainability Lead or 3rd party conducts on-site or desktop audit of high-risk vendors
Responsible (R): Sustainability Lead
Accountable (A): VP Merch
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W195_Flow15</bpmn:incoming>
        <bpmn:outgoing>W195_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W195_Task8" name="Corrective Action">
        <bpmn:documentation>Step 4: Corrective Action: If non-compliance found, vendor must execute CAPA (Corrective Action Plan) per W110.5 or face de-listing per W36
Responsible (R): Vendor
Accountable (A): Sustainability Lead
Duration: 30 days</bpmn:documentation>
        <bpmn:incoming>W195_Flow16</bpmn:incoming>
        <bpmn:outgoing>W195_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W195_Task9" name="Scoring">
        <bpmn:documentation>Step 5: Scoring: Vendor&#x27;s &quot;Sustainability Score&quot; integrated into the Master Vendor Scorecard (W44)
Responsible (R): Sustainability Lead
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W195_Flow17</bpmn:incoming>
        <bpmn:outgoing>W195_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W195_End10" name="Complete">
        <bpmn:incoming>W195_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W195_Annotation11">
        <bpmn:text>Controls: - CTL-227 (ensure ESG data integrity &amp; disclosure.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Sustainability Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W195_Assoc12" sourceRef="W195_Annotation11" targetRef="W195_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W195_Flow13" sourceRef="W195_Start4" targetRef="W195_Task5" />
      <bpmn:sequenceFlow id="W195_Flow14" sourceRef="W195_Task5" targetRef="W195_Task6" />
      <bpmn:sequenceFlow id="W195_Flow15" sourceRef="W195_Task6" targetRef="W195_Task7" />
      <bpmn:sequenceFlow id="W195_Flow16" sourceRef="W195_Task7" targetRef="W195_Task8" />
      <bpmn:sequenceFlow id="W195_Flow17" sourceRef="W195_Task8" targetRef="W195_Task9" />
      <bpmn:sequenceFlow id="W195_Flow18" sourceRef="W195_Task9" targetRef="W195_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W195_diag">
      <bpmndi:BPMNPlane id="W195_plane" bpmnElement="W_W195">
        <bpmndi:BPMNShape id="W195_Lane1_di" bpmnElement="W195_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W195_Lane2_di" bpmnElement="W195_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W195_Task5_di" bpmnElement="W195_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W195_Task6_di" bpmnElement="W195_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W195_Task7_di" bpmnElement="W195_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W195_Task8_di" bpmnElement="W195_Task8"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W195_Task9_di" bpmnElement="W195_Task9"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W195_Start4_di" bpmnElement="W195_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W195_End10_di" bpmnElement="W195_End10"><dc:Bounds x="1470" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W195_Annotation11_di" bpmnElement="W195_Annotation11"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W195_Flow13_di" bpmnElement="W195_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W195_Flow14_di" bpmnElement="W195_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W195_Flow15_di" bpmnElement="W195_Flow15"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W195_Flow16_di" bpmnElement="W195_Flow16"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W195_Flow17_di" bpmnElement="W195_Flow17"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W195_Flow18_di" bpmnElement="W195_Flow18"><di:waypoint x="1420" y="335" /><di:waypoint x="1470" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W195_Assoc12_di" bpmnElement="W195_Assoc12"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W800" name="W800. Green Building Certification (BERDE/LEED) &amp; Sustainable Store Design Standards" isExecutable="false">
      <bpmn:documentation>Trigger: New store design phase per W223; or major renovation per W226 incorporating sustainability upgrades
Frequency: Per new store (10-15 per year); per major renovation with sustainability scope
Volume: Target: all new stores built after 2027 to achieve BERDE Certified level minimum
Owner: VP for Engineering &amp; Construction
Participants: Architect, MEP Engineer, ESG Manager, Procurement, Store Operations, BERDE/LEED Assessor
Source: workflow W800 — Green Building Certification (BERDE/LEED) &amp; Sustainable Store Design Standards</bpmn:documentation>
      <bpmn:laneSet id="W800_LaneSet6">
        <bpmn:lane id="W800_Lane1" name="Director, Facilities &amp; Real Estate">
        <bpmn:flowNodeRef>W800_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W800_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W800_Lane2" name="Architect">
        <bpmn:flowNodeRef>W800_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W800_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W800_Lane3" name="Project Manager">
        <bpmn:flowNodeRef>W800_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W800_Lane4" name="ESG Manager">
        <bpmn:flowNodeRef>W800_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W800_Lane5" name="Store Manager">
        <bpmn:flowNodeRef>W800_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W800_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W800_Start7" name="New store design phase per W223; or major renovation per W226 incorporating…">
        <bpmn:outgoing>W800_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W800_Task8" name="BERDE Certification Decision">
        <bpmn:documentation>Step 1: BERDE Certification Decision: For each new store project, Director, Facilities &amp; Real Estate and ESG Manager decide certification level: (a) BERDE Certified: minimum compliance (target for all new stores); (b) BERDE Silver: enhanced sustainability (target for flagship stores in Metro Manila); (c) BERDE Gold/Platinum: aspirational for landmark stores; (d) consider incremental CAPEX vs. long-term utility savings per W111; (e) register project with PHILGBC for BERDE assessment
Responsible (R): Director, Facilities &amp; Real Estate / ESG Manager
Accountable (A): CEO
Duration: 1-2 days</bpmn:documentation>
        <bpmn:incoming>W800_Flow17</bpmn:incoming>
        <bpmn:outgoing>W800_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W800_Task9" name="Sustainable Design Integration">
        <bpmn:documentation>Step 2: Sustainable Design Integration: During W223 design phase, Architect incorporates BERDE criteria: (a) Energy Efficiency: LED lighting throughout, high-efficiency HVAC (inverter technology), roof insulation, natural ventilation for non-airconditioned areas, solar-ready roof structure per W173; (b) Water Efficiency: low-flow fixtures, rainwater harvesting for garden center irrigation, greywater recycling where feasible; (c) Materials: locally-sourced materials (within 500 km per BERDE criteria), recycled content in non-structural elements, sustainable timber per W195 for lumber display areas; (d) Indoor Environmental Quality: low-VOC paints and adhesives, adequate ventilation, daylighting for showroom areas; (e) Waste Management: construction waste recycling plan per W193, dedicated recycling area in store operations per W167; (f) Sustainable Site: permeable paving for parking per W498, native landscaping, stormwater management
Responsible (R): Architect / MEP Engineer
Accountable (A): Director, Facilities &amp; Real Estate
Duration: Integrated into W223 timeline (+1-2 weeks)</bpmn:documentation>
        <bpmn:incoming>W800_Flow18</bpmn:incoming>
        <bpmn:outgoing>W800_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W800_Task10" name="BERDE Documentation">
        <bpmn:documentation>Step 3: BERDE Documentation: Throughout design and construction, compile BERDE submission documentation: (a) energy model showing projected energy consumption vs. baseline; (b) water consumption calculations; (c) material sourcing documentation with distance certificates; (d) indoor air quality management plan; (e) construction waste management plan with diversion targets; (f) commissioning plan for energy systems per W227
Responsible (R): Architect / ESG Manager
Accountable (A): Director, Facilities &amp; Real Estate
Duration: Continuous during design and construction</bpmn:documentation>
        <bpmn:incoming>W800_Flow19</bpmn:incoming>
        <bpmn:outgoing>W800_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W800_Task11" name="Construction Compliance">
        <bpmn:documentation>Step 4: Construction Compliance: During construction per W225, Project Manager monitors green building compliance: (a) construction waste segregation and recycling per W193 target of 50% diversion; (b) erosion and sedimentation control during site work; (c) indoor air quality management during construction (HVAC protection, material storage); (d) commissioning of energy systems per BERDE requirements integrated into W227; (e) document all sustainable construction practices with photos and records for BERDE submission
Responsible (R): Project Manager / Contractor
Accountable (A): Director, Facilities &amp; Real Estate
Duration: During W225 construction</bpmn:documentation>
        <bpmn:incoming>W800_Flow20</bpmn:incoming>
        <bpmn:outgoing>W800_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W800_Task12" name="BERDE Assessment &amp; Certification">
        <bpmn:documentation>Step 5: BERDE Assessment &amp; Certification: After store completion: (a) submit BERDE documentation package to PHILGBC assessor; (b) assessor conducts desk review and site verification; (c) address any assessor queries or additional documentation requests; (d) PHILGBC issues BERDE certification rating; (e) if target level not achieved: document gap and remediation plan for future stores; (f) if certified: display BERDE certificate in store per W504 digital signage; (g) publish certification in ESG report per W694
Responsible (R): ESG Manager / Architect
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 2-3 months post-completion</bpmn:documentation>
        <bpmn:incoming>W800_Flow21</bpmn:incoming>
        <bpmn:outgoing>W800_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W800_Task13" name="Post-Occupancy Monitoring">
        <bpmn:documentation>Step 6: Post-Occupancy Monitoring: During first year of operation, monitor green building performance: (a) actual energy consumption vs. modeled per W111; (b) actual water consumption vs. design target; (c) indoor air quality measurements; (d) occupant comfort survey (staff); (e) report performance to ESG Manager for W694 annual ESG report; (f) if actual performance significantly deviates from model: investigate and correct
Responsible (R): Store Manager / ESG Manager
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 1 year post-opening</bpmn:documentation>
        <bpmn:incoming>W800_Flow22</bpmn:incoming>
        <bpmn:outgoing>W800_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W800_End14" name="Complete">
        <bpmn:incoming>W800_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W800_Annotation15">
        <bpmn:text>Controls: - CTL-317 (ensure controlled execution — Social Impact &amp; Governance (PA-25.2).) | - operational: additional contractor supervision to ensure green-building compliance during construction
Owner: VP for Engineering &amp; Construction</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W800_Assoc16" sourceRef="W800_Annotation15" targetRef="W800_Start7" associationDirection="None" />
