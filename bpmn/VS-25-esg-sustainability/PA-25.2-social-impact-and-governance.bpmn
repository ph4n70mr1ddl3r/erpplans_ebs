      <bpmn:sequenceFlow id="W1176_Flow18" sourceRef="W1176_Task7" targetRef="W1176_Task8" />
      <bpmn:sequenceFlow id="W1176_Flow19" sourceRef="W1176_Task8" targetRef="W1176_Task9" />
      <bpmn:sequenceFlow id="W1176_Flow20" sourceRef="W1176_Task9" targetRef="W1176_Task10" />
      <bpmn:sequenceFlow id="W1176_Flow21" sourceRef="W1176_Task10" targetRef="W1176_Task11" />
      <bpmn:sequenceFlow id="W1176_Flow22" sourceRef="W1176_Task11" targetRef="W1176_Task12" />
      <bpmn:sequenceFlow id="W1176_Flow23" sourceRef="W1176_Task12" targetRef="W1176_End13" />
    </bpmn:process>
