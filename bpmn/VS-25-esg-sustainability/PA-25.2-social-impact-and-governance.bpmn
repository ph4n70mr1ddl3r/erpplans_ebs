      <bpmn:sequenceFlow id="W1479_Flow18" sourceRef="W1479_Task8" targetRef="W1479_Task9" />
      <bpmn:sequenceFlow id="W1479_Flow19" sourceRef="W1479_Task9" targetRef="W1479_Task10" />
      <bpmn:sequenceFlow id="W1479_Flow20" sourceRef="W1479_Task10" targetRef="W1479_Task11" />
      <bpmn:sequenceFlow id="W1479_Flow21" sourceRef="W1479_Task11" targetRef="W1479_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1479_diag">
      <bpmndi:BPMNPlane id="W1479_plane" bpmnElement="W_W1479">
        <bpmndi:BPMNShape id="W1479_Lane1_di" bpmnElement="W1479_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
