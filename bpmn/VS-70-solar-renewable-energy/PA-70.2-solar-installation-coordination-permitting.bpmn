      <bpmn:startEvent id="W2538_Start3" name="Solar installation work order created">
        <bpmn:outgoing>W2538_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2538_Task4" name="Coordinator prepares LGU permit application: electrical plan signed by licensed…">
        <bpmn:documentation>Step 1: Coordinator prepares LGU permit application: electrical plan signed by licensed Professional Electrical Engineer (PEE), structural certification for roof loading, building permit (if required by LGU for solar installations), fire safety clearance; requirements vary by LGU
Responsible (R): Solar Sales Coordinator
Accountable (A): Category Manager
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W2538_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2538_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2538_Task5" name="Coordinator submits application to LGU Building Official; tracks approval…">
        <bpmn:documentation>Step 2: Coordinator submits application to LGU Building Official; tracks approval timeline (typically 5–15 business days); coordinates with Licensed Electrical Engineer for any revisions or additional documentation requested
Responsible (R): Solar Sales Coordinator
Accountable (A): Category Manager
Duration: 5–15 business days</bpmn:documentation>
        <bpmn:incoming>W2538_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2538_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2538_Task6" name="Upon permit approval: installation can proceed; LGU inspection scheduled…">
        <bpmn:documentation>Step 3: Upon permit approval: installation can proceed; LGU inspection scheduled post-installation for final occupancy/electrical clearance; Coordinator ensures all documentation archived in ERP for future reference and warranty claims
Responsible (R): Solar Sales Coordinator
Accountable (A): Category Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2538_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2538_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2538_End7" name="Complete">
        <bpmn:incoming>W2538_Flow13</bpmn:incoming>
      </bpmn:endEvent>
