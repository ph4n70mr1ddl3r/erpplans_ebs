        <bpmndi:BPMNShape id="W2535_Task6_di" bpmnElement="W2535_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2535_Task7_di" bpmnElement="W2535_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2535_Start4_di" bpmnElement="W2535_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2535_End8_di" bpmnElement="W2535_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2535_Annotation9_di" bpmnElement="W2535_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2535_Flow11_di" bpmnElement="W2535_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2535_Flow12_di" bpmnElement="W2535_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2535_Flow13_di" bpmnElement="W2535_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2535_Flow14_di" bpmnElement="W2535_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2535_Assoc10_di" bpmnElement="W2535_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2536" name="W2536. Net Metering Application &amp; DU Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Solar system installation completed and passed inspection
Frequency: ~40–60 applications/month
Volume: ~40–60/month across all DU service areas
Owner: Solar Sales Coordinator
Participants: Solar Sales Coord, Customer, DU (Distribution Utility), ERC
Source: workflow W2536 — Net Metering Application &amp; DU Coordination</bpmn:documentation>
      <bpmn:laneSet id="W2536_LaneSet2">
        <bpmn:lane id="W2536_Lane1" name="Solar Sales Coordinator">
        <bpmn:flowNodeRef>W2536_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2536_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2536_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2536_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2536_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2536_Start3" name="Solar system installation completed and passed inspection">
        <bpmn:outgoing>W2536_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2536_Task4" name="Coordinator prepares net metering application package: ERC certificate of…">
        <bpmn:documentation>Step 1: Coordinator prepares net metering application package: ERC certificate of compliance, electrical plan/diagram, installation photos, installer license, customer documents (ID, proof of ownership, DU account number); submits to DU per their specific process (Meralco online portal, provincial DU walk-in)
Responsible (R): Solar Sales Coordinator
Accountable (A): Category Manager
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2536_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2536_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2536_Task5" name="DU conducts inspection and meter change (bi-directional meter); Coordinator…">
        <bpmn:documentation>Step 2: DU conducts inspection and meter change (bi-directional meter); Coordinator tracks application status; follows up with DU every 5 business days; manages customer expectations (DU processing: 2–8 weeks depending on utility)
Responsible (R): Solar Sales Coordinator
Accountable (A): Category Manager
Duration: 2–8 weeks</bpmn:documentation>
        <bpmn:incoming>W2536_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2536_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2536_Task6" name="Upon DU approval and bi-directional meter installation: Coordinator confirms…">
        <bpmn:documentation>Step 3: Upon DU approval and bi-directional meter installation: Coordinator confirms net metering activation; customer begins earning export credits; Coordinator closes installation work order and triggers warranty registration (W2541)
Responsible (R): Solar Sales Coordinator
Accountable (A): Category Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2536_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2536_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2536_End7" name="Complete">
        <bpmn:incoming>W2536_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2536_Annotation8">
        <bpmn:text>Controls: - CTL-440 (ensure controlled execution — Solar Installation Coordination &amp; Permitting (PA-70.2).) | - operational: Solar Sales Coordinator review and approval gate
Owner: Solar Sales Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2536_Assoc9" sourceRef="W2536_Annotation8" targetRef="W2536_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2536_Flow10" sourceRef="W2536_Start3" targetRef="W2536_Task4" />
      <bpmn:sequenceFlow id="W2536_Flow11" sourceRef="W2536_Task4" targetRef="W2536_Task5" />
      <bpmn:sequenceFlow id="W2536_Flow12" sourceRef="W2536_Task5" targetRef="W2536_Task6" />
      <bpmn:sequenceFlow id="W2536_Flow13" sourceRef="W2536_Task6" targetRef="W2536_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2536_diag">
      <bpmndi:BPMNPlane id="W2536_plane" bpmnElement="W_W2536">
        <bpmndi:BPMNShape id="W2536_Lane1_di" bpmnElement="W2536_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2536_Task4_di" bpmnElement="W2536_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2536_Task5_di" bpmnElement="W2536_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2536_Task6_di" bpmnElement="W2536_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2536_Start3_di" bpmnElement="W2536_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2536_End7_di" bpmnElement="W2536_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2536_Annotation8_di" bpmnElement="W2536_Annotation8"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2536_Flow10_di" bpmnElement="W2536_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2536_Flow11_di" bpmnElement="W2536_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2536_Flow12_di" bpmnElement="W2536_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2536_Flow13_di" bpmnElement="W2536_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2536_Assoc9_di" bpmnElement="W2536_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2537" name="W2537. Solar Installation Quality Inspection &amp; Commissioning" isExecutable="false">
      <bpmn:documentation>Trigger: Solar installation physical work completed
Frequency: ~40–60 inspections/month
Volume: ~40–60/month
Owner: Quality Inspector
Participants: Quality Inspector, Solar Installer, Category Manager
Source: workflow W2537 — Solar Installation Quality Inspection &amp; Commissioning</bpmn:documentation>
      <bpmn:laneSet id="W2537_LaneSet2">
        <bpmn:lane id="W2537_Lane1" name="Quality Inspector">
        <bpmn:flowNodeRef>W2537_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2537_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2537_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2537_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2537_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2537_Start3" name="Solar installation physical work completed">
        <bpmn:outgoing>W2537_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2537_Task4" name="Quality Inspector (BuildRight or third-party) conducts commissioning…">
        <bpmn:documentation>Step 1: Quality Inspector (BuildRight or third-party) conducts commissioning inspection: verifies panel mounting torque, wiring compliance (Philippine Electrical Code), inverter installation, grounding system, DC/AC disconnect accessibility, label compliance, fire safety clearance
Responsible (R): Quality Inspector
Accountable (A): Category Manager
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W2537_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2537_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2537_Task5" name="Inspector performs electrical testing: open-circuit voltage measurement per…">
        <bpmn:documentation>Step 2: Inspector performs electrical testing: open-circuit voltage measurement per string, insulation resistance test, ground continuity test, inverter startup and grid synchronization; records all test results in commissioning report via mobile app
Responsible (R): Quality Inspector
Accountable (A): Category Manager
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W2537_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2537_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2537_Task6" name="If passed: Inspector signs off commissioning certificate; triggers net metering…">
        <bpmn:documentation>Step 3: If passed: Inspector signs off commissioning certificate; triggers net metering application (W2536) and warranty registration (W2541). If failed: issues punch list to installer, schedules re-inspection within 5 business days
Responsible (R): Quality Inspector
Accountable (A): Category Manager
Duration: 30 min – 1 hour</bpmn:documentation>
        <bpmn:incoming>W2537_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2537_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2537_End7" name="Complete">
        <bpmn:incoming>W2537_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2537_Annotation8">
