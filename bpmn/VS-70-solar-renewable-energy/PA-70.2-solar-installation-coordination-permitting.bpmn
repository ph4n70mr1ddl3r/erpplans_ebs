        <bpmndi:BPMNShape id="W2534_End8_di" bpmnElement="W2534_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2534_Annotation9_di" bpmnElement="W2534_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2534_Flow11_di" bpmnElement="W2534_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2534_Flow12_di" bpmnElement="W2534_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2534_Flow13_di" bpmnElement="W2534_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2534_Flow14_di" bpmnElement="W2534_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2534_Assoc10_di" bpmnElement="W2534_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2535" name="W2535. Solar Installation Partner Scheduling &amp; Dispatch" isExecutable="false">
      <bpmn:documentation>Trigger: Customer approves final solar quotation
Frequency: ~40–60 installations/month
Volume: ~40–60/month across all regions
Owner: Solar Sales Coordinator
Participants: Solar Sales Coord, Installation Partner, Logistics, Store Ops
Source: workflow W2535 — Solar Installation Partner Scheduling &amp; Dispatch</bpmn:documentation>
      <bpmn:laneSet id="W2535_LaneSet3">
        <bpmn:lane id="W2535_Lane1" name="Solar Sales Coordinator">
        <bpmn:flowNodeRef>W2535_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2535_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2535_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2535_Lane2" name="Solar Installer">
        <bpmn:flowNodeRef>W2535_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2535_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2535_Start4" name="Customer approves final solar quotation">
        <bpmn:outgoing>W2535_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2535_Task5" name="Coordinator confirms customer order and creates installation work order in ERP…">
        <bpmn:documentation>Step 1: Coordinator confirms customer order and creates installation work order in ERP; assigns to installation partner based on geographic coverage, certification level (PRC-licensed Registered Master Electrician per RA 7920 required), and current workload; confirms installation date with customer (typically 2–4 weeks lead time)
Responsible (R): Solar Sales Coordinator
Accountable (A): Category Manager
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W2535_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2535_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2535_Task6" name="Coordinator coordinates material delivery: generates pick list for store/DC…">
        <bpmn:documentation>Step 2: Coordinator coordinates material delivery: generates pick list for store/DC, schedules delivery to customer site 1–2 days before installation, confirms installation partner has required tools and mounting hardware; Logistics arranges special delivery (panels require careful handling)
Responsible (R): Solar Sales Coordinator / Logistics
Accountable (A): VP Supply Chain
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2535_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2535_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2535_Task7" name="Installation partner arrives on-site, confirms material receipt and…">
        <bpmn:documentation>Step 3: Installation partner arrives on-site, confirms material receipt and completeness, executes installation per approved design; updates work order status in mobile app with progress photos at key milestones (mounting, panel placement, inverter installation, wiring)
Responsible (R): Solar Installer
Accountable (A): Solar Sales Coordinator
Duration: 1–3 days (system size dependent)</bpmn:documentation>
        <bpmn:incoming>W2535_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2535_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2535_End8" name="Complete">
        <bpmn:incoming>W2535_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2535_Annotation9">
        <bpmn:text>Controls: - CTL-440 (ensure controlled execution — Solar Installation Coordination &amp; Permitting (PA-70.2).) | - operational: Solar Sales Coordinator review and approval gate
Owner: Solar Sales Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2535_Assoc10" sourceRef="W2535_Annotation9" targetRef="W2535_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2535_Flow11" sourceRef="W2535_Start4" targetRef="W2535_Task5" />
      <bpmn:sequenceFlow id="W2535_Flow12" sourceRef="W2535_Task5" targetRef="W2535_Task6" />
      <bpmn:sequenceFlow id="W2535_Flow13" sourceRef="W2535_Task6" targetRef="W2535_Task7" />
      <bpmn:sequenceFlow id="W2535_Flow14" sourceRef="W2535_Task7" targetRef="W2535_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2535_diag">
      <bpmndi:BPMNPlane id="W2535_plane" bpmnElement="W_W2535">
        <bpmndi:BPMNShape id="W2535_Lane1_di" bpmnElement="W2535_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2535_Lane2_di" bpmnElement="W2535_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
