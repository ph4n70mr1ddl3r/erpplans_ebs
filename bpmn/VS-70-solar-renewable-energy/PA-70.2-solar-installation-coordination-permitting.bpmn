      <bpmn:documentation>Trigger: Solar system commissioned and grid-connected
Frequency: ~40–60 registrations/month
Volume: ~40–60/month
Owner: Solar Sales Coordinator
Participants: Solar Sales Coord, Customer, Vendor, Installation Partner
Source: workflow W2541 — Solar Installation Warranty Registration &amp; Handover</bpmn:documentation>
      <bpmn:laneSet id="W2541_LaneSet2">
        <bpmn:lane id="W2541_Lane1" name="Solar Sales Coordinator">
        <bpmn:flowNodeRef>W2541_Task4</bpmn:flowNodeRef>
