      <bpmn:startEvent id="W2541_Start3" name="Solar system commissioned and grid-connected">
        <bpmn:outgoing>W2541_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2541_Task4" name="Coordinator registers warranties: panel performance warranty (25-year linear…">
        <bpmn:documentation>Step 1: Coordinator registers warranties: panel performance warranty (25-year linear, 12-year product), inverter warranty (5–10 years), battery warranty (5–10 years), installation workmanship warranty (2 years); enters serial numbers, installation date, and contractor details into Oracle Install Base (serialized item instances, fit-gap D16)
Responsible (R): Solar Sales Coordinator
Accountable (A): Category Manager
Duration: 30–45 min</bpmn:documentation>
        <bpmn:incoming>W2541_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2541_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2541_Task5" name="Coordinator prepares customer handover package: system documentation (as-built…">
        <bpmn:documentation>Step 2: Coordinator prepares customer handover package: system documentation (as-built diagram, equipment manuals, warranty certificates), maintenance guide (panel cleaning schedule, inverter monitoring, annual inspection), emergency contacts, ERP portal login for warranty claim submission
Responsible (R): Solar Sales Coordinator
Accountable (A): Category Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W2541_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2541_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2541_Task6" name="Coordinator schedules 6-month follow-up call to verify system performance…">
        <bpmn:documentation>Step 3: Coordinator schedules 6-month follow-up call to verify system performance; enters customer into annual maintenance reminder program; flags for upsell opportunities (battery storage, EV charger, system expansion) at 12-month mark
Responsible (R): Solar Sales Coordinator
Accountable (A): Category Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W2541_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2541_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2541_End7" name="Complete">
        <bpmn:incoming>W2541_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2541_Annotation8">
        <bpmn:text>Controls: - CTL-440 (ensure controlled execution — Solar Installation Coordination &amp; Permitting (PA-70.2).) | - operational: maintenance, voiding performance warranties
Owner: Solar Sales Coordinator</bpmn:text>
      </bpmn:textAnnotation>
