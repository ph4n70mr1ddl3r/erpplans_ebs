      <bpmn:startEvent id="W2539_Start3" name="Installation date confirmed with partner">
        <bpmn:outgoing>W2539_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2539_Task4" name="Logistics Coordinator picks and stages installation materials at originating…">
        <bpmn:documentation>Step 1: Logistics Coordinator picks and stages installation materials at originating location (store or DC): panels (fragile), inverter, mounting rails, cables, connectors, breakers, conduits; creates consolidated shipment for site delivery
Responsible (R): Logistics Coordinator / DC Ops
Accountable (A): Logistics Manager
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2539_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2539_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2539_Task5" name="Coordinator schedules special delivery: panels require flat-bed or covered…">
        <bpmn:documentation>Step 2: Coordinator schedules special delivery: panels require flat-bed or covered truck (no stacking); arranges delivery 1–2 days before installation; confirms customer site access (roof access, parking for truck, crane/hoist availability for 2+ story buildings)
Responsible (R): Logistics Coordinator
Accountable (A): Logistics Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2539_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2539_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2539_Task6" name="Delivery executed; installation partner or customer signs goods receipt…">
        <bpmn:documentation>Step 3: Delivery executed; installation partner or customer signs goods receipt; Coordinator confirms material completeness vs. BOM; any missing items trigger emergency store-to-site replenishment within 24 hours
Responsible (R): Logistics Coordinator / Installation Partner
Accountable (A): Logistics Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2539_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2539_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2539_End7" name="Complete">
        <bpmn:incoming>W2539_Flow13</bpmn:incoming>
      </bpmn:endEvent>
