<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-70.2-solar-installation-coordination-permitting" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2534" name="W2534. Solar Site Survey &amp; Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: Customer confirms interest in solar system purchase
Frequency: ~80–120 surveys/month
Volume: ~80–120/month across all regions
Owner: Solar Installation Partner
Participants: Solar Installer, Customer, Solar Sales Coordinator
Source: workflow W2534 — Solar Site Survey &amp; Assessment</bpmn:documentation>
      <bpmn:laneSet id="W2534_LaneSet3">
        <bpmn:lane id="W2534_Lane1" name="Solar Sales Coordinator">
        <bpmn:flowNodeRef>W2534_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2534_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2534_Lane2" name="Solar Installer">
        <bpmn:flowNodeRef>W2534_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2534_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2534_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2534_Start4" name="Customer confirms interest in solar system purchase">
        <bpmn:outgoing>W2534_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2534_Task5" name="Solar Sales Coordinator schedules site survey with certified installation…">
        <bpmn:documentation>Step 1: Solar Sales Coordinator schedules site survey with certified installation partner within 5 business days of lead qualification; provides customer brief with preliminary system sizing from in-store consultation
Responsible (R): Solar Sales Coordinator
Accountable (A): Category Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W2534_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2534_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2534_Task6" name="Installation partner conducts on-site assessment: roof structural integrity…">
        <bpmn:documentation>Step 2: Installation partner conducts on-site assessment: roof structural integrity, orientation and tilt angle, shading analysis (trees, buildings), electrical panel capacity, meter location, conduit routing; takes photos and measurements; uses mobile app to capture data into ERP
Responsible (R): Solar Installer
Accountable (A): Solar Sales Coordinator
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2534_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2534_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2534_Task7" name="Installer produces final system design: panel layout, inverter placement, cable…">
        <bpmn:documentation>Step 3: Installer produces final system design: panel layout, inverter placement, cable routing, structural mounting requirements; generates updated quotation with actual costs (scaffolding, structural reinforcement, electrical upgrades if needed); Coordinator presents to customer for approval
Responsible (R): Solar Installer / Solar Sales Coordinator
Accountable (A): Category Manager
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2534_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2534_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2534_End8" name="Complete">
        <bpmn:incoming>W2534_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2534_Annotation9">
        <bpmn:text>Controls: - CTL-440 (ensure controlled execution — Solar Installation Coordination &amp; Permitting (PA-70.2).) | - operational: Solar Installation Partner review and approval gate
Owner: Solar Installation Partner</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2534_Assoc10" sourceRef="W2534_Annotation9" targetRef="W2534_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2534_Flow11" sourceRef="W2534_Start4" targetRef="W2534_Task5" />
      <bpmn:sequenceFlow id="W2534_Flow12" sourceRef="W2534_Task5" targetRef="W2534_Task6" />
      <bpmn:sequenceFlow id="W2534_Flow13" sourceRef="W2534_Task6" targetRef="W2534_Task7" />
      <bpmn:sequenceFlow id="W2534_Flow14" sourceRef="W2534_Task7" targetRef="W2534_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2534_diag">
      <bpmndi:BPMNPlane id="W2534_plane" bpmnElement="W_W2534">
        <bpmndi:BPMNShape id="W2534_Lane1_di" bpmnElement="W2534_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2534_Lane2_di" bpmnElement="W2534_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2534_Task5_di" bpmnElement="W2534_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2534_Task6_di" bpmnElement="W2534_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2534_Task7_di" bpmnElement="W2534_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
