    <bpmn:process id="W_W2538" name="W2538. Solar Electrical Permit &amp; LGU Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: Solar installation work order created
Frequency: ~40–60 permits/month
Volume: ~40–60/month across ~150 different LGUs
Owner: Solar Sales Coordinator
Participants: Solar Sales Coord, Customer, LGU Building Official, Licensed Engineer
Source: workflow W2538 — Solar Electrical Permit &amp; LGU Compliance</bpmn:documentation>
      <bpmn:laneSet id="W2538_LaneSet2">
        <bpmn:lane id="W2538_Lane1" name="Solar Sales Coordinator">
        <bpmn:flowNodeRef>W2538_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2538_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2538_Task6</bpmn:flowNodeRef>
