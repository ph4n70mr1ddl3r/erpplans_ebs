    <bpmn:process id="W_W2539" name="W2539. Solar Installation Material Staging &amp; Delivery Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Installation date confirmed with partner
Frequency: ~40–60 deliveries/month
Volume: ~40–60/month
Owner: Logistics Coordinator
Participants: Logistics Coord, Store/DC Ops, Installation Partner, Customer
Source: workflow W2539 — Solar Installation Material Staging &amp; Delivery Coordination</bpmn:documentation>
      <bpmn:laneSet id="W2539_LaneSet2">
        <bpmn:lane id="W2539_Lane1" name="Logistics Coordinator">
        <bpmn:flowNodeRef>W2539_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2539_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2539_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2539_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2539_End7</bpmn:flowNodeRef>
        </bpmn:lane>
