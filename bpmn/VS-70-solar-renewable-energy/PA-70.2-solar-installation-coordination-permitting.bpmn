    <bpmn:process id="W_W2540" name="W2540. Solar System Grid Connection &amp; Net Metering Activation" isExecutable="false">
      <bpmn:documentation>Trigger: DU approves net metering application
Frequency: ~40–60 activations/month
Volume: ~40–60/month
Owner: Solar Sales Coordinator
Participants: Solar Sales Coord, DU Technician, Customer, Installer
Source: workflow W2540 — Solar System Grid Connection &amp; Net Metering Activation</bpmn:documentation>
      <bpmn:laneSet id="W2540_LaneSet3">
        <bpmn:lane id="W2540_Lane1" name="DU Technician">
        <bpmn:flowNodeRef>W2540_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2540_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2540_Lane2" name="Solar Sales Coordinator">
        <bpmn:flowNodeRef>W2540_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2540_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2540_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2540_Start4" name="DU approves net metering application">
        <bpmn:outgoing>W2540_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2540_Task5" name="DU technician visits customer site: replaces existing unidirectional meter with…">
        <bpmn:documentation>Step 1: DU technician visits customer site: replaces existing unidirectional meter with bi-directional net meter; verifies system connection and grid synchronization; tests export power measurement
Responsible (R): DU Technician
Accountable (A): DU
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W2540_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2540_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2540_Task6" name="Coordinator confirms activation with customer: explains net metering billing…">
        <bpmn:documentation>Step 2: Coordinator confirms activation with customer: explains net metering billing mechanics (export credit calculation, monthly settlement, excess generation rollover); provides customer with monitoring app setup instructions; takes final system photos for project file
Responsible (R): Solar Sales Coordinator
Accountable (A): Category Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W2540_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2540_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2540_Task7" name="Coordinator closes project in ERP: completes installation work order, triggers…">
        <bpmn:documentation>Step 3: Coordinator closes project in ERP: completes installation work order, triggers warranty registration (W2541), posts revenue recognition (product sale + installation service), updates CRM with completed sale for future cross-sell (battery upgrade, EV charger)
Responsible (R): Solar Sales Coordinator
Accountable (A): Category Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W2540_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2540_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2540_End8" name="Complete">
        <bpmn:incoming>W2540_Flow14</bpmn:incoming>
      </bpmn:endEvent>
