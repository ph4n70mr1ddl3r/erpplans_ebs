<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-70.1-solar-product-merchandising-consultation" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2526" name="W2526. Solar Product Assortment Planning &amp; Vendor Selection" isExecutable="false">
      <bpmn:documentation>Trigger: Annual assortment review or new solar technology market entry
Frequency: Annual with quarterly updates
Volume: ~200–300 solar SKUs across panels, inverters, batteries, mounting, wiring
Owner: Category Manager — Electrical
Participants: Category Mgr, Procurement, Technical Specialist, VP Merchandising
Source: workflow W2526 — Solar Product Assortment Planning &amp; Vendor Selection</bpmn:documentation>
      <bpmn:laneSet id="W2526_LaneSet3">
        <bpmn:lane id="W2526_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W2526_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2526_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2526_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2526_Lane2" name="Procurement">
        <bpmn:flowNodeRef>W2526_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2526_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2526_Start4" name="Annual assortment review or new solar technology market entry">
        <bpmn:outgoing>W2526_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2526_Task5" name="Category Manager reviews solar market trends: panel technology (mono PERC…">
        <bpmn:documentation>Step 1: Category Manager reviews solar market trends: panel technology (mono PERC, bifacial, half-cut), inverter types (string vs. micro), battery storage, EV charging integration; identifies 20–30 new SKUs for introduction; evaluates vendor certifications (TÜV, IEC, UL)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2526_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2526_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2526_Task6" name="Procurement sources and qualifies solar vendors: Philippines product…">
        <bpmn:documentation>Step 2: Procurement sources and qualifies solar vendors: Philippines product certification (BPS/DTI), ERC registration, warranty terms, technical support capability, lead time for panels (import: 45–60 days); negotiates volume rebates and co-marketing funds
Responsible (R): Procurement
Accountable (A): VP Merchandising
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W2526_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2526_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2526_Task7" name="Merchandising finalizes assortment matrix: Tier 1 stores (Metro Manila, Cebu…">
        <bpmn:documentation>Step 3: Merchandising finalizes assortment matrix: Tier 1 stores (Metro Manila, Cebu, Davao) carry full solar range; Tier 2 stores carry core packages; online carries complete catalog; creates planogram for dedicated solar display area (minimum 16 sqm)
Responsible (R): Category Manager / Merchandising
Accountable (A): VP Merchandising
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2526_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2526_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2526_End8" name="Complete">
        <bpmn:incoming>W2526_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2526_Annotation9">
        <bpmn:text>Controls: - CTL-439 (ensure controlled execution — Solar Product Merchandising &amp; Consultation (PA-70.1).) | - operational: Category Manager — Electrical review and approval gate
Owner: Category Manager — Electrical</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2526_Assoc10" sourceRef="W2526_Annotation9" targetRef="W2526_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2526_Flow11" sourceRef="W2526_Start4" targetRef="W2526_Task5" />
      <bpmn:sequenceFlow id="W2526_Flow12" sourceRef="W2526_Task5" targetRef="W2526_Task6" />
      <bpmn:sequenceFlow id="W2526_Flow13" sourceRef="W2526_Task6" targetRef="W2526_Task7" />
      <bpmn:sequenceFlow id="W2526_Flow14" sourceRef="W2526_Task7" targetRef="W2526_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2526_diag">
      <bpmndi:BPMNPlane id="W2526_plane" bpmnElement="W_W2526">
        <bpmndi:BPMNShape id="W2526_Lane1_di" bpmnElement="W2526_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2526_Lane2_di" bpmnElement="W2526_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
