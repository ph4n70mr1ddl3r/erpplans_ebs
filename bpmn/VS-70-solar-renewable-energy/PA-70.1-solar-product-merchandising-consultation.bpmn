    <bpmn:process id="W_W2533" name="W2533. Solar Promotional Campaign &amp; Trade Show Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Seasonal promotion calendar or industry event
Frequency: Quarterly campaigns; 2–3 trade shows/year
Volume: 4 major campaigns; 2–3 events
Owner: Marketing Manager — Category
Participants: Marketing Mgr, Category Mgr, Vendor Co-Op, Store Ops, Events
Source: workflow W2533 — Solar Promotional Campaign &amp; Trade Show Coordination</bpmn:documentation>
      <bpmn:laneSet id="W2533_LaneSet3">
        <bpmn:lane id="W2533_Lane1" name="Marketing Manager">
        <bpmn:flowNodeRef>W2533_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2533_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2533_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2533_Lane2" name="Store Ops">
        <bpmn:flowNodeRef>W2533_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2533_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2533_Start4" name="Seasonal promotion calendar or industry event">
        <bpmn:outgoing>W2533_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2533_Task5" name="Marketing designs solar campaign: target audience (homeowners, small…">
        <bpmn:documentation>Step 1: Marketing designs solar campaign: target audience (homeowners, small businesses, trade accounts), promotional offers (bundle discounts, free installation assessment, net metering assistance), vendor co-op funding (panel manufacturers contribute 50% of ad spend)
Responsible (R): Marketing Manager
Accountable (A): CMO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2533_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2533_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2533_Task6" name="Store Ops coordinates in-store activation: solar demo display setup (working…">
        <bpmn:documentation>Step 2: Store Ops coordinates in-store activation: solar demo display setup (working panel + inverter + light display), staff briefing, promotional signage, ROI calculator kiosk; Logistics ensures additional stock for promotion period
Responsible (R): Store Ops / Logistics
Accountable (A): VP Store Operations
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2533_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2533_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2533_Task7" name="Marketing coordinates trade show participation (Philippine Energy Efficiency…">
        <bpmn:documentation>Step 3: Marketing coordinates trade show participation (Philippine Energy Efficiency Forum, Constructech): booth design, staff assignment, lead capture via iPad, vendor co-exhibition, post-event lead follow-up within 48 hours
Responsible (R): Marketing Manager / Category Manager
Accountable (A): CMO
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W2533_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2533_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2533_End8" name="Complete">
        <bpmn:incoming>W2533_Flow14</bpmn:incoming>
      </bpmn:endEvent>
