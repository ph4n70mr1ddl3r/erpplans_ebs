    <bpmn:process id="W_W2531" name="W2531. Solar Product Inventory &amp; Lead Time Management" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly inventory review or stockout incident
Frequency: Monthly
Volume: ~200–300 solar SKUs
Owner: Supply Planner
Participants: Supply Planner, Procurement, DC Ops, Category Manager
Source: workflow W2531 — Solar Product Inventory &amp; Lead Time Management</bpmn:documentation>
      <bpmn:laneSet id="W2531_LaneSet4">
        <bpmn:lane id="W2531_Lane1" name="Supply Planner">
        <bpmn:flowNodeRef>W2531_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2531_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2531_Lane2" name="Procurement">
        <bpmn:flowNodeRef>W2531_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2531_Lane3" name="DC Ops">
        <bpmn:flowNodeRef>W2531_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2531_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2531_Start5" name="Monthly inventory review or stockout incident">
        <bpmn:outgoing>W2531_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2531_Task6" name="Supply Planner reviews solar inventory levels vs. demand forecast: panels (high…">
        <bpmn:documentation>Step 1: Supply Planner reviews solar inventory levels vs. demand forecast: panels (high volume, import, 45–60 day lead time), inverters (medium volume, import, 30–45 days), mounting kits (local, 14 days), batteries (growing demand, import, 30–60 days); adjusts safety stock for A-items at 3 weeks vs. standard 1–2 weeks
Responsible (R): Supply Planner
Accountable (A): VP Supply Chain
Duration: 3–4 hours</bpmn:documentation>
        <bpmn:incoming>W2531_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2531_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2531_Task7" name="For stockout or low-stock critical items: Procurement expedites with vendor…">
        <bpmn:documentation>Step 2: For stockout or low-stock critical items: Procurement expedites with vendor; explores air freight for high-margin items; identifies substitute products; Category Manager approves SKU substitution at store level
Responsible (R): Procurement / Category Manager
Accountable (A): VP Merchandising
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2531_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2531_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2531_Task8" name="DC Ops ensures special handling for solar panels: vertical storage racks…">
        <bpmn:documentation>Step 3: DC Ops ensures special handling for solar panels: vertical storage racks, fragile handling protocols, dedicated staging area for large orders; coordinates consolidated delivery with customer installation schedule
Responsible (R): DC Ops / Logistics
Accountable (A): VP Supply Chain
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2531_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2531_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2531_End9" name="Complete">
        <bpmn:incoming>W2531_Flow15</bpmn:incoming>
      </bpmn:endEvent>
