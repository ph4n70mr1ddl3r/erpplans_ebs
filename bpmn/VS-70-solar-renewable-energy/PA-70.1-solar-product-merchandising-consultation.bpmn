      <bpmndi:BPMNPlane id="W2528_plane" bpmnElement="W_W2528">
        <bpmndi:BPMNShape id="W2528_Lane1_di" bpmnElement="W2528_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2528_Lane2_di" bpmnElement="W2528_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2528_Lane3_di" bpmnElement="W2528_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
