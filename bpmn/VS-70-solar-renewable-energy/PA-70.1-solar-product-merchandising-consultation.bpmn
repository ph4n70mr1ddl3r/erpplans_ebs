      <bpmn:startEvent id="W2530_Start4" name="New product launch, new hire, or annual recertification">
        <bpmn:outgoing>W2530_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2530_Task5" name="Training Manager develops solar product curriculum with vendor support: panel…">
        <bpmn:documentation>Step 1: Training Manager develops solar product curriculum with vendor support: panel technology basics, inverter selection, battery sizing, Philippine electrical code compliance, net metering process, safety protocols, customer consultation methodology
Responsible (R): Training Manager
Accountable (A): VP Merchandising
Duration: 1 week initial; quarterly updates</bpmn:documentation>
        <bpmn:incoming>W2530_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2530_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2530_Task6" name="Delivery: online modules via OLA (4 hours) + in-store practical workshop with…">
        <bpmn:documentation>Step 2: Delivery: online modules via OLA (4 hours) + in-store practical workshop with vendor demo units (4 hours); associates must pass certification quiz (80% minimum); certified associates receive badge on name tag and ERP profile
Responsible (R): Training Manager / Vendor Trainers
Accountable (A): CHRO
Duration: 8 hours per cohort</bpmn:documentation>
        <bpmn:incoming>W2530_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2530_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2530_Task7" name="HR tracks certification status in employee profile; Store Managers ensure…">
        <bpmn:documentation>Step 3: HR tracks certification status in employee profile; Store Managers ensure minimum 2 certified associates per store; recertification required annually; uncategorized associates cannot sell solar systems
Responsible (R): HR / Store Manager
Accountable (A): CHRO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2530_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2530_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2530_End8" name="Complete">
        <bpmn:incoming>W2530_Flow14</bpmn:incoming>
      </bpmn:endEvent>
