        <bpmndi:BPMNShape id="W2527_Start4_di" bpmnElement="W2527_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2527_End8_di" bpmnElement="W2527_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2527_Annotation9_di" bpmnElement="W2527_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2527_Flow11_di" bpmnElement="W2527_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2527_Flow12_di" bpmnElement="W2527_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2527_Flow13_di" bpmnElement="W2527_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2527_Flow14_di" bpmnElement="W2527_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2527_Assoc10_di" bpmnElement="W2527_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2528" name="W2528. Solar Package &amp; Bundle Configuration" isExecutable="false">
      <bpmn:documentation>Trigger: New product introduction or seasonal promotion
Frequency: Quarterly; 4–6 new packages/year
Volume: ~15–20 active solar bundles
Owner: Category Manager — Electrical
Participants: Category Mgr, Pricing Analyst, Merchandising, Procurement
Source: workflow W2528 — Solar Package &amp; Bundle Configuration</bpmn:documentation>
      <bpmn:laneSet id="W2528_LaneSet4">
        <bpmn:lane id="W2528_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W2528_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2528_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2528_Lane2" name="Pricing Analyst">
        <bpmn:flowNodeRef>W2528_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2528_Lane3" name="IT">
        <bpmn:flowNodeRef>W2528_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2528_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2528_Start5" name="New product introduction or seasonal promotion">
        <bpmn:outgoing>W2528_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2528_Task6" name="Category Manager designs solar packages by system size: 1kW (basic household)…">
        <bpmn:documentation>Step 1: Category Manager designs solar packages by system size: 1kW (basic household), 3kW (standard), 5kW (medium), 10kW (large household/small business); each bundle includes panels, inverter, mounting kit, cables, breakers, and installation labor SKU
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W2528_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2528_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2528_Task7" name="Pricing Analyst calculates bundle pricing: component cost + 5–10% bundle…">
        <bpmn:documentation>Step 2: Pricing Analyst calculates bundle pricing: component cost + 5–10% bundle discount vs. individual items; verifies margin targets (25–30%); compares against competitor solar package pricing in market
Responsible (R): Pricing Analyst
Accountable (A): VP Merchandising
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2528_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2528_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2528_Task8" name="System configures kit/bundle in ERP: links component SKUs to parent bundle…">
        <bpmn:documentation>Step 3: System configures kit/bundle in ERP: links component SKUs to parent bundle, defines BOM, sets assembly lead time (if pre-assembled), configures POS bundle scanning; tests at pilot store before rollout
Responsible (R): IT / Category Manager
Accountable (A): CIO / VP Merchandising
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W2528_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2528_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2528_End9" name="Complete">
        <bpmn:incoming>W2528_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2528_Annotation10">
        <bpmn:text>Controls: - CTL-202 (ensure solar program compliance &amp; delivery.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Category Manager — Electrical</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2528_Assoc11" sourceRef="W2528_Annotation10" targetRef="W2528_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2528_Flow12" sourceRef="W2528_Start5" targetRef="W2528_Task6" />
      <bpmn:sequenceFlow id="W2528_Flow13" sourceRef="W2528_Task6" targetRef="W2528_Task7" />
      <bpmn:sequenceFlow id="W2528_Flow14" sourceRef="W2528_Task7" targetRef="W2528_Task8" />
      <bpmn:sequenceFlow id="W2528_Flow15" sourceRef="W2528_Task8" targetRef="W2528_End9" />
    </bpmn:process>
