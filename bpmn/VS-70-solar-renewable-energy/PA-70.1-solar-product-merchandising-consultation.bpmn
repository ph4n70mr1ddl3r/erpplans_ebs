    <bpmn:process id="W_W2532" name="W2532. Solar Lead Capture &amp; CRM Funnel Management" isExecutable="false">
      <bpmn:documentation>Trigger: Customer expresses interest in solar system (in-store, online, phone)
Frequency: ~200–300 new leads/month
Volume: ~600–900 active leads in pipeline at any time
Owner: Solar Sales Coordinator
Participants: Solar Sales Coord, Sales Associates, Installation Partners, Category Manager
Source: workflow W2532 — Solar Lead Capture &amp; CRM Funnel Management</bpmn:documentation>
      <bpmn:laneSet id="W2532_LaneSet3">
        <bpmn:lane id="W2532_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W2532_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2532_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2532_Lane2" name="Solar Sales Coordinator">
        <bpmn:flowNodeRef>W2532_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2532_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2532_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2532_Start4" name="Customer expresses interest in solar system (in-store, online, phone)">
        <bpmn:outgoing>W2532_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2532_Task5" name="Sales Associate captures lead in CRM: customer contact, electricity consumption…">
        <bpmn:documentation>Step 1: Sales Associate captures lead in CRM: customer contact, electricity consumption data, property details, system interest level, budget range; assigns lead source (in-store, online, referral, trade account)
Responsible (R): Sales Associate
Accountable (A): Solar Sales Coordinator
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W2532_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2532_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2532_Task6" name="Solar Sales Coordinator qualifies lead: contacts customer within 24 hours…">
        <bpmn:documentation>Step 2: Solar Sales Coordinator qualifies lead: contacts customer within 24 hours, confirms requirements, schedules site survey with installation partner, sends preliminary quotation; updates CRM pipeline stage (New → Qualified → Site Survey → Quoted)
Responsible (R): Solar Sales Coordinator
Accountable (A): Category Manager
Duration: 30–45 min per lead</bpmn:documentation>
        <bpmn:incoming>W2532_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2532_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2532_Task7" name="Coordinator manages pipeline: follows up quoted leads within 7 days, nurtures…">
        <bpmn:documentation>Step 3: Coordinator manages pipeline: follows up quoted leads within 7 days, nurtures cold leads with monthly solar education content, reports conversion metrics (lead-to-sale target: 15–20%), escalates large commercial leads (&gt;20kW) to Category Manager
Responsible (R): Solar Sales Coordinator
Accountable (A): VP Merchandising
Duration: 2–3 hours/week</bpmn:documentation>
        <bpmn:incoming>W2532_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2532_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2532_End8" name="Complete">
        <bpmn:incoming>W2532_Flow14</bpmn:incoming>
      </bpmn:endEvent>
