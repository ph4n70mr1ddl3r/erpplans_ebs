    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2527" name="W2527. In-Store Solar Consultation &amp; System Sizing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer inquiry about solar installation at store or via ecommerce
Frequency: ~200–300 consultations/month across all stores
Volume: ~1–2 per store per week at Tier 1 stores; ~2–4 per month at Tier 2
Owner: Department Supervisor — Electrical
Participants: Dept Supervisor, Solar-Trained Sales Associate, Customer
Source: workflow W2527 — In-Store Solar Consultation &amp; System Sizing</bpmn:documentation>
      <bpmn:laneSet id="W2527_LaneSet3">
        <bpmn:lane id="W2527_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W2527_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2527_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2527_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2527_Lane2" name="System">
        <bpmn:flowNodeRef>W2527_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2527_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2527_Start4" name="Customer inquiry about solar installation at store or via ecommerce">
        <bpmn:outgoing>W2527_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2527_Task5" name="Sales Associate conducts needs assessment: customer monthly electricity bill…">
        <bpmn:documentation>Step 1: Sales Associate conducts needs assessment: customer monthly electricity bill (kWh), roof type and orientation, available roof area, current electrical panel capacity, shading analysis; enters data into ERP solar sizing tool
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 30–45 min</bpmn:documentation>
        <bpmn:incoming>W2527_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2527_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2527_Task6" name="System generates recommended solar system size: calculates panel count…">
        <bpmn:documentation>Step 2: System generates recommended solar system size: calculates panel count, inverter sizing, battery backup requirement; produces estimated ROI (payback period typically 3–5 years in Philippines); generates preliminary quotation
Responsible (R): System / Sales Associate
Accountable (A): Department Supervisor
Duration: 15–20 min</bpmn:documentation>
        <bpmn:incoming>W2527_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2527_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2527_Task7" name="Customer selects configuration; Associate creates sales order with installation…">
        <bpmn:documentation>Step 3: Customer selects configuration; Associate creates sales order with installation option; if installation requested, schedules site survey with certified solar installer partner; captures lead in CRM for follow-up
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 20–30 min</bpmn:documentation>
        <bpmn:incoming>W2527_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2527_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2527_End8" name="Complete">
        <bpmn:incoming>W2527_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2527_Annotation9">
        <bpmn:text>Controls: - CTL-439 (ensure controlled execution — Solar Product Merchandising &amp; Consultation (PA-70.1).) | - operational: site survey verification; operational: fails to deliver promised savings
Owner: Department Supervisor — Electrical</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2527_Assoc10" sourceRef="W2527_Annotation9" targetRef="W2527_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2527_Flow11" sourceRef="W2527_Start4" targetRef="W2527_Task5" />
      <bpmn:sequenceFlow id="W2527_Flow12" sourceRef="W2527_Task5" targetRef="W2527_Task6" />
      <bpmn:sequenceFlow id="W2527_Flow13" sourceRef="W2527_Task6" targetRef="W2527_Task7" />
      <bpmn:sequenceFlow id="W2527_Flow14" sourceRef="W2527_Task7" targetRef="W2527_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2527_diag">
      <bpmndi:BPMNPlane id="W2527_plane" bpmnElement="W_W2527">
        <bpmndi:BPMNShape id="W2527_Lane1_di" bpmnElement="W2527_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2527_Lane2_di" bpmnElement="W2527_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
