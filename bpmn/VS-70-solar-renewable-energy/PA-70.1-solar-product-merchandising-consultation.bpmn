    <bpmn:process id="W_W2529" name="W2529. Solar Product Pricing &amp; Net Metering ROI Calculator" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly pricing review or Meralco/DU rate change
Frequency: Monthly
Volume: ~200–300 solar SKUs
Owner: Pricing Analyst
Participants: Pricing Analyst, Category Manager, Finance
Source: workflow W2529 — Solar Product Pricing &amp; Net Metering ROI Calculator</bpmn:documentation>
      <bpmn:laneSet id="W2529_LaneSet2">
        <bpmn:lane id="W2529_Lane1" name="Pricing Analyst">
        <bpmn:flowNodeRef>W2529_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2529_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2529_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2529_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2529_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2529_Start3" name="Monthly pricing review or Meralco/DU rate change">
        <bpmn:outgoing>W2529_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2529_Task4" name="Pricing Analyst updates ROI calculator parameters: current utility rates per DU…">
        <bpmn:documentation>Step 1: Pricing Analyst updates ROI calculator parameters: current utility rates per DU (Meralco, Davao Light, VECO, etc.), ERC-approved net metering rates, average solar irradiance per region (5–5.5 kWh/m²/day in Philippines), panel degradation rate (0.5%/year), system cost trends
Responsible (R): Pricing Analyst
Accountable (A): Category Manager
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W2529_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2529_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2529_Task5" name="Analyst reviews solar product pricing vs. competitors and online market…">
        <bpmn:documentation>Step 2: Analyst reviews solar product pricing vs. competitors and online market; adjusts pricing to maintain target margin while ensuring ROI calculator shows &lt;5 year payback for standard systems; flags SKUs where cost increase threatens payback threshold
Responsible (R): Pricing Analyst
Accountable (A): VP Merchandising
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2529_Flow11</bpmn:incoming>
