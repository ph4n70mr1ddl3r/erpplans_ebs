        <bpmn:outgoing>W5141_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5141_Task4" name="Submit application for Land Reclassification to the Municipal/City Planning and…">
        <bpmn:documentation>Step 1: Submit application for Land Reclassification to the Municipal/City Planning and Development Office.
Responsible (R): Regulatory Compliance Officer / Land Liaison Officer
Accountable (A): Regulatory Compliance Officer / Land Liaison Officer
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5141_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5141_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5141_Task5" name="Provide documentation: land title, DAR certification, environmental clearance…">
        <bpmn:documentation>Step 2: Provide documentation: land title, DAR certification, environmental clearance, and site plan.
Responsible (R): Regulatory Compliance Officer / Land Liaison Officer
Accountable (A): Regulatory Compliance Officer / Land Liaison Officer
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5141_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5141_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5141_Task6" name="Attend public hearings at the Sanggunian Bayan/Panglungsod Committee on Housing…">
        <bpmn:documentation>Step 3: Attend public hearings at the Sanggunian Bayan/Panglungsod Committee on Housing and Land Use; present justification for the retail development (jobs, tax revenues, convenient hardware sourcing).
Responsible (R): Regulatory Compliance Officer / Land Liaison Officer
Accountable (A): Regulatory Compliance Officer / Land Liaison Officer
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5141_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5141_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5141_Task7" name="Secure the Sanggunian Ordinance reclassifying the land from agricultural to…">
        <bpmn:documentation>Step 4: Secure the Sanggunian Ordinance reclassifying the land from agricultural to commercial use.
Responsible (R): Regulatory Compliance Officer / Land Liaison Officer
Accountable (A): Regulatory Compliance Officer / Land Liaison Officer
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5141_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5141_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5141_End8" name="Complete">
        <bpmn:incoming>W5141_Flow15</bpmn:incoming>
      </bpmn:endEvent>
