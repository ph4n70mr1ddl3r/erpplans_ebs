    <bpmn:process id="W_W5143" name="W5143. Tenant Farmer Compensation, Settlement &amp; Relocation Governance" isExecutable="false">
      <bpmn:documentation>Trigger: DAR clearance/conversion process identifying registered or actual tenant farmers on target land
Frequency: Event-driven per site settlement
Volume: ~3–5 settlements annually
Owner: Land Acquisition Manager / HR Specialist
Participants: Tenant farmers, DAR Municipal Agrarian Reform Officer (MARO), Legal (VS-100), CSR Foundation (VS-152)
Source: workflow W5143 — Tenant Farmer Compensation, Settlement &amp; Relocation Governance</bpmn:documentation>
      <bpmn:laneSet id="W5143_LaneSet2">
        <bpmn:lane id="W5143_Lane1" name="Land Acquisition Manager">
        <bpmn:flowNodeRef>W5143_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5143_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5143_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5143_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5143_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5143_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5143_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5143_Start3" name="DAR clearance/conversion process identifying registered or actual tenant farmers on…">
        <bpmn:outgoing>W5143_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5143_Task4" name="Conduct census of all actual occupants, tenants, and farmworkers on the target…">
        <bpmn:documentation>Step 1: Conduct census of all actual occupants, tenants, and farmworkers on the target property.
Responsible (R): Land Acquisition Manager / HR Specialist
Accountable (A): Land Acquisition Manager / HR Specialist
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5143_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5143_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5143_Task5" name="Negotiate tenant disturbance compensation package (under RA 3844 rules) and…">
        <bpmn:documentation>Step 2: Negotiate tenant disturbance compensation package (under RA 3844 rules) and voluntary surrender of land tenancy rights.
Responsible (R): Land Acquisition Manager / HR Specialist
Accountable (A): Land Acquisition Manager / HR Specialist
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5143_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5143_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5143_Task6" name="Draft Disturbance Compensation Agreements and secure MARO validation and…">
        <bpmn:documentation>Step 3: Draft Disturbance Compensation Agreements and secure MARO validation and notarization.
Responsible (R): Land Acquisition Manager / HR Specialist
Accountable (A): Land Acquisition Manager / HR Specialist
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5143_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5143_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5143_Task7" name="Provide relocation assistance, job retraining programs, and priority employment…">
        <bpmn:documentation>Step 4: Provide relocation assistance, job retraining programs, and priority employment lists for tenant family members at the new BuildRight store.
Responsible (R): Land Acquisition Manager / HR Specialist
Accountable (A): Land Acquisition Manager / HR Specialist
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5143_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5143_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5143_Task8" name="Disburse settlement payments through audited checks and file quitclaims with…">
        <bpmn:documentation>Step 5: Disburse settlement payments through audited checks and file quitclaims with the DAR.
Responsible (R): Land Acquisition Manager / HR Specialist
Accountable (A): Land Acquisition Manager / HR Specialist
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5143_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5143_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5143_End9" name="Complete">
        <bpmn:incoming>W5143_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5143_Annotation10">
        <bpmn:text>Controls: - CTL-765 (ensure controlled execution — Agrarian Reform, NCIP Ancestral Domain &amp; Land Use Conversion Operations (PA-178.2).) | - CTL-765: Quitclaims signed by 100% of identified tenants; MARO representative witness signatures secured; payment disbursements audited.
Owner: Land Acquisition Manager / HR Specialist</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5143_Assoc11" sourceRef="W5143_Annotation10" targetRef="W5143_Start3" associationDirection="None" />
