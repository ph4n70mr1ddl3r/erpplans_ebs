    <bpmn:process id="W_W5139" name="W5139. Free, Prior, and Informed Consent (FPIC) Assessment &amp; Tribal Council Negotiation" isExecutable="false">
      <bpmn:documentation>Trigger: NCIP verification (W5138) showing ancestral domain overlap/contiguity and project proceeding via long-term lease
Frequency: Event-driven per IP lease transaction
Volume: ~1–2 complex negotiations annually
Owner: Director, Facilities &amp; Real Estate / CSR Manager
Participants: Indigenous Cultural Community (ICC) Tribal Council, NCIP Elders, CSR Foundation (VS-152), Legal
Source: workflow W5139 — Free, Prior, and Informed Consent (FPIC) Assessment &amp; Tribal Council Negotiation</bpmn:documentation>
      <bpmn:laneSet id="W5139_LaneSet2">
        <bpmn:lane id="W5139_Lane1" name="Director, Facilities &amp; Real Estate">
        <bpmn:flowNodeRef>W5139_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5139_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5139_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5139_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5139_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5139_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5139_Start3" name="NCIP verification (W5138) showing ancestral domain overlap/contiguity and project…">
        <bpmn:outgoing>W5139_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5139_Task4" name="Initiate formal NCIP FPIC process: request NCIP field team to conduct…">
        <bpmn:documentation>Step 1: Initiate formal NCIP FPIC process: request NCIP field team to conduct Field-Based Investigation (FBI).
Responsible (R): Director, Facilities &amp; Real Estate / CSR Manager
Accountable (A): Director, Facilities &amp; Real Estate / CSR Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5139_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5139_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5139_Task5" name="Participate in Community Consultative Assemblies: present BuildRight store…">
        <bpmn:documentation>Step 2: Participate in Community Consultative Assemblies: present BuildRight store proposal, economic benefits, jobs, and environmental safeguards to tribal members.
Responsible (R): Director, Facilities &amp; Real Estate / CSR Manager
Accountable (A): Director, Facilities &amp; Real Estate / CSR Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5139_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5139_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5139_Task6" name="Negotiate Memorandum of Agreement (MOA) detailing lease rentals, royalty…">
        <bpmn:documentation>Step 3: Negotiate Memorandum of Agreement (MOA) detailing lease rentals, royalty sharing, tribal employment quotas, and CSR community investments (VS-152).
Responsible (R): Director, Facilities &amp; Real Estate / CSR Manager
Accountable (A): Director, Facilities &amp; Real Estate / CSR Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5139_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5139_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5139_Task7" name="Secure NCIP En Banc approval of the MOA and issuance of the Certification…">
        <bpmn:documentation>Step 4: Secure NCIP En Banc approval of the MOA and issuance of the Certification Precondition (CP).
Responsible (R): Director, Facilities &amp; Real Estate / CSR Manager
Accountable (A): Director, Facilities &amp; Real Estate / CSR Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5139_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5139_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5139_End8" name="Complete">
        <bpmn:incoming>W5139_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5139_Annotation9">
        <bpmn:text>Controls: - CTL-765 (ensure controlled execution — Agrarian Reform, NCIP Ancestral Domain &amp; Land Use Conversion Operations (PA-178.2).) | - CTL-765: Certification Precondition issued by NCIP En Banc; MOA signed by Tribal Council, NCIP Chairperson, and BuildRight CEO.
Owner: Director, Facilities &amp; Real Estate / CSR Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5139_Assoc10" sourceRef="W5139_Annotation9" targetRef="W5139_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W5139_Flow11" sourceRef="W5139_Start3" targetRef="W5139_Task4" />
      <bpmn:sequenceFlow id="W5139_Flow12" sourceRef="W5139_Task4" targetRef="W5139_Task5" />
      <bpmn:sequenceFlow id="W5139_Flow13" sourceRef="W5139_Task5" targetRef="W5139_Task6" />
      <bpmn:sequenceFlow id="W5139_Flow14" sourceRef="W5139_Task6" targetRef="W5139_Task7" />
      <bpmn:sequenceFlow id="W5139_Flow15" sourceRef="W5139_Task7" targetRef="W5139_End8" />
    </bpmn:process>
