    <bpmn:process id="W_W5144" name="W5144. DENR Environmental Compliance Certificate (ECC) / CNC Application for New Sites" isExecutable="false">
      <bpmn:documentation>Trigger: Zoning clearance (W5141) and engineering assessment indicating construction footprint requires environmental clearance
Frequency: Per new store construction
Volume: 10–15 applications annually
Owner: Director of Construction PMO / Environmental Consultant
Participants: DENR Environmental Management Bureau (EMB), Environmental Compliance Officer (VS-25)
Source: workflow W5144 — DENR Environmental Compliance Certificate (ECC) / CNC Application for New Sites</bpmn:documentation>
      <bpmn:laneSet id="W5144_LaneSet2">
        <bpmn:lane id="W5144_Lane1" name="Director of Construction PMO">
        <bpmn:flowNodeRef>W5144_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5144_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5144_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5144_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5144_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5144_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5144_Start3" name="Zoning clearance (W5141) and engineering assessment indicating construction footprint…">
        <bpmn:outgoing>W5144_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5144_Task4" name="Prepare Environmental Impact Assessment (EIA) or Initial Environmental…">
        <bpmn:documentation>Step 1: Prepare Environmental Impact Assessment (EIA) or Initial Environmental Examination (IEE) Checklist for the proposed store size and location.
Responsible (R): Director of Construction PMO / Environmental Consultant
Accountable (A): Director of Construction PMO / Environmental Consultant
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5144_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5144_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5144_Task5" name="Submit ECC or CNC (Certificate of Non-Coverage) application on the DENR-EMB…">
        <bpmn:documentation>Step 2: Submit ECC or CNC (Certificate of Non-Coverage) application on the DENR-EMB online portal.
Responsible (R): Director of Construction PMO / Environmental Consultant
Accountable (A): Director of Construction PMO / Environmental Consultant
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5144_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5144_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5144_Task6" name="Address EMB questions, submit engineering plans for sewage treatment plants…">
        <bpmn:documentation>Step 3: Address EMB questions, submit engineering plans for sewage treatment plants (STP), drainage, and waste storage.
Responsible (R): Director of Construction PMO / Environmental Consultant
Accountable (A): Director of Construction PMO / Environmental Consultant
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5144_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5144_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5144_Task7" name="Secure signed Environmental Compliance Certificate (ECC) containing development…">
        <bpmn:documentation>Step 4: Secure signed Environmental Compliance Certificate (ECC) containing development conditions; assign conditions to Construction PMO (VS-112) and store operations (VS-25).
Responsible (R): Director of Construction PMO / Environmental Consultant
Accountable (A): Director of Construction PMO / Environmental Consultant
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5144_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5144_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5144_End8" name="Complete">
        <bpmn:incoming>W5144_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5144_Annotation9">
        <bpmn:text>Controls: - CTL-765 (ensure controlled execution — Agrarian Reform, NCIP Ancestral Domain &amp; Land Use Conversion Operations (PA-178.2).) | - CTL-765: ECC issued before groundbreaking permit application; annual compliance reports filed as required by DENR.
Owner: Director of Construction PMO / Environmental Consultant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5144_Assoc10" sourceRef="W5144_Annotation9" targetRef="W5144_Start3" associationDirection="None" />
