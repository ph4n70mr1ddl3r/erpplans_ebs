    <bpmn:process id="W_W5137" name="W5137. Department of Agrarian Reform (DAR) Clearance &amp; Exemption Application" isExecutable="false">
      <bpmn:documentation>Trigger: Title search (W5130) showing CARP/agrarian patents or agrarian reform land cover
Frequency: Event-driven per transaction
Volume: ~5–8 clearances annually
Owner: Land Acquisition Manager / Regulatory Compliance Officer
Participants: Department of Agrarian Reform (DAR) Municipal/Provincial offices, Seller
Source: workflow W5137 — Department of Agrarian Reform (DAR) Clearance &amp; Exemption Application</bpmn:documentation>
      <bpmn:laneSet id="W5137_LaneSet2">
        <bpmn:lane id="W5137_Lane1" name="Land Acquisition Manager">
        <bpmn:flowNodeRef>W5137_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5137_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5137_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5137_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5137_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5137_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5137_Start3" name="Title search (W5130) showing CARP/agrarian patents or agrarian reform land cover">
        <bpmn:outgoing>W5137_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5137_Task4" name="Conduct verification at the provincial DAR office to check if the land is…">
        <bpmn:documentation>Step 1: Conduct verification at the provincial DAR office to check if the land is subject to Comprehensive Agrarian Reform Program (CARP) coverage or land retention limits.
Responsible (R): Land Acquisition Manager / Regulatory Compliance Officer
Accountable (A): Land Acquisition Manager / Regulatory Compliance Officer
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5137_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5137_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5137_Task5" name="File application for DAR Clearance (for private agricultural lands) or…">
        <bpmn:documentation>Step 2: File application for DAR Clearance (for private agricultural lands) or Exemption Clearance (for lands reclassified prior to June 15, 1988).
Responsible (R): Land Acquisition Manager / Regulatory Compliance Officer
Accountable (A): Land Acquisition Manager / Regulatory Compliance Officer
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5137_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5137_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5137_Task6" name="Coordinate provincial DAR inspection to verify no tenant farmers, active…">
        <bpmn:documentation>Step 3: Coordinate provincial DAR inspection to verify no tenant farmers, active cultivation, or CARP coverage violations exist.
Responsible (R): Land Acquisition Manager / Regulatory Compliance Officer
Accountable (A): Land Acquisition Manager / Regulatory Compliance Officer
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5137_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5137_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5137_Task7" name="Secure the formal DAR Clearance Certificate / Exemption Order and file in the…">
        <bpmn:documentation>Step 4: Secure the formal DAR Clearance Certificate / Exemption Order and file in the transaction folder.
Responsible (R): Land Acquisition Manager / Regulatory Compliance Officer
Accountable (A): Land Acquisition Manager / Regulatory Compliance Officer
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5137_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5137_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5137_End8" name="Complete">
        <bpmn:incoming>W5137_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5137_Annotation9">
        <bpmn:text>Controls: - CTL-765 (ensure controlled execution — Agrarian Reform, NCIP Ancestral Domain &amp; Land Use Conversion Operations (PA-178.2).) | - CTL-765: Exemption Order signed by DAR Regional Director or Secretary; verified by Legal before escrow funds release.
Owner: Land Acquisition Manager / Regulatory Compliance Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5137_Assoc10" sourceRef="W5137_Annotation9" targetRef="W5137_Start3" associationDirection="None" />
