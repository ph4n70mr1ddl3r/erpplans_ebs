    <bpmn:process id="W_W5138" name="W5138. National Commission on Indigenous Peoples (NCIP) Ancestral Domain Verification" isExecutable="false">
      <bpmn:documentation>Trigger: Approved suitability report (W5129) in regions with high IP density (Mindanao, Northern Luzon)
Frequency: Per site candidate in targeted regions
Volume: ~10–12 verifications annually
Owner: Regulatory Compliance Officer / Land Liaison Officer
Participants: NCIP Provincial Office, Local Ancestral Domain Office, Legal (VS-100)
Source: workflow W5138 — National Commission on Indigenous Peoples (NCIP) Ancestral Domain Verification</bpmn:documentation>
      <bpmn:laneSet id="W5138_LaneSet2">
        <bpmn:lane id="W5138_Lane1" name="Regulatory Compliance Officer">
        <bpmn:flowNodeRef>W5138_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5138_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5138_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5138_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5138_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5138_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5138_Start3" name="Approved suitability report (W5129) in regions with high IP density (Mindanao, Northern…">
        <bpmn:outgoing>W5138_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5138_Task4" name="Submit site coordinates and cadastral maps to the NCIP Provincial Office to…">
        <bpmn:documentation>Step 1: Submit site coordinates and cadastral maps to the NCIP Provincial Office to request Ancestral Domain Verification.
Responsible (R): Regulatory Compliance Officer / Land Liaison Officer
Accountable (A): Regulatory Compliance Officer / Land Liaison Officer
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5138_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5138_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5138_Task5" name="Search NCIP records for Certificate of Ancestral Domain Title (CADT) or…">
        <bpmn:documentation>Step 2: Search NCIP records for Certificate of Ancestral Domain Title (CADT) or Certificate of Ancestral Land Title (CALT) overlays on candidate coordinates.
Responsible (R): Regulatory Compliance Officer / Land Liaison Officer
Accountable (A): Regulatory Compliance Officer / Land Liaison Officer
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5138_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5138_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5138_Task6" name="Obtain official NCIP Geographic Information System (GIS) mapping clearance…">
        <bpmn:documentation>Step 3: Obtain official NCIP Geographic Information System (GIS) mapping clearance report.
Responsible (R): Regulatory Compliance Officer / Land Liaison Officer
Accountable (A): Regulatory Compliance Officer / Land Liaison Officer
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5138_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5138_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5138_Task7" name="Secure NCIP initial assessment indicating if the site falls inside, adjacent…">
        <bpmn:documentation>Step 4: Secure NCIP initial assessment indicating if the site falls inside, adjacent to, or outside ancestral domains.
Responsible (R): Regulatory Compliance Officer / Land Liaison Officer
Accountable (A): Regulatory Compliance Officer / Land Liaison Officer
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5138_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5138_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5138_End8" name="Complete">
        <bpmn:incoming>W5138_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5138_Annotation9">
        <bpmn:text>Controls: - CTL-141 (ensure land title &amp; acquisition due diligence.) | - CTL-765: Official NCIP mapping clearance report signed by NCIP Regional Director; documented in site feasibility files.
Owner: Regulatory Compliance Officer / Land Liaison Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5138_Assoc10" sourceRef="W5138_Annotation9" targetRef="W5138_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W5138_Flow11" sourceRef="W5138_Start3" targetRef="W5138_Task4" />
      <bpmn:sequenceFlow id="W5138_Flow12" sourceRef="W5138_Task4" targetRef="W5138_Task5" />
