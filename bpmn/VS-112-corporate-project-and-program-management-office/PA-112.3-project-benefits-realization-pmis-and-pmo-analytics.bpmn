      <bpmn:sequenceFlow id="W3562_Flow13" sourceRef="W3562_Task6" targetRef="W3562_Task7" />
      <bpmn:sequenceFlow id="W3562_Flow14" sourceRef="W3562_Task7" targetRef="W3562_End8" />
    </bpmn:process>
