        <bpmndi:BPMNShape id="W308_Task8_di" bpmnElement="W308_Task8"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W308_Task9_di" bpmnElement="W308_Task9"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
