        <bpmndi:BPMNShape id="W292_End13_di" bpmnElement="W292_End13"><dc:Bounds x="1890" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W292_Annotation14_di" bpmnElement="W292_Annotation14"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W292_Flow16_di" bpmnElement="W292_Flow16"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W292_Flow17_di" bpmnElement="W292_Flow17"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W292_Flow18_di" bpmnElement="W292_Flow18"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W292_Flow19_di" bpmnElement="W292_Flow19"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W292_Flow20_di" bpmnElement="W292_Flow20"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W292_Flow21_di" bpmnElement="W292_Flow21"><di:waypoint x="1420" y="335" /><di:waypoint x="1450" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W292_Flow22_di" bpmnElement="W292_Flow22"><di:waypoint x="1630" y="335" /><di:waypoint x="1660" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W292_Flow23_di" bpmnElement="W292_Flow23"><di:waypoint x="1840" y="505" /><di:waypoint x="1890" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W292_Assoc15_di" bpmnElement="W292_Assoc15"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W296" name="W296. Service &amp; Non-Stock Item Master Governance" isExecutable="false">
      <bpmn:documentation>Trigger: Creation of a new service offering, modification of service pricing, or addition of a non-stock/special-order item template
Frequency: ~5–10 new service items/month; ~20–30 non-stock templates/month
Volume: ~200 active service items; ~500 non-stock item templates; growing with service expansion
Owner: Master Data Manager
Participants: Services Manager, Category Manager, Pricing Analyst, Master Data Analyst
Source: workflow W296 — Service &amp; Non-Stock Item Master Governance</bpmn:documentation>
      <bpmn:laneSet id="W296_LaneSet5">
        <bpmn:lane id="W296_Lane1" name="Services Manager">
        <bpmn:flowNodeRef>W296_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W296_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W296_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W296_Lane2" name="Pricing Analyst">
        <bpmn:flowNodeRef>W296_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W296_Lane3" name="Master Data Analyst">
        <bpmn:flowNodeRef>W296_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W296_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W296_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W296_Lane4" name="Master Data Manager">
        <bpmn:flowNodeRef>W296_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W296_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W296_Start6" name="Creation of a new service offering, modification of service pricing, or addition of a…">
        <bpmn:outgoing>W296_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W296_Task7" name="Service Item Request">
        <bpmn:documentation>Step 1: Service Item Request: Services Manager or Category Manager requests creation of a new service item (e.g., &quot;Aircon Installation — Split Type 1.5HP&quot;, &quot;Bathroom Tile Laying — per sqm&quot;, &quot;3D Kitchen Design Rendering — Standard&quot;). Request specifies: service type (installation, rental, custom processing, consultancy, subscription), pricing model (fixed price, per-unit, hourly, tiered), and linked merchandise SKUs (if applicable, e.g., installation linked to appliance SKU).
Responsible (R): Services Manager / Category Manager
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W296_Flow17</bpmn:incoming>
        <bpmn:outgoing>W296_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W296_Task8" name="Pricing &amp; Margin Review">
        <bpmn:documentation>Step 2: Pricing &amp; Margin Review: Pricing Analyst reviews the proposed service pricing against cost inputs (labor rate, material cost, subcontractor rate, overhead allocation). System calculates the service margin and flags items below the target service margin threshold.
Responsible (R): Pricing Analyst
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W296_Flow18</bpmn:incoming>
        <bpmn:outgoing>W296_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W296_Task9" name="Attribute Configuration">
        <bpmn:documentation>Step 3: Attribute Configuration: Master Data Analyst configures service-specific attributes in the ERP: service duration estimate, scheduling rules, required certifications (e.g., licensed electrician for electrical installation), subcontractor assignment, warranty coverage, and revenue recognition method (point-in-time vs. over-time per PFRS 15).
Responsible (R): Master Data Analyst
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W296_Flow19</bpmn:incoming>
        <bpmn:outgoing>W296_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W296_Task10" name="Non-Stock Item Template Creation">
        <bpmn:documentation>Step 4: Non-Stock Item Template Creation: For non-stock/special-order items (W38), Master Data Analyst creates item templates with: default vendor assignment, estimated lead time, special order flag (no inventory held), and auto-PO generation rules. Templates allow rapid creation of specific non-stock items against customer special orders while maintaining data consistency.
Responsible (R): Master Data Analyst
Accountable (A): Master Data Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W296_Flow20</bpmn:incoming>
        <bpmn:outgoing>W296_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W296_Task11" name="POS &amp; Channel Integration">
        <bpmn:documentation>Step 5: POS &amp; Channel Integration: Service items are linked to POS quick-keys for in-store selling (W5B), ecommerce service booking pages, and the trade counter/pro desk (W112). Custom processing items (paint mixing W168, lumber cutting W169) are linked to the relevant POS workflow triggers.
Responsible (R): Master Data Analyst
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W296_Flow21</bpmn:incoming>
        <bpmn:outgoing>W296_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W296_Task12" name="Approval &amp; Activation">
        <bpmn:documentation>Step 6: Approval &amp; Activation: Master Data Manager reviews the complete service/non-stock item setup, verifies all mandatory attributes are populated, and activates the item. System generates a cross-reference linking the service item to any related merchandise items for bundle/cross-sell reporting.
Responsible (R): Master Data Manager
Accountable (A): Master Data Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W296_Flow22</bpmn:incoming>
        <bpmn:outgoing>W296_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W296_Task13" name="Periodic Service Catalog Review">
        <bpmn:documentation>Step 7: Periodic Service Catalog Review: Quarterly, Services Manager and Master Data Manager review the active service catalog. Obsolete services (zero transactions in 6 months) are flagged for deactivation. Pricing is compared against subcontractor rate changes and competitor service pricing (W130).
Responsible (R): Services Manager / Master Data Manager
Accountable (A): COO
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W296_Flow23</bpmn:incoming>
        <bpmn:outgoing>W296_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W296_End14" name="Complete">
        <bpmn:incoming>W296_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W296_Annotation15">
        <bpmn:text>Controls: - CTL-328 (ensure controlled execution — Foundational Masters (PA-29.1).) | - operational: Master Data Manager review and approval gate
Owner: Master Data Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W296_Assoc16" sourceRef="W296_Annotation15" targetRef="W296_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W296_Flow17" sourceRef="W296_Start6" targetRef="W296_Task7" />
      <bpmn:sequenceFlow id="W296_Flow18" sourceRef="W296_Task7" targetRef="W296_Task8" />
      <bpmn:sequenceFlow id="W296_Flow19" sourceRef="W296_Task8" targetRef="W296_Task9" />
      <bpmn:sequenceFlow id="W296_Flow20" sourceRef="W296_Task9" targetRef="W296_Task10" />
      <bpmn:sequenceFlow id="W296_Flow21" sourceRef="W296_Task10" targetRef="W296_Task11" />
      <bpmn:sequenceFlow id="W296_Flow22" sourceRef="W296_Task11" targetRef="W296_Task12" />
      <bpmn:sequenceFlow id="W296_Flow23" sourceRef="W296_Task12" targetRef="W296_Task13" />
      <bpmn:sequenceFlow id="W296_Flow24" sourceRef="W296_Task13" targetRef="W296_End14" />
    </bpmn:process>
