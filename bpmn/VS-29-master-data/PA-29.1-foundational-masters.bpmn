        <bpmndi:BPMNShape id="W252_Lane5_di" bpmnElement="W252_Lane5" isHorizontal="true"><dc:Bounds x="160" y="760" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W252_Lane6_di" bpmnElement="W252_Lane6" isHorizontal="true"><dc:Bounds x="160" y="930" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W252_Task9_di" bpmnElement="W252_Task9"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W252_Task10_di" bpmnElement="W252_Task10"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W252_Task11_di" bpmnElement="W252_Task11"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W252_Task12_di" bpmnElement="W252_Task12"><dc:Bounds x="1030" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W252_Task13_di" bpmnElement="W252_Task13"><dc:Bounds x="1240" y="805" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W252_Task14_di" bpmnElement="W252_Task14"><dc:Bounds x="1450" y="975" width="180" height="80" /></bpmndi:BPMNShape>
