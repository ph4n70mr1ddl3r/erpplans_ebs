      <bpmn:sequenceFlow id="W310_Flow18" sourceRef="W310_Task7" targetRef="W310_Task8" />
      <bpmn:sequenceFlow id="W310_Flow19" sourceRef="W310_Task8" targetRef="W310_Task9" />
      <bpmn:sequenceFlow id="W310_Flow20" sourceRef="W310_Task9" targetRef="W310_Task10" />
      <bpmn:sequenceFlow id="W310_Flow21" sourceRef="W310_Task10" targetRef="W310_Task11" />
      <bpmn:sequenceFlow id="W310_Flow22" sourceRef="W310_Task11" targetRef="W310_Task12" />
      <bpmn:sequenceFlow id="W310_Flow23" sourceRef="W310_Task12" targetRef="W310_End13" />
    </bpmn:process>
