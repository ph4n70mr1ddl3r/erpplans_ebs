    <bpmn:process id="W_W404" name="W404. Point-of-Sale (POS) System &amp; Hardware Master Governance" isExecutable="false">
      <bpmn:documentation>Trigger: Deployment of a new POS terminal, self-checkout kiosk, or updates to receipt templates and macro keys
Frequency: Weekly (for new registers or layout changes)
Volume: ~600 POS terminals across 200 stores
Owner: IT Store Operations Manager
Participants: Store Manager, Finance Controller, IT ERP Administrator
Source: workflow W404 — Point-of-Sale (POS) System &amp; Hardware Master Governance</bpmn:documentation>
      <bpmn:laneSet id="W404_LaneSet5">
        <bpmn:lane id="W404_Lane1" name="IT Store Ops Mgr">
        <bpmn:flowNodeRef>W404_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W404_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
