        <bpmndi:BPMNEdge id="W252_Flow19_di" bpmnElement="W252_Flow19"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W252_Flow20_di" bpmnElement="W252_Flow20"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W252_Flow21_di" bpmnElement="W252_Flow21"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W252_Flow22_di" bpmnElement="W252_Flow22"><di:waypoint x="1210" y="675" /><di:waypoint x="1240" y="845" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W252_Flow23_di" bpmnElement="W252_Flow23"><di:waypoint x="1420" y="845" /><di:waypoint x="1450" y="1015" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W252_Flow24_di" bpmnElement="W252_Flow24"><di:waypoint x="1630" y="1015" /><di:waypoint x="1680" y="1015" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W252_Assoc17_di" bpmnElement="W252_Assoc17"><di:waypoint x="340" y="1140" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W253" name="W253. Customer Master Data Governance &amp; Deduplication" isExecutable="false">
      <bpmn:documentation>Trigger: Ongoing customer data ingestion from POS loyalty sign-ups, Ecommerce registrations, and B2B Trade Account creations
Frequency: Continuous automated ingestion; Monthly manual deduplication review
Volume: ~4,500 new loyalty enrollments/month (the data-volumes §1.1 customer-registration anchor; loyalty sign-ups are its bulk); deduplication batch matching runs daily (per Step 2)
Owner: CRM Data Steward
Participants: Store Cashier, B2B Sales Rep, Customer Service Rep, CRM Data Steward
Source: workflow W253 — Customer Master Data Governance &amp; Deduplication</bpmn:documentation>
      <bpmn:laneSet id="W253_LaneSet4">
        <bpmn:lane id="W253_Lane1" name="Store Cashier">
        <bpmn:flowNodeRef>W253_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W253_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W253_Lane2" name="System">
        <bpmn:flowNodeRef>W253_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W253_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W253_Lane3" name="CRM Data Steward">
        <bpmn:flowNodeRef>W253_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W253_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W253_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W253_Start5" name="Ongoing customer data ingestion from POS loyalty sign-ups, Ecommerce registrations, and…">
        <bpmn:outgoing>W253_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W253_Task6" name="Data Ingestion &amp; Verification">
        <bpmn:documentation>Step 1: Data Ingestion &amp; Verification: Customer data is captured at POS (phone number lookup/creation), Ecommerce, or B2B Portal. System mandates real-time One-Time Password (OTP) verification for mobile numbers to prevent dummy account creation and immediate duplicates.
Responsible (R): Store Cashier / Customer
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W253_Flow14</bpmn:incoming>
        <bpmn:outgoing>W253_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W253_Task7" name="Automated Matching">
        <bpmn:documentation>Step 2: Automated Matching: ERP/CDP runs daily batch matching algorithms (Levenshtein distance on names, exact match on email/mobile) to flag potential duplicate profiles
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W253_Flow15</bpmn:incoming>
        <bpmn:outgoing>W253_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W253_Task8" name="Exception Management">
        <bpmn:documentation>Step 3: Exception Management: CRM Data Steward reviews the &quot;Potential Duplicates&quot; queue
Responsible (R): CRM Data Steward
Accountable (A): —
Duration: 15 min/batch</bpmn:documentation>
        <bpmn:incoming>W253_Flow16</bpmn:incoming>
        <bpmn:outgoing>W253_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W253_Task9" name="Merge &amp; Consolidate">
        <bpmn:documentation>Step 4: Merge &amp; Consolidate: Steward executes a merge. System consolidates loyalty points, purchase history, and contact details into the surviving &quot;Golden Record&quot;, and leaves a tombstone on the deprecated record
Responsible (R): CRM Data Steward
Accountable (A): CRM Data Steward
Duration: 10 min/merge</bpmn:documentation>
        <bpmn:incoming>W253_Flow17</bpmn:incoming>
        <bpmn:outgoing>W253_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W253_Task10" name="Downstream Sync">
        <bpmn:documentation>Step 5: Downstream Sync: The Golden Record updates are pushed to Ecommerce, POS offline databases, and Marketing Automation tools
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W253_Flow18</bpmn:incoming>
        <bpmn:outgoing>W253_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W253_End11" name="Complete">
        <bpmn:incoming>W253_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W253_Annotation12">
        <bpmn:text>Controls: - CTL-328 (ensure controlled execution — Foundational Masters (PA-29.1).) | - operational: CRM Data Steward review and approval gate
Owner: CRM Data Steward</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W253_Assoc13" sourceRef="W253_Annotation12" targetRef="W253_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W253_Flow14" sourceRef="W253_Start5" targetRef="W253_Task6" />
      <bpmn:sequenceFlow id="W253_Flow15" sourceRef="W253_Task6" targetRef="W253_Task7" />
      <bpmn:sequenceFlow id="W253_Flow16" sourceRef="W253_Task7" targetRef="W253_Task8" />
      <bpmn:sequenceFlow id="W253_Flow17" sourceRef="W253_Task8" targetRef="W253_Task9" />
      <bpmn:sequenceFlow id="W253_Flow18" sourceRef="W253_Task9" targetRef="W253_Task10" />
      <bpmn:sequenceFlow id="W253_Flow19" sourceRef="W253_Task10" targetRef="W253_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W253_diag">
      <bpmndi:BPMNPlane id="W253_plane" bpmnElement="W_W253">
        <bpmndi:BPMNShape id="W253_Lane1_di" bpmnElement="W253_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W253_Lane2_di" bpmnElement="W253_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W253_Lane3_di" bpmnElement="W253_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W253_Task6_di" bpmnElement="W253_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W253_Task7_di" bpmnElement="W253_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W253_Task8_di" bpmnElement="W253_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W253_Task9_di" bpmnElement="W253_Task9"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W253_Task10_di" bpmnElement="W253_Task10"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W253_Start5_di" bpmnElement="W253_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W253_End11_di" bpmnElement="W253_End11"><dc:Bounds x="1470" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W253_Annotation12_di" bpmnElement="W253_Annotation12"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W253_Flow14_di" bpmnElement="W253_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W253_Flow15_di" bpmnElement="W253_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W253_Flow16_di" bpmnElement="W253_Flow16"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W253_Flow17_di" bpmnElement="W253_Flow17"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W253_Flow18_di" bpmnElement="W253_Flow18"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W253_Flow19_di" bpmnElement="W253_Flow19"><di:waypoint x="1420" y="335" /><di:waypoint x="1470" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W253_Assoc13_di" bpmnElement="W253_Assoc13"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
