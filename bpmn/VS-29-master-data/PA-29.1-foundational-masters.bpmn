        <bpmn:flowNodeRef>W404_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W404_Start6" name="Deployment of a new POS terminal, self-checkout kiosk, or updates to receipt templates…">
        <bpmn:outgoing>W404_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W404_Task7" name="Terminal Registration">
        <bpmn:documentation>Step 1: Terminal Registration: IT Store Ops Manager provisions a new POS terminal, assigning it a unique Terminal ID, linking it to the Store Location Master (W254), and defining its hardware profile (scanner, receipt printer, cash drawer).
Responsible (R): IT Store Ops Mgr
Accountable (A): IT Store Operations Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W404_Flow14</bpmn:incoming>
        <bpmn:outgoing>W404_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W404_Task8" name="Financial Mapping">
        <bpmn:documentation>Step 2: Financial Mapping: Finance Controller links the Terminal ID to the specific petty cash/till GL account and tax profile for correct VAT/LGU tax printing on receipts.
Responsible (R): Finance Controller
Accountable (A): Finance Controller
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W404_Flow15</bpmn:incoming>
        <bpmn:outgoing>W404_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W404_Task9" name="UI &amp; Macro Key Setup">
        <bpmn:documentation>Step 3: UI &amp; Macro Key Setup: IT ERP Administrator pushes the standard UI profile to the terminal, containing the governed list of quick-keys (e.g., non-barcoded items, service fees, bag fees) ensuring consistency across all stores.
Responsible (R): IT ERP Administrator
Accountable (A): IT Store Operations Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W404_Flow16</bpmn:incoming>
        <bpmn:outgoing>W404_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W404_Task10" name="Offline DB Sync Rule">
        <bpmn:documentation>Step 4: Offline DB Sync Rule: System configures the terminal&#x27;s offline database sync frequency and scope (downloading the Item Master and Pricing Master delta updates daily).
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W404_Flow17</bpmn:incoming>
        <bpmn:outgoing>W404_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W404_End11" name="Complete">
        <bpmn:incoming>W404_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W404_Annotation12">
        <bpmn:text>Controls: - CTL-328 (ensure controlled execution — Foundational Masters (PA-29.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: IT Store Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
