    <bpmn:process id="W_W291" name="W291. Master Data Quality Monitoring &amp; Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly governance review and continuous automated profiling
Frequency: Automated daily profiling; Monthly governance review
Volume: Millions of records scanned daily against rule sets
Owner: Master Data Manager
Participants: Data Stewards (CRM, Vendor, Item), BI Analyst, Master Data Manager
Source: workflow W291 — Master Data Quality Monitoring &amp; Reporting</bpmn:documentation>
      <bpmn:laneSet id="W291_LaneSet4">
        <bpmn:lane id="W291_Lane1" name="System">
        <bpmn:flowNodeRef>W291_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W291_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W291_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W291_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W291_Lane2" name="Data Steward">
        <bpmn:flowNodeRef>W291_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W291_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W291_Lane3" name="Master Data Manager">
        <bpmn:flowNodeRef>W291_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W291_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W291_Start5" name="Monthly governance review and continuous automated profiling">
        <bpmn:outgoing>W291_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W291_Task6" name="Automated Profiling">
        <bpmn:documentation>Step 1: Automated Profiling: System runs daily data quality (DQ) checks against predefined rules (e.g., % of Item Master missing dimensions, % of Customer Master missing email, suspected duplicate rates).
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W291_Flow15</bpmn:incoming>
        <bpmn:outgoing>W291_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W291_Task7" name="Dashboard Generation">
        <bpmn:documentation>Step 2: Dashboard Generation: BI platform aggregates DQ scores into a central MDM Governance Dashboard.
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W291_Flow16</bpmn:incoming>
        <bpmn:outgoing>W291_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W291_Task8" name="Exception Routing">
        <bpmn:documentation>Step 3: Exception Routing: High-priority exceptions (e.g., vendor missing TIN) automatically generate alert tickets routed to the respective Data Steward.
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W291_Flow17</bpmn:incoming>
        <bpmn:outgoing>W291_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W291_Task9" name="Remediation">
        <bpmn:documentation>Step 4: Remediation: Data Stewards execute bulk or single-record corrections based on the alerts.
Responsible (R): Data Steward
Accountable (A): —
Duration: 2 hours/week</bpmn:documentation>
        <bpmn:incoming>W291_Flow18</bpmn:incoming>
        <bpmn:outgoing>W291_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W291_Task10" name="Data Archiving &amp; Lifecycle Review">
        <bpmn:documentation>Step 5: Data Archiving &amp; Lifecycle Review: System identifies obsolete records (e.g., zero transactions in 3 years, discontinued SKUs). Data Steward reviews and approves records for archival/soft-deletion to maintain system performance.
Responsible (R): Data Steward
Accountable (A): Master Data Manager
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W291_Flow19</bpmn:incoming>
        <bpmn:outgoing>W291_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W291_Task11" name="Quarterly Data Governance Council Review">
        <bpmn:documentation>Step 6: Quarterly Data Governance Council Review: Master Data Manager compiles the Enterprise Data Quality Scorecard and presents DQ trends, archiving metrics, and policy changes to the Enterprise Data Governance Council (W474) for ratification.
Responsible (R): Master Data Manager
Accountable (A): DGC Chair
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W291_Flow20</bpmn:incoming>
        <bpmn:outgoing>W291_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W291_End12" name="Complete">
        <bpmn:incoming>W291_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W291_Annotation13">
        <bpmn:text>Controls: - CTL-50 (prevent unauthorized master data changes.); CTL-51 (detect stale or incomplete master data.) | - operational: Master Data Manager review and approval gate on archival/purge runs
Owner: Master Data Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W291_Assoc14" sourceRef="W291_Annotation13" targetRef="W291_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W291_Flow15" sourceRef="W291_Start5" targetRef="W291_Task6" />
      <bpmn:sequenceFlow id="W291_Flow16" sourceRef="W291_Task6" targetRef="W291_Task7" />
      <bpmn:sequenceFlow id="W291_Flow17" sourceRef="W291_Task7" targetRef="W291_Task8" />
      <bpmn:sequenceFlow id="W291_Flow18" sourceRef="W291_Task8" targetRef="W291_Task9" />
      <bpmn:sequenceFlow id="W291_Flow19" sourceRef="W291_Task9" targetRef="W291_Task10" />
      <bpmn:sequenceFlow id="W291_Flow20" sourceRef="W291_Task10" targetRef="W291_Task11" />
      <bpmn:sequenceFlow id="W291_Flow21" sourceRef="W291_Task11" targetRef="W291_End12" />
    </bpmn:process>
