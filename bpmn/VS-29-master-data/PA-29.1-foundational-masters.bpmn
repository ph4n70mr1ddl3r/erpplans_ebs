        <bpmndi:BPMNEdge id="W406_Flow18_di" bpmnElement="W406_Flow18"><di:waypoint x="1210" y="675" /><di:waypoint x="1260" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W406_Assoc13_di" bpmnElement="W406_Assoc13"><di:waypoint x="340" y="800" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1532" name="W1532. Seasonal SKU Lifecycle Master Data Setup, Phase-In/Phase-Out Calendar &amp; Attribute Management" isExecutable="false">
      <bpmn:documentation>Trigger: Merchandise Planning seasonal assortment review (W264); Category Manager identifies SKUs for seasonal phase-in or phase-out
Frequency: Quarterly seasonal transitions (dry/wet/typhoon/holiday); ad-hoc for trend-responsive categories
Volume: ~2,000–4,000 seasonal SKU lifecycle transitions per year (phase-in new seasonal SKUs + phase-out expiring seasonal SKUs)
Owner: Master Data Analyst
Participants: Master Data Analyst, Category Manager, Merchandise Planner, Pricing Analyst, Store Operations
Source: workflow W1532 — Seasonal SKU Lifecycle Master Data Setup, Phase-In/Phase-Out Calendar &amp; Attribute Management</bpmn:documentation>
      <bpmn:laneSet id="W1532_LaneSet4">
        <bpmn:lane id="W1532_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W1532_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1532_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1532_Lane2" name="Master Data Analyst">
        <bpmn:flowNodeRef>W1532_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1532_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1532_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1532_Lane3" name="System">
        <bpmn:flowNodeRef>W1532_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1532_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1532_Start5" name="Merchandise Planning seasonal assortment review (W264); Category Manager identifies SKUs…">
        <bpmn:outgoing>W1532_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1532_Task6" name="Seasonal assortment intake">
        <bpmn:documentation>Step 1: Seasonal assortment intake: (a) Category Manager submits seasonal SKU list to Master Data Analyst: (i) new SKUs to phase in (with vendor, cost, retail price, expected season, target stores), (ii) existing SKUs to extend (with new phase-out date), (iii) existing SKUs to phase out (with final order date, markdown schedule, disposition plan); (b) Merchandise Planner provides seasonal sales forecast per SKU for inventory planning
Responsible (R): Category Manager / Merchandise Planner
Accountable (A): VP Merchandising
Duration: 2–3 days/quarter</bpmn:documentation>
        <bpmn:incoming>W1532_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1532_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1532_Task7" name="New seasonal SKU master data creation">
        <bpmn:documentation>Step 2: New seasonal SKU master data creation: (a) for each new seasonal SKU, Master Data Analyst creates master data record: (i) standard product attributes (SKU, description, category, subcategory, brand, vendor, UOM, dimensions, weight, barcode), (ii) seasonal attributes: season code (DRY, WET, TYPH, HOLIDAY, B2S), phase-in date, peak start date, peak end date, phase-out date, disposition rule (markdown % schedule → donate → destroy), (iii) pricing: regular price, seasonal promotional price (if applicable), markdown trigger dates and percentages, (iv) replenishment parameters: minimum order quantity, lead time, target days of supply by season phase, (v) store listing: which stores carry this SKU (all 200 vs. stores with garden center vs. coastal stores only); (b) Master Data Analyst validates: (i) barcode uniqueness, (ii) price compliance (VAT-inclusive, minimum margin threshold), (iii) seasonal date logic (phase-in &lt; peak start &lt; peak end &lt; phase-out)
Responsible (R): Master Data Analyst
Accountable (A): Master Data Manager
Duration: 15–20 min per SKU</bpmn:documentation>
        <bpmn:incoming>W1532_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1532_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1532_Task8" name="Phase-out SKU master data update">
        <bpmn:documentation>Step 3: Phase-out SKU master data update: (a) for SKUs being phased out, Master Data Analyst updates: (i) phase-out date (final date for store replenishment orders), (ii) markdown schedule (if not already on markdown): trigger date → markdown %, (iii) disposition rule (vendor return, clearance, donate, destroy), (iv) system action: after phase-out date — SKU becomes non-orderable but remains searchable for historical transactions; (b) coordinates with Merchandise Planner on remaining inventory disposition per W588 (Seasonal Build-Down) and W830 (Phase-Out Disposition)
Responsible (R): Master Data Analyst
Accountable (A): Master Data Manager
Duration: 10–15 min per SKU</bpmn:documentation>
        <bpmn:incoming>W1532_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1532_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1532_Task9" name="Seasonal calendar maintenance">
        <bpmn:documentation>Step 4: Seasonal calendar maintenance: (a) Master Data Analyst maintains the seasonal SKU calendar in the system: (i) visual timeline showing all seasonal SKUs by category with phase-in/peak/phase-out dates, (ii) overlap detection (incoming seasonal SKU vs. outgoing seasonal SKU competing for same shelf space), (iii) gap detection (category with no active seasonal SKU during expected peak period); (b) publishes seasonal calendar to Category Managers and Merchandise Planners for planning; (c) system uses calendar to: (i) auto-trigger replenishment parameter changes (increase target DOS during peak, decrease during phase-out), (ii) auto-activate promotional pricing on phase-in date, (iii) auto-trigger markdown schedule on phase-out date
Responsible (R): Master Data Analyst / System
Accountable (A): Master Data Manager
Duration: 4–6 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1532_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1532_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1532_Task10" name="Store communication and readiness">
        <bpmn:documentation>Step 5: Store communication and readiness: (a) 4 weeks before phase-in date: system generates seasonal transition notification to affected Store Managers: (i) incoming seasonal SKUs with display location and planogram reference, (ii) outgoing seasonal SKUs with markdown schedule and clearance timeline; (b) Store Manager confirms readiness: display space cleared, planogram updated, staff briefed on seasonal product features; (c) 1 week before phase-in: system activates SKU for ordering and store-level inventory visibility
Responsible (R): System / Store Manager
Accountable (A): Store Operations
Duration: 1–2 hours/store per seasonal transition</bpmn:documentation>
        <bpmn:incoming>W1532_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1532_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1532_End11" name="Complete">
        <bpmn:incoming>W1532_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1532_Annotation12">
        <bpmn:text>Controls: - CTL-328 (ensure controlled execution — Foundational Masters (PA-29.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Master Data Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1532_Assoc13" sourceRef="W1532_Annotation12" targetRef="W1532_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1532_Flow14" sourceRef="W1532_Start5" targetRef="W1532_Task6" />
      <bpmn:sequenceFlow id="W1532_Flow15" sourceRef="W1532_Task6" targetRef="W1532_Task7" />
      <bpmn:sequenceFlow id="W1532_Flow16" sourceRef="W1532_Task7" targetRef="W1532_Task8" />
      <bpmn:sequenceFlow id="W1532_Flow17" sourceRef="W1532_Task8" targetRef="W1532_Task9" />
      <bpmn:sequenceFlow id="W1532_Flow18" sourceRef="W1532_Task9" targetRef="W1532_Task10" />
      <bpmn:sequenceFlow id="W1532_Flow19" sourceRef="W1532_Task10" targetRef="W1532_End11" />
    </bpmn:process>
