<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-29.1-foundational-masters" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W252" name="W252. Centralized Item Master Creation &amp; Governance" isExecutable="false">
      <bpmn:documentation>Trigger: Merchandising department requests a new SKU/Item to be added to the assortment
Frequency: Daily (approx. 30–50 new SKUs/week across all categories)
Volume: ~125–210 new SKUs created/month (1,500–2,500/year canon); ~1,000–1,500 SKU updates/month
Owner: Master Data Manager
Participants: Category Manager, Pricing Analyst, Supply Chain Planner, Master Data Analyst
Source: workflow W252 — Centralized Item Master Creation &amp; Governance</bpmn:documentation>
      <bpmn:laneSet id="W252_LaneSet7">
        <bpmn:lane id="W252_Lane1" name="Vendor">
        <bpmn:flowNodeRef>W252_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W252_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W252_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W252_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W252_Lane3" name="Supply Chain Planner">
        <bpmn:flowNodeRef>W252_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W252_Lane4" name="Pricing Analyst">
        <bpmn:flowNodeRef>W252_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W252_Lane5" name="Master Data Analyst">
        <bpmn:flowNodeRef>W252_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W252_Lane6" name="Master Data Manager">
        <bpmn:flowNodeRef>W252_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W252_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W252_Start8" name="Merchandising department requests a new SKU/Item to be added to the assortment">
        <bpmn:outgoing>W252_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W252_Task9" name="Request Initiation (Vendor Portal)">
        <bpmn:documentation>Step 1: Request Initiation (Vendor Portal): Vendor submits a New Item Request via the Vendor Portal / PIM, providing core product data, images, and marketing copy.
Responsible (R): Vendor
Accountable (A): —
Duration: Variable</bpmn:documentation>
        <bpmn:incoming>W252_Flow18</bpmn:incoming>
        <bpmn:outgoing>W252_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W252_Task10" name="Commercial Review &amp; Categorization">
        <bpmn:documentation>Step 2: Commercial Review &amp; Categorization: Category Manager reviews the vendor submission, assigns the hierarchy category, confirms standard cost, and flags any ESG/Sustainability attributes.
Responsible (R): Category Manager
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W252_Flow19</bpmn:incoming>
        <bpmn:outgoing>W252_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W252_Task11" name="Attribute Enrichment — Supply Chain &amp; Compliance">
        <bpmn:documentation>Step 3: Attribute Enrichment — Supply Chain &amp; Compliance: Supply Chain Planner adds logistical attributes (dimensions, weight, pallet tie/high, default supply DC, minimum order quantity) and assigns Hazardous Materials (Hazmat) classifications if required.
Responsible (R): Supply Chain Planner
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W252_Flow20</bpmn:incoming>
        <bpmn:outgoing>W252_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W252_Task12" name="Attribute Enrichment — Pricing">
        <bpmn:documentation>Step 4: Attribute Enrichment — Pricing: Pricing Analyst adds retail pricing parameters (base retail price, price family grouping, initial margin)
Responsible (R): Pricing Analyst
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W252_Flow21</bpmn:incoming>
        <bpmn:outgoing>W252_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W252_Task13" name="Validation &amp; Quality Check">
        <bpmn:documentation>Step 5: Validation &amp; Quality Check: Master Data Analyst reviews the completed request, ensuring no duplicates exist (checking GTIN/UPC/EAN) and all naming conventions are strictly followed
Responsible (R): Master Data Analyst
Accountable (A): Master Data Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W252_Flow22</bpmn:incoming>
        <bpmn:outgoing>W252_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W252_Task14" name="Approval &amp; Activation">
        <bpmn:documentation>Step 6: Approval &amp; Activation: Master Data Manager approves the item. System assigns internal SKU number, activates the item across the relevant location matrix (store assortments), and syncs to POS and Ecommerce platforms
Responsible (R): Master Data Manager
Accountable (A): Master Data Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W252_Flow23</bpmn:incoming>
        <bpmn:outgoing>W252_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W252_End15" name="Complete">
        <bpmn:incoming>W252_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W252_Annotation16">
        <bpmn:text>Controls: - CTL-50 (prevent unauthorized master data changes.) | - operational: Master Data Manager review and approval gate
Owner: Master Data Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W252_Assoc17" sourceRef="W252_Annotation16" targetRef="W252_Start8" associationDirection="None" />
      <bpmn:sequenceFlow id="W252_Flow18" sourceRef="W252_Start8" targetRef="W252_Task9" />
      <bpmn:sequenceFlow id="W252_Flow19" sourceRef="W252_Task9" targetRef="W252_Task10" />
      <bpmn:sequenceFlow id="W252_Flow20" sourceRef="W252_Task10" targetRef="W252_Task11" />
      <bpmn:sequenceFlow id="W252_Flow21" sourceRef="W252_Task11" targetRef="W252_Task12" />
      <bpmn:sequenceFlow id="W252_Flow22" sourceRef="W252_Task12" targetRef="W252_Task13" />
      <bpmn:sequenceFlow id="W252_Flow23" sourceRef="W252_Task13" targetRef="W252_Task14" />
      <bpmn:sequenceFlow id="W252_Flow24" sourceRef="W252_Task14" targetRef="W252_End15" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W252_diag">
      <bpmndi:BPMNPlane id="W252_plane" bpmnElement="W_W252">
        <bpmndi:BPMNShape id="W252_Lane1_di" bpmnElement="W252_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
