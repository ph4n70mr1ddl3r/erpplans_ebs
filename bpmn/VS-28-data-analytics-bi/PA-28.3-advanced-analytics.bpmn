      <bpmn:sequenceFlow id="W1178_Flow20" sourceRef="W1178_Task9" targetRef="W1178_Task10" />
      <bpmn:sequenceFlow id="W1178_Flow21" sourceRef="W1178_Task10" targetRef="W1178_Task11" />
      <bpmn:sequenceFlow id="W1178_Flow22" sourceRef="W1178_Task11" targetRef="W1178_Task12" />
      <bpmn:sequenceFlow id="W1178_Flow23" sourceRef="W1178_Task12" targetRef="W1178_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1178_diag">
      <bpmndi:BPMNPlane id="W1178_plane" bpmnElement="W_W1178">
        <bpmndi:BPMNShape id="W1178_Lane1_di" bpmnElement="W1178_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1178_Lane2_di" bpmnElement="W1178_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1178_Lane3_di" bpmnElement="W1178_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1178_Task6_di" bpmnElement="W1178_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1178_Task7_di" bpmnElement="W1178_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1178_Task8_di" bpmnElement="W1178_Task8"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1178_Task9_di" bpmnElement="W1178_Task9"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1178_Task10_di" bpmnElement="W1178_Task10"><dc:Bounds x="1240" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1178_Task11_di" bpmnElement="W1178_Task11"><dc:Bounds x="1450" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1178_Task12_di" bpmnElement="W1178_Task12"><dc:Bounds x="1660" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1178_Start5_di" bpmnElement="W1178_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1178_End13_di" bpmnElement="W1178_End13"><dc:Bounds x="1890" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1178_Annotation14_di" bpmnElement="W1178_Annotation14"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1178_Flow16_di" bpmnElement="W1178_Flow16"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1178_Flow17_di" bpmnElement="W1178_Flow17"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1178_Flow18_di" bpmnElement="W1178_Flow18"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1178_Flow19_di" bpmnElement="W1178_Flow19"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1178_Flow20_di" bpmnElement="W1178_Flow20"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="505" /></bpmndi:BPMNEdge>
