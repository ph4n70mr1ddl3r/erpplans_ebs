      <bpmn:sequenceFlow id="W1399_Flow16" sourceRef="W1399_Task5" targetRef="W1399_Task6" />
      <bpmn:sequenceFlow id="W1399_Flow17" sourceRef="W1399_Task6" targetRef="W1399_Task7" />
      <bpmn:sequenceFlow id="W1399_Flow18" sourceRef="W1399_Task7" targetRef="W1399_Task8" />
      <bpmn:sequenceFlow id="W1399_Flow19" sourceRef="W1399_Task8" targetRef="W1399_Task9" />
      <bpmn:sequenceFlow id="W1399_Flow20" sourceRef="W1399_Task9" targetRef="W1399_Task10" />
      <bpmn:sequenceFlow id="W1399_Flow21" sourceRef="W1399_Task10" targetRef="W1399_Task11" />
      <bpmn:sequenceFlow id="W1399_Flow22" sourceRef="W1399_Task11" targetRef="W1399_End12" />
    </bpmn:process>
