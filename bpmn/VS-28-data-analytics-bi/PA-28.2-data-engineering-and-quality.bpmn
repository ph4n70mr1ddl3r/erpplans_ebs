<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-28.2-data-engineering-and-quality" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W881" name="W881. Data Warehouse ETL Job Monitoring &amp; Exception Handling" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled — continuous monitoring of all ETL jobs; alert-driven for failures
Frequency: Daily monitoring of ~50–80 ETL jobs; ~3–5 job failures per week requiring intervention
Volume: ~20,000 ETL job executions per month across all pipelines
Owner: BI Operations Analyst / Data Engineer
Participants: BI Manager, IT Database Administrator, Source System Owner
Source: workflow W881 — Data Warehouse ETL Job Monitoring &amp; Exception Handling</bpmn:documentation>
      <bpmn:laneSet id="W881_LaneSet3">
        <bpmn:lane id="W881_Lane1" name="BI Operations Analyst">
        <bpmn:flowNodeRef>W881_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W881_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W881_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W881_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W881_Lane2" name="Data Engineer">
        <bpmn:flowNodeRef>W881_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W881_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W881_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W881_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W881_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W881_Start4" name="Scheduled — continuous monitoring of all ETL jobs; alert-driven for failures">
        <bpmn:outgoing>W881_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W881_Task5" name="Review overnight ETL batch status (06:00 AM) — check all critical jobs…">
        <bpmn:documentation>Step 1: Review overnight ETL batch status (06:00 AM) — check all critical jobs completed: (a) POS sales extract, (b) Inventory snapshot, (c) Finance posting extract, (d) HR payroll extract, (e) ecommerce order extract, (f) WMS movement extract; verify row counts within expected ranges
Responsible (R): BI Operations Analyst
Accountable (A): BI Manager
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W881_Flow15</bpmn:incoming>
        <bpmn:outgoing>W881_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W881_Task6" name="Investigate failed jobs — for each failure: (a) review error log for root cause…">
        <bpmn:documentation>Step 2: Investigate failed jobs — for each failure: (a) review error log for root cause (source system unavailable, data quality violation, timeout, connectivity issue), (b) determine impact (which reports/dashboards affected), (c) decide on remediation approach (re-run, manual fix, escalate)
Responsible (R): Data Engineer
Accountable (A): BI Manager
Duration: 30–60 min per failure</bpmn:documentation>
        <bpmn:incoming>W881_Flow16</bpmn:incoming>
        <bpmn:outgoing>W881_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W881_Task7" name="Execute remediation — (a) re-run failed job after resolving root cause, (b) for…">
        <bpmn:documentation>Step 3: Execute remediation — (a) re-run failed job after resolving root cause, (b) for data quality failures: quarantine bad records, correct in staging, and re-process, (c) for source system issues: coordinate with IT to resolve, (d) for timeout: optimize query or increase timeout threshold
Responsible (R): Data Engineer
Accountable (A): BI Manager
Duration: 30–120 min</bpmn:documentation>
        <bpmn:incoming>W881_Flow17</bpmn:incoming>
        <bpmn:outgoing>W881_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W881_Task8" name="Validate remediated data — after re-run, verify: (a) row counts match source…">
        <bpmn:documentation>Step 4: Validate remediated data — after re-run, verify: (a) row counts match source system, (b) data quality checks pass, (c) downstream reports reflect updated data; notify affected report consumers if data was stale
Responsible (R): BI Operations Analyst
Accountable (A): BI Manager
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W881_Flow18</bpmn:incoming>
        <bpmn:outgoing>W881_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W881_Task9" name="Monitor intraday ETL jobs — real-time and near-real-time feeds (POS streaming…">
        <bpmn:documentation>Step 5: Monitor intraday ETL jobs — real-time and near-real-time feeds (POS streaming, ecommerce orders, inventory updates) require continuous monitoring; check latency against SLA (POS: &lt; 30 sec, ecommerce: &lt; 5 min)
Responsible (R): BI Operations Analyst
Accountable (A): BI Manager
Duration: Continuous (during business hours)</bpmn:documentation>
        <bpmn:incoming>W881_Flow19</bpmn:incoming>
        <bpmn:outgoing>W881_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W881_Task10" name="Weekly ETL health review — analyze job performance trends: (a) average…">
        <bpmn:documentation>Step 6: Weekly ETL health review — analyze job performance trends: (a) average execution time vs. baseline, (b) failure rate by job type, (c) data volume growth and capacity impact, (d) upcoming schema changes in source systems that may affect ETL
Responsible (R): Data Engineer
Accountable (A): BI Manager
Duration: 2 hours weekly</bpmn:documentation>
        <bpmn:incoming>W881_Flow20</bpmn:incoming>
        <bpmn:outgoing>W881_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W881_Task11" name="Monthly ETL optimization — identify and implement improvements: (a) optimize…">
        <bpmn:documentation>Step 7: Monthly ETL optimization — identify and implement improvements: (a) optimize slow-running queries, (b) consolidate redundant jobs, (c) implement incremental loading for large tables, (d) archive historical data to reduce processing time
Responsible (R): Data Engineer
Accountable (A): BI Manager
Duration: 4 hours monthly</bpmn:documentation>
        <bpmn:incoming>W881_Flow21</bpmn:incoming>
        <bpmn:outgoing>W881_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W881_End12" name="Complete">
        <bpmn:incoming>W881_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W881_Annotation13">
        <bpmn:text>Controls: - CTL-222 (ensure BI data governance &amp; reporting integrity.) | - operational: BI Operations Analyst / Data Engineer review and approval gate
Owner: BI Operations Analyst / Data Engineer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W881_Assoc14" sourceRef="W881_Annotation13" targetRef="W881_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W881_Flow15" sourceRef="W881_Start4" targetRef="W881_Task5" />
      <bpmn:sequenceFlow id="W881_Flow16" sourceRef="W881_Task5" targetRef="W881_Task6" />
      <bpmn:sequenceFlow id="W881_Flow17" sourceRef="W881_Task6" targetRef="W881_Task7" />
