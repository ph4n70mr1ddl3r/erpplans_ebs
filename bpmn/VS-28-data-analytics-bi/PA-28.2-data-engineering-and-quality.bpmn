      <bpmn:sequenceFlow id="W881_Flow19" sourceRef="W881_Task8" targetRef="W881_Task9" />
      <bpmn:sequenceFlow id="W881_Flow20" sourceRef="W881_Task9" targetRef="W881_Task10" />
      <bpmn:sequenceFlow id="W881_Flow21" sourceRef="W881_Task10" targetRef="W881_Task11" />
      <bpmn:sequenceFlow id="W881_Flow22" sourceRef="W881_Task11" targetRef="W881_End12" />
    </bpmn:process>
