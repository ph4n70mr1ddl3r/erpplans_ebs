    <bpmn:process id="W_W2881" name="W2881. Grievance Intake, Classification &amp; Step-1 Conference" isExecutable="false">
      <bpmn:documentation>Trigger: Employee or union files grievance
Frequency: Event-driven; ~5–20 grievances/month
Volume: All employees
Owner: HR Manager
Participants: HR, Employee, Union Steward, Supervisor
Source: workflow W2881 — Grievance Intake, Classification &amp; Step-1 Conference</bpmn:documentation>
      <bpmn:laneSet id="W2881_LaneSet2">
        <bpmn:lane id="W2881_Lane1" name="HR">
        <bpmn:flowNodeRef>W2881_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2881_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2881_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2881_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2881_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2881_Start3" name="Employee or union files grievance">
        <bpmn:outgoing>W2881_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2881_Task4" name="HR receives grievance (written/verbal via union or individual); logs in…">
        <bpmn:documentation>Step 1: HR receives grievance (written/verbal via union or individual); logs in grievance case system; classifies (wage, discipline, working condition, interpretation)
Responsible (R): HR
Accountable (A): HR Manager
Duration: Per grievance</bpmn:documentation>
        <bpmn:incoming>W2881_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2881_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2881_Task5" name="HR convenes Step-1 conference with employee, union steward, and immediate…">
        <bpmn:documentation>Step 2: HR convenes Step-1 conference with employee, union steward, and immediate supervisor within CBA-prescribed timeline (often 5–7 days)
Responsible (R): HR
Accountable (A): HR Manager
Duration: Per grievance</bpmn:documentation>
        <bpmn:incoming>W2881_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2881_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2881_Task6" name="HR documents Step-1 decision; communicates to employee/union; escalates to…">
        <bpmn:documentation>Step 3: HR documents Step-1 decision; communicates to employee/union; escalates to Step-2 if unresolved
Responsible (R): HR
Accountable (A): HR Manager
Duration: Per grievance</bpmn:documentation>
        <bpmn:incoming>W2881_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2881_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2881_End7" name="Complete">
        <bpmn:incoming>W2881_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2881_Annotation8">
        <bpmn:text>Controls: - CTL-217 (ensure labor-relations statutory compliance.) | - operational: SLA-bounded case system
Owner: HR Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2881_Assoc9" sourceRef="W2881_Annotation8" targetRef="W2881_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2881_Flow10" sourceRef="W2881_Start3" targetRef="W2881_Task4" />
      <bpmn:sequenceFlow id="W2881_Flow11" sourceRef="W2881_Task4" targetRef="W2881_Task5" />
      <bpmn:sequenceFlow id="W2881_Flow12" sourceRef="W2881_Task5" targetRef="W2881_Task6" />
      <bpmn:sequenceFlow id="W2881_Flow13" sourceRef="W2881_Task6" targetRef="W2881_End7" />
    </bpmn:process>
