    <bpmn:process id="W_W2883" name="W2883. Preventive Suspension, Due Process &amp; Notice Workflow (2-Notice Rule)" isExecutable="false">
      <bpmn:documentation>Trigger: Serious offense allegation requiring investigation
Frequency: Event-driven; ~10–30 cases/year
Volume: All employees
Owner: HR Manager
Participants: HR, LR Director, Legal, Supervisor
Source: workflow W2883 — Preventive Suspension, Due Process &amp; Notice Workflow (2-Notice Rule)</bpmn:documentation>
      <bpmn:laneSet id="W2883_LaneSet2">
        <bpmn:lane id="W2883_Lane1" name="HR">
        <bpmn:flowNodeRef>W2883_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2883_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2883_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2883_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2883_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2883_Start3" name="Serious offense allegation requiring investigation">
        <bpmn:outgoing>W2883_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2883_Task4" name="HR issues Notice of Preventive Suspension (not exceeding 30 days per Labor…">
        <bpmn:documentation>Step 1: HR issues Notice of Preventive Suspension (not exceeding 30 days per Labor Code) with written grounds; ensures pay rules per law
Responsible (R): HR
Accountable (A): HR Manager
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W2883_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2883_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2883_Task5" name="HR serves First Notice (Notice to Explain) specifying charges and giving…">
        <bpmn:documentation>Step 2: HR serves First Notice (Notice to Explain) specifying charges and giving employee opportunity to respond within reasonable period (typically 5 days)
Responsible (R): HR
Accountable (A): HR Manager
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W2883_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2883_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2883_Task6" name="HR documents employee response; prepares for hearing and decision; safeguards…">
        <bpmn:documentation>Step 3: HR documents employee response; prepares for hearing and decision; safeguards against procedural defects
Responsible (R): HR / Legal
Accountable (A): VP Legal &amp; Compliance
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W2883_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2883_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2883_End7" name="Complete">
        <bpmn:incoming>W2883_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2883_Annotation8">
        <bpmn:text>Controls: - CTL-482 (ensure controlled execution — Grievance Handling, Labor Dispute &amp; DOLE Conciliation (PA-84.2).) | - operational: standardized workflow and legal review
Owner: HR Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2883_Assoc9" sourceRef="W2883_Annotation8" targetRef="W2883_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2883_Flow10" sourceRef="W2883_Start3" targetRef="W2883_Task4" />
      <bpmn:sequenceFlow id="W2883_Flow11" sourceRef="W2883_Task4" targetRef="W2883_Task5" />
      <bpmn:sequenceFlow id="W2883_Flow12" sourceRef="W2883_Task5" targetRef="W2883_Task6" />
      <bpmn:sequenceFlow id="W2883_Flow13" sourceRef="W2883_Task6" targetRef="W2883_End7" />
    </bpmn:process>
