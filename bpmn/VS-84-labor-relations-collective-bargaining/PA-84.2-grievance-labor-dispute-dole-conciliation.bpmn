      <bpmn:sequenceFlow id="W2888_Flow13" sourceRef="W2888_Task6" targetRef="W2888_Task7" />
      <bpmn:sequenceFlow id="W2888_Flow14" sourceRef="W2888_Task7" targetRef="W2888_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2888_diag">
      <bpmndi:BPMNPlane id="W2888_plane" bpmnElement="W_W2888">
        <bpmndi:BPMNShape id="W2888_Lane1_di" bpmnElement="W2888_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2888_Lane2_di" bpmnElement="W2888_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
