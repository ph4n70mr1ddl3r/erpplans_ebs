    <bpmn:process id="W_W2882" name="W2882. Grievance Escalation, Step-2/3 Review &amp; CBA Dispute Resolution" isExecutable="false">
      <bpmn:documentation>Trigger: Unresolved Step-1 grievance
Frequency: Event-driven
Volume: Subset of grievances
Owner: Labor Relations Director
Participants: LR Director, HR, Union, Senior Management
Source: workflow W2882 — Grievance Escalation, Step-2/3 Review &amp; CBA Dispute Resolution</bpmn:documentation>
      <bpmn:laneSet id="W2882_LaneSet2">
        <bpmn:lane id="W2882_Lane1" name="LR Director">
        <bpmn:flowNodeRef>W2882_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2882_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2882_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2882_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2882_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2882_Start3" name="Unresolved Step-1 grievance">
        <bpmn:outgoing>W2882_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2882_Task4" name="LR Director convenes Step-2 review with higher management and union officers…">
        <bpmn:documentation>Step 1: LR Director convenes Step-2 review with higher management and union officers; reviews evidence and prior decision
Responsible (R): LR Director
Accountable (A): VP Legal &amp; Compliance
Duration: Per grievance</bpmn:documentation>
        <bpmn:incoming>W2882_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2882_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2882_Task5" name="LR Director facilitates Step-3 (grievance committee or top management) per CBA…">
        <bpmn:documentation>Step 2: LR Director facilitates Step-3 (grievance committee or top management) per CBA; seeks resolution before arbitration
Responsible (R): LR Director
Accountable (A): VP Legal &amp; Compliance
Duration: Per grievance</bpmn:documentation>
        <bpmn:incoming>W2882_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2882_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2882_Task6" name="LR Director documents final position; if unresolved, advises on DOLE SENA/NLRC…">
        <bpmn:documentation>Step 3: LR Director documents final position; if unresolved, advises on DOLE SENA/NLRC arbitration pathway
Responsible (R): LR Director
Accountable (A): VP Legal &amp; Compliance
Duration: Per grievance</bpmn:documentation>
        <bpmn:incoming>W2882_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2882_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2882_End7" name="Complete">
        <bpmn:incoming>W2882_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2882_Annotation8">
        <bpmn:text>Controls: - CTL-482 (ensure controlled execution — Grievance Handling, Labor Dispute &amp; DOLE Conciliation (PA-84.2).) | - operational: root-cause analysis
Owner: Labor Relations Director</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2882_Assoc9" sourceRef="W2882_Annotation8" targetRef="W2882_Start3" associationDirection="None" />
