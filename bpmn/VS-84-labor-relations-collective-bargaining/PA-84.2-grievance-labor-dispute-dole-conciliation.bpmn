      </bpmn:laneSet>
      <bpmn:startEvent id="W2888_Start4" name="Strike vote or lockout notice">
        <bpmn:outgoing>W2888_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2888_Task5" name="LR Director validates strike-vote compliance (2/3 majority, notice, cooling-off…">
        <bpmn:documentation>Step 1: LR Director validates strike-vote compliance (2/3 majority, notice, cooling-off period); engages DOLE conciliation to avert
Responsible (R): LR Director / Legal
Accountable (A): VP Legal &amp; Compliance
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W2888_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2888_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2888_Task6" name="BCM activates strike contingency plan: temporary staffing, security, supply…">
        <bpmn:documentation>Step 2: BCM activates strike contingency plan: temporary staffing, security, supply continuity, executive communications
Responsible (R): BCM / Management
Accountable (A): CEO
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W2888_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2888_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2888_Task7" name="LR Director negotiates resolution or seeks DOLE Secretary assumption of…">
        <bpmn:documentation>Step 3: LR Director negotiates resolution or seeks DOLE Secretary assumption of jurisdiction; manages return-to-work and amnesty terms
Responsible (R): LR Director / Legal
Accountable (A): CEO
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W2888_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2888_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2888_End8" name="Complete">
        <bpmn:incoming>W2888_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2888_Annotation9">
        <bpmn:text>Controls: - CTL-482 (ensure controlled execution — Grievance Handling, Labor Dispute &amp; DOLE Conciliation (PA-84.2).) | - operational: contingency plan and early DOLE engagement
Owner: Labor Relations Director</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2888_Assoc10" sourceRef="W2888_Annotation9" targetRef="W2888_Start4" associationDirection="None" />
