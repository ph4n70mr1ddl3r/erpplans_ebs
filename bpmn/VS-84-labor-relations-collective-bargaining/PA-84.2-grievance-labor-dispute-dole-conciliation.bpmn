    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2884" name="W2884. Disciplinary Investigation, Hearing &amp; Decision" isExecutable="false">
      <bpmn:documentation>Trigger: Employee response received; hearing scheduled
Frequency: Event-driven
Volume: ~10–30 cases/year
Owner: Labor Relations Director
Participants: LR Director, HR, Legal, Employee, Union, Witnesses
Source: workflow W2884 — Disciplinary Investigation, Hearing &amp; Decision</bpmn:documentation>
      <bpmn:laneSet id="W2884_LaneSet3">
        <bpmn:lane id="W2884_Lane1" name="LR Director">
        <bpmn:flowNodeRef>W2884_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2884_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2884_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2884_Lane2" name="HR">
        <bpmn:flowNodeRef>W2884_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2884_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2884_Start4" name="Employee response received; hearing scheduled">
        <bpmn:outgoing>W2884_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2884_Task5" name="LR Director conducts administrative hearing; presents evidence; allows employee…">
        <bpmn:documentation>Step 1: LR Director conducts administrative hearing; presents evidence; allows employee (with counsel/union rep) to cross-examine and present defense
Responsible (R): LR Director
Accountable (A): VP Legal &amp; Compliance
Duration: Per hearing</bpmn:documentation>
        <bpmn:incoming>W2884_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2884_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2884_Task6" name="LR Director/Legal evaluates evidence against just causes (serious misconduct…">
        <bpmn:documentation>Step 2: LR Director/Legal evaluates evidence against just causes (serious misconduct, willful disobedience, fraud, etc.); documents findings
Responsible (R): LR Director / Legal
Accountable (A): VP Legal &amp; Compliance
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W2884_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2884_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2884_Task7" name="HR issues Second Notice (Decision) with penalty and rationale; communicates…">
        <bpmn:documentation>Step 3: HR issues Second Notice (Decision) with penalty and rationale; communicates appeal rights; archives complete case file
Responsible (R): HR
Accountable (A): VP Legal &amp; Compliance
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W2884_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2884_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2884_End8" name="Complete">
        <bpmn:incoming>W2884_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2884_Annotation9">
        <bpmn:text>Controls: - CTL-482 (ensure controlled execution — Grievance Handling, Labor Dispute &amp; DOLE Conciliation (PA-84.2).) | - operational: hearing rigor and proportionality assessment
Owner: Labor Relations Director</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2884_Assoc10" sourceRef="W2884_Annotation9" targetRef="W2884_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2884_Flow11" sourceRef="W2884_Start4" targetRef="W2884_Task5" />
      <bpmn:sequenceFlow id="W2884_Flow12" sourceRef="W2884_Task5" targetRef="W2884_Task6" />
      <bpmn:sequenceFlow id="W2884_Flow13" sourceRef="W2884_Task6" targetRef="W2884_Task7" />
      <bpmn:sequenceFlow id="W2884_Flow14" sourceRef="W2884_Task7" targetRef="W2884_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2884_diag">
