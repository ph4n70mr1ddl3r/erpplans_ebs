        <bpmn:lane id="W2892_Lane1" name="Internal Audit">
        <bpmn:flowNodeRef>W2892_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2892_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2892_Start4</bpmn:flowNodeRef>
