<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-30.2-ai-ml-and-automation" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W200" name="W200. AI-Driven Personalization &amp; Recommendation Engine" isExecutable="false">
      <bpmn:documentation>Trigger: Customer visits website/app; or opens marketing email
Frequency: Real-time (at interaction)
Volume: ~600,000 loyalty members; millions of digital touchpoints
Owner: Digital Commerce Manager
Participants: Data Science Team (IT), Marketing, Digital Commerce Mgr
Source: workflow W200 — AI-Driven Personalization &amp; Recommendation Engine</bpmn:documentation>
      <bpmn:laneSet id="W200_LaneSet3">
        <bpmn:lane id="W200_Lane1" name="System">
        <bpmn:flowNodeRef>W200_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W200_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W200_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W200_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W200_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W200_Lane2" name="Digital Commerce Manager">
        <bpmn:flowNodeRef>W200_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W200_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W200_Start4" name="Customer visits website/app; or opens marketing email">
        <bpmn:outgoing>W200_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W200_Task5" name="Data Ingestion">
        <bpmn:documentation>Step 1: Data Ingestion: System aggregates behavioral data (search history, clicks, abandoned carts) and transaction data (W17)
Responsible (R): System
Accountable (A): —
Duration: Real-time</bpmn:documentation>
        <bpmn:incoming>W200_Flow13</bpmn:incoming>
        <bpmn:outgoing>W200_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W200_Task6" name="Model Prediction">
        <bpmn:documentation>Step 2: Model Prediction: AI model identifies &quot;Next Best Product&quot; or &quot;Propensity to Buy&quot; for the specific customer segment
Responsible (R): System
Accountable (A): —
Duration: &lt; 200ms</bpmn:documentation>
        <bpmn:incoming>W200_Flow14</bpmn:incoming>
        <bpmn:outgoing>W200_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W200_Task7" name="Dynamic Rendering">
        <bpmn:documentation>Step 3: Dynamic Rendering: Website/App displays personalized banners, &quot;Recommended for You&quot; carousels, or targeted coupon (W13)
Responsible (R): System
Accountable (A): —
Duration: Real-time</bpmn:documentation>
        <bpmn:incoming>W200_Flow15</bpmn:incoming>
        <bpmn:outgoing>W200_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W200_Task8" name="Feedback Loop">
        <bpmn:documentation>Step 4: Feedback Loop: System tracks conversion on AI-recommended items vs. non-AI; adjusts model weights
Responsible (R): System
Accountable (A): Data Scientist
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W200_Flow16</bpmn:incoming>
        <bpmn:outgoing>W200_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W200_Task9" name="Monthly Review">
        <bpmn:documentation>Step 5: Monthly Review: Digital Commerce Manager reviews &quot;Revenue Lift from Personalization&quot; dashboard
Responsible (R): Digital Commerce Manager
Accountable (A): CMO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W200_Flow17</bpmn:incoming>
        <bpmn:outgoing>W200_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W200_End10" name="Complete">
        <bpmn:incoming>W200_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W200_Annotation11">
        <bpmn:text>Controls: - CTL-332 (ensure controlled execution — AI/ML &amp; Automation (PA-30.2).) | - operational: Digital Commerce Manager review and approval gate
Owner: Digital Commerce Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W200_Assoc12" sourceRef="W200_Annotation11" targetRef="W200_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W200_Flow13" sourceRef="W200_Start4" targetRef="W200_Task5" />
      <bpmn:sequenceFlow id="W200_Flow14" sourceRef="W200_Task5" targetRef="W200_Task6" />
      <bpmn:sequenceFlow id="W200_Flow15" sourceRef="W200_Task6" targetRef="W200_Task7" />
      <bpmn:sequenceFlow id="W200_Flow16" sourceRef="W200_Task7" targetRef="W200_Task8" />
      <bpmn:sequenceFlow id="W200_Flow17" sourceRef="W200_Task8" targetRef="W200_Task9" />
      <bpmn:sequenceFlow id="W200_Flow18" sourceRef="W200_Task9" targetRef="W200_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W200_diag">
      <bpmndi:BPMNPlane id="W200_plane" bpmnElement="W_W200">
        <bpmndi:BPMNShape id="W200_Lane1_di" bpmnElement="W200_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W200_Lane2_di" bpmnElement="W200_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
