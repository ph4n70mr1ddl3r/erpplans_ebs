        <bpmndi:BPMNShape id="W1340_Task12_di" bpmnElement="W1340_Task12"><dc:Bounds x="1450" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1340_Start6_di" bpmnElement="W1340_Start6"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
