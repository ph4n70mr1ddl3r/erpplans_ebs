      <bpmn:sequenceFlow id="W1340_Flow18" sourceRef="W1340_Task8" targetRef="W1340_Task9" />
      <bpmn:sequenceFlow id="W1340_Flow19" sourceRef="W1340_Task9" targetRef="W1340_Task10" />
      <bpmn:sequenceFlow id="W1340_Flow20" sourceRef="W1340_Task10" targetRef="W1340_Task11" />
      <bpmn:sequenceFlow id="W1340_Flow21" sourceRef="W1340_Task11" targetRef="W1340_Task12" />
      <bpmn:sequenceFlow id="W1340_Flow22" sourceRef="W1340_Task12" targetRef="W1340_End13" />
    </bpmn:process>
