      <bpmndi:BPMNPlane id="W1340_plane" bpmnElement="W_W1340">
        <bpmndi:BPMNShape id="W1340_Lane1_di" bpmnElement="W1340_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
