      <bpmn:sequenceFlow id="W1206_Flow20" sourceRef="W1206_Task10" targetRef="W1206_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1206_diag">
      <bpmndi:BPMNPlane id="W1206_plane" bpmnElement="W_W1206">
        <bpmndi:BPMNShape id="W1206_Lane1_di" bpmnElement="W1206_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
