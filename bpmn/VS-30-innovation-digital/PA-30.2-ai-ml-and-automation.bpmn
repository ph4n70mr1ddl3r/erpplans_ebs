    <bpmn:process id="W_W201" name="W201. Robotic Process Automation (RPA) Lifecycle" isExecutable="false">
      <bpmn:documentation>Trigger: Identification of a high-volume, repetitive manual task (e.g., bank reconciliation, vendor statement matching)
Frequency: Ongoing project basis
Volume: ~15–20 RPA bots in production
Owner: IT Business Analyst
Participants: Subject Matter Expert (SME), IT Developer, Business Process Owner
Source: workflow W201 — Robotic Process Automation (RPA) Lifecycle</bpmn:documentation>
      <bpmn:laneSet id="W201_LaneSet5">
        <bpmn:lane id="W201_Lane1" name="IT Analyst">
        <bpmn:flowNodeRef>W201_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W201_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W201_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W201_Lane2" name="SME">
        <bpmn:flowNodeRef>W201_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W201_Lane3" name="Developer">
        <bpmn:flowNodeRef>W201_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W201_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W201_Lane4" name="IT Ops">
        <bpmn:flowNodeRef>W201_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W201_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W201_Start6" name="Identification of a high-volume, repetitive manual task (e.g., bank reconciliation…">
        <bpmn:outgoing>W201_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W201_Task7" name="Opportunity Assessment">
        <bpmn:documentation>Step 1: Opportunity Assessment: Evaluate process for RPA suitability (Rule-based, high volume, structured data)
Responsible (R): IT Analyst
Accountable (A): Dept Head
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W201_Flow16</bpmn:incoming>
        <bpmn:outgoing>W201_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W201_Task8" name="Process Documentation">
        <bpmn:documentation>Step 2: Process Documentation: Record &quot;As-Is&quot; process steps and all exception paths
Responsible (R): SME
Accountable (A): IT Analyst
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W201_Flow17</bpmn:incoming>
        <bpmn:outgoing>W201_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W201_Task9" name="Bot Development">
        <bpmn:documentation>Step 3: Bot Development: Configure RPA bot (e.g., UiPath/BluePrism) to mimic human actions in the system
Responsible (R): Developer
Accountable (A): IT Analyst
Duration: 1–3 weeks</bpmn:documentation>
        <bpmn:incoming>W201_Flow18</bpmn:incoming>
        <bpmn:outgoing>W201_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W201_Task10" name="Testing">
        <bpmn:documentation>Step 4: Testing: Run bot in UAT environment; verify accuracy and exception handling
Responsible (R): Developer / SME
Accountable (A): —
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W201_Flow19</bpmn:incoming>
        <bpmn:outgoing>W201_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W201_Task11" name="Deployment">
        <bpmn:documentation>Step 5: Deployment: Bot scheduled to run in Production (e.g., &quot;Nightly Bank Recon Bot&quot;)
Responsible (R): IT Ops
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W201_Flow20</bpmn:incoming>
        <bpmn:outgoing>W201_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W201_Task12" name="Monitoring">
        <bpmn:documentation>Step 6: Monitoring: IT tracks bot success rate and &quot;Hours Saved&quot; per month
Responsible (R): IT Analyst
Accountable (A): CIO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W201_Flow21</bpmn:incoming>
        <bpmn:outgoing>W201_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W201_End13" name="Complete">
        <bpmn:incoming>W201_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W201_Annotation14">
        <bpmn:text>Controls: - CTL-332 (ensure controlled execution — AI/ML &amp; Automation (PA-30.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: IT Business Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W201_Assoc15" sourceRef="W201_Annotation14" targetRef="W201_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W201_Flow16" sourceRef="W201_Start6" targetRef="W201_Task7" />
      <bpmn:sequenceFlow id="W201_Flow17" sourceRef="W201_Task7" targetRef="W201_Task8" />
      <bpmn:sequenceFlow id="W201_Flow18" sourceRef="W201_Task8" targetRef="W201_Task9" />
      <bpmn:sequenceFlow id="W201_Flow19" sourceRef="W201_Task9" targetRef="W201_Task10" />
      <bpmn:sequenceFlow id="W201_Flow20" sourceRef="W201_Task10" targetRef="W201_Task11" />
      <bpmn:sequenceFlow id="W201_Flow21" sourceRef="W201_Task11" targetRef="W201_Task12" />
      <bpmn:sequenceFlow id="W201_Flow22" sourceRef="W201_Task12" targetRef="W201_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W201_diag">
      <bpmndi:BPMNPlane id="W201_plane" bpmnElement="W_W201">
        <bpmndi:BPMNShape id="W201_Lane1_di" bpmnElement="W201_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W201_Lane2_di" bpmnElement="W201_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W201_Lane3_di" bpmnElement="W201_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W201_Lane4_di" bpmnElement="W201_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W201_Task7_di" bpmnElement="W201_Task7"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W201_Task8_di" bpmnElement="W201_Task8"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
