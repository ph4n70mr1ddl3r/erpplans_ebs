      <bpmn:startEvent id="W1460_Start5" name="Monthly content calendar milestone; new product category launch; customer service…">
        <bpmn:outgoing>W1460_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1460_Task6" name="Content calendar planning">
        <bpmn:documentation>Step 1: Content calendar planning: Quarterly content calendar aligned with seasonal calendar per Section 13.2; SEO keyword research for Philippine search terms; balance: 40% beginner, 30% intermediate, 20% advanced, 10% seasonal
Responsible (R): Content Marketing Specialist
Accountable (A): CMO
Duration: 4–6 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1460_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1460_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1460_Task7" name="Guide creation">
        <bpmn:documentation>Step 2: Guide creation: Select topic; research materials, tools, duration, difficulty, cost; write step-by-step with photos; record 3–5 min video tutorial; create &#x27;Buy all materials&#x27; bundle link; include safety warnings and FAQ from W31
Responsible (R): Content Marketing Specialist
Accountable (A): —
Duration: 8–12 hours/guide</bpmn:documentation>
        <bpmn:incoming>W1460_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1460_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1460_Task8" name="Technical review">
        <bpmn:documentation>Step 3: Technical review: Category Manager verifies specifications, quantities, building standards; Store Operations verifies practical accuracy and safety; approved for publishing
Responsible (R): Category Manager / Store Operations
Accountable (A): Content Marketing Specialist
Duration: 2–3 hours/guide</bpmn:documentation>
        <bpmn:incoming>W1460_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1460_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1460_Task9" name="Publishing &amp; distribution">
        <bpmn:documentation>Step 4: Publishing &amp; distribution: Publish on buildright.com.ph with SEO, materials bundle, video embed; mobile app &#x27;Projects &amp; Ideas&#x27; section; social media excerpt per W142 and W1417; email newsletter per W1350; in-store QR codes
Responsible (R): Content Marketing Specialist / Ecommerce
Accountable (A): —
Duration: 1–2 hours/guide</bpmn:documentation>
        <bpmn:incoming>W1460_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1460_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1460_Task10" name="Performance tracking">
        <bpmn:documentation>Step 5: Performance tracking: Monthly: page views, video views, bundle click-through, attributed revenue, SEO ranking, customer feedback, content ROI
Responsible (R): Marketing Data Analyst
Accountable (A): Content Marketing Specialist
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1460_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1460_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1460_Task11" name="Quarterly content review">
        <bpmn:documentation>Step 6: Quarterly content review: Identify guides needing refresh or retirement; update for seasonal relevance; report library performance to CMO
Responsible (R): Content Marketing Specialist
Accountable (A): CMO
Duration: 4 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1460_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1460_Flow21</bpmn:outgoing>
      </bpmn:userTask>
