    <bpmn:process id="W_W1459" name="W1459. Store Operations SOP Digital Library, Mobile Access &amp; Version-Controlled Update Distribution" isExecutable="false">
      <bpmn:documentation>Trigger: New SOP published by HQ; existing SOP revision; new store opening; or quarterly SOP review cycle
Frequency: SOP updates: 5–10 new/revised SOPs/month; New store package: 10–15 stores/year; Quarterly review
Volume: ~200 active SOPs across store operations; 200 stores × ~5,800 store employees as end users
Owner: Store Operations Standards Manager
Participants: Store Operations Standards Manager, Department Heads (authors), Store Managers, Store Associates, IT
Source: workflow W1459 — Store Operations SOP Digital Library, Mobile Access &amp; Version-Controlled Update Distribution</bpmn:documentation>
      <bpmn:laneSet id="W1459_LaneSet5">
        <bpmn:lane id="W1459_Lane1" name="Department Head">
        <bpmn:flowNodeRef>W1459_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1459_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1459_Lane2" name="Store Operations Standards Manager">
        <bpmn:flowNodeRef>W1459_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1459_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1459_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1459_Lane3" name="System">
        <bpmn:flowNodeRef>W1459_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1459_Lane4" name="Store Manager">
        <bpmn:flowNodeRef>W1459_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1459_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1459_Start6" name="New SOP published by HQ; existing SOP revision; new store opening; or quarterly SOP…">
        <bpmn:outgoing>W1459_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1459_Task7" name="SOP authoring &amp; review">
        <bpmn:documentation>Step 1: SOP authoring &amp; review: Department Head authors SOP using template per W687; includes photos, video clips; Store Operations Standards Manager reviews for clarity and chain-wide consistency; legal review for safety/compliance SOPs; approved with version number
Responsible (R): Department Head / Store Ops Standards Manager
Accountable (A): COO
Duration: 2–4 hours/SOP</bpmn:documentation>
        <bpmn:incoming>W1459_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1459_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1459_Task8" name="SOP publication &amp; distribution">
        <bpmn:documentation>Step 2: SOP publication &amp; distribution: Published to cloud SOP platform; auto-tagged by category, audience role, and location; push notification sent to affected employees&#x27; mobile app with 7-day acknowledgement deadline; offline access for provincial stores; previous version auto-archived
Responsible (R): Store Operations Standards Manager
Accountable (A): —
Duration: 15 min/SOP</bpmn:documentation>
        <bpmn:incoming>W1459_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1459_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1459_Task9" name="Employee acknowledgement tracking">
        <bpmn:documentation>Step 3: Employee acknowledgement tracking: System tracks acknowledgement per employee; Store Manager dashboard shows compliance %; automated reminders on day 5 and 7; non-acknowledgement after 10 days flagged to Store Manager
Responsible (R): System / Store Manager
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1459_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1459_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1459_Task10" name="New store SOP package">
        <bpmn:documentation>Step 4: New store SOP package: Generate complete SOP package for new stores per W702; pre-loaded on Employee App during onboarding per W15; all employees acknowledge within first week
Responsible (R): Store Operations Standards Manager
Accountable (A): Regional Manager
Duration: 2–3 hours/store</bpmn:documentation>
        <bpmn:incoming>W1459_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1459_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1459_Task11" name="Quarterly SOP review">
        <bpmn:documentation>Step 5: Quarterly SOP review: Review all SOPs older than 12 months; update based on process changes, regulatory changes, audit findings; retire obsolete SOPs; report library health metrics
Responsible (R): Store Operations Standards Manager
Accountable (A): COO
Duration: 8–10 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1459_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1459_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1459_Task12" name="SOP feedback loop">
        <bpmn:documentation>Step 6: SOP feedback loop: Store Managers and Associates submit feedback via mobile app; feedback routed to Department Head; incorporated into next revision cycle
Responsible (R): Store Manager / Associate
Accountable (A): Store Operations Standards Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1459_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1459_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1459_End13" name="Complete">
        <bpmn:incoming>W1459_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1459_Annotation14">
        <bpmn:text>Controls: - CTL-333 (ensure controlled execution — Document &amp; Knowledge Management (PA-30.3).) | - operational: Store Operations Standards Manager review and approval gate
Owner: Store Operations Standards Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1459_Assoc15" sourceRef="W1459_Annotation14" targetRef="W1459_Start6" associationDirection="None" />
