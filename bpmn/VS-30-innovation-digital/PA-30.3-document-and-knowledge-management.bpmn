      <bpmn:sequenceFlow id="W687_Flow23" sourceRef="W687_Task12" targetRef="W687_Task13" />
      <bpmn:sequenceFlow id="W687_Flow24" sourceRef="W687_Task13" targetRef="W687_End14" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W687_diag">
      <bpmndi:BPMNPlane id="W687_plane" bpmnElement="W_W687">
