<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-30.3-document-and-knowledge-management" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W255" name="W255. Electronic Document Storage &amp; Retrieval (ERP-wide)" isExecutable="false">
      <bpmn:documentation>Trigger: A transaction is executed that requires supporting documentation (e.g., Goods Receipt, AP Invoice, Capex Request)
Frequency: Continuous (thousands of documents attached daily)
Volume: ~5,000–10,000 document attachments/day across all entities
Owner: Respective Department Heads (Finance, Procurement, Logistics)
Participants: End Users, ERP Administrator
Source: workflow W255 — Electronic Document Storage &amp; Retrieval (ERP-wide)</bpmn:documentation>
      <bpmn:laneSet id="W255_LaneSet4">
        <bpmn:lane id="W255_Lane1" name="End User">
        <bpmn:flowNodeRef>W255_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W255_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W255_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W255_Lane2" name="System">
        <bpmn:flowNodeRef>W255_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W255_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W255_Lane3" name="Approver">
        <bpmn:flowNodeRef>W255_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W255_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W255_Start5" name="A transaction is executed that requires supporting documentation (e.g., Goods Receipt, AP…">
        <bpmn:outgoing>W255_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W255_Task6" name="Document Capture">
        <bpmn:documentation>Step 1: Document Capture: User receives a physical document (e.g., vendor delivery receipt) and scans it, or receives a digital PDF (e.g., supplier invoice via email)
Responsible (R): End User
Accountable (A): Department Head
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W255_Flow14</bpmn:incoming>
        <bpmn:outgoing>W255_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W255_Task7" name="Transaction Attachment">
        <bpmn:documentation>Step 2: Transaction Attachment: User drags-and-drops or uploads the document directly to the relevant ERP transaction screen (e.g., attaching the scanned DR to the ERP Goods Receipt record)
Responsible (R): End User
Accountable (A): Department Head
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W255_Flow15</bpmn:incoming>
        <bpmn:outgoing>W255_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W255_Task8" name="Metadata Tagging">
        <bpmn:documentation>Step 3: Metadata Tagging: System automatically inherits metadata from the transaction (Transaction ID, Vendor Name, Date, Amount, User ID) for searchability
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W255_Flow16</bpmn:incoming>
        <bpmn:outgoing>W255_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W255_Task9" name="Storage &amp; Linking">
        <bpmn:documentation>Step 4: Storage &amp; Linking: The document is stored in the ERP&#x27;s secure document repository (or linked cloud storage) and visually indicated with a paperclip/attachment icon on the transaction record
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W255_Flow17</bpmn:incoming>
        <bpmn:outgoing>W255_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W255_Task10" name="Retrieval">
        <bpmn:documentation>Step 5: Retrieval: Approvers or Auditors click the attachment icon during workflow review or audit processes to view the source document without requesting physical copies
Responsible (R): Approver / Auditor
Accountable (A): —
Duration: &lt; 30 sec</bpmn:documentation>
        <bpmn:incoming>W255_Flow18</bpmn:incoming>
        <bpmn:outgoing>W255_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W255_End11" name="Complete">
        <bpmn:incoming>W255_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W255_Annotation12">
        <bpmn:text>Controls: - CTL-333 (ensure controlled execution — Document &amp; Knowledge Management (PA-30.3).) | - operational: Respective Department Heads (Finance, Procurement, Logistics) review and approval gate
Owner: Respective Department Heads (Finance, Procurement, Logistics)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W255_Assoc13" sourceRef="W255_Annotation12" targetRef="W255_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W255_Flow14" sourceRef="W255_Start5" targetRef="W255_Task6" />
      <bpmn:sequenceFlow id="W255_Flow15" sourceRef="W255_Task6" targetRef="W255_Task7" />
      <bpmn:sequenceFlow id="W255_Flow16" sourceRef="W255_Task7" targetRef="W255_Task8" />
      <bpmn:sequenceFlow id="W255_Flow17" sourceRef="W255_Task8" targetRef="W255_Task9" />
      <bpmn:sequenceFlow id="W255_Flow18" sourceRef="W255_Task9" targetRef="W255_Task10" />
      <bpmn:sequenceFlow id="W255_Flow19" sourceRef="W255_Task10" targetRef="W255_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W255_diag">
      <bpmndi:BPMNPlane id="W255_plane" bpmnElement="W_W255">
        <bpmndi:BPMNShape id="W255_Lane1_di" bpmnElement="W255_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W255_Lane2_di" bpmnElement="W255_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W255_Lane3_di" bpmnElement="W255_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W255_Task6_di" bpmnElement="W255_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W255_Task7_di" bpmnElement="W255_Task7"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W255_Task8_di" bpmnElement="W255_Task8"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W255_Task9_di" bpmnElement="W255_Task9"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W255_Task10_di" bpmnElement="W255_Task10"><dc:Bounds x="1240" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W255_Start5_di" bpmnElement="W255_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W255_End11_di" bpmnElement="W255_End11"><dc:Bounds x="1470" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W255_Annotation12_di" bpmnElement="W255_Annotation12"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W255_Flow14_di" bpmnElement="W255_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W255_Flow15_di" bpmnElement="W255_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W255_Flow16_di" bpmnElement="W255_Flow16"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W255_Flow17_di" bpmnElement="W255_Flow17"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W255_Flow18_di" bpmnElement="W255_Flow18"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W255_Flow19_di" bpmnElement="W255_Flow19"><di:waypoint x="1420" y="505" /><di:waypoint x="1470" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W255_Assoc13_di" bpmnElement="W255_Assoc13"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W256" name="W256. Enterprise Document Retention &amp; Archiving Policy" isExecutable="false">
      <bpmn:documentation>Trigger: End of fiscal year and periodic archiving schedules
Frequency: Annual batch process
Volume: ~500,000+ documents archived annually
Owner: Legal &amp; Compliance Officer
Participants: Finance Controller, IT Database Administrator
Source: workflow W256 — Enterprise Document Retention &amp; Archiving Policy</bpmn:documentation>
      <bpmn:laneSet id="W256_LaneSet4">
        <bpmn:lane id="W256_Lane1" name="Legal Officer">
        <bpmn:flowNodeRef>W256_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W256_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W256_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W256_Lane2" name="System">
        <bpmn:flowNodeRef>W256_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W256_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W256_Lane3" name="IT DBA">
        <bpmn:flowNodeRef>W256_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W256_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W256_Start5" name="End of fiscal year and periodic archiving schedules">
        <bpmn:outgoing>W256_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W256_Task6" name="Policy Definition">
        <bpmn:documentation>Step 1: Policy Definition: Legal Officer defines retention rules in the ERP DMS (e.g., Financial Invoices: 10 years per BIR regulation; HR records: 5 years post-separation)
Responsible (R): Legal Officer
Accountable (A): Legal Officer
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W256_Flow14</bpmn:incoming>
        <bpmn:outgoing>W256_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W256_Task7" name="Automated Aging">
        <bpmn:documentation>Step 2: Automated Aging: ERP DMS continuously monitors document creation dates against the retention policy matrix
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W256_Flow15</bpmn:incoming>
        <bpmn:outgoing>W256_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W256_Task8" name="Archiving Run">
        <bpmn:documentation>Step 3: Archiving Run: At fiscal year-end, IT DBA triggers the archiving utility. Documents exceeding the &quot;active&quot; threshold (e.g., 2 years) are compressed and moved to cold storage (cheaper storage tier), but remain accessible via slow-retrieval query
Responsible (R): IT DBA
Accountable (A): IT DBA
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W256_Flow16</bpmn:incoming>
        <bpmn:outgoing>W256_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W256_Task9" name="Legal Hold">
        <bpmn:documentation>Step 4: Legal Hold: For entities under active BIR audit or litigation, Legal Officer places a &quot;Legal Hold&quot; on the location/vendor, overriding automated deletion rules
Responsible (R): Legal Officer
Accountable (A): Legal &amp; Compliance Officer
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W256_Flow17</bpmn:incoming>
        <bpmn:outgoing>W256_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W256_Task10" name="Purge/Destruction">
        <bpmn:documentation>Step 5: Purge/Destruction: Documents reaching the absolute end of their legal retention period (e.g., 10 years + 1 day) are permanently purged from all tiers. IT generates a Certificate of Digital Destruction for compliance records
Responsible (R): System
Accountable (A): IT DBA
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W256_Flow18</bpmn:incoming>
        <bpmn:outgoing>W256_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W256_End11" name="Complete">
        <bpmn:incoming>W256_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W256_Annotation12">
        <bpmn:text>Controls: - CTL-333 (ensure controlled execution — Document &amp; Knowledge Management (PA-30.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Legal &amp; Compliance Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W256_Assoc13" sourceRef="W256_Annotation12" targetRef="W256_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W256_Flow14" sourceRef="W256_Start5" targetRef="W256_Task6" />
      <bpmn:sequenceFlow id="W256_Flow15" sourceRef="W256_Task6" targetRef="W256_Task7" />
      <bpmn:sequenceFlow id="W256_Flow16" sourceRef="W256_Task7" targetRef="W256_Task8" />
      <bpmn:sequenceFlow id="W256_Flow17" sourceRef="W256_Task8" targetRef="W256_Task9" />
      <bpmn:sequenceFlow id="W256_Flow18" sourceRef="W256_Task9" targetRef="W256_Task10" />
      <bpmn:sequenceFlow id="W256_Flow19" sourceRef="W256_Task10" targetRef="W256_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W256_diag">
      <bpmndi:BPMNPlane id="W256_plane" bpmnElement="W_W256">
        <bpmndi:BPMNShape id="W256_Lane1_di" bpmnElement="W256_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W256_Lane2_di" bpmnElement="W256_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W256_Lane3_di" bpmnElement="W256_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W256_Task6_di" bpmnElement="W256_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W256_Task7_di" bpmnElement="W256_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W256_Task8_di" bpmnElement="W256_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W256_Task9_di" bpmnElement="W256_Task9"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W256_Task10_di" bpmnElement="W256_Task10"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W256_Start5_di" bpmnElement="W256_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W256_End11_di" bpmnElement="W256_End11"><dc:Bounds x="1470" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W256_Annotation12_di" bpmnElement="W256_Annotation12"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W256_Flow14_di" bpmnElement="W256_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W256_Flow15_di" bpmnElement="W256_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W256_Flow16_di" bpmnElement="W256_Flow16"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W256_Flow17_di" bpmnElement="W256_Flow17"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W256_Flow18_di" bpmnElement="W256_Flow18"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W256_Flow19_di" bpmnElement="W256_Flow19"><di:waypoint x="1420" y="335" /><di:waypoint x="1470" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W256_Assoc13_di" bpmnElement="W256_Assoc13"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W686" name="W686. Document Approval Routing &amp; Digital Signature Management" isExecutable="false">
      <bpmn:documentation>Trigger: Document requiring multi-level approval is created or received (contracts, purchase orders above threshold, board resolutions, BIR filings)
Frequency: Continuous (~200–300 approval workflows/day enterprise-wide)
Volume: ~60,000–75,000 routed documents/year across 200 stores, 4 DCs, and HQ
Owner: ERP Administrator (system config); Department Heads (workflow ownership)
Participants: Originators, Approvers (multi-level), Legal, Compliance, Internal Audit
Source: workflow W686 — Document Approval Routing &amp; Digital Signature Management</bpmn:documentation>
      <bpmn:laneSet id="W686_LaneSet5">
        <bpmn:lane id="W686_Lane1" name="Originator">
        <bpmn:flowNodeRef>W686_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W686_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W686_Lane2" name="System">
        <bpmn:flowNodeRef>W686_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W686_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W686_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W686_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W686_Lane3" name="Approver">
        <bpmn:flowNodeRef>W686_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W686_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W686_Lane4" name="ERP Administrator">
        <bpmn:flowNodeRef>W686_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W686_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W686_Start6" name="Document requiring multi-level approval is created or received (contracts, purchase…">
        <bpmn:outgoing>W686_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W686_Task7" name="Originator submits document">
        <bpmn:documentation>Step 1: Originator submits document: user creates or uploads document in ERP (contract, PO, expense report, BIR filing); system auto-classifies document type and identifies required approval chain based on DOA matrix (e.g., PO &lt;PHP 50K: Store Manager approves; PHP 50K-500K: Category Manager + Procurement Manager; &gt;PHP 500K: VP Supply Chain + CFO)
Responsible (R): Originator
Accountable (A): Department Head
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W686_Flow18</bpmn:incoming>
        <bpmn:outgoing>W686_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W686_Task8" name="System routes to first approver">
        <bpmn:documentation>Step 2: System routes to first approver: ERP pushes approval notification to assigned approver via email, mobile app, and in-app alert; includes document preview, amount, requester, and deadline; SLA timer starts (standard: 24 hours for routine, 4 hours for urgent, 1 hour for critical)
Responsible (R): System
Accountable (A): ERP Administrator
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W686_Flow19</bpmn:incoming>
        <bpmn:outgoing>W686_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W686_Task9" name="Approver reviews and acts">
        <bpmn:documentation>Step 3: Approver reviews and acts: approver opens document, reviews content and supporting attachments, and selects Approve, Reject (with reason), or Request Revision; digital signature is applied automatically upon approval action using approver&#x27;s registered credentials
Responsible (R): Approver
Accountable (A): —
Duration: 5-15 min</bpmn:documentation>
        <bpmn:incoming>W686_Flow20</bpmn:incoming>
        <bpmn:outgoing>W686_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W686_Task10" name="Escalation for overdue approvals">
        <bpmn:documentation>Step 4: Escalation for overdue approvals: if approver does not act within SLA window, system escalates: (a) first escalation: reminder to approver + notification to approver&#x27;s supervisor; (b) second escalation (after 2× SLA): auto-route to designated alternate approver per delegation rules; (c) critical items: escalation to Department Head and VP level
Responsible (R): System
Accountable (A): ERP Administrator
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W686_Flow21</bpmn:incoming>
        <bpmn:outgoing>W686_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W686_Task11" name="Delegation-of-authority management">
        <bpmn:documentation>Step 5: Delegation-of-authority management: approver going on leave configures delegation in system — designates alternate approver with same authority level, specifies delegation period; system routes approvals to delegate during delegation window; all delegate actions logged with original approver&#x27;s authority
Responsible (R): Approver / ERP Admin
Accountable (A): Department Head
Duration: 10 min per delegation setup</bpmn:documentation>
        <bpmn:incoming>W686_Flow22</bpmn:incoming>
        <bpmn:outgoing>W686_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W686_Task12" name="Multi-entity routing">
        <bpmn:documentation>Step 6: Multi-entity routing: for documents affecting multiple BuildRight entities (e.g., intercompany agreements, shared services invoices), system routes to approvers in each relevant entity per W442 intercompany framework; all entity approvals must complete before document is finalized
Responsible (R): System / Multi-entity Approvers
Accountable (A): VP Legal
Duration: 1-2 days</bpmn:documentation>
        <bpmn:incoming>W686_Flow23</bpmn:incoming>
        <bpmn:outgoing>W686_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W686_Task13" name="Digital signature verification">
        <bpmn:documentation>Step 7: Digital signature verification: system maintains digital signature registry for all authorized signatories: (a) registration: each signatory enrolls with verified identity (government ID + biometric); (b) usage: each approval action applies digital signature with timestamp, IP address, device ID; (c) verification: any party can verify signature authenticity; (d) BIR compliance: digital signatures comply with BIR e-invoicing requirements and Electronic Commerce Act (RA 8792)
Responsible (R): ERP Administrator
Accountable (A): VP Legal
Duration: Initial setup: 2 hours; ongoing: automated</bpmn:documentation>
        <bpmn:incoming>W686_Flow24</bpmn:incoming>
        <bpmn:outgoing>W686_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W686_Task14" name="Audit trail &amp; compliance reporting">
        <bpmn:documentation>Step 8: Audit trail &amp; compliance reporting: system maintains immutable audit trail for every approval action: who approved, when, from what device, with what authority level, any delegation chain; quarterly, Internal Audit reviews approval audit trails for segregation-of-duties violations per W359 SOD monitoring
Responsible (R): System / Internal Audit
Accountable (A): VP Legal
Duration: Quarterly: 4-6 hours</bpmn:documentation>
        <bpmn:incoming>W686_Flow25</bpmn:incoming>
        <bpmn:outgoing>W686_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W686_End15" name="Complete">
        <bpmn:incoming>W686_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W686_Annotation16">
        <bpmn:text>Controls: - CTL-333 (ensure controlled execution — Document &amp; Knowledge Management (PA-30.3).) | - operational: audit trail monitoring and quarterly SOD review per W359; operational: verified identity enrollment and secure credential management; operational: MFA requirement and device registration
Owner: ERP Administrator (system config); Department Heads (workflow ownership)</bpmn:text>
      </bpmn:textAnnotation>
