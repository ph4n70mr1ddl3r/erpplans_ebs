        <bpmndi:BPMNEdge id="W3842_Assoc9_di" bpmnElement="W3842_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3843" name="W3843. New-Product Launch Enablement &amp; Rapid Knowledge Rollout" isExecutable="false">
      <bpmn:documentation>Trigger: New product/category launch (links to VS-01.1); promotion (links to VS-14)
Frequency: Per launch
Volume: New-product enablement events
Owner: Sales Enablement / Merchandising
Participants: Sales Enablement, Merchandising (links to VS-01), Marketing (links to VS-14), Store Ops (links to VS-07), L&amp;D (links to VS-19.4), Store Comms (links to VS-63), Vendors
Source: workflow W3843 — New-Product Launch Enablement &amp; Rapid Knowledge Rollout</bpmn:documentation>
      <bpmn:laneSet id="W3843_LaneSet2">
        <bpmn:lane id="W3843_Lane1" name="Sales Enablement">
        <bpmn:flowNodeRef>W3843_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3843_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3843_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3843_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3843_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3843_Start3" name="New product/category launch (links to VS-01.1); promotion (links to VS-14)">
        <bpmn:outgoing>W3843_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3843_Task4" name="Sales Enablement/Merchandising build launch enablement for new…">
        <bpmn:documentation>Step 1: Sales Enablement/Merchandising build launch enablement for new products/categories: key features/benefits, target customer/job, differentiation, pricing/promo (links to VS-01.2/VS-14), attach opportunities, and common questions/objections — produced ahead of launch
Responsible (R): Sales Enablement / Merchandising / Marketing
Accountable (A): Sales Enablement Lead
Duration: Per launch</bpmn:documentation>
        <bpmn:incoming>W3843_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3843_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3843_Task5" name="Sales Enablement/Store-Comms roll out the knowledge rapidly to ~200 stores via…">
        <bpmn:documentation>Step 2: Sales Enablement/Store-Comms roll out the knowledge rapidly to ~200 stores via mobile/micro-learning (links to W3839), store comms/tasking (links to VS-63), pre-shift huddles, and vendor training where relevant (links to W3848), timed to the launch/planogram reset (links to VS-55)
Responsible (R): Sales Enablement / Store Ops / Store Comms
Accountable (A): Sales Enablement Lead
Duration: Per launch</bpmn:documentation>
        <bpmn:incoming>W3843_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3843_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3843_Task6" name="Sales Enablement/Analytics verify rollout (knowledge-check completion, store…">
        <bpmn:documentation>Step 3: Sales Enablement/Analytics verify rollout (knowledge-check completion, store coverage) and track new-product sell-through and attach (links to W3849/VS-01.1), feeding launch learning back to merchandising
Responsible (R): Sales Enablement / Analytics / Merchandising
Accountable (A): Sales Enablement Lead
Duration: Per launch</bpmn:documentation>
        <bpmn:incoming>W3843_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3843_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3843_End7" name="Complete">
        <bpmn:incoming>W3843_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3843_Annotation8">
        <bpmn:text>Controls: - CTL-602 (ensure controlled execution — Product Knowledge Mastery, Certification &amp; Clienteling Tools (PA-124.2).) | - operational: rapid/mobile rollout; operational: launch enablement and sell-through tracking
Owner: Sales Enablement / Merchandising</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3843_Assoc9" sourceRef="W3843_Annotation8" targetRef="W3843_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3843_Flow10" sourceRef="W3843_Start3" targetRef="W3843_Task4" />
      <bpmn:sequenceFlow id="W3843_Flow11" sourceRef="W3843_Task4" targetRef="W3843_Task5" />
      <bpmn:sequenceFlow id="W3843_Flow12" sourceRef="W3843_Task5" targetRef="W3843_Task6" />
      <bpmn:sequenceFlow id="W3843_Flow13" sourceRef="W3843_Task6" targetRef="W3843_End7" />
    </bpmn:process>
