    <bpmn:process id="W_W3842" name="W3842. Product Knowledge Certification, Assessment &amp; Recertification" isExecutable="false">
      <bpmn:documentation>Trigger: Mastery standards (W3841); certification cycle
Frequency: Per certification + periodic recertification
Volume: ~5,800 frontline staff
Owner: Sales Enablement / L&amp;D
Participants: Sales Enablement, L&amp;D (links to VS-19.4/W683/W1127), Store Ops (links to VS-07), Merchandising (links to VS-01), HR (links to VS-103), Master Associates
Source: workflow W3842 — Product Knowledge Certification, Assessment &amp; Recertification</bpmn:documentation>
      <bpmn:laneSet id="W3842_LaneSet2">
        <bpmn:lane id="W3842_Lane1" name="Sales Enablement">
        <bpmn:flowNodeRef>W3842_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3842_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3842_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3842_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3842_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3842_Start3" name="Mastery standards (W3841); certification cycle">
        <bpmn:outgoing>W3842_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3842_Task4" name="Sales Enablement/L&amp;D design product-knowledge certification per…">
        <bpmn:documentation>Step 1: Sales Enablement/L&amp;D design product-knowledge certification per role/department: knowledge checks (quizzes), practical demonstration (e.g., specify the right tile adhesive for a substrate, the right wire gauge for a load, tint a paint sample), and scenario-based assessment — distinct from general competency (links to VS-19.4/W683)
Responsible (R): Sales Enablement / L&amp;D / Master Associates
Accountable (A): Sales Enablement Lead
Duration: Per role</bpmn:documentation>
        <bpmn:incoming>W3842_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3842_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3842_Task5" name="Sales Enablement/L&amp;D deliver certification (via OLA/mobile links to…">
        <bpmn:documentation>Step 2: Sales Enablement/L&amp;D deliver certification (via OLA/mobile links to W3839/VS-19.4), capture results (links to W683/W3841), and recognize certified associates (recognition links to W630, compensation links to VS-102 where applicable)
Responsible (R): Sales Enablement / L&amp;D / HR
Accountable (A): Sales Enablement Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3842_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3842_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3842_Task6" name="Sales Enablement/L&amp;D manage periodic recertification (links to W1127 annual…">
        <bpmn:documentation>Step 3: Sales Enablement/L&amp;D manage periodic recertification (links to W1127 annual re-certification), remediation for not-yet-certified associates, and coverage analytics (certified % per department/store — links to W3849)
Responsible (R): Sales Enablement / L&amp;D
Accountable (A): Sales Enablement Lead
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W3842_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3842_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3842_End7" name="Complete">
        <bpmn:incoming>W3842_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3842_Annotation8">
        <bpmn:text>Controls: - CTL-88 (ensure selling-quality &amp; training integrity.) | - operational: practical/scenario assessment; operational: coverage analytics
Owner: Sales Enablement / L&amp;D</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3842_Assoc9" sourceRef="W3842_Annotation8" targetRef="W3842_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3842_Flow10" sourceRef="W3842_Start3" targetRef="W3842_Task4" />
      <bpmn:sequenceFlow id="W3842_Flow11" sourceRef="W3842_Task4" targetRef="W3842_Task5" />
      <bpmn:sequenceFlow id="W3842_Flow12" sourceRef="W3842_Task5" targetRef="W3842_Task6" />
      <bpmn:sequenceFlow id="W3842_Flow13" sourceRef="W3842_Task6" targetRef="W3842_End7" />
    </bpmn:process>
