      <bpmn:sequenceFlow id="W3835_Flow11" sourceRef="W3835_Task4" targetRef="W3835_Task5" />
      <bpmn:sequenceFlow id="W3835_Flow12" sourceRef="W3835_Task5" targetRef="W3835_Task6" />
      <bpmn:sequenceFlow id="W3835_Flow13" sourceRef="W3835_Task6" targetRef="W3835_End7" />
    </bpmn:process>
