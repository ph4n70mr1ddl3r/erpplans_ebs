<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-124.1-sales-enablement-strategy-content-and-coaching-framework" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3833" name="W3833. Sales Enablement Strategy, Operating Model &amp; Governance" isExecutable="false">
      <bpmn:documentation>Trigger: Annual strategy (links to VS-33.1); capability review
Frequency: Annual + on change
Volume: Enterprise sales-enablement strategy
Owner: Sales Enablement / Store Ops
Participants: Sales Enablement, Store Ops (links to VS-07), Merchandising (links to VS-01), Marketing (links to VS-14), L&amp;D (links to VS-19.4), HR (links to VS-19/VS-103), In-Store Services (links to VS-09), Finance (links to VS-17.4)
Source: workflow W3833 — Sales Enablement Strategy, Operating Model &amp; Governance</bpmn:documentation>
      <bpmn:laneSet id="W3833_LaneSet3">
        <bpmn:lane id="W3833_Lane1" name="Sales Enablement">
        <bpmn:flowNodeRef>W3833_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3833_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3833_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3833_Lane2" name="COO">
        <bpmn:flowNodeRef>W3833_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3833_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3833_Start4" name="Annual strategy (links to VS-33.1); capability review">
        <bpmn:outgoing>W3833_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3833_Task5" name="Sales Enablement/Store-Ops define the sales-enablement strategy: target selling…">
        <bpmn:documentation>Step 1: Sales Enablement/Store-Ops define the sales-enablement strategy: target selling outcomes (basket size, conversion, attach rate, trade-pro capture, service attach), the capability model for associates (product knowledge + selling skills + clienteling + tools), the operating model (central enablement team + store-level coaches), and KPIs aligned to merchandise/commercial plan (links to VS-101/VS-33.2)
Responsible (R): Sales Enablement / Store Ops
Accountable (A): COO / CMO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3833_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3833_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3833_Task6" name="Sales Enablement establish governance: enablement steering (Store Ops…">
        <bpmn:documentation>Step 2: Sales Enablement establish governance: enablement steering (Store Ops, Merchandising, Marketing, L&amp;D, HR), cadence, integration to L&amp;D (links to VS-19.4), merchandising (links to VS-01.1 assortment/pricing), and marketing campaigns (links to VS-14.1), and the link to incentive/compensation (links to VS-102/W3838)
Responsible (R): Sales Enablement / Store Ops / HR
Accountable (A): COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3833_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3833_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3833_Task7" name="COO/Executive ratify the strategy, approve the enablement budget (links to…">
        <bpmn:documentation>Step 3: COO/Executive ratify the strategy, approve the enablement budget (links to W3840), and cascade to store/category leadership as a commercial priority
Responsible (R): COO / Sales Enablement
Accountable (A): CEO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3833_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3833_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3833_End8" name="Complete">
        <bpmn:incoming>W3833_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3833_Annotation9">
        <bpmn:text>Controls: - CTL-88 (ensure selling-quality &amp; training integrity.) | - operational: enablement strategy; operational: KPI linkage
Owner: Sales Enablement / Store Ops</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3833_Assoc10" sourceRef="W3833_Annotation9" targetRef="W3833_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3833_Flow11" sourceRef="W3833_Start4" targetRef="W3833_Task5" />
      <bpmn:sequenceFlow id="W3833_Flow12" sourceRef="W3833_Task5" targetRef="W3833_Task6" />
      <bpmn:sequenceFlow id="W3833_Flow13" sourceRef="W3833_Task6" targetRef="W3833_Task7" />
      <bpmn:sequenceFlow id="W3833_Flow14" sourceRef="W3833_Task7" targetRef="W3833_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3833_diag">
      <bpmndi:BPMNPlane id="W3833_plane" bpmnElement="W_W3833">
        <bpmndi:BPMNShape id="W3833_Lane1_di" bpmnElement="W3833_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
