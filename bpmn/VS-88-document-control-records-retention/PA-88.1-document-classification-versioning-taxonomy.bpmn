    <bpmn:process id="W_W2969" name="W2969. Enterprise Document Taxonomy &amp; Classification Scheme Maintenance" isExecutable="false">
      <bpmn:documentation>Trigger: Annual review or new document type
Frequency: Annual + event-driven
Volume: ~200–300 document types
Owner: Records Manager
Participants: Records Mgr, Compliance, IT, Department Owners
Source: workflow W2969 — Enterprise Document Taxonomy &amp; Classification Scheme Maintenance</bpmn:documentation>
      <bpmn:laneSet id="W2969_LaneSet4">
        <bpmn:lane id="W2969_Lane1" name="Records Manager">
        <bpmn:flowNodeRef>W2969_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2969_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
