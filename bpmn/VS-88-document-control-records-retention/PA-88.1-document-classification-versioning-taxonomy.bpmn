    <bpmn:process id="W_W2970" name="W2970. Document Capture, Indexing &amp; Metadata Tagging" isExecutable="false">
      <bpmn:documentation>Trigger: Document created or received
Frequency: Continuous
Volume: ~100,000+ documents/year
Owner: Department Records Custodian
Participants: Records Custodian, IT
Source: workflow W2970 — Document Capture, Indexing &amp; Metadata Tagging</bpmn:documentation>
      <bpmn:laneSet id="W2970_LaneSet3">
        <bpmn:lane id="W2970_Lane1" name="Records Custodian">
        <bpmn:flowNodeRef>W2970_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2970_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2970_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2970_Lane2" name="IT">
        <bpmn:flowNodeRef>W2970_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2970_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2970_Start4" name="Document created or received">
        <bpmn:outgoing>W2970_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2970_Task5" name="Records Custodian captures document in repository (scan/email-intake/upload)…">
        <bpmn:documentation>Step 1: Records Custodian captures document in repository (scan/email-intake/upload); applies metadata (date, type, counterparty, period, entity)
Responsible (R): Records Custodian
Accountable (A): Records Manager
Duration: Per document</bpmn:documentation>
        <bpmn:incoming>W2970_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2970_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2970_Task6" name="IT auto-tags via OCR/classification where possible; validates against taxonomy…">
        <bpmn:documentation>Step 2: IT auto-tags via OCR/classification where possible; validates against taxonomy; flags incomplete metadata
Responsible (R): IT
Accountable (A): Records Manager
Duration: Per batch</bpmn:documentation>
        <bpmn:incoming>W2970_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2970_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2970_Task7" name="Records Custodian declares record status (official copy) where applicable…">
        <bpmn:documentation>Step 3: Records Custodian declares record status (official copy) where applicable; links to authoritative transaction in ERP
Responsible (R): Records Custodian
Accountable (A): Records Manager
Duration: Per document</bpmn:documentation>
        <bpmn:incoming>W2970_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2970_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2970_End8" name="Complete">
        <bpmn:incoming>W2970_Flow14</bpmn:incoming>
      </bpmn:endEvent>
