    <bpmn:process id="W_W2972" name="W2972. Document Access Control, Permissions &amp; Confidentiality Tiering" isExecutable="false">
      <bpmn:documentation>Trigger: Access request or annual review
Frequency: Continuous + quarterly review
Volume: ~6,911 users; ~200–300 document classes
Owner: IT Security Manager
Participants: IT Security, Records Manager, HR
Source: workflow W2972 — Document Access Control, Permissions &amp; Confidentiality Tiering</bpmn:documentation>
      <bpmn:laneSet id="W2972_LaneSet3">
        <bpmn:lane id="W2972_Lane1" name="Records Manager">
        <bpmn:flowNodeRef>W2972_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2972_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2972_Lane2" name="IT Security">
        <bpmn:flowNodeRef>W2972_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2972_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2972_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2972_Start4" name="Access request or annual review">
        <bpmn:outgoing>W2972_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2972_Task5" name="Records Manager assigns confidentiality tier (Public, Internal, Confidential…">
        <bpmn:documentation>Step 1: Records Manager assigns confidentiality tier (Public, Internal, Confidential, Restricted) per document class
Responsible (R): Records Manager
Accountable (A): Compliance Officer
Duration: Per class</bpmn:documentation>
        <bpmn:incoming>W2972_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2972_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2972_Task6" name="IT Security enforces role-based access by tier; manages permissions; logs…">
        <bpmn:documentation>Step 2: IT Security enforces role-based access by tier; manages permissions; logs access to Confidential/Restricted
Responsible (R): IT Security
Accountable (A): IT Security Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W2972_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2972_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2972_Task7" name="IT Security/HR reviews access quarterly; revokes on role change/separation…">
        <bpmn:documentation>Step 3: IT Security/HR reviews access quarterly; revokes on role change/separation; audits access logs for anomalies
Responsible (R): IT Security / HR
Accountable (A): IT Security Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2972_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2972_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2972_End8" name="Complete">
        <bpmn:incoming>W2972_Flow14</bpmn:incoming>
      </bpmn:endEvent>
