        <bpmn:flowNodeRef>W2969_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2969_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2969_Start5" name="Annual review or new document type">
        <bpmn:outgoing>W2969_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2969_Task6" name="Records Manager maintains enterprise taxonomy: document class (financial, HR…">
        <bpmn:documentation>Step 1: Records Manager maintains enterprise taxonomy: document class (financial, HR, legal, tax, contract, operational), subtype, confidentiality, retention class
Responsible (R): Records Manager
Accountable (A): Compliance Officer
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2969_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2969_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2969_Task7" name="Department Owners validate taxonomy covers their records; Records Manager maps…">
        <bpmn:documentation>Step 2: Department Owners validate taxonomy covers their records; Records Manager maps each class to retention rule and authoritative system
Responsible (R): Department Owners
Accountable (A): Records Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2969_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2969_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2969_Task8" name="IT configures taxonomy in document management system; enforces classification…">
        <bpmn:documentation>Step 3: IT configures taxonomy in document management system; enforces classification at capture
Responsible (R): IT
Accountable (A): Records Manager
Duration: Per change</bpmn:documentation>
        <bpmn:incoming>W2969_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2969_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2969_End9" name="Complete">
        <bpmn:incoming>W2969_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2969_Annotation10">
        <bpmn:text>Controls: - CTL-493 (ensure controlled execution — Document Classification, Versioning &amp; Taxonomy (PA-88.1).) | - operational: structured classification scheme
Owner: Records Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2969_Assoc11" sourceRef="W2969_Annotation10" targetRef="W2969_Start5" associationDirection="None" />
