    <bpmn:process id="W_W2971" name="W2971. Version Control, Check-Out/In &amp; Authoritative Source Management" isExecutable="false">
      <bpmn:documentation>Trigger: Document revision
Frequency: Event-driven
Volume: Policy/contract/procedure documents
Owner: Document Owner
Participants: Document Owner, Records Manager
Source: workflow W2971 — Version Control, Check-Out/In &amp; Authoritative Source Management</bpmn:documentation>
      <bpmn:laneSet id="W2971_LaneSet3">
        <bpmn:lane id="W2971_Lane1" name="Document Owner">
        <bpmn:flowNodeRef>W2971_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2971_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2971_Lane2" name="Records Manager">
        <bpmn:flowNodeRef>W2971_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2971_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2971_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2971_Start4" name="Document revision">
        <bpmn:outgoing>W2971_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2971_Task5" name="Document Owner checks out controlled document; edits; tracks changes; checks in…">
        <bpmn:documentation>Step 1: Document Owner checks out controlled document; edits; tracks changes; checks in new version
Responsible (R): Document Owner
Accountable (A): Document Owner
Duration: Per revision</bpmn:documentation>
        <bpmn:incoming>W2971_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2971_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2971_Task6" name="Records Manager maintains version history and supersedence; ensures only…">
        <bpmn:documentation>Step 2: Records Manager maintains version history and supersedence; ensures only current version is active; archives prior versions
Responsible (R): Records Manager
Accountable (A): Records Manager
Duration: Per revision</bpmn:documentation>
        <bpmn:incoming>W2971_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2971_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2971_Task7" name="Records Manager designates authoritative source for each record class (e.g…">
        <bpmn:documentation>Step 3: Records Manager designates authoritative source for each record class (e.g., ERP invoice is authoritative; PDF copy is reference)
Responsible (R): Records Manager
Accountable (A): Compliance Officer
Duration: Per class</bpmn:documentation>
        <bpmn:incoming>W2971_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2971_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2971_End8" name="Complete">
        <bpmn:incoming>W2971_Flow14</bpmn:incoming>
      </bpmn:endEvent>
