    <bpmn:process id="W_W3048" name="W3048. Minors&#x27; Data, Sensitive Data &amp; Special Category Processing Controls" isExecutable="false">
      <bpmn:documentation>Trigger: Processing involving minors or sensitive/special-category data
Frequency: Event-driven + annual review
Volume: Limited; high-sensitivity
Owner: Data Protection Officer (DPO)
Participants: DPO, Legal, HR, Marketing, Customer Service
Source: workflow W3048 — Minors&#x27; Data, Sensitive Data &amp; Special Category Processing Controls</bpmn:documentation>
      <bpmn:laneSet id="W3048_LaneSet3">
        <bpmn:lane id="W3048_Lane1" name="DPO">
        <bpmn:flowNodeRef>W3048_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3048_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3048_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3048_Lane2" name="IT">
        <bpmn:flowNodeRef>W3048_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3048_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3048_Start4" name="Processing involving minors or sensitive/special-category data">
        <bpmn:outgoing>W3048_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3048_Task5" name="DPO/Legal identify processing involving minors (e.g., student/community…">
        <bpmn:documentation>Step 1: DPO/Legal identify processing involving minors (e.g., student/community programs) or sensitive data (health-related wellness, biometrics, government IDs); apply heightened controls
Responsible (R): DPO / Legal
Accountable (A): DPO
Duration: Per processing + annual</bpmn:documentation>
        <bpmn:incoming>W3048_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3048_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3048_Task6" name="IT/Process Owners apply enhanced controls: explicit consent, access…">
        <bpmn:documentation>Step 2: IT/Process Owners apply enhanced controls: explicit consent, access restriction, encryption, minimization, and shorter retention for sensitive data
Responsible (R): IT / Process Owners
Accountable (A): DPO
Duration: Per processing</bpmn:documentation>
        <bpmn:incoming>W3048_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3048_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3048_Task7" name="DPO audits special-category processing for compliance; restricts use; documents…">
        <bpmn:documentation>Step 3: DPO audits special-category processing for compliance; restricts use; documents lawful basis (consent or limited legitimate grounds)
Responsible (R): DPO
Accountable (A): DPO
Duration: Annual + event</bpmn:documentation>
        <bpmn:incoming>W3048_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3048_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3048_End8" name="Complete">
        <bpmn:incoming>W3048_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3048_Annotation9">
        <bpmn:text>Controls: - CTL-153 (ensure privacy consent, DSAR &amp; processor oversight.) | - operational: minimization and enhanced controls
Owner: Data Protection Officer (DPO)</bpmn:text>
      </bpmn:textAnnotation>
