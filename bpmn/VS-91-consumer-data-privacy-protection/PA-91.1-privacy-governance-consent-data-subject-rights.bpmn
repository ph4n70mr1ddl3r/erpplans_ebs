<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-91.1-privacy-governance-consent-data-subject-rights" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3041" name="W3041. Data Privacy Program Governance, NPC Registration &amp; DPO Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Program setup, annual review, or regulatory change
Frequency: Continuous + annual review
Volume: Enterprise-wide; 1 DPO, ~5 legal entities
Owner: Data Protection Officer (DPO)
Participants: DPO, Legal, Compliance, IT Security, HR, Marketing, Customer Service
Source: workflow W3041 — Data Privacy Program Governance, NPC Registration &amp; DPO Operations</bpmn:documentation>
      <bpmn:laneSet id="W3041_LaneSet2">
        <bpmn:lane id="W3041_Lane1" name="DPO">
        <bpmn:flowNodeRef>W3041_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3041_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3041_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3041_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3041_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3041_Start3" name="Program setup, annual review, or regulatory change">
        <bpmn:outgoing>W3041_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3041_Task4" name="DPO maintains the privacy program: charter, privacy policy, data governance…">
        <bpmn:documentation>Step 1: DPO maintains the privacy program: charter, privacy policy, data governance framework, and NPC registration/renewal for all 5 legal entities and personal-data processing
Responsible (R): DPO
Accountable (A): VP Legal &amp; Compliance
Duration: Annual + event</bpmn:documentation>
        <bpmn:incoming>W3041_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3041_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3041_Task5" name="DPO chairs the Privacy Steering Committee (Legal, IT Security, HR, Marketing…">
        <bpmn:documentation>Step 2: DPO chairs the Privacy Steering Committee (Legal, IT Security, HR, Marketing, CX); sets risk appetite, priorities, and resourcing; reports to board (links to VS-36)
Responsible (R): DPO
Accountable (A): VP Legal &amp; Compliance
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3041_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3041_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3041_Task6" name="DPO maintains privacy policy and notices across touchpoints (web/app, store…">
        <bpmn:documentation>Step 3: DPO maintains privacy policy and notices across touchpoints (web/app, store signage, loyalty enrollment, CCTV) and ensures lawful-basis documentation per processing activity
Responsible (R): DPO / Legal
Accountable (A): DPO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3041_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3041_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3041_End7" name="Complete">
        <bpmn:incoming>W3041_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3041_Annotation8">
        <bpmn:text>Controls: - CTL-153 (ensure privacy consent, DSAR &amp; processor oversight.) | - operational: dedicated DPO and steering committee
Owner: Data Protection Officer (DPO)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3041_Assoc9" sourceRef="W3041_Annotation8" targetRef="W3041_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3041_Flow10" sourceRef="W3041_Start3" targetRef="W3041_Task4" />
      <bpmn:sequenceFlow id="W3041_Flow11" sourceRef="W3041_Task4" targetRef="W3041_Task5" />
      <bpmn:sequenceFlow id="W3041_Flow12" sourceRef="W3041_Task5" targetRef="W3041_Task6" />
      <bpmn:sequenceFlow id="W3041_Flow13" sourceRef="W3041_Task6" targetRef="W3041_End7" />
    </bpmn:process>
