        <bpmndi:BPMNShape id="W3043_Lane2_di" bpmnElement="W3043_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3043_Lane3_di" bpmnElement="W3043_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
