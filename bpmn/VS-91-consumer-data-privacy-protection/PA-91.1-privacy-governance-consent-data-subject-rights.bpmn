        <bpmndi:BPMNEdge id="W3042_Flow14_di" bpmnElement="W3042_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3042_Flow15_di" bpmnElement="W3042_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3042_Assoc11_di" bpmnElement="W3042_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3043" name="W3043. Consent Capture, Preference Management &amp; Lawful Basis Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Customer data collection / signup / preference change
Frequency: Continuous
Volume: ~600K loyalty + ecommerce/app signups
Owner: Marketing Technology Manager
Participants: Marketing Tech, DPO, Loyalty/CRM, IT, Ecommerce
Source: workflow W3043 — Consent Capture, Preference Management &amp; Lawful Basis Tracking</bpmn:documentation>
      <bpmn:laneSet id="W3043_LaneSet4">
        <bpmn:lane id="W3043_Lane1" name="System">
        <bpmn:flowNodeRef>W3043_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3043_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3043_Lane2" name="IT">
        <bpmn:flowNodeRef>W3043_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3043_Lane3" name="DPO">
        <bpmn:flowNodeRef>W3043_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3043_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3043_Start5" name="Customer data collection / signup / preference change">
        <bpmn:outgoing>W3043_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W3043_Task6" name="Loyalty platform and POS checkout capture consent at enrollment/checkout with…">
        <bpmn:documentation>Step 1: Loyalty platform and POS checkout capture consent at enrollment/checkout with granular purpose flags (marketing, profiling, third-party share, location); record timestamp and version
Responsible (R): System
Accountable (A): Marketing Technology Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W3043_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3043_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W3043_Task7" name="IT maintains consent/preference center allowing customer self-service changes…">
        <bpmn:documentation>Step 2: IT maintains consent/preference center allowing customer self-service changes; syncs preferences across channels (POS, web, app, CRM, email/SMS)
Responsible (R): IT / CRM
Accountable (A): Marketing Technology Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3043_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3043_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3043_Task8" name="DPO audits consent records for lawful-basis coverage; flags processing without…">
        <bpmn:documentation>Step 3: DPO audits consent records for lawful-basis coverage; flags processing without valid consent/legitimate-interest assessment; remediates
Responsible (R): DPO
Accountable (A): DPO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3043_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3043_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3043_End9" name="Complete">
        <bpmn:incoming>W3043_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3043_Annotation10">
        <bpmn:text>Controls: - CTL-153 (ensure privacy consent, DSAR &amp; processor oversight.) | - operational: granular consent capture and quarterly audit
Owner: Marketing Technology Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3043_Assoc11" sourceRef="W3043_Annotation10" targetRef="W3043_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3043_Flow12" sourceRef="W3043_Start5" targetRef="W3043_Task6" />
      <bpmn:sequenceFlow id="W3043_Flow13" sourceRef="W3043_Task6" targetRef="W3043_Task7" />
