    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3042" name="W3042. Personal Data Inventory, Data Mapping &amp; Records of Processing Activities (ROPA)" isExecutable="false">
      <bpmn:documentation>Trigger: Initial build, new processing, or annual refresh
Frequency: Annual + event-driven
Volume: ~600K loyalty + ~5,400 B2B + ecommerce/app/marketplace buyers
Owner: Data Protection Officer (DPO)
Participants: DPO, IT, Data Governance, Business Process Owners
Source: workflow W3042 — Personal Data Inventory, Data Mapping &amp; Records of Processing Activities (ROPA)</bpmn:documentation>
      <bpmn:laneSet id="W3042_LaneSet4">
        <bpmn:lane id="W3042_Lane1" name="DPO">
        <bpmn:flowNodeRef>W3042_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3042_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3042_Lane2" name="IT">
        <bpmn:flowNodeRef>W3042_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3042_Lane3" name="Business Process Owners">
        <bpmn:flowNodeRef>W3042_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3042_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3042_Start5" name="Initial build, new processing, or annual refresh">
        <bpmn:outgoing>W3042_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3042_Task6" name="DPO/Data Governance build/maintain ROPA: data category, source, purpose, lawful…">
        <bpmn:documentation>Step 1: DPO/Data Governance build/maintain ROPA: data category, source, purpose, lawful basis, recipients, retention, cross-border transfer, processor — per processing activity
Responsible (R): DPO / Data Governance
Accountable (A): DPO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3042_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3042_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3042_Task7" name="IT maps data flows across systems (POS, ecommerce, loyalty/CRM, app…">
        <bpmn:documentation>Step 2: IT maps data flows across systems (POS, ecommerce, loyalty/CRM, app, marketplace, CCTV, AP/AR, payroll-adjacent); identifies storage, integrations, and copies
Responsible (R): IT / Data Governance
Accountable (A): DPO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3042_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3042_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3042_Task8" name="Business Process Owners validate ROPA accuracy; DPO publishes and maintains as…">
        <bpmn:documentation>Step 3: Business Process Owners validate ROPA accuracy; DPO publishes and maintains as living register; supports DSAR (W3044) and PIA (W3049)
Responsible (R): Business Process Owners
Accountable (A): DPO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3042_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3042_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3042_End9" name="Complete">
        <bpmn:incoming>W3042_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3042_Annotation10">
        <bpmn:text>Controls: - CTL-502 (ensure controlled execution — Privacy Governance, Consent &amp; Data Subject Rights Fulfillment (PA-91.1).) | - operational: data flow mapping and process-owner validation
Owner: Data Protection Officer (DPO)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3042_Assoc11" sourceRef="W3042_Annotation10" targetRef="W3042_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3042_Flow12" sourceRef="W3042_Start5" targetRef="W3042_Task6" />
      <bpmn:sequenceFlow id="W3042_Flow13" sourceRef="W3042_Task6" targetRef="W3042_Task7" />
      <bpmn:sequenceFlow id="W3042_Flow14" sourceRef="W3042_Task7" targetRef="W3042_Task8" />
      <bpmn:sequenceFlow id="W3042_Flow15" sourceRef="W3042_Task8" targetRef="W3042_End9" />
    </bpmn:process>
