    <bpmn:process id="W_W3056" name="W3056. Privacy Awareness Training &amp; Employee Compliance Program" isExecutable="false">
      <bpmn:documentation>Trigger: Onboarding + annual refresh
Frequency: Annual + onboarding
Volume: ~6,925 employees
Owner: DPO (with HR/L&amp;D)
Participants: DPO, HR/L&amp;D, Compliance, IT Security
Source: workflow W3056 — Privacy Awareness Training &amp; Employee Compliance Program</bpmn:documentation>
      <bpmn:laneSet id="W3056_LaneSet3">
        <bpmn:lane id="W3056_Lane1" name="DPO">
        <bpmn:flowNodeRef>W3056_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3056_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3056_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3056_Lane2" name="HR">
        <bpmn:flowNodeRef>W3056_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3056_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3056_Start4" name="Onboarding + annual refresh">
        <bpmn:outgoing>W3056_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3056_Task5" name="DPO/HR develop role-based privacy training (general awareness, CX/marketing…">
        <bpmn:documentation>Step 1: DPO/HR develop role-based privacy training (general awareness, CX/marketing handling PII, IT/data handlers, executive); deploy via L&amp;D (links to VS-19)
Responsible (R): DPO / HR / L&amp;D
Accountable (A): DPO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3056_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3056_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3056_Task6" name="HR/L&amp;D ensure completion at onboarding and annual refresh; track completion by…">
        <bpmn:documentation>Step 2: HR/L&amp;D ensure completion at onboarding and annual refresh; track completion by role; certify high-risk roles (CX, marketing, IT, finance)
Responsible (R): HR / L&amp;D
Accountable (A): HR Manager
Duration: Per employee</bpmn:documentation>
        <bpmn:incoming>W3056_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3056_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3056_Task7" name="DPO/Compliance run phishing/social-engineering simulations and privacy-incident…">
        <bpmn:documentation>Step 3: DPO/Compliance run phishing/social-engineering simulations and privacy-incident drills; reinforce via comms; track program effectiveness
Responsible (R): DPO / Compliance / IT Security
Accountable (A): DPO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3056_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3056_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3056_End8" name="Complete">
        <bpmn:incoming>W3056_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3056_Annotation9">
        <bpmn:text>Controls: - CTL-503 (ensure controlled execution — Privacy Impact Assessment, Data Mapping &amp; Vendor Privacy Due Diligence (PA-91.2).) | - operational: role-based training and simulations
Owner: DPO (with HR/L&amp;D)</bpmn:text>
      </bpmn:textAnnotation>
