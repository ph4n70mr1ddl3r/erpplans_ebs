        <bpmn:outgoing>W3054_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3054_Task6" name="Data Governance/DPO determine de-identification/anonymization technique for…">
        <bpmn:documentation>Step 1: Data Governance/DPO determine de-identification/anonymization technique for each analytics use case; validate re-identification risk
Responsible (R): Data Governance / DPO
Accountable (A): Data Governance Manager
Duration: Per use case</bpmn:documentation>
        <bpmn:incoming>W3054_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3054_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3054_Task7" name="IT/Data Analytics apply techniques (pseudonymization, aggregation, masking)…">
        <bpmn:documentation>Step 2: IT/Data Analytics apply techniques (pseudonymization, aggregation, masking) before data enters analytics/AI/test environments; prohibit raw PII in non-prod
Responsible (R): IT / Data Analytics
Accountable (A): Data Governance Manager
Duration: Per use case</bpmn:documentation>
        <bpmn:incoming>W3054_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3054_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3054_Task8" name="DPO audits de-identification effectiveness; restricts and logs access to…">
        <bpmn:documentation>Step 3: DPO audits de-identification effectiveness; restricts and logs access to re-identification keys; reviews AI/profiling for privacy impact
Responsible (R): DPO
Accountable (A): DPO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3054_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3054_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3054_End9" name="Complete">
        <bpmn:incoming>W3054_Flow15</bpmn:incoming>
      </bpmn:endEvent>
