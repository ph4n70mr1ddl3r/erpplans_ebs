<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-91.2-privacy-impact-assessment-data-mapping-vendor-privacy" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3049" name="W3049. Privacy Impact Assessment (PIA) &amp; DPIA for New Initiatives" isExecutable="false">
      <bpmn:documentation>Trigger: New initiative/system processing personal data, or material change
Frequency: Per initiative
Volume: New product launches, app features, analytics/AI use cases
Owner: Data Protection Officer (DPO)
Participants: DPO, Project Sponsor, IT, Legal, Security
Source: workflow W3049 — Privacy Impact Assessment (PIA) &amp; DPIA for New Initiatives</bpmn:documentation>
      <bpmn:laneSet id="W3049_LaneSet3">
        <bpmn:lane id="W3049_Lane1" name="Project Sponsor">
        <bpmn:flowNodeRef>W3049_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3049_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3049_Lane2" name="DPO">
        <bpmn:flowNodeRef>W3049_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3049_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3049_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3049_Start4" name="New initiative/system processing personal data, or material change">
        <bpmn:outgoing>W3049_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3049_Task5" name="Project Sponsor completes PIA screening for new initiative (app feature…">
        <bpmn:documentation>Step 1: Project Sponsor completes PIA screening for new initiative (app feature, loyalty analytics, AI/profiling, biometrics); DPO determines if full DPIA required (high-risk)
Responsible (R): Project Sponsor / DPO
Accountable (A): DPO
Duration: Per initiative</bpmn:documentation>
        <bpmn:incoming>W3049_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3049_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3049_Task6" name="DPO leads DPIA: necessity/proportionality, risks to subjects, mitigations…">
        <bpmn:documentation>Step 2: DPO leads DPIA: necessity/proportionality, risks to subjects, mitigations, residual risk, and go/no-go recommendation; consults subjects where appropriate
Responsible (R): DPO
Accountable (A): DPO
Duration: Per initiative</bpmn:documentation>
        <bpmn:incoming>W3049_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3049_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3049_Task7" name="DPO/Steering Committee decide on processing; mandate mitigations; document…">
        <bpmn:documentation>Step 3: DPO/Steering Committee decide on processing; mandate mitigations; document decision; re-review on material change
Responsible (R): DPO / Steering Committee
Accountable (A): VP Legal &amp; Compliance
Duration: Per initiative</bpmn:documentation>
        <bpmn:incoming>W3049_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3049_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3049_End8" name="Complete">
        <bpmn:incoming>W3049_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3049_Annotation9">
        <bpmn:text>Controls: - CTL-503 (ensure controlled execution — Privacy Impact Assessment, Data Mapping &amp; Vendor Privacy Due Diligence (PA-91.2).) | - operational: PIA gate in project intake
Owner: Data Protection Officer (DPO)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3049_Assoc10" sourceRef="W3049_Annotation9" targetRef="W3049_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3049_Flow11" sourceRef="W3049_Start4" targetRef="W3049_Task5" />
      <bpmn:sequenceFlow id="W3049_Flow12" sourceRef="W3049_Task5" targetRef="W3049_Task6" />
      <bpmn:sequenceFlow id="W3049_Flow13" sourceRef="W3049_Task6" targetRef="W3049_Task7" />
      <bpmn:sequenceFlow id="W3049_Flow14" sourceRef="W3049_Task7" targetRef="W3049_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3049_diag">
      <bpmndi:BPMNPlane id="W3049_plane" bpmnElement="W_W3049">
        <bpmndi:BPMNShape id="W3049_Lane1_di" bpmnElement="W3049_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3049_Lane2_di" bpmnElement="W3049_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3049_Task5_di" bpmnElement="W3049_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3049_Task6_di" bpmnElement="W3049_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3049_Task7_di" bpmnElement="W3049_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3049_Start4_di" bpmnElement="W3049_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3049_End8_di" bpmnElement="W3049_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3049_Annotation9_di" bpmnElement="W3049_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3049_Flow11_di" bpmnElement="W3049_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3049_Flow12_di" bpmnElement="W3049_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3049_Flow13_di" bpmnElement="W3049_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3049_Flow14_di" bpmnElement="W3049_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3049_Assoc10_di" bpmnElement="W3049_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3050" name="W3050. Cross-Border Transfer Assessment &amp; Adequacy Determination" isExecutable="false">
      <bpmn:documentation>Trigger: Personal data transfer outside Philippines
Frequency: Per transfer mechanism + annual review
Volume: Cloud/SaaS vendors, regional marketplaces, group entities
Owner: Data Protection Officer (DPO)
Participants: DPO, Legal, IT, Vendor Mgmt, Finance
Source: workflow W3050 — Cross-Border Transfer Assessment &amp; Adequacy Determination</bpmn:documentation>
      <bpmn:laneSet id="W3050_LaneSet3">
        <bpmn:lane id="W3050_Lane1" name="DPO">
        <bpmn:flowNodeRef>W3050_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3050_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3050_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3050_Lane2" name="Legal">
        <bpmn:flowNodeRef>W3050_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3050_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3050_Start4" name="Personal data transfer outside Philippines">
        <bpmn:outgoing>W3050_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3050_Task5" name="DPO/Legal identify cross-border transfers (cloud regions, marketplace…">
        <bpmn:documentation>Step 1: DPO/Legal identify cross-border transfers (cloud regions, marketplace platforms, group sharing); assess destination-country adequacy per NPC guidance
Responsible (R): DPO / Legal
Accountable (A): DPO
Duration: Annual + event</bpmn:documentation>
        <bpmn:incoming>W3050_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3050_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3050_Task6" name="Legal/DPO implement appropriate safeguards: contractual clauses, binding…">
        <bpmn:documentation>Step 2: Legal/DPO implement appropriate safeguards: contractual clauses, binding corporate rules for group entities, or NPC-approved transfer mechanisms
Responsible (R): Legal / DPO
Accountable (A): VP Legal &amp; Compliance
Duration: Per transfer</bpmn:documentation>
        <bpmn:incoming>W3050_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3050_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3050_Task7" name="DPO monitors regulatory changes affecting transfers; renews safeguards…">
        <bpmn:documentation>Step 3: DPO monitors regulatory changes affecting transfers; renews safeguards; documents transfer register; suspends non-compliant transfers
Responsible (R): DPO
Accountable (A): DPO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3050_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3050_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3050_End8" name="Complete">
        <bpmn:incoming>W3050_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3050_Annotation9">
        <bpmn:text>Controls: - CTL-503 (ensure controlled execution — Privacy Impact Assessment, Data Mapping &amp; Vendor Privacy Due Diligence (PA-91.2).) | - operational: transfer register and safeguards
Owner: Data Protection Officer (DPO)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3050_Assoc10" sourceRef="W3050_Annotation9" targetRef="W3050_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3050_Flow11" sourceRef="W3050_Start4" targetRef="W3050_Task5" />
      <bpmn:sequenceFlow id="W3050_Flow12" sourceRef="W3050_Task5" targetRef="W3050_Task6" />
      <bpmn:sequenceFlow id="W3050_Flow13" sourceRef="W3050_Task6" targetRef="W3050_Task7" />
      <bpmn:sequenceFlow id="W3050_Flow14" sourceRef="W3050_Task7" targetRef="W3050_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3050_diag">
      <bpmndi:BPMNPlane id="W3050_plane" bpmnElement="W_W3050">
        <bpmndi:BPMNShape id="W3050_Lane1_di" bpmnElement="W3050_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3050_Lane2_di" bpmnElement="W3050_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3050_Task5_di" bpmnElement="W3050_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3050_Task6_di" bpmnElement="W3050_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3050_Task7_di" bpmnElement="W3050_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3050_Start4_di" bpmnElement="W3050_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3050_End8_di" bpmnElement="W3050_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3050_Annotation9_di" bpmnElement="W3050_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3050_Flow11_di" bpmnElement="W3050_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3050_Flow12_di" bpmnElement="W3050_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3050_Flow13_di" bpmnElement="W3050_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3050_Flow14_di" bpmnElement="W3050_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3050_Assoc10_di" bpmnElement="W3050_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3051" name="W3051. Data Processing Agreement (DPA) &amp; Vendor Privacy Due Diligence" isExecutable="false">
      <bpmn:documentation>Trigger: Onboarding processor handling personal data
Frequency: Per vendor + renewal
Volume: ~100–200 processors among ~800–1,000 vendors + SaaS/IT providers
Owner: Vendor Management Manager
Participants: Vendor Mgmt, DPO, Legal, IT Security
Source: workflow W3051 — Data Processing Agreement (DPA) &amp; Vendor Privacy Due Diligence</bpmn:documentation>
      <bpmn:laneSet id="W3051_LaneSet3">
        <bpmn:lane id="W3051_Lane1" name="Vendor Mgmt">
        <bpmn:flowNodeRef>W3051_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3051_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3051_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3051_Lane2" name="Legal">
        <bpmn:flowNodeRef>W3051_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3051_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3051_Start4" name="Onboarding processor handling personal data">
        <bpmn:outgoing>W3051_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3051_Task5" name="Vendor Mgmt/DPO screen vendors processing personal data; assess privacy posture…">
        <bpmn:documentation>Step 1: Vendor Mgmt/DPO screen vendors processing personal data; assess privacy posture (certifications, security, sub-processors, breach history)
Responsible (R): Vendor Mgmt / DPO
Accountable (A): Vendor Management Manager
Duration: Per vendor</bpmn:documentation>
        <bpmn:incoming>W3051_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3051_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3051_Task6" name="Legal/DPO execute Data Processing Agreement (DPA) defining purpose, data…">
        <bpmn:documentation>Step 2: Legal/DPO execute Data Processing Agreement (DPA) defining purpose, data, sub-processors, security, breach notice, audit rights, deletion on exit
Responsible (R): Legal / DPO
Accountable (A): VP Legal &amp; Compliance
Duration: Per vendor</bpmn:documentation>
        <bpmn:incoming>W3051_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3051_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3051_Task7" name="Vendor Mgmt integrate DPA requirement into vendor onboarding (links to VS-03)…">
        <bpmn:documentation>Step 3: Vendor Mgmt integrate DPA requirement into vendor onboarding (links to VS-03) and contract lifecycle; block non-compliant processors
Responsible (R): Vendor Mgmt
Accountable (A): Vendor Management Manager
Duration: Per vendor</bpmn:documentation>
        <bpmn:incoming>W3051_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3051_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3051_End8" name="Complete">
        <bpmn:incoming>W3051_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3051_Annotation9">
        <bpmn:text>Controls: - CTL-503 (ensure controlled execution — Privacy Impact Assessment, Data Mapping &amp; Vendor Privacy Due Diligence (PA-91.2).) | - operational: DPA and due diligence
Owner: Vendor Management Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3051_Assoc10" sourceRef="W3051_Annotation9" targetRef="W3051_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3051_Flow11" sourceRef="W3051_Start4" targetRef="W3051_Task5" />
      <bpmn:sequenceFlow id="W3051_Flow12" sourceRef="W3051_Task5" targetRef="W3051_Task6" />
      <bpmn:sequenceFlow id="W3051_Flow13" sourceRef="W3051_Task6" targetRef="W3051_Task7" />
      <bpmn:sequenceFlow id="W3051_Flow14" sourceRef="W3051_Task7" targetRef="W3051_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3051_diag">
      <bpmndi:BPMNPlane id="W3051_plane" bpmnElement="W_W3051">
        <bpmndi:BPMNShape id="W3051_Lane1_di" bpmnElement="W3051_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3051_Lane2_di" bpmnElement="W3051_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3051_Task5_di" bpmnElement="W3051_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3051_Task6_di" bpmnElement="W3051_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3051_Task7_di" bpmnElement="W3051_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3051_Start4_di" bpmnElement="W3051_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3051_End8_di" bpmnElement="W3051_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3051_Annotation9_di" bpmnElement="W3051_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3051_Flow11_di" bpmnElement="W3051_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3051_Flow12_di" bpmnElement="W3051_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3051_Flow13_di" bpmnElement="W3051_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3051_Flow14_di" bpmnElement="W3051_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3051_Assoc10_di" bpmnElement="W3051_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3052" name="W3052. Third-Party Processor Oversight &amp; Privacy Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Annual review or risk-triggered
Frequency: Annual + event-driven
Volume: Processors handling personal data
Owner: Data Protection Officer (DPO)
Participants: DPO, Internal Audit, IT Security, Vendor Mgmt
Source: workflow W3052 — Third-Party Processor Oversight &amp; Privacy Audit</bpmn:documentation>
      <bpmn:laneSet id="W3052_LaneSet3">
        <bpmn:lane id="W3052_Lane1" name="DPO">
        <bpmn:flowNodeRef>W3052_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3052_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3052_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3052_Lane2" name="Internal Audit">
        <bpmn:flowNodeRef>W3052_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3052_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3052_Start4" name="Annual review or risk-triggered">
        <bpmn:outgoing>W3052_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3052_Task5" name="DPO/Vendor Mgmt maintain processor inventory and risk tier; schedule oversight…">
        <bpmn:documentation>Step 1: DPO/Vendor Mgmt maintain processor inventory and risk tier; schedule oversight based on data sensitivity and volume
Responsible (R): DPO / Vendor Mgmt
Accountable (A): DPO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3052_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3052_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3052_Task6" name="Internal Audit/IT Security audit high-risk processors (security controls…">
        <bpmn:documentation>Step 2: Internal Audit/IT Security audit high-risk processors (security controls, access logs, sub-processor changes, deletion evidence); review certifications
Responsible (R): Internal Audit / IT Security
Accountable (A): Internal Audit Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3052_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3052_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3052_Task7" name="DPO/Vendor Mgmt remediate findings; escalate unresolved issues; suspend/exit…">
        <bpmn:documentation>Step 3: DPO/Vendor Mgmt remediate findings; escalate unresolved issues; suspend/exit processors per DPA breach provisions
Responsible (R): DPO / Vendor Mgmt
Accountable (A): DPO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3052_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3052_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3052_End8" name="Complete">
        <bpmn:incoming>W3052_Flow14</bpmn:incoming>
      </bpmn:endEvent>
