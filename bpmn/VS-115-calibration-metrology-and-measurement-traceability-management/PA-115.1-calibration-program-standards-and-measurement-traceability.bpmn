    <bpmn:process id="W_W3623" name="W3623. Calibration Training, Competency &amp; Technician Certification" isExecutable="false">
      <bpmn:documentation>Trigger: New technician; competency cycle; OOT/incident
Frequency: Per technician + recurring
Volume: Calibration technicians and device-operator community
Owner: Metrology Manager / HR-L&amp;D
Participants: Metrology Manager, HR/L&amp;D (links to VS-19.3/VS-103), Quality (links to VS-31), Standards Lab, Device Operators (Stores/DC/Services)
Source: workflow W3623 — Calibration Training, Competency &amp; Technician Certification</bpmn:documentation>
      <bpmn:laneSet id="W3623_LaneSet2">
        <bpmn:lane id="W3623_Lane1" name="Metrology Manager">
        <bpmn:flowNodeRef>W3623_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3623_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3623_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3623_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3623_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3623_Start3" name="New technician; competency cycle; OOT/incident">
        <bpmn:outgoing>W3623_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3623_Task4" name="Metrology Manager/HR define calibration competency requirements: calibration…">
        <bpmn:documentation>Step 1: Metrology Manager/HR define calibration competency requirements: calibration technicians (metrology fundamentals, uncertainty, procedures by device class, MSA/Gage R&amp;R), and device operators (correct use, basic checks, defect reporting); define the certification/qualification scheme
Responsible (R): Metrology Manager / HR
Accountable (A): Quality Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3623_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3623_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3623_Task5" name="Metrology Manager/L&amp;D deliver training: classroom and hands-on, device-class…">
        <bpmn:documentation>Step 2: Metrology Manager/L&amp;D deliver training: classroom and hands-on, device-class procedures, software/Oracle eAM, standards handling, and safety (electrical/pressure for some instruments); certify technicians and record competency; manage external certifications where required
Responsible (R): Metrology Manager / L&amp;D / Standards Lab
Accountable (A): Quality Manager
Duration: Per technician + recurring</bpmn:documentation>
        <bpmn:incoming>W3623_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3623_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3623_Task6" name="Metrology Manager maintain the competency register, track certification/expiry…">
        <bpmn:documentation>Step 3: Metrology Manager maintain the competency register, track certification/expiry and refresher, audit competency coverage, and feed gaps to L&amp;D (links to VS-19.3); report to governance (W3640) and audit (links to VS-21)
Responsible (R): Metrology Manager / HR
Accountable (A): Quality Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3623_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3623_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3623_End7" name="Complete">
        <bpmn:incoming>W3623_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3623_Annotation8">
        <bpmn:text>Controls: - CTL-145 (ensure measurement traceability &amp; weights-and-measures compliance.) | - operational: certification gating; operational: refresher and competency audit
Owner: Metrology Manager / HR-L&amp;D</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3623_Assoc9" sourceRef="W3623_Annotation8" targetRef="W3623_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3623_Flow10" sourceRef="W3623_Start3" targetRef="W3623_Task4" />
      <bpmn:sequenceFlow id="W3623_Flow11" sourceRef="W3623_Task4" targetRef="W3623_Task5" />
      <bpmn:sequenceFlow id="W3623_Flow12" sourceRef="W3623_Task5" targetRef="W3623_Task6" />
      <bpmn:sequenceFlow id="W3623_Flow13" sourceRef="W3623_Task6" targetRef="W3623_End7" />
    </bpmn:process>
