        <bpmndi:BPMNShape id="W3618_Task6_di" bpmnElement="W3618_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3618_Start3_di" bpmnElement="W3618_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3618_End7_di" bpmnElement="W3618_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3618_Annotation8_di" bpmnElement="W3618_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3618_Flow10_di" bpmnElement="W3618_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3618_Flow11_di" bpmnElement="W3618_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3618_Flow12_di" bpmnElement="W3618_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3618_Flow13_di" bpmnElement="W3618_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3618_Assoc9_di" bpmnElement="W3618_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3619" name="W3619. Calibration Intervals, Tolerance &amp; MRA Methodology" isExecutable="false">
      <bpmn:documentation>Trigger: Program strategy (W3617); device-class definition; OOT trend (W3634)
Frequency: Maintained + periodic optimization
Volume: Calibration intervals and tolerances by device class
Owner: Metrology Manager
Participants: Metrology Manager, Quality (links to VS-31), Device Owners (Stores/DC/Services/Facilities), Compliance (links to VS-22), Standards Lab (W3622)
Source: workflow W3619 — Calibration Intervals, Tolerance &amp; MRA Methodology</bpmn:documentation>
      <bpmn:laneSet id="W3619_LaneSet2">
        <bpmn:lane id="W3619_Lane1" name="Metrology Manager">
        <bpmn:flowNodeRef>W3619_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3619_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3619_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3619_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3619_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3619_Start3" name="Program strategy (W3617); device-class definition; OOT trend (W3634)">
        <bpmn:outgoing>W3619_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3619_Task4" name="Metrology Manager define calibration intervals by device class and criticality…">
        <bpmn:documentation>Step 1: Metrology Manager define calibration intervals by device class and criticality: legal-for-trade POS scales (statutory interval — typically annual DTI verification), cutting/paint dispensers (usage-based or time-based), DC weighbridges (statutory + usage), fuel meters (statutory), environmental instruments (time-based), test &amp; measurement tools (usage-based); align to regulation, manufacturer, and usage
Responsible (R): Metrology Manager / Quality
Accountable (A): Quality Manager
Duration: Maintained</bpmn:documentation>
        <bpmn:incoming>W3619_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3619_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3619_Task5" name="Metrology Manager define tolerances (acceptance criteria) and…">
        <bpmn:documentation>Step 2: Metrology Manager define tolerances (acceptance criteria) and maximum-permissible-error (MPE) by device class and measurement: align to legal-for-trade MPE (DTI), process-control need (revenue/quality impact), and the OOT-investigation thresholds (W3634); document the tolerance methodology
Responsible (R): Metrology Manager / Quality
Accountable (A): Quality Manager
Duration: Maintained</bpmn:documentation>
        <bpmn:incoming>W3619_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3619_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3619_Task6" name="Metrology Manager optimize intervals using calibration history and OOT data…">
        <bpmn:documentation>Step 3: Metrology Manager optimize intervals using calibration history and OOT data (W3634/W3635): extend intervals for stable devices, shorten for drift-prone ones (reliability-centered calibration / OOT-based interval adjustment); apply measurement-risk-assessment (MRA) to set economically-optimal intervals; report optimization to governance (W3640)
Responsible (R): Metrology Manager / Quality
Accountable (A): Quality Manager
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W3619_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3619_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3619_End7" name="Complete">
        <bpmn:incoming>W3619_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3619_Annotation8">
        <bpmn:text>Controls: - CTL-574 (ensure controlled execution — Calibration Program, Standards &amp; Measurement Traceability (PA-115.1).) | - operational: OOT-based optimization; operational: MPE/impact-based methodology
Owner: Metrology Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3619_Assoc9" sourceRef="W3619_Annotation8" targetRef="W3619_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3619_Flow10" sourceRef="W3619_Start3" targetRef="W3619_Task4" />
      <bpmn:sequenceFlow id="W3619_Flow11" sourceRef="W3619_Task4" targetRef="W3619_Task5" />
      <bpmn:sequenceFlow id="W3619_Flow12" sourceRef="W3619_Task5" targetRef="W3619_Task6" />
      <bpmn:sequenceFlow id="W3619_Flow13" sourceRef="W3619_Task6" targetRef="W3619_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3619_diag">
      <bpmndi:BPMNPlane id="W3619_plane" bpmnElement="W_W3619">
        <bpmndi:BPMNShape id="W3619_Lane1_di" bpmnElement="W3619_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3619_Task4_di" bpmnElement="W3619_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3619_Task5_di" bpmnElement="W3619_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3619_Task6_di" bpmnElement="W3619_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3619_Start3_di" bpmnElement="W3619_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3619_End7_di" bpmnElement="W3619_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3619_Annotation8_di" bpmnElement="W3619_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3619_Flow10_di" bpmnElement="W3619_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3619_Flow11_di" bpmnElement="W3619_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3619_Flow12_di" bpmnElement="W3619_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3619_Flow13_di" bpmnElement="W3619_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3619_Assoc9_di" bpmnElement="W3619_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3620" name="W3620. Calibration Master Data &amp; Device Registry" isExecutable="false">
      <bpmn:documentation>Trigger: New device acquisition (links to VS-34/VS-99); device-class setup; registry cycle
Frequency: Per device + maintained
Volume: Enterprise measurement-device estate (~600 POS scales + cutting/paint/weighbridge/fuel/environmental/test devices)
Owner: Metrology Manager / Master Data
Participants: Metrology Manager, Master Data (links to VS-29), Device Owners (Stores/DC/Services/Facilities/IT), Procurement (links to VS-34/VS-99), Quality (links to VS-31), Finance (links to VS-35)
Source: workflow W3620 — Calibration Master Data &amp; Device Registry</bpmn:documentation>
      <bpmn:laneSet id="W3620_LaneSet2">
        <bpmn:lane id="W3620_Lane1" name="Metrology Manager">
        <bpmn:flowNodeRef>W3620_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3620_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3620_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3620_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3620_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3620_Start3" name="New device acquisition (links to VS-34/VS-99); device-class setup; registry cycle">
        <bpmn:outgoing>W3620_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3620_Task4" name="Metrology Manager/Master Data register each measurement device: unique device…">
        <bpmn:documentation>Step 1: Metrology Manager/Master Data register each measurement device: unique device ID/asset tag (links to VS-35/VS-99), device class, make/model/serial, location/site, measurement range, resolution, classification (legal-for-trade vs. process-control), owner, and criticality; reconcile to the fixed-asset/ITAM register (links to VS-35/VS-99)
Responsible (R): Metrology Manager / Master Data
Accountable (A): Metrology Manager
Duration: Per device</bpmn:documentation>
        <bpmn:incoming>W3620_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3620_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3620_Task5" name="Metrology Manager/Master Data maintain the calibration attributes per device…">
        <bpmn:documentation>Step 2: Metrology Manager/Master Data maintain the calibration attributes per device: interval (W3619), tolerance/MPE (W3619), last/next calibration date, calibration method (in-house W3622 vs. external W3621), standards used (traceability W3618), status (due/overdue/OOT/in-service/out-of-service), and the calibration history link (W3624)
Responsible (R): Metrology Manager / Master Data
Accountable (A): Metrology Manager
Duration: Per device + maintained</bpmn:documentation>
        <bpmn:incoming>W3620_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3620_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3620_Task6" name="Metrology Manager/IT deploy Oracle eAM as the calibration management system…">
        <bpmn:documentation>Step 3: Metrology Manager/IT deploy Oracle eAM as the calibration management system (links to VS-27/VS-20.3; fit-gap F5) to schedule, dispatch, record, and report calibration; integrate to the device registry and trigger alerts for due/overdue (links to W3622/W3632); audit registry completeness
Responsible (R): Metrology Manager / IT
Accountable (A): Quality Manager
Duration: Maintained</bpmn:documentation>
        <bpmn:incoming>W3620_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3620_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3620_End7" name="Complete">
        <bpmn:incoming>W3620_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3620_Annotation8">
        <bpmn:text>Controls: - CTL-145 (ensure measurement traceability &amp; weights-and-measures compliance.) | - operational: acquisition gate and discovery; operational: system-driven scheduling
Owner: Metrology Manager / Master Data</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3620_Assoc9" sourceRef="W3620_Annotation8" targetRef="W3620_Start3" associationDirection="None" />
