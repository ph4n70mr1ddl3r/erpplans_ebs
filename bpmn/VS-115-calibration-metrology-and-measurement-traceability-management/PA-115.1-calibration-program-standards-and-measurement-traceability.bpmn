    <bpmn:process id="W_W3624" name="W3624. Calibration Audit, Documentation &amp; Records" isExecutable="false">
      <bpmn:documentation>Trigger: Per calibration; annual audit; regulatory inspection
Frequency: Per calibration + annual
Volume: Calibration records and audit
Owner: Metrology Manager / Quality
Participants: Metrology Manager, Quality (links to VS-31), Calibration Technicians, Compliance (links to VS-22), Records (links to VS-88), Audit (links to VS-21), External Labs (W3621)
Source: workflow W3624 — Calibration Audit, Documentation &amp; Records</bpmn:documentation>
      <bpmn:laneSet id="W3624_LaneSet3">
        <bpmn:lane id="W3624_Lane1" name="Calibration Technicians">
        <bpmn:flowNodeRef>W3624_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3624_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3624_Lane2" name="Metrology Manager">
        <bpmn:flowNodeRef>W3624_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3624_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3624_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3624_Start4" name="Per calibration; annual audit; regulatory inspection">
        <bpmn:outgoing>W3624_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3624_Task5" name="Calibration Technicians/Metrology Manager produce the calibration…">
        <bpmn:documentation>Step 1: Calibration Technicians/Metrology Manager produce the calibration record/certificate per calibration: device, date, technician/lab, standards used (traceability W3618), as-found/as-left results, tolerance/MPE (W3619), uncertainty, pass/fail/OOT (W3634), adjustments, and the next-due date; sign/issue and store in the calibration system
Responsible (R): Calibration Technicians / Metrology Manager
Accountable (A): Metrology Manager
Duration: Per calibration</bpmn:documentation>
        <bpmn:incoming>W3624_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3624_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3624_Task6" name="Metrology Manager/Quality maintain calibration documentation: certificates…">
        <bpmn:documentation>Step 2: Metrology Manager/Quality maintain calibration documentation: certificates, procedures, uncertainty budgets, traceability chain (W3618), training records (W3623), lab accreditations (W3621), and the calibration register; retention per regulation/VS-88 (legal-for-trade typically 3–7 years); manage legal-for-trade seals/labels
Responsible (R): Metrology Manager / Quality / Records
Accountable (A): Quality Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3624_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3624_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3624_Task7" name="Metrology Manager/Audit conduct the annual calibration audit: registry…">
        <bpmn:documentation>Step 3: Metrology Manager/Audit conduct the annual calibration audit: registry completeness (W3620), schedule adherence, OOT handling (W3634), records quality, traceability integrity (W3618), and ISO 17025 conformance where applicable; support DTI/regulatory inspection (links to VS-22/W3633) and manage findings to closure; report to governance (W3640)
Responsible (R): Metrology Manager / Audit / Quality
Accountable (A): Quality Manager
Duration: Annual + continuous</bpmn:documentation>
        <bpmn:incoming>W3624_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3624_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3624_End8" name="Complete">
        <bpmn:incoming>W3624_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3624_Annotation9">
        <bpmn:text>Controls: - CTL-145 (ensure measurement traceability &amp; weights-and-measures compliance.) | - operational: documentation discipline; operational: closure tracking
Owner: Metrology Manager / Quality</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3624_Assoc10" sourceRef="W3624_Annotation9" targetRef="W3624_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3624_Flow11" sourceRef="W3624_Start4" targetRef="W3624_Task5" />
      <bpmn:sequenceFlow id="W3624_Flow12" sourceRef="W3624_Task5" targetRef="W3624_Task6" />
      <bpmn:sequenceFlow id="W3624_Flow13" sourceRef="W3624_Task6" targetRef="W3624_Task7" />
      <bpmn:sequenceFlow id="W3624_Flow14" sourceRef="W3624_Task7" targetRef="W3624_End8" />
    </bpmn:process>
