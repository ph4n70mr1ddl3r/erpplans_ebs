      <bpmn:sequenceFlow id="W696_Flow20" sourceRef="W696_Task9" targetRef="W696_Task10" />
      <bpmn:sequenceFlow id="W696_Flow21" sourceRef="W696_Task10" targetRef="W696_Task11" />
      <bpmn:sequenceFlow id="W696_Flow22" sourceRef="W696_Task11" targetRef="W696_Task12" />
      <bpmn:sequenceFlow id="W696_Flow23" sourceRef="W696_Task12" targetRef="W696_Task13" />
      <bpmn:sequenceFlow id="W696_Flow24" sourceRef="W696_Task13" targetRef="W696_Task14" />
      <bpmn:sequenceFlow id="W696_Flow25" sourceRef="W696_Task14" targetRef="W696_End15" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W696_diag">
      <bpmndi:BPMNPlane id="W696_plane" bpmnElement="W_W696">
        <bpmndi:BPMNShape id="W696_Lane1_di" bpmnElement="W696_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W696_Lane2_di" bpmnElement="W696_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W696_Lane3_di" bpmnElement="W696_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W696_Lane4_di" bpmnElement="W696_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W696_Lane5_di" bpmnElement="W696_Lane5" isHorizontal="true"><dc:Bounds x="160" y="760" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W696_Task8_di" bpmnElement="W696_Task8"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W696_Task9_di" bpmnElement="W696_Task9"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W696_Task10_di" bpmnElement="W696_Task10"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W696_Task11_di" bpmnElement="W696_Task11"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W696_Task12_di" bpmnElement="W696_Task12"><dc:Bounds x="1240" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W696_Task13_di" bpmnElement="W696_Task13"><dc:Bounds x="1450" y="295" width="180" height="80" /></bpmndi:BPMNShape>
