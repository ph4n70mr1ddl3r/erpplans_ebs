      <bpmn:sequenceFlow id="W1223_Flow19" sourceRef="W1223_Task7" targetRef="W1223_Task8" />
      <bpmn:sequenceFlow id="W1223_Flow20" sourceRef="W1223_Task8" targetRef="W1223_Task9" />
      <bpmn:sequenceFlow id="W1223_Flow21" sourceRef="W1223_Task9" targetRef="W1223_Task10" />
      <bpmn:sequenceFlow id="W1223_Flow22" sourceRef="W1223_Task10" targetRef="W1223_Task11" />
      <bpmn:sequenceFlow id="W1223_Flow23" sourceRef="W1223_Task11" targetRef="W1223_Task12" />
      <bpmn:sequenceFlow id="W1223_Flow24" sourceRef="W1223_Task12" targetRef="W1223_Task13" />
      <bpmn:sequenceFlow id="W1223_Flow25" sourceRef="W1223_Task13" targetRef="W1223_End14" />
    </bpmn:process>
