        <bpmndi:BPMNShape id="W1386_Task14_di" bpmnElement="W1386_Task14"><dc:Bounds x="1660" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1386_Task15_di" bpmnElement="W1386_Task15"><dc:Bounds x="1870" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1386_Task16_di" bpmnElement="W1386_Task16"><dc:Bounds x="2080" y="805" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1386_Task17_di" bpmnElement="W1386_Task17"><dc:Bounds x="2290" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1386_Task18_di" bpmnElement="W1386_Task18"><dc:Bounds x="2500" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1386_Start7_di" bpmnElement="W1386_Start7"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1386_End19_di" bpmnElement="W1386_End19"><dc:Bounds x="2730" y="827" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1386_Annotation20_di" bpmnElement="W1386_Annotation20"><dc:Bounds x="160" y="970" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1386_Flow22_di" bpmnElement="W1386_Flow22"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1386_Flow23_di" bpmnElement="W1386_Flow23"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
