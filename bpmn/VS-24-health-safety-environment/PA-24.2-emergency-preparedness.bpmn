      <bpmn:sequenceFlow id="W5570_Flow23" sourceRef="W5570_Task11" targetRef="W5570_Task12" />
      <bpmn:sequenceFlow id="W5570_Flow24" sourceRef="W5570_Task12" targetRef="W5570_Task13" />
      <bpmn:sequenceFlow id="W5570_Flow25" sourceRef="W5570_Task13" targetRef="W5570_Task14" />
      <bpmn:sequenceFlow id="W5570_Flow26" sourceRef="W5570_Task14" targetRef="W5570_Task15" />
      <bpmn:sequenceFlow id="W5570_Flow27" sourceRef="W5570_Task15" targetRef="W5570_End16" />
    </bpmn:process>
