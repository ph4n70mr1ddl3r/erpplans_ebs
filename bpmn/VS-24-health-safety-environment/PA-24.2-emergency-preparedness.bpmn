        <bpmndi:BPMNEdge id="W1386_Flow27_di" bpmnElement="W1386_Flow27"><di:waypoint x="1420" y="335" /><di:waypoint x="1450" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1386_Flow28_di" bpmnElement="W1386_Flow28"><di:waypoint x="1630" y="505" /><di:waypoint x="1660" y="675" /></bpmndi:BPMNEdge>
