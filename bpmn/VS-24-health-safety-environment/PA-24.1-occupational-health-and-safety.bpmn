    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1266_diag">
      <bpmndi:BPMNPlane id="W1266_plane" bpmnElement="W_W1266">
        <bpmndi:BPMNShape id="W1266_Lane1_di" bpmnElement="W1266_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
