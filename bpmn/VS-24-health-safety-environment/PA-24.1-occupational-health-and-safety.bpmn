    <bpmn:process id="W_W758" name="W758. Store-Level Fire Safety Equipment Daily Inspection &amp; Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: Daily store opening (W5A); scheduled daily inspection
Frequency: Daily per store
Volume: 200 stores × daily inspection
Owner: Maintenance Associate
Participants: Maintenance Associate, Store Manager, BFP (annual inspection W476)
Source: workflow W758 — Store-Level Fire Safety Equipment Daily Inspection &amp; Compliance</bpmn:documentation>
      <bpmn:laneSet id="W758_LaneSet4">
        <bpmn:lane id="W758_Lane1" name="System">
        <bpmn:flowNodeRef>W758_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W758_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W758_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W758_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W758_Lane2" name="Maintenance Associate">
        <bpmn:flowNodeRef>W758_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W758_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W758_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W758_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W758_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W758_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W758_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W758_Start5" name="Daily store opening (W5A); scheduled daily inspection">
        <bpmn:outgoing>W758_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W758_Task6" name="Inspection checklist generation — System generates daily fire safety checklist…">
        <bpmn:documentation>Step 1: Inspection checklist generation — System generates daily fire safety checklist per store location based on installed equipment: fire extinguishers (type, location, pressure gauge), fire alarm panels, emergency exit lights, sprinkler pressure gauges, fire exit paths, fire door closers
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W758_Flow17</bpmn:incoming>
        <bpmn:outgoing>W758_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W758_Task7" name="Equipment walk-through — Maintenance Associate walks store following…">
        <bpmn:documentation>Step 2: Equipment walk-through — Maintenance Associate walks store following system-guided inspection route; at each equipment point: (a) verify equipment present, (b) check visual indicators (pressure gauge in green zone, no visible damage), (c) confirm exit path clear, (d) scan equipment barcode/QR for digital logging
Responsible (R): Maintenance Associate
Accountable (A): Store Manager
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W758_Flow18</bpmn:incoming>
        <bpmn:outgoing>W758_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W758_Task8" name="Failed item documentation — If any equipment fails visual check: Maintenance…">
        <bpmn:documentation>Step 3: Failed item documentation — If any equipment fails visual check: Maintenance Associate photographs deficiency, records description, and marks item as &quot;Failed&quot; in system; system auto-generates maintenance work order (W47)
Responsible (R): Maintenance Associate
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W758_Flow19</bpmn:incoming>
        <bpmn:outgoing>W758_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W758_Task9" name="Fire extinguisher pressure verification — Monthly: Maintenance Associate weighs…">
        <bpmn:documentation>Step 4: Fire extinguisher pressure verification — Monthly: Maintenance Associate weighs each fire extinguisher (weight indicates charge level); records weight in system; if weight below minimum threshold, system triggers replacement request
Responsible (R): Maintenance Associate
Accountable (A): —
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W758_Flow20</bpmn:incoming>
        <bpmn:outgoing>W758_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W758_Task10" name="Emergency exit light test — Monthly: Maintenance Associate simulates power…">
        <bpmn:documentation>Step 5: Emergency exit light test — Monthly: Maintenance Associate simulates power failure to verify emergency exit lights activate; records pass/fail per unit
Responsible (R): Maintenance Associate
Accountable (A): —
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W758_Flow21</bpmn:incoming>
        <bpmn:outgoing>W758_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W758_Task11" name="Compliance documentation — System compiles daily inspection records into…">
        <bpmn:documentation>Step 6: Compliance documentation — System compiles daily inspection records into monthly compliance report; archives for 5 years per BFP requirements; accessible for W476 FSIC inspection and W141 safety audit
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W758_Flow22</bpmn:incoming>
        <bpmn:outgoing>W758_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W758_Task12" name="Equipment expiry tracking — System tracks fire extinguisher expiry dates…">
        <bpmn:documentation>Step 7: Equipment expiry tracking — System tracks fire extinguisher expiry dates, sprinkler system inspection dates, and fire alarm system certification dates; auto-generates replacement/inspection requests 30 days before expiry
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W758_Flow23</bpmn:incoming>
        <bpmn:outgoing>W758_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W758_Task13" name="Escalation for critical failures — If critical fire safety equipment fails (no…">
        <bpmn:documentation>Step 8: Escalation for critical failures — If critical fire safety equipment fails (no fire extinguisher coverage for a zone, fire alarm system down, blocked fire exit): immediate escalation to Store Manager; Store Manager contacts fire safety vendor for same-day emergency repair
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: Immediate</bpmn:documentation>
        <bpmn:incoming>W758_Flow24</bpmn:incoming>
        <bpmn:outgoing>W758_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W758_End14" name="Complete">
        <bpmn:incoming>W758_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W758_Annotation15">
        <bpmn:text>Controls: - CTL-226 (ensure OHS compliance &amp; incident management.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Maintenance Associate</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W758_Assoc16" sourceRef="W758_Annotation15" targetRef="W758_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W758_Flow17" sourceRef="W758_Start5" targetRef="W758_Task6" />
