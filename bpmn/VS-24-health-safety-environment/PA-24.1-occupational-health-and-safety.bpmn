      <bpmn:sequenceFlow id="W697_Flow24" sourceRef="W697_Task12" targetRef="W697_Task13" />
      <bpmn:sequenceFlow id="W697_Flow25" sourceRef="W697_Task13" targetRef="W697_Task14" />
      <bpmn:sequenceFlow id="W697_Flow26" sourceRef="W697_Task14" targetRef="W697_End15" />
    </bpmn:process>
