<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-24.1-occupational-health-and-safety" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W140" name="W140. Occupational Health &amp; Safety (OHS) Incident Management" isExecutable="false">
      <bpmn:documentation>Trigger: Workplace accident, &quot;near miss,&quot; or safety hazard reported (involving employee, customer, or contractor)
Frequency: Ad-hoc; ~50–100 reportable incidents/year chain-wide
Volume: Covers all 200 stores, 4 DCs, and HQ
Owner: Safety Officer (HQ/DC); Store Manager (Store)
Participants: Affected Individual, First Aider, Store/DC Manager, HR, Legal, Insurance
Source: workflow W140 — Occupational Health &amp; Safety (OHS) Incident Management</bpmn:documentation>
      <bpmn:laneSet id="W140_LaneSet6">
        <bpmn:lane id="W140_Lane1" name="First Aider">
        <bpmn:flowNodeRef>W140_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W140_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W140_Lane2" name="Store">
        <bpmn:flowNodeRef>W140_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W140_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W140_Lane3" name="Safety Officer">
        <bpmn:flowNodeRef>W140_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W140_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W140_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W140_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W140_Lane4" name="Store Manager">
        <bpmn:flowNodeRef>W140_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W140_Lane5" name="Safety Committee">
        <bpmn:flowNodeRef>W140_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W140_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W140_Start7" name="Workplace accident, &quot;near miss,&quot; or safety hazard reported (involving employee, customer…">
        <bpmn:outgoing>W140_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W140_Task8" name="Emergency Response">
        <bpmn:documentation>Step 1: Emergency Response: Immediate first aid or medical evacuation; secure the scene to prevent further injury
Responsible (R): First Aider / Manager
Accountable (A): Store Manager
Duration: Immediate</bpmn:documentation>
        <bpmn:incoming>W140_Flow20</bpmn:incoming>
        <bpmn:outgoing>W140_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W140_Task9" name="Incident Reporting">
        <bpmn:documentation>Step 2: Incident Reporting: Manager creates Incident Report in system within 2 hours: date/time, location, individuals involved, description of event, and immediate actions taken
Responsible (R): Store/DC Manager
Accountable (A): Safety Officer
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W140_Flow21</bpmn:incoming>
        <bpmn:outgoing>W140_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W140_Task10" name="Evidence Capture">
        <bpmn:documentation>Step 3: Evidence Capture: Upload photos of the scene, witness statements, and CCTV footage to the incident record
Responsible (R): Store/DC Manager
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W140_Flow22</bpmn:incoming>
        <bpmn:outgoing>W140_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W140_Task11" name="Investigation">
        <bpmn:documentation>Step 4: Investigation: Safety Officer conducts root cause analysis (e.g., &quot;5 Whys&quot;); classifies incident (Minor, Medical Treatment, Lost Time Injury, Fatality)
Responsible (R): Safety Officer
Accountable (A): CHRO
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W140_Flow23</bpmn:incoming>
        <bpmn:outgoing>W140_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W140_Task12" name="Corrective Action (CAPA)">
        <bpmn:documentation>Step 5: Corrective Action (CAPA): System generates CAPA tasks (e.g., repair floor, replace PPE, retraining); tracks completion
Responsible (R): Safety Officer
Accountable (A): Dept Head
Duration: Varies</bpmn:documentation>
        <bpmn:incoming>W140_Flow24</bpmn:incoming>
        <bpmn:outgoing>W140_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W140_Task13" name="Regulatory Notification">
        <bpmn:documentation>Step 6: Regulatory Notification: If required (e.g., serious injury), DPO/Safety Officer notifies DOLE (Department of Labor and Employment) within prescribed timelines
Responsible (R): Safety Officer
Accountable (A): VP Legal
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W140_Flow25</bpmn:incoming>
        <bpmn:outgoing>W140_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W140_Task14" name="Insurance/Claims">
        <bpmn:documentation>Step 7: Insurance/Claims: If involving customer injury or significant property damage, initiate insurance claim per W3.6a
Responsible (R): Store Manager / Finance
Accountable (A): CFO
Duration: Per W3.6a</bpmn:documentation>
        <bpmn:incoming>W140_Flow26</bpmn:incoming>
        <bpmn:outgoing>W140_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W140_Task15" name="Closure">
        <bpmn:documentation>Step 8: Closure: Review all actions completed; Safety Officer closes the case; system archives for 10 years
Responsible (R): Safety Officer
Accountable (A): CHRO
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W140_Flow27</bpmn:incoming>
        <bpmn:outgoing>W140_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W140_Task16" name="Monthly Review">
        <bpmn:documentation>Step 9: Monthly Review: Monthly Safety Committee meeting reviews incident trends, &quot;near miss&quot; patterns, and CAPA completion rates
Responsible (R): Safety Committee
Accountable (A): CEO
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W140_Flow28</bpmn:incoming>
        <bpmn:outgoing>W140_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W140_End17" name="Complete">
        <bpmn:incoming>W140_Flow29</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W140_Annotation18">
        <bpmn:text>Controls: - CTL-226 (ensure OHS compliance &amp; incident management.) | - operational: current FSIC from Bureau of Fire Protection (BFP) per location, tracked to expiry
Owner: Safety Officer (HQ/DC); Store Manager (Store)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W140_Assoc19" sourceRef="W140_Annotation18" targetRef="W140_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W140_Flow20" sourceRef="W140_Start7" targetRef="W140_Task8" />
      <bpmn:sequenceFlow id="W140_Flow21" sourceRef="W140_Task8" targetRef="W140_Task9" />
      <bpmn:sequenceFlow id="W140_Flow22" sourceRef="W140_Task9" targetRef="W140_Task10" />
      <bpmn:sequenceFlow id="W140_Flow23" sourceRef="W140_Task10" targetRef="W140_Task11" />
      <bpmn:sequenceFlow id="W140_Flow24" sourceRef="W140_Task11" targetRef="W140_Task12" />
      <bpmn:sequenceFlow id="W140_Flow25" sourceRef="W140_Task12" targetRef="W140_Task13" />
      <bpmn:sequenceFlow id="W140_Flow26" sourceRef="W140_Task13" targetRef="W140_Task14" />
      <bpmn:sequenceFlow id="W140_Flow27" sourceRef="W140_Task14" targetRef="W140_Task15" />
      <bpmn:sequenceFlow id="W140_Flow28" sourceRef="W140_Task15" targetRef="W140_Task16" />
      <bpmn:sequenceFlow id="W140_Flow29" sourceRef="W140_Task16" targetRef="W140_End17" />
    </bpmn:process>
