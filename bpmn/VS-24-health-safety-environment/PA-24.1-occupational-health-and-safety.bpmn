      <bpmn:sequenceFlow id="W5552_Flow25" sourceRef="W5552_Task13" targetRef="W5552_Task14" />
      <bpmn:sequenceFlow id="W5552_Flow26" sourceRef="W5552_Task14" targetRef="W5552_Task15" />
      <bpmn:sequenceFlow id="W5552_Flow27" sourceRef="W5552_Task15" targetRef="W5552_Task16" />
      <bpmn:sequenceFlow id="W5552_Flow28" sourceRef="W5552_Task16" targetRef="W5552_End17" />
    </bpmn:process>
