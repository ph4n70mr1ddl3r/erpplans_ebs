        <bpmndi:BPMNShape id="W697_Task10_di" bpmnElement="W697_Task10"><dc:Bounds x="1030" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W697_Task11_di" bpmnElement="W697_Task11"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W697_Task12_di" bpmnElement="W697_Task12"><dc:Bounds x="1450" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W697_Task13_di" bpmnElement="W697_Task13"><dc:Bounds x="1660" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W697_Task14_di" bpmnElement="W697_Task14"><dc:Bounds x="1870" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W697_Start6_di" bpmnElement="W697_Start6"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W697_End15_di" bpmnElement="W697_End15"><dc:Bounds x="2100" y="657" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W697_Annotation16_di" bpmnElement="W697_Annotation16"><dc:Bounds x="160" y="800" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W697_Flow18_di" bpmnElement="W697_Flow18"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
