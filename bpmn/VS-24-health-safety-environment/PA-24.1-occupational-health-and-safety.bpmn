    <bpmn:process id="W_W436" name="W436. Annual OHS Statutory Reporting (WAIR/AMR)" isExecutable="false">
      <bpmn:documentation>Trigger: Annual statutory deadline (typically January/February)
Frequency: Annual
Volume: 200 Stores + 4 DCs + 1 HQ
Owner: Safety Officer
Participants: HR Manager, Company Physician/Nurse, Store Managers, DOLE
Source: workflow W436 — Annual OHS Statutory Reporting (WAIR/AMR)</bpmn:documentation>
      <bpmn:laneSet id="W436_LaneSet4">
        <bpmn:lane id="W436_Lane1" name="Safety Officer">
        <bpmn:flowNodeRef>W436_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W436_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W436_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W436_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W436_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W436_Lane2" name="Company Nurse">
        <bpmn:flowNodeRef>W436_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W436_Lane3" name="System">
        <bpmn:flowNodeRef>W436_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W436_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W436_Start5" name="Annual statutory deadline (typically January/February)">
        <bpmn:outgoing>W436_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W436_Task6" name="Data Consolidation">
        <bpmn:documentation>Step 1: Data Consolidation: Aggregates all workplace incident records (W140) and safety inspection findings (W141) for the calendar year
Responsible (R): Safety Officer
Accountable (A): —
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W436_Flow15</bpmn:incoming>
        <bpmn:outgoing>W436_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W436_Task7" name="Medical Data">
        <bpmn:documentation>Step 2: Medical Data: Company Nurse consolidates employee health records, clinic consultations, and annual physical exam (APE) results for the AMR
Responsible (R): Company Nurse
Accountable (A): HR Manager
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W436_Flow16</bpmn:incoming>
        <bpmn:outgoing>W436_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W436_Task8" name="Report Drafting">
        <bpmn:documentation>Step 3: Report Drafting: Safety Officer prepares the WAIR and RSO; Physician prepares the AMR
Responsible (R): Safety Officer / Physician
Accountable (A): CHRO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W436_Flow17</bpmn:incoming>
        <bpmn:outgoing>W436_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W436_Task9" name="Review &amp; Signing">
        <bpmn:documentation>Step 4: Review &amp; Signing: Store Managers sign the branch-specific reports; Safety Officer and Physician sign the technical sections
Responsible (R): Safety Officer / Physician
Accountable (A): Store Manager
Duration: 1 hour/loc</bpmn:documentation>
        <bpmn:incoming>W436_Flow18</bpmn:incoming>
        <bpmn:outgoing>W436_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W436_Task10" name="Online/Manual Submission">
        <bpmn:documentation>Step 5: Online/Manual Submission: Submit the consolidated reports to the DOLE Regional Office or via the DOLE Establishment Report System (ERS)
Responsible (R): Safety Officer
Accountable (A): —
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W436_Flow19</bpmn:incoming>
        <bpmn:outgoing>W436_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W436_Task11" name="Acknowledgement">
        <bpmn:documentation>Step 6: Acknowledgement: System archives the &quot;Received&quot; copy of the reports for future DOLE inspections
Responsible (R): System
Accountable (A): Safety Officer
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W436_Flow20</bpmn:incoming>
        <bpmn:outgoing>W436_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W436_End12" name="Complete">
        <bpmn:incoming>W436_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W436_Annotation13">
        <bpmn:text>Controls: - CTL-226 (ensure OHS compliance &amp; incident management.) | - operational: Safety Officer review and approval gate
Owner: Safety Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W436_Assoc14" sourceRef="W436_Annotation13" targetRef="W436_Start5" associationDirection="None" />
