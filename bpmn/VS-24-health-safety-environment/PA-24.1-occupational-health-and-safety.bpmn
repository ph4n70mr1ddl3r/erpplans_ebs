    <bpmn:process id="W_W141" name="W141. Workplace Safety Inspection &amp; Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled monthly inspection; or pre-opening checklist for new store
Frequency: Monthly per location
Volume: ~204 inspections/month
Owner: Safety Officer
Participants: Store/DC Manager, Maintenance, external fire/safety inspectors
Source: workflow W141 — Workplace Safety Inspection &amp; Audit</bpmn:documentation>
      <bpmn:laneSet id="W141_LaneSet4">
        <bpmn:lane id="W141_Lane1" name="System">
        <bpmn:flowNodeRef>W141_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W141_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W141_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W141_Lane2" name="Store">
        <bpmn:flowNodeRef>W141_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W141_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W141_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W141_Lane3" name="Safety Officer">
        <bpmn:flowNodeRef>W141_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W141_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W141_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W141_Start5" name="Scheduled monthly inspection; or pre-opening checklist for new store">
        <bpmn:outgoing>W141_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W141_Task6" name="Inspection Prep">
        <bpmn:documentation>Step 1: Inspection Prep: System generates monthly inspection checklist for the location (tailored for Store vs. DC)
Responsible (R): System
Accountable (A): Safety Officer
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W141_Flow16</bpmn:incoming>
        <bpmn:outgoing>W141_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W141_Task7" name="Walkthrough">
        <bpmn:documentation>Step 2: Walkthrough: Manager/Safety Officer conducts physical inspection: fire exits clear, fire extinguishers charged, racking integrity (DC), spill kits stocked, PPE usage, electrical safety
Responsible (R): Store/DC Manager
Accountable (A): Safety Officer
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W141_Flow17</bpmn:incoming>
        <bpmn:outgoing>W141_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W141_Task8" name="Findings Logging">
        <bpmn:documentation>Step 3: Findings Logging: Record &quot;Pass/Fail&quot; for each item; capture photos of any non-compliance
Responsible (R): Store/DC Manager
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W141_Flow18</bpmn:incoming>
        <bpmn:outgoing>W141_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W141_Task9" name="Immediate Fixes">
        <bpmn:documentation>Step 4: Immediate Fixes: Resolve low-risk items immediately (e.g., move a box blocking an exit); log as &quot;Corrected on Site&quot;
Responsible (R): Store/DC Manager
Accountable (A): —
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W141_Flow19</bpmn:incoming>
        <bpmn:outgoing>W141_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W141_Task10" name="Maintenance Request">
        <bpmn:documentation>Step 5: Maintenance Request: For structural/equipment issues, auto-generate Work Order in Facilities Mgmt system (W47)
Responsible (R): System
Accountable (A): Maintenance
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W141_Flow20</bpmn:incoming>
        <bpmn:outgoing>W141_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W141_Task11" name="Certification Tracking">
        <bpmn:documentation>Step 6: Certification Tracking: System tracks expiry of mandatory certifications: Fire Safety Inspection Certificate (FSIC), Elevator/Escalator permits, Forklift operator licenses
Responsible (R): Safety Officer
Accountable (A): Regulatory Officer
Duration: 15 min/month</bpmn:documentation>
        <bpmn:incoming>W141_Flow21</bpmn:incoming>
        <bpmn:outgoing>W141_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W141_Task12" name="Dashboard">
        <bpmn:documentation>Step 7: Dashboard: Safety Officer reviews &quot;Safety Compliance Score&quot; per region/location; flags high-risk locations for unannounced audit
Responsible (R): Safety Officer
Accountable (A): VP Store Operations
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W141_Flow22</bpmn:incoming>
        <bpmn:outgoing>W141_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W141_End13" name="Complete">
        <bpmn:incoming>W141_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W141_Annotation14">
        <bpmn:text>Controls: - CTL-226 (ensure OHS compliance &amp; incident management.) | - operational: Safety Officer review and approval gate
Owner: Safety Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W141_Assoc15" sourceRef="W141_Annotation14" targetRef="W141_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W141_Flow16" sourceRef="W141_Start5" targetRef="W141_Task6" />
      <bpmn:sequenceFlow id="W141_Flow17" sourceRef="W141_Task6" targetRef="W141_Task7" />
