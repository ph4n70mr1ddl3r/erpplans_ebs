<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-24.3-hazmat-management" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W236" name="W236. Hazmat Storage &amp; Segregation Compliance (DC)" isExecutable="false">
      <bpmn:documentation>Trigger: Receiving of Hazmat SKUs (W3)
Frequency: Daily
Volume: ~15% of SKUs (Paint, Thinners, Adhesives, Batteries)
Owner: DC Safety Officer
Participants: DC Receiving Clerk, Putaway Staff
Source: workflow W236 — Hazmat Storage &amp; Segregation Compliance (DC)</bpmn:documentation>
      <bpmn:laneSet id="W236_LaneSet4">
        <bpmn:lane id="W236_Lane1" name="System">
        <bpmn:flowNodeRef>W236_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W236_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W236_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W236_Lane2" name="DC Safety Officer">
        <bpmn:flowNodeRef>W236_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W236_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W236_Lane3" name="Putaway Staff">
        <bpmn:flowNodeRef>W236_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W236_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W236_Start5" name="Receiving of Hazmat SKUs (W3)">
        <bpmn:outgoing>W236_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W236_Task6" name="Identification">
        <bpmn:documentation>Step 1: Identification: System flags incoming SKU as &quot;Hazmat&quot; based on SDS (Safety Data Sheet) in Item Master
Responsible (R): System
Accountable (A): Receiving Clerk
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W236_Flow14</bpmn:incoming>
        <bpmn:outgoing>W236_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W236_Task7" name="Segregation Check">
        <bpmn:documentation>Step 2: Segregation Check: System suggests putaway in dedicated &quot;Hazmat Zone&quot; (Fire-rated area)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W236_Flow15</bpmn:incoming>
        <bpmn:outgoing>W236_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W236_Task8" name="Compatibility Review">
        <bpmn:documentation>Step 3: Compatibility Review: Verify SKU is not stored adjacent to incompatible chemicals (e.g., Flammables away from Oxidizers)
Responsible (R): DC Safety Officer
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W236_Flow16</bpmn:incoming>
        <bpmn:outgoing>W236_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W236_Task9" name="Containment">
        <bpmn:documentation>Step 4: Containment: Ensure secondary containment (spill pallets) is used for bulk liquid storage
Responsible (R): Putaway Staff
Accountable (A): DC Safety Officer
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W236_Flow17</bpmn:incoming>
        <bpmn:outgoing>W236_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W236_Task10" name="Signage">
        <bpmn:documentation>Step 5: Signage: Verify appropriate hazard placards (NFPA/GHS) are visible at the bin location
Responsible (R): DC Safety Officer
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W236_Flow18</bpmn:incoming>
        <bpmn:outgoing>W236_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W236_End11" name="Complete">
        <bpmn:incoming>W236_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W236_Annotation12">
        <bpmn:text>Controls: - CTL-315 (ensure controlled execution — Hazmat Management (PA-24.3).) | - operational: DC Safety Officer review and approval gate
Owner: DC Safety Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W236_Assoc13" sourceRef="W236_Annotation12" targetRef="W236_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W236_Flow14" sourceRef="W236_Start5" targetRef="W236_Task6" />
      <bpmn:sequenceFlow id="W236_Flow15" sourceRef="W236_Task6" targetRef="W236_Task7" />
      <bpmn:sequenceFlow id="W236_Flow16" sourceRef="W236_Task7" targetRef="W236_Task8" />
      <bpmn:sequenceFlow id="W236_Flow17" sourceRef="W236_Task8" targetRef="W236_Task9" />
      <bpmn:sequenceFlow id="W236_Flow18" sourceRef="W236_Task9" targetRef="W236_Task10" />
      <bpmn:sequenceFlow id="W236_Flow19" sourceRef="W236_Task10" targetRef="W236_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W236_diag">
      <bpmndi:BPMNPlane id="W236_plane" bpmnElement="W_W236">
        <bpmndi:BPMNShape id="W236_Lane1_di" bpmnElement="W236_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W236_Lane2_di" bpmnElement="W236_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W236_Lane3_di" bpmnElement="W236_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W236_Task6_di" bpmnElement="W236_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W236_Task7_di" bpmnElement="W236_Task7"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W236_Task8_di" bpmnElement="W236_Task8"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W236_Task9_di" bpmnElement="W236_Task9"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W236_Task10_di" bpmnElement="W236_Task10"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W236_Start5_di" bpmnElement="W236_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W236_End11_di" bpmnElement="W236_End11"><dc:Bounds x="1470" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W236_Annotation12_di" bpmnElement="W236_Annotation12"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W236_Flow14_di" bpmnElement="W236_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W236_Flow15_di" bpmnElement="W236_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W236_Flow16_di" bpmnElement="W236_Flow16"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W236_Flow17_di" bpmnElement="W236_Flow17"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W236_Flow18_di" bpmnElement="W236_Flow18"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W236_Flow19_di" bpmnElement="W236_Flow19"><di:waypoint x="1420" y="335" /><di:waypoint x="1470" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W236_Assoc13_di" bpmnElement="W236_Assoc13"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W237" name="W237. Hazmat Handling &amp; Safety Training (Store)" isExecutable="false">
      <bpmn:documentation>Trigger: New employee hire (W15); or annual refresher
Frequency: Annual
Volume: ~1,800–2,200 training events/year across 200 stores (per the staffing derivation)
Owner: Store Safety Officer
Participants: Store Staff, HR
Source: workflow W237 — Hazmat Handling &amp; Safety Training (Store)</bpmn:documentation>
      <bpmn:laneSet id="W237_LaneSet5">
        <bpmn:lane id="W237_Lane1" name="HR">
        <bpmn:flowNodeRef>W237_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W237_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W237_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W237_Lane2" name="Safety Officer">
        <bpmn:flowNodeRef>W237_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W237_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W237_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W237_Lane3" name="Dept Supervisor">
        <bpmn:flowNodeRef>W237_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W237_Lane4" name="System">
        <bpmn:flowNodeRef>W237_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W237_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W237_Start6" name="New employee hire (W15); or annual refresher">
        <bpmn:outgoing>W237_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W237_Task7" name="Training Module">
        <bpmn:documentation>Step 1: Training Module: Staff complete &quot;Hazmat Handling 101&quot; (PPE use, SDS reading, lifting techniques)
Responsible (R): HR / Safety Officer
Accountable (A): —
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W237_Flow17</bpmn:incoming>
        <bpmn:outgoing>W237_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W237_Task8" name="Assessment &amp; Quiz">
        <bpmn:documentation>Step 2: Assessment &amp; Quiz: Staff complete a written assessment with 80% passing threshold; those who fail must retake within 7 days
Responsible (R): Safety Officer
Accountable (A): HR Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W237_Flow18</bpmn:incoming>
        <bpmn:outgoing>W237_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W237_Task9" name="Certification Record">
        <bpmn:documentation>Step 3: Certification Record: System records training completion in employee file (W15); certificate valid for 12 months
Responsible (R): HR / System
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W237_Flow19</bpmn:incoming>
        <bpmn:outgoing>W237_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W237_Task10" name="PPE Inspection">
        <bpmn:documentation>Step 4: PPE Inspection: Daily check of available PPE (Gloves, Eye protection, Aprons) in Paint/Tile departments
Responsible (R): Safety Officer
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W237_Flow20</bpmn:incoming>
        <bpmn:outgoing>W237_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W237_Task11" name="Display Safety">
        <bpmn:documentation>Step 5: Display Safety: Ensure chemicals on shelves are not stacked &gt; 1.5m and are secured from falling
Responsible (R): Dept Supervisor
Accountable (A): —
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W237_Flow21</bpmn:incoming>
        <bpmn:outgoing>W237_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W237_Task12" name="Store-Specific Hazmat Inventory Audit">
        <bpmn:documentation>Step 6: Store-Specific Hazmat Inventory Audit: Safety Officer verifies SDS availability and GHS labels for all hazmat SKUs in the store&#x27;s active assortment
Responsible (R): Safety Officer
Accountable (A): Store Manager
Duration: 1 hour/quarter</bpmn:documentation>
        <bpmn:incoming>W237_Flow22</bpmn:incoming>
        <bpmn:outgoing>W237_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W237_Task13" name="Annual Refresher Scheduling">
        <bpmn:documentation>Step 7: Annual Refresher Scheduling: System auto-generates refresher training schedule 11 months after initial certification via W51 (Employee Training)
Responsible (R): System
Accountable (A): Safety Officer
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W237_Flow23</bpmn:incoming>
        <bpmn:outgoing>W237_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W237_End14" name="Complete">
        <bpmn:incoming>W237_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W237_Annotation15">
        <bpmn:text>Controls: - CTL-315 (ensure controlled execution — Hazmat Management (PA-24.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Store Safety Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W237_Assoc16" sourceRef="W237_Annotation15" targetRef="W237_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W237_Flow17" sourceRef="W237_Start6" targetRef="W237_Task7" />
      <bpmn:sequenceFlow id="W237_Flow18" sourceRef="W237_Task7" targetRef="W237_Task8" />
      <bpmn:sequenceFlow id="W237_Flow19" sourceRef="W237_Task8" targetRef="W237_Task9" />
      <bpmn:sequenceFlow id="W237_Flow20" sourceRef="W237_Task9" targetRef="W237_Task10" />
      <bpmn:sequenceFlow id="W237_Flow21" sourceRef="W237_Task10" targetRef="W237_Task11" />
      <bpmn:sequenceFlow id="W237_Flow22" sourceRef="W237_Task11" targetRef="W237_Task12" />
      <bpmn:sequenceFlow id="W237_Flow23" sourceRef="W237_Task12" targetRef="W237_Task13" />
      <bpmn:sequenceFlow id="W237_Flow24" sourceRef="W237_Task13" targetRef="W237_End14" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W237_diag">
      <bpmndi:BPMNPlane id="W237_plane" bpmnElement="W_W237">
        <bpmndi:BPMNShape id="W237_Lane1_di" bpmnElement="W237_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W237_Lane2_di" bpmnElement="W237_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W237_Lane3_di" bpmnElement="W237_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W237_Lane4_di" bpmnElement="W237_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W237_Task7_di" bpmnElement="W237_Task7"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W237_Task8_di" bpmnElement="W237_Task8"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W237_Task9_di" bpmnElement="W237_Task9"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W237_Task10_di" bpmnElement="W237_Task10"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W237_Task11_di" bpmnElement="W237_Task11"><dc:Bounds x="1240" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W237_Task12_di" bpmnElement="W237_Task12"><dc:Bounds x="1450" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W237_Task13_di" bpmnElement="W237_Task13"><dc:Bounds x="1660" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W237_Start6_di" bpmnElement="W237_Start6"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W237_End14_di" bpmnElement="W237_End14"><dc:Bounds x="1890" y="657" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W237_Annotation15_di" bpmnElement="W237_Annotation15"><dc:Bounds x="160" y="800" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W237_Flow17_di" bpmnElement="W237_Flow17"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W237_Flow18_di" bpmnElement="W237_Flow18"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W237_Flow19_di" bpmnElement="W237_Flow19"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W237_Flow20_di" bpmnElement="W237_Flow20"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W237_Flow21_di" bpmnElement="W237_Flow21"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W237_Flow22_di" bpmnElement="W237_Flow22"><di:waypoint x="1420" y="505" /><di:waypoint x="1450" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W237_Flow23_di" bpmnElement="W237_Flow23"><di:waypoint x="1630" y="335" /><di:waypoint x="1660" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W237_Flow24_di" bpmnElement="W237_Flow24"><di:waypoint x="1840" y="675" /><di:waypoint x="1890" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W237_Assoc16_di" bpmnElement="W237_Assoc16"><di:waypoint x="340" y="800" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W238" name="W238. Hazmat Spill Response &amp; Incident Management" isExecutable="false">
      <bpmn:documentation>Trigger: Discovery of a spill or leak (Paint, Chemical, Battery acid)
Frequency: Ad-hoc (Rare)
Volume: ~10–20 significant spills/year chain-wide
Owner: Safety Officer
Participants: Response Team, Store/DC Manager
Source: workflow W238 — Hazmat Spill Response &amp; Incident Management</bpmn:documentation>
      <bpmn:laneSet id="W238_LaneSet4">
        <bpmn:lane id="W238_Lane1" name="Response Team">
        <bpmn:flowNodeRef>W238_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W238_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W238_Lane2" name="Safety Officer">
        <bpmn:flowNodeRef>W238_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W238_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W238_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W238_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W238_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W238_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W238_Lane3" name="Store Mgr">
        <bpmn:flowNodeRef>W238_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W238_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W238_Start5" name="Discovery of a spill or leak (Paint, Chemical, Battery acid)">
        <bpmn:outgoing>W238_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W238_Task6" name="Containment">
        <bpmn:documentation>Step 1: Containment: Evacuate immediate area; deploy spill kit (absorbent pads, socks); isolate the hazard zone
Responsible (R): Response Team
Accountable (A): Safety Officer
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W238_Flow17</bpmn:incoming>
        <bpmn:outgoing>W238_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W238_Task7" name="Evacuation Decision">
        <bpmn:documentation>Step 2: Evacuation Decision: Safety Officer assesses spill volume and toxicity — minor (&lt; 5L, low toxicity): localized containment; major (&gt; 5L or toxic/corrosive): initiate full area evacuation per emergency plan
Responsible (R): Safety Officer
Accountable (A): Store/DC Manager
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W238_Flow18</bpmn:incoming>
        <bpmn:outgoing>W238_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W238_Task8" name="Reporting">
        <bpmn:documentation>Step 3: Reporting: Create Incident Report in system (W140) with photos, SDS reference, and estimated volume
Responsible (R): Safety Officer
Accountable (A): Store Mgr
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W238_Flow19</bpmn:incoming>
        <bpmn:outgoing>W238_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W238_Task9" name="DENR Notification">
        <bpmn:documentation>Step 4: DENR Notification: If spill exceeds reportable quantity threshold (per DENR-EMB), Safety Officer notifies DENR-EMB regional office within 24 hours
Responsible (R): Safety Officer
Accountable (A): VP Legal
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W238_Flow20</bpmn:incoming>
        <bpmn:outgoing>W238_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W238_Task10" name="Cleanup">
        <bpmn:documentation>Step 5: Cleanup: Trained staff or licensed hazmat contractor disposes of contaminated materials as &quot;Hazardous Waste&quot; per W82 and DENR DAO 2013-22
Responsible (R): Safety Officer / Contractor
Accountable (A): —
Duration: 1-4 hours</bpmn:documentation>
        <bpmn:incoming>W238_Flow21</bpmn:incoming>
        <bpmn:outgoing>W238_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W238_Task11" name="Inventory Adjustment">
        <bpmn:documentation>Step 6: Inventory Adjustment: Record loss in system via W92 (Damage); system updates hazmat inventory and triggers replenishment if needed
Responsible (R): Store Mgr
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W238_Flow22</bpmn:incoming>
        <bpmn:outgoing>W238_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W238_Task12" name="Employee Medical Evaluation">
        <bpmn:documentation>Step 7: Employee Medical Evaluation: If any employee was exposed, refer to company clinic or nearest hospital within 24 hours; document in W140 incident file
Responsible (R): Safety Officer
Accountable (A): HR Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W238_Flow23</bpmn:incoming>
        <bpmn:outgoing>W238_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W238_Task13" name="Root Cause Analysis &amp; Trend Reporting">
        <bpmn:documentation>Step 8: Root Cause Analysis &amp; Trend Reporting: Within 7 days, Safety Officer completes RCA (5 Whys); quarterly, HQ Safety aggregates all spill incidents across 200 stores/4 DCs for trend analysis and prevention measures
Responsible (R): Safety Officer
Accountable (A): CHRO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W238_Flow24</bpmn:incoming>
        <bpmn:outgoing>W238_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W238_End14" name="Complete">
        <bpmn:incoming>W238_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W238_Annotation15">
        <bpmn:text>Controls: - CTL-226 (ensure OHS compliance &amp; incident management.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Safety Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W238_Assoc16" sourceRef="W238_Annotation15" targetRef="W238_Start5" associationDirection="None" />
