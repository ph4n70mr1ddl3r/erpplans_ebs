        <bpmndi:BPMNShape id="W803_Task6_di" bpmnElement="W803_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W803_Task7_di" bpmnElement="W803_Task7"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W803_Task8_di" bpmnElement="W803_Task8"><dc:Bounds x="1240" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W803_Start3_di" bpmnElement="W803_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W803_End9_di" bpmnElement="W803_End9"><dc:Bounds x="1470" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W803_Annotation10_di" bpmnElement="W803_Annotation10"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W803_Flow12_di" bpmnElement="W803_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W803_Flow13_di" bpmnElement="W803_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W803_Flow14_di" bpmnElement="W803_Flow14"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W803_Flow15_di" bpmnElement="W803_Flow15"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W803_Flow16_di" bpmnElement="W803_Flow16"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W803_Flow17_di" bpmnElement="W803_Flow17"><di:waypoint x="1420" y="165" /><di:waypoint x="1470" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W803_Assoc11_di" bpmnElement="W803_Assoc11"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1312" name="W1312. Store-Level Hazardous Material (Paint/Chemical/Solvent) Spill Response, Cleanup &amp; Environmental Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Hazardous material spill at store (paint, solvent, thinner, adhesive, pesticide, or other chemical product); or customer reports chemical spill in parking lot/lumber yard
Frequency: ~2–5 minor spills per store per month (mostly small paint spills during customer handling); ~5–10 significant spills chain-wide per year (container failure, forklift damage, customer accident)
Volume: ~200 stores carrying ~2,800 paint/chemical SKUs; ~400–1,000 minor spill incidents/month chain-wide (2–5/store/month per the Frequency); ~5–10 significant incidents/year
Owner: Store Manager
Participants: Store Manager, Department Supervisor (Paint &amp; Finishes), Maintenance/Utility Staff, Safety Officer, DENR Emergency Response (for major spills), Security Guard
Source: workflow W1312 — Store-Level Hazardous Material (Paint/Chemical/Solvent) Spill Response, Cleanup &amp; Environmental Reporting</bpmn:documentation>
      <bpmn:laneSet id="W1312_LaneSet4">
        <bpmn:lane id="W1312_Lane1" name="Department Supervisor">
        <bpmn:flowNodeRef>W1312_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1312_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1312_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1312_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1312_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W1312_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1312_Lane3" name="Maintenance Staff">
        <bpmn:flowNodeRef>W1312_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1312_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1312_Start5" name="Hazardous material spill at store (paint, solvent, thinner, adhesive, pesticide, or other…">
        <bpmn:outgoing>W1312_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1312_Task6" name="Immediate spill containment">
        <bpmn:documentation>Step 1: Immediate spill containment: (a) staff member who discovers spill: (i) alerts nearby customers and staff — move away from spill area, (ii) identifies spilled material: check container label or nearby shelf label for product name and hazard class, (iii) if flammable: eliminate ignition sources (no smoking, no welding nearby, turn off nearby electrical equipment if safe), (iv) if corrosive: avoid skin contact — wear chemical-resistant gloves from spill kit, (v) if toxic: evacuate immediate area and ventilate (open doors, turn on exhaust fans); (b) Department Supervisor activates spill response: (i) retrieve spill kit from designated location (spill kits located at paint department, receiving dock, and customer service counter — each kit contains: absorbent pads, absorbent granules, chemical-resistant gloves, goggles, disposal bags, caution tape, spill response instruction card), (ii) don PPE per spill kit instructions, (iii) contain spill: place absorbent pads around spill perimeter to prevent spread, (iv) if spill is flowing toward floor drain: deploy drain cover (included in spill kit) to prevent environmental contamination
Responsible (R): Department Supervisor / Maintenance Staff
Accountable (A): Store Manager
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W1312_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1312_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1312_Task7" name="Spill cleanup &amp; material-specific protocol">
        <bpmn:documentation>Step 2: Spill cleanup &amp; material-specific protocol: (a) Paint spill: (i) absorbent granules/pads to contain and absorb liquid, (ii) scoop absorbed paint into hazardous waste disposal bag, (iii) clean residual stain with appropriate cleaner (water-based paint: soap and water; oil-based paint: mineral spirits — use sparingly with ventilation), (iv) place all contaminated materials in disposal bag; (b) Solvent/thinner spill: (i) evacuate area if spill &gt; 1 liter (flammable vapor risk), (ii) ventilate area (open doors, fans), (iii) absorb with chemical-specific absorbent (not sawdust — fire risk with solvent-soaked sawdust), (iv) place in sealed disposal bag — label as &quot;Flammable Waste&quot;, (v) store in flammable storage cabinet pending hazardous waste pickup per W443; (c) Corrosive spill (acid/alkali): (i) for small spill (&lt; 500 ml): neutralize with appropriate neutralizing agent from spill kit (sodium bicarbonate for acid, citric acid for alkali), (ii) for large spill: evacuate and call Safety Officer; (iii) absorb neutralized material and place in disposal bag; (d) Pesticide spill: (i) avoid skin contact and inhalation, (ii) contain and absorb, (iii) all contaminated materials placed in sealed, labeled hazardous waste bag — &quot;Pesticide Contaminated Waste&quot;; (e) for all spills: (i) clean affected floor area — dry completely before allowing foot traffic, (ii) replace damaged packaging if product container was the source (transfer remaining product to new container or dispose as damaged goods per W91)
Responsible (R): Department Supervisor / Maintenance Staff
Accountable (A): Store Manager
Duration: 15–45 min depending on spill size</bpmn:documentation>
        <bpmn:incoming>W1312_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1312_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1312_Task8" name="Significant spill escalation &amp; environmental reporting">
        <bpmn:documentation>Step 3: Significant spill escalation &amp; environmental reporting: (a) for spills meeting any of these criteria: (i) &gt; 5 liters of any hazardous material, (ii) any quantity reaching floor drain, storm drain, or waterway, (iii) any spill involving corrosive material (pH &lt; 2 or &gt; 12.5), (iv) any spill causing customer or staff injury, (v) any solvent spill creating fire hazard: (b) Store Manager escalates: (i) call Safety Officer immediately for on-site support, (ii) call Fire Department (BFP) if fire risk exists, (iii) evacuate store if vapor/inhalation hazard per W330, (iv) notify Regional Manager and COO; (c) if spill reaches waterway or drain: (i) Store Manager notifies DENR Emergency Response within 24 hours per DAO 2013-22, (ii) document: location, material, estimated quantity, cause, containment measures taken, environmental impact assessment, (iii) engage licensed hazardous waste cleanup contractor if spill exceeds store capability; (d) if customer/staff injury: (i) administer first aid per W501, (ii) transport to hospital if chemical burn or inhalation injury, (iii) incident report per W440 and DOLE reporting if hospitalization required
Responsible (R): Store Manager / Safety Officer
Accountable (A): COO
Duration: Per event: 2–8 hours for significant spills</bpmn:documentation>
        <bpmn:incoming>W1312_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1312_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1312_Task9" name="Post-spill documentation &amp; root cause analysis">
        <bpmn:documentation>Step 4: Post-spill documentation &amp; root cause analysis: (a) Department Supervisor completes spill incident report: (i) date, time, location, (ii) spilled material (product name, SKU, hazard class), (iii) estimated quantity, (iv) cause (customer drop, container failure, forklift damage, shelf collapse, leaking packaging), (v) response actions taken, (vi) cleanup time and materials used, (vii) environmental impact (reached drain? waterway?), (viii) customer/staff injury (if any), (ix) photos of spill, cleanup, and affected area; (b) Store Manager reviews and identifies root cause: (i) customer education needed (better signage on handling heavy/fragile containers?), (ii) container quality issue (vendor packaging fails — initiate vendor claim per W110), (iii) storage issue (chemicals stored inappropriately — shelf overloaded, not in containment tray), (iv) staff training gap (inadequate material handling training); (c) implement corrective action: (i) vendor claim for packaging failure, (ii) shelf restacking or containment tray installation, (iii) staff retraining on hazardous material handling per W655
Responsible (R): Department Supervisor / Store Manager
Accountable (A): Store Manager
Duration: 15–30 min per incident</bpmn:documentation>
        <bpmn:incoming>W1312_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1312_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1312_Task10" name="Spill prevention &amp; spill kit maintenance">
        <bpmn:documentation>Step 5: Spill prevention &amp; spill kit maintenance: (a) monthly: Maintenance Staff inspects spill kits: (i) verify all spill kits fully stocked (absorbent pads, granules, gloves, goggles, bags, drain covers), (ii) replace any used or expired items, (iii) verify spill kit locations are accessible and clearly marked; (b) quarterly: Safety Officer conducts hazardous material storage audit: (i) all chemicals stored on containment trays or in containment shelving (catches leaks before reaching floor), (ii) flammable storage cabinet properly vented and locked, (iii) chemical shelf labels accurate and hazard diamonds visible, (iv) MSDS (Material Safety Data Sheets) binder at paint department current and accessible, (v) no expired chemicals on shelf (expired paint, pesticides past efficacy date); (c) annual: all paint department staff complete hazardous material handling refresher training per W655
Responsible (R): Maintenance Staff / Safety Officer
Accountable (A): Store Manager
Duration: Monthly: 30 min; Quarterly: 2 hours; Annual: 4 hours</bpmn:documentation>
        <bpmn:incoming>W1312_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1312_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1312_End11" name="Complete">
        <bpmn:incoming>W1312_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1312_Annotation12">
        <bpmn:text>Controls: - CTL-315 (ensure controlled execution — Hazmat Management (PA-24.3).) | - operational: Store Manager review and approval gate
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
