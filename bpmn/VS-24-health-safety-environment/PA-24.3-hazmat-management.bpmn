      <bpmndi:BPMNPlane id="W698_plane" bpmnElement="W_W698">
        <bpmndi:BPMNShape id="W698_Lane1_di" bpmnElement="W698_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
