      <bpmn:sequenceFlow id="W698_Flow19" sourceRef="W698_Task9" targetRef="W698_Task10" />
      <bpmn:sequenceFlow id="W698_Flow20" sourceRef="W698_Task10" targetRef="W698_Task11" />
      <bpmn:sequenceFlow id="W698_Flow21" sourceRef="W698_Task11" targetRef="W698_Task12" />
      <bpmn:sequenceFlow id="W698_Flow22" sourceRef="W698_Task12" targetRef="W698_Task13" />
      <bpmn:sequenceFlow id="W698_Flow23" sourceRef="W698_Task13" targetRef="W698_End14" />
    </bpmn:process>
