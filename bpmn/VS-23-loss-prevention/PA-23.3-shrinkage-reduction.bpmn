<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-23.3-shrinkage-reduction" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W846" name="W846. Loss Prevention Training, Awareness &amp; Compliance Program" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled — onboarding (new hire), annual refresher (all store employees), quarterly update (Store Managers and LP-sensitive roles)
Frequency: Onboarding: per new hire (~100–130 new hires/month per profile §11.4 — turnover replacement plus new-store openings); Annual refresher: all ~5,800 store employees; Quarterly update: 200 Store Managers + 400 key holders
Volume: ~1,200–1,600 training completions per year (onboarding per profile §11.4) + ~5,800 annual refresher completions + ~2,400 quarterly update completions (600 per quarter)
Owner: LP Training Coordinator / HR Training Manager
Participants: LP Manager (Regional), Store Manager, New Hire Employee, HR Training Manager, External Training Provider (for specialized topics)
Source: workflow W846 — Loss Prevention Training, Awareness &amp; Compliance Program</bpmn:documentation>
      <bpmn:laneSet id="W846_LaneSet5">
        <bpmn:lane id="W846_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W846_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W846_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W846_Lane2" name="LP Training Coordinator">
        <bpmn:flowNodeRef>W846_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W846_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W846_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W846_Lane3" name="LP Manager">
        <bpmn:flowNodeRef>W846_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W846_Lane4" name="LP Analyst">
        <bpmn:flowNodeRef>W846_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W846_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W846_Start6" name="Scheduled — onboarding (new hire), annual refresher (all store employees), quarterly…">
        <bpmn:outgoing>W846_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W846_Task7" name="New hire LP orientation (Day 2 of onboarding) — cover cash handling policy…">
        <bpmn:documentation>Step 1: New hire LP orientation (Day 2 of onboarding) — cover cash handling policy, return/refund procedure, receiving verification, EAS tagging, incident reporting, whistleblower channel, and consequences of theft
Responsible (R): Store Manager / HR Training
Accountable (A): LP Manager (Regional)
Duration: 2 hours per new hire batch</bpmn:documentation>
        <bpmn:incoming>W846_Flow16</bpmn:incoming>
        <bpmn:outgoing>W846_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W846_Task8" name="Annual LP refresher training (e-learning + in-store practical) — update on new…">
        <bpmn:documentation>Step 2: Annual LP refresher training (e-learning + in-store practical) — update on new fraud schemes, policy changes, exception report awareness, and shrinkage results; includes quiz (minimum 80% pass rate)
Responsible (R): LP Training Coordinator
Accountable (A): National LP Director
Duration: 1 hour per employee (e-learning) + 30 min practical</bpmn:documentation>
        <bpmn:incoming>W846_Flow17</bpmn:incoming>
        <bpmn:outgoing>W846_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W846_Task9" name="Quarterly LP awareness update for Store Managers — review chain-wide LP…">
        <bpmn:documentation>Step 3: Quarterly LP awareness update for Store Managers — review chain-wide LP metrics, share anonymized case studies, introduce new detection tools or policy changes, set quarterly LP targets
Responsible (R): LP Manager (Regional)
Accountable (A): National LP Director
Duration: 2 hours per session (regional grouping)</bpmn:documentation>
        <bpmn:incoming>W846_Flow18</bpmn:incoming>
        <bpmn:outgoing>W846_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W846_Task10" name="Specialized LP training for receiving clerks — vendor fraud indicators, dock…">
        <bpmn:documentation>Step 4: Specialized LP training for receiving clerks — vendor fraud indicators, dock security procedures, weight verification, short-shipment detection; certification required before solo receiving shifts
Responsible (R): LP Training Coordinator
Accountable (A): LP Manager (Regional)
Duration: 4 hours per clerk (initial) + 2 hours annual refresh</bpmn:documentation>
        <bpmn:incoming>W846_Flow19</bpmn:incoming>
        <bpmn:outgoing>W846_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W846_Task11" name="LP awareness campaign execution — monthly LP tip of the month (digital poster +…">
        <bpmn:documentation>Step 5: LP awareness campaign execution — monthly LP tip of the month (digital poster + store huddle talking point), quarterly LP awareness week (in-store displays, reward for LP tips), annual LP excellence awards
Responsible (R): LP Training Coordinator
Accountable (A): National LP Director
Duration: 4 hours monthly</bpmn:documentation>
        <bpmn:incoming>W846_Flow20</bpmn:incoming>
        <bpmn:outgoing>W846_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W846_Task12" name="Training effectiveness measurement — track shrinkage correlation with training…">
        <bpmn:documentation>Step 6: Training effectiveness measurement — track shrinkage correlation with training completion rates, quiz scores, and time-to-incident for new hires; adjust curriculum based on findings
Responsible (R): LP Analyst
Accountable (A): National LP Director
Duration: 4 hours quarterly</bpmn:documentation>
        <bpmn:incoming>W846_Flow21</bpmn:incoming>
        <bpmn:outgoing>W846_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W846_End13" name="Complete">
        <bpmn:incoming>W846_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W846_Annotation14">
        <bpmn:text>Controls: - CTL-312 (ensure controlled execution — Shrinkage Reduction (PA-23.3).) | - operational: LP Training Coordinator / HR Training Manager review and approval gate
Owner: LP Training Coordinator / HR Training Manager</bpmn:text>
      </bpmn:textAnnotation>
