        <bpmndi:BPMNShape id="W1249_Task11_di" bpmnElement="W1249_Task11"><dc:Bounds x="1030" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1249_Task12_di" bpmnElement="W1249_Task12"><dc:Bounds x="1240" y="805" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1249_Start7_di" bpmnElement="W1249_Start7"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1249_End13_di" bpmnElement="W1249_End13"><dc:Bounds x="1470" y="827" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1249_Annotation14_di" bpmnElement="W1249_Annotation14"><dc:Bounds x="160" y="970" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1249_Flow16_di" bpmnElement="W1249_Flow16"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1249_Flow17_di" bpmnElement="W1249_Flow17"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1249_Flow18_di" bpmnElement="W1249_Flow18"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
