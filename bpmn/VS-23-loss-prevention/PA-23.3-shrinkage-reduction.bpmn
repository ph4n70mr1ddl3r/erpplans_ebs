        <bpmndi:BPMNShape id="W1173_Lane3_di" bpmnElement="W1173_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1173_Lane4_di" bpmnElement="W1173_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1580" height="170" /></bpmndi:BPMNShape>
