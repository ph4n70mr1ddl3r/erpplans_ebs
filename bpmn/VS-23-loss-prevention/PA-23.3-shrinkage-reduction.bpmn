    <bpmn:process id="W_W1497" name="W1497. Store-Level Anti-Theft Cable &amp; Sensor Tag Deployment, Deactivation Compliance &amp; Equipment Maintenance" isExecutable="false">
      <bpmn:documentation>Trigger: New high-theft-risk SKU identification by LP Analyst; also triggered by seasonal theft pattern change or new store opening
Frequency: Monthly risk assessment; continuous tag deployment on flagged items; quarterly equipment audit
Volume: ~300–500 tagged items per store across high-risk categories (power tools, accessories, copper wire, premium plumbing fixtures); ~200 stores
Owner: LP Analyst
Participants: LP Associate (Store), Department Supervisor, Cashier, LP Equipment Vendor
Source: workflow W1497 — Store-Level Anti-Theft Cable &amp; Sensor Tag Deployment, Deactivation Compliance &amp; Equipment Maintenance</bpmn:documentation>
      <bpmn:laneSet id="W1497_LaneSet6">
        <bpmn:lane id="W1497_Lane1" name="LP Analyst">
        <bpmn:flowNodeRef>W1497_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1497_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1497_Lane2" name="Stock Associate">
        <bpmn:flowNodeRef>W1497_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1497_Lane3" name="Cashier">
        <bpmn:flowNodeRef>W1497_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1497_Lane4" name="CSR">
        <bpmn:flowNodeRef>W1497_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1497_Lane5" name="LP Equipment Vendor">
        <bpmn:flowNodeRef>W1497_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1497_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1497_Start7" name="New high-theft-risk SKU identification by LP Analyst; also triggered by seasonal theft…">
        <bpmn:outgoing>W1497_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1497_Task8" name="Monthly high-theft-risk SKU identification">
        <bpmn:documentation>Step 1: Monthly high-theft-risk SKU identification: Monthly: (a) LP Analyst reviews shrinkage data by SKU: (i) POS sales vs. cycle count adjustments; (ii) known theft incidents; (iii) exception-based analytics flags per PA-23.1; (b) SKUs with shrinkage &gt; 2% of sales flagged for tagging; (c) new product launches in high-risk categories (power tools, accessories, copper products) auto-flagged; (d) LP Analyst publishes updated &quot;Tagged SKU List&quot; to all stores via LP portal; (e) Department Supervisors acknowledge receipt and confirm tagging compliance within 48 hours
Responsible (R): LP Analyst
Accountable (A): LP Manager
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W1497_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1497_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1497_Task9" name="Tag deployment at shelf/receiving">
        <bpmn:documentation>Step 2: Tag deployment at shelf/receiving: (a) for incoming shipments of tagged SKUs: Stock Associates apply EAS tags or cable locks per the tagging standard: (i) small items (drill bits, saw blades): EAS label inside packaging or sticker tag on exterior; (ii) medium items (power tool accessories, faucets): EAS hard tag with pin through packaging or cable loop; (iii) large items (power tools, copper wire rolls): steel cable lock through item and display hook; (b) tag type and placement documented in the Tagging Standards Manual with photo examples per category; (c) Stock Associate certifies tagging completion per shipment in system; (d) Department Supervisor spot-checks 10% of tagged items daily
Responsible (R): Stock Associate
Accountable (A): Department Supervisor
Duration: ~2 min per item tagged; ~30–60 min/day per store</bpmn:documentation>
        <bpmn:incoming>W1497_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1497_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1497_Task10" name="POS deactivation at checkout">
        <bpmn:documentation>Step 3: POS deactivation at checkout: (a) when customer purchases a tagged item: Cashier scans barcode and deactivates EAS tag: (i) EAS labels: passed over deactivation pad at POS counter (deactivates magnetic strip); (ii) EAS hard tags: removed using detacher tool at counter; (iii) cable locks: removed using cable key (kept at register); (b) system logs deactivation event with transaction ID and cashier ID; (c) if deactivation fails (pad not working, detacher broken): Cashier calls Department Supervisor for manual override; (d) manual override logged as exception for LP review
Responsible (R): Cashier
Accountable (A): Department Supervisor
Duration: ~10 sec per item at checkout</bpmn:documentation>
        <bpmn:incoming>W1497_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1497_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1497_Task11" name="Exit alarm response protocol">
        <bpmn:documentation>Step 4: Exit alarm response protocol: When EAS gate alarm triggers: (a) CSR or LP Associate stationed near exit responds; (b) politely asks customer: &quot;Sir/Ma&#x27;am, may we check if an item needs to be deactivated?&quot;; (c) scans customer&#x27;s receipt and checks bags against purchased items; (d) if un-deactivated tag found: deactivated at counter, customer thanked and released; (e) if unpurchased tagged item found: LP Associate follows PA-23.1 investigation protocol; (f) all alarm events logged in system for pattern analysis; (g) false alarm rate tracked — target &lt; 10% of alarms
Responsible (R): CSR / LP Associate
Accountable (A): LP Manager
Duration: 2–5 min per alarm event</bpmn:documentation>
        <bpmn:incoming>W1497_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1497_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1497_Task12" name="Quarterly equipment maintenance &amp; calibration">
        <bpmn:documentation>Step 5: Quarterly equipment maintenance &amp; calibration: Quarterly: (a) LP Equipment Vendor performs: (i) EAS gate sensitivity test (must detect all tag types at 1.5m distance); (ii) deactivation pad effectiveness test; (iii) detacher tool functionality check; (iv) cable key inventory reconciliation; (b) faulty equipment replaced within 5 business days; (c) calibration certificate issued per store; (d) LP Associate verifies all EAS gates operational at store opening daily
Responsible (R): LP Equipment Vendor / LP Associate
Accountable (A): LP Manager
Duration: 2–3 hours/quarter per store</bpmn:documentation>
        <bpmn:incoming>W1497_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1497_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1497_End13" name="Complete">
        <bpmn:incoming>W1497_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1497_Annotation14">
        <bpmn:text>Controls: - CTL-312 (ensure controlled execution — Shrinkage Reduction (PA-23.3).) | - operational: strict detacher-tool and key custody protocol
Owner: LP Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1497_Assoc15" sourceRef="W1497_Annotation14" targetRef="W1497_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W1497_Flow16" sourceRef="W1497_Start7" targetRef="W1497_Task8" />
      <bpmn:sequenceFlow id="W1497_Flow17" sourceRef="W1497_Task8" targetRef="W1497_Task9" />
      <bpmn:sequenceFlow id="W1497_Flow18" sourceRef="W1497_Task9" targetRef="W1497_Task10" />
      <bpmn:sequenceFlow id="W1497_Flow19" sourceRef="W1497_Task10" targetRef="W1497_Task11" />
      <bpmn:sequenceFlow id="W1497_Flow20" sourceRef="W1497_Task11" targetRef="W1497_Task12" />
      <bpmn:sequenceFlow id="W1497_Flow21" sourceRef="W1497_Task12" targetRef="W1497_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1497_diag">
