      <bpmn:sequenceFlow id="W1336_Flow17" sourceRef="W1336_Task7" targetRef="W1336_Task8" />
      <bpmn:sequenceFlow id="W1336_Flow18" sourceRef="W1336_Task8" targetRef="W1336_Task9" />
      <bpmn:sequenceFlow id="W1336_Flow19" sourceRef="W1336_Task9" targetRef="W1336_Task10" />
      <bpmn:sequenceFlow id="W1336_Flow20" sourceRef="W1336_Task10" targetRef="W1336_Task11" />
      <bpmn:sequenceFlow id="W1336_Flow21" sourceRef="W1336_Task11" targetRef="W1336_End12" />
    </bpmn:process>
