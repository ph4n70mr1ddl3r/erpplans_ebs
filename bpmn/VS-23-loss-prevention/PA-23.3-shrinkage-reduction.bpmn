      <bpmn:sequenceFlow id="W1338_Flow17" sourceRef="W1338_Task7" targetRef="W1338_Task8" />
      <bpmn:sequenceFlow id="W1338_Flow18" sourceRef="W1338_Task8" targetRef="W1338_Task9" />
      <bpmn:sequenceFlow id="W1338_Flow19" sourceRef="W1338_Task9" targetRef="W1338_Task10" />
      <bpmn:sequenceFlow id="W1338_Flow20" sourceRef="W1338_Task10" targetRef="W1338_Task11" />
      <bpmn:sequenceFlow id="W1338_Flow21" sourceRef="W1338_Task11" targetRef="W1338_End12" />
    </bpmn:process>
