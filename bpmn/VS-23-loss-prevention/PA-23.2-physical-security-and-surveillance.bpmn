        <bpmndi:BPMNShape id="W1388_Start5_di" bpmnElement="W1388_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1388_End12_di" bpmnElement="W1388_End12"><dc:Bounds x="1680" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1388_Annotation13_di" bpmnElement="W1388_Annotation13"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1388_Flow15_di" bpmnElement="W1388_Flow15"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1388_Flow16_di" bpmnElement="W1388_Flow16"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1388_Flow17_di" bpmnElement="W1388_Flow17"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1388_Flow18_di" bpmnElement="W1388_Flow18"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1388_Flow19_di" bpmnElement="W1388_Flow19"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1388_Flow20_di" bpmnElement="W1388_Flow20"><di:waypoint x="1420" y="505" /><di:waypoint x="1450" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1388_Flow21_di" bpmnElement="W1388_Flow21"><di:waypoint x="1630" y="335" /><di:waypoint x="1680" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1388_Assoc14_di" bpmnElement="W1388_Assoc14"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1389" name="W1389. Store After-Hours Burglary Alarm Response, Police Coordination &amp; Incident Documentation" isExecutable="false">
      <bpmn:documentation>Trigger: Store burglar alarm activation during non-operating hours (10:00 PM – 7:00 AM); alarm monitoring center (AMC) notifies LP Operations Center
Frequency: ~15–25 alarm activations/month chain-wide; ~5–10 confirmed burglaries or break-in attempts/year
Volume: ~180–300 alarm activations/year; majority are false alarms (animals, wind, power fluctuation, employee error)
Owner: LP Operations Center Manager
Participants: LP Operations Center, LPO, Store Manager, Security Guard Agency, Philippine National Police (PNP), Insurance Coordinator, Facilities Manager
Source: workflow W1389 — Store After-Hours Burglary Alarm Response, Police Coordination &amp; Incident Documentation</bpmn:documentation>
      <bpmn:laneSet id="W1389_LaneSet9">
        <bpmn:lane id="W1389_Lane1" name="AMC">
        <bpmn:flowNodeRef>W1389_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1389_Start10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1389_Lane2" name="LP Analyst">
        <bpmn:flowNodeRef>W1389_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1389_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1389_Lane3" name="First Responder">
        <bpmn:flowNodeRef>W1389_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1389_Lane4" name="Store Manager">
        <bpmn:flowNodeRef>W1389_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1389_Lane5" name="LPO">
        <bpmn:flowNodeRef>W1389_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1389_Lane6" name="Insurance Coordinator">
        <bpmn:flowNodeRef>W1389_Task17</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1389_Lane7" name="Facilities Tech">
        <bpmn:flowNodeRef>W1389_Task18</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1389_Lane8" name="LP Manager">
        <bpmn:flowNodeRef>W1389_Task19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1389_End20</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1389_Start10" name="Store burglar alarm activation during non-operating hours (10:00 PM – 7:00 AM); alarm…">
        <bpmn:outgoing>W1389_Flow23</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1389_Task11" name="Alarm activation">
        <bpmn:documentation>Step 1: Alarm activation: alarm system triggers at store during non-operating hours; alarm monitoring center (AMC) receives signal with zone identification (which sensor triggered: door, window, motion, glass break); AMC calls LP Operations Center and designated Store Manager simultaneously
Responsible (R): AMC / LP Ops Center
Accountable (A): LP Ops Center Mgr
Duration: Immediate</bpmn:documentation>
        <bpmn:incoming>W1389_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1389_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1389_Task12" name="Initial triage">
        <bpmn:documentation>Step 2: Initial triage (within 5 minutes): LP Analyst reviews alarm details: (a) which zone(s) triggered — single zone (likely false alarm) vs. multiple zones in sequence (likely genuine intrusion); (b) review CCTV remote feed (if available and internet is up) — visual confirmation of intruder vs. empty store; (c) check if any scheduled activity (night cleaning, early morning delivery) explains the activation
Responsible (R): LP Analyst
Accountable (A): LP Ops Center Mgr
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1389_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1389_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1389_Task13" name="Decision">
        <bpmn:documentation>Step 3: Decision: (a) Confirmed false alarm — LP Analyst resets alarm remotely, notifies Store Manager and security guard on duty; no police dispatch; log as false alarm; (b) Confirmed intrusion or cannot verify — LP Analyst dispatches response: (i) call security guard agency mobile patrol (if contracted), (ii) call PNP local station, (iii) notify Store Manager to respond to store, (iv) continue monitoring CCTV if available
Responsible (R): LP Analyst
Accountable (A): LP Ops Center Mgr
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1389_Flow25</bpmn:incoming>
        <bpmn:outgoing>W1389_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1389_Task14" name="On-site response">
        <bpmn:documentation>Step 4: On-site response: first responder arrives (security patrol, PNP, or Store Manager): (a) do NOT enter store alone — wait for backup; (b) perimeter check from outside — broken window, forced door, vehicle near dock; (c) if intruder still present — PNP handles apprehension; if intruder fled — preserve scene
Responsible (R): First Responder / PNP
Accountable (A): LP Ops Center Mgr
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W1389_Flow26</bpmn:incoming>
        <bpmn:outgoing>W1389_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1389_Task15" name="Scene entry and assessment">
        <bpmn:documentation>Step 5: Scene entry and assessment (after PNP clears scene or confirms intruder gone): (a) Store Manager and LPO enter store; (b) document point of entry (photograph); (c) identify stolen merchandise — walk each department, compare shelf/display quantities against pre-close inventory snapshot; (d) LPO reviews CCTV footage with Store Manager to identify intruder(s), entry/exit times, and items taken; (e) record all findings in incident report
Responsible (R): Store Manager / LPO
Accountable (A): LP Ops Center Mgr
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W1389_Flow27</bpmn:incoming>
        <bpmn:outgoing>W1389_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1389_Task16" name="Police report">
        <bpmn:documentation>Step 6: Police report: LPO or Store Manager files official police report (Blotter) with local PNP station: (a) time of break-in, (b) point of entry, (c) list of stolen items with values, (d) CCTV footage screenshots of intruder(s), (e) obtain police blotter reference number (required for insurance claim)
Responsible (R): LPO / Store Manager
Accountable (A): LP Ops Center Mgr
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W1389_Flow28</bpmn:incoming>
        <bpmn:outgoing>W1389_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1389_Task17" name="Insurance notification">
        <bpmn:documentation>Step 7: Insurance notification: within 24 hours, Insurance Coordinator notifies property/crime insurance carrier of burglary claim per W610; provides police blotter, incident report, and CCTV footage
Responsible (R): Insurance Coordinator
Accountable (A): CFO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W1389_Flow29</bpmn:incoming>
        <bpmn:outgoing>W1389_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1389_Task18" name="Damage repair and securing">
        <bpmn:documentation>Step 8: Damage repair and securing: Facilities Technician repairs point of entry (broken window, forced door, cut fence/grille) same day; upgrades security if weakness identified (e.g., add anti-pry bars, reinforce glass with security film); store cannot remain open with compromised physical security
Responsible (R): Facilities Tech / Store Manager
Accountable (A): LP Ops Center Mgr
Duration: 2–8 hours</bpmn:documentation>
        <bpmn:incoming>W1389_Flow30</bpmn:incoming>
        <bpmn:outgoing>W1389_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1389_Task19" name="Post-incident review">
        <bpmn:documentation>Step 9: Post-incident review: LP Manager reviews each confirmed burglary: (a) vulnerability assessment — how did intruder gain entry? (b) was alarm system adequate? (c) CCTV footage quality sufficient for identification? (d) response time from alarm to on-site presence; (e) recommendations for security upgrade; (f) if pattern identified (same MO across multiple stores), issue chain-wide security alert
Responsible (R): LP Manager
Accountable (A): VP Store Operations
Duration: 1 hour/incident</bpmn:documentation>
        <bpmn:incoming>W1389_Flow31</bpmn:incoming>
        <bpmn:outgoing>W1389_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1389_End20" name="Complete">
        <bpmn:incoming>W1389_Flow32</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1389_Annotation21">
        <bpmn:text>Controls: - CTL-311 (ensure controlled execution — Physical Security &amp; Surveillance (PA-23.2).) | - operational: LP Operations Center Manager review and approval gate
Owner: LP Operations Center Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1389_Assoc22" sourceRef="W1389_Annotation21" targetRef="W1389_Start10" associationDirection="None" />
      <bpmn:sequenceFlow id="W1389_Flow23" sourceRef="W1389_Start10" targetRef="W1389_Task11" />
