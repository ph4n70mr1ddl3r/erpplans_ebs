    <bpmn:process id="W_W1247" name="W1247. Outdoor Lumber Yard &amp; Building Material Yard Theft Prevention &amp; Surveillance" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled — daily surveillance protocol; ad-hoc triggered by exception report (W837), inventory variance alert, or incident report
Frequency: Daily (every operating day at all 200 stores with lumber yards)
Volume: 200 stores × daily surveillance protocol; estimated 15–25 lumber yard theft incidents per month chain-wide
Owner: LP Officer (Store-Level) / Store Manager
Participants: LP Analyst, Lumber Yard Sales Associate, Department Supervisor (Lumber &amp; Building Materials), LP Manager (Regional)
Source: workflow W1247 — Outdoor Lumber Yard &amp; Building Material Yard Theft Prevention &amp; Surveillance</bpmn:documentation>
      <bpmn:laneSet id="W1247_LaneSet4">
        <bpmn:lane id="W1247_Lane1" name="Lumber Yard Sales Associate">
        <bpmn:flowNodeRef>W1247_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1247_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1247_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1247_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1247_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1247_Lane2" name="Department Supervisor">
        <bpmn:flowNodeRef>W1247_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1247_Lane3" name="LP Officer">
        <bpmn:flowNodeRef>W1247_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1247_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1247_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1247_Start5" name="Scheduled — daily surveillance protocol; ad-hoc triggered by exception report (W837)…">
        <bpmn:outgoing>W1247_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1247_Task6" name="Opening yard security check">
        <bpmn:documentation>Step 1: Opening yard security check: Before customer access, Lumber Yard Sales Associate conducts perimeter walk: (a) verify fencing integrity — no cuts, breaches, or lifted sections; (b) check all gates locked and chain intact; (c) verify CCTV camera coverage of yard entry/exit points (minimum 4 cameras per yard: main gate, vehicle exit, pedestrian entry, high-value display); (d) confirm yard lighting operational for evening hours; (e) report any security deficiencies to Store Manager before yard opens
Responsible (R): Lumber Yard Sales Associate
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1247_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1247_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1247_Task7" name="High-value material inventory spot-check">
        <bpmn:documentation>Step 2: High-value material inventory spot-check: Verify physical count of top 20 highest-value lumber and building material SKUs against system on-hand: (a) premium plywood bundles, (b) structural lumber (2×4, 2×6 per board), (c) rebar bundles, (d) cement pallets, (e) steel pipe lengths; flag variance &gt; 2 units per SKU for investigation
Responsible (R): Lumber Yard Sales Associate
Accountable (A): Department Supervisor
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W1247_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1247_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1247_Task8" name="Customer vehicle loading monitoring">
        <bpmn:documentation>Step 3: Customer vehicle loading monitoring: During operating hours, Sales Associate monitors customer vehicle loading zone: (a) verify customer presents sales receipt before loading bulky items into vehicle; (b) match receipt line items to physical goods being loaded; (c) for large purchases (&gt; PHP 10,000 in lumber/CM), verify payment completed at POS before release; (d) log vehicle plate number for purchases &gt; PHP 20,000
Responsible (R): Lumber Yard Sales Associate
Accountable (A): Department Supervisor
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W1247_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1247_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1247_Task9" name="Contractor crew access control">
        <bpmn:documentation>Step 4: Contractor crew access control: For registered trade account customers purchasing in bulk: (a) verify trade account ID and authorized purchaser list; (b) issue yard access badge that logs entry/exit time; (c) limit yard access to 2 crew members per account visit; (d) verify total loaded quantity matches invoice before yard exit
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 5 min per crew</bpmn:documentation>
        <bpmn:incoming>W1247_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1247_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1247_Task10" name="CCTV real-time monitoring review">
        <bpmn:documentation>Step 5: CCTV real-time monitoring review: LP Officer reviews CCTV footage for lumber yard during high-risk windows (opening hour, lunch rush, closing hour): (a) flag vehicles entering loading zone without stopping at POS; (b) identify individuals loitering near high-value stacks; (c) detect concealment of smaller items (tools, fittings) within lumber bundles; (d) cross-reference vehicle plates with previous incident database
Responsible (R): LP Officer / LP Analyst
Accountable (A): LP Manager (Regional)
Duration: 30 min/day</bpmn:documentation>
        <bpmn:incoming>W1247_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1247_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1247_Task11" name="Incident response for yard theft">
        <bpmn:documentation>Step 6: Incident response for yard theft: If theft detected: (a) approach subject with minimum 2 staff present; (b) if customer has unpaid goods in vehicle, request return to POS for payment; (c) if subject refuses or flees, record vehicle description, plate number, and CCTV timestamp — do not physically pursue; (d) file incident report within 1 hour; (e) for repeat offenders or organized groups, escalate to LP Manager (Regional) for investigation per W840
Responsible (R): LP Officer / Department Supervisor
Accountable (A): Store Manager
Duration: 30–60 min per incident</bpmn:documentation>
        <bpmn:incoming>W1247_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1247_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1247_Task12" name="Closing yard security protocol">
        <bpmn:documentation>Step 7: Closing yard security protocol: After customer hours: (a) final yard walk to verify no customers or unauthorized persons remain; (b) conduct closing count of top 10 high-value SKUs; (c) secure all gates with padlock; (d) verify CCTV recording continues in night-vision mode; (e) report any closing variance to Store Manager via system alert
Responsible (R): Lumber Yard Sales Associate
Accountable (A): Store Manager
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W1247_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1247_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1247_End13" name="Complete">
        <bpmn:incoming>W1247_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1247_Annotation14">
        <bpmn:text>Controls: - CTL-311 (ensure controlled execution — Physical Security &amp; Surveillance (PA-23.2).) | - operational: LP Officer (Store-Level) / Store Manager review and approval gate
Owner: LP Officer (Store-Level) / Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1247_Assoc15" sourceRef="W1247_Annotation14" targetRef="W1247_Start5" associationDirection="None" />
