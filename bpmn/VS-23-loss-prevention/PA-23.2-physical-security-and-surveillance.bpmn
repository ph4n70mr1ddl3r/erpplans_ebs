<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-23.2-physical-security-and-surveillance" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W838" name="W838. CCTV &amp; Surveillance System Daily Operations &amp; Incident Review" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled — daily operations review; ad-hoc triggered by exception report (W837) or incident report
Frequency: Daily (continuous monitoring during store hours; incident review within 24 hours)
Volume: 200 stores × average 2–3 incident reviews per day = ~400–600 reviews; 24/7 continuous monitoring at 4 DCs
Owner: LP Officer (Store-Level) / Security Operations Center (SOC) Lead
Participants: LP Analyst, Store Manager, IT Security, External Security Agency (contracted)
Source: workflow W838 — CCTV &amp; Surveillance System Daily Operations &amp; Incident Review</bpmn:documentation>
      <bpmn:laneSet id="W838_LaneSet4">
        <bpmn:lane id="W838_Lane1" name="IT Security">
        <bpmn:flowNodeRef>W838_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W838_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W838_Lane2" name="SOC Operator">
        <bpmn:flowNodeRef>W838_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W838_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W838_Lane3" name="LP Analyst">
        <bpmn:flowNodeRef>W838_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W838_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W838_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W838_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W838_Start5" name="Scheduled — daily operations review; ad-hoc triggered by exception report (W837) or…">
        <bpmn:outgoing>W838_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W838_Task6" name="Verify all store CCTV cameras online and recording — automated health check at…">
        <bpmn:documentation>Step 1: Verify all store CCTV cameras online and recording — automated health check at store open; flag any offline cameras to IT Security for immediate remediation
Responsible (R): IT Security
Accountable (A): SOC Lead
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W838_Flow15</bpmn:incoming>
        <bpmn:outgoing>W838_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W838_Task7" name="Monitor real-time camera feeds at SOC for 4 DCs and 10 highest-shrinkage stores…">
        <bpmn:documentation>Step 2: Monitor real-time camera feeds at SOC for 4 DCs and 10 highest-shrinkage stores (rotating selection monthly)
Responsible (R): SOC Operator
Accountable (A): SOC Lead
Duration: Continuous (shift-based)</bpmn:documentation>
        <bpmn:incoming>W838_Flow16</bpmn:incoming>
        <bpmn:outgoing>W838_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W838_Task8" name="Review flagged incidents from exception report (W837) — retrieve footage for…">
        <bpmn:documentation>Step 3: Review flagged incidents from exception report (W837) — retrieve footage for timestamp window, document observation, tag for investigation if warranted
Responsible (R): LP Analyst
Accountable (A): LP Manager (Regional)
Duration: 60 min</bpmn:documentation>
        <bpmn:incoming>W838_Flow17</bpmn:incoming>
        <bpmn:outgoing>W838_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W838_Task9" name="Conduct spot-check surveillance review — random selection of 5 stores per day…">
        <bpmn:documentation>Step 4: Conduct spot-check surveillance review — random selection of 5 stores per day for cashier area, entrance/exit, and high-value merchandise zones
Responsible (R): LP Analyst
Accountable (A): LP Manager (Regional)
Duration: 45 min</bpmn:documentation>
        <bpmn:incoming>W838_Flow18</bpmn:incoming>
        <bpmn:outgoing>W838_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W838_Task10" name="Archive incident footage per retention policy — 30 days routine, 1 year for…">
        <bpmn:documentation>Step 5: Archive incident footage per retention policy — 30 days routine, 1 year for active investigation, 7 years for prosecuted cases (aligned with criminal-prosecution prescriptive periods; CCTV footage is governed by legal/LP practice, separate from the 10-year BIR accounting-records retention)
Responsible (R): LP Analyst
Accountable (A): SOC Lead
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W838_Flow19</bpmn:incoming>
        <bpmn:outgoing>W838_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W838_Task11" name="Generate daily CCTV operational status report — camera uptime %, incident…">
        <bpmn:documentation>Step 6: Generate daily CCTV operational status report — camera uptime %, incident captures, response time to offline alerts
Responsible (R): SOC Operator
Accountable (A): SOC Lead
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W838_Flow20</bpmn:incoming>
        <bpmn:outgoing>W838_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W838_End12" name="Complete">
        <bpmn:incoming>W838_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W838_Annotation13">
        <bpmn:text>Controls: - CTL-311 (ensure controlled execution — Physical Security &amp; Surveillance (PA-23.2).) | - operational: LP Officer (Store-Level) / Security Operations Center (SOC) Lead review and approval gate
Owner: LP Officer (Store-Level) / Security Operations Center (SOC) Lead</bpmn:text>
      </bpmn:textAnnotation>
