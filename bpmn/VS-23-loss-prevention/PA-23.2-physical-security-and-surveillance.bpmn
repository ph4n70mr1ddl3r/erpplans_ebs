    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1247_diag">
      <bpmndi:BPMNPlane id="W1247_plane" bpmnElement="W_W1247">
        <bpmndi:BPMNShape id="W1247_Lane1_di" bpmnElement="W1247_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
