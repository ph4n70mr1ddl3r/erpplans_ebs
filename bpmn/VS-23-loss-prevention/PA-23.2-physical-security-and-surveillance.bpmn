      <bpmn:sequenceFlow id="W1477_Flow21" sourceRef="W1477_Task11" targetRef="W1477_Task12" />
      <bpmn:sequenceFlow id="W1477_Flow22" sourceRef="W1477_Task12" targetRef="W1477_End13" />
    </bpmn:process>
