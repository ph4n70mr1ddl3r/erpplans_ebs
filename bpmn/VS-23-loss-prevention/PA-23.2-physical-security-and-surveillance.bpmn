    <bpmn:process id="W_W844" name="W844. Store Entrance/Exit Audit &amp; Electronic Article Surveillance (EAS) Management" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled — monthly per store; or triggered by EAS alarm frequency spike or shrinkage result
Frequency: Monthly per store (200 stores = ~200 audits/month); daily EAS alarm response
Volume: ~200 entrance/exit audits/month; ~500–800 EAS alarm responses per day chain-wide
Owner: LP Officer (Store-Level) / Security Guard (contracted)
Participants: Store Manager, LP Analyst, Security Guard Agency Supervisor, IT Security
Source: workflow W844 — Store Entrance/Exit Audit &amp; Electronic Article Surveillance (EAS) Management</bpmn:documentation>
      <bpmn:laneSet id="W844_LaneSet4">
        <bpmn:lane id="W844_Lane1" name="Security Guard">
        <bpmn:flowNodeRef>W844_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W844_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W844_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W844_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W844_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W844_Lane3" name="LP Analyst">
        <bpmn:flowNodeRef>W844_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W844_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W844_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W844_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W844_Start5" name="Scheduled — monthly per store; or triggered by EAS alarm frequency spike or shrinkage…">
        <bpmn:outgoing>W844_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W844_Task6" name="EAS alarm response — security guard approaches customer, requests to verify…">
        <bpmn:documentation>Step 1: EAS alarm response — security guard approaches customer, requests to verify purchase, checks receipt against bag contents, tags/detags merchandise, logs alarm in incident register
Responsible (R): Security Guard
Accountable (A): Store Manager
Duration: 5 min per alarm</bpmn:documentation>
        <bpmn:incoming>W844_Flow15</bpmn:incoming>
        <bpmn:outgoing>W844_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W844_Task7" name="Daily EAS alarm log review — Store Manager reviews incident register; flag…">
        <bpmn:documentation>Step 2: Daily EAS alarm log review — Store Manager reviews incident register; flag repeat alarm locations (may indicate tag deactivation failure), repeat individuals, or alarm-to-apprehension ratio
Responsible (R): Store Manager
Accountable (A): LP Manager (Regional)
Duration: 15 min daily</bpmn:documentation>
        <bpmn:incoming>W844_Flow16</bpmn:incoming>
        <bpmn:outgoing>W844_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W844_Task8" name="Monthly entrance/exit audit — verify EAS gate functionality, tag application…">
        <bpmn:documentation>Step 3: Monthly entrance/exit audit — verify EAS gate functionality, tag application compliance at checkout, source-tagging compliance for high-risk SKUs, security guard presence and procedure adherence
Responsible (R): LP Analyst
Accountable (A): LP Manager (Regional)
Duration: 60 min per store</bpmn:documentation>
        <bpmn:incoming>W844_Flow17</bpmn:incoming>
        <bpmn:outgoing>W844_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W844_Task9" name="EAS tag inventory management — reconcile EAS tag stock (hard tags, soft…">
        <bpmn:documentation>Step 4: EAS tag inventory management — reconcile EAS tag stock (hard tags, soft labels), order replenishment, ensure tag availability at all POS terminals and receiving dock
Responsible (R): Store Manager
Accountable (A): LP Manager (Regional)
Duration: 30 min monthly</bpmn:documentation>
        <bpmn:incoming>W844_Flow18</bpmn:incoming>
        <bpmn:outgoing>W844_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W844_Task10" name="Source-tagging compliance verification — confirm vendor-applied EAS labels on…">
        <bpmn:documentation>Step 5: Source-tagging compliance verification — confirm vendor-applied EAS labels on high-risk categories (power tools, electrical, plumbing fittings, adhesives) per vendor agreement
Responsible (R): LP Analyst
Accountable (A): Procurement Manager
Duration: 2 hours monthly</bpmn:documentation>
        <bpmn:incoming>W844_Flow19</bpmn:incoming>
        <bpmn:outgoing>W844_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W844_Task11" name="Generate monthly EAS effectiveness report — alarm rate, apprehension rate, tag…">
        <bpmn:documentation>Step 6: Generate monthly EAS effectiveness report — alarm rate, apprehension rate, tag application compliance %, shrinkage correlation by store
Responsible (R): LP Analyst
Accountable (A): LP Manager (Regional)
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W844_Flow20</bpmn:incoming>
        <bpmn:outgoing>W844_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W844_End12" name="Complete">
        <bpmn:incoming>W844_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W844_Annotation13">
        <bpmn:text>Controls: - CTL-311 (ensure controlled execution — Physical Security &amp; Surveillance (PA-23.2).) | - operational: maintenance (gate calibration, deactivator pad replacement) requires specialized vendor support
Owner: LP Officer (Store-Level) / Security Guard (contracted)</bpmn:text>
      </bpmn:textAnnotation>
