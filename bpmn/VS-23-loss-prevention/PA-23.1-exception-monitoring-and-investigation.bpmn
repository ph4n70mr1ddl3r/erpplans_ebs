<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-23.1-exception-monitoring-and-investigation" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W837" name="W837. Daily Store Exception-Based Reporting &amp; Transaction Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Automated — POS transaction data feed processed nightly; exception alerts generated when thresholds breached
Frequency: Daily (every store, every operating day)
Volume: 200 stores × ~15–25 flagged exceptions per store per day = ~3,000–5,000 exception alerts daily chain-wide
Owner: Loss Prevention Manager (Regional)
Participants: Store Manager, LP Analyst, POS System Administrator, Finance Controller, Senior LP Analytics Analyst
Source: workflow W837 — Daily Store Exception-Based Reporting &amp; Transaction Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W837_LaneSet3">
        <bpmn:lane id="W837_Lane1" name="LP Analyst">
        <bpmn:flowNodeRef>W837_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W837_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W837_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W837_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W837_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W837_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W837_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W837_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W837_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W837_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W837_Start4" name="Automated — POS transaction data feed processed nightly; exception alerts generated when…">
        <bpmn:outgoing>W837_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W837_Task5" name="Automated POS data extraction and exception rule engine execution — flag voids…">
        <bpmn:documentation>Step 1: Automated POS data extraction and exception rule engine execution — flag voids, no-sales, excessive discounts, high-value refunds, post-void patterns, and override frequency by cashier
Responsible (R): LP Analyst
Accountable (A): LP Manager (Regional)
Duration: 30 min (automated + validation)</bpmn:documentation>
        <bpmn:incoming>W837_Flow15</bpmn:incoming>
        <bpmn:outgoing>W837_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W837_Task6" name="Review prioritized exception dashboard — sort by severity (critical: repeat…">
        <bpmn:documentation>Step 2: Review prioritized exception dashboard — sort by severity (critical: repeat offenders, high-value anomalies; medium: single threshold breach; low: borderline)
Responsible (R): LP Analyst
Accountable (A): LP Manager (Regional)
Duration: 45 min</bpmn:documentation>
        <bpmn:incoming>W837_Flow16</bpmn:incoming>
        <bpmn:outgoing>W837_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W837_Task7" name="Cross-reference flagged transactions against CCTV timestamp log and cashier…">
        <bpmn:documentation>Step 3: Cross-reference flagged transactions against CCTV timestamp log and cashier shift schedule
Responsible (R): LP Analyst
Accountable (A): Store Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W837_Flow17</bpmn:incoming>
        <bpmn:outgoing>W837_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W837_Task8" name="Escalate critical exceptions (value &gt; PHP 10,000 or repeat pattern ≥ 3…">
        <bpmn:documentation>Step 4: Escalate critical exceptions (value &gt; PHP 10,000 or repeat pattern ≥ 3 occurrences) to regional LP Manager with evidence package
Responsible (R): LP Analyst
Accountable (A): LP Manager (Regional)
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W837_Flow18</bpmn:incoming>
        <bpmn:outgoing>W837_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W837_Task9" name="Document non-critical exceptions in case log with disposition (explained, under…">
        <bpmn:documentation>Step 5: Document non-critical exceptions in case log with disposition (explained, under review, escalated)
Responsible (R): LP Analyst
Accountable (A): Store Manager
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W837_Flow19</bpmn:incoming>
        <bpmn:outgoing>W837_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W837_Task10" name="Generate daily LP summary report — total exceptions by category, store ranking…">
        <bpmn:documentation>Step 6: Generate daily LP summary report — total exceptions by category, store ranking, trend vs. prior week
Responsible (R): LP Analyst
Accountable (A): LP Manager (Regional)
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W837_Flow20</bpmn:incoming>
        <bpmn:outgoing>W837_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W837_Task11" name="Store Manager reviews and acknowledges store-level exception summary; provides…">
        <bpmn:documentation>Step 7: Store Manager reviews and acknowledges store-level exception summary; provides context for explained items
Responsible (R): Store Manager
Accountable (A): LP Manager (Regional)
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W837_Flow21</bpmn:incoming>
        <bpmn:outgoing>W837_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W837_End12" name="Complete">
        <bpmn:incoming>W837_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W837_Annotation13">
        <bpmn:text>Controls: - CTL-225 (ensure shrinkage detection &amp; case governance.) | - operational: Loss Prevention Manager (Regional) review and approval gate
Owner: Loss Prevention Manager (Regional)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W837_Assoc14" sourceRef="W837_Annotation13" targetRef="W837_Start4" associationDirection="None" />
