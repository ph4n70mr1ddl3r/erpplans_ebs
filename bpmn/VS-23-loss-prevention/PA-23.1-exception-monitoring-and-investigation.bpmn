      </bpmn:laneSet>
      <bpmn:startEvent id="W842_Start5" name="Automated — POS cash variance threshold breach, or sweethearting pattern detected by…">
        <bpmn:outgoing>W842_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W842_Task6" name="Automated cash variance monitoring — flag: drawer shortage &gt; PHP 500, drawer…">
        <bpmn:documentation>Step 1: Automated cash variance monitoring — flag: drawer shortage &gt; PHP 500, drawer overage &gt; PHP 200, repeated small shortages by same cashier (≥ 3 in 5 days), no-sale drawer opens &gt; 5 per shift
Responsible (R): LP Analyst
Accountable (A): Finance Controller
Duration: 30 min (automated)</bpmn:documentation>
        <bpmn:incoming>W842_Flow15</bpmn:incoming>
        <bpmn:outgoing>W842_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W842_Task7" name="Sweethearting pattern detection — flag: cashier passes items without scanning…">
        <bpmn:documentation>Step 2: Sweethearting pattern detection — flag: cashier passes items without scanning, manual price entry below SRP, unauthorized discount application, cancellation of items after customer leaves with merchandise, scanning personal loyalty card for customer purchases
Responsible (R): LP Analyst
Accountable (A): LP Manager (Regional)
Duration: 45 min daily review</bpmn:documentation>
        <bpmn:incoming>W842_Flow16</bpmn:incoming>
        <bpmn:outgoing>W842_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W842_Task8" name="Cross-reference cash exceptions with CCTV at POS terminal — verify legitimate…">
        <bpmn:documentation>Step 3: Cross-reference cash exceptions with CCTV at POS terminal — verify legitimate explanations (system error, customer dispute, training issue) vs. deliberate manipulation
Responsible (R): LP Analyst
Accountable (A): Store Manager
Duration: 30 min per escalated case</bpmn:documentation>
        <bpmn:incoming>W842_Flow17</bpmn:incoming>
        <bpmn:outgoing>W842_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W842_Task9" name="For confirmed sweethearting: compile evidence package, escalate to LP…">
        <bpmn:documentation>Step 4: For confirmed sweethearting: compile evidence package, escalate to LP Investigator for integrity interview (per W839 process)
Responsible (R): LP Investigator
Accountable (A): LP Manager (Regional)
Duration: 4–8 hours per case</bpmn:documentation>
        <bpmn:incoming>W842_Flow18</bpmn:incoming>
        <bpmn:outgoing>W842_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W842_Task10" name="Cash handling coaching — for non-fraud variances, Store Manager conducts…">
        <bpmn:documentation>Step 5: Cash handling coaching — for non-fraud variances, Store Manager conducts corrective coaching with cashier; document in HR file
Responsible (R): Store Manager
Accountable (A): LP Manager (Regional)
Duration: 30 min per session</bpmn:documentation>
        <bpmn:incoming>W842_Flow19</bpmn:incoming>
        <bpmn:outgoing>W842_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W842_Task11" name="Monthly cash variance trend report — store ranking, cashier ranking, trend vs…">
        <bpmn:documentation>Step 6: Monthly cash variance trend report — store ranking, cashier ranking, trend vs. prior month, root cause analysis for top 10 variance stores
Responsible (R): LP Analyst
Accountable (A): Finance Controller
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W842_Flow20</bpmn:incoming>
        <bpmn:outgoing>W842_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W842_End12" name="Complete">
        <bpmn:incoming>W842_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W842_Annotation13">
        <bpmn:text>Controls: - CTL-225 (ensure shrinkage detection &amp; case governance.) | - operational: standard operating procedures; system-enforced validation rules
Owner: LP Analyst / Finance Controller</bpmn:text>
      </bpmn:textAnnotation>
