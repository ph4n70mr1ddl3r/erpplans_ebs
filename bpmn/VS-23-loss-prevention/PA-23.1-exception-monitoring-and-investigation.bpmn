    <bpmn:process id="W_W839" name="W839. Internal Theft Investigation &amp; Employee Dishonesty Case Management" isExecutable="false">
      <bpmn:documentation>Trigger: Exception report pattern (W837), CCTV observation (W838), anonymous tip, or inventory variance threshold breach
Frequency: As-needed; estimated 5–10 active investigations ongoing at any time chain-wide
Volume: ~50–80 completed investigations per year; average case duration 2–6 weeks
Owner: LP Manager (Regional)
Participants: LP Investigator, HR Manager, Legal Counsel, Store Manager, Finance Controller, Union Representative (if applicable), Forensic / Fraud Investigator
Source: workflow W839 — Internal Theft Investigation &amp; Employee Dishonesty Case Management</bpmn:documentation>
      <bpmn:laneSet id="W839_LaneSet3">
        <bpmn:lane id="W839_Lane1" name="LP Investigator">
        <bpmn:flowNodeRef>W839_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W839_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W839_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W839_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W839_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W839_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W839_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W839_Lane2" name="LP Manager">
        <bpmn:flowNodeRef>W839_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W839_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W839_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W839_Start4" name="Exception report pattern (W837), CCTV observation (W838), anonymous tip, or inventory…">
        <bpmn:outgoing>W839_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W839_Task5" name="Receive and document allegation — source (exception report, tip, CCTV), subject…">
        <bpmn:documentation>Step 1: Receive and document allegation — source (exception report, tip, CCTV), subject employee(s), initial evidence summary, and estimated loss value
Responsible (R): LP Investigator
Accountable (A): LP Manager (Regional)
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W839_Flow16</bpmn:incoming>
        <bpmn:outgoing>W839_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W839_Task6" name="Conduct preliminary assessment — verify exception patterns, review transaction…">
        <bpmn:documentation>Step 2: Conduct preliminary assessment — verify exception patterns, review transaction history (30-day lookback), cross-reference with inventory variance data
Responsible (R): LP Investigator
Accountable (A): LP Manager (Regional)
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W839_Flow17</bpmn:incoming>
        <bpmn:outgoing>W839_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W839_Task7" name="Determine investigation classification — minor (&lt; PHP 50,000): store-level…">
        <bpmn:documentation>Step 3: Determine investigation classification — minor (&lt; PHP 50,000): store-level resolution; major (&gt; PHP 50,000 or management-level subject): regional/national investigation
Responsible (R): LP Manager (Regional)
Accountable (A): National LP Director
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W839_Flow18</bpmn:incoming>
        <bpmn:outgoing>W839_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W839_Task8" name="Build evidence package — compile transaction logs, CCTV footage, inventory…">
        <bpmn:documentation>Step 4: Build evidence package — compile transaction logs, CCTV footage, inventory discrepancy reports, witness statements, and pattern analysis
Responsible (R): LP Investigator
Accountable (A): LP Manager (Regional)
Duration: 8–16 hours (over multiple days)</bpmn:documentation>
        <bpmn:incoming>W839_Flow19</bpmn:incoming>
        <bpmn:outgoing>W839_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W839_Task9" name="Conduct integrity interview (with HR witness present) — present evidence…">
        <bpmn:documentation>Step 5: Conduct integrity interview (with HR witness present) — present evidence, obtain written statement, document admission or denial
Responsible (R): LP Investigator
Accountable (A): LP Manager (Regional)
Duration: 1–3 hours</bpmn:documentation>
        <bpmn:incoming>W839_Flow20</bpmn:incoming>
        <bpmn:outgoing>W839_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W839_Task10" name="Determine disciplinary action in consultation with HR and Legal — options range…">
        <bpmn:documentation>Step 6: Determine disciplinary action in consultation with HR and Legal — options range from written warning to termination, criminal complaint, or civil recovery
Responsible (R): LP Manager (Regional)
Accountable (A): National LP Director
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W839_Flow21</bpmn:incoming>
        <bpmn:outgoing>W839_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W839_Task11" name="Process recovery — deduct from final pay (within DOLE limits), file insurance…">
        <bpmn:documentation>Step 7: Process recovery — deduct from final pay (within DOLE limits), file insurance claim if applicable, issue demand letter for civil recovery
Responsible (R): LP Investigator
Accountable (A): Finance Controller
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W839_Flow22</bpmn:incoming>
        <bpmn:outgoing>W839_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W839_Task12" name="Close case — update case management system, archive evidence per retention…">
        <bpmn:documentation>Step 8: Close case — update case management system, archive evidence per retention policy, generate lessons-learned summary, update exception rules if new pattern identified
Responsible (R): LP Investigator
Accountable (A): LP Manager (Regional)
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W839_Flow23</bpmn:incoming>
        <bpmn:outgoing>W839_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W839_End13" name="Complete">
        <bpmn:incoming>W839_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W839_Annotation14">
        <bpmn:text>Controls: - CTL-225 (ensure shrinkage detection &amp; case governance.) | - operational: LP Manager (Regional) review and approval gate
Owner: LP Manager (Regional)</bpmn:text>
      </bpmn:textAnnotation>
