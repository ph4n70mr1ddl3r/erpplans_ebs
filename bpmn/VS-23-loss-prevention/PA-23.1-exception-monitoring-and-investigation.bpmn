    <bpmn:process id="W_W843" name="W843. Vendor &amp; Delivery Fraud Detection &amp; Dock Security Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled dock audits (weekly per store); or triggered by receiving variance exception from WMS
Frequency: Weekly dock audits per store; continuous monitoring via receiving variance data
Volume: 200 stores × 1 dock audit/week = ~800 audits/month; ~5–10 vendor fraud cases per year
Owner: LP Manager (Regional)
Participants: Store Receiving Clerk, Store Manager, Procurement Specialist, LP Investigator, Vendor Account Manager
Source: workflow W843 — Vendor &amp; Delivery Fraud Detection &amp; Dock Security Audit</bpmn:documentation>
      <bpmn:laneSet id="W843_LaneSet5">
        <bpmn:lane id="W843_Lane1" name="LP Analyst">
        <bpmn:flowNodeRef>W843_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W843_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W843_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W843_Lane2" name="LP Investigator">
        <bpmn:flowNodeRef>W843_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W843_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W843_Lane3" name="Procurement Specialist">
        <bpmn:flowNodeRef>W843_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W843_Lane4" name="LP Manager">
        <bpmn:flowNodeRef>W843_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W843_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W843_Start6" name="Scheduled dock audits (weekly per store); or triggered by receiving variance exception…">
        <bpmn:outgoing>W843_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W843_Task7" name="Conduct unannounced dock audit — verify incoming shipment against PO and ASN…">
        <bpmn:documentation>Step 1: Conduct unannounced dock audit — verify incoming shipment against PO and ASN: unit count, SKU accuracy, weight verification, condition assessment; compare vendor delivery vehicle manifest against system PO
Responsible (R): LP Analyst / Store Receiving Clerk
Accountable (A): LP Manager (Regional)
Duration: 60 min per audit</bpmn:documentation>
        <bpmn:incoming>W843_Flow16</bpmn:incoming>
        <bpmn:outgoing>W843_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W843_Task8" name="Review receiving variance data — flag vendors with &gt; 2% quantity variance rate…">
        <bpmn:documentation>Step 2: Review receiving variance data — flag vendors with &gt; 2% quantity variance rate or &gt; PHP 5,000 cumulative variance in rolling 30-day period
Responsible (R): LP Analyst
Accountable (A): Procurement Manager
Duration: 30 min weekly</bpmn:documentation>
        <bpmn:incoming>W843_Flow17</bpmn:incoming>
        <bpmn:outgoing>W843_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W843_Task9" name="Identify fraud indicators — short shipment, phantom items (invoiced but not…">
        <bpmn:documentation>Step 3: Identify fraud indicators — short shipment, phantom items (invoiced but not delivered), substitution (lower-grade product), duplicate delivery, or collusion with receiving clerk
Responsible (R): LP Investigator
Accountable (A): LP Manager (Regional)
Duration: 2–4 hours per case</bpmn:documentation>
        <bpmn:incoming>W843_Flow18</bpmn:incoming>
        <bpmn:outgoing>W843_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W843_Task10" name="Conduct vendor fraud investigation — compile receiving records, interview…">
        <bpmn:documentation>Step 4: Conduct vendor fraud investigation — compile receiving records, interview receiving clerk, review CCTV of dock area, contact vendor for explanation
Responsible (R): LP Investigator
Accountable (A): LP Manager (Regional)
Duration: 8–16 hours per case</bpmn:documentation>
        <bpmn:incoming>W843_Flow19</bpmn:incoming>
        <bpmn:outgoing>W843_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W843_Task11" name="Vendor resolution — issue debit memo for shortage, require vendor corrective…">
        <bpmn:documentation>Step 5: Vendor resolution — issue debit memo for shortage, require vendor corrective action plan, escalate to Procurement for vendor review/suspension if pattern confirmed
Responsible (R): Procurement Specialist
Accountable (A): Procurement Manager
Duration: 4 hours per case</bpmn:documentation>
        <bpmn:incoming>W843_Flow20</bpmn:incoming>
        <bpmn:outgoing>W843_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W843_Task12" name="Quarterly dock security assessment — evaluate physical security (locking gates…">
        <bpmn:documentation>Step 6: Quarterly dock security assessment — evaluate physical security (locking gates, CCTV coverage, scales calibration), receiving clerk procedures compliance, and vendor credential verification
Responsible (R): LP Manager (Regional)
Accountable (A): National LP Director
Duration: 4 hours per region (quarterly)</bpmn:documentation>
        <bpmn:incoming>W843_Flow21</bpmn:incoming>
        <bpmn:outgoing>W843_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W843_End13" name="Complete">
        <bpmn:incoming>W843_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W843_Annotation14">
        <bpmn:text>Controls: - CTL-310 (ensure controlled execution — Exception Monitoring &amp; Investigation (PA-23.1).) | - operational: LP Manager (Regional) review and approval gate
Owner: LP Manager (Regional)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W843_Assoc15" sourceRef="W843_Annotation14" targetRef="W843_Start6" associationDirection="None" />
