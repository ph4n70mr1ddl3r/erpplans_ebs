    <bpmn:process id="W_W841" name="W841. Refund &amp; Return Fraud Detection, Investigation &amp; Prevention" isExecutable="false">
      <bpmn:documentation>Trigger: Exception report flags refund anomalies (W837), or cashier reports suspicious return behavior
Frequency: Daily monitoring; investigation initiated as needed
Volume: ~200–300 flagged return anomalies per week chain-wide; ~15–25 confirmed fraud cases per month
Owner: LP Analyst / LP Manager (Regional)
Participants: Store Manager, Cashier, Customer Service Supervisor, Finance Controller
Source: workflow W841 — Refund &amp; Return Fraud Detection, Investigation &amp; Prevention</bpmn:documentation>
      <bpmn:laneSet id="W841_LaneSet3">
        <bpmn:lane id="W841_Lane1" name="LP Analyst">
        <bpmn:flowNodeRef>W841_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W841_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W841_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W841_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W841_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W841_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W841_Lane2" name="LP Manager">
        <bpmn:flowNodeRef>W841_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W841_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W841_Start4" name="Exception report flags refund anomalies (W837), or cashier reports suspicious return…">
        <bpmn:outgoing>W841_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W841_Task5" name="Automated return anomaly detection — flag: returns without receipt exceeding…">
        <bpmn:documentation>Step 1: Automated return anomaly detection — flag: returns without receipt exceeding PHP 5,000, same customer returning ≥ 3 times in 7 days, returns of commonly stolen items (power tools, copper wire, adhesives), refunds to different payment method than original purchase
Responsible (R): LP Analyst
Accountable (A): LP Manager (Regional)
Duration: 30 min (automated)</bpmn:documentation>
        <bpmn:incoming>W841_Flow14</bpmn:incoming>
        <bpmn:outgoing>W841_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W841_Task6" name="Review flagged returns — verify against original transaction (if receipted)…">
        <bpmn:documentation>Step 2: Review flagged returns — verify against original transaction (if receipted), check CCTV for return counter activity, cross-reference customer loyalty ID or government ID captured at return
Responsible (R): LP Analyst
Accountable (A): Store Manager
Duration: 30 min per case</bpmn:documentation>
        <bpmn:incoming>W841_Flow15</bpmn:incoming>
        <bpmn:outgoing>W841_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W841_Task7" name="Classify fraud type — receipt fraud (forged/altered receipt), wardrobing (used…">
        <bpmn:documentation>Step 3: Classify fraud type — receipt fraud (forged/altered receipt), wardrobing (used item return), employee collusion, return-of-stolen-merchandise, or organized return fraud ring
Responsible (R): LP Analyst
Accountable (A): LP Manager (Regional)
Duration: 15 min per case</bpmn:documentation>
        <bpmn:incoming>W841_Flow16</bpmn:incoming>
        <bpmn:outgoing>W841_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W841_Task8" name="For confirmed fraud: block customer from future no-receipt returns, recover…">
        <bpmn:documentation>Step 4: For confirmed fraud: block customer from future no-receipt returns, recover funds if possible, escalate to investigation if value &gt; PHP 20,000 or ring pattern detected
Responsible (R): LP Manager (Regional)
Accountable (A): National LP Director
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W841_Flow17</bpmn:incoming>
        <bpmn:outgoing>W841_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W841_Task9" name="Update return policy rules engine — tighten return window or require manager…">
        <bpmn:documentation>Step 5: Update return policy rules engine — tighten return window or require manager approval for flagged categories/individuals
Responsible (R): LP Analyst
Accountable (A): LP Manager (Regional)
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W841_Flow18</bpmn:incoming>
        <bpmn:outgoing>W841_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W841_Task10" name="Generate weekly return fraud summary — trend analysis, top stores, top…">
        <bpmn:documentation>Step 6: Generate weekly return fraud summary — trend analysis, top stores, top categories, estimated loss, policy recommendation
Responsible (R): LP Analyst
Accountable (A): LP Manager (Regional)
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W841_Flow19</bpmn:incoming>
        <bpmn:outgoing>W841_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W841_End11" name="Complete">
        <bpmn:incoming>W841_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W841_Annotation12">
        <bpmn:text>Controls: - CTL-225 (ensure shrinkage detection &amp; case governance.) | - operational: LP Analyst / LP Manager (Regional) review and approval gate
Owner: LP Analyst / LP Manager (Regional)</bpmn:text>
      </bpmn:textAnnotation>
