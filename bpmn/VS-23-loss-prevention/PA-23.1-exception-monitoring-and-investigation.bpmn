        <bpmndi:BPMNShape id="W1475_Task9_di" bpmnElement="W1475_Task9"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1475_Start4_di" bpmnElement="W1475_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1475_End10_di" bpmnElement="W1475_End10"><dc:Bounds x="1470" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1475_Annotation11_di" bpmnElement="W1475_Annotation11"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1475_Flow13_di" bpmnElement="W1475_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1475_Flow14_di" bpmnElement="W1475_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1475_Flow15_di" bpmnElement="W1475_Flow15"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1475_Flow16_di" bpmnElement="W1475_Flow16"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1475_Flow17_di" bpmnElement="W1475_Flow17"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1475_Flow18_di" bpmnElement="W1475_Flow18"><di:waypoint x="1420" y="335" /><di:waypoint x="1470" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1475_Assoc12_di" bpmnElement="W1475_Assoc12"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1476" name="W1476. Gift Card &amp; Store Credit Fraud Detection, Balance Manipulation Investigation &amp; Controls" isExecutable="false">
      <bpmn:documentation>Trigger: System alert for anomalous gift card/store credit activity; or customer complaint about unexpected balance; or LP investigation reveals gift card involvement in fraud scheme
Frequency: ~5–10 suspected fraud cases/month chain-wide; quarterly control review
Volume: ~PHP 20–30M in gift card/store credit outstanding at any time; ~5,000–10,000 gift card transactions/month
Owner: LP Operations Manager
Participants: LP Analyst, Store Manager, CSR, IT POS Administrator, Finance (store credit accounting), Customer
Source: workflow W1476 — Gift Card &amp; Store Credit Fraud Detection, Balance Manipulation Investigation &amp; Controls</bpmn:documentation>
      <bpmn:laneSet id="W1476_LaneSet5">
        <bpmn:lane id="W1476_Lane1" name="System">
        <bpmn:flowNodeRef>W1476_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1476_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1476_Lane2" name="LP Analyst">
        <bpmn:flowNodeRef>W1476_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1476_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1476_Lane3" name="IT POS Administrator">
        <bpmn:flowNodeRef>W1476_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1476_Lane4" name="LP Operations Manager">
        <bpmn:flowNodeRef>W1476_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1476_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1476_Start6" name="System alert for anomalous gift card/store credit activity; or customer complaint about…">
        <bpmn:outgoing>W1476_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1476_Task7" name="Automated fraud monitoring">
        <bpmn:documentation>Step 1: Automated fraud monitoring: System monitors gift card and store credit transactions for fraud indicators: (a) Velocity alerts: single gift card loaded with &gt; PHP 10,000 in a single transaction; multiple gift cards activated on same terminal within 1 hour; (b) Return-credit pattern: employee-associated loyalty accounts receiving disproportionate store credit from returns (indicator of fictitious return scheme); (c) Balance anomaly: gift card balance increasing without corresponding purchase transaction; store credit balance changed outside normal system processes; (d) Geographic impossibility: same gift card/store credit used at two different stores simultaneously or within an implausible travel time; (e) Payment method risk: gift cards purchased with credit cards subsequently reported as fraudulent (chargeback risk)
Responsible (R): System
Accountable (A): LP Analyst
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1476_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1476_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1476_Task8" name="Case triage &amp; investigation">
        <bpmn:documentation>Step 2: Case triage &amp; investigation: LP Analyst reviews each alert: (a) confirm anomaly is genuine (not system error or legitimate unusual transaction — e.g., a contractor legitimately purchasing PHP 50,000 in gift cards for project giveaways); (b) for confirmed suspicious activity: (i) pull complete transaction history for the gift card/store credit account, (ii) identify the CSR/cashier who processed the transaction, (iii) review CCTV footage per W838 for the transaction timestamp, (iv) cross-reference with other fraud indicators — is the same cashier or store appearing in multiple alerts? (c) categorize fraud type: employee fraud, external fraud (stolen cards), system exploit, social engineering
Responsible (R): LP Analyst
Accountable (A): LP Operations Manager
Duration: 1–2 hours/case</bpmn:documentation>
        <bpmn:incoming>W1476_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1476_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1476_Task9" name="Immediate containment">
        <bpmn:documentation>Step 3: Immediate containment: (a) for active fraud in progress: IT POS Administrator freezes the affected gift card/store credit account to prevent further use; (b) for suspected employee involvement: Store Manager removes cashier from POS duties pending investigation per HR policy; (c) for suspected stolen credit card purchases: LP Analyst notifies payment gateway to flag the card; (d) for system exploit: IT applies emergency patch to close the vulnerability
Responsible (R): IT POS Administrator / Store Manager / LP Analyst
Accountable (A): LP Operations Manager
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W1476_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1476_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1476_Task10" name="Investigation resolution &amp; recovery">
        <bpmn:documentation>Step 4: Investigation resolution &amp; recovery: (a) if fraud confirmed: (i) Employee fraud: HR disciplinary process — repayment of stolen amount or termination per W19.5 separation; report to LP database; (ii) External fraud: file police report for stolen credit card activity; block customer account; if identity discovered, pursue civil recovery; (iii) System exploit: IT fixes vulnerability; quantify financial impact; Finance writes off unrecoverable loss; (b) LP Analyst documents case with evidence, resolution, and financial impact in LP case management system
Responsible (R): LP Analyst / HR / IT / Finance
Accountable (A): LP Operations Manager
Duration: 2–4 hours/case</bpmn:documentation>
        <bpmn:incoming>W1476_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1476_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1476_Task11" name="Quarterly control review &amp; system hardening">
        <bpmn:documentation>Step 5: Quarterly control review &amp; system hardening: (a) LP Operations Manager reviews all gift card/store credit fraud cases from prior quarter: patterns, root causes, financial impact; (b) recommend system controls: (i) gift card activation requires manager authorization for values &gt; PHP 5,000, (ii) store credit issuance requires supervisor approval and customer ID verification, (iii) daily reconciliation of gift card liability account (total cards outstanding × balances) vs. GL per W86, (iv) two-person control for bulk gift card activation (promotional giveaways), (v) store credit refund timeout — 24-hour hold before store credit can be used (cooling period to detect fraudulent returns); (c) IT implements approved controls
Responsible (R): LP Operations Manager / IT
Accountable (A): COO
Duration: 4 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1476_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1476_Flow20</bpmn:outgoing>
