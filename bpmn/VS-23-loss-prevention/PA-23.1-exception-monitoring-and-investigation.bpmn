    <bpmn:process id="W_W845" name="W845. Shrinkage Analysis, Root Cause Investigation &amp; Reduction Program" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly inventory count results, quarterly physical inventory, or mid-year shrinkage result exceeding 1.5% target
Frequency: Monthly analysis; quarterly deep-dive; mid-year and year-end comprehensive review
Volume: 200 stores × 12 monthly counts = 2,400 count events; 4 DCs × 4 quarterly counts = 16 DC counts
Owner: National LP Director
Participants: LP Manager (Regional), LP Analyst, Store Manager, Inventory Manager, Finance Controller, Merchandising Manager
Source: workflow W845 — Shrinkage Analysis, Root Cause Investigation &amp; Reduction Program</bpmn:documentation>
      <bpmn:laneSet id="W845_LaneSet4">
        <bpmn:lane id="W845_Lane1" name="LP Analyst">
        <bpmn:flowNodeRef>W845_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W845_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W845_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W845_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W845_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W845_Lane2" name="LP Manager">
        <bpmn:flowNodeRef>W845_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W845_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W845_Lane3" name="National LP Director">
        <bpmn:flowNodeRef>W845_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W845_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W845_Start5" name="Monthly inventory count results, quarterly physical inventory, or mid-year shrinkage…">
        <bpmn:outgoing>W845_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W845_Task6" name="Compile shrinkage results — aggregate monthly count variance by store…">
        <bpmn:documentation>Step 1: Compile shrinkage results — aggregate monthly count variance by store, department, category; calculate shrinkage % against net sales; compare to 1.5% target and prior period
Responsible (R): LP Analyst
Accountable (A): National LP Director
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W845_Flow16</bpmn:incoming>
        <bpmn:outgoing>W845_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W845_Task7" name="Classify shrinkage by type — known vs. unknown; for known: administrative…">
        <bpmn:documentation>Step 2: Classify shrinkage by type — known vs. unknown; for known: administrative error, vendor fraud, damage, employee theft, shoplifting; allocate unknown proportionally based on investigation findings
Responsible (R): LP Analyst
Accountable (A): National LP Director
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W845_Flow17</bpmn:incoming>
        <bpmn:outgoing>W845_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W845_Task8" name="Root cause analysis for top 20 shrinkage stores — detailed review of LP…">
        <bpmn:documentation>Step 3: Root cause analysis for top 20 shrinkage stores — detailed review of LP incidents, cash variances, receiving variances, damage rates, and employee turnover; identify contributing factors
Responsible (R): LP Manager (Regional)
Accountable (A): National LP Director
Duration: 8 hours per store (quarterly)</bpmn:documentation>
        <bpmn:incoming>W845_Flow18</bpmn:incoming>
        <bpmn:outgoing>W845_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W845_Task9" name="Identify category-level hot spots — SKU-level analysis for categories exceeding…">
        <bpmn:documentation>Step 4: Identify category-level hot spots — SKU-level analysis for categories exceeding 2% shrinkage (power tools, electrical fittings, adhesives, copper products are typical); trigger targeted LP intervention
Responsible (R): LP Analyst
Accountable (A): Merchandising Manager
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W845_Flow19</bpmn:incoming>
        <bpmn:outgoing>W845_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W845_Task10" name="Develop and deploy shrinkage reduction action plans for bottom-quartile stores…">
        <bpmn:documentation>Step 5: Develop and deploy shrinkage reduction action plans for bottom-quartile stores — LP interventions, staffing adjustments, physical security enhancements, EAS coverage expansion
Responsible (R): LP Manager (Regional)
Accountable (A): National LP Director
Duration: 4 hours per store</bpmn:documentation>
        <bpmn:incoming>W845_Flow20</bpmn:incoming>
        <bpmn:outgoing>W845_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W845_Task11" name="Quarterly shrinkage review meeting — present chain-wide results to COO, VP…">
        <bpmn:documentation>Step 6: Quarterly shrinkage review meeting — present chain-wide results to COO, VP Merchandising, CFO; secure budget for reduction initiatives
Responsible (R): National LP Director
Accountable (A): COO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W845_Flow21</bpmn:incoming>
        <bpmn:outgoing>W845_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W845_Task12" name="Track reduction program effectiveness — measure shrinkage delta for stores with…">
        <bpmn:documentation>Step 7: Track reduction program effectiveness — measure shrinkage delta for stores with active interventions; adjust strategies based on results
Responsible (R): LP Analyst
Accountable (A): National LP Director
Duration: 2 hours monthly</bpmn:documentation>
        <bpmn:incoming>W845_Flow22</bpmn:incoming>
        <bpmn:outgoing>W845_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W845_End13" name="Complete">
        <bpmn:incoming>W845_Flow23</bpmn:incoming>
      </bpmn:endEvent>
