    <bpmn:process id="W_W3475" name="W3475. Remodel Concept, Format &amp; Scope Definition" isExecutable="false">
      <bpmn:documentation>Trigger: Store qualified for full remodel (W3474)
Frequency: Per remodel
Volume: ~30–40 remodels/year
Owner: Store Design / Concept Manager
Participants: Store Design/Concept, Merchandising (links to VS-01), Real Estate (links to VS-20), Store Ops (links to VS-07), Marketing (links to VS-14), Store Manager
Source: workflow W3475 — Remodel Concept, Format &amp; Scope Definition</bpmn:documentation>
      <bpmn:laneSet id="W3475_LaneSet2">
        <bpmn:lane id="W3475_Lane1" name="Store Design">
        <bpmn:flowNodeRef>W3475_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3475_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3475_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3475_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3475_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3475_Start3" name="Store qualified for full remodel (W3474)">
        <bpmn:outgoing>W3475_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3475_Task4" name="Store Design/Merchandising define the remodel concept and format: department…">
        <bpmn:documentation>Step 1: Store Design/Merchandising define the remodel concept and format: department adjacencies and space reallocation (links to VS-55/W2160), category expansion/contraction (links to VS-01.1), new zones (e.g., appliance gallery, project-design center links to VS-66, solar/renewable bay links to VS-70), customer-flow and queue/checkout layout (links to VS-08), and fixture/finish standard
Responsible (R): Store Design / Merchandising
Accountable (A): VP Store Operations
Duration: Per remodel</bpmn:documentation>
        <bpmn:incoming>W3475_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3475_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3475_Task5" name="Store Design/Real Estate scope the works: structural (walls/openings), MEP/HVAC…">
        <bpmn:documentation>Step 2: Store Design/Real Estate scope the works: structural (walls/openings), MEP/HVAC (links to VS-20.3), lighting/electrical, finishes, fixtures/FF&amp;E (W3481), signage/graphics (W3485), technology/POS refresh (W3486), and exterior/storefront; distinguish capital vs expense and phasing (W3480)
Responsible (R): Store Design / Real Estate
Accountable (A): VP Store Operations
Duration: Per remodel</bpmn:documentation>
        <bpmn:incoming>W3475_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3475_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3475_Task6" name="Store Design publish the concept brief, scope-of-works, target schedule, and…">
        <bpmn:documentation>Step 3: Store Design publish the concept brief, scope-of-works, target schedule, and Class-3 cost estimate (W3476); obtain Merchandising/Store Ops/Marketing sign-off and the Store Manager&#x27;s operational input; proceed to business case
Responsible (R): Store Design / Merchandising
Accountable (A): COO
Duration: Per remodel</bpmn:documentation>
        <bpmn:incoming>W3475_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3475_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3475_End7" name="Complete">
        <bpmn:incoming>W3475_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3475_Annotation8">
        <bpmn:text>Controls: - CTL-556 (ensure controlled execution — Remodel Strategy, Portfolio Planning &amp; Scope Definition (PA-109.1).) | - operational: clear scope-of-works and change control (W3556); operational: merchandising/market input (links to VS-01/VS-33)
Owner: Store Design / Concept Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3475_Assoc9" sourceRef="W3475_Annotation8" targetRef="W3475_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3475_Flow10" sourceRef="W3475_Start3" targetRef="W3475_Task4" />
      <bpmn:sequenceFlow id="W3475_Flow11" sourceRef="W3475_Task4" targetRef="W3475_Task5" />
      <bpmn:sequenceFlow id="W3475_Flow12" sourceRef="W3475_Task5" targetRef="W3475_Task6" />
      <bpmn:sequenceFlow id="W3475_Flow13" sourceRef="W3475_Task6" targetRef="W3475_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3475_diag">
      <bpmndi:BPMNPlane id="W3475_plane" bpmnElement="W_W3475">
        <bpmndi:BPMNShape id="W3475_Lane1_di" bpmnElement="W3475_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3475_Task4_di" bpmnElement="W3475_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3475_Task5_di" bpmnElement="W3475_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3475_Task6_di" bpmnElement="W3475_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3475_Start3_di" bpmnElement="W3475_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3475_End7_di" bpmnElement="W3475_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3475_Annotation8_di" bpmnElement="W3475_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3475_Flow10_di" bpmnElement="W3475_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3475_Flow11_di" bpmnElement="W3475_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3475_Flow12_di" bpmnElement="W3475_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3475_Flow13_di" bpmnElement="W3475_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3475_Assoc9_di" bpmnElement="W3475_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3476" name="W3476. Remodel Business Case, Capex Funding &amp; Approval" isExecutable="false">
      <bpmn:documentation>Trigger: Concept/scope approved (W3475); capex cycle
Frequency: Per remodel
Volume: ~30–40 remodels/year; PHP 8–25M each
Owner: Real Estate / Project Sponsor
Participants: Real Estate, Finance/FP&amp;A (links to VS-17.4/VS-40), Merchandising (links to VS-01), Store Ops (links to VS-07), Tax (links to VS-79)
Source: workflow W3476 — Remodel Business Case, Capex Funding &amp; Approval</bpmn:documentation>
      <bpmn:laneSet id="W3476_LaneSet4">
        <bpmn:lane id="W3476_Lane1" name="FP&amp;A">
        <bpmn:flowNodeRef>W3476_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3476_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
