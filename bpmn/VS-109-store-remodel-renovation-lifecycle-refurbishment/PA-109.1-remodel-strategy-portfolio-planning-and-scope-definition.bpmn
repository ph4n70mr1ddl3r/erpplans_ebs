        <bpmn:flowNodeRef>W3476_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3476_Lane3" name="Real Estate">
        <bpmn:flowNodeRef>W3476_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3476_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3476_Start5" name="Concept/scope approved (W3475); capex cycle">
        <bpmn:outgoing>W3476_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3476_Task6" name="FP&amp;A/Real Estate build the business case: capex…">
        <bpmn:documentation>Step 1: FP&amp;A/Real Estate build the business case: capex (W3481/W3482/W3484/W3485/W3486), lost-sales during construction (W3480 phasing), expected comp-sales lift, margin/turn improvement (links to VS-101), payback/IRR/NPV, residual-value/asset-life extension (links to VS-35), and store-closure-avoidance value
Responsible (R): FP&amp;A / Real Estate
Accountable (A): CFO
Duration: Per remodel</bpmn:documentation>
        <bpmn:incoming>W3476_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3476_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3476_Task7" name="Finance/Treasury structure the funding within the capex plan (links to…">
        <bpmn:documentation>Step 2: Finance/Treasury structure the funding within the capex plan (links to VS-40/W1814) and cash forecast (links to VS-18.1); route the capex request per authority (links to VS-40/W1813 and VS-36); secure sponsor and executive approval
Responsible (R): Finance / Treasury
Accountable (A): CFO / CEO / Board
Duration: Per remodel</bpmn:documentation>
        <bpmn:incoming>W3476_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3476_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3476_Task8" name="Real Estate/PMO register the approved project in the capital portfolio (links…">
        <bpmn:documentation>Step 3: Real Estate/PMO register the approved project in the capital portfolio (links to VS-40/W1811 and VS-112 PMO), lock the budget and baseline schedule, and authorize procurement (W3481) and construction (W3483) start; track baseline through delivery (W3493)
Responsible (R): Real Estate / PMO
Accountable (A): COO
Duration: Per remodel</bpmn:documentation>
        <bpmn:incoming>W3476_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3476_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3476_End9" name="Complete">
        <bpmn:incoming>W3476_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3476_Annotation10">
        <bpmn:text>Controls: - CTL-136 (ensure remodel capex &amp; handover control.) | - operational: benchmark-based assumptions and post-remodel tracking (W3491); operational: contingency and change control (W3556/W3493)
Owner: Real Estate / Project Sponsor</bpmn:text>
      </bpmn:textAnnotation>
