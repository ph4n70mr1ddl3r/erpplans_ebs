    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3474" name="W3474. Store Performance Assessment &amp; Remodel Trigger / Qualification" isExecutable="false">
      <bpmn:documentation>Trigger: Annual scoring; store-underperformance alert; age/condition threshold
Frequency: Annual + event-driven
Volume: ~200 stores scored; ~30–40 qualified/year
Owner: VP Store Operations
Participants: VP Store Operations, Regional Managers (links to VS-07), Real Estate (links to VS-20), Facilities (links to VS-20.3), Merchandising (links to VS-01), FP&amp;A (links to VS-17.4)
Source: workflow W3474 — Store Performance Assessment &amp; Remodel Trigger / Qualification</bpmn:documentation>
      <bpmn:laneSet id="W3474_LaneSet4">
        <bpmn:lane id="W3474_Lane1" name="Regional Mgrs">
        <bpmn:flowNodeRef>W3474_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3474_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3474_Lane2" name="Real Estate">
        <bpmn:flowNodeRef>W3474_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3474_Lane3" name="VP Store Operations">
        <bpmn:flowNodeRef>W3474_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3474_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3474_Start5" name="Annual scoring; store-underperformance alert; age/condition threshold">
        <bpmn:outgoing>W3474_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3474_Task6" name="Regional Managers/FP&amp;A score each store on the lifecycle matrix: sales trend &amp;…">
        <bpmn:documentation>Step 1: Regional Managers/FP&amp;A score each store on the lifecycle matrix: sales trend &amp; comp vs market (links to VS-33.3), gross-margin &amp; inventory turn (links to VS-101), customer-satisfaction/NPS (links to VS-13), store age &amp; fixture/asset condition (links to VS-35/VS-20.3), maintenance-spend trend, and trade-area growth/competitor pressure
Responsible (R): Regional Mgrs / FP&amp;A
Accountable (A): VP Store Operations
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3474_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3474_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3474_Task7" name="Real Estate/Facilities validate physical condition: roof/structural, MEP/HVAC…">
        <bpmn:documentation>Step 2: Real Estate/Facilities validate physical condition: roof/structural, MEP/HVAC, floor/walls, fixtures, signage, technology/POS currency (links to VS-99), compliance gaps (links to VS-22/VS-76), and accessibility; flag safety/structural priorities
Responsible (R): Real Estate / Facilities
Accountable (A): VP Store Operations
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3474_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3474_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3474_Task8" name="VP Store Operations qualify stores into tiers (full remodel / refresh /…">
        <bpmn:documentation>Step 3: VP Store Operations qualify stores into tiers (full remodel / refresh / re-fixture / defer) and feed the roadmap (W3473); for full remodels, commission a concept/scope brief (W3475) and business case (W3476); document the qualification decision for governance (W3496)
Responsible (R): VP Store Operations / Real Estate
Accountable (A): COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3474_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3474_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3474_End9" name="Complete">
        <bpmn:incoming>W3474_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3474_Annotation10">
        <bpmn:text>Controls: - CTL-556 (ensure controlled execution — Remodel Strategy, Portfolio Planning &amp; Scope Definition (PA-109.1).) | - operational: multi-year trend and condition validation; operational: facility survey (links to VS-20)
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3474_Assoc11" sourceRef="W3474_Annotation10" targetRef="W3474_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3474_Flow12" sourceRef="W3474_Start5" targetRef="W3474_Task6" />
      <bpmn:sequenceFlow id="W3474_Flow13" sourceRef="W3474_Task6" targetRef="W3474_Task7" />
      <bpmn:sequenceFlow id="W3474_Flow14" sourceRef="W3474_Task7" targetRef="W3474_Task8" />
      <bpmn:sequenceFlow id="W3474_Flow15" sourceRef="W3474_Task8" targetRef="W3474_End9" />
    </bpmn:process>
