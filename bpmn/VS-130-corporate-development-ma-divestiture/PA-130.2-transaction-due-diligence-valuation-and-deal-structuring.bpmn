      <bpmn:startEvent id="W3992_Start3" name="Signing; notifiable transaction (links to W3967)">
        <bpmn:outgoing>W3992_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3992_Task4" name="Legal/Competition-counsel confirm notifiability and file the PCC merger…">
        <bpmn:documentation>Step 1: Legal/Competition-counsel confirm notifiability and file the PCC merger notification (links to VS-129 W3967) and any foreign notifications where BuildRight&#x27;s footprint/customers trigger review; manage conditions/remedies if Phase 2
Responsible (R): Legal / External Counsel / Corp Dev
Accountable (A): VP Legal / CEO
Duration: Per transaction</bpmn:documentation>
        <bpmn:incoming>W3992_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3992_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3992_Task5" name="Legal/Corp-Sec manage SEC and corporate-regulatory filings (links to VS-36.1)…">
        <bpmn:documentation>Step 2: Legal/Corp-Sec manage SEC and corporate-regulatory filings (links to VS-36.1), LGU/license transfers (links to VS-22/VS-76), BIR/tax-clearance (links to VS-79), and any sector-specific approvals (customs links to VS-87, data-privacy consent links to VS-91, labor links to VS-84)
Responsible (R): Legal / Corp Sec / Compliance
Accountable (A): VP Legal
Duration: Per transaction</bpmn:documentation>
        <bpmn:incoming>W3992_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3992_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3992_Task6" name="Legal track conditions-satisfaction to closing (links to W3994), manage…">
        <bpmn:documentation>Step 3: Legal track conditions-satisfaction to closing (links to W3994), manage gun-jumping risk, and document all clearances in the deal file (links to VS-88)
Responsible (R): Legal / Corp Dev
Accountable (A): VP Legal
Duration: Per transaction</bpmn:documentation>
        <bpmn:incoming>W3992_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3992_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3992_End7" name="Complete">
        <bpmn:incoming>W3992_Flow13</bpmn:incoming>
      </bpmn:endEvent>
