    <bpmn:process id="W_W3985" name="W3985. Commercial &amp; Strategic Due Diligence" isExecutable="false">
      <bpmn:documentation>Trigger: LOI/exclusivity (links to W3982)
Frequency: Per target
Volume: Per target
Owner: Head of Corporate Development / Strategy
Participants: Corp Dev, Strategy (links to VS-33.3), Insights (links to VS-44), Merchandising (links to VS-01), Trade/B2B Sales (links to VS-11), Marketing (links to VS-14), affected business unit, external commercial advisors
Source: workflow W3985 — Commercial &amp; Strategic Due Diligence</bpmn:documentation>
      <bpmn:laneSet id="W3985_LaneSet2">
        <bpmn:lane id="W3985_Lane1" name="Corp Dev">
        <bpmn:flowNodeRef>W3985_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3985_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3985_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3985_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3985_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3985_Start3" name="LOI/exclusivity (links to W3982)">
        <bpmn:outgoing>W3985_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3985_Task4" name="Corp Dev/Strategy conduct commercial DD: market size/growth, competitive…">
        <bpmn:documentation>Step 1: Corp Dev/Strategy conduct commercial DD: market size/growth, competitive position, customer base and concentration (trade/B2B/B2G mix), store portfolio performance, assortment/channel/digital maturity, brand equity, and revenue quality (links to VS-44/VS-57 for market intelligence)
Responsible (R): Corp Dev / Strategy / Insights
Accountable (A): Head of Corp Dev
Duration: Per target</bpmn:documentation>
        <bpmn:incoming>W3985_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3985_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3985_Task5" name="Corp Dev/Merchandising assess strategic fit and synergy potential…">
        <bpmn:documentation>Step 2: Corp Dev/Merchandising assess strategic fit and synergy potential: category/assortment overlap and gaps, store/network overlap and cannibalization, channel complementarity, vendor overlap, and revenue/cost synergy hypotheses to refine the model (links to W3981)
Responsible (R): Corp Dev / Merchandising / Trade Sales
Accountable (A): Head of Corp Dev
Duration: Per target</bpmn:documentation>
        <bpmn:incoming>W3985_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3985_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3985_Task6" name="Corp Dev compile findings into the commercial DD report, flag…">
        <bpmn:documentation>Step 3: Corp Dev compile findings into the commercial DD report, flag value-killers/risk, and update the deal model and SPA price/terms (links to W3991)
Responsible (R): Corp Dev / Strategy
Accountable (A): Head of Corp Dev
Duration: Per target</bpmn:documentation>
        <bpmn:incoming>W3985_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3985_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3985_End7" name="Complete">
        <bpmn:incoming>W3985_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3985_Annotation8">
        <bpmn:text>Controls: - CTL-621 (ensure controlled execution — Transaction Due Diligence, Valuation &amp; Deal Structuring (PA-130.2).) | - operational: bottom-up hypotheses; operational: store-level overlap analysis
Owner: Head of Corporate Development / Strategy</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3985_Assoc9" sourceRef="W3985_Annotation8" targetRef="W3985_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3985_Flow10" sourceRef="W3985_Start3" targetRef="W3985_Task4" />
      <bpmn:sequenceFlow id="W3985_Flow11" sourceRef="W3985_Task4" targetRef="W3985_Task5" />
      <bpmn:sequenceFlow id="W3985_Flow12" sourceRef="W3985_Task5" targetRef="W3985_Task6" />
      <bpmn:sequenceFlow id="W3985_Flow13" sourceRef="W3985_Task6" targetRef="W3985_End7" />
    </bpmn:process>
