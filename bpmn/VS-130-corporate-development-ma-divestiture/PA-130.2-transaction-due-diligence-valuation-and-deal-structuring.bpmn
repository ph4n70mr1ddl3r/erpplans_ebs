      <bpmn:sequenceFlow id="W3986_Flow13" sourceRef="W3986_Task6" targetRef="W3986_Task7" />
      <bpmn:sequenceFlow id="W3986_Flow14" sourceRef="W3986_Task7" targetRef="W3986_End8" />
    </bpmn:process>
