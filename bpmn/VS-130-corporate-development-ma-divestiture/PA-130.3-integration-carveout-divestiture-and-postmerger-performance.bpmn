      <bpmn:sequenceFlow id="W3993_Flow12" sourceRef="W3993_Task5" targetRef="W3993_Task6" />
      <bpmn:sequenceFlow id="W3993_Flow13" sourceRef="W3993_Task6" targetRef="W3993_End7" />
    </bpmn:process>
