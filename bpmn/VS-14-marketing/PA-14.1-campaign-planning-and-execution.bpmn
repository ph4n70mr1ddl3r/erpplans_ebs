    <bpmn:process id="W_W1522" name="W1522. Monthly Flyer &amp; Promotional Catalog Production, Print Run &amp; In-Store Distribution" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly promotional calendar cycle; mid-month flyer refresh for extended promotions
Frequency: 1 primary monthly flyer + 1–2 supplemental flyers (weekend sale, clearance event)
Volume: ~250,000–400,000 copies per print run for primary flyer; distributed across 200 stores + 50,000 direct-to-barangay
Owner: Marketing Communications Manager
Participants: Marketing Communications Manager, Graphic Designer, Category Managers, Merchandise Planner, Print Vendor, Store Managers
Source: workflow W1522 — Monthly Flyer &amp; Promotional Catalog Production, Print Run &amp; In-Store Distribution</bpmn:documentation>
      <bpmn:laneSet id="W1522_LaneSet6">
        <bpmn:lane id="W1522_Lane1" name="Category Managers">
        <bpmn:flowNodeRef>W1522_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1522_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1522_Lane2" name="Graphic Designer">
        <bpmn:flowNodeRef>W1522_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1522_Lane3" name="Marketing Comms Manager">
        <bpmn:flowNodeRef>W1522_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1522_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1522_Lane4" name="Print Vendor">
        <bpmn:flowNodeRef>W1522_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1522_Lane5" name="Store Managers">
        <bpmn:flowNodeRef>W1522_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1522_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1522_Start7" name="Monthly promotional calendar cycle; mid-month flyer refresh for extended promotions">
        <bpmn:outgoing>W1522_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1522_Task8" name="Promotional item selection">
        <bpmn:documentation>Step 1: Promotional item selection (Week 1): (a) Category Managers submit promotional item nominations for next month&#x27;s flyer: item SKU, regular price, promotional price, margin impact, stock availability, hero deal recommendation; (b) Merchandise Planner validates: (i) stock depth sufficient for chain-wide promotion (min 4-week supply at promotional velocity), (ii) vendor funding/rebate confirmed for any below-cost hero deals; (c) Marketing Communications Manager selects final 80–150 items with VP Merchandising approval; prioritizes: hero deals (3–5 front-page items), category themes, seasonal relevance, margin-positive items
Responsible (R): Category Managers / Marketing Comms Manager
Accountable (A): VP Merchandising
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W1522_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1522_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1522_Task9" name="Creative design and layout">
        <bpmn:documentation>Step 2: Creative design and layout (Week 2): (a) Graphic Designer creates flyer layout: (i) front page: hero deals with large product photos, promotional prices with &quot;Was/Now&quot; format, savings callouts; (ii) category spreads: grouped by project theme (e.g., &quot;Build Your Dream Bathroom&quot;); (iii) back page: store locator map, loyalty program promotion, next month teaser; (b) Category Managers review product photos, descriptions, specifications, and pricing accuracy; (c) Legal/Compliance review: (i) prices include VAT (Philippine law: advertised price must be VAT-inclusive), (ii) &quot;While stocks last&quot; disclaimer on limited-stock items, (iii) promo period clearly stated, (iv) no misleading &quot;was&quot; prices (DTI regulation: must have sold at &quot;was&quot; price within last 6 months)
Responsible (R): Graphic Designer / Marketing Comms Manager
Accountable (A): VP Marketing
Duration: 5–7 days</bpmn:documentation>
        <bpmn:incoming>W1522_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1522_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1522_Task10" name="Print production">
        <bpmn:documentation>Step 3: Print production (Week 3): (a) Marketing Communications Manager sends approved artwork to print vendor; (b) print vendor produces: (i) main run: 250,000–400,000 copies (tabloid format, newsprint or glossy depending on budget), (ii) regional variations if pricing differs (e.g., provincial stores may have different promotional prices due to logistics cost differences); (c) quality check: Marketing Communications Manager reviews printer&#x27;s proof copy for color accuracy, text clarity, price readability before authorizing full run
Responsible (R): Marketing Comms Manager / Print Vendor
Accountable (A): —
Duration: 5–7 days print + delivery</bpmn:documentation>
        <bpmn:incoming>W1522_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1522_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1522_Task11" name="Distribution logistics">
        <bpmn:documentation>Step 4: Distribution logistics (Week 3–4): (a) print vendor ships bundled flyers to 200 stores + HQ marketing warehouse: (i) store allocation based on store size tier (A/B/C stores receive proportional quantities), (ii) HQ warehouse retains buffer stock for replenishment; (b) Store Managers receive delivery, verify count, and place in store flyer racks; (c) barangay distribution: local flyer distributors (contracted per store) receive allocated quantities and perform door-to-door drop within 3-km radius of each store
Responsible (R): Print Vendor / Store Managers / Local Distributors
Accountable (A): Marketing Comms Manager
Duration: 3–5 days distribution</bpmn:documentation>
        <bpmn:incoming>W1522_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1522_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1522_Task12" name="In-store display execution">
        <bpmn:documentation>Step 5: In-store display execution (same week as distribution): (a) Store Managers ensure: (i) flyer racks at entrance and checkout are fully stocked, (ii) promotional items featured in flyer are prominently displayed with matching shelf tags and point-of-sale materials, (iii) front-page hero deals displayed at store entrance end-caps; (b) Marketing Communications Manager receives photo confirmation from each store (via store manager mobile app) verifying display compliance
Responsible (R): Store Managers
Accountable (A): Marketing Comms Manager
Duration: 2–4 hours/store</bpmn:documentation>
        <bpmn:incoming>W1522_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1522_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1522_Task13" name="Performance tracking">
        <bpmn:documentation>Step 6: Performance tracking (during promo period): (a) system tracks promotional item sales velocity vs. baseline: (i) lift factor (promo sales / normal sales), (ii) basket attachment (did flyer customers buy non-promo items too?), (iii) store traffic during promo period vs. non-promo period; (b) Marketing Communications Manager compiles monthly flyer ROI report: print cost + distribution cost vs. incremental gross margin from promotional sales; (c) learnings feed into next month&#x27;s item selection (Step 1)
Responsible (R): Marketing Comms Manager / Merchandise Planner
Accountable (A): VP Marketing
Duration: 4–6 hours/month</bpmn:documentation>
        <bpmn:incoming>W1522_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1522_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1522_End14" name="Complete">
        <bpmn:incoming>W1522_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1522_Annotation15">
        <bpmn:text>Controls: - CTL-281 (ensure controlled execution — Campaign Planning &amp; Execution (PA-14.1).) | - operational: Marketing Communications Manager review and approval gate
Owner: Marketing Communications Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1522_Assoc16" sourceRef="W1522_Annotation15" targetRef="W1522_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W1522_Flow17" sourceRef="W1522_Start7" targetRef="W1522_Task8" />
      <bpmn:sequenceFlow id="W1522_Flow18" sourceRef="W1522_Task8" targetRef="W1522_Task9" />
      <bpmn:sequenceFlow id="W1522_Flow19" sourceRef="W1522_Task9" targetRef="W1522_Task10" />
      <bpmn:sequenceFlow id="W1522_Flow20" sourceRef="W1522_Task10" targetRef="W1522_Task11" />
      <bpmn:sequenceFlow id="W1522_Flow21" sourceRef="W1522_Task11" targetRef="W1522_Task12" />
      <bpmn:sequenceFlow id="W1522_Flow22" sourceRef="W1522_Task12" targetRef="W1522_Task13" />
      <bpmn:sequenceFlow id="W1522_Flow23" sourceRef="W1522_Task13" targetRef="W1522_End14" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1522_diag">
      <bpmndi:BPMNPlane id="W1522_plane" bpmnElement="W_W1522">
        <bpmndi:BPMNShape id="W1522_Lane1_di" bpmnElement="W1522_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1522_Lane2_di" bpmnElement="W1522_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1522_Lane3_di" bpmnElement="W1522_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1580" height="170" /></bpmndi:BPMNShape>
