    <bpmn:process id="W_W190" name="W190. In-house Design &amp; Creative Production Management" isExecutable="false">
      <bpmn:documentation>Trigger: Creative request for campaign (W83), store opening (W16), or signage update
Frequency: Daily
Volume: ~50–100 creative tickets/month
Owner: Content Manager
Participants: Graphic Designers, Video Editors, Dept Requestors
Source: workflow W190 — In-house Design &amp; Creative Production Management</bpmn:documentation>
      <bpmn:laneSet id="W190_LaneSet4">
        <bpmn:lane id="W190_Lane1" name="Requestor">
        <bpmn:flowNodeRef>W190_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W190_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W190_Lane2" name="Content Mgr">
        <bpmn:flowNodeRef>W190_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W190_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W190_Lane3" name="Creative Team">
        <bpmn:flowNodeRef>W190_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W190_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W190_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W190_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W190_Start5" name="Creative request for campaign (W83), store opening (W16), or signage update">
        <bpmn:outgoing>W190_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W190_Task6" name="Request Intake">
        <bpmn:documentation>Step 1: Request Intake: Dept Head submits &quot;Creative Brief&quot; (W83.1) via internal ticketing system
Responsible (R): Requestor
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W190_Flow15</bpmn:incoming>
        <bpmn:outgoing>W190_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W190_Task7" name="Prioritization">
        <bpmn:documentation>Step 2: Prioritization: Content Manager assigns priority based on campaign importance and deadline
Responsible (R): Content Mgr
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W190_Flow16</bpmn:incoming>
        <bpmn:outgoing>W190_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W190_Task8" name="Production">
        <bpmn:documentation>Step 3: Production: Designers/Editors produce assets (layouts, videos, posters)
Responsible (R): Creative Team
Accountable (A): —
Duration: 1–5 days</bpmn:documentation>
        <bpmn:incoming>W190_Flow17</bpmn:incoming>
        <bpmn:outgoing>W190_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W190_Task9" name="Review &amp; Approval">
        <bpmn:documentation>Step 4: Review &amp; Approval: Requestor and Content Manager review drafts; request revisions
Responsible (R): Content Mgr
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W190_Flow18</bpmn:incoming>
        <bpmn:outgoing>W190_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W190_Task10" name="Finalization">
        <bpmn:documentation>Step 5: Finalization: Export in required formats (Print-ready, Social-size, Web-optimized)
Responsible (R): Creative Team
Accountable (A): —
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W190_Flow19</bpmn:incoming>
        <bpmn:outgoing>W190_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W190_Task11" name="Asset Management">
        <bpmn:documentation>Step 6: Asset Management: Upload final assets to Digital Asset Management (DAM) system (W50)
Responsible (R): Creative Team
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W190_Flow20</bpmn:incoming>
        <bpmn:outgoing>W190_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W190_End12" name="Complete">
        <bpmn:incoming>W190_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W190_Annotation13">
        <bpmn:text>Controls: - CTL-281 (ensure controlled execution — Campaign Planning &amp; Execution (PA-14.1).) | - operational: Content Manager review and approval gate
Owner: Content Manager</bpmn:text>
      </bpmn:textAnnotation>
