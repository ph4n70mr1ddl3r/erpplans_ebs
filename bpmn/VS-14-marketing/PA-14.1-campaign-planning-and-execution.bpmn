<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-14.1-campaign-planning-and-execution" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W83" name="W83. Marketing Campaign Planning, Execution &amp; Performance Measurement" isExecutable="false">
      <bpmn:documentation>Trigger: Campaign calendar milestone; or ad-hoc campaign request from C-suite / Category Manager
Frequency: 6 major bi-monthly campaigns/year + 12 monthly hot-deal cycles + ad-hoc campaigns (store openings, seasonal pushes, competitive response)
Volume: ~18–24 planned campaigns/year + ~5–10 ad-hoc campaigns; each campaign involves 2–8 channels and 200–500+ SKUs
Owner: Marketing Campaign Manager
Participants: Campaign Manager, Content Manager, CMO, VP Merchandising, Category Managers, Pricing Analysts, VP Store Operations, Ecom Team, external creative / media agencies
Source: workflow W83 — Marketing Campaign Planning, Execution &amp; Performance Measurement</bpmn:documentation>
      <bpmn:laneSet id="W83_LaneSet7">
        <bpmn:lane id="W83_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W83_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W83_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W83_Lane2" name="Campaign Manager">
        <bpmn:flowNodeRef>W83_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W83_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W83_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W83_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W83_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W83_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W83_Task19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W83_Task20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W83_Task21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W83_Task22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W83_Task23</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W83_Task24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W83_Task25</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W83_Task26</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W83_Task27</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W83_Task28</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W83_Task29</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W83_Task33</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W83_Task35</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W83_Lane3" name="CMO">
        <bpmn:flowNodeRef>W83_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W83_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W83_Task31</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W83_Task32</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W83_Lane4" name="Content Manager">
        <bpmn:flowNodeRef>W83_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W83_Lane5" name="System">
        <bpmn:flowNodeRef>W83_Task30</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W83_Lane6" name="AP Clerk">
        <bpmn:flowNodeRef>W83_Task34</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W83_End36</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W83_Start8" name="Campaign calendar milestone; or ad-hoc campaign request from C-suite / Category Manager">
        <bpmn:outgoing>W83_Flow39</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W83_Task9" name="Category Manager or VP Merchandising submits campaign brief request to Campaign…">
        <bpmn:documentation>Step 1: Category Manager or VP Merchandising submits campaign brief request to Campaign Manager: campaign objective (traffic, revenue, margin, clearance, brand awareness), target customer segment, proposed SKU list, desired timing, and rough budget expectation
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1 hour/brief</bpmn:documentation>
        <bpmn:incoming>W83_Flow39</bpmn:incoming>
        <bpmn:outgoing>W83_Flow40</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W83_Task10" name="Campaign Manager reviews brief with CMO; assesses feasibility against campaign…">
        <bpmn:documentation>Step 2: Campaign Manager reviews brief with CMO; assesses feasibility against campaign calendar (avoid overlapping campaigns), budget availability, and resource capacity (creative team workload, external agency availability)
Responsible (R): Campaign Manager
Accountable (A): CMO
Duration: 30 min/brief</bpmn:documentation>
        <bpmn:incoming>W83_Flow40</bpmn:incoming>
        <bpmn:outgoing>W83_Flow41</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W83_Task11" name="Campaign Manager develops campaign brief document: (a) campaign name and code…">
        <bpmn:documentation>Step 3: Campaign Manager develops campaign brief document: (a) campaign name and code (for system tracking and cost allocation), (b) objectives with measurable KPIs (target revenue lift, foot traffic increase, ecommerce conversion rate, new loyalty sign-ups), (c) target audience (all customers, loyalty tiers, trade accounts, geographic segments), (d) channel plan — which channels (in-store, email, SMS, social media, digital ads, print, radio, PR), (e) promotional mechanics (percentage off, bundle deals, gift-with-purchase, loyalty points multiplier, clearance pricing), (f) SKU list and pricing per W13, (g) timeline — key dates for creative review, material production, distribution, and go-live, (h) budget allocation by channel with estimated cost per channel, (i) success metrics and measurement plan
Responsible (R): Campaign Manager
Accountable (A): CMO
Duration: 4–8 hours/campaign</bpmn:documentation>
        <bpmn:incoming>W83_Flow41</bpmn:incoming>
        <bpmn:outgoing>W83_Flow42</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W83_Task12" name="CMO reviews and approves campaign brief; VP Merchandising confirms SKU list and…">
        <bpmn:documentation>Step 4: CMO reviews and approves campaign brief; VP Merchandising confirms SKU list and pricing strategy; CFO approves budget for campaigns exceeding PHP 1M
Responsible (R): CMO / VP Merchandising / CFO
Accountable (A): CEO (if budget &gt; PHP 5M)
Duration: 1 hour/campaign</bpmn:documentation>
        <bpmn:incoming>W83_Flow42</bpmn:incoming>
        <bpmn:outgoing>W83_Flow43</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W83_Task13" name="Campaign Manager creates campaign record in system: campaign code, objectives…">
        <bpmn:documentation>Step 5: Campaign Manager creates campaign record in system: campaign code, objectives, KPIs, budget, timeline, assigned team members, linked promo pricing records (W13), and linked SKU list; system generates campaign cost center for expense tracking
Responsible (R): Campaign Manager
Accountable (A): CMO
Duration: 30 min/campaign</bpmn:documentation>
        <bpmn:incoming>W83_Flow43</bpmn:incoming>
        <bpmn:outgoing>W83_Flow44</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W83_Task14" name="Campaign Manager assigns creative deliverables: (a) in-store POS materials…">
        <bpmn:documentation>Step 6: Campaign Manager assigns creative deliverables: (a) in-store POS materials (posters, shelf talkers, banners, endcap displays, outdoor signage), (b) digital assets (website banners, social media posts/stories, email templates, digital ad creatives), (c) print materials (flyers, newspaper inserts, direct mailers), (d) SMS/email copy, (e) press releases or PR materials (if applicable)
Responsible (R): Campaign Manager
Accountable (A): CMO
Duration: 1 hour/campaign</bpmn:documentation>
        <bpmn:incoming>W83_Flow44</bpmn:incoming>
        <bpmn:outgoing>W83_Flow45</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W83_Task15" name="Content Manager and Content Specialists produce or coordinate creative assets…">
        <bpmn:documentation>Step 7: Content Manager and Content Specialists produce or coordinate creative assets: (a) in-house for standard materials (email templates, social media posts, SMS copy, shelf talkers using templates), (b) external creative agency for major campaigns (TV/radio spots, high-end print, complex digital campaigns) per W62 service contract; agency briefed with brand guidelines, campaign messaging framework, and deliverable specifications
Responsible (R): Content Manager / External Agency
Accountable (A): CMO
Duration: 1–3 weeks/campaign</bpmn:documentation>
        <bpmn:incoming>W83_Flow45</bpmn:incoming>
        <bpmn:outgoing>W83_Flow46</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W83_Task16" name="Campaign Manager reviews all creative assets against brand guidelines…">
        <bpmn:documentation>Step 8: Campaign Manager reviews all creative assets against brand guidelines: consistent visual identity, correct pricing (match W13/W40 system prices), correct SKU descriptions, legal disclaimers (BIR-compliant pricing disclosures, promo terms and conditions), and inclusive language
Responsible (R): Campaign Manager
Accountable (A): CMO
Duration: 2–4 hours/campaign</bpmn:documentation>
        <bpmn:incoming>W83_Flow46</bpmn:incoming>
        <bpmn:outgoing>W83_Flow47</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W83_Task17" name="CMO approves final creative assets; Campaign Manager archives approved assets…">
        <bpmn:documentation>Step 9: CMO approves final creative assets; Campaign Manager archives approved assets in system linked to campaign record
Responsible (R): CMO
Accountable (A): CEO (for major brand campaigns)
Duration: 30 min/campaign</bpmn:documentation>
        <bpmn:incoming>W83_Flow47</bpmn:incoming>
        <bpmn:outgoing>W83_Flow48</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W83_Task18" name="In-store materials">
        <bpmn:documentation>Step 10: In-store materials: Campaign Manager coordinates printing and distribution of POS materials to 200 stores — centralized printing at HQ, shipped to stores via DC delivery trucks (W4) or direct courier for urgent materials; includes installation instructions and display planogram for promotional displays; VP Store Operations confirms receipt with Store Managers
Responsible (R): Campaign Manager / VP Store Operations
Accountable (A): COO
Duration: 1 week distribution</bpmn:documentation>
        <bpmn:incoming>W83_Flow48</bpmn:incoming>
        <bpmn:outgoing>W83_Flow49</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W83_Task19" name="Digital channels">
        <bpmn:documentation>Step 11: Digital channels: (a) Ecom Team uploads website banners and landing pages to ecommerce platform; configures campaign-specific landing page with promo SKUs and pricing per W13, (b) Campaign Manager schedules social media posts via social media management tool (Meta Business Suite, etc.) with approved creatives and copy, (c) Campaign Manager configures email campaign in email marketing platform: segment audience per campaign brief, schedule send dates, set up A/B test variants if applicable, (d) Campaign Manager configures SMS blast via SMS gateway provider for loyalty member segments
Responsible (R): Campaign Manager / Ecom Team
Accountable (A): CMO
Duration: 2–4 hours/channel</bpmn:documentation>
        <bpmn:incoming>W83_Flow49</bpmn:incoming>
        <bpmn:outgoing>W83_Flow50</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W83_Task20" name="Traditional media">
        <bpmn:documentation>Step 12: Traditional media: Campaign Manager coordinates with media buying agency (or direct media placement) for radio spots, print ads, and digital ads; confirms placement schedule, flight dates, and audience targeting parameters; media costs tracked to campaign cost center
Responsible (R): Campaign Manager / Media Agency
Accountable (A): CMO
Duration: Per W62 contract</bpmn:documentation>
        <bpmn:incoming>W83_Flow50</bpmn:incoming>
        <bpmn:outgoing>W83_Flow51</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W83_Task21" name="Loyalty integration">
        <bpmn:documentation>Step 13: Loyalty integration: Campaign Manager coordinates with Loyalty Manager to configure campaign-specific loyalty mechanics per W17 — e.g., double-points weekends, bonus points for specific categories, tier-exclusive early access, member-only pricing; Loyalty Manager configures in loyalty engine and tests before go-live
Responsible (R): Campaign Manager / Loyalty Manager
Accountable (A): CMO
Duration: 2 hours/campaign</bpmn:documentation>
        <bpmn:incoming>W83_Flow51</bpmn:incoming>
        <bpmn:outgoing>W83_Flow52</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W83_Task22" name="System readiness check">
        <bpmn:documentation>Step 14: System readiness check (T-3 days): Campaign Manager verifies with IT that (a) promotional pricing is loaded in POS per W13.5, (b) ecommerce campaign pages are live and pricing matches, (c) email and SMS campaigns are scheduled and tested, (d) campaign tracking tags/pixels are correctly implemented for digital performance measurement
Responsible (R): Campaign Manager / IT
Accountable (A): CIO
Duration: 2 hours/campaign</bpmn:documentation>
        <bpmn:incoming>W83_Flow52</bpmn:incoming>
        <bpmn:outgoing>W83_Flow53</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W83_Task23" name="Campaign launches on scheduled go-live date; Campaign Manager monitors…">
        <bpmn:documentation>Step 15: Campaign launches on scheduled go-live date; Campaign Manager monitors first-day execution across channels: confirm POS materials displayed in stores (Store Manager photo confirmation), verify digital assets live, confirm email/SMS sent
Responsible (R): Campaign Manager
Accountable (A): CMO
Duration: 4 hours/launch day</bpmn:documentation>
        <bpmn:incoming>W83_Flow53</bpmn:incoming>
        <bpmn:outgoing>W83_Flow54</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W83_Task24" name="Campaign Manager monitors daily campaign performance dashboard during campaign…">
        <bpmn:documentation>Step 16: Campaign Manager monitors daily campaign performance dashboard during campaign period: (a) in-store: promo SKU sell-through per store, traffic counts (if available), average basket size, (b) ecommerce: campaign landing page visits, conversion rate, promo code usage, (c) digital: email open rate, click-through rate, social media engagement (likes, shares, comments), digital ad impressions and click-through rate, (d) loyalty: campaign-specific points earning and redemption activity
Responsible (R): Campaign Manager
Accountable (A): CMO
Duration: 30 min/day during campaign</bpmn:documentation>
        <bpmn:incoming>W83_Flow54</bpmn:incoming>
        <bpmn:outgoing>W83_Flow55</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W83_Task25" name="Weekly during campaign: Campaign Manager presents performance snapshot to CMO…">
        <bpmn:documentation>Step 17: Weekly during campaign: Campaign Manager presents performance snapshot to CMO and VP Merchandising — actual vs. target KPIs, top-performing SKUs, top-performing stores, underperforming channels, budget burn rate
Responsible (R): Campaign Manager
Accountable (A): CMO
Duration: 30 min/week</bpmn:documentation>
        <bpmn:incoming>W83_Flow55</bpmn:incoming>
        <bpmn:outgoing>W83_Flow56</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W83_Task26" name="Mid-campaign optimization: if performance significantly below target on a…">
        <bpmn:documentation>Step 18: Mid-campaign optimization: if performance significantly below target on a channel, Campaign Manager proposes adjustments with CMO approval — (a) increase digital ad spend on performing channels, (b) adjust email re-send to unopened segment, (c) extend or modify in-store displays, (d) adjust social media content strategy
Responsible (R): Campaign Manager
Accountable (A): CMO
Duration: 1 hour/ad-hoc</bpmn:documentation>
        <bpmn:incoming>W83_Flow56</bpmn:incoming>
        <bpmn:outgoing>W83_Flow57</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W83_Task27" name="Campaign Manager pulls comprehensive post-campaign data: (a) total revenue…">
        <bpmn:documentation>Step 19: Campaign Manager pulls comprehensive post-campaign data: (a) total revenue attributed to campaign SKUs vs. baseline, (b) campaign cost by channel (creative production, media placement, printing, distribution, agency fees), (c) ROI per channel (revenue attributed ÷ channel cost), (d) incremental traffic (vs. pre-campaign baseline), (e) new loyalty sign-ups attributed to campaign, (f) ecommerce metrics (landing page conversion, promo code redemption, new customer acquisition cost), (g) social media metrics (reach, engagement, follower growth), (h) store-level performance variation (top 10 and bottom 10 stores)
Responsible (R): Campaign Manager
Accountable (A): CMO
Duration: 4–8 hours/campaign</bpmn:documentation>
        <bpmn:incoming>W83_Flow57</bpmn:incoming>
        <bpmn:outgoing>W83_Flow58</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W83_Task28" name="Campaign Manager prepares post-campaign report: executive summary, KPI actual…">
        <bpmn:documentation>Step 20: Campaign Manager prepares post-campaign report: executive summary, KPI actual vs. target, channel performance comparison, cost analysis and ROI, customer acquisition metrics, creative performance assessment (which assets performed best), key learnings and recommendations for future campaigns
Responsible (R): Campaign Manager
Accountable (A): CMO
Duration: 4 hours/campaign</bpmn:documentation>
        <bpmn:incoming>W83_Flow58</bpmn:incoming>
        <bpmn:outgoing>W83_Flow59</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W83_Task29" name="Campaign Manager presents post-campaign report to CMO, VP Merchandising, and…">
        <bpmn:documentation>Step 21: Campaign Manager presents post-campaign report to CMO, VP Merchandising, and CFO; lessons learned documented and archived in system linked to campaign record; key insights shared with Category Managers for future assortment and pricing decisions (W1, W40)
Responsible (R): Campaign Manager / CMO
Accountable (A): CEO (for major campaigns)
Duration: 1 hour/campaign</bpmn:documentation>
        <bpmn:incoming>W83_Flow59</bpmn:incoming>
        <bpmn:outgoing>W83_Flow60</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W83_Task30" name="System archives campaign record with full documentation: brief, creative…">
        <bpmn:documentation>Step 22: System archives campaign record with full documentation: brief, creative assets, performance data, cost tracking, and post-campaign report; available for future campaign planning reference
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W83_Flow60</bpmn:incoming>
        <bpmn:outgoing>W83_Flow61</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W83_Task31" name="Quarterly: CMO reviews portfolio of campaign performance across all campaigns…">
        <bpmn:documentation>Step 23: Quarterly: CMO reviews portfolio of campaign performance across all campaigns in the quarter — total marketing spend vs. attributed revenue, overall marketing ROI, most effective channels, seasonal patterns; presents to CEO in quarterly management committee (W35.14)
Responsible (R): CMO
Accountable (A): CEO
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W83_Flow61</bpmn:incoming>
        <bpmn:outgoing>W83_Flow62</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W83_Task32" name="Annual: CMO and CFO review annual marketing budget utilization and ROI; propose…">
        <bpmn:documentation>Step 24: Annual: CMO and CFO review annual marketing budget utilization and ROI; propose next year&#x27;s marketing budget allocation by channel per W26 annual budget cycle
Responsible (R): CMO / CFO
Accountable (A): CEO
Duration: 4 hours/year</bpmn:documentation>
        <bpmn:incoming>W83_Flow62</bpmn:incoming>
        <bpmn:outgoing>W83_Flow63</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W83_Task33" name="At campaign brief approval (step 4), Campaign Manager creates campaign purchase…">
        <bpmn:documentation>Step 25: At campaign brief approval (step 4), Campaign Manager creates campaign purchase requisitions for external costs: (a) creative agency fees per W62 contract, (b) media placement costs, (c) printing and production costs, (d) distribution / logistics costs; all costs tagged to campaign cost center
Responsible (R): Campaign Manager
Accountable (A): CMO
Duration: 1 hour/campaign</bpmn:documentation>
        <bpmn:incoming>W83_Flow63</bpmn:incoming>
        <bpmn:outgoing>W83_Flow64</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W83_Task34" name="AP Clerk processes campaign vendor invoices per W7C (non-PO) or against…">
        <bpmn:documentation>Step 26: AP Clerk processes campaign vendor invoices per W7C (non-PO) or against campaign PO; system tags expense to campaign cost center; Campaign Manager confirms goods/services received before AP approval
Responsible (R): AP Clerk / Campaign Manager
Accountable (A): AP Supervisor
Duration: Per W7</bpmn:documentation>
        <bpmn:incoming>W83_Flow64</bpmn:incoming>
        <bpmn:outgoing>W83_Flow65</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W83_Task35" name="Monthly: Campaign Manager generates campaign budget utilization report — total…">
        <bpmn:documentation>Step 27: Monthly: Campaign Manager generates campaign budget utilization report — total spend by campaign, spend by channel, budget vs. actual per campaign, and remaining budget for active campaigns
Responsible (R): Campaign Manager
Accountable (A): CMO
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W83_Flow65</bpmn:incoming>
        <bpmn:outgoing>W83_Flow66</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W83_End36" name="Complete">
        <bpmn:incoming>W83_Flow66</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W83_Annotation37">
        <bpmn:text>Controls: - CTL-187 (ensure marketing spend &amp; loyalty-fraud control.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Marketing Campaign Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W83_Assoc38" sourceRef="W83_Annotation37" targetRef="W83_Start8" associationDirection="None" />
      <bpmn:sequenceFlow id="W83_Flow39" sourceRef="W83_Start8" targetRef="W83_Task9" />
      <bpmn:sequenceFlow id="W83_Flow40" sourceRef="W83_Task9" targetRef="W83_Task10" />
      <bpmn:sequenceFlow id="W83_Flow41" sourceRef="W83_Task10" targetRef="W83_Task11" />
      <bpmn:sequenceFlow id="W83_Flow42" sourceRef="W83_Task11" targetRef="W83_Task12" />
      <bpmn:sequenceFlow id="W83_Flow43" sourceRef="W83_Task12" targetRef="W83_Task13" />
      <bpmn:sequenceFlow id="W83_Flow44" sourceRef="W83_Task13" targetRef="W83_Task14" />
      <bpmn:sequenceFlow id="W83_Flow45" sourceRef="W83_Task14" targetRef="W83_Task15" />
      <bpmn:sequenceFlow id="W83_Flow46" sourceRef="W83_Task15" targetRef="W83_Task16" />
      <bpmn:sequenceFlow id="W83_Flow47" sourceRef="W83_Task16" targetRef="W83_Task17" />
      <bpmn:sequenceFlow id="W83_Flow48" sourceRef="W83_Task17" targetRef="W83_Task18" />
      <bpmn:sequenceFlow id="W83_Flow49" sourceRef="W83_Task18" targetRef="W83_Task19" />
      <bpmn:sequenceFlow id="W83_Flow50" sourceRef="W83_Task19" targetRef="W83_Task20" />
      <bpmn:sequenceFlow id="W83_Flow51" sourceRef="W83_Task20" targetRef="W83_Task21" />
      <bpmn:sequenceFlow id="W83_Flow52" sourceRef="W83_Task21" targetRef="W83_Task22" />
      <bpmn:sequenceFlow id="W83_Flow53" sourceRef="W83_Task22" targetRef="W83_Task23" />
      <bpmn:sequenceFlow id="W83_Flow54" sourceRef="W83_Task23" targetRef="W83_Task24" />
      <bpmn:sequenceFlow id="W83_Flow55" sourceRef="W83_Task24" targetRef="W83_Task25" />
      <bpmn:sequenceFlow id="W83_Flow56" sourceRef="W83_Task25" targetRef="W83_Task26" />
      <bpmn:sequenceFlow id="W83_Flow57" sourceRef="W83_Task26" targetRef="W83_Task27" />
      <bpmn:sequenceFlow id="W83_Flow58" sourceRef="W83_Task27" targetRef="W83_Task28" />
      <bpmn:sequenceFlow id="W83_Flow59" sourceRef="W83_Task28" targetRef="W83_Task29" />
      <bpmn:sequenceFlow id="W83_Flow60" sourceRef="W83_Task29" targetRef="W83_Task30" />
      <bpmn:sequenceFlow id="W83_Flow61" sourceRef="W83_Task30" targetRef="W83_Task31" />
      <bpmn:sequenceFlow id="W83_Flow62" sourceRef="W83_Task31" targetRef="W83_Task32" />
      <bpmn:sequenceFlow id="W83_Flow63" sourceRef="W83_Task32" targetRef="W83_Task33" />
      <bpmn:sequenceFlow id="W83_Flow64" sourceRef="W83_Task33" targetRef="W83_Task34" />
