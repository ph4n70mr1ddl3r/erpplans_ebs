    <bpmn:process id="W_W149" name="W149. Bank &amp; Credit Card Partnership Management" isExecutable="false">
      <bpmn:documentation>Trigger: Seasonal promo planning; or bank-initiated partnership proposal
Frequency: Quarterly campaigns
Volume: Covers top 3–5 credit card issuers in the Philippines
Owner: Partnerships Manager
Participants: Marketing, Finance, Bank Partner, POS/IT
Source: workflow W149 — Bank &amp; Credit Card Partnership Management</bpmn:documentation>
      <bpmn:laneSet id="W149_LaneSet7">
        <bpmn:lane id="W149_Lane1" name="Partnerships Mgr">
        <bpmn:flowNodeRef>W149_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W149_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W149_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W149_Lane2" name="Finance Mgr">
        <bpmn:flowNodeRef>W149_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W149_Lane3" name="IT">
        <bpmn:flowNodeRef>W149_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W149_Lane4" name="Marketing">
        <bpmn:flowNodeRef>W149_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W149_Lane5" name="Cashier">
        <bpmn:flowNodeRef>W149_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W149_Lane6" name="Finance">
        <bpmn:flowNodeRef>W149_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W149_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W149_Start8" name="Seasonal promo planning; or bank-initiated partnership proposal">
        <bpmn:outgoing>W149_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W149_Task9" name="Negotiation">
        <bpmn:documentation>Step 1: Negotiation: Define promo mechanics (e.g., 0% interest for 12 months, 5% rebate, or points multiplier)
Responsible (R): Partnerships Mgr
Accountable (A): CMO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W149_Flow19</bpmn:incoming>
        <bpmn:outgoing>W149_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W149_Task10" name="Financial Modeling">
        <bpmn:documentation>Step 2: Financial Modeling: Calculate cost-sharing (Bank vs. BuildRight) and impact on margin
Responsible (R): Finance Mgr
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W149_Flow20</bpmn:incoming>
        <bpmn:outgoing>W149_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W149_Task11" name="POS Configuration">
        <bpmn:documentation>Step 3: POS Configuration: Setup Bank BIN (Bank Identification Number) ranges and promo codes in POS
Responsible (R): IT / POS Team
Accountable (A): Partnerships Mgr
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W149_Flow21</bpmn:incoming>
        <bpmn:outgoing>W149_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W149_Task12" name="Communication">
        <bpmn:documentation>Step 4: Communication: Brief store staff on offer details and settlement process (e.g., specific card terminals)
Responsible (R): Marketing
Accountable (A): Store Mgr
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W149_Flow22</bpmn:incoming>
        <bpmn:outgoing>W149_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W149_Task13" name="Execution">
        <bpmn:documentation>Step 5: Execution: Customer uses partner card at POS; system auto-applies benefit (rebate/points)
Responsible (R): Cashier / System
Accountable (A): —
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W149_Flow23</bpmn:incoming>
        <bpmn:outgoing>W149_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W149_Task14" name="Settlement">
        <bpmn:documentation>Step 6: Settlement: Reconcile partner bank statements vs. POS records; invoice bank for their cost share
Responsible (R): Finance (AR)
Accountable (A): Controller
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W149_Flow24</bpmn:incoming>
        <bpmn:outgoing>W149_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W149_Task15" name="ROI Review">
        <bpmn:documentation>Step 7: ROI Review: Measure incremental sales and new customer acquisition from the partnership
Responsible (R): Partnerships Mgr
Accountable (A): CMO
Duration: 2 hours/campaign</bpmn:documentation>
        <bpmn:incoming>W149_Flow25</bpmn:incoming>
        <bpmn:outgoing>W149_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W149_End16" name="Complete">
        <bpmn:incoming>W149_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W149_Annotation17">
        <bpmn:text>Controls: - CTL-281 (ensure controlled execution — Campaign Planning &amp; Execution (PA-14.1).) | - operational: Partnerships Manager review and approval gate; operational: periodic reconciliation against source documents
Owner: Partnerships Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W149_Assoc18" sourceRef="W149_Annotation17" targetRef="W149_Start8" associationDirection="None" />
