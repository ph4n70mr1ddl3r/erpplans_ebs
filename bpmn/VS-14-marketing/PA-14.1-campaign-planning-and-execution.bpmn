      <bpmn:sequenceFlow id="W926_Flow17" sourceRef="W926_Task8" targetRef="W926_Task9" />
      <bpmn:sequenceFlow id="W926_Flow18" sourceRef="W926_Task9" targetRef="W926_Task10" />
      <bpmn:sequenceFlow id="W926_Flow19" sourceRef="W926_Task10" targetRef="W926_End11" />
    </bpmn:process>
