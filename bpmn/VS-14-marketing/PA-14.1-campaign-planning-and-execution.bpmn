    <bpmn:process id="W_W1551" name="W1551. Local Store Marketing Campaign Execution, Barangay-Level Outreach &amp; Community Event Partnership" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly local marketing calendar cycle; or new store pre-opening; or barangay/community event opportunity
Frequency: ~200–300 local campaigns/month across all stores (each store executes 1–2 local initiatives/month)
Volume: Barangay fiestas (1,000+ events/year nationwide), school-building drives, local sports tournament sponsorships
Owner: Store Manager
Participants: Store Manager, Sales Associates, Marketing Coordinator (HQ), Barangay officials
Source: workflow W1551 — Local Store Marketing Campaign Execution, Barangay-Level Outreach &amp; Community Event Partnership</bpmn:documentation>
      <bpmn:laneSet id="W1551_LaneSet3">
        <bpmn:lane id="W1551_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W1551_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1551_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1551_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1551_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1551_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1551_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1551_Lane2" name="Marketing Coordinator">
        <bpmn:flowNodeRef>W1551_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1551_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1551_Start4" name="Monthly local marketing calendar cycle; or new store pre-opening; or barangay/community…">
        <bpmn:outgoing>W1551_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1551_Task5" name="Monthly local marketing plan">
        <bpmn:documentation>Step 1: Monthly local marketing plan: Store Manager submits monthly local marketing plan via mobile app — proposed activities (barangay event sponsorship, school partnership, local sports team support, community workshop), budget request (up to PHP 15,000/month per store), expected foot traffic impact; Marketing Coordinator (HQ) reviews and approves within brand guidelines
Responsible (R): Store Manager
Accountable (A): Marketing Coordinator
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W1551_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1551_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1551_Task6" name="Barangay relationship management">
        <bpmn:documentation>Step 2: Barangay relationship management: Store Manager maintains ongoing relationship with barangay captain and council — attends barangay assembly when invited, participates in disaster preparedness planning (W49), offers BuildRight as community resource for building materials during emergencies; Store Manager logs all barangay interactions in CRM (W253)
Responsible (R): Store Manager
Accountable (A): VP Store Operations
Duration: 2–3 hours/month</bpmn:documentation>
        <bpmn:incoming>W1551_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1551_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1551_Task7" name="Community event execution">
        <bpmn:documentation>Step 3: Community event execution: For approved events — Store Manager coordinates logistics (booth setup, product display, promotional flyers, staff assignment); Sales Associates staff the BuildRight presence at the event; distribute promotional materials with store-specific discount codes (trackable); collect customer leads for loyalty enrollment (W263)
Responsible (R): Store Manager / Sales Associates
Accountable (A): Marketing Coordinator
Duration: 4–8 hours/event</bpmn:documentation>
        <bpmn:incoming>W1551_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1551_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1551_Task8" name="Local partnership development">
        <bpmn:documentation>Step 4: Local partnership development: Store Manager identifies and develops partnerships with local contractors&#x27; associations, technical/vocational schools (TESDA), and homeowner associations — offers exclusive store tours, contractor loyalty enrollment drives (W897), workshop invitations (W147); logs partnership details in CRM
Responsible (R): Store Manager
Accountable (A): VP Store Operations
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1551_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1551_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1551_Task9" name="Budget reconciliation &amp; ROI tracking">
        <bpmn:documentation>Step 5: Budget reconciliation &amp; ROI tracking: After each local campaign, Store Manager submits expense receipts and outcome metrics — foot traffic during event period (+/- vs. baseline), new loyalty sign-ups, redemption of event-specific discount codes, incremental sales; Marketing Coordinator reviews ROI across all 200 stores monthly
Responsible (R): Store Manager / Marketing Coordinator
Accountable (A): VP Marketing
Duration: 30 min/event</bpmn:documentation>
        <bpmn:incoming>W1551_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1551_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1551_Task10" name="Best practice sharing">
        <bpmn:documentation>Step 6: Best practice sharing: Marketing Coordinator identifies top-performing local campaigns each month; creates best practice brief distributed to all Store Managers; annual &quot;Best Local Marketing&quot; award at company meeting recognizes outstanding community engagement
Responsible (R): Marketing Coordinator
Accountable (A): VP Marketing
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W1551_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1551_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1551_End11" name="Complete">
        <bpmn:incoming>W1551_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1551_Annotation12">
        <bpmn:text>Controls: - CTL-281 (ensure controlled execution — Campaign Planning &amp; Execution (PA-14.1).) | - operational: Store Manager review and approval gate; operational: periodic reconciliation against source documents
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1551_Assoc13" sourceRef="W1551_Annotation12" targetRef="W1551_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1551_Flow14" sourceRef="W1551_Start4" targetRef="W1551_Task5" />
      <bpmn:sequenceFlow id="W1551_Flow15" sourceRef="W1551_Task5" targetRef="W1551_Task6" />
      <bpmn:sequenceFlow id="W1551_Flow16" sourceRef="W1551_Task6" targetRef="W1551_Task7" />
      <bpmn:sequenceFlow id="W1551_Flow17" sourceRef="W1551_Task7" targetRef="W1551_Task8" />
      <bpmn:sequenceFlow id="W1551_Flow18" sourceRef="W1551_Task8" targetRef="W1551_Task9" />
      <bpmn:sequenceFlow id="W1551_Flow19" sourceRef="W1551_Task9" targetRef="W1551_Task10" />
      <bpmn:sequenceFlow id="W1551_Flow20" sourceRef="W1551_Task10" targetRef="W1551_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1551_diag">
