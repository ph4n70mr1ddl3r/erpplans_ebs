    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1443_diag">
      <bpmndi:BPMNPlane id="W1443_plane" bpmnElement="W_W1443">
        <bpmndi:BPMNShape id="W1443_Lane1_di" bpmnElement="W1443_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1443_Lane2_di" bpmnElement="W1443_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1443_Lane3_di" bpmnElement="W1443_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1443_Lane4_di" bpmnElement="W1443_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1443_Task7_di" bpmnElement="W1443_Task7"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1443_Task8_di" bpmnElement="W1443_Task8"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
