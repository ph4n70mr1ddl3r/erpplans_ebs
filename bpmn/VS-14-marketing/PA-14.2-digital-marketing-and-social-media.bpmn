    <bpmn:process id="W_W142" name="W142. Social Media &amp; Influencer Management" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly content calendar; or influencer partnership agreement
Frequency: Daily posts; monthly influencer activations
Volume: Managing ~5–7 social channels (Facebook, TikTok, Instagram, YouTube, Viber)
Owner: Social Media Manager
Participants: Content Specialists, Influencers, Customer Service (for moderation), CMO
Source: workflow W142 — Social Media &amp; Influencer Management</bpmn:documentation>
      <bpmn:laneSet id="W142_LaneSet6">
        <bpmn:lane id="W142_Lane1" name="Social Media Mgr">
        <bpmn:flowNodeRef>W142_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W142_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W142_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W142_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W142_Lane2" name="Content Specialist">
        <bpmn:flowNodeRef>W142_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W142_Lane3" name="Legal">
        <bpmn:flowNodeRef>W142_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W142_Lane4" name="Influencer">
        <bpmn:flowNodeRef>W142_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W142_Lane5" name="CS Team">
        <bpmn:flowNodeRef>W142_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W142_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W142_Start7" name="Weekly content calendar; or influencer partnership agreement">
        <bpmn:outgoing>W142_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W142_Task8" name="Content Calendar">
        <bpmn:documentation>Step 1: Content Calendar: Develop 4-week rolling calendar aligned with W83 campaigns and W13 promos
Responsible (R): Social Media Mgr
Accountable (A): CMO
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W142_Flow18</bpmn:incoming>
        <bpmn:outgoing>W142_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W142_Task9" name="Content Creation">
        <bpmn:documentation>Step 2: Content Creation: Produce short-form videos (TikTok/Reels), product feature posts, and DIY tips
Responsible (R): Content Specialist
Accountable (A): Social Media Mgr
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W142_Flow19</bpmn:incoming>
        <bpmn:outgoing>W142_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W142_Task10" name="Influencer Sourcing">
        <bpmn:documentation>Step 3: Influencer Sourcing: Identify DIY/Home-Improvement influencers; vet for audience fit and engagement rate
Responsible (R): Social Media Mgr
Accountable (A): CMO
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W142_Flow20</bpmn:incoming>
        <bpmn:outgoing>W142_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W142_Task11" name="Contracting">
        <bpmn:documentation>Step 4: Contracting: Sign partnership agreements (W62); define deliverables (e.g., 2 videos, 3 stories)
Responsible (R): Legal / Social Mgr
Accountable (A): CMO
Duration: 2 hours/influencer</bpmn:documentation>
        <bpmn:incoming>W142_Flow21</bpmn:incoming>
        <bpmn:outgoing>W142_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W142_Task12" name="Campaign Execution">
        <bpmn:documentation>Step 5: Campaign Execution: Influencer posts content; system tracks referral traffic and promo code usage
Responsible (R): Influencer / Social Mgr
Accountable (A): —
Duration: Per campaign</bpmn:documentation>
        <bpmn:incoming>W142_Flow22</bpmn:incoming>
        <bpmn:outgoing>W142_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W142_Task13" name="Community Management">
        <bpmn:documentation>Step 6: Community Management: Respond to comments/DMs; escalate complaints to W41; moderate &quot;trolls&quot;
Responsible (R): CS Team / Social Mgr
Accountable (A): —
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W142_Flow23</bpmn:incoming>
        <bpmn:outgoing>W142_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W142_Task14" name="Performance Review">
        <bpmn:documentation>Step 7: Performance Review: Monthly report on reach, engagement, sentiment, and conversion ROI
Responsible (R): Social Media Mgr
Accountable (A): CMO
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W142_Flow24</bpmn:incoming>
        <bpmn:outgoing>W142_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W142_End15" name="Complete">
        <bpmn:incoming>W142_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W142_Annotation16">
        <bpmn:text>Controls: - CTL-282 (ensure controlled execution — Digital Marketing &amp; Social Media (PA-14.2).) | - operational: Social Media Manager review and approval gate
Owner: Social Media Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W142_Assoc17" sourceRef="W142_Annotation16" targetRef="W142_Start7" associationDirection="None" />
