    <bpmn:process id="W_W676" name="W676. Digital Marketing Campaign Operations &amp; Cross-Channel Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Campaign launch date; ongoing campaign optimization cycle
Frequency: Daily monitoring during active campaigns; weekly performance review; monthly cross-channel analysis
Volume: 6 major campaigns/year + 12 monthly hot deals + always-on digital marketing across Facebook, Google, YouTube, TikTok, email, SMS, app push
Owner: Digital Marketing Manager
Participants: Social Media Specialist, Content Creator, Media Buyer, CX Analytics Lead, Ecommerce Manager
Source: workflow W676 — Digital Marketing Campaign Operations &amp; Cross-Channel Execution</bpmn:documentation>
      <bpmn:laneSet id="W676_LaneSet5">
        <bpmn:lane id="W676_Lane1" name="Digital Marketing Manager">
        <bpmn:flowNodeRef>W676_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W676_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W676_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W676_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W676_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W676_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W676_Lane2" name="Media Buyer">
        <bpmn:flowNodeRef>W676_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W676_Lane3" name="Social Media Specialist">
        <bpmn:flowNodeRef>W676_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W676_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W676_Lane4" name="CX Analytics Lead">
        <bpmn:flowNodeRef>W676_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W676_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W676_Start6" name="Campaign launch date; ongoing campaign optimization cycle">
        <bpmn:outgoing>W676_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W676_Task7" name="Digital Marketing Manager activates campaign per approved plan from W83…">
        <bpmn:documentation>Step 1: Digital Marketing Manager activates campaign per approved plan from W83: configures campaign in marketing automation platform with audience segment per W673, creative assets from W190, channel mix (social media, email, SMS, app push, Google Ads), budget allocation, and flight dates
Responsible (R): Digital Marketing Manager
Accountable (A): Marketing Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W676_Flow19</bpmn:incoming>
        <bpmn:outgoing>W676_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W676_Task8" name="Media Buyer launches paid media: Facebook/Meta Ads Manager, Google Ads (Search…">
        <bpmn:documentation>Step 2: Media Buyer launches paid media: Facebook/Meta Ads Manager, Google Ads (Search + Display + Shopping), YouTube pre-roll, TikTok ads; sets targeting parameters, bid strategy, and daily budget caps; implements UTM tracking for attribution per W565
Responsible (R): Media Buyer
Accountable (A): Digital Marketing Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W676_Flow20</bpmn:incoming>
        <bpmn:outgoing>W676_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W676_Task9" name="Social Media Specialist publishes organic content: Facebook posts, Instagram…">
        <bpmn:documentation>Step 3: Social Media Specialist publishes organic content: Facebook posts, Instagram feed/stories/reels, TikTok content per W142; coordinates with influencer content calendar
Responsible (R): Social Media Specialist
Accountable (A): Digital Marketing Manager
Duration: 3 hours</bpmn:documentation>
        <bpmn:incoming>W676_Flow21</bpmn:incoming>
        <bpmn:outgoing>W676_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W676_Task10" name="Daily during campaign: Digital Marketing Manager monitors real-time performance…">
        <bpmn:documentation>Step 4: Daily during campaign: Digital Marketing Manager monitors real-time performance dashboard: spend pacing, impression delivery, click-through rate, conversion rate, ROAS (return on ad spend), cost per acquisition; flags underperforming channels for optimization
Responsible (R): Digital Marketing Manager
Accountable (A): Marketing Manager
Duration: 1 hour/day</bpmn:documentation>
        <bpmn:incoming>W676_Flow22</bpmn:incoming>
        <bpmn:outgoing>W676_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W676_Task11" name="Social Media Specialist monitors brand mentions, responds to comments/messages…">
        <bpmn:documentation>Step 5: Social Media Specialist monitors brand mentions, responds to comments/messages, escalates negative sentiment per W142 crisis protocol
Responsible (R): Social Media Specialist
Accountable (A): Digital Marketing Manager
Duration: 2 hours/day</bpmn:documentation>
        <bpmn:incoming>W676_Flow23</bpmn:incoming>
        <bpmn:outgoing>W676_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W676_Task12" name="Digital Marketing Manager performs mid-campaign optimization: reallocates…">
        <bpmn:documentation>Step 6: Digital Marketing Manager performs mid-campaign optimization: reallocates budget from underperforming to overperforming channels, adjusts creative rotation, tests new audience segments, modifies bid strategies
Responsible (R): Digital Marketing Manager
Accountable (A): Marketing Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W676_Flow24</bpmn:incoming>
        <bpmn:outgoing>W676_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W676_Task13" name="CX Analytics Lead provides segment performance data: which customer segments…">
        <bpmn:documentation>Step 7: CX Analytics Lead provides segment performance data: which customer segments are responding, attribution across channels, incremental revenue per W565
Responsible (R): CX Analytics Lead
Accountable (A): Digital Marketing Manager
Duration: 3 hours</bpmn:documentation>
        <bpmn:incoming>W676_Flow25</bpmn:incoming>
        <bpmn:outgoing>W676_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W676_Task14" name="Weekly: Digital Marketing Manager produces campaign performance report for…">
        <bpmn:documentation>Step 8: Weekly: Digital Marketing Manager produces campaign performance report for Marketing Manager: channel-level metrics, creative performance, audience insights, spend vs. budget, and optimization recommendations
Responsible (R): Digital Marketing Manager
Accountable (A): Marketing Manager
Duration: 3 hours</bpmn:documentation>
        <bpmn:incoming>W676_Flow26</bpmn:incoming>
        <bpmn:outgoing>W676_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W676_Task15" name="Post-campaign: Digital Marketing Manager compiles comprehensive performance…">
        <bpmn:documentation>Step 9: Post-campaign: Digital Marketing Manager compiles comprehensive performance report feeding into W565 ROI analysis; documents learnings for future campaign planning
Responsible (R): Digital Marketing Manager
Accountable (A): Marketing Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W676_Flow27</bpmn:incoming>
        <bpmn:outgoing>W676_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W676_End16" name="Complete">
        <bpmn:incoming>W676_Flow28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W676_Annotation17">
        <bpmn:text>Controls: - CTL-282 (ensure controlled execution — Digital Marketing &amp; Social Media (PA-14.2).) | - operational: Digital Marketing Manager review and approval gate
Owner: Digital Marketing Manager</bpmn:text>
      </bpmn:textAnnotation>
