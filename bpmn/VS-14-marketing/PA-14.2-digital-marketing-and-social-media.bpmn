    <bpmn:process id="W_W736" name="W736. Marketing Data Platform Daily Operations &amp; Campaign Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Start of marketing operations day; or campaign performance alert
Frequency: Daily review; real-time campaign monitoring
Volume: ~5–10 active marketing campaigns at any time; ~1M+ customer touchpoints/day (email, SMS, push, social)
Owner: Marketing Analytics Manager
Participants: Campaign Manager, Digital Marketing Specialist, Customer Experience Manager, CMO
Source: workflow W736 — Marketing Data Platform Daily Operations &amp; Campaign Analytics</bpmn:documentation>
      <bpmn:laneSet id="W736_LaneSet2">
        <bpmn:lane id="W736_Lane1" name="Marketing Analytics Manager">
        <bpmn:flowNodeRef>W736_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W736_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W736_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W736_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W736_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W736_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W736_Start3" name="Start of marketing operations day; or campaign performance alert">
        <bpmn:outgoing>W736_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W736_Task4" name="Morning campaign performance dashboard review">
        <bpmn:documentation>Step 1: Morning campaign performance dashboard review: Marketing Analytics Manager reviews: (a) active campaign performance: (i) email campaigns: open rate, click-through rate, conversion rate, unsubscribe rate; (ii) SMS campaigns: delivery rate, click rate, opt-out rate; (iii) push notifications: delivery rate, open rate, app engagement; (iv) social media ads per W142: impressions, CTR, cost-per-click, ROAS; (v) in-store promotional lift per W13: promoted SKU sales vs. baseline; (b) campaign vs. target: each campaign&#x27;s KPI vs. its planned target per W83; (c) alert on underperforming campaigns: any campaign below 70% of target KPI flagged for review
Responsible (R): Marketing Analytics Manager
Accountable (A): CMO
Duration: 20-30 min/day</bpmn:documentation>
        <bpmn:incoming>W736_Flow11</bpmn:incoming>
        <bpmn:outgoing>W736_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W736_Task5" name="Real-time optimization">
        <bpmn:documentation>Step 2: Real-time optimization: for underperforming campaigns: (a) Marketing Analytics Manager diagnoses: (i) creative issue: low engagement despite good reach → test new creative per W190; (ii) audience issue: good engagement but low conversion → refine targeting per W673 segmentation; (iii) offer issue: good engagement but no purchase → adjust offer value or terms; (iv) channel issue: campaign performing well on one channel but not others → reallocate budget; (b) implement optimizations: (i) A/B test new creative or copy; (ii) adjust audience targeting rules; (iii) modify offer parameters; (iv) reallocate budget from underperforming to overperforming channels
Responsible (R): Marketing Analytics Manager
Accountable (A): Campaign Manager
Duration: 30-60 min/day</bpmn:documentation>
        <bpmn:incoming>W736_Flow12</bpmn:incoming>
        <bpmn:outgoing>W736_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W736_Task6" name="Data pipeline health check">
        <bpmn:documentation>Step 3: Data pipeline health check: verify marketing data platform pipelines: (a) POS transaction data feed: last successful sync, data freshness (&lt;24 hours); (b) ecommerce behavioral data: website clicks, cart activity, search queries flowing into MDP; (c) loyalty transaction feed: points earning/redemption events updating customer profiles; (d) third-party data feeds: social media platform metrics, email platform metrics, ad platform metrics; (e) any pipeline failures: escalate to IT per W733 API monitoring
Responsible (R): Marketing Analytics Manager / IT
Accountable (A): IT Manager
Duration: 10-15 min/day</bpmn:documentation>
        <bpmn:incoming>W736_Flow13</bpmn:incoming>
        <bpmn:outgoing>W736_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W736_Task7" name="Weekly campaign analytics report">
        <bpmn:documentation>Step 4: Weekly campaign analytics report: Marketing Analytics Manager compiles weekly report: (a) campaign-level performance summary with KPI tracking; (b) channel performance comparison: email vs. SMS vs. push vs. social vs. in-store; (c) audience segment performance: which segments responded best; (d) attribution analysis: last-click, first-click, and multi-touch attribution for major campaigns; (e) cost analysis: cost per acquisition, cost per conversion, ROAS by campaign and channel; (f) recommendations for next week&#x27;s campaign adjustments
Responsible (R): Marketing Analytics Manager
Accountable (A): CMO
Duration: 2-3 hours/week</bpmn:documentation>
        <bpmn:incoming>W736_Flow14</bpmn:incoming>
        <bpmn:outgoing>W736_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W736_End8" name="Complete">
        <bpmn:incoming>W736_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W736_Annotation9">
        <bpmn:text>Controls: - CTL-282 (ensure controlled execution — Digital Marketing &amp; Social Media (PA-14.2).) | - operational: Marketing Analytics Manager review and approval gate
Owner: Marketing Analytics Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W736_Assoc10" sourceRef="W736_Annotation9" targetRef="W736_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W736_Flow11" sourceRef="W736_Start3" targetRef="W736_Task4" />
      <bpmn:sequenceFlow id="W736_Flow12" sourceRef="W736_Task4" targetRef="W736_Task5" />
      <bpmn:sequenceFlow id="W736_Flow13" sourceRef="W736_Task5" targetRef="W736_Task6" />
      <bpmn:sequenceFlow id="W736_Flow14" sourceRef="W736_Task6" targetRef="W736_Task7" />
      <bpmn:sequenceFlow id="W736_Flow15" sourceRef="W736_Task7" targetRef="W736_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W736_diag">
      <bpmndi:BPMNPlane id="W736_plane" bpmnElement="W_W736">
        <bpmndi:BPMNShape id="W736_Lane1_di" bpmnElement="W736_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W736_Task4_di" bpmnElement="W736_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
