    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1560_diag">
      <bpmndi:BPMNPlane id="W1560_plane" bpmnElement="W_W1560">
        <bpmndi:BPMNShape id="W1560_Lane1_di" bpmnElement="W1560_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1560_Lane2_di" bpmnElement="W1560_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1560_Task5_di" bpmnElement="W1560_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1560_Task6_di" bpmnElement="W1560_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1560_Task7_di" bpmnElement="W1560_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1560_Task8_di" bpmnElement="W1560_Task8"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
