<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-14.2-digital-marketing-and-social-media" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1350" name="W1350. Email Marketing Campaign Operations, Segmentation &amp; Engagement Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Marketing campaign calendar milestone; or triggered event (abandoned cart, post-purchase, loyalty tier upgrade)
Frequency: 2–3 broadcast campaigns/week; daily triggered/automated emails
Volume: ~600,000 loyalty members + ~5,400 trade and corporate accounts ≈ ~605,400 reachable contacts; average open rate 15–20% for Philippine retail
Owner: Email Marketing Specialist
Participants: Content Specialist, Category Manager (for product selection), Marketing Data Analyst, CMO
Source: workflow W1350 — Email Marketing Campaign Operations, Segmentation &amp; Engagement Analytics</bpmn:documentation>
      <bpmn:laneSet id="W1350_LaneSet6">
        <bpmn:lane id="W1350_Lane1" name="Email Marketing Specialist">
        <bpmn:flowNodeRef>W1350_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1350_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1350_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1350_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1350_Lane2" name="Content Specialist">
        <bpmn:flowNodeRef>W1350_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1350_Lane3" name="CMO">
        <bpmn:flowNodeRef>W1350_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1350_Lane4" name="System">
        <bpmn:flowNodeRef>W1350_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1350_Lane5" name="Marketing Data Analyst">
        <bpmn:flowNodeRef>W1350_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1350_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1350_Start7" name="Marketing campaign calendar milestone; or triggered event (abandoned cart, post-purchase…">
        <bpmn:outgoing>W1350_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1350_Task8" name="Email Marketing Specialist builds audience segment using CRM data: by loyalty…">
        <bpmn:documentation>Step 1: Email Marketing Specialist builds audience segment using CRM data: by loyalty tier, purchase history (category-level), trade account status, geographic region, or last-active date
Responsible (R): Email Marketing Specialist
Accountable (A): CMO
Duration: 30 min/campaign</bpmn:documentation>
        <bpmn:incoming>W1350_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1350_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1350_Task9" name="Content Specialist creates email creative: hero image, product grid (6–12…">
        <bpmn:documentation>Step 2: Content Specialist creates email creative: hero image, product grid (6–12 items), promotional copy in Filipino/English, call-to-action buttons linking to buildright.com.ph or store locator
Responsible (R): Content Specialist
Accountable (A): Email Marketing Specialist
Duration: 2–3 hours/campaign</bpmn:documentation>
        <bpmn:incoming>W1350_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1350_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1350_Task10" name="Email Marketing Specialist configures email in marketing automation platform…">
        <bpmn:documentation>Step 3: Email Marketing Specialist configures email in marketing automation platform: personalization tokens (first name, loyalty points balance, nearest store), dynamic product blocks based on segment, A/B test subject lines
Responsible (R): Email Marketing Specialist
Accountable (A): —
Duration: 1 hour/campaign</bpmn:documentation>
        <bpmn:incoming>W1350_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1350_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1350_Task11" name="CMO or designated approver reviews and approves email content, offer validity…">
        <bpmn:documentation>Step 4: CMO or designated approver reviews and approves email content, offer validity, and audience size
Responsible (R): CMO
Accountable (A): CMO
Duration: 15 min/campaign</bpmn:documentation>
        <bpmn:incoming>W1350_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1350_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1350_Task12" name="System sends email at optimal send time (historically 10 AM Tuesday/Thursday…">
        <bpmn:documentation>Step 5: System sends email at optimal send time (historically 10 AM Tuesday/Thursday for B2C; 8 AM Monday for trade); triggered emails sent in real-time
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1350_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1350_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1350_Task13" name="Email Marketing Specialist monitors real-time dashboard: delivery rate, open…">
        <bpmn:documentation>Step 6: Email Marketing Specialist monitors real-time dashboard: delivery rate, open rate, click-through rate (CTR), unsubscribe rate, spam complaints
Responsible (R): Email Marketing Specialist
Accountable (A): CMO
Duration: 15 min/day</bpmn:documentation>
        <bpmn:incoming>W1350_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1350_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1350_Task14" name="Marketing Data Analyst produces weekly email performance report: segment-level…">
        <bpmn:documentation>Step 7: Marketing Data Analyst produces weekly email performance report: segment-level engagement, revenue attribution (via UTM-tagged links), and list growth/attrition metrics
Responsible (R): Marketing Data Analyst
Accountable (A): CMO
Duration: 2 hours/week</bpmn:documentation>
        <bpmn:incoming>W1350_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1350_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1350_End15" name="Complete">
        <bpmn:incoming>W1350_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1350_Annotation16">
        <bpmn:text>Controls: - CTL-282 (ensure controlled execution — Digital Marketing &amp; Social Media (PA-14.2).) | - operational: Email Marketing Specialist review and approval gate
Owner: Email Marketing Specialist</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1350_Assoc17" sourceRef="W1350_Annotation16" targetRef="W1350_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W1350_Flow18" sourceRef="W1350_Start7" targetRef="W1350_Task8" />
      <bpmn:sequenceFlow id="W1350_Flow19" sourceRef="W1350_Task8" targetRef="W1350_Task9" />
