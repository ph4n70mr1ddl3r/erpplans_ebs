    <bpmn:process id="W_W1351" name="W1351. Customer Referral Program Operations, Reward Fulfillment &amp; Fraud Prevention" isExecutable="false">
      <bpmn:documentation>Trigger: Existing loyalty member shares referral link/code with a new customer
Frequency: Continuous (always-on program)
Volume: ~2,000–3,000 referral attempts/month; ~800–1,200 successful conversions (40% conversion rate)
Owner: Loyalty Program Manager
Participants: Customer (Referrer), Customer (Referee), Customer Service, Finance (points liability), Marketing Data Analyst
Source: workflow W1351 — Customer Referral Program Operations, Reward Fulfillment &amp; Fraud Prevention</bpmn:documentation>
      <bpmn:laneSet id="W1351_LaneSet6">
        <bpmn:lane id="W1351_Lane1" name="System">
        <bpmn:flowNodeRef>W1351_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1351_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1351_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1351_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1351_Lane2" name="Customer">
        <bpmn:flowNodeRef>W1351_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1351_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1351_Lane3" name="Loyalty Program Manager">
        <bpmn:flowNodeRef>W1351_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1351_Lane4" name="Customer Service">
        <bpmn:flowNodeRef>W1351_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1351_Lane5" name="Marketing Data Analyst">
        <bpmn:flowNodeRef>W1351_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1351_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1351_Start7" name="Existing loyalty member shares referral link/code with a new customer">
        <bpmn:outgoing>W1351_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1351_Task8" name="Referrer generates unique referral code/link via buildright.com.ph account or…">
        <bpmn:documentation>Step 1: Referrer generates unique referral code/link via buildright.com.ph account or mobile app; system creates referral record linked to referrer&#x27;s loyalty ID
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1351_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1351_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1351_Task9" name="Referee uses referral link/code during online registration or presents code at…">
        <bpmn:documentation>Step 2: Referee uses referral link/code during online registration or presents code at POS during first in-store purchase
Responsible (R): Customer (Referee)
Accountable (A): —
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W1351_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1351_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1351_Task10" name="System validates referral: referee must be a new loyalty member (no prior…">
        <bpmn:documentation>Step 3: System validates referral: referee must be a new loyalty member (no prior purchase history), with a unique name, phone, and address; flags duplicates for manual review
Responsible (R): System
Accountable (A): Loyalty Program Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1351_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1351_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1351_Task11" name="Referee makes first qualifying purchase (minimum PHP 2,000 single receipt…">
        <bpmn:documentation>Step 4: Referee makes first qualifying purchase (minimum PHP 2,000 single receipt within 30 days of registration)
Responsible (R): Customer (Referee)
Accountable (A): —
Duration: —</bpmn:documentation>
        <bpmn:incoming>W1351_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1351_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1351_Task12" name="System auto-awards referral bonus: Referrer receives 500 points (PHP 500…">
        <bpmn:documentation>Step 5: System auto-awards referral bonus: Referrer receives 500 points (PHP 500 value), Referee receives 200 points (PHP 200 value); points posted within 24 hours
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1351_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1351_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1351_Task13" name="Loyalty Program Manager reviews weekly fraud detection report: flags clusters…">
        <bpmn:documentation>Step 6: Loyalty Program Manager reviews weekly fraud detection report: flags clusters from same IP address, same household address, rapid sequential referrals, or referee purchase-then-return patterns
Responsible (R): Loyalty Program Manager
Accountable (A): CMO
Duration: 1 hour/week</bpmn:documentation>
        <bpmn:incoming>W1351_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1351_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1351_Task14" name="Customer Service processes referral inquiries and disputes (referee did not…">
        <bpmn:documentation>Step 7: Customer Service processes referral inquiries and disputes (referee did not receive points, referral code not recognized at POS)
Responsible (R): Customer Service
Accountable (A): Loyalty Program Manager
Duration: 10 min/inquiry</bpmn:documentation>
        <bpmn:incoming>W1351_Flow25</bpmn:incoming>
        <bpmn:outgoing>W1351_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1351_Task15" name="Marketing Data Analyst produces monthly referral program performance report…">
        <bpmn:documentation>Step 8: Marketing Data Analyst produces monthly referral program performance report: new member acquisition, conversion rate, points liability, cost-per-acquisition, and referral chain analysis (referees who become referrers)
Responsible (R): Marketing Data Analyst
Accountable (A): CMO
Duration: 3 hours/month</bpmn:documentation>
        <bpmn:incoming>W1351_Flow26</bpmn:incoming>
        <bpmn:outgoing>W1351_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1351_End16" name="Complete">
        <bpmn:incoming>W1351_Flow27</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1351_Annotation17">
        <bpmn:text>Controls: - CTL-282 (ensure controlled execution — Digital Marketing &amp; Social Media (PA-14.2).) | - operational: Loyalty Program Manager review and approval gate
Owner: Loyalty Program Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1351_Assoc18" sourceRef="W1351_Annotation17" targetRef="W1351_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W1351_Flow19" sourceRef="W1351_Start7" targetRef="W1351_Task8" />
