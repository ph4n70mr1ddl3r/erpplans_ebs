    <bpmn:process id="W_W143" name="W143. Public Relations &amp; Corporate Communications" isExecutable="false">
      <bpmn:documentation>Trigger: New store opening (W16); major company milestone; or crisis (W134)
Frequency: Monthly press releases; ad-hoc media events
Volume: ~12–15 press releases/year
Owner: PR Manager
Participants: CEO, CMO, Legal, external PR agency
Source: workflow W143 — Public Relations &amp; Corporate Communications</bpmn:documentation>
      <bpmn:laneSet id="W143_LaneSet2">
        <bpmn:lane id="W143_Lane1" name="PR Manager">
        <bpmn:flowNodeRef>W143_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W143_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W143_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W143_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W143_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W143_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W143_Start3" name="New store opening (W16); major company milestone; or crisis (W134)">
        <bpmn:outgoing>W143_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W143_Task4" name="Media List Maintenance">
        <bpmn:documentation>Step 1: Media List Maintenance: Manage database of reporters, editors, and industry bloggers
Responsible (R): PR Manager
Accountable (A): CMO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W143_Flow11</bpmn:incoming>
        <bpmn:outgoing>W143_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W143_Task5" name="Press Release Drafting">
        <bpmn:documentation>Step 2: Press Release Drafting: Write official statements for new store openings, CSR events, or financial results
Responsible (R): PR Manager
Accountable (A): CMO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W143_Flow12</bpmn:incoming>
        <bpmn:outgoing>W143_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W143_Task6" name="Executive Briefing">
        <bpmn:documentation>Step 3: Executive Briefing: Prep CEO/C-suite for media interviews or press conferences
Responsible (R): PR Manager
Accountable (A): CMO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W143_Flow13</bpmn:incoming>
