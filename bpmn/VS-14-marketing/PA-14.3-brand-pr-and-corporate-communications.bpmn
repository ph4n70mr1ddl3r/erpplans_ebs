    <bpmn:process id="W_W153" name="W153. Retail Media Network (RMN) Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor request to purchase premium advertising space on BuildRight digital/physical assets
Frequency: Ongoing; Monthly campaign cycles
Volume: ~20–30 vendors participating; ~50 active ad placements
Owner: Retail Media Manager
Participants: Merchandising, Digital Marketing, Ecommerce, Finance
Source: workflow W153 — Retail Media Network (RMN) Operations</bpmn:documentation>
      <bpmn:laneSet id="W153_LaneSet6">
        <bpmn:lane id="W153_Lane1" name="RMN Manager">
        <bpmn:flowNodeRef>W153_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W153_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W153_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W153_Lane2" name="Vendor">
        <bpmn:flowNodeRef>W153_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W153_Lane3" name="Digital Mktg">
        <bpmn:flowNodeRef>W153_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W153_Lane4" name="System">
        <bpmn:flowNodeRef>W153_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W153_Lane5" name="Finance">
        <bpmn:flowNodeRef>W153_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W153_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W153_Start7" name="Vendor request to purchase premium advertising space on BuildRight digital/physical assets">
        <bpmn:outgoing>W153_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W153_Task8" name="Inventory Mapping">
        <bpmn:documentation>Step 1: Inventory Mapping: Catalog all &quot;ad assets&quot;: website banners, app home screen, email newsletters, in-store digital screens, gondola end-caps
Responsible (R): RMN Manager
Accountable (A): CMO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W153_Flow17</bpmn:incoming>
        <bpmn:outgoing>W153_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W153_Task9" name="Rate Card">
        <bpmn:documentation>Step 2: Rate Card: Define pricing for ad placements (CPM, CPC, or flat fee per week)
Responsible (R): RMN Manager
Accountable (A): CMO
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W153_Flow18</bpmn:incoming>
        <bpmn:outgoing>W153_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W153_Task10" name="Media Booking">
        <bpmn:documentation>Step 3: Media Booking: Vendor selects and books ad space; Category Manager approves for brand alignment
Responsible (R): Vendor / Buyer
Accountable (A): RMN Manager
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W153_Flow19</bpmn:incoming>
        <bpmn:outgoing>W153_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W153_Task11" name="Execution">
        <bpmn:documentation>Step 4: Execution: Upload ad creative to PIM (W50) or digital signage system; ensure tracking links are active
Responsible (R): Digital Mktg
Accountable (A): Ecommerce Mgr
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W153_Flow20</bpmn:incoming>
        <bpmn:outgoing>W153_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W153_Task12" name="Performance Reporting">
        <bpmn:documentation>Step 5: Performance Reporting: Provide vendor with &quot;Closed-Loop&quot; report: ad impressions vs. actual sales lift at POS
Responsible (R): System / RMN Mgr
Accountable (A): RMN Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W153_Flow21</bpmn:incoming>
        <bpmn:outgoing>W153_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W153_Task13" name="Billing">
        <bpmn:documentation>Step 6: Billing: Invoice vendor for media services (distinct from product rebates W27)
Responsible (R): Finance
Accountable (A): Controller
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W153_Flow22</bpmn:incoming>
        <bpmn:outgoing>W153_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W153_End14" name="Complete">
        <bpmn:incoming>W153_Flow23</bpmn:incoming>
      </bpmn:endEvent>
