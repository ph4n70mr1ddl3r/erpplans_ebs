        <bpmn:flowNodeRef>W151_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W151_Lane4" name="CSR Manager">
        <bpmn:flowNodeRef>W151_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W151_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W151_Start6" name="Completion of CSR event (W135) or annual ESG reporting cycle">
        <bpmn:outgoing>W151_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W151_Task7" name="Data Collection">
        <bpmn:documentation>Step 1: Data Collection: Gather quantitative data: number of beneficiaries, tons of waste diverted, trees planted, scholarship hours funded
Responsible (R): CSR Team
Accountable (A): CSR Manager
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W151_Flow14</bpmn:incoming>
        <bpmn:outgoing>W151_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W151_Task8" name="Financial Reconciliation">
        <bpmn:documentation>Step 2: Financial Reconciliation: Match actual CSR spend against budget and donations collected from customers
Responsible (R): Finance
Accountable (A): Controller
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W151_Flow15</bpmn:incoming>
        <bpmn:outgoing>W151_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W151_Task9" name="Qualitative Stories">
        <bpmn:documentation>Step 3: Qualitative Stories: Interview beneficiaries and employee volunteers for &quot;impact stories&quot;
Responsible (R): Marketing / CSR
Accountable (A): CMO
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W151_Flow16</bpmn:incoming>
        <bpmn:outgoing>W151_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W151_Task10" name="Impact Report">
        <bpmn:documentation>Step 4: Impact Report: Produce &quot;BuildRight Impact&quot; dashboard; integrate into Annual ESG Report (W114)
Responsible (R): CSR Manager
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W151_Flow17</bpmn:incoming>
        <bpmn:outgoing>W151_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W151_End11" name="Complete">
        <bpmn:incoming>W151_Flow18</bpmn:incoming>
      </bpmn:endEvent>
