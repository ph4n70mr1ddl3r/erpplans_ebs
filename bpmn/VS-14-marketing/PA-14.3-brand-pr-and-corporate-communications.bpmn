<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-14.3-brand-pr-and-corporate-communications" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W134" name="W134. Crisis Communication &amp; Brand Reputation Management" isExecutable="false">
      <bpmn:documentation>Trigger: Brand crisis (e.g., major safety issue, viral complaint, legal scandal)
Frequency: Ad-hoc
Volume: ~1–2 major crises managed per year
Owner: CMO / Public Relations (PR) Manager
Participants: CEO, Legal (W125), HR, Store Ops (if applicable)
Source: workflow W134 — Crisis Communication &amp; Brand Reputation Management</bpmn:documentation>
      <bpmn:laneSet id="W134_LaneSet4">
        <bpmn:lane id="W134_Lane1" name="PR Manager">
        <bpmn:flowNodeRef>W134_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W134_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W134_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W134_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W134_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W134_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W134_Lane2" name="CMO">
        <bpmn:flowNodeRef>W134_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W134_Lane3" name="Dept Head">
        <bpmn:flowNodeRef>W134_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W134_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W134_Start5" name="Brand crisis (e.g., major safety issue, viral complaint, legal scandal)">
        <bpmn:outgoing>W134_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W134_Task6" name="Alert &amp; Verification: Identify and verify the scale of the crisis">
        <bpmn:documentation>Step 1: Alert &amp; Verification: Identify and verify the scale of the crisis
Responsible (R): PR Manager
Accountable (A): CMO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W134_Flow16</bpmn:incoming>
        <bpmn:outgoing>W134_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W134_Task7" name="Crisis Team Activation: Convene CEO, Legal, CMO, and relevant Dept Head">
        <bpmn:documentation>Step 2: Crisis Team Activation: Convene CEO, Legal, CMO, and relevant Dept Head
Responsible (R): CMO
Accountable (A): CEO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W134_Flow17</bpmn:incoming>
        <bpmn:outgoing>W134_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W134_Task8" name="Fact Finding: Gather details and internal reports on the incident">
        <bpmn:documentation>Step 3: Fact Finding: Gather details and internal reports on the incident
Responsible (R): Dept Head
Accountable (A): CEO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W134_Flow18</bpmn:incoming>
        <bpmn:outgoing>W134_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W134_Task9" name="Messaging: Develop official statement and FAQ for press/social media">
        <bpmn:documentation>Step 4: Messaging: Develop official statement and FAQ for press/social media
Responsible (R): PR Manager
Accountable (A): CEO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W134_Flow19</bpmn:incoming>
        <bpmn:outgoing>W134_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W134_Task10" name="Channel Execution: Release statement via PR wires, website, and social media">
        <bpmn:documentation>Step 5: Channel Execution: Release statement via PR wires, website, and social media
Responsible (R): PR Manager
Accountable (A): CMO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W134_Flow20</bpmn:incoming>
        <bpmn:outgoing>W134_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W134_Task11" name="Monitoring: Track sentiment and response; adjust messaging as needed">
        <bpmn:documentation>Step 6: Monitoring: Track sentiment and response; adjust messaging as needed
Responsible (R): PR Manager
Accountable (A): CMO
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W134_Flow21</bpmn:incoming>
        <bpmn:outgoing>W134_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W134_Task12" name="Post-Crisis Review: Document impact and update crisis protocol">
        <bpmn:documentation>Step 7: Post-Crisis Review: Document impact and update crisis protocol
Responsible (R): PR Manager
Accountable (A): CMO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W134_Flow22</bpmn:incoming>
        <bpmn:outgoing>W134_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W134_End13" name="Complete">
        <bpmn:incoming>W134_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W134_Annotation14">
        <bpmn:text>Controls: - CTL-283 (ensure controlled execution — Brand, PR &amp; Corporate Communications (PA-14.3).) | - operational: CMO / Public Relations (PR) Manager review and approval gate
Owner: CMO / Public Relations (PR) Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W134_Assoc15" sourceRef="W134_Annotation14" targetRef="W134_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W134_Flow16" sourceRef="W134_Start5" targetRef="W134_Task6" />
