    <bpmn:process id="W_W135" name="W135. CSR Program Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Annual CSR calendar or emergency request (e.g., typhoon relief)
Frequency: Periodic; ~4–6 major projects/year
Volume: Budget PHP 20M–100M annually (~0.5–2% of net profit per VS-152.1)
Owner: CSR Coordinator (within Marketing)
Participants: Marketing, Finance, Store Managers (local execution)
Source: workflow W135 — CSR Program Execution</bpmn:documentation>
      <bpmn:laneSet id="W135_LaneSet5">
        <bpmn:lane id="W135_Lane1" name="CSR Coord">
        <bpmn:flowNodeRef>W135_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W135_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W135_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W135_Lane2" name="Buyer">
        <bpmn:flowNodeRef>W135_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W135_Lane3" name="Store Staff">
        <bpmn:flowNodeRef>W135_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W135_Lane4" name="PR Manager">
        <bpmn:flowNodeRef>W135_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W135_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W135_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W135_Start6" name="Annual CSR calendar or emergency request (e.g., typhoon relief)">
        <bpmn:outgoing>W135_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W135_Task7" name="Project Selection: Identify beneficiary communities or NGOs">
        <bpmn:documentation>Step 1: Project Selection: Identify beneficiary communities or NGOs
Responsible (R): CSR Coord
Accountable (A): CMO
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W135_Flow16</bpmn:incoming>
        <bpmn:outgoing>W135_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W135_Task8" name="Budget Approval: Finalize project scope and fund allocation (W21)">
        <bpmn:documentation>Step 2: Budget Approval: Finalize project scope and fund allocation (W21)
Responsible (R): CSR Coord
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W135_Flow17</bpmn:incoming>
        <bpmn:outgoing>W135_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W135_Task9" name="Procurement: Source materials (lumber, tools, supplies) at cost from stores">
        <bpmn:documentation>Step 3: Procurement: Source materials (lumber, tools, supplies) at cost from stores
Responsible (R): Buyer
Accountable (A): CSR Coord
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W135_Flow18</bpmn:incoming>
        <bpmn:outgoing>W135_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W135_Task10" name="Implementation: Execute event (e.g., building a community center, relief…">
        <bpmn:documentation>Step 4: Implementation: Execute event (e.g., building a community center, relief distribution)
Responsible (R): Store Staff
Accountable (A): CSR Coord
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W135_Flow19</bpmn:incoming>
        <bpmn:outgoing>W135_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W135_Task11" name="Documentation: Capture photos/videos and prepare impact report">
        <bpmn:documentation>Step 5: Documentation: Capture photos/videos and prepare impact report
Responsible (R): PR Manager
Accountable (A): CMO
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W135_Flow20</bpmn:incoming>
        <bpmn:outgoing>W135_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W135_Task12" name="Publicity: Share CSR stories on social media and annual report (W114)">
        <bpmn:documentation>Step 6: Publicity: Share CSR stories on social media and annual report (W114)
Responsible (R): PR Manager
Accountable (A): CMO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W135_Flow21</bpmn:incoming>
        <bpmn:outgoing>W135_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W135_End13" name="Complete">
        <bpmn:incoming>W135_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W135_Annotation14">
        <bpmn:text>Controls: - CTL-283 (ensure controlled execution — Brand, PR &amp; Corporate Communications (PA-14.3).) | - operational: CSR Coordinator (within Marketing) review and approval gate
Owner: CSR Coordinator (within Marketing)</bpmn:text>
      </bpmn:textAnnotation>
