    <bpmn:process id="W_W286" name="W286. Retail Media Network (RMN) Vendor Billing &amp; Yield Management" isExecutable="false">
      <bpmn:documentation>Trigger: End of month billing cycle for vendors who purchased ad space (digital screens, e-commerce banners, physical endcaps) in the retailer&#x27;s network.
Frequency: Monthly
Volume: ~20–30 vendor invoices per month (per W153&#x27;s participating-vendor count)
Owner: Marketing Finance / RMN Director
Participants: Vendors/Brands, Marketing, AR, Sales Ops
Source: workflow W286 — Retail Media Network (RMN) Vendor Billing &amp; Yield Management</bpmn:documentation>
      <bpmn:laneSet id="W286_LaneSet4">
        <bpmn:lane id="W286_Lane1" name="Marketing Finance">
        <bpmn:flowNodeRef>W286_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W286_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W286_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W286_Lane2" name="RMN Platform Admin">
        <bpmn:flowNodeRef>W286_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W286_Lane3" name="Sales Ops">
        <bpmn:flowNodeRef>W286_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W286_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W286_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W286_Start5" name="End of month billing cycle for vendors who purchased ad space (digital screens…">
        <bpmn:outgoing>W286_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W286_Task6" name="RMN platform aggregates impression data, click-through rates, or physical…">
        <bpmn:documentation>Step 1: RMN platform aggregates impression data, click-through rates, or physical placement durations for the month; Marketing Finance validates data completeness against ad placement schedule.
Responsible (R): Marketing Finance
Accountable (A): RMN Platform Admin
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W286_Flow14</bpmn:incoming>
        <bpmn:outgoing>W286_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W286_Task7" name="System calculates the yield and total cost owed by the vendor based on their…">
        <bpmn:documentation>Step 2: System calculates the yield and total cost owed by the vendor based on their media contract; RMN Platform Admin reviews calculations for anomalies (zero-impression placements, CPM spikes, contract term mismatches).
Responsible (R): RMN Platform Admin
Accountable (A): Marketing Finance
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W286_Flow15</bpmn:incoming>
        <bpmn:outgoing>W286_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W286_Task8" name="ERP auto-generates a sales invoice to the vendor for the advertising services…">
        <bpmn:documentation>Step 3: ERP auto-generates a sales invoice to the vendor for the advertising services rendered — OM/AR AutoInvoice on the vendor&#x27;s TCA account (or an AP debit memo offsetting the supplier balance where the vendor is also a supplier); Sales Ops reviews invoice details and routes to AR for processing; PFRS 15 revenue schedules ride AR Revenue Management where the media contract bundles placements over the contract term.
Responsible (R): Sales Ops
Accountable (A): Marketing Finance
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W286_Flow16</bpmn:incoming>
        <bpmn:outgoing>W286_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W286_Task9" name="Vendor receives a performance dashboard alongside the invoice; Sales Ops fields…">
        <bpmn:documentation>Step 4: Vendor receives a performance dashboard alongside the invoice; Sales Ops fields vendor inquiries on impression metrics and provides supporting data for disputed line items.
Responsible (R): Sales Ops
Accountable (A): RMN Director
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W286_Flow17</bpmn:incoming>
        <bpmn:outgoing>W286_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W286_Task10" name="Finance monitors collection and recognizes the high-margin RMN revenue; AR…">
        <bpmn:documentation>Step 5: Finance monitors collection and recognizes the high-margin RMN revenue; AR tracks aging and escalates overdue invoices beyond 30 days.
Responsible (R): Marketing Finance
Accountable (A): Controller
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W286_Flow18</bpmn:incoming>
        <bpmn:outgoing>W286_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W286_End11" name="Complete">
        <bpmn:incoming>W286_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W286_Annotation12">
        <bpmn:text>Controls: - CTL-283 (ensure controlled execution — Brand, PR &amp; Corporate Communications (PA-14.3).) | - operational: Marketing Finance / RMN Director review and approval gate
Owner: Marketing Finance / RMN Director</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W286_Assoc13" sourceRef="W286_Annotation12" targetRef="W286_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W286_Flow14" sourceRef="W286_Start5" targetRef="W286_Task6" />
      <bpmn:sequenceFlow id="W286_Flow15" sourceRef="W286_Task6" targetRef="W286_Task7" />
      <bpmn:sequenceFlow id="W286_Flow16" sourceRef="W286_Task7" targetRef="W286_Task8" />
      <bpmn:sequenceFlow id="W286_Flow17" sourceRef="W286_Task8" targetRef="W286_Task9" />
      <bpmn:sequenceFlow id="W286_Flow18" sourceRef="W286_Task9" targetRef="W286_Task10" />
      <bpmn:sequenceFlow id="W286_Flow19" sourceRef="W286_Task10" targetRef="W286_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W286_diag">
      <bpmndi:BPMNPlane id="W286_plane" bpmnElement="W_W286">
        <bpmndi:BPMNShape id="W286_Lane1_di" bpmnElement="W286_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W286_Lane2_di" bpmnElement="W286_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W286_Lane3_di" bpmnElement="W286_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W286_Task6_di" bpmnElement="W286_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W286_Task7_di" bpmnElement="W286_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W286_Task8_di" bpmnElement="W286_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W286_Task9_di" bpmnElement="W286_Task9"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W286_Task10_di" bpmnElement="W286_Task10"><dc:Bounds x="1240" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W286_Start5_di" bpmnElement="W286_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W286_End11_di" bpmnElement="W286_End11"><dc:Bounds x="1470" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W286_Annotation12_di" bpmnElement="W286_Annotation12"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W286_Flow14_di" bpmnElement="W286_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W286_Flow15_di" bpmnElement="W286_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W286_Flow16_di" bpmnElement="W286_Flow16"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W286_Flow17_di" bpmnElement="W286_Flow17"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W286_Flow18_di" bpmnElement="W286_Flow18"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W286_Flow19_di" bpmnElement="W286_Flow19"><di:waypoint x="1420" y="165" /><di:waypoint x="1470" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W286_Assoc13_di" bpmnElement="W286_Assoc13"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W833" name="W833. Marketing Campaign Compliance Review &amp; Regulatory Approval" isExecutable="false">
      <bpmn:documentation>Trigger: Marketing campaign creative and copy completed per W83; ready for launch
Frequency: Bi-monthly for major campaigns; weekly for digital campaigns
Volume: ~6 major catalog campaigns/year + ~50 digital/social media campaigns/month requiring compliance review
Owner: Marketing Manager
Participants: Marketing Manager, Legal Counsel, Compliance Officer, Brand Manager, External Agency
Source: workflow W833 — Marketing Campaign Compliance Review &amp; Regulatory Approval</bpmn:documentation>
      <bpmn:laneSet id="W833_LaneSet4">
        <bpmn:lane id="W833_Lane1" name="Marketing Manager">
        <bpmn:flowNodeRef>W833_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W833_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W833_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W833_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W833_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W833_Lane2" name="Legal Counsel">
        <bpmn:flowNodeRef>W833_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W833_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W833_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W833_Lane3" name="Compliance Officer">
        <bpmn:flowNodeRef>W833_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W833_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W833_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W833_Start5" name="Marketing campaign creative and copy completed per W83; ready for launch">
        <bpmn:outgoing>W833_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W833_Task6" name="Marketing Manager submits completed campaign materials">
        <bpmn:documentation>Step 1: Marketing Manager submits completed campaign materials for compliance review: creative assets, copy, landing pages, social media posts, in-store signage, promotional mechanics
Responsible (R): Marketing Manager
Accountable (A): —
Duration: 15-30 min</bpmn:documentation>
        <bpmn:incoming>W833_Flow18</bpmn:incoming>
        <bpmn:outgoing>W833_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W833_Task7" name="Legal Counsel reviews">
        <bpmn:documentation>Step 2: Legal Counsel reviews: (a) advertising claims accuracy and substantiation, (b) promotional mechanics compliance (raffle, contest, giveaway rules per DTI guidelines), (c) terms and conditions completeness, (d) intellectual property clearance (images, music, fonts per W126 IP management), (e) data privacy consent wording per W834 RA 10173
Responsible (R): Legal Counsel
Accountable (A): —
Duration: 2-4 hours</bpmn:documentation>
        <bpmn:incoming>W833_Flow19</bpmn:incoming>
        <bpmn:outgoing>W833_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W833_Task8" name="Compliance Officer reviews">
        <bpmn:documentation>Step 3: Compliance Officer reviews: (a) DTI Sales Promotion Permit secured per W427, (b) price accuracy vs. ERP pricing master per W289, (c) Senior Citizen/PWD discount applicability per W170, (d) product safety claims per W185 product liability, (e) environmental claims substantiation per W114 sustainability compliance, (f) competitor comparison accuracy per W130 competitor intelligence
Responsible (R): Compliance Officer
Accountable (A): —
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W833_Flow20</bpmn:incoming>
        <bpmn:outgoing>W833_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W833_Task9" name="If campaign involves bank partnership">
        <bpmn:documentation>Step 4: If campaign involves bank partnership: Legal verifies BSP compliance per W149 bank partnerships
Responsible (R): Legal Counsel
Accountable (A): —
Duration: 30-60 min</bpmn:documentation>
        <bpmn:incoming>W833_Flow21</bpmn:incoming>
        <bpmn:outgoing>W833_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W833_Task10" name="Marketing Manager addresses review feedback">
        <bpmn:documentation>Step 5: Marketing Manager addresses review feedback and resubmits if required
Responsible (R): Marketing Manager
Accountable (A): —
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W833_Flow22</bpmn:incoming>
        <bpmn:outgoing>W833_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W833_Task11" name="Legal Counsel and Compliance Officer approve">
        <bpmn:documentation>Step 6: Legal Counsel and Compliance Officer approve via digital sign-off per W686 document approval routing — the sign-off captured as ERES evidence on the compliance record and routed by position hierarchy (the reviewing Legal Counsel and Compliance Officer approve; the submitting Marketing Manager can never approve their own submission)
Responsible (R): Legal Counsel / Compliance Officer
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W833_Flow23</bpmn:incoming>
        <bpmn:outgoing>W833_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W833_Task12" name="Campaign cleared for launch">
        <bpmn:documentation>Step 7: Campaign cleared for launch per W83 execution timeline
Responsible (R): Marketing Manager
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W833_Flow24</bpmn:incoming>
        <bpmn:outgoing>W833_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W833_Task13" name="During campaign">
        <bpmn:documentation>Step 8: During campaign: Compliance monitors for consumer complaints related to advertising per W41; escalates to Legal if issues arise
Responsible (R): Compliance Officer
Accountable (A): Legal Counsel
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W833_Flow25</bpmn:incoming>
        <bpmn:outgoing>W833_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W833_Task14" name="Post-campaign">
        <bpmn:documentation>Step 9: Post-campaign: compliance review retrospect included in W565 campaign ROI analysis — any regulatory issues documented for future prevention
Responsible (R): Marketing Manager
Accountable (A): Legal Counsel
Duration: 30-60 min</bpmn:documentation>
        <bpmn:incoming>W833_Flow26</bpmn:incoming>
        <bpmn:outgoing>W833_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W833_End15" name="Complete">
        <bpmn:incoming>W833_Flow27</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W833_Annotation16">
        <bpmn:text>Controls: - CTL-283 (ensure controlled execution — Brand, PR &amp; Corporate Communications (PA-14.3).) | - operational: Marketing Manager review and approval gate
Owner: Marketing Manager</bpmn:text>
      </bpmn:textAnnotation>
