        </bpmn:lane>
        <bpmn:lane id="W189_Lane2" name="System">
        <bpmn:flowNodeRef>W189_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W189_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W189_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W189_Lane3" name="Analytics">
        <bpmn:flowNodeRef>W189_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W189_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W189_Start5" name="Launch of referral campaign or onboarding of new Brand Ambassador">
        <bpmn:outgoing>W189_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W189_Task6" name="Program Setup">
        <bpmn:documentation>Step 1: Program Setup: Define referral rewards (e.g., PHP 500 voucher for both referrer and referee)
Responsible (R): Loyalty Mgr
Accountable (A): CMO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W189_Flow16</bpmn:incoming>
        <bpmn:outgoing>W189_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W189_Task7" name="Link Generation">
        <bpmn:documentation>Step 2: Link Generation: System generates unique referral codes/links for all loyalty members (W17)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W189_Flow17</bpmn:incoming>
        <bpmn:outgoing>W189_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W189_Task8" name="Ambassador Onboarding">
        <bpmn:documentation>Step 3: Ambassador Onboarding: Sign agreements with &quot;Power Referrers&quot; (vetted high-engagement customers)
Responsible (R): Loyalty Mgr
Accountable (A): CMO
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W189_Flow18</bpmn:incoming>
        <bpmn:outgoing>W189_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W189_Task9" name="Referral Tracking">
        <bpmn:documentation>Step 4: Referral Tracking: Referee uses code at POS or online; system validates eligibility (new customer only)
Responsible (R): System
Accountable (A): —
Duration: Real-time</bpmn:documentation>
        <bpmn:incoming>W189_Flow19</bpmn:incoming>
        <bpmn:outgoing>W189_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W189_Task10" name="Reward Fulfillment">
        <bpmn:documentation>Step 5: Reward Fulfillment: System auto-issues vouchers or loyalty points upon successful referee purchase
Responsible (R): System
Accountable (A): —
Duration: Real-time</bpmn:documentation>
        <bpmn:incoming>W189_Flow20</bpmn:incoming>
        <bpmn:outgoing>W189_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W189_Task11" name="Fraud Monitoring">
        <bpmn:documentation>Step 6: Fraud Monitoring: Audit for self-referrals or &quot;referral mills&quot;; block suspicious accounts
Responsible (R): Loyalty Mgr
Accountable (A): —
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W189_Flow21</bpmn:incoming>
        <bpmn:outgoing>W189_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W189_Task12" name="Performance Analysis">
        <bpmn:documentation>Step 7: Performance Analysis: Calculate Customer Acquisition Cost (CAC) via referral vs. other channels
Responsible (R): Analytics
Accountable (A): CMO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W189_Flow22</bpmn:incoming>
        <bpmn:outgoing>W189_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W189_End13" name="Complete">
        <bpmn:incoming>W189_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W189_Annotation14">
        <bpmn:text>Controls: - CTL-283 (ensure controlled execution — Brand, PR &amp; Corporate Communications (PA-14.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Loyalty Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W189_Assoc15" sourceRef="W189_Annotation14" targetRef="W189_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W189_Flow16" sourceRef="W189_Start5" targetRef="W189_Task6" />
