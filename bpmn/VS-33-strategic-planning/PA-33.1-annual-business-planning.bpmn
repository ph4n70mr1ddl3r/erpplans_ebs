    <bpmn:process id="W_W1651" name="W1651. Mid-Year Budget Review &amp; Recalibration" isExecutable="false">
      <bpmn:documentation>Trigger: Mid-year (June/July) or significant variance from budget
Frequency: Semi-annual (mid-year mandatory; ad-hoc as needed)
Volume: 1 comprehensive review
Owner: CFO
Participants: CFO, FP&amp;A, C-Suite, department heads
Source: workflow W1651 — Mid-Year Budget Review &amp; Recalibration</bpmn:documentation>
      <bpmn:laneSet id="W1651_LaneSet3">
        <bpmn:lane id="W1651_Lane1" name="FP&amp;A">
        <bpmn:flowNodeRef>W1651_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1651_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1651_Lane2" name="CFO">
        <bpmn:flowNodeRef>W1651_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1651_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1651_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1651_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1651_Start4" name="Mid-year (June/July) or significant variance from budget">
        <bpmn:outgoing>W1651_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1651_Task5" name="FP&amp;A prepares mid-year variance analysis: (a) actual vs. budget for H1 by…">
        <bpmn:documentation>Step 1: FP&amp;A prepares mid-year variance analysis: (a) actual vs. budget for H1 by entity, department, store cluster, (b) forecast for H2 based on H1 actuals and known changes, (c) full-year revised forecast vs. original budget, (d) variance drivers (volume, price, mix, timing, one-time items)
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1651_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1651_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1651_Task6" name="CFO reviews with each C-Suite member: (a) identify areas requiring corrective…">
        <bpmn:documentation>Step 2: CFO reviews with each C-Suite member: (a) identify areas requiring corrective action (cost overruns, revenue shortfalls), (b) identify opportunities to reallocate budget from underperforming to overperforming areas, (c) assess if strategic priorities need recalibration based on H1 results
Responsible (R): CFO
Accountable (A): CEO
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W1651_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1651_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1651_Task7" name="If recalibration needed: (a) FP&amp;A prepares revised full-year forecast, (b)…">
        <bpmn:documentation>Step 3: If recalibration needed: (a) FP&amp;A prepares revised full-year forecast, (b) specific budget reallocations documented and approved, (c) revised forecast communicated to department heads and Store Managers
Responsible (R): CFO / FP&amp;A
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1651_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1651_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1651_Task8" name="Board communication: CFO presents mid-year results and revised forecast to…">
        <bpmn:documentation>Step 4: Board communication: CFO presents mid-year results and revised forecast to Board at next scheduled meeting
Responsible (R): CFO
Accountable (A): Board
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W1651_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1651_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1651_End9" name="Complete">
        <bpmn:incoming>W1651_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1651_Annotation10">
        <bpmn:text>Controls: - CTL-230 (ensure strategy-to-budget alignment.) | - operational: CFO review and approval gate
Owner: CFO</bpmn:text>
      </bpmn:textAnnotation>
