    <bpmn:process id="W_W1652" name="W1652. New Store Financial Model &amp; Pre-Opening Budget Planning" isExecutable="false">
      <bpmn:documentation>Trigger: New store site approved per W20.1 (Site Selection &amp; Lease Management)
Frequency: ~10–15 new stores/year
Volume: 1 financial model per new store
Owner: FP&amp;A
Participants: FP&amp;A, VP Store Operations, COO, CFO
Source: workflow W1652 — New Store Financial Model &amp; Pre-Opening Budget Planning</bpmn:documentation>
      <bpmn:laneSet id="W1652_LaneSet3">
        <bpmn:lane id="W1652_Lane1" name="FP&amp;A">
        <bpmn:flowNodeRef>W1652_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1652_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1652_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1652_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1652_Lane2" name="CFO">
        <bpmn:flowNodeRef>W1652_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1652_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1652_Start4" name="New store site approved per W20.1 (Site Selection &amp; Lease Management)">
        <bpmn:outgoing>W1652_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1652_Task5" name="FP&amp;A builds new store financial model: (a) revenue projection by category…">
        <bpmn:documentation>Step 1: FP&amp;A builds new store financial model: (a) revenue projection by category (based on trade area demographics, competitive analysis, comparable store performance), (b) 5-year revenue ramp: Year 1 (70% of mature), Year 2 (85%), Year 3 (95%), Year 4+ (100%), (c) gross margin projection by category, (d) operating cost projection (rent, utilities, payroll for 29 staff, maintenance, supplies), (e) capex: construction, fixtures, equipment, POS, initial inventory, (f) working capital: initial stock investment, cash float
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: 4 hours/store</bpmn:documentation>
        <bpmn:incoming>W1652_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1652_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1652_Task6" name="Financial returns: (a) store-level IRR and NPV over 10-year lease period, (b)…">
        <bpmn:documentation>Step 2: Financial returns: (a) store-level IRR and NPV over 10-year lease period, (b) payback period (target: &lt; 3 years), (c) EBITDA contribution at maturity, (d) sensitivity analysis: revenue -10%/+10%, rent escalation, wage increase
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: 2 hours/store</bpmn:documentation>
        <bpmn:incoming>W1652_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1652_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1652_Task7" name="CFO reviews and approves financial model; if returns meet threshold (IRR &gt; 15%…">
        <bpmn:documentation>Step 3: CFO reviews and approves financial model; if returns meet threshold (IRR &gt; 15%, payback &lt; 3 years): proceed to construction per W20.2; if returns below threshold: COO renegotiates lease terms or site is rejected
Responsible (R): CFO
Accountable (A): CEO
Duration: 1 hour/store</bpmn:documentation>
        <bpmn:incoming>W1652_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1652_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1652_Task8" name="Pre-opening budget: FP&amp;A tracks cumulative pre-opening costs (construction…">
        <bpmn:documentation>Step 4: Pre-opening budget: FP&amp;A tracks cumulative pre-opening costs (construction, initial inventory, staff hiring/training, marketing/grand opening); pre-opening costs capitalized per PFRS and amortized over lease term
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: Ongoing through opening</bpmn:documentation>
        <bpmn:incoming>W1652_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1652_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1652_End9" name="Complete">
        <bpmn:incoming>W1652_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1652_Annotation10">
        <bpmn:text>Controls: - CTL-340 (ensure controlled execution — Annual Business Planning &amp; Budgeting (PA-33.1).) | - operational: FP&amp;A review and approval gate
Owner: FP&amp;A</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1652_Assoc11" sourceRef="W1652_Annotation10" targetRef="W1652_Start4" associationDirection="None" />
