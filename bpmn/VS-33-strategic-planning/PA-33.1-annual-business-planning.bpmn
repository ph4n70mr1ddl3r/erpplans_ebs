<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-33.1-annual-business-planning" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1645" name="W1645. Annual Strategic Planning Workshop &amp; Strategy Refresh" isExecutable="false">
      <bpmn:documentation>Trigger: Annual strategic planning cycle (Q4 for following year)
Frequency: Annual (2-day offsite workshop) + quarterly strategy check-ins
Volume: 1 comprehensive annual cycle
Owner: CEO
Participants: CEO, CFO, COO, CIO, CMO, CHRO, VP Legal, VP Supply Chain, Strategy Analyst
Source: workflow W1645 — Annual Strategic Planning Workshop &amp; Strategy Refresh</bpmn:documentation>
      <bpmn:laneSet id="W1645_LaneSet3">
        <bpmn:lane id="W1645_Lane1" name="CEO">
        <bpmn:flowNodeRef>W1645_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1645_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1645_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1645_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1645_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1645_Lane2" name="C-Suite">
        <bpmn:flowNodeRef>W1645_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1645_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1645_Start4" name="Annual strategic planning cycle (Q4 for following year)">
        <bpmn:outgoing>W1645_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1645_Task5" name="CEO initiates annual strategic planning cycle (October): (a) distributes…">
        <bpmn:documentation>Step 1: CEO initiates annual strategic planning cycle (October): (a) distributes strategy discussion paper covering: (i) current year performance vs. plan, (ii) market trends (Philippine retail, construction industry, consumer behavior), (iii) competitive landscape update, (iv) SWOT refresh, (v) strategic questions for discussion
Responsible (R): CEO
Accountable (A): —
Duration: 1 week prep</bpmn:documentation>
        <bpmn:incoming>W1645_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1645_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1645_Task6" name="C-Suite prepares departmental strategy inputs: (a) COO — store expansion…">
        <bpmn:documentation>Step 2: C-Suite prepares departmental strategy inputs: (a) COO — store expansion pipeline, operational efficiency initiatives, supply chain strategy, (b) CFO — financial performance analysis, capital allocation priorities, profitability improvement opportunities, (c) CMO — market positioning, ecommerce growth strategy, customer insights, (d) CIO — technology roadmap, digital transformation priorities, cybersecurity posture, (e) CHRO — organizational development, talent strategy, culture initiatives, (f) VP Supply Chain — supply chain resilience, vendor diversification, logistics optimization
Responsible (R): C-Suite
Accountable (A): CEO
Duration: 2 weeks prep</bpmn:documentation>
        <bpmn:incoming>W1645_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1645_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1645_Task7" name="2-day strategic planning workshop (offsite): (a) Day 1 — review current year…">
        <bpmn:documentation>Step 3: 2-day strategic planning workshop (offsite): (a) Day 1 — review current year performance; discuss market outlook; identify strategic themes for next 3 years; competitive analysis, (b) Day 2 — define next year strategic priorities (3–5 themes); set top-level financial targets (revenue, EBITDA margin, store count, ecommerce penetration); identify major initiatives and owners; agree on resource allocation principles
Responsible (R): CEO / C-Suite
Accountable (A): CEO
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W1645_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1645_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1645_Task8" name="CEO synthesizes workshop outcomes into Strategic Priorities Document: (a)…">
        <bpmn:documentation>Step 4: CEO synthesizes workshop outcomes into Strategic Priorities Document: (a) strategic themes with measurable objectives, (b) top-level financial targets, (c) major initiatives with owners and timelines, (d) resource allocation framework (new stores vs. existing store improvement vs. technology vs. people)
Responsible (R): CEO
Accountable (A): Board
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1645_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1645_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1645_Task9" name="Strategic Priorities Document presented to Board for alignment; Board provides…">
        <bpmn:documentation>Step 5: Strategic Priorities Document presented to Board for alignment; Board provides feedback and approval; approved priorities cascade to annual budget process (W1646)
Responsible (R): CEO
Accountable (A): Board
Duration: 2 hours (Board meeting)</bpmn:documentation>
        <bpmn:incoming>W1645_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1645_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1645_End10" name="Complete">
        <bpmn:incoming>W1645_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1645_Annotation11">
        <bpmn:text>Controls: - CTL-340 (ensure controlled execution — Annual Business Planning &amp; Budgeting (PA-33.1).) | - operational: CEO review and approval gate
Owner: CEO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1645_Assoc12" sourceRef="W1645_Annotation11" targetRef="W1645_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1645_Flow13" sourceRef="W1645_Start4" targetRef="W1645_Task5" />
      <bpmn:sequenceFlow id="W1645_Flow14" sourceRef="W1645_Task5" targetRef="W1645_Task6" />
      <bpmn:sequenceFlow id="W1645_Flow15" sourceRef="W1645_Task6" targetRef="W1645_Task7" />
      <bpmn:sequenceFlow id="W1645_Flow16" sourceRef="W1645_Task7" targetRef="W1645_Task8" />
      <bpmn:sequenceFlow id="W1645_Flow17" sourceRef="W1645_Task8" targetRef="W1645_Task9" />
      <bpmn:sequenceFlow id="W1645_Flow18" sourceRef="W1645_Task9" targetRef="W1645_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1645_diag">
      <bpmndi:BPMNPlane id="W1645_plane" bpmnElement="W_W1645">
        <bpmndi:BPMNShape id="W1645_Lane1_di" bpmnElement="W1645_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
