    <bpmn:process id="W_W1662" name="W1662. Market &amp; Industry Trend Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Ongoing monitoring cycle
Frequency: Weekly scan; quarterly deep-dive analysis
Volume: Continuous
Owner: CMO
Participants: CMO, Category Managers, FP&amp;A, CEO
Source: workflow W1662 — Market &amp; Industry Trend Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W1662_LaneSet3">
        <bpmn:lane id="W1662_Lane1" name="CMO">
        <bpmn:flowNodeRef>W1662_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1662_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1662_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1662_Lane2" name="Category Managers">
        <bpmn:flowNodeRef>W1662_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1662_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1662_Start4" name="Ongoing monitoring cycle">
        <bpmn:outgoing>W1662_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1662_Task5" name="CMO monitors Philippine market trends weekly: (a) construction industry data…">
        <bpmn:documentation>Step 1: CMO monitors Philippine market trends weekly: (a) construction industry data (Philippine Statistics Authority building permits, construction spending), (b) real estate development pipeline (property portals, developer announcements), (c) retail industry reports (Philippine Retailers Association, Euromonitor, Nielsen), (d) consumer spending trends (BSP consumer expectations survey), (e) government infrastructure projects (DPWH, Build Build Build program updates), (f) remittance trends (overseas Filipino workers — drives home construction spending in provinces)
Responsible (R): CMO
Accountable (A): —
Duration: 2 hours/week</bpmn:documentation>
        <bpmn:incoming>W1662_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1662_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1662_Task6" name="Category Managers monitor product-specific trends: (a) commodity price trends…">
        <bpmn:documentation>Step 2: Category Managers monitor product-specific trends: (a) commodity price trends (steel, cement, copper — drives pricing strategy), (b) product innovation trends (smart home, sustainable materials, energy-efficient products), (c) import trade data (Philippine customs import statistics for key categories), (d) vendor market intelligence (new vendor products, supply disruptions)
Responsible (R): Category Managers
Accountable (A): VP Merchandising
Duration: 1 hour/week</bpmn:documentation>
        <bpmn:incoming>W1662_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1662_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1662_Task7" name="Quarterly: CMO prepares Market Intelligence Briefing: (a) Philippine macro…">
        <bpmn:documentation>Step 3: Quarterly: CMO prepares Market Intelligence Briefing: (a) Philippine macro outlook (GDP growth, inflation, interest rates, construction sector growth), (b) retail market outlook (consumer confidence, retail sales growth, channel shift), (c) competitive landscape changes (new entrants, market exits, M&amp;A activity), (d) emerging opportunities (product categories, geographic markets, customer segments), (e) emerging threats (economic slowdown, supply chain disruption, regulatory changes), (f) strategic implications and recommendations for BuildRight
Responsible (R): CMO
Accountable (A): CEO
Duration: 4 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1662_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1662_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1662_End8" name="Complete">
        <bpmn:incoming>W1662_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1662_Annotation9">
        <bpmn:text>Controls: - CTL-342 (ensure controlled execution — Competitive Intelligence &amp; Market Analysis (PA-33.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: CMO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1662_Assoc10" sourceRef="W1662_Annotation9" targetRef="W1662_Start4" associationDirection="None" />
