    <bpmn:process id="W_W1664" name="W1664. Competitive Pricing Intelligence &amp; Benchmarking" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly pricing intelligence cycle
Frequency: Monthly competitive price collection; weekly for key promotional periods
Volume: ~500 benchmark SKUs priced across 5–10 competitor stores
Owner: Pricing Analyst
Participants: Pricing Analysts, Category Managers, FP&amp;A Analyst, VP Merchandising
Source: workflow W1664 — Competitive Pricing Intelligence &amp; Benchmarking</bpmn:documentation>
      <bpmn:laneSet id="W1664_LaneSet4">
        <bpmn:lane id="W1664_Lane1" name="Pricing Analysts">
        <bpmn:flowNodeRef>W1664_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1664_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1664_Lane2" name="FP&amp;A">
        <bpmn:flowNodeRef>W1664_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1664_Lane3" name="Pricing Analyst">
        <bpmn:flowNodeRef>W1664_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1664_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1664_Start5" name="Monthly pricing intelligence cycle">
        <bpmn:outgoing>W1664_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1664_Task6" name="Pricing Analysts consolidate the weekly W2214 competitor-price feed…">
        <bpmn:documentation>Step 1: Pricing Analysts consolidate the weekly W2214 competitor-price feed (web-scraped, mystery-shop, and third-party prices) and run the monthly benchmark deep-dive: (a) in-store visits (5–10 competitor store locations of the 4–5 tracked chains, per W2214), (b) competitor websites and marketplaces (Lazada, Shopee for overlapping products), (c) mystery shopping calls for trade/B2B pricing, (d) record prices for ~500 benchmark SKUs (top items by revenue across categories)
Responsible (R): Pricing Analysts
Accountable (A): VP Merchandising
Duration: 2 days/month</bpmn:documentation>
        <bpmn:incoming>W1664_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1664_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1664_Task7" name="FP&amp;A calculates competitive price index: (a) BuildRight price vs. competitor…">
        <bpmn:documentation>Step 2: FP&amp;A calculates competitive price index: (a) BuildRight price vs. competitor average price per SKU (BuildRight price ÷ competitor average × 100), (b) index by category, (c) index by store cluster (prices may vary by region for some competitors), (d) price position: BuildRight target = index 95–105 (competitive parity)
Responsible (R): FP&amp;A
Accountable (A): VP Merchandising
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W1664_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1664_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1664_Task8" name="Pricing Analyst flags price outliers: (a) SKUs where BuildRight is &gt; 10% above…">
        <bpmn:documentation>Step 3: Pricing Analyst flags price outliers: (a) SKUs where BuildRight is &gt; 10% above competitor average → Category Manager review for price adjustment or value justification, (b) SKUs where BuildRight is &gt; 10% below competitor average → potential margin improvement opportunity, (c) new competitor promotional pricing → match-or-beat assessment per W40 (Pricing &amp; Promotions)
Responsible (R): Pricing Analyst
Accountable (A): Category Manager
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1664_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1664_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1664_End9" name="Complete">
        <bpmn:incoming>W1664_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1664_Annotation10">
        <bpmn:text>Controls: - CTL-342 (ensure controlled execution — Competitive Intelligence &amp; Market Analysis (PA-33.3).) | - operational: Pricing Analyst review and approval gate
Owner: Pricing Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1664_Assoc11" sourceRef="W1664_Annotation10" targetRef="W1664_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1664_Flow12" sourceRef="W1664_Start5" targetRef="W1664_Task6" />
      <bpmn:sequenceFlow id="W1664_Flow13" sourceRef="W1664_Task6" targetRef="W1664_Task7" />
      <bpmn:sequenceFlow id="W1664_Flow14" sourceRef="W1664_Task7" targetRef="W1664_Task8" />
      <bpmn:sequenceFlow id="W1664_Flow15" sourceRef="W1664_Task8" targetRef="W1664_End9" />
    </bpmn:process>
