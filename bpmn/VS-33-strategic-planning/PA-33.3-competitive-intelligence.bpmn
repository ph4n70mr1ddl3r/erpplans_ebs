    <bpmn:process id="W_W1666" name="W1666. Philippine Retail Regulatory &amp; Policy Impact Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: New legislation, regulatory change, or government policy announcement
Frequency: Ad-hoc (as regulatory changes occur)
Volume: ~5–10 significant regulatory assessments/year
Owner: VP Legal &amp; Compliance
Participants: VP Legal, Compliance Officer, CFO, CIO, CHRO
Source: workflow W1666 — Philippine Retail Regulatory &amp; Policy Impact Assessment</bpmn:documentation>
      <bpmn:laneSet id="W1666_LaneSet3">
        <bpmn:lane id="W1666_Lane1" name="VP Legal">
        <bpmn:flowNodeRef>W1666_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1666_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1666_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1666_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1666_Lane2" name="Department Head">
        <bpmn:flowNodeRef>W1666_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1666_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1666_Start4" name="New legislation, regulatory change, or government policy announcement">
        <bpmn:outgoing>W1666_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1666_Task5" name="VP Legal monitors regulatory landscape: (a) pending legislation affecting…">
        <bpmn:documentation>Step 1: VP Legal monitors regulatory landscape: (a) pending legislation affecting retail (e.g., Retail Trade Liberalization Act amendments, foreign ownership rules), (b) BIR revenue regulations affecting tax compliance (e.g., e-invoicing mandates), (c) DOLE labor regulations (wage orders, employment classification rules), (d) LGU zoning and business permit changes, (e) DTI consumer protection regulations, (f) NPC data privacy regulations and enforcement trends
Responsible (R): VP Legal
Accountable (A): —
Duration: 2 hours/week</bpmn:documentation>
        <bpmn:incoming>W1666_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1666_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1666_Task6" name="For significant regulatory changes: VP Legal prepares impact assessment: (a)…">
        <bpmn:documentation>Step 2: For significant regulatory changes: VP Legal prepares impact assessment: (a) description of change and effective date, (b) affected business areas (which departments, processes, systems), (c) compliance requirements (what needs to change), (d) financial impact (cost of compliance, potential penalties for non-compliance), (e) implementation timeline and resource needs, (f) risk rating (high/medium/low)
Responsible (R): VP Legal
Accountable (A): CEO
Duration: 4 hours/assessment</bpmn:documentation>
        <bpmn:incoming>W1666_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1666_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1666_Task7" name="VP Legal and affected C-Suite member present impact assessment to CEO; agree on…">
        <bpmn:documentation>Step 3: VP Legal and affected C-Suite member present impact assessment to CEO; agree on response: (a) comply — allocate budget and resources for implementation, (b) influence — engage industry association (Philippine Retailers Association) or government consultation to advocate for BuildRight interests, (c) monitor — track regulatory development without immediate action
Responsible (R): VP Legal / C-Suite
Accountable (A): CEO
Duration: 1 hour/assessment</bpmn:documentation>
        <bpmn:incoming>W1666_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1666_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1666_Task8" name="Implementation: affected department head executes compliance plan with Legal…">
        <bpmn:documentation>Step 4: Implementation: affected department head executes compliance plan with Legal oversight; progress tracked per W1660
Responsible (R): Department Head
Accountable (A): C-Suite sponsor
Duration: Per assessment</bpmn:documentation>
        <bpmn:incoming>W1666_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1666_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1666_End9" name="Complete">
        <bpmn:incoming>W1666_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1666_Annotation10">
        <bpmn:text>Controls: - CTL-342 (ensure controlled execution — Competitive Intelligence &amp; Market Analysis (PA-33.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: VP Legal &amp; Compliance</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1666_Assoc11" sourceRef="W1666_Annotation10" targetRef="W1666_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1666_Flow12" sourceRef="W1666_Start4" targetRef="W1666_Task5" />
      <bpmn:sequenceFlow id="W1666_Flow13" sourceRef="W1666_Task5" targetRef="W1666_Task6" />
      <bpmn:sequenceFlow id="W1666_Flow14" sourceRef="W1666_Task6" targetRef="W1666_Task7" />
      <bpmn:sequenceFlow id="W1666_Flow15" sourceRef="W1666_Task7" targetRef="W1666_Task8" />
      <bpmn:sequenceFlow id="W1666_Flow16" sourceRef="W1666_Task8" targetRef="W1666_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1666_diag">
      <bpmndi:BPMNPlane id="W1666_plane" bpmnElement="W_W1666">
        <bpmndi:BPMNShape id="W1666_Lane1_di" bpmnElement="W1666_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
