<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-33.3-competitive-intelligence" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1661" name="W1661. Competitor Store Visit Program &amp; Systematic Data Collection" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly competitor visit calendar; new competitor store opening
Frequency: Quarterly structured visits + ad-hoc visits for new openings
Volume: ~20–30 competitor visits/quarter across key trade areas
Owner: Category Manager (merchandising focus); VP Store Operations (operations focus)
Participants: Category Managers, Regional Managers, Pricing Analysts, Store Managers, Strategy Analyst
Source: workflow W1661 — Competitor Store Visit Program &amp; Systematic Data Collection</bpmn:documentation>
      <bpmn:laneSet id="W1661_LaneSet5">
        <bpmn:lane id="W1661_Lane1" name="VP Store Operations">
        <bpmn:flowNodeRef>W1661_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1661_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1661_Lane2" name="Assigned visitor">
        <bpmn:flowNodeRef>W1661_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1661_Lane3" name="Visitor">
        <bpmn:flowNodeRef>W1661_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1661_Lane4" name="FP&amp;A, Strategy Analyst">
        <bpmn:flowNodeRef>W1661_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1661_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1661_Start6" name="Quarterly competitor visit calendar; new competitor store opening">
        <bpmn:outgoing>W1661_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1661_Task7" name="VP Store Operations and VP Merchandising jointly plan quarterly competitor…">
        <bpmn:documentation>Step 1: VP Store Operations and VP Merchandising jointly plan quarterly competitor visit schedule: (a) prioritize competitors: (i) direct competitors (other hardware/home improvement chains), (ii) indirect competitors (general merchandise retailers with hardware sections, building supply dealers), (iii) emerging competitors (online-first building supply retailers), (b) assign visits to Category Managers, Regional Managers, and Store Managers, (c) provide standardized competitor visit form
Responsible (R): VP Store Operations / VP Merchandising
Accountable (A): —
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1661_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1661_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1661_Task8" name="Merchandising assessment">
        <bpmn:documentation>Step 2: Visitor conducts competitor store visit using standardized form: (a) Merchandising assessment: category breadth/depth, private label presence, new product introductions, display quality, pricing (select 20–30 benchmark SKUs across categories), promotional activity (sale events, bundles), (b) Operations assessment: store layout and flow, staffing levels, checkout speed, customer service quality, store cleanliness, technology (self-checkout, mobile POS), (c) Customer assessment: customer traffic (count 15-min sample), customer demographics observed, customer-employee interactions
Responsible (R): Assigned visitor
Accountable (A): VP Merchandising / VP Store Operations
Duration: 2 hours/visit</bpmn:documentation>
        <bpmn:incoming>W1661_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1661_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1661_Task9" name="Visitor submits completed form to FP&amp;A for compilation; data entered into…">
        <bpmn:documentation>Step 3: Visitor submits completed form to FP&amp;A for compilation; data entered into competitive intelligence database
Responsible (R): Visitor / FP&amp;A
Accountable (A): VP Merchandising
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1661_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1661_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1661_Task10" name="FP&amp;A consolidates visit data into quarterly competitive intelligence report…">
        <bpmn:documentation>Step 4: FP&amp;A consolidates visit data into quarterly competitive intelligence report: (a) pricing comparison (benchmark SKU basket price index vs. BuildRight), (b) assortment comparison (categories where competitors have deeper/broader range), (c) operational benchmarking (staffing, technology adoption), (d) competitive threat assessment by region
Responsible (R): FP&amp;A, Strategy Analyst
Accountable (A): VP Merchandising
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1661_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1661_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1661_End11" name="Complete">
        <bpmn:incoming>W1661_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1661_Annotation12">
        <bpmn:text>Controls: - CTL-342 (ensure controlled execution — Competitive Intelligence &amp; Market Analysis (PA-33.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Category Manager (merchandising focus); VP Store Operations (operations focus)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1661_Assoc13" sourceRef="W1661_Annotation12" targetRef="W1661_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1661_Flow14" sourceRef="W1661_Start6" targetRef="W1661_Task7" />
      <bpmn:sequenceFlow id="W1661_Flow15" sourceRef="W1661_Task7" targetRef="W1661_Task8" />
      <bpmn:sequenceFlow id="W1661_Flow16" sourceRef="W1661_Task8" targetRef="W1661_Task9" />
      <bpmn:sequenceFlow id="W1661_Flow17" sourceRef="W1661_Task9" targetRef="W1661_Task10" />
      <bpmn:sequenceFlow id="W1661_Flow18" sourceRef="W1661_Task10" targetRef="W1661_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1661_diag">
