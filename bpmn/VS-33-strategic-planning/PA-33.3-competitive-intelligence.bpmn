      <bpmn:sequenceFlow id="W1665_Flow15" sourceRef="W1665_Task7" targetRef="W1665_Task8" />
      <bpmn:sequenceFlow id="W1665_Flow16" sourceRef="W1665_Task8" targetRef="W1665_Task9" />
      <bpmn:sequenceFlow id="W1665_Flow17" sourceRef="W1665_Task9" targetRef="W1665_End10" />
    </bpmn:process>
