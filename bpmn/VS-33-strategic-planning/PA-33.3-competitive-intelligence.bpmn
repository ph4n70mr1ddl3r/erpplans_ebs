    <bpmn:process id="W_W1663" name="W1663. Customer Market Research &amp; Segmentation Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Annual research cycle or specific strategic question
Frequency: Annual comprehensive research; quarterly targeted studies
Volume: ~1 major study/year + 2–3 targeted studies
Owner: CMO
Participants: CMO, Marketing team, external research agency, Category Managers
Source: workflow W1663 — Customer Market Research &amp; Segmentation Analysis</bpmn:documentation>
      <bpmn:laneSet id="W1663_LaneSet3">
        <bpmn:lane id="W1663_Lane1" name="CMO">
        <bpmn:flowNodeRef>W1663_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1663_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1663_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1663_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1663_Lane2" name="Research Agency">
        <bpmn:flowNodeRef>W1663_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1663_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1663_Start4" name="Annual research cycle or specific strategic question">
        <bpmn:outgoing>W1663_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1663_Task5" name="Annual customer segmentation refresh: (a) engage external research agency for…">
        <bpmn:documentation>Step 1: Annual customer segmentation refresh: (a) engage external research agency for survey (sample: 1,000–2,000 respondents across BuildRight trade areas), (b) research objectives: customer segment profile, shopping behavior, category preferences, channel preferences, spend patterns, brand perception, unmet needs, (c) include BuildRight customer data analysis: loyalty program transaction data, ecommerce behavior, customer service interaction data
Responsible (R): CMO / Research Agency
Accountable (A): —
Duration: 6 weeks</bpmn:documentation>
        <bpmn:incoming>W1663_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1663_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1663_Task6" name="Research agency delivers segmentation analysis: (a) customer segments…">
        <bpmn:documentation>Step 2: Research agency delivers segmentation analysis: (a) customer segments identified and profiled (e.g., Professional Contractor, Serious DIYer, Casual Homeowner, Interior Designer, Small Builder), (b) segment size and value estimation, (c) segment growth trajectory, (d) segment needs and pain points, (e) competitive brand preference by segment, (f) channel preference by segment (in-store vs. online vs. phone)
Responsible (R): Research Agency
Accountable (A): CMO
Duration: —</bpmn:documentation>
        <bpmn:incoming>W1663_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1663_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1663_Task7" name="CMO translates research into actionable strategy: (a) update customer segment…">
        <bpmn:documentation>Step 3: CMO translates research into actionable strategy: (a) update customer segment profiles in CRM per W13.3, (b) identify target segments for growth (underserved segments with high potential), (c) develop segment-specific value propositions and marketing strategies, (d) brief Category Managers on segment-specific assortment and pricing implications, (e) brief CIO on segment-specific digital experience requirements
Responsible (R): CMO
Accountable (A): CEO
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W1663_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1663_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1663_Task8" name="Quarterly targeted studies: (a) post-promotion customer feedback, (b) new store…">
        <bpmn:documentation>Step 4: Quarterly targeted studies: (a) post-promotion customer feedback, (b) new store opening customer reception, (c) ecommerce customer experience, (d) customer satisfaction deep-dive for underperforming categories
Responsible (R): CMO
Accountable (A): —
Duration: Per study</bpmn:documentation>
        <bpmn:incoming>W1663_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1663_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1663_End9" name="Complete">
        <bpmn:incoming>W1663_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1663_Annotation10">
        <bpmn:text>Controls: - CTL-342 (ensure controlled execution — Competitive Intelligence &amp; Market Analysis (PA-33.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: CMO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1663_Assoc11" sourceRef="W1663_Annotation10" targetRef="W1663_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1663_Flow12" sourceRef="W1663_Start4" targetRef="W1663_Task5" />
      <bpmn:sequenceFlow id="W1663_Flow13" sourceRef="W1663_Task5" targetRef="W1663_Task6" />
      <bpmn:sequenceFlow id="W1663_Flow14" sourceRef="W1663_Task6" targetRef="W1663_Task7" />
      <bpmn:sequenceFlow id="W1663_Flow15" sourceRef="W1663_Task7" targetRef="W1663_Task8" />
      <bpmn:sequenceFlow id="W1663_Flow16" sourceRef="W1663_Task8" targetRef="W1663_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1663_diag">
      <bpmndi:BPMNPlane id="W1663_plane" bpmnElement="W_W1663">
        <bpmndi:BPMNShape id="W1663_Lane1_di" bpmnElement="W1663_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1663_Lane2_di" bpmnElement="W1663_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1663_Task5_di" bpmnElement="W1663_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1663_Task6_di" bpmnElement="W1663_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1663_Task7_di" bpmnElement="W1663_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1663_Task8_di" bpmnElement="W1663_Task8"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1663_Start4_di" bpmnElement="W1663_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1663_End9_di" bpmnElement="W1663_End9"><dc:Bounds x="1260" y="317" width="36" height="36" /></bpmndi:BPMNShape>
