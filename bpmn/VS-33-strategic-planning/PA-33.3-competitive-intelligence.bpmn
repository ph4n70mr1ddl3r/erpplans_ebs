    <bpmn:process id="W_W1665" name="W1665. New Market Entry &amp; Store Location Feasibility Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Expansion pipeline review (quarterly) or specific site opportunity
Frequency: ~10–15 analyses/year
Volume: 1 per prospective store location
Owner: VP Store Operations
Participants: VP Store Operations, COO, FP&amp;A, CMO
Source: workflow W1665 — New Market Entry &amp; Store Location Feasibility Analysis</bpmn:documentation>
      <bpmn:laneSet id="W1665_LaneSet4">
        <bpmn:lane id="W1665_Lane1" name="VP Store Operations">
        <bpmn:flowNodeRef>W1665_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1665_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1665_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1665_Lane2" name="FP&amp;A">
        <bpmn:flowNodeRef>W1665_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1665_Lane3" name="COO">
        <bpmn:flowNodeRef>W1665_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1665_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1665_Start5" name="Expansion pipeline review (quarterly) or specific site opportunity">
        <bpmn:outgoing>W1665_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1665_Task6" name="COO identifies prospective site; VP Store Operations initiates feasibility…">
        <bpmn:documentation>Step 1: COO identifies prospective site; VP Store Operations initiates feasibility analysis: (a) trade area definition (15 km radius for provincial; 5 km for Metro Manila), (b) population and household count within trade area, (c) income demographics (PSA census data, LGU data), (d) competitive landscape (existing competitors within trade area, planned competitor openings), (e) construction activity indicators (building permits, new subdivisions, commercial developments), (f) accessibility (main road frontage, public transport, parking), (g) proximity to existing BuildRight stores (cannibalization risk if &lt; 15 km from existing store)
Responsible (R): VP Store Operations / COO
Accountable (A): COO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1665_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1665_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1665_Task7" name="FP&amp;A builds financial model per W1652 (New Store Financial Model) with…">
        <bpmn:documentation>Step 2: FP&amp;A builds financial model per W1652 (New Store Financial Model) with location-specific assumptions
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W1665_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1665_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1665_Task8" name="VP Store Operations and FP&amp;A present feasibility analysis to COO and CFO: (a)…">
        <bpmn:documentation>Step 3: VP Store Operations and FP&amp;A present feasibility analysis to COO and CFO: (a) recommendation: proceed, hold, or reject, (b) financial returns, (c) strategic fit, (d) risks (competitive, demographic, infrastructure)
Responsible (R): VP Store Operations / FP&amp;A
Accountable (A): COO / CFO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W1665_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1665_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1665_Task9" name="COO and CFO present to CEO for go/no-go; CEO approves sites meeting financial…">
        <bpmn:documentation>Step 4: COO and CFO present to CEO for go/no-go; CEO approves sites meeting financial thresholds
Responsible (R): COO / CFO / CEO
Accountable (A): Board (if capex &gt; PHP 50M)
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1665_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1665_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1665_End10" name="Complete">
        <bpmn:incoming>W1665_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1665_Annotation11">
        <bpmn:text>Controls: - CTL-342 (ensure controlled execution — Competitive Intelligence &amp; Market Analysis (PA-33.3).) | - operational: VP Store Operations review and approval gate
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1665_Assoc12" sourceRef="W1665_Annotation11" targetRef="W1665_Start5" associationDirection="None" />
