      <bpmn:sequenceFlow id="W1662_Flow12" sourceRef="W1662_Task5" targetRef="W1662_Task6" />
      <bpmn:sequenceFlow id="W1662_Flow13" sourceRef="W1662_Task6" targetRef="W1662_Task7" />
      <bpmn:sequenceFlow id="W1662_Flow14" sourceRef="W1662_Task7" targetRef="W1662_End8" />
    </bpmn:process>
