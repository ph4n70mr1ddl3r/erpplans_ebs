    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1654" name="W1654. Weekly Sales Flash &amp; KPI Dashboard" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly calendar (Monday for prior week results)
Frequency: Weekly (52×/year)
Volume: Chain-wide with store-level drill-down
Owner: FP&amp;A
Participants: FP&amp;A, CEO, COO, CMO, VP Store Operations
Source: workflow W1654 — Weekly Sales Flash &amp; KPI Dashboard</bpmn:documentation>
      <bpmn:laneSet id="W1654_LaneSet3">
        <bpmn:lane id="W1654_Lane1" name="System">
        <bpmn:flowNodeRef>W1654_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1654_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1654_Lane2" name="FP&amp;A">
        <bpmn:flowNodeRef>W1654_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1654_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1654_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1654_Start4" name="Weekly calendar (Monday for prior week results)">
        <bpmn:outgoing>W1654_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1654_Task5" name="System auto-generates weekly sales flash (Monday 6 AM): (a) total chain…">
        <bpmn:documentation>Step 1: System auto-generates weekly sales flash (Monday 6 AM): (a) total chain revenue: daily and weekly, vs. same week last year, vs. budget, (b) store cluster performance: Metro Manila, Luzon, Visayas, Mindanao, (c) top 10 / bottom 10 stores by revenue variance, (d) ecommerce: orders, GMV, conversion rate, (e) category performance: top 5 growing categories, top 5 declining, (f) transaction count and average transaction value, (g) key promotions performance (if active)
Responsible (R): System
Accountable (A): FP&amp;A
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1654_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1654_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1654_Task6" name="FP&amp;A adds commentary: (a) significant events affecting sales (typhoon closures…">
        <bpmn:documentation>Step 2: FP&amp;A adds commentary: (a) significant events affecting sales (typhoon closures, holidays, competitor promotions), (b) notable trends or anomalies, (c) promotional event results if applicable
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1654_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1654_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1654_Task7" name="Weekly sales flash distributed to CEO, COO, CMO, VP Store Operations by Monday…">
        <bpmn:documentation>Step 3: Weekly sales flash distributed to CEO, COO, CMO, VP Store Operations by Monday 9 AM; accessible via mobile executive dashboard
Responsible (R): FP&amp;A
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1654_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1654_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1654_End8" name="Complete">
        <bpmn:incoming>W1654_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1654_Annotation9">
        <bpmn:text>Controls: - CTL-230 (ensure strategy-to-budget alignment.) | - operational: standard operating procedures; system-enforced validation rules
Owner: FP&amp;A</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1654_Assoc10" sourceRef="W1654_Annotation9" targetRef="W1654_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1654_Flow11" sourceRef="W1654_Start4" targetRef="W1654_Task5" />
      <bpmn:sequenceFlow id="W1654_Flow12" sourceRef="W1654_Task5" targetRef="W1654_Task6" />
      <bpmn:sequenceFlow id="W1654_Flow13" sourceRef="W1654_Task6" targetRef="W1654_Task7" />
      <bpmn:sequenceFlow id="W1654_Flow14" sourceRef="W1654_Task7" targetRef="W1654_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1654_diag">
      <bpmndi:BPMNPlane id="W1654_plane" bpmnElement="W_W1654">
        <bpmndi:BPMNShape id="W1654_Lane1_di" bpmnElement="W1654_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1654_Lane2_di" bpmnElement="W1654_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
