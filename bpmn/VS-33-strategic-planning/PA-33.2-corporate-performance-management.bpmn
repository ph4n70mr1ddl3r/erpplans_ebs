        <bpmndi:BPMNShape id="W1653_Start5_di" bpmnElement="W1653_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1653_End10_di" bpmnElement="W1653_End10"><dc:Bounds x="1260" y="487" width="36" height="36" /></bpmndi:BPMNShape>
