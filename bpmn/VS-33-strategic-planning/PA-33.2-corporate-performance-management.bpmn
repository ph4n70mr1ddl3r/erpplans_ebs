        <bpmndi:BPMNEdge id="W1654_Flow12_di" bpmnElement="W1654_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1654_Flow13_di" bpmnElement="W1654_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1654_Flow14_di" bpmnElement="W1654_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1654_Assoc10_di" bpmnElement="W1654_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1655" name="W1655. Store-Level Monthly Performance Review &amp; Scorecard" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly calendar (by Day 10 for prior month)
Frequency: Monthly
Volume: 200 store scorecards
Owner: VP Store Operations
Participants: VP Store Operations, Regional Managers, Store Managers
Source: workflow W1655 — Store-Level Monthly Performance Review &amp; Scorecard</bpmn:documentation>
      <bpmn:laneSet id="W1655_LaneSet4">
        <bpmn:lane id="W1655_Lane1" name="System">
        <bpmn:flowNodeRef>W1655_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1655_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1655_Lane2" name="Regional Manager">
        <bpmn:flowNodeRef>W1655_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1655_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1655_Lane3" name="VP Store Operations">
        <bpmn:flowNodeRef>W1655_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1655_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1655_Start5" name="Monthly calendar (by Day 10 for prior month)">
        <bpmn:outgoing>W1655_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1655_Task6" name="System generates monthly store scorecard per store: (a) financial KPIs: revenue…">
        <bpmn:documentation>Step 1: System generates monthly store scorecard per store: (a) financial KPIs: revenue vs. budget, gross margin %, controllable expense vs. budget, store contribution margin, (b) operational KPIs: sales/sqm, inventory turns, shrinkage %, on-time replenishment rate, (c) customer KPIs: customer satisfaction score, NPS (if surveyed), loyalty enrollment rate, (d) people KPIs: turnover rate, training completion, attendance compliance, (e) safety KPIs: incident count, safety audit score
Responsible (R): System
Accountable (A): VP Store Operations
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1655_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1655_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1655_Task7" name="Regional Manager reviews scorecards for their stores (~33 stores per Regional…">
        <bpmn:documentation>Step 2: Regional Manager reviews scorecards for their stores (~33 stores per Regional Manager; ~6 RMs per VS-177); identifies: (a) top performing stores (recognize and share best practices), (b) underperforming stores (coach and action plan), (c) stores with concerning trends (3+ months declining metrics)
Responsible (R): Regional Manager
Accountable (A): VP Store Operations
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W1655_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1655_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1655_Task8" name="Regional Manager conducts monthly review call with each Store Manager: (a)…">
        <bpmn:documentation>Step 3: Regional Manager conducts monthly review call with each Store Manager: (a) discuss scorecard results, (b) identify root causes for underperformance, (c) agree on corrective actions, (d) share best practices from top-performing stores
Responsible (R): Regional Manager
Accountable (A): VP Store Operations
Duration: 30 min/store</bpmn:documentation>
        <bpmn:incoming>W1655_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1655_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1655_Task9" name="VP Store Operations reviews aggregate store performance with COO monthly: (a)…">
        <bpmn:documentation>Step 4: VP Store Operations reviews aggregate store performance with COO monthly: (a) chain-wide average scorecard, (b) regional comparison, (c) bottom 10 stores with action plans, (d) top 10 stores for recognition
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1655_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1655_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1655_End10" name="Complete">
        <bpmn:incoming>W1655_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1655_Annotation11">
        <bpmn:text>Controls: - CTL-341 (ensure controlled execution — Corporate Performance Management (PA-33.2).) | - operational: VP Store Operations review and approval gate
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1655_Assoc12" sourceRef="W1655_Annotation11" targetRef="W1655_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1655_Flow13" sourceRef="W1655_Start5" targetRef="W1655_Task6" />
      <bpmn:sequenceFlow id="W1655_Flow14" sourceRef="W1655_Task6" targetRef="W1655_Task7" />
      <bpmn:sequenceFlow id="W1655_Flow15" sourceRef="W1655_Task7" targetRef="W1655_Task8" />
      <bpmn:sequenceFlow id="W1655_Flow16" sourceRef="W1655_Task8" targetRef="W1655_Task9" />
      <bpmn:sequenceFlow id="W1655_Flow17" sourceRef="W1655_Task9" targetRef="W1655_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1655_diag">
      <bpmndi:BPMNPlane id="W1655_plane" bpmnElement="W_W1655">
        <bpmndi:BPMNShape id="W1655_Lane1_di" bpmnElement="W1655_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1655_Lane2_di" bpmnElement="W1655_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1655_Lane3_di" bpmnElement="W1655_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1655_Task6_di" bpmnElement="W1655_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1655_Task7_di" bpmnElement="W1655_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1655_Task8_di" bpmnElement="W1655_Task8"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1655_Task9_di" bpmnElement="W1655_Task9"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1655_Start5_di" bpmnElement="W1655_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1655_End10_di" bpmnElement="W1655_End10"><dc:Bounds x="1260" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1655_Annotation11_di" bpmnElement="W1655_Annotation11"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1655_Flow13_di" bpmnElement="W1655_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1655_Flow14_di" bpmnElement="W1655_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1655_Flow15_di" bpmnElement="W1655_Flow15"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
