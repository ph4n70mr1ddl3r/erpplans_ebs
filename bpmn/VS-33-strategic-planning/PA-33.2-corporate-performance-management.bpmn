      <bpmn:sequenceFlow id="W1660_Flow15" sourceRef="W1660_Task7" targetRef="W1660_Task8" />
      <bpmn:sequenceFlow id="W1660_Flow16" sourceRef="W1660_Task8" targetRef="W1660_Task9" />
      <bpmn:sequenceFlow id="W1660_Flow17" sourceRef="W1660_Task9" targetRef="W1660_End10" />
    </bpmn:process>
