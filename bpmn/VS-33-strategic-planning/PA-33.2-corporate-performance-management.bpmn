        <bpmndi:BPMNShape id="W1657_Lane2_di" bpmnElement="W1657_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1657_Lane3_di" bpmnElement="W1657_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1657_Task6_di" bpmnElement="W1657_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1657_Task7_di" bpmnElement="W1657_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1657_Task8_di" bpmnElement="W1657_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
