    <bpmn:process id="W_W1658" name="W1658. Annual Performance Assessment &amp; Incentive Compensation Calculation" isExecutable="false">
      <bpmn:documentation>Trigger: Year-end (January for prior year performance)
Frequency: Annual
Volume: 6,932 employees (all headcount)
Owner: CHRO
Participants: CHRO, CEO, C-Suite, HR, Payroll, Finance
Source: workflow W1658 — Annual Performance Assessment &amp; Incentive Compensation Calculation</bpmn:documentation>
      <bpmn:laneSet id="W1658_LaneSet5">
        <bpmn:lane id="W1658_Lane1" name="HR">
        <bpmn:flowNodeRef>W1658_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1658_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1658_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1658_Lane2" name="C-Suite">
        <bpmn:flowNodeRef>W1658_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1658_Lane3" name="CEO">
        <bpmn:flowNodeRef>W1658_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1658_Lane4" name="Payroll">
        <bpmn:flowNodeRef>W1658_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1658_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1658_Start6" name="Year-end (January for prior year performance)">
        <bpmn:outgoing>W1658_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1658_Task7" name="HR compiles annual performance data: (a) individual KPI achievement vs. targets…">
        <bpmn:documentation>Step 1: HR compiles annual performance data: (a) individual KPI achievement vs. targets (for roles with quantifiable KPIs), (b) behavioral competency assessment (for all roles), (c) store scorecard results (for Store Managers), (d) category P&amp;L results (for Category Managers), (e) department operating plan achievement (for department heads)
Responsible (R): HR
Accountable (A): CHRO
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W1658_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1658_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1658_Task8" name="Performance calibration: (a) C-Suite reviews and calibrates performance ratings…">
        <bpmn:documentation>Step 2: Performance calibration: (a) C-Suite reviews and calibrates performance ratings for direct reports, (b) Regional Managers calibrate Store Manager ratings, (c) distribution guidelines: top performer (15%), strong performer (35%), solid performer (35%), development needed (12%), unsatisfactory (3%)
Responsible (R): C-Suite / Regional Managers
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1658_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1658_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1658_Task9" name="Store Managers">
        <bpmn:documentation>Step 3: Incentive compensation calculation: (a) Store Managers: bonus = base salary × performance multiplier × store achievement %; funded from store-level P&amp;L bonus pool, (b) Category Managers: bonus = base salary × category margin achievement %, (c) HQ staff: bonus = base salary × corporate achievement multiplier (based on consolidated EBITDA vs. target), (d) Sales Associates: monthly commission based on individual sales performance (tracked via POS ID), (e) 13th month pay: mandatory per PD 851; calculated separately from performance bonus
Responsible (R): HR / Payroll / Finance
Accountable (A): CHRO / CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1658_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1658_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1658_Task10" name="CEO approves incentive compensation for C-Suite and department heads; CHRO…">
        <bpmn:documentation>Step 4: CEO approves incentive compensation for C-Suite and department heads; CHRO approves for all other employees within approved budget
Responsible (R): CEO / CHRO
Accountable (A): Board (C-Suite compensation)
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1658_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1658_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1658_Task11" name="Payroll processes incentive payments; separate from regular payroll per PH tax…">
        <bpmn:documentation>Step 5: Payroll processes incentive payments; separate from regular payroll per PH tax rules; BIR withholding tax calculated on bonus income
Responsible (R): Payroll
Accountable (A): CHRO / CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1658_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1658_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1658_End12" name="Complete">
        <bpmn:incoming>W1658_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1658_Annotation13">
        <bpmn:text>Controls: - CTL-341 (ensure controlled execution — Corporate Performance Management (PA-33.2).) | - operational: CHRO review and approval gate
Owner: CHRO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1658_Assoc14" sourceRef="W1658_Annotation13" targetRef="W1658_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1658_Flow15" sourceRef="W1658_Start6" targetRef="W1658_Task7" />
      <bpmn:sequenceFlow id="W1658_Flow16" sourceRef="W1658_Task7" targetRef="W1658_Task8" />
      <bpmn:sequenceFlow id="W1658_Flow17" sourceRef="W1658_Task8" targetRef="W1658_Task9" />
      <bpmn:sequenceFlow id="W1658_Flow18" sourceRef="W1658_Task9" targetRef="W1658_Task10" />
      <bpmn:sequenceFlow id="W1658_Flow19" sourceRef="W1658_Task10" targetRef="W1658_Task11" />
      <bpmn:sequenceFlow id="W1658_Flow20" sourceRef="W1658_Task11" targetRef="W1658_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1658_diag">
      <bpmndi:BPMNPlane id="W1658_plane" bpmnElement="W_W1658">
        <bpmndi:BPMNShape id="W1658_Lane1_di" bpmnElement="W1658_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
