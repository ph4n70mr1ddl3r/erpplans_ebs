    <bpmn:process id="W_W1656" name="W1656. Category Manager Monthly Performance Review &amp; Margin Ownership" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly calendar cycle — Category Manager
Frequency: Monthly
Volume: 13 departments / ~40 product categories (per profile §6.2)
Owner: VP Merchandising
Participants: VP Merchandising, Category Managers, FP&amp;A
Source: workflow W1656 — Category Manager Monthly Performance Review &amp; Margin Ownership</bpmn:documentation>
      <bpmn:laneSet id="W1656_LaneSet4">
        <bpmn:lane id="W1656_Lane1" name="FP&amp;A">
        <bpmn:flowNodeRef>W1656_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1656_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1656_Lane2" name="VP Merchandising">
        <bpmn:flowNodeRef>W1656_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1656_Lane3" name="Category Manager">
        <bpmn:flowNodeRef>W1656_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1656_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1656_Start5" name="Monthly calendar cycle — Category Manager">
        <bpmn:outgoing>W1656_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1656_Task6" name="FP&amp;A generates category-level monthly P&amp;L: (a) revenue vs. budget by category…">
        <bpmn:documentation>Step 1: FP&amp;A generates category-level monthly P&amp;L: (a) revenue vs. budget by category and by store cluster, (b) gross margin % and margin bridge (cost change, price change, mix change, promo impact), (c) sell-through rate, (d) inventory turns and weeks of supply, (e) markdown rate, (f) vendor margin contribution (rebates, volume discounts)
Responsible (R): FP&amp;A
Accountable (A): VP Merchandising
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1656_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1656_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1656_Task7" name="VP Merchandising reviews category performance with each Category Manager: (a)…">
        <bpmn:documentation>Step 2: VP Merchandising reviews category performance with each Category Manager: (a) revenue and margin vs. plan, (b) assortment effectiveness (new SKU sell-through, discontinued SKU clearance progress), (c) promotional ROI (margin given up vs. incremental revenue), (d) vendor negotiation wins/losses, (e) action items for margin improvement
Responsible (R): VP Merchandising
Accountable (A): —
Duration: 1 hour/category</bpmn:documentation>
        <bpmn:incoming>W1656_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1656_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1656_Task8" name="Category-specific action items: (a) margin below target → vendor negotiation…">
        <bpmn:documentation>Step 3: Category-specific action items: (a) margin below target → vendor negotiation for better cost, price increase, or mix shift, (b) revenue below target → promotional plan, assortment adjustment, (c) inventory above target → markdown acceleration, return to vendor
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1656_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1656_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1656_End9" name="Complete">
        <bpmn:incoming>W1656_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1656_Annotation10">
        <bpmn:text>Controls: - CTL-341 (ensure controlled execution — Corporate Performance Management (PA-33.2).) | - operational: VP Merchandising review and approval gate
Owner: VP Merchandising</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1656_Assoc11" sourceRef="W1656_Annotation10" targetRef="W1656_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1656_Flow12" sourceRef="W1656_Start5" targetRef="W1656_Task6" />
      <bpmn:sequenceFlow id="W1656_Flow13" sourceRef="W1656_Task6" targetRef="W1656_Task7" />
      <bpmn:sequenceFlow id="W1656_Flow14" sourceRef="W1656_Task7" targetRef="W1656_Task8" />
      <bpmn:sequenceFlow id="W1656_Flow15" sourceRef="W1656_Task8" targetRef="W1656_End9" />
    </bpmn:process>
