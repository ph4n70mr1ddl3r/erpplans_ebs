<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-33.2-corporate-performance-management" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1653" name="W1653. Monthly Executive Performance Review (Operating Review)" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly calendar (first week of month for prior month results)
Frequency: Monthly (12×/year)
Volume: 1 comprehensive review covering entire enterprise
Owner: CFO
Participants: CEO, CFO, COO, CIO, CMO, CHRO, VP Supply Chain
Source: workflow W1653 — Monthly Executive Performance Review (Operating Review)</bpmn:documentation>
      <bpmn:laneSet id="W1653_LaneSet4">
        <bpmn:lane id="W1653_Lane1" name="FP&amp;A">
        <bpmn:flowNodeRef>W1653_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1653_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1653_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1653_Lane2" name="CFO">
        <bpmn:flowNodeRef>W1653_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1653_Lane3" name="CEO">
        <bpmn:flowNodeRef>W1653_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1653_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1653_Start5" name="Monthly calendar (first week of month for prior month results)">
        <bpmn:outgoing>W1653_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1653_Task6" name="FP&amp;A prepares monthly operating review package (by Day 3 of month): (a) P&amp;L…">
        <bpmn:documentation>Step 1: FP&amp;A prepares monthly operating review package (by Day 3 of month): (a) P&amp;L summary: actual vs. budget vs. prior year (entity-level and consolidated), (b) revenue analysis: by store cluster, by category, by channel (in-store vs. ecommerce), (c) gross margin analysis: by category, with margin bridge (volume, mix, price, cost), (d) OpEx analysis: by department with variance commentary, (e) working capital dashboard: inventory days, receivable days, payable days, cash position, (f) store operations metrics: sales/sqm, inventory turns, shrinkage, on-time replenishment, (g) supply chain metrics: DC throughput, fill rate, on-time delivery, (h) ecommerce metrics: orders, GMV, conversion rate, AOV, BOPIS pickup rate, (i) HR metrics: turnover, open positions, training completion
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W1653_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1653_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1653_Task7" name="CFO reviews package; identifies areas requiring executive discussion: (a)…">
        <bpmn:documentation>Step 2: CFO reviews package; identifies areas requiring executive discussion: (a) significant variances (&gt; 5% vs. budget), (b) trend concerns (3+ months of unfavorable trend), (c) strategic initiative progress, (d) risk items
Responsible (R): CFO
Accountable (A): CEO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W1653_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1653_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1653_Task8" name="Monthly Operating Review meeting (Day 5–7): (a) CFO presents financial…">
        <bpmn:documentation>Step 3: Monthly Operating Review meeting (Day 5–7): (a) CFO presents financial overview, (b) each C-Suite member reports on their area: key metrics, variances, actions, (c) CEO directs specific actions and follow-ups, (d) FP&amp;A captures action items with owners and deadlines
Responsible (R): CEO / C-Suite
Accountable (A): CEO
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W1653_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1653_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1653_Task9" name="Action items distributed to owners; tracked in initiative tracker per W1660…">
        <bpmn:documentation>Step 4: Action items distributed to owners; tracked in initiative tracker per W1660; progress reviewed at next monthly meeting
Responsible (R): FP&amp;A
Accountable (A): CEO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1653_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1653_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1653_End10" name="Complete">
        <bpmn:incoming>W1653_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1653_Annotation11">
        <bpmn:text>Controls: - CTL-341 (ensure controlled execution — Corporate Performance Management (PA-33.2).) | - operational: CFO review and approval gate
Owner: CFO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1653_Assoc12" sourceRef="W1653_Annotation11" targetRef="W1653_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1653_Flow13" sourceRef="W1653_Start5" targetRef="W1653_Task6" />
      <bpmn:sequenceFlow id="W1653_Flow14" sourceRef="W1653_Task6" targetRef="W1653_Task7" />
      <bpmn:sequenceFlow id="W1653_Flow15" sourceRef="W1653_Task7" targetRef="W1653_Task8" />
      <bpmn:sequenceFlow id="W1653_Flow16" sourceRef="W1653_Task8" targetRef="W1653_Task9" />
      <bpmn:sequenceFlow id="W1653_Flow17" sourceRef="W1653_Task9" targetRef="W1653_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1653_diag">
      <bpmndi:BPMNPlane id="W1653_plane" bpmnElement="W_W1653">
        <bpmndi:BPMNShape id="W1653_Lane1_di" bpmnElement="W1653_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
