    <bpmn:process id="W_W1657" name="W1657. Quarterly Board Performance Report &amp; Governance Package" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly Board meeting calendar
Frequency: Quarterly (4×/year)
Volume: 1 comprehensive governance package
Owner: CFO
Participants: CFO, CEO, Corporate Secretary, Board of Directors
Source: workflow W1657 — Quarterly Board Performance Report &amp; Governance Package</bpmn:documentation>
      <bpmn:laneSet id="W1657_LaneSet4">
        <bpmn:lane id="W1657_Lane1" name="CFO">
        <bpmn:flowNodeRef>W1657_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1657_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1657_Lane2" name="Corporate Secretary">
        <bpmn:flowNodeRef>W1657_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1657_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1657_Lane3" name="CEO">
        <bpmn:flowNodeRef>W1657_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1657_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1657_Start5" name="Quarterly Board meeting calendar">
        <bpmn:outgoing>W1657_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1657_Task6" name="CFO prepares Board governance package: (a) CEO report: strategic initiative…">
        <bpmn:documentation>Step 1: CFO prepares Board governance package: (a) CEO report: strategic initiative progress, market commentary, organizational highlights, (b) CFO report: quarterly financial results vs. budget and prior year, YTD performance, revised full-year forecast, cash and debt position, (c) COO report: store operations summary, new store pipeline and openings, supply chain performance, (d) CIO report: technology project status, cybersecurity posture, system performance, (e) CMO report: marketing campaign results, ecommerce growth, loyalty program metrics, (f) CHRO report: headcount, turnover, key hires, training, (g) Internal Audit report: audit findings, management action status, (h) Risk report: top risks, risk mitigation status, emerging risks
Responsible (R): CFO / C-Suite
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1657_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1657_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1657_Task7" name="Corporate Secretary compiles governance package; distributes to Board members 5…">
        <bpmn:documentation>Step 2: Corporate Secretary compiles governance package; distributes to Board members 5 business days before meeting per corporate governance policy
Responsible (R): Corporate Secretary
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1657_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1657_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1657_Task8" name="Board meeting: (a) CEO and C-Suite present reports, (b) Board discusses…">
        <bpmn:documentation>Step 3: Board meeting: (a) CEO and C-Suite present reports, (b) Board discusses performance, asks questions, provides direction, (c) Board approves: quarterly financial statements, dividend declaration (if applicable), major capex projects, policy changes, (d) Corporate Secretary records Board minutes and resolutions
Responsible (R): CEO / Board
Accountable (A): Board Chair
Duration: 3–4 hours</bpmn:documentation>
        <bpmn:incoming>W1657_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1657_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1657_Task9" name="Post-meeting: (a) Board resolutions communicated to relevant officers for…">
        <bpmn:documentation>Step 4: Post-meeting: (a) Board resolutions communicated to relevant officers for execution, (b) management actions tracked per W1660, (c) quarterly financial statements filed with SEC (per Philippine corporate law)
Responsible (R): Corporate Secretary / CFO
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1657_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1657_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1657_End10" name="Complete">
        <bpmn:incoming>W1657_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1657_Annotation11">
        <bpmn:text>Controls: - CTL-341 (ensure controlled execution — Corporate Performance Management (PA-33.2).) | - operational: CFO review and approval gate
Owner: CFO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1657_Assoc12" sourceRef="W1657_Annotation11" targetRef="W1657_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1657_Flow13" sourceRef="W1657_Start5" targetRef="W1657_Task6" />
      <bpmn:sequenceFlow id="W1657_Flow14" sourceRef="W1657_Task6" targetRef="W1657_Task7" />
      <bpmn:sequenceFlow id="W1657_Flow15" sourceRef="W1657_Task7" targetRef="W1657_Task8" />
      <bpmn:sequenceFlow id="W1657_Flow16" sourceRef="W1657_Task8" targetRef="W1657_Task9" />
      <bpmn:sequenceFlow id="W1657_Flow17" sourceRef="W1657_Task9" targetRef="W1657_End10" />
    </bpmn:process>
