    <bpmn:process id="W_W1660" name="W1660. Cross-Functional Initiative Tracking &amp; Status Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Strategic initiative approved in W1645 or emerging priority
Frequency: Ongoing tracking; monthly reporting to C-Suite
Volume: ~15–25 active cross-functional initiatives at any time
Owner: CEO
Participants: Initiative sponsors (C-Suite), initiative leads, FP&amp;A
Source: workflow W1660 — Cross-Functional Initiative Tracking &amp; Status Reporting</bpmn:documentation>
      <bpmn:laneSet id="W1660_LaneSet4">
        <bpmn:lane id="W1660_Lane1" name="Initiative Lead">
        <bpmn:flowNodeRef>W1660_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1660_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1660_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1660_Lane2" name="FP&amp;A">
        <bpmn:flowNodeRef>W1660_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1660_Lane3" name="CEO">
        <bpmn:flowNodeRef>W1660_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1660_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1660_Start5" name="Strategic initiative approved in W1645 or emerging priority">
        <bpmn:outgoing>W1660_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1660_Task6" name="Each strategic initiative documented in initiative tracker: (a) initiative…">
        <bpmn:documentation>Step 1: Each strategic initiative documented in initiative tracker: (a) initiative name, strategic priority alignment, sponsor (C-Suite), lead (senior manager), (b) business case: expected outcome, financial impact, timeline, resource requirement, (c) milestones with dates, (d) status: On Track (green), At Risk (amber), Off Track (red), Complete
Responsible (R): Initiative Lead
Accountable (A): Sponsor
Duration: 2 hours/initiative</bpmn:documentation>
        <bpmn:incoming>W1660_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1660_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1660_Task7" name="Monthly: initiative leads update status: (a) milestone completion, (b) budget…">
        <bpmn:documentation>Step 2: Monthly: initiative leads update status: (a) milestone completion, (b) budget spent vs. plan, (c) risks and issues, (d) decisions needed from C-Suite
Responsible (R): Initiative Lead
Accountable (A): Sponsor
Duration: 30 min/initiative</bpmn:documentation>
        <bpmn:incoming>W1660_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1660_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1660_Task8" name="Monthly: FP&amp;A compiles initiative status summary for CEO: (a) portfolio…">
        <bpmn:documentation>Step 3: Monthly: FP&amp;A compiles initiative status summary for CEO: (a) portfolio dashboard: all initiatives with status, (b) budget utilization: total initiative spend vs. budget, (c) at-risk initiatives with root cause and recommended actions, (d) completed initiatives with outcome vs. business case
Responsible (R): FP&amp;A
Accountable (A): CEO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W1660_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1660_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1660_Task9" name="CEO reviews initiative portfolio with C-Suite at monthly operating review: (a)…">
        <bpmn:documentation>Step 4: CEO reviews initiative portfolio with C-Suite at monthly operating review: (a) course-correct at-risk initiatives, (b) approve scope/budget changes, (c) celebrate completions, (d) archive completed initiatives
Responsible (R): CEO
Accountable (A): Board
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1660_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1660_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1660_End10" name="Complete">
        <bpmn:incoming>W1660_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1660_Annotation11">
        <bpmn:text>Controls: - CTL-341 (ensure controlled execution — Corporate Performance Management (PA-33.2).) | - operational: CEO review and approval gate
Owner: CEO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1660_Assoc12" sourceRef="W1660_Annotation11" targetRef="W1660_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1660_Flow13" sourceRef="W1660_Start5" targetRef="W1660_Task6" />
