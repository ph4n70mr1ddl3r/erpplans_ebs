    <bpmn:process id="W_W2729" name="W2729. Green Building Workshop &amp; Event Management" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly workshop calendar
Frequency: Quarterly; 4 major + monthly in-store
Volume: 200 stores
Owner: Marketing Manager
Participants: Marketing Mgr, Sustainability Coordinator, Store Managers, Category Manager
Source: workflow W2729 — Green Building Workshop &amp; Event Management</bpmn:documentation>
      <bpmn:laneSet id="W2729_LaneSet4">
        <bpmn:lane id="W2729_Lane1" name="Marketing Manager">
        <bpmn:flowNodeRef>W2729_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2729_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2729_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W2729_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2729_Lane3" name="Marketing">
        <bpmn:flowNodeRef>W2729_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2729_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2729_Start5" name="Quarterly workshop calendar">
        <bpmn:outgoing>W2729_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2729_Task6" name="Marketing Manager plans workshop: topic (energy-efficient home, water-saving…">
        <bpmn:documentation>Step 1: Marketing Manager plans workshop: topic (energy-efficient home, water-saving, solar, BERDE overview), expert speaker, venue (store or online), audience targeting
Responsible (R): Marketing Manager / Sustainability Coordinator
Accountable (A): CMO
Duration: 2–3 weeks planning</bpmn:documentation>
        <bpmn:incoming>W2729_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2729_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2729_Task7" name="Store Manager hosts: manages registration, sets up demo area, coordinates…">
        <bpmn:documentation>Step 2: Store Manager hosts: manages registration, sets up demo area, coordinates logistics; Category Manager ensures featured products in stock and displayed
Responsible (R): Store Manager / Category Manager
Accountable (A): VP Store Operations
Duration: Event day</bpmn:documentation>
        <bpmn:incoming>W2729_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2729_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2729_Task8" name="Marketing measures: attendance vs. target, satisfaction survey, sales lift for…">
        <bpmn:documentation>Step 3: Marketing measures: attendance vs. target, satisfaction survey, sales lift for featured items (2 weeks post), new trade registrations, workshop-to-project conversion
Responsible (R): Marketing
Accountable (A): CMO
Duration: Post-event</bpmn:documentation>
        <bpmn:incoming>W2729_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2729_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2729_End9" name="Complete">
        <bpmn:incoming>W2729_Flow15</bpmn:incoming>
      </bpmn:endEvent>
