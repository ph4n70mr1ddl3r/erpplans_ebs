    <bpmn:process id="W_W2728" name="W2728. BERDE/LEED Project Partnership with Architects &amp; Engineers" isExecutable="false">
      <bpmn:documentation>Trigger: Architecture/engineering firm interested in partnership
Frequency: Ad-hoc; 5–10 partnerships/year
Volume: ~5–10 partnerships
Owner: Trade Sales Manager
Participants: Trade Sales Mgr, Sustainability Coordinator, Category Manager
Source: workflow W2728 — BERDE/LEED Project Partnership with Architects &amp; Engineers</bpmn:documentation>
      <bpmn:laneSet id="W2728_LaneSet3">
        <bpmn:lane id="W2728_Lane1" name="Trade Sales Manager">
        <bpmn:flowNodeRef>W2728_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2728_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2728_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2728_Lane2" name="Sustainability Coordinator">
        <bpmn:flowNodeRef>W2728_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2728_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2728_Start4" name="Architecture/engineering firm interested in partnership">
        <bpmn:outgoing>W2728_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2728_Task5" name="Trade Sales Manager develops proposal: green product catalog, documentation…">
        <bpmn:documentation>Step 1: Trade Sales Manager develops proposal: green product catalog, documentation support, supply reliability, bulk pricing, dedicated service, joint marketing
Responsible (R): Trade Sales Manager / Sustainability Coordinator
Accountable (A): VP Merchandising
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2728_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2728_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2728_Task6" name="Sustainability Coordinator conducts product knowledge session: specs…">
        <bpmn:documentation>Step 2: Sustainability Coordinator conducts product knowledge session: specs, BERDE/LEED contributions, new products pipeline, documentation process
Responsible (R): Sustainability Coordinator
Accountable (A): COO
Duration: Half day per firm</bpmn:documentation>
        <bpmn:incoming>W2728_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2728_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2728_Task7" name="Trade Sales Manager manages partnership: quarterly updates, project pipeline…">
        <bpmn:documentation>Step 3: Trade Sales Manager manages partnership: quarterly updates, project pipeline visibility, pricing maintenance, feedback loop; tracks partnership revenue
Responsible (R): Trade Sales Manager
Accountable (A): VP Merchandising
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2728_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2728_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2728_End8" name="Complete">
        <bpmn:incoming>W2728_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2728_Annotation9">
        <bpmn:text>Controls: - CTL-06: vendor/partner-master onboarding; Operational: Trade Sales Manager sign-off on the workflow output
Owner: Trade Sales Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2728_Assoc10" sourceRef="W2728_Annotation9" targetRef="W2728_Start4" associationDirection="None" />
