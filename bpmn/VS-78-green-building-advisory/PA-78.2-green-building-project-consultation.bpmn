    <bpmn:process id="W_W2732" name="W2732. Green Product Vendor Sustainability Scorecard" isExecutable="false">
      <bpmn:documentation>Trigger: Annual vendor review
Frequency: Annual; quarterly monitoring
Volume: ~200–300 green vendors
Owner: Procurement Manager
Participants: Procurement Mgr, Sustainability Coordinator, Category Manager
Source: workflow W2732 — Green Product Vendor Sustainability Scorecard</bpmn:documentation>
      <bpmn:laneSet id="W2732_LaneSet4">
        <bpmn:lane id="W2732_Lane1" name="Sustainability Coordinator">
        <bpmn:flowNodeRef>W2732_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2732_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2732_Lane2" name="Procurement Manager">
        <bpmn:flowNodeRef>W2732_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2732_Lane3" name="Category Manager">
        <bpmn:flowNodeRef>W2732_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2732_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2732_Start5" name="Annual vendor review">
        <bpmn:outgoing>W2732_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2732_Task6" name="Sustainability Coordinator compiles scorecard: certifications, carbon…">
        <bpmn:documentation>Step 1: Sustainability Coordinator compiles scorecard: certifications, carbon disclosure, sustainable sourcing, packaging waste, ethical labor, end-of-life program; 100-point scale
Responsible (R): Sustainability Coordinator
Accountable (A): COO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2732_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2732_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2732_Task7" name="Procurement incorporates: minimum 70/100 for Green Choice suppliers, preferred…">
        <bpmn:documentation>Step 2: Procurement incorporates: minimum 70/100 for Green Choice suppliers, preferred status for top scorers, development plans for below-threshold; includes in vendor reviews
Responsible (R): Procurement Manager
Accountable (A): VP Merchandising
Duration: Per review cycle</bpmn:documentation>
        <bpmn:incoming>W2732_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2732_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2732_Task8" name="Category Manager identifies opportunities: high sustainability + poor…">
        <bpmn:documentation>Step 3: Category Manager identifies opportunities: high sustainability + poor availability (increase), low score + unique product (improve or replace), excellent sustainability story (co-marketing)
Responsible (R): Category Manager / Procurement
Accountable (A): VP Merchandising
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2732_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2732_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2732_End9" name="Complete">
        <bpmn:incoming>W2732_Flow15</bpmn:incoming>
      </bpmn:endEvent>
