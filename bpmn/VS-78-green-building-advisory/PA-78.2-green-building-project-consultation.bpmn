    <bpmn:process id="W_W2733" name="W2733. Green Building Advisory Customer Feedback &amp; Improvement" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly feedback review
Frequency: Quarterly
Volume: ~50–100 green consultations/month
Owner: Customer Experience Analyst
Participants: CX Analyst, Sustainability Coordinator, Trade Sales Manager
Source: workflow W2733 — Green Building Advisory Customer Feedback &amp; Improvement</bpmn:documentation>
      <bpmn:laneSet id="W2733_LaneSet4">
        <bpmn:lane id="W2733_Lane1" name="CX Analyst">
        <bpmn:flowNodeRef>W2733_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2733_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2733_Lane2" name="Sustainability Coordinator">
        <bpmn:flowNodeRef>W2733_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2733_Lane3" name="Trade Sales Manager">
        <bpmn:flowNodeRef>W2733_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2733_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2733_Start5" name="Quarterly feedback review">
        <bpmn:outgoing>W2733_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2733_Task6" name="CX Analyst surveys consultation customers: satisfaction, recommendation…">
        <bpmn:documentation>Step 1: CX Analyst surveys consultation customers: satisfaction, recommendation relevance, pricing perception, recommendation likelihood; target NPS &gt;50
Responsible (R): CX Analyst
Accountable (A): COO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2733_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2733_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2733_Task7" name="Sustainability Coordinator analyzes: knowledge gaps, availability issues…">
        <bpmn:documentation>Step 2: Sustainability Coordinator analyzes: knowledge gaps, availability issues, pricing concerns, documentation satisfaction; develops improvement plan
Responsible (R): Sustainability Coordinator
Accountable (A): COO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2733_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2733_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2733_Task8" name="Trade Sales Manager implements: additional training, adjusts recommendations…">
        <bpmn:documentation>Step 3: Trade Sales Manager implements: additional training, adjusts recommendations, improves documentation turnaround, negotiates pricing; tracks improvement in next quarter
Responsible (R): Trade Sales Manager
Accountable (A): VP Merchandising
Duration: Per feedback cycle</bpmn:documentation>
        <bpmn:incoming>W2733_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2733_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2733_End9" name="Complete">
        <bpmn:incoming>W2733_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2733_Annotation10">
        <bpmn:text>Controls: - CTL-464 (ensure controlled execution — Green Building Project Consultation (PA-78.2).) | - CTL-464 (data-privacy — links to VS-91 / W53, RA 10173); Operational: Customer Experience Analyst sign-off on the workflow output
Owner: Customer Experience Analyst</bpmn:text>
      </bpmn:textAnnotation>
