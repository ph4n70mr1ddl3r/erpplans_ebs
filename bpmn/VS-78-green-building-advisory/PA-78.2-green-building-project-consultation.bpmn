<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-78.2-green-building-project-consultation" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2726" name="W2726. Green Building Project Material Consultation Service" isExecutable="false">
      <bpmn:documentation>Trigger: Customer inquires about green building materials
Frequency: ~50–100 consultations/month
Volume: ~50–100/month
Owner: Green-Certified Sales Associate
Participants: Green-Certified Sales Associate, Sustainability Coordinator, Trade Sales Rep
Source: workflow W2726 — Green Building Project Material Consultation Service</bpmn:documentation>
      <bpmn:laneSet id="W2726_LaneSet2">
        <bpmn:lane id="W2726_Lane1" name="Green-Certified Sales Associate">
        <bpmn:flowNodeRef>W2726_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2726_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2726_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2726_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2726_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2726_Start3" name="Customer inquires about green building materials">
        <bpmn:outgoing>W2726_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2726_Task4" name="Green-Certified Sales Associate conducts consultation: project type, green…">
        <bpmn:documentation>Step 1: Green-Certified Sales Associate conducts consultation: project type, green target (BERDE/LEED or general sustainability), budget, timeline; identifies contributing BuildRight products
Responsible (R): Green-Certified Sales Associate
Accountable (A): Department Supervisor
Duration: 30–45 min</bpmn:documentation>
        <bpmn:incoming>W2726_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2726_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2726_Task5" name="Associate develops recommendation: lower-impact alternatives, energy/water…">
        <bpmn:documentation>Step 2: Associate develops recommendation: lower-impact alternatives, energy/water savings calculations, payback periods, BERDE/LEED credit mapping for recommended products
Responsible (R): Green-Certified Sales Associate / Sustainability Coordinator
Accountable (A): Department Supervisor
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W2726_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2726_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2726_Task6" name="Associate creates quotation with green line-up, environmental benefit summary…">
        <bpmn:documentation>Step 3: Associate creates quotation with green line-up, environmental benefit summary (energy saved, water saved, carbon reduced), BERDE/LEED scorecard; escalates to Coordinator for advanced support if needed
Responsible (R): Green-Certified Sales Associate
Accountable (A): Department Supervisor
Duration: 15–20 min</bpmn:documentation>
        <bpmn:incoming>W2726_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2726_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2726_End7" name="Complete">
        <bpmn:incoming>W2726_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2726_Annotation8">
        <bpmn:text>Controls: - CTL-464 (ensure controlled execution — Green Building Project Consultation (PA-78.2).) | - operational: Green-Certified Sales Associate sign-off on the workflow output
Owner: Green-Certified Sales Associate</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2726_Assoc9" sourceRef="W2726_Annotation8" targetRef="W2726_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2726_Flow10" sourceRef="W2726_Start3" targetRef="W2726_Task4" />
      <bpmn:sequenceFlow id="W2726_Flow11" sourceRef="W2726_Task4" targetRef="W2726_Task5" />
      <bpmn:sequenceFlow id="W2726_Flow12" sourceRef="W2726_Task5" targetRef="W2726_Task6" />
      <bpmn:sequenceFlow id="W2726_Flow13" sourceRef="W2726_Task6" targetRef="W2726_End7" />
    </bpmn:process>
