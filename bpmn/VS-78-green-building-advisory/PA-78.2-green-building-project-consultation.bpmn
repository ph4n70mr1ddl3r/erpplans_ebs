    <bpmn:process id="W_W2727" name="W2727. Green Home Energy Audit Referral Service" isExecutable="false">
      <bpmn:documentation>Trigger: Customer requests energy assessment
Frequency: ~20–30 requests/month
Volume: ~20–30/month
Owner: Department Supervisor
Participants: Dept Supervisor, Sustainability Coordinator, Energy Audit Partner
Source: workflow W2727 — Green Home Energy Audit Referral Service</bpmn:documentation>
      <bpmn:laneSet id="W2727_LaneSet4">
        <bpmn:lane id="W2727_Lane1" name="Department Supervisor">
        <bpmn:flowNodeRef>W2727_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2727_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2727_Lane2" name="Sustainability Coordinator">
        <bpmn:flowNodeRef>W2727_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2727_Lane3" name="Sales Associate">
        <bpmn:flowNodeRef>W2727_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2727_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2727_Start5" name="Customer requests energy assessment">
        <bpmn:outgoing>W2727_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2727_Task6" name="Department Supervisor identifies interest: high electricity bill, renovation…">
        <bpmn:documentation>Step 1: Department Supervisor identifies interest: high electricity bill, renovation, solar inquiry; offers free basic energy audit referral; explains partner auditor service
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W2727_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2727_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2727_Task7" name="Sustainability Coordinator dispatches auditor: licensed auditor visits home…">
        <bpmn:documentation>Step 2: Sustainability Coordinator dispatches auditor: licensed auditor visits home, assesses consumption, recommends BuildRight products (LED, inverter AC, solar, insulation)
Responsible (R): Sustainability Coordinator / Energy Audit Partner
Accountable (A): COO
Duration: 2–3 hours audit</bpmn:documentation>
        <bpmn:incoming>W2727_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2727_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2727_Task8" name="Sales Associate follows up: presents recommendations with savings calculations…">
        <bpmn:documentation>Step 3: Sales Associate follows up: presents recommendations with savings calculations and payback, offers bundled pricing, coordinates delivery/installation; tracks conversion rate
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 30–45 min follow-up</bpmn:documentation>
        <bpmn:incoming>W2727_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2727_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2727_End9" name="Complete">
        <bpmn:incoming>W2727_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2727_Annotation10">
        <bpmn:text>Controls: - CTL-464 (ensure controlled execution — Green Building Project Consultation (PA-78.2).) | - operational: Department Supervisor sign-off on the workflow output
Owner: Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2727_Assoc11" sourceRef="W2727_Annotation10" targetRef="W2727_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2727_Flow12" sourceRef="W2727_Start5" targetRef="W2727_Task6" />
      <bpmn:sequenceFlow id="W2727_Flow13" sourceRef="W2727_Task6" targetRef="W2727_Task7" />
      <bpmn:sequenceFlow id="W2727_Flow14" sourceRef="W2727_Task7" targetRef="W2727_Task8" />
      <bpmn:sequenceFlow id="W2727_Flow15" sourceRef="W2727_Task8" targetRef="W2727_End9" />
    </bpmn:process>
