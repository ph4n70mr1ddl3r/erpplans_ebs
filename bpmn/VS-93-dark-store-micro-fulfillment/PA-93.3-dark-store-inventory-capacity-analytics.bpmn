      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3107" name="W3107. Dark Store Throughput, Utilization &amp; Labor Productivity Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Daily/weekly KPI cycle
Frequency: Daily + weekly deep-dive
Volume: Per dark store and network-wide
Owner: Dark Store Operations Manager
Participants: Dark Store Ops Mgr, Network Planning, Finance, HR, BI (links to VS-28)
Source: workflow W3107 — Dark Store Throughput, Utilization &amp; Labor Productivity Analytics</bpmn:documentation>
      <bpmn:laneSet id="W3107_LaneSet4">
        <bpmn:lane id="W3107_Lane1" name="BI Analyst">
        <bpmn:flowNodeRef>W3107_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3107_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3107_Lane2" name="Dark Store Operations Manager">
        <bpmn:flowNodeRef>W3107_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3107_Lane3" name="HR">
        <bpmn:flowNodeRef>W3107_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3107_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3107_Start5" name="Daily/weekly KPI cycle">
        <bpmn:outgoing>W3107_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3107_Task6" name="BI (links to VS-28) computes dark-store throughput KPIs: orders/hour…">
        <bpmn:documentation>Step 1: BI (links to VS-28) computes dark-store throughput KPIs: orders/hour, lines/picker-hour, orders/pack-station-hour, dispatch on-time %, automation utilization %, labor utilization vs. plan
Responsible (R): BI Analyst
Accountable (A): Dark Store Operations Manager
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W3107_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3107_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3107_Task7" name="Dark Store Ops Mgr benchmarks dark stores vs. each other and vs. external…">
        <bpmn:documentation>Step 2: Dark Store Ops Mgr benchmarks dark stores vs. each other and vs. external benchmark; identifies laggards; investigates root causes (staffing, layout, automation downtime, demand mix)
Responsible (R): Dark Store Operations Manager
Accountable (A): VP Supply Chain
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W3107_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3107_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3107_Task8" name="HR/Finance model productivity-linked incentive, shift design, and overtime to…">
        <bpmn:documentation>Step 3: HR/Finance model productivity-linked incentive, shift design, and overtime to lift utilization; validate against labor-cost-per-order target
Responsible (R): HR / Finance
Accountable (A): VP Supply Chain
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3107_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3107_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3107_End9" name="Complete">
        <bpmn:incoming>W3107_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3107_Annotation10">
        <bpmn:text>Controls: - CTL-510 (ensure controlled execution — Dark Store Inventory, Capacity &amp; Performance Analytics (PA-93.3).) | - operational: accuracy-weighted incentive and quality audit (links to W3099)
Owner: Dark Store Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3107_Assoc11" sourceRef="W3107_Annotation10" targetRef="W3107_Start5" associationDirection="None" />
