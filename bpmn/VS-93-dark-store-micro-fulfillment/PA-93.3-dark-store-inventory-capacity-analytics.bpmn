<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-93.3-dark-store-inventory-capacity-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3105" name="W3105. Dark Store Inventory Positioning, Safety Stock &amp; Replenishment" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly cycle + daily min/max triggers
Frequency: Daily/weekly
Volume: ~2,000–8,000 active SKUs per dark store (curated for catchment)
Owner: Dark Store Operations Manager
Participants: Dark Store Ops Mgr, Inventory Planning, DC Ops (links to VS-04), Category (links to VS-01)
Source: workflow W3105 — Dark Store Inventory Positioning, Safety Stock &amp; Replenishment</bpmn:documentation>
      <bpmn:laneSet id="W3105_LaneSet4">
        <bpmn:lane id="W3105_Lane1" name="Inventory Planner">
        <bpmn:flowNodeRef>W3105_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3105_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3105_Lane2" name="WMS">
        <bpmn:flowNodeRef>W3105_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3105_Lane3" name="Dark Store Operations Manager">
        <bpmn:flowNodeRef>W3105_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3105_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3105_Start5" name="Weekly cycle + daily min/max triggers">
        <bpmn:outgoing>W3105_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3105_Task6" name="Inventory Planning sets per-SKU safety stock and reorder point for the dark…">
        <bpmn:documentation>Step 1: Inventory Planning sets per-SKU safety stock and reorder point for the dark store based on catchment velocity, lead time from feeder DC (links to VS-04), and target service level (98%+); distinguishes A/B/C velocity
Responsible (R): Inventory Planner
Accountable (A): Dark Store Operations Manager
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W3105_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3105_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3105_Task7" name="System auto-generates replenishment transfer requests to feeder DC when min…">
        <bpmn:documentation>Step 2: System auto-generates replenishment transfer requests to feeder DC when min breached; DC schedules transfer (links to VS-05/VS-04); inbound received and putaway to forward pick faces
Responsible (R): WMS / DC Ops
Accountable (A): Dark Store Operations Manager
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W3105_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3105_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3105_Task8" name="Dark Store Ops Mgr reviews slow-movers (links to VS-05 aging) and obsolete…">
        <bpmn:documentation>Step 3: Dark Store Ops Mgr reviews slow-movers (links to VS-05 aging) and obsolete candidates; returns to DC or removes from dark-store range (links to W3110); confirms physical-to-book accuracy via cycle count
Responsible (R): Dark Store Operations Manager / Inventory
Accountable (A): VP Supply Chain
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W3105_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3105_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3105_End9" name="Complete">
        <bpmn:incoming>W3105_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3105_Annotation10">
        <bpmn:text>Controls: - CTL-510 (ensure controlled execution — Dark Store Inventory, Capacity &amp; Performance Analytics (PA-93.3).) | - operational: velocity-based safety stock and same-day DC replenishment
Owner: Dark Store Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3105_Assoc11" sourceRef="W3105_Annotation10" targetRef="W3105_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3105_Flow12" sourceRef="W3105_Start5" targetRef="W3105_Task6" />
      <bpmn:sequenceFlow id="W3105_Flow13" sourceRef="W3105_Task6" targetRef="W3105_Task7" />
      <bpmn:sequenceFlow id="W3105_Flow14" sourceRef="W3105_Task7" targetRef="W3105_Task8" />
      <bpmn:sequenceFlow id="W3105_Flow15" sourceRef="W3105_Task8" targetRef="W3105_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3105_diag">
      <bpmndi:BPMNPlane id="W3105_plane" bpmnElement="W_W3105">
        <bpmndi:BPMNShape id="W3105_Lane1_di" bpmnElement="W3105_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
