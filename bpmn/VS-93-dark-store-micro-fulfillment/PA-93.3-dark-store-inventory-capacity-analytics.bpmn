    <bpmn:process id="W_W3108" name="W3108. Dark Store Order Cycle Time, Cut-Off Adherence &amp; SLA Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Daily SLA cycle; SLA breach
Frequency: Daily
Volume: All orders
Owner: Dark Store Operations Manager
Participants: Dark Store Ops Mgr, Ecommerce Ops (links to VS-60), CS (links to VS-13), BI
Source: workflow W3108 — Dark Store Order Cycle Time, Cut-Off Adherence &amp; SLA Reporting</bpmn:documentation>
      <bpmn:laneSet id="W3108_LaneSet4">
        <bpmn:lane id="W3108_Lane1" name="WMS">
        <bpmn:flowNodeRef>W3108_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3108_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3108_Lane2" name="Dark Store Operations Manager">
        <bpmn:flowNodeRef>W3108_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3108_Lane3" name="Ecommerce Ops">
        <bpmn:flowNodeRef>W3108_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3108_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3108_Start5" name="Daily SLA cycle; SLA breach">
        <bpmn:outgoing>W3108_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3108_Task6" name="System tracks end-to-end order cycle time: order received → wave release → pick…">
        <bpmn:documentation>Step 1: System tracks end-to-end order cycle time: order received → wave release → pick complete → pack complete → dispatch → delivery/handover; segments by promise tier (same-day, next-day, BOPIS)
Responsible (R): WMS / BI
Accountable (A): Dark Store Operations Manager
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W3108_Flow12</bpmn:incoming>
