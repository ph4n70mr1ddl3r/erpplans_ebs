    <bpmn:process id="W_W3106" name="W3106. Dark Store Slotting, Velocity Analysis &amp; Re-Slotting" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly slotting review; seasonal/sale velocity shift
Frequency: Monthly + event-driven
Volume: All pick faces
Owner: Dark Store Operations Manager
Participants: Dark Store Ops Mgr, Industrial Engineer, Pickers
Source: workflow W3106 — Dark Store Slotting, Velocity Analysis &amp; Re-Slotting</bpmn:documentation>
      <bpmn:laneSet id="W3106_LaneSet3">
        <bpmn:lane id="W3106_Lane1" name="Industrial Engineer">
        <bpmn:flowNodeRef>W3106_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3106_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3106_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3106_Lane2" name="Picker">
        <bpmn:flowNodeRef>W3106_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3106_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3106_Start4" name="Monthly slotting review; seasonal/sale velocity shift">
        <bpmn:outgoing>W3106_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3106_Task5" name="Industrial Engineer computes SKU velocity (lines/day, picks/day) and current…">
        <bpmn:documentation>Step 1: Industrial Engineer computes SKU velocity (lines/day, picks/day) and current slot location; identifies A-velocity SKUs in non-golden-zone slots and C-velocity SKUs consuming golden-zone space
Responsible (R): Industrial Engineer
Accountable (A): Dark Store Operations Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3106_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3106_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3106_Task6" name="Engineer proposes re-slot plan: A-velocity → eye-level/golden zone nearest pack…">
        <bpmn:documentation>Step 2: Engineer proposes re-slot plan: A-velocity → eye-level/golden zone nearest pack stations; C-velocity → reserve/upper; bundle/kit components co-located; automation (MFC) bins re-balanced
Responsible (R): Industrial Engineer
Accountable (A): Dark Store Operations Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3106_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3106_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3106_Task7" name="Picker execute re-slot during low-volume window (overnight/early AM); WMS…">
        <bpmn:documentation>Step 3: Picker execute re-slot during low-volume window (overnight/early AM); WMS updates bin assignments; productivity uplift measured post-implementation vs. baseline lines/picker-hour (links to W3107)
Responsible (R): Picker / WMS
Accountable (A): Dark Store Operations Manager
Duration: Per re-slot event</bpmn:documentation>
        <bpmn:incoming>W3106_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3106_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3106_End8" name="Complete">
        <bpmn:incoming>W3106_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3106_Annotation9">
        <bpmn:text>Controls: - CTL-510 (ensure controlled execution — Dark Store Inventory, Capacity &amp; Performance Analytics (PA-93.3).) | - operational: overnight execution and phased moves
Owner: Dark Store Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3106_Assoc10" sourceRef="W3106_Annotation9" targetRef="W3106_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3106_Flow11" sourceRef="W3106_Start4" targetRef="W3106_Task5" />
      <bpmn:sequenceFlow id="W3106_Flow12" sourceRef="W3106_Task5" targetRef="W3106_Task6" />
      <bpmn:sequenceFlow id="W3106_Flow13" sourceRef="W3106_Task6" targetRef="W3106_Task7" />
      <bpmn:sequenceFlow id="W3106_Flow14" sourceRef="W3106_Task7" targetRef="W3106_End8" />
    </bpmn:process>
