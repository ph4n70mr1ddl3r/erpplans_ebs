        <bpmn:outgoing>W3102_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3102_Task6" name="System enforces published cut-offs per zone/promise (e.g., same-day order…">
        <bpmn:documentation>Step 1: System enforces published cut-offs per zone/promise (e.g., same-day order before 2 PM in Metro Manila Zone 1); auto-extends promise to next tier when cut-off passed; communicates updated promise to customer at checkout (links to VS-10)
Responsible (R): WMS / OMS
Accountable (A): GM, Digital Commerce Inc.
Duration: Automated + daily review</bpmn:documentation>
        <bpmn:incoming>W3102_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3102_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3102_Task7" name="Dark Store Shift Supervisor runs SLA watchlist: orders within 30 min of breach…">
        <bpmn:documentation>Step 2: Dark Store Shift Supervisor runs SLA watchlist: orders within 30 min of breach flagged red; reprioritizes pick/pack/dispatch, swaps rider/carrier, or escalates to supervisor/CS to preempt customer complaint
Responsible (R): Dark Store Shift Supervisor
Accountable (A): Dark Store Operations Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3102_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3102_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3102_Task8" name="CS (links to VS-13) proactively notifies customers of any SLA miss with apology…">
        <bpmn:documentation>Step 3: CS (links to VS-13) proactively notifies customers of any SLA miss with apology and remediation (credit, loyalty points, free delivery); root-cause feeds into PA-93.3 analytics
Responsible (R): Customer Service
Accountable (A): GM, Digital Commerce Inc.
Duration: Per breach</bpmn:documentation>
        <bpmn:incoming>W3102_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3102_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3102_End9" name="Complete">
        <bpmn:incoming>W3102_Flow15</bpmn:incoming>
      </bpmn:endEvent>
