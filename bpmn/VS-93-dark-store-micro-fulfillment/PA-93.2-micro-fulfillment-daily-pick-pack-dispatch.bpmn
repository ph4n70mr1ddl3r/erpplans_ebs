      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3098" name="W3098. Multi-Order Batch Picking &amp; RF/Automation-Guided Walk Optimization" isExecutable="false">
      <bpmn:documentation>Trigger: Wave released to floor
Frequency: Continuous during operating hours
Volume: Target ≥ 80 lines/picker-hour (manual) / ≥ 150 lines/picker-hour (MFC automation)
Owner: Dark Store Shift Supervisor
Participants: Pickers, Dark Store Shift Supervisor, Automation (if MFC)
Source: workflow W3098 — Multi-Order Batch Picking &amp; RF/Automation-Guided Walk Optimization</bpmn:documentation>
      <bpmn:laneSet id="W3098_LaneSet2">
        <bpmn:lane id="W3098_Lane1" name="Picker">
        <bpmn:flowNodeRef>W3098_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3098_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3098_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3098_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3098_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3098_Start3" name="Wave released to floor">
        <bpmn:outgoing>W3098_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3098_Task4" name="Picker follows RF/automation-guided walk sequence (optimized for shortest path…">
        <bpmn:documentation>Step 1: Picker follows RF/automation-guided walk sequence (optimized for shortest path / goods-to-person bin delivery); scans bin and item at each pick face; confirms quantity against pick label/tote
Responsible (R): Picker
Accountable (A): Dark Store Shift Supervisor
Duration: Per wave</bpmn:documentation>
        <bpmn:incoming>W3098_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3098_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3098_Task5" name="Multi-order batch pick: picker places each picked line into the correct…">
        <bpmn:documentation>Step 2: Multi-order batch pick: picker places each picked line into the correct customer tote/order partition (sort-while-picking); system validates scan-to-tote to prevent wrong-order placement
Responsible (R): Picker
Accountable (A): Dark Store Shift Supervisor
Duration: Per wave</bpmn:documentation>
        <bpmn:incoming>W3098_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3098_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3098_Task6" name="On short-pick (stockout, damaged): picker marks reason code in WMS; system…">
        <bpmn:documentation>Step 3: On short-pick (stockout, damaged): picker marks reason code in WMS; system triggers substitute suggestion (links to VS-01 substitute logic) or short-ship / cancel per customer-eligible rule; for high-value/fragile, escalate to Supervisor
Responsible (R): Picker / WMS
Accountable (A): Dark Store Shift Supervisor
Duration: Per exception</bpmn:documentation>
        <bpmn:incoming>W3098_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3098_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3098_End7" name="Complete">
        <bpmn:incoming>W3098_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3098_Annotation8">
        <bpmn:text>Controls: - CTL-77 (ensure dark-store order accuracy &amp; dispatch control.) | - operational: scan-to-tote, weight-check at pack station, and picker accuracy KPI
Owner: Dark Store Shift Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3098_Assoc9" sourceRef="W3098_Annotation8" targetRef="W3098_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3098_Flow10" sourceRef="W3098_Start3" targetRef="W3098_Task4" />
      <bpmn:sequenceFlow id="W3098_Flow11" sourceRef="W3098_Task4" targetRef="W3098_Task5" />
      <bpmn:sequenceFlow id="W3098_Flow12" sourceRef="W3098_Task5" targetRef="W3098_Task6" />
      <bpmn:sequenceFlow id="W3098_Flow13" sourceRef="W3098_Task6" targetRef="W3098_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3098_diag">
