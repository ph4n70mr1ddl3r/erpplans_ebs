<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-93.2-micro-fulfillment-daily-pick-pack-dispatch" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3097" name="W3097. Dark Store Order Wave Planning &amp; Batch Release" isExecutable="false">
      <bpmn:documentation>Trigger: Continuous order intake; cut-off windows; batch release schedule
Frequency: 6–12 wave releases per day per dark store
Volume: ~50–400 orders per wave; ~1,000–5,000 lines/day per dark store
Owner: Dark Store Shift Supervisor
Participants: Dark Store Shift Supervisor, WMS, Pickers, Packers, Dispatch
Source: workflow W3097 — Dark Store Order Wave Planning &amp; Batch Release</bpmn:documentation>
      <bpmn:laneSet id="W3097_LaneSet3">
        <bpmn:lane id="W3097_Lane1" name="WMS">
        <bpmn:flowNodeRef>W3097_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3097_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3097_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3097_Lane2" name="Dark Store Shift Supervisor">
        <bpmn:flowNodeRef>W3097_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3097_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3097_Start4" name="Continuous order intake; cut-off windows; batch release schedule">
        <bpmn:outgoing>W3097_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3097_Task5" name="WMS continuously aggregates eligible orders (links to VS-60) into a wave plan…">
        <bpmn:documentation>Step 1: WMS continuously aggregates eligible orders (links to VS-60) into a wave plan: group by SLA tier (same-day, next-day, BOPIS), cut-off, dispatch route/zone, and item overlap; respects promised time and rider/3PL capacity
Responsible (R): WMS / Dark Store Shift Supervisor
Accountable (A): Dark Store Shift Supervisor
Duration: Per wave (5–10 min)</bpmn:documentation>
        <bpmn:incoming>W3097_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3097_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3097_Task6" name="Dark Store Shift Supervisor reviews proposed wave: volume vs. staffing…">
        <bpmn:documentation>Step 2: Dark Store Shift Supervisor reviews proposed wave: volume vs. staffing, automation availability, hot-orders, known stockouts/substitutes; adjusts wave size and releases batch to pick
Responsible (R): Dark Store Shift Supervisor
Accountable (A): Dark Store Operations Manager
Duration: 5 min/wave</bpmn:documentation>
        <bpmn:incoming>W3097_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3097_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W3097_Task7" name="System reserves inventory against wave (atomic reservation to prevent…">
        <bpmn:documentation>Step 3: System reserves inventory against wave (atomic reservation to prevent oversell), prints pick labels / pushes to RF guns / dispatches goods-to-person bins; flags short-pick candidates for substitute approval
Responsible (R): WMS
Accountable (A): Dark Store Shift Supervisor
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W3097_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3097_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W3097_End8" name="Complete">
        <bpmn:incoming>W3097_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3097_Annotation9">
        <bpmn:text>Controls: - CTL-509 (ensure controlled execution — Micro-Fulfillment Daily Pick / Pack / Dispatch Operations (PA-93.2).) | - operational: atomic reservation and real-time sync to ecommerce (links to VS-10)
Owner: Dark Store Shift Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3097_Assoc10" sourceRef="W3097_Annotation9" targetRef="W3097_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3097_Flow11" sourceRef="W3097_Start4" targetRef="W3097_Task5" />
      <bpmn:sequenceFlow id="W3097_Flow12" sourceRef="W3097_Task5" targetRef="W3097_Task6" />
      <bpmn:sequenceFlow id="W3097_Flow13" sourceRef="W3097_Task6" targetRef="W3097_Task7" />
      <bpmn:sequenceFlow id="W3097_Flow14" sourceRef="W3097_Task7" targetRef="W3097_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3097_diag">
      <bpmndi:BPMNPlane id="W3097_plane" bpmnElement="W_W3097">
        <bpmndi:BPMNShape id="W3097_Lane1_di" bpmnElement="W3097_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3097_Lane2_di" bpmnElement="W3097_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
