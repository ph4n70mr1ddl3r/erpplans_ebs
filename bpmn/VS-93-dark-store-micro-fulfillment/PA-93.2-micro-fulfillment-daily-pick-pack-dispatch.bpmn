        <bpmndi:BPMNShape id="W3098_Annotation8_di" bpmnElement="W3098_Annotation8"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3098_Flow10_di" bpmnElement="W3098_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3098_Flow11_di" bpmnElement="W3098_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3098_Flow12_di" bpmnElement="W3098_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3098_Flow13_di" bpmnElement="W3098_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3098_Assoc9_di" bpmnElement="W3098_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3099" name="W3099. Pack Station Operations, Quality Check &amp; Right-Box Selection" isExecutable="false">
      <bpmn:documentation>Trigger: Pick complete; tote arrives at pack station
Frequency: Continuous
Volume: Target ≥ 30 orders/pack-station-hour
Owner: Dark Store Shift Supervisor
Participants: Packers, Quality Checker, Dark Store Shift Supervisor
Source: workflow W3099 — Pack Station Operations, Quality Check &amp; Right-Box Selection</bpmn:documentation>
      <bpmn:laneSet id="W3099_LaneSet3">
        <bpmn:lane id="W3099_Lane1" name="Packer">
        <bpmn:flowNodeRef>W3099_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3099_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3099_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3099_Lane2" name="Quality Checker">
        <bpmn:flowNodeRef>W3099_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3099_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3099_Start4" name="Pick complete; tote arrives at pack station">
        <bpmn:outgoing>W3099_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3099_Task5" name="Packer scans order/tote at pack station; system displays items expected with…">
        <bpmn:documentation>Step 1: Packer scans order/tote at pack station; system displays items expected with images and pack instructions (fragile orientation, hazmat rules — links to VS-24, cold/chemical — links to VS-73); packer scans each item to confirm correctness
Responsible (R): Packer
Accountable (A): Dark Store Shift Supervisor
Duration: 1–3 min/order</bpmn:documentation>
        <bpmn:incoming>W3099_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3099_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3099_Task6" name="System auto-suggests carton size based on cube (dimensioner or item…">
        <bpmn:documentation>Step 2: System auto-suggests carton size based on cube (dimensioner or item dimensions); packer packs, void-fills, seals; weight-check station validates packed weight vs. expected tolerance; out-of-tolerance orders held for Quality
Responsible (R): Packer / WMS
Accountable (A): Dark Store Shift Supervisor
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W3099_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3099_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3099_Task7" name="Quality Checker performs AQL sample audit (e.g., 1 in 50): correct items…">
        <bpmn:documentation>Step 3: Quality Checker performs AQL sample audit (e.g., 1 in 50): correct items, quantity, presentation, invoice/packing slip, gift/messages; defects logged and fed back to picker/packer accuracy KPI
Responsible (R): Quality Checker
Accountable (A): Dark Store Shift Supervisor
Duration: Per sample</bpmn:documentation>
        <bpmn:incoming>W3099_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3099_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3099_End8" name="Complete">
        <bpmn:incoming>W3099_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3099_Annotation9">
        <bpmn:text>Controls: - CTL-77 (ensure dark-store order accuracy &amp; dispatch control.) | - operational: scan-to-pack and weight tolerance
Owner: Dark Store Shift Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3099_Assoc10" sourceRef="W3099_Annotation9" targetRef="W3099_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3099_Flow11" sourceRef="W3099_Start4" targetRef="W3099_Task5" />
      <bpmn:sequenceFlow id="W3099_Flow12" sourceRef="W3099_Task5" targetRef="W3099_Task6" />
      <bpmn:sequenceFlow id="W3099_Flow13" sourceRef="W3099_Task6" targetRef="W3099_Task7" />
      <bpmn:sequenceFlow id="W3099_Flow14" sourceRef="W3099_Task7" targetRef="W3099_End8" />
    </bpmn:process>
