    <bpmn:process id="W_W3104" name="W3104. Dark Store Returns, Reverse Putaway &amp; Exception Handling" isExecutable="false">
      <bpmn:documentation>Trigger: Customer returns ecommerce/dark-store order; damaged-in-transit; mis-pick; undeliverable
Frequency: ~2–5% return rate (links to VS-32)
Volume: Per dark store
Owner: Dark Store Shift Supervisor
Participants: Returns Clerk, Quality, Inventory, CS (links to VS-13), AP/AR
Source: workflow W3104 — Dark Store Returns, Reverse Putaway &amp; Exception Handling</bpmn:documentation>
      <bpmn:laneSet id="W3104_LaneSet4">
        <bpmn:lane id="W3104_Lane1" name="Returns Clerk">
        <bpmn:flowNodeRef>W3104_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3104_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3104_Lane2" name="Quality">
        <bpmn:flowNodeRef>W3104_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3104_Lane3" name="Finance">
        <bpmn:flowNodeRef>W3104_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3104_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3104_Start5" name="Customer returns ecommerce/dark-store order; damaged-in-transit; mis-pick; undeliverable">
        <bpmn:outgoing>W3104_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3104_Task6" name="Returns Clerk receives returned/undeliverable parcel; scans order; matches to…">
        <bpmn:documentation>Step 1: Returns Clerk receives returned/undeliverable parcel; scans order; matches to original shipment; inspects condition (A/B/C/D, saleable/not); logs disposition reason and photos
Responsible (R): Returns Clerk
Accountable (A): Dark Store Shift Supervisor
Duration: Per return (3–5 min)</bpmn:documentation>
        <bpmn:incoming>W3104_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3104_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3104_Task7" name="Quality/Inventory route to disposition: sellable → reverse putaway to pick face…">
        <bpmn:documentation>Step 2: Quality/Inventory route to disposition: sellable → reverse putaway to pick face (links to VS-05); damaged → damage/claim workflow (links to VS-90); vendor-return → VS-32; dispose → VS-73
Responsible (R): Quality / Inventory
Accountable (A): Dark Store Shift Supervisor
Duration: Per return</bpmn:documentation>
        <bpmn:incoming>W3104_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3104_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3104_Task8" name="Finance/CS process refund (links to VS-80) and any restocking fee per policy…">
        <bpmn:documentation>Step 3: Finance/CS process refund (links to VS-80) and any restocking fee per policy; for courier-attributable damage, file claim with carrier (links to VS-56/VS-90); update customer via CS
Responsible (R): Finance / CS
Accountable (A): Dark Store Operations Manager
Duration: Per return</bpmn:documentation>
        <bpmn:incoming>W3104_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3104_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3104_End9" name="Complete">
        <bpmn:incoming>W3104_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3104_Annotation10">
        <bpmn:text>Controls: - CTL-77 (ensure dark-store order accuracy &amp; dispatch control.) | - operational: inspection, weight check, and serial tracking
Owner: Dark Store Shift Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3104_Assoc11" sourceRef="W3104_Annotation10" targetRef="W3104_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3104_Flow12" sourceRef="W3104_Start5" targetRef="W3104_Task6" />
      <bpmn:sequenceFlow id="W3104_Flow13" sourceRef="W3104_Task6" targetRef="W3104_Task7" />
      <bpmn:sequenceFlow id="W3104_Flow14" sourceRef="W3104_Task7" targetRef="W3104_Task8" />
      <bpmn:sequenceFlow id="W3104_Flow15" sourceRef="W3104_Task8" targetRef="W3104_End9" />
    </bpmn:process>
