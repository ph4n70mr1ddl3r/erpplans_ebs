      <bpmndi:BPMNPlane id="W3099_plane" bpmnElement="W_W3099">
        <bpmndi:BPMNShape id="W3099_Lane1_di" bpmnElement="W3099_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3099_Lane2_di" bpmnElement="W3099_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3099_Task5_di" bpmnElement="W3099_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3099_Task6_di" bpmnElement="W3099_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3099_Task7_di" bpmnElement="W3099_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3099_Start4_di" bpmnElement="W3099_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3099_End8_di" bpmnElement="W3099_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3099_Annotation9_di" bpmnElement="W3099_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3099_Flow11_di" bpmnElement="W3099_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3099_Flow12_di" bpmnElement="W3099_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3099_Flow13_di" bpmnElement="W3099_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3099_Flow14_di" bpmnElement="W3099_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3099_Assoc10_di" bpmnElement="W3099_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3100" name="W3100. Pack-Station Consumables, Labeling &amp; Manifest Management" isExecutable="false">
      <bpmn:documentation>Trigger: Shift start; low-stock alerts; daily consumables plan
Frequency: Daily + event-driven
Volume: ~300–4,800 cartons consumed/day per dark store (one per order, per W3097&#x27;s wave volumes) drawn from ~10–20 carton sizes on hand, plus labels, void-fill, tape, ribbons
Owner: Dark Store Shift Supervisor
Participants: Packers, Inventory/Stores Clerk, Procurement (links to VS-34)
Source: workflow W3100 — Pack-Station Consumables, Labeling &amp; Manifest Management</bpmn:documentation>
      <bpmn:laneSet id="W3100_LaneSet3">
        <bpmn:lane id="W3100_Lane1" name="WMS">
        <bpmn:flowNodeRef>W3100_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3100_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3100_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3100_Lane2" name="Stores Clerk">
        <bpmn:flowNodeRef>W3100_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3100_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3100_Start4" name="Shift start; low-stock alerts; daily consumables plan">
        <bpmn:outgoing>W3100_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3100_Task5" name="System prints shipping labels and packing slips (BIR-compliant invoice for the…">
        <bpmn:documentation>Step 1: System prints shipping labels and packing slips (BIR-compliant invoice for the customer&#x27;s tender — links to VS-79); integrates address validation; applies promotional inserts, return labels, and multi-language instructions per destination
Responsible (R): WMS / Packer
Accountable (A): Dark Store Shift Supervisor
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W3100_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3100_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3100_Task6" name="Stores Clerk monitors consumables inventory (cartons by size, void-fill, tape…">
        <bpmn:documentation>Step 2: Stores Clerk monitors consumables inventory (cartons by size, void-fill, tape, labels, ribbons, hazmat labels) and replenishes pack stations; min/max triggers replenishment from reserve or procurement via VS-34
Responsible (R): Stores Clerk
Accountable (A): Dark Store Shift Supervisor
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W3100_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3100_Flow13</bpmn:outgoing>
      </bpmn:userTask>
