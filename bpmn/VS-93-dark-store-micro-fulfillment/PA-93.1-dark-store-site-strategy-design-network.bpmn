      <bpmn:userTask id="W3093_Task6" name="Dark Store Ops Mgr builds staffing model by zone/shift from forecasted…">
        <bpmn:documentation>Step 1: Dark Store Ops Mgr builds staffing model by zone/shift from forecasted orders/hour, productivity standards (lines/picker-hour, orders/pack-station-hour), peak cover, and 2–3 shift design; validates vs. financial case
Responsible (R): Dark Store Operations Manager
Accountable (A): VP Supply Chain
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W3093_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3093_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3093_Task7" name="HR executes recruitment, pre-employment checks, and onboarding per VS-19 (incl…">
        <bpmn:documentation>Step 2: HR executes recruitment, pre-employment checks, and onboarding per VS-19 (incl. statutory SSS/PhilHealth/Pag-IBIG, contracts, biometric T&amp;A); priority hire from local barangay per community-engagement policy
Responsible (R): HR Business Partner
Accountable (A): HR Manager
Duration: 4–8 weeks</bpmn:documentation>
        <bpmn:incoming>W3093_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3093_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3093_Task8" name="Learning &amp; Dev delivers dark-store training: WMS/handheld use, pick/pack…">
        <bpmn:documentation>Step 3: Learning &amp; Dev delivers dark-store training: WMS/handheld use, pick/pack standard work, quality/accuracy controls, safety (manual handling, automation, fire — links to VS-24), anti-fraud (links to VS-23); certifies before solo work
Responsible (R): Learning &amp; Dev / Dark Store Ops
Accountable (A): Dark Store Operations Manager
Duration: 1–2 weeks per cohort</bpmn:documentation>
        <bpmn:incoming>W3093_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3093_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3093_End9" name="Complete">
        <bpmn:incoming>W3093_Flow15</bpmn:incoming>
      </bpmn:endEvent>
