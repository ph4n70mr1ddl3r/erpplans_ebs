    <bpmn:process id="W_W3092" name="W3092. Dark Store System Integration, WMS &amp; Robotics Commissioning" isExecutable="false">
      <bpmn:documentation>Trigger: Build-out complete; pre-go-live
Frequency: Per site + major upgrade
Volume: Per dark store / MFC
Owner: IT – Applications
Participants: IT Apps, IT Integration, Automation Vendor, Dark Store Ops Mgr, Quality
Source: workflow W3092 — Dark Store System Integration, WMS &amp; Robotics Commissioning</bpmn:documentation>
      <bpmn:laneSet id="W3092_LaneSet4">
        <bpmn:lane id="W3092_Lane1" name="IT – Applications">
        <bpmn:flowNodeRef>W3092_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3092_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3092_Lane2" name="IT – Integration">
        <bpmn:flowNodeRef>W3092_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3092_Lane3" name="Automation Vendor">
        <bpmn:flowNodeRef>W3092_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3092_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3092_Start5" name="Build-out complete; pre-go-live">
        <bpmn:outgoing>W3092_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3092_Task6" name="IT configures dark-store WMS extension: bin/barcode schema, wave/batch pick…">
        <bpmn:documentation>Step 1: IT configures dark-store WMS extension: bin/barcode schema, wave/batch pick algorithms, pack-station integration, dispatch/load planning, cycle-count plan; integrates to enterprise WMS (VS-04) and OMS (VS-60)
Responsible (R): IT – Applications
Accountable (A): IT – Applications Manager
Duration: 4–6 weeks</bpmn:documentation>
        <bpmn:incoming>W3092_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3092_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3092_Task7" name="IT Integration wires up critical feeds: real-time order push from OMS (links to…">
        <bpmn:documentation>Step 2: IT Integration wires up critical feeds: real-time order push from OMS (links to VS-60), inventory sync to enterprise inventory &amp; ecommerce (VS-10), carrier/3PL dispatch API (links to VS-56), loyalty/customer master (VS-13)
Responsible (R): IT – Integration
Accountable (A): IT – Applications Manager
Duration: 3–4 weeks</bpmn:documentation>
        <bpmn:incoming>W3092_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3092_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3092_Task8" name="Vendor/IT run commissioning: automation dry-run, end-to-end pick-pack-dispatch…">
        <bpmn:documentation>Step 3: Vendor/IT run commissioning: automation dry-run, end-to-end pick-pack-dispatch dress rehearsal, peak-volume stress test, failover/fallback (manual mode) drill, and go/no-go sign-off with Dark Store Ops Mgr
Responsible (R): Automation Vendor / IT (in-suite WMS — Oracle WMS/MSCA)
Accountable (A): Dark Store Operations Manager
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W3092_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3092_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3092_End9" name="Complete">
        <bpmn:incoming>W3092_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3092_Annotation10">
        <bpmn:text>Controls: - CTL-508 (ensure controlled execution — Dark Store Site Strategy, Design &amp; Network Planning (PA-93.1).) | - operational: reservation, hard cut-over test, and 2-week hyper-care
Owner: IT – Applications</bpmn:text>
      </bpmn:textAnnotation>
