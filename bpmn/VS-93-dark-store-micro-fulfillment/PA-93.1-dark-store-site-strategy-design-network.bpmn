    <bpmn:process id="W_W3095" name="W3095. Dark Store Capacity Planning &amp; Expansion Triggers" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly capacity review or SLA degradation
Frequency: Monthly + event-driven
Volume: Per dark store
Owner: Dark Store Operations Manager
Participants: Dark Store Ops Mgr, Network Planning, Finance, HR, IT
Source: workflow W3095 — Dark Store Capacity Planning &amp; Expansion Triggers</bpmn:documentation>
      <bpmn:laneSet id="W3095_LaneSet4">
        <bpmn:lane id="W3095_Lane1" name="Dark Store Operations Manager">
        <bpmn:flowNodeRef>W3095_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3095_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3095_Lane2" name="Network Planning">
        <bpmn:flowNodeRef>W3095_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3095_Lane3" name="Finance Analyst">
        <bpmn:flowNodeRef>W3095_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3095_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3095_Start5" name="Monthly capacity review or SLA degradation">
        <bpmn:outgoing>W3095_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3095_Task6" name="Dark Store Ops Mgr reviews rolling 13-week capacity: forecasted orders/day vs…">
        <bpmn:documentation>Step 1: Dark Store Ops Mgr reviews rolling 13-week capacity: forecasted orders/day vs. demonstrated peak-hour throughput, labor availability, automation capacity, dispatch-bay/rider staging capacity; flags bottlenecks
Responsible (R): Dark Store Operations Manager
Accountable (A): VP Supply Chain
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3095_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3095_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3095_Task7" name="When utilization ≥ 80% sustained or SLA dips below target: trigger expansion…">
        <bpmn:documentation>Step 2: When utilization ≥ 80% sustained or SLA dips below target: trigger expansion menu — add shifts, extend cut-off, re-slot velocity, add pack stations, MFC automation bolt-on, or open a new dark store (links to W3090)
Responsible (R): Network Planning / Dark Store Ops Mgr
Accountable (A): VP Supply Chain
Duration: Per trigger</bpmn:documentation>
        <bpmn:incoming>W3095_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3095_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3095_Task8" name="Finance/SC validate capex/ROI for any automation or new-site trigger; submit…">
        <bpmn:documentation>Step 3: Finance/SC validate capex/ROI for any automation or new-site trigger; submit via VS-40 capex workflow; HR pre-recruits against expansion plan
Responsible (R): Finance Analyst / HR
Accountable (A): CFO / VP Supply Chain
Duration: Per trigger</bpmn:documentation>
        <bpmn:incoming>W3095_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3095_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3095_End9" name="Complete">
