<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-93.1-dark-store-site-strategy-design-network" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3089" name="W3089. Dark Store Network Strategy &amp; Market Catchment Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Ecommerce penetration target breach, market expansion, or strategic review
Frequency: Annual strategic review + event-driven
Volume: Enterprise-wide; ~3–6 candidate dark-store markets
Owner: VP Supply Chain
Participants: VP Supply Chain, GM, Digital Commerce Inc., Real Estate Mgr, Finance, IT, Network Planning
Source: workflow W3089 — Dark Store Network Strategy &amp; Market Catchment Analysis</bpmn:documentation>
      <bpmn:laneSet id="W3089_LaneSet3">
        <bpmn:lane id="W3089_Lane1" name="Network Planning Analyst">
        <bpmn:flowNodeRef>W3089_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3089_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3089_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3089_Lane2" name="VP Supply Chain">
        <bpmn:flowNodeRef>W3089_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3089_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3089_Start4" name="Ecommerce penetration target breach, market expansion, or strategic review">
        <bpmn:outgoing>W3089_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3089_Task5" name="Network Planning aggregates 18-month ecommerce demand by barangay/pincode using…">
        <bpmn:documentation>Step 1: Network Planning aggregates 18-month ecommerce demand by barangay/pincode using order history (links to VS-10), population density, smartphone penetration, and competitor dark-store presence; maps demand heat-zones per Metro Manila / Cebu / Davao cores
Responsible (R): Network Planning Analyst
Accountable (A): VP Supply Chain
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W3089_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3089_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3089_Task6" name="Network Planning runs catchment modeling: for each candidate site, compute…">
        <bpmn:documentation>Step 2: Network Planning runs catchment modeling: for each candidate site, compute 2-hour / 4-hour / same-day / next-day addressable order volume vs. current ship-from-store (VS-10) and DC (VS-04) cost-per-order baselines
Responsible (R): Network Planning Analyst
Accountable (A): VP Supply Chain
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W3089_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3089_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3089_Task7" name="Steering committee (VP Supply Chain, GM, Digital Commerce Inc., CFO, CIO)…">
        <bpmn:documentation>Step 3: Steering committee (VP Supply Chain, GM, Digital Commerce Inc., CFO, CIO) selects network plan: number of dark stores, MFC vs. manual format, phasing, and capex envelope; links to VS-33 strategic plan and VS-40 capex
Responsible (R): VP Supply Chain
Accountable (A): CEO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W3089_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3089_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3089_End8" name="Complete">
        <bpmn:incoming>W3089_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3089_Annotation9">
        <bpmn:text>Controls: - CTL-508 (ensure controlled execution — Dark Store Site Strategy, Design &amp; Network Planning (PA-93.1).) | - operational: phased capex, modular MFC format, and 18-month rolling reforecast
Owner: VP Supply Chain</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3089_Assoc10" sourceRef="W3089_Annotation9" targetRef="W3089_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3089_Flow11" sourceRef="W3089_Start4" targetRef="W3089_Task5" />
      <bpmn:sequenceFlow id="W3089_Flow12" sourceRef="W3089_Task5" targetRef="W3089_Task6" />
      <bpmn:sequenceFlow id="W3089_Flow13" sourceRef="W3089_Task6" targetRef="W3089_Task7" />
      <bpmn:sequenceFlow id="W3089_Flow14" sourceRef="W3089_Task7" targetRef="W3089_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3089_diag">
      <bpmndi:BPMNPlane id="W3089_plane" bpmnElement="W_W3089">
        <bpmndi:BPMNShape id="W3089_Lane1_di" bpmnElement="W3089_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3089_Lane2_di" bpmnElement="W3089_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3089_Task5_di" bpmnElement="W3089_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3089_Task6_di" bpmnElement="W3089_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3089_Task7_di" bpmnElement="W3089_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3089_Start4_di" bpmnElement="W3089_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3089_End8_di" bpmnElement="W3089_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3089_Annotation9_di" bpmnElement="W3089_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3089_Flow11_di" bpmnElement="W3089_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3089_Flow12_di" bpmnElement="W3089_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3089_Flow13_di" bpmnElement="W3089_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3089_Flow14_di" bpmnElement="W3089_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3089_Assoc10_di" bpmnElement="W3089_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3090" name="W3090. Dark Store Site Selection, Lease &amp; Build-Out" isExecutable="false">
      <bpmn:documentation>Trigger: Approved network plan identifies a new site
Frequency: Per new dark store (~1–2 sites/year at maturity)
Volume: ~1,500–3,000 sqm per dark store; 300–800 sqm per MFC
Owner: Real Estate Manager
Participants: Real Estate Mgr, VP Supply Chain, Facilities, Legal, Finance, IT
Source: workflow W3090 — Dark Store Site Selection, Lease &amp; Build-Out</bpmn:documentation>
      <bpmn:laneSet id="W3090_LaneSet4">
        <bpmn:lane id="W3090_Lane1" name="Real Estate Manager">
        <bpmn:flowNodeRef>W3090_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3090_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3090_Lane2" name="Legal Counsel">
        <bpmn:flowNodeRef>W3090_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3090_Lane3" name="Facilities Manager">
        <bpmn:flowNodeRef>W3090_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3090_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3090_Start5" name="Approved network plan identifies a new site">
        <bpmn:outgoing>W3090_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3090_Task6" name="Real Estate Manager screens candidate properties against dark-store criteria…">
        <bpmn:documentation>Step 1: Real Estate Manager screens candidate properties against dark-store criteria: catchment fit, last-mile access (rider/driver ingress/egress), ceiling height (≥6 m for mezzanine/automation), floor load, power (esp. for MFC automation), zoning/LGU permits, landlord build-out allowance
Responsible (R): Real Estate Manager
Accountable (A): COO
Duration: 4–8 weeks</bpmn:documentation>
        <bpmn:incoming>W3090_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3090_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3090_Task7" name="Legal/Real Estate negotiate lease: base rent, escalation, CAM, fit-out…">
        <bpmn:documentation>Step 2: Legal/Real Estate negotiate lease: base rent, escalation, CAM, fit-out allowance, exclusivity (no competitor), assignment/sublease, early-termination; Real Estate confirms LGU business permit path per VS-76
Responsible (R): Legal Counsel / Real Estate Manager
Accountable (A): COO
Duration: 4–6 weeks</bpmn:documentation>
        <bpmn:incoming>W3090_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3090_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3090_Task8" name="Facilities Manager runs build-out: floor reinforcement, racking/mezzanine…">
        <bpmn:documentation>Step 3: Facilities Manager runs build-out: floor reinforcement, racking/mezzanine, electrical/power back-up (generator per VS-20), HVAC, lighting, security (CCTV per VS-23), IT/data; integrate to VS-20 real estate and VS-27 IT
Responsible (R): Facilities Manager
Accountable (A): VP Supply Chain
Duration: 8–16 weeks</bpmn:documentation>
        <bpmn:incoming>W3090_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3090_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3090_End9" name="Complete">
        <bpmn:incoming>W3090_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3090_Annotation10">
        <bpmn:text>Controls: - CTL-508 (ensure controlled execution — Dark Store Site Strategy, Design &amp; Network Planning (PA-93.1).) | - operational: early engagement (VS-76) and site criteria that prefer pre-permitted commercial space
Owner: Real Estate Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3090_Assoc11" sourceRef="W3090_Annotation10" targetRef="W3090_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3090_Flow12" sourceRef="W3090_Start5" targetRef="W3090_Task6" />
      <bpmn:sequenceFlow id="W3090_Flow13" sourceRef="W3090_Task6" targetRef="W3090_Task7" />
      <bpmn:sequenceFlow id="W3090_Flow14" sourceRef="W3090_Task7" targetRef="W3090_Task8" />
      <bpmn:sequenceFlow id="W3090_Flow15" sourceRef="W3090_Task8" targetRef="W3090_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3090_diag">
      <bpmndi:BPMNPlane id="W3090_plane" bpmnElement="W_W3090">
        <bpmndi:BPMNShape id="W3090_Lane1_di" bpmnElement="W3090_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3090_Lane2_di" bpmnElement="W3090_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3090_Lane3_di" bpmnElement="W3090_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3090_Task6_di" bpmnElement="W3090_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3090_Task7_di" bpmnElement="W3090_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3090_Task8_di" bpmnElement="W3090_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3090_Start5_di" bpmnElement="W3090_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3090_End9_di" bpmnElement="W3090_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3090_Annotation10_di" bpmnElement="W3090_Annotation10"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3090_Flow12_di" bpmnElement="W3090_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3090_Flow13_di" bpmnElement="W3090_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3090_Flow14_di" bpmnElement="W3090_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3090_Flow15_di" bpmnElement="W3090_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3090_Assoc11_di" bpmnElement="W3090_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3091" name="W3091. Dark Store Layout Design, Fixture &amp; Automation Configuration" isExecutable="false">
      <bpmn:documentation>Trigger: Site secured, before fit-out
Frequency: Per new site + periodic re-layout
Volume: Site-specific (1,500–3,000 sqm)
Owner: Dark Store Operations Manager
Participants: Dark Store Ops Mgr, Engineering, Automation Vendor, IT, Safety, HR
Source: workflow W3091 — Dark Store Layout Design, Fixture &amp; Automation Configuration</bpmn:documentation>
      <bpmn:laneSet id="W3091_LaneSet4">
        <bpmn:lane id="W3091_Lane1" name="Dark Store Operations Manager">
        <bpmn:flowNodeRef>W3091_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3091_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3091_Lane2" name="Engineering">
        <bpmn:flowNodeRef>W3091_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3091_Lane3" name="Safety Officer">
        <bpmn:flowNodeRef>W3091_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3091_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3091_Start5" name="Site secured, before fit-out">
        <bpmn:outgoing>W3091_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3091_Task6" name="Dark Store Ops Mgr designs functional zones: receiving/staging, reserve…">
        <bpmn:documentation>Step 1: Dark Store Ops Mgr designs functional zones: receiving/staging, reserve storage, forward pick faces (A/B velocity), batch-pick zones, pack stations, dispatch bays, returns zone, rider waiting/loading, amenities; defines flow (one-way, no cross) and slotting logic
Responsible (R): Dark Store Operations Manager
Accountable (A): VP Supply Chain
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W3091_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3091_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3091_Task7" name="Engineering/Automation Vendor configures fixtures and (if MFC) semi-automation…">
        <bpmn:documentation>Step 2: Engineering/Automation Vendor configures fixtures and (if MFC) semi-automation: shelving/racking, gravity-feed lanes, put-wall / sortation, goods-to-person shuttle or AutoStore-style cubes, conveyors, auto-baggers; sized to peak-hour throughput
Responsible (R): Engineering / Automation Vendor
Accountable (A): Dark Store Operations Manager
Duration: 4–8 weeks</bpmn:documentation>
        <bpmn:incoming>W3091_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3091_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3091_Task8" name="Safety/HR validate ergonomic and OSH design (lift heights, pack-station…">
        <bpmn:documentation>Step 3: Safety/HR validate ergonomic and OSH design (lift heights, pack-station ergonomics, fire egress, ventilation per VS-24); HR confirms staffing model feasibility
Responsible (R): Safety Officer / HR
Accountable (A): Dark Store Operations Manager
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W3091_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3091_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3091_End9" name="Complete">
        <bpmn:incoming>W3091_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3091_Annotation10">
        <bpmn:text>Controls: - CTL-508 (ensure controlled execution — Dark Store Site Strategy, Design &amp; Network Planning (PA-93.1).) | - operational: modular design, vendor neutrality, and phased automation (manual→MFC)
Owner: Dark Store Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3091_Assoc11" sourceRef="W3091_Annotation10" targetRef="W3091_Start5" associationDirection="None" />
