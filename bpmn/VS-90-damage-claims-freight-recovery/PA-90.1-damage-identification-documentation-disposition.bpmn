    <bpmn:process id="W_W3017" name="W3017. Inbound Receiving Damage &amp; Shortage Identification &amp; Documentation" isExecutable="false">
      <bpmn:documentation>Trigger: DC/store receiving discrepancy vs. ASN/PO
Frequency: Continuous (~5–8% of receipts have some discrepancy)
Volume: ~72,000 inbound receipts/year
Owner: DC Receiving Supervisor
Participants: DC Receiving, QC, Inventory Control, Vendor Mgmt
Source: workflow W3017 — Inbound Receiving Damage &amp; Shortage Identification &amp; Documentation</bpmn:documentation>
      <bpmn:laneSet id="W3017_LaneSet3">
        <bpmn:lane id="W3017_Lane1" name="Receiving Clerk">
        <bpmn:flowNodeRef>W3017_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3017_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3017_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3017_Lane2" name="Inventory Control">
        <bpmn:flowNodeRef>W3017_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3017_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3017_Start4" name="DC/store receiving discrepancy vs. ASN/PO">
        <bpmn:outgoing>W3017_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3017_Task5" name="Receiving Clerk inspects inbound delivery against PO/ASN; identifies visible…">
        <bpmn:documentation>Step 1: Receiving Clerk inspects inbound delivery against PO/ASN; identifies visible damage, water damage, crushed packaging, or quantity shortage at goods receipt (links to VS-04)
Responsible (R): Receiving Clerk
Accountable (A): DC Receiving Supervisor
Duration: Per receipt</bpmn:documentation>
        <bpmn:incoming>W3017_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3017_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3017_Task6" name="Receiving Clerk/QC documents damage: photos, quantities damaged vs. received…">
        <bpmn:documentation>Step 2: Receiving Clerk/QC documents damage: photos, quantities damaged vs. received, carrier/seal condition, and discrepancy code in ERP goods-receipt exception
Responsible (R): Receiving Clerk / QC
Accountable (A): DC Receiving Supervisor
Duration: Per discrepancy</bpmn:documentation>
        <bpmn:incoming>W3017_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3017_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3017_Task7" name="Inventory Control/Vendor Mgmt route discrepancy to claim (PA-90.2) or RTV…">
        <bpmn:documentation>Step 3: Inventory Control/Vendor Mgmt route discrepancy to claim (PA-90.2) or RTV (links to VS-32); place damaged units in damage quarantine pending disposition
Responsible (R): Inventory Control / Vendor Mgmt
Accountable (A): DC Operations Manager
Duration: Per discrepancy</bpmn:documentation>
        <bpmn:incoming>W3017_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3017_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3017_End8" name="Complete">
        <bpmn:incoming>W3017_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3017_Annotation9">
        <bpmn:text>Controls: - CTL-499 (ensure controlled execution — Damage Identification, Documentation &amp; Disposition (PA-90.1).) | - operational: mandatory photo + discrepancy capture at goods receipt
Owner: DC Receiving Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3017_Assoc10" sourceRef="W3017_Annotation9" targetRef="W3017_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3017_Flow11" sourceRef="W3017_Start4" targetRef="W3017_Task5" />
      <bpmn:sequenceFlow id="W3017_Flow12" sourceRef="W3017_Task5" targetRef="W3017_Task6" />
      <bpmn:sequenceFlow id="W3017_Flow13" sourceRef="W3017_Task6" targetRef="W3017_Task7" />
      <bpmn:sequenceFlow id="W3017_Flow14" sourceRef="W3017_Task7" targetRef="W3017_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3017_diag">
      <bpmndi:BPMNPlane id="W3017_plane" bpmnElement="W_W3017">
        <bpmndi:BPMNShape id="W3017_Lane1_di" bpmnElement="W3017_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
