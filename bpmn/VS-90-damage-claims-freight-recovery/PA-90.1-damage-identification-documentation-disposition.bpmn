      <bpmndi:BPMNPlane id="W3019_plane" bpmnElement="W_W3019">
        <bpmndi:BPMNShape id="W3019_Lane1_di" bpmnElement="W3019_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3019_Lane2_di" bpmnElement="W3019_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3019_Lane3_di" bpmnElement="W3019_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3019_Task6_di" bpmnElement="W3019_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3019_Task7_di" bpmnElement="W3019_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3019_Task8_di" bpmnElement="W3019_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3019_Start5_di" bpmnElement="W3019_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3019_End9_di" bpmnElement="W3019_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3019_Annotation10_di" bpmnElement="W3019_Annotation10"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3019_Flow12_di" bpmnElement="W3019_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3019_Flow13_di" bpmnElement="W3019_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3019_Flow14_di" bpmnElement="W3019_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3019_Flow15_di" bpmnElement="W3019_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3019_Assoc11_di" bpmnElement="W3019_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3020" name="W3020. Damage Documentation, Photographic Evidence &amp; ERP Capture" isExecutable="false">
      <bpmn:documentation>Trigger: Damage event identified
Frequency: Continuous
Volume: Enterprise-wide damage events
Owner: Inventory Control Manager
Participants: Inventory Control, DC/Store Staff, QC, Vendor Mgmt
Source: workflow W3020 — Damage Documentation, Photographic Evidence &amp; ERP Capture</bpmn:documentation>
      <bpmn:laneSet id="W3020_LaneSet4">
        <bpmn:lane id="W3020_Lane1" name="DC">
        <bpmn:flowNodeRef>W3020_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3020_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3020_Lane2" name="Inventory Control">
        <bpmn:flowNodeRef>W3020_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3020_Lane3" name="QC">
        <bpmn:flowNodeRef>W3020_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3020_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3020_Start5" name="Damage event identified">
        <bpmn:outgoing>W3020_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3020_Task6" name="DC/Store staff capture standardized evidence: photos (packaging, product, seal…">
        <bpmn:documentation>Step 1: DC/Store staff capture standardized evidence: photos (packaging, product, seal, carrier markings), quantities, SKU/lot, PO/ASN, carrier/waybill, witness
Responsible (R): DC / Store Staff
Accountable (A): Inventory Control Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3020_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3020_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3020_Task7" name="Inventory Control records damage event in ERP damage-case module: linked PO/GR…">
        <bpmn:documentation>Step 2: Inventory Control records damage event in ERP damage-case module: linked PO/GR, value at cost, liability indicator, evidence attachments
Responsible (R): Inventory Control
Accountable (A): Inventory Control Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3020_Flow13</bpmn:incoming>
