    <bpmn:process id="W_W3024" name="W3024. Damage Trend Analysis &amp; Root Cause Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly/monthly review
Frequency: Weekly + monthly
Volume: Enterprise damage data
Owner: Supply Chain Analytics Manager
Participants: Supply Chain Analytics, DC Ops, Store Ops, Vendor Mgmt, Merchandising
Source: workflow W3024 — Damage Trend Analysis &amp; Root Cause Reporting</bpmn:documentation>
      <bpmn:laneSet id="W3024_LaneSet4">
        <bpmn:lane id="W3024_Lane1" name="Supply Chain Analytics">
        <bpmn:flowNodeRef>W3024_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3024_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3024_Lane2" name="DC Ops">
        <bpmn:flowNodeRef>W3024_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3024_Lane3" name="Merchandising">
        <bpmn:flowNodeRef>W3024_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3024_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3024_Start5" name="Weekly/monthly review">
        <bpmn:outgoing>W3024_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3024_Task6" name="Supply Chain Analytics produces damage trend dashboard: damage rate by vendor…">
        <bpmn:documentation>Step 1: Supply Chain Analytics produces damage trend dashboard: damage rate by vendor, carrier, lane, SKU category, DC, store, cause, and value
Responsible (R): Supply Chain Analytics
Accountable (A): Supply Chain Analytics Manager
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W3024_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3024_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3024_Task7" name="DC/Store Ops/Vendor Mgmt review top damage drivers; initiate corrective actions…">
        <bpmn:documentation>Step 2: DC/Store Ops/Vendor Mgmt review top damage drivers; initiate corrective actions (packaging change, lane/lane carrier switch, handling training, racking fix)
Responsible (R): DC Ops / Store Ops / Vendor Mgmt
Accountable (A): DC Operations Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3024_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3024_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3024_Task8" name="Merchandising/Vendor Mgmt feed damage trends into vendor scorecard and…">
        <bpmn:documentation>Step 3: Merchandising/Vendor Mgmt feed damage trends into vendor scorecard and corrective action (links to VS-67); track reduction vs. targets
Responsible (R): Merchandising / Vendor Mgmt
Accountable (A): Vendor Management Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3024_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3024_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3024_End9" name="Complete">
        <bpmn:incoming>W3024_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3024_Annotation10">
        <bpmn:text>Controls: - CTL-75 (detect and recover freight &amp; receiving damage.) | - operational: trend visibility and scorecard consequences
Owner: Supply Chain Analytics Manager</bpmn:text>
      </bpmn:textAnnotation>
