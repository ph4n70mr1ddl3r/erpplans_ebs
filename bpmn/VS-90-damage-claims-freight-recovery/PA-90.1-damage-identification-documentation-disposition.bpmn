    <bpmn:process id="W_W3018" name="W3018. In-Transit &amp; DC Damage Identification, Quarantine &amp; Classification" isExecutable="false">
      <bpmn:documentation>Trigger: Damage found at DC putaway, picking, or in-transit audit
Frequency: Continuous
Volume: Across 4 DCs handling ~72,000 receipts + outbound
Owner: DC Operations Manager
Participants: DC Ops, QC, Inventory Control, LP
Source: workflow W3018 — In-Transit &amp; DC Damage Identification, Quarantine &amp; Classification</bpmn:documentation>
      <bpmn:laneSet id="W3018_LaneSet4">
        <bpmn:lane id="W3018_Lane1" name="DC Staff">
        <bpmn:flowNodeRef>W3018_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3018_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3018_Lane2" name="QC">
        <bpmn:flowNodeRef>W3018_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3018_Lane3" name="Loss Prevention">
        <bpmn:flowNodeRef>W3018_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3018_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3018_Start5" name="Damage found at DC putaway, picking, or in-transit audit">
        <bpmn:outgoing>W3018_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3018_Task6" name="DC staff identify in-house damage (putaway/pick handling, racking…">
        <bpmn:documentation>Step 1: DC staff identify in-house damage (putaway/pick handling, racking, contamination, pest, water) during cycle counts or pick; log to damage case
Responsible (R): DC Staff / QC
Accountable (A): DC Operations Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3018_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3018_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3018_Task7" name="QC classifies damage cause: carrier-induced, vendor packaging, DC handling…">
        <bpmn:documentation>Step 2: QC classifies damage cause: carrier-induced, vendor packaging, DC handling, environmental, or indeterminate; assigns liability indicator for claim routing
Responsible (R): QC
Accountable (A): DC Operations Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3018_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3018_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3018_Task8" name="LP investigates patterns suggesting theft/concealment disguised as damage…">
        <bpmn:documentation>Step 3: LP investigates patterns suggesting theft/concealment disguised as damage; secures evidence; escalates to VS-23 where fraud suspected
Responsible (R): Loss Prevention
Accountable (A): LP Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3018_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3018_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3018_End9" name="Complete">
        <bpmn:incoming>W3018_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3018_Annotation10">
        <bpmn:text>Controls: - CTL-499 (ensure controlled execution — Damage Identification, Documentation &amp; Disposition (PA-90.1).) | - operational: cause classification and LP review
Owner: DC Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3018_Assoc11" sourceRef="W3018_Annotation10" targetRef="W3018_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3018_Flow12" sourceRef="W3018_Start5" targetRef="W3018_Task6" />
      <bpmn:sequenceFlow id="W3018_Flow13" sourceRef="W3018_Task6" targetRef="W3018_Task7" />
      <bpmn:sequenceFlow id="W3018_Flow14" sourceRef="W3018_Task7" targetRef="W3018_Task8" />
      <bpmn:sequenceFlow id="W3018_Flow15" sourceRef="W3018_Task8" targetRef="W3018_End9" />
    </bpmn:process>
