        <bpmndi:BPMNEdge id="W3018_Flow13_di" bpmnElement="W3018_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3018_Flow14_di" bpmnElement="W3018_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3018_Flow15_di" bpmnElement="W3018_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3018_Assoc11_di" bpmnElement="W3018_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3019" name="W3019. Store-Level Damaged-on-Arrival (DOA) &amp; In-Store Damage Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Store receives damaged goods or in-store damage occurs
Frequency: Continuous across 200 stores
Volume: 200 stores; ~5,000 replenishment orders/month chain-wide + DSD
Owner: Store Manager
Participants: Store Mgr, Receiving Clerk, Stock Associate, Customer Service
Source: workflow W3019 — Store-Level Damaged-on-Arrival (DOA) &amp; In-Store Damage Reporting</bpmn:documentation>
      <bpmn:laneSet id="W3019_LaneSet4">
        <bpmn:lane id="W3019_Lane1" name="Receiving Clerk">
        <bpmn:flowNodeRef>W3019_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3019_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3019_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W3019_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3019_Lane3" name="Customer Service">
        <bpmn:flowNodeRef>W3019_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3019_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3019_Start5" name="Store receives damaged goods or in-store damage occurs">
        <bpmn:outgoing>W3019_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3019_Task6" name="Receiving Clerk/Stock Associate identifies DOA at store receiving or in-store…">
        <bpmn:documentation>Step 1: Receiving Clerk/Stock Associate identifies DOA at store receiving or in-store damage (customer handling, drop, spill, weather in lumber yard); logs damage case with photos
Responsible (R): Receiving Clerk / Stock Associate
Accountable (A): Store Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3019_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3019_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3019_Task7" name="Store Mgr classifies cause (carrier transit, DC pick error, in-store handling…">
        <bpmn:documentation>Step 2: Store Mgr classifies cause (carrier transit, DC pick error, in-store handling, customer-caused); routes to claim, RTV, or write-off per disposition matrix
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3019_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3019_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3019_Task8" name="Customer Service handles customer-caused damage (broken in-aisle) per store…">
        <bpmn:documentation>Step 3: Customer Service handles customer-caused damage (broken in-aisle) per store policy; coordinates goodwill/replacement where applicable (links to W3035)
Responsible (R): Customer Service
Accountable (A): Store Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3019_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3019_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3019_End9" name="Complete">
        <bpmn:incoming>W3019_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3019_Annotation10">
        <bpmn:text>Controls: - CTL-75 (detect and recover freight &amp; receiving damage.) | - operational: mandatory damage-case logging
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3019_Assoc11" sourceRef="W3019_Annotation10" targetRef="W3019_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3019_Flow12" sourceRef="W3019_Start5" targetRef="W3019_Task6" />
      <bpmn:sequenceFlow id="W3019_Flow13" sourceRef="W3019_Task6" targetRef="W3019_Task7" />
      <bpmn:sequenceFlow id="W3019_Flow14" sourceRef="W3019_Task7" targetRef="W3019_Task8" />
      <bpmn:sequenceFlow id="W3019_Flow15" sourceRef="W3019_Task8" targetRef="W3019_End9" />
    </bpmn:process>
