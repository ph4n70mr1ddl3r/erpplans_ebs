        <bpmndi:BPMNShape id="W3033_Annotation8_di" bpmnElement="W3033_Annotation8"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3033_Flow10_di" bpmnElement="W3033_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3033_Flow11_di" bpmnElement="W3033_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3033_Flow12_di" bpmnElement="W3033_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3033_Flow13_di" bpmnElement="W3033_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3033_Assoc9_di" bpmnElement="W3033_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3034" name="W3034. B2B / Trade Delivery Damage Claim Investigation &amp; Resolution" isExecutable="false">
      <bpmn:documentation>Trigger: B2B/trade/government account reports damage/shortage
Frequency: Continuous
Volume: ~5,400 B2B accounts; trade/project deliveries
Owner: Trade Sales Manager
Participants: Trade Sales, Logistics, Project Mgmt, QC, Customer Service
Source: workflow W3034 — B2B / Trade Delivery Damage Claim Investigation &amp; Resolution</bpmn:documentation>
      <bpmn:laneSet id="W3034_LaneSet3">
        <bpmn:lane id="W3034_Lane1" name="Trade Sales">
        <bpmn:flowNodeRef>W3034_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3034_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3034_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3034_Lane2" name="QC">
        <bpmn:flowNodeRef>W3034_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3034_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3034_Start4" name="B2B/trade/government account reports damage/shortage">
        <bpmn:outgoing>W3034_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3034_Task5" name="Trade Sales/Project Mgmt investigate B2B claim against delivery POD, jobsite…">
        <bpmn:documentation>Step 1: Trade Sales/Project Mgmt investigate B2B claim against delivery POD, jobsite receipt, and project records; document with photos/witnesses
Responsible (R): Trade Sales / Project Mgmt
Accountable (A): Trade Sales Manager
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W3034_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3034_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3034_Task6" name="QC/Logistics determine liability (vendor, carrier, jobsite handling, customer)…">
        <bpmn:documentation>Step 2: QC/Logistics determine liability (vendor, carrier, jobsite handling, customer); quantify loss including project-delay impact where applicable
Responsible (R): QC / Logistics
Accountable (A): Trade Sales Manager
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W3034_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3034_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3034_Task7" name="Trade Sales negotiates resolution with account (replacement, credit, price…">
        <bpmn:documentation>Step 3: Trade Sales negotiates resolution with account (replacement, credit, price adjustment, retention-money adjustment); coordinates subrogation (W3038)
Responsible (R): Trade Sales
Accountable (A): Trade Sales Manager
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W3034_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3034_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3034_End8" name="Complete">
        <bpmn:incoming>W3034_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3034_Annotation9">
        <bpmn:text>Controls: - CTL-501 (ensure controlled execution — Customer Damage/Shortage Claims &amp; Recovery Analytics (PA-90.3).) | - operational: documented investigation and tiered resolution authority
Owner: Trade Sales Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3034_Assoc10" sourceRef="W3034_Annotation9" targetRef="W3034_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3034_Flow11" sourceRef="W3034_Start4" targetRef="W3034_Task5" />
      <bpmn:sequenceFlow id="W3034_Flow12" sourceRef="W3034_Task5" targetRef="W3034_Task6" />
      <bpmn:sequenceFlow id="W3034_Flow13" sourceRef="W3034_Task6" targetRef="W3034_Task7" />
      <bpmn:sequenceFlow id="W3034_Flow14" sourceRef="W3034_Task7" targetRef="W3034_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3034_diag">
      <bpmndi:BPMNPlane id="W3034_plane" bpmnElement="W_W3034">
        <bpmndi:BPMNShape id="W3034_Lane1_di" bpmnElement="W3034_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3034_Lane2_di" bpmnElement="W3034_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3034_Task5_di" bpmnElement="W3034_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3034_Task6_di" bpmnElement="W3034_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3034_Task7_di" bpmnElement="W3034_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3034_Start4_di" bpmnElement="W3034_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3034_End8_di" bpmnElement="W3034_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3034_Annotation9_di" bpmnElement="W3034_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3034_Flow11_di" bpmnElement="W3034_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3034_Flow12_di" bpmnElement="W3034_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3034_Flow13_di" bpmnElement="W3034_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3034_Flow14_di" bpmnElement="W3034_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3034_Assoc10_di" bpmnElement="W3034_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3035" name="W3035. Customer Goodwill &amp; Damage Replacement Authorization" isExecutable="false">
      <bpmn:documentation>Trigger: Customer claim routed to the goodwill path (W3033 step 3)
Frequency: Continuous
Volume: Subset of customer claims
Owner: Customer Service Manager
Participants: Customer Service, Store Ops, Finance, LP
Source: workflow W3035 — Customer Goodwill &amp; Damage Replacement Authorization</bpmn:documentation>
      <bpmn:laneSet id="W3035_LaneSet4">
        <bpmn:lane id="W3035_Lane1" name="Customer Service">
        <bpmn:flowNodeRef>W3035_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3035_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3035_Lane2" name="Store Ops">
        <bpmn:flowNodeRef>W3035_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3035_Lane3" name="Loss Prevention">
        <bpmn:flowNodeRef>W3035_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3035_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3035_Start5" name="Customer claim routed to the goodwill path (W3033 step 3)">
        <bpmn:outgoing>W3035_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3035_Task6" name="Customer Service applies goodwill authority matrix (value tier, customer…">
        <bpmn:documentation>Step 1: Customer Service applies goodwill authority matrix (value tier, customer lifetime, loyalty tier) to authorize replacement/refund without full investigation
Responsible (R): Customer Service
Accountable (A): Customer Service Manager
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W3035_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3035_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3035_Task7" name="Store Ops/Ecommerce fulfill replacement (store pick / re-delivery / BOPIS)…">
        <bpmn:documentation>Step 2: Store Ops/Ecommerce fulfill replacement (store pick / re-delivery / BOPIS); coordinates logistics; updates order
Responsible (R): Store Ops / Ecommerce
Accountable (A): Store Operations Manager
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W3035_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3035_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3035_Task8" name="LP samples goodwill authorizations for abuse patterns (serial claimants, fraud…">
        <bpmn:documentation>Step 3: LP samples goodwill authorizations for abuse patterns (serial claimants, fraud rings); escalates anomalies to VS-23; tracks goodwill cost
Responsible (R): Loss Prevention
Accountable (A): LP Manager
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W3035_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3035_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3035_End9" name="Complete">
        <bpmn:incoming>W3035_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3035_Annotation10">
        <bpmn:text>Controls: - CTL-501 (ensure controlled execution — Customer Damage/Shortage Claims &amp; Recovery Analytics (PA-90.3).) | - operational: authority tiers and LP pattern monitoring
Owner: Customer Service Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3035_Assoc11" sourceRef="W3035_Annotation10" targetRef="W3035_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3035_Flow12" sourceRef="W3035_Start5" targetRef="W3035_Task6" />
      <bpmn:sequenceFlow id="W3035_Flow13" sourceRef="W3035_Task6" targetRef="W3035_Task7" />
      <bpmn:sequenceFlow id="W3035_Flow14" sourceRef="W3035_Task7" targetRef="W3035_Task8" />
      <bpmn:sequenceFlow id="W3035_Flow15" sourceRef="W3035_Task8" targetRef="W3035_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3035_diag">
      <bpmndi:BPMNPlane id="W3035_plane" bpmnElement="W_W3035">
        <bpmndi:BPMNShape id="W3035_Lane1_di" bpmnElement="W3035_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3035_Lane2_di" bpmnElement="W3035_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3035_Lane3_di" bpmnElement="W3035_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
