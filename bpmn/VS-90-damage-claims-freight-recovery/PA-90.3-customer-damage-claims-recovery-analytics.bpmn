    <bpmn:process id="W_W3040" name="W3040. Damage Cost Allocation, Vendor Recovery Rate &amp; Margin Impact Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly close + margin review
Frequency: Monthly
Volume: Enterprise
Owner: Finance Manager (FP&amp;A)
Participants: FP&amp;A, Supply Chain Analytics, Merchandising, Vendor Mgmt
Source: workflow W3040 — Damage Cost Allocation, Vendor Recovery Rate &amp; Margin Impact Analysis</bpmn:documentation>
      <bpmn:laneSet id="W3040_LaneSet3">
        <bpmn:lane id="W3040_Lane1" name="FP&amp;A">
        <bpmn:flowNodeRef>W3040_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3040_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3040_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3040_Lane2" name="Merchandising">
        <bpmn:flowNodeRef>W3040_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3040_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3040_Start4" name="Monthly close + margin review">
        <bpmn:outgoing>W3040_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3040_Task5" name="FP&amp;A allocates net damage cost to category/vendor/lane/SKU; computes vendor…">
        <bpmn:documentation>Step 1: FP&amp;A allocates net damage cost to category/vendor/lane/SKU; computes vendor recovery rate and unrecovered damage cost
Responsible (R): FP&amp;A
Accountable (A): Finance Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3040_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3040_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3040_Task6" name="Merchandising/Vendor Mgmt incorporate damage cost and recovery into category…">
        <bpmn:documentation>Step 2: Merchandising/Vendor Mgmt incorporate damage cost and recovery into category margin analysis (links to W85) and vendor negotiation (rebates/allowances)
Responsible (R): Merchandising / Vendor Mgmt
Accountable (A): VP Merchandising
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3040_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3040_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3040_Task7" name="FP&amp;A reports margin impact of damage; recommends pricing/packaging/sourcing…">
        <bpmn:documentation>Step 3: FP&amp;A reports margin impact of damage; recommends pricing/packaging/sourcing actions to recover net damage cost
Responsible (R): FP&amp;A
Accountable (A): Finance Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3040_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3040_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3040_End8" name="Complete">
        <bpmn:incoming>W3040_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3040_Annotation9">
        <bpmn:text>Controls: - CTL-501 (ensure controlled execution — Customer Damage/Shortage Claims &amp; Recovery Analytics (PA-90.3).) | - operational: full-cost allocation to category/vendor
Owner: Finance Manager (FP&amp;A)</bpmn:text>
      </bpmn:textAnnotation>
