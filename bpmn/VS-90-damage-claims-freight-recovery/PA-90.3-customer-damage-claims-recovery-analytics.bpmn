<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-90.3-customer-damage-claims-recovery-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3033" name="W3033. Customer Delivery Damage &amp; Shortage Claim Intake" isExecutable="false">
      <bpmn:documentation>Trigger: Customer reports damaged/short delivery
Frequency: Continuous
Volume: ~42,900 ecommerce orders/month + B2B/trade deliveries
Owner: Customer Service Manager
Participants: Customer Service, Ecommerce, Logistics, Store Ops
Source: workflow W3033 — Customer Delivery Damage &amp; Shortage Claim Intake</bpmn:documentation>
      <bpmn:laneSet id="W3033_LaneSet2">
        <bpmn:lane id="W3033_Lane1" name="Customer Service">
        <bpmn:flowNodeRef>W3033_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3033_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3033_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3033_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3033_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3033_Start3" name="Customer reports damaged/short delivery">
        <bpmn:outgoing>W3033_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3033_Task4" name="Customer Service logs damage/shortage claim from customer…">
        <bpmn:documentation>Step 1: Customer Service logs damage/shortage claim from customer (phone/chat/email/in-store): order, SKU, qty, photo, delivery date, carrier
Responsible (R): Customer Service
Accountable (A): Customer Service Manager
Duration: Per claim (&lt;24 hr)</bpmn:documentation>
        <bpmn:incoming>W3033_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3033_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3033_Task5" name="Customer Service/Ecommerce verify against order, delivery POD, and fulfillment…">
        <bpmn:documentation>Step 2: Customer Service/Ecommerce verify against order, delivery POD, and fulfillment source (store/DC/3PL); determines responsibility indicator
Responsible (R): Customer Service / Ecommerce
Accountable (A): Customer Service Manager
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W3033_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3033_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3033_Task6" name="Customer Service routes claim: goodwill replacement/refund (W3035)…">
        <bpmn:documentation>Step 3: Customer Service routes claim: goodwill replacement/refund (W3035), investigation (W3034), or denial with explanation; communicates to customer
Responsible (R): Customer Service
Accountable (A): Customer Service Manager
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W3033_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3033_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3033_End7" name="Complete">
        <bpmn:incoming>W3033_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3033_Annotation8">
        <bpmn:text>Controls: - CTL-501 (ensure controlled execution — Customer Damage/Shortage Claims &amp; Recovery Analytics (PA-90.3).) | - operational: 24-hr SLA and goodwill authority tiers
Owner: Customer Service Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3033_Assoc9" sourceRef="W3033_Annotation8" targetRef="W3033_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3033_Flow10" sourceRef="W3033_Start3" targetRef="W3033_Task4" />
      <bpmn:sequenceFlow id="W3033_Flow11" sourceRef="W3033_Task4" targetRef="W3033_Task5" />
      <bpmn:sequenceFlow id="W3033_Flow12" sourceRef="W3033_Task5" targetRef="W3033_Task6" />
      <bpmn:sequenceFlow id="W3033_Flow13" sourceRef="W3033_Task6" targetRef="W3033_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3033_diag">
      <bpmndi:BPMNPlane id="W3033_plane" bpmnElement="W_W3033">
        <bpmndi:BPMNShape id="W3033_Lane1_di" bpmnElement="W3033_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3033_Task4_di" bpmnElement="W3033_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3033_Task5_di" bpmnElement="W3033_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
