        <bpmndi:BPMNShape id="W3035_Task8_di" bpmnElement="W3035_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3035_Start5_di" bpmnElement="W3035_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3035_End9_di" bpmnElement="W3035_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3035_Annotation10_di" bpmnElement="W3035_Annotation10"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3035_Flow12_di" bpmnElement="W3035_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3035_Flow13_di" bpmnElement="W3035_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3035_Flow14_di" bpmnElement="W3035_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3035_Flow15_di" bpmnElement="W3035_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3035_Assoc11_di" bpmnElement="W3035_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3036" name="W3036. Damage Claim Refund, Credit Note &amp; Financial Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: Claim resolved with refund/credit
Frequency: Continuous
Volume: Enterprise resolved claims
Owner: Finance Manager (AR)
Participants: Finance/AR, Customer Service, AP
Source: workflow W3036 — Damage Claim Refund, Credit Note &amp; Financial Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W3036_LaneSet2">
        <bpmn:lane id="W3036_Lane1" name="Finance">
        <bpmn:flowNodeRef>W3036_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3036_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3036_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3036_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3036_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3036_Start3" name="Claim resolved with refund/credit">
        <bpmn:outgoing>W3036_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3036_Task4" name="Finance/AR processes refund via original tender or BIR-compliant credit note…">
        <bpmn:documentation>Step 1: Finance/AR processes refund via original tender or BIR-compliant credit note (links to W101); posts to customer account or one-off refund
Responsible (R): Finance / AR
Accountable (A): Finance Manager
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W3036_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3036_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3036_Task5" name="Finance allocates cost to damage case with liability flag; offsets recovered…">
        <bpmn:documentation>Step 2: Finance allocates cost to damage case with liability flag; offsets recovered amounts from vendor/carrier/insurer subrogation
Responsible (R): Finance
Accountable (A): Finance Manager
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W3036_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3036_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3036_Task6" name="Finance reconciles claim P&amp;L impact (net of recovery) at month-end; reports…">
        <bpmn:documentation>Step 3: Finance reconciles claim P&amp;L impact (net of recovery) at month-end; reports unrecovered damage cost to management
Responsible (R): Finance
Accountable (A): Finance Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3036_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3036_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3036_End7" name="Complete">
        <bpmn:incoming>W3036_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3036_Annotation8">
        <bpmn:text>Controls: - CTL-75 (detect and recover freight &amp; receiving damage.) | - operational: liability flag and subrogation follow-through (W3038)
Owner: Finance Manager (AR)</bpmn:text>
      </bpmn:textAnnotation>
