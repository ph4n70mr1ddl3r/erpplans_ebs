    <bpmn:process id="W_W731" name="W731. Consumer Act (RA 7394) Compliance Monitoring &amp; Enforcement" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly compliance review cycle; or consumer complaint per W41; or DTI inspection notification
Frequency: Monthly (monitoring); ad-hoc (complaints, inspections)
Volume: ~50–100 consumer complaints/month; ~5–10 DTI-related escalations/month; 200 stores requiring compliance
Owner: Compliance Officer
Participants: Store Manager, Merchandising Manager, Customer Service, Legal Counsel, DTI
Source: workflow W731 — Consumer Act (RA 7394) Compliance Monitoring &amp; Enforcement</bpmn:documentation>
      <bpmn:laneSet id="W731_LaneSet2">
        <bpmn:lane id="W731_Lane1" name="Compliance Officer">
        <bpmn:flowNodeRef>W731_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W731_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W731_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W731_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W731_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W731_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W731_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W731_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W731_Start3" name="Monthly compliance review cycle; or consumer complaint per W41; or DTI inspection…">
        <bpmn:outgoing>W731_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W731_Task4" name="Monthly price display compliance audit">
        <bpmn:documentation>Step 1: Monthly price display compliance audit: Compliance Officer conducts monthly audit of price display compliance per RA 7394 Article 81-82: (a) random sample of 10 stores per month (rotating coverage across 200 stores ensures each store audited at least once per 20 months); (b) verify: (i) every item on shelf has a price tag or shelf label per W181; (ii) price tag shows: selling price, unit of measure, and price per unit; (iii) promotional pricing clearly displays original and discounted price; (iv) no &quot;ghost markdowns&quot; — items displayed at promotional price that have reverted to regular price; (v) price accuracy: physical tag matches POS price and ecommerce price per W678; (c) document findings with photographic evidence; (d) issue compliance report to Store Manager and Regional Manager
Responsible (R): Compliance Officer
Accountable (A): VP Store Operations
Duration: 1 day per store audit; ~10 days/month</bpmn:documentation>
        <bpmn:incoming>W731_Flow13</bpmn:incoming>
        <bpmn:outgoing>W731_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W731_Task5" name="Product safety monitoring">
        <bpmn:documentation>Step 2: Product safety monitoring: Compliance Officer monitors product safety compliance per RA 7394 Article 22-30: (a) maintain product safety alert registry: (i) items subject to mandatory DTI-BPS certification per W447; (ii) items with active consumer safety complaints per W41; (iii) items recalled per W29; (iv) items with expired shelf life; (b) for flagged items: (i) verify ICC/SOC mark is displayed on product and packaging; (ii) coordinate with Merchandising per W625 for quality testing results; (iii) remove non-compliant items from shelf immediately if safety risk identified; (c) quarterly product safety review with Merchandising and Quality teams
Responsible (R): Compliance Officer
Accountable (A): VP Merchandising
Duration: 4-6 hours/month</bpmn:documentation>
        <bpmn:incoming>W731_Flow14</bpmn:incoming>
        <bpmn:outgoing>W731_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W731_Task6" name="Return and exchange policy compliance">
        <bpmn:documentation>Step 3: Return and exchange policy compliance: monitor adherence to BuildRight&#x27;s return policy (which must comply with RA 7394): (a) verify stores display return policy: (i) posted at customer service counter; (ii) printed on receipts; (iii) available on website; (b) review return transactions per W12 for policy compliance: (i) are stores accepting returns within policy window?; (ii) are stores improperly denying valid returns?; (iii) are stores granting exceptions that violate policy?; (c) investigate DTI consumer complaints related to returns: (i) compile transaction evidence; (ii) propose resolution (refund, exchange, store credit); (iii) Legal Counsel reviews if complaint escalates to DTI adjudication
Responsible (R): Compliance Officer / Store Manager
Accountable (A): VP Store Operations
Duration: 4-6 hours/month</bpmn:documentation>
        <bpmn:incoming>W731_Flow15</bpmn:incoming>
        <bpmn:outgoing>W731_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W731_Task7" name="DTI inspection response">
        <bpmn:documentation>Step 4: DTI inspection response: when DTI conducts store inspection: (a) Store Manager notifies Compliance Officer immediately; (b) Compliance Officer coordinates response: (i) provide requested documents: business permit per W54, price tags, product certifications per W447, sales promotion permits per W427, consumer complaint log; (ii) accompany DTI inspector during store walkthrough; (iii) address any immediate findings (reprice items, remove non-compliant products); (c) post-inspection: (i) document DTI findings; (ii) develop corrective action plan for any violations; (iii) submit corrective action evidence to DTI within prescribed timeline; (iv) implement preventive measures across all stores if finding is systemic
Responsible (R): Compliance Officer / Store Manager
Accountable (A): VP Legal
Duration: 4-8 hours per inspection</bpmn:documentation>
        <bpmn:incoming>W731_Flow16</bpmn:incoming>
        <bpmn:outgoing>W731_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W731_Task8" name="Consumer complaint DTI escalation management">
        <bpmn:documentation>Step 5: Consumer complaint DTI escalation management: for consumer complaints escalated to DTI per W469: (a) Legal Counsel reviews complaint with Compliance Officer; (b) prepare BuildRight response: (i) factual chronology of the transaction and complaint handling; (ii) evidence: receipts, CCTV footage per W207, product photos, communication records; (iii) proposed amicable settlement if appropriate; (c) attend DTI mediation/conciliation proceedings; (d) if settlement reached: execute within agreed timeline; (e) if unresolved: prepare for DTI adjudication with Legal Counsel; (f) track all DTI cases and outcomes for trend analysis
Responsible (R): Compliance Officer / Legal Counsel
Accountable (A): VP Legal
Duration: 4-8 hours per case</bpmn:documentation>
        <bpmn:incoming>W731_Flow17</bpmn:incoming>
        <bpmn:outgoing>W731_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W731_Task9" name="Quarterly Consumer Act compliance report">
        <bpmn:documentation>Step 6: Quarterly Consumer Act compliance report: Compliance Officer prepares quarterly report: (a) price display compliance rate by store and region; (b) product safety incidents and resolutions; (c) return policy compliance metrics; (d) DTI inspection results and corrective actions; (e) consumer complaint volume, resolution rate, and DTI escalation count; (f) training completion: Consumer Act awareness training for store staff (annual 1-hour module); (g) recommendations for compliance improvement
Responsible (R): Compliance Officer
Accountable (A): VP Legal / VP Store Operations
Duration: 4-6 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W731_Flow18</bpmn:incoming>
        <bpmn:outgoing>W731_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W731_End10" name="Complete">
        <bpmn:incoming>W731_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W731_Annotation11">
        <bpmn:text>Controls: - CTL-308 (ensure controlled execution — Government Audit &amp; Inspection Response (PA-22.2).) | - operational: Compliance Officer review and approval gate
Owner: Compliance Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W731_Assoc12" sourceRef="W731_Annotation11" targetRef="W731_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W731_Flow13" sourceRef="W731_Start3" targetRef="W731_Task4" />
      <bpmn:sequenceFlow id="W731_Flow14" sourceRef="W731_Task4" targetRef="W731_Task5" />
      <bpmn:sequenceFlow id="W731_Flow15" sourceRef="W731_Task5" targetRef="W731_Task6" />
      <bpmn:sequenceFlow id="W731_Flow16" sourceRef="W731_Task6" targetRef="W731_Task7" />
      <bpmn:sequenceFlow id="W731_Flow17" sourceRef="W731_Task7" targetRef="W731_Task8" />
      <bpmn:sequenceFlow id="W731_Flow18" sourceRef="W731_Task8" targetRef="W731_Task9" />
      <bpmn:sequenceFlow id="W731_Flow19" sourceRef="W731_Task9" targetRef="W731_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W731_diag">
      <bpmndi:BPMNPlane id="W731_plane" bpmnElement="W_W731">
        <bpmndi:BPMNShape id="W731_Lane1_di" bpmnElement="W731_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W731_Task4_di" bpmnElement="W731_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W731_Task5_di" bpmnElement="W731_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W731_Task6_di" bpmnElement="W731_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W731_Task7_di" bpmnElement="W731_Task7"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W731_Task8_di" bpmnElement="W731_Task8"><dc:Bounds x="1240" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W731_Task9_di" bpmnElement="W731_Task9"><dc:Bounds x="1450" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W731_Start3_di" bpmnElement="W731_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
