        <bpmndi:BPMNEdge id="W505_Flow30_di" bpmnElement="W505_Flow30"><di:waypoint x="2050" y="165" /><di:waypoint x="2080" y="845" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W505_Flow31_di" bpmnElement="W505_Flow31"><di:waypoint x="2260" y="845" /><di:waypoint x="2290" y="165" /></bpmndi:BPMNEdge>
