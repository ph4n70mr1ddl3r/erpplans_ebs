    <bpmn:process id="W_W658" name="W658. General Regulatory Inspection Response Protocol" isExecutable="false">
      <bpmn:documentation>Trigger: Unannounced regulatory inspection at any location (store, DC, HQ)
Frequency: ~30–50 inspections/year across 200 stores, 4 DCs, and HQ
Volume: ~3–5 per month
Owner: Regulatory Compliance Officer
Participants: Location Manager (Store Manager/DC Manager), VP Legal, affected Department Head, Compliance Officer
Source: workflow W658 — General Regulatory Inspection Response Protocol</bpmn:documentation>
      <bpmn:laneSet id="W658_LaneSet4">
        <bpmn:lane id="W658_Lane1" name="Location Manager">
        <bpmn:flowNodeRef>W658_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W658_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W658_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W658_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W658_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W658_Lane2" name="Regulatory Compliance Officer">
        <bpmn:flowNodeRef>W658_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W658_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W658_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W658_Lane3" name="Department Head">
        <bpmn:flowNodeRef>W658_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W658_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W658_Start5" name="Unannounced regulatory inspection at any location (store, DC, HQ)">
        <bpmn:outgoing>W658_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W658_Task6" name="Location Manager receives inspector; verifies inspector credentials (government…">
        <bpmn:documentation>Step 1: Location Manager receives inspector; verifies inspector credentials (government ID, authority letter, specific agency); confirms inspection type and scope; contacts Regulatory Compliance Officer within 15 minutes for guidance
Responsible (R): Location Manager
Accountable (A): Regulatory Compliance Officer
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W658_Flow17</bpmn:incoming>
        <bpmn:outgoing>W658_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W658_Task7" name="Regulatory Compliance Officer identifies relevant inspection protocol by…">
        <bpmn:documentation>Step 2: Regulatory Compliance Officer identifies relevant inspection protocol by agency: BIR (tax compliance, CAS per W216), DTI (consumer protection, pricing per W69, product standards), DOLE (labor standards per W505), DENR (environmental per W477), BFP (fire safety per W476), FDA (product safety per W479), LGU (business permit compliance per W54), SEC (corporate governance per W481); provides Location Manager with inspection-specific checklist and guidance
Responsible (R): Regulatory Compliance Officer
Accountable (A): VP Legal
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W658_Flow18</bpmn:incoming>
        <bpmn:outgoing>W658_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W658_Task8" name="Location Manager accompanies inspector throughout inspection; provides…">
        <bpmn:documentation>Step 3: Location Manager accompanies inspector throughout inspection; provides requested documents (permits, licenses, records); does not volunteer information beyond scope; takes notes on all inspector observations and requests
Responsible (R): Location Manager
Accountable (A): Regulatory Compliance Officer
Duration: Duration of inspection</bpmn:documentation>
        <bpmn:incoming>W658_Flow19</bpmn:incoming>
        <bpmn:outgoing>W658_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W658_Task9" name="If inspector issues Notice of Violation or findings on-site: Location Manager…">
        <bpmn:documentation>Step 4: If inspector issues Notice of Violation or findings on-site: Location Manager signs acknowledgment (not admission of liability); obtains copy of all findings; does NOT agree to on-the-spot payment or penalty
Responsible (R): Location Manager
Accountable (A): VP Legal
Duration: During inspection</bpmn:documentation>
        <bpmn:incoming>W658_Flow20</bpmn:incoming>
        <bpmn:outgoing>W658_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W658_Task10" name="Location Manager submits inspection report with findings to Regulatory…">
        <bpmn:documentation>Step 5: Location Manager submits inspection report with findings to Regulatory Compliance Officer within 24 hours; includes inspector name, agency, scope, findings, required response deadline, and any documents provided to or obtained from inspector
Responsible (R): Location Manager
Accountable (A): Regulatory Compliance Officer
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W658_Flow21</bpmn:incoming>
        <bpmn:outgoing>W658_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W658_Task11" name="Regulatory Compliance Officer coordinates with VP Legal and affected Department…">
        <bpmn:documentation>Step 6: Regulatory Compliance Officer coordinates with VP Legal and affected Department Head to prepare response: corrective action plan addressing each finding; legal review of response language; response submitted within agency-prescribed deadline (typically 5–15 business days)
Responsible (R): Regulatory Compliance Officer
Accountable (A): VP Legal
Duration: 2–5 days</bpmn:documentation>
        <bpmn:incoming>W658_Flow22</bpmn:incoming>
        <bpmn:outgoing>W658_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W658_Task12" name="Department Head implements corrective actions; Regulatory Compliance Officer…">
        <bpmn:documentation>Step 7: Department Head implements corrective actions; Regulatory Compliance Officer tracks completion and documents closure; updates compliance calendar (W506) if finding relates to permit renewal or recurring requirement
Responsible (R): Department Head
Accountable (A): VP Legal
Duration: Per corrective action timeline</bpmn:documentation>
        <bpmn:incoming>W658_Flow23</bpmn:incoming>
        <bpmn:outgoing>W658_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W658_Task13" name="Monthly: Regulatory Compliance Officer produces inspection activity report…">
        <bpmn:documentation>Step 8: Monthly: Regulatory Compliance Officer produces inspection activity report: inspections by agency, location, finding type, corrective action status, repeat findings; identifies systemic issues requiring enterprise-wide action
Responsible (R): Regulatory Compliance Officer
Accountable (A): VP Legal
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W658_Flow24</bpmn:incoming>
        <bpmn:outgoing>W658_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W658_End14" name="Complete">
        <bpmn:incoming>W658_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W658_Annotation15">
        <bpmn:text>Controls: - CTL-308 (ensure controlled execution — Government Audit &amp; Inspection Response (PA-22.2).) | - operational: Regulatory Compliance Officer review and approval gate
Owner: Regulatory Compliance Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W658_Assoc16" sourceRef="W658_Annotation15" targetRef="W658_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W658_Flow17" sourceRef="W658_Start5" targetRef="W658_Task6" />
      <bpmn:sequenceFlow id="W658_Flow18" sourceRef="W658_Task6" targetRef="W658_Task7" />
      <bpmn:sequenceFlow id="W658_Flow19" sourceRef="W658_Task7" targetRef="W658_Task8" />
      <bpmn:sequenceFlow id="W658_Flow20" sourceRef="W658_Task8" targetRef="W658_Task9" />
      <bpmn:sequenceFlow id="W658_Flow21" sourceRef="W658_Task9" targetRef="W658_Task10" />
      <bpmn:sequenceFlow id="W658_Flow22" sourceRef="W658_Task10" targetRef="W658_Task11" />
      <bpmn:sequenceFlow id="W658_Flow23" sourceRef="W658_Task11" targetRef="W658_Task12" />
      <bpmn:sequenceFlow id="W658_Flow24" sourceRef="W658_Task12" targetRef="W658_Task13" />
      <bpmn:sequenceFlow id="W658_Flow25" sourceRef="W658_Task13" targetRef="W658_End14" />
    </bpmn:process>
