      <bpmn:sequenceFlow id="W732_Flow16" sourceRef="W732_Task7" targetRef="W732_Task8" />
      <bpmn:sequenceFlow id="W732_Flow17" sourceRef="W732_Task8" targetRef="W732_Task9" />
      <bpmn:sequenceFlow id="W732_Flow18" sourceRef="W732_Task9" targetRef="W732_End10" />
    </bpmn:process>
