    <bpmn:process id="W_W216" name="W216. BIR CAS (Computerized Accounting System) Compliance Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Periodic compliance review; or BIR post-evaluation/inspection of the ERP system
Frequency: Annual internal review; or as scheduled by BIR
Volume: Covers all 5 legal entities and centralized accounting
Owner: VP Legal &amp; Compliance / CIO
Participants: Tax Manager, IT Manager, External Audit, BIR Officers
Source: workflow W216 — BIR CAS (Computerized Accounting System) Compliance Audit</bpmn:documentation>
      <bpmn:laneSet id="W216_LaneSet4">
        <bpmn:lane id="W216_Lane1" name="IT Manager">
        <bpmn:flowNodeRef>W216_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W216_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W216_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W216_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W216_Lane2" name="Tax Manager">
        <bpmn:flowNodeRef>W216_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W216_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W216_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W216_Lane3" name="VP Legal">
        <bpmn:flowNodeRef>W216_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W216_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W216_Start5" name="Periodic compliance review; or BIR post-evaluation/inspection of the ERP system">
        <bpmn:outgoing>W216_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W216_Task6" name="System Documentation Update">
        <bpmn:documentation>Step 1: System Documentation Update: Maintain up-to-date system architecture, data flow diagrams, and functional descriptions for BIR submission
Responsible (R): IT Manager
Accountable (A): CIO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W216_Flow16</bpmn:incoming>
        <bpmn:outgoing>W216_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W216_Task7" name="Audit Trail Verification">
        <bpmn:documentation>Step 2: Audit Trail Verification: Verify that all transactions (GL, AP, AR, Inventory) have immutable audit trails (who, when, what, previous value)
Responsible (R): IT Manager
Accountable (A): Internal Audit
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W216_Flow17</bpmn:incoming>
        <bpmn:outgoing>W216_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W216_Task8" name="Standard Report Generation">
        <bpmn:documentation>Step 3: Standard Report Generation: Generate and validate &quot;Books of Accounts&quot; in BIR-required formats (General Journal, Sales Journal, Purchase Journal, etc.)
Responsible (R): Tax Manager
Accountable (A): Controller
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W216_Flow18</bpmn:incoming>
        <bpmn:outgoing>W216_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W216_Task9" name="E-Invoicing Compliance">
        <bpmn:documentation>Step 4: E-Invoicing Compliance: Verify that system-generated Invoices and Official Receipts (OR) comply with BIR serial numbering and mandatory field requirements
Responsible (R): Tax Manager
Accountable (A): VP Legal
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W216_Flow19</bpmn:incoming>
        <bpmn:outgoing>W216_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W216_Task10" name="CAS Permit Review">
        <bpmn:documentation>Step 5: CAS Permit Review: Verify that any significant system changes (W132) have been reported to the BIR as &quot;System Enhancements&quot; per regulation
Responsible (R): VP Legal
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W216_Flow20</bpmn:incoming>
        <bpmn:outgoing>W216_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W216_Task11" name="Mock Inspection">
        <bpmn:documentation>Step 6: Mock Inspection: Conduct mock BIR walk-through: demonstrate system navigation, report generation, and data archival for BIR officers
Responsible (R): Tax Manager
Accountable (A): CIO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W216_Flow21</bpmn:incoming>
        <bpmn:outgoing>W216_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W216_Task12" name="Archival &amp; Retention">
        <bpmn:documentation>Step 7: Archival &amp; Retention: Verify 10-year data retention and accessibility of archived accounting data (profile §15.3)
Responsible (R): IT Manager
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W216_Flow22</bpmn:incoming>
        <bpmn:outgoing>W216_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W216_End13" name="Complete">
        <bpmn:incoming>W216_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W216_Annotation14">
        <bpmn:text>Controls: - CTL-308 (ensure controlled execution — Government Audit &amp; Inspection Response (PA-22.2).) | - operational: audit trails be immutable (no editing or deletion of transaction records)
Owner: VP Legal &amp; Compliance / CIO</bpmn:text>
      </bpmn:textAnnotation>
