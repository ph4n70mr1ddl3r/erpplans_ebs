    <bpmn:process id="W_W1367" name="W1367. BIR CAS Registration Renewal, System Change Notification &amp; Annual Compliance Attestation" isExecutable="false">
      <bpmn:documentation>Trigger: BIR CAS registration renewal due date (annual); or ERP system change requiring BIR notification; or BIR RDO request for compliance demonstration
Frequency: Annual renewal per entity (5 entities × 5 registrations); system change notifications as needed (~2–4 per year across all entities); BIR inspection response as requested
Volume: 5 CAS registrations maintained; ~2–4 change notifications/year; ~1–2 BIR inspections/year across all entities
Owner: Tax Manager
Participants: Tax Manager, CIO, Controller, External Tax Advisor, BIR Revenue District Officer (RDO)
Source: workflow W1367 — BIR CAS Registration Renewal, System Change Notification &amp; Annual Compliance Attestation</bpmn:documentation>
      <bpmn:laneSet id="W1367_LaneSet4">
        <bpmn:lane id="W1367_Lane1" name="Tax Manager">
        <bpmn:flowNodeRef>W1367_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1367_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1367_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1367_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1367_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1367_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1367_Lane2" name="CIO">
        <bpmn:flowNodeRef>W1367_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1367_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1367_Lane3" name="External Tax Advisor">
        <bpmn:flowNodeRef>W1367_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1367_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1367_Start5" name="BIR CAS registration renewal due date (annual); or ERP system change requiring BIR…">
        <bpmn:outgoing>W1367_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1367_Task6" name="Tax Manager maintains CAS registration calendar: tracks expiry dates for all 5…">
        <bpmn:documentation>Step 1: Tax Manager maintains CAS registration calendar: tracks expiry dates for all 5 entity registrations; initiates renewal process 60 days before expiry
Responsible (R): Tax Manager
Accountable (A): Controller
Duration: 2 hours/year</bpmn:documentation>
        <bpmn:incoming>W1367_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1367_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1367_Task7" name="Tax Manager prepares renewal documentation: updated system description, list of…">
        <bpmn:documentation>Step 2: Tax Manager prepares renewal documentation: updated system description, list of modules, sample outputs (invoice, receipt, journal entry, financial statements), system security description, and backup/retention procedures
Responsible (R): Tax Manager
Accountable (A): CIO
Duration: 4–6 hours/renewal</bpmn:documentation>
        <bpmn:incoming>W1367_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1367_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1367_Task8" name="CIO reviews and confirms system description accuracy; provides evidence of any…">
        <bpmn:documentation>Step 3: CIO reviews and confirms system description accuracy; provides evidence of any changes since last registration (version upgrades, new integrations, infrastructure changes)
Responsible (R): CIO
Accountable (A): —
Duration: 1–2 hours/renewal</bpmn:documentation>
        <bpmn:incoming>W1367_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1367_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1367_Task9" name="External Tax Advisor reviews renewal package for completeness and compliance…">
        <bpmn:documentation>Step 4: External Tax Advisor reviews renewal package for completeness and compliance with current BIR CAS requirements (Revenue Regulations may have been updated since last renewal)
Responsible (R): External Tax Advisor
Accountable (A): Tax Manager
Duration: 1–2 hours/renewal</bpmn:documentation>
        <bpmn:incoming>W1367_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1367_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1367_Task10" name="Tax Manager submits renewal application to respective RDO; follows up on…">
        <bpmn:documentation>Step 5: Tax Manager submits renewal application to respective RDO; follows up on processing status (BIR processing typically takes 30–60 days)
Responsible (R): Tax Manager
Accountable (A): —
Duration: 2–3 hours/renewal</bpmn:documentation>
        <bpmn:incoming>W1367_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1367_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1367_Task11" name="BIR issues updated CAS registration permit; Tax Manager files permit with…">
        <bpmn:documentation>Step 6: BIR issues updated CAS registration permit; Tax Manager files permit with corporate records; distributes copies to Finance and IT
Responsible (R): Tax Manager
Accountable (A): Controller
Duration: 1 hour/renewal</bpmn:documentation>
        <bpmn:incoming>W1367_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1367_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1367_Task12" name="For system changes between renewals: CIO notifies Tax Manager of planned ERP…">
        <bpmn:documentation>Step 7: For system changes between renewals: CIO notifies Tax Manager of planned ERP changes; Tax Manager assesses whether change requires BIR notification (material changes) or can be documented internally (immaterial changes)
Responsible (R): CIO / Tax Manager
Accountable (A): Controller
Duration: Per change event</bpmn:documentation>
        <bpmn:incoming>W1367_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1367_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1367_Task13" name="Annual: Tax Manager conducts self-assessment compliance check: verifies all CAS…">
        <bpmn:documentation>Step 8: Annual: Tax Manager conducts self-assessment compliance check: verifies all CAS registrations are current, all system changes have been properly notified, and sample invoice/receipt formats match BIR-approved templates
Responsible (R): Tax Manager
Accountable (A): Controller
Duration: 4–6 hours/year</bpmn:documentation>
        <bpmn:incoming>W1367_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1367_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1367_End14" name="Complete">
        <bpmn:incoming>W1367_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1367_Annotation15">
        <bpmn:text>Controls: - CTL-308 (ensure controlled execution — Government Audit &amp; Inspection Response (PA-22.2).) | - operational: Tax Manager review and approval gate
Owner: Tax Manager</bpmn:text>
      </bpmn:textAnnotation>
