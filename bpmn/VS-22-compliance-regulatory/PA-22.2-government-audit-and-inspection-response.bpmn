    <bpmn:process id="W_W505" name="W505. DOLE Labor Inspection Response Protocol" isExecutable="false">
      <bpmn:documentation>Trigger: DOLE Regional Office serves notice of labor inspection (routine, complaint-driven, special, or follow-up)
Frequency: Routine: ~2–4 inspections/year across 200+ locations; complaint-driven: ad-hoc (~5–10/year); follow-up: as needed
Volume: ~10–15 total DOLE inspections/year across the company
Owner: CHRO
Participants: CHRO, Legal Counsel, Store Manager (if store inspection), DC Manager (if DC inspection), Payroll Manager, Safety Officer
Source: workflow W505 — DOLE Labor Inspection Response Protocol</bpmn:documentation>
      <bpmn:laneSet id="W505_LaneSet6">
        <bpmn:lane id="W505_Lane1" name="CHRO">
        <bpmn:flowNodeRef>W505_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W505_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W505_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W505_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W505_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W505_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W505_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W505_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W505_Lane2" name="Assigned Team">
        <bpmn:flowNodeRef>W505_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W505_Lane3" name="DOLE Inspector">
        <bpmn:flowNodeRef>W505_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W505_Lane4" name="Legal Counsel">
        <bpmn:flowNodeRef>W505_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W505_Lane5" name="HR Team">
        <bpmn:flowNodeRef>W505_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W505_End19</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W505_Start7" name="DOLE Regional Office serves notice of labor inspection (routine, complaint-driven…">
        <bpmn:outgoing>W505_Flow22</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W505_Task8" name="CHRO receives DOLE inspection notice; classifies inspection type (routine…">
        <bpmn:documentation>Step 1: CHRO receives DOLE inspection notice; classifies inspection type (routine, complaint-driven, special, follow-up); identifies inspection scope (specific location or HQ-wide)
Responsible (R): CHRO
Accountable (A): CHRO
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W505_Flow22</bpmn:incoming>
        <bpmn:outgoing>W505_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W505_Task9" name="CHRO assembles inspection response team: HR Manager, Payroll Manager, Legal…">
        <bpmn:documentation>Step 2: CHRO assembles inspection response team: HR Manager, Payroll Manager, Legal Counsel, Safety Officer (if OHS-related); assigns document preparation responsibilities
Responsible (R): CHRO
Accountable (A): VP Legal
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W505_Flow23</bpmn:incoming>
        <bpmn:outgoing>W505_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W505_Task10" name="Document preparation per DOLE checklist: (a) Employment contracts and 201 files…">
        <bpmn:documentation>Step 3: Document preparation per DOLE checklist: (a) Employment contracts and 201 files for all employees at inspection site; (b) Payroll registers (6 months) showing SSS/PhilHealth/Pag-IBIG deductions; (c) 13th month pay computation and proof of payment; (d) Service incentive leave records; (e) Overtime computation and holiday pay records; (f) SSS/PhilHealth/Pag-IBIG remittance receipts (6 months); (g) DOLE-required workplace postings (minimum wage, holiday pay, 13th month); (h) Safety committee minutes and OSHC compliance documents; (i) Working hours and rest period records; (j) Child labor / youth employment verification
Responsible (R): Assigned Team
Accountable (A): CHRO
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W505_Flow24</bpmn:incoming>
        <bpmn:outgoing>W505_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W505_Task11" name="CHRO or designate accompanies DOLE inspector during facility visit; takes notes…">
        <bpmn:documentation>Step 4: CHRO or designate accompanies DOLE inspector during facility visit; takes notes of all inspector questions, observations, and requests
Responsible (R): CHRO
Accountable (A): VP Legal
Duration: Full inspection</bpmn:documentation>
        <bpmn:incoming>W505_Flow25</bpmn:incoming>
        <bpmn:outgoing>W505_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W505_Task12" name="DOLE inspector conducts document review and employee interviews; HR team…">
        <bpmn:documentation>Step 5: DOLE inspector conducts document review and employee interviews; HR team provides requested documents and clarifications
Responsible (R): DOLE Inspector / HR Team
Accountable (A): CHRO
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W505_Flow26</bpmn:incoming>
        <bpmn:outgoing>W505_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W505_Task13" name="DOLE inspector issues inspection findings report (if deficiencies found); CHRO…">
        <bpmn:documentation>Step 6: DOLE inspector issues inspection findings report (if deficiencies found); CHRO acknowledges receipt and signs finding report with notation &quot;received for comment&quot;
Responsible (R): CHRO
Accountable (A): VP Legal
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W505_Flow27</bpmn:incoming>
        <bpmn:outgoing>W505_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W505_Task14" name="Legal Counsel reviews findings; CHRO prepares corrective action plan addressing…">
        <bpmn:documentation>Step 7: Legal Counsel reviews findings; CHRO prepares corrective action plan addressing each finding with specific actions, responsible persons, and target dates
Responsible (R): Legal Counsel / CHRO
Accountable (A): VP Legal
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W505_Flow28</bpmn:incoming>
        <bpmn:outgoing>W505_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W505_Task15" name="CHRO submits corrective action plan to DOLE within prescribed deadline…">
        <bpmn:documentation>Step 8: CHRO submits corrective action plan to DOLE within prescribed deadline (typically 5–10 working days from receipt of findings)
Responsible (R): CHRO
Accountable (A): VP Legal
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W505_Flow29</bpmn:incoming>
        <bpmn:outgoing>W505_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W505_Task16" name="HR team implements corrective actions; system tracks implementation status per…">
        <bpmn:documentation>Step 9: HR team implements corrective actions; system tracks implementation status per finding; escalation if corrective action not completed by target date
Responsible (R): HR Team
Accountable (A): CHRO
Duration: Variable</bpmn:documentation>
        <bpmn:incoming>W505_Flow30</bpmn:incoming>
        <bpmn:outgoing>W505_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W505_Task17" name="If re-inspection: CHRO prepares re-inspection package showing all corrective…">
        <bpmn:documentation>Step 10: If re-inspection: CHRO prepares re-inspection package showing all corrective actions completed with supporting evidence
Responsible (R): CHRO
Accountable (A): VP Legal
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W505_Flow31</bpmn:incoming>
        <bpmn:outgoing>W505_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W505_Task18" name="Annual: CHRO compiles DOLE inspection history; identifies recurring findings…">
        <bpmn:documentation>Step 11: Annual: CHRO compiles DOLE inspection history; identifies recurring findings across locations; develops systemic preventive measures
Responsible (R): CHRO
Accountable (A): VP Legal
Duration: 4 hours/year</bpmn:documentation>
        <bpmn:incoming>W505_Flow32</bpmn:incoming>
        <bpmn:outgoing>W505_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W505_End19" name="Complete">
        <bpmn:incoming>W505_Flow33</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W505_Annotation20">
        <bpmn:text>Controls: - CTL-308 (ensure controlled execution — Government Audit &amp; Inspection Response (PA-22.2).) | - operational: ensuring payroll records are accurate and complete before inspection; operational: system deadline tracking and escalation
Owner: CHRO</bpmn:text>
      </bpmn:textAnnotation>
