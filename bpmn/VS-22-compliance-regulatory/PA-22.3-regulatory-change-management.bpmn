    <bpmn:process id="W_W157" name="W157. E-waste Collection &amp; Circular Economy Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Customer brings end-of-life products (batteries, old tools, appliances) to store collection points
Frequency: Ongoing
Volume: Covers all 200 stores
Owner: Sustainability Manager
Participants: Store Staff, Logistics, Accredited Recyclers, DENR
Source: workflow W157 — E-waste Collection &amp; Circular Economy Operations</bpmn:documentation>
      <bpmn:laneSet id="W157_LaneSet6">
        <bpmn:lane id="W157_Lane1" name="Store Staff">
        <bpmn:flowNodeRef>W157_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W157_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W157_Lane2" name="System">
        <bpmn:flowNodeRef>W157_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W157_Lane3" name="Logistics">
        <bpmn:flowNodeRef>W157_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W157_Lane4" name="Recycler">
        <bpmn:flowNodeRef>W157_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W157_Lane5" name="Sustainability Manager">
        <bpmn:flowNodeRef>W157_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W157_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W157_Start7" name="Customer brings end-of-life products (batteries, old tools, appliances) to store…">
        <bpmn:outgoing>W157_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W157_Task8" name="Collection">
        <bpmn:documentation>Step 1: Collection: Customer drops off items at designated in-store bins; Store Staff record weight/type in system
Responsible (R): Store Staff
Accountable (A): Store Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W157_Flow16</bpmn:incoming>
        <bpmn:outgoing>W157_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W157_Task9" name="Incentive">
        <bpmn:documentation>Step 2: Incentive: System issues &quot;Green Points&quot; to customer loyalty account (W17) for participating
Responsible (R): System
Accountable (A): —
Duration: Real-time</bpmn:documentation>
        <bpmn:incoming>W157_Flow17</bpmn:incoming>
        <bpmn:outgoing>W157_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W157_Task10" name="Consolidation">
        <bpmn:documentation>Step 3: Consolidation: DC delivery trucks backhaul e-waste to the nearest Hub (W4)
Responsible (R): Logistics
Accountable (A): —
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W157_Flow18</bpmn:incoming>
        <bpmn:outgoing>W157_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W157_Task11" name="Certified Disposal">
        <bpmn:documentation>Step 4: Certified Disposal: Accredited 3rd-party recycler collects waste from DC; provide Certificate of Treatment
Responsible (R): Recycler
Accountable (A): Sustainability Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W157_Flow19</bpmn:incoming>
        <bpmn:outgoing>W157_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W157_Task12" name="Impact Reporting">
        <bpmn:documentation>Step 5: Impact Reporting: Track total tonnage diverted from landfills for ESG report (W114)
Responsible (R): Sustainability Manager
Accountable (A): CMO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W157_Flow20</bpmn:incoming>
        <bpmn:outgoing>W157_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W157_End13" name="Complete">
        <bpmn:incoming>W157_Flow21</bpmn:incoming>
      </bpmn:endEvent>
