    <bpmn:process id="W_W506" name="W506. Unified Regulatory Compliance Calendar &amp; Dashboard" isExecutable="false">
      <bpmn:documentation>Trigger: Annual compliance calendar setup (January); ongoing deadline monitoring and alerting
Frequency: Continuous monitoring; daily deadline alerts; weekly compliance status review
Volume: ~500–700 compliance obligations/year across 5 entities × 200+ locations × 7+ regulatory bodies
Owner: Compliance Officer
Participants: Tax Accountant (BIR), Legal Counsel (SEC), Safety Officer (DOLE), Environmental Officer (DENR), Facilities Coordinator (LGU), Regulatory Officer (FDA/CAAP)
Source: workflow W506 — Unified Regulatory Compliance Calendar &amp; Dashboard</bpmn:documentation>
      <bpmn:laneSet id="W506_LaneSet4">
        <bpmn:lane id="W506_Lane1" name="Compliance Officer">
        <bpmn:flowNodeRef>W506_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W506_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W506_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W506_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W506_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W506_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W506_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W506_Lane2" name="System">
        <bpmn:flowNodeRef>W506_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W506_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W506_Lane3" name="Responsible Person">
        <bpmn:flowNodeRef>W506_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W506_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W506_Start5" name="Annual compliance calendar setup (January); ongoing deadline monitoring and alerting">
        <bpmn:outgoing>W506_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W506_Task6" name="Compliance Officer initializes annual compliance calendar: loads all known…">
        <bpmn:documentation>Step 1: Compliance Officer initializes annual compliance calendar: loads all known recurring obligations per regulatory body (BIR monthly/quarterly/annual, LGU annual permits, DOLE annual reporting, DENR quarterly, SEC annual filings, FDA renewals, CAAP clearances)
Responsible (R): Compliance Officer
Accountable (A): VP Legal
Duration: 8 hours/year</bpmn:documentation>
        <bpmn:incoming>W506_Flow18</bpmn:incoming>
        <bpmn:outgoing>W506_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W506_Task7" name="System maps each obligation to: responsible person, affected entities, affected…">
        <bpmn:documentation>Step 2: System maps each obligation to: responsible person, affected entities, affected locations, deadline date, preparation lead time, required documents, reference workflow
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W506_Flow19</bpmn:incoming>
        <bpmn:outgoing>W506_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W506_Task8" name="System generates automated alerts: 30-day advance notice to responsible person…">
        <bpmn:documentation>Step 3: System generates automated alerts: 30-day advance notice to responsible person; 7-day reminder; 1-day urgent alert; overdue escalation to Compliance Officer and VP Legal
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W506_Flow20</bpmn:incoming>
        <bpmn:outgoing>W506_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W506_Task9" name="Responsible person updates obligation status: Not Started → In Progress →…">
        <bpmn:documentation>Step 4: Responsible person updates obligation status: Not Started → In Progress → Submitted → Confirmed; attaches proof of submission (eFiling confirmation, receipt, permit copy)
Responsible (R): Responsible Person
Accountable (A): Compliance Officer
Duration: 5 min/obligation</bpmn:documentation>
        <bpmn:incoming>W506_Flow21</bpmn:incoming>
        <bpmn:outgoing>W506_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W506_Task10" name="Compliance Officer reviews weekly compliance dashboard: completion rate…">
        <bpmn:documentation>Step 5: Compliance Officer reviews weekly compliance dashboard: completion rate, upcoming deadlines, overdue items, at-risk obligations
Responsible (R): Compliance Officer
Accountable (A): VP Legal
Duration: 1 hour/week</bpmn:documentation>
        <bpmn:incoming>W506_Flow22</bpmn:incoming>
        <bpmn:outgoing>W506_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W506_Task11" name="For multi-location obligations (e.g., LGU business permits for 200 stores)…">
        <bpmn:documentation>Step 6: For multi-location obligations (e.g., LGU business permits for 200 stores): system provides per-location status view with drill-down; Compliance Officer identifies lagging locations and escalates to Regional Manager
Responsible (R): Compliance Officer
Accountable (A): COO
Duration: 30 min/week</bpmn:documentation>
        <bpmn:incoming>W506_Flow23</bpmn:incoming>
        <bpmn:outgoing>W506_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W506_Task12" name="Monthly: Compliance Officer generates compliance status report for executive…">
        <bpmn:documentation>Step 7: Monthly: Compliance Officer generates compliance status report for executive review: completion rate by regulatory body, overdue items with root cause, risk exposure assessment, upcoming critical deadlines
Responsible (R): Compliance Officer
Accountable (A): CFO / VP Legal
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W506_Flow24</bpmn:incoming>
        <bpmn:outgoing>W506_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W506_Task13" name="Quarterly: Compliance Officer conducts compliance risk review: identifies new…">
        <bpmn:documentation>Step 8: Quarterly: Compliance Officer conducts compliance risk review: identifies new regulatory requirements, assesses impact, assigns to responsible teams for implementation
Responsible (R): Compliance Officer
Accountable (A): VP Legal
Duration: 4 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W506_Flow25</bpmn:incoming>
        <bpmn:outgoing>W506_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W506_Task14" name="Annually: Compliance Officer compiles annual compliance report: total…">
        <bpmn:documentation>Step 9: Annually: Compliance Officer compiles annual compliance report: total obligations, completion rate, penalty exposure, audit findings, improvement recommendations
Responsible (R): Compliance Officer
Accountable (A): CFO / VP Legal
Duration: 8 hours/year</bpmn:documentation>
        <bpmn:incoming>W506_Flow26</bpmn:incoming>
        <bpmn:outgoing>W506_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W506_End15" name="Complete">
        <bpmn:incoming>W506_Flow27</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W506_Annotation16">
        <bpmn:text>Controls: - CTL-309 (ensure controlled execution — Regulatory Change Management (PA-22.3).) | - operational: quarterly regulatory scan and subscription to BIR/DOLE/DENR/SEC advisory services; operational: per-location status dashboard and automated escalation; operational: backup assignment in system and 30-day advance alerting
Owner: Compliance Officer</bpmn:text>
      </bpmn:textAnnotation>
