        <bpmn:flowNodeRef>W185_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W185_Lane3" name="Risk Manager">
        <bpmn:flowNodeRef>W185_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W185_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W185_Lane4" name="Legal Manager">
        <bpmn:flowNodeRef>W185_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W185_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W185_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W185_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W185_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W185_Start6" name="Report of property damage, personal injury, or safety hazard related to a sold product">
        <bpmn:outgoing>W185_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W185_Task7" name="Customer Service Rep receives report; records incident details, product SKU…">
        <bpmn:documentation>Step 1: Customer Service Rep receives report; records incident details, product SKU, batch/lot (if available), and photos in ERP
Responsible (R): CS Rep
Accountable (A): CS Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W185_Flow18</bpmn:incoming>
        <bpmn:outgoing>W185_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W185_Task8" name="System flags product; if multiple reports occur for same SKU, alerts…">
        <bpmn:documentation>Step 2: System flags product; if multiple reports occur for same SKU, alerts Merchandising for potential stop-sell
Responsible (R): System
Accountable (A): Merchandising Manager
Duration: Real-time</bpmn:documentation>
        <bpmn:incoming>W185_Flow19</bpmn:incoming>
        <bpmn:outgoing>W185_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W185_Task9" name="Store Manager/Risk Manager conducts physical inspection of incident site or…">
        <bpmn:documentation>Step 3: Store Manager/Risk Manager conducts physical inspection of incident site or product remains
Responsible (R): Risk Manager
Accountable (A): Legal Manager
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W185_Flow20</bpmn:incoming>
        <bpmn:outgoing>W185_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W185_Task10" name="Legal Manager reviews documentation; determines liability and coordinates with…">
        <bpmn:documentation>Step 4: Legal Manager reviews documentation; determines liability and coordinates with insurance (W59)
Responsible (R): Legal Manager
Accountable (A): CFO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W185_Flow21</bpmn:incoming>
        <bpmn:outgoing>W185_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W185_Task11" name="Formal notice sent to Vendor; request for investigation and indemnity">
        <bpmn:documentation>Step 5: Formal notice sent to Vendor; request for investigation and indemnity
Responsible (R): Legal Manager
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W185_Flow22</bpmn:incoming>
        <bpmn:outgoing>W185_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W185_Task12" name="Coordinate with DTI (Dept of Trade and Industry) if mandatory product recall is…">
        <bpmn:documentation>Step 6: Coordinate with DTI (Dept of Trade and Industry) if mandatory product recall is triggered (W29)
Responsible (R): Legal Manager
Accountable (A): —
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W185_Flow23</bpmn:incoming>
        <bpmn:outgoing>W185_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W185_Task13" name="Resolve claim: settlement, replacement, or legal defense">
        <bpmn:documentation>Step 7: Resolve claim: settlement, replacement, or legal defense
Responsible (R): Legal Manager
Accountable (A): CFO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W185_Flow24</bpmn:incoming>
        <bpmn:outgoing>W185_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W185_Task14" name="Document &quot;Lessons Learned&quot;; feed into Vendor Performance Review (W44)">
        <bpmn:documentation>Step 8: Document &quot;Lessons Learned&quot;; feed into Vendor Performance Review (W44)
Responsible (R): Risk Manager
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W185_Flow25</bpmn:incoming>
        <bpmn:outgoing>W185_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W185_End15" name="Complete">
        <bpmn:incoming>W185_Flow26</bpmn:incoming>
      </bpmn:endEvent>
