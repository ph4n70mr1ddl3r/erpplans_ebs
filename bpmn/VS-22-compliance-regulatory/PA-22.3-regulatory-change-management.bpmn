    <bpmn:process id="W_W656" name="W656. Anti-Bribery &amp; Anti-Corruption (ABAC) Compliance Program" isExecutable="false">
      <bpmn:documentation>Trigger: Annual program cycle; triggered by suspicion of corrupt activity; periodic third-party due diligence
Frequency: Annual risk assessment and training; continuous monitoring; quarterly gift register review
Volume: ~6,932 employees (annual training); ~800–1,000 vendors (due diligence); ~200 LGUs (interaction points)
Owner: Compliance Officer
Participants: Legal Counsel, Internal Audit (W159), Procurement Manager, HR Manager
Source: workflow W656 — Anti-Bribery &amp; Anti-Corruption (ABAC) Compliance Program</bpmn:documentation>
      <bpmn:laneSet id="W656_LaneSet4">
        <bpmn:lane id="W656_Lane1" name="Compliance Officer">
        <bpmn:flowNodeRef>W656_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W656_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W656_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W656_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W656_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W656_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W656_Lane2" name="HR Manager">
        <bpmn:flowNodeRef>W656_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W656_Lane3" name="Employee">
        <bpmn:flowNodeRef>W656_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W656_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W656_Start5" name="Annual program cycle; triggered by suspicion of corrupt activity; periodic third-party…">
        <bpmn:outgoing>W656_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W656_Task6" name="Annual: Compliance Officer conducts ABAC risk assessment: identifies high-risk…">
        <bpmn:documentation>Step 1: Annual: Compliance Officer conducts ABAC risk assessment: identifies high-risk roles (procurement buyers, store managers interacting with LGU officials, government procurement team, construction project managers), high-risk transactions (government permits per W54, vendor selection per W632, construction contracts per W224), and high-risk geographies (LGUs with known corruption history)
Responsible (R): Compliance Officer
Accountable (A): VP Legal
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W656_Flow16</bpmn:incoming>
        <bpmn:outgoing>W656_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W656_Task7" name="Annual: HR Manager facilitates anti-corruption training for all employees…">
        <bpmn:documentation>Step 2: Annual: HR Manager facilitates anti-corruption training for all employees (online module, 1 hour); enhanced in-person training for high-risk roles (3 hours with case studies and Philippine context — Anti-Graft and Corrupt Practices Act RA 3019)
Responsible (R): HR Manager
Accountable (A): Compliance Officer
Duration: 1 month rollout</bpmn:documentation>
        <bpmn:incoming>W656_Flow17</bpmn:incoming>
        <bpmn:outgoing>W656_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W656_Task8" name="Continuous: Compliance Officer manages gift and entertainment register —…">
        <bpmn:documentation>Step 3: Continuous: Compliance Officer manages gift and entertainment register — employees declare all gifts/hospitality received from vendors or government officials exceeding PHP 1,000; system auto-routes declarations to Compliance Officer for review and approval/return
Responsible (R): Employee
Accountable (A): Compliance Officer
Duration: 5 min/declaration</bpmn:documentation>
        <bpmn:incoming>W656_Flow18</bpmn:incoming>
        <bpmn:outgoing>W656_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W656_Task9" name="Quarterly: Compliance Officer reviews gift register for patterns (excessive…">
        <bpmn:documentation>Step 4: Quarterly: Compliance Officer reviews gift register for patterns (excessive gifts from specific vendor, gifts to specific government officials); investigates anomalies
Responsible (R): Compliance Officer
Accountable (A): VP Legal
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W656_Flow19</bpmn:incoming>
        <bpmn:outgoing>W656_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W656_Task10" name="For vendor onboarding (W36/W620): Compliance Officer conducts third-party due…">
        <bpmn:documentation>Step 5: For vendor onboarding (W36/W620): Compliance Officer conducts third-party due diligence for high-risk vendors and agents — beneficial ownership verification, PEP (Politically Exposed Person) screening, sanctions list screening, reputation risk assessment
Responsible (R): Compliance Officer
Accountable (A): Procurement Manager
Duration: 1 day/vendor</bpmn:documentation>
        <bpmn:incoming>W656_Flow20</bpmn:incoming>
        <bpmn:outgoing>W656_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W656_Task11" name="For suspected corrupt activity: Compliance Officer activates investigation…">
        <bpmn:documentation>Step 6: For suspected corrupt activity: Compliance Officer activates investigation protocol; coordinates with Internal Audit (W159) and Legal Counsel; ensures whistleblower protection per W79; escalates to CEO and Board Audit Committee if confirmed
Responsible (R): Compliance Officer
Accountable (A): VP Legal
Duration: Per investigation</bpmn:documentation>
        <bpmn:incoming>W656_Flow21</bpmn:incoming>
        <bpmn:outgoing>W656_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W656_Task12" name="Annual: Compliance Officer produces ABAC program effectiveness report: training…">
        <bpmn:documentation>Step 7: Annual: Compliance Officer produces ABAC program effectiveness report: training completion rate, gift register compliance, due diligence completion, investigation outcomes, recommendations; presents to Board Audit Committee
Responsible (R): Compliance Officer
Accountable (A): VP Legal
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W656_Flow22</bpmn:incoming>
        <bpmn:outgoing>W656_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W656_End13" name="Complete">
        <bpmn:incoming>W656_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W656_Annotation14">
        <bpmn:text>Controls: - CTL-309 (ensure controlled execution — Regulatory Change Management (PA-22.3).) | - operational: Compliance Officer review and approval gate
Owner: Compliance Officer</bpmn:text>
      </bpmn:textAnnotation>
