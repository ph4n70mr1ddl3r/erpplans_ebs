    <bpmn:process id="W_W444" name="W444. Community Solicitation &amp; Donation Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Receipt of a solicitation letter or donation request from a local Barangay, school, or organization
Frequency: Weekly; ~5–10 requests per store/month
Volume: High volume of low-value requests (PHP 2,000–20,000)
Owner: Store Manager
Participants: Store Manager, Regional Manager, CSR Lead, Marketing (HQ)
Source: workflow W444 — Community Solicitation &amp; Donation Processing</bpmn:documentation>
      <bpmn:laneSet id="W444_LaneSet6">
        <bpmn:lane id="W444_Lane1" name="CSR">
        <bpmn:flowNodeRef>W444_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W444_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W444_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W444_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W444_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W444_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W444_Lane3" name="Approver">
        <bpmn:flowNodeRef>W444_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W444_Lane4" name="Stock Associate">
        <bpmn:flowNodeRef>W444_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W444_Lane5" name="Finance">
        <bpmn:flowNodeRef>W444_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W444_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W444_Start7" name="Receipt of a solicitation letter or donation request from a local Barangay, school, or…">
        <bpmn:outgoing>W444_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W444_Task8" name="Intake">
        <bpmn:documentation>Step 1: Intake: CSR receives solicitation letter; logs request in the &quot;CSR Portal&quot;; scans the letter and ID of requester
Responsible (R): CSR
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W444_Flow18</bpmn:incoming>
        <bpmn:outgoing>W444_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W444_Task9" name="Validation">
        <bpmn:documentation>Step 2: Validation: Store Manager verifies the legitimacy of the requesting organization (e.g., Barangay ID, School Principal signature)
Responsible (R): Store Manager
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W444_Flow19</bpmn:incoming>
        <bpmn:outgoing>W444_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W444_Task10" name="Approval (Tiered)">
        <bpmn:documentation>Step 3: Approval (Tiered): (a) Store Manager approves if &lt; PHP 5K (Product only); (b) Regional Manager approves if PHP 5K–20K; (c) HQ Marketing approves if &gt; PHP 20K
Responsible (R): Approver
Accountable (A): —
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W444_Flow20</bpmn:incoming>
        <bpmn:outgoing>W444_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W444_Task11" name="Item Selection">
        <bpmn:documentation>Step 4: Item Selection: Store Manager selects &quot;Donation eligible&quot; SKUs (e.g., damaged-box paint, slow-moving items)
Responsible (R): Store Manager
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W444_Flow21</bpmn:incoming>
        <bpmn:outgoing>W444_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W444_Task12" name="Issue Voucher">
        <bpmn:documentation>Step 5: Issue Voucher: System generates a &quot;Donation Voucher&quot;; requester signs &quot;Deed of Donation&quot; / Acknowledgment Receipt
Responsible (R): CSR
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W444_Flow22</bpmn:incoming>
        <bpmn:outgoing>W444_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W444_Task13" name="Inventory Release">
        <bpmn:documentation>Step 6: Inventory Release: Stock Associate releases items at the loading dock; system posts inventory adjustment (Reason Code: DONATION)
Responsible (R): Stock Associate
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W444_Flow23</bpmn:incoming>
        <bpmn:outgoing>W444_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W444_Task14" name="Tax Documentation">
        <bpmn:documentation>Step 7: Tax Documentation: Finance extracts monthly donation log for BIR tax-deductible expense filing
Responsible (R): Finance (Tax)
Accountable (A): —
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W444_Flow24</bpmn:incoming>
        <bpmn:outgoing>W444_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W444_End15" name="Complete">
        <bpmn:incoming>W444_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W444_Annotation16">
        <bpmn:text>Controls: - CTL-309 (ensure controlled execution — Regulatory Change Management (PA-22.3).) | - operational: Store Manager review and approval gate
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W444_Assoc17" sourceRef="W444_Annotation16" targetRef="W444_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W444_Flow18" sourceRef="W444_Start7" targetRef="W444_Task8" />
      <bpmn:sequenceFlow id="W444_Flow19" sourceRef="W444_Task8" targetRef="W444_Task9" />
      <bpmn:sequenceFlow id="W444_Flow20" sourceRef="W444_Task9" targetRef="W444_Task10" />
      <bpmn:sequenceFlow id="W444_Flow21" sourceRef="W444_Task10" targetRef="W444_Task11" />
      <bpmn:sequenceFlow id="W444_Flow22" sourceRef="W444_Task11" targetRef="W444_Task12" />
      <bpmn:sequenceFlow id="W444_Flow23" sourceRef="W444_Task12" targetRef="W444_Task13" />
      <bpmn:sequenceFlow id="W444_Flow24" sourceRef="W444_Task13" targetRef="W444_Task14" />
      <bpmn:sequenceFlow id="W444_Flow25" sourceRef="W444_Task14" targetRef="W444_End15" />
    </bpmn:process>
