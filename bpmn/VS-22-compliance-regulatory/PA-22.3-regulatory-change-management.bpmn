    <bpmn:process id="W_W185" name="W185. Product Liability &amp; Consumer Safety Incident Management" isExecutable="false">
      <bpmn:documentation>Trigger: Report of property damage, personal injury, or safety hazard related to a sold product
Frequency: As occurred
Volume: &lt; 10 incidents/month
Owner: Legal &amp; Compliance Manager
Participants: Customer Service Manager, Risk Manager, Store Manager, Vendor (Supplier)
Source: workflow W185 — Product Liability &amp; Consumer Safety Incident Management</bpmn:documentation>
      <bpmn:laneSet id="W185_LaneSet5">
        <bpmn:lane id="W185_Lane1" name="CS Rep">
        <bpmn:flowNodeRef>W185_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W185_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
