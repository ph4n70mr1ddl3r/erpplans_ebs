    <bpmn:process id="W_W2747" name="W2747. DTI Sales Promotion Permit Application &amp; Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: Marketing team finalizes mechanics for a promotional campaign (W83, W13)
Frequency: ~20–30 times per year
Volume: Covers all major sales events, raffles, and &quot;Buy 1 Get 1&quot; promos
Owner: Regulatory Officer
Participants: Marketing Campaign Manager, DTI Representative, Finance
Source: workflow W2747 — DTI Sales Promotion Permit Application &amp; Compliance</bpmn:documentation>
      <bpmn:laneSet id="W2747_LaneSet4">
        <bpmn:lane id="W2747_Lane1" name="Marketing Manager">
        <bpmn:flowNodeRef>W2747_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2747_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2747_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2747_Lane2" name="Regulatory Officer">
        <bpmn:flowNodeRef>W2747_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2747_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2747_Lane3" name="Finance">
        <bpmn:flowNodeRef>W2747_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2747_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2747_Start5" name="Marketing team finalizes mechanics for a promotional campaign (W83, W13)">
        <bpmn:outgoing>W2747_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2747_Task6" name="Promo Review">
        <bpmn:documentation>Step 1: Promo Review: Marketing submits promo mechanics to Regulatory Officer 30-45 days before launch
Responsible (R): Marketing Manager
Accountable (A): CMO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W2747_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2747_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2747_Task7" name="DTI Filing">
        <bpmn:documentation>Step 2: DTI Filing: Regulatory Officer prepares and files permit application via DTI portal
Responsible (R): Regulatory Officer
Accountable (A): VP Legal &amp; Compliance
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W2747_Flow15</bpmn:incoming>
        <bpmn:outgoing>W2747_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2747_Task8" name="Payment &amp; Tracking">
        <bpmn:documentation>Step 3: Payment &amp; Tracking: Finance pays DTI processing fee; Regulatory Officer tracks permit status
Responsible (R): Finance / Regulatory Officer
Accountable (A): Controller
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2747_Flow16</bpmn:incoming>
        <bpmn:outgoing>W2747_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2747_Task9" name="Permit Issuance">
        <bpmn:documentation>Step 4: Permit Issuance: DTI approves and issues Permit Number; Regulatory Officer updates promo record
Responsible (R): Regulatory Officer
Accountable (A): VP Legal &amp; Compliance
Duration: 5–15 days lead time</bpmn:documentation>
        <bpmn:incoming>W2747_Flow17</bpmn:incoming>
        <bpmn:outgoing>W2747_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2747_Task10" name="Marketing Integration">
        <bpmn:documentation>Step 5: Marketing Integration: Marketing includes DTI Permit Number on all advertising materials
Responsible (R): Marketing Manager
Accountable (A): CMO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2747_Flow18</bpmn:incoming>
        <bpmn:outgoing>W2747_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2747_End11" name="Complete">
        <bpmn:incoming>W2747_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2747_Annotation12">
        <bpmn:text>Controls: - CTL-307 (ensure controlled execution — Regulatory Permits &amp; Licenses (PA-22.1).) | - operational: Regulatory Officer review and approval gate
Owner: Regulatory Officer</bpmn:text>
      </bpmn:textAnnotation>
