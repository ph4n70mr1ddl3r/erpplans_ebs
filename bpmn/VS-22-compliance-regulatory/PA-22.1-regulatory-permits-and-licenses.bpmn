    <bpmn:process id="W_W49" name="W49. Natural Disaster / Typhoon Business Continuity" isExecutable="false">
      <bpmn:documentation>Trigger: PAGASA raises tropical cyclone warning signal over a store/DC location; or earthquake, flooding, or volcanic activity alert
Frequency: ~10–20 typhoon-related events/year requiring action across Philippine store network; 2–4 significant events/year with store closures
Volume: Variable — from 1–2 stores affected (localized flooding) to 50+ stores (major typhoon crossing multiple regions)
Owner: COO (overall response); Store Manager (store-level execution)
Participants: COO, VP Store Operations, Regional Managers, Store Managers, DC Managers, IT, HR, Finance, Supply Chain, Marketing, Logistics
Source: workflow W49 — Natural Disaster / Typhoon Business Continuity</bpmn:documentation>
      <bpmn:laneSet id="W49_LaneSet15">
        <bpmn:lane id="W49_Lane1" name="COO">
        <bpmn:flowNodeRef>W49_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W49_Task24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W49_Task31</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W49_Task38</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W49_Start16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W49_Lane2" name="Regional Manager">
        <bpmn:flowNodeRef>W49_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W49_Task30</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W49_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W49_Task19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W49_Task27</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W49_Task28</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W49_Task29</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W49_Task32</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W49_Lane4" name="DC Manager">
        <bpmn:flowNodeRef>W49_Task20</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W49_Lane5" name="IT Team">
        <bpmn:flowNodeRef>W49_Task21</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W49_Lane6" name="HR Head">
        <bpmn:flowNodeRef>W49_Task22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W49_Task35</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W49_Lane7" name="Supply Planner">
        <bpmn:flowNodeRef>W49_Task23</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W49_Task34</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W49_Lane8" name="Marketing">
        <bpmn:flowNodeRef>W49_Task25</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W49_Task36</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W49_Lane9" name="Ecom Team">
        <bpmn:flowNodeRef>W49_Task26</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W49_Lane10" name="Facilities Coordinator">
        <bpmn:flowNodeRef>W49_Task33</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W49_Lane11" name="IT">
        <bpmn:flowNodeRef>W49_Task37</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W49_Lane12" name="Controller">
        <bpmn:flowNodeRef>W49_Task39</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W49_Lane13" name="Treasury Analyst">
        <bpmn:flowNodeRef>W49_Task40</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W49_Lane14" name="VP Store Operations">
        <bpmn:flowNodeRef>W49_Task41</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W49_End42</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W49_Start16" name="PAGASA raises tropical cyclone warning signal over a store/DC location; or earthquake…">
        <bpmn:outgoing>W49_Flow45</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W49_Task17" name="COO monitors PAGASA bulletins and NDRRMC advisories; activates disaster…">
        <bpmn:documentation>Step 1: COO monitors PAGASA bulletins and NDRRMC advisories; activates disaster monitoring protocol when Signal 1 is raised over any operating region
Responsible (R): COO
Accountable (A): CEO
Duration: Ongoing during typhoon season</bpmn:documentation>
        <bpmn:incoming>W49_Flow45</bpmn:incoming>
        <bpmn:outgoing>W49_Flow46</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W49_Task18" name="Regional Managers notify Store Managers in affected regions to begin…">
        <bpmn:documentation>Step 2: Regional Managers notify Store Managers in affected regions to begin preparations; Store Managers brief all staff
Responsible (R): Regional Manager
Accountable (A): VP Store Operations
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W49_Flow46</bpmn:incoming>
        <bpmn:outgoing>W49_Flow47</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W49_Task19" name="Store preparations">
        <bpmn:documentation>Step 3: Store preparations: Store Manager directs staff to: (a) secure outdoor yard inventory — move lumber, cement, and building materials under cover or to higher ground; (b) protect floor-level merchandise from potential flooding (move to higher shelves or backroom); (c) secure display fixtures, signage, and loose items; (d) verify backup power (generator fuel level, battery backup for POS); (e) verify emergency supplies (flashlights, first aid kits, drinking water)
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W49_Flow47</bpmn:incoming>
        <bpmn:outgoing>W49_Flow48</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W49_Task20" name="DC preparations">
        <bpmn:documentation>Step 4: DC preparations: DC Manager directs staff to: (a) prioritize outbound shipments to stores in safe zones before transport disruption; (b) secure outdoor inventory and yard areas; (c) verify backup power systems; (d) coordinate with carriers to suspend inbound shipments to affected areas
Responsible (R): DC Manager
Accountable (A): Supply Chain Manager
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W49_Flow48</bpmn:incoming>
        <bpmn:outgoing>W49_Flow49</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W49_Task21" name="IT sends system advisory to all locations: reminder of offline POS procedures…">
        <bpmn:documentation>Step 5: IT sends system advisory to all locations: reminder of offline POS procedures (W5G), system backup schedule accelerated
Responsible (R): IT Team
Accountable (A): CIO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W49_Flow49</bpmn:incoming>
        <bpmn:outgoing>W49_Flow50</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W49_Task22" name="HR verifies emergency contact information for all employees in affected…">
        <bpmn:documentation>Step 6: HR verifies emergency contact information for all employees in affected regions; prepares welfare check plan
Responsible (R): HR Head
Accountable (A): CHRO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W49_Flow50</bpmn:incoming>
        <bpmn:outgoing>W49_Flow51</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W49_Task23" name="Supply Planner reviews inventory levels at stores and DCs in projected path…">
        <bpmn:documentation>Step 7: Supply Planner reviews inventory levels at stores and DCs in projected path; identifies potential stockout risks for essential items (tarps, waterproofing, cement, plywood, flashlights, batteries, generators)
Responsible (R): Supply Planner
Accountable (A): Supply Chain Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W49_Flow51</bpmn:incoming>
        <bpmn:outgoing>W49_Flow52</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W49_Task24" name="COO makes store closure decision based on: PAGASA signal level (Signal 2+…">
        <bpmn:documentation>Step 8: COO makes store closure decision based on: PAGASA signal level (Signal 2+ triggers automatic closure), LGU advisory, road conditions, staff safety assessment; decisions made by region, not chain-wide
Responsible (R): COO
Accountable (A): CEO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W49_Flow52</bpmn:incoming>
        <bpmn:outgoing>W49_Flow53</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W49_Task25" name="Marketing communicates closure to customers: update website, social media…">
        <bpmn:documentation>Step 9: Marketing communicates closure to customers: update website, social media, Google Business listings; send SMS/email to loyalty members in affected areas
Responsible (R): Marketing
Accountable (A): CMO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W49_Flow53</bpmn:incoming>
        <bpmn:outgoing>W49_Flow54</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W49_Task26" name="Ecommerce platform: Digital Commerce Inc. suspends BOPIS and delivery orders…">
        <bpmn:documentation>Step 10: Ecommerce platform: Digital Commerce Inc. suspends BOPIS and delivery orders for closed stores/DCs; displays closure notice
Responsible (R): Ecom Team
Accountable (A): CMO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W49_Flow54</bpmn:incoming>
        <bpmn:outgoing>W49_Flow55</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W49_Task27" name="Store Manager executes early closing procedure (abbreviated W5F): expedited…">
        <bpmn:documentation>Step 11: Store Manager executes early closing procedure (abbreviated W5F): expedited Z-report, cash secured in safe (do NOT send with armored car during typhoon — hold in safe), POS shut down, building secured
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W49_Flow55</bpmn:incoming>
        <bpmn:outgoing>W49_Flow56</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W49_Task28" name="Store Manager sends staff home with safety instructions; confirms all staff…">
        <bpmn:documentation>Step 12: Store Manager sends staff home with safety instructions; confirms all staff have departed safely
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W49_Flow56</bpmn:incoming>
        <bpmn:outgoing>W49_Flow57</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W49_Task29" name="Store Manager or designated contact conducts visual assessment of store…">
        <bpmn:documentation>Step 13: Store Manager or designated contact conducts visual assessment of store exterior (drive-by or walk-by) as soon as safely possible after event passes; reports to Regional Manager: structural damage, flooding, power status, yard inventory status
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W49_Flow57</bpmn:incoming>
        <bpmn:outgoing>W49_Flow58</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W49_Task30" name="Regional Manager compiles damage assessment across affected stores; reports to…">
        <bpmn:documentation>Step 14: Regional Manager compiles damage assessment across affected stores; reports to COO and VP Store Operations
Responsible (R): Regional Manager
Accountable (A): COO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W49_Flow58</bpmn:incoming>
        <bpmn:outgoing>W49_Flow59</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W49_Task31" name="COO makes reopening decision per store: (a) open immediately if no damage and…">
        <bpmn:documentation>Step 15: COO makes reopening decision per store: (a) open immediately if no damage and power/connectivity restored, (b) delayed opening for minor cleanup and repair, (c) remain closed for significant damage requiring repair or insurance assessment
Responsible (R): COO
Accountable (A): CEO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W49_Flow59</bpmn:incoming>
        <bpmn:outgoing>W49_Flow60</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W49_Task32" name="If inventory damaged">
        <bpmn:documentation>Step 16: If inventory damaged: Store Manager conducts damage inventory with photos; system creates damage report; disposition per W6.8a (scrap, markdown, RTV, insurance claim)
Responsible (R): Store Manager / Maintenance
Accountable (A): Regional Manager
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W49_Flow60</bpmn:incoming>
        <bpmn:outgoing>W49_Flow61</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W49_Task33" name="If facility damaged">
        <bpmn:documentation>Step 17: If facility damaged: Facilities Coordinator engages contractors for emergency repair; Store Manager initiates insurance claim per W3.6a process (photos, documentation, claim filing)
Responsible (R): Facilities Coordinator / Store Manager
Accountable (A): VP Store Operations
Duration: Varies</bpmn:documentation>
        <bpmn:incoming>W49_Flow61</bpmn:incoming>
        <bpmn:outgoing>W49_Flow62</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W49_Task34" name="Supply Planner triggers emergency replenishment for disaster-response items…">
        <bpmn:documentation>Step 18: Supply Planner triggers emergency replenishment for disaster-response items (tarps, plywood, cement, paint, waterproofing, tools, generators) to reopened stores; coordinates with DC for expedited shipment
Responsible (R): Supply Planner
Accountable (A): Supply Chain Manager
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W49_Flow62</bpmn:incoming>
        <bpmn:outgoing>W49_Flow63</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W49_Task35" name="HR conducts welfare check on all employees in affected regions within 24 hours…">
        <bpmn:documentation>Step 19: HR conducts welfare check on all employees in affected regions within 24 hours; provides assistance (advance salary, emergency loan, temporary shelter) per company policy
Responsible (R): HR Head
Accountable (A): CHRO
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W49_Flow63</bpmn:incoming>
        <bpmn:outgoing>W49_Flow64</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W49_Task36" name="Marketing communicates reopening to customers; update website and social media…">
        <bpmn:documentation>Step 20: Marketing communicates reopening to customers; update website and social media; potential &quot;rebuilding supplies&quot; promotion to serve community needs
Responsible (R): Marketing
Accountable (A): CMO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W49_Flow64</bpmn:incoming>
        <bpmn:outgoing>W49_Flow65</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W49_Task37" name="System reconciles: process any offline POS transactions from pre-closure…">
        <bpmn:documentation>Step 21: System reconciles: process any offline POS transactions from pre-closure; reverse pending ecommerce orders for closed stores; update inventory for damaged/scrapped items
Responsible (R): IT / Finance
Accountable (A): Controller
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W49_Flow65</bpmn:incoming>
        <bpmn:outgoing>W49_Flow66</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W49_Task38" name="COO conducts after-action review: preparation adequacy, response time, damage…">
        <bpmn:documentation>Step 22: COO conducts after-action review: preparation adequacy, response time, damage extent, recovery speed, staff safety outcomes
Responsible (R): COO
Accountable (A): CEO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W49_Flow66</bpmn:incoming>
        <bpmn:outgoing>W49_Flow67</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W49_Task39" name="Finance quantifies total loss: inventory damage, facility repair costs, revenue…">
        <bpmn:documentation>Step 23: Finance quantifies total loss: inventory damage, facility repair costs, revenue loss from closure days, insurance recovery
Responsible (R): Controller
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W49_Flow67</bpmn:incoming>
        <bpmn:outgoing>W49_Flow68</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W49_Task40" name="Insurance claims finalized for major events; Finance tracks claim status and…">
        <bpmn:documentation>Step 24: Insurance claims finalized for major events; Finance tracks claim status and settlement
Responsible (R): Treasury Analyst
Accountable (A): CFO
Duration: Varies</bpmn:documentation>
        <bpmn:incoming>W49_Flow68</bpmn:incoming>
        <bpmn:outgoing>W49_Flow69</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W49_Task41" name="VP Store Operations updates disaster response procedures based on lessons…">
        <bpmn:documentation>Step 25: VP Store Operations updates disaster response procedures based on lessons learned
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W49_Flow69</bpmn:incoming>
        <bpmn:outgoing>W49_Flow70</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W49_End42" name="Complete">
        <bpmn:incoming>W49_Flow70</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W49_Annotation43">
        <bpmn:text>Controls: - CTL-307 (ensure controlled execution — Regulatory Permits &amp; Licenses (PA-22.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: COO (overall response); Store Manager (store-level execution)</bpmn:text>
      </bpmn:textAnnotation>
