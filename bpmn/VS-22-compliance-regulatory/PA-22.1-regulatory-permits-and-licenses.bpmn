        <bpmndi:BPMNShape id="W1421_Start4_di" bpmnElement="W1421_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1421_End10_di" bpmnElement="W1421_End10"><dc:Bounds x="1470" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1421_Annotation11_di" bpmnElement="W1421_Annotation11"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1421_Flow13_di" bpmnElement="W1421_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1421_Flow14_di" bpmnElement="W1421_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1421_Flow15_di" bpmnElement="W1421_Flow15"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1421_Flow16_di" bpmnElement="W1421_Flow16"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1421_Flow17_di" bpmnElement="W1421_Flow17"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1421_Flow18_di" bpmnElement="W1421_Flow18"><di:waypoint x="1420" y="165" /><di:waypoint x="1470" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1421_Assoc12_di" bpmnElement="W1421_Assoc12"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1489" name="W1489. BIR Electronic Invoicing (E-Invoice) Compliance, System Registration &amp; Monthly Transmission" isExecutable="false">
      <bpmn:documentation>Trigger: BIR RR 8-2020 (as amended by RR 8-2022/RR 9-2022) EIS mandate for electronic invoicing under NIRC §237-A; monthly transmission reconciliation (15th of following month); system registration for new POS terminals or stores
Frequency: Monthly transmission; per-store/terminal registration as needed; annual renewal
Volume: ~200 stores × 3 POS terminals = 600 registered devices; ~2.8M transactions/month chain-wide requiring e-invoice transmission
Owner: Tax Manager
Participants: IT Systems Administrator, SSP (Store Systems &amp; POS — the in-house POS platform), Store Manager, BIR Liaison Officer
Source: workflow W1489 — BIR Electronic Invoicing (E-Invoice) Compliance, System Registration &amp; Monthly Transmission</bpmn:documentation>
      <bpmn:laneSet id="W1489_LaneSet3">
        <bpmn:lane id="W1489_Lane1" name="Tax Manager">
        <bpmn:flowNodeRef>W1489_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1489_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1489_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1489_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1489_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1489_Lane2" name="POS System">
        <bpmn:flowNodeRef>W1489_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1489_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1489_Start4" name="BIR RR 8-2020 (as amended by RR 8-2022/RR 9-2022) EIS mandate for electronic invoicing…">
        <bpmn:outgoing>W1489_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1489_Task5" name="E-invoicing system registration">
        <bpmn:documentation>Step 1: E-invoicing system registration: For new stores or new POS terminals: (a) Tax Manager submits System Registration Update (BIR Form 1907) for each new POS terminal to the BIR Revenue District Office (RDO) where the store is registered; (b) BIR issues Authority to Use (ATU) the e-invoicing system; (c) IT Systems Administrator configures POS terminal with BIR-assigned serial number, TIN, and registered address; (d) test transmission performed and BIR confirmation verified; (e) terminal goes live with e-invoicing enabled; (f) all documentation filed for BIR audit trail
Responsible (R): Tax Manager / IT Systems Administrator
Accountable (A): CFO
Duration: Per terminal setup: 2–5 days</bpmn:documentation>
        <bpmn:incoming>W1489_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1489_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1489_Task6" name="Near-real-time transaction transmission">
        <bpmn:documentation>Step 2: Near-real-time transaction transmission: Per POS transaction: (a) POS system generates electronic sales invoice in BIR-required JSON/XML format; (b) invoice data includes: TIN of seller, registered name, address, invoice number (sequential, per BIR format), date/time, item description, quantity, unit price, VAT amount, total amount, buyer TIN (if available); (c) system transmits invoice to BIR-accredited e-invoicing service provider via API; (d) service provider acknowledges receipt with transaction reference number; (e) POS stores acknowledgment for audit trail; (f) if transmission fails: invoice queued for retry (up to 3 attempts within 24 hours); (g) if still fails: stored locally and included in batch retransmission
Responsible (R): POS System / IT Systems Administrator
Accountable (A): Tax Manager
Duration: Automated per transaction</bpmn:documentation>
        <bpmn:incoming>W1489_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1489_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1489_Task7" name="Monthly transmission reconciliation">
        <bpmn:documentation>Step 3: Monthly transmission reconciliation: By 15th of following month: (a) system generates transmission report: total invoices generated vs. invoices successfully transmitted vs. failed; (b) Tax Manager reviews failure log and resolves outstanding failures; (c) failed invoices retransmitted before monthly deadline; (d) reconciliation certificate generated confirming 100% transmission; (e) summary report filed with BIR per regulatory requirement; (f) any remaining unresolvable failures (e.g., BIR system downtime) documented with incident report as audit defense
Responsible (R): Tax Manager / IT Systems Administrator
Accountable (A): CFO
Duration: 2–4 hours/month</bpmn:documentation>
        <bpmn:incoming>W1489_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1489_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1489_Task8" name="BIR audit readiness &amp; retrieval">
        <bpmn:documentation>Step 4: BIR audit readiness &amp; retrieval: On BIR audit notification: (a) Tax Manager queries e-invoice archive by date range, store, terminal, or invoice number; (b) requested invoices exported in BIR-approved format; (c) supporting POS transaction logs and Z-read reports provided as corroboration; (d) transmission logs and BIR acknowledgment receipts compiled; (e) Tax Manager reviews all retrieved records for consistency before submission to BIR examiner; (f) any discrepancies investigated and documented before audit day
Responsible (R): Tax Manager
Accountable (A): CFO
Duration: 1–2 days per audit request</bpmn:documentation>
        <bpmn:incoming>W1489_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1489_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1489_Task9" name="System update &amp; compliance monitoring">
        <bpmn:documentation>Step 5: System update &amp; compliance monitoring: Quarterly: (a) Tax Manager monitors BIR issuances for e-invoicing regulation changes; (b) IT Systems Administrator applies required system updates (new fields, format changes, API version upgrades); (c) test transmission performed after each update; (d) stores with persistent transmission issues (&gt; 1% failure rate) flagged for IT investigation; (e) compliance dashboard reviewed in monthly tax committee meeting
Responsible (R): Tax Manager / IT Systems Administrator
Accountable (A): CFO
Duration: 2–3 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1489_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1489_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1489_End10" name="Complete">
        <bpmn:incoming>W1489_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1489_Annotation11">
        <bpmn:text>Controls: - CTL-307 (ensure controlled execution — Regulatory Permits &amp; Licenses (PA-22.1).) | - operational: downtime: the BIR e-invoicing system experiences periodic downtime; operational: updates must be deployed quickly across 600 terminals
Owner: Tax Manager</bpmn:text>
      </bpmn:textAnnotation>
