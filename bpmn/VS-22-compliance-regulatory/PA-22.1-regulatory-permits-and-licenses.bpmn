    <bpmn:process id="W_W447" name="W447. DTI-BPS Mandatory Product Certification (ICC/SOC)" isExecutable="false">
      <bpmn:documentation>Trigger: Import Purchase Order (W2B) created for regulated construction materials
Frequency: Per import shipment of regulated goods (e.g., steel, cement, electrical)
Volume: ~10–15 shipments/month
Owner: Import Coordinator
Participants: Buyer, Customs Broker, DTI-BPS Officer, Third-Party Testing Lab
Source: workflow W447 — DTI-BPS Mandatory Product Certification (ICC/SOC)</bpmn:documentation>
      <bpmn:laneSet id="W447_LaneSet7">
        <bpmn:lane id="W447_Lane1" name="Import Coordinator">
        <bpmn:flowNodeRef>W447_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W447_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W447_Lane2" name="DTI-BPS">
        <bpmn:flowNodeRef>W447_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W447_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W447_Lane3" name="DTI Inspector">
        <bpmn:flowNodeRef>W447_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W447_Lane4" name="Lab Tech">
        <bpmn:flowNodeRef>W447_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W447_Lane5" name="Customs Broker">
        <bpmn:flowNodeRef>W447_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W447_Lane6" name="DC Team">
        <bpmn:flowNodeRef>W447_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W447_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W447_Start8" name="Import Purchase Order (W2B) created for regulated construction materials">
        <bpmn:outgoing>W447_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W447_Task9" name="Application">
        <bpmn:documentation>Step 1: Application: Import Coordinator files ICC/SOC application via the DTI-BPS Product Certification Information Management System (PCIMS) upon shipment departure from origin
Responsible (R): Import Coordinator
Accountable (A): Category Mgr
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W447_Flow19</bpmn:incoming>
        <bpmn:outgoing>W447_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W447_Task10" name="Documentary Review">
        <bpmn:documentation>Step 2: Documentary Review: DTI-BPS reviews Bill of Lading, Packing List, and Commercial Invoice
Responsible (R): DTI-BPS
Accountable (A): —
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W447_Flow20</bpmn:incoming>
        <bpmn:outgoing>W447_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W447_Task11" name="Inspection &amp; Sampling">
        <bpmn:documentation>Step 3: Inspection &amp; Sampling: Upon arrival at Port/DC, DTI inspector performs physical inspection and draws random samples
Responsible (R): DTI Inspector
Accountable (A): Import Coordinator
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W447_Flow21</bpmn:incoming>
        <bpmn:outgoing>W447_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W447_Task12" name="Testing">
        <bpmn:documentation>Step 4: Testing: Samples sent to DTI-accredited laboratory for testing (e.g., tensile strength for steel, compression for cement)
Responsible (R): Lab Tech
Accountable (A): —
Duration: 5–10 days</bpmn:documentation>
        <bpmn:incoming>W447_Flow22</bpmn:incoming>
        <bpmn:outgoing>W447_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W447_Task13" name="Certificate Issuance">
        <bpmn:documentation>Step 5: Certificate Issuance: If tests pass, DTI issues ICC/SOC certificate and ICC stickers for each unit/package
Responsible (R): DTI-BPS
Accountable (A): —
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W447_Flow23</bpmn:incoming>
        <bpmn:outgoing>W447_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W447_Task14" name="Release">
        <bpmn:documentation>Step 6: Release: Customs Broker uses the certificate to finalize customs clearance; goods released to DC
Responsible (R): Customs Broker
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W447_Flow24</bpmn:incoming>
        <bpmn:outgoing>W447_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W447_Task15" name="Sticker Application">
        <bpmn:documentation>Step 7: Sticker Application: DC staff apply ICC stickers to individual items before putaway or dispatch to stores
Responsible (R): DC Team
Accountable (A): DC Manager
Duration: Varies</bpmn:documentation>
        <bpmn:incoming>W447_Flow25</bpmn:incoming>
        <bpmn:outgoing>W447_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W447_End16" name="Complete">
        <bpmn:incoming>W447_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W447_Annotation17">
        <bpmn:text>Controls: - CTL-307 (ensure controlled execution — Regulatory Permits &amp; Licenses (PA-22.1).) | - operational: Import Coordinator review and approval gate
Owner: Import Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W447_Assoc18" sourceRef="W447_Annotation17" targetRef="W447_Start8" associationDirection="None" />
      <bpmn:sequenceFlow id="W447_Flow19" sourceRef="W447_Start8" targetRef="W447_Task9" />
      <bpmn:sequenceFlow id="W447_Flow20" sourceRef="W447_Task9" targetRef="W447_Task10" />
      <bpmn:sequenceFlow id="W447_Flow21" sourceRef="W447_Task10" targetRef="W447_Task11" />
