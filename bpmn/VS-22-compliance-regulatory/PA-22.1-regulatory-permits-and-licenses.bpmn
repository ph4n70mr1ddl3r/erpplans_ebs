        <bpmndi:BPMNShape id="W685_Lane4_di" bpmnElement="W685_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="2420" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W685_Task7_di" bpmnElement="W685_Task7"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
