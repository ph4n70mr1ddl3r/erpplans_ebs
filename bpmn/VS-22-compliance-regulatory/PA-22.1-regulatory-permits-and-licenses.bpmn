      <bpmn:sequenceFlow id="W1244_Flow22" sourceRef="W1244_Task11" targetRef="W1244_Task12" />
      <bpmn:sequenceFlow id="W1244_Flow23" sourceRef="W1244_Task12" targetRef="W1244_Task13" />
      <bpmn:sequenceFlow id="W1244_Flow24" sourceRef="W1244_Task13" targetRef="W1244_End14" />
    </bpmn:process>
