        <bpmn:flowNodeRef>W685_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W685_Start6" name="Annual BIA refresh cycle; post-incident plan update; organizational change (new store…">
        <bpmn:outgoing>W685_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W685_Task7" name="Compliance Manager initiates annual BIA (Business Impact Analysis) refresh…">
        <bpmn:documentation>Step 1: Compliance Manager initiates annual BIA (Business Impact Analysis) refresh: distributes BIA questionnaire to all Department Heads covering: critical business processes, maximum tolerable downtime (MTD), recovery time objectives (RTO), recovery point objectives (RPO), key dependencies (systems, suppliers, people, facilities), and financial impact of outage per hour
Responsible (R): Compliance Manager
Accountable (A): Department Heads
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W685_Flow20</bpmn:incoming>
        <bpmn:outgoing>W685_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W685_Task8" name="Department Heads complete BIA questionnaire with input from direct reports…">
        <bpmn:documentation>Step 2: Department Heads complete BIA questionnaire with input from direct reports; Compliance Manager consolidates responses
Responsible (R): Department Heads
Accountable (A): Compliance Manager
Duration: 2-3 hours each</bpmn:documentation>
        <bpmn:incoming>W685_Flow21</bpmn:incoming>
        <bpmn:outgoing>W685_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W685_Task9" name="Compliance Manager and External BC Consultant analyze BIA results: identify…">
        <bpmn:documentation>Step 3: Compliance Manager and External BC Consultant analyze BIA results: identify changes from prior year (new stores, new systems like ecommerce platform, new critical dependencies), validate MTD/RTO/RPO targets against current recovery capabilities (W55 IT DR, W580 manual operations), and update critical process prioritization
Responsible (R): Compliance Manager
Accountable (A): External BC Consultant
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W685_Flow22</bpmn:incoming>
        <bpmn:outgoing>W685_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W685_Task10" name="Compliance Manager updates BC plan documents: contact tree (all Department…">
        <bpmn:documentation>Step 4: Compliance Manager updates BC plan documents: contact tree (all Department Heads, Regional Managers, DC Managers — refreshed for organizational changes), critical system recovery sequence (updated for new ERP modules per W616), alternate site operations (updated for new store locations), communication protocols (updated for new communication tools), and vendor emergency contacts
Responsible (R): Compliance Manager
Accountable (A): —
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W685_Flow23</bpmn:incoming>
        <bpmn:outgoing>W685_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W685_Task11" name="CIO updates IT disaster recovery plan per W55 based on BIA refresh: confirms…">
        <bpmn:documentation>Step 5: CIO updates IT disaster recovery plan per W55 based on BIA refresh: confirms RTO/RPO capabilities, tests failover procedures, updates runbooks for new systems
Responsible (R): CIO
Accountable (A): Compliance Manager
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W685_Flow24</bpmn:incoming>
        <bpmn:outgoing>W685_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W685_Task12" name="VP Store Operations updates store-level BC procedures: typhoon protocol per…">
        <bpmn:documentation>Step 6: VP Store Operations updates store-level BC procedures: typhoon protocol per W576, manual operations per W580, power failure per W470, and communication chain for 200 stores
Responsible (R): VP Store Operations
Accountable (A): Compliance Manager
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W685_Flow25</bpmn:incoming>
        <bpmn:outgoing>W685_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W685_Task13" name="Compliance Manager presents updated BIA and BC plan to Executive Committee…">
        <bpmn:documentation>Step 7: Compliance Manager presents updated BIA and BC plan to Executive Committee (CEO, CFO, COO, CIO) for approval; Executive Committee confirms resource allocation for BC program
Responsible (R): Compliance Manager
Accountable (A): CEO, CFO, COO, CIO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W685_Flow26</bpmn:incoming>
        <bpmn:outgoing>W685_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W685_Task14" name="Semi-annual: Compliance Officer coordinates BC drill per W158; drill results…">
        <bpmn:documentation>Step 8: Semi-annual: Compliance Officer coordinates BC drill per W158; drill results feed back into plan improvements
Responsible (R): Compliance Manager
Accountable (A): VP Store Operations, CIO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W685_Flow27</bpmn:incoming>
        <bpmn:outgoing>W685_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W685_Task15" name="Post-incident (any significant disruption): Compliance Manager conducts…">
        <bpmn:documentation>Step 9: Post-incident (any significant disruption): Compliance Manager conducts post-incident review; documents actual vs. planned response performance; updates BC plan with lessons learned
Responsible (R): Compliance Manager
Accountable (A): —
Duration: 2-3 days</bpmn:documentation>
        <bpmn:incoming>W685_Flow28</bpmn:incoming>
        <bpmn:outgoing>W685_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W685_Task16" name="Quarterly: Compliance Manager reviews BC plan for accuracy (contact…">
        <bpmn:documentation>Step 10: Quarterly: Compliance Manager reviews BC plan for accuracy (contact information, system inventory, vendor contacts) and distributes updated plan to all BC role holders
Responsible (R): Compliance Manager
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W685_Flow29</bpmn:incoming>
        <bpmn:outgoing>W685_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W685_End17" name="Complete">
        <bpmn:incoming>W685_Flow30</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W685_Annotation18">
        <bpmn:text>Controls: - CTL-307 (ensure controlled execution — Regulatory Permits &amp; Licenses (PA-22.1).) | - operational: Compliance Manager (BC Program Owner) review and approval gate
Owner: Compliance Manager (BC Program Owner)</bpmn:text>
      </bpmn:textAnnotation>
