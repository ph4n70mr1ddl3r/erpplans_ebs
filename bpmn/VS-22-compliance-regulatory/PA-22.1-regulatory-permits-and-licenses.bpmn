        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W207_Start7" name="Scheduled audit or suspected internal/external theft incident">
        <bpmn:outgoing>W207_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W207_Task8" name="Exception Identification">
        <bpmn:documentation>Step 1: Exception Identification: System identifies high-risk POS transactions (e.g., voids, high-value returns, employee discounts) via automated exception reports (W37)
Responsible (R): System
Accountable (A): LP Analyst
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W207_Flow17</bpmn:incoming>
        <bpmn:outgoing>W207_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W207_Task9" name="CCTV Reconciliation">
        <bpmn:documentation>Step 2: CCTV Reconciliation: LP Analyst retrieves CCTV footage synced with POS transaction timestamps; verifies physical action matches system record
Responsible (R): LP Analyst
Accountable (A): LP Manager
Duration: 30 min/event</bpmn:documentation>
        <bpmn:incoming>W207_Flow18</bpmn:incoming>
        <bpmn:outgoing>W207_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W207_Task10" name="Discrepancy Logging">
        <bpmn:documentation>Step 3: Discrepancy Logging: If &quot;phantom return&quot; or unrecorded sale discovered, log as a &quot;Confirmed Incident&quot; in LP module
Responsible (R): LP Analyst
Accountable (A): LP Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W207_Flow19</bpmn:incoming>
        <bpmn:outgoing>W207_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W207_Task11" name="Investigation">
        <bpmn:documentation>Step 4: Investigation: Confront staff or review external footage for identification; coordinate with HR for disciplinary action (W79)
Responsible (R): LP Manager
Accountable (A): CHRO
Duration: 2-4 hours</bpmn:documentation>
        <bpmn:incoming>W207_Flow20</bpmn:incoming>
        <bpmn:outgoing>W207_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W207_Task12" name="System Update">
        <bpmn:documentation>Step 5: System Update: Write off confirmed theft inventory (W37.6); update shrinkage metrics in P&amp;L (W102)
Responsible (R): Finance
Accountable (A): LP Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W207_Flow21</bpmn:incoming>
        <bpmn:outgoing>W207_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W207_Task13" name="Security Hardening">
        <bpmn:documentation>Step 6: Security Hardening: Adjust camera angles or POS procedures based on audit findings
Responsible (R): IT / Store Manager
Accountable (A): LP Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W207_Flow22</bpmn:incoming>
        <bpmn:outgoing>W207_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W207_End14" name="Complete">
        <bpmn:incoming>W207_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W207_Annotation15">
        <bpmn:text>Controls: - CTL-307 (ensure controlled execution — Regulatory Permits &amp; Licenses (PA-22.1).) | - operational: Loss Prevention (LP) Manager review and approval gate; operational: periodic reconciliation against source documents
Owner: Loss Prevention (LP) Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W207_Assoc16" sourceRef="W207_Annotation15" targetRef="W207_Start7" associationDirection="None" />
