    <bpmn:process id="W_W427" name="W427. DTI Sales Promotion Permit Monitoring &amp; In-Store Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: Launch of a DTI-permitted sales promotion (per W2747)
Frequency: Weekly during the promo period
Volume: ~20–30 major promos per year across 200 stores
Owner: Regulatory Officer
Participants: Store Manager, Marketing Audit Team, Loss Prevention, Pricing Analyst
Source: workflow W427 — DTI Sales Promotion Permit Monitoring &amp; In-Store Compliance</bpmn:documentation>
      <bpmn:laneSet id="W427_LaneSet5">
        <bpmn:lane id="W427_Lane1" name="Regulatory Officer">
        <bpmn:flowNodeRef>W427_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W427_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W427_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W427_Lane2" name="Marketing Audit">
        <bpmn:flowNodeRef>W427_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W427_Lane3" name="Pricing Analyst">
        <bpmn:flowNodeRef>W427_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W427_Lane4" name="Store Manager">
        <bpmn:flowNodeRef>W427_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W427_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W427_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W427_Start6" name="Launch of a DTI-permitted sales promotion (per W2747)">
        <bpmn:outgoing>W427_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W427_Task7" name="Compliance Checklist">
        <bpmn:documentation>Step 1: Compliance Checklist: Regulatory Officer generates a &quot;DTI Compliance Checklist&quot; for each active promo: (a) DTI Permit Number, (b) Approved Mechanics, (c) Start/End Dates, (d) Covered SKUs and Discount Levels
Responsible (R): Regulatory Officer
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W427_Flow16</bpmn:incoming>
        <bpmn:outgoing>W427_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W427_Task8" name="Digital Ad Verification">
        <bpmn:documentation>Step 2: Digital Ad Verification: Marketing Audit Team reviews current social media ads and website banners; verifies DTI Permit Number is visible and mechanics match the approved filing
Responsible (R): Marketing Audit
Accountable (A): CMO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W427_Flow17</bpmn:incoming>
        <bpmn:outgoing>W427_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W427_Task9" name="POS Price Audit">
        <bpmn:documentation>Step 3: POS Price Audit: Pricing Analyst runs a system query to compare &quot;Live POS Price&quot; vs. &quot;DTI-Approved Promo Price&quot; for a sample of 20 SKUs; flags any discrepancies
Responsible (R): Pricing Analyst
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W427_Flow18</bpmn:incoming>
        <bpmn:outgoing>W427_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W427_Task10" name="Store Spot Check">
        <bpmn:documentation>Step 4: Store Spot Check: Store Manager (or LPO during store visit) conducts a physical walk-through: (a) verify DTI Permit Number is displayed on all shelf talkers; (b) verify no &quot;Expired&quot; promo signage remains on the floor; (c) verify &quot;Terms &amp; Conditions&quot; are available at the CS desk
Responsible (R): Store Manager / LPO
Accountable (A): Regional Mgr
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W427_Flow19</bpmn:incoming>
        <bpmn:outgoing>W427_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W427_Task11" name="Exception Correction">
        <bpmn:documentation>Step 5: Exception Correction: Any discrepancy (e.g., missing permit number, wrong price) must be corrected within 2 hours; Store Manager logs the correction in the Compliance Portal
Responsible (R): Store Manager
Accountable (A): —
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W427_Flow20</bpmn:incoming>
        <bpmn:outgoing>W427_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W427_Task12" name="Audit Trail Archive">
        <bpmn:documentation>Step 6: Audit Trail Archive: All weekly compliance checks and corrections are archived for use during DTI spot audits or annual compliance reviews
Responsible (R): Regulatory Officer
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W427_Flow21</bpmn:incoming>
        <bpmn:outgoing>W427_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W427_End13" name="Complete">
        <bpmn:incoming>W427_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W427_Annotation14">
        <bpmn:text>Controls: - CTL-307 (ensure controlled execution — Regulatory Permits &amp; Licenses (PA-22.1).) | - operational: Regulatory Officer review and approval gate
Owner: Regulatory Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W427_Assoc15" sourceRef="W427_Annotation14" targetRef="W427_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W427_Flow16" sourceRef="W427_Start6" targetRef="W427_Task7" />
      <bpmn:sequenceFlow id="W427_Flow17" sourceRef="W427_Task7" targetRef="W427_Task8" />
      <bpmn:sequenceFlow id="W427_Flow18" sourceRef="W427_Task8" targetRef="W427_Task9" />
