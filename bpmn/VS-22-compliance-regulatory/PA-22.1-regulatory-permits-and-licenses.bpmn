        <bpmn:flowNodeRef>W627_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W627_Start6" name="Recall execution completed (per W29); 30-day post-recall milestone">
        <bpmn:outgoing>W627_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W627_Task7" name="At T+7 days after recall initiation (per W29): Category Manager verifies POS…">
        <bpmn:documentation>Step 1: At T+7 days after recall initiation (per W29): Category Manager verifies POS block compliance — confirms affected SKU is blocked at all 600 POS terminals and cannot be sold; spot-checks 10 random stores via phone or Regional Manager visit
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W627_Flow18</bpmn:incoming>
        <bpmn:outgoing>W627_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W627_Task8" name="At T+14 days: VP Supply Chain verifies physical stock quarantine — confirms all…">
        <bpmn:documentation>Step 2: At T+14 days: VP Supply Chain verifies physical stock quarantine — confirms all DC stock is quarantined, all in-transit stock is intercepted, and store-level stock is pulled from shelves; collects store-level confirmation reports
Responsible (R): VP Supply Chain
Accountable (A): —
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W627_Flow19</bpmn:incoming>
        <bpmn:outgoing>W627_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W627_Task9" name="At T+21 days: Category Manager verifies customer notification reach — system…">
        <bpmn:documentation>Step 3: At T+21 days: Category Manager verifies customer notification reach — system reports: (a) loyalty members who purchased affected product notified (target ≥ 95%), (b) B2B customers notified, (c) ecommerce customers notified, (d) general public notification published; calculates notification effectiveness rate
Responsible (R): Category Manager
Accountable (A): —
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W627_Flow20</bpmn:incoming>
        <bpmn:outgoing>W627_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W627_Task10" name="At T+30 days: VP Merchandising conducts effectiveness verification — (a)…">
        <bpmn:documentation>Step 4: At T+30 days: VP Merchandising conducts effectiveness verification — (a) calculates % of affected stock accounted for (quarantined + returned + documented disposal), (b) calculates % of affected customers notified, (c) confirms zero additional sales of recalled product, (d) confirms DTI/FDA notification acknowledged
Responsible (R): VP Merchandising
Accountable (A): COO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W627_Flow21</bpmn:incoming>
        <bpmn:outgoing>W627_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W627_Task11" name="If effectiveness targets not met (&gt; 95% stock accounted for, &gt; 90% customer…">
        <bpmn:documentation>Step 5: If effectiveness targets not met (&gt; 95% stock accounted for, &gt; 90% customer notification): VP Merchandising extends recall period with targeted actions for remaining gaps (additional store visits, extended customer outreach, media re-notification)
Responsible (R): VP Merchandising
Accountable (A): COO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W627_Flow22</bpmn:incoming>
        <bpmn:outgoing>W627_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W627_Task12" name="Post-recall review meeting (within 2 weeks of effectiveness verification): all…">
        <bpmn:documentation>Step 6: Post-recall review meeting (within 2 weeks of effectiveness verification): all stakeholders review recall execution timeline, bottlenecks encountered, communication effectiveness, and system performance; documents lessons learned
Responsible (R): VP Merchandising
Accountable (A): COO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W627_Flow23</bpmn:incoming>
        <bpmn:outgoing>W627_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W627_Task13" name="QA Manager conducts root cause analysis with vendor — determines recall cause…">
        <bpmn:documentation>Step 7: QA Manager conducts root cause analysis with vendor — determines recall cause (manufacturing defect, specification change, contamination, labeling error); develops corrective action with vendor per CAPA process (per W110); updates incoming quality inspection protocol (per W625) if needed
Responsible (R): QA Manager
Accountable (A): Buyer
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W627_Flow24</bpmn:incoming>
        <bpmn:outgoing>W627_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W627_Task14" name="VP Merchandising updates recall playbook (W29) with lessons learned; updates…">
        <bpmn:documentation>Step 8: VP Merchandising updates recall playbook (W29) with lessons learned; updates mock recall exercise scenarios (per W622) to test improved processes; files regulatory close-out documentation with DTI/FDA as required
Responsible (R): VP Merchandising
Accountable (A): Legal Counsel
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W627_Flow25</bpmn:incoming>
        <bpmn:outgoing>W627_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W627_End15" name="Complete">
        <bpmn:incoming>W627_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W627_Annotation16">
        <bpmn:text>Controls: - CTL-307 (ensure controlled execution — Regulatory Permits &amp; Licenses (PA-22.1).) | - operational: broad public notification and in-store signage; operational: contractual recall cooperation clause and vendor chargeback for recall costs; operational: transparent communication, swift action, and customer-first messaging
Owner: VP Merchandising</bpmn:text>
      </bpmn:textAnnotation>
