        <bpmndi:BPMNShape id="W685_Lane1_di" bpmnElement="W685_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2420" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W685_Lane2_di" bpmnElement="W685_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="2420" height="170" /></bpmndi:BPMNShape>
