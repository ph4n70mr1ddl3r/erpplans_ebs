    <bpmn:process id="W_W448" name="W448. LGU Sanitary &amp; Health Permit Management" isExecutable="false">
      <bpmn:documentation>Trigger: Annual LGU Business Permit renewal cycle (January) or new hire onboarding
Frequency: Annual for all staff; per-hire for new employees
Volume: ~6,762 employees across 200 stores
Owner: Store Manager
Participants: HR Assistant, Store Staff, LGU Health Office, Accredited Clinic
Source: workflow W448 — LGU Sanitary &amp; Health Permit Management</bpmn:documentation>
      <bpmn:laneSet id="W448_LaneSet5">
        <bpmn:lane id="W448_Lane1" name="Employee">
        <bpmn:flowNodeRef>W448_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W448_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W448_Lane2" name="HR Assistant">
        <bpmn:flowNodeRef>W448_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W448_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W448_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W448_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W448_Lane4" name="LGU Inspector">
        <bpmn:flowNodeRef>W448_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W448_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W448_Start6" name="Annual LGU Business Permit renewal cycle (January) or new hire onboarding">
        <bpmn:outgoing>W448_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W448_Task7" name="Medical Screening">
        <bpmn:documentation>Step 1: Medical Screening: Store staff undergo annual medical exam (X-ray, stool/drug test) at accredited clinic
Responsible (R): Employee
Accountable (A): HR Assistant
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W448_Flow15</bpmn:incoming>
        <bpmn:outgoing>W448_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W448_Task8" name="Application">
        <bpmn:documentation>Step 2: Application: HR Assistant compiles medical results and submits application to LGU Health Office
Responsible (R): HR Assistant
Accountable (A): Store Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W448_Flow16</bpmn:incoming>
        <bpmn:outgoing>W448_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W448_Task9" name="Payment &amp; Issuance">
        <bpmn:documentation>Step 3: Payment &amp; Issuance: Pay LGU fees; Health Office issues individual Health Cards and the Store Sanitary Permit
Responsible (R): HR Assistant
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W448_Flow17</bpmn:incoming>
        <bpmn:outgoing>W448_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W448_Task10" name="Compliance Display">
        <bpmn:documentation>Step 4: Compliance Display: Store Manager displays Sanitary Permit in the customer area; Health Cards kept in store files for inspection
Responsible (R): Store Manager
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W448_Flow18</bpmn:incoming>
        <bpmn:outgoing>W448_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W448_Task11" name="Inspection">
        <bpmn:documentation>Step 5: Inspection: LGU Health Inspector conducts unannounced visit to check facility sanitation and staff health cards
Responsible (R): LGU Inspector
Accountable (A): Store Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W448_Flow19</bpmn:incoming>
        <bpmn:outgoing>W448_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W448_End12" name="Complete">
        <bpmn:incoming>W448_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W448_Annotation13">
        <bpmn:text>Controls: - CTL-307 (ensure controlled execution — Regulatory Permits &amp; Licenses (PA-22.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
