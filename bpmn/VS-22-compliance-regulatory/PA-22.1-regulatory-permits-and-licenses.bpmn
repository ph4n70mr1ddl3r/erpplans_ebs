        <bpmndi:BPMNEdge id="W79_Flow24_di" bpmnElement="W79_Flow24"><di:waypoint x="1630" y="335" /><di:waypoint x="1660" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W79_Flow25_di" bpmnElement="W79_Flow25"><di:waypoint x="1840" y="505" /><di:waypoint x="1870" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W79_Flow26_di" bpmnElement="W79_Flow26"><di:waypoint x="2050" y="335" /><di:waypoint x="2080" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W79_Flow27_di" bpmnElement="W79_Flow27"><di:waypoint x="2260" y="335" /><di:waypoint x="2310" y="505" /></bpmndi:BPMNEdge>
