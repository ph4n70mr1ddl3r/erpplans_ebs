        <bpmndi:BPMNEdge id="W79_Flow21_di" bpmnElement="W79_Flow21"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W79_Flow22_di" bpmnElement="W79_Flow22"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="505" /></bpmndi:BPMNEdge>
