        <bpmndi:BPMNShape id="W78_Task12_di" bpmnElement="W78_Task12"><dc:Bounds x="1660" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W78_Task13_di" bpmnElement="W78_Task13"><dc:Bounds x="1870" y="465" width="180" height="80" /></bpmndi:BPMNShape>
