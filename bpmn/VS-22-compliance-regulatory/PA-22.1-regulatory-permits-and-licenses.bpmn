      <bpmn:sequenceFlow id="W37_Flow26" sourceRef="W37_Task12" targetRef="W37_Task13" />
      <bpmn:sequenceFlow id="W37_Flow27" sourceRef="W37_Task13" targetRef="W37_Task14" />
      <bpmn:sequenceFlow id="W37_Flow28" sourceRef="W37_Task14" targetRef="W37_Task15" />
      <bpmn:sequenceFlow id="W37_Flow29" sourceRef="W37_Task15" targetRef="W37_Task16" />
      <bpmn:sequenceFlow id="W37_Flow30" sourceRef="W37_Task16" targetRef="W37_End17" />
    </bpmn:process>
