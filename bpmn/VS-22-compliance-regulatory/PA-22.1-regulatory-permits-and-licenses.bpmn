    <bpmn:process id="W_W433" name="W433. DENR Self-Monitoring (SMR) &amp; Compliance (CMR) Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly (SMR) or Semi-Annual (CMR) reporting calendar
Frequency: Semi-Annual (SMR per semester); CMR prepared by DENR-EMB as its compliance-monitoring output (monitored, not company-filed)
Volume: 200 Stores + 4 DCs
Owner: Regulatory Officer
Participants: Store Managers, DC Managers, Pollution Control Officer (PCO), DENR-EMB
Source: workflow W433 — DENR Self-Monitoring (SMR) &amp; Compliance (CMR) Reporting</bpmn:documentation>
      <bpmn:laneSet id="W433_LaneSet5">
        <bpmn:lane id="W433_Lane1" name="Store">
        <bpmn:flowNodeRef>W433_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W433_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W433_Lane2" name="Pollution Control Officer">
        <bpmn:flowNodeRef>W433_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W433_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W433_Lane3" name="Regulatory Officer">
        <bpmn:flowNodeRef>W433_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W433_Lane4" name="System">
        <bpmn:flowNodeRef>W433_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W433_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W433_Start6" name="Quarterly (SMR) or Semi-Annual (CMR) reporting calendar">
        <bpmn:outgoing>W433_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W433_Task7" name="Data Collection">
        <bpmn:documentation>Step 1: Data Collection: Collect quarterly data per location: hazardous waste volume (W82), water consumption, air emissions (if using large generators), and CSR activities
Responsible (R): Store/DC Manager
Accountable (A): PCO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W433_Flow15</bpmn:incoming>
        <bpmn:outgoing>W433_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W433_Task8" name="Report Preparation">
        <bpmn:documentation>Step 2: Report Preparation: PCO consolidates data into the SMR/CMR templates; verifies against ECC conditions and hazardous waste manifests
Responsible (R): Pollution Control Officer
Accountable (A): Regulatory Officer
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W433_Flow16</bpmn:incoming>
        <bpmn:outgoing>W433_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W433_Task9" name="Review &amp; Approval">
        <bpmn:documentation>Step 3: Review &amp; Approval: Regulatory Officer reviews the consolidated report for accuracy and legal compliance
Responsible (R): Regulatory Officer
Accountable (A): VP Legal
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W433_Flow17</bpmn:incoming>
        <bpmn:outgoing>W433_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W433_Task10" name="Online Filing">
        <bpmn:documentation>Step 4: Online Filing: PCO uploads the reports via the DENR-EMB Online Systems (SMR Online / IIS)
Responsible (R): Pollution Control Officer
Accountable (A): —
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W433_Flow18</bpmn:incoming>
        <bpmn:outgoing>W433_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W433_Task11" name="Proof of Submission">
        <bpmn:documentation>Step 5: Proof of Submission: System archives the &quot;Filing Confirmation&quot; and &quot;Reference Number&quot; for audit purposes
Responsible (R): System
Accountable (A): Regulatory Officer
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W433_Flow19</bpmn:incoming>
        <bpmn:outgoing>W433_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W433_End12" name="Complete">
        <bpmn:incoming>W433_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W433_Annotation13">
        <bpmn:text>Controls: - CTL-307 (ensure controlled execution — Regulatory Permits &amp; Licenses (PA-22.1).) | - operational: Regulatory Officer review and approval gate
Owner: Regulatory Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W433_Assoc14" sourceRef="W433_Annotation13" targetRef="W433_Start6" associationDirection="None" />
