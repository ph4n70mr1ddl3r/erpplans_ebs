    <bpmn:process id="W_W467" name="W467. Specialized Hardware Permits (DENR, FPA)" isExecutable="false">
      <bpmn:documentation>Trigger: Initial store setup or annual permit expiry
Frequency: Annual
Volume: All stores selling Lumber (DENR) or Fertilizer (FPA)
Owner: Store Manager
Participants: Category Manager (Merch), Legal, DENR, FPA
Source: workflow W467 — Specialized Hardware Permits (DENR, FPA)</bpmn:documentation>
      <bpmn:laneSet id="W467_LaneSet3">
        <bpmn:lane id="W467_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W467_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W467_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W467_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W467_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W467_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W467_Lane2" name="Inspector">
        <bpmn:flowNodeRef>W467_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W467_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W467_Start4" name="Initial store setup or annual permit expiry">
        <bpmn:outgoing>W467_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W467_Task5" name="Application">
        <bpmn:documentation>Step 1: Application: Store Manager compiles proof of legitimate wood sourcing (for DENR) or accredited handler training (for FPA)
Responsible (R): Store Manager
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W467_Flow13</bpmn:incoming>
        <bpmn:outgoing>W467_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W467_Task6" name="Submission">
        <bpmn:documentation>Step 2: Submission: File application with the regional DENR or FPA office
Responsible (R): Store Manager
Accountable (A): Legal
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W467_Flow14</bpmn:incoming>
        <bpmn:outgoing>W467_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W467_Task7" name="Inspection">
        <bpmn:documentation>Step 3: Inspection: Regional officers inspect the store storage area for compliant ventilation, signage, and safety
Responsible (R): Inspector
Accountable (A): Store Manager
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W467_Flow15</bpmn:incoming>
        <bpmn:outgoing>W467_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W467_Task8" name="Issuance">
        <bpmn:documentation>Step 4: Issuance: Pay fees; Receive permit/license
Responsible (R): Store Manager
Accountable (A): —
Duration: 1-2 weeks</bpmn:documentation>
        <bpmn:incoming>W467_Flow16</bpmn:incoming>
        <bpmn:outgoing>W467_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W467_Task9" name="Display">
        <bpmn:documentation>Step 5: Display: Post permit in a conspicuous location near the lumber yard or garden center
Responsible (R): Store Manager
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W467_Flow17</bpmn:incoming>
        <bpmn:outgoing>W467_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W467_End10" name="Complete">
        <bpmn:incoming>W467_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W467_Annotation11">
        <bpmn:text>Controls: - CTL-307 (ensure controlled execution — Regulatory Permits &amp; Licenses (PA-22.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
