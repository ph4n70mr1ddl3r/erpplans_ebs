      <bpmn:sequenceFlow id="W78_Flow27" sourceRef="W78_Task14" targetRef="W78_End15" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W78_diag">
      <bpmndi:BPMNPlane id="W78_plane" bpmnElement="W_W78">
        <bpmndi:BPMNShape id="W78_Lane1_di" bpmnElement="W78_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2210" height="170" /></bpmndi:BPMNShape>
