      <bpmn:sequenceFlow id="W480_Flow22" sourceRef="W480_Task10" targetRef="W480_Task11" />
      <bpmn:sequenceFlow id="W480_Flow23" sourceRef="W480_Task11" targetRef="W480_Task12" />
      <bpmn:sequenceFlow id="W480_Flow24" sourceRef="W480_Task12" targetRef="W480_Task13" />
      <bpmn:sequenceFlow id="W480_Flow25" sourceRef="W480_Task13" targetRef="W480_Task14" />
      <bpmn:sequenceFlow id="W480_Flow26" sourceRef="W480_Task14" targetRef="W480_Task15" />
      <bpmn:sequenceFlow id="W480_Flow27" sourceRef="W480_Task15" targetRef="W480_Task16" />
      <bpmn:sequenceFlow id="W480_Flow28" sourceRef="W480_Task16" targetRef="W480_End17" />
    </bpmn:process>
