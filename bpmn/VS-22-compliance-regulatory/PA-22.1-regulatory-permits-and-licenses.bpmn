<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-22.1-regulatory-permits-and-licenses" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W37" name="W37. Loss Prevention &amp; Exception Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Daily exception report generation; or real-time alert triggered by POS exception
Frequency: Daily review; real-time alerts for high-severity exceptions
Volume: ~500–1,000 exception events/day chain-wide across all 200 stores
Owner: Loss Prevention Officer (LPO)
Participants: LPO, Store Manager, Regional Manager, Internal Audit, Cashier, Department Supervisor
Source: workflow W37 — Loss Prevention &amp; Exception Reporting</bpmn:documentation>
      <bpmn:laneSet id="W37_LaneSet5">
        <bpmn:lane id="W37_Lane1" name="System">
        <bpmn:flowNodeRef>W37_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W37_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W37_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W37_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W37_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W37_Lane2" name="LPO">
        <bpmn:flowNodeRef>W37_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W37_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W37_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W37_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W37_Lane3" name="LPO + Regional Manager">
        <bpmn:flowNodeRef>W37_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W37_Lane4" name="Internal Audit">
        <bpmn:flowNodeRef>W37_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W37_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W37_Start6" name="Daily exception report generation; or real-time alert triggered by POS exception">
        <bpmn:outgoing>W37_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W37_Task7" name="System automatically monitors POS transactions in real-time and generates…">
        <bpmn:documentation>Step 1: System automatically monitors POS transactions in real-time and generates exception alerts for: (a) excessive voids/cancels per cashier, (b) high-value refunds without manager override, (c) manual price overrides, (d) sweet-hearting (repeated transactions with loyalty card of same employee or family), (e) excessive no-sale drawer opens, (f) post-void patterns, (g) high ratio of discount transactions
Responsible (R): System
Accountable (A): —
Duration: Real-time</bpmn:documentation>
        <bpmn:incoming>W37_Flow20</bpmn:incoming>
        <bpmn:outgoing>W37_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W37_Task8" name="System generates daily exception summary report per store: top exception…">
        <bpmn:documentation>Step 2: System generates daily exception summary report per store: top exception categories, top cashiers by exception count, transaction drill-down capability
Responsible (R): System
Accountable (A): —
Duration: Automated (daily)</bpmn:documentation>
        <bpmn:incoming>W37_Flow21</bpmn:incoming>
        <bpmn:outgoing>W37_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W37_Task9" name="LPO reviews daily exception report; prioritizes investigation of high-risk…">
        <bpmn:documentation>Step 3: LPO reviews daily exception report; prioritizes investigation of high-risk patterns (e.g., one cashier with 5× average void rate)
Responsible (R): LPO
Accountable (A): Internal Audit
Duration: 1–2 hours/day</bpmn:documentation>
        <bpmn:incoming>W37_Flow22</bpmn:incoming>
        <bpmn:outgoing>W37_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W37_Task10" name="For flagged exceptions: LPO pulls transaction details, CCTV timestamps…">
        <bpmn:documentation>Step 4: For flagged exceptions: LPO pulls transaction details, CCTV timestamps (cross-reference with security footage), and employee history
Responsible (R): LPO
Accountable (A): Internal Audit
Duration: 30 min/case</bpmn:documentation>
        <bpmn:incoming>W37_Flow23</bpmn:incoming>
        <bpmn:outgoing>W37_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W37_Task11" name="If investigation confirms irregularity: LPO documents findings; escalates to…">
        <bpmn:documentation>Step 5: If investigation confirms irregularity: LPO documents findings; escalates to Regional Manager and Internal Audit for disciplinary action
Responsible (R): LPO
Accountable (A): Internal Audit
Duration: 1 hour/case</bpmn:documentation>
        <bpmn:incoming>W37_Flow24</bpmn:incoming>
        <bpmn:outgoing>W37_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W37_Task12" name="For receiving dock exceptions: system monitors GR short shipments, frequent…">
        <bpmn:documentation>Step 6: For receiving dock exceptions: system monitors GR short shipments, frequent damage claims from same vendor, and receiving patterns outside scheduled appointments
Responsible (R): System
Accountable (A): DC Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W37_Flow25</bpmn:incoming>
        <bpmn:outgoing>W37_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W37_Task13" name="Monthly: LPO generates shrinkage report per store (inventory adjustment value ÷…">
        <bpmn:documentation>Step 7: Monthly: LPO generates shrinkage report per store (inventory adjustment value ÷ sales); flags stores exceeding 1.5% threshold
Responsible (R): LPO
Accountable (A): Internal Audit
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W37_Flow26</bpmn:incoming>
        <bpmn:outgoing>W37_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W37_Task14" name="Monthly: LPO and Regional Manager review top shrinkage stores; develop action…">
        <bpmn:documentation>Step 8: Monthly: LPO and Regional Manager review top shrinkage stores; develop action plans (additional training, CCTV repositioning, staffing adjustments)
Responsible (R): LPO + Regional Manager
Accountable (A): Internal Audit
Duration: 1 hour/month per high-shrinkage store</bpmn:documentation>
        <bpmn:incoming>W37_Flow27</bpmn:incoming>
        <bpmn:outgoing>W37_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W37_Task15" name="Quarterly: Internal Audit includes POS exception trends in audit findings…">
        <bpmn:documentation>Step 9: Quarterly: Internal Audit includes POS exception trends in audit findings; recommends system configuration changes (e.g., tighten void approval rules)
Responsible (R): Internal Audit
Accountable (A): CFO
Duration: Quarterly report</bpmn:documentation>
        <bpmn:incoming>W37_Flow28</bpmn:incoming>
        <bpmn:outgoing>W37_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W37_Task16" name="System tracks all investigation cases: status (open/investigating/closed)…">
        <bpmn:documentation>Step 10: System tracks all investigation cases: status (open/investigating/closed), resolution, recovery amount, disciplinary action taken
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W37_Flow29</bpmn:incoming>
        <bpmn:outgoing>W37_Flow30</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W37_End17" name="Complete">
        <bpmn:incoming>W37_Flow30</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W37_Annotation18">
        <bpmn:text>Controls: - CTL-23 (detect POS fraud / theft.); CTL-24 (detect receiving fraud.); CTL-46 (ensure loyalty fraud investigation and resolution.); CTL-49 (prevent unauthorized gift card balance manipulation.) | - operational: Loss Prevention Officer (LPO) review and approval gate
Owner: Loss Prevention Officer (LPO)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W37_Assoc19" sourceRef="W37_Annotation18" targetRef="W37_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W37_Flow20" sourceRef="W37_Start6" targetRef="W37_Task7" />
