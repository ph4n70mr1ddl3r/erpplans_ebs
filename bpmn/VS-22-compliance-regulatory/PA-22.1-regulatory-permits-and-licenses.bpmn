    <bpmn:process id="W_W627" name="W627. Product Recall Effectiveness Verification &amp; Post-Recall Review" isExecutable="false">
      <bpmn:documentation>Trigger: Recall execution completed (per W29); 30-day post-recall milestone
Frequency: Per recall event; estimated ~2–4 recalls/year
Volume: 1 effectiveness check per recall event
Owner: VP Merchandising
Participants: VP Merchandising, VP Supply Chain, LP Manager, QA Manager, Category Manager, VP Store Operations, Legal Counsel
Source: workflow W627 — Product Recall Effectiveness Verification &amp; Post-Recall Review</bpmn:documentation>
      <bpmn:laneSet id="W627_LaneSet5">
        <bpmn:lane id="W627_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W627_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W627_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W627_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
