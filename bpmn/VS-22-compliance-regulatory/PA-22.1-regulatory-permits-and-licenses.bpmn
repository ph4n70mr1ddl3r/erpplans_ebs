    <bpmn:process id="W_W158" name="W158. Business Continuity Drill &amp; Disaster Recovery Testing" isExecutable="false">
      <bpmn:documentation>Trigger: Annual BC/DR schedule or major system change
Frequency: Semi-annual for IT DR; Annual for full BC drill
Volume: Covers all 5 legal entities and critical sites (HQ, DCs, 200 stores)
Owner: VP Legal &amp; Compliance
Participants: IT Infrastructure Team, DC Managers, Store Managers, HR, Finance
Source: workflow W158 — Business Continuity Drill &amp; Disaster Recovery Testing</bpmn:documentation>
      <bpmn:laneSet id="W158_LaneSet6">
        <bpmn:lane id="W158_Lane1" name="Compliance Officer">
        <bpmn:flowNodeRef>W158_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W158_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W158_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W158_Lane2" name="IT Manager">
        <bpmn:flowNodeRef>W158_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W158_Lane3" name="HR Manager">
        <bpmn:flowNodeRef>W158_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W158_Lane4" name="Store Manager">
        <bpmn:flowNodeRef>W158_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W158_Lane5" name="VP Legal &amp; Compliance">
        <bpmn:flowNodeRef>W158_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W158_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W158_Start7" name="Annual BC/DR schedule or major system change">
        <bpmn:outgoing>W158_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W158_Task8" name="Scenario Planning">
        <bpmn:documentation>Step 1: Scenario Planning: Define the drill scenario (e.g., total network outage, major typhoon landfall in Visayas, fire at DC3)
Responsible (R): Compliance Officer
Accountable (A): VP Legal &amp; Compliance
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W158_Flow17</bpmn:incoming>
        <bpmn:outgoing>W158_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W158_Task9" name="IT Disaster Recovery Test">
        <bpmn:documentation>Step 2: IT Disaster Recovery Test: Execute &quot;failover&quot; to backup data center; verify data integrity and POS transaction synchronization (W55)
Responsible (R): IT Manager
Accountable (A): CIO
Duration: 8-12 hours</bpmn:documentation>
        <bpmn:incoming>W158_Flow18</bpmn:incoming>
        <bpmn:outgoing>W158_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W158_Task10" name="Communication Drill">
        <bpmn:documentation>Step 3: Communication Drill: Activate emergency notification tree; verify response times from Store Managers and DC Supervisors
Responsible (R): HR Manager
Accountable (A): CHRO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W158_Flow19</bpmn:incoming>
        <bpmn:outgoing>W158_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W158_Task11" name="Operational Workarounds">
        <bpmn:documentation>Step 4: Operational Workarounds: Stores practice manual sales recording (W5G) and manual inventory logging for 4 hours; DCs practice manual load manifest creation
Responsible (R): Store Manager / DC Supervisor
Accountable (A): COO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W158_Flow20</bpmn:incoming>
        <bpmn:outgoing>W158_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W158_Task12" name="Post-Drill Review">
        <bpmn:documentation>Step 5: Post-Drill Review: Document gaps, system performance issues, and communication bottlenecks; update Business Continuity Plan (BCP)
Responsible (R): Compliance Officer
Accountable (A): VP Legal &amp; Compliance
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W158_Flow21</bpmn:incoming>
        <bpmn:outgoing>W158_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W158_Task13" name="Board Reporting">
        <bpmn:documentation>Step 6: Board Reporting: Present DR/BC readiness status and improvement plan to the Board of Directors
Responsible (R): VP Legal &amp; Compliance
Accountable (A): CEO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W158_Flow22</bpmn:incoming>
        <bpmn:outgoing>W158_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W158_End14" name="Complete">
        <bpmn:incoming>W158_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W158_Annotation15">
        <bpmn:text>Controls: - CTL-307 (ensure controlled execution — Regulatory Permits &amp; Licenses (PA-22.1).) | - operational: VP Legal &amp; Compliance review and approval gate
Owner: VP Legal &amp; Compliance</bpmn:text>
      </bpmn:textAnnotation>
