    <bpmn:process id="W_W437" name="W437. Regulatory Branch De-registration &amp; Permit Cancellation" isExecutable="false">
      <bpmn:documentation>Trigger: Formal decision to close or relocate a store (W45)
Frequency: Ad-hoc (Rare)
Volume: ~1–2 branches per year
Owner: Regulatory Officer
Participants: VP Legal, Finance (Tax), BIR, LGU, DTI, SSS, PhilHealth, Pag-IBIG
Source: workflow W437 — Regulatory Branch De-registration &amp; Permit Cancellation</bpmn:documentation>
      <bpmn:laneSet id="W437_LaneSet7">
        <bpmn:lane id="W437_Lane1" name="Tax Manager">
        <bpmn:flowNodeRef>W437_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W437_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W437_Lane2" name="Regulatory Officer">
        <bpmn:flowNodeRef>W437_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W437_Lane3" name="Finance">
        <bpmn:flowNodeRef>W437_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W437_Lane4" name="IT Manager">
        <bpmn:flowNodeRef>W437_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W437_Lane5" name="HR Manager">
        <bpmn:flowNodeRef>W437_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W437_Lane6" name="System">
        <bpmn:flowNodeRef>W437_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W437_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W437_Start8" name="Formal decision to close or relocate a store (W45)">
        <bpmn:outgoing>W437_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W437_Task9" name="BIR Notification">
        <bpmn:documentation>Step 1: BIR Notification: File &quot;Notice of Closure&quot; with the RDO having jurisdiction over the store within 10 days of closure
Responsible (R): Tax Manager
Accountable (A): VP Legal
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W437_Flow18</bpmn:incoming>
        <bpmn:outgoing>W437_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W437_Task10" name="LGU Cancellation">
        <bpmn:documentation>Step 2: LGU Cancellation: Surrender the Business Permit and Mayor&#x27;s Permit to the BPLO; settle any outstanding Local Business Tax (LBT)
Responsible (R): Regulatory Officer
Accountable (A): Store Manager
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W437_Flow19</bpmn:incoming>
        <bpmn:outgoing>W437_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W437_Task11" name="Inventory Clearance">
        <bpmn:documentation>Step 3: Inventory Clearance: For BIR purposes, declare the final inventory disposition (sale, transfer, or write-off) and settle any associated VAT
Responsible (R): Finance
Accountable (A): Controller
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W437_Flow20</bpmn:incoming>
        <bpmn:outgoing>W437_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W437_Task12" name="CAS De-registration">
        <bpmn:documentation>Step 4: CAS De-registration: Formally request the BIR to cancel the &quot;Permit to Use&quot; for POS terminals and the Computerized Accounting System (CAS) at that location
Responsible (R): IT Manager
Accountable (A): CIO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W437_Flow21</bpmn:incoming>
        <bpmn:outgoing>W437_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W437_Task13" name="Statutory Updates">
        <bpmn:documentation>Step 5: Statutory Updates: Notify SSS, PhilHealth, and Pag-IBIG of the branch closure to stop billing for that specific employer branch code (if applicable)
Responsible (R): HR Manager
Accountable (A): —
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W437_Flow22</bpmn:incoming>
        <bpmn:outgoing>W437_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W437_Task14" name="Document Archival">
        <bpmn:documentation>Step 6: Document Archival: Maintain all &quot;Certificate of No Outstanding Liability&quot; and &quot;Closure Certs&quot; for 10 years per BIR rules
Responsible (R): System
Accountable (A): Regulatory Officer
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W437_Flow23</bpmn:incoming>
        <bpmn:outgoing>W437_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W437_End15" name="Complete">
        <bpmn:incoming>W437_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W437_Annotation16">
        <bpmn:text>Controls: - CTL-307 (ensure controlled execution — Regulatory Permits &amp; Licenses (PA-22.1).) | - operational: continues to expect monthly reports, leading to automated &quot;Open Case&quot; penalties
Owner: Regulatory Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W437_Assoc17" sourceRef="W437_Annotation16" targetRef="W437_Start8" associationDirection="None" />
      <bpmn:sequenceFlow id="W437_Flow18" sourceRef="W437_Start8" targetRef="W437_Task9" />
