        <bpmndi:BPMNShape id="W2574_End7_di" bpmnElement="W2574_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2574_Annotation8_di" bpmnElement="W2574_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2574_Flow10_di" bpmnElement="W2574_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2574_Flow11_di" bpmnElement="W2574_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2574_Flow12_di" bpmnElement="W2574_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2574_Flow13_di" bpmnElement="W2574_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2574_Assoc9_di" bpmnElement="W2574_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2575" name="W2575. Monthly Shared Services Cost Pool Compilation" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly close cycle
Frequency: Monthly
Volume: ~15 cost pools across 5 entities
Owner: Finance Analyst
Participants: Finance Analyst, Cost Center Managers, Finance Controller
Source: workflow W2575 — Monthly Shared Services Cost Pool Compilation</bpmn:documentation>
      <bpmn:laneSet id="W2575_LaneSet3">
        <bpmn:lane id="W2575_Lane1" name="Finance Analyst">
        <bpmn:flowNodeRef>W2575_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2575_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2575_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2575_Lane2" name="Finance Controller">
        <bpmn:flowNodeRef>W2575_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2575_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2575_Start4" name="Monthly close cycle">
        <bpmn:outgoing>W2575_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2575_Task5" name="Finance Analyst compiles monthly shared services costs: extracts actual costs…">
        <bpmn:documentation>Step 1: Finance Analyst compiles monthly shared services costs: extracts actual costs from each shared service cost center (IT: PHP ~5M/month, HR: PHP ~2M/month, Finance: PHP ~3M/month, Procurement: PHP ~1.5M/month, Facilities: PHP ~8M/month); validates against budget and prior month
Responsible (R): Finance Analyst
Accountable (A): Finance Controller
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W2575_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2575_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2575_Task6" name="Analyst processes cost adjustments: accrues for unbilled services, corrects…">
        <bpmn:documentation>Step 2: Analyst processes cost adjustments: accrues for unbilled services, corrects misposted costs, allocates shared costs that are directly chargeable (e.g., IT project specific to one entity); prepares allocation summary for controller review
Responsible (R): Finance Analyst
Accountable (A): Finance Controller
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2575_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2575_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2575_Task7" name="Finance Controller reviews and approves compiled cost pool; signs off on…">
        <bpmn:documentation>Step 3: Finance Controller reviews and approves compiled cost pool; signs off on allocation run; system posts allocation entries to each entity&#x27;s GL; generates allocation report for intercompany reconciliation
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2575_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2575_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2575_End8" name="Complete">
        <bpmn:incoming>W2575_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2575_Annotation9">
        <bpmn:text>Controls: - CTL-213: duplicate-allocation guard &amp; chargeback cost-accuracy — links to VS-17; operational: Finance Controller sign-off on the allocation run
Owner: Finance Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2575_Assoc10" sourceRef="W2575_Annotation9" targetRef="W2575_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2575_Flow11" sourceRef="W2575_Start4" targetRef="W2575_Task5" />
      <bpmn:sequenceFlow id="W2575_Flow12" sourceRef="W2575_Task5" targetRef="W2575_Task6" />
      <bpmn:sequenceFlow id="W2575_Flow13" sourceRef="W2575_Task6" targetRef="W2575_Task7" />
      <bpmn:sequenceFlow id="W2575_Flow14" sourceRef="W2575_Task7" targetRef="W2575_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2575_diag">
      <bpmndi:BPMNPlane id="W2575_plane" bpmnElement="W_W2575">
        <bpmndi:BPMNShape id="W2575_Lane1_di" bpmnElement="W2575_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2575_Lane2_di" bpmnElement="W2575_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2575_Task5_di" bpmnElement="W2575_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2575_Task6_di" bpmnElement="W2575_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2575_Task7_di" bpmnElement="W2575_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2575_Start4_di" bpmnElement="W2575_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2575_End8_di" bpmnElement="W2575_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2575_Annotation9_di" bpmnElement="W2575_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2575_Flow11_di" bpmnElement="W2575_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2575_Flow12_di" bpmnElement="W2575_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2575_Flow13_di" bpmnElement="W2575_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2575_Flow14_di" bpmnElement="W2575_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2575_Assoc10_di" bpmnElement="W2575_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2576" name="W2576. IT Shared Services Chargeback Calculation &amp; Allocation" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly IT cost allocation cycle
Frequency: Monthly
Volume: IT budget ~PHP 60M/year across 5 entities
Owner: IT Finance Analyst
Participants: IT Finance Analyst, CIO, Entity CFOs
Source: workflow W2576 — IT Shared Services Chargeback Calculation &amp; Allocation</bpmn:documentation>
      <bpmn:laneSet id="W2576_LaneSet3">
        <bpmn:lane id="W2576_Lane1" name="IT Finance Analyst">
        <bpmn:flowNodeRef>W2576_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2576_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2576_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2576_Lane2" name="System">
        <bpmn:flowNodeRef>W2576_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2576_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2576_Start4" name="Monthly IT cost allocation cycle">
        <bpmn:outgoing>W2576_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2576_Task5" name="IT Finance Analyst compiles IT shared costs: infrastructure (servers, network…">
        <bpmn:documentation>Step 1: IT Finance Analyst compiles IT shared costs: infrastructure (servers, network, cloud), applications (ERP licenses, POS system), helpdesk (staff costs), security (cybersecurity tools), project costs (new implementations); separates direct-chargeable projects from shared pool
Responsible (R): IT Finance Analyst
Accountable (A): Finance Controller
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W2576_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2576_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2576_Task6" name="Analyst calculates entity allocation: infrastructure by user count (Depot Inc…">
        <bpmn:documentation>Step 2: Analyst calculates entity allocation: infrastructure by user count (Depot Inc. ~5,000 users = 75%, Logistics ~600 = 9%, Digital ~50 = 1%, Property ~100 = 1.5%, Holdings ~315 = 5%), applications by transaction volume, helpdesk by ticket count, security equally; validates allocation reasonableness vs. entity revenue contribution
Responsible (R): IT Finance Analyst
Accountable (A): CIO / Finance Controller
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2576_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2576_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2576_Task7" name="System generates IT chargeback entries per entity; posts to IC AP/AR accounts…">
        <bpmn:documentation>Step 3: System generates IT chargeback entries per entity; posts to IC AP/AR accounts; produces entity-level IT cost report for management review; CIO reviews entity IT spending vs. budget in monthly IT governance meeting
Responsible (R): System / IT Finance Analyst
Accountable (A): CIO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2576_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2576_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2576_End8" name="Complete">
        <bpmn:incoming>W2576_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2576_Annotation9">
        <bpmn:text>Controls: - CTL-213 (ensure shared-services chargeback integrity.) | - CTL-445 (IT-asset/license accuracy — links to VS-99); operational: CIO monthly IT-governance sign-off
Owner: IT Finance Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2576_Assoc10" sourceRef="W2576_Annotation9" targetRef="W2576_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2576_Flow11" sourceRef="W2576_Start4" targetRef="W2576_Task5" />
      <bpmn:sequenceFlow id="W2576_Flow12" sourceRef="W2576_Task5" targetRef="W2576_Task6" />
      <bpmn:sequenceFlow id="W2576_Flow13" sourceRef="W2576_Task6" targetRef="W2576_Task7" />
      <bpmn:sequenceFlow id="W2576_Flow14" sourceRef="W2576_Task7" targetRef="W2576_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2576_diag">
      <bpmndi:BPMNPlane id="W2576_plane" bpmnElement="W_W2576">
        <bpmndi:BPMNShape id="W2576_Lane1_di" bpmnElement="W2576_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2576_Lane2_di" bpmnElement="W2576_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2576_Task5_di" bpmnElement="W2576_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2576_Task6_di" bpmnElement="W2576_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2576_Task7_di" bpmnElement="W2576_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2576_Start4_di" bpmnElement="W2576_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2576_End8_di" bpmnElement="W2576_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2576_Annotation9_di" bpmnElement="W2576_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2576_Flow11_di" bpmnElement="W2576_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2576_Flow12_di" bpmnElement="W2576_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2576_Flow13_di" bpmnElement="W2576_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2576_Flow14_di" bpmnElement="W2576_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2576_Assoc10_di" bpmnElement="W2576_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2577" name="W2577. HR Shared Services Cost Allocation" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly HR cost allocation cycle
Frequency: Monthly
Volume: HR budget ~PHP 24M/year shared services
Owner: HR Finance Analyst
Participants: HR Finance Analyst, CHRO, Entity CFOs
Source: workflow W2577 — HR Shared Services Cost Allocation</bpmn:documentation>
      <bpmn:laneSet id="W2577_LaneSet3">
        <bpmn:lane id="W2577_Lane1" name="HR Finance Analyst">
        <bpmn:flowNodeRef>W2577_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2577_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2577_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2577_Lane2" name="System">
        <bpmn:flowNodeRef>W2577_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2577_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2577_Start4" name="Monthly HR cost allocation cycle">
        <bpmn:outgoing>W2577_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2577_Task5" name="HR Finance Analyst compiles shared HR costs: payroll processing (semi-monthly…">
        <bpmn:documentation>Step 1: HR Finance Analyst compiles shared HR costs: payroll processing (semi-monthly runs for 6,918 employees across 5 entities), recruitment shared services, training and development, benefits administration, HRIS system costs; separates entity-specific costs (entity-specific hiring, entity-specific training)
Responsible (R): HR Finance Analyst
Accountable (A): Finance Controller
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2577_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2577_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2577_Task6" name="Allocates shared HR costs: payroll processing by headcount per entity…">
        <bpmn:documentation>Step 2: Allocates shared HR costs: payroll processing by headcount per entity, recruitment by number of hires per entity, training by training hours consumed per entity, benefits administration by enrollment count per entity, HRIS by headcount; Depot Inc. bears ~86% (store + HQ headcount)
Responsible (R): HR Finance Analyst
Accountable (A): CHRO / Finance Controller
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2577_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2577_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2577_Task7" name="System posts HR chargeback entries; generates entity HR cost reports; CHRO…">
        <bpmn:documentation>Step 3: System posts HR chargeback entries; generates entity HR cost reports; CHRO reviews HR cost per employee by entity in quarterly HR metrics review
Responsible (R): System / HR Finance Analyst
Accountable (A): CHRO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2577_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2577_Flow14</bpmn:outgoing>
