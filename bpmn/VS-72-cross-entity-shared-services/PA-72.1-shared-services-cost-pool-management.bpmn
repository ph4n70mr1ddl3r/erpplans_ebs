<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-72.1-shared-services-cost-pool-management" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2574" name="W2574. Shared Services Cost Pool Identification &amp; Classification" isExecutable="false">
      <bpmn:documentation>Trigger: Annual classification cycle or new shared service establishment
Frequency: Annual; event-driven for new services
Volume: 5 legal entities; ~15 shared service categories
Owner: Finance Controller
Participants: Finance Controller, Entity CFOs, COO
Source: workflow W2574 — Shared Services Cost Pool Identification &amp; Classification</bpmn:documentation>
      <bpmn:laneSet id="W2574_LaneSet2">
        <bpmn:lane id="W2574_Lane1" name="Finance Controller">
        <bpmn:flowNodeRef>W2574_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2574_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2574_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2574_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2574_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2574_Start3" name="Annual classification cycle or new shared service establishment">
        <bpmn:outgoing>W2574_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2574_Task4" name="Finance Controller identifies shared service cost pools: IT infrastructure and…">
        <bpmn:documentation>Step 1: Finance Controller identifies shared service cost pools: IT infrastructure and applications, HR services (payroll, recruitment), finance shared services (AP, AR, GL), procurement operations, real estate and facilities management, logistics planning; classifies each as direct-chargeable or allocated
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2574_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2574_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2574_Task5" name="For each cost pool: defines allocation methodology (headcount for HR…">
        <bpmn:documentation>Step 2: For each cost pool: defines allocation methodology (headcount for HR, transaction volume for AP/AR, revenue for IT, square footage for facilities, FTE for procurement); documents methodology in transfer pricing policy; obtains CFO and external advisor sign-off for arm&#x27;s-length compliance
Responsible (R): Finance Controller / Transfer Pricing Advisor
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2574_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2574_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2574_Task6" name="System configures cost pool allocation rules: sets allocation keys per entity…">
        <bpmn:documentation>Step 3: System configures cost pool allocation rules: sets allocation keys per entity, establishes monthly run schedule, defines GL posting rules per entity; Finance Controller validates with test run; documents for audit trail
Responsible (R): Finance Controller / IT
Accountable (A): CFO
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W2574_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2574_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2574_End7" name="Complete">
        <bpmn:incoming>W2574_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2574_Annotation8">
        <bpmn:text>Controls: - CTL-213 (ensure shared-services chargeback integrity.) | - CTL-445 (transfer-pricing arm&#x27;s-length — links to VS-17 / W235 transfer-pricing tax compliance); operational: CFO + external-advisor sign-off on the methodology
Owner: Finance Controller</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2574_Assoc9" sourceRef="W2574_Annotation8" targetRef="W2574_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2574_Flow10" sourceRef="W2574_Start3" targetRef="W2574_Task4" />
      <bpmn:sequenceFlow id="W2574_Flow11" sourceRef="W2574_Task4" targetRef="W2574_Task5" />
      <bpmn:sequenceFlow id="W2574_Flow12" sourceRef="W2574_Task5" targetRef="W2574_Task6" />
      <bpmn:sequenceFlow id="W2574_Flow13" sourceRef="W2574_Task6" targetRef="W2574_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2574_diag">
      <bpmndi:BPMNPlane id="W2574_plane" bpmnElement="W_W2574">
        <bpmndi:BPMNShape id="W2574_Lane1_di" bpmnElement="W2574_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2574_Task4_di" bpmnElement="W2574_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
