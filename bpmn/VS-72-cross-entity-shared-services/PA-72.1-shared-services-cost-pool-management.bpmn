    <bpmn:process id="W_W2580" name="W2580. Shared Services Cost Pool Audit &amp; Documentation" isExecutable="false">
      <bpmn:documentation>Trigger: Internal audit cycle or external audit request
Frequency: Annual internal; annual external
Volume: ~15 cost pools
Owner: Internal Auditor
Participants: Internal Auditor, Finance Controller, External Auditors
Source: workflow W2580 — Shared Services Cost Pool Audit &amp; Documentation</bpmn:documentation>
      <bpmn:laneSet id="W2580_LaneSet3">
        <bpmn:lane id="W2580_Lane1" name="Internal Auditor">
        <bpmn:flowNodeRef>W2580_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2580_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2580_Lane2" name="Finance Controller">
        <bpmn:flowNodeRef>W2580_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2580_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2580_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2580_Start4" name="Internal audit cycle or external audit request">
        <bpmn:outgoing>W2580_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2580_Task5" name="Internal Auditor reviews shared services allocation methodology: verifies…">
        <bpmn:documentation>Step 1: Internal Auditor reviews shared services allocation methodology: verifies arm&#x27;s-length pricing, tests allocation calculation accuracy, reviews cost pool classification (direct vs. allocated), assesses completeness of cost capture; produces audit findings report
Responsible (R): Internal Auditor
Accountable (A): Head of Internal Audit
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2580_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2580_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2580_Task6" name="Finance Controller addresses audit findings: corrects methodology issues…">
        <bpmn:documentation>Step 2: Finance Controller addresses audit findings: corrects methodology issues, adjusts misallocated costs, strengthens documentation for transfer pricing file; implements controls recommended by auditor
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W2580_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2580_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2580_Task7" name="External auditors review shared services allocation as part of intercompany…">
        <bpmn:documentation>Step 3: External auditors review shared services allocation as part of intercompany transactions audit: verify transfer pricing documentation, confirm allocation mathematical accuracy, assess management judgment reasonableness; Finance Controller provides supporting documentation
Responsible (R): Finance Controller / External Auditors
Accountable (A): CFO
Duration: During annual audit (1–2 weeks)</bpmn:documentation>
        <bpmn:incoming>W2580_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2580_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2580_End8" name="Complete">
        <bpmn:incoming>W2580_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2580_Annotation9">
        <bpmn:text>Controls: - CTL-445 (ensure controlled execution — Shared Services Cost Pool Management (PA-72.1).) | - operational: auditor independent of the Controller (segregation of duties); Head of Internal Audit sign-off on the findings; CFO sign-off on remediation
Owner: Internal Auditor</bpmn:text>
      </bpmn:textAnnotation>
