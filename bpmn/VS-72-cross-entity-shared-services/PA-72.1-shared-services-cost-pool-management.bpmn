    <bpmn:process id="W_W2579" name="W2579. Shared Service Cost Budget &amp; Variance Management" isExecutable="false">
      <bpmn:documentation>Trigger: Annual budget cycle; monthly variance review
Frequency: Annual budget; monthly review
Volume: ~15 cost pools
Owner: Finance Controller
Participants: Finance Controller, CFO, Cost Center Managers
Source: workflow W2579 — Shared Service Cost Budget &amp; Variance Management</bpmn:documentation>
      <bpmn:laneSet id="W2579_LaneSet3">
        <bpmn:lane id="W2579_Lane1" name="Finance Controller">
        <bpmn:flowNodeRef>W2579_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2579_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2579_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2579_Lane2" name="Finance Analyst">
        <bpmn:flowNodeRef>W2579_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2579_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2579_Start4" name="Annual budget cycle; monthly variance review">
        <bpmn:outgoing>W2579_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2579_Task5" name="Finance Controller establishes annual shared services budget per cost pool…">
        <bpmn:documentation>Step 1: Finance Controller establishes annual shared services budget per cost pool: top-down from enterprise budget, bottom-up from cost center manager inputs; sets monthly phasing; obtains CFO approval
Responsible (R): Finance Controller / Cost Center Managers
Accountable (A): CFO
Duration: 2–3 weeks (during budget cycle)</bpmn:documentation>
        <bpmn:incoming>W2579_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2579_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2579_Task6" name="Monthly: Finance Analyst compares actual shared services costs vs. budget…">
        <bpmn:documentation>Step 2: Monthly: Finance Analyst compares actual shared services costs vs. budget; investigates variances &gt;5%; identifies cost overruns (especially IT projects and facilities maintenance); prepares variance commentary for CFO review
Responsible (R): Finance Analyst
Accountable (A): Finance Controller
Duration: 1–2 days/month</bpmn:documentation>
        <bpmn:incoming>W2579_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2579_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2579_Task7" name="Quarterly: Finance Controller presents shared services cost trend to CFO and…">
        <bpmn:documentation>Step 3: Quarterly: Finance Controller presents shared services cost trend to CFO and COO; proposes corrective actions for over-budget categories; adjusts allocation rates if significant permanent cost changes; updates annual forecast
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W2579_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2579_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2579_End8" name="Complete">
        <bpmn:incoming>W2579_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2579_Annotation9">
        <bpmn:text>Controls: - CTL-213 (ensure shared-services chargeback integrity.) | - CTL-445 (budget-vs-actual accuracy — links to VS-17 / W26); operational: CFO quarterly variance-review sign-off
Owner: Finance Controller</bpmn:text>
      </bpmn:textAnnotation>
