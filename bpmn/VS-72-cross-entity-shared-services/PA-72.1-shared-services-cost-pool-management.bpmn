        <bpmndi:BPMNEdge id="W2580_Flow13_di" bpmnElement="W2580_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2580_Flow14_di" bpmnElement="W2580_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2580_Assoc10_di" bpmnElement="W2580_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2581" name="W2581. Shared Service Provider Recharge to External Third Parties" isExecutable="false">
      <bpmn:documentation>Trigger: Service provided to external party by shared service function
Frequency: Ad-hoc; 5–10 per year
Volume: 5 entities
Owner: Finance Controller
Participants: Finance Controller, Legal, Entity CFOs
Source: workflow W2581 — Shared Service Provider Recharge to External Third Parties</bpmn:documentation>
      <bpmn:laneSet id="W2581_LaneSet4">
        <bpmn:lane id="W2581_Lane1" name="Finance Controller">
        <bpmn:flowNodeRef>W2581_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2581_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2581_Lane2" name="Legal">
        <bpmn:flowNodeRef>W2581_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2581_Lane3" name="Finance">
        <bpmn:flowNodeRef>W2581_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2581_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2581_Start5" name="Service provided to external party by shared service function">
        <bpmn:outgoing>W2581_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2581_Task6" name="Finance Controller identifies external recharge opportunity: shared service…">
        <bpmn:documentation>Step 1: Finance Controller identifies external recharge opportunity: shared service provider (e.g., BuildRight Logistics) provides warehousing to external party, or IT provides system access to joint venture partner; calculates recharge cost including direct cost + reasonable margin (5–10%)
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W2581_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2581_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2581_Task7" name="Legal prepares service agreement: scope, pricing, payment terms, data privacy…">
        <bpmn:documentation>Step 2: Legal prepares service agreement: scope, pricing, payment terms, data privacy provisions (RA 10173), liability limitations; CFO approves pricing; entity head signs agreement
Responsible (R): Legal / Finance Controller
Accountable (A): CEO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2581_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2581_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2581_Task8" name="Finance generates monthly recharge invoice; posts revenue to shared service…">
        <bpmn:documentation>Step 3: Finance generates monthly recharge invoice; posts revenue to shared service entity; ensures VAT and withholding tax compliance on recharge revenue; tracks accounts receivable from external party
Responsible (R): Finance / Billing
Accountable (A): Finance Controller
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2581_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2581_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2581_End9" name="Complete">
        <bpmn:incoming>W2581_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2581_Annotation10">
        <bpmn:text>Controls: - CTL-445 (tax compliance — links to VS-79 / W90); CTL-44 (duplicate-invoice guard); operational: CEO sign-off on the agreement
Owner: Finance Controller</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2581_Assoc11" sourceRef="W2581_Annotation10" targetRef="W2581_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2581_Flow12" sourceRef="W2581_Start5" targetRef="W2581_Task6" />
      <bpmn:sequenceFlow id="W2581_Flow13" sourceRef="W2581_Task6" targetRef="W2581_Task7" />
      <bpmn:sequenceFlow id="W2581_Flow14" sourceRef="W2581_Task7" targetRef="W2581_Task8" />
      <bpmn:sequenceFlow id="W2581_Flow15" sourceRef="W2581_Task8" targetRef="W2581_End9" />
    </bpmn:process>
