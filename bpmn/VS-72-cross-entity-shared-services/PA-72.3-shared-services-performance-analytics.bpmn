    <bpmn:process id="W_W2594" name="W2594. Transfer Pricing Documentation &amp; BIR Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: Annual documentation cycle or BIR audit trigger
Frequency: Annual; event-driven
Volume: 5 entities; ~20 IC flows
Owner: Finance Controller
Participants: Finance Controller, External TP Advisor, Legal, CFO
Source: workflow W2594 — Transfer Pricing Documentation &amp; BIR Compliance</bpmn:documentation>
      <bpmn:laneSet id="W2594_LaneSet3">
        <bpmn:lane id="W2594_Lane1" name="Finance Controller">
