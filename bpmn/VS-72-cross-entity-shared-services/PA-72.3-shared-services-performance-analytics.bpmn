    <bpmn:process id="W_W2597" name="W2597. Shared Services Annual Performance Report &amp; Board Presentation" isExecutable="false">
      <bpmn:documentation>Trigger: Annual reporting cycle
Frequency: Annual
Volume: 5 entities; ~15 shared service categories
Owner: Finance Controller
Participants: Finance Controller, CFO, COO, Board
Source: workflow W2597 — Shared Services Annual Performance Report &amp; Board Presentation</bpmn:documentation>
      <bpmn:laneSet id="W2597_LaneSet3">
        <bpmn:lane id="W2597_Lane1" name="Finance Controller">
        <bpmn:flowNodeRef>W2597_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2597_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2597_Lane2" name="CFO">
        <bpmn:flowNodeRef>W2597_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2597_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2597_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2597_Start4" name="Annual reporting cycle">
        <bpmn:outgoing>W2597_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2597_Task5" name="Finance Controller compiles annual shared services performance report: total…">
        <bpmn:documentation>Step 1: Finance Controller compiles annual shared services performance report: total shared services cost (PHP ~150M/year), cost per entity, efficiency trend (3-year), automation progress, SLA compliance, transfer pricing compliance, benchmarking results, 3-year outlook
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2597_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2597_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2597_Task6" name="CFO reviews and approves report; highlights key findings and strategic…">
        <bpmn:documentation>Step 2: CFO reviews and approves report; highlights key findings and strategic recommendations for Board presentation; includes shared services transformation roadmap and investment requests
Responsible (R): CFO
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2597_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2597_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2597_Task7" name="CFO presents to Board Audit Committee: shared services governance, IC…">
        <bpmn:documentation>Step 3: CFO presents to Board Audit Committee: shared services governance, IC transaction compliance, transfer pricing status, cost efficiency achievements, investment proposals; Board provides oversight feedback and approves major initiatives
Responsible (R): CFO
Accountable (A): Board Audit Committee
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W2597_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2597_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2597_End8" name="Complete">
        <bpmn:incoming>W2597_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2597_Annotation9">
        <bpmn:text>Controls: - CTL-349: board &amp; committee governance — annual report receipt minuted (links to VS-21 / VS-36); operational: Board Audit Committee receipt minuted
Owner: Finance Controller</bpmn:text>
      </bpmn:textAnnotation>
