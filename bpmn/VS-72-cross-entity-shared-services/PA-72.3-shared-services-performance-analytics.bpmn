    <bpmn:process id="W_W2596" name="W2596. Shared Services Entity Profitability Contribution Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly profitability review
Frequency: Quarterly
Volume: 5 entities
Owner: FP&amp;A Manager
Participants: FP&amp;A Mgr, Finance Controller, CFO
Source: workflow W2596 — Shared Services Entity Profitability Contribution Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2596_LaneSet3">
        <bpmn:lane id="W2596_Lane1" name="FP&amp;A Manager">
        <bpmn:flowNodeRef>W2596_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2596_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2596_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2596_Lane2" name="CFO">
        <bpmn:flowNodeRef>W2596_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2596_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2596_Start4" name="Quarterly profitability review">
        <bpmn:outgoing>W2596_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2596_Task5" name="FP&amp;A Manager analyzes entity profitability after IC allocations: revenue per…">
        <bpmn:documentation>Step 1: FP&amp;A Manager analyzes entity profitability after IC allocations: revenue per entity, cost of services including IC charges, operating margin per entity; compares entity standalone profit vs. allocated shared services cost impact
Responsible (R): FP&amp;A Manager
Accountable (A): Finance Controller
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W2596_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2596_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2596_Task6" name="FP&amp;A identifies cross-subsidization concerns: entities with disproportionate…">
        <bpmn:documentation>Step 2: FP&amp;A identifies cross-subsidization concerns: entities with disproportionate shared service cost allocation relative to benefit received, entities subsidizing others&#x27; growth, transfer pricing margins distorting entity profitability
Responsible (R): FP&amp;A Manager
Accountable (A): CFO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2596_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2596_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2596_Task7" name="CFO reviews entity profitability with CEO: discusses allocation equity…">
        <bpmn:documentation>Step 3: CFO reviews entity profitability with CEO: discusses allocation equity, strategic investment justification (e.g., Digital Commerce Inc. startup losses funded by mature Depot Inc.), performance incentive implications; adjusts allocation methodology if significant inequity identified
Responsible (R): CFO
Accountable (A): CEO
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W2596_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2596_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2596_End8" name="Complete">
        <bpmn:incoming>W2596_Flow14</bpmn:incoming>
      </bpmn:endEvent>
