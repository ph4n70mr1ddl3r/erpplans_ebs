        <bpmndi:BPMNShape id="W2591_Annotation9_di" bpmnElement="W2591_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2591_Flow11_di" bpmnElement="W2591_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2591_Flow12_di" bpmnElement="W2591_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2591_Flow13_di" bpmnElement="W2591_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2591_Flow14_di" bpmnElement="W2591_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2591_Assoc10_di" bpmnElement="W2591_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2592" name="W2592. IC Profit Elimination &amp; Consolidation Impact Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly consolidation cycle
Frequency: Monthly
Volume: 5 entities
Owner: Consolidation Accountant
Participants: Consolidation Accountant, Finance Controller
Source: workflow W2592 — IC Profit Elimination &amp; Consolidation Impact Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2592_LaneSet3">
        <bpmn:lane id="W2592_Lane1" name="Consolidation Accountant">
        <bpmn:flowNodeRef>W2592_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2592_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2592_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2592_Lane2" name="Finance Controller">
        <bpmn:flowNodeRef>W2592_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2592_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2592_Start4" name="Monthly consolidation cycle">
        <bpmn:outgoing>W2592_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2592_Task5" name="Consolidation Accountant calculates IC profit elimination: identifies IC…">
        <bpmn:documentation>Step 1: Consolidation Accountant calculates IC profit elimination: identifies IC transactions with unrealized profit (inventory transfers between entities at above-cost, IC service margins), calculates elimination amounts, posts consolidation adjustment entries
Responsible (R): Consolidation Accountant
Accountable (A): Finance Controller
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2592_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2592_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2592_Task6" name="Accountant analyzes IC profit elimination trend: tracks IC margin levels by…">
        <bpmn:documentation>Step 2: Accountant analyzes IC profit elimination trend: tracks IC margin levels by service type, identifies margin creep (IC pricing gradually increasing above arm&#x27;s-length), flags high-margin IC transactions for transfer pricing review
Responsible (R): Consolidation Accountant
Accountable (A): Finance Controller
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2592_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2592_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2592_Task7" name="Finance Controller reviews elimination impact on consolidated financials…">
        <bpmn:documentation>Step 3: Finance Controller reviews elimination impact on consolidated financials: ensures eliminations are complete and accurate, verifies no material IC balances remain uneliminated, confirms consolidated tax positions reflect proper elimination
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2592_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2592_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2592_End8" name="Complete">
        <bpmn:incoming>W2592_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2592_Annotation9">
        <bpmn:text>Controls: - CTL-447 (ensure controlled execution — Shared Services Performance &amp; Analytics (PA-72.3).) | - CTL-447 (consolidation accuracy — links to VS-17 / W9A, W234); CTL-18 (TP arm&#x27;s-length — links to W235); operational: Finance Controller elimination sign-off
Owner: Consolidation Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2592_Assoc10" sourceRef="W2592_Annotation9" targetRef="W2592_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2592_Flow11" sourceRef="W2592_Start4" targetRef="W2592_Task5" />
      <bpmn:sequenceFlow id="W2592_Flow12" sourceRef="W2592_Task5" targetRef="W2592_Task6" />
      <bpmn:sequenceFlow id="W2592_Flow13" sourceRef="W2592_Task6" targetRef="W2592_Task7" />
      <bpmn:sequenceFlow id="W2592_Flow14" sourceRef="W2592_Task7" targetRef="W2592_End8" />
    </bpmn:process>
