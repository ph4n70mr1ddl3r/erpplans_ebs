      <bpmndi:BPMNPlane id="W2592_plane" bpmnElement="W_W2592">
        <bpmndi:BPMNShape id="W2592_Lane1_di" bpmnElement="W2592_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
