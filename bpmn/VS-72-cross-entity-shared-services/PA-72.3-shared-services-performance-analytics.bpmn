<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-72.3-shared-services-performance-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2590" name="W2590. Shared Services Efficiency &amp; Cost-per-Transaction Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly analytics cycle
Frequency: Monthly
Volume: ~15 shared service categories
Owner: Finance Analyst
Participants: Finance Analyst, Finance Controller, COO
Source: workflow W2590 — Shared Services Efficiency &amp; Cost-per-Transaction Analytics</bpmn:documentation>
      <bpmn:laneSet id="W2590_LaneSet3">
        <bpmn:lane id="W2590_Lane1" name="Finance Analyst">
        <bpmn:flowNodeRef>W2590_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2590_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2590_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2590_Lane2" name="Finance Controller">
        <bpmn:flowNodeRef>W2590_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2590_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2590_Start4" name="Monthly analytics cycle">
        <bpmn:outgoing>W2590_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2590_Task5" name="Finance Analyst calculates cost-per-transaction for each shared service: AP…">
        <bpmn:documentation>Step 1: Finance Analyst calculates cost-per-transaction for each shared service: AP cost per invoice processed (target: PHP 150–200), AR cost per invoice, payroll cost per payslip, IT cost per user, procurement cost per PO; compares against industry benchmarks
Responsible (R): Finance Analyst
Accountable (A): Finance Controller
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2590_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2590_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2590_Task6" name="Analyst identifies efficiency improvement opportunities: automation potential…">
        <bpmn:documentation>Step 2: Analyst identifies efficiency improvement opportunities: automation potential (AP OCR, payroll automation), volume consolidation across entities, shared service center staffing optimization, technology upgrade ROI
Responsible (R): Finance Analyst
Accountable (A): Finance Controller
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2590_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2590_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2590_Task7" name="Finance Controller presents efficiency analytics to COO and CFO: cost trend by…">
        <bpmn:documentation>Step 3: Finance Controller presents efficiency analytics to COO and CFO: cost trend by shared service, benchmark comparison, improvement recommendations with projected savings; proposes annual efficiency targets
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W2590_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2590_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2590_End8" name="Complete">
        <bpmn:incoming>W2590_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2590_Annotation9">
        <bpmn:text>Controls: - CTL-447 (ensure controlled execution — Shared Services Performance &amp; Analytics (PA-72.3).) | - operational: transaction-count integrity; operational: Finance Controller quarterly efficiency-review sign-off
Owner: Finance Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2590_Assoc10" sourceRef="W2590_Annotation9" targetRef="W2590_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2590_Flow11" sourceRef="W2590_Start4" targetRef="W2590_Task5" />
      <bpmn:sequenceFlow id="W2590_Flow12" sourceRef="W2590_Task5" targetRef="W2590_Task6" />
      <bpmn:sequenceFlow id="W2590_Flow13" sourceRef="W2590_Task6" targetRef="W2590_Task7" />
      <bpmn:sequenceFlow id="W2590_Flow14" sourceRef="W2590_Task7" targetRef="W2590_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2590_diag">
      <bpmndi:BPMNPlane id="W2590_plane" bpmnElement="W_W2590">
        <bpmndi:BPMNShape id="W2590_Lane1_di" bpmnElement="W2590_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2590_Lane2_di" bpmnElement="W2590_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
