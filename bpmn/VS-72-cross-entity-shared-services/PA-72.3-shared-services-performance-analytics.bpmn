      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2591" name="W2591. Cross-Entity Shared Services Benchmarking" isExecutable="false">
      <bpmn:documentation>Trigger: Annual benchmarking cycle
Frequency: Annual
Volume: 5 entities; ~15 categories
Owner: Finance Controller
Participants: Finance Controller, CFO, External Benchmarking Firm
Source: workflow W2591 — Cross-Entity Shared Services Benchmarking</bpmn:documentation>
      <bpmn:laneSet id="W2591_LaneSet3">
        <bpmn:lane id="W2591_Lane1" name="Finance Controller">
        <bpmn:flowNodeRef>W2591_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2591_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2591_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2591_Lane2" name="CFO">
        <bpmn:flowNodeRef>W2591_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2591_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2591_Start4" name="Annual benchmarking cycle">
        <bpmn:outgoing>W2591_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2591_Task5" name="Finance Controller engages benchmarking firm: compares BuildRight shared…">
        <bpmn:documentation>Step 1: Finance Controller engages benchmarking firm: compares BuildRight shared services cost and efficiency against Philippine retail sector peers, ASEAN retail benchmarks, global best practices; covers IT, HR, Finance, Procurement, Facilities functions
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: 4–6 weeks</bpmn:documentation>
        <bpmn:incoming>W2591_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2591_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2591_Task6" name="Controller analyzes benchmarking results: identifies above-benchmark costs…">
        <bpmn:documentation>Step 2: Controller analyzes benchmarking results: identifies above-benchmark costs (opportunity for reduction), below-benchmark costs (potential underinvestment risk), best practice adoption gaps; produces gap analysis with quantified improvement potential
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W2591_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2591_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2591_Task7" name="CFO and COO review benchmarking findings: set 3-year improvement targets…">
        <bpmn:documentation>Step 3: CFO and COO review benchmarking findings: set 3-year improvement targets, approve transformation initiatives (shared service automation, process re-engineering), allocate investment budget; Finance Controller tracks progress quarterly
Responsible (R): CFO / COO
Accountable (A): CEO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2591_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2591_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2591_End8" name="Complete">
        <bpmn:incoming>W2591_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2591_Annotation9">
        <bpmn:text>Controls: - CTL-447 (ensure controlled execution — Shared Services Performance &amp; Analytics (PA-72.3).) | - Operational: CFO + COO sign-off on the benchmarking findings and targets; CEO sign-off on major transformation investment
Owner: Finance Controller</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2591_Assoc10" sourceRef="W2591_Annotation9" targetRef="W2591_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2591_Flow11" sourceRef="W2591_Start4" targetRef="W2591_Task5" />
      <bpmn:sequenceFlow id="W2591_Flow12" sourceRef="W2591_Task5" targetRef="W2591_Task6" />
      <bpmn:sequenceFlow id="W2591_Flow13" sourceRef="W2591_Task6" targetRef="W2591_Task7" />
      <bpmn:sequenceFlow id="W2591_Flow14" sourceRef="W2591_Task7" targetRef="W2591_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2591_diag">
      <bpmndi:BPMNPlane id="W2591_plane" bpmnElement="W_W2591">
        <bpmndi:BPMNShape id="W2591_Lane1_di" bpmnElement="W2591_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2591_Lane2_di" bpmnElement="W2591_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
