        <bpmndi:BPMNShape id="W927_Task11_di" bpmnElement="W927_Task11"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W927_Start6_di" bpmnElement="W927_Start6"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W927_End12_di" bpmnElement="W927_End12"><dc:Bounds x="1470" y="657" width="36" height="36" /></bpmndi:BPMNShape>
