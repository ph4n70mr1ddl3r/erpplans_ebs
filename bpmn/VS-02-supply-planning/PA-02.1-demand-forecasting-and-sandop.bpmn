        <bpmndi:BPMNEdge id="W835_Flow18_di" bpmnElement="W835_Flow18"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W835_Flow19_di" bpmnElement="W835_Flow19"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
