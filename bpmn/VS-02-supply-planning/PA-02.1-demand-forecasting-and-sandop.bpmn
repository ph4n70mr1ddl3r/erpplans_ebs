    <bpmn:process id="W_W133" name="W133. Sales &amp; Operations Planning (S&amp;OP) Cycle" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly planning calendar (typically starting 10th business day)
Frequency: Monthly
Volume: Covers all product categories and all 4 DCs
Owner: VP for Supply Chain
Participants: CEO, COO, CFO, VP Merchandising, VP Store Operations, Supply Planning Manager, Demand Planner, Category Managers, Senior Demand Planner
Source: workflow W133 — Sales &amp; Operations Planning (S&amp;OP) Cycle</bpmn:documentation>
      <bpmn:laneSet id="W133_LaneSet6">
        <bpmn:lane id="W133_Lane1" name="Demand Planner">
        <bpmn:flowNodeRef>W133_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W133_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W133_Lane2" name="Supply Planner">
        <bpmn:flowNodeRef>W133_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W133_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W133_Lane3" name="Controller">
        <bpmn:flowNodeRef>W133_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W133_Lane4" name="Supply Planning Mgr">
        <bpmn:flowNodeRef>W133_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W133_Lane5" name="CEO">
        <bpmn:flowNodeRef>W133_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W133_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W133_Start7" name="Monthly planning calendar (typically starting 10th business day)">
        <bpmn:outgoing>W133_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W133_Task8" name="Demand Review">
        <bpmn:documentation>Step 1: Demand Review: Demand Planner and Category Managers review the unconstrained forecast (W31); adjust for planned promos (W83) and new store openings (W16); sign off on &quot;Consensus Demand Plan&quot;
Responsible (R): Demand Planner
Accountable (A): VP Merch
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W133_Flow17</bpmn:incoming>
        <bpmn:outgoing>W133_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W133_Task9" name="Supply Review">
        <bpmn:documentation>Step 2: Supply Review: Supply Planner and DC Managers evaluate ability to meet demand; check vendor lead times (W44), DC storage/labor capacity, and port congestion (W144); identify supply gaps
Responsible (R): Supply Planner
Accountable (A): VP Supply Chain
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W133_Flow18</bpmn:incoming>
        <bpmn:outgoing>W133_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W133_Task10" name="Financial Integration">
        <bpmn:documentation>Step 3: Financial Integration: Finance translates the volume plan into PHP; compares against budget (W26) and revenue targets; highlights margin risks if high-cost logistics (W66) are needed
Responsible (R): Controller
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W133_Flow19</bpmn:incoming>
        <bpmn:outgoing>W133_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W133_Task11" name="Pre-S&amp;OP Meeting">
        <bpmn:documentation>Step 4: Pre-S&amp;OP Meeting: Managers reconcile demand/supply gaps; develop scenarios (e.g., &quot;Air-freight vs. Out-of-stock&quot;) for leadership
Responsible (R): Supply Planning Mgr
Accountable (A): VP Supply Chain
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W133_Flow20</bpmn:incoming>
        <bpmn:outgoing>W133_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W133_Task12" name="Executive S&amp;OP Meeting">
        <bpmn:documentation>Step 5: Executive S&amp;OP Meeting: C-Suite reviews scenarios; makes trade-off decisions; approves the &quot;Consensus Operating Plan&quot; for the next 3–12 months
Responsible (R): CEO
Accountable (A): CEO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W133_Flow21</bpmn:incoming>
        <bpmn:outgoing>W133_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W133_Task13" name="Disaggregation">
        <bpmn:documentation>Step 6: Disaggregation: Approved plan is pushed back to replenishment systems (W4) and Buy Plans (W32) to drive execution
Responsible (R): Supply Planner
Accountable (A): —
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W133_Flow22</bpmn:incoming>
        <bpmn:outgoing>W133_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W133_End14" name="Complete">
        <bpmn:incoming>W133_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W133_Annotation15">
        <bpmn:text>Controls: - CTL-172 (ensure demand-plan integrity &amp; replenishment authorization.) | - operational: modules with different refresh cycles creates reconciliation overhead; operational: controls to flag plan-vs
Owner: VP for Supply Chain</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W133_Assoc16" sourceRef="W133_Annotation15" targetRef="W133_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W133_Flow17" sourceRef="W133_Start7" targetRef="W133_Task8" />
      <bpmn:sequenceFlow id="W133_Flow18" sourceRef="W133_Task8" targetRef="W133_Task9" />
      <bpmn:sequenceFlow id="W133_Flow19" sourceRef="W133_Task9" targetRef="W133_Task10" />
      <bpmn:sequenceFlow id="W133_Flow20" sourceRef="W133_Task10" targetRef="W133_Task11" />
      <bpmn:sequenceFlow id="W133_Flow21" sourceRef="W133_Task11" targetRef="W133_Task12" />
      <bpmn:sequenceFlow id="W133_Flow22" sourceRef="W133_Task12" targetRef="W133_Task13" />
      <bpmn:sequenceFlow id="W133_Flow23" sourceRef="W133_Task13" targetRef="W133_End14" />
    </bpmn:process>
