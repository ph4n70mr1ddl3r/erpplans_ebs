      <bpmndi:BPMNPlane id="W5509_plane" bpmnElement="W_W5509">
        <bpmndi:BPMNShape id="W5509_Lane1_di" bpmnElement="W5509_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2000" height="170" /></bpmndi:BPMNShape>
