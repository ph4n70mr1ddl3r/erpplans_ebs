    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W32" name="W32. Seasonal Buy Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Seasonal calendar milestones (6 months before each season peak)
Frequency: 4 major seasonal planning cycles/year: Christmas (plan in Jun), Summer/March (plan in Oct), Back-to-School (plan in Nov), Rainy Season/ typhoon prep (plan in Jan)
Volume: ~3,000–5,000 seasonal SKUs per major event; ~20–30 import POs per season
Owner: Category Manager
Participants: Category Manager, Buyer, Demand Planner, Import Coordinator, VP Merchandising, Finance (budget)
Source: workflow W32 — Seasonal Buy Planning</bpmn:documentation>
      <bpmn:laneSet id="W32_LaneSet9">
        <bpmn:lane id="W32_Lane1" name="Demand Planner">
        <bpmn:flowNodeRef>W32_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W32_Start10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W32_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W32_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W32_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W32_Task20</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W32_Lane3" name="Buyer">
        <bpmn:flowNodeRef>W32_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W32_Task17</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W32_Lane4" name="Controller">
        <bpmn:flowNodeRef>W32_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W32_Lane5" name="VP Merchandising">
        <bpmn:flowNodeRef>W32_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W32_Lane6" name="System">
        <bpmn:flowNodeRef>W32_Task18</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W32_Lane7" name="Pricing Analyst">
        <bpmn:flowNodeRef>W32_Task19</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W32_Lane8" name="Buyer + Category Manager">
        <bpmn:flowNodeRef>W32_Task21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W32_End22</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W32_Start10" name="Seasonal calendar milestones (6 months before each season peak)">
        <bpmn:outgoing>W32_Flow25</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W32_Task11" name="Demand Planner generates seasonal forecast: prior-year sales by SKU for the…">
        <bpmn:documentation>Step 1: Demand Planner generates seasonal forecast: prior-year sales by SKU for the season period, adjusted for current trend and planned promotions
Responsible (R): Demand Planner
Accountable (A): Category Manager
Duration: 4 hours/season</bpmn:documentation>
        <bpmn:incoming>W32_Flow25</bpmn:incoming>
        <bpmn:outgoing>W32_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W32_Task12" name="Category Manager reviews seasonal forecast; identifies SKUs to carry forward…">
        <bpmn:documentation>Step 2: Category Manager reviews seasonal forecast; identifies SKUs to carry forward, new items to add, items to drop
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 2 hours/season</bpmn:documentation>
        <bpmn:incoming>W32_Flow26</bpmn:incoming>
        <bpmn:outgoing>W32_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W32_Task13" name="Buyer solicits vendor quotations for seasonal items; negotiates volume…">
        <bpmn:documentation>Step 3: Buyer solicits vendor quotations for seasonal items; negotiates volume discounts, early-order incentives, and return/excess-stock terms
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 1 week/season</bpmn:documentation>
        <bpmn:incoming>W32_Flow27</bpmn:incoming>
        <bpmn:outgoing>W32_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W32_Task14" name="Category Manager creates seasonal buy plan: SKU-level quantities, vendor…">
        <bpmn:documentation>Step 4: Category Manager creates seasonal buy plan: SKU-level quantities, vendor allocation, delivery schedule (phased receipts vs. single drop)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 4 hours/season</bpmn:documentation>
        <bpmn:incoming>W32_Flow28</bpmn:incoming>
        <bpmn:outgoing>W32_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W32_Task15" name="Finance validates seasonal buy plan against working capital budget and…">
        <bpmn:documentation>Step 5: Finance validates seasonal buy plan against working capital budget and inventory plan (max inventory days target)
Responsible (R): Controller
Accountable (A): CFO
Duration: 2 hours/season</bpmn:documentation>
        <bpmn:incoming>W32_Flow29</bpmn:incoming>
        <bpmn:outgoing>W32_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W32_Task16" name="VP Merchandising approves seasonal buy plan">
        <bpmn:documentation>Step 6: VP Merchandising approves seasonal buy plan
Responsible (R): VP Merchandising
Accountable (A): VP Merchandising
Duration: 1 hour/season</bpmn:documentation>
        <bpmn:incoming>W32_Flow30</bpmn:incoming>
        <bpmn:outgoing>W32_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W32_Task17" name="Buyer creates import POs (W2B) or domestic POs (W2A) per the seasonal buy plan…">
        <bpmn:documentation>Step 7: Buyer creates import POs (W2B) or domestic POs (W2A) per the seasonal buy plan; times orders to arrive 6–8 weeks before season start
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: Per W2</bpmn:documentation>
        <bpmn:incoming>W32_Flow31</bpmn:incoming>
        <bpmn:outgoing>W32_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W32_Task18" name="System tracks seasonal PO commitments vs. seasonal buy plan budget; alerts if…">
        <bpmn:documentation>Step 8: System tracks seasonal PO commitments vs. seasonal buy plan budget; alerts if over-committed
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W32_Flow32</bpmn:incoming>
        <bpmn:outgoing>W32_Flow33</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W32_Task19" name="As season approaches: Pricing Analyst sets up seasonal pricing and promotions…">
        <bpmn:documentation>Step 9: As season approaches: Pricing Analyst sets up seasonal pricing and promotions (W13)
Responsible (R): Pricing Analyst
Accountable (A): Category Manager
Duration: Per W13</bpmn:documentation>
        <bpmn:incoming>W32_Flow33</bpmn:incoming>
        <bpmn:outgoing>W32_Flow34</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W32_Task20" name="Mid-season: Category Manager and Buyer review sell-through vs. plan; trigger…">
        <bpmn:documentation>Step 10: Mid-season: Category Manager and Buyer review sell-through vs. plan; trigger re-orders for hot items or accelerate markdowns for slow movers
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1 hour/week during season</bpmn:documentation>
        <bpmn:incoming>W32_Flow34</bpmn:incoming>
        <bpmn:outgoing>W32_Flow35</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W32_Task21" name="Post-season: Buyer and Category Manager conduct post-mortem: actual vs. plan…">
        <bpmn:documentation>Step 11: Post-season: Buyer and Category Manager conduct post-mortem: actual vs. plan sales, margin, leftover inventory disposition (clearance, return to vendor, carry forward to next year)
Responsible (R): Buyer + Category Manager
Accountable (A): VP Merchandising
Duration: 2 hours/season</bpmn:documentation>
        <bpmn:incoming>W32_Flow35</bpmn:incoming>
        <bpmn:outgoing>W32_Flow36</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W32_End22" name="Complete">
        <bpmn:incoming>W32_Flow36</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W32_Annotation23">
        <bpmn:text>Controls: - CTL-243 (ensure controlled execution — Demand Forecasting &amp; S&amp;OP (PA-02.1).) | - operational: Category Manager review and approval gate
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W32_Assoc24" sourceRef="W32_Annotation23" targetRef="W32_Start10" associationDirection="None" />
      <bpmn:sequenceFlow id="W32_Flow25" sourceRef="W32_Start10" targetRef="W32_Task11" />
      <bpmn:sequenceFlow id="W32_Flow26" sourceRef="W32_Task11" targetRef="W32_Task12" />
      <bpmn:sequenceFlow id="W32_Flow27" sourceRef="W32_Task12" targetRef="W32_Task13" />
      <bpmn:sequenceFlow id="W32_Flow28" sourceRef="W32_Task13" targetRef="W32_Task14" />
      <bpmn:sequenceFlow id="W32_Flow29" sourceRef="W32_Task14" targetRef="W32_Task15" />
      <bpmn:sequenceFlow id="W32_Flow30" sourceRef="W32_Task15" targetRef="W32_Task16" />
      <bpmn:sequenceFlow id="W32_Flow31" sourceRef="W32_Task16" targetRef="W32_Task17" />
      <bpmn:sequenceFlow id="W32_Flow32" sourceRef="W32_Task17" targetRef="W32_Task18" />
      <bpmn:sequenceFlow id="W32_Flow33" sourceRef="W32_Task18" targetRef="W32_Task19" />
      <bpmn:sequenceFlow id="W32_Flow34" sourceRef="W32_Task19" targetRef="W32_Task20" />
      <bpmn:sequenceFlow id="W32_Flow35" sourceRef="W32_Task20" targetRef="W32_Task21" />
      <bpmn:sequenceFlow id="W32_Flow36" sourceRef="W32_Task21" targetRef="W32_End22" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W32_diag">
      <bpmndi:BPMNPlane id="W32_plane" bpmnElement="W_W32">
        <bpmndi:BPMNShape id="W32_Lane1_di" bpmnElement="W32_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2630" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W32_Lane2_di" bpmnElement="W32_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="2630" height="170" /></bpmndi:BPMNShape>
