<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-02.1-demand-forecasting-and-sandop" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W31" name="W31. Demand Forecasting Cycle" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly forecast recalculation schedule (Sunday batch)
Frequency: Weekly recalculation; monthly review; quarterly adjustment
Volume: 35,000 active SKUs across 205 locations (200 stores + 4 DCs + HQ) = up to ~7.2M SKU-location forecasts; typically forecasted at DC level (140,000 SKU-DC combinations) and disaggregated to stores
Owner: Demand Planner
Participants: Demand Planner, Supply Planner, Category Manager, Pricing Analyst, Senior Demand Planner
Source: workflow W31 — Demand Forecasting Cycle</bpmn:documentation>
      <bpmn:laneSet id="W31_LaneSet3">
        <bpmn:lane id="W31_Lane1" name="System">
        <bpmn:flowNodeRef>W31_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W31_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W31_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W31_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W31_Lane2" name="Demand Planner">
        <bpmn:flowNodeRef>W31_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W31_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W31_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W31_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W31_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W31_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W31_Start4" name="Weekly forecast recalculation schedule (Sunday batch)">
        <bpmn:outgoing>W31_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W31_Task5" name="System runs automated forecast engine: statistical algorithms (exponential…">
        <bpmn:documentation>Step 1: System runs automated forecast engine: statistical algorithms (exponential smoothing, seasonal decomposition) applied to 2+ years of historical sales data per SKU per DC
Responsible (R): System
Accountable (A): —
Duration: Automated (Sunday batch, 1–3 hours)</bpmn:documentation>
        <bpmn:incoming>W31_Flow16</bpmn:incoming>
        <bpmn:outgoing>W31_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W31_Task6" name="System adjusts raw statistical forecast for known events: promotional calendar…">
        <bpmn:documentation>Step 2: System adjusts raw statistical forecast for known events: promotional calendar (W13), seasonal calendar, new store openings (W16), planned store closures, one-time events (typhoons, pandemic)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W31_Flow17</bpmn:incoming>
        <bpmn:outgoing>W31_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W31_Task7" name="Demand Planner reviews forecast exception report: SKUs with forecast error &gt;…">
        <bpmn:documentation>Step 3: Demand Planner reviews forecast exception report: SKUs with forecast error &gt; 30%, SKUs with insufficient history, new SKUs with no history, SKUs with sudden demand spikes or drops
Responsible (R): Demand Planner
Accountable (A): Supply Planning Manager
Duration: 2–3 hours/week</bpmn:documentation>
        <bpmn:incoming>W31_Flow18</bpmn:incoming>
        <bpmn:outgoing>W31_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W31_Task8" name="Demand Planner adjusts flagged forecasts manually: overrides algorithm, inputs…">
        <bpmn:documentation>Step 4: Demand Planner adjusts flagged forecasts manually: overrides algorithm, inputs qualitative intelligence (vendor intel, market trends, competitive activity)
Responsible (R): Demand Planner
Accountable (A): Supply Planning Manager
Duration: 1–2 hours/week</bpmn:documentation>
        <bpmn:incoming>W31_Flow19</bpmn:incoming>
        <bpmn:outgoing>W31_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W31_Task9" name="Demand Planner reviews forecast accuracy metrics (MAPE, bias) by category…">
        <bpmn:documentation>Step 5: Demand Planner reviews forecast accuracy metrics (MAPE, bias) by category; identifies systematic over/under-forecasting patterns
Responsible (R): Demand Planner
Accountable (A): Supply Planning Manager
Duration: 1 hour/week</bpmn:documentation>
        <bpmn:incoming>W31_Flow20</bpmn:incoming>
        <bpmn:outgoing>W31_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W31_Task10" name="Adjusted forecast released to replenishment engine (W4.1, W2A.1); system uses…">
        <bpmn:documentation>Step 6: Adjusted forecast released to replenishment engine (W4.1, W2A.1); system uses forecast instead of simple min/max for forecasted SKUs
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W31_Flow21</bpmn:incoming>
        <bpmn:outgoing>W31_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W31_Task11" name="Monthly: Demand Planner presents forecast vs. actual report to Category…">
        <bpmn:documentation>Step 7: Monthly: Demand Planner presents forecast vs. actual report to Category Managers; discusses upcoming demand shifts (one review per Category Manager, ~5 CMs per profile §13.1)
Responsible (R): Demand Planner
Accountable (A): VP Merchandising
Duration: 1 hour/CM/month</bpmn:documentation>
        <bpmn:incoming>W31_Flow22</bpmn:incoming>
        <bpmn:outgoing>W31_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W31_Task12" name="Quarterly: Demand Planner recalibrates forecast model parameters (alpha, beta…">
        <bpmn:documentation>Step 8: Quarterly: Demand Planner recalibrates forecast model parameters (alpha, beta, gamma for exponential smoothing); updates seasonal indices based on latest year of data; reviews and updates safety stock parameters per SKU-location based on forecast error and demand variability changes (feeds into W2A.1 ROP/safety stock calculation); reviews ROP parameter governance: (a) lead time accuracy per vendor — compares actual delivery lead time vs. system lead time and updates for vendors with &gt; 20% variance, flagging chronic late vendors for W44 review; (b) demand averaging period appropriateness by SKU volatility class; (c) service level targets by ABC class (e.g., A-items: 98%, B-items: 95%, C-items: 90% or as configured); (d) order multiple / MOQ accuracy per vendor-SKU; cross-references vendor lead time variance to vendor scorecard (W44)
Responsible (R): Demand Planner
Accountable (A): Supply Planning Manager
Duration: 4–6 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W31_Flow23</bpmn:incoming>
        <bpmn:outgoing>W31_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W31_End13" name="Complete">
        <bpmn:incoming>W31_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W31_Annotation14">
        <bpmn:text>Controls: - CTL-243 (ensure controlled execution — Demand Forecasting &amp; S&amp;OP (PA-02.1).) | - operational: replenishment unreliable for slow movers; operational: parameters, degrading safety stock calculations and ROP accuracy
Owner: Demand Planner</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W31_Assoc15" sourceRef="W31_Annotation14" targetRef="W31_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W31_Flow16" sourceRef="W31_Start4" targetRef="W31_Task5" />
      <bpmn:sequenceFlow id="W31_Flow17" sourceRef="W31_Task5" targetRef="W31_Task6" />
      <bpmn:sequenceFlow id="W31_Flow18" sourceRef="W31_Task6" targetRef="W31_Task7" />
      <bpmn:sequenceFlow id="W31_Flow19" sourceRef="W31_Task7" targetRef="W31_Task8" />
      <bpmn:sequenceFlow id="W31_Flow20" sourceRef="W31_Task8" targetRef="W31_Task9" />
      <bpmn:sequenceFlow id="W31_Flow21" sourceRef="W31_Task9" targetRef="W31_Task10" />
      <bpmn:sequenceFlow id="W31_Flow22" sourceRef="W31_Task10" targetRef="W31_Task11" />
      <bpmn:sequenceFlow id="W31_Flow23" sourceRef="W31_Task11" targetRef="W31_Task12" />
      <bpmn:sequenceFlow id="W31_Flow24" sourceRef="W31_Task12" targetRef="W31_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W31_diag">
      <bpmndi:BPMNPlane id="W31_plane" bpmnElement="W_W31">
        <bpmndi:BPMNShape id="W31_Lane1_di" bpmnElement="W31_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2000" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W31_Lane2_di" bpmnElement="W31_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="2000" height="170" /></bpmndi:BPMNShape>
