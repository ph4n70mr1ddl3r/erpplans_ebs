        <bpmn:flowNodeRef>W284_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W284_Lane5" name="Import Coordinator">
        <bpmn:flowNodeRef>W284_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W284_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W284_Start7" name="Arrival of imported goods designated for the CBW to defer customs duties until final…">
        <bpmn:outgoing>W284_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W284_Task8" name="Import container arrives and is received into a designated logical/physical CBW…">
        <bpmn:documentation>Step 1: Import container arrives and is received into a designated logical/physical CBW location in the WMS without paying duties (under customs bond).
Responsible (R): Logistics Coordinator
Accountable (A): Import Compliance Mgr
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W284_Flow16</bpmn:incoming>
        <bpmn:outgoing>W284_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W284_Task9" name="System tags the inventory as bonded and unavailable for standard retail sale.">
        <bpmn:documentation>Step 2: System tags the inventory as bonded and unavailable for standard retail sale.
Responsible (R): Warehouse Supervisor
Accountable (A): Logistics Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W284_Flow17</bpmn:incoming>
        <bpmn:outgoing>W284_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W284_Task10" name="When store replenishment (W4) demands the stock, a formal withdrawal request is…">
        <bpmn:documentation>Step 3: When store replenishment (W4) demands the stock, a formal withdrawal request is generated.
Responsible (R): Supply Planner
Accountable (A): Import Compliance Mgr
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W284_Flow18</bpmn:incoming>
        <bpmn:outgoing>W284_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W284_Task11" name="Finance pays the specific duties/taxes for only the withdrawn quantity (W239).">
        <bpmn:documentation>Step 4: Finance pays the specific duties/taxes for only the withdrawn quantity (W239).
Responsible (R): Finance Specialist
Accountable (A): Controller
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W284_Flow19</bpmn:incoming>
        <bpmn:outgoing>W284_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W284_Task12" name="BOC approves, and the WMS releases the stock from the CBW location to the…">
        <bpmn:documentation>Step 5: BOC approves, and the WMS releases the stock from the CBW location to the standard picking area.
Responsible (R): Import Coordinator
Accountable (A): Import Compliance Mgr
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W284_Flow20</bpmn:incoming>
        <bpmn:outgoing>W284_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W284_End13" name="Complete">
        <bpmn:incoming>W284_Flow21</bpmn:incoming>
      </bpmn:endEvent>
