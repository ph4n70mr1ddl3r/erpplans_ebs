<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-02.2-import-and-customs-operations" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W144" name="W144. International Logistics &amp; Import Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Import Purchase Order (W2B) approved and sent to overseas vendor
Frequency: Weekly; ~20–30 import shipments/month (multiple containers per shipment; ~400–600 TEUs/month)
Volume: Primary sourcing from China, Vietnam, Thailand, and Europe
Owner: Import Coordinator
Participants: Buyer, Import Coordinator, Freight Forwarder, Customs Broker, Finance, DC Receiving, Import Documentation Specialist
Source: workflow W144 — International Logistics &amp; Import Operations</bpmn:documentation>
      <bpmn:laneSet id="W144_LaneSet7">
        <bpmn:lane id="W144_Lane1" name="Buyer">
        <bpmn:flowNodeRef>W144_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W144_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W144_Lane2" name="Finance">
        <bpmn:flowNodeRef>W144_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W144_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W144_Lane3" name="Import Coordinator">
        <bpmn:flowNodeRef>W144_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W144_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W144_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W144_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W144_Lane4" name="Customs Broker">
        <bpmn:flowNodeRef>W144_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W144_Lane5" name="DC Receiving">
        <bpmn:flowNodeRef>W144_Task17</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W144_Lane6" name="System">
        <bpmn:flowNodeRef>W144_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W144_End19</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W144_Start8" name="Import Purchase Order (W2B) approved and sent to overseas vendor">
        <bpmn:outgoing>W144_Flow22</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W144_Task9" name="Proforma Invoice (PI) Review">
        <bpmn:documentation>Step 1: Proforma Invoice (PI) Review: Receive PI from vendor; verify against PO (W2B); check payment terms (L/C, T/T, CAD)
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W144_Flow22</bpmn:incoming>
        <bpmn:outgoing>W144_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W144_Task10" name="L/C Opening (if applicable)">
        <bpmn:documentation>Step 2: L/C Opening (if applicable): Finance coordinates with Bank to open Letter of Credit; sends L/C to vendor bank
Responsible (R): Finance (Treasury)
Accountable (A): CFO
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W144_Flow23</bpmn:incoming>
        <bpmn:outgoing>W144_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W144_Task11" name="Production &amp; Booking">
        <bpmn:documentation>Step 3: Production &amp; Booking: Vendor confirms production completion; Import Coordinator coordinates with Freight Forwarder for vessel booking (FCL/LCL)
Responsible (R): Import Coordinator
Accountable (A): —
Duration: 2–5 days</bpmn:documentation>
        <bpmn:incoming>W144_Flow24</bpmn:incoming>
        <bpmn:outgoing>W144_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W144_Task12" name="Shipping Documents">
        <bpmn:documentation>Step 4: Shipping Documents: Receive set of documents: Bill of Lading (B/L), Commercial Invoice, Packing List, Certificate of Origin (for FTA benefits like ATIGA/ACFTA)
Responsible (R): Import Coordinator
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W144_Flow25</bpmn:incoming>
        <bpmn:outgoing>W144_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W144_Task13" name="In-Transit Tracking">
        <bpmn:documentation>Step 5: In-Transit Tracking: Update system with vessel name, container ID, and ETA; monitor &quot;Estimated vs. Actual&quot; arrival dates
Responsible (R): Import Coordinator
Accountable (A): —
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W144_Flow26</bpmn:incoming>
        <bpmn:outgoing>W144_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W144_Task14" name="Customs Entry">
        <bpmn:documentation>Step 6: Customs Entry: Customs Broker files entry via BOC E2M system; calculates Duties &amp; Taxes (VAT + Import Duty)
Responsible (R): Customs Broker
Accountable (A): Import Coordinator
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W144_Flow27</bpmn:incoming>
        <bpmn:outgoing>W144_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W144_Task15" name="Payment of Duties">
        <bpmn:documentation>Step 7: Payment of Duties: Finance processes payment of duties/taxes to BOC via bank portal; system records as &quot;Inventory in Transit&quot; cost component
Responsible (R): Finance
Accountable (A): Controller
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W144_Flow28</bpmn:incoming>
        <bpmn:outgoing>W144_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W144_Task16" name="Release &amp; Haulage">
        <bpmn:documentation>Step 8: Release &amp; Haulage: BOC releases cargo; Forwarder coordinates haulage from Port to DC; monitor &quot;Port Out&quot; to avoid demurrage/detention fees
Responsible (R): Import Coordinator
Accountable (A): DC Manager
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W144_Flow29</bpmn:incoming>
        <bpmn:outgoing>W144_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W144_Task17" name="DC Arrival &amp; Stripping">
        <bpmn:documentation>Step 9: DC Arrival &amp; Stripping: DC receives container; verifies seal integrity; strips container and performs &quot;Blind Count&quot; against Packing List
Responsible (R): DC Receiving
Accountable (A): DC Manager
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W144_Flow30</bpmn:incoming>
        <bpmn:outgoing>W144_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W144_Task18" name="Cost Finalization">
        <bpmn:documentation>Step 10: Cost Finalization: System aggregates all landed costs (Product + Freight + Duties + Brokerage + Wharfage) to calculate final Landed WAC
Responsible (R): System / Finance
Accountable (A): Cost Accountant
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W144_Flow31</bpmn:incoming>
        <bpmn:outgoing>W144_Flow32</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W144_End19" name="Complete">
        <bpmn:incoming>W144_Flow32</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W144_Annotation20">
        <bpmn:text>Controls: - CTL-244 (ensure controlled execution — Import &amp; Customs Operations (PA-02.2).) | - operational: processing times vary widely
Owner: Import Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W144_Assoc21" sourceRef="W144_Annotation20" targetRef="W144_Start8" associationDirection="None" />
      <bpmn:sequenceFlow id="W144_Flow22" sourceRef="W144_Start8" targetRef="W144_Task9" />
      <bpmn:sequenceFlow id="W144_Flow23" sourceRef="W144_Task9" targetRef="W144_Task10" />
      <bpmn:sequenceFlow id="W144_Flow24" sourceRef="W144_Task10" targetRef="W144_Task11" />
      <bpmn:sequenceFlow id="W144_Flow25" sourceRef="W144_Task11" targetRef="W144_Task12" />
      <bpmn:sequenceFlow id="W144_Flow26" sourceRef="W144_Task12" targetRef="W144_Task13" />
      <bpmn:sequenceFlow id="W144_Flow27" sourceRef="W144_Task13" targetRef="W144_Task14" />
      <bpmn:sequenceFlow id="W144_Flow28" sourceRef="W144_Task14" targetRef="W144_Task15" />
      <bpmn:sequenceFlow id="W144_Flow29" sourceRef="W144_Task15" targetRef="W144_Task16" />
      <bpmn:sequenceFlow id="W144_Flow30" sourceRef="W144_Task16" targetRef="W144_Task17" />
      <bpmn:sequenceFlow id="W144_Flow31" sourceRef="W144_Task17" targetRef="W144_Task18" />
      <bpmn:sequenceFlow id="W144_Flow32" sourceRef="W144_Task18" targetRef="W144_End19" />
    </bpmn:process>
