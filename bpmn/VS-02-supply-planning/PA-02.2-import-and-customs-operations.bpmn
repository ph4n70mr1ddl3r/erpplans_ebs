    <bpmn:process id="W_W249" name="W249. Import Port Demurrage &amp; Detention Management" isExecutable="false">
      <bpmn:documentation>Trigger: Import container vessel arrival at Philippine port (Manila/Cebu/Davao) (W144)
Frequency: Ongoing per import shipment (~20–30 shipments/month)
Volume: Covers ~400–600 TEUs/month
Owner: Logistics Manager
Participants: Import Coordinator, Customs Broker, Finance Specialist, Shipping Line
Source: workflow W249 — Import Port Demurrage &amp; Detention Management</bpmn:documentation>
      <bpmn:laneSet id="W249_LaneSet5">
        <bpmn:lane id="W249_Lane1" name="System">
        <bpmn:flowNodeRef>W249_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W249_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W249_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W249_Lane2" name="Import Coordinator">
        <bpmn:flowNodeRef>W249_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W249_Lane3" name="Hauler">
        <bpmn:flowNodeRef>W249_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W249_Lane4" name="Finance Specialist">
        <bpmn:flowNodeRef>W249_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W249_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W249_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W249_Start6" name="Import container vessel arrival at Philippine port (Manila/Cebu/Davao) (W144)">
        <bpmn:outgoing>W249_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W249_Task7" name="Vessel Arrival">
        <bpmn:documentation>Step 1: Vessel Arrival: System pulls actual arrival time from Port Authority API; calculates free-time expiration date (standard: 5 days demurrage, 3 days detention).
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W249_Flow16</bpmn:incoming>
        <bpmn:outgoing>W249_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W249_Task8" name="Clearance Tracking">
        <bpmn:documentation>Step 2: Clearance Tracking: Import Coordinator monitors customs brokerage clearance progress (W239). If delayed (&gt; 3 days), triggers warning.
Responsible (R): Import Coordinator
Accountable (A): Logistics Mgr
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W249_Flow17</bpmn:incoming>
        <bpmn:outgoing>W249_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W249_Task9" name="Demurrage Alert">
        <bpmn:documentation>Step 3: Demurrage Alert: System auto-calculates potential demurrage fees if containers are not gate-outed before free-time expiry; alerts Logistics Manager to prioritize pickup.
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W249_Flow18</bpmn:incoming>
        <bpmn:outgoing>W249_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W249_Task10" name="Gate-Out &amp; Return">
        <bpmn:documentation>Step 4: Gate-Out &amp; Return: Containers are hauled to DC (W3). Hauler returns empty container to designated port yard within shipping line&#x27;s free-time window.
Responsible (R): Hauler / DC Clerk
Accountable (A): Logistics Mgr
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W249_Flow19</bpmn:incoming>
        <bpmn:outgoing>W249_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W249_Task11" name="Charges Auditing">
        <bpmn:documentation>Step 5: Charges Auditing: If demurrage/detention occurs: Shipping line issues invoice; Finance Specialist audits charges against system-captured arrival/gate-out/gate-in logs.
Responsible (R): Finance Specialist
Accountable (A): Controller
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W249_Flow20</bpmn:incoming>
        <bpmn:outgoing>W249_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W249_Task12" name="Dispute / Payment">
        <bpmn:documentation>Step 6: Dispute / Payment: If charges valid, approve payment to avoid port hold; if invalid, initiate dispute via shipping line portal with log evidence.
Responsible (R): Finance Specialist
Accountable (A): Logistics Mgr
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W249_Flow21</bpmn:incoming>
        <bpmn:outgoing>W249_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W249_End13" name="Complete">
        <bpmn:incoming>W249_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W249_Annotation14">
        <bpmn:text>Controls: - CTL-244 (ensure controlled execution — Import &amp; Customs Operations (PA-02.2).) | - operational: Logistics Manager review and approval gate
Owner: Logistics Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W249_Assoc15" sourceRef="W249_Annotation14" targetRef="W249_Start6" associationDirection="None" />
