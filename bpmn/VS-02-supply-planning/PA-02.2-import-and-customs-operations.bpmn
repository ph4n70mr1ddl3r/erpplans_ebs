        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W464_Start6" name="Import container arrives at port (Manila/Davao/Cebu)">
        <bpmn:outgoing>W464_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W464_Task7" name="Entry Lodgment">
        <bpmn:documentation>Step 1: Entry Lodgment: Broker submits &quot;Import Entry&quot; via BOC e2m system; calculates duties/taxes (W239)
Responsible (R): In-house Broker
Accountable (A): —
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W464_Flow16</bpmn:incoming>
        <bpmn:outgoing>W464_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W464_Task8" name="Documentary Review">
        <bpmn:documentation>Step 2: Documentary Review: BOC verifies manifest vs. packing list and commercial invoice
Responsible (R): BOC Officer
Accountable (A): —
Duration: 1-2 days</bpmn:documentation>
        <bpmn:incoming>W464_Flow17</bpmn:incoming>
        <bpmn:outgoing>W464_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W464_Task9" name="Physical Inspection">
        <bpmn:documentation>Step 3: Physical Inspection: If flagged (Red/Yellow lane), Broker attends physical inspection at the port
Responsible (R): In-house Broker
Accountable (A): Import Coordinator
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W464_Flow18</bpmn:incoming>
        <bpmn:outgoing>W464_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W464_Task10" name="Gate Pass &amp; Release">
        <bpmn:documentation>Step 4: Gate Pass &amp; Release: Upon payment of duties (W239), BOC issues &quot;Release Instruction&quot; and Port Gate Pass
Responsible (R): BOC / Broker
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W464_Flow19</bpmn:incoming>
        <bpmn:outgoing>W464_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W464_Task11" name="Drayage (Hauling)">
        <bpmn:documentation>Step 5: Drayage (Hauling): Broker coordinates with haulier to pick up container and deliver to DC
Responsible (R): In-house Broker
Accountable (A): Logistics Mgr
Duration: 4-8 hours</bpmn:documentation>
        <bpmn:incoming>W464_Flow20</bpmn:incoming>
        <bpmn:outgoing>W464_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W464_Task12" name="Empty Return">
        <bpmn:documentation>Step 6: Empty Return: Haulier returns empty container to port/yard to avoid detention fees (W249)
Responsible (R): Haulier
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W464_Flow21</bpmn:incoming>
        <bpmn:outgoing>W464_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W464_End13" name="Complete">
        <bpmn:incoming>W464_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W464_Annotation14">
        <bpmn:text>Controls: - CTL-244 (ensure controlled execution — Import &amp; Customs Operations (PA-02.2).) | - operational: Import Coordinator (Licensed Broker) review and approval gate
Owner: Import Coordinator (Licensed Broker)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W464_Assoc15" sourceRef="W464_Annotation14" targetRef="W464_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W464_Flow16" sourceRef="W464_Start6" targetRef="W464_Task7" />
      <bpmn:sequenceFlow id="W464_Flow17" sourceRef="W464_Task7" targetRef="W464_Task8" />
      <bpmn:sequenceFlow id="W464_Flow18" sourceRef="W464_Task8" targetRef="W464_Task9" />
      <bpmn:sequenceFlow id="W464_Flow19" sourceRef="W464_Task9" targetRef="W464_Task10" />
      <bpmn:sequenceFlow id="W464_Flow20" sourceRef="W464_Task10" targetRef="W464_Task11" />
      <bpmn:sequenceFlow id="W464_Flow21" sourceRef="W464_Task11" targetRef="W464_Task12" />
      <bpmn:sequenceFlow id="W464_Flow22" sourceRef="W464_Task12" targetRef="W464_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W464_diag">
      <bpmndi:BPMNPlane id="W464_plane" bpmnElement="W_W464">
        <bpmndi:BPMNShape id="W464_Lane1_di" bpmnElement="W464_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
