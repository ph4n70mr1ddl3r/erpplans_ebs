    <bpmn:process id="W_W191" name="W191. Global Supply Chain — Incoterm &amp; Marine Insurance Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Import PO creation (W2B) or Shipment Booking (W144)
Frequency: Ongoing per import shipment
Volume: ~400–600 TEUs/month
Owner: Import Coordinator
Participants: Buyer, Insurance Provider, Finance, Freight Forwarder, Import Documentation Specialist
Source: workflow W191 — Global Supply Chain — Incoterm &amp; Marine Insurance Tracking</bpmn:documentation>
      <bpmn:laneSet id="W191_LaneSet5">
        <bpmn:lane id="W191_Lane1" name="Buyer">
        <bpmn:flowNodeRef>W191_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W191_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W191_Lane2" name="Import Coordinator">
        <bpmn:flowNodeRef>W191_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W191_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W191_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W191_Lane3" name="System">
        <bpmn:flowNodeRef>W191_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W191_Lane4" name="Finance">
        <bpmn:flowNodeRef>W191_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W191_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W191_Start6" name="Import PO creation (W2B) or Shipment Booking (W144)">
        <bpmn:outgoing>W191_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W191_Task7" name="Incoterm Selection">
        <bpmn:documentation>Step 1: Incoterm Selection: Buyer selects Incoterm (EXW, FOB, CFR, CIF) during PO negotiation (W2B); system calculates risk transfer point
Responsible (R): Buyer
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W191_Flow16</bpmn:incoming>
        <bpmn:outgoing>W191_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W191_Task8" name="Insurance Booking">
        <bpmn:documentation>Step 2: Insurance Booking: If Incoterm requires BuildRight to provide insurance (EXW, FOB, CFR), Import Coordinator issues &quot;Marine Insurance Declaration&quot;
Responsible (R): Import Coordinator
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W191_Flow17</bpmn:incoming>
        <bpmn:outgoing>W191_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W191_Task9" name="Risk Monitoring">
        <bpmn:documentation>Step 3: Risk Monitoring: System tracks shipment location vs. risk transfer point (e.g., &quot;On Board&quot; for FOB); alerts if insurance coverage gap exists
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W191_Flow18</bpmn:incoming>
        <bpmn:outgoing>W191_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W191_Task10" name="Claim Initiation">
        <bpmn:documentation>Step 4: Claim Initiation: If damage/loss occurs during transit (W3.6a), Import Coordinator gathers B/L, Survey Report, and Invoice
Responsible (R): Import Coordinator
Accountable (A): —
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W191_Flow19</bpmn:incoming>
        <bpmn:outgoing>W191_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W191_Task11" name="Claim Filing">
        <bpmn:documentation>Step 5: Claim Filing: Submit claim to Marine Insurance provider; track status in ERP
Responsible (R): Import Coordinator
Accountable (A): Finance Mgr
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W191_Flow20</bpmn:incoming>
        <bpmn:outgoing>W191_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W191_Task12" name="Settlement">
        <bpmn:documentation>Step 6: Settlement: Finance records insurance recovery; offsets against inventory loss (W3.6a)
Responsible (R): Finance
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W191_Flow21</bpmn:incoming>
        <bpmn:outgoing>W191_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W191_End13" name="Complete">
        <bpmn:incoming>W191_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W191_Annotation14">
        <bpmn:text>Controls: - CTL-244 (ensure controlled execution — Import &amp; Customs Operations (PA-02.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Import Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W191_Assoc15" sourceRef="W191_Annotation14" targetRef="W191_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W191_Flow16" sourceRef="W191_Start6" targetRef="W191_Task7" />
      <bpmn:sequenceFlow id="W191_Flow17" sourceRef="W191_Task7" targetRef="W191_Task8" />
      <bpmn:sequenceFlow id="W191_Flow18" sourceRef="W191_Task8" targetRef="W191_Task9" />
      <bpmn:sequenceFlow id="W191_Flow19" sourceRef="W191_Task9" targetRef="W191_Task10" />
      <bpmn:sequenceFlow id="W191_Flow20" sourceRef="W191_Task10" targetRef="W191_Task11" />
      <bpmn:sequenceFlow id="W191_Flow21" sourceRef="W191_Task11" targetRef="W191_Task12" />
      <bpmn:sequenceFlow id="W191_Flow22" sourceRef="W191_Task12" targetRef="W191_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W191_diag">
      <bpmndi:BPMNPlane id="W191_plane" bpmnElement="W_W191">
        <bpmndi:BPMNShape id="W191_Lane1_di" bpmnElement="W191_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W191_Lane2_di" bpmnElement="W191_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W191_Lane3_di" bpmnElement="W191_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W191_Lane4_di" bpmnElement="W191_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W191_Task7_di" bpmnElement="W191_Task7"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W191_Task8_di" bpmnElement="W191_Task8"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W191_Task9_di" bpmnElement="W191_Task9"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W191_Task10_di" bpmnElement="W191_Task10"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W191_Task11_di" bpmnElement="W191_Task11"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W191_Task12_di" bpmnElement="W191_Task12"><dc:Bounds x="1450" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W191_Start6_di" bpmnElement="W191_Start6"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
