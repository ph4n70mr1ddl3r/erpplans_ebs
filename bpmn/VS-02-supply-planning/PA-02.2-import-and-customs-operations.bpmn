    <bpmn:process id="W_W284" name="W284. Customs Bonded Warehouse (CBW) Operations &amp; Duty Deferral" isExecutable="false">
      <bpmn:documentation>Trigger: Arrival of imported goods designated for the CBW to defer customs duties until final store allocation.
Frequency: Weekly
Volume: 10-20 containers per week
Owner: Logistics Manager / Import Compliance
Participants: Customs Broker, Bureau of Customs (BOC), DC Manager, Finance
Source: workflow W284 — Customs Bonded Warehouse (CBW) Operations &amp; Duty Deferral</bpmn:documentation>
      <bpmn:laneSet id="W284_LaneSet6">
        <bpmn:lane id="W284_Lane1" name="Logistics Coordinator">
        <bpmn:flowNodeRef>W284_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W284_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W284_Lane2" name="Warehouse Supervisor">
        <bpmn:flowNodeRef>W284_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W284_Lane3" name="Supply Planner">
        <bpmn:flowNodeRef>W284_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
