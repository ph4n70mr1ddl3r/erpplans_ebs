<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-02.3-supply-chain-orchestration-and-risk" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W183" name="W183. Supply Chain Network Optimization Review" isExecutable="false">
      <bpmn:documentation>Trigger: Annual strategic review; or significant change in logistics costs/fuel prices
Frequency: Annual full review; ad-hoc triggered by fuel price spikes &gt; 15%, new store cluster openings, or DC lease renewal decisions
Volume: Covers all 200 stores, 4 DCs, and ~200 delivery routes across Luzon, Visayas, and Mindanao
Owner: COO
Participants: VP Supply Chain, Logistics Manager, Finance Analyst, External Logistics Consultant
Source: workflow W183 — Supply Chain Network Optimization Review</bpmn:documentation>
      <bpmn:laneSet id="W183_LaneSet6">
        <bpmn:lane id="W183_Lane1" name="Finance Analyst">
        <bpmn:flowNodeRef>W183_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W183_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W183_Lane2" name="SC Director">
        <bpmn:flowNodeRef>W183_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W183_Lane3" name="Logistics Mgr">
        <bpmn:flowNodeRef>W183_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W183_Lane4" name="COO">
        <bpmn:flowNodeRef>W183_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W183_Lane5" name="VP Supply Chain">
        <bpmn:flowNodeRef>W183_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W183_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W183_Start7" name="Annual strategic review; or significant change in logistics costs/fuel prices">
        <bpmn:outgoing>W183_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W183_Task8" name="Data Extraction">
        <bpmn:documentation>Step 1: Data Extraction: Pull historical store sales, DC throughput, and transport costs by route
Responsible (R): Finance Analyst
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W183_Flow16</bpmn:incoming>
        <bpmn:outgoing>W183_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W183_Task9" name="Modeling">
        <bpmn:documentation>Step 2: Modeling: Use &quot;Center of Gravity&quot; and &quot;Network Optimization&quot; tools to simulate optimal DC locations vs. 200-store footprint
Responsible (R): SC Director
Accountable (A): —
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W183_Flow17</bpmn:incoming>
        <bpmn:outgoing>W183_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W183_Task10" name="Cost Analysis">
        <bpmn:documentation>Step 3: Cost Analysis: Compare current &quot;4-DC&quot; cost vs. potential &quot;6-DC&quot; or &quot;Consolidated DC&quot; scenarios; include lease exit costs (W117)
Responsible (R): Logistics Mgr
Accountable (A): CFO
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W183_Flow18</bpmn:incoming>
        <bpmn:outgoing>W183_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W183_Task11" name="Recommendation">
        <bpmn:documentation>Step 4: Recommendation: Present optimal network configuration (e.g., &quot;Open DC6 in North Luzon&quot;) to Board
Responsible (R): COO
Accountable (A): CEO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W183_Flow19</bpmn:incoming>
        <bpmn:outgoing>W183_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W183_Task12" name="Implementation Plan">
        <bpmn:documentation>Step 5: Implementation Plan: If approved, trigger W116 (Site Selection) for the new DC
Responsible (R): VP Supply Chain
Accountable (A): —
Duration: —</bpmn:documentation>
        <bpmn:incoming>W183_Flow20</bpmn:incoming>
        <bpmn:outgoing>W183_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W183_End13" name="Complete">
        <bpmn:incoming>W183_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W183_Annotation14">
        <bpmn:text>Controls: - CTL-245 (ensure controlled execution — Supply Chain Orchestration &amp; Risk (PA-02.3).) | - operational: COO review and approval gate
Owner: COO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W183_Assoc15" sourceRef="W183_Annotation14" targetRef="W183_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W183_Flow16" sourceRef="W183_Start7" targetRef="W183_Task8" />
      <bpmn:sequenceFlow id="W183_Flow17" sourceRef="W183_Task8" targetRef="W183_Task9" />
      <bpmn:sequenceFlow id="W183_Flow18" sourceRef="W183_Task9" targetRef="W183_Task10" />
      <bpmn:sequenceFlow id="W183_Flow19" sourceRef="W183_Task10" targetRef="W183_Task11" />
      <bpmn:sequenceFlow id="W183_Flow20" sourceRef="W183_Task11" targetRef="W183_Task12" />
      <bpmn:sequenceFlow id="W183_Flow21" sourceRef="W183_Task12" targetRef="W183_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W183_diag">
      <bpmndi:BPMNPlane id="W183_plane" bpmnElement="W_W183">
        <bpmndi:BPMNShape id="W183_Lane1_di" bpmnElement="W183_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W183_Lane2_di" bpmnElement="W183_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
