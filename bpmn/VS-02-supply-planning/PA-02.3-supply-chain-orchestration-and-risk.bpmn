        <bpmndi:BPMNShape id="W1031_Annotation13_di" bpmnElement="W1031_Annotation13"><dc:Bounds x="160" y="800" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1031_Flow15_di" bpmnElement="W1031_Flow15"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
