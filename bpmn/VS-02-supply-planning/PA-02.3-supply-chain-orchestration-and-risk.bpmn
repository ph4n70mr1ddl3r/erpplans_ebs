    <bpmn:process id="W_W763" name="W763. Supply Chain Vendor Diversification &amp; Alternative Sourcing Maintenance" isExecutable="false">
      <bpmn:documentation>Trigger: Annual category sourcing review; or supply disruption event (W558)
Frequency: Annual comprehensive review; quarterly updates; ad-hoc during disruptions
Volume: ~13 product categories with ~4–6 flagged critical requiring diversification plans (profile §6.2)
Owner: Procurement Manager (Strategic Sourcing)
Participants: Category Manager, Procurement Manager, Quality (W150), Logistics Manager, VP Supply Chain
Source: workflow W763 — Supply Chain Vendor Diversification &amp; Alternative Sourcing Maintenance</bpmn:documentation>
      <bpmn:laneSet id="W763_LaneSet3">
        <bpmn:lane id="W763_Lane1" name="Procurement Manager">
        <bpmn:flowNodeRef>W763_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W763_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W763_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W763_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W763_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W763_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W763_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W763_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W763_Lane2" name="System">
        <bpmn:flowNodeRef>W763_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W763_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W763_Start4" name="Annual category sourcing review; or supply disruption event (W558)">
        <bpmn:outgoing>W763_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W763_Task5" name="Category criticality assessment — Annual: Procurement Manager classifies all…">
        <bpmn:documentation>Step 1: Category criticality assessment — Annual: Procurement Manager classifies all categories by supply risk: (a) Critical — single/dual source, high revenue, long lead time, (b) Important — limited sources, moderate revenue, (c) Standard — multiple sources, short lead time
Responsible (R): Procurement Manager
Accountable (A): VP Supply Chain
Duration: 2 days/year</bpmn:documentation>
        <bpmn:incoming>W763_Flow16</bpmn:incoming>
        <bpmn:outgoing>W763_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W763_Task6" name="Concentration risk scoring — For each Critical category: system calculates…">
        <bpmn:documentation>Step 2: Concentration risk scoring — For each Critical category: system calculates vendor concentration using Herfindahl-Hirschman Index (HHI); flags categories where top vendor supplies &gt; 60% of volume
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W763_Flow17</bpmn:incoming>
        <bpmn:outgoing>W763_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W763_Task7" name="Alternative vendor identification — For high-concentration categories…">
        <bpmn:documentation>Step 3: Alternative vendor identification — For high-concentration categories: Procurement Manager identifies 2–3 alternative vendors through: (a) industry trade shows, (b) competitor intelligence (W130), (c) PH vendor directories, (d) international sourcing for import-eligible categories
Responsible (R): Procurement Manager
Accountable (A): Category Manager
Duration: 2 days/quarter</bpmn:documentation>
        <bpmn:incoming>W763_Flow18</bpmn:incoming>
        <bpmn:outgoing>W763_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W763_Task8" name="Alternative vendor qualification — Each alternative vendor undergoes…">
        <bpmn:documentation>Step 4: Alternative vendor qualification — Each alternative vendor undergoes abbreviated qualification: (a) W36 vendor onboarding (financial review, TIN verification), (b) W625 product quality testing (sample evaluation), (c) W620 site visit (factory/warehouse inspection)
Responsible (R): Procurement Manager
Accountable (A): Quality Team
Duration: Per W36/W625</bpmn:documentation>
        <bpmn:incoming>W763_Flow19</bpmn:incoming>
        <bpmn:outgoing>W763_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W763_Task9" name="Trial order execution — Place trial order with alternative vendor: 5–10% of…">
        <bpmn:documentation>Step 5: Trial order execution — Place trial order with alternative vendor: 5–10% of category volume; monitor delivery performance, quality, and cost vs. incumbent
Responsible (R): Procurement Manager
Accountable (A): Logistics Manager
Duration: Per W2</bpmn:documentation>
        <bpmn:incoming>W763_Flow20</bpmn:incoming>
        <bpmn:outgoing>W763_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W763_Task10" name="Dual-sourcing implementation — If trial successful: establish dual-sourcing…">
        <bpmn:documentation>Step 6: Dual-sourcing implementation — If trial successful: establish dual-sourcing agreement with volume split (e.g., 70/30 incumbent/alternative); system configures split allocation in W312 planning parameters
Responsible (R): Procurement Manager
Accountable (A): Category Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W763_Flow21</bpmn:incoming>
        <bpmn:outgoing>W763_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W763_Task11" name="Quarterly diversification review — Quarterly: Procurement Manager reviews…">
        <bpmn:documentation>Step 7: Quarterly diversification review — Quarterly: Procurement Manager reviews diversification status per category: concentration score, alternative vendor readiness, trial results, and recommended volume adjustments
Responsible (R): Procurement Manager
Accountable (A): VP Supply Chain
Duration: 4 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W763_Flow22</bpmn:incoming>
        <bpmn:outgoing>W763_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W763_Task12" name="Disruption activation — When supply disruption occurs (W558): Procurement…">
        <bpmn:documentation>Step 8: Disruption activation — When supply disruption occurs (W558): Procurement Manager activates alternative vendor from diversification plan; issues emergency PO (W60); system adjusts replenishment parameters to redirect volume
Responsible (R): Procurement Manager
Accountable (A): VP Supply Chain
Duration: Per W558</bpmn:documentation>
        <bpmn:incoming>W763_Flow23</bpmn:incoming>
        <bpmn:outgoing>W763_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W763_End13" name="Complete">
        <bpmn:incoming>W763_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W763_Annotation14">
        <bpmn:text>Controls: - CTL-245 (ensure controlled execution — Supply Chain Orchestration &amp; Risk (PA-02.3).) | - operational: Procurement Manager (Strategic Sourcing) review and approval gate
Owner: Procurement Manager (Strategic Sourcing)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W763_Assoc15" sourceRef="W763_Annotation14" targetRef="W763_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W763_Flow16" sourceRef="W763_Start4" targetRef="W763_Task5" />
