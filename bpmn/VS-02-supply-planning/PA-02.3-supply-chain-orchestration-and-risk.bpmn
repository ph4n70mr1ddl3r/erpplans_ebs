        <bpmndi:BPMNEdge id="W183_Flow17_di" bpmnElement="W183_Flow17"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W183_Flow18_di" bpmnElement="W183_Flow18"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W183_Flow19_di" bpmnElement="W183_Flow19"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W183_Flow20_di" bpmnElement="W183_Flow20"><di:waypoint x="1210" y="675" /><di:waypoint x="1240" y="845" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W183_Flow21_di" bpmnElement="W183_Flow21"><di:waypoint x="1420" y="845" /><di:waypoint x="1470" y="845" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W183_Assoc15_di" bpmnElement="W183_Assoc15"><di:waypoint x="340" y="970" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W250" name="W250. Supply Chain Control Tower &amp; Real-Time Shipment Visibility" isExecutable="false">
      <bpmn:documentation>Trigger: Shipment of import PO (W144 / W2B) or inter-island freight dispatch (W66)
Frequency: Ongoing per shipment
Volume: ~20–30 import shipments (multiple containers each; ~400–600 TEUs/month) and ~40–50 inter-island shipments/month
Owner: VP Supply Chain
Participants: Logistics Manager, Import Coordinator, Store Operations Rep, 3PL Partners
Source: workflow W250 — Supply Chain Control Tower &amp; Real-Time Shipment Visibility</bpmn:documentation>
      <bpmn:laneSet id="W250_LaneSet6">
        <bpmn:lane id="W250_Lane1" name="3PL Partner">
        <bpmn:flowNodeRef>W250_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W250_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W250_Lane2" name="System">
        <bpmn:flowNodeRef>W250_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W250_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W250_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W250_Lane3" name="Import Coordinator">
        <bpmn:flowNodeRef>W250_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W250_Lane4" name="VP Supply Chain">
        <bpmn:flowNodeRef>W250_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W250_Lane5" name="Logistics Manager">
        <bpmn:flowNodeRef>W250_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W250_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W250_Start7" name="Shipment of import PO (W144 / W2B) or inter-island freight dispatch (W66)">
        <bpmn:outgoing>W250_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W250_Task8" name="Shipment Dispatch">
        <bpmn:documentation>Step 1: Shipment Dispatch: 3PL partner dispatches shipment and transmits Container ID / GPS tracker link via API/EDI to BuildRight.
Responsible (R): 3PL Partner
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W250_Flow18</bpmn:incoming>
        <bpmn:outgoing>W250_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W250_Task9" name="Milestones Tracking">
        <bpmn:documentation>Step 2: Milestones Tracking: Control Tower system aggregates tracking data (vessel GPS, port gate-out/gate-in, inland truck GPS) to trace shipment in transit.
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W250_Flow19</bpmn:incoming>
        <bpmn:outgoing>W250_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W250_Task10" name="Dynamic ETA Update">
        <bpmn:documentation>Step 3: Dynamic ETA Update: System dynamically recalculates estimated time of arrival (ETA) based on weather, port speed, and transit history.
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W250_Flow20</bpmn:incoming>
        <bpmn:outgoing>W250_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W250_Task11" name="Geofence Alerts">
        <bpmn:documentation>Step 4: Geofence Alerts: System detects container entering port/DC zone; auto-alerts DC gate crew (W3) and Import Coordinator to prepare receiving.
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W250_Flow21</bpmn:incoming>
        <bpmn:outgoing>W250_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W250_Task12" name="Exception Trigger">
        <bpmn:documentation>Step 5: Exception Trigger: If a shipment is delayed &gt; 24 hours from original ETA, system triggers alert. Import Coordinator investigates bottleneck.
Responsible (R): Import Coordinator
Accountable (A): Logistics Mgr
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W250_Flow22</bpmn:incoming>
        <bpmn:outgoing>W250_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W250_Task13" name="Re-routing / Mitigation">
        <bpmn:documentation>Step 6: Re-routing / Mitigation: If critical delay threatens store stockout, VP Supply Chain authorizes inventory reallocation (W105) or alternative local sourcing (W60).
Responsible (R): VP Supply Chain
Accountable (A): VP Supply Chain
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W250_Flow23</bpmn:incoming>
        <bpmn:outgoing>W250_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W250_Task14" name="Carrier Review">
        <bpmn:documentation>Step 7: Carrier Review: Monthly, Logistics Manager reviews carrier lead-time performance and delay metrics in S&amp;OP dashboard (W133).
Responsible (R): Logistics Manager
Accountable (A): VP Supply Chain
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W250_Flow24</bpmn:incoming>
        <bpmn:outgoing>W250_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W250_End15" name="Complete">
        <bpmn:incoming>W250_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W250_Annotation16">
        <bpmn:text>Controls: - CTL-245 (ensure controlled execution — Supply Chain Orchestration &amp; Risk (PA-02.3).) | - operational: VP Supply Chain review and approval gate
Owner: VP Supply Chain</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W250_Assoc17" sourceRef="W250_Annotation16" targetRef="W250_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W250_Flow18" sourceRef="W250_Start7" targetRef="W250_Task8" />
      <bpmn:sequenceFlow id="W250_Flow19" sourceRef="W250_Task8" targetRef="W250_Task9" />
      <bpmn:sequenceFlow id="W250_Flow20" sourceRef="W250_Task9" targetRef="W250_Task10" />
      <bpmn:sequenceFlow id="W250_Flow21" sourceRef="W250_Task10" targetRef="W250_Task11" />
      <bpmn:sequenceFlow id="W250_Flow22" sourceRef="W250_Task11" targetRef="W250_Task12" />
      <bpmn:sequenceFlow id="W250_Flow23" sourceRef="W250_Task12" targetRef="W250_Task13" />
      <bpmn:sequenceFlow id="W250_Flow24" sourceRef="W250_Task13" targetRef="W250_Task14" />
      <bpmn:sequenceFlow id="W250_Flow25" sourceRef="W250_Task14" targetRef="W250_End15" />
    </bpmn:process>
