      <bpmndi:BPMNPlane id="W250_plane" bpmnElement="W_W250">
        <bpmndi:BPMNShape id="W250_Lane1_di" bpmnElement="W250_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
