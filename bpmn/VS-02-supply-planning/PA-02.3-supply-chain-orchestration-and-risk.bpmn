        <bpmndi:BPMNEdge id="W250_Flow25_di" bpmnElement="W250_Flow25"><di:waypoint x="1840" y="845" /><di:waypoint x="1890" y="845" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W250_Assoc17_di" bpmnElement="W250_Assoc17"><di:waypoint x="340" y="970" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W268" name="W268. Last-Mile Home Delivery Tracking &amp; Proof-of-Delivery" isExecutable="false">
      <bpmn:documentation>Trigger: Order dispatched from DC or Store for home delivery (W19 / W19B)
Frequency: Ongoing per delivery transaction (~573 delivery orders/day)
Volume: Covers ~17,200 deliveries/month
Owner: Last-Mile Operations Supervisor
Participants: WMS, Dispatch Crew, Driver (Fleet/3PL), Customer Service Representative, Customer
Source: workflow W268 — Last-Mile Home Delivery Tracking &amp; Proof-of-Delivery</bpmn:documentation>
      <bpmn:laneSet id="W268_LaneSet3">
        <bpmn:lane id="W268_Lane1" name="Driver">
        <bpmn:flowNodeRef>W268_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W268_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W268_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W268_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W268_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W268_Lane2" name="System">
        <bpmn:flowNodeRef>W268_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W268_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W268_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W268_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W268_Start4" name="Order dispatched from DC or Store for home delivery (W19 / W19B)">
        <bpmn:outgoing>W268_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W268_Task5" name="Driver Loading &amp; Scan">
        <bpmn:documentation>Step 1: Driver Loading &amp; Scan: Dispatch crew loads delivery vehicle; driver scans order barcodes using the last-mile mobile app, changing order status in ERP to &quot;Out for Delivery&quot;.
Responsible (R): Driver / Dispatch Crew
Accountable (A): Last-Mile Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W268_Flow15</bpmn:incoming>
        <bpmn:outgoing>W268_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W268_Task6" name="Customer Dispatch Alert">
        <bpmn:documentation>Step 2: Customer Dispatch Alert: System automatically triggers SMS/email notifications to customer with an updated ETA, contact details for the driver, and a link to the real-time tracking map.
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W268_Flow16</bpmn:incoming>
        <bpmn:outgoing>W268_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W268_Task7" name="Real-Time GPS Tracking">
        <bpmn:documentation>Step 3: Real-Time GPS Tracking: Driver&#x27;s mobile app streams GPS location to the ERP Supply Chain Control Tower (W250); system dynamically recalculates ETA based on traffic conditions.
Responsible (R): Driver / System
Accountable (A): Last-Mile Supervisor
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W268_Flow17</bpmn:incoming>
        <bpmn:outgoing>W268_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W268_Task8" name="Proximity Alert">
        <bpmn:documentation>Step 4: Proximity Alert: When the delivery vehicle enters a 2 km geofenced radius of the destination, the system sends an automated proximity SMS alert to the customer.
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W268_Flow18</bpmn:incoming>
        <bpmn:outgoing>W268_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W268_Task9" name="Delivery &amp; Site Inspection">
        <bpmn:documentation>Step 5: Delivery &amp; Site Inspection: Driver arrives at address; unloads goods (cement, tiles, fixtures); customer inspects items to verify correct SKUs and quantity.
Responsible (R): Driver / Customer
Accountable (A): Last-Mile Supervisor
Duration: 5–15 min</bpmn:documentation>
        <bpmn:incoming>W268_Flow19</bpmn:incoming>
        <bpmn:outgoing>W268_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W268_Task10" name="POD Capture">
        <bpmn:documentation>Step 6: POD Capture: Driver captures digital Proof of Delivery (POD) via mobile app: (a) customer&#x27;s electronic signature, (b) photo of items staged at the site, (c) GPS coordinate stamp confirming vehicle was at delivery location.
Responsible (R): Driver
Accountable (A): Last-Mile Supervisor
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W268_Flow20</bpmn:incoming>
        <bpmn:outgoing>W268_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W268_Task11" name="Delivery Completion">
        <bpmn:documentation>Step 7: Delivery Completion: Mobile app uploads POD data; ERP changes order status to &quot;Delivered&quot;, posts inventory reduction, generates official sales invoice to customer, and sends CSAT rating request (W65).
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W268_Flow21</bpmn:incoming>
        <bpmn:outgoing>W268_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W268_End12" name="Complete">
        <bpmn:incoming>W268_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W268_Annotation13">
        <bpmn:text>Controls: - CTL-245 (ensure controlled execution — Supply Chain Orchestration &amp; Risk (PA-02.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Last-Mile Operations Supervisor</bpmn:text>
      </bpmn:textAnnotation>
