    <bpmn:process id="W_W757" name="W757. Customer On-the-Spot Loyalty Tier Upgrade Offer Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Loyalty member checkout (W5B) where system identifies member is within threshold of next tier
Frequency: Daily; triggered by qualifying loyalty transactions
Volume: ~200–300 upgrade opportunities/day chain-wide
Owner: Cashier
Participants: Cashier, Customer
Source: workflow W757 — Customer On-the-Spot Loyalty Tier Upgrade Offer Processing</bpmn:documentation>
      <bpmn:laneSet id="W757_LaneSet3">
        <bpmn:lane id="W757_Lane1" name="System">
        <bpmn:flowNodeRef>W757_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W757_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W757_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W757_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W757_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W757_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W757_Lane2" name="Cashier">
        <bpmn:flowNodeRef>W757_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W757_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W757_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W757_Start4" name="Loyalty member checkout (W5B) where system identifies member is within threshold of next…">
        <bpmn:outgoing>W757_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W757_Task5" name="Tier proximity detection — During checkout (W5B), system calculates customer&#x27;s…">
        <bpmn:documentation>Step 1: Tier proximity detection — During checkout (W5B), system calculates customer&#x27;s rolling 12-month spend and distance to next tier threshold; if within 150% of average basket value from next tier, triggers upgrade prompt
Responsible (R): System
Accountable (A): —
Duration: Instant</bpmn:documentation>
        <bpmn:incoming>W757_Flow15</bpmn:incoming>
        <bpmn:outgoing>W757_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W757_Task6" name="POS prompt display — Customer-facing screen displays personalized upgrade…">
        <bpmn:documentation>Step 2: POS prompt display — Customer-facing screen displays personalized upgrade offer: &quot;You&#x27;re only PHP [X] away from [Tier Name]! Spend [X] today to unlock [benefit description]. Would you like to see items that can help you reach [Tier Name]?&quot;
Responsible (R): System
Accountable (A): —
Duration: Instant</bpmn:documentation>
        <bpmn:incoming>W757_Flow16</bpmn:incoming>
        <bpmn:outgoing>W757_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W757_Task7" name="Customer interest check — Cashier verbally reinforces: &quot;Just so you know…">
        <bpmn:documentation>Step 3: Customer interest check — Cashier verbally reinforces: &quot;Just so you know, you&#x27;re close to our next loyalty tier — would you like me to suggest a couple of items that could get you there today?&quot;
Responsible (R): Cashier
Accountable (A): —
Duration: 30 sec</bpmn:documentation>
        <bpmn:incoming>W757_Flow17</bpmn:incoming>
        <bpmn:outgoing>W757_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W757_Task8" name="Targeted suggestion — If customer agrees, system displays 2–3 personalized…">
        <bpmn:documentation>Step 4: Targeted suggestion — If customer agrees, system displays 2–3 personalized product suggestions based on: (a) customer&#x27;s purchase history category affinity, (b) items frequently bought together with current basket, (c) current promotional items
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W757_Flow18</bpmn:incoming>
        <bpmn:outgoing>W757_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W757_Task9" name="Upgrade transaction — If customer adds suggested items: Cashier scans items…">
        <bpmn:documentation>Step 5: Upgrade transaction — If customer adds suggested items: Cashier scans items; system calculates new projected 12-month spend; confirms tier upgrade will be achieved
Responsible (R): Cashier
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W757_Flow19</bpmn:incoming>
        <bpmn:outgoing>W757_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W757_Task10" name="Tier upgrade confirmation — If threshold met: system processes tier upgrade…">
        <bpmn:documentation>Step 6: Tier upgrade confirmation — If threshold met: system processes tier upgrade effective immediately; customer receives SMS confirmation: &quot;Congratulations! You&#x27;ve been upgraded to [Tier Name]. Your new benefits include: [list]. Enjoy!&quot;
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W757_Flow20</bpmn:incoming>
        <bpmn:outgoing>W757_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W757_Task11" name="Upgrade analytics — System tracks: upgrade offer display rate, acceptance rate…">
        <bpmn:documentation>Step 7: Upgrade analytics — System tracks: upgrade offer display rate, acceptance rate, incremental revenue per upgrade, upgrade retention rate after 12 months; feeds to W565 marketing ROI and W104 loyalty financial governance
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W757_Flow21</bpmn:incoming>
        <bpmn:outgoing>W757_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W757_End12" name="Complete">
        <bpmn:incoming>W757_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W757_Annotation13">
        <bpmn:text>Controls: - CTL-279 (ensure controlled execution — Loyalty Program Operations (PA-13.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Cashier</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W757_Assoc14" sourceRef="W757_Annotation13" targetRef="W757_Start4" associationDirection="None" />
