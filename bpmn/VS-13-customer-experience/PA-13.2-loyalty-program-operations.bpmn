    <bpmn:process id="W_W996" name="W996. Store-Level Contractor Loyalty Tier Upgrade &amp; VIP Retention Program Management" isExecutable="false">
      <bpmn:documentation>Trigger: Contractor trade account reaches tier upgrade threshold (monthly/quarterly review) or contractor at risk of churn (spend decline detection)
Frequency: ~2,000–3,000 tier evaluations/month chain-wide (~10–15/store/month); ~500 VIP retention actions/month
Volume: 1 account per evaluation/action
Owner: Store Manager
Participants: Sales Associate (Trade Desk), Category Manager, HR (if training benefit), Finance (credit per W328)
Source: workflow W996 — Store-Level Contractor Loyalty Tier Upgrade &amp; VIP Retention Program Management</bpmn:documentation>
      <bpmn:laneSet id="W996_LaneSet4">
        <bpmn:lane id="W996_Lane1" name="System">
        <bpmn:flowNodeRef>W996_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W996_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W996_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W996_Lane2" name="Sales Associate">
        <bpmn:flowNodeRef>W996_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W996_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W996_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W996_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W996_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W996_Start5" name="Contractor trade account reaches tier upgrade threshold (monthly/quarterly review) or…">
        <bpmn:outgoing>W996_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W996_Task6" name="Monthly Tier Evaluation &amp; Upgrade Detection">
        <bpmn:documentation>Step 1: Monthly Tier Evaluation &amp; Upgrade Detection: System evaluates all trade accounts monthly: (a) Bronze Tier (entry level): ≥PHP 20,000/month cumulative spend; (b) Silver Tier: ≥PHP 50,000/month cumulative spend or ≥PHP 500,000/year; (c) Gold Tier: ≥PHP 150,000/month or ≥PHP 1,500,000/year; (d) Platinum Tier: ≥PHP 300,000/month or ≥PHP 3,000,000/year; (e) system identifies accounts meeting upgrade criteria and generates upgrade list; (f) system also identifies accounts within 10% of next tier threshold (near-upgrade) for proactive outreach
Responsible (R): System
Accountable (A): Store Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W996_Flow14</bpmn:incoming>
        <bpmn:outgoing>W996_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W996_Task7" name="Tier Upgrade Notification &amp; Benefits Activation">
        <bpmn:documentation>Step 2: Tier Upgrade Notification &amp; Benefits Activation: For upgraded accounts: (a) Store Manager or Sales Associate (Trade Desk) contacts contractor to congratulate on tier upgrade; (b) benefits activated in system — Silver: 2% additional trade discount, priority delivery scheduling; Gold: 5% additional trade discount, priority delivery, dedicated Sales Associate, extended credit terms (Net 45 vs. Net 30), annual Store Manager appreciation dinner invitation; Platinum: 7% additional trade discount, all Gold benefits, 24-hour emergency delivery, quarterly business review with Category Manager, exclusive product preview events, free annual safety equipment certification for 2 employees per W51; (c) new trade discount tier automatically applied at POS via customer loyalty account per W17; (d) system generates welcome kit email with updated pricing matrix and benefit details
Responsible (R): Sales Associate / Store Manager
Accountable (A): Store Manager
Duration: 15–20 min per upgrade</bpmn:documentation>
        <bpmn:incoming>W996_Flow15</bpmn:incoming>
        <bpmn:outgoing>W996_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W996_Task8" name="Churn Risk Detection">
        <bpmn:documentation>Step 3: Churn Risk Detection: System monitors trade account spending patterns: (a) flags accounts with &gt;20% month-over-month spend decline (Yellow risk); (b) flags accounts with &gt;40% month-over-month decline or 2 consecutive months of decline (Red risk); (c) flags accounts with zero transactions for 60+ days (Dormant risk per W84); (d) system generates churn risk report and distributes to Store Manager and Sales Associate (Trade Desk) weekly
Responsible (R): System
Accountable (A): Store Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W996_Flow16</bpmn:incoming>
        <bpmn:outgoing>W996_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W996_Task9" name="Proactive Retention Action">
        <bpmn:documentation>Step 4: Proactive Retention Action: For churn risk accounts: (a) Yellow risk: Sales Associate calls contractor within 3 business days — inquires about project pipeline, offers assistance with upcoming project planning per W993, discusses any service concerns; (b) Red risk: Store Manager personally calls contractor — discusses relationship, offers temporary enhanced discount (2% additional for 3 months), offers dedicated delivery priority, invites to store for project planning session; (c) Dormant risk: Sales Associate contacts via email/SMS with account reactivation offer per W84 — limited-time discount, project planning assistance, new product catalog; (d) all retention actions logged in CRM system with outcome and follow-up date
Responsible (R): Sales Associate / Store Manager
Accountable (A): Store Manager
Duration: 15–30 min per account</bpmn:documentation>
        <bpmn:incoming>W996_Flow17</bpmn:incoming>
        <bpmn:outgoing>W996_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W996_Task10" name="Quarterly VIP Contractor Business Review">
        <bpmn:documentation>Step 5: Quarterly VIP Contractor Business Review: For Gold and Platinum accounts: (a) Store Manager and Category Manager conduct quarterly business review with contractor; (b) review: spending trends, project pipeline, product satisfaction, service feedback, competitive alternatives considered; (c) discuss: upcoming project needs, material pre-ordering, phased delivery planning per W993, new product introductions; (d) negotiate: annual volume commitment in exchange for preferred pricing per W163; (e) identify: cross-sell opportunities (categories contractor doesn&#x27;t currently purchase from BuildRight); (f) document outcomes in CRM and update account strategy
Responsible (R): Store Manager / Category Manager / Sales Associate
Accountable (A): Store Manager
Duration: 45–60 min per review</bpmn:documentation>
        <bpmn:incoming>W996_Flow18</bpmn:incoming>
        <bpmn:outgoing>W996_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W996_End11" name="Complete">
        <bpmn:incoming>W996_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W996_Annotation12">
        <bpmn:text>Controls: - CTL-279 (ensure controlled execution — Loyalty Program Operations (PA-13.2).) | - operational: Store Manager review and approval gate
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W996_Assoc13" sourceRef="W996_Annotation12" targetRef="W996_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W996_Flow14" sourceRef="W996_Start5" targetRef="W996_Task6" />
