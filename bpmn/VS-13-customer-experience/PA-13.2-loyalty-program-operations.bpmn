        <bpmndi:BPMNShape id="W822_Task11_di" bpmnElement="W822_Task11"><dc:Bounds x="1660" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W822_Task12_di" bpmnElement="W822_Task12"><dc:Bounds x="1870" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W822_Start4_di" bpmnElement="W822_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
