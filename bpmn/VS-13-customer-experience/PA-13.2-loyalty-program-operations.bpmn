      <bpmn:sequenceFlow id="W674_Flow25" sourceRef="W674_Task13" targetRef="W674_Task14" />
      <bpmn:sequenceFlow id="W674_Flow26" sourceRef="W674_Task14" targetRef="W674_Task15" />
      <bpmn:sequenceFlow id="W674_Flow27" sourceRef="W674_Task15" targetRef="W674_Task16" />
      <bpmn:sequenceFlow id="W674_Flow28" sourceRef="W674_Task16" targetRef="W674_End17" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W674_diag">
      <bpmndi:BPMNPlane id="W674_plane" bpmnElement="W_W674">
        <bpmndi:BPMNShape id="W674_Lane1_di" bpmnElement="W674_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2000" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W674_Lane2_di" bpmnElement="W674_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="2000" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W674_Lane3_di" bpmnElement="W674_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="2000" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W674_Lane4_di" bpmnElement="W674_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="2000" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W674_Lane5_di" bpmnElement="W674_Lane5" isHorizontal="true"><dc:Bounds x="160" y="760" width="2000" height="170" /></bpmndi:BPMNShape>
