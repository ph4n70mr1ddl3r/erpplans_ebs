    </bpmn:process>
    <bpmndi:BPMNDiagram id="W757_diag">
      <bpmndi:BPMNPlane id="W757_plane" bpmnElement="W_W757">
        <bpmndi:BPMNShape id="W757_Lane1_di" bpmnElement="W757_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W757_Lane2_di" bpmnElement="W757_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W757_Task5_di" bpmnElement="W757_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W757_Task6_di" bpmnElement="W757_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
