    <bpmn:process id="W_W1039" name="W1039. Customer Housewarming &amp; New Home Gift Registry Service" isExecutable="false">
      <bpmn:documentation>Trigger: Customer creates a gift registry for housewarming, new home, or home renovation milestone
Frequency: ~500–800 new registries/month; peaks during summer (Mar–May, peak construction completion) and post-holiday (Jan–Feb)
Volume: 1 registry per customer; average 15–30 items per registry
Owner: Customer Service Manager
Participants: Customer (Registrant), Gift Givers, Sales Associates, Ecommerce Content Specialist, Marketing Coordinator
Source: workflow W1039 — Customer Housewarming &amp; New Home Gift Registry Service</bpmn:documentation>
      <bpmn:laneSet id="W1039_LaneSet4">
        <bpmn:lane id="W1039_Lane1" name="Customer">
        <bpmn:flowNodeRef>W1039_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1039_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1039_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1039_Lane2" name="Gift Giver">
        <bpmn:flowNodeRef>W1039_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1039_Lane3" name="System">
        <bpmn:flowNodeRef>W1039_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1039_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1039_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1039_Start5" name="Customer creates a gift registry for housewarming, new home, or home renovation milestone">
        <bpmn:outgoing>W1039_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1039_Task6" name="Registry Creation">
        <bpmn:documentation>Step 1: Registry Creation: Customer creates registry via: (a) BuildRight mobile app: dedicated &quot;New Home Registry&quot; feature with guided setup; (b) buildright.com.ph website; (c) in-store at customer service counter with assistance from Customer Service Rep; (d) registry setup includes: (i) registrant name(s) and contact details, (ii) event type (housewarming, new condo, renovated home, wedding + new home), (iii) event date, (iv) personal message to gift givers, (v) preferred fulfillment store for physical gifts; (e) system creates unique registry URL and QR code for sharing
Responsible (R): Customer / Customer Service Rep
Accountable (A): Customer Service Manager
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W1039_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1039_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1039_Task7" name="Item Selection &amp; Registry Curation">
        <bpmn:documentation>Step 2: Item Selection &amp; Registry Curation: Customer adds items to registry: (a) browse BuildRight catalog (35,000 SKUs) via app/website and add to registry; (b) in-store: Customer Service Rep or Sales Associate assists with item selection using tablet — scans shelf barcodes to add items; (c) system provides smart recommendations based on event type: &quot;Popular items for new homeowners: power drill set (PHP 3,500), bathroom accessories set (PHP 2,800), curtain rods and rings (PHP 800), paint roller kit (PHP 650)&quot;; (d) customer can specify desired quantity per item; (e) customer can add &quot;fund contribution&quot; option for high-value items (e.g., &quot;Contribute toward 1.5HP aircon — PHP 25,000&quot; — multiple gift givers can contribute any amount toward the item); (f) registry displays real-time pricing and availability per item; (g) customer can prioritize items as &quot;Must Have,&quot; &quot;Nice to Have,&quot; or &quot;Surprise Me&quot;
Responsible (R): Customer / Sales Associate
Accountable (A): Customer Service Manager
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W1039_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1039_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1039_Task8" name="Registry Sharing &amp; Gift Giver Experience">
        <bpmn:documentation>Step 3: Registry Sharing &amp; Gift Giver Experience: Customer shares registry with friends and family: (a) shareable link via SMS, Viber, WhatsApp, Facebook Messenger, or email; (b) gift givers access registry via link: (i) view registrant&#x27;s name, event details, and personal message, (ii) browse selected items with images, descriptions, and prices, (iii) see which items have already been purchased (marked as &quot;Fulfilled&quot; with gift giver&#x27;s name, unless anonymous), (iv) select item(s) to purchase, (v) choose: &quot;Ship to registrant&#x27;s preferred store for pickup&quot; or &quot;Ship to registrant&#x27;s home address&quot; or &quot;Let registrant choose later (store credit)&quot;; (c) payment processed per standard ecommerce flow (W19/W11); (d) system sends registrant notification: &quot;Juan Del Cruz purchased a Bosch Drill Set from your New Home Registry! 🎁&quot;; (e) gift receipt generated (price hidden from gift recipient); (f) for &quot;fund contribution&quot; items: gift giver enters contribution amount (minimum PHP 500); multiple contributions aggregated until item value reached
Responsible (R): Gift Giver / System
Accountable (A): Customer Service Manager
Duration: 5–10 min per gift purchase</bpmn:documentation>
        <bpmn:incoming>W1039_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1039_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1039_Task9" name="Fulfillment &amp; Delivery">
        <bpmn:documentation>Step 4: Fulfillment &amp; Delivery: (a) physical items: fulfilled via BOPIS (registrant picks up at preferred store per W11) or home delivery per W19; (b) system tracks fulfillment status per item: purchased → shipped/delivered → received; (c) registrant receives consolidated &quot;gift summary&quot; after event date: list of all gifts received with gift giver names (for thank-you notes); (d) for unfulfilled items after event date + 30 days: (i) registrant offered option to purchase remaining items at 10% discount (incentivizes completing the list at BuildRight), (ii) or convert to store credit equivalent; (e) &quot;fund contribution&quot; items: once total contributions reach item value, item is automatically ordered and shipped to registrant; if event date passes without reaching funding goal, contributions converted to store credit
Responsible (R): System / Customer Service Rep
Accountable (A): Customer Service Manager
Duration: Automated (per item)</bpmn:documentation>
        <bpmn:incoming>W1039_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1039_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1039_Task10" name="Post-Event Follow-Up &amp; Marketing">
        <bpmn:documentation>Step 5: Post-Event Follow-Up &amp; Marketing: After event: (a) system sends thank-you email to registrant with gift summary and offer: &quot;Complete your new home essentials — 10% off remaining registry items for 30 days&quot;; (b) system sends thank-you email to each gift giver with suggestion: &quot;Looking for more home improvement gifts? Browse BuildRight&#x27;s gift guide&quot;; (c) marketing adds registrant to &quot;New Homeowner&quot; segment per W673 (Customer Segmentation) for targeted campaigns: home improvement tutorials, product recommendations, and seasonal promotions; (d) registry data feeds analytics: most popular registry items (informs merchandising per W1), average registry value, conversion rate (gift givers who purchase vs. who view), and repeat registry rate
Responsible (R): System / Marketing Coordinator
Accountable (A): Marketing Manager
Duration: 1–2 hours/week (marketing)</bpmn:documentation>
        <bpmn:incoming>W1039_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1039_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1039_End11" name="Complete">
        <bpmn:incoming>W1039_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1039_Annotation12">
        <bpmn:text>Controls: - CTL-279 (ensure controlled execution — Loyalty Program Operations (PA-13.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Customer Service Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1039_Assoc13" sourceRef="W1039_Annotation12" targetRef="W1039_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1039_Flow14" sourceRef="W1039_Start5" targetRef="W1039_Task6" />
      <bpmn:sequenceFlow id="W1039_Flow15" sourceRef="W1039_Task6" targetRef="W1039_Task7" />
      <bpmn:sequenceFlow id="W1039_Flow16" sourceRef="W1039_Task7" targetRef="W1039_Task8" />
      <bpmn:sequenceFlow id="W1039_Flow17" sourceRef="W1039_Task8" targetRef="W1039_Task9" />
      <bpmn:sequenceFlow id="W1039_Flow18" sourceRef="W1039_Task9" targetRef="W1039_Task10" />
      <bpmn:sequenceFlow id="W1039_Flow19" sourceRef="W1039_Task10" targetRef="W1039_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1039_diag">
      <bpmndi:BPMNPlane id="W1039_plane" bpmnElement="W_W1039">
        <bpmndi:BPMNShape id="W1039_Lane1_di" bpmnElement="W1039_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1039_Lane2_di" bpmnElement="W1039_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1039_Lane3_di" bpmnElement="W1039_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1039_Task6_di" bpmnElement="W1039_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1039_Task7_di" bpmnElement="W1039_Task7"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1039_Task8_di" bpmnElement="W1039_Task8"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1039_Task9_di" bpmnElement="W1039_Task9"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1039_Task10_di" bpmnElement="W1039_Task10"><dc:Bounds x="1240" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1039_Start5_di" bpmnElement="W1039_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1039_End11_di" bpmnElement="W1039_End11"><dc:Bounds x="1470" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1039_Annotation12_di" bpmnElement="W1039_Annotation12"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
