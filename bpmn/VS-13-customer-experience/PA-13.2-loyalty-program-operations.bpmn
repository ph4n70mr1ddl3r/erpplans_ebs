    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1186_diag">
      <bpmndi:BPMNPlane id="W1186_plane" bpmnElement="W_W1186">
        <bpmndi:BPMNShape id="W1186_Lane1_di" bpmnElement="W1186_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1186_Lane2_di" bpmnElement="W1186_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1186_Lane3_di" bpmnElement="W1186_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1186_Task6_di" bpmnElement="W1186_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1186_Task7_di" bpmnElement="W1186_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1186_Task8_di" bpmnElement="W1186_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1186_Task9_di" bpmnElement="W1186_Task9"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1186_Task10_di" bpmnElement="W1186_Task10"><dc:Bounds x="1240" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1186_Task11_di" bpmnElement="W1186_Task11"><dc:Bounds x="1450" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1186_Start5_di" bpmnElement="W1186_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
