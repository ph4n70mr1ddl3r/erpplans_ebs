        <bpmndi:BPMNEdge id="W822_Flow18_di" bpmnElement="W822_Flow18"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W822_Flow19_di" bpmnElement="W822_Flow19"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W822_Flow20_di" bpmnElement="W822_Flow20"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W822_Flow21_di" bpmnElement="W822_Flow21"><di:waypoint x="1420" y="165" /><di:waypoint x="1450" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W822_Flow22_di" bpmnElement="W822_Flow22"><di:waypoint x="1630" y="335" /><di:waypoint x="1660" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W822_Flow23_di" bpmnElement="W822_Flow23"><di:waypoint x="1840" y="335" /><di:waypoint x="1870" y="335" /></bpmndi:BPMNEdge>
