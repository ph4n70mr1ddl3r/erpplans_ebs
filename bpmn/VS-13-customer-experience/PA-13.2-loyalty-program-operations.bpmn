    <bpmn:process id="W_W674" name="W674. Customer Loyalty Program Partner Management" isExecutable="false">
      <bpmn:documentation>Trigger: Partner onboarding request; quarterly partner review cycle; partner agreement renewal
Frequency: Ad-hoc onboarding; quarterly partner performance review; annual contract renewal
Volume: ~15–20 active partners (banks, airlines, utility companies, home builders, insurance; one count with W1434 — W1186&#x27;s 3–5 refers to simultaneously featured offers)
Owner: Loyalty Program Manager
Participants: Marketing Manager, Finance Analyst, Legal Counsel, Partner Account Manager
Source: workflow W674 — Customer Loyalty Program Partner Management</bpmn:documentation>
      <bpmn:laneSet id="W674_LaneSet7">
        <bpmn:lane id="W674_Lane1" name="Loyalty Program Manager">
        <bpmn:flowNodeRef>W674_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W674_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W674_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W674_Lane2" name="Loyalty Program Manager, Legal Counsel">
        <bpmn:flowNodeRef>W674_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W674_Lane3" name="Finance Analyst">
        <bpmn:flowNodeRef>W674_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W674_Lane4" name="IT Data Engineer">
        <bpmn:flowNodeRef>W674_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W674_Lane5" name="Loyalty Program Manager, Partner Account Manager">
        <bpmn:flowNodeRef>W674_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W674_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W674_Lane6" name="System">
        <bpmn:flowNodeRef>W674_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W674_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W674_Start8" name="Partner onboarding request; quarterly partner review cycle; partner agreement renewal">
        <bpmn:outgoing>W674_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W674_Task9" name="Loyalty Program Manager identifies potential partnership opportunity: bank…">
        <bpmn:documentation>Step 1: Loyalty Program Manager identifies potential partnership opportunity: bank co-branded credit card, airline miles conversion, utility bill payment rewards, home builder referral program, insurance bundling; evaluates partner fit (brand alignment, customer overlap, incremental value)
Responsible (R): Loyalty Program Manager
Accountable (A): Loyalty Program Manager
Duration: 1-2 days</bpmn:documentation>
        <bpmn:incoming>W674_Flow20</bpmn:incoming>
        <bpmn:outgoing>W674_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W674_Task10" name="Loyalty Program Manager and Legal Counsel negotiate partnership terms: points…">
        <bpmn:documentation>Step 2: Loyalty Program Manager and Legal Counsel negotiate partnership terms: points earn/redemption rates, revenue sharing model, marketing obligations, data sharing scope (RA 10173 compliance), performance targets, contract duration (typically 1-2 years)
Responsible (R): Loyalty Program Manager, Legal Counsel
Accountable (A): Loyalty Program Manager
Duration: 1-2 weeks</bpmn:documentation>
        <bpmn:incoming>W674_Flow21</bpmn:incoming>
        <bpmn:outgoing>W674_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W674_Task11" name="Finance Analyst models partnership financial impact: incremental points…">
        <bpmn:documentation>Step 3: Finance Analyst models partnership financial impact: incremental points liability per PFRS 15, projected partner-driven enrollment, cost of partnership vs. incremental revenue, breakage assumptions
Responsible (R): Finance Analyst
Accountable (A): Loyalty Program Manager
Duration: 2-3 days</bpmn:documentation>
        <bpmn:incoming>W674_Flow22</bpmn:incoming>
        <bpmn:outgoing>W674_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W674_Task12" name="IT team configures partner integration in loyalty engine: points earning…">
        <bpmn:documentation>Step 4: IT team configures partner integration in loyalty engine: points earning triggers, real-time points conversion API, partner portal access, reconciliation file exchange
Responsible (R): IT Data Engineer
Accountable (A): CDP Administrator
Duration: 1-2 weeks</bpmn:documentation>
        <bpmn:incoming>W674_Flow23</bpmn:incoming>
        <bpmn:outgoing>W674_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W674_Task13" name="Loyalty Program Manager and Partner Account Manager co-develop launch plan…">
        <bpmn:documentation>Step 5: Loyalty Program Manager and Partner Account Manager co-develop launch plan: joint marketing campaign per W83, in-store signage, app notification, staff training on partner offer
Responsible (R): Loyalty Program Manager, Partner Account Manager
Accountable (A): Marketing Manager
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W674_Flow24</bpmn:incoming>
        <bpmn:outgoing>W674_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W674_Task14" name="Monthly: system generates partner performance report: partner-driven…">
        <bpmn:documentation>Step 6: Monthly: system generates partner performance report: partner-driven enrollments, points earned/redeemed via partner, partner-attributed revenue, customer complaint rate related to partner
Responsible (R): System
Accountable (A): Loyalty Program Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W674_Flow25</bpmn:incoming>
        <bpmn:outgoing>W674_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W674_Task15" name="Quarterly: Loyalty Program Manager conducts partner performance review with…">
        <bpmn:documentation>Step 7: Quarterly: Loyalty Program Manager conducts partner performance review with Partner Account Manager: reviews KPIs vs. targets, discusses customer feedback, adjusts earn/burn rates if needed
Responsible (R): Loyalty Program Manager, Partner Account Manager
Accountable (A): Loyalty Program Manager
Duration: 2-3 hours</bpmn:documentation>
        <bpmn:incoming>W674_Flow26</bpmn:incoming>
        <bpmn:outgoing>W674_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W674_Task16" name="Annual: Loyalty Program Manager evaluates partnership ROI and recommends…">
        <bpmn:documentation>Step 8: Annual: Loyalty Program Manager evaluates partnership ROI and recommends renewal, renegotiation, or termination; coordinates with Finance for PFRS 15 deferred revenue adjustment per W487
Responsible (R): Loyalty Program Manager
Accountable (A): Marketing Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W674_Flow27</bpmn:incoming>
        <bpmn:outgoing>W674_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W674_End17" name="Complete">
        <bpmn:incoming>W674_Flow28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W674_Annotation18">
        <bpmn:text>Controls: - CTL-279 (ensure controlled execution — Loyalty Program Operations (PA-13.2).) | - operational: Loyalty Program Manager review and approval gate; operational: periodic reconciliation against source documents
Owner: Loyalty Program Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W674_Assoc19" sourceRef="W674_Annotation18" targetRef="W674_Start8" associationDirection="None" />
      <bpmn:sequenceFlow id="W674_Flow20" sourceRef="W674_Start8" targetRef="W674_Task9" />
