      <bpmn:sequenceFlow id="W936_Flow37" sourceRef="W936_Task19" targetRef="W936_Task20" />
      <bpmn:sequenceFlow id="W936_Flow38" sourceRef="W936_Task20" targetRef="W936_Task21" />
      <bpmn:sequenceFlow id="W936_Flow39" sourceRef="W936_Task21" targetRef="W936_End22" />
    </bpmn:process>
