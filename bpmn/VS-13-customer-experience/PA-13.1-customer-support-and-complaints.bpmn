      <bpmn:startEvent id="W507_Start5" name="Monthly complaint pattern analysis run; or systemic issue threshold breached (same root…">
        <bpmn:outgoing>W507_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W507_Task6" name="System runs monthly complaint pattern analysis: auto-categorizes resolved…">
        <bpmn:documentation>Step 1: System runs monthly complaint pattern analysis: auto-categorizes resolved complaints (W41) by root cause (product quality, pricing error, stock availability, delivery delay, staff behavior, return policy, store environment, ecommerce UX); generates Pareto chart by category, store, SKU, and vendor
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W507_Flow18</bpmn:incoming>
        <bpmn:outgoing>W507_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W507_Task7" name="Customer Experience Manager reviews monthly complaint analytics dashboard: top…">
        <bpmn:documentation>Step 2: Customer Experience Manager reviews monthly complaint analytics dashboard: top 5 complaint categories by volume, top 10 stores by complaint rate, top 20 SKUs by complaint frequency, vendor-attributed complaints
Responsible (R): CX Manager
Accountable (A): VP Marketing
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W507_Flow19</bpmn:incoming>
        <bpmn:outgoing>W507_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W507_Task8" name="System identifies systemic issues: same root cause exceeds threshold (&gt;5…">
        <bpmn:documentation>Step 3: System identifies systemic issues: same root cause exceeds threshold (&gt;5 complaints same SKU in 30 days, &gt;10 complaints same store in 30 days, &gt;3 complaints same vendor in 30 days); auto-generates systemic issue ticket
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W507_Flow20</bpmn:incoming>
        <bpmn:outgoing>W507_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W507_Task9" name="CX Manager assigns systemic issue ticket to responsible department: product…">
        <bpmn:documentation>Step 4: CX Manager assigns systemic issue ticket to responsible department: product quality → Category Manager + Vendor Manager (W110); pricing error → Merchandising (W40); stock availability → Supply Chain (W4); staff behavior → Store Operations (W67); ecommerce UX → Digital Commerce team
Responsible (R): CX Manager
Accountable (A): VP Marketing
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W507_Flow21</bpmn:incoming>
        <bpmn:outgoing>W507_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W507_Task10" name="Assigned department investigates root cause using complaint data, transaction…">
        <bpmn:documentation>Step 5: Assigned department investigates root cause using complaint data, transaction records, and supporting evidence; documents root cause and proposed corrective action in systemic issue ticket
Responsible (R): Assigned Department
Accountable (A): CX Manager
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W507_Flow22</bpmn:incoming>
        <bpmn:outgoing>W507_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W507_Task11" name="CX Manager reviews proposed corrective action; approves or requests revision…">
        <bpmn:documentation>Step 6: CX Manager reviews proposed corrective action; approves or requests revision; sets implementation deadline and effectiveness measurement criteria
Responsible (R): CX Manager
Accountable (A): VP Marketing
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W507_Flow23</bpmn:incoming>
        <bpmn:outgoing>W507_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W507_Task12" name="Assigned department implements corrective action; updates ticket with…">
        <bpmn:documentation>Step 7: Assigned department implements corrective action; updates ticket with implementation evidence
Responsible (R): Assigned Department
Accountable (A): CX Manager
Duration: Variable</bpmn:documentation>
        <bpmn:incoming>W507_Flow24</bpmn:incoming>
        <bpmn:outgoing>W507_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W507_Task13" name="System monitors complaint rate for affected SKU/store/vendor for 60 days…">
        <bpmn:documentation>Step 8: System monitors complaint rate for affected SKU/store/vendor for 60 days post-implementation; auto-closes ticket if complaint rate drops below threshold; re-escalates if not improved
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W507_Flow25</bpmn:incoming>
        <bpmn:outgoing>W507_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W507_Task14" name="Quarterly: CX Manager presents complaint-to-improvement conversion report to…">
        <bpmn:documentation>Step 9: Quarterly: CX Manager presents complaint-to-improvement conversion report to management: issues identified, corrective actions implemented, effectiveness rates, remaining open issues
Responsible (R): CX Manager
Accountable (A): VP Marketing
Duration: 4 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W507_Flow26</bpmn:incoming>
        <bpmn:outgoing>W507_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W507_End15" name="Complete">
        <bpmn:incoming>W507_Flow27</bpmn:incoming>
      </bpmn:endEvent>
