      <bpmndi:BPMNPlane id="W660_plane" bpmnElement="W_W660">
        <bpmndi:BPMNShape id="W660_Lane1_di" bpmnElement="W660_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
