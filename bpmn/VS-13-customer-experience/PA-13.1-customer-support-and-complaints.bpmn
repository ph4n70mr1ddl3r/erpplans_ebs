    <bpmn:process id="W_W1363" name="W1363. Trade Professional VIP Priority Support Hotline &amp; Dedicated Account Manager Escalation" isExecutable="false">
      <bpmn:documentation>Trigger: Trade professional (Silver/Gold/Platinum tier loyalty member) calls VIP hotline or submits priority support request
Frequency: ~50–80 VIP support requests/day across all trade tiers
Volume: ~5,200 trade account customers; Gold/Platinum tiers (~1,200 accounts) eligible for VIP hotline; Silver (~1,800) eligible for priority queue
Owner: Trade Account Manager
Participants: Trade Account Manager, Dedicated Call Center Agent (VIP line), Store Manager, Category Manager, Finance (credit-related issues)
Source: workflow W1363 — Trade Professional VIP Priority Support Hotline &amp; Dedicated Account Manager Escalation</bpmn:documentation>
      <bpmn:laneSet id="W1363_LaneSet4">
        <bpmn:lane id="W1363_Lane1" name="System">
        <bpmn:flowNodeRef>W1363_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1363_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1363_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1363_Lane2" name="VIP Call Center Agent">
        <bpmn:flowNodeRef>W1363_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1363_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1363_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1363_Lane3" name="Trade Account Manager">
        <bpmn:flowNodeRef>W1363_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1363_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1363_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1363_Start5" name="Trade professional (Silver/Gold/Platinum tier loyalty member) calls VIP hotline or…">
        <bpmn:outgoing>W1363_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1363_Task6" name="Trade professional calls dedicated VIP hotline number (separate from general…">
        <bpmn:documentation>Step 1: Trade professional calls dedicated VIP hotline number (separate from general customer service) or selects &quot;Priority Support&quot; in mobile app; system identifies caller by registered phone number and retrieves account profile
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1363_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1363_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1363_Task7" name="Dedicated VIP call center agent answers within 3 rings / 30 seconds; greets by…">
        <bpmn:documentation>Step 2: Dedicated VIP call center agent answers within 3 rings / 30 seconds; greets by name; sees account summary: tier, credit limit, open orders, recent invoices, any active disputes
Responsible (R): VIP Call Center Agent
Accountable (A): Trade Account Manager
Duration: Immediate</bpmn:documentation>
        <bpmn:incoming>W1363_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1363_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1363_Task8" name="Agent resolves standard requests directly: stock check at specific stores…">
        <bpmn:documentation>Step 3: Agent resolves standard requests directly: stock check at specific stores, order status update, invoice copy request, delivery rescheduling, loyalty points inquiry
Responsible (R): VIP Call Center Agent
Accountable (A): —
Duration: 5–10 min/call</bpmn:documentation>
        <bpmn:incoming>W1363_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1363_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1363_Task9" name="For complex requests (credit limit increase, project pricing negotiation…">
        <bpmn:documentation>Step 4: For complex requests (credit limit increase, project pricing negotiation, invoice dispute &gt; PHP 10K, material specification technical question): agent warm-transfers to assigned Trade Account Manager
Responsible (R): VIP Call Center Agent / Trade Account Manager
Accountable (A): —
Duration: 2 min transfer</bpmn:documentation>
        <bpmn:incoming>W1363_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1363_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1363_Task10" name="Trade Account Manager handles complex request: authorizes credit limit increase…">
        <bpmn:documentation>Step 5: Trade Account Manager handles complex request: authorizes credit limit increase (per approval matrix), negotiates project pricing, resolves invoice dispute, or coordinates with Category Manager for technical specification support
Responsible (R): Trade Account Manager
Accountable (A): VP Store Operations
Duration: 10–30 min/case</bpmn:documentation>
        <bpmn:incoming>W1363_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1363_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1363_Task11" name="All VIP interactions logged in CRM with resolution, follow-up actions, and…">
        <bpmn:documentation>Step 6: All VIP interactions logged in CRM with resolution, follow-up actions, and satisfaction rating; unresolved cases auto-escalate to VP Store Operations if SLA &gt; 4 hours
Responsible (R): System
Accountable (A): Trade Account Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1363_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1363_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1363_Task12" name="Monthly: Trade Account Manager reviews VIP support analytics — call volume…">
        <bpmn:documentation>Step 7: Monthly: Trade Account Manager reviews VIP support analytics — call volume, resolution rate, average handle time, escalation rate, and customer satisfaction — for continuous improvement
Responsible (R): Trade Account Manager
Accountable (A): VP Store Operations
Duration: 2–3 hours/month</bpmn:documentation>
        <bpmn:incoming>W1363_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1363_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1363_End13" name="Complete">
        <bpmn:incoming>W1363_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1363_Annotation14">
        <bpmn:text>Controls: - CTL-278 (ensure controlled execution — Customer Support &amp; Complaints (PA-13.1).) | - operational: Trade Account Manager review and approval gate
Owner: Trade Account Manager</bpmn:text>
      </bpmn:textAnnotation>
