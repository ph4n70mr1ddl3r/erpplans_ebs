    <bpmn:process id="W_W259" name="W259. Call Center Daily Operations &amp; Queue Management" isExecutable="false">
      <bpmn:documentation>Trigger: Shift start (daily)
Frequency: Daily (2 shifts, 7 AM–10 PM)
Volume: ~400–600 inbound contacts/day (calls 60%, chat 25%, email 10%, social 5%)
Owner: CS Manager
Participants: CS Agent (~30), CS Supervisor (3), CS Manager (1)
Source: workflow W259 — Call Center Daily Operations &amp; Queue Management</bpmn:documentation>
      <bpmn:laneSet id="W259_LaneSet4">
        <bpmn:lane id="W259_Lane1" name="CS Agent">
        <bpmn:flowNodeRef>W259_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W259_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W259_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W259_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W259_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W259_Lane2" name="System">
        <bpmn:flowNodeRef>W259_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W259_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W259_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W259_Lane3" name="CS Supervisor">
        <bpmn:flowNodeRef>W259_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W259_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W259_Start5" name="Shift start (daily)">
        <bpmn:outgoing>W259_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W259_Task6" name="Shift Start">
        <bpmn:documentation>Step 1: Shift Start: CS Agents log into unified communications platform (telephony, chat, email, social queue); system loads agent profile with skill-based routing assignments; CS Supervisor reviews overnight queue backlog and distributes priority tickets
Responsible (R): CS Agent / CS Supervisor
Accountable (A): CS Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W259_Flow17</bpmn:incoming>
        <bpmn:outgoing>W259_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W259_Task7" name="Queue Management">
        <bpmn:documentation>Step 2: Queue Management: System routes inbound contacts based on: (a) customer tier (Platinum/Gold → priority queue; Silver/Bronze → standard), (b) issue type (order status → general; complaint → senior agent; credit/billing → finance-trained agent), (c) language preference (English, Filipino, Visayan/Bisaya for Mindanao/Visayas customers), (d) agent availability and skill set
Responsible (R): System
Accountable (A): CS Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W259_Flow18</bpmn:incoming>
        <bpmn:outgoing>W259_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W259_Task8" name="IVR Self-Service">
        <bpmn:documentation>Step 3: IVR Self-Service: For calls, IVR handles routine inquiries without agent: (a) order status (system reads tracking via ECOM-005), (b) store hours and locations (MDM-006), (c) loyalty points balance (CRM-001), (d) return policy information; estimated 25–30% of calls resolved by IVR
Responsible (R): System
Accountable (A): CS Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W259_Flow19</bpmn:incoming>
        <bpmn:outgoing>W259_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W259_Task9" name="Live Interaction">
        <bpmn:documentation>Step 4: Live Interaction: Agent handles customer inquiry using unified workspace: (a) customer 360 view (W156) with purchase history, loyalty tier, open orders, recent tickets, account alerts; (b) ERP access for real-time inventory check (ECOM-001), order status, delivery tracking; (c) Oracle Knowledge Management solutions for product info, return policies, warranty terms
Responsible (R): CS Agent
Accountable (A): CS Supervisor
Duration: 8–12 min avg</bpmn:documentation>
        <bpmn:incoming>W259_Flow20</bpmn:incoming>
        <bpmn:outgoing>W259_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W259_Task10" name="Callback Queue">
        <bpmn:documentation>Step 5: Callback Queue: During peak periods (sale events, holidays), if wait time exceeds 3 minutes, system offers callback option; callback queue managed with estimated wait time; callback scheduled within 2 hours; customer receives SMS confirmation with callback window
Responsible (R): System / CS Agent
Accountable (A): CS Manager
Duration: 2 min setup</bpmn:documentation>
        <bpmn:incoming>W259_Flow21</bpmn:incoming>
        <bpmn:outgoing>W259_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W259_Task11" name="Real-Time Monitoring">
        <bpmn:documentation>Step 6: Real-Time Monitoring: CS Supervisor monitors agent dashboard with live metrics: queue depth, average wait time, average handle time, abandonment rate, CSAT rolling average; flags agents needing assistance; rebalances queue assignments during volume spikes
Responsible (R): CS Supervisor
Accountable (A): CS Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W259_Flow22</bpmn:incoming>
        <bpmn:outgoing>W259_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W259_Task12" name="Escalation Handling">
        <bpmn:documentation>Step 7: Escalation Handling: For issues requiring other departments: (a) store-level issues → routed to Store Manager via ticket (W258), (b) billing/credit disputes → routed to AR (W108), (c) product quality/safety → routed to Quality (W110) and LP (W37), (d) data privacy → routed to DPO (W53); agent retains ownership for follow-up
Responsible (R): CS Agent
Accountable (A): CS Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W259_Flow23</bpmn:incoming>
        <bpmn:outgoing>W259_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W259_Task13" name="Shift End">
        <bpmn:documentation>Step 8: Shift End: CS Agent wraps open tickets, logs after-call work, reviews personal CSAT and handle time metrics; CS Supervisor generates end-of-shift report: total contacts handled, queue clearance rate, SLA compliance (80% of calls answered within 60 seconds, 90% of chats within 90 seconds, emails within 24 hours), top issue categories
Responsible (R): CS Agent / CS Supervisor
Accountable (A): CS Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W259_Flow24</bpmn:incoming>
        <bpmn:outgoing>W259_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W259_End14" name="Complete">
        <bpmn:incoming>W259_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W259_Annotation15">
        <bpmn:text>Controls: - CTL-278 (ensure controlled execution — Customer Support &amp; Complaints (PA-13.1).) | - operational: CS Manager review and approval gate
Owner: CS Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W259_Assoc16" sourceRef="W259_Annotation15" targetRef="W259_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W259_Flow17" sourceRef="W259_Start5" targetRef="W259_Task6" />
