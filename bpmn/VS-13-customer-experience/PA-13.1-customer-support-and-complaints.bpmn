      <bpmn:sequenceFlow id="W821_Flow20" sourceRef="W821_Task8" targetRef="W821_Task9" />
      <bpmn:sequenceFlow id="W821_Flow21" sourceRef="W821_Task9" targetRef="W821_Task10" />
      <bpmn:sequenceFlow id="W821_Flow22" sourceRef="W821_Task10" targetRef="W821_Task11" />
      <bpmn:sequenceFlow id="W821_Flow23" sourceRef="W821_Task11" targetRef="W821_Task12" />
      <bpmn:sequenceFlow id="W821_Flow24" sourceRef="W821_Task12" targetRef="W821_Task13" />
      <bpmn:sequenceFlow id="W821_Flow25" sourceRef="W821_Task13" targetRef="W821_Task14" />
      <bpmn:sequenceFlow id="W821_Flow26" sourceRef="W821_Task14" targetRef="W821_End15" />
    </bpmn:process>
