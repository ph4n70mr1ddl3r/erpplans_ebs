        <bpmndi:BPMNShape id="W781_Lane4_di" bpmnElement="W781_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W781_Task7_di" bpmnElement="W781_Task7"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
