    <bpmn:process id="W_W1364" name="W1364. Customer Product Knowledge Base &amp; DIY Self-Service Help Center Content Management" isExecutable="false">
      <bpmn:documentation>Trigger: Content review calendar (quarterly); or new product category launch; or customer support trend analysis identifying frequently asked questions not covered in existing content
Frequency: Quarterly full review; monthly content additions/updates for new products and seasonal topics
Volume: ~500–800 help articles, how-to guides, and FAQ entries across all product categories; ~20–30 new articles per quarter for new products and seasonal topics
Owner: Content Specialist (Marketing)
Participants: Content Specialist, Category Manager (technical review), Store Department Supervisors (practical review), IT (platform management), Customer Service (usage analytics)
Source: workflow W1364 — Customer Product Knowledge Base &amp; DIY Self-Service Help Center Content Management</bpmn:documentation>
      <bpmn:laneSet id="W1364_LaneSet4">
        <bpmn:lane id="W1364_Lane1" name="Content Specialist">
        <bpmn:flowNodeRef>W1364_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1364_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1364_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1364_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1364_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1364_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W1364_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1364_Lane3" name="IT">
        <bpmn:flowNodeRef>W1364_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1364_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1364_Start5" name="Content review calendar (quarterly); or new product category launch; or customer support…">
        <bpmn:outgoing>W1364_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1364_Task6" name="Content Specialist reviews content calendar and customer service FAQ analytics…">
        <bpmn:documentation>Step 1: Content Specialist reviews content calendar and customer service FAQ analytics; identifies gaps — topics with high search volume but no existing article, or articles with high bounce rates indicating poor quality
Responsible (R): Content Specialist
Accountable (A): CMO
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W1364_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1364_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1364_Task7" name="Content Specialist drafts new article or updates existing content: includes…">
        <bpmn:documentation>Step 2: Content Specialist drafts new article or updates existing content: includes step-by-step instructions, materials list (linked to BuildRight product SKUs), estimated project cost, difficulty rating, and safety warnings
Responsible (R): Content Specialist
Accountable (A): —
Duration: 2–4 hours/article</bpmn:documentation>
        <bpmn:incoming>W1364_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1364_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1364_Task8" name="Category Manager or Department Supervisor reviews draft for technical accuracy…">
        <bpmn:documentation>Step 3: Category Manager or Department Supervisor reviews draft for technical accuracy: correct product specifications, appropriate safety warnings, building code references (Philippine National Building Code, local LGU requirements)
Responsible (R): Category Manager / Dept Supervisor
Accountable (A): —
Duration: 30–60 min/article</bpmn:documentation>
        <bpmn:incoming>W1364_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1364_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1364_Task9" name="Content Specialist incorporates review feedback; adds SEO keywords, meta…">
        <bpmn:documentation>Step 4: Content Specialist incorporates review feedback; adds SEO keywords, meta descriptions, and internal links to related products and guides
Responsible (R): Content Specialist
Accountable (A): —
Duration: 30 min/article</bpmn:documentation>
        <bpmn:incoming>W1364_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1364_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1364_Task10" name="IT publishes approved content to buildright.com.ph help center and mobile app…">
        <bpmn:documentation>Step 5: IT publishes approved content to buildright.com.ph help center and mobile app; content indexed for site search and Google search
Responsible (R): IT / System
Accountable (A): Content Specialist
Duration: 15 min/article</bpmn:documentation>
        <bpmn:incoming>W1364_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1364_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1364_Task11" name="Monthly: Content Specialist analyzes help center usage metrics — top articles…">
        <bpmn:documentation>Step 6: Monthly: Content Specialist analyzes help center usage metrics — top articles, search queries with no results, average time on page, and click-through to product pages; uses insights to prioritize next month&#x27;s content plan
Responsible (R): Content Specialist
Accountable (A): CMO
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1364_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1364_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1364_End12" name="Complete">
        <bpmn:incoming>W1364_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1364_Annotation13">
        <bpmn:text>Controls: - CTL-278 (ensure controlled execution — Customer Support &amp; Complaints (PA-13.1).) | - operational: Content Specialist (Marketing) review and approval gate
Owner: Content Specialist (Marketing)</bpmn:text>
      </bpmn:textAnnotation>
