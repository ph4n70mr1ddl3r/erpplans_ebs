        <bpmndi:BPMNShape id="W1240_Task9_di" bpmnElement="W1240_Task9"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1240_Task10_di" bpmnElement="W1240_Task10"><dc:Bounds x="1450" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1240_Start4_di" bpmnElement="W1240_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1240_End11_di" bpmnElement="W1240_End11"><dc:Bounds x="1680" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1240_Annotation12_di" bpmnElement="W1240_Annotation12"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1240_Flow14_di" bpmnElement="W1240_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1240_Flow15_di" bpmnElement="W1240_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1240_Flow16_di" bpmnElement="W1240_Flow16"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1240_Flow17_di" bpmnElement="W1240_Flow17"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1240_Flow18_di" bpmnElement="W1240_Flow18"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1240_Flow19_di" bpmnElement="W1240_Flow19"><di:waypoint x="1420" y="335" /><di:waypoint x="1450" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1240_Flow20_di" bpmnElement="W1240_Flow20"><di:waypoint x="1630" y="335" /><di:waypoint x="1680" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1240_Assoc13_di" bpmnElement="W1240_Assoc13"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1290" name="W1290. Store-Level Appliance Warranty Registration &amp; After-Sales Service Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Customer purchases appliance or equipment item requiring manufacturer warranty registration
Frequency: ~2,000–3,000 appliance sales per store per year; ~400,000–600,000 chain-wide
Volume: ~1.5–3 appliance warranty claims per store per month; ~300–600 chain-wide (a subset of W33&#x27;s ~800–1,200 total claims/month)
Owner: Customer Service Rep
Participants: Customer Service Rep, Sales Associate, Department Supervisor, Vendor Service Center, Customer
Source: workflow W1290 — Store-Level Appliance Warranty Registration &amp; After-Sales Service Coordination</bpmn:documentation>
      <bpmn:laneSet id="W1290_LaneSet5">
        <bpmn:lane id="W1290_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W1290_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1290_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1290_Lane2" name="Customer Service Rep">
        <bpmn:flowNodeRef>W1290_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1290_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1290_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1290_Lane3" name="System">
        <bpmn:flowNodeRef>W1290_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1290_Lane4" name="AP Clerk">
        <bpmn:flowNodeRef>W1290_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1290_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1290_Start6" name="Customer purchases appliance or equipment item requiring manufacturer warranty…">
        <bpmn:outgoing>W1290_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1290_Task7" name="Warranty registration at POS">
        <bpmn:documentation>Step 1: Warranty registration at POS: Sales Associate registers warranty at point of sale for all appliance purchases: (a) system auto-detects appliance category items in transaction, (b) Sales Associate enters customer details (name, address, phone, email) if not auto-populated from loyalty card, (c) system generates warranty registration with: purchase date, store location, product serial number (scanned or manually entered), warranty start date, warranty terms per vendor, (d) warranty certificate printed with receipt or emailed to customer, (e) system transmits registration to manufacturer via API or batch file per vendor agreement
Responsible (R): Sales Associate / System
Accountable (A): —
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W1290_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1290_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1290_Task8" name="Customer warranty claim intake">
        <bpmn:documentation>Step 2: Customer warranty claim intake: Customer contacts BuildRight (in-store, phone, or online) with appliance issue: (a) Customer Service Rep looks up purchase by receipt number, loyalty card, or phone number, (b) system displays warranty status (active/expired, coverage details, remaining coverage period), (c) if warranty active: Customer Service Rep creates service ticket with: issue description, appliance model/serial, customer contact, preferred service date, (d) if warranty expired: advise customer on out-of-warranty service options (vendor service center contact, potential trade-in per W93)
Responsible (R): Customer Service Rep
Accountable (A): Department Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1290_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1290_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1290_Task9" name="Service dispatch coordination">
        <bpmn:documentation>Step 3: Service dispatch coordination: Customer Service Rep coordinates service with manufacturer-authorized service center: (a) system identifies authorized service center by product brand and customer location, (b) submits service request with warranty details and issue description to service center via portal or phone, (c) confirms service appointment date/time with customer, (d) for items requiring in-store drop-off: schedules service drop-off slot, (e) for in-home service (aircons, large appliances): confirms customer availability and site access per W1208
Responsible (R): Customer Service Rep
Accountable (A): Department Supervisor
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1290_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1290_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1290_Task10" name="Service resolution tracking">
        <bpmn:documentation>Step 4: Service resolution tracking: System tracks service ticket through resolution: (a) service center updates status (received → diagnosed → parts ordered → repaired → ready for pickup/completed), (b) Customer Service Rep monitors open tickets and proactively updates customer on status, (c) if repair requires &gt;7 days: Customer Service Rep escalates to Department Supervisor for customer accommodation (loaner unit, discount on future purchase, extended warranty), (d) system flags tickets open &gt;30 days for management escalation
Responsible (R): System / Customer Service Rep
Accountable (A): Department Supervisor
Duration: 5 min/ticket/day</bpmn:documentation>
        <bpmn:incoming>W1290_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1290_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1290_Task11" name="Service completion &amp; customer satisfaction">
        <bpmn:documentation>Step 5: Service completion &amp; customer satisfaction: Upon service completion: (a) Customer Service Rep confirms resolution with customer, (b) closes service ticket with resolution details, (c) system sends satisfaction survey via SMS/email, (d) if customer dissatisfied: escalate to Department Supervisor for follow-up, (e) track resolution metrics per vendor for vendor scorecard per W44
Responsible (R): Customer Service Rep
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1290_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1290_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1290_Task12" name="Vendor chargeback for warranty costs">
        <bpmn:documentation>Step 6: Vendor chargeback for warranty costs: For warranty claims where BuildRight fronts service costs: (a) AP records warranty-related expenses per vendor, (b) system accumulates warranty costs per vendor per period, (c) Category Manager negotiates warranty cost reimbursement during vendor review per W688, (d) AP processes vendor chargeback or credit per W7
Responsible (R): AP Clerk / Category Manager
Accountable (A): Controller
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W1290_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1290_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1290_End13" name="Complete">
        <bpmn:incoming>W1290_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1290_Annotation14">
        <bpmn:text>Controls: - CTL-278 (ensure controlled execution — Customer Support &amp; Complaints (PA-13.1).) | - operational: Customer Service Rep review and approval gate
Owner: Customer Service Rep</bpmn:text>
      </bpmn:textAnnotation>
