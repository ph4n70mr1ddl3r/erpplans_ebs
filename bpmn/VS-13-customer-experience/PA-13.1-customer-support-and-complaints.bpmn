    <bpmn:process id="W_W660" name="W660. Service Recovery &amp; Customer Retention Program" isExecutable="false">
      <bpmn:documentation>Trigger: Customer complaint classified as S1 or S2 per W597; loyalty tier downgrade trigger; churn prediction flag per W618; proactive service failure (BOPIS SLA miss, delivery delay, stockout of promoted item)
Frequency: ~500–800 service recovery actions/month
Volume: ~20–30 per day
Owner: CX Recovery Specialist
Participants: Store Manager (store-level recovery), Customer Service Lead (call center recovery), Loyalty Program Manager, Category Manager (product-driven recovery)
Source: workflow W660 — Service Recovery &amp; Customer Retention Program</bpmn:documentation>
      <bpmn:laneSet id="W660_LaneSet5">
        <bpmn:lane id="W660_Lane1" name="System">
        <bpmn:flowNodeRef>W660_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W660_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W660_Lane2" name="CX Recovery Specialist">
        <bpmn:flowNodeRef>W660_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W660_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W660_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W660_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W660_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W660_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W660_Lane4" name="CX Manager">
        <bpmn:flowNodeRef>W660_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W660_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W660_Start6" name="Customer complaint classified as S1 or S2 per W597; loyalty tier downgrade trigger; churn…">
        <bpmn:outgoing>W660_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W660_Task7" name="System or CX Recovery Specialist identifies service recovery candidate from…">
        <bpmn:documentation>Step 1: System or CX Recovery Specialist identifies service recovery candidate from: complaint severity S1/S2 (W597), NPS detractor survey response, loyalty tier downgrade, churn model high-risk flag (W618), or operational SLA breach (BOPIS &gt; 4 hours, delivery &gt; SLA, stockout on promoted item)
Responsible (R): System/CX Recovery Specialist
Accountable (A): CX Manager
Duration: Automated flagging + 15 min review</bpmn:documentation>
        <bpmn:incoming>W660_Flow17</bpmn:incoming>
        <bpmn:outgoing>W660_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W660_Task8" name="CX Recovery Specialist assesses customer value (CLV from CDP/W156), complaint…">
        <bpmn:documentation>Step 2: CX Recovery Specialist assesses customer value (CLV from CDP/W156), complaint severity, and recovery tier: Tier 1 (goodwill gesture ≤ PHP 500 — discount voucher, free delivery, bonus loyalty points), Tier 2 (service recovery ≤ PHP 5,000 — product replacement, full refund, premium service offer), Tier 3 (executive recovery &gt; PHP 5,000 — personal call from CX Manager, premium gift basket, exclusive experience)
Responsible (R): CX Recovery Specialist
Accountable (A): CX Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W660_Flow18</bpmn:incoming>
        <bpmn:outgoing>W660_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W660_Task9" name="CX Recovery Specialist initiates recovery action: Tier 1 — auto-generated via…">
        <bpmn:documentation>Step 3: CX Recovery Specialist initiates recovery action: Tier 1 — auto-generated via system with personalized message; Tier 2 — personalized email/call from CX Recovery Specialist with offer; Tier 3 — escalation to CX Manager for executive handling
Responsible (R): CX Recovery Specialist
Accountable (A): CX Manager
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W660_Flow19</bpmn:incoming>
        <bpmn:outgoing>W660_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W660_Task10" name="For store-level recovery: Store Manager authorized for frontline recovery…">
        <bpmn:documentation>Step 4: For store-level recovery: Store Manager authorized for frontline recovery gestures per GOV-050 guidelines (10% discount, free delivery, expedited reorder); executes recovery and logs in system
Responsible (R): Store Manager
Accountable (A): CX Recovery Specialist
Duration: During customer interaction</bpmn:documentation>
        <bpmn:incoming>W660_Flow20</bpmn:incoming>
        <bpmn:outgoing>W660_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W660_Task11" name="CX Recovery Specialist follows up within 48 hours to confirm customer…">
        <bpmn:documentation>Step 5: CX Recovery Specialist follows up within 48 hours to confirm customer satisfaction with recovery action; captures recovery outcome (satisfied, neutral, dissatisfied)
Responsible (R): CX Recovery Specialist
Accountable (A): CX Manager
Duration: 10 min/customer</bpmn:documentation>
        <bpmn:incoming>W660_Flow21</bpmn:incoming>
        <bpmn:outgoing>W660_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W660_Task12" name="Monthly: CX Recovery Specialist produces service recovery analytics: recovery…">
        <bpmn:documentation>Step 6: Monthly: CX Recovery Specialist produces service recovery analytics: recovery volume by trigger, recovery tier distribution, recovery cost, customer satisfaction rate post-recovery, recovery-to-retention conversion rate, repeat recovery rate (customers needing multiple recoveries — systemic failure indicator)
Responsible (R): CX Recovery Specialist
Accountable (A): CX Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W660_Flow22</bpmn:incoming>
        <bpmn:outgoing>W660_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W660_Task13" name="Quarterly: CX Manager reviews recovery program effectiveness with VP Marketing…">
        <bpmn:documentation>Step 7: Quarterly: CX Manager reviews recovery program effectiveness with VP Marketing and VP Store Operations; adjusts recovery tier thresholds, authorizations, and recovery gesture options based on cost-effectiveness data
Responsible (R): CX Manager
Accountable (A): VP Marketing
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W660_Flow23</bpmn:incoming>
        <bpmn:outgoing>W660_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W660_End14" name="Complete">
        <bpmn:incoming>W660_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W660_Annotation15">
        <bpmn:text>Controls: - CTL-278 (ensure controlled execution — Customer Support &amp; Complaints (PA-13.1).) | - operational: (serial complainers)
Owner: CX Recovery Specialist</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W660_Assoc16" sourceRef="W660_Annotation15" targetRef="W660_Start6" associationDirection="None" />
