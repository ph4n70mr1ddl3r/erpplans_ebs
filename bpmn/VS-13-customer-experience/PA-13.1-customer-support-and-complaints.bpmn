    <bpmn:process id="W_W617" name="W617. B2B Customer Success &amp; Quarterly Business Review Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly calendar; new B2B account onboarding; account health alert
Frequency: Quarterly QBR; monthly account health monitoring
Volume: ~5,200 trade accounts; ~200 corporate accounts; QBR focus on top 200 accounts (by revenue)
Owner: Key Account Manager
Participants: Key Account Manager, Trade Sales Manager, Category Manager, Store Manager (local), customer contact, Finance Analyst
Source: workflow W617 — B2B Customer Success &amp; Quarterly Business Review Operations</bpmn:documentation>
      <bpmn:laneSet id="W617_LaneSet5">
        <bpmn:lane id="W617_Lane1" name="System">
        <bpmn:flowNodeRef>W617_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W617_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W617_Lane2" name="Key Account Manager">
        <bpmn:flowNodeRef>W617_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W617_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W617_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W617_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W617_Lane3" name="Category Manager">
        <bpmn:flowNodeRef>W617_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W617_Lane4" name="Trade Sales Manager">
        <bpmn:flowNodeRef>W617_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W617_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W617_Start6" name="Quarterly calendar; new B2B account onboarding; account health alert">
        <bpmn:outgoing>W617_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W617_Task7" name="Monthly: system calculates account health score for all B2B accounts using…">
        <bpmn:documentation>Step 1: Monthly: system calculates account health score for all B2B accounts using composite metrics: (a) revenue trend (vs. prior quarter), (b) payment behavior (days-to-pay, bounced checks), (c) order frequency, (d) return rate, (e) complaint count, (f) credit utilization; accounts scored Green/Yellow/Red
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W617_Flow17</bpmn:incoming>
        <bpmn:outgoing>W617_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W617_Task8" name="Key Account Manager reviews Yellow/Red accounts monthly; proactively contacts…">
        <bpmn:documentation>Step 2: Key Account Manager reviews Yellow/Red accounts monthly; proactively contacts Yellow accounts for relationship check; initiates intervention for Red accounts (payment plan per W108, account review per W328, or product/service remediation)
Responsible (R): Key Account Manager
Accountable (A): Trade Sales Manager
Duration: 15 min/account</bpmn:documentation>
        <bpmn:incoming>W617_Flow18</bpmn:incoming>
        <bpmn:outgoing>W617_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W617_Task9" name="Quarterly QBR preparation: Key Account Manager compiles QBR package for top 200…">
        <bpmn:documentation>Step 3: Quarterly QBR preparation: Key Account Manager compiles QBR package for top 200 accounts — purchase history, product mix analysis, margin analysis, delivery performance, return/complaint summary, and comparison to account&#x27;s prior period and peer benchmarks
Responsible (R): Key Account Manager
Accountable (A): —
Duration: 60 min/account</bpmn:documentation>
        <bpmn:incoming>W617_Flow19</bpmn:incoming>
        <bpmn:outgoing>W617_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W617_Task10" name="Category Manager provides product recommendations for QBR: new products…">
        <bpmn:documentation>Step 4: Category Manager provides product recommendations for QBR: new products relevant to account&#x27;s trade (e.g., new tile line for interior designer accounts), promotional offers, and exclusive bundle pricing
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 15 min/account</bpmn:documentation>
        <bpmn:incoming>W617_Flow20</bpmn:incoming>
        <bpmn:outgoing>W617_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W617_Task11" name="Quarterly QBR meeting (top 200 accounts, ~3–4 meetings/day during QBR weeks)…">
        <bpmn:documentation>Step 5: Quarterly QBR meeting (top 200 accounts, ~3–4 meetings/day during QBR weeks): Key Account Manager presents performance review, discusses customer&#x27;s upcoming projects and procurement plans, addresses issues, presents recommendations, and negotiates volume commitments for next quarter
Responsible (R): Key Account Manager
Accountable (A): Trade Sales Manager
Duration: 60 min/meeting</bpmn:documentation>
        <bpmn:incoming>W617_Flow21</bpmn:incoming>
        <bpmn:outgoing>W617_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W617_Task12" name="Post-QBR: Key Account Manager documents meeting outcomes, agreed actions, and…">
        <bpmn:documentation>Step 6: Post-QBR: Key Account Manager documents meeting outcomes, agreed actions, and volume commitments in CRM; system updates account plan with next-quarter targets; assigns follow-up tasks with deadlines
Responsible (R): Key Account Manager
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W617_Flow22</bpmn:incoming>
        <bpmn:outgoing>W617_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W617_Task13" name="Quarterly: Trade Sales Manager consolidates QBR outcomes for executive review —…">
        <bpmn:documentation>Step 7: Quarterly: Trade Sales Manager consolidates QBR outcomes for executive review — total committed revenue, at-risk accounts, win-back opportunities, and product feedback themes; presents to CMO and Head of Trade / Account Management
Responsible (R): Trade Sales Manager
Accountable (A): CMO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W617_Flow23</bpmn:incoming>
        <bpmn:outgoing>W617_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W617_End14" name="Complete">
        <bpmn:incoming>W617_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W617_Annotation15">
        <bpmn:text>Controls: - CTL-278 (ensure controlled execution — Customer Support &amp; Complaints (PA-13.1).) | - operational: automated account health monitoring for all accounts; operational: data-driven insights and tangible value in each meeting (exclusive offers, project leads); operational: staggering QBR schedules and using virtual meetings for distant accounts
Owner: Key Account Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W617_Assoc16" sourceRef="W617_Annotation15" targetRef="W617_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W617_Flow17" sourceRef="W617_Start6" targetRef="W617_Task7" />
      <bpmn:sequenceFlow id="W617_Flow18" sourceRef="W617_Task7" targetRef="W617_Task8" />
      <bpmn:sequenceFlow id="W617_Flow19" sourceRef="W617_Task8" targetRef="W617_Task9" />
      <bpmn:sequenceFlow id="W617_Flow20" sourceRef="W617_Task9" targetRef="W617_Task10" />
      <bpmn:sequenceFlow id="W617_Flow21" sourceRef="W617_Task10" targetRef="W617_Task11" />
      <bpmn:sequenceFlow id="W617_Flow22" sourceRef="W617_Task11" targetRef="W617_Task12" />
