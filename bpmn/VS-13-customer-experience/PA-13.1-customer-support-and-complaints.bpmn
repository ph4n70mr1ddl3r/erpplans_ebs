<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-13.1-customer-support-and-complaints" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W41" name="W41. Customer Complaint Resolution" isExecutable="false">
      <bpmn:documentation>Trigger: Customer submits complaint in-store, by phone (call center), by email/chat, or on website/app
Frequency: ~2,000–3,000 complaints/month chain-wide; ~10–15 per store per month
Volume: Categories: product quality (30%), delivery issues (20%), staff behavior (15%), pricing/charging errors (15%), out-of-stock (10%), others (10%)
Owner: Customer Service Rep (Tier 1) / Customer Service Manager (Tier 2)
Participants: CSR, CS Manager, Department Supervisor, Store Manager, Buyer, Call Center Agent, Logistics
Source: workflow W41 — Customer Complaint Resolution</bpmn:documentation>
      <bpmn:laneSet id="W41_LaneSet6">
        <bpmn:lane id="W41_Lane1" name="Customer">
        <bpmn:flowNodeRef>W41_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W41_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W41_Lane2" name="CSR">
        <bpmn:flowNodeRef>W41_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W41_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W41_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W41_Lane3" name="System">
        <bpmn:flowNodeRef>W41_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W41_Task17</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W41_Lane4" name="CS Manager">
        <bpmn:flowNodeRef>W41_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W41_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W41_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W41_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W41_Task18</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W41_Lane5" name="VP Store Operations">
        <bpmn:flowNodeRef>W41_Task19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W41_Task20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W41_End21</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W41_Start7" name="Customer submits complaint in-store, by phone (call center), by email/chat, or on…">
        <bpmn:outgoing>W41_Flow24</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W41_Task8" name="Customer submits complaint via any channel: in-store (CSR counter), phone (call…">
        <bpmn:documentation>Step 1: Customer submits complaint via any channel: in-store (CSR counter), phone (call center), email/chat, or website/app form
Responsible (R): Customer
Accountable (A): —
Duration: —</bpmn:documentation>
        <bpmn:incoming>W41_Flow24</bpmn:incoming>
        <bpmn:outgoing>W41_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W41_Task9" name="System creates complaint ticket: unique ticket number, channel, customer info…">
        <bpmn:documentation>Step 2: System creates complaint ticket: unique ticket number, channel, customer info (loyalty lookup or guest), category, description, priority (auto-assessed by category)
Responsible (R): CSR / Call Center Agent
Accountable (A): CS Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W41_Flow25</bpmn:incoming>
        <bpmn:outgoing>W41_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W41_Task10" name="Tier 1 Resolution">
        <bpmn:documentation>Step 3: Tier 1 Resolution (CSR or Call Center Agent): attempt immediate resolution — (a) product issue: offer exchange (W12), warranty claim (W33), or store credit; (b) pricing error: verify and issue refund; (c) delivery issue: check status, arrange redelivery
Responsible (R): CSR / Call Center Agent
Accountable (A): CS Manager
Duration: 5–15 min</bpmn:documentation>
        <bpmn:incoming>W41_Flow26</bpmn:incoming>
        <bpmn:outgoing>W41_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W41_Task11" name="If resolved at Tier 1: CSR closes ticket with resolution code and customer…">
        <bpmn:documentation>Step 4: If resolved at Tier 1: CSR closes ticket with resolution code and customer satisfaction rating (if provided)
Responsible (R): CSR / Call Center Agent
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W41_Flow27</bpmn:incoming>
        <bpmn:outgoing>W41_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W41_Task12" name="If unresolved at Tier 1: ticket escalated to Tier 2 (CS Manager or Store…">
        <bpmn:documentation>Step 5: If unresolved at Tier 1: ticket escalated to Tier 2 (CS Manager or Store Manager); system reassigns ticket and starts SLA timer
Responsible (R): System
Accountable (A): CS Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W41_Flow28</bpmn:incoming>
        <bpmn:outgoing>W41_Flow29</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W41_Task13" name="Tier 2 Resolution">
        <bpmn:documentation>Step 6: Tier 2 Resolution (CS Manager / Store Manager): investigates root cause; coordinates with relevant department (Buyer for product issues, Logistics for delivery, HR for staff complaints)
Responsible (R): CS Manager / Store Manager
Accountable (A): VP Store Operations
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W41_Flow29</bpmn:incoming>
        <bpmn:outgoing>W41_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W41_Task14" name="CS Manager proposes resolution to customer: refund, exchange, discount voucher…">
        <bpmn:documentation>Step 7: CS Manager proposes resolution to customer: refund, exchange, discount voucher, written apology, corrective action commitment
Responsible (R): CS Manager
Accountable (A): VP Store Operations
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W41_Flow30</bpmn:incoming>
        <bpmn:outgoing>W41_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W41_Task15" name="If customer accepts: ticket closed with resolution; system triggers any…">
        <bpmn:documentation>Step 8: If customer accepts: ticket closed with resolution; system triggers any financial actions (refund, voucher issuance)
Responsible (R): CS Manager
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W41_Flow31</bpmn:incoming>
        <bpmn:outgoing>W41_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W41_Task16" name="If customer rejects or complaint involves legal/regulatory risk: escalate to VP…">
        <bpmn:documentation>Step 9: If customer rejects or complaint involves legal/regulatory risk: escalate to VP Store Operations or Legal; system logs escalation
Responsible (R): CS Manager
Accountable (A): VP Store Operations
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W41_Flow32</bpmn:incoming>
        <bpmn:outgoing>W41_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W41_Task17" name="SLA enforcement: Tier 1 must respond within 4 hours; Tier 2 must resolve within…">
        <bpmn:documentation>Step 10: SLA enforcement: Tier 1 must respond within 4 hours; Tier 2 must resolve within 48 hours; if exceeded, system escalates to VP Store Operations
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W41_Flow33</bpmn:incoming>
        <bpmn:outgoing>W41_Flow34</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W41_Task18" name="Monthly: CS Manager generates complaint analytics report: volume by category…">
        <bpmn:documentation>Step 11: Monthly: CS Manager generates complaint analytics report: volume by category, by store, resolution rate, SLA compliance, top recurring issues
Responsible (R): CS Manager
Accountable (A): VP Store Operations
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W41_Flow34</bpmn:incoming>
        <bpmn:outgoing>W41_Flow35</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W41_Task19" name="Monthly: VP Store Operations reviews complaint trends with Department Heads…">
        <bpmn:documentation>Step 12: Monthly: VP Store Operations reviews complaint trends with Department Heads; assigns corrective actions for recurring root causes
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W41_Flow35</bpmn:incoming>
        <bpmn:outgoing>W41_Flow36</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W41_Task20" name="Quarterly: top complaint root causes feed into operational improvement…">
        <bpmn:documentation>Step 13: Quarterly: top complaint root causes feed into operational improvement initiatives (training, process changes, vendor quality requirements)
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: Quarterly review</bpmn:documentation>
        <bpmn:incoming>W41_Flow36</bpmn:incoming>
        <bpmn:outgoing>W41_Flow37</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W41_End21" name="Complete">
        <bpmn:incoming>W41_Flow37</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W41_Annotation22">
        <bpmn:text>Controls: - CTL-278 (ensure controlled execution — Customer Support &amp; Complaints (PA-13.1).) | - operational: Customer Service Rep (Tier 1) / Customer Service Manager (Tier 2) review and approval gate
Owner: Customer Service Rep (Tier 1) / Customer Service Manager (Tier 2)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W41_Assoc23" sourceRef="W41_Annotation22" targetRef="W41_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W41_Flow24" sourceRef="W41_Start7" targetRef="W41_Task8" />
      <bpmn:sequenceFlow id="W41_Flow25" sourceRef="W41_Task8" targetRef="W41_Task9" />
      <bpmn:sequenceFlow id="W41_Flow26" sourceRef="W41_Task9" targetRef="W41_Task10" />
      <bpmn:sequenceFlow id="W41_Flow27" sourceRef="W41_Task10" targetRef="W41_Task11" />
      <bpmn:sequenceFlow id="W41_Flow28" sourceRef="W41_Task11" targetRef="W41_Task12" />
      <bpmn:sequenceFlow id="W41_Flow29" sourceRef="W41_Task12" targetRef="W41_Task13" />
      <bpmn:sequenceFlow id="W41_Flow30" sourceRef="W41_Task13" targetRef="W41_Task14" />
      <bpmn:sequenceFlow id="W41_Flow31" sourceRef="W41_Task14" targetRef="W41_Task15" />
      <bpmn:sequenceFlow id="W41_Flow32" sourceRef="W41_Task15" targetRef="W41_Task16" />
      <bpmn:sequenceFlow id="W41_Flow33" sourceRef="W41_Task16" targetRef="W41_Task17" />
      <bpmn:sequenceFlow id="W41_Flow34" sourceRef="W41_Task17" targetRef="W41_Task18" />
      <bpmn:sequenceFlow id="W41_Flow35" sourceRef="W41_Task18" targetRef="W41_Task19" />
      <bpmn:sequenceFlow id="W41_Flow36" sourceRef="W41_Task19" targetRef="W41_Task20" />
      <bpmn:sequenceFlow id="W41_Flow37" sourceRef="W41_Task20" targetRef="W41_End21" />
    </bpmn:process>
