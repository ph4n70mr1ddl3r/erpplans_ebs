    <bpmn:process id="W_W258" name="W258. Omni-channel Customer Ticketing &amp; Support Management" isExecutable="false">
      <bpmn:documentation>Trigger: Customer reaches out via email, social media, phone, or live chat for inquiries, order status, or support
Frequency: Continuous
Volume: ~3,000 - 5,000 tickets/month
Owner: Customer Service Manager
Participants: CS Agents, Store Managers, DC Operations, Delivery Partners
Source: workflow W258 — Omni-channel Customer Ticketing &amp; Support Management</bpmn:documentation>
      <bpmn:laneSet id="W258_LaneSet3">
        <bpmn:lane id="W258_Lane1" name="System">
        <bpmn:flowNodeRef>W258_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W258_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W258_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W258_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W258_Lane2" name="CS Agent">
        <bpmn:flowNodeRef>W258_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W258_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W258_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W258_Start4" name="Customer reaches out via email, social media, phone, or live chat for inquiries, order…">
        <bpmn:outgoing>W258_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W258_Task5" name="Ticket Creation">
        <bpmn:documentation>Step 1: Ticket Creation: System automatically consolidates omnichannel inputs (social, email, chat) into a single CRM ticketing queue
Responsible (R): System
Accountable (A): CS Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W258_Flow13</bpmn:incoming>
        <bpmn:outgoing>W258_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W258_Task6" name="Triage &amp; Assignment">
        <bpmn:documentation>Step 2: Triage &amp; Assignment: Auto-assign ticket to specific agent or queue (e.g., &quot;Ecommerce Delivery&quot;, &quot;Product Inquiry&quot;, &quot;Store Feedback&quot;) based on keywords and customer tier
Responsible (R): System
Accountable (A): CS Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W258_Flow14</bpmn:incoming>
        <bpmn:outgoing>W258_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W258_Task7" name="Resolution">
        <bpmn:documentation>Step 3: Resolution: CS Agent reviews customer 360-degree profile (W156), accesses ERP for order status/inventory, and provides resolution or update
Responsible (R): CS Agent
Accountable (A): CS Manager
Duration: 10-15 min</bpmn:documentation>
        <bpmn:incoming>W258_Flow15</bpmn:incoming>
        <bpmn:outgoing>W258_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W258_Task8" name="Escalation">
        <bpmn:documentation>Step 4: Escalation: If issue requires store action (e.g., missing BOPIS item) or logistics action (e.g., lost package), agent escalates ticket to respective department
Responsible (R): CS Agent
Accountable (A): CS Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W258_Flow16</bpmn:incoming>
        <bpmn:outgoing>W258_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W258_Task9" name="Closure &amp; CSAT">
        <bpmn:documentation>Step 5: Closure &amp; CSAT: Ticket resolved; system automatically sends CSAT/NPS survey to customer (W65) to measure satisfaction with support
Responsible (R): System
Accountable (A): CS Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W258_Flow17</bpmn:incoming>
        <bpmn:outgoing>W258_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
