      <bpmn:sequenceFlow id="W782_Flow19" sourceRef="W782_Task8" targetRef="W782_Task9" />
      <bpmn:sequenceFlow id="W782_Flow20" sourceRef="W782_Task9" targetRef="W782_Task10" />
      <bpmn:sequenceFlow id="W782_Flow21" sourceRef="W782_Task10" targetRef="W782_Task11" />
      <bpmn:sequenceFlow id="W782_Flow22" sourceRef="W782_Task11" targetRef="W782_Task12" />
      <bpmn:sequenceFlow id="W782_Flow23" sourceRef="W782_Task12" targetRef="W782_End13" />
    </bpmn:process>
