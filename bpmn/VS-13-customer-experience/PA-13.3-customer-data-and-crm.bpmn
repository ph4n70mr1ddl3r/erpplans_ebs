    <bpmn:process id="W_W560" name="W560. Customer Account Dormancy Identification &amp; Deactivation" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly dormancy scan schedule (1st business day of each month); quarterly deactivation batch
Frequency: Monthly scan; quarterly deactivation batch processing
Volume: ~2,000–3,000 newly dormant loyalty accounts per month (no transaction for 12 months); ~5,200 trade accounts and ~200 corporate accounts monitored quarterly; ~5,000–8,000 loyalty accounts deactivated per quarter
Owner: CRM Manager / AR Supervisor (for B2B accounts)
Participants: CRM Analyst, CRM Manager, AR Supervisor (R for B2B), Sales Manager (C for B2B relationship), Customer Service Lead (I for inbound inquiries)
Source: workflow W560 — Customer Account Dormancy Identification &amp; Deactivation</bpmn:documentation>
      <bpmn:laneSet id="W560_LaneSet6">
        <bpmn:lane id="W560_Lane1" name="System">
        <bpmn:flowNodeRef>W560_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W560_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W560_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W560_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W560_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W560_Lane2" name="CRM Analyst">
        <bpmn:flowNodeRef>W560_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W560_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W560_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W560_Task19</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W560_Lane3" name="Sales Manager">
        <bpmn:flowNodeRef>W560_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W560_Lane4" name="AR Supervisor">
        <bpmn:flowNodeRef>W560_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W560_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W560_Lane5" name="CRM Manager">
        <bpmn:flowNodeRef>W560_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W560_End20</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W560_Start7" name="Monthly dormancy scan schedule (1st business day of each month); quarterly deactivation…">
        <bpmn:outgoing>W560_Flow23</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W560_Task8" name="Monthly dormancy scan">
        <bpmn:documentation>Step 1: Monthly dormancy scan: CRM system identifies accounts meeting dormancy criteria — (a) Loyalty: no transaction or login for 12 months; (b) Trade: no invoice or payment for 6 months; (c) Corporate: no order for 6 months and no active project per W162
Responsible (R): System
Accountable (A): CRM Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W560_Flow23</bpmn:incoming>
        <bpmn:outgoing>W560_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W560_Task9" name="Dormancy classification">
        <bpmn:documentation>Step 2: Dormancy classification: (a) Early dormancy (12–18 months loyalty / 6–9 months B2B) — retain with re-engagement; (b) Extended dormancy (18–24 months loyalty / 9–12 months B2B) — prepare for deactivation; (c) Dead account (&gt; 24 months loyalty / &gt; 12 months B2B) — deactivate
Responsible (R): CRM Analyst
Accountable (A): CRM Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W560_Flow24</bpmn:incoming>
        <bpmn:outgoing>W560_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W560_Task10" name="Early dormancy re-engagement (loyalty)">
        <bpmn:documentation>Step 3: Early dormancy re-engagement (loyalty): automated email/SMS campaign — &quot;We miss you!&quot; with personalized offer (bonus points, discount voucher) per CRM-007
Responsible (R): System / CRM Analyst
Accountable (A): CRM Manager
Duration: Automated + 1 hour review</bpmn:documentation>
        <bpmn:incoming>W560_Flow25</bpmn:incoming>
        <bpmn:outgoing>W560_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W560_Task11" name="Early dormancy re-engagement (B2B)">
        <bpmn:documentation>Step 4: Early dormancy re-engagement (B2B): Sales Manager personal outreach — call or visit to understand reason (switched to competitor, business closure, project completed)
Responsible (R): Sales Manager
Accountable (A): CRM Manager
Duration: 30 min/account</bpmn:documentation>
        <bpmn:incoming>W560_Flow26</bpmn:incoming>
        <bpmn:outgoing>W560_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W560_Task12" name="Data quality review for extended dormant accounts: verify contact information…">
        <bpmn:documentation>Step 5: Data quality review for extended dormant accounts: verify contact information, update customer master per W253 if returned mail/bounced email
Responsible (R): CRM Analyst
Accountable (A): CRM Manager
Duration: 4 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W560_Flow27</bpmn:incoming>
        <bpmn:outgoing>W560_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W560_Task13" name="B2B extended dormancy">
        <bpmn:documentation>Step 6: B2B extended dormancy: AR Supervisor reviews outstanding balance — if zero balance, proceed to deactivation; if outstanding balance, escalate to W108 (credit collection) before deactivation
Responsible (R): AR Supervisor
Accountable (A): CRM Manager
Duration: 15 min/account</bpmn:documentation>
        <bpmn:incoming>W560_Flow28</bpmn:incoming>
        <bpmn:outgoing>W560_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W560_Task14" name="Corporate extended dormancy">
        <bpmn:documentation>Step 7: Corporate extended dormancy: verify no pending contract or project milestone per W162/W165 before deactivation
Responsible (R): CRM Analyst / Sales Manager
Accountable (A): CRM Manager
Duration: 15 min/account</bpmn:documentation>
        <bpmn:incoming>W560_Flow29</bpmn:incoming>
        <bpmn:outgoing>W560_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W560_Task15" name="Quarterly deactivation batch">
        <bpmn:documentation>Step 8: Quarterly deactivation batch: CRM Manager approves deactivation list; system updates account status to &quot;Inactive&quot; (not deleted — retained per NFR-006 data retention)
Responsible (R): CRM Manager
Accountable (A): VP Marketing
Duration: 4–6 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W560_Flow30</bpmn:incoming>
        <bpmn:outgoing>W560_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W560_Task16" name="B2B deactivation">
        <bpmn:documentation>Step 9: B2B deactivation: credit limit set to zero per W253; Sales Manager notified; account remains in AR for historical reference
Responsible (R): AR Supervisor / System
Accountable (A): CRM Manager
Duration: Automated + 15 min review</bpmn:documentation>
        <bpmn:incoming>W560_Flow31</bpmn:incoming>
        <bpmn:outgoing>W560_Flow32</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W560_Task17" name="Loyalty deactivation">
        <bpmn:documentation>Step 10: Loyalty deactivation: points balance preserved but frozen; account marked inactive; customer can reactivate via W84 within 24 months with points restored
Responsible (R): System
Accountable (A): CRM Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W560_Flow32</bpmn:incoming>
        <bpmn:outgoing>W560_Flow33</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W560_Task18" name="Deactivation confirmation: system generates deactivation report with count by…">
        <bpmn:documentation>Step 11: Deactivation confirmation: system generates deactivation report with count by category and reason; CRM Manager reviews for accuracy
Responsible (R): System / CRM Analyst
Accountable (A): CRM Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W560_Flow33</bpmn:incoming>
        <bpmn:outgoing>W560_Flow34</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W560_Task19" name="Quarterly dormancy analytics: dormancy rate trend, re-engagement success rate…">
        <bpmn:documentation>Step 12: Quarterly dormancy analytics: dormancy rate trend, re-engagement success rate, average dormancy period, root cause analysis (price, service, location, competitor)
Responsible (R): CRM Analyst
Accountable (A): CRM Manager
Duration: 3–4 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W560_Flow34</bpmn:incoming>
        <bpmn:outgoing>W560_Flow35</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W560_End20" name="Complete">
        <bpmn:incoming>W560_Flow35</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W560_Annotation21">
        <bpmn:text>Controls: - CTL-280 (ensure controlled execution — Customer Data &amp; CRM (PA-13.3).) | - operational: CRM Manager / AR Supervisor (for B2B accounts) review and approval gate
Owner: CRM Manager / AR Supervisor (for B2B accounts)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W560_Assoc22" sourceRef="W560_Annotation21" targetRef="W560_Start7" associationDirection="None" />
