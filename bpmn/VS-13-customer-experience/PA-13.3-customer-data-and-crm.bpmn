    <bpmn:process id="W_W508" name="W508. Customer Account Maintenance &amp; B2B Information Update" isExecutable="false">
      <bpmn:documentation>Trigger: B2B customer requests information update (trade or corporate account); or scheduled periodic re-verification
Frequency: ~80–120 update requests/month; annual re-verification of all 5,400 B2B accounts
Volume: ~100 average updates/month; 5,400 annual re-verifications (per the Frequency: all B2B accounts)
Owner: AR Supervisor
Participants: Sales Representative, AR Clerk, Credit Analyst, Customer
Source: workflow W508 — Customer Account Maintenance &amp; B2B Information Update</bpmn:documentation>
      <bpmn:laneSet id="W508_LaneSet7">
        <bpmn:lane id="W508_Lane1" name="Customer">
        <bpmn:flowNodeRef>W508_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W508_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W508_Lane2" name="AR Clerk">
        <bpmn:flowNodeRef>W508_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W508_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W508_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W508_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W508_Lane3" name="Credit Analyst">
        <bpmn:flowNodeRef>W508_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W508_Lane4" name="System">
        <bpmn:flowNodeRef>W508_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W508_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W508_Lane5" name="Sales Rep">
        <bpmn:flowNodeRef>W508_Task17</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W508_Lane6" name="AR Supervisor">
        <bpmn:flowNodeRef>W508_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W508_End19</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W508_Start8" name="B2B customer requests information update (trade or corporate account); or scheduled…">
        <bpmn:outgoing>W508_Flow22</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W508_Task9" name="Customer submits information update request via: (a) assigned Sales…">
        <bpmn:documentation>Step 1: Customer submits information update request via: (a) assigned Sales Representative, (b) trade counter/pro desk (W112), (c) customer self-service portal, or (d) call center (W259)
Responsible (R): Customer / Sales Rep
Accountable (A): AR Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W508_Flow22</bpmn:incoming>
        <bpmn:outgoing>W508_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W508_Task10" name="AR Clerk receives request; classifies update type: (a) business name / trade…">
        <bpmn:documentation>Step 2: AR Clerk receives request; classifies update type: (a) business name / trade name change, (b) TIN / tax registration change, (c) billing address change, (d) contact person change, (e) credit limit review request, (f) payment terms modification, (g) VAT registration status change, (h) bank account change for payments
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W508_Flow23</bpmn:incoming>
        <bpmn:outgoing>W508_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W508_Task11" name="For business name/TIN change: AR Clerk requests supporting documents (SEC…">
        <bpmn:documentation>Step 3: For business name/TIN change: AR Clerk requests supporting documents (SEC registration, BIR Certificate of Registration, DTI registration); uploads documents to customer master
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W508_Flow24</bpmn:incoming>
        <bpmn:outgoing>W508_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W508_Task12" name="For contact person change: AR Clerk verifies authorization (new contact must…">
        <bpmn:documentation>Step 4: For contact person change: AR Clerk verifies authorization (new contact must provide authorization letter from company authorized signatory); updates customer master with new contact details
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W508_Flow25</bpmn:incoming>
        <bpmn:outgoing>W508_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W508_Task13" name="For credit-related changes (limit, terms): AR Clerk routes to Credit Analyst…">
        <bpmn:documentation>Step 5: For credit-related changes (limit, terms): AR Clerk routes to Credit Analyst for assessment (W24); Credit Analyst evaluates based on updated financial information and payment history
Responsible (R): Credit Analyst
Accountable (A): AR Supervisor
Duration: Variable</bpmn:documentation>
        <bpmn:incoming>W508_Flow26</bpmn:incoming>
        <bpmn:outgoing>W508_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W508_Task14" name="For VAT registration status change: AR Clerk updates tax classification in…">
        <bpmn:documentation>Step 6: For VAT registration status change: AR Clerk updates tax classification in customer master (W293); system validates TIN format against BIR; updates invoice template for future billings
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W508_Flow27</bpmn:incoming>
        <bpmn:outgoing>W508_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W508_Task15" name="System updates customer master record with audit trail: old value, new value…">
        <bpmn:documentation>Step 7: System updates customer master record with audit trail: old value, new value, changed by, changed date, reason, supporting document reference
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W508_Flow28</bpmn:incoming>
        <bpmn:outgoing>W508_Flow29</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W508_Task16" name="System propagates changes to downstream systems: invoicing, POS trade pricing…">
        <bpmn:documentation>Step 8: System propagates changes to downstream systems: invoicing, POS trade pricing, ecommerce B2B portal, CRM, credit management
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W508_Flow29</bpmn:incoming>
        <bpmn:outgoing>W508_Flow30</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W508_Task17" name="Annual re-verification: system generates re-verification list of all B2B…">
        <bpmn:documentation>Step 9: Annual re-verification: system generates re-verification list of all B2B accounts; assigns to Sales Representatives by territory; Sales Reps contact customers to verify and update information
Responsible (R): Sales Rep
Accountable (A): AR Supervisor
Duration: 15 min/account</bpmn:documentation>
        <bpmn:incoming>W508_Flow30</bpmn:incoming>
        <bpmn:outgoing>W508_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W508_Task18" name="Monthly: AR Supervisor reviews update volume and aging; identifies accounts…">
        <bpmn:documentation>Step 10: Monthly: AR Supervisor reviews update volume and aging; identifies accounts with incomplete re-verification; escalates to Sales Manager
Responsible (R): AR Supervisor
Accountable (A): Controller
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W508_Flow31</bpmn:incoming>
        <bpmn:outgoing>W508_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W508_End19" name="Complete">
        <bpmn:incoming>W508_Flow32</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W508_Annotation20">
        <bpmn:text>Controls: - CTL-280 (ensure controlled execution — Customer Data &amp; CRM (PA-13.3).) | - operational: authorization letter requirement and signatory verification; operational: real-time sync and reconciliation checks (W253); operational: dormant account flagging and credit suspension for unverified accounts
Owner: AR Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W508_Assoc21" sourceRef="W508_Annotation20" targetRef="W508_Start8" associationDirection="None" />
      <bpmn:sequenceFlow id="W508_Flow22" sourceRef="W508_Start8" targetRef="W508_Task9" />
      <bpmn:sequenceFlow id="W508_Flow23" sourceRef="W508_Task9" targetRef="W508_Task10" />
      <bpmn:sequenceFlow id="W508_Flow24" sourceRef="W508_Task10" targetRef="W508_Task11" />
