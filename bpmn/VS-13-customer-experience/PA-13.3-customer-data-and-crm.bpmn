    <bpmn:process id="W_W156" name="W156. Customer Data Platform (CDP) &amp; Hyper-Personalization" isExecutable="false">
      <bpmn:documentation>Trigger: Real-time customer interaction (web visit, POS sale, app notification)
Frequency: Continuous
Volume: 600,000+ member profiles
Owner: Digital Marketing Manager
Participants: Data Analyst, CRM Team, IT, CMO
Source: workflow W156 — Customer Data Platform (CDP) &amp; Hyper-Personalization</bpmn:documentation>
      <bpmn:laneSet id="W156_LaneSet5">
        <bpmn:lane id="W156_Lane1" name="System">
        <bpmn:flowNodeRef>W156_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W156_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W156_Lane2" name="Data Analyst">
        <bpmn:flowNodeRef>W156_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W156_Lane3" name="CRM Team">
        <bpmn:flowNodeRef>W156_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W156_Lane4" name="Digital Mktg Mgr">
        <bpmn:flowNodeRef>W156_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W156_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W156_Start6" name="Real-time customer interaction (web visit, POS sale, app notification)">
        <bpmn:outgoing>W156_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W156_Task7" name="Data Ingestion">
        <bpmn:documentation>Step 1: Data Ingestion: Aggregate data from POS (W5), Ecommerce (W11), and Loyalty (W17) into a unified &quot;Golden Record&quot;
Responsible (R): System
Accountable (A): IT Mgr
Duration: Real-time</bpmn:documentation>
        <bpmn:incoming>W156_Flow14</bpmn:incoming>
        <bpmn:outgoing>W156_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W156_Task8" name="Segmentation">
        <bpmn:documentation>Step 2: Segmentation: System auto-assigns segments based on behavior: &quot;DIY Hobbyist,&quot; &quot;Professional Contractor,&quot; &quot;Lapsed Buyer&quot;
Responsible (R): Data Analyst
Accountable (A): Digital Mktg Mgr
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W156_Flow15</bpmn:incoming>
        <bpmn:outgoing>W156_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W156_Task9" name="Triggered Journeys">
        <bpmn:documentation>Step 3: Triggered Journeys: Auto-trigger email/SMS based on events: &quot;Abandoned Cart,&quot; &quot;Project Follow-up,&quot; or &quot;Refill Reminder&quot; (for paint/consumables)
Responsible (R): CRM Team
Accountable (A): Digital Mktg Mgr
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W156_Flow16</bpmn:incoming>
        <bpmn:outgoing>W156_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W156_Task10" name="Personalized Offers">
        <bpmn:documentation>Step 4: Personalized Offers: Push unique promo codes to the Mobile App based on individual purchase history
Responsible (R): Digital Mktg Mgr
Accountable (A): CMO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W156_Flow17</bpmn:incoming>
        <bpmn:outgoing>W156_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W156_End11" name="Complete">
        <bpmn:incoming>W156_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W156_Annotation12">
        <bpmn:text>Controls: - CTL-280 (ensure controlled execution — Customer Data &amp; CRM (PA-13.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Digital Marketing Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W156_Assoc13" sourceRef="W156_Annotation12" targetRef="W156_Start6" associationDirection="None" />
