        <bpmndi:BPMNEdge id="W675_Flow15_di" bpmnElement="W675_Flow15"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W675_Flow16_di" bpmnElement="W675_Flow16"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W675_Flow17_di" bpmnElement="W675_Flow17"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W675_Flow18_di" bpmnElement="W675_Flow18"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W675_Flow19_di" bpmnElement="W675_Flow19"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W675_Flow20_di" bpmnElement="W675_Flow20"><di:waypoint x="1420" y="165" /><di:waypoint x="1450" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W675_Flow21_di" bpmnElement="W675_Flow21"><di:waypoint x="1630" y="165" /><di:waypoint x="1660" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W675_Flow22_di" bpmnElement="W675_Flow22"><di:waypoint x="1840" y="165" /><di:waypoint x="1890" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W675_Assoc14_di" bpmnElement="W675_Assoc14"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W708" name="W708. Customer Communication Management &amp; Proactive Notification Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Order lifecycle events; promotional campaign trigger; loyalty program milestone; service disruption notification; account statement cycle; regulatory notice requirement
Frequency: Continuous (thousands of notifications/day); monthly statement cycle; campaign-based promotional bursts
Volume: ~600,000 registered loyalty members; ~93,000 POS transactions/day; ~1,400 ecommerce orders/day; estimated 50,000-100,000 customer communications/day across all channels
Owner: Customer Experience Manager
Participants: Marketing (campaign content), IT (communication platform), Customer Service (inquiry response), Legal (regulatory notices), Ecommerce Operations
Source: workflow W708 — Customer Communication Management &amp; Proactive Notification Operations</bpmn:documentation>
      <bpmn:laneSet id="W708_LaneSet6">
        <bpmn:lane id="W708_Lane1" name="Customer Experience Manager">
        <bpmn:flowNodeRef>W708_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W708_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W708_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W708_Lane2" name="System">
        <bpmn:flowNodeRef>W708_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W708_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W708_Lane3" name="Marketing">
        <bpmn:flowNodeRef>W708_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W708_Lane4" name="Customer Service Manager">
        <bpmn:flowNodeRef>W708_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W708_Lane5" name="Legal">
        <bpmn:flowNodeRef>W708_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W708_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W708_Start7" name="Order lifecycle events; promotional campaign trigger; loyalty program milestone; service…">
        <bpmn:outgoing>W708_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W708_Task8" name="Communication channel management">
        <bpmn:documentation>Step 1: Communication channel management: Customer Experience Manager maintains communication channel configuration: (a) SMS gateway (Philippine telecom providers: Smart, Globe — with registered sender ID per NTC requirements); (b) email platform (branded templates per W687, sender domain authentication via SPF/DKIM/DMARC); (c) mobile app push notification service (APNS for iOS, FCM for Android); (d) in-app message center; (e) preferred channel per customer: system respects customer opt-in/opt-out preferences per RA 10173 data privacy requirements; (f) communication preference managed in customer master per CRM-030
Responsible (R): Customer Experience Manager / IT
Accountable (A): Head of Customer Service
Duration: Initial setup: 1 week; ongoing: 2-3 hours/month</bpmn:documentation>
        <bpmn:incoming>W708_Flow18</bpmn:incoming>
        <bpmn:outgoing>W708_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W708_Task9" name="Transactional notifications (automated)">
        <bpmn:documentation>Step 2: Transactional notifications (automated): system sends transactional notifications triggered by order lifecycle events: (a) POS purchase: digital receipt via email/SMS (opt-in); loyalty points earned notification; (b) ecommerce order: order confirmation, order processing update, shipping notification with tracking link, delivery confirmation; (c) returns: RA confirmation, return received, refund processed per W707; (d) loyalty program: points earned, points expiring (30-day notice), tier upgrade/downgrade per W83, reward redemption confirmation; (e) account management: password reset, profile update confirmation, credit limit change notification per W145; (f) system personalizes notifications: customer name, store location, order details, loyalty tier
Responsible (R): System
Accountable (A): Customer Experience Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W708_Flow19</bpmn:incoming>
        <bpmn:outgoing>W708_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W708_Task10" name="Promotional communications">
        <bpmn:documentation>Step 3: Promotional communications: Marketing creates and schedules promotional communications per W142: (a) audience segmentation per W673 customer segmentation (loyalty tier, purchase history, location, category interest); (b) content creation: promotional offer, creative assets, call-to-action; (c) channel selection: email for detailed promotions, SMS for time-limited flash sales, push notification for app-engaged users; (d) scheduling: optimize send time based on customer engagement patterns; (e) A/B testing: test subject lines, content variants, send times on sample before full deployment; (f) suppress customers who have opted out of promotional communications per RA 10173
Responsible (R): Marketing / Customer Experience Manager
Accountable (A): CMO
Duration: Per campaign cycle</bpmn:documentation>
        <bpmn:incoming>W708_Flow20</bpmn:incoming>
        <bpmn:outgoing>W708_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W708_Task11" name="Service disruption notifications">
        <bpmn:documentation>Step 4: Service disruption notifications: when operational disruptions affect customers: (a) store temporary closure (typhoon per W576, power outage per W470): push notification and SMS to customers near affected store(s) with estimated reopening; (b) ecommerce delivery delay: proactively notify affected customers with revised ETA and apology; (c) website/app downtime: status page update + social media notification per W142; (d) product recall per W627: urgent multi-channel notification to customers who purchased affected product (identified via POS/ecommerce transaction history); (e) Customer Service Manager approves service disruption message content before distribution
Responsible (R): Customer Service Manager / IT
Accountable (A): Head of Customer Service
Duration: 30-60 min per disruption event</bpmn:documentation>
        <bpmn:incoming>W708_Flow21</bpmn:incoming>
        <bpmn:outgoing>W708_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W708_Task12" name="Regulatory and compliance notices">
        <bpmn:documentation>Step 5: Regulatory and compliance notices: for mandatory customer communications: (a) monthly customer statements for wholesale/trade accounts per W100; (b) BIR e-invoice notification per FIN-010; (c) data privacy annual notice per RA 10173 and NPC requirements; (d) loyalty program terms and conditions updates; (e) credit terms change notices per W145; (f) Legal reviews all regulatory notice content before distribution
Responsible (R): Legal / Customer Service Manager
Accountable (A): VP Legal
Duration: Per regulatory requirement</bpmn:documentation>
        <bpmn:incoming>W708_Flow22</bpmn:incoming>
        <bpmn:outgoing>W708_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W708_Task13" name="Communication analytics and optimization">
        <bpmn:documentation>Step 6: Communication analytics and optimization: monthly, Customer Experience Manager reviews communication performance: (a) delivery rate by channel (target: &gt;95% email, &gt;98% SMS, &gt;90% push); (b) open rate by communication type and channel; (c) click-through rate for promotional communications; (d) unsubscribe rate (target: &lt;0.5% per campaign); (e) customer feedback and complaints about communications (too frequent, irrelevant, wrong channel); (f) cost analysis: SMS cost per message × volume, email platform cost, push notification (free); (g) optimize: reduce low-engagement communications, shift to lower-cost channels where appropriate, improve personalization relevance
Responsible (R): Customer Experience Manager
Accountable (A): Head of Customer Service
Duration: 4-6 hours/month</bpmn:documentation>
        <bpmn:incoming>W708_Flow23</bpmn:incoming>
        <bpmn:outgoing>W708_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W708_Task14" name="Customer preference and opt-out management">
        <bpmn:documentation>Step 7: Customer preference and opt-out management: system manages customer communication preferences per RA 10173: (a) customer can opt in/out of each communication type: transactional (always on, cannot opt out), promotional, loyalty program updates, service alerts; (b) customer can select preferred channel; (c) system honors opt-out within 24 hours; (d) quarterly audit: verify all customer opt-out requests are respected across all channels; (e) annual data privacy notice per W647 includes communication preference disclosure
Responsible (R): System / IT
Accountable (A): VP Legal
Duration: Automated + quarterly audit: 2 hours</bpmn:documentation>
        <bpmn:incoming>W708_Flow24</bpmn:incoming>
        <bpmn:outgoing>W708_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W708_End15" name="Complete">
        <bpmn:incoming>W708_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W708_Annotation16">
        <bpmn:text>Controls: - CTL-280 (ensure controlled execution — Customer Data &amp; CRM (PA-13.3).) | - operational: Customer Experience Manager review and approval gate
Owner: Customer Experience Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W708_Assoc17" sourceRef="W708_Annotation16" targetRef="W708_Start7" associationDirection="None" />
