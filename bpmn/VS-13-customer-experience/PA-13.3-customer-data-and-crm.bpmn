    <bpmn:process id="W_W566" name="W566. Mystery Shopping Program &amp; CX Compliance Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly mystery shopping visit schedule; quarterly program review
Frequency: ~2–3 visits per store per month (~400–600 visits per month chain-wide); quarterly program review
Volume: 200 stores covered; higher frequency for underperforming stores (4–5 visits/month) and newly opened stores (6 visits for first 3 months)
Owner: CX Manager / Head of Customer Service
Participants: Mystery Shopping Agency (R — third-party provider), CX Manager, Store Manager (I — does not know visit schedule), Regional Manager (I — receives results), Department Supervisors (I — action items)
Source: workflow W566 — Mystery Shopping Program &amp; CX Compliance Audit</bpmn:documentation>
      <bpmn:laneSet id="W566_LaneSet4">
        <bpmn:lane id="W566_Lane1" name="CX Manager">
        <bpmn:flowNodeRef>W566_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W566_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W566_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W566_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W566_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W566_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W566_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W566_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W566_Lane2" name="Mystery Shopping Agency">
        <bpmn:flowNodeRef>W566_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W566_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W566_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W566_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W566_Lane3" name="Regional Manager">
        <bpmn:flowNodeRef>W566_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W566_End18</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W566_Start5" name="Monthly mystery shopping visit schedule; quarterly program review">
        <bpmn:outgoing>W566_Flow21</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W566_Task6" name="CX Manager contracts mystery shopping agency with defined evaluation criteria…">
        <bpmn:documentation>Step 1: CX Manager contracts mystery shopping agency with defined evaluation criteria and scoring rubric aligned to BuildRight service standards; agency onboards with evaluation criteria, store profiles, and reporting templates
Responsible (R): CX Manager
Accountable (A): Head of Customer Service
Duration: Initial setup: 20 hours; annual renewal: 4 hours</bpmn:documentation>
        <bpmn:incoming>W566_Flow21</bpmn:incoming>
        <bpmn:outgoing>W566_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W566_Task7" name="Monthly schedule creation">
        <bpmn:documentation>Step 2: Monthly schedule creation: CX Manager assigns visits to stores based on: (a) all stores minimum 2 visits/month, (b) underperforming stores 4–5 visits/month, (c) new stores 6 visits for first 3 months, (d) random selection for remaining visits
Responsible (R): CX Manager
Accountable (A): Head of Customer Service
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W566_Flow22</bpmn:incoming>
        <bpmn:outgoing>W566_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W566_Task8" name="Agency recruits and trains mystery shoppers">
        <bpmn:documentation>Step 3: Agency recruits and trains mystery shoppers matching BuildRight customer profiles: (a) DIY homeowner, (b) contractor/trade professional, (c) B2B corporate buyer, (d) senior citizen/PWD (for discount compliance testing)
Responsible (R): Mystery Shopping Agency
Accountable (A): CX Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W566_Flow23</bpmn:incoming>
        <bpmn:outgoing>W566_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W566_Task9" name="Mystery shopper conducts visit">
        <bpmn:documentation>Step 4: Mystery shopper conducts visit using mobile evaluation app: (a) exterior assessment (parking, signage, entrance cleanliness), (b) greeting (acknowledged within 30 seconds, friendly demeanor), (c) product inquiry (asks about specific item — scores product knowledge and selling behavior), (d) department navigation (signage clarity, aisle organization, product availability), (e) checkout experience (wait time, cashier courtesy, accuracy, loyalty enrollment offer, bag option), (f) restroom cleanliness (if applicable), (g) Senior Citizen/PWD discount procedure compliance (for eligible shopper profiles)
Responsible (R): Mystery Shopping Agency
Accountable (A): CX Manager
Duration: 30–45 min/visit</bpmn:documentation>
        <bpmn:incoming>W566_Flow24</bpmn:incoming>
        <bpmn:outgoing>W566_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W566_Task10" name="Mystery shopper submits evaluation within 24 hours via mobile app with photo…">
        <bpmn:documentation>Step 5: Mystery shopper submits evaluation within 24 hours via mobile app with photo evidence where applicable
Responsible (R): Mystery Shopping Agency
Accountable (A): CX Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W566_Flow25</bpmn:incoming>
        <bpmn:outgoing>W566_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W566_Task11" name="Agency quality team reviews">
        <bpmn:documentation>Step 6: Agency quality team reviews submission for completeness and objectivity; rejects biased or incomplete evaluations; follows up with shopper for clarification
Responsible (R): Mystery Shopping Agency
Accountable (A): CX Manager
Duration: 10 min/evaluation</bpmn:documentation>
        <bpmn:incoming>W566_Flow26</bpmn:incoming>
        <bpmn:outgoing>W566_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W566_Task12" name="CX Manager reviews monthly results dashboard">
        <bpmn:documentation>Step 7: CX Manager reviews monthly results dashboard: store-level scores, regional averages, chain-wide trends; identifies stores requiring immediate attention (overall score &lt; 70%)
Responsible (R): CX Manager
Accountable (A): Head of Customer Service
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W566_Flow27</bpmn:incoming>
        <bpmn:outgoing>W566_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W566_Task13" name="Score categories">
        <bpmn:documentation>Step 8: Score categories: (a) Service Excellence (40% weight) — greeting, product knowledge, selling skills, checkout; (b) Store Standards (30% weight) — cleanliness, planogram, signage, restroom; (c) Policy Compliance (20% weight) — discounts, return policy, age-restricted items; (d) Facility Condition (10% weight) — parking, exterior, equipment, lighting
Responsible (R): CX Manager
Accountable (A): Head of Customer Service
Duration: Ongoing (scoring methodology)</bpmn:documentation>
        <bpmn:incoming>W566_Flow28</bpmn:incoming>
        <bpmn:outgoing>W566_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W566_Task14" name="Underperforming stores (overall score &lt; 70%)">
        <bpmn:documentation>Step 9: Underperforming stores (overall score &lt; 70%): Store Manager receives detailed report with specific improvement actions and 30-day remediation deadline; CX Manager follows up at day 15 for progress check
Responsible (R): CX Manager
Accountable (A): Head of Customer Service
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W566_Flow29</bpmn:incoming>
        <bpmn:outgoing>W566_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W566_Task15" name="Regional Manager reviews mystery shopping results in monthly store performance…">
        <bpmn:documentation>Step 10: Regional Manager reviews mystery shopping results in monthly store performance review per W67; incorporates scores into Store Manager performance evaluation
Responsible (R): Regional Manager
Accountable (A): VP Store Operations
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W566_Flow30</bpmn:incoming>
        <bpmn:outgoing>W566_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W566_Task16" name="Quarterly program review">
        <bpmn:documentation>Step 11: Quarterly program review: CX Manager, Head of Customer Service, and VP Store Operations review program effectiveness, adjust scoring rubric, and modify visit frequency based on performance trends
Responsible (R): CX Manager / Head of Customer Service
Accountable (A): VP Store Operations
Duration: 3–4 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W566_Flow31</bpmn:incoming>
        <bpmn:outgoing>W566_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W566_Task17" name="Annual mystery shopping program ROI">
        <bpmn:documentation>Step 12: Annual mystery shopping program ROI: correlate mystery shopping scores with CSAT/NPS per W65, sales performance per W67, and customer retention per CRM-019; present findings to executive team
Responsible (R): CX Manager
Accountable (A): Head of Customer Service
Duration: 8 hours/year</bpmn:documentation>
        <bpmn:incoming>W566_Flow32</bpmn:incoming>
        <bpmn:outgoing>W566_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W566_End18" name="Complete">
        <bpmn:incoming>W566_Flow33</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W566_Annotation19">
        <bpmn:text>Controls: - CTL-280 (ensure controlled execution — Customer Data &amp; CRM (PA-13.3).) | - operational: agency quality review and shopper calibration sessions; operational: unannounced visit frequency changes and expanded evaluation criteria; operational: randomized visit timing and varying shopper profiles
Owner: CX Manager / Head of Customer Service</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W566_Assoc20" sourceRef="W566_Annotation19" targetRef="W566_Start5" associationDirection="None" />
