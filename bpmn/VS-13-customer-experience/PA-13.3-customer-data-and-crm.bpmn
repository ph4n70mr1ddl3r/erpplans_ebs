      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W673" name="W673. Customer Segmentation &amp; Target Marketing Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly segment refresh cycle; campaign targeting request from Marketing
Frequency: Monthly segment refresh; ad-hoc targeting for campaigns
Volume: ~600,000 loyalty members + ~5,400 B2B accounts segmented into 15-20 actionable segments
Owner: CX Analytics Lead
Participants: Marketing Campaign Manager, Loyalty Program Manager, CDP Administrator
Source: workflow W673 — Customer Segmentation &amp; Target Marketing Operations</bpmn:documentation>
      <bpmn:laneSet id="W673_LaneSet5">
        <bpmn:lane id="W673_Lane1" name="CX Analytics Lead">
        <bpmn:flowNodeRef>W673_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W673_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W673_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W673_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W673_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W673_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W673_Lane2" name="System">
        <bpmn:flowNodeRef>W673_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W673_Lane3" name="Marketing Campaign Manager">
        <bpmn:flowNodeRef>W673_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W673_Lane4" name="CDP Administrator">
        <bpmn:flowNodeRef>W673_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W673_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W673_Start6" name="Monthly segment refresh cycle; campaign targeting request from Marketing">
        <bpmn:outgoing>W673_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W673_Task7" name="CX Analytics Lead executes monthly segment refresh using CDP (W156): system…">
        <bpmn:documentation>Step 1: CX Analytics Lead executes monthly segment refresh using CDP (W156): system recalculates RFM (Recency-Frequency-Monetary) scores for all loyalty members using 12-month rolling transaction data from POS and ecommerce
Responsible (R): CX Analytics Lead
Accountable (A): CX Analytics Lead
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W673_Flow18</bpmn:incoming>
        <bpmn:outgoing>W673_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W673_Task8" name="System auto-classifies customers into predefined segments: Champions (top 5% by…">
        <bpmn:documentation>Step 2: System auto-classifies customers into predefined segments: Champions (top 5% by value and frequency), Loyal Customers (regular buyers, above-average spend), Potential Loyalists (recent first-time buyers), Promising (new with good initial basket), Need Attention (declining frequency), About to Sleep (declining recency), At Risk (formerly high-value, now dormant), Hibernating (long dormant), Lost (churn prediction &gt; 0.7 per W618)
Responsible (R): System
Accountable (A): CX Analytics Lead
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W673_Flow19</bpmn:incoming>
        <bpmn:outgoing>W673_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W673_Task9" name="For B2B: CX Analytics Lead applies separate segmentation: Enterprise (annual…">
        <bpmn:documentation>Step 3: For B2B: CX Analytics Lead applies separate segmentation: Enterprise (annual spend &gt; PHP 10M), Growth Accounts (PHP 1-10M), Emerging (PHP 100K-1M), Micro (&lt; PHP 100K), each sub-segmented by industry (construction, developer, government, reseller)
Responsible (R): CX Analytics Lead
Accountable (A): CX Analytics Lead
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W673_Flow20</bpmn:incoming>
        <bpmn:outgoing>W673_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W673_Task10" name="CX Analytics Lead publishes updated segment membership to CDP; segments…">
        <bpmn:documentation>Step 4: CX Analytics Lead publishes updated segment membership to CDP; segments available for campaign targeting via marketing automation
Responsible (R): CX Analytics Lead
Accountable (A): CDP Administrator
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W673_Flow21</bpmn:incoming>
        <bpmn:outgoing>W673_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W673_Task11" name="Marketing Campaign Manager requests segment-specific targeting for campaigns…">
        <bpmn:documentation>Step 5: Marketing Campaign Manager requests segment-specific targeting for campaigns per W83: defines target criteria (segment + geographic + product affinity), campaign channel, offer type, and expected volume
Responsible (R): Marketing Campaign Manager
Accountable (A): CX Analytics Lead
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W673_Flow22</bpmn:incoming>
        <bpmn:outgoing>W673_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W673_Task12" name="CX Analytics Lead validates target audience size, estimated reach, and overlap…">
        <bpmn:documentation>Step 6: CX Analytics Lead validates target audience size, estimated reach, and overlap with recent campaigns (preventing customer fatigue); provides segment insights (average basket, preferred categories, channel preference)
Responsible (R): CX Analytics Lead
Accountable (A): Marketing Campaign Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W673_Flow23</bpmn:incoming>
        <bpmn:outgoing>W673_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W673_Task13" name="CDP Administrator executes audience export to campaign channels (email, SMS…">
        <bpmn:documentation>Step 7: CDP Administrator executes audience export to campaign channels (email, SMS, app push, social media custom audiences) per RA 10173 consent verification
Responsible (R): CDP Administrator
Accountable (A): CX Analytics Lead
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W673_Flow24</bpmn:incoming>
        <bpmn:outgoing>W673_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W673_Task14" name="Monthly: CX Analytics Lead produces segment migration report: customers moving…">
        <bpmn:documentation>Step 8: Monthly: CX Analytics Lead produces segment migration report: customers moving between segments, segment growth/decline, and revenue contribution by segment; identifies actionable insights (e.g., &quot;2,000 Potential Loyalists ready for upgrade campaign&quot;)
Responsible (R): CX Analytics Lead
Accountable (A): Marketing Campaign Manager
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W673_Flow25</bpmn:incoming>
        <bpmn:outgoing>W673_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W673_End15" name="Complete">
        <bpmn:incoming>W673_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W673_Annotation16">
        <bpmn:text>Controls: - CTL-280 (ensure controlled execution — Customer Data &amp; CRM (PA-13.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: CX Analytics Lead</bpmn:text>
      </bpmn:textAnnotation>
