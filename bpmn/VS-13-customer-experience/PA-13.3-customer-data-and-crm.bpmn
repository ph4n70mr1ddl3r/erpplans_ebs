<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-13.3-customer-data-and-crm" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W65" name="W65. Customer Satisfaction Measurement" isExecutable="false">
      <bpmn:documentation>Trigger: Ongoing measurement program; continuous collection and periodic review
Frequency: Continuous survey collection; monthly reporting; quarterly deep analysis
Volume: Target: ~5,000–10,000 survey responses/month (from ~2.8M POS transactions ≈ 0.2–0.4% response rate)
Owner: Marketing — CS Manager
Participants: CS Manager, VP Store Operations, Store Managers, BI Analyst
Source: workflow W65 — Customer Satisfaction Measurement</bpmn:documentation>
      <bpmn:laneSet id="W65_LaneSet4">
        <bpmn:lane id="W65_Lane1" name="CS Manager">
        <bpmn:flowNodeRef>W65_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W65_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W65_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W65_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W65_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W65_Lane2" name="System">
        <bpmn:flowNodeRef>W65_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W65_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W65_Lane3" name="VP Store Operations">
        <bpmn:flowNodeRef>W65_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W65_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W65_Start5" name="Ongoing measurement program; continuous collection and periodic review">
        <bpmn:outgoing>W65_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W65_Task6" name="CS Manager configures survey instruments in system: POS receipt QR code…">
        <bpmn:documentation>Step 1: CS Manager configures survey instruments in system: POS receipt QR code generation, post-visit email templates with survey link, ecommerce post-order trigger
Responsible (R): CS Manager
Accountable (A): CMO
Duration: 4 hours (setup) + 1 hour/quarter (maintenance)</bpmn:documentation>
        <bpmn:incoming>W65_Flow16</bpmn:incoming>
        <bpmn:outgoing>W65_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W65_Task7" name="System collects survey responses continuously: POS receipt scans, email…">
        <bpmn:documentation>Step 2: System collects survey responses continuously: POS receipt scans, email click-throughs, ecommerce ratings; all responses linked to transaction and store (where applicable)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W65_Flow17</bpmn:incoming>
        <bpmn:outgoing>W65_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W65_Task8" name="System calculates monthly CSAT score (1–5 scale) and NPS (0–10 scale → %…">
        <bpmn:documentation>Step 3: System calculates monthly CSAT score (1–5 scale) and NPS (0–10 scale → % Promoters − % Detractors) per store and chain-wide
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W65_Flow18</bpmn:incoming>
        <bpmn:outgoing>W65_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W65_Task9" name="Monthly: CS Manager generates CSAT/NPS dashboard: scores by store, by…">
        <bpmn:documentation>Step 4: Monthly: CS Manager generates CSAT/NPS dashboard: scores by store, by department, trend vs. prior month and vs. target (≥ 85% CSAT per profile §12.3); flags stores below threshold for Store Manager attention
Responsible (R): CS Manager
Accountable (A): VP Store Operations
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W65_Flow19</bpmn:incoming>
        <bpmn:outgoing>W65_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W65_Task10" name="Monthly: VP Store Operations reviews CSAT/NPS scores in management committee…">
        <bpmn:documentation>Step 5: Monthly: VP Store Operations reviews CSAT/NPS scores in management committee meeting (W35 step 14); bottom 10 stores flagged for improvement action plans
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W65_Flow20</bpmn:incoming>
        <bpmn:outgoing>W65_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W65_Task11" name="Quarterly: CS Manager presents comprehensive satisfaction analysis: trends…">
        <bpmn:documentation>Step 6: Quarterly: CS Manager presents comprehensive satisfaction analysis: trends, root causes of low scores, complaint correlation (W41), mystery shopping findings; recommends specific improvement actions
Responsible (R): CS Manager
Accountable (A): CMO
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W65_Flow21</bpmn:incoming>
        <bpmn:outgoing>W65_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W65_Task12" name="Mystery shopping results: CS Manager shares individual store reports with Store…">
        <bpmn:documentation>Step 7: Mystery shopping results: CS Manager shares individual store reports with Store Managers; Store Manager develops corrective action for identified gaps; results factored into Store Manager performance evaluation
Responsible (R): CS Manager / Store Manager
Accountable (A): VP Store Operations
Duration: Per quarter</bpmn:documentation>
        <bpmn:incoming>W65_Flow22</bpmn:incoming>
        <bpmn:outgoing>W65_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W65_End13" name="Complete">
        <bpmn:incoming>W65_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W65_Annotation14">
        <bpmn:text>Controls: - CTL-280 (ensure controlled execution — Customer Data &amp; CRM (PA-13.3).) | - operational: Marketing — CS Manager review and approval gate
Owner: Marketing — CS Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W65_Assoc15" sourceRef="W65_Annotation14" targetRef="W65_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W65_Flow16" sourceRef="W65_Start5" targetRef="W65_Task6" />
      <bpmn:sequenceFlow id="W65_Flow17" sourceRef="W65_Task6" targetRef="W65_Task7" />
      <bpmn:sequenceFlow id="W65_Flow18" sourceRef="W65_Task7" targetRef="W65_Task8" />
      <bpmn:sequenceFlow id="W65_Flow19" sourceRef="W65_Task8" targetRef="W65_Task9" />
      <bpmn:sequenceFlow id="W65_Flow20" sourceRef="W65_Task9" targetRef="W65_Task10" />
      <bpmn:sequenceFlow id="W65_Flow21" sourceRef="W65_Task10" targetRef="W65_Task11" />
      <bpmn:sequenceFlow id="W65_Flow22" sourceRef="W65_Task11" targetRef="W65_Task12" />
      <bpmn:sequenceFlow id="W65_Flow23" sourceRef="W65_Task12" targetRef="W65_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W65_diag">
      <bpmndi:BPMNPlane id="W65_plane" bpmnElement="W_W65">
        <bpmndi:BPMNShape id="W65_Lane1_di" bpmnElement="W65_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W65_Lane2_di" bpmnElement="W65_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W65_Lane3_di" bpmnElement="W65_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W65_Task6_di" bpmnElement="W65_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W65_Task7_di" bpmnElement="W65_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W65_Task8_di" bpmnElement="W65_Task8"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W65_Task9_di" bpmnElement="W65_Task9"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W65_Task10_di" bpmnElement="W65_Task10"><dc:Bounds x="1240" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W65_Task11_di" bpmnElement="W65_Task11"><dc:Bounds x="1450" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W65_Task12_di" bpmnElement="W65_Task12"><dc:Bounds x="1660" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W65_Start5_di" bpmnElement="W65_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W65_End13_di" bpmnElement="W65_End13"><dc:Bounds x="1890" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W65_Annotation14_di" bpmnElement="W65_Annotation14"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W65_Flow16_di" bpmnElement="W65_Flow16"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W65_Flow17_di" bpmnElement="W65_Flow17"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W65_Flow18_di" bpmnElement="W65_Flow18"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W65_Flow19_di" bpmnElement="W65_Flow19"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W65_Flow20_di" bpmnElement="W65_Flow20"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W65_Flow21_di" bpmnElement="W65_Flow21"><di:waypoint x="1420" y="505" /><di:waypoint x="1450" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W65_Flow22_di" bpmnElement="W65_Flow22"><di:waypoint x="1630" y="165" /><di:waypoint x="1660" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W65_Flow23_di" bpmnElement="W65_Flow23"><di:waypoint x="1840" y="165" /><di:waypoint x="1890" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W65_Assoc15_di" bpmnElement="W65_Assoc15"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W87" name="W87. Customer Feedback-to-Action Loop" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly complaint analytics review (W41.11); or quarterly CSAT/NPS deep analysis (W65.6); or recurring pattern identified by BI Analyst
Frequency: Monthly review; quarterly action planning; annual strategic review
Volume: ~2,000–3,000 complaints/month + ~5,000–10,000 survey responses/month feeding into the loop
Owner: CS Manager (operational); VP Store Operations (store-level actions); CMO (strategic)
Participants: CS Manager, VP Store Operations, Regional Managers, Category Managers, Training Officer, BI Analyst, CMO
Source: workflow W87 — Customer Feedback-to-Action Loop</bpmn:documentation>
      <bpmn:laneSet id="W87_LaneSet6">
        <bpmn:lane id="W87_Lane1" name="CS Manager">
        <bpmn:flowNodeRef>W87_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W87_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W87_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W87_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W87_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W87_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W87_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W87_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W87_Lane2" name="Department Head">
        <bpmn:flowNodeRef>W87_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W87_Lane3" name="Training Officer">
        <bpmn:flowNodeRef>W87_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W87_Lane4" name="Category Manager">
        <bpmn:flowNodeRef>W87_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W87_Lane5" name="CMO">
        <bpmn:flowNodeRef>W87_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W87_Task19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W87_End20</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W87_Start7" name="Monthly complaint analytics review (W41.11); or quarterly CSAT/NPS deep analysis (W65.6)…">
        <bpmn:outgoing>W87_Flow23</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W87_Task8" name="CS Manager compiles monthly feedback synthesis from: (a) W41 complaint…">
        <bpmn:documentation>Step 1: CS Manager compiles monthly feedback synthesis from: (a) W41 complaint analytics — top 5 complaint categories, top 10 stores by complaint volume, recurring root causes, unresolved escalations, (b) W65 CSAT/NPS scores — stores below threshold (&lt; 85% CSAT), trending decline, specific department-level issues from survey comments, (c) W17 loyalty data — points redemption patterns, tier movement, enrollment drop-offs, loyalty program feedback, (d) social media sentiment — review of mentions, reviews, and direct messages aggregated by social media monitoring tool, (e) W58 corporate account feedback — Sales Rep reports of customer dissatisfaction with pricing, delivery, or service
Responsible (R): CS Manager
Accountable (A): CMO
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W87_Flow23</bpmn:incoming>
        <bpmn:outgoing>W87_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W87_Task9" name="Quick wins">
        <bpmn:documentation>Step 2: CS Manager categorizes feedback into actionable themes: (a) Quick wins — individual issues resolvable by a single department within 1 week (e.g., specific store cleanliness issue, individual staff behavior, specific SKU pricing error), (b) Process improvements — recurring issues requiring process or procedure changes across multiple locations (e.g., BOPIS pickup SLA not met consistently, DSD receiving causing customer wait times, returns policy confusion), (c) Training needs — patterns indicating skill or knowledge gaps (e.g., product knowledge complaints in specific departments, POS error rates by store), (d) Product/service changes — feedback suggesting product assortment gaps, new service needs, or pricing concerns, (e) Strategic themes — fundamental customer experience shifts (e.g., channel preference changes, competitive threats, brand perception issues)
Responsible (R): CS Manager
Accountable (A): CMO
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W87_Flow24</bpmn:incoming>
        <bpmn:outgoing>W87_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W87_Task10" name="CS Manager assigns quick wins to responsible department with specific action…">
        <bpmn:documentation>Step 3: CS Manager assigns quick wins to responsible department with specific action items and 1-week resolution SLA: (a) store-level issues → Regional Manager → Store Manager, (b) product issues → Category Manager, (c) pricing issues → Pricing Analyst, (d) delivery issues → DC Dispatch / Fleet Manager, (e) website/app issues → Ecom Team
Responsible (R): CS Manager
Accountable (A): Department Head
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W87_Flow25</bpmn:incoming>
        <bpmn:outgoing>W87_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W87_Task11" name="CS Manager follows up on prior month&#x27;s quick win resolution status; reports…">
        <bpmn:documentation>Step 4: CS Manager follows up on prior month&#x27;s quick win resolution status; reports completion rate to CMO; unresolved items escalated to department head
Responsible (R): CS Manager
Accountable (A): CMO
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W87_Flow26</bpmn:incoming>
        <bpmn:outgoing>W87_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W87_Task12" name="CS Manager prepares quarterly customer experience improvement report: (a)…">
        <bpmn:documentation>Step 5: CS Manager prepares quarterly customer experience improvement report: (a) complaint trend analysis — month-over-month volume, resolution rate, SLA compliance trend, (b) CSAT/NPS trend with store heat map, (c) top 5 recurring root causes with frequency and business impact (estimated revenue at risk from unresolved issues), (d) process improvement recommendations — specific process changes with expected impact, (e) training recommendations — specific programs with target audience, (f) product/service change recommendations — new products, discontinued products, service enhancements based on customer demand
Responsible (R): CS Manager
Accountable (A): CMO
Duration: 8 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W87_Flow27</bpmn:incoming>
        <bpmn:outgoing>W87_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W87_Task13" name="CS Manager presents quarterly report to cross-functional customer experience…">
        <bpmn:documentation>Step 6: CS Manager presents quarterly report to cross-functional customer experience review meeting — attended by VP Store Operations, VP Merchandising, Training Officer, BI Analyst, and CMO; meeting reviews each recommendation and assigns owners, deadlines, and success metrics
Responsible (R): CS Manager / CMO
Accountable (A): COO
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W87_Flow28</bpmn:incoming>
        <bpmn:outgoing>W87_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W87_Task14" name="Process improvements">
        <bpmn:documentation>Step 7: Process improvements: VP Store Operations (for operational changes), VP Merchandising (for product/pricing changes), or CIO (for system changes) implements approved process improvements; changes documented in system with expected completion date; CS Manager tracks implementation status
Responsible (R): Department Head
Accountable (A): COO
Duration: Varies</bpmn:documentation>
        <bpmn:incoming>W87_Flow29</bpmn:incoming>
        <bpmn:outgoing>W87_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W87_Task15" name="Training needs">
        <bpmn:documentation>Step 8: Training needs: Training Officer incorporates approved training recommendations into W51 training calendar — develops targeted training materials for identified gaps (e.g., product knowledge for specific departments, returns handling refresher for CSRs, delivery communication for ecommerce team); training completion tracked and reported to CS Manager
Responsible (R): Training Officer
Accountable (A): HR Head
Duration: Per W51</bpmn:documentation>
        <bpmn:incoming>W87_Flow30</bpmn:incoming>
        <bpmn:outgoing>W87_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W87_Task16" name="Product/service changes">
        <bpmn:documentation>Step 9: Product/service changes: Category Managers review product feedback recommendations during next W1 quarterly assortment review; CMO reviews service enhancement proposals for feasibility and budget; approved changes implemented through existing workflows (W1, W13, W40, W58)
Responsible (R): Category Manager / CMO
Accountable (A): VP Merchandising / COO
Duration: Per existing workflows</bpmn:documentation>
        <bpmn:incoming>W87_Flow31</bpmn:incoming>
        <bpmn:outgoing>W87_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W87_Task17" name="CS Manager tracks all quarterly action items to completion; reports status at…">
        <bpmn:documentation>Step 10: CS Manager tracks all quarterly action items to completion; reports status at next quarterly review; closed action items archived with outcome measurement (did the action reduce complaints or improve CSAT?)
Responsible (R): CS Manager
Accountable (A): CMO
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W87_Flow32</bpmn:incoming>
        <bpmn:outgoing>W87_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W87_Task18" name="CMO and CS Manager prepare annual customer experience strategic review: (a)…">
        <bpmn:documentation>Step 11: CMO and CS Manager prepare annual customer experience strategic review: (a) year-over-year CSAT/NPS trend, (b) complaint volume and resolution efficiency trend, (c) customer retention rate (loyalty member active rate, trade account retention), (d) voice-of-customer themes for the year, (e) competitive customer experience benchmarking (where available), (f) investment recommendations — technology, staffing, training, or service enhancements to improve customer experience, (g) proposed customer experience KPIs for next year
Responsible (R): CMO / CS Manager
Accountable (A): CEO
Duration: 8 hours/year</bpmn:documentation>
        <bpmn:incoming>W87_Flow33</bpmn:incoming>
        <bpmn:outgoing>W87_Flow34</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W87_Task19" name="CMO presents annual CX review to CEO and management committee; approved…">
        <bpmn:documentation>Step 12: CMO presents annual CX review to CEO and management committee; approved investments included in next year&#x27;s budget (W26)
Responsible (R): CMO
Accountable (A): CEO
Duration: 1 hour/year</bpmn:documentation>
        <bpmn:incoming>W87_Flow34</bpmn:incoming>
        <bpmn:outgoing>W87_Flow35</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W87_End20" name="Complete">
        <bpmn:incoming>W87_Flow35</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W87_Annotation21">
        <bpmn:text>Controls: - CTL-280 (ensure controlled execution — Customer Data &amp; CRM (PA-13.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: CS Manager (operational); VP Store Operations (store-level actions); CMO (strategic)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W87_Assoc22" sourceRef="W87_Annotation21" targetRef="W87_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W87_Flow23" sourceRef="W87_Start7" targetRef="W87_Task8" />
      <bpmn:sequenceFlow id="W87_Flow24" sourceRef="W87_Task8" targetRef="W87_Task9" />
      <bpmn:sequenceFlow id="W87_Flow25" sourceRef="W87_Task9" targetRef="W87_Task10" />
      <bpmn:sequenceFlow id="W87_Flow26" sourceRef="W87_Task10" targetRef="W87_Task11" />
      <bpmn:sequenceFlow id="W87_Flow27" sourceRef="W87_Task11" targetRef="W87_Task12" />
      <bpmn:sequenceFlow id="W87_Flow28" sourceRef="W87_Task12" targetRef="W87_Task13" />
      <bpmn:sequenceFlow id="W87_Flow29" sourceRef="W87_Task13" targetRef="W87_Task14" />
      <bpmn:sequenceFlow id="W87_Flow30" sourceRef="W87_Task14" targetRef="W87_Task15" />
      <bpmn:sequenceFlow id="W87_Flow31" sourceRef="W87_Task15" targetRef="W87_Task16" />
      <bpmn:sequenceFlow id="W87_Flow32" sourceRef="W87_Task16" targetRef="W87_Task17" />
      <bpmn:sequenceFlow id="W87_Flow33" sourceRef="W87_Task17" targetRef="W87_Task18" />
      <bpmn:sequenceFlow id="W87_Flow34" sourceRef="W87_Task18" targetRef="W87_Task19" />
      <bpmn:sequenceFlow id="W87_Flow35" sourceRef="W87_Task19" targetRef="W87_End20" />
    </bpmn:process>
