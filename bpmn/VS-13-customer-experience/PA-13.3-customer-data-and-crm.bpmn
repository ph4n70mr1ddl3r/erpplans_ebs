    <bpmn:process id="W_W756" name="W756. Customer Post-Purchase Follow-Up &amp; Satisfaction Verification" isExecutable="false">
      <bpmn:documentation>Trigger: Customer completes high-value purchase (&gt; PHP 10,000) or installation/service order (W138/W544)
Frequency: Daily; triggered by qualifying transactions
Volume: ~4,500–5,000 qualifying transactions/day chain-wide (~5% of daily transactions by count, ~40% by value)
Owner: Customer Service Representative
Participants: CSR, Customer, Installation/Service Partner (if applicable)
Source: workflow W756 — Customer Post-Purchase Follow-Up &amp; Satisfaction Verification</bpmn:documentation>
      <bpmn:laneSet id="W756_LaneSet4">
        <bpmn:lane id="W756_Lane1" name="System">
        <bpmn:flowNodeRef>W756_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W756_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W756_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W756_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W756_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W756_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W756_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W756_Lane2" name="CSR">
        <bpmn:flowNodeRef>W756_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W756_Lane3" name="Customer Service Manager">
        <bpmn:flowNodeRef>W756_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W756_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W756_Start5" name="Customer completes high-value purchase (&gt; PHP 10,000) or installation/service order…">
        <bpmn:outgoing>W756_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W756_Task6" name="Follow-up list generation — System generates daily follow-up list: (a)…">
        <bpmn:documentation>Step 1: Follow-up list generation — System generates daily follow-up list: (a) transactions &gt; PHP 10,000 in past 48–72 hours, (b) completed installation/service orders (W138) in past 24–48 hours, (c) special orders (W545) picked up in past 48 hours
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W756_Flow17</bpmn:incoming>
        <bpmn:outgoing>W756_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W756_Task7" name="Channel selection — System selects follow-up channel based on customer…">
        <bpmn:documentation>Step 2: Channel selection — System selects follow-up channel based on customer preference: (a) SMS with satisfaction link (most common), (b) phone call for transactions &gt; PHP 50,000 or installation completion, (c) email for project/account customers
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W756_Flow18</bpmn:incoming>
        <bpmn:outgoing>W756_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W756_Task8" name="Automated satisfaction survey — System sends 3-question survey: (a) &quot;How would…">
        <bpmn:documentation>Step 3: Automated satisfaction survey — System sends 3-question survey: (a) &quot;How would you rate your experience?&quot; (1–5), (b) &quot;Did the product/service meet your expectations?&quot; (Yes/Partially/No), (c) &quot;Would you recommend BuildRight to a friend?&quot; (Yes/No)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W756_Flow19</bpmn:incoming>
        <bpmn:outgoing>W756_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W756_Task9" name="Manual follow-up (high-value) — For transactions &gt; PHP 50,000 or installation…">
        <bpmn:documentation>Step 4: Manual follow-up (high-value) — For transactions &gt; PHP 50,000 or installation orders: CSR calls customer within 48 hours; follows structured script: product satisfaction, installation quality (if applicable), any issues or concerns, recommendation for complementary products
Responsible (R): CSR
Accountable (A): Department Supervisor
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W756_Flow20</bpmn:incoming>
        <bpmn:outgoing>W756_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W756_Task10" name="Issue escalation — If customer reports dissatisfaction (survey rating ≤ 2 or…">
        <bpmn:documentation>Step 5: Issue escalation — If customer reports dissatisfaction (survey rating ≤ 2 or negative phone call): auto-generates complaint ticket in W41/W258 for resolution; if product defect, triggers W33 warranty or W110 supplier CAPA
Responsible (R): System / CSR
Accountable (A): Customer Service Manager
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W756_Flow21</bpmn:incoming>
        <bpmn:outgoing>W756_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W756_Task11" name="Positive follow-up action — If customer is satisfied: (a) prompt for product…">
        <bpmn:documentation>Step 6: Positive follow-up action — If customer is satisfied: (a) prompt for product review on W510 ecommerce, (b) suggest loyalty program benefits if not yet enrolled (W551), (c) recommend complementary products based on purchase
Responsible (R): System / CSR
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W756_Flow22</bpmn:incoming>
        <bpmn:outgoing>W756_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W756_Task12" name="Response analytics — System tracks: response rate, satisfaction score…">
        <bpmn:documentation>Step 7: Response analytics — System tracks: response rate, satisfaction score distribution, issue rate, escalation rate, review generation rate; feeds to W156 CDP for customer profiling
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W756_Flow23</bpmn:incoming>
        <bpmn:outgoing>W756_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W756_Task13" name="Monthly follow-up program review — Customer Service Manager reviews program…">
        <bpmn:documentation>Step 8: Monthly follow-up program review — Customer Service Manager reviews program effectiveness: response rate trends, satisfaction scores, issue resolution rate, repeat purchase rate for followed-up customers vs. control group
Responsible (R): Customer Service Manager
Accountable (A): Head of Customer Service
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W756_Flow24</bpmn:incoming>
        <bpmn:outgoing>W756_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W756_End14" name="Complete">
        <bpmn:incoming>W756_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W756_Annotation15">
        <bpmn:text>Controls: - CTL-280 (ensure controlled execution — Customer Data &amp; CRM (PA-13.3).) | - operational: Customer Service Representative review and approval gate
Owner: Customer Service Representative</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W756_Assoc16" sourceRef="W756_Annotation15" targetRef="W756_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W756_Flow17" sourceRef="W756_Start5" targetRef="W756_Task6" />
      <bpmn:sequenceFlow id="W756_Flow18" sourceRef="W756_Task6" targetRef="W756_Task7" />
      <bpmn:sequenceFlow id="W756_Flow19" sourceRef="W756_Task7" targetRef="W756_Task8" />
      <bpmn:sequenceFlow id="W756_Flow20" sourceRef="W756_Task8" targetRef="W756_Task9" />
      <bpmn:sequenceFlow id="W756_Flow21" sourceRef="W756_Task9" targetRef="W756_Task10" />
      <bpmn:sequenceFlow id="W756_Flow22" sourceRef="W756_Task10" targetRef="W756_Task11" />
      <bpmn:sequenceFlow id="W756_Flow23" sourceRef="W756_Task11" targetRef="W756_Task12" />
      <bpmn:sequenceFlow id="W756_Flow24" sourceRef="W756_Task12" targetRef="W756_Task13" />
      <bpmn:sequenceFlow id="W756_Flow25" sourceRef="W756_Task13" targetRef="W756_End14" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W756_diag">
      <bpmndi:BPMNPlane id="W756_plane" bpmnElement="W_W756">
        <bpmndi:BPMNShape id="W756_Lane1_di" bpmnElement="W756_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2000" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W756_Lane2_di" bpmnElement="W756_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="2000" height="170" /></bpmndi:BPMNShape>
