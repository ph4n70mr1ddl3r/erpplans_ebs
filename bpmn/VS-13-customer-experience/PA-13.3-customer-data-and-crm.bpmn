    <bpmn:process id="W_W675" name="W675. Customer Data Platform Daily Operations &amp; Data Quality Management" isExecutable="false">
      <bpmn:documentation>Trigger: Daily CDP health monitoring; ongoing data quality management
Frequency: Daily health check; weekly data quality review; monthly stewardship reporting
Volume: ~600,000 loyalty records + ~5,400 B2B records + ~2.8M monthly POS transactions + ~42,900 monthly ecommerce orders feeding into CDP
Owner: CDP Administrator
Participants: CX Analytics Lead, IT Data Engineer, Marketing Campaign Manager
Source: workflow W675 — Customer Data Platform Daily Operations &amp; Data Quality Management</bpmn:documentation>
      <bpmn:laneSet id="W675_LaneSet3">
        <bpmn:lane id="W675_Lane1" name="CDP Administrator">
        <bpmn:flowNodeRef>W675_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W675_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W675_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W675_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W675_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W675_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W675_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W675_Lane2" name="System">
        <bpmn:flowNodeRef>W675_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W675_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W675_Start4" name="Daily CDP health monitoring; ongoing data quality management">
        <bpmn:outgoing>W675_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W675_Task5" name="CDP Administrator performs daily CDP health check: overnight data pipeline…">
        <bpmn:documentation>Step 1: CDP Administrator performs daily CDP health check: overnight data pipeline completion (POS transactions, ecommerce orders, loyalty transactions, customer service tickets), identity resolution run status, segment refresh status, data freshness verification (max 24-hour lag)
Responsible (R): CDP Administrator
Accountable (A): CDP Administrator
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W675_Flow15</bpmn:incoming>
        <bpmn:outgoing>W675_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W675_Task6" name="System auto-flags data quality exceptions: records failing validation (missing…">
        <bpmn:documentation>Step 2: System auto-flags data quality exceptions: records failing validation (missing mobile, invalid email format, TIN format error for B2B), identity resolution conflicts (multiple profiles matching same mobile/email), duplicate detection alerts (W619 queue)
Responsible (R): System
Accountable (A): CDP Administrator
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W675_Flow16</bpmn:incoming>
        <bpmn:outgoing>W675_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W675_Task7" name="CDP Administrator triages exceptions: bulk-fixes formatting issues, routes…">
        <bpmn:documentation>Step 3: CDP Administrator triages exceptions: bulk-fixes formatting issues, routes identity resolution conflicts to CX Analytics Lead for manual review, escalates data pipeline failures to IT Data Engineer per W614
Responsible (R): CDP Administrator
Accountable (A): CDP Administrator
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W675_Flow17</bpmn:incoming>
        <bpmn:outgoing>W675_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W675_Task8" name="CDP Administrator processes deduplication queue: reviews &quot;Probable&quot; matches…">
        <bpmn:documentation>Step 4: CDP Administrator processes deduplication queue: reviews &quot;Probable&quot; matches (80-95% confidence) per W619, applies survivorship rules, merges confirmed duplicates
Responsible (R): CDP Administrator
Accountable (A): CX Analytics Lead
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W675_Flow18</bpmn:incoming>
        <bpmn:outgoing>W675_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W675_Task9" name="Weekly: CDP Administrator produces data quality scorecard: completeness (%…">
        <bpmn:documentation>Step 5: Weekly: CDP Administrator produces data quality scorecard: completeness (% records with all required fields), validity (% passing format rules), uniqueness (duplicate rate), timeliness (data freshness), accuracy (sample-based verification against source systems)
Responsible (R): CDP Administrator
Accountable (A): CX Analytics Lead
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W675_Flow19</bpmn:incoming>
        <bpmn:outgoing>W675_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W675_Task10" name="Monthly: CDP Administrator presents data quality report to CX Analytics Lead…">
        <bpmn:documentation>Step 6: Monthly: CDP Administrator presents data quality report to CX Analytics Lead and Marketing Campaign Manager; highlights trends, data quality improvement initiatives, and impact on campaign targeting accuracy
Responsible (R): CDP Administrator
Accountable (A): Marketing Campaign Manager
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W675_Flow20</bpmn:incoming>
        <bpmn:outgoing>W675_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W675_Task11" name="Quarterly: CDP Administrator conducts comprehensive data cleanse: purges…">
        <bpmn:documentation>Step 7: Quarterly: CDP Administrator conducts comprehensive data cleanse: purges records with no activity &gt; 36 months (per RA 10173 retention requirements), updates consent status, validates B2B records against SEC registration data, refreshes geographic data per MDM-019 Philippine hierarchy
Responsible (R): CDP Administrator
Accountable (A): CX Analytics Lead
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W675_Flow21</bpmn:incoming>
        <bpmn:outgoing>W675_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W675_End12" name="Complete">
        <bpmn:incoming>W675_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W675_Annotation13">
        <bpmn:text>Controls: - CTL-280 (ensure controlled execution — Customer Data &amp; CRM (PA-13.3).) | - operational: CDP Administrator review and approval gate
Owner: CDP Administrator</bpmn:text>
      </bpmn:textAnnotation>
