    <bpmn:process id="W_W1713" name="W1713. Asset Register Cleanup &amp; Archiving" isExecutable="false">
      <bpmn:documentation>Trigger: Post-physical verification (W1706); annual register maintenance
Frequency: Annual (post-verification) + ongoing
Volume: ~500–1,000 register cleanups/year
Owner: Fixed Asset Accountant
Participants: Fixed Asset Accountant, Accounting Manager
Source: workflow W1713 — Asset Register Cleanup &amp; Archiving</bpmn:documentation>
      <bpmn:laneSet id="W1713_LaneSet3">
        <bpmn:lane id="W1713_Lane1" name="Fixed Asset Accountant">
        <bpmn:flowNodeRef>W1713_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1713_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1713_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1713_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1713_Lane2" name="System">
        <bpmn:flowNodeRef>W1713_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1713_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1713_Start4" name="Post-physical verification (W1706); annual register maintenance">
        <bpmn:outgoing>W1713_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1713_Task5" name="Post-verification cleanup actions: (a) fully depreciated assets still…">
        <bpmn:documentation>Step 1: Post-verification cleanup actions: (a) fully depreciated assets still physically present → change status to &quot;Fully Depreciated — Active&quot; (remain in register for insurance and accountability purposes), (b) fully depreciated assets no longer present → process retirement per W1708, (c) duplicate asset records → merge with audit trail, (d) assets with incorrect location → update location per actual, (e) assets with incorrect classification → reclassify per W1691
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 2–3 days/year</bpmn:documentation>
        <bpmn:incoming>W1713_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1713_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1713_Task6" name="System archives retired/disposed assets: (a) assets moved from active register…">
        <bpmn:documentation>Step 2: System archives retired/disposed assets: (a) assets moved from active register to archived register, (b) archived records retained for 10 years per BIR requirement, (c) archived records searchable but excluded from active reports and depreciation runs, (d) GL reconciliation includes both active and archived totals for audit completeness
Responsible (R): System
Accountable (A): Fixed Asset Accountant
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1713_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1713_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1713_Task7" name="Annual: Fixed Asset Accountant reviews archived register for records eligible…">
        <bpmn:documentation>Step 3: Annual: Fixed Asset Accountant reviews archived register for records eligible for permanent deletion (&gt; 10 years since disposal); submits deletion list to Accounting Manager for approval; deleted records logged in deletion journal for audit trail
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 1 day/year</bpmn:documentation>
        <bpmn:incoming>W1713_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1713_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1713_Task8" name="Policy document update: if verification or cleanup reveals systemic issues…">
        <bpmn:documentation>Step 4: Policy document update: if verification or cleanup reveals systemic issues (e.g., consistent failure to register assets, frequent tag damage), Fixed Asset Accountant updates fixed asset policy and procedures accordingly
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: As needed</bpmn:documentation>
        <bpmn:incoming>W1713_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1713_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1713_End9" name="Complete">
        <bpmn:incoming>W1713_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1713_Annotation10">
        <bpmn:text>Controls: - CTL-348 (ensure controlled execution — Physical Verification &amp; Disposal (PA-35.3).) | - operational: Fixed Asset Accountant review and approval gate; periodic reconciliation against source documents
Owner: Fixed Asset Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1713_Assoc11" sourceRef="W1713_Annotation10" targetRef="W1713_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1713_Flow12" sourceRef="W1713_Start4" targetRef="W1713_Task5" />
      <bpmn:sequenceFlow id="W1713_Flow13" sourceRef="W1713_Task5" targetRef="W1713_Task6" />
      <bpmn:sequenceFlow id="W1713_Flow14" sourceRef="W1713_Task6" targetRef="W1713_Task7" />
      <bpmn:sequenceFlow id="W1713_Flow15" sourceRef="W1713_Task7" targetRef="W1713_Task8" />
