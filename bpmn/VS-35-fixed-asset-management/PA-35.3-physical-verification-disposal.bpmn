    <bpmn:process id="W_W1709" name="W1709. Asset Write-Off Due to Loss, Theft or Damage" isExecutable="false">
      <bpmn:documentation>Trigger: Asset confirmed missing (physical verification per W1706/W1707), stolen (reported incident), or damaged beyond repair (natural disaster, accident)
Frequency: ~20–50 write-offs/year
Volume: Low volume but potentially high value per incident
Owner: Fixed Asset Accountant
Participants: Fixed Asset Accountant, Loss Prevention, Location Manager, CFO, Insurance &amp; Risk Officer
Source: workflow W1709 — Asset Write-Off Due to Loss, Theft or Damage</bpmn:documentation>
      <bpmn:laneSet id="W1709_LaneSet5">
        <bpmn:lane id="W1709_Lane1" name="Location Manager">
        <bpmn:flowNodeRef>W1709_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1709_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1709_Lane2" name="Loss Prevention">
        <bpmn:flowNodeRef>W1709_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1709_Lane3" name="Fixed Asset Accountant">
        <bpmn:flowNodeRef>W1709_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1709_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1709_Lane4" name="Accounting Manager">
        <bpmn:flowNodeRef>W1709_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1709_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1709_Start6" name="Asset confirmed missing (physical verification per W1706/W1707), stolen (reported…">
        <bpmn:outgoing>W1709_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1709_Task7" name="Location Manager or Loss Prevention reports asset loss/theft/damage incident…">
        <bpmn:documentation>Step 1: Location Manager or Loss Prevention reports asset loss/theft/damage incident: (a) incident report with date, location, circumstances, (b) photos of damage (if applicable), (c) police report (for theft), (d) initial assessment of whether asset is recoverable or must be written off
Responsible (R): Location Manager / Loss Prevention
Accountable (A): Fixed Asset Accountant
Duration: 1–2 hours/incident</bpmn:documentation>
        <bpmn:incoming>W1709_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1709_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1709_Task8" name="Loss Prevention investigates theft cases: (a) CCTV review, (b) employee…">
        <bpmn:documentation>Step 2: Loss Prevention investigates theft cases: (a) CCTV review, (b) employee investigation if internal theft suspected, (c) coordination with police; report forwarded to Fixed Asset Accountant with investigation conclusion
Responsible (R): Loss Prevention
Accountable (A): Head of Internal Audit
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1709_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1709_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1709_Task9" name="Fixed Asset Accountant prepares write-off recommendation: (a) asset details…">
        <bpmn:documentation>Step 3: Fixed Asset Accountant prepares write-off recommendation: (a) asset details: description, original cost, net book value, (b) reason for write-off, (c) insurance claim status (if applicable), (d) expected recovery (insurance proceeds, police recovery), (e) net loss to be recognized
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 30 min/asset</bpmn:documentation>
        <bpmn:incoming>W1709_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1709_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1709_Task10" name="Approval per tiered authority: (a) net book value &lt; PHP 50K: Accounting Manager…">
        <bpmn:documentation>Step 4: Approval per tiered authority: (a) net book value &lt; PHP 50K: Accounting Manager approval, (b) PHP 50K–500K: CFO approval, (c) &gt; PHP 500K: CEO approval, (d) &gt; PHP 1M: Board notification
Responsible (R): Accounting Manager / CFO / CEO
Accountable (A): Per tier
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1709_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1709_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1709_Task11" name="Write-off processed in system: (a) asset derecognized from register, (b) net…">
        <bpmn:documentation>Step 5: Write-off processed in system: (a) asset derecognized from register, (b) net book value written off as loss on disposal, (c) if insurance claim pending: record receivable for expected recovery, (d) when insurance settles: cash received, receivable cleared, any difference adjusted
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 15 min/asset</bpmn:documentation>
        <bpmn:incoming>W1709_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1709_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1709_End12" name="Complete">
        <bpmn:incoming>W1709_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1709_Annotation13">
        <bpmn:text>Controls: - CTL-348 (ensure controlled execution — Physical Verification &amp; Disposal (PA-35.3).) | - operational: Fixed Asset Accountant review and approval gate
Owner: Fixed Asset Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1709_Assoc14" sourceRef="W1709_Annotation13" targetRef="W1709_Start6" associationDirection="None" />
