        <bpmndi:BPMNShape id="W1706_Task13_di" bpmnElement="W1706_Task13"><dc:Bounds x="1450" y="805" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1706_Start7_di" bpmnElement="W1706_Start7"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1706_End14_di" bpmnElement="W1706_End14"><dc:Bounds x="1680" y="827" width="36" height="36" /></bpmndi:BPMNShape>
