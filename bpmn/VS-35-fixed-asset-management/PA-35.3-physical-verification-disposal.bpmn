    <bpmn:process id="W_W1710" name="W1710. Asset Sale, Trade-In &amp; Salvage Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Asset retirement with recoverable value (W1708)
Frequency: ~30–60 sales/trade-ins/year
Volume: Low volume but important for value recovery
Owner: Fixed Asset Accountant
Participants: Fixed Asset Accountant, Purchasing (for trade-in negotiation), Maintenance (for salvage), Treasury (for proceeds)
Source: workflow W1710 — Asset Sale, Trade-In &amp; Salvage Processing</bpmn:documentation>
      <bpmn:laneSet id="W1710_LaneSet4">
        <bpmn:lane id="W1710_Lane1" name="Fixed Asset Accountant">
        <bpmn:flowNodeRef>W1710_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1710_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1710_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1710_Lane2" name="Purchasing">
        <bpmn:flowNodeRef>W1710_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1710_Lane3" name="Treasury">
        <bpmn:flowNodeRef>W1710_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1710_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1710_Start5" name="Asset retirement with recoverable value (W1708)">
        <bpmn:outgoing>W1710_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1710_Task6" name="Determine disposal method based on asset type and condition: (a) vehicles —…">
        <bpmn:documentation>Step 1: Determine disposal method based on asset type and condition: (a) vehicles — trade-in to dealer on new vehicle purchase or sell via auction, (b) IT equipment — certified data destruction then sell to e-waste recycler, (c) store fixtures — sell to used fixture dealer or scrap, (d) forklifts/DC equipment — sell to equipment dealer, (e) POS terminals — return to vendor or sell to refurbisher
Responsible (R): Fixed Asset Accountant / Purchasing
Accountable (A): Accounting Manager
Duration: 1–2 hours/asset</bpmn:documentation>
        <bpmn:incoming>W1710_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1710_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1710_Task7" name="Obtain fair market value: (a) for high-value assets (≥ PHP 100K): minimum 2…">
        <bpmn:documentation>Step 2: Obtain fair market value: (a) for high-value assets (≥ PHP 100K): minimum 2 quotes or auction listing, (b) for trade-in: vendor provides trade-in value vs. separate sale comparison, (c) for scrap: current scrap metal/e-waste rates, (d) document valuation basis for audit trail
Responsible (R): Purchasing / Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W1710_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1710_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1710_Task8" name="Execute sale/trade-in: (a) prepare sales documentation (invoice or trade-in…">
        <bpmn:documentation>Step 3: Execute sale/trade-in: (a) prepare sales documentation (invoice or trade-in credit memo), (b) for trade-in: credit applied to new asset purchase invoice, (c) for sale: issue sales invoice, collect payment, (d) for scrap: weigh and apply contracted rates, issue delivery receipt
Responsible (R): Fixed Asset Accountant / Purchasing
Accountable (A): Accounting Manager
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1710_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1710_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1710_Task9" name="Treasury receives proceeds (if cash sale); Fixed Asset Accountant processes…">
        <bpmn:documentation>Step 4: Treasury receives proceeds (if cash sale); Fixed Asset Accountant processes disposal per W1708 step 4 and gain/loss recognition per W1711
Responsible (R): Treasury / Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 15 min/asset</bpmn:documentation>
        <bpmn:incoming>W1710_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1710_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1710_End10" name="Complete">
        <bpmn:incoming>W1710_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1710_Annotation11">
        <bpmn:text>Controls: - CTL-348 (ensure controlled execution — Physical Verification &amp; Disposal (PA-35.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Fixed Asset Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1710_Assoc12" sourceRef="W1710_Annotation11" targetRef="W1710_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1710_Flow13" sourceRef="W1710_Start5" targetRef="W1710_Task6" />
      <bpmn:sequenceFlow id="W1710_Flow14" sourceRef="W1710_Task6" targetRef="W1710_Task7" />
      <bpmn:sequenceFlow id="W1710_Flow15" sourceRef="W1710_Task7" targetRef="W1710_Task8" />
      <bpmn:sequenceFlow id="W1710_Flow16" sourceRef="W1710_Task8" targetRef="W1710_Task9" />
      <bpmn:sequenceFlow id="W1710_Flow17" sourceRef="W1710_Task9" targetRef="W1710_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1710_diag">
      <bpmndi:BPMNPlane id="W1710_plane" bpmnElement="W_W1710">
        <bpmndi:BPMNShape id="W1710_Lane1_di" bpmnElement="W1710_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1710_Lane2_di" bpmnElement="W1710_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1710_Lane3_di" bpmnElement="W1710_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1710_Task6_di" bpmnElement="W1710_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1710_Task7_di" bpmnElement="W1710_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1710_Task8_di" bpmnElement="W1710_Task8"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1710_Task9_di" bpmnElement="W1710_Task9"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
