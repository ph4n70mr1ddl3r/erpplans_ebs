<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-35.3-physical-verification-disposal" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1706" name="W1706. Annual Fixed Asset Physical Verification (Wall-to-Wall Count)" isExecutable="false">
      <bpmn:documentation>Trigger: Annual internal audit plan or external audit requirement; PFRS control expectation
Frequency: Annual (typically Q4 or Q1, coordinated with external audit)
Volume: ~15,000–20,000 fixed assets across 200 stores, 4 DCs, and HQ
Owner: Internal Audit (coordinates); Store Manager / DC Supervisor (executes)
Participants: Internal Audit, Store Manager, DC Supervisor, Fixed Asset Accountant, Department Heads
Source: workflow W1706 — Annual Fixed Asset Physical Verification (Wall-to-Wall Count)</bpmn:documentation>
      <bpmn:laneSet id="W1706_LaneSet6">
        <bpmn:lane id="W1706_Lane1" name="Internal Audit">
        <bpmn:flowNodeRef>W1706_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1706_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1706_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1706_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W1706_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1706_Lane3" name="System">
        <bpmn:flowNodeRef>W1706_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1706_Lane4" name="Location Manager">
        <bpmn:flowNodeRef>W1706_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1706_Lane5" name="Fixed Asset Accountant">
        <bpmn:flowNodeRef>W1706_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1706_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1706_Start7" name="Annual internal audit plan or external audit requirement; PFRS control expectation">
        <bpmn:outgoing>W1706_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1706_Task8" name="Internal Audit issues physical verification instructions: (a) each location…">
        <bpmn:documentation>Step 1: Internal Audit issues physical verification instructions: (a) each location receives a list of registered assets at their location (sorted by category and location within facility), (b) instructions: scan/verify each asset tag, record condition (good, fair, poor, missing), (c) target completion: 2 weeks for stores, 3 weeks for DCs, 1 week for HQ, (d) mobile app or handheld scanner provided for scan-and-confirm process
Responsible (R): Internal Audit
Accountable (A): Head of Internal Audit
Duration: 1 week prep</bpmn:documentation>
        <bpmn:incoming>W1706_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1706_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1706_Task9" name="Location teams execute physical count: (a) scan each asset tag with mobile…">
        <bpmn:documentation>Step 2: Location teams execute physical count: (a) scan each asset tag with mobile device — system confirms match to register, (b) visually inspect condition: Good (functioning, no damage), Fair (operational but needs maintenance), Poor (needs replacement), Missing (not found), (c) for assets without readable tags: record description and location for reconciliation, (d) for assets found but not in register: record as &quot;unregistered asset found&quot;, (e) the location&#x27;s custodian of record signs the count certification; Finance and Internal Audit recount a risk-based sample rather than the full estate
Responsible (R): Store Manager / DC Supervisor / Department Head
Accountable (A): Internal Audit
Duration: 1–2 days/location (stores); 3–5 days/DC</bpmn:documentation>
        <bpmn:incoming>W1706_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1706_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1706_Task10" name="System generates reconciliation report per location: (a) matched assets…">
        <bpmn:documentation>Step 3: System generates reconciliation report per location: (a) matched assets (scanned and confirmed), (b) missing assets (registered but not found), (c) unregistered assets (found but not in register), (d) condition exceptions (assets in &quot;poor&quot; condition), (e) tag exceptions (unreadable or missing tags)
Responsible (R): System
Accountable (A): Internal Audit
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1706_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1706_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1706_Task11" name="Location Manager investigates discrepancies: (a) missing assets — search…">
        <bpmn:documentation>Step 4: Location Manager investigates discrepancies: (a) missing assets — search facility, check transfer records, confirm disposal; if truly missing: escalate to Loss Prevention and initiate write-off per W1709, (b) unregistered assets — identify source (donation, transfer not recorded, expensed item that should have been capitalized); Fixed Asset Accountant registers per W1690 if appropriate, (c) tag exceptions — replacement tags ordered per W1692
Responsible (R): Location Manager
Accountable (A): Internal Audit
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1706_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1706_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1706_Task12" name="Internal Audit compiles company-wide verification summary: (a) verification…">
        <bpmn:documentation>Step 5: Internal Audit compiles company-wide verification summary: (a) verification rate (% of assets physically confirmed), target ≥ 98%, (b) exception rate by category and location, (c) missing asset value and count, (d) unregistered asset value and count, (e) condition summary, (f) recommendations for register cleanup and process improvement
Responsible (R): Internal Audit
Accountable (A): CFO / Audit Committee
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1706_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1706_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1706_Task13" name="Fixed Asset Accountant processes all adjustments resulting from verification…">
        <bpmn:documentation>Step 6: Fixed Asset Accountant processes all adjustments resulting from verification: new registrations, disposal write-offs, location corrections, condition updates, tag replacements
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1706_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1706_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1706_End14" name="Complete">
        <bpmn:incoming>W1706_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1706_Annotation15">
        <bpmn:text>Controls: - CTL-219 (ensure fixed-asset register accuracy.) | - operational: periodic reconciliation against source documents
Owner: Internal Audit (coordinates); Store Manager / DC Supervisor (executes)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1706_Assoc16" sourceRef="W1706_Annotation15" targetRef="W1706_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W1706_Flow17" sourceRef="W1706_Start7" targetRef="W1706_Task8" />
      <bpmn:sequenceFlow id="W1706_Flow18" sourceRef="W1706_Task8" targetRef="W1706_Task9" />
      <bpmn:sequenceFlow id="W1706_Flow19" sourceRef="W1706_Task9" targetRef="W1706_Task10" />
      <bpmn:sequenceFlow id="W1706_Flow20" sourceRef="W1706_Task10" targetRef="W1706_Task11" />
      <bpmn:sequenceFlow id="W1706_Flow21" sourceRef="W1706_Task11" targetRef="W1706_Task12" />
      <bpmn:sequenceFlow id="W1706_Flow22" sourceRef="W1706_Task12" targetRef="W1706_Task13" />
      <bpmn:sequenceFlow id="W1706_Flow23" sourceRef="W1706_Task13" targetRef="W1706_End14" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1706_diag">
      <bpmndi:BPMNPlane id="W1706_plane" bpmnElement="W_W1706">
        <bpmndi:BPMNShape id="W1706_Lane1_di" bpmnElement="W1706_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
