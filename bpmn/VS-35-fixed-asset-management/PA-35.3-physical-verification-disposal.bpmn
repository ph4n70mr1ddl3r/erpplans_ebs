    <bpmn:process id="W_W1712" name="W1712. Asset Return to Vendor (Warranty Claim)" isExecutable="false">
      <bpmn:documentation>Trigger: Capital asset fails within warranty period
Frequency: ~20–40 warranty claims/year
Volume: Low volume but important for cost recovery
Owner: Maintenance Supervisor
Participants: Maintenance Supervisor, Purchasing, Fixed Asset Accountant, Vendor
Source: workflow W1712 — Asset Return to Vendor (Warranty Claim)</bpmn:documentation>
      <bpmn:laneSet id="W1712_LaneSet3">
        <bpmn:lane id="W1712_Lane1" name="Maintenance Supervisor">
        <bpmn:flowNodeRef>W1712_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1712_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1712_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1712_Lane2" name="Purchasing">
        <bpmn:flowNodeRef>W1712_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1712_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1712_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1712_Start4" name="Capital asset fails within warranty period">
        <bpmn:outgoing>W1712_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1712_Task5" name="Maintenance identifies asset failure within warranty period: (a) checks asset…">
        <bpmn:documentation>Step 1: Maintenance identifies asset failure within warranty period: (a) checks asset record for warranty expiry date, (b) confirms failure type is covered by warranty terms, (c) documents failure with photos and technical description
Responsible (R): Maintenance Supervisor
Accountable (A): —
Duration: 30 min/claim</bpmn:documentation>
        <bpmn:incoming>W1712_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1712_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1712_Task6" name="Purchasing contacts vendor with warranty claim: (a) provides asset details…">
        <bpmn:documentation>Step 2: Purchasing contacts vendor with warranty claim: (a) provides asset details, serial number, purchase date, PO reference, (b) vendor confirms warranty coverage and provides return authorization (RMA), (c) vendor specifies: repair, replacement, or credit
Responsible (R): Purchasing
Accountable (A): Maintenance Supervisor
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1712_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1712_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1712_Task7" name="If repair: vendor repairs and returns; system logs downtime and tracks repair…">
        <bpmn:documentation>Step 3: If repair: vendor repairs and returns; system logs downtime and tracks repair. If replacement: old asset returned, new asset received; Fixed Asset Accountant updates asset register (new serial number, reset warranty clock). If credit: asset returned, credit note received; Fixed Asset Accountant processes partial disposal and applies credit to cost center
Responsible (R): Purchasing / Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: Variable</bpmn:documentation>
        <bpmn:incoming>W1712_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1712_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1712_Task8" name="Warranty claim outcome logged in asset maintenance history per W1695; used for…">
        <bpmn:documentation>Step 4: Warranty claim outcome logged in asset maintenance history per W1695; used for vendor quality evaluation and future purchasing decisions
Responsible (R): Maintenance Supervisor
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1712_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1712_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1712_End9" name="Complete">
        <bpmn:incoming>W1712_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1712_Annotation10">
        <bpmn:text>Controls: - CTL-348 (ensure controlled execution — Physical Verification &amp; Disposal (PA-35.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Maintenance Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1712_Assoc11" sourceRef="W1712_Annotation10" targetRef="W1712_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1712_Flow12" sourceRef="W1712_Start4" targetRef="W1712_Task5" />
      <bpmn:sequenceFlow id="W1712_Flow13" sourceRef="W1712_Task5" targetRef="W1712_Task6" />
      <bpmn:sequenceFlow id="W1712_Flow14" sourceRef="W1712_Task6" targetRef="W1712_Task7" />
      <bpmn:sequenceFlow id="W1712_Flow15" sourceRef="W1712_Task7" targetRef="W1712_Task8" />
      <bpmn:sequenceFlow id="W1712_Flow16" sourceRef="W1712_Task8" targetRef="W1712_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1712_diag">
      <bpmndi:BPMNPlane id="W1712_plane" bpmnElement="W_W1712">
        <bpmndi:BPMNShape id="W1712_Lane1_di" bpmnElement="W1712_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1712_Lane2_di" bpmnElement="W1712_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1712_Task5_di" bpmnElement="W1712_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1712_Task6_di" bpmnElement="W1712_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1712_Task7_di" bpmnElement="W1712_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1712_Task8_di" bpmnElement="W1712_Task8"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1712_Start4_di" bpmnElement="W1712_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1712_End9_di" bpmnElement="W1712_End9"><dc:Bounds x="1260" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1712_Annotation10_di" bpmnElement="W1712_Annotation10"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1712_Flow12_di" bpmnElement="W1712_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1712_Flow13_di" bpmnElement="W1712_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1712_Flow14_di" bpmnElement="W1712_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1712_Flow15_di" bpmnElement="W1712_Flow15"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1712_Flow16_di" bpmnElement="W1712_Flow16"><di:waypoint x="1210" y="165" /><di:waypoint x="1260" y="335" /></bpmndi:BPMNEdge>
