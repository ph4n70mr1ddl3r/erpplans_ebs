    <bpmn:process id="W_W1711" name="W1711. Gain/Loss on Asset Disposal Recognition" isExecutable="false">
      <bpmn:documentation>Trigger: Asset disposal processed (W1708, W1709, W1710)
Frequency: ~100–200 disposals/month
Volume: Monthly aggregate gain/loss posted
Owner: Fixed Asset Accountant
Participants: Fixed Asset Accountant, Accounting Manager
Source: workflow W1711 — Gain/Loss on Asset Disposal Recognition</bpmn:documentation>
      <bpmn:laneSet id="W1711_LaneSet4">
        <bpmn:lane id="W1711_Lane1" name="System">
        <bpmn:flowNodeRef>W1711_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1711_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1711_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1711_Lane2" name="Fixed Asset Accountant">
        <bpmn:flowNodeRef>W1711_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1711_Lane3" name="Tax Accountant">
        <bpmn:flowNodeRef>W1711_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1711_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1711_Start5" name="Asset disposal processed (W1708, W1709, W1710)">
        <bpmn:outgoing>W1711_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1711_Task6" name="System auto-calculates gain/loss on each disposal: (a) gain = proceeds/recovery…">
        <bpmn:documentation>Step 1: System auto-calculates gain/loss on each disposal: (a) gain = proceeds/recovery − net book value − disposal costs, (b) loss = net book value − proceeds/recovery + disposal costs, (c) proceeds include: cash received, trade-in credit, insurance recovery, salvage value, (d) disposal costs include: removal, transportation, environmental remediation
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1711_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1711_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1711_Task7" name="System generates disposal journal entry: (a) debit: cash/receivable (proceeds)…">
        <bpmn:documentation>Step 2: System generates disposal journal entry: (a) debit: cash/receivable (proceeds), accumulated depreciation, (b) credit: gross asset cost, (c) difference = gain (credit to other income) or loss (debit to other expense), (d) entry posted to entity-specific GL
Responsible (R): System
Accountable (A): Fixed Asset Accountant
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1711_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1711_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1711_Task8" name="Monthly: Fixed Asset Accountant reviews aggregate disposal gain/loss: (a) total…">
        <bpmn:documentation>Step 3: Monthly: Fixed Asset Accountant reviews aggregate disposal gain/loss: (a) total gains and losses by entity, (b) significant individual disposals (gain/loss &gt; PHP 100K), (c) ensures proper classification (PFRS requires gain/loss in P&amp;L, not OCI)
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W1711_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1711_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1711_Task9" name="Tax compliance: gains on disposal may be subject to capital gains tax or…">
        <bpmn:documentation>Step 4: Tax compliance: gains on disposal may be subject to capital gains tax or ordinary income tax depending on asset type and Philippine tax rules; Tax Accountant reviews material gains for proper tax treatment
Responsible (R): Tax Accountant
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W1711_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1711_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1711_End10" name="Complete">
        <bpmn:incoming>W1711_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1711_Annotation11">
        <bpmn:text>Controls: - CTL-348 (ensure controlled execution — Physical Verification &amp; Disposal (PA-35.3).) | - operational: Fixed Asset Accountant review and approval gate
Owner: Fixed Asset Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1711_Assoc12" sourceRef="W1711_Annotation11" targetRef="W1711_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1711_Flow13" sourceRef="W1711_Start5" targetRef="W1711_Task6" />
      <bpmn:sequenceFlow id="W1711_Flow14" sourceRef="W1711_Task6" targetRef="W1711_Task7" />
      <bpmn:sequenceFlow id="W1711_Flow15" sourceRef="W1711_Task7" targetRef="W1711_Task8" />
      <bpmn:sequenceFlow id="W1711_Flow16" sourceRef="W1711_Task8" targetRef="W1711_Task9" />
      <bpmn:sequenceFlow id="W1711_Flow17" sourceRef="W1711_Task9" targetRef="W1711_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1711_diag">
      <bpmndi:BPMNPlane id="W1711_plane" bpmnElement="W_W1711">
        <bpmndi:BPMNShape id="W1711_Lane1_di" bpmnElement="W1711_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
