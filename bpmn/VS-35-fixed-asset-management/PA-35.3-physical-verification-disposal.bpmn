    <bpmn:process id="W_W1707" name="W1707. Spot Check &amp; Rolling Asset Verification" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled quarterly spot checks; triggered by specific concerns (high-value asset, anomalous location, audit finding)
Frequency: Quarterly spot checks covering ~10–15% of assets; rolling cycle ensures 100% coverage over ~2 years
Volume: ~2,000–3,000 assets per quarter
Owner: Internal Audit
Participants: Internal Audit, Store Manager, DC Supervisor
Source: workflow W1707 — Spot Check &amp; Rolling Asset Verification</bpmn:documentation>
      <bpmn:laneSet id="W1707_LaneSet3">
        <bpmn:lane id="W1707_Lane1" name="Internal Audit">
        <bpmn:flowNodeRef>W1707_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1707_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1707_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1707_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1707_Lane2" name="Internal Auditor">
        <bpmn:flowNodeRef>W1707_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1707_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1707_Start4" name="Scheduled quarterly spot checks; triggered by specific concerns (high-value asset…">
        <bpmn:outgoing>W1707_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1707_Task5" name="Internal Audit selects sample for spot check: (a) random sample of 5–10 stores…">
        <bpmn:documentation>Step 1: Internal Audit selects sample for spot check: (a) random sample of 5–10 stores per quarter, (b) targeted selection based on: high-value assets, locations with prior discrepancies, recently transferred assets, assets approaching end of useful life, (c) DC equipment (forklifts, racking) checked every quarter due to heavy usage
Responsible (R): Internal Audit
Accountable (A): Head of Internal Audit
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1707_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1707_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1707_Task6" name="Internal Auditor visits selected locations (or delegates to Regional Manager…">
        <bpmn:documentation>Step 2: Internal Auditor visits selected locations (or delegates to Regional Manager with photo evidence): (a) scans/verifies sampled assets, (b) assesses condition vs. register, (c) checks maintenance records for compliance with schedule per W1695, (d) interviews location staff on asset movements
Responsible (R): Internal Auditor
Accountable (A): Head of Internal Audit
Duration: 1–2 days/location</bpmn:documentation>
        <bpmn:incoming>W1707_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1707_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1707_Task7" name="Discrepancies investigated and resolved same as W1706.4–5; patterns across…">
        <bpmn:documentation>Step 3: Discrepancies investigated and resolved same as W1706.4–5; patterns across locations identified (e.g., systematic failure to register new assets → process improvement needed)
Responsible (R): Internal Audit
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1707_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1707_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1707_Task8" name="Quarterly spot check report submitted to CFO and Audit Committee; tracking of…">
        <bpmn:documentation>Step 4: Quarterly spot check report submitted to CFO and Audit Committee; tracking of prior findings and corrective actions
Responsible (R): Internal Audit
Accountable (A): Head of Internal Audit
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W1707_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1707_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1707_End9" name="Complete">
        <bpmn:incoming>W1707_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1707_Annotation10">
        <bpmn:text>Controls: - CTL-219 (ensure fixed-asset register accuracy.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Internal Audit</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1707_Assoc11" sourceRef="W1707_Annotation10" targetRef="W1707_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1707_Flow12" sourceRef="W1707_Start4" targetRef="W1707_Task5" />
      <bpmn:sequenceFlow id="W1707_Flow13" sourceRef="W1707_Task5" targetRef="W1707_Task6" />
      <bpmn:sequenceFlow id="W1707_Flow14" sourceRef="W1707_Task6" targetRef="W1707_Task7" />
      <bpmn:sequenceFlow id="W1707_Flow15" sourceRef="W1707_Task7" targetRef="W1707_Task8" />
      <bpmn:sequenceFlow id="W1707_Flow16" sourceRef="W1707_Task8" targetRef="W1707_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1707_diag">
      <bpmndi:BPMNPlane id="W1707_plane" bpmnElement="W_W1707">
        <bpmndi:BPMNShape id="W1707_Lane1_di" bpmnElement="W1707_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1707_Lane2_di" bpmnElement="W1707_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1707_Task5_di" bpmnElement="W1707_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1707_Task6_di" bpmnElement="W1707_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1707_Task7_di" bpmnElement="W1707_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1707_Task8_di" bpmnElement="W1707_Task8"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1707_Start4_di" bpmnElement="W1707_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1707_End9_di" bpmnElement="W1707_End9"><dc:Bounds x="1260" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1707_Annotation10_di" bpmnElement="W1707_Annotation10"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1707_Flow12_di" bpmnElement="W1707_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1707_Flow13_di" bpmnElement="W1707_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1707_Flow14_di" bpmnElement="W1707_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1707_Flow15_di" bpmnElement="W1707_Flow15"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1707_Flow16_di" bpmnElement="W1707_Flow16"><di:waypoint x="1210" y="165" /><di:waypoint x="1260" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1707_Assoc11_di" bpmnElement="W1707_Assoc11"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1708" name="W1708. Asset Retirement &amp; Disposal Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Asset fully depreciated and no longer usable, asset replacement, store closure, or asset upgrade
Frequency: ~100–200 retirements/month
Volume: ~1,200–2,400 retirements/year
Owner: Fixed Asset Accountant
Participants: Fixed Asset Accountant, Location Manager, Maintenance, Loss Prevention (if applicable)
Source: workflow W1708 — Asset Retirement &amp; Disposal Processing</bpmn:documentation>
      <bpmn:laneSet id="W1708_LaneSet3">
        <bpmn:lane id="W1708_Lane1" name="Location Manager">
        <bpmn:flowNodeRef>W1708_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1708_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1708_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1708_Lane2" name="Fixed Asset Accountant">
        <bpmn:flowNodeRef>W1708_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1708_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1708_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1708_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1708_Start4" name="Asset fully depreciated and no longer usable, asset replacement, store closure, or asset…">
        <bpmn:outgoing>W1708_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1708_Task5" name="Location Manager initiates asset retirement request: (a) selects asset from…">
        <bpmn:documentation>Step 1: Location Manager initiates asset retirement request: (a) selects asset from register, (b) specifies reason: (i) end of useful life — fully depreciated, (ii) damaged beyond repair, (iii) technologically obsolete, (iv) store closure/consolidation, (v) replacement by new asset, (c) attaches photos (if damaged), (d) recommends disposal method: (i) scrap/salvage, (ii) trade-in for new asset, (iii) sell to third party, (iv) donate, (v) return to vendor under warranty
Responsible (R): Location Manager
Accountable (A): Fixed Asset Accountant
Duration: 10 min/request</bpmn:documentation>
        <bpmn:incoming>W1708_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1708_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1708_Task6" name="Fixed Asset Accountant reviews retirement request: (a) verifies asset…">
        <bpmn:documentation>Step 2: Fixed Asset Accountant reviews retirement request: (a) verifies asset identification (correct asset number, description, location), (b) reviews remaining net book value — if &gt; PHP 0, disposal will result in gain or loss per W1711, (c) for high-value assets (≥ PHP 200K original cost): requires Accounting Manager approval, (d) checks insurance coverage — if asset is insured and damaged, initiates insurance claim per W1697, (e) confirms disposal method is appropriate
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 10 min/request</bpmn:documentation>
        <bpmn:incoming>W1708_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1708_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1708_Task7" name="Approved disposal executed: (a) scrap/salvage: asset physically dismantled and…">
        <bpmn:documentation>Step 3: Approved disposal executed: (a) scrap/salvage: asset physically dismantled and removed; salvage value recorded, (b) trade-in: old asset surrendered to vendor as partial payment for new asset; trade-in value credited, (c) sale: asset listed and sold; proceeds recorded, (d) donation: asset transferred to recipient with donation documentation; no proceeds (potential tax deduction documentation)
Responsible (R): Location Manager / Maintenance
Accountable (A): Fixed Asset Accountant
Duration: Variable</bpmn:documentation>
        <bpmn:incoming>W1708_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1708_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1708_Task8" name="Fixed Asset Accountant processes retirement in system: (a) asset status changed…">
        <bpmn:documentation>Step 4: Fixed Asset Accountant processes retirement in system: (a) asset status changed to &quot;Retired,&quot; (b) gross asset value removed from register, (c) accumulated depreciation removed, (d) net book value (if any) recognized as loss on disposal (or gain if proceeds &gt; NBV), (e) journal entry posted to GL, (f) asset removed from depreciation schedule going forward
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 5 min/asset</bpmn:documentation>
        <bpmn:incoming>W1708_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1708_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1708_Task9" name="Insurance schedule updated per W1697; asset tag collected/destroyed; physical…">
        <bpmn:documentation>Step 5: Insurance schedule updated per W1697; asset tag collected/destroyed; physical location cleared
Responsible (R): Fixed Asset Accountant / Location Manager
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1708_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1708_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1708_End10" name="Complete">
        <bpmn:incoming>W1708_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1708_Annotation11">
        <bpmn:text>Controls: - CTL-348 (ensure controlled execution — Physical Verification &amp; Disposal (PA-35.3).) | - operational: Fixed Asset Accountant review and approval gate
Owner: Fixed Asset Accountant</bpmn:text>
      </bpmn:textAnnotation>
