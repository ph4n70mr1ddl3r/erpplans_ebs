    <bpmn:process id="W_W1703" name="W1703. Entity-Level &amp; Consolidated Asset Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly management reporting; quarterly Board reporting; annual financial statements
Frequency: Monthly / Quarterly / Annual
Volume: 5 entity reports + 1 consolidated report per period
Owner: FP&amp;A Manager
Participants: FP&amp;A Manager, Fixed Asset Accountant, CFO
Source: workflow W1703 — Entity-Level &amp; Consolidated Asset Reporting</bpmn:documentation>
      <bpmn:laneSet id="W1703_LaneSet3">
        <bpmn:lane id="W1703_Lane1" name="System">
        <bpmn:flowNodeRef>W1703_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1703_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1703_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1703_Lane2" name="FP&amp;A Manager">
        <bpmn:flowNodeRef>W1703_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1703_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1703_Start4" name="Monthly management reporting; quarterly Board reporting; annual financial statements">
        <bpmn:outgoing>W1703_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1703_Task5" name="System generates entity-level fixed asset reports for each of the 5 entities…">
        <bpmn:documentation>Step 1: System generates entity-level fixed asset reports for each of the 5 entities: (a) BuildRight Holdings Inc. — HQ assets, investments, (b) BuildRight Depot Inc. — stores, POS, fixtures, merchandise-related equipment, (c) BuildRight Logistics Inc. — DC equipment, forklifts, warehouse racking, (d) BuildRight Digital Commerce Inc. — IT servers, development equipment, (e) BuildRight Property Management Inc. — land, buildings, leased property improvements
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1703_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1703_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1703_Task6" name="Consolidated fixed asset report: (a) sum of all entity registers, (b)…">
        <bpmn:documentation>Step 2: Consolidated fixed asset report: (a) sum of all entity registers, (b) elimination of intercompany asset transfers (selling entity removes, buying entity adds — net zero at group level), (c) elimination of intercompany gains/losses on asset transfers, (d) unified depreciation schedule for group reporting
Responsible (R): System
Accountable (A): Fixed Asset Accountant
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W1703_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1703_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1703_Task7" name="FP&amp;A prepares Board-level capital asset summary: (a) total net book value and…">
        <bpmn:documentation>Step 3: FP&amp;A prepares Board-level capital asset summary: (a) total net book value and trend, (b) capital intensity ratio (net fixed assets ÷ total assets), (c) asset utilization (revenue ÷ average net fixed assets), (d) capex to depreciation ratio (indicates whether asset base is growing or aging), (e) planned vs. actual capex, (f) store-level asset intensity (net assets per store)
Responsible (R): FP&amp;A Manager
Accountable (A): CFO
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1703_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1703_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1703_End8" name="Complete">
        <bpmn:incoming>W1703_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1703_Annotation9">
        <bpmn:text>Controls: - CTL-219 (ensure fixed-asset register accuracy.) | - operational: standard operating procedures; system-enforced validation rules
Owner: FP&amp;A Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1703_Assoc10" sourceRef="W1703_Annotation9" targetRef="W1703_Start4" associationDirection="None" />
