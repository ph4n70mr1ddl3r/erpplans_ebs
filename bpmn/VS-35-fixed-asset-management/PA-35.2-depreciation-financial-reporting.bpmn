<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-35.2-depreciation-financial-reporting" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1698" name="W1698. Monthly Depreciation Run &amp; Journal Posting" isExecutable="false">
      <bpmn:documentation>Trigger: Month-end close process (Day 1 of following month)
Frequency: Monthly (5 entities × 12 months = 60 runs/year)
Volume: ~15,000–20,000 active assets depreciated per month
Owner: Fixed Asset Accountant
Participants: Fixed Asset Accountant, GL Accountant, Accounting Manager
Source: workflow W1698 — Monthly Depreciation Run &amp; Journal Posting</bpmn:documentation>
      <bpmn:laneSet id="W1698_LaneSet4">
        <bpmn:lane id="W1698_Lane1" name="Fixed Asset Accountant">
        <bpmn:flowNodeRef>W1698_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1698_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1698_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1698_Lane2" name="System">
        <bpmn:flowNodeRef>W1698_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1698_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1698_Lane3" name="Accounting Manager">
        <bpmn:flowNodeRef>W1698_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1698_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1698_Start5" name="Month-end close process (Day 1 of following month)">
        <bpmn:outgoing>W1698_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1698_Task6" name="Before depreciation run: Fixed Asset Accountant verifies all new assets from…">
        <bpmn:documentation>Step 1: Before depreciation run: Fixed Asset Accountant verifies all new assets from the month have been registered per W1690 and all disposals/retirements processed per W1708; system flags assets with missing classification or useful life
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1698_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1698_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1698_Task7" name="System executes depreciation calculation for all active assets: (a)…">
        <bpmn:documentation>Step 2: System executes depreciation calculation for all active assets: (a) straight-line depreciation for most categories: monthly expense = (cost − residual value) ÷ useful life in months, (b) declining balance for vehicles: monthly expense = net book value × (rate ÷ 12), (c) depreciation starts from ready-for-use date — partial month calculated pro-rata, (d) fully depreciated assets (net book value = residual value or zero) are skipped, (e) assets on hold or pending disposal continue depreciating until formal disposal date, (f) depreciation calculates in each entity&#x27;s corporate book — the book of record for the register — and the tax (BIR) book derives from the corporate book per W1704; tax schedules are never maintained independently of the corporate register
Responsible (R): System
Accountable (A): —
Duration: ~5 min computation</bpmn:documentation>
        <bpmn:incoming>W1698_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1698_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1698_Task8" name="Fixed Asset Accountant reviews depreciation run results: (a) total depreciation…">
        <bpmn:documentation>Step 3: Fixed Asset Accountant reviews depreciation run results: (a) total depreciation expense by entity vs. prior month (material variance investigation), (b) new assets added this month — verify depreciation amounts, (c) assets reaching end of useful life this month — flag for disposal review per W1708, (d) any errors or exceptions (negative depreciation, missing parameters)
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 1–2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1698_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1698_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1698_Task9" name="Accounting Manager approves depreciation run; system posts journal entries: (a)…">
        <bpmn:documentation>Step 4: Accounting Manager approves depreciation run; system posts journal entries: (a) debit: depreciation expense by cost center (store/DC/HQ/department), (b) credit: accumulated depreciation by asset category, (c) entries posted to each entity&#x27;s GL separately, (d) consolidation elimination not needed (depreciation is entity-specific)
Responsible (R): Accounting Manager
Accountable (A): CFO
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W1698_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1698_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1698_Task10" name="System updates each asset&#x27;s net book value; generates depreciation schedule…">
        <bpmn:documentation>Step 5: System updates each asset&#x27;s net book value; generates depreciation schedule report for the month showing: cost, accumulated depreciation, net book value by asset, category, location, and entity
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1698_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1698_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1698_End11" name="Complete">
        <bpmn:incoming>W1698_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1698_Annotation12">
        <bpmn:text>Controls: - CTL-347 (ensure controlled execution — Depreciation &amp; Financial Reporting (PA-35.2).) | - operational: Fixed Asset Accountant review and approval gate
Owner: Fixed Asset Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1698_Assoc13" sourceRef="W1698_Annotation12" targetRef="W1698_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1698_Flow14" sourceRef="W1698_Start5" targetRef="W1698_Task6" />
      <bpmn:sequenceFlow id="W1698_Flow15" sourceRef="W1698_Task6" targetRef="W1698_Task7" />
      <bpmn:sequenceFlow id="W1698_Flow16" sourceRef="W1698_Task7" targetRef="W1698_Task8" />
      <bpmn:sequenceFlow id="W1698_Flow17" sourceRef="W1698_Task8" targetRef="W1698_Task9" />
      <bpmn:sequenceFlow id="W1698_Flow18" sourceRef="W1698_Task9" targetRef="W1698_Task10" />
      <bpmn:sequenceFlow id="W1698_Flow19" sourceRef="W1698_Task10" targetRef="W1698_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1698_diag">
      <bpmndi:BPMNPlane id="W1698_plane" bpmnElement="W_W1698">
        <bpmndi:BPMNShape id="W1698_Lane1_di" bpmnElement="W1698_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1698_Lane2_di" bpmnElement="W1698_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1698_Lane3_di" bpmnElement="W1698_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1698_Task6_di" bpmnElement="W1698_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1698_Task7_di" bpmnElement="W1698_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1698_Task8_di" bpmnElement="W1698_Task8"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1698_Task9_di" bpmnElement="W1698_Task9"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1698_Task10_di" bpmnElement="W1698_Task10"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
