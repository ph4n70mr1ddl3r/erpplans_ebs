    <bpmn:process id="W_W1704" name="W1704. Tax Depreciation &amp; BIR Compliance Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Annual income tax return preparation (Q1)
Frequency: Annual (with quarterly estimates)
Volume: 5 entity tax returns
Owner: Tax Accountant
Participants: Tax Accountant, Fixed Asset Accountant, External Tax Advisor
Source: workflow W1704 — Tax Depreciation &amp; BIR Compliance Reporting</bpmn:documentation>
      <bpmn:laneSet id="W1704_LaneSet4">
        <bpmn:lane id="W1704_Lane1" name="System">
        <bpmn:flowNodeRef>W1704_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1704_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1704_Lane2" name="Tax Accountant">
        <bpmn:flowNodeRef>W1704_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1704_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1704_Lane3" name="Fixed Asset Accountant">
        <bpmn:flowNodeRef>W1704_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1704_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1704_Start5" name="Annual income tax return preparation (Q1)">
        <bpmn:outgoing>W1704_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1704_Task6" name="System maintains parallel tax depreciation schedule per BIR-prescribed rates…">
        <bpmn:documentation>Step 1: System maintains parallel tax depreciation schedule per BIR-prescribed rates: (a) buildings: 5% declining balance or straight-line (taxpayer choice), (b) machinery and equipment: varies by type per BIR schedule, (c) vehicles: 20% declining balance (5-year useful life), (d) computers/IT equipment: 20–33.3% per BIR schedule, (e) furniture and fixtures: 10% declining balance (10-year useful life)
Responsible (R): System
Accountable (A): Tax Accountant
Duration: Configured annually</bpmn:documentation>
        <bpmn:incoming>W1704_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1704_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1704_Task7" name="Annual: Tax Accountant generates tax depreciation schedule per entity; compares…">
        <bpmn:documentation>Step 2: Annual: Tax Accountant generates tax depreciation schedule per entity; compares with book depreciation per W1698; calculates book-tax difference (temporary difference → deferred tax asset or liability per PFRS 112)
Responsible (R): Tax Accountant
Accountable (A): Tax Manager
Duration: 1–2 days/year</bpmn:documentation>
        <bpmn:incoming>W1704_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1704_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1704_Task8" name="Tax depreciation amounts used in annual income tax computation (BIR Form…">
        <bpmn:documentation>Step 3: Tax depreciation amounts used in annual income tax computation (BIR Form 1702RT); included in tax return supporting schedules; tax depreciation reduces taxable income
Responsible (R): Tax Accountant
Accountable (A): CFO
Duration: Part of annual tax return</bpmn:documentation>
        <bpmn:incoming>W1704_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1704_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1704_Task9" name="BIR audit readiness: Fixed asset register and depreciation schedules maintained…">
        <bpmn:documentation>Step 4: BIR audit readiness: Fixed asset register and depreciation schedules maintained for 10-year retention period per BIR requirement; supporting documents (POs, delivery receipts, board resolutions for capex approval) archived and indexed
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1704_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1704_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1704_End10" name="Complete">
        <bpmn:incoming>W1704_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1704_Annotation11">
        <bpmn:text>Controls: - CTL-347 (ensure controlled execution — Depreciation &amp; Financial Reporting (PA-35.2).) | - operational: Tax Accountant review and approval gate
Owner: Tax Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1704_Assoc12" sourceRef="W1704_Annotation11" targetRef="W1704_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1704_Flow13" sourceRef="W1704_Start5" targetRef="W1704_Task6" />
      <bpmn:sequenceFlow id="W1704_Flow14" sourceRef="W1704_Task6" targetRef="W1704_Task7" />
      <bpmn:sequenceFlow id="W1704_Flow15" sourceRef="W1704_Task7" targetRef="W1704_Task8" />
      <bpmn:sequenceFlow id="W1704_Flow16" sourceRef="W1704_Task8" targetRef="W1704_Task9" />
      <bpmn:sequenceFlow id="W1704_Flow17" sourceRef="W1704_Task9" targetRef="W1704_End10" />
    </bpmn:process>
