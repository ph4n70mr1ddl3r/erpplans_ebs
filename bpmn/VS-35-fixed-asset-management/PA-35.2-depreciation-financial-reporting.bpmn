        <bpmndi:BPMNShape id="W1698_End11_di" bpmnElement="W1698_End11"><dc:Bounds x="1470" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1698_Annotation12_di" bpmnElement="W1698_Annotation12"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1698_Flow14_di" bpmnElement="W1698_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1698_Flow15_di" bpmnElement="W1698_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1698_Flow16_di" bpmnElement="W1698_Flow16"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1698_Flow17_di" bpmnElement="W1698_Flow17"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1698_Flow18_di" bpmnElement="W1698_Flow18"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1698_Flow19_di" bpmnElement="W1698_Flow19"><di:waypoint x="1420" y="335" /><di:waypoint x="1470" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1698_Assoc13_di" bpmnElement="W1698_Assoc13"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1699" name="W1699. Depreciation Method Review &amp; Useful Life Adjustment" isExecutable="false">
      <bpmn:documentation>Trigger: Annual review, physical verification findings (W1706), or significant change in asset usage pattern
Frequency: Annual review (Q4); ad-hoc as needed
Volume: ~50–100 useful life adjustments/year
Owner: Fixed Asset Accountant
Participants: Fixed Asset Accountant, Accounting Manager, External Auditor
Source: workflow W1699 — Depreciation Method Review &amp; Useful Life Adjustment</bpmn:documentation>
      <bpmn:laneSet id="W1699_LaneSet5">
        <bpmn:lane id="W1699_Lane1" name="Fixed Asset Accountant">
        <bpmn:flowNodeRef>W1699_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1699_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1699_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1699_Lane2" name="Accounting Manager">
        <bpmn:flowNodeRef>W1699_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1699_Lane3" name="System">
        <bpmn:flowNodeRef>W1699_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1699_Lane4" name="External Auditor">
        <bpmn:flowNodeRef>W1699_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1699_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1699_Start6" name="Annual review, physical verification findings (W1706), or significant change in asset…">
        <bpmn:outgoing>W1699_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1699_Task7" name="Triggers for useful life review: (a) physical verification reveals asset in…">
        <bpmn:documentation>Step 1: Triggers for useful life review: (a) physical verification reveals asset in worse/better condition than expected, (b) technology change (e.g., POS system upgrade makes existing terminals obsolete sooner), (c) regulatory change (e.g., new emission standards require fleet replacement), (d) change in usage pattern (store open longer hours → fixtures wear faster), (e) external auditor recommendation
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: Event-driven</bpmn:documentation>
        <bpmn:incoming>W1699_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1699_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1699_Task8" name="Fixed Asset Accountant prepares useful life adjustment proposal: (a) asset(s)…">
        <bpmn:documentation>Step 2: Fixed Asset Accountant prepares useful life adjustment proposal: (a) asset(s) affected, (b) current useful life and remaining useful life, (c) proposed new useful life with justification, (d) impact on future depreciation expense (increase/decrease per month), (e) catch-up adjustment needed for prior periods (prospectively per PFRS — no restatement)
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 1–2 hours/batch</bpmn:documentation>
        <bpmn:incoming>W1699_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1699_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1699_Task9" name="Accounting Manager reviews and approves adjustment; for material changes…">
        <bpmn:documentation>Step 3: Accounting Manager reviews and approves adjustment; for material changes (aggregate impact &gt; PHP 1M/year): CFO approval required
Responsible (R): Accounting Manager / CFO
Accountable (A): CFO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1699_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1699_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1699_Task10" name="System updates useful life on affected assets; recalculates remaining…">
        <bpmn:documentation>Step 4: System updates useful life on affected assets; recalculates remaining depreciation schedule: (a) net book value at adjustment date ÷ remaining new useful life = new monthly depreciation, (b) adjustment applied prospectively from next depreciation run, (c) change documented in asset history with approval reference
Responsible (R): System
Accountable (A): Fixed Asset Accountant
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1699_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1699_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1699_Task11" name="External auditor reviews useful life changes during annual audit; confirms PFRS…">
        <bpmn:documentation>Step 5: External auditor reviews useful life changes during annual audit; confirms PFRS compliance and consistency of application
Responsible (R): External Auditor
Accountable (A): —
Duration: During annual audit</bpmn:documentation>
        <bpmn:incoming>W1699_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1699_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1699_End12" name="Complete">
        <bpmn:incoming>W1699_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1699_Annotation13">
        <bpmn:text>Controls: - CTL-347 (ensure controlled execution — Depreciation &amp; Financial Reporting (PA-35.2).) | - operational: Fixed Asset Accountant review and approval gate
Owner: Fixed Asset Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1699_Assoc14" sourceRef="W1699_Annotation13" targetRef="W1699_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1699_Flow15" sourceRef="W1699_Start6" targetRef="W1699_Task7" />
      <bpmn:sequenceFlow id="W1699_Flow16" sourceRef="W1699_Task7" targetRef="W1699_Task8" />
      <bpmn:sequenceFlow id="W1699_Flow17" sourceRef="W1699_Task8" targetRef="W1699_Task9" />
      <bpmn:sequenceFlow id="W1699_Flow18" sourceRef="W1699_Task9" targetRef="W1699_Task10" />
      <bpmn:sequenceFlow id="W1699_Flow19" sourceRef="W1699_Task10" targetRef="W1699_Task11" />
      <bpmn:sequenceFlow id="W1699_Flow20" sourceRef="W1699_Task11" targetRef="W1699_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1699_diag">
      <bpmndi:BPMNPlane id="W1699_plane" bpmnElement="W_W1699">
        <bpmndi:BPMNShape id="W1699_Lane1_di" bpmnElement="W1699_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1699_Lane2_di" bpmnElement="W1699_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1699_Lane3_di" bpmnElement="W1699_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1699_Lane4_di" bpmnElement="W1699_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1699_Task7_di" bpmnElement="W1699_Task7"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1699_Task8_di" bpmnElement="W1699_Task8"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1699_Task9_di" bpmnElement="W1699_Task9"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1699_Task10_di" bpmnElement="W1699_Task10"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1699_Task11_di" bpmnElement="W1699_Task11"><dc:Bounds x="1240" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1699_Start6_di" bpmnElement="W1699_Start6"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1699_End12_di" bpmnElement="W1699_End12"><dc:Bounds x="1470" y="657" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1699_Annotation13_di" bpmnElement="W1699_Annotation13"><dc:Bounds x="160" y="800" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1699_Flow15_di" bpmnElement="W1699_Flow15"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1699_Flow16_di" bpmnElement="W1699_Flow16"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1699_Flow17_di" bpmnElement="W1699_Flow17"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1699_Flow18_di" bpmnElement="W1699_Flow18"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1699_Flow19_di" bpmnElement="W1699_Flow19"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1699_Flow20_di" bpmnElement="W1699_Flow20"><di:waypoint x="1420" y="675" /><di:waypoint x="1470" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1699_Assoc14_di" bpmnElement="W1699_Assoc14"><di:waypoint x="340" y="800" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1700" name="W1700. Impairment Assessment &amp; Testing" isExecutable="false">
      <bpmn:documentation>Trigger: Indicators of impairment: store closure plan, significant decline in asset market value, physical damage, change in use, or annual testing for goodwill/certain intangibles
Frequency: Event-driven; annual review for stores with consistent losses
Volume: ~5–15 impairment assessments/year
Owner: FP&amp;A Manager
Participants: FP&amp;A Manager, Fixed Asset Accountant, Accounting Manager, CFO, External Auditor
Source: workflow W1700 — Impairment Assessment &amp; Testing</bpmn:documentation>
      <bpmn:laneSet id="W1700_LaneSet4">
        <bpmn:lane id="W1700_Lane1" name="FP&amp;A Manager">
        <bpmn:flowNodeRef>W1700_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1700_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1700_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1700_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1700_Lane2" name="CFO">
        <bpmn:flowNodeRef>W1700_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1700_Lane3" name="Accounting Manager">
        <bpmn:flowNodeRef>W1700_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1700_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1700_Start5" name="Indicators of impairment: store closure plan, significant decline in asset market value…">
        <bpmn:outgoing>W1700_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1700_Task6" name="Identify impairment indicators: (a) store-level P&amp;L shows 4+ consecutive…">
        <bpmn:documentation>Step 1: Identify impairment indicators: (a) store-level P&amp;L shows 4+ consecutive quarters of operating loss, (b) store identified for closure or downsizing, (c) natural disaster damage (typhoon, flood), (d) technology obsolescence (old POS system), (e) significant decline in asset replacement cost, (f) regulatory change making asset use illegal or restricted
Responsible (R): FP&amp;A Manager
Accountable (A): CFO
Duration: Event-driven</bpmn:documentation>
        <bpmn:incoming>W1700_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1700_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1700_Task7" name="For identified stores/assets, FP&amp;A performs recoverable amount test per PAS 36…">
        <bpmn:documentation>Step 2: For identified stores/assets, FP&amp;A performs recoverable amount test per PAS 36: (a) value in use: discounted future cash flows from store operations (revenue projections, cost projections, remaining useful life), (b) fair value less cost of disposal: market comparable or appraisal for real estate, (c) recoverable amount = higher of (a) and (b), (d) if recoverable amount &lt; carrying amount (net book value) → impairment loss = difference
Responsible (R): FP&amp;A Manager
Accountable (A): CFO
Duration: 4–8 hours/store</bpmn:documentation>
        <bpmn:incoming>W1700_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1700_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1700_Task8" name="CFO reviews impairment assessment; if impairment confirmed: (a) Fixed Asset…">
        <bpmn:documentation>Step 3: CFO reviews impairment assessment; if impairment confirmed: (a) Fixed Asset Accountant records impairment loss in GL: debit impairment expense, credit accumulated impairment, (b) asset&#x27;s carrying amount reduced to recoverable amount, (c) revised carrying amount becomes new basis for future depreciation (over remaining revised useful life)
Responsible (R): CFO
Accountable (A): CEO / Board (if material)
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W1700_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1700_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1700_Task9" name="Disclosures: Accounting Manager ensures impairment loss is properly disclosed…">
        <bpmn:documentation>Step 4: Disclosures: Accounting Manager ensures impairment loss is properly disclosed in financial statement notes per PAS 36 — description of asset, nature of impairment, amount, method of determining recoverable amount
Responsible (R): Accounting Manager
Accountable (A): CFO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W1700_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1700_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1700_Task10" name="Annual review: FP&amp;A reassesses impaired assets for possible reversal (PFRS…">
        <bpmn:documentation>Step 5: Annual review: FP&amp;A reassesses impaired assets for possible reversal (PFRS allows reversal for non-goodwill impairments if conditions improve)
Responsible (R): FP&amp;A Manager
Accountable (A): CFO
Duration: 2 hours/year</bpmn:documentation>
        <bpmn:incoming>W1700_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1700_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1700_End11" name="Complete">
        <bpmn:incoming>W1700_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1700_Annotation12">
        <bpmn:text>Controls: - CTL-347 (ensure controlled execution — Depreciation &amp; Financial Reporting (PA-35.2).) | - operational: FP&amp;A Manager review and approval gate
Owner: FP&amp;A Manager</bpmn:text>
      </bpmn:textAnnotation>
