        <bpmndi:BPMNShape id="W1702_Task6_di" bpmnElement="W1702_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1702_Task7_di" bpmnElement="W1702_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
