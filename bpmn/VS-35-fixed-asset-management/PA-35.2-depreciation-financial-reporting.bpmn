    <bpmn:process id="W_W1705" name="W1705. Capital Work-in-Progress Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: Month-end close; project milestone completion
Frequency: Monthly reconciliation
Volume: ~10–20 active CIP projects at any time (new stores, DC expansion, IT projects)
Owner: Fixed Asset Accountant
Participants: Fixed Asset Accountant, Project Manager, FP&amp;A, Accounting Manager
Source: workflow W1705 — Capital Work-in-Progress Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W1705_LaneSet3">
        <bpmn:lane id="W1705_Lane1" name="Fixed Asset Accountant">
        <bpmn:flowNodeRef>W1705_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1705_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1705_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1705_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1705_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1705_Lane2" name="Project Manager">
        <bpmn:flowNodeRef>W1705_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1705_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1705_Start4" name="Month-end close; project milestone completion">
        <bpmn:outgoing>W1705_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1705_Task5" name="Monthly: Fixed Asset Accountant reviews all active CIP accounts: (a) costs…">
        <bpmn:documentation>Step 1: Monthly: Fixed Asset Accountant reviews all active CIP accounts: (a) costs accumulated to date per project, (b) budget vs. actual cost, (c) project status (on-track, delayed, on-hold), (d) estimated completion date, (e) aging of CIP — projects in CIP &gt; 12 months flagged for review (potential abandoned or stalled projects)
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 2–4 hours/month</bpmn:documentation>
        <bpmn:incoming>W1705_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1705_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1705_Task6" name="Project Manager confirms project status; provides: (a) % completion estimate…">
        <bpmn:documentation>Step 2: Project Manager confirms project status; provides: (a) % completion estimate, (b) costs incurred but not yet invoiced (accruals needed), (c) remaining budget to complete, (d) expected completion date
Responsible (R): Project Manager
Accountable (A): COO / CIO
Duration: 30 min/project</bpmn:documentation>
        <bpmn:incoming>W1705_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1705_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1705_Task7" name="Fixed Asset Accountant posts month-end CIP accruals for costs incurred but not…">
        <bpmn:documentation>Step 3: Fixed Asset Accountant posts month-end CIP accruals for costs incurred but not yet invoiced (contractor progress billing lag)
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W1705_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1705_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1705_Task8" name="When project completes: Fixed Asset Accountant reconciles total CIP costs…">
        <bpmn:documentation>Step 4: When project completes: Fixed Asset Accountant reconciles total CIP costs, performs final review, and triggers asset turnover per W40.3 — converting CIP to completed fixed assets
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 2–4 hours/project</bpmn:documentation>
        <bpmn:incoming>W1705_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1705_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1705_Task9" name="Abandoned or cancelled projects: CIP costs written off to expense (not…">
        <bpmn:documentation>Step 5: Abandoned or cancelled projects: CIP costs written off to expense (not capitalized); requires CFO approval; documented with reason for abandonment
Responsible (R): Fixed Asset Accountant
Accountable (A): CFO
Duration: 1 hour/project</bpmn:documentation>
        <bpmn:incoming>W1705_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1705_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1705_End10" name="Complete">
        <bpmn:incoming>W1705_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1705_Annotation11">
        <bpmn:text>Controls: - CTL-347 (ensure controlled execution — Depreciation &amp; Financial Reporting (PA-35.2).) | - operational: Fixed Asset Accountant review and approval gate; periodic reconciliation against source documents
Owner: Fixed Asset Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1705_Assoc12" sourceRef="W1705_Annotation11" targetRef="W1705_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1705_Flow13" sourceRef="W1705_Start4" targetRef="W1705_Task5" />
