      <bpmn:sequenceFlow id="W1705_Flow18" sourceRef="W1705_Task9" targetRef="W1705_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1705_diag">
      <bpmndi:BPMNPlane id="W1705_plane" bpmnElement="W_W1705">
        <bpmndi:BPMNShape id="W1705_Lane1_di" bpmnElement="W1705_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1705_Lane2_di" bpmnElement="W1705_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1705_Task5_di" bpmnElement="W1705_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1705_Task6_di" bpmnElement="W1705_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1705_Task7_di" bpmnElement="W1705_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
