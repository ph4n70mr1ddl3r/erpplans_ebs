    <bpmn:process id="W_W1696" name="W1696. Asset Lease vs. Buy Decision &amp; Recording" isExecutable="false">
      <bpmn:documentation>Trigger: Need for new asset (vehicle, equipment, IT hardware) identified during budgeting or operational planning
Frequency: ~20–30 lease-vs-buy decisions/year for material assets
Volume: Low volume but high value — each decision may involve PHP 1–20M
Owner: FP&amp;A Manager
Participants: FP&amp;A Manager, CFO, Department Head, Treasury
Source: workflow W1696 — Asset Lease vs. Buy Decision &amp; Recording</bpmn:documentation>
      <bpmn:laneSet id="W1696_LaneSet5">
        <bpmn:lane id="W1696_Lane1" name="FP&amp;A Manager">
        <bpmn:flowNodeRef>W1696_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1696_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1696_Lane2" name="CFO">
        <bpmn:flowNodeRef>W1696_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1696_Lane3" name="Fixed Asset Accountant">
        <bpmn:flowNodeRef>W1696_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1696_Lane4" name="Treasury">
        <bpmn:flowNodeRef>W1696_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1696_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1696_Start6" name="Need for new asset (vehicle, equipment, IT hardware) identified during budgeting or…">
        <bpmn:outgoing>W1696_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1696_Task7" name="Department Head identifies need for new asset; FP&amp;A performs lease-vs-buy…">
        <bpmn:documentation>Step 1: Department Head identifies need for new asset; FP&amp;A performs lease-vs-buy analysis: (a) total cost of ownership (purchase price + maintenance + disposal vs. lease payments + maintenance), (b) NPV comparison using company&#x27;s incremental borrowing rate, (c) cash flow impact (upfront purchase vs. monthly lease), (d) tax implications (depreciation vs. lease expense deductibility), (e) flexibility (lease allows upgrade; purchase builds equity), (f) balance sheet impact per PFRS 16 (most leases now on-balance-sheet)
Responsible (R): FP&amp;A Manager
Accountable (A): CFO
Duration: 2–4 hours/decision</bpmn:documentation>
        <bpmn:incoming>W1696_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1696_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1696_Task8" name="CFO reviews analysis and decides: (a) purchase — triggers capex request per…">
        <bpmn:documentation>Step 2: CFO reviews analysis and decides: (a) purchase — triggers capex request per W1811, (b) finance lease — recorded as asset and liability on balance sheet per PFRS 16, (c) operating lease (short-term ≤ 12 months or low-value) — recorded as expense on straight-line basis
Responsible (R): CFO
Accountable (A): CEO (if &gt; PHP 5M)
Duration: 30 min/decision</bpmn:documentation>
        <bpmn:incoming>W1696_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1696_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1696_Task9" name="For leased assets: Fixed Asset Accountant records right-of-use asset and lease…">
        <bpmn:documentation>Step 3: For leased assets: Fixed Asset Accountant records right-of-use asset and lease liability at inception: (a) right-of-use asset = present value of lease payments, (b) lease liability = same present value, (c) asset depreciated over lease term, (d) liability reduced by lease payments with interest expense on outstanding balance
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 30 min/lease</bpmn:documentation>
        <bpmn:incoming>W1696_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1696_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1696_Task10" name="Lease payments scheduled in treasury system; monthly: (a) lease payment…">
        <bpmn:documentation>Step 4: Lease payments scheduled in treasury system; monthly: (a) lease payment processed to lessor, (b) system splits payment into principal reduction and interest expense, (c) right-of-use asset depreciated monthly
Responsible (R): Treasury / System
Accountable (A): Fixed Asset Accountant
Duration: Automated monthly</bpmn:documentation>
        <bpmn:incoming>W1696_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1696_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1696_End11" name="Complete">
        <bpmn:incoming>W1696_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1696_Annotation12">
        <bpmn:text>Controls: - CTL-346 (ensure controlled execution — Asset Registration &amp; Lifecycle Tracking (PA-35.1).) | - operational: FP&amp;A Manager review and approval gate
Owner: FP&amp;A Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1696_Assoc13" sourceRef="W1696_Annotation12" targetRef="W1696_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1696_Flow14" sourceRef="W1696_Start6" targetRef="W1696_Task7" />
