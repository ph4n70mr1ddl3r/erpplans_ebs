    <bpmn:process id="W_W1694" name="W1694. Asset Component &amp; Sub-Asset Management" isExecutable="false">
      <bpmn:documentation>Trigger: Asset installation with identifiable components of different useful lives, or major component replacement
Frequency: ~3–5 component structures/month (10–15 new store builds/year per W1427 plus ~30–40 remodels/year per W109.2)
Volume: ~40–60/year
Owner: Fixed Asset Accountant
Participants: Fixed Asset Accountant, COO, Project Engineer
Source: workflow W1694 — Asset Component &amp; Sub-Asset Management</bpmn:documentation>
      <bpmn:laneSet id="W1694_LaneSet3">
        <bpmn:lane id="W1694_Lane1" name="Fixed Asset Accountant">
        <bpmn:flowNodeRef>W1694_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1694_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1694_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1694_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1694_Lane2" name="System">
        <bpmn:flowNodeRef>W1694_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1694_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1694_Start4" name="Asset installation with identifiable components of different useful lives, or major…">
        <bpmn:outgoing>W1694_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1694_Task5" name="During new store build or major renovation, Fixed Asset Accountant decomposes…">
        <bpmn:documentation>Step 1: During new store build or major renovation, Fixed Asset Accountant decomposes the project into component assets per PFRS component accounting: (a) building structure / leasehold improvements (10–20 years or lease term), (b) HVAC system (10–15 years), (c) electrical installation (15–20 years), (d) plumbing (15–20 years), (e) racking and shelving (10 years), (f) POS system (5 years), (g) signage (7–10 years), (h) paint and cosmetic finishes (3–5 years)
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 1–2 hours/store</bpmn:documentation>
        <bpmn:incoming>W1694_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1694_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1694_Task6" name="System creates parent asset record with sub-asset components, each with its…">
        <bpmn:documentation>Step 2: System creates parent asset record with sub-asset components, each with its own: (a) acquisition cost allocation (proportion of total project cost), (b) useful life, (c) depreciation method and schedule, (d) replacement schedule
Responsible (R): System
Accountable (A): Fixed Asset Accountant
Duration: 30 min/store</bpmn:documentation>
        <bpmn:incoming>W1694_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1694_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1694_Task7" name="When a component is replaced (e.g., HVAC replacement after 12 years): (a) old…">
        <bpmn:documentation>Step 3: When a component is replaced (e.g., HVAC replacement after 12 years): (a) old component derecognized — remaining book value written off, (b) new component capitalized as sub-asset with its own useful life, (c) parent asset and other components unaffected
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 15 min/component</bpmn:documentation>
        <bpmn:incoming>W1694_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1694_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1694_Task8" name="Annual review: Fixed Asset Accountant reviews component structures for assets…">
        <bpmn:documentation>Step 4: Annual review: Fixed Asset Accountant reviews component structures for assets approaching component replacement; coordinates with Facilities for planned replacement budget
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 1 day/year</bpmn:documentation>
        <bpmn:incoming>W1694_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1694_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1694_End9" name="Complete">
        <bpmn:incoming>W1694_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1694_Annotation10">
        <bpmn:text>Controls: - CTL-346 (ensure controlled execution — Asset Registration &amp; Lifecycle Tracking (PA-35.1).) | - operational: Fixed Asset Accountant review and approval gate
Owner: Fixed Asset Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1694_Assoc11" sourceRef="W1694_Annotation10" targetRef="W1694_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1694_Flow12" sourceRef="W1694_Start4" targetRef="W1694_Task5" />
      <bpmn:sequenceFlow id="W1694_Flow13" sourceRef="W1694_Task5" targetRef="W1694_Task6" />
      <bpmn:sequenceFlow id="W1694_Flow14" sourceRef="W1694_Task6" targetRef="W1694_Task7" />
      <bpmn:sequenceFlow id="W1694_Flow15" sourceRef="W1694_Task7" targetRef="W1694_Task8" />
      <bpmn:sequenceFlow id="W1694_Flow16" sourceRef="W1694_Task8" targetRef="W1694_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1694_diag">
      <bpmndi:BPMNPlane id="W1694_plane" bpmnElement="W_W1694">
        <bpmndi:BPMNShape id="W1694_Lane1_di" bpmnElement="W1694_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1694_Lane2_di" bpmnElement="W1694_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1694_Task5_di" bpmnElement="W1694_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
