        <bpmndi:BPMNShape id="W1693_Annotation14_di" bpmnElement="W1693_Annotation14"><dc:Bounds x="160" y="970" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1693_Flow16_di" bpmnElement="W1693_Flow16"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
