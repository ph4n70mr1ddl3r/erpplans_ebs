    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1691" name="W1691. Asset Classification &amp; Category Assignment" isExecutable="false">
      <bpmn:documentation>Trigger: New asset registration (W1690) or annual classification review
Frequency: Continuous for new assets; annual review in Q4
Volume: ~2,500–3,500 new classifications/year + ~15,000–20,000 existing assets reviewed annually
Owner: Fixed Asset Accountant
Participants: Fixed Asset Accountant, Accounting Manager, External Auditor
Source: workflow W1691 — Asset Classification &amp; Category Assignment</bpmn:documentation>
      <bpmn:laneSet id="W1691_LaneSet4">
        <bpmn:lane id="W1691_Lane1" name="System">
        <bpmn:flowNodeRef>W1691_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1691_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1691_Lane2" name="Fixed Asset Accountant">
        <bpmn:flowNodeRef>W1691_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1691_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1691_Lane3" name="External Auditor">
        <bpmn:flowNodeRef>W1691_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1691_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1691_Start5" name="New asset registration (W1690) or annual classification review">
        <bpmn:outgoing>W1691_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1691_Task6" name="System maintains standardized asset category tree aligned to PFRS/IAS 16 and…">
        <bpmn:documentation>Step 1: System maintains standardized asset category tree aligned to PFRS/IAS 16 and Philippine tax rules: (a) Land (non-depreciable), (b) Buildings &amp; Improvements (20–40 years), (c) Leasehold Improvements (shorter of useful life or lease term), (d) Plant &amp; Machinery (7–15 years), (e) Vehicles (5 years), (f) Furniture, Fixtures &amp; Equipment (5–10 years), (g) IT Equipment &amp; Software (3–5 years), (h) POS &amp; Retail Technology (5 years), (i) Warehouse Equipment (7–10 years)
Responsible (R): System
Accountable (A): Accounting Manager
Duration: Pre-configured</bpmn:documentation>
        <bpmn:incoming>W1691_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1691_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1691_Task7" name="Fixed Asset Accountant assigns category and sub-category during registration…">
        <bpmn:documentation>Step 2: Fixed Asset Accountant assigns category and sub-category during registration; system auto-populates default useful life and depreciation method; Accountant can override with justification (e.g., harsh environment may reduce useful life of DC forklifts from 7 to 5 years)
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 5 min/asset</bpmn:documentation>
        <bpmn:incoming>W1691_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1691_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1691_Task8" name="Annual review (Q4): Fixed Asset Accountant reviews category assignments for…">
        <bpmn:documentation>Step 3: Annual review (Q4): Fixed Asset Accountant reviews category assignments for material misclassifications; identifies assets with useful life that should be adjusted based on condition assessment; proposes reclassification to Accounting Manager
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 2–3 days/year</bpmn:documentation>
        <bpmn:incoming>W1691_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1691_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1691_Task9" name="External auditor reviews classification and useful life assumptions during…">
        <bpmn:documentation>Step 4: External auditor reviews classification and useful life assumptions during annual audit; confirms PFRS compliance; any reclassification adjustments posted before year-end close
Responsible (R): External Auditor / Fixed Asset Accountant
Accountable (A): CFO
Duration: During annual audit</bpmn:documentation>
        <bpmn:incoming>W1691_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1691_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1691_End10" name="Complete">
        <bpmn:incoming>W1691_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1691_Annotation11">
        <bpmn:text>Controls: - CTL-346 (ensure controlled execution — Asset Registration &amp; Lifecycle Tracking (PA-35.1).) | - operational: Fixed Asset Accountant review and approval gate
Owner: Fixed Asset Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1691_Assoc12" sourceRef="W1691_Annotation11" targetRef="W1691_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1691_Flow13" sourceRef="W1691_Start5" targetRef="W1691_Task6" />
      <bpmn:sequenceFlow id="W1691_Flow14" sourceRef="W1691_Task6" targetRef="W1691_Task7" />
      <bpmn:sequenceFlow id="W1691_Flow15" sourceRef="W1691_Task7" targetRef="W1691_Task8" />
      <bpmn:sequenceFlow id="W1691_Flow16" sourceRef="W1691_Task8" targetRef="W1691_Task9" />
      <bpmn:sequenceFlow id="W1691_Flow17" sourceRef="W1691_Task9" targetRef="W1691_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1691_diag">
      <bpmndi:BPMNPlane id="W1691_plane" bpmnElement="W_W1691">
        <bpmndi:BPMNShape id="W1691_Lane1_di" bpmnElement="W1691_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1691_Lane2_di" bpmnElement="W1691_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1691_Lane3_di" bpmnElement="W1691_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1691_Task6_di" bpmnElement="W1691_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1691_Task7_di" bpmnElement="W1691_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1691_Task8_di" bpmnElement="W1691_Task8"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1691_Task9_di" bpmnElement="W1691_Task9"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1691_Start5_di" bpmnElement="W1691_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1691_End10_di" bpmnElement="W1691_End10"><dc:Bounds x="1260" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1691_Annotation11_di" bpmnElement="W1691_Annotation11"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1691_Flow13_di" bpmnElement="W1691_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1691_Flow14_di" bpmnElement="W1691_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1691_Flow15_di" bpmnElement="W1691_Flow15"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1691_Flow16_di" bpmnElement="W1691_Flow16"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1691_Flow17_di" bpmnElement="W1691_Flow17"><di:waypoint x="1210" y="505" /><di:waypoint x="1260" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1691_Assoc12_di" bpmnElement="W1691_Assoc12"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1692" name="W1692. Asset Tag &amp; Label Generation &amp; Application" isExecutable="false">
      <bpmn:documentation>Trigger: New asset registration (W1690) or replacement of damaged/missing tag
Frequency: ~2,500–3,500 tags/year for new assets + ~500–1,000 replacement tags/year
Volume: ~3,000–4,500 tags/year
Owner: Fixed Asset Accountant
Participants: Fixed Asset Accountant, Receiving Clerk, Store Manager, DC Supervisor
Source: workflow W1692 — Asset Tag &amp; Label Generation &amp; Application</bpmn:documentation>
      <bpmn:laneSet id="W1692_LaneSet5">
        <bpmn:lane id="W1692_Lane1" name="System">
        <bpmn:flowNodeRef>W1692_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1692_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1692_Lane2" name="Fixed Asset Accountant">
        <bpmn:flowNodeRef>W1692_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1692_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1692_Lane3" name="Receiving Clerk">
        <bpmn:flowNodeRef>W1692_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1692_Lane4" name="Store Manager">
        <bpmn:flowNodeRef>W1692_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1692_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1692_Start6" name="New asset registration (W1690) or replacement of damaged/missing tag">
        <bpmn:outgoing>W1692_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1692_Task7" name="System auto-generates asset tag upon asset registration: (a) QR code containing…">
        <bpmn:documentation>Step 1: System auto-generates asset tag upon asset registration: (a) QR code containing asset number, description, location, category, and acquisition date, (b) barcode (Code 128) for scanning during physical verification per W1706, (c) human-readable label with asset number and brief description
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1692_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1692_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1692_Task8" name="Tag printed on durable polyester/Vinyl label (weather-resistant for DC/yard…">
        <bpmn:documentation>Step 2: Tag printed on durable polyester/Vinyl label (weather-resistant for DC/yard assets; tamper-evident for POS terminals and IT equipment); for high-value assets (≥ PHP 500K): engraved metal tag or RFID tag
Responsible (R): Fixed Asset Accountant / Receiving Clerk
Accountable (A): —
Duration: 2 min/tag</bpmn:documentation>
        <bpmn:incoming>W1692_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1692_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1692_Task9" name="Tag applied to asset at receiving or installation: (a) POS terminals: tag…">
        <bpmn:documentation>Step 3: Tag applied to asset at receiving or installation: (a) POS terminals: tag affixed to underside or back panel, (b) forklifts: metal tag riveted to frame, (c) store fixtures: tag on non-visible surface, (d) vehicles: tag in glove compartment + windshield sticker, (e) IT equipment: tag on back panel, (f) DC racking: tag at aisle end
Responsible (R): Receiving Clerk / Store Maintenance
Accountable (A): —
Duration: 2 min/tag</bpmn:documentation>
        <bpmn:incoming>W1692_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1692_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1692_Task10" name="Store Manager / DC Supervisor confirms tag application via mobile app scan…">
        <bpmn:documentation>Step 4: Store Manager / DC Supervisor confirms tag application via mobile app scan; system updates asset record with &quot;Tag Applied&quot; status and date — the scan doubles as the custody-acceptance signature: the location&#x27;s custodian of record accepts accountability for the tagged asset at that scan
Responsible (R): Store Manager / DC Supervisor
Accountable (A): —
Duration: 1 min/scan</bpmn:documentation>
        <bpmn:incoming>W1692_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1692_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1692_Task11" name="Missing/damaged tag replacement: any employee reports missing tag via helpdesk…">
        <bpmn:documentation>Step 5: Missing/damaged tag replacement: any employee reports missing tag via helpdesk ticket; Fixed Asset Accountant verifies asset existence, generates replacement tag, ships to location; location confirms re-application
Responsible (R): Fixed Asset Accountant / Store Manager
Accountable (A): —
Duration: 15 min/case</bpmn:documentation>
        <bpmn:incoming>W1692_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1692_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1692_End12" name="Complete">
        <bpmn:incoming>W1692_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1692_Annotation13">
        <bpmn:text>Controls: - CTL-219 (ensure fixed-asset register accuracy.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Fixed Asset Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1692_Assoc14" sourceRef="W1692_Annotation13" targetRef="W1692_Start6" associationDirection="None" />
