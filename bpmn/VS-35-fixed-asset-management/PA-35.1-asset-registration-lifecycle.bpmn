    <bpmn:process id="W_W1697" name="W1697. Asset Insurance Coverage Tracking &amp; Linkage" isExecutable="false">
      <bpmn:documentation>Trigger: New asset registration (W1690), annual insurance renewal, or significant asset addition/disposal
Frequency: Continuous for new assets; annual policy renewal review
Volume: ~2,500–3,500 coverage updates/year
Owner: Insurance &amp; Risk Officer
Participants: Insurance &amp; Risk Officer, Fixed Asset Accountant, Treasury, Insurance Broker
Source: workflow W1697 — Asset Insurance Coverage Tracking &amp; Linkage</bpmn:documentation>
      <bpmn:laneSet id="W1697_LaneSet4">
        <bpmn:lane id="W1697_Lane1" name="Insurance &amp; Risk Officer">
        <bpmn:flowNodeRef>W1697_Task6</bpmn:flowNodeRef>
