    <bpmn:process id="W_W1695" name="W1695. Asset Maintenance Schedule &amp; History Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Asset registration (W1690), manufacturer warranty requirement, or regulatory mandate (e.g., forklift annual inspection)
Frequency: Continuous — ~4,000–6,000 maintenance events/month across all assets
Volume: ~50,000–70,000 maintenance records/year
Owner: Maintenance Supervisor (DC) / Store Maintenance (stores) / IT Helpdesk (IT assets)
Participants: Maintenance Supervisor, Store Maintenance, IT Helpdesk, Fixed Asset Accountant
Source: workflow W1695 — Asset Maintenance Schedule &amp; History Tracking</bpmn:documentation>
      <bpmn:laneSet id="W1695_LaneSet4">
        <bpmn:lane id="W1695_Lane1" name="System">
        <bpmn:flowNodeRef>W1695_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1695_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1695_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1695_Lane2" name="Maintenance Technician">
        <bpmn:flowNodeRef>W1695_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1695_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1695_Lane3" name="Fixed Asset Accountant">
        <bpmn:flowNodeRef>W1695_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1695_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1695_Start5" name="Asset registration (W1690), manufacturer warranty requirement, or regulatory mandate…">
        <bpmn:outgoing>W1695_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1695_Task6" name="eAM auto-generates the preventive maintenance schedule as PM work orders based…">
        <bpmn:documentation>Step 1: eAM auto-generates the preventive maintenance schedule as PM work orders based on asset category rules on the FA-linked eAM asset register: (a) forklifts: monthly inspection, annual comprehensive service, (b) HVAC: quarterly filter change, annual full service, (c) POS terminals: quarterly cleaning and calibration, (d) delivery vehicles: every 5,000 km oil change, annual registration renewal, (e) generators: monthly test run, quarterly full load test, (f) fire suppression systems: annual certification
Responsible (R): System (eAM PM scheduling)
Accountable (A): Maintenance Supervisor
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1695_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1695_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1695_Task7" name="Maintenance team executes the eAM work orders; records in the work order: (a)…">
        <bpmn:documentation>Step 2: Maintenance team executes the eAM work orders; records in the work order: (a) date, technician, work performed, parts used (linked to spare parts inventory via work-order parts issue), (b) cost (labor hours + parts) — work-order costing rolls to GL/AP and is categorized as maintenance expense (not capitalized), (c) next service due date updated automatically
Responsible (R): Maintenance Technician
Accountable (A): Maintenance Supervisor
Duration: 30 min–4 hours/event</bpmn:documentation>
        <bpmn:incoming>W1695_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1695_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1695_Task8" name="Emergency/breakdown maintenance: (a) asset user reports failure via helpdesk…">
        <bpmn:documentation>Step 3: Emergency/breakdown maintenance: (a) asset user reports failure via helpdesk, (b) maintenance team responds and diagnoses, (c) repair or replacement performed, (d) if repair extends useful life or increases capacity → cost capitalized as asset improvement per W1690; if repair merely restores function → expensed, (e) maintenance history updated
Responsible (R): Maintenance Technician
Accountable (A): Maintenance Supervisor
Duration: Variable</bpmn:documentation>
        <bpmn:incoming>W1695_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1695_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1695_Task9" name="Fixed Asset Accountant reviews capitalized maintenance costs monthly to ensure…">
        <bpmn:documentation>Step 4: Fixed Asset Accountant reviews capitalized maintenance costs monthly to ensure proper capitalization vs. expense treatment per PFRS
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1695_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1695_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1695_Task10" name="Asset maintenance history available from the eAM work-order history on the…">
        <bpmn:documentation>Step 5: Asset maintenance history available from the eAM work-order history on the FA-linked asset register for: (a) physical verification condition assessment per W1706, (b) vendor warranty claims, (c) replacement decision support (frequency and cost of repairs vs. replacement)
Responsible (R): System (eAM history)
Accountable (A): —
Duration: On-demand</bpmn:documentation>
        <bpmn:incoming>W1695_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1695_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1695_End11" name="Complete">
        <bpmn:incoming>W1695_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1695_Annotation12">
        <bpmn:text>Controls: - CTL-346 (ensure controlled execution — Asset Registration &amp; Lifecycle Tracking (PA-35.1).) | - operational: Maintenance Supervisor (DC) / Store Maintenance (stores) / IT Helpdesk (IT assets) review and approval gate
Owner: Maintenance Supervisor (DC) / Store Maintenance (stores) / IT Helpdesk (IT assets)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1695_Assoc13" sourceRef="W1695_Annotation12" targetRef="W1695_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1695_Flow14" sourceRef="W1695_Start5" targetRef="W1695_Task6" />
      <bpmn:sequenceFlow id="W1695_Flow15" sourceRef="W1695_Task6" targetRef="W1695_Task7" />
      <bpmn:sequenceFlow id="W1695_Flow16" sourceRef="W1695_Task7" targetRef="W1695_Task8" />
      <bpmn:sequenceFlow id="W1695_Flow17" sourceRef="W1695_Task8" targetRef="W1695_Task9" />
      <bpmn:sequenceFlow id="W1695_Flow18" sourceRef="W1695_Task9" targetRef="W1695_Task10" />
      <bpmn:sequenceFlow id="W1695_Flow19" sourceRef="W1695_Task10" targetRef="W1695_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1695_diag">
      <bpmndi:BPMNPlane id="W1695_plane" bpmnElement="W_W1695">
