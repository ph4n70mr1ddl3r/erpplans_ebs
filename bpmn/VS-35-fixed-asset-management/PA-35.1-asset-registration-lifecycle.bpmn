<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-35.1-asset-registration-lifecycle" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1690" name="W1690. New Fixed Asset Registration &amp; Capitalization" isExecutable="false">
      <bpmn:documentation>Trigger: Purchase order receipt for capital asset or construction project completion per W40.3
Frequency: ~200–300 new assets/month (store fixtures, IT equipment, vehicles, renovation components)
Volume: ~2,500–3,500 new fixed assets/year
Owner: Fixed Asset Accountant
Participants: Fixed Asset Accountant, Receiving Clerk, Department Head, CFO (for assets &gt; threshold)
Source: workflow W1690 — New Fixed Asset Registration &amp; Capitalization</bpmn:documentation>
      <bpmn:laneSet id="W1690_LaneSet5">
        <bpmn:lane id="W1690_Lane1" name="System">
        <bpmn:flowNodeRef>W1690_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1690_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1690_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1690_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1690_Lane2" name="Fixed Asset Accountant">
        <bpmn:flowNodeRef>W1690_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1690_Lane3" name="Accounting Manager">
        <bpmn:flowNodeRef>W1690_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1690_Lane4" name="Receiving Clerk">
        <bpmn:flowNodeRef>W1690_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1690_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1690_Start6" name="Purchase order receipt for capital asset or construction project completion per W40.3">
        <bpmn:outgoing>W1690_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1690_Task7" name="System auto-generates asset registration candidate from approved PO or capex…">
        <bpmn:documentation>Step 1: System auto-generates asset registration candidate from approved PO or capex project closure: (a) PO with asset category flag flows the asset candidate into the mass additions queue for Fixed Asset review, (b) capex project completion triggers CIP-to-asset conversion per W40.3, (c) manual creation for donated, leased, or transferred assets
Responsible (R): System
Accountable (A): Fixed Asset Accountant
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1690_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1690_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1690_Task8" name="Fixed Asset Accountant reviews and enriches asset record: (a) assigns unique…">
        <bpmn:documentation>Step 2: Fixed Asset Accountant reviews and enriches asset record: (a) assigns unique asset number (format: BRD-XX-YYYY-NNNNN where XX = entity code, YYYY = year, NNNNN = sequential), (b) enters asset description, category, sub-category (POS terminal, forklift, fixture, vehicle, IT equipment, office furniture), (c) links to cost center, location (store/DC/HQ code), and responsible department, (d) records acquisition cost including non-recoverable VAT, delivery, installation, and testing costs per PFRS, (e) assigns useful life per category schedule (POS terminals: 5 years; forklifts: 7 years; store fixtures: 10 years; vehicles: 5 years; IT servers: 4 years; office furniture: 8 years), (f) assigns depreciation method (straight-line for all; declining balance for vehicles), (g) records vendor, PO reference, GR reference, and warranty expiry, (h) assigns the asset custodian of record into the Assigned-To field — the location manager, DC supervisor or department head of record for the space the asset occupies; named individual for IT equipment, tools and vehicles, role-of-record for fixtures — so custody is never blank and moves only via the W1693 release-and-accept chain
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 15 min/asset</bpmn:documentation>
        <bpmn:incoming>W1690_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1690_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1690_Task9" name="System validates capitalization threshold: assets ≥ PHP 20,000 capitalized…">
        <bpmn:documentation>Step 3: System validates capitalization threshold: assets ≥ PHP 20,000 capitalized; assets &lt; PHP 20,000 charged to expense (policy threshold reviewed annually). Threshold excludes low-value items like individual hand tools, cables, or accessories; items below the threshold but accountable by nature — power tools, measuring instruments, cameras — are flagged as tractable items, expensed yet carried on the countable minor-asset register so the W1706 count covers them
Responsible (R): System
Accountable (A): Fixed Asset Accountant
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1690_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1690_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1690_Task10" name="For assets requiring capitalization approval (≥ PHP 500K): Accounting Manager…">
        <bpmn:documentation>Step 4: For assets requiring capitalization approval (≥ PHP 500K): Accounting Manager reviews asset record, verifies capex approval per W1811, confirms classification and useful life; approves capitalization
Responsible (R): Accounting Manager
Accountable (A): CFO
Duration: 10 min/asset</bpmn:documentation>
        <bpmn:incoming>W1690_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1690_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1690_Task11" name="System activates asset in fixed asset register; depreciation begins from the…">
        <bpmn:documentation>Step 5: System activates asset in fixed asset register; depreciation begins from the asset&#x27;s ready-for-use date (not invoice date); asset appears in entity-specific fixed asset register and consolidated group register
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1690_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1690_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1690_Task12" name="Asset tag generated and assigned per W1692; physical label applied to asset at…">
        <bpmn:documentation>Step 6: Asset tag generated and assigned per W1692; physical label applied to asset at receiving or installation
Responsible (R): Receiving Clerk / Fixed Asset Accountant
Accountable (A): —
Duration: 5 min/asset</bpmn:documentation>
        <bpmn:incoming>W1690_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1690_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1690_End13" name="Complete">
        <bpmn:incoming>W1690_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1690_Annotation14">
        <bpmn:text>Controls: - CTL-219 (ensure fixed-asset register accuracy.) | - operational: Fixed Asset Accountant review and approval gate
Owner: Fixed Asset Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1690_Assoc15" sourceRef="W1690_Annotation14" targetRef="W1690_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1690_Flow16" sourceRef="W1690_Start6" targetRef="W1690_Task7" />
      <bpmn:sequenceFlow id="W1690_Flow17" sourceRef="W1690_Task7" targetRef="W1690_Task8" />
      <bpmn:sequenceFlow id="W1690_Flow18" sourceRef="W1690_Task8" targetRef="W1690_Task9" />
      <bpmn:sequenceFlow id="W1690_Flow19" sourceRef="W1690_Task9" targetRef="W1690_Task10" />
      <bpmn:sequenceFlow id="W1690_Flow20" sourceRef="W1690_Task10" targetRef="W1690_Task11" />
      <bpmn:sequenceFlow id="W1690_Flow21" sourceRef="W1690_Task11" targetRef="W1690_Task12" />
      <bpmn:sequenceFlow id="W1690_Flow22" sourceRef="W1690_Task12" targetRef="W1690_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1690_diag">
      <bpmndi:BPMNPlane id="W1690_plane" bpmnElement="W_W1690">
        <bpmndi:BPMNShape id="W1690_Lane1_di" bpmnElement="W1690_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1690_Lane2_di" bpmnElement="W1690_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1690_Lane3_di" bpmnElement="W1690_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1690_Lane4_di" bpmnElement="W1690_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1690_Task7_di" bpmnElement="W1690_Task7"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1690_Task8_di" bpmnElement="W1690_Task8"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1690_Task9_di" bpmnElement="W1690_Task9"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1690_Task10_di" bpmnElement="W1690_Task10"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1690_Task11_di" bpmnElement="W1690_Task11"><dc:Bounds x="1240" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1690_Task12_di" bpmnElement="W1690_Task12"><dc:Bounds x="1450" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1690_Start6_di" bpmnElement="W1690_Start6"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1690_End13_di" bpmnElement="W1690_End13"><dc:Bounds x="1680" y="657" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1690_Annotation14_di" bpmnElement="W1690_Annotation14"><dc:Bounds x="160" y="800" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1690_Flow16_di" bpmnElement="W1690_Flow16"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1690_Flow17_di" bpmnElement="W1690_Flow17"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1690_Flow18_di" bpmnElement="W1690_Flow18"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1690_Flow19_di" bpmnElement="W1690_Flow19"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1690_Flow20_di" bpmnElement="W1690_Flow20"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1690_Flow21_di" bpmnElement="W1690_Flow21"><di:waypoint x="1420" y="165" /><di:waypoint x="1450" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1690_Flow22_di" bpmnElement="W1690_Flow22"><di:waypoint x="1630" y="675" /><di:waypoint x="1680" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1690_Assoc15_di" bpmnElement="W1690_Assoc15"><di:waypoint x="340" y="800" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
