      <bpmn:startEvent id="W1697_Start5" name="New asset registration (W1690), annual insurance renewal, or significant asset…">
        <bpmn:outgoing>W1697_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1697_Task6" name="Insurance &amp; Risk Officer maintains insurance coverage matrix by asset category…">
        <bpmn:documentation>Step 1: Insurance &amp; Risk Officer maintains insurance coverage matrix by asset category: (a) property insurance (buildings, leasehold improvements, fixtures) — blanket policy per entity, (b) motor vehicle insurance — per-vehicle policy, (c) equipment breakdown / boiler &amp; machinery — DC equipment, generators, HVAC, (d) electronic equipment insurance — POS terminals, servers, RF guns, (e) transit / inland marine — assets in transit between locations, (f) business interruption — linked to property coverage
Responsible (R): Insurance &amp; Risk Officer
Accountable (A): CFO
Duration: Maintained continuously</bpmn:documentation>
        <bpmn:incoming>W1697_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1697_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1697_Task7" name="System auto-flags new assets above coverage threshold for insurance enrollment…">
        <bpmn:documentation>Step 2: System auto-flags new assets above coverage threshold for insurance enrollment: (a) vehicles: auto-enrolled in motor fleet policy within 7 days of registration, (b) high-value assets ≥ PHP 1M: reported to broker for schedule update, (c) DC equipment: added to equipment breakdown schedule
Responsible (R): System
Accountable (A): Insurance &amp; Risk Officer
Duration: Automated flag; manual update</bpmn:documentation>
        <bpmn:incoming>W1697_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1697_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1697_Task8" name="Asset disposal/retirement per W1708 triggers insurance schedule update: (a)…">
        <bpmn:documentation>Step 3: Asset disposal/retirement per W1708 triggers insurance schedule update: (a) vehicle retired → motor policy endorsement to remove, (b) asset written off due to damage → insurance claim initiated per W837 (VS-26), (c) blanket policy: no change needed for individual assets unless approaching aggregate limit
Responsible (R): Fixed Asset Accountant / Insurance &amp; Risk Officer
Accountable (A): —
Duration: 10 min/disposal</bpmn:documentation>
        <bpmn:incoming>W1697_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1697_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1697_Task9" name="Annual insurance renewal: (a) Insurance &amp; Risk Officer exports asset register…">
        <bpmn:documentation>Step 4: Annual insurance renewal: (a) Insurance &amp; Risk Officer exports asset register summary by category and entity, (b) compares with insurance schedule to identify coverage gaps or over-insurance, (c) submits updated schedule to broker with renewal instructions, (d) Treasury processes premium payment
Responsible (R): Insurance &amp; Risk Officer
Accountable (A): CFO
Duration: 2–3 days/year</bpmn:documentation>
        <bpmn:incoming>W1697_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1697_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1697_Task10" name="Monthly reconciliation: Fixed Asset Accountant reconciles asset register totals…">
        <bpmn:documentation>Step 5: Monthly reconciliation: Fixed Asset Accountant reconciles asset register totals with insurance coverage amounts; material variances (&gt; 10%) reported to Insurance &amp; Risk Officer for schedule correction
Responsible (R): Fixed Asset Accountant
Accountable (A): Insurance &amp; Risk Officer
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1697_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1697_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1697_End11" name="Complete">
        <bpmn:incoming>W1697_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1697_Annotation12">
        <bpmn:text>Controls: - CTL-219 (ensure fixed-asset register accuracy.) | - operational: periodic reconciliation against source documents
Owner: Insurance &amp; Risk Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1697_Assoc13" sourceRef="W1697_Annotation12" targetRef="W1697_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1697_Flow14" sourceRef="W1697_Start5" targetRef="W1697_Task6" />
      <bpmn:sequenceFlow id="W1697_Flow15" sourceRef="W1697_Task6" targetRef="W1697_Task7" />
      <bpmn:sequenceFlow id="W1697_Flow16" sourceRef="W1697_Task7" targetRef="W1697_Task8" />
      <bpmn:sequenceFlow id="W1697_Flow17" sourceRef="W1697_Task8" targetRef="W1697_Task9" />
      <bpmn:sequenceFlow id="W1697_Flow18" sourceRef="W1697_Task9" targetRef="W1697_Task10" />
      <bpmn:sequenceFlow id="W1697_Flow19" sourceRef="W1697_Task10" targetRef="W1697_End11" />
    </bpmn:process>
