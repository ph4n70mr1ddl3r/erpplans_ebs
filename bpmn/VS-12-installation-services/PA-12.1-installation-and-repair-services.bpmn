    <bpmn:process id="W_W1519" name="W1519. Plumbing Fixture &amp; Water System Installation Service Management" isExecutable="false">
      <bpmn:documentation>Trigger: Customer purchases plumbing fixtures (water heater, faucet set, toilet, shower system, water pump, water tank) and requests installation service at POS or via service counter
Frequency: ~300–500 plumbing installation orders/month chain-wide
Volume: Average service value: PHP 2,000–8,000 labor + PHP 3,000–30,000 materials
Owner: Service Coordinator
Participants: Service Coordinator, Plumbing Installation Subcontractor, Store Manager, Customer
Source: workflow W1519 — Plumbing Fixture &amp; Water System Installation Service Management</bpmn:documentation>
      <bpmn:laneSet id="W1519_LaneSet3">
        <bpmn:lane id="W1519_Lane1" name="Service Coordinator">
        <bpmn:flowNodeRef>W1519_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1519_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1519_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1519_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1519_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1519_Lane2" name="Plumbing Subcontractor">
        <bpmn:flowNodeRef>W1519_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1519_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1519_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1519_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1519_Start4" name="Customer purchases plumbing fixtures (water heater, faucet set, toilet, shower system…">
        <bpmn:outgoing>W1519_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1519_Task5" name="Service order creation">
        <bpmn:documentation>Step 1: Service order creation: (a) at POS or service counter: customer selects plumbing fixtures + installation service SKU; (b) Service Coordinator creates service order linked to product sales order; (c) captures: (i) installation type (faucet, toilet, water heater, shower set, water pump, water tank), (ii) installation location (kitchen, bathroom, laundry, outdoor), (iii) existing plumbing condition (new installation vs. replacement), (iv) preferred schedule date/time, (v) site address, (vi) customer contact; (d) system calculates service fee based on installation type and complexity matrix
Responsible (R): Service Coordinator
Accountable (A): —
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W1519_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1519_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1519_Task6" name="Site assessment dispatch">
        <bpmn:documentation>Step 2: Site assessment dispatch (for complex installations: water heater, water pump, water tank, or any gas-line work): (a) Service Coordinator schedules site assessment visit by plumbing subcontractor; (b) subcontractor visits site and documents: (i) existing plumbing layout, (ii) pipe material and condition (PVC, galvanized iron, PPR, PE), (iii) water pressure, (iv) electrical proximity (for electric water heaters), (v) venting path (for gas water heaters), (vi) structural mounting requirements (water tank on roof); (c) subcontractor submits assessment report via mobile app: photos, required additional materials (pipes, fittings, valves, sealant), estimated labor hours, any access challenges
Responsible (R): Plumbing Subcontractor
Accountable (A): Service Coordinator
Duration: 30–60 min/site visit</bpmn:documentation>
        <bpmn:incoming>W1519_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1519_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1519_Task7" name="Material confirmation">
        <bpmn:documentation>Step 3: Material confirmation: (a) Service Coordinator reviews assessment report; (b) confirms additional materials needed beyond customer-purchased items: pipes, fittings, valves, sealant, mounting hardware; (c) additional materials either: (i) sourced from store inventory (customer returns to purchase), or (ii) included in service fee as &quot;installation materials kit&quot; (pre-defined per service type); (d) system generates updated service quotation with materials; customer confirms via SMS/app
Responsible (R): Service Coordinator
Accountable (A): —
Duration: 15–20 min</bpmn:documentation>
        <bpmn:incoming>W1519_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1519_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1519_Task8" name="Installation scheduling">
        <bpmn:documentation>Step 4: Installation scheduling: (a) Service Coordinator assigns job to accredited plumbing subcontractor based on: (i) geographic zone, (ii) skill match (gas water heater requires subcontractor with gas fitting experience), (iii) schedule availability; (b) subcontractor receives work order via mobile app with: site address, installation scope, product details, customer contact, preferred time, assessment report photos; (c) system sends customer SMS confirmation with subcontractor name, photo, and estimated arrival time
Responsible (R): Service Coordinator / System
Accountable (A): —
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W1519_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1519_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1519_Task9" name="Installation execution">
        <bpmn:documentation>Step 5: Installation execution: (a) subcontractor arrives at site; verifies product delivered/present; confirms scope with customer; (b) performs installation: (i) shuts off water supply, (ii) installs fixture per manufacturer specification and Philippine Plumbing Code (PPC) standards, (iii) connects to existing plumbing system, (iv) tests for leaks (pressurize and hold 15 min), (v) checks drainage flow, (vi) for water heaters: verifies electrical connection (or gas line connection + leak test), (vii) cleans up work area; (c) captures before/after photos via mobile app
Responsible (R): Plumbing Subcontractor
Accountable (A): Service Coordinator
Duration: 1–4 hours (varies by job complexity)</bpmn:documentation>
        <bpmn:incoming>W1519_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1519_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1519_Task10" name="Quality sign-off and warranty registration">
        <bpmn:documentation>Step 6: Quality sign-off and warranty registration: (a) customer inspects completed work; (b) subcontractor demonstrates: fixture operation, water shut-off valve location, basic maintenance (e.g., cleaning faucet aerator); (c) customer signs digital completion certificate per W1254; (d) system registers 12-month installation warranty; (e) system triggers product warranty registration if applicable (manufacturer warranty); (f) subcontractor marks job complete in mobile app
Responsible (R): Plumbing Subcontractor / Customer
Accountable (A): Service Coordinator
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W1519_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1519_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1519_Task11" name="Service order closure">
        <bpmn:documentation>Step 7: Service order closure: (a) Service Coordinator reviews completion certificate and photos; (b) confirms no outstanding issues; (c) system triggers: (i) subcontractor payment (per agreed labor rate), (ii) customer satisfaction survey (SMS link), (iii) installation cost posted to store service revenue GL
Responsible (R): Service Coordinator / System
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1519_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1519_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1519_End12" name="Complete">
        <bpmn:incoming>W1519_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1519_Annotation13">
        <bpmn:text>Controls: - CTL-275 (ensure controlled execution — Installation &amp; Repair Services (PA-12.1).) | - operational: Service Coordinator review and approval gate
Owner: Service Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1519_Assoc14" sourceRef="W1519_Annotation13" targetRef="W1519_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1519_Flow15" sourceRef="W1519_Start4" targetRef="W1519_Task5" />
      <bpmn:sequenceFlow id="W1519_Flow16" sourceRef="W1519_Task5" targetRef="W1519_Task6" />
      <bpmn:sequenceFlow id="W1519_Flow17" sourceRef="W1519_Task6" targetRef="W1519_Task7" />
      <bpmn:sequenceFlow id="W1519_Flow18" sourceRef="W1519_Task7" targetRef="W1519_Task8" />
      <bpmn:sequenceFlow id="W1519_Flow19" sourceRef="W1519_Task8" targetRef="W1519_Task9" />
      <bpmn:sequenceFlow id="W1519_Flow20" sourceRef="W1519_Task9" targetRef="W1519_Task10" />
      <bpmn:sequenceFlow id="W1519_Flow21" sourceRef="W1519_Task10" targetRef="W1519_Task11" />
      <bpmn:sequenceFlow id="W1519_Flow22" sourceRef="W1519_Task11" targetRef="W1519_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1519_diag">
      <bpmndi:BPMNPlane id="W1519_plane" bpmnElement="W_W1519">
        <bpmndi:BPMNShape id="W1519_Lane1_di" bpmnElement="W1519_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1519_Lane2_di" bpmnElement="W1519_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1519_Task5_di" bpmnElement="W1519_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
