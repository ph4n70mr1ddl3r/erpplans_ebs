    <bpmn:process id="W_W148" name="W148. Home Design &amp; Consultancy Services" isExecutable="false">
      <bpmn:documentation>Trigger: Customer requests renovation planning for Kitchen, Bathroom, or Wardrobe
Frequency: Daily; ~5–10 requests per store/month
Volume: High-value sales potential (PHP 50,000–500,000 per lead)
Owner: Design Consultant
Participants: Customer, Sales Rep, Category Manager
Source: workflow W148 — Home Design &amp; Consultancy Services</bpmn:documentation>
      <bpmn:laneSet id="W148_LaneSet3">
        <bpmn:lane id="W148_Lane1" name="Design Consultant">
        <bpmn:flowNodeRef>W148_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W148_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W148_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W148_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W148_Lane2" name="Sales Rep">
        <bpmn:flowNodeRef>W148_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W148_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W148_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W148_Start4" name="Customer requests renovation planning for Kitchen, Bathroom, or Wardrobe">
        <bpmn:outgoing>W148_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W148_Task5" name="Discovery">
        <bpmn:documentation>Step 1: Discovery: Interview customer on needs, style, and budget; schedule site measurement if needed
Responsible (R): Design Consultant
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W148_Flow13</bpmn:incoming>
        <bpmn:outgoing>W148_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W148_Task6" name="3D Modeling">
        <bpmn:documentation>Step 2: 3D Modeling: Create kitchen/bath layout using design software; select SKUs from active assortment
Responsible (R): Design Consultant
Accountable (A): —
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W148_Flow14</bpmn:incoming>
        <bpmn:outgoing>W148_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W148_Task7" name="Presentation">
        <bpmn:documentation>Step 3: Presentation: Present 3D render and detailed BOM (Bill of Materials) to customer
Responsible (R): Design Consultant
Accountable (A): Sales Rep
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W148_Flow15</bpmn:incoming>
        <bpmn:outgoing>W148_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W148_Task8" name="Quotation">
        <bpmn:documentation>Step 4: Quotation: Generate project quotation (W58.1a) with bundled discount if applicable
Responsible (R): Sales Rep
Accountable (A): Category Mgr
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W148_Flow16</bpmn:incoming>
        <bpmn:outgoing>W148_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W148_Task9" name="Order Conversion">
        <bpmn:documentation>Step 5: Order Conversion: Customer accepts; convert to Sales Order; coordinate delivery and installation (W138)
Responsible (R): Sales Rep
Accountable (A): Store Mgr
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W148_Flow17</bpmn:incoming>
        <bpmn:outgoing>W148_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W148_End10" name="Complete">
        <bpmn:incoming>W148_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W148_Annotation11">
        <bpmn:text>Controls: - CTL-275 (ensure controlled execution — Installation &amp; Repair Services (PA-12.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Design Consultant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W148_Assoc12" sourceRef="W148_Annotation11" targetRef="W148_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W148_Flow13" sourceRef="W148_Start4" targetRef="W148_Task5" />
