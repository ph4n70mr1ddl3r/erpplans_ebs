      <bpmndi:BPMNPlane id="W1198_plane" bpmnElement="W_W1198">
        <bpmndi:BPMNShape id="W1198_Lane1_di" bpmnElement="W1198_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
