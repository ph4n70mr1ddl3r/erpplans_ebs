    <bpmn:process id="W_W168" name="W168. Custom Paint Mixing &amp; Tinting Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Customer selects a base paint and a specific color from the swatch/fan deck
Frequency: High volume; ~1–3 tinting requests per store/day (≈~88,000–219,000 liters/year chain-wide at ~4 L per request)
Volume: ~100,000+ liters mixed annually chain-wide
Owner: Paint Department Supervisor
Participants: Paint Technician (Sales Associate), Customer, Cashier
Source: workflow W168 — Custom Paint Mixing &amp; Tinting Operations</bpmn:documentation>
      <bpmn:laneSet id="W168_LaneSet3">
        <bpmn:lane id="W168_Lane1" name="Paint Technician">
        <bpmn:flowNodeRef>W168_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W168_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W168_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W168_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W168_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W168_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W168_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W168_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W168_Lane2" name="Cashier">
        <bpmn:flowNodeRef>W168_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W168_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W168_Start4" name="Customer selects a base paint and a specific color from the swatch/fan deck">
        <bpmn:outgoing>W168_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W168_Task5" name="Color Selection">
        <bpmn:documentation>Step 1: Color Selection: Customer chooses color code from brand swatch; Technician identifies required Base Paint (A, B, C, or Deep)
Responsible (R): Paint Technician
Accountable (A): —
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W168_Flow16</bpmn:incoming>
        <bpmn:outgoing>W168_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W168_Task6" name="System Entry">
        <bpmn:documentation>Step 2: System Entry: Technician enters Color Code and Can Size in the tinting machine software; system calculates required colorant dosage
Responsible (R): Paint Technician
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W168_Flow17</bpmn:incoming>
        <bpmn:outgoing>W168_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W168_Task7" name="Tinting">
        <bpmn:documentation>Step 3: Tinting: Technician places base can under dispenser; machine injects colorants; system logs colorant consumption per canister
Responsible (R): Paint Technician
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W168_Flow18</bpmn:incoming>
        <bpmn:outgoing>W168_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W168_Task8" name="Mixing">
        <bpmn:documentation>Step 4: Mixing: Can is sealed and placed in the Gyroscopic Mixer for 2–3 minutes to ensure uniform color distribution
Responsible (R): Paint Technician
Accountable (A): —
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W168_Flow19</bpmn:incoming>
        <bpmn:outgoing>W168_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W168_Task9" name="Quality Check">
        <bpmn:documentation>Step 5: Quality Check: Technician performs a &quot;dot test&quot; on the can lid; dries with heat gun; verifies match against physical swatch
Responsible (R): Paint Technician
Accountable (A): Dept Supervisor
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W168_Flow20</bpmn:incoming>
        <bpmn:outgoing>W168_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W168_Task10" name="Labeling &amp; POS">
        <bpmn:documentation>Step 6: Labeling &amp; POS: Technician generates a &quot;Custom Tint&quot; barcode label from the system; labels can; customer takes to Cashier
Responsible (R): Paint Technician
Accountable (A): —
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W168_Flow21</bpmn:incoming>
        <bpmn:outgoing>W168_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W168_Task11" name="Checkout">
        <bpmn:documentation>Step 7: Checkout: Cashier scans Custom SKU; system deducts Base Paint and Colorants from inventory in real-time
Responsible (R): Cashier
Accountable (A): —
Duration: 30 sec</bpmn:documentation>
        <bpmn:incoming>W168_Flow22</bpmn:incoming>
        <bpmn:outgoing>W168_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W168_Task12" name="Machine Maintenance">
        <bpmn:documentation>Step 8: Machine Maintenance: Daily nozzle cleaning and weekly calibration to ensure color accuracy
Responsible (R): Paint Technician
Accountable (A): Dept Supervisor
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W168_Flow23</bpmn:incoming>
        <bpmn:outgoing>W168_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W168_End13" name="Complete">
        <bpmn:incoming>W168_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W168_Annotation14">
        <bpmn:text>Controls: - CTL-275 (ensure controlled execution — Installation &amp; Repair Services (PA-12.1).) | - operational: records
Owner: Paint Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W168_Assoc15" sourceRef="W168_Annotation14" targetRef="W168_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W168_Flow16" sourceRef="W168_Start4" targetRef="W168_Task5" />
