<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-12.1-installation-and-repair-services" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W138" name="W138. Home Installation Services Management" isExecutable="false">
      <bpmn:documentation>Trigger: Customer purchases installation-eligible product (e.g., split-type AC, water heater, floor tiles) and requests service
Frequency: Daily across 200 stores
Volume: ~500–800 service orders/week chain-wide
Owner: Services Manager (HQ); Customer Service Rep (Store)
Participants: CSR, Installation Contractor (3rd party), Warehouse/Logistics, Finance, Customer
Source: workflow W138 — Home Installation Services Management</bpmn:documentation>
      <bpmn:laneSet id="W138_LaneSet8">
        <bpmn:lane id="W138_Lane1" name="CSR">
        <bpmn:flowNodeRef>W138_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W138_Start9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W138_Lane2" name="System">
        <bpmn:flowNodeRef>W138_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W138_Task19</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W138_Lane3" name="Contractor">
        <bpmn:flowNodeRef>W138_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W138_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W138_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W138_Lane4" name="Warehouse">
        <bpmn:flowNodeRef>W138_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W138_Lane5" name="Customer">
        <bpmn:flowNodeRef>W138_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W138_Lane6" name="Services Mgr">
        <bpmn:flowNodeRef>W138_Task17</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W138_Lane7" name="Finance">
        <bpmn:flowNodeRef>W138_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W138_End20</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W138_Start9" name="Customer purchases installation-eligible product (e.g., split-type AC, water heater…">
        <bpmn:outgoing>W138_Flow23</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W138_Task10" name="Service Sale">
        <bpmn:documentation>Step 1: Service Sale: Customer purchases item + Service SKU at POS; CSR captures site details (address, contact, preferred date) and attaches to Service Order (SO)
Responsible (R): CSR
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W138_Flow23</bpmn:incoming>
        <bpmn:outgoing>W138_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W138_Task11" name="Contractor Assignment">
        <bpmn:documentation>Step 2: Contractor Assignment: System auto-assigns SO to nearest accredited contractor based on category (HVAC, Plumbing, Flooring) and current workload; contractor notified via mobile app
Responsible (R): System / Services Mgr
Accountable (A): Services Mgr
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W138_Flow24</bpmn:incoming>
        <bpmn:outgoing>W138_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W138_Task12" name="Site Inspection (if complex)">
        <bpmn:documentation>Step 3: Site Inspection (if complex): For large flooring or roofing jobs, contractor performs site inspection; updates SO with actual material requirements; system adjusts SO price if needed
Responsible (R): Contractor
Accountable (A): Services Mgr
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W138_Flow25</bpmn:incoming>
        <bpmn:outgoing>W138_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W138_Task13" name="Scheduling">
        <bpmn:documentation>Step 4: Scheduling: Contractor confirms installation date/time with customer via system; system sends SMS confirmation to customer
Responsible (R): Contractor
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W138_Flow26</bpmn:incoming>
        <bpmn:outgoing>W138_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W138_Task14" name="Material Release">
        <bpmn:documentation>Step 5: Material Release: Store/DC releases materials for delivery (W19) or customer pickup (W11); system links material delivery status to SO status
Responsible (R): Warehouse / CSR
Accountable (A): Store Manager
Duration: Per W19</bpmn:documentation>
        <bpmn:incoming>W138_Flow27</bpmn:incoming>
        <bpmn:outgoing>W138_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W138_Task15" name="Execution">
        <bpmn:documentation>Step 6: Execution: Contractor performs installation; captures &quot;Before&quot; and &quot;After&quot; photos via mobile app; records any additional materials used from customer&#x27;s stock
Responsible (R): Contractor
Accountable (A): —
Duration: 2–6 hours</bpmn:documentation>
        <bpmn:incoming>W138_Flow28</bpmn:incoming>
        <bpmn:outgoing>W138_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W138_Task16" name="Completion &amp; Sign-off">
        <bpmn:documentation>Step 7: Completion &amp; Sign-off: Customer reviews work; signs digital completion certificate on contractor&#x27;s app; rate service (1–5 stars)
Responsible (R): Customer / Contractor
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W138_Flow29</bpmn:incoming>
        <bpmn:outgoing>W138_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W138_Task17" name="Quality Audit">
        <bpmn:documentation>Step 8: Quality Audit: Services Manager reviews a sample of completed SOs (10%) and all low-rated services; triggers corrective action if needed
Responsible (R): Services Mgr
Accountable (A): VP Store Operations
Duration: 1 hour/day</bpmn:documentation>
        <bpmn:incoming>W138_Flow30</bpmn:incoming>
        <bpmn:outgoing>W138_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W138_Task18" name="Billing &amp; Payout">
        <bpmn:documentation>Step 9: Billing &amp; Payout: System moves SO to &quot;Completed/Ready for Payout&quot;; Finance runs weekly payout batch: Contractor Fee − Commission % = Net Payout
Responsible (R): Finance (AP)
Accountable (A): Controller
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W138_Flow31</bpmn:incoming>
        <bpmn:outgoing>W138_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W138_Task19" name="Warranty Tracking">
        <bpmn:documentation>Step 10: Warranty Tracking: System records installation date as start of labor warranty; links to product warranty (W33)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W138_Flow32</bpmn:incoming>
        <bpmn:outgoing>W138_Flow33</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W138_End20" name="Complete">
        <bpmn:incoming>W138_Flow33</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W138_Annotation21">
        <bpmn:text>Controls: - CTL-275 (ensure controlled execution — Installation &amp; Repair Services (PA-12.1).) | - operational: Services Manager (HQ); Customer Service Rep (Store) review and approval gate
Owner: Services Manager (HQ); Customer Service Rep (Store)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W138_Assoc22" sourceRef="W138_Annotation21" targetRef="W138_Start9" associationDirection="None" />
      <bpmn:sequenceFlow id="W138_Flow23" sourceRef="W138_Start9" targetRef="W138_Task10" />
      <bpmn:sequenceFlow id="W138_Flow24" sourceRef="W138_Task10" targetRef="W138_Task11" />
      <bpmn:sequenceFlow id="W138_Flow25" sourceRef="W138_Task11" targetRef="W138_Task12" />
      <bpmn:sequenceFlow id="W138_Flow26" sourceRef="W138_Task12" targetRef="W138_Task13" />
      <bpmn:sequenceFlow id="W138_Flow27" sourceRef="W138_Task13" targetRef="W138_Task14" />
      <bpmn:sequenceFlow id="W138_Flow28" sourceRef="W138_Task14" targetRef="W138_Task15" />
      <bpmn:sequenceFlow id="W138_Flow29" sourceRef="W138_Task15" targetRef="W138_Task16" />
      <bpmn:sequenceFlow id="W138_Flow30" sourceRef="W138_Task16" targetRef="W138_Task17" />
      <bpmn:sequenceFlow id="W138_Flow31" sourceRef="W138_Task17" targetRef="W138_Task18" />
      <bpmn:sequenceFlow id="W138_Flow32" sourceRef="W138_Task18" targetRef="W138_Task19" />
      <bpmn:sequenceFlow id="W138_Flow33" sourceRef="W138_Task19" targetRef="W138_End20" />
    </bpmn:process>
