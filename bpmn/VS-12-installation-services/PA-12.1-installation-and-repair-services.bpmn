    <bpmn:process id="W_W1253" name="W1253. Subcontractor Performance Scorecard, Quality Assurance &amp; Remediation Management" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled — monthly subcontractor scorecard generation; quarterly performance review; ad-hoc triggered by customer complaint, installation defect, or warranty claim attributed to subcontractor workmanship
Frequency: Monthly scorecard; quarterly formal review with subcontractor; ad-hoc for critical quality failures
Volume: ~150 active subcontractors across 200 stores; ~2,200–3,500 installation jobs completed per month chain-wide (per the 500–800/week basis)
Owner: Installation Services Manager
Participants: Category Manager, Store Manager, Subcontractor, Quality Inspector, Finance Controller, HR Manager
Source: workflow W1253 — Subcontractor Performance Scorecard, Quality Assurance &amp; Remediation Management</bpmn:documentation>
      <bpmn:laneSet id="W1253_LaneSet3">
        <bpmn:lane id="W1253_Lane1" name="Installation Services Manager">
        <bpmn:flowNodeRef>W1253_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1253_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1253_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1253_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1253_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1253_Lane2" name="Quality Inspector">
        <bpmn:flowNodeRef>W1253_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1253_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1253_Start4" name="Scheduled — monthly subcontractor scorecard generation; quarterly performance review…">
        <bpmn:outgoing>W1253_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1253_Task5" name="Monthly scorecard generation">
        <bpmn:documentation>Step 1: Monthly scorecard generation: System automatically compiles monthly performance data per subcontractor across 6 dimensions: (a) Quality score (30% weight): defect rate (punch list items per job per W1171), customer complaint rate (per W795), rework rate; (b) Schedule adherence (20%): % of jobs completed within agreed timeline, average delay days; (c) Customer satisfaction (20%): average CSAT rating from post-installation survey, NPS score; (d) Safety compliance (15%): zero-incident rate, PPE compliance, safety orientation attendance; (e) Documentation compliance (10%): completion certificate submission rate, photo documentation quality, warranty form accuracy; (f) Professionalism (5%): appearance, communication, store feedback
Responsible (R): Installation Services Manager
Accountable (A): VP Store Operations
Duration: 2 hours/month (automated + review)</bpmn:documentation>
        <bpmn:incoming>W1253_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1253_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1253_Task6" name="Scorecard rating &amp; tier assignment">
        <bpmn:documentation>Step 2: Scorecard rating &amp; tier assignment: System assigns each subcontractor a tier based on composite score: (a) Platinum (≥ 4.5/5.0): priority for premium jobs, eligible for project management roles, annual recognition; (b) Gold (3.5–4.4): standard assignment, eligible for all job types; (c) Silver (2.5–3.4): restricted from complex/premium jobs, requires improvement plan; (d) Bronze (&lt; 2.5): placed on probation, no new job assignments, 60-day remediation or termination
Responsible (R): Installation Services Manager
Accountable (A): VP Store Operations
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W1253_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1253_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1253_Task7" name="Quarterly performance review meeting">
        <bpmn:documentation>Step 3: Quarterly performance review meeting: For Gold-tier and above: 30-min phone review; for Silver and Bronze: formal in-person review at regional office: (a) present scorecard results with specific job-level examples; (b) discuss strengths and improvement areas; (c) for Silver: agree on specific improvement targets and timeline; (d) for Bronze: present formal Performance Improvement Plan (PIP) with 60-day milestones; (e) document meeting outcomes and commitments
Responsible (R): Installation Services Manager
Accountable (A): VP Store Operations
Duration: 4 hours/quarter (all subcontractors)</bpmn:documentation>
        <bpmn:incoming>W1253_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1253_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1253_Task8" name="Critical quality failure response">
        <bpmn:documentation>Step 4: Critical quality failure response: For any installation that results in: (a) customer injury or property damage — immediate job suspension pending investigation; (b) structural failure (water leak, electrical hazard) — dispatch Quality Inspector within 24 hours, subcontractor bears rework cost; (c) 3+ customer complaints in rolling 30-day period — mandatory retraining and temporary suspension; (d) fraudulent documentation (falsified completion photos, warranty forms) — immediate termination per W600 offboarding
Responsible (R): Quality Inspector / Installation Services Manager
Accountable (A): VP Store Operations
Duration: 4–8 hours per incident</bpmn:documentation>
        <bpmn:incoming>W1253_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1253_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1253_Task9" name="Annual subcontractor pool optimization">
        <bpmn:documentation>Step 5: Annual subcontractor pool optimization: Installation Services Manager conducts annual review of subcontractor network: (a) terminate bottom 10% performers (Bronze tier with failed PIP); (b) recruit replacement subcontractors via W600 accreditation; (c) adjust geographic coverage — ensure minimum 3 accredited subcontractors per store; (d) negotiate rate adjustments based on performance tier (Platinum: +5% rate premium; Bronze: -5% rate reduction during PIP); (e) present network optimization plan to COO and Finance
Responsible (R): Installation Services Manager
Accountable (A): VP Store Operations
Duration: 16 hours/year</bpmn:documentation>
        <bpmn:incoming>W1253_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1253_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1253_End10" name="Complete">
        <bpmn:incoming>W1253_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1253_Annotation11">
        <bpmn:text>Controls: - CTL-275 (ensure controlled execution — Installation &amp; Repair Services (PA-12.1).) | - operational: Installation Services Manager review and approval gate
Owner: Installation Services Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1253_Assoc12" sourceRef="W1253_Annotation11" targetRef="W1253_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1253_Flow13" sourceRef="W1253_Start4" targetRef="W1253_Task5" />
      <bpmn:sequenceFlow id="W1253_Flow14" sourceRef="W1253_Task5" targetRef="W1253_Task6" />
      <bpmn:sequenceFlow id="W1253_Flow15" sourceRef="W1253_Task6" targetRef="W1253_Task7" />
      <bpmn:sequenceFlow id="W1253_Flow16" sourceRef="W1253_Task7" targetRef="W1253_Task8" />
