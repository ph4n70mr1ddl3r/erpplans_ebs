    <bpmn:process id="W_W442" name="W442. Site Technical Survey &amp; Measurement Services" isExecutable="false">
      <bpmn:documentation>Trigger: Customer requests survey for custom/project-based products (Aluminum windows, doors, kitchen cabinets)
Frequency: Daily; ~1–2 requests per store per week (≈200–400 surveys/week chain-wide)
Volume: ~200–400 surveys/week chain-wide
Owner: Project Sales Manager
Participants: Technical Surveyor, Sales Rep, Customer
Source: workflow W442 — Site Technical Survey &amp; Measurement Services</bpmn:documentation>
      <bpmn:laneSet id="W442_LaneSet5">
        <bpmn:lane id="W442_Lane1" name="Sales Rep">
        <bpmn:flowNodeRef>W442_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W442_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W442_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W442_Lane2" name="System">
        <bpmn:flowNodeRef>W442_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W442_Lane3" name="Surveyor">
        <bpmn:flowNodeRef>W442_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W442_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W442_Lane4" name="Project Manager">
        <bpmn:flowNodeRef>W442_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W442_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W442_Start6" name="Customer requests survey for custom/project-based products (Aluminum windows, doors…">
        <bpmn:outgoing>W442_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W442_Task7" name="Service Sale">
        <bpmn:documentation>Step 1: Service Sale: Customer pays for &quot;Survey Service&quot; at POS (often refundable upon order)
Responsible (R): Sales Rep
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W442_Flow16</bpmn:incoming>
        <bpmn:outgoing>W442_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W442_Task8" name="Scheduling">
        <bpmn:documentation>Step 2: Scheduling: System assigns surveyor based on location/specialty; schedules visit with customer
Responsible (R): System / Admin
Accountable (A): Project Sales Mgr
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W442_Flow17</bpmn:incoming>
        <bpmn:outgoing>W442_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W442_Task9" name="Site Visit">
        <bpmn:documentation>Step 3: Site Visit: Surveyor visits site; performs precise measurements; takes photos of site conditions
Responsible (R): Surveyor
Accountable (A): —
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W442_Flow18</bpmn:incoming>
        <bpmn:outgoing>W442_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W442_Task10" name="Data Upload">
        <bpmn:documentation>Step 4: Data Upload: Surveyor uploads measurements and photos into the ERP/Project folder
Responsible (R): Surveyor
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W442_Flow19</bpmn:incoming>
        <bpmn:outgoing>W442_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W442_Task11" name="Quotation Feed">
        <bpmn:documentation>Step 5: Quotation Feed: Sales Rep receives &quot;Verified Measurements&quot; alert; updates project quotation (W162)
Responsible (R): Sales Rep
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W442_Flow20</bpmn:incoming>
        <bpmn:outgoing>W442_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W442_Task12" name="Technical Review">
        <bpmn:documentation>Step 6: Technical Review: Project Manager/Technician reviews feasibility before final contract
Responsible (R): Project Manager
Accountable (A): Project Sales Mgr
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W442_Flow21</bpmn:incoming>
        <bpmn:outgoing>W442_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W442_End13" name="Complete">
        <bpmn:incoming>W442_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W442_Annotation14">
        <bpmn:text>Controls: - CTL-275 (ensure controlled execution — Installation &amp; Repair Services (PA-12.1).) | - operational: Project Sales Manager review and approval gate
Owner: Project Sales Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W442_Assoc15" sourceRef="W442_Annotation14" targetRef="W442_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W442_Flow16" sourceRef="W442_Start6" targetRef="W442_Task7" />
      <bpmn:sequenceFlow id="W442_Flow17" sourceRef="W442_Task7" targetRef="W442_Task8" />
      <bpmn:sequenceFlow id="W442_Flow18" sourceRef="W442_Task8" targetRef="W442_Task9" />
      <bpmn:sequenceFlow id="W442_Flow19" sourceRef="W442_Task9" targetRef="W442_Task10" />
      <bpmn:sequenceFlow id="W442_Flow20" sourceRef="W442_Task10" targetRef="W442_Task11" />
      <bpmn:sequenceFlow id="W442_Flow21" sourceRef="W442_Task11" targetRef="W442_Task12" />
      <bpmn:sequenceFlow id="W442_Flow22" sourceRef="W442_Task12" targetRef="W442_End13" />
    </bpmn:process>
