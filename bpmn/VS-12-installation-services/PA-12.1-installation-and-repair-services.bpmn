    <bpmn:process id="W_W1254" name="W1254. Customer Project Digital Completion Certificate &amp; Post-Installation Warranty Registration" isExecutable="false">
      <bpmn:documentation>Trigger: Installation job completion and customer quality sign-off (W1171)
Frequency: Per installation job; ~2,200–3,500 installation jobs per month chain-wide (per the 500–800/week canon)
Volume: ~4,500 completion certificates per month; ~4,500 warranty registrations per month
Owner: Customer Service Representative / Installation Services Coordinator
Participants: Subcontractor, Customer, Store Manager, Category Manager, Warranty Administrator
Source: workflow W1254 — Customer Project Digital Completion Certificate &amp; Post-Installation Warranty Registration</bpmn:documentation>
      <bpmn:laneSet id="W1254_LaneSet4">
        <bpmn:lane id="W1254_Lane1" name="Installation Services Coordinator">
        <bpmn:flowNodeRef>W1254_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1254_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1254_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1254_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1254_Lane2" name="System">
        <bpmn:flowNodeRef>W1254_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1254_Lane3" name="Customer Service Representative">
        <bpmn:flowNodeRef>W1254_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1254_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1254_Start5" name="Installation job completion and customer quality sign-off (W1171)">
        <bpmn:outgoing>W1254_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1254_Task6" name="Digital completion certificate generation">
        <bpmn:documentation>Step 1: Digital completion certificate generation: After customer quality sign-off (W1171), Installation Services Coordinator generates digital completion certificate in ERP: (a) auto-populate: job number, customer name, store location, installation date, subcontractor name and license number; (b) capture installed materials list — each material SKU, batch/lot number, and quantity used (linked from material kit per W1198); (c) attach before/after photographs — minimum 4 photos per job (pre-installation condition, during installation, completed installation, close-up of key connection points); (d) record customer acceptance — digital signature or OTP-verified acceptance
Responsible (R): Installation Services Coordinator
Accountable (A): Store Manager
Duration: 15 min per job</bpmn:documentation>
        <bpmn:incoming>W1254_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1254_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1254_Task7" name="Warranty term calculation">
        <bpmn:documentation>Step 2: Warranty term calculation: System determines warranty coverage based on: (a) product manufacturer warranty (per item master) — typically 1–5 years for materials; (b) installation workmanship warranty — 1 year standard for BuildRight installation services; (c) combined warranty start date: installation completion date; (d) warranty end date: earliest of product warranty expiry or workmanship warranty expiry; (e) generate warranty certificate with coverage details, claim process instructions, and BuildRight customer service contact
Responsible (R): System / Installation Services Coordinator
Accountable (A): Category Manager
Duration: 5 min per job (automated)</bpmn:documentation>
        <bpmn:incoming>W1254_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1254_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1254_Task8" name="Warranty registration &amp; customer notification">
        <bpmn:documentation>Step 3: Warranty registration &amp; customer notification: (a) register warranty in Oracle Install Base with unique warranty ID (fit-gap D16); (b) link warranty to customer record in CRM (loyalty member or new customer); (c) send warranty confirmation to customer: email with digital warranty certificate, SMS with warranty ID and expiry date; (d) for loyalty members: auto-link warranty to customer profile for future claim reference; (e) schedule warranty expiry reminder notification (30 days before expiry)
Responsible (R): Customer Service Representative
Accountable (A): Installation Services Coordinator
Duration: 5 min per job</bpmn:documentation>
        <bpmn:incoming>W1254_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1254_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1254_Task9" name="Compliance documentation filing">
        <bpmn:documentation>Step 4: Compliance documentation filing: For installations requiring regulatory compliance: (a) electrical installations: ensure licensed electrician license number recorded per Philippine Electrical Code; (b) plumbing installations: ensure licensed plumber license number recorded per National Plumbing Code; (c) structural modifications: ensure building permit reference recorded where applicable; (d) gas appliance installations: ensure LPG connection certification per BFP (Bureau of Fire Protection) requirements; (e) attach compliance documents to digital completion certificate
Responsible (R): Installation Services Coordinator
Accountable (A): Store Manager
Duration: 10 min per job (if compliance docs required)</bpmn:documentation>
        <bpmn:incoming>W1254_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1254_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1254_Task10" name="Monthly completion analytics">
        <bpmn:documentation>Step 5: Monthly completion analytics: Installation Services Coordinator generates monthly report: (a) completion certificate issuance rate — % of jobs with completed certificates; (b) warranty registration rate — % of eligible products registered; (c) average time from job completion to certificate generation; (d) certificate completeness audit — % with all required photos, materials list, and customer signature; (e) flag stores with &lt; 90% completion certificate rate for corrective action
Responsible (R): Installation Services Coordinator
Accountable (A): VP Store Operations
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W1254_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1254_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1254_End11" name="Complete">
        <bpmn:incoming>W1254_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1254_Annotation12">
        <bpmn:text>Controls: - CTL-186 (ensure installation quality &amp; warranty registration.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Customer Service Representative / Installation Services Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1254_Assoc13" sourceRef="W1254_Annotation12" targetRef="W1254_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1254_Flow14" sourceRef="W1254_Start5" targetRef="W1254_Task6" />
      <bpmn:sequenceFlow id="W1254_Flow15" sourceRef="W1254_Task6" targetRef="W1254_Task7" />
      <bpmn:sequenceFlow id="W1254_Flow16" sourceRef="W1254_Task7" targetRef="W1254_Task8" />
      <bpmn:sequenceFlow id="W1254_Flow17" sourceRef="W1254_Task8" targetRef="W1254_Task9" />
      <bpmn:sequenceFlow id="W1254_Flow18" sourceRef="W1254_Task9" targetRef="W1254_Task10" />
      <bpmn:sequenceFlow id="W1254_Flow19" sourceRef="W1254_Task10" targetRef="W1254_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1254_diag">
      <bpmndi:BPMNPlane id="W1254_plane" bpmnElement="W_W1254">
        <bpmndi:BPMNShape id="W1254_Lane1_di" bpmnElement="W1254_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1254_Lane2_di" bpmnElement="W1254_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
