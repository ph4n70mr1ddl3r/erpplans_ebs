        <bpmndi:BPMNShape id="W1198_Task10_di" bpmnElement="W1198_Task10"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1198_Task11_di" bpmnElement="W1198_Task11"><dc:Bounds x="1450" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1198_Start5_di" bpmnElement="W1198_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1198_End12_di" bpmnElement="W1198_End12"><dc:Bounds x="1680" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1198_Annotation13_di" bpmnElement="W1198_Annotation13"><dc:Bounds x="160" y="630" width="360" height="100" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1198_Flow15_di" bpmnElement="W1198_Flow15"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1198_Flow16_di" bpmnElement="W1198_Flow16"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1198_Flow17_di" bpmnElement="W1198_Flow17"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1198_Flow18_di" bpmnElement="W1198_Flow18"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1198_Flow19_di" bpmnElement="W1198_Flow19"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1198_Flow20_di" bpmnElement="W1198_Flow20"><di:waypoint x="1420" y="335" /><di:waypoint x="1450" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1198_Flow21_di" bpmnElement="W1198_Flow21"><di:waypoint x="1630" y="505" /><di:waypoint x="1680" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1198_Assoc14_di" bpmnElement="W1198_Assoc14"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1170" name="W1170. Subcontractor Installation Daily Dispatch, Work Order &amp; Capacity Management" isExecutable="false">
      <bpmn:documentation>Trigger: Approved installation service order from W138 requiring subcontractor assignment; daily dispatch planning cycle
Frequency: Daily; ~100–120 installation work orders dispatched chain-wide
Volume: ~500–800 service orders/week across 200 stores; ~80% fulfilled by accredited subcontractors per W600
Owner: Services Dispatch Coordinator
Participants: Services Dispatch Coordinator, Subcontractor, Store Manager, Customer, Services Manager (HQ)
Source: workflow W1170 — Subcontractor Installation Daily Dispatch, Work Order &amp; Capacity Management</bpmn:documentation>
      <bpmn:laneSet id="W1170_LaneSet4">
        <bpmn:lane id="W1170_Lane1" name="Services Dispatch Coordinator">
        <bpmn:flowNodeRef>W1170_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1170_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1170_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1170_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1170_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1170_Lane2" name="System">
        <bpmn:flowNodeRef>W1170_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1170_Lane3" name="Services Manager">
        <bpmn:flowNodeRef>W1170_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1170_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1170_Start5" name="Approved installation service order from W138 requiring subcontractor assignment; daily…">
        <bpmn:outgoing>W1170_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1170_Task6" name="Daily work order pool review">
        <bpmn:documentation>Step 1: Daily work order pool review: Services Dispatch Coordinator reviews all pending installation work orders for the day/next day: (a) filter by store region, service type (AC installation, water heater, tile laying, electrical), priority (SLA-based), and material availability; (b) identify orders requiring pre-installation site survey per W442; (c) flag orders with customer-requested time windows
Responsible (R): Services Dispatch Coordinator
Accountable (A): Services Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1170_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1170_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1170_Task7" name="Subcontractor availability &amp; skill matching">
        <bpmn:documentation>Step 2: Subcontractor availability &amp; skill matching: System checks accredited subcontractor availability per W600 registry: (a) available today/tomorrow, (b) holds required skill certification for service type (e.g., TESDA NC-II for electrical work), (c) within geographic coverage zone of customer site, (d) not double-booked; Coordinator selects best-fit subcontractor based on: skill match, proximity, customer rating history, and current workload balance
Responsible (R): Services Dispatch Coordinator / System
Accountable (A): Services Manager
Duration: 15 min/order</bpmn:documentation>
        <bpmn:incoming>W1170_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1170_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1170_Task8" name="Work order dispatch">
        <bpmn:documentation>Step 3: Work order dispatch: System generates digital work order sent to subcontractor&#x27;s mobile app: (a) customer name, address, contact; (b) service type and scope; (c) materials list linked to BOM from W820 or W211; (d) customer-requested time window; (e) store pickup location for materials; (f) installation standard operating procedure (SOP) reference; (g) safety requirements per W695; subcontractor acknowledges receipt and confirms acceptance within 2 hours
Responsible (R): System / Services Dispatch Coordinator
Accountable (A): Services Manager
Duration: 10 min/order</bpmn:documentation>
        <bpmn:incoming>W1170_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1170_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1170_Task9" name="Material coordination">
        <bpmn:documentation>Step 4: Material coordination: For orders requiring store-supplied materials: (a) Coordinator confirms material availability at originating store per ATP; (b) if materials unavailable, check alternate store for transfer per W22 or reschedule installation; (c) subcontractor picks up materials from store receiving dock; Stock Associate verifies material handoff with subcontractor signature; (d) for customer-purchased materials: Coordinator confirms customer has materials on-site before dispatch
Responsible (R): Services Dispatch Coordinator / Stock Associate
Accountable (A): Store Manager
Duration: 20 min/order</bpmn:documentation>
        <bpmn:incoming>W1170_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1170_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1170_Task10" name="Real-time dispatch monitoring">
        <bpmn:documentation>Step 5: Real-time dispatch monitoring: System tracks subcontractor status: (a) en route to customer, (b) arrived on-site, (c) installation in progress, (d) completed; Coordinator monitors all active installations on dashboard; if subcontractor is delayed &gt; 30 minutes from scheduled arrival, Coordinator contacts subcontractor and notifies customer via W708
Responsible (R): Services Dispatch Coordinator
Accountable (A): Services Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W1170_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1170_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1170_Task11" name="Capacity planning &amp; rebalancing">
        <bpmn:documentation>Step 6: Capacity planning &amp; rebalancing: Weekly, Services Manager reviews subcontractor utilization: (a) average orders/week per subcontractor, (b) coverage gaps by region, (c) peak-day capacity (weekends = 60% of installations); if capacity insufficient: (i) accelerate accreditation of new subcontractors per W600, (ii) authorize overtime for existing subcontractors, (iii) reschedule non-urgent orders to off-peak days
Responsible (R): Services Manager
Accountable (A): VP Store Operations
Duration: 2 hours/week</bpmn:documentation>
        <bpmn:incoming>W1170_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1170_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1170_End12" name="Complete">
        <bpmn:incoming>W1170_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1170_Annotation13">
        <bpmn:text>Controls: - CTL-275 (ensure controlled execution — Installation &amp; Repair Services (PA-12.1).) | - operational: Services Dispatch Coordinator review and approval gate
Owner: Services Dispatch Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1170_Assoc14" sourceRef="W1170_Annotation13" targetRef="W1170_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1170_Flow15" sourceRef="W1170_Start5" targetRef="W1170_Task6" />
      <bpmn:sequenceFlow id="W1170_Flow16" sourceRef="W1170_Task6" targetRef="W1170_Task7" />
      <bpmn:sequenceFlow id="W1170_Flow17" sourceRef="W1170_Task7" targetRef="W1170_Task8" />
      <bpmn:sequenceFlow id="W1170_Flow18" sourceRef="W1170_Task8" targetRef="W1170_Task9" />
      <bpmn:sequenceFlow id="W1170_Flow19" sourceRef="W1170_Task9" targetRef="W1170_Task10" />
      <bpmn:sequenceFlow id="W1170_Flow20" sourceRef="W1170_Task10" targetRef="W1170_Task11" />
      <bpmn:sequenceFlow id="W1170_Flow21" sourceRef="W1170_Task11" targetRef="W1170_End12" />
    </bpmn:process>
