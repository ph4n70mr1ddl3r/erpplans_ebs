        <bpmndi:BPMNShape id="W1171_Task12_di" bpmnElement="W1171_Task12"><dc:Bounds x="1450" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1171_Task13_di" bpmnElement="W1171_Task13"><dc:Bounds x="1660" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1171_Start6_di" bpmnElement="W1171_Start6"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1171_End14_di" bpmnElement="W1171_End14"><dc:Bounds x="1890" y="657" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1171_Annotation15_di" bpmnElement="W1171_Annotation15"><dc:Bounds x="160" y="800" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1171_Flow17_di" bpmnElement="W1171_Flow17"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1171_Flow18_di" bpmnElement="W1171_Flow18"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1171_Flow19_di" bpmnElement="W1171_Flow19"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1171_Flow20_di" bpmnElement="W1171_Flow20"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1171_Flow21_di" bpmnElement="W1171_Flow21"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1171_Flow22_di" bpmnElement="W1171_Flow22"><di:waypoint x="1420" y="335" /><di:waypoint x="1450" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1171_Flow23_di" bpmnElement="W1171_Flow23"><di:waypoint x="1630" y="505" /><di:waypoint x="1660" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1171_Flow24_di" bpmnElement="W1171_Flow24"><di:waypoint x="1840" y="675" /><di:waypoint x="1890" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1171_Assoc16_di" bpmnElement="W1171_Assoc16"><di:waypoint x="340" y="800" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1210" name="W1210. Customer In-Home Site Measurement, Assessment &amp; Quotation for Installation Services" isExecutable="false">
      <bpmn:documentation>Trigger: Customer purchases or inquires about installation-dependent products (tiles, aircon, water heater, kitchen/bathroom fixtures, electrical panel) at store or ecommerce; or customer requests free site assessment
Frequency: ~3,000–4,000 site assessments per month across 200 stores
Volume: ~15–20 per store per month; higher in stores near new residential developments
Owner: Installation Coordinator
Participants: Installation Coordinator, Sales Associate, Measurement Technician (accredited per W600), Customer, Estimator/Quotation Specialist
Source: workflow W1210 — Customer In-Home Site Measurement, Assessment &amp; Quotation for Installation Services</bpmn:documentation>
      <bpmn:laneSet id="W1210_LaneSet7">
        <bpmn:lane id="W1210_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W1210_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1210_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1210_Lane2" name="System">
        <bpmn:flowNodeRef>W1210_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1210_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1210_Lane3" name="Measurement Technician">
        <bpmn:flowNodeRef>W1210_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1210_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1210_Lane4" name="Estimator">
        <bpmn:flowNodeRef>W1210_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1210_Lane5" name="Installation Coordinator">
        <bpmn:flowNodeRef>W1210_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1210_Task17</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1210_Lane6" name="Customer">
        <bpmn:flowNodeRef>W1210_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1210_End18</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1210_Start8" name="Customer purchases or inquires about installation-dependent products (tiles, aircon…">
        <bpmn:outgoing>W1210_Flow21</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1210_Task9" name="Customer expresses interest in installation-dependent purchase; Sales Associate…">
        <bpmn:documentation>Step 1: Customer expresses interest in installation-dependent purchase; Sales Associate captures: (a) product category (tiles, aircon, water heater, fixtures, electrical), (b) approximate scope (room size, number of units, type of project), (c) customer address and contact, (d) preferred assessment date/time; system checks measurement technician availability and schedules visit
Responsible (R): Sales Associate / System
Accountable (A): Installation Coordinator
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1210_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1210_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1210_Task10" name="System sends customer confirmation SMS/email: scheduled date/time window…">
        <bpmn:documentation>Step 2: System sends customer confirmation SMS/email: scheduled date/time window (2-hour window), technician name and photo ID, assessment preparation checklist (clear area, ensure access to plumbing/electrical if applicable, have building floor plan if available), and link to reschedule
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1210_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1210_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1210_Task11" name="Measurement Technician receives job assignment on mobile app: customer details…">
        <bpmn:documentation>Step 3: Measurement Technician receives job assignment on mobile app: customer details, product category, scope notes, address with GPS navigation, and any prior in-store product selections
Responsible (R): System
Accountable (A): Installation Coordinator
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1210_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1210_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1210_Task12" name="On-site assessment">
        <bpmn:documentation>Step 4: On-site assessment (1–2 hours): Technician arrives at customer site; presents BuildRight ID; conducts assessment: (a) Measurements: laser measure all relevant dimensions — room length/width/height, door/window openings, column protrusions, pipe locations, electrical outlet positions; record in mobile app with photos; (b) Condition assessment: inspect subfloor condition (for tiles), wall condition (for fixtures), plumbing connectivity (for water heaters/toilets), electrical capacity (for aircons — check breaker amp rating, wire gauge, outdoor unit mounting space); (c) Constraints: note building restrictions (condo rules on drilling, HOA requirements, load-bearing wall identification), access limitations (narrow stairways, no elevator); (d) Customer preferences: discuss design preferences, timeline, budget range
Responsible (R): Measurement Technician
Accountable (A): Installation Coordinator
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W1210_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1210_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1210_Task13" name="measurement report">
        <bpmn:documentation>Step 5: Mobile app automatically generates measurement report: dimensioned floor plan/wall elevation, annotated photos, condition notes, constraint summary; Technician reviews for completeness and submits to Installation Coordinator
Responsible (R): Measurement Technician / System
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1210_Flow25</bpmn:incoming>
        <bpmn:outgoing>W1210_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1210_Task14" name="Quotation generation">
        <bpmn:documentation>Step 6: Quotation generation (within 24 hours): Estimator reviews measurement report and generates itemized quotation: (a) Materials list: exact SKU quantities from measurement (tiles: area + 10% waste; plumbing: fittings list; electrical: wire length + conduit + breakers); (b) Labor estimate: based on complexity (simple rectangular room vs. complex angles, first-floor vs. upper-floor installation), estimated hours per trade (tiler, plumber, electrician); (c) Ancillary materials: adhesive, grout, sealant, waterproofing membrane, mounting brackets; (d) Total quotation: materials + labor + ancillary + delivery fee (W1208) + 12% VAT; (e) system auto-links quotation to customer&#x27;s in-store or ecommerce cart
Responsible (R): Estimator / System
Accountable (A): Installation Manager
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W1210_Flow26</bpmn:incoming>
        <bpmn:outgoing>W1210_Flow27</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1210_Task15" name="Installation Coordinator sends quotation to customer via email and SMS with…">
        <bpmn:documentation>Step 7: Installation Coordinator sends quotation to customer via email and SMS with: itemized breakdown, 3D visualization of finished project (if applicable), estimated project timeline (start-to-completion), payment terms (50% deposit per W546, balance on completion), and link to accept quotation online or visit store
Responsible (R): Installation Coordinator / System
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1210_Flow27</bpmn:incoming>
        <bpmn:outgoing>W1210_Flow28</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1210_Task16" name="Customer accepts quotation: (a) online: customer clicks &quot;Accept&quot; in email…">
        <bpmn:documentation>Step 8: Customer accepts quotation: (a) online: customer clicks &quot;Accept&quot; in email, system converts quotation to sales order and schedules installation per W138; (b) in-store: customer visits store, Sales Associate recalls quotation, customer pays deposit, system creates installation work order; (c) if customer requests revision: Estimator adjusts quotation and resends
Responsible (R): Customer / Sales Associate / System
Accountable (A): Installation Coordinator
Duration: Variable</bpmn:documentation>
        <bpmn:incoming>W1210_Flow28</bpmn:incoming>
        <bpmn:outgoing>W1210_Flow29</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1210_Task17" name="If customer declines: Installation Coordinator records reason in CRM (price too…">
        <bpmn:documentation>Step 9: If customer declines: Installation Coordinator records reason in CRM (price too high, timeline doesn&#x27;t work, competitor chosen, project postponed); CX team adds to lead nurturing pipeline for follow-up in 30/60/90 days
Responsible (R): Installation Coordinator
Accountable (A): CX Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1210_Flow29</bpmn:incoming>
        <bpmn:outgoing>W1210_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1210_End18" name="Complete">
        <bpmn:incoming>W1210_Flow30</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1210_Annotation19">
        <bpmn:text>Controls: - CTL-275 (ensure controlled execution — Installation &amp; Repair Services (PA-12.1).) | - operational: Installation Coordinator review and approval gate
Owner: Installation Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1210_Assoc20" sourceRef="W1210_Annotation19" targetRef="W1210_Start8" associationDirection="None" />
