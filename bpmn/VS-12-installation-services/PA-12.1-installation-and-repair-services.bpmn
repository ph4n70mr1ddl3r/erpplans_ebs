    <bpmn:process id="W_W169" name="W169. Lumber &amp; Board Cutting Services" isExecutable="false">
      <bpmn:documentation>Trigger: Customer purchases whole lumber/plywood and requests specific sizes
Frequency: Moderate; ~10–20 requests per store/day
Volume: Primary items: Plywood, Marine Board, 2x4 Lumber
Owner: Lumber Department Supervisor
Participants: Cutter (Stock Associate), Customer, Cashier
Source: workflow W169 — Lumber &amp; Board Cutting Services</bpmn:documentation>
      <bpmn:laneSet id="W169_LaneSet3">
        <bpmn:lane id="W169_Lane1" name="Cutter">
        <bpmn:flowNodeRef>W169_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W169_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W169_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W169_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W169_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W169_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W169_Lane2" name="Cashier">
        <bpmn:flowNodeRef>W169_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W169_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W169_Start4" name="Customer purchases whole lumber/plywood and requests specific sizes">
        <bpmn:outgoing>W169_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W169_Task5" name="Intake">
        <bpmn:documentation>Step 1: Intake: Customer presents purchased board/lumber or selects from floor; provides cutting list/dimensions
Responsible (R): Cutter
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W169_Flow14</bpmn:incoming>
        <bpmn:outgoing>W169_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W169_Task6" name="Calculation">
        <bpmn:documentation>Step 2: Calculation: Cutter calculates number of cuts; system determines &quot;Cutting Fee&quot; (e.g., first 2 cuts free, PHP 10 per subsequent cut)
Responsible (R): Cutter
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W169_Flow15</bpmn:incoming>
        <bpmn:outgoing>W169_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W169_Task7" name="Payment">
        <bpmn:documentation>Step 3: Payment: Customer pays Cutting Fee at POS; receives &quot;Cutting Authorization&quot; slip
Responsible (R): Cashier
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W169_Flow16</bpmn:incoming>
        <bpmn:outgoing>W169_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W169_Task8" name="Execution">
        <bpmn:documentation>Step 4: Execution: Cutter performs cuts using Table Saw or Panel Saw; adheres to safety protocols (PPE, machine guards)
Responsible (R): Cutter
Accountable (A): Dept Supervisor
Duration: 5–15 min</bpmn:documentation>
        <bpmn:incoming>W169_Flow17</bpmn:incoming>
        <bpmn:outgoing>W169_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W169_Task9" name="Scrap Management">
        <bpmn:documentation>Step 5: Scrap Management: (a) Off-cuts &gt; 1ft offered to customer; (b) if declined, off-cuts moved to &quot;Scrap Bin&quot; for discounted sale or internal use
Responsible (R): Cutter
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W169_Flow18</bpmn:incoming>
        <bpmn:outgoing>W169_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W169_Task10" name="Safety Log">
        <bpmn:documentation>Step 6: Safety Log: Cutter logs machine hours and blade condition; reports dull blades for sharpening/replacement (W47)
Responsible (R): Cutter
Accountable (A): Dept Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W169_Flow19</bpmn:incoming>
        <bpmn:outgoing>W169_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W169_End11" name="Complete">
        <bpmn:incoming>W169_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W169_Annotation12">
        <bpmn:text>Controls: - CTL-275 (ensure controlled execution — Installation &amp; Repair Services (PA-12.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Lumber Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W169_Assoc13" sourceRef="W169_Annotation12" targetRef="W169_Start4" associationDirection="None" />
