    <bpmn:process id="W_W213" name="W213. Installation Service Partner Quality Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled quarterly audit; or high complaint rate for a specific contractor (W138.8)
Frequency: Quarterly per contractor; or ad-hoc
Volume: ~100–133 contractor audits/month nationwide (quarterly per contractor, per the 300–400 accredited pool — mostly remote checklist audits with on-site visits for high-risk tiers)
Owner: Services Quality Manager
Participants: Services Quality Mgr, Contractor, Customer (for site visit)
Source: workflow W213 — Installation Service Partner Quality Audit</bpmn:documentation>
      <bpmn:laneSet id="W213_LaneSet4">
        <bpmn:lane id="W213_Lane1" name="System">
        <bpmn:flowNodeRef>W213_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W213_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W213_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W213_Lane2" name="Services Qual Mgr">
        <bpmn:flowNodeRef>W213_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W213_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W213_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W213_Lane3" name="Services Mgr">
        <bpmn:flowNodeRef>W213_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W213_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W213_Start5" name="Scheduled quarterly audit; or high complaint rate for a specific contractor (W138.8)">
        <bpmn:outgoing>W213_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W213_Task6" name="Audit Scoping">
        <bpmn:documentation>Step 1: Audit Scoping: System identifies contractors with high volume or low CSAT (W65) in the past quarter
Responsible (R): System
Accountable (A): Services Qual Mgr
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W213_Flow15</bpmn:incoming>
        <bpmn:outgoing>W213_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W213_Task7" name="Site Visit">
        <bpmn:documentation>Step 2: Site Visit: Auditor visits 3–5 active/completed sites with the contractor; inspects workmanship against &quot;BuildRight Standard&quot;
Responsible (R): Services Qual Mgr
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W213_Flow16</bpmn:incoming>
        <bpmn:outgoing>W213_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W213_Task8" name="Compliance Check">
        <bpmn:documentation>Step 3: Compliance Check: Verify contractor&#x27;s team has valid IDs, PPE, and appropriate tools (as required in W138 contract)
Responsible (R): Services Qual Mgr
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W213_Flow17</bpmn:incoming>
        <bpmn:outgoing>W213_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W213_Task9" name="Audit Report">
        <bpmn:documentation>Step 4: Audit Report: Auditor logs findings in system: workmanship score, safety score, compliance score
Responsible (R): Services Qual Mgr
Accountable (A): Services Mgr
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W213_Flow18</bpmn:incoming>
        <bpmn:outgoing>W213_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W213_Task10" name="Scorecard Update">
        <bpmn:documentation>Step 5: Scorecard Update: Audit score feeds into the &quot;Contractor Master Scorecard&quot; (linked to W44)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W213_Flow19</bpmn:incoming>
        <bpmn:outgoing>W213_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W213_Task11" name="Corrective Action">
        <bpmn:documentation>Step 6: Corrective Action: If score &lt; 70%, contractor put on &quot;Probation&quot;; requires remedial training or face de-listing
Responsible (R): Services Mgr
Accountable (A): VP Store Operations
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W213_Flow20</bpmn:incoming>
        <bpmn:outgoing>W213_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W213_End12" name="Complete">
        <bpmn:incoming>W213_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W213_Annotation13">
        <bpmn:text>Controls: - CTL-186 (ensure installation quality &amp; warranty registration.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Services Quality Manager</bpmn:text>
      </bpmn:textAnnotation>
