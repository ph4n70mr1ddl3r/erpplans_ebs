    <bpmn:process id="W_W440" name="W440. Power Tool Service &amp; Repair Center Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Customer brings in a damaged power tool (Makita, Bosch, DeWalt, etc.) for repair (In-Warranty or Out-of-Warranty)
Frequency: Daily; ~2–3 service intake events per store per week (≈20,000–30,000 repairs/year chain-wide)
Volume: ~20,000–30,000 repairs per year chain-wide
Owner: Service Center Manager
Participants: Service Desk Clerk, Technician, Parts Specialist, Cashier
Source: workflow W440 — Power Tool Service &amp; Repair Center Operations</bpmn:documentation>
      <bpmn:laneSet id="W440_LaneSet5">
        <bpmn:lane id="W440_Lane1" name="Service Desk Clerk">
        <bpmn:flowNodeRef>W440_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W440_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W440_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W440_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W440_Lane2" name="Technician">
        <bpmn:flowNodeRef>W440_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W440_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W440_Lane3" name="Parts Specialist">
        <bpmn:flowNodeRef>W440_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W440_Lane4" name="System">
        <bpmn:flowNodeRef>W440_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W440_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W440_Start6" name="Customer brings in a damaged power tool (Makita, Bosch, DeWalt, etc.) for repair…">
        <bpmn:outgoing>W440_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W440_Task7" name="Intake">
        <bpmn:documentation>Step 1: Intake: Clerk inspects tool; verifies warranty status; captures customer complaint; system generates Service Ticket
Responsible (R): Service Desk Clerk
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W440_Flow17</bpmn:incoming>
        <bpmn:outgoing>W440_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W440_Task8" name="Diagnostic">
        <bpmn:documentation>Step 2: Diagnostic: Technician inspects tool; identifies part failure; system checks parts availability
Responsible (R): Technician
Accountable (A): Service Center Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W440_Flow18</bpmn:incoming>
        <bpmn:outgoing>W440_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W440_Task9" name="Quotation">
        <bpmn:documentation>Step 3: Quotation: System generates estimate (Labor + Parts); Clerk notifies customer for approval (via SMS/App)
Responsible (R): Service Desk Clerk
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W440_Flow19</bpmn:incoming>
        <bpmn:outgoing>W440_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W440_Task10" name="Part Issue">
        <bpmn:documentation>Step 4: Part Issue: Parts Specialist issues spares from &quot;Service Inventory&quot; (non-sales stock) to the ticket
Responsible (R): Parts Specialist
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W440_Flow20</bpmn:incoming>
        <bpmn:outgoing>W440_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W440_Task11" name="Repair">
        <bpmn:documentation>Step 5: Repair: Technician replaces parts; performs safety/functionality test; signs off on ticket
Responsible (R): Technician
Accountable (A): —
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W440_Flow21</bpmn:incoming>
        <bpmn:outgoing>W440_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W440_Task12" name="Customer Notification">
        <bpmn:documentation>Step 6: Customer Notification: System auto-notifies customer that tool is ready for pickup
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W440_Flow22</bpmn:incoming>
        <bpmn:outgoing>W440_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W440_Task13" name="Release &amp; Billing">
        <bpmn:documentation>Step 7: Release &amp; Billing: Customer picks up tool; pays at POS (if out-of-warranty); Clerk closes ticket
Responsible (R): Service Desk Clerk / Cashier
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W440_Flow23</bpmn:incoming>
        <bpmn:outgoing>W440_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W440_End14" name="Complete">
        <bpmn:incoming>W440_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W440_Annotation15">
        <bpmn:text>Controls: - CTL-275 (ensure controlled execution — Installation &amp; Repair Services (PA-12.1).) | - operational: Service Center Manager review and approval gate
Owner: Service Center Manager</bpmn:text>
      </bpmn:textAnnotation>
