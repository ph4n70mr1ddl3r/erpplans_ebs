    <bpmn:process id="W_W2331" name="W2331. 3PL Cost Benchmarking &amp; Negotiation" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly
Frequency: Quarterly; ~10–15 partners
Volume: ~10–15 partners
Owner: Procurement Manager
Participants: Procurement, Finance, Logistics Manager, VP Supply Chain
Source: workflow W2331 — 3PL Cost Benchmarking &amp; Negotiation</bpmn:documentation>
      <bpmn:laneSet id="W2331_LaneSet2">
        <bpmn:lane id="W2331_Lane1" name="Procurement">
        <bpmn:flowNodeRef>W2331_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2331_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2331_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2331_Start3" name="Quarterly">
        <bpmn:outgoing>W2331_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2331_Task4" name="Benchmarks vs. market; identifies above-market partners; negotiates reductions…">
        <bpmn:documentation>Step 1: Benchmarks vs. market; identifies above-market partners; negotiates reductions; Finance validates savings; Logistics plans transition if needed per VS-56
Responsible (R): Procurement / Finance / Logistics Mgr
Accountable (A): VP Supply Chain
Duration: 2–3 days + 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2331_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2331_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2331_End5" name="Complete">
        <bpmn:incoming>W2331_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2331_Annotation6">
        <bpmn:text>Controls: - CTL-414 (3PL-contract accuracy — links to VS-03); CTL-48 (rate-dispute resolution); operational: VP Supply Chain sign-off on negotiation/transition
Owner: Procurement Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2331_Assoc7" sourceRef="W2331_Annotation6" targetRef="W2331_Start3" associationDirection="None" />
