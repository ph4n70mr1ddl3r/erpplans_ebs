    <bpmn:process id="W_W2328" name="W2328. Fleet Utilization Rate Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly
Frequency: Monthly; ~40 owned vehicles (the 40-truck owned fleet)
Volume: ~40 reports/month (one per owned vehicle)
Owner: Fleet Supervisor
Participants: Logistics Manager
Source: workflow W2328 — Fleet Utilization Rate Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2328_LaneSet2">
        <bpmn:lane id="W2328_Lane1" name="Fleet Supervisor">
        <bpmn:flowNodeRef>W2328_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2328_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2328_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2328_Start3" name="Monthly">
        <bpmn:outgoing>W2328_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2328_Task4" name="Calculates: % available hours delivering, % capacity utilized per trip, idle…">
        <bpmn:documentation>Step 1: Calculates: % available hours delivering, % capacity utilized per trip, idle time; targets ≥75% utilization; identifies underutilized for redeployment or disposal
Responsible (R): Fleet Supervisor
Accountable (A): Logistics Manager
Duration: 4–6 hours/month</bpmn:documentation>
        <bpmn:incoming>W2328_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2328_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2328_End5" name="Complete">
        <bpmn:incoming>W2328_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2328_Annotation6">
        <bpmn:text>Controls: - CTL-414 (ensure controlled execution — Fleet Total Cost of Ownership Analytics (PA-61.3).) | - Operational: Logistics Manager utilization-review sign-off
Owner: Fleet Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2328_Assoc7" sourceRef="W2328_Annotation6" targetRef="W2328_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2328_Flow8" sourceRef="W2328_Start3" targetRef="W2328_Task4" />
      <bpmn:sequenceFlow id="W2328_Flow9" sourceRef="W2328_Task4" targetRef="W2328_End5" />
    </bpmn:process>
