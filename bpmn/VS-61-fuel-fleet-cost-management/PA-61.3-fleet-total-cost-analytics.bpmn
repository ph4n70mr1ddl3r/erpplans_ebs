    <bpmn:process id="W_W2329" name="W2329. Fleet Carbon Footprint Estimation" isExecutable="false">
      <bpmn:documentation>Trigger: Annual sustainability reporting
Frequency: Annual
Volume: 20 owned + 3PL
Owner: ESG Manager
Participants: VP Supply Chain
Source: workflow W2329 — Fleet Carbon Footprint Estimation</bpmn:documentation>
      <bpmn:laneSet id="W2329_LaneSet2">
        <bpmn:lane id="W2329_Lane1" name="ESG Manager">
        <bpmn:flowNodeRef>W2329_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2329_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2329_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2329_Start3" name="Annual sustainability reporting">
        <bpmn:outgoing>W2329_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2329_Task4" name="Calculates: fuel × emission factor; estimates 3PL emissions from volume…">
        <bpmn:documentation>Step 1: Calculates: fuel × emission factor; estimates 3PL emissions from volume; identifies reduction: route optimization, fuel-efficient, alternative fuels, load optimization; feeds VS-25
Responsible (R): ESG Manager
Accountable (A): VP Supply Chain
Duration: 3–5 days/year + 2–3 days</bpmn:documentation>
        <bpmn:incoming>W2329_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2329_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2329_End5" name="Complete">
        <bpmn:incoming>W2329_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2329_Annotation6">
        <bpmn:text>Controls: - CTL-414 (ensure controlled execution — Fleet Total Cost of Ownership Analytics (PA-61.3).) | - CTL-414 (ESG-reporting accuracy — links to VS-25); operational: VP Supply Chain annual sign-off
Owner: ESG Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2329_Assoc7" sourceRef="W2329_Annotation6" targetRef="W2329_Start3" associationDirection="None" />
