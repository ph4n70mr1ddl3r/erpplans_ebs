    <bpmn:process id="W_W2326" name="W2326. Annual Fleet TCO Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Annual budget cycle
Frequency: Annual
Volume: 20 owned vehicles
Owner: Finance Controller
Participants: VP Supply Chain, CFO, DC Cost-to-Serve Analyst
Source: workflow W2326 — Annual Fleet TCO Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2326_LaneSet2">
        <bpmn:lane id="W2326_Lane1" name="Finance Controller">
        <bpmn:flowNodeRef>W2326_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2326_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2326_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2326_Start3" name="Annual budget cycle">
        <bpmn:outgoing>W2326_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2326_Task4" name="Calculates TCO per vehicle: depreciation + fuel + maintenance + insurance +…">
        <bpmn:documentation>Step 1: Calculates TCO per vehicle: depreciation + fuel + maintenance + insurance + tolls + driver + overhead; compares vs. 3PL cost; VP recommends own vs. outsource by route
Responsible (R): Finance Controller / VP Supply Chain
Accountable (A): CFO
Duration: 5–10 days + 3–5 days</bpmn:documentation>
        <bpmn:incoming>W2326_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2326_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2326_End5" name="Complete">
        <bpmn:incoming>W2326_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2326_Annotation6">
        <bpmn:text>Controls: - CTL-414 (ensure controlled execution — Fleet Total Cost of Ownership Analytics (PA-61.3).) | - CTL-414 (TCO-accuracy — links to VS-158); operational: CFO sign-off on the TCO and the own-vs-outsource recommendation
Owner: Finance Controller</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2326_Assoc7" sourceRef="W2326_Annotation6" targetRef="W2326_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2326_Flow8" sourceRef="W2326_Start3" targetRef="W2326_Task4" />
      <bpmn:sequenceFlow id="W2326_Flow9" sourceRef="W2326_Task4" targetRef="W2326_End5" />
    </bpmn:process>
