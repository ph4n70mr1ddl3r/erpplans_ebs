    <bpmn:process id="W_W2330" name="W2330. Fleet Safety Cost Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly
Frequency: Quarterly
Volume: ~40 owned vehicles (the 40-truck owned fleet canon)
Owner: Safety Officer
Participants: VP Supply Chain
Source: workflow W2330 — Fleet Safety Cost Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2330_LaneSet2">
        <bpmn:lane id="W2330_Lane1" name="Safety Officer">
        <bpmn:flowNodeRef>W2330_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2330_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2330_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2330_Start3" name="Quarterly">
        <bpmn:outgoing>W2330_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2330_Task4" name="Analyzes: accident repair, cargo damage, insurance premium impact, driver…">
        <bpmn:documentation>Step 1: Analyzes: accident repair, cargo damage, insurance premium impact, driver injury, third-party liability; recommends: training, safety features, route risk assessment
Responsible (R): Safety Officer
Accountable (A): VP Supply Chain
Duration: 4–6 hours/quarter + 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2330_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2330_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2330_End5" name="Complete">
        <bpmn:incoming>W2330_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2330_Annotation6">
        <bpmn:text>Controls: - CTL-414 (ensure controlled execution — Fleet Total Cost of Ownership Analytics (PA-61.3).) | - CTL-414 (OHS/fleet-safety — links to VS-24); operational: VP Supply Chain quarterly sign-off
Owner: Safety Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2330_Assoc7" sourceRef="W2330_Annotation6" targetRef="W2330_Start3" associationDirection="None" />
