      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2327" name="W2327. Vehicle Replacement Cost-Benefit Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Vehicle replacement criteria met
Frequency: 2–3/year
Volume: ~2–3 evaluations/year
Owner: Fleet Supervisor
Participants: Finance, VP Supply Chain, COO
Source: workflow W2327 — Vehicle Replacement Cost-Benefit Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2327_LaneSet2">
        <bpmn:lane id="W2327_Lane1" name="Fleet Supervisor">
        <bpmn:flowNodeRef>W2327_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2327_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2327_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2327_Start3" name="Vehicle replacement criteria met">
        <bpmn:outgoing>W2327_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2327_Task4" name="Identifies: &gt;8 years, &gt;300K km, maintenance &gt;30% of value; Finance calculates…">
        <bpmn:documentation>Step 1: Identifies: &gt;8 years, &gt;300K km, maintenance &gt;30% of value; Finance calculates replacement vs. continued maintenance; VP recommends model; Finance approves budget
Responsible (R): Fleet Supervisor / Finance / VP Supply Chain
Accountable (A): COO
Duration: 3–5 days + 2–3 days</bpmn:documentation>
        <bpmn:incoming>W2327_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2327_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2327_End5" name="Complete">
        <bpmn:incoming>W2327_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2327_Annotation6">
        <bpmn:text>Controls: - CTL-414 (ensure controlled execution — Fleet Total Cost of Ownership Analytics (PA-61.3).) | - operational: capex-approval for the replacement; asset disposition; operational: COO sign-off on the replacement
Owner: Fleet Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2327_Assoc7" sourceRef="W2327_Annotation6" targetRef="W2327_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2327_Flow8" sourceRef="W2327_Start3" targetRef="W2327_Task4" />
      <bpmn:sequenceFlow id="W2327_Flow9" sourceRef="W2327_Task4" targetRef="W2327_End5" />
    </bpmn:process>
