      <bpmn:sequenceFlow id="W3536_Flow13" sourceRef="W3536_Task6" targetRef="W3536_Task7" />
      <bpmn:sequenceFlow id="W3536_Flow14" sourceRef="W3536_Task7" targetRef="W3536_End8" />
    </bpmn:process>
