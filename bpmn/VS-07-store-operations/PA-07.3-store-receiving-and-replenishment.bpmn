    <bpmn:process id="W_W1058" name="W1058. Store-Level Customer Bulk Construction Water Delivery &amp; Site Logistics Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Customer (contractor or developer) requests bulk water delivery to a construction site for concrete mixing, curing, dust suppression, or site use
Frequency: ~2,000–3,000 delivery requests/month across all stores (Philippine construction sites in areas without municipal water connections require delivered water)
Volume: 1 delivery order per site per request; typical order: 1–5 tanker loads (2,000–10,000 liters per tanker)
Owner: Lumber &amp; Building Materials Department Supervisor
Participants: Sales Associate (Building Materials Section), Delivery Coordinator, Third-Party Water Tanker Operator, Customer
Source: workflow W1058 — Store-Level Customer Bulk Construction Water Delivery &amp; Site Logistics Coordination</bpmn:documentation>
      <bpmn:laneSet id="W1058_LaneSet4">
        <bpmn:lane id="W1058_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W1058_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1058_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1058_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1058_Lane2" name="System">
        <bpmn:flowNodeRef>W1058_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1058_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1058_Lane3" name="Water Tanker Operator">
        <bpmn:flowNodeRef>W1058_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1058_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1058_Start5" name="Customer (contractor or developer) requests bulk water delivery to a construction site…">
        <bpmn:outgoing>W1058_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1058_Task6" name="Water Demand Assessment &amp; Order Intake">
        <bpmn:documentation>Step 1: Water Demand Assessment &amp; Order Intake: Sales Associate gathers delivery requirements: (a) project location (address, landmark, GPS coordinates for mapping per W1031 delivery service area); (b) water volume required (liters or cubic meters); (c) purpose — concrete mixing, curing, dust suppression, general site use; (d) delivery schedule — one-time or recurring (daily/weekly); (e) site access — tanker truck accessible road? Minimum road width 3m for 6-wheeler tanker, 4m for 10-wheeler; overhead clearance &gt;4m; turning radius for turnaround; (f) on-site storage — available water tank/drum capacity at site (determines if multiple trips needed per day); (g) water quality requirement — potable (for worker drinking/cooking) or non-potable (construction use); (h) customer account type — walk-in retail, trade account, corporate project account per W58
Responsible (R): Sales Associate
Accountable (A): Lumber &amp; Building Materials Dept Supervisor
Duration: 5–8 min</bpmn:documentation>
        <bpmn:incoming>W1058_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1058_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1058_Task7" name="Water Source &amp; Tanker Matching">
        <bpmn:documentation>Step 2: Water Source &amp; Tanker Matching: System matches delivery requirements with partnered water tanker operators: (a) system accesses approved water tanker vendor list per W62B (3PL/delivery partner onboarding); (b) tanker capacity options: (i) 6-wheeler: 4,000–6,000 liters; (ii) 10-wheeler: 8,000–12,000 liters; (iii) mini-tanker/truck: 1,000–2,000 liters (for narrow roads); (c) system calculates number of trips: total volume required ÷ tanker capacity, rounded up; (d) system estimates delivery cost: (i) base delivery fee per trip (distance-based from water source to site); (ii) water cost per liter (varies by source: PHP 15–30 per m³ for non-potable, PHP 30–60 per m³ for potable); (iii) total cost = (water cost × volume) + (delivery fee × trips); (e) system checks if site is within delivery coverage area per W1031 (geo-fenced delivery zones)
Responsible (R): System / Delivery Coordinator
Accountable (A): Lumber &amp; Building Materials Dept Supervisor
Duration: 2–3 min</bpmn:documentation>
        <bpmn:incoming>W1058_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1058_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1058_Task8" name="Delivery Scheduling &amp; Confirmation">
        <bpmn:documentation>Step 3: Delivery Scheduling &amp; Confirmation: (a) system offers available delivery time slots (per tanker operator&#x27;s schedule); (b) for recurring orders: system sets up recurring delivery schedule (e.g., daily at 8:00 AM for 30 days) with automatic order generation per W2A-like recurring order logic; (c) customer confirms order and delivery schedule; (d) system collects payment: (i) one-time orders: full payment at POS per W5B; (ii) recurring orders: deposit per W94 (customer deposit) equivalent to 1 week&#x27;s estimated cost, with weekly billing per W8 (AR billing) for trade/corporate accounts; (e) system sends order confirmation to customer via SMS/email with delivery details (tanker plate number, driver name, estimated arrival, volume); (f) system sends dispatch instruction to water tanker operator with site location, access instructions, and customer contact
Responsible (R): Sales Associate / Delivery Coordinator
Accountable (A): Lumber &amp; Building Materials Dept Supervisor
Duration: 5–8 min</bpmn:documentation>
        <bpmn:incoming>W1058_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1058_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1058_Task9" name="Delivery Execution &amp; Proof of Delivery">
        <bpmn:documentation>Step 4: Delivery Execution &amp; Proof of Delivery: (a) water tanker arrives at construction site at scheduled time; (b) tanker operator contacts customer on-site for unloading coordination; (c) water transferred to customer&#x27;s on-site storage (tank, drums, or direct to curing area); (d) tanker operator captures proof of delivery: (i) photo of water being discharged at site; (ii) GPS coordinates and timestamp; (iii) customer&#x27;s signature on delivery receipt confirming volume received; (e) if volume discrepancy: tanker operator records actual volume delivered (from flow meter) vs. ordered volume; system adjusts billing per actual delivered volume; (f) system logs proof of delivery and triggers billing finalization
Responsible (R): Water Tanker Operator / Customer
Accountable (A): Delivery Coordinator
Duration: 30–90 min (depending on travel and discharge time)</bpmn:documentation>
        <bpmn:incoming>W1058_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1058_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1058_Task10" name="Recurring Order Management &amp; Billing">
        <bpmn:documentation>Step 5: Recurring Order Management &amp; Billing: (a) for recurring orders: system auto-generates daily delivery orders per agreed schedule; (b) system tracks cumulative volume delivered per billing period (weekly); (c) system generates weekly statement: total volume delivered × rate per m³ + total delivery fees; (d) for trade/corporate accounts: weekly invoice generated per W8 (AR billing) with payment terms per W295 (payment terms master); (e) system monitors deposit balance — if deposit falls below 3 days&#x27; estimated cost, system sends auto-replenishment reminder to customer; (f) customer can modify or cancel recurring schedule with 24-hour notice; (g) at project completion: system generates final delivery summary and reconciliation statement
Responsible (R): System / Delivery Coordinator / Sales Associate
Accountable (A): Lumber &amp; Building Materials Dept Supervisor
Duration: 10–15 min (weekly billing cycle)</bpmn:documentation>
        <bpmn:incoming>W1058_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1058_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1058_End11" name="Complete">
        <bpmn:incoming>W1058_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1058_Annotation12">
        <bpmn:text>Controls: - CTL-261 (ensure controlled execution — Store Receiving &amp; Replenishment (PA-07.3).) | - operational: must only match with operators who have DOH-accredited water quality testing certificates
Owner: Lumber &amp; Building Materials Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1058_Assoc13" sourceRef="W1058_Annotation12" targetRef="W1058_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1058_Flow14" sourceRef="W1058_Start5" targetRef="W1058_Task6" />
      <bpmn:sequenceFlow id="W1058_Flow15" sourceRef="W1058_Task6" targetRef="W1058_Task7" />
      <bpmn:sequenceFlow id="W1058_Flow16" sourceRef="W1058_Task7" targetRef="W1058_Task8" />
      <bpmn:sequenceFlow id="W1058_Flow17" sourceRef="W1058_Task8" targetRef="W1058_Task9" />
      <bpmn:sequenceFlow id="W1058_Flow18" sourceRef="W1058_Task9" targetRef="W1058_Task10" />
      <bpmn:sequenceFlow id="W1058_Flow19" sourceRef="W1058_Task10" targetRef="W1058_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1058_diag">
      <bpmndi:BPMNPlane id="W1058_plane" bpmnElement="W_W1058">
        <bpmndi:BPMNShape id="W1058_Lane1_di" bpmnElement="W1058_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1058_Lane2_di" bpmnElement="W1058_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1058_Lane3_di" bpmnElement="W1058_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1058_Task6_di" bpmnElement="W1058_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
