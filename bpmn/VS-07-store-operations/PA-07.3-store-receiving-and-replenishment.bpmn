        <bpmndi:BPMNShape id="W825_Task12_di" bpmnElement="W825_Task12"><dc:Bounds x="1660" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W825_Task13_di" bpmnElement="W825_Task13"><dc:Bounds x="1870" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W825_Task14_di" bpmnElement="W825_Task14"><dc:Bounds x="2080" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W825_Start5_di" bpmnElement="W825_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W825_End15_di" bpmnElement="W825_End15"><dc:Bounds x="2310" y="487" width="36" height="36" /></bpmndi:BPMNShape>
