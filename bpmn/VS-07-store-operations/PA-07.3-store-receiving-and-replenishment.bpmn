    <bpmn:process id="W_W18B" name="W18B. DSD Vendor Delivery Scheduling" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly DSD delivery schedule coordination
Frequency: Weekly schedule per DSD vendor; ~500–600 DSD deliveries/month across 200 stores
Volume: ~2–3 DSD deliveries per store per month; each vendor serves multiple stores per region
Owner: Buyer (coordination); Receiving Clerk (store execution)
Participants: Buyer, Vendor, Receiving Clerk, Store Manager
Source: workflow W18B — DSD Vendor Delivery Scheduling</bpmn:documentation>
      <bpmn:laneSet id="W18B_LaneSet4">
        <bpmn:lane id="W18B_Lane1" name="Buyer">
        <bpmn:flowNodeRef>W18B_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W18B_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W18B_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W18B_Lane2" name="System">
        <bpmn:flowNodeRef>W18B_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W18B_Lane3" name="Receiving Clerk">
        <bpmn:flowNodeRef>W18B_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W18B_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W18B_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W18B_Start5" name="Weekly DSD delivery schedule coordination">
        <bpmn:outgoing>W18B_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W18B_Task6" name="Buyer maintains DSD vendor delivery calendar per vendor: assigned stores…">
        <bpmn:documentation>Step 1: Buyer maintains DSD vendor delivery calendar per vendor: assigned stores, delivery frequency, preferred delivery day(s), contact person, special handling requirements
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 1 hour/vendor/quarter</bpmn:documentation>
        <bpmn:incoming>W18B_Flow14</bpmn:incoming>
        <bpmn:outgoing>W18B_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W18B_Task7" name="Vendor or Buyer confirms weekly delivery schedule: which stores, which day…">
        <bpmn:documentation>Step 2: Vendor or Buyer confirms weekly delivery schedule: which stores, which day, approximate time window, PO references (if applicable)
Responsible (R): Buyer / Vendor
Accountable (A): Buyer
Duration: 30 min/vendor/week</bpmn:documentation>
        <bpmn:incoming>W18B_Flow15</bpmn:incoming>
        <bpmn:outgoing>W18B_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W18B_Task8" name="System pushes DSD delivery schedule to affected store Receiving Clerks via…">
        <bpmn:documentation>Step 3: System pushes DSD delivery schedule to affected store Receiving Clerks via handheld/tablet notification; includes expected vendor, PO references, and time window
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W18B_Flow16</bpmn:incoming>
        <bpmn:outgoing>W18B_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W18B_Task9" name="Receiving Clerk plans receiving dock availability around DSD schedule and DC…">
        <bpmn:documentation>Step 4: Receiving Clerk plans receiving dock availability around DSD schedule and DC replenishment truck schedule (W4); flags scheduling conflicts to Store Manager
Responsible (R): Receiving Clerk
Accountable (A): Store Manager
Duration: 15 min/day</bpmn:documentation>
        <bpmn:incoming>W18B_Flow17</bpmn:incoming>
        <bpmn:outgoing>W18B_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W18B_Task10" name="If vendor misses scheduled delivery: Receiving Clerk reports no-show to Buyer…">
        <bpmn:documentation>Step 5: If vendor misses scheduled delivery: Receiving Clerk reports no-show to Buyer; Buyer follows up with vendor; reschedules within the same week if possible; tracks vendor delivery reliability in vendor scorecard (W44)
Responsible (R): Receiving Clerk / Buyer
Accountable (A): Category Manager
Duration: 10 min/occurrence</bpmn:documentation>
        <bpmn:incoming>W18B_Flow18</bpmn:incoming>
        <bpmn:outgoing>W18B_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W18B_End11" name="Complete">
        <bpmn:incoming>W18B_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W18B_Annotation12">
        <bpmn:text>Controls: (none recorded)
Owner: Buyer (coordination); Receiving Clerk (store execution)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W18B_Assoc13" sourceRef="W18B_Annotation12" targetRef="W18B_Start5" associationDirection="None" />
