    <bpmn:process id="W_W1412" name="W1412. Store-Level Receiving Dock Safety Inspection, Material Handling Compliance &amp; Incident Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly safety inspection schedule; or post-incident investigation; or new employee onboarding to receiving role
Frequency: Weekly visual inspection; monthly comprehensive inspection; incident-triggered inspection as needed
Volume: ~200 stores × 52 weekly inspections = ~10,400 inspections/year; ~200 monthly comprehensive inspections/year; ~50–100 incident-triggered inspections/year
Owner: Store Manager
Participants: Store Manager, Receiving Clerk, Department Supervisor, Facilities Coordinator (HQ), Safety Officer (regional)
Source: workflow W1412 — Store-Level Receiving Dock Safety Inspection, Material Handling Compliance &amp; Incident Reporting</bpmn:documentation>
      <bpmn:laneSet id="W1412_LaneSet4">
        <bpmn:lane id="W1412_Lane1" name="Receiving Clerk">
        <bpmn:flowNodeRef>W1412_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1412_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1412_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1412_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W1412_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1412_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1412_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1412_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1412_Lane3" name="Facilities Coordinator">
        <bpmn:flowNodeRef>W1412_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1412_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1412_Start5" name="Weekly safety inspection schedule; or post-incident investigation; or new employee…">
        <bpmn:outgoing>W1412_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1412_Task6" name="Weekly visual inspection">
        <bpmn:documentation>Step 1: Weekly visual inspection: Receiving Clerk walks the receiving dock and backroom area per standardized checklist: (a) floor condition — no standing water, oil, or debris; non-slip matting in good condition; (b) dock leveler/plate — properly secured, no gaps between truck and dock; (c) lighting — adequate illumination (&gt; 200 lux) in receiving area and backroom aisles; (d) MHE condition — pallet jacks and hand trucks operational per W1403; (e) exit routes — unobstructed, clearly marked; (f) PPE availability — safety gloves, steel-toe boots, back support belts available and in good condition; (g) chemical/hazmat receiving area — spill kit accessible, SDS binder present; (h) stacking height — inventory stacked below maximum height (2.4m or 2 pallets high)
Responsible (R): Receiving Clerk
Accountable (A): Store Manager
Duration: 15 min/week</bpmn:documentation>
        <bpmn:incoming>W1412_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1412_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1412_Task7" name="Receiving Clerk enters inspection results in system: Pass / Needs Attention /…">
        <bpmn:documentation>Step 2: Receiving Clerk enters inspection results in system: Pass / Needs Attention / Hazard — Immediate Action Required; if &quot;Hazard&quot;: Receiving Clerk stops receiving operations, restricts access to the hazard area, and immediately notifies Store Manager
Responsible (R): Receiving Clerk
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1412_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1412_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1412_Task8" name="Monthly comprehensive inspection">
        <bpmn:documentation>Step 3: Monthly comprehensive inspection: Store Manager conducts detailed inspection with Receiving Clerk: (a) all weekly items plus (b) dock door mechanisms (springs, seals, weather stripping), (c) fire extinguisher accessibility and charge level, (d) electrical panel clearance (1m clearance maintained), (e) pallet rack integrity (no bent uprights, missing pins, or overloaded shelves), (f) waste accumulation (no excessive packaging blocking aisles), (g) receiving dock exterior (drainage clear, no unauthorized access, adequate bollard protection), (h) emergency stop button for dock equipment tested
Responsible (R): Store Manager / Receiving Clerk
Accountable (A): Regional Manager
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W1412_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1412_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1412_Task9" name="Store Manager documents findings with photographs; creates corrective action…">
        <bpmn:documentation>Step 4: Store Manager documents findings with photographs; creates corrective action items for any &quot;Needs Attention&quot; or &quot;Hazard&quot; items; assigns responsible person and target completion date; system tracks corrective actions to closure
Responsible (R): Store Manager
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1412_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1412_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1412_Task10" name="Incident reporting">
        <bpmn:documentation>Step 5: Incident reporting: if any injury, near-miss, or property damage occurs at the receiving dock: (a) Receiving Clerk provides first aid (if trained) and calls Store Manager, (b) Store Manager secures the scene, (c) Store Manager completes incident report in system within 4 hours: date/time, location, person(s) involved, description of incident, immediate cause, contributing factors, photographs, witness statements, (d) if injury requires medical treatment: Store Manager transports employee to nearest clinic/hospital and files DOLE report per W779, (e) if DOLE-reportable: Safety Officer notified for mandatory reporting
Responsible (R): Store Manager / Receiving Clerk
Accountable (A): Regional Manager
Duration: 1–4 hours depending on severity</bpmn:documentation>
        <bpmn:incoming>W1412_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1412_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1412_Task11" name="Post-incident inspection">
        <bpmn:documentation>Step 6: Post-incident inspection: after any receiving dock incident, Store Manager conducts immediate targeted inspection of the specific hazard area; corrects the condition before resuming operations; updates the risk assessment for the receiving dock area
Responsible (R): Store Manager
Accountable (A): Facilities Coordinator
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1412_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1412_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1412_Task12" name="Monthly: Facilities Coordinator aggregates receiving dock safety data across…">
        <bpmn:documentation>Step 7: Monthly: Facilities Coordinator aggregates receiving dock safety data across all stores: (a) inspection pass rate by store, (b) corrective action closure rate, (c) incident frequency rate (incidents per 1,000 receiving events), (d) top 5 hazards across the chain; generates receiving dock safety dashboard for VP Store Operations
Responsible (R): Facilities Coordinator
Accountable (A): VP Store Operations
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1412_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1412_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1412_End13" name="Complete">
        <bpmn:incoming>W1412_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1412_Annotation14">
        <bpmn:text>Controls: - CTL-261 (ensure controlled execution — Store Receiving &amp; Replenishment (PA-07.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1412_Assoc15" sourceRef="W1412_Annotation14" targetRef="W1412_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1412_Flow16" sourceRef="W1412_Start5" targetRef="W1412_Task6" />
