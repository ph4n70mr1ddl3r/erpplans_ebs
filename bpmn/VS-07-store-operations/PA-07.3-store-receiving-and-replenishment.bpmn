      <bpmn:sequenceFlow id="W825_Flow24" sourceRef="W825_Task11" targetRef="W825_Task12" />
      <bpmn:sequenceFlow id="W825_Flow25" sourceRef="W825_Task12" targetRef="W825_Task13" />
      <bpmn:sequenceFlow id="W825_Flow26" sourceRef="W825_Task13" targetRef="W825_Task14" />
      <bpmn:sequenceFlow id="W825_Flow27" sourceRef="W825_Task14" targetRef="W825_End15" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W825_diag">
      <bpmndi:BPMNPlane id="W825_plane" bpmnElement="W_W825">
        <bpmndi:BPMNShape id="W825_Lane1_di" bpmnElement="W825_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2210" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W825_Lane2_di" bpmnElement="W825_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="2210" height="170" /></bpmndi:BPMNShape>
