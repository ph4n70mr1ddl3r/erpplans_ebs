        <bpmndi:BPMNEdge id="W18B_Flow18_di" bpmnElement="W18B_Flow18"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W18B_Flow19_di" bpmnElement="W18B_Flow19"><di:waypoint x="1420" y="505" /><di:waypoint x="1470" y="505" /></bpmndi:BPMNEdge>
