      <bpmn:sequenceFlow id="W1112_Flow14" sourceRef="W1112_Task5" targetRef="W1112_Task6" />
      <bpmn:sequenceFlow id="W1112_Flow15" sourceRef="W1112_Task6" targetRef="W1112_Task7" />
      <bpmn:sequenceFlow id="W1112_Flow16" sourceRef="W1112_Task7" targetRef="W1112_Task8" />
      <bpmn:sequenceFlow id="W1112_Flow17" sourceRef="W1112_Task8" targetRef="W1112_End9" />
    </bpmn:process>
