    <bpmn:process id="W_W583" name="W583. Store-Level Seasonal Promotional Transition &amp; Display Reset" isExecutable="false">
      <bpmn:documentation>Trigger: Promotional transition brief received from HQ (typically T-3 days before new promotion start)
Frequency: Bi-monthly major sales + monthly hot deals + 4 seasonal transitions = ~20–24 transitions/year per store
Volume: 200 stores × 22 transitions/year = 4,400 transition events/year
Owner: Store Manager
Participants: Department Supervisors, Stock Associates, Visual Merchandising Associate (larger stores)
Source: workflow W583 — Store-Level Seasonal Promotional Transition &amp; Display Reset</bpmn:documentation>
      <bpmn:laneSet id="W583_LaneSet6">
        <bpmn:lane id="W583_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W583_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W583_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W583_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W583_Lane2" name="Department Supervisors">
        <bpmn:flowNodeRef>W583_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W583_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W583_Lane3" name="Stock Associates">
        <bpmn:flowNodeRef>W583_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W583_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W583_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W583_Lane4" name="Lead Cashier">
        <bpmn:flowNodeRef>W583_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W583_Lane5" name="Department Supervisor">
        <bpmn:flowNodeRef>W583_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W583_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W583_Start7" name="Promotional transition brief received from HQ (typically T-3 days before new promotion…">
        <bpmn:outgoing>W583_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W583_Task8" name="Receive transition brief">
        <bpmn:documentation>Step 1: Receive transition brief (T-3 days): HQ distributes promotional transition brief via W571 communication module — contains: old promo teardown instructions, new promo planograms, new signage, new shelf tags, POS configuration changes, display build instructions, stock pick list for promotional items
Responsible (R): Store Manager
Accountable (A): VP Store Operations
Duration: 10 min (review)</bpmn:documentation>
        <bpmn:incoming>W583_Flow20</bpmn:incoming>
        <bpmn:outgoing>W583_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W583_Task9" name="Old promo teardown">
        <bpmn:documentation>Step 2: Old promo teardown (T-1 day or after store close on last day of old promo): (a) remove old promotional signage and shelf talkers, (b) dismantle old promotional displays (endcaps, power wings, feature tables), (c) remove old promotional shelf tags per W63, (d) return unsold promotional stock to regular shelf locations or backroom
Responsible (R): Department Supervisors
Accountable (A): Store Manager
Duration: 60–90 min</bpmn:documentation>
        <bpmn:incoming>W583_Flow21</bpmn:incoming>
        <bpmn:outgoing>W583_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W583_Task10" name="New planogram execution">
        <bpmn:documentation>Step 3: New planogram execution for promotional displays: (a) execute new planogram per W86 for endcaps, feature tables, and promotional bays, (b) install new display fixtures if provided (risers, bins, signage holders), (c) position promotional stock from backroom pick list
Responsible (R): Stock Associates
Accountable (A): Department Supervisor
Duration: 60–120 min</bpmn:documentation>
        <bpmn:incoming>W583_Flow22</bpmn:incoming>
        <bpmn:outgoing>W583_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W583_Task11" name="Signage and shelf tag installation">
        <bpmn:documentation>Step 4: Signage and shelf tag installation: (a) install new promotional signage (hanging signs, shelf talkers, window posters, department banners), (b) print and install new shelf tags per W181 for all promotional SKUs, (c) update digital signage per W504 if applicable
Responsible (R): Stock Associates
Accountable (A): Department Supervisor
Duration: 30–45 min</bpmn:documentation>
        <bpmn:incoming>W583_Flow23</bpmn:incoming>
        <bpmn:outgoing>W583_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W583_Task12" name="POS configuration verification">
        <bpmn:documentation>Step 5: POS configuration verification: verify all promotional prices are loaded in POS system per W523 — scan sample promotional items to confirm correct promotional price, validate quantity break pricing, verify bundle/combo pricing
Responsible (R): Lead Cashier
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W583_Flow24</bpmn:incoming>
        <bpmn:outgoing>W583_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W583_Task13" name="Endcap and feature display build">
        <bpmn:documentation>Step 6: Endcap and feature display build: construct feature displays for high-impact promotional items (e.g., power tool festival, paint sale, tile showcase) — includes display fixture assembly, product placement, price card insertion, and signage
Responsible (R): Department Supervisors
Accountable (A): Store Manager
Duration: 30–60 min per display</bpmn:documentation>
        <bpmn:incoming>W583_Flow25</bpmn:incoming>
        <bpmn:outgoing>W583_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W583_Task14" name="Promotional stock placement and fronting">
        <bpmn:documentation>Step 7: Promotional stock placement and fronting: place all promotional stock on designated shelves and displays; front and face all items; verify stock levels match allocation
Responsible (R): Stock Associates
Accountable (A): Department Supervisor
Duration: 30–45 min</bpmn:documentation>
        <bpmn:incoming>W583_Flow26</bpmn:incoming>
        <bpmn:outgoing>W583_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W583_Task15" name="Pre-opening walkthrough verification">
        <bpmn:documentation>Step 8: Pre-opening walkthrough verification: Store Manager walks all promotional displays and zones — verify: (a) correct planogram execution, (b) all signage in place, (c) correct pricing on shelf tags, (d) POS prices match shelf tags, (e) displays are visually appealing and safe, (f) no old promotional material remaining
Responsible (R): Store Manager
Accountable (A): —
Duration: 15–20 min</bpmn:documentation>
        <bpmn:incoming>W583_Flow27</bpmn:incoming>
        <bpmn:outgoing>W583_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W583_Task16" name="Photographic documentation">
        <bpmn:documentation>Step 9: Photographic documentation: Department Supervisor photographs each promotional display and endcap; uploads to system for HQ compliance audit; photos timestamped and geo-tagged
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W583_Flow28</bpmn:incoming>
        <bpmn:outgoing>W583_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W583_End17" name="Complete">
        <bpmn:incoming>W583_Flow29</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W583_Annotation18">
        <bpmn:text>Controls: - CTL-261 (ensure controlled execution — Store Receiving &amp; Replenishment (PA-07.3).) | - operational: pre-positioning per W57 and substitution protocol (display with available stock, backorder sign for remaining); operational: photographic documentation requirement and Regional Manager spot-check during first week of new promo; operational: mandatory Step 5 POS verification and W553 pricing error detection
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W583_Assoc19" sourceRef="W583_Annotation18" targetRef="W583_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W583_Flow20" sourceRef="W583_Start7" targetRef="W583_Task8" />
      <bpmn:sequenceFlow id="W583_Flow21" sourceRef="W583_Task8" targetRef="W583_Task9" />
      <bpmn:sequenceFlow id="W583_Flow22" sourceRef="W583_Task9" targetRef="W583_Task10" />
      <bpmn:sequenceFlow id="W583_Flow23" sourceRef="W583_Task10" targetRef="W583_Task11" />
      <bpmn:sequenceFlow id="W583_Flow24" sourceRef="W583_Task11" targetRef="W583_Task12" />
      <bpmn:sequenceFlow id="W583_Flow25" sourceRef="W583_Task12" targetRef="W583_Task13" />
      <bpmn:sequenceFlow id="W583_Flow26" sourceRef="W583_Task13" targetRef="W583_Task14" />
      <bpmn:sequenceFlow id="W583_Flow27" sourceRef="W583_Task14" targetRef="W583_Task15" />
      <bpmn:sequenceFlow id="W583_Flow28" sourceRef="W583_Task15" targetRef="W583_Task16" />
      <bpmn:sequenceFlow id="W583_Flow29" sourceRef="W583_Task16" targetRef="W583_End17" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W583_diag">
      <bpmndi:BPMNPlane id="W583_plane" bpmnElement="W_W583">
