        <bpmndi:BPMNShape id="W723_Annotation11_di" bpmnElement="W723_Annotation11"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W723_Flow13_di" bpmnElement="W723_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W723_Flow14_di" bpmnElement="W723_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W723_Flow15_di" bpmnElement="W723_Flow15"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W723_Flow16_di" bpmnElement="W723_Flow16"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W723_Flow17_di" bpmnElement="W723_Flow17"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
