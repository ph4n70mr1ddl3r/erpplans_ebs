    <bpmn:process id="W_W745" name="W745. Store-Level Receiving Dock Scheduling &amp; DSD Vendor Delivery Window Management" isExecutable="false">
      <bpmn:documentation>Trigger: DSD vendor delivery schedule; inter-store transfer arrival; customer pickup of bulky items
Frequency: Daily dock schedule; ~3–5 receiving events per store per week
Volume: 200 stores × ~4 receiving events/week = ~800 receiving events/week chain-wide (~115/day)
Owner: Stock Associate / Department Supervisor
Participants: Stock Associate, Department Supervisor, Vendor Driver, Delivery Carrier, LP (W37)
Source: workflow W745 — Store-Level Receiving Dock Scheduling &amp; DSD Vendor Delivery Window Management</bpmn:documentation>
      <bpmn:laneSet id="W745_LaneSet3">
        <bpmn:lane id="W745_Lane1" name="System">
        <bpmn:flowNodeRef>W745_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W745_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W745_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W745_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W745_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W745_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W745_Lane2" name="Stock Associate">
        <bpmn:flowNodeRef>W745_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W745_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W745_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W745_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W745_Start4" name="DSD vendor delivery schedule; inter-store transfer arrival; customer pickup of bulky items">
        <bpmn:outgoing>W745_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W745_Task5" name="Dock schedule generation — System compiles next-day delivery schedule from…">
        <bpmn:documentation>Step 1: Dock schedule generation — System compiles next-day delivery schedule from: confirmed DC delivery windows (W4), DSD vendor appointments (W18B), inter-store transfer ETAs (W22), and special order shipment notifications
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W745_Flow16</bpmn:incoming>
        <bpmn:outgoing>W745_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W745_Task6" name="Time slot allocation — System assigns dock time slots based on delivery…">
        <bpmn:documentation>Step 2: Time slot allocation — System assigns dock time slots based on delivery priority (perishable/temperature-sensitive first, then high-priority replenishment, then routine), dock door availability (1–2 dock doors per store), and staffing availability (W34)
Responsible (R): System / Stock Associate
Accountable (A): Department Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W745_Flow17</bpmn:incoming>
        <bpmn:outgoing>W745_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W745_Task7" name="Vendor notification — System sends dock time slot confirmation to…">
        <bpmn:documentation>Step 3: Vendor notification — System sends dock time slot confirmation to vendor/carrier via SMS/email; includes dock door assignment, expected unload duration, and store contact number
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W745_Flow18</bpmn:incoming>
        <bpmn:outgoing>W745_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W745_Task8" name="Day-of gate check-in — Vendor/carrier arrives; Stock Associate verifies…">
        <bpmn:documentation>Step 4: Day-of gate check-in — Vendor/carrier arrives; Stock Associate verifies delivery appointment, checks against schedule, and assigns to designated dock door or staging area
Responsible (R): Stock Associate
Accountable (A): Department Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W745_Flow19</bpmn:incoming>
        <bpmn:outgoing>W745_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W745_Task9" name="Receiving execution — Stock Associate executes receiving per W18 (DSD) or W109…">
        <bpmn:documentation>Step 5: Receiving execution — Stock Associate executes receiving per W18 (DSD) or W109 (DC/transfer); dock time slot enforces expected completion time
Responsible (R): Stock Associate
Accountable (A): —
Duration: 15–60 min</bpmn:documentation>
        <bpmn:incoming>W745_Flow20</bpmn:incoming>
        <bpmn:outgoing>W745_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W745_Task10" name="Dock congestion management — If delivery arrives outside scheduled window or…">
        <bpmn:documentation>Step 6: Dock congestion management — If delivery arrives outside scheduled window or previous delivery overruns, Stock Associate redirects to overflow staging area; system reschedules to next available slot
Responsible (R): Stock Associate
Accountable (A): Department Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W745_Flow21</bpmn:incoming>
        <bpmn:outgoing>W745_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W745_Task11" name="No-show management — Vendor no-show for scheduled delivery: system logs…">
        <bpmn:documentation>Step 7: No-show management — Vendor no-show for scheduled delivery: system logs no-show; feeds to vendor scorecard (W44); auto-triggers follow-up to vendor and DC for alternate supply plan
Responsible (R): System / Department Supervisor
Accountable (A): Department Supervisor
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W745_Flow22</bpmn:incoming>
        <bpmn:outgoing>W745_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W745_Task12" name="Weekly receiving efficiency report — System compiles: on-time delivery rate…">
        <bpmn:documentation>Step 8: Weekly receiving efficiency report — System compiles: on-time delivery rate, average unload time, dock utilization rate, no-show rate; Store Manager reviews in W575 weekly review
Responsible (R): System / Store Manager
Accountable (A): Store Manager
Duration: Automated + 10 min</bpmn:documentation>
        <bpmn:incoming>W745_Flow23</bpmn:incoming>
        <bpmn:outgoing>W745_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W745_End13" name="Complete">
        <bpmn:incoming>W745_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W745_Annotation14">
        <bpmn:text>Controls: - CTL-261 (ensure controlled execution — Store Receiving &amp; Replenishment (PA-07.3).) | - operational: Stock Associate / Department Supervisor review and approval gate
Owner: Stock Associate / Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
