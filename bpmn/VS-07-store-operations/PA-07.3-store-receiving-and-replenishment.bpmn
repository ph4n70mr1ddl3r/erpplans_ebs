        <bpmndi:BPMNEdge id="W1283_Flow23_di" bpmnElement="W1283_Flow23"><di:waypoint x="1420" y="335" /><di:waypoint x="1450" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1283_Flow24_di" bpmnElement="W1283_Flow24"><di:waypoint x="1630" y="335" /><di:waypoint x="1660" y="505" /></bpmndi:BPMNEdge>
