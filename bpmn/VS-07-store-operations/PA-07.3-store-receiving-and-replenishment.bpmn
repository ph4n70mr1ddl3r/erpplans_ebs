<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-07.3-store-receiving-and-replenishment" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W18" name="W18. Direct Store Delivery (DSD) Receiving" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor delivers goods directly to store (bypassing DC)
Frequency: ~2–3 DSD deliveries per store per month; ~500–600 DSD receipts/month chain-wide
Volume: ~30% of total inbound goods by value/weight (cement, lumber, sand, gravel are bulky/high-value); ~500–600 DSD receipts/month (~8–10% of total receipt count); ~5–10 lines per receipt
Owner: Receiving Clerk (Store)
Participants: Receiving Clerk, Department Supervisor, Vendor Driver, AP Clerk
Source: workflow W18 — Direct Store Delivery (DSD) Receiving</bpmn:documentation>
      <bpmn:laneSet id="W18_LaneSet6">
        <bpmn:lane id="W18_Lane1" name="Vendor Driver">
        <bpmn:flowNodeRef>W18_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W18_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W18_Lane2" name="Receiving Clerk">
        <bpmn:flowNodeRef>W18_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W18_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W18_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W18_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W18_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W18_Lane3" name="Dept. Supervisor">
        <bpmn:flowNodeRef>W18_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W18_Lane4" name="Stock Associate">
        <bpmn:flowNodeRef>W18_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W18_Lane5" name="AP Clerk">
        <bpmn:flowNodeRef>W18_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W18_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W18_Start7" name="Vendor delivers goods directly to store (bypassing DC)">
        <bpmn:outgoing>W18_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W18_Task8" name="Vendor arrives at store receiving dock; presents Delivery Receipt (DR) and PO…">
        <bpmn:documentation>Step 1: Vendor arrives at store receiving dock; presents Delivery Receipt (DR) and PO reference
Responsible (R): Vendor Driver
Accountable (A): Receiving Clerk
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W18_Flow20</bpmn:incoming>
        <bpmn:outgoing>W18_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W18_Task9" name="Receiving Clerk retrieves PO in system on handheld/tablet">
        <bpmn:documentation>Step 2: Receiving Clerk retrieves PO in system on handheld/tablet
Responsible (R): Receiving Clerk
Accountable (A): Dept. Supervisor
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W18_Flow21</bpmn:incoming>
        <bpmn:outgoing>W18_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W18_Task10" name="Unload goods; Receiving Clerk scans/verifies each item against PO: SKU…">
        <bpmn:documentation>Step 3: Unload goods; Receiving Clerk scans/verifies each item against PO: SKU, quantity, condition
Responsible (R): Receiving Clerk
Accountable (A): Dept. Supervisor
Duration: 20–45 min</bpmn:documentation>
        <bpmn:incoming>W18_Flow22</bpmn:incoming>
        <bpmn:outgoing>W18_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W18_Task11" name="Quality check on sampled items (damage, completeness)">
        <bpmn:documentation>Step 4: Quality check on sampled items (damage, completeness)
Responsible (R): Dept. Supervisor
Accountable (A): Dept. Supervisor
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W18_Flow23</bpmn:incoming>
        <bpmn:outgoing>W18_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W18_Task12" name="If discrepancy: flag in system; note on DR; notify Buyer">
        <bpmn:documentation>Step 5: If discrepancy: flag in system; note on DR; notify Buyer
Responsible (R): Receiving Clerk
Accountable (A): Dept. Supervisor
Duration: 5 min if any</bpmn:documentation>
        <bpmn:incoming>W18_Flow24</bpmn:incoming>
        <bpmn:outgoing>W18_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W18_Task13" name="Confirm Goods Receipt in system; store inventory increases in real-time">
        <bpmn:documentation>Step 6: Confirm Goods Receipt in system; store inventory increases in real-time
Responsible (R): Receiving Clerk
Accountable (A): Dept. Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W18_Flow25</bpmn:incoming>
        <bpmn:outgoing>W18_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W18_Task14" name="Vendor DR signed and returned; copy retained for AP matching">
        <bpmn:documentation>Step 7: Vendor DR signed and returned; copy retained for AP matching
Responsible (R): Receiving Clerk
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W18_Flow26</bpmn:incoming>
        <bpmn:outgoing>W18_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W18_Task15" name="Stock Associate moves goods directly to sales floor (no backroom staging for…">
        <bpmn:documentation>Step 8: Stock Associate moves goods directly to sales floor (no backroom staging for DSD)
Responsible (R): Stock Associate
Accountable (A): Dept. Supervisor
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W18_Flow27</bpmn:incoming>
        <bpmn:outgoing>W18_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W18_Task16" name="AP receives vendor invoice; 3-way match: PO → Store GR → Invoice">
        <bpmn:documentation>Step 9: AP receives vendor invoice; 3-way match: PO → Store GR → Invoice
Responsible (R): AP Clerk
Accountable (A): AP Supervisor
Duration: Automated / 10 min</bpmn:documentation>
        <bpmn:incoming>W18_Flow28</bpmn:incoming>
        <bpmn:outgoing>W18_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W18_End17" name="Complete">
        <bpmn:incoming>W18_Flow29</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W18_Annotation18">
        <bpmn:text>Controls: - CTL-261 (ensure controlled execution — Store Receiving &amp; Replenishment (PA-07.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Receiving Clerk (Store)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W18_Assoc19" sourceRef="W18_Annotation18" targetRef="W18_Start7" associationDirection="None" />
