    <bpmn:process id="W_W420" name="W420. AI Shelf Monitoring &amp; Real-time Replenishment Alerting" isExecutable="false">
      <bpmn:documentation>Trigger: Computer Vision (CV) system detects Out-of-Stock (OOS) on shelf or Planogram (POG) non-compliance
Frequency: Real-time / Continuous
Volume: ~50–100 alerts per store/day
Owner: Department Supervisor
Participants: Stock Associate, IT Systems (AI Engine), Store Manager
Source: workflow W420 — AI Shelf Monitoring &amp; Real-time Replenishment Alerting</bpmn:documentation>
      <bpmn:laneSet id="W420_LaneSet4">
        <bpmn:lane id="W420_Lane1" name="System">
        <bpmn:flowNodeRef>W420_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W420_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W420_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W420_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W420_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W420_Lane2" name="Dept Supervisor">
        <bpmn:flowNodeRef>W420_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W420_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W420_Lane3" name="Stock Associate">
        <bpmn:flowNodeRef>W420_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W420_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W420_Start5" name="Computer Vision (CV) system detects Out-of-Stock (OOS) on shelf or Planogram (POG)…">
        <bpmn:outgoing>W420_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W420_Task6" name="Detection">
        <bpmn:documentation>Step 1: Detection: CV cameras/drones scan shelves; AI engine identifies gaps (OOS) or incorrect SKU placement vs. active Planogram (W86)
Responsible (R): System
Accountable (A): —
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W420_Flow16</bpmn:incoming>
        <bpmn:outgoing>W420_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W420_Task7" name="Alert Trigger">
        <bpmn:documentation>Step 2: Alert Trigger: System verifies OOS against ERP &quot;On-Hand&quot; (SOH); if SOH &gt; 0, system triggers a &quot;Shelf Gap&quot; alert to the Department Supervisor&#x27;s mobile device
Responsible (R): System
Accountable (A): IT Ops
Duration: &lt; 1 min</bpmn:documentation>
        <bpmn:incoming>W420_Flow17</bpmn:incoming>
        <bpmn:outgoing>W420_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W420_Task8" name="Validation">
        <bpmn:documentation>Step 3: Validation: Supervisor reviews alert on handheld; confirms if gap is actual OOS or if stock is hidden behind other items
Responsible (R): Dept Supervisor
Accountable (A): Store Manager
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W420_Flow18</bpmn:incoming>
        <bpmn:outgoing>W420_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W420_Task9" name="Stock Pull">
        <bpmn:documentation>Step 4: Stock Pull: If OOS confirmed and backroom stock exists: system creates an &quot;Urgent Stock Pull&quot; task for the nearest Stock Associate
Responsible (R): System / Supervisor
Accountable (A): Dept Supervisor
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W420_Flow19</bpmn:incoming>
        <bpmn:outgoing>W420_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W420_Task10" name="Replenishment">
        <bpmn:documentation>Step 5: Replenishment: Stock Associate pulls item from backroom/overstock and replenishes shelf; scans &quot;Task Complete&quot; on handheld
Responsible (R): Stock Associate
Accountable (A): Dept Supervisor
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W420_Flow20</bpmn:incoming>
        <bpmn:outgoing>W420_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W420_Task11" name="Audit">
        <bpmn:documentation>Step 6: Audit: AI engine re-scans shelf to confirm gap is closed; system logs &quot;Time-to-Replenish&quot; metric for Store KPIs
Responsible (R): System
Accountable (A): Store Manager
Duration: &lt; 5 min</bpmn:documentation>
        <bpmn:incoming>W420_Flow21</bpmn:incoming>
        <bpmn:outgoing>W420_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W420_Task12" name="Ghost Inventory Investigation">
        <bpmn:documentation>Step 7: Ghost Inventory Investigation: If SOH &gt; 0 but shelf is empty and backroom is empty: Supervisor triggers an &quot;Inventory Variance Investigation&quot; (W248) to find the &quot;Ghost Inventory&quot; (potential shrinkage)
Responsible (R): Dept Supervisor
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W420_Flow22</bpmn:incoming>
        <bpmn:outgoing>W420_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W420_End13" name="Complete">
        <bpmn:incoming>W420_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W420_Annotation14">
        <bpmn:text>Controls: - CTL-261 (ensure controlled execution — Store Receiving &amp; Replenishment (PA-07.3).) | - operational: Department Supervisor review and approval gate
Owner: Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W420_Assoc15" sourceRef="W420_Annotation14" targetRef="W420_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W420_Flow16" sourceRef="W420_Start5" targetRef="W420_Task6" />
      <bpmn:sequenceFlow id="W420_Flow17" sourceRef="W420_Task6" targetRef="W420_Task7" />
      <bpmn:sequenceFlow id="W420_Flow18" sourceRef="W420_Task7" targetRef="W420_Task8" />
