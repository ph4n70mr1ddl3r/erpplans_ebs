    <bpmn:process id="W_W668" name="W668. Store-Level Home Delivery &amp; Third-Party Logistics Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Customer home delivery order placed at POS or ecommerce order routed to store for fulfillment
Frequency: Daily; varies by store location (urban stores: 5-10/day, provincial: 1-3/day)
Volume: ~17,200 home delivery orders/month network-wide; ~86/store/month
Owner: Stock Associate (pick/pack); Store Manager (coordination)
Participants: Receiving Clerk, Customer Service Rep, Third-Party Courier
Source: workflow W668 — Store-Level Home Delivery &amp; Third-Party Logistics Coordination</bpmn:documentation>
      <bpmn:laneSet id="W668_LaneSet5">
        <bpmn:lane id="W668_Lane1" name="System">
        <bpmn:flowNodeRef>W668_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W668_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W668_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W668_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W668_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W668_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W668_Lane2" name="Stock Associate">
        <bpmn:flowNodeRef>W668_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W668_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W668_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W668_Lane3" name="Customer Service Rep">
        <bpmn:flowNodeRef>W668_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W668_Lane4" name="Store Manager">
        <bpmn:flowNodeRef>W668_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W668_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W668_Start6" name="Customer home delivery order placed at POS or ecommerce order routed to store for…">
        <bpmn:outgoing>W668_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W668_Task7" name="System routes home delivery order to originating store with customer details…">
        <bpmn:documentation>Step 1: System routes home delivery order to originating store with customer details, item list, delivery address, and preferred delivery window
Responsible (R): System
Accountable (A): Store Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W668_Flow20</bpmn:incoming>
        <bpmn:outgoing>W668_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W668_Task8" name="Stock Associate picks items from selling floor/backroom per pick list on…">
        <bpmn:documentation>Step 2: Stock Associate picks items from selling floor/backroom per pick list on handheld; verifies item, quantity, and condition; flags items out-of-stock for substitute suggestion per W279 or backorder per W56
Responsible (R): Stock Associate
Accountable (A): Store Manager
Duration: 10-15 min</bpmn:documentation>
        <bpmn:incoming>W668_Flow21</bpmn:incoming>
        <bpmn:outgoing>W668_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W668_Task9" name="Stock Associate packs items in delivery-appropriate packaging: fragile items…">
        <bpmn:documentation>Step 3: Stock Associate packs items in delivery-appropriate packaging: fragile items (tiles, electrical fixtures) in protective wrap, heavy items (cement, lumber) in reinforced packaging, hazardous items (paint, chemicals) per W237 hazmat labeling requirements
Responsible (R): Stock Associate
Accountable (A): Store Manager
Duration: 5-10 min</bpmn:documentation>
        <bpmn:incoming>W668_Flow22</bpmn:incoming>
        <bpmn:outgoing>W668_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W668_Task10" name="Customer Service Rep contacts customer for delivery confirmation and address…">
        <bpmn:documentation>Step 4: Customer Service Rep contacts customer for delivery confirmation and address verification; provides delivery tracking information
Responsible (R): Customer Service Rep
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W668_Flow23</bpmn:incoming>
        <bpmn:outgoing>W668_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W668_Task11" name="System auto-dispatches to third-party courier via API integration (Lalamove…">
        <bpmn:documentation>Step 5: System auto-dispatches to third-party courier via API integration (Lalamove, Transportify, own fleet per W548); selects vehicle type based on order weight/volume (motorcycle for small, van for bulky/lumber)
Responsible (R): System
Accountable (A): Store Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W668_Flow24</bpmn:incoming>
