      <bpmn:sequenceFlow id="W825_Flow20" sourceRef="W825_Task7" targetRef="W825_Task8" />
      <bpmn:sequenceFlow id="W825_Flow21" sourceRef="W825_Task8" targetRef="W825_Task9" />
      <bpmn:sequenceFlow id="W825_Flow22" sourceRef="W825_Task9" targetRef="W825_Task10" />
