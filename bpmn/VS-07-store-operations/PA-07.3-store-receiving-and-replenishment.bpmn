      <bpmn:sequenceFlow id="W723_Flow15" sourceRef="W723_Task6" targetRef="W723_Task7" />
      <bpmn:sequenceFlow id="W723_Flow16" sourceRef="W723_Task7" targetRef="W723_Task8" />
      <bpmn:sequenceFlow id="W723_Flow17" sourceRef="W723_Task8" targetRef="W723_Task9" />
      <bpmn:sequenceFlow id="W723_Flow18" sourceRef="W723_Task9" targetRef="W723_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W723_diag">
      <bpmndi:BPMNPlane id="W723_plane" bpmnElement="W_W723">
        <bpmndi:BPMNShape id="W723_Lane1_di" bpmnElement="W723_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
