    <bpmn:process id="W_W176" name="W176. Store-to-DC Reverse Logistics (Consolidation)" isExecutable="false">
      <bpmn:documentation>Trigger: Accumulation of customer returns, overstock, or defective items at store level requiring vendor return
Frequency: Bi-weekly per store
Volume: ~2–5 pallets per shipment
Owner: Store Receiving Clerk
Participants: Store Receiving Clerk, DC Receiving Clerk, Logistics (Fleet)
Source: workflow W176 — Store-to-DC Reverse Logistics (Consolidation)</bpmn:documentation>
      <bpmn:laneSet id="W176_LaneSet4">
        <bpmn:lane id="W176_Lane1" name="Store Clerk">
        <bpmn:flowNodeRef>W176_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W176_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W176_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W176_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W176_Lane2" name="Driver">
        <bpmn:flowNodeRef>W176_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W176_Lane3" name="DC Clerk">
        <bpmn:flowNodeRef>W176_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W176_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W176_Start5" name="Accumulation of customer returns, overstock, or defective items at store level requiring…">
        <bpmn:outgoing>W176_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W176_Task6" name="Consolidation">
        <bpmn:documentation>Step 1: Consolidation: Store Receiving Clerk identifies items in &quot;RTV Staging Area&quot; (from W12 returns or W91 damage); groups by Vendor and Reason (Defective, Overstock)
Responsible (R): Store Clerk
Accountable (A): Asst Store Mgr
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W176_Flow14</bpmn:incoming>
        <bpmn:outgoing>W176_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W176_Task7" name="Transfer Creation">
        <bpmn:documentation>Step 2: Transfer Creation: Clerk creates a &quot;Reverse Stock Transfer Order (RSTO)&quot; in ERP from Store to Hub DC; system ensures items are non-saleable in store inventory
Responsible (R): Store Clerk
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W176_Flow15</bpmn:incoming>
        <bpmn:outgoing>W176_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W176_Task8" name="Palletization">
        <bpmn:documentation>Step 3: Palletization: Items are boxed and palletized; &quot;Return Shipment&quot; labels generated from ERP
Responsible (R): Store Clerk
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W176_Flow16</bpmn:incoming>
        <bpmn:outgoing>W176_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W176_Task9" name="Backhaul Pickup">
        <bpmn:documentation>Step 4: Backhaul Pickup: Logistics truck (after making a store delivery, W4) picks up the return pallets (Backhaul)
Responsible (R): Driver
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W176_Flow17</bpmn:incoming>
        <bpmn:outgoing>W176_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W176_Task10" name="DC Receipt">
        <bpmn:documentation>Step 5: DC Receipt: DC Receiving Clerk receives pallets; scan-verifies against RSTO; moves to DC RTV Zone for consolidated shipment to Vendor (W88)
Responsible (R): DC Clerk
Accountable (A): DC Supervisor
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W176_Flow18</bpmn:incoming>
        <bpmn:outgoing>W176_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W176_End11" name="Complete">
        <bpmn:incoming>W176_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W176_Annotation12">
        <bpmn:text>Controls: - CTL-261 (ensure controlled execution — Store Receiving &amp; Replenishment (PA-07.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Store Receiving Clerk</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W176_Assoc13" sourceRef="W176_Annotation12" targetRef="W176_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W176_Flow14" sourceRef="W176_Start5" targetRef="W176_Task6" />
