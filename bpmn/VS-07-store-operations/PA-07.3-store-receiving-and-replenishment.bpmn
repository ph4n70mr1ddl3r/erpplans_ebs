    <bpmn:process id="W_W666" name="W666. Store-Level Inventory Receiving Quality Control" isExecutable="false">
      <bpmn:documentation>Trigger: Each inbound delivery at store receiving dock
Frequency: Per delivery; 2-3 deliveries per store per week (~500–600 store receipts/week network-wide)
Volume: ~15–25 pallets/cases per delivery; ~60–90 order lines per delivery (the W109 consolidated-drop canon)
Owner: Receiving Clerk
Participants: Department Supervisor, Stock Associate, Store Manager (for exceptions)
Source: workflow W666 — Store-Level Inventory Receiving Quality Control</bpmn:documentation>
      <bpmn:laneSet id="W666_LaneSet4">
        <bpmn:lane id="W666_Lane1" name="Receiving Clerk">
        <bpmn:flowNodeRef>W666_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W666_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W666_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W666_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W666_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W666_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W666_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W666_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W666_Lane2" name="Department Supervisor">
        <bpmn:flowNodeRef>W666_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W666_Lane3" name="Stock Associate">
        <bpmn:flowNodeRef>W666_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W666_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W666_Start5" name="Each inbound delivery at store receiving dock">
        <bpmn:outgoing>W666_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W666_Task6" name="Delivery truck arrives; Receiving Clerk verifies delivery appointment against…">
        <bpmn:documentation>Step 1: Delivery truck arrives; Receiving Clerk verifies delivery appointment against dock schedule and matches driver identification with carrier manifest
Responsible (R): Receiving Clerk
Accountable (A): Receiving Clerk
Duration: 5-10 min</bpmn:documentation>
        <bpmn:incoming>W666_Flow18</bpmn:incoming>
        <bpmn:outgoing>W666_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W666_Task7" name="Receiving Clerk unloads goods to staging area; performs visual inspection for…">
        <bpmn:documentation>Step 2: Receiving Clerk unloads goods to staging area; performs visual inspection for transit damage: crushed boxes, wet packaging, broken seals, dented containers; segregates damaged items
Responsible (R): Receiving Clerk
Accountable (A): Department Supervisor
Duration: 15-20 min</bpmn:documentation>
        <bpmn:incoming>W666_Flow19</bpmn:incoming>
        <bpmn:outgoing>W666_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W666_Task8" name="Receiving Clerk scans delivery receipt against transfer order or PO in ERP…">
        <bpmn:documentation>Step 3: Receiving Clerk scans delivery receipt against transfer order or PO in ERP using handheld device; system displays expected items with quantities
Responsible (R): Receiving Clerk
Accountable (A): Receiving Clerk
Duration: 5-10 min</bpmn:documentation>
        <bpmn:incoming>W666_Flow20</bpmn:incoming>
        <bpmn:outgoing>W666_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W666_Task9" name="Receiving Clerk performs count verification: scans barcode on each case/pallet…">
        <bpmn:documentation>Step 4: Receiving Clerk performs count verification: scans barcode on each case/pallet; for catch-weight items (lumber, wire, nails bulk), weighs or measures and records actual quantity; flags quantity variances &gt; 2% for Supervisor review
Responsible (R): Receiving Clerk
Accountable (A): Department Supervisor
Duration: 15-25 min</bpmn:documentation>
        <bpmn:incoming>W666_Flow21</bpmn:incoming>
        <bpmn:outgoing>W666_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W666_Task10" name="For designated AQL sampling items (per PUR-016), Receiving Clerk performs…">
        <bpmn:documentation>Step 5: For designated AQL sampling items (per PUR-016), Receiving Clerk performs quality inspection per sampling plan: visual quality, correct labeling and barcode readability, shelf-life/expiration date check for paint and chemicals
Responsible (R): Receiving Clerk
Accountable (A): Department Supervisor
Duration: 10-15 min</bpmn:documentation>
        <bpmn:incoming>W666_Flow22</bpmn:incoming>
        <bpmn:outgoing>W666_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W666_Task11" name="Receiving Clerk identifies discrepancies: quantity shortage, quality defects…">
        <bpmn:documentation>Step 6: Receiving Clerk identifies discrepancies: quantity shortage, quality defects, wrong items, missing labels; logs discrepancy with photo evidence in ERP
Responsible (R): Receiving Clerk
Accountable (A): Department Supervisor
Duration: 5-10 min</bpmn:documentation>
        <bpmn:incoming>W666_Flow23</bpmn:incoming>
        <bpmn:outgoing>W666_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W666_Task12" name="Department Supervisor reviews flagged items; approves or rejects delivery line…">
        <bpmn:documentation>Step 7: Department Supervisor reviews flagged items; approves or rejects delivery line items; for material discrepancies (&gt;₱5,000 or &gt; 10% shortage), escalates to Store Manager
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 5-10 min</bpmn:documentation>
        <bpmn:incoming>W666_Flow24</bpmn:incoming>
        <bpmn:outgoing>W666_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W666_Task13" name="Receiving Clerk completes goods receipt in ERP; accepted items automatically…">
        <bpmn:documentation>Step 8: Receiving Clerk completes goods receipt in ERP; accepted items automatically update store inventory; rejected items flagged for carrier claim or return-to-DC per W22B
Responsible (R): Receiving Clerk
Accountable (A): Receiving Clerk
Duration: 5-10 min</bpmn:documentation>
        <bpmn:incoming>W666_Flow25</bpmn:incoming>
        <bpmn:outgoing>W666_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W666_Task14" name="Stock Associate moves received goods to selling floor or backroom per planogram…">
        <bpmn:documentation>Step 9: Stock Associate moves received goods to selling floor or backroom per planogram location; system updates bin-level inventory
Responsible (R): Stock Associate
Accountable (A): Department Supervisor
Duration: 15-20 min</bpmn:documentation>
        <bpmn:incoming>W666_Flow26</bpmn:incoming>
        <bpmn:outgoing>W666_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W666_End15" name="Complete">
        <bpmn:incoming>W666_Flow27</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W666_Annotation16">
        <bpmn:text>Controls: - CTL-261 (ensure controlled execution — Store Receiving &amp; Replenishment (PA-07.3).) | - operational: Receiving Clerk review and approval gate
Owner: Receiving Clerk</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W666_Assoc17" sourceRef="W666_Annotation16" targetRef="W666_Start5" associationDirection="None" />
