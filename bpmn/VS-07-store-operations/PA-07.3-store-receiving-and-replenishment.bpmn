      <bpmn:sequenceFlow id="W18B_Flow17" sourceRef="W18B_Task8" targetRef="W18B_Task9" />
      <bpmn:sequenceFlow id="W18B_Flow18" sourceRef="W18B_Task9" targetRef="W18B_Task10" />
      <bpmn:sequenceFlow id="W18B_Flow19" sourceRef="W18B_Task10" targetRef="W18B_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W18B_diag">
      <bpmndi:BPMNPlane id="W18B_plane" bpmnElement="W_W18B">
        <bpmndi:BPMNShape id="W18B_Lane1_di" bpmnElement="W18B_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
