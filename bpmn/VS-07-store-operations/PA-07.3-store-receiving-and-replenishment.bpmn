    <bpmn:process id="W_W825" name="W825. Store-Level Bulky Item Delivery Proof Collection &amp; Documentation" isExecutable="false">
      <bpmn:documentation>Trigger: Customer purchases bulky items (lumber, cement, appliances, tiles in bulk) requiring delivery; delivery completed by store or 3PL
Frequency: Daily; ~5–10 bulky deliveries per store per week
Volume: 200 stores x 7.5 deliveries/week = ~1,500 bulky deliveries/week chain-wide; ~6,000/month
Owner: Receiving Clerk / Delivery Driver
Participants: Receiving Clerk, Delivery Driver, Customer, Store Manager (for escalations)
Source: workflow W825 — Store-Level Bulky Item Delivery Proof Collection &amp; Documentation</bpmn:documentation>
      <bpmn:laneSet id="W825_LaneSet4">
        <bpmn:lane id="W825_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W825_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W825_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W825_Lane2" name="Receiving Clerk">
        <bpmn:flowNodeRef>W825_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W825_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W825_Lane3" name="Delivery Driver">
        <bpmn:flowNodeRef>W825_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W825_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W825_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W825_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W825_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W825_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W825_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W825_Start5" name="Customer purchases bulky items (lumber, cement, appliances, tiles in bulk) requiring…">
        <bpmn:outgoing>W825_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W825_Task6" name="At POS purchase: Cashier creates delivery order per W5D — captures customer…">
        <bpmn:documentation>Step 1: At POS purchase: Cashier creates delivery order per W5D — captures customer delivery address, contact number, preferred delivery date/time window (AM 8-12 or PM 1-5), items to deliver, COD amount if applicable, special instructions (&quot;gate code: 1234&quot;, &quot;load to second floor via service elevator&quot;)
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W825_Flow18</bpmn:incoming>
        <bpmn:outgoing>W825_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W825_Task7" name="Receiving Clerk prepares delivery: (a) picks items from store stock per…">
        <bpmn:documentation>Step 2: Receiving Clerk prepares delivery: (a) picks items from store stock per delivery order pick list, (b) verifies items match delivery order — correct SKU, correct quantity, correct size/color for appliances, (c) loads onto delivery vehicle per W438 yard dispatch — proper securing for transport (strapping lumber bundles, wrapping appliances in protective blanket, stacking cement bags on pallets), (d) generates delivery trip sheet with all deliveries scheduled for this run
Responsible (R): Receiving Clerk
Accountable (A): Department Supervisor
Duration: 15 min per delivery</bpmn:documentation>
        <bpmn:incoming>W825_Flow19</bpmn:incoming>
        <bpmn:outgoing>W825_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W825_Task8" name="Delivery driver executes delivery: (a) follows route per delivery trip sheet…">
        <bpmn:documentation>Step 3: Delivery driver executes delivery: (a) follows route per delivery trip sheet, (b) navigates to customer address — Philippine addressing challenges (barangay-level directions, landmarks, informal settlements), (c) arrives at customer location, unloads items at customer-designated location (driveway, garage, ground floor, specified room if installation included per W138)
Responsible (R): Delivery Driver
Accountable (A): —
Duration: 30-90 min including drive</bpmn:documentation>
        <bpmn:incoming>W825_Flow20</bpmn:incoming>
        <bpmn:outgoing>W825_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W825_Task9" name="Proof of delivery collection">
        <bpmn:documentation>Step 4: Proof of delivery collection: (a) delivery driver presents delivery receipt to customer for signature — customer confirms items received in good condition, (b) customer notes any discrepancies or damage on delivery receipt (&quot;2 tiles chipped&quot;, &quot;wrong color appliance&quot;), (c) delivery driver takes photo of delivered items at customer location using mobile app — items in position, condition visible, customer location identifiable, (d) if COD: collects payment per POS multi-tender per W5B — cash or GCash/bank transfer per W99, issues receipt per W540 BIR-compliant receipt
Responsible (R): Delivery Driver
Accountable (A): Customer
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W825_Flow21</bpmn:incoming>
        <bpmn:outgoing>W825_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W825_Task10" name="Delivery driver returns to store: (a) submits signed delivery receipt and photo…">
        <bpmn:documentation>Step 5: Delivery driver returns to store: (a) submits signed delivery receipt and photo evidence to Receiving Clerk, (b) turns over COD cash collections to Cash Office per W541 cash handling — counted, verified, receipted, (c) reports any delivery exceptions (customer refusal, damage in transit, wrong address)
Responsible (R): Delivery Driver
Accountable (A): Receiving Clerk
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W825_Flow22</bpmn:incoming>
        <bpmn:outgoing>W825_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W825_Task11" name="Receiving Clerk processes proof of delivery: (a) scans signed delivery receipt…">
        <bpmn:documentation>Step 6: Receiving Clerk processes proof of delivery: (a) scans signed delivery receipt into ERP per W255 document storage — linked to original delivery order, (b) matches delivery order to proof of delivery — system validates all items delivered, quantities match, customer signature present, (c) closes delivery order in system — triggers inventory deduction from store stock and revenue recognition per W487, (d) if COD: reconciles cash collected against COD amount on delivery order per W89 bank reconciliation
Responsible (R): Receiving Clerk
Accountable (A): Store Manager
Duration: 5 min per POD</bpmn:documentation>
        <bpmn:incoming>W825_Flow23</bpmn:incoming>
        <bpmn:outgoing>W825_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W825_Task12" name="Exception handling — customer not at delivery address">
        <bpmn:documentation>Step 7: Exception handling — customer not at delivery address: (a) driver contacts customer via phone — reschedule if customer reachable within 30 min, (b) if customer unreachable: leave delivery attempt notice per W5D with rescheduling number, (c) return items to store — note on delivery trip sheet as &quot;failed delivery&quot;, (d) Receiving Clerk reschedules per W5D rescheduling rules (max 2 attempts, then cancellation)
Responsible (R): Delivery Driver / Receiving Clerk
Accountable (A): Store Manager
Duration: 15-30 min per exception</bpmn:documentation>
        <bpmn:incoming>W825_Flow24</bpmn:incoming>
        <bpmn:outgoing>W825_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W825_Task13" name="Exception handling — customer refuses delivery">
        <bpmn:documentation>Step 8: Exception handling — customer refuses delivery: (a) driver documents refusal reason on delivery receipt, (b) returns items to store, (c) Receiving Clerk initiates return per W12 returns — items restocked, delivery fee non-refundable per policy, (d) Store Manager reviews for pattern (customer repeatedly ordering and refusing)
Responsible (R): Delivery Driver / Receiving Clerk
Accountable (A): Store Manager
Duration: 20 min per exception</bpmn:documentation>
        <bpmn:incoming>W825_Flow25</bpmn:incoming>
        <bpmn:outgoing>W825_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W825_Task14" name="Exception handling — delivery damage">
        <bpmn:documentation>Step 9: Exception handling — delivery damage: (a) driver documents damage on delivery receipt and takes photos, (b) customer signs with damage notation, (c) Receiving Clerk processes per W91 damaged goods — insurance claim per W59 if applicable, replacement delivery scheduled, customer compensation per policy
Responsible (R): Delivery Driver / Receiving Clerk
Accountable (A): Store Manager
Duration: 30 min per incident</bpmn:documentation>
        <bpmn:incoming>W825_Flow26</bpmn:incoming>
        <bpmn:outgoing>W825_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W825_End15" name="Complete">
        <bpmn:incoming>W825_Flow27</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W825_Annotation16">
        <bpmn:text>Controls: - CTL-261 (ensure controlled execution — Store Receiving &amp; Replenishment (PA-07.3).) | - operational: confirmation call day before per W5D
Owner: Receiving Clerk / Delivery Driver</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W825_Assoc17" sourceRef="W825_Annotation16" targetRef="W825_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W825_Flow18" sourceRef="W825_Start5" targetRef="W825_Task6" />
