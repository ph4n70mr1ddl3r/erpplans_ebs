        <bpmndi:BPMNEdge id="W774_Flow15_di" bpmnElement="W774_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W774_Flow16_di" bpmnElement="W774_Flow16"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
