    <bpmn:process id="W_W577" name="W577. Store-Level Holiday Season (Ber Months) Operational Ramp-Up" isExecutable="false">
      <bpmn:documentation>Trigger: Annual seasonal planning calendar — T-8 weeks before September 1
Frequency: Annual (September–December), with mid-season checkpoints
Volume: All 200 stores; &quot;Ber months&quot; represent ~35–40% of annual revenue
Owner: VP Store Operations
Participants: VP Store Operations, Regional Managers, Store Managers, HR, Merchandising, LP, IT, Marketing
Source: workflow W577 — Store-Level Holiday Season (Ber Months) Operational Ramp-Up</bpmn:documentation>
      <bpmn:laneSet id="W577_LaneSet5">
        <bpmn:lane id="W577_Lane1" name="HR Manager">
        <bpmn:flowNodeRef>W577_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W577_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W577_Lane2" name="Supply Planning Manager">
        <bpmn:flowNodeRef>W577_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W577_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W577_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W577_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W577_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W577_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W577_Lane4" name="LP Director">
        <bpmn:flowNodeRef>W577_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W577_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W577_Start6" name="Annual seasonal planning calendar — T-8 weeks before September 1">
        <bpmn:outgoing>W577_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W577_Task7" name="T-8 weeks (early July)">
        <bpmn:documentation>Step 1: T-8 weeks (early July): HR prepares seasonal staffing plan per W555 — identify temp headcount needs per store (10–15% increase = ~580–870 seasonal workers across 200 stores); initiate recruitment
Responsible (R): HR Manager
Accountable (A): VP Store Operations
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W577_Flow17</bpmn:incoming>
        <bpmn:outgoing>W577_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W577_Task8" name="T-6 weeks (mid July)">
        <bpmn:documentation>Step 2: T-6 weeks (mid July): Merchandising and Supply Chain coordinate inventory build-up with DCs — seasonal SKUs pre-positioned, DC capacity allocated for peak outbound volumes
Responsible (R): Supply Planning Manager
Accountable (A): VP Merchandising
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W577_Flow18</bpmn:incoming>
        <bpmn:outgoing>W577_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W577_Task9" name="T-4 weeks (early August)">
        <bpmn:documentation>Step 3: T-4 weeks (early August): Store Managers prepare fixture/display expansion plan; identify seasonal display locations; submit extended operating hours request to LGU per regulatory requirements
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W577_Flow19</bpmn:incoming>
        <bpmn:outgoing>W577_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W577_Task10" name="T-2 weeks (mid August)">
        <bpmn:documentation>Step 4: T-2 weeks (mid August): LP adds additional shifts and increases CCTV coverage review frequency; IT pre-positions spare POS terminals and networking equipment for rapid deployment; promotional calendar finalized per W13
Responsible (R): LP Director / IT Manager
Accountable (A): VP Store Operations
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W577_Flow20</bpmn:incoming>
        <bpmn:outgoing>W577_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W577_Task11" name="T-1 week (late August)">
        <bpmn:documentation>Step 5: T-1 week (late August): dress rehearsal — Store Manager runs through peak-day simulation with full staffing; all promotional displays installed per W262; POS promo prices verified per W523
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 4 hours/store</bpmn:documentation>
        <bpmn:incoming>W577_Flow21</bpmn:incoming>
        <bpmn:outgoing>W577_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W577_Task12" name="In-season (Sept–Dec)">
        <bpmn:documentation>Step 6: In-season (Sept–Dec): daily flash sales report reviewed by Store Manager and Regional Manager; staffing flexed up/down based on daily traffic; bi-monthly sale events executed per promotional calendar
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W577_Flow22</bpmn:incoming>
        <bpmn:outgoing>W577_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W577_Task13" name="Post-season (early January)">
        <bpmn:documentation>Step 7: Post-season (early January): seasonal close-out review — sales vs. plan, staffing costs, LP incidents, inventory remaining; lessons learned documented for next year
Responsible (R): Store Manager
Accountable (A): VP Store Operations
Duration: 2 hours/store</bpmn:documentation>
        <bpmn:incoming>W577_Flow23</bpmn:incoming>
        <bpmn:outgoing>W577_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W577_End14" name="Complete">
        <bpmn:incoming>W577_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W577_Annotation15">
        <bpmn:text>Controls: - CTL-260 (ensure controlled execution — Store Facility &amp; Safety (PA-07.2).) | - operational: standardized 2-day onboarding program per W555 and W518; operational: advance scheduling and cross-dock flow for fast-moving seasonal items per W221; operational: mandatory rest day per DOLE Labor Code and overtime caps per HR-010
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W577_Assoc16" sourceRef="W577_Annotation15" targetRef="W577_Start6" associationDirection="None" />
