        <bpmndi:BPMNShape id="W5536_Task15_di" bpmnElement="W5536_Task15"><dc:Bounds x="1660" y="975" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5536_Start8_di" bpmnElement="W5536_Start8"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
