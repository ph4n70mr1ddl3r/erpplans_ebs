    <bpmn:process id="W_W503" name="W503. Store-Level Pest Control &amp; Sanitation Management" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled pest control service visit; pest incident reported by staff; monthly sanitation audit
Frequency: Monthly pest control service per store; ad-hoc pest incidents; monthly sanitation self-audit; quarterly deep sanitation
Volume: 200 stores × 12 monthly visits = 2,400 visits/year; ~50 pest incidents/month chain-wide
Owner: Store Manager
Participants: Maintenance/Utility Staff, Pest Control Vendor Technician, Facilities Coordinator, Safety Officer
Source: workflow W503 — Store-Level Pest Control &amp; Sanitation Management</bpmn:documentation>
      <bpmn:laneSet id="W503_LaneSet6">
        <bpmn:lane id="W503_Lane1" name="Vendor Technician">
        <bpmn:flowNodeRef>W503_Task8</bpmn:flowNodeRef>
