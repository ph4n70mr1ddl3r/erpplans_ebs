    <bpmn:process id="W_W743" name="W743. Store-Level Daily Cleaning &amp; Sanitation Checklist Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Store opening preparation (W5A) and store closing (W5F)
Frequency: Twice daily (pre-opening and post-closing)
Volume: 200 stores × 2 checklist executions/day
Owner: Department Supervisor
Participants: Floor Associates, Maintenance Associate, Janitorial Staff
Source: workflow W743 — Store-Level Daily Cleaning &amp; Sanitation Checklist Execution</bpmn:documentation>
      <bpmn:laneSet id="W743_LaneSet6">
        <bpmn:lane id="W743_Lane1" name="Department Supervisor">
        <bpmn:flowNodeRef>W743_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W743_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W743_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W743_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W743_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W743_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W743_Lane3" name="Janitorial Staff">
        <bpmn:flowNodeRef>W743_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W743_Lane4" name="Maintenance Associate">
        <bpmn:flowNodeRef>W743_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W743_Lane5" name="System">
        <bpmn:flowNodeRef>W743_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W743_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W743_Start7" name="Store opening preparation (W5A) and store closing (W5F)">
        <bpmn:outgoing>W743_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W743_Task8" name="Pre-opening cleaning verification — Before store opens (W5A), Department…">
        <bpmn:documentation>Step 1: Pre-opening cleaning verification — Before store opens (W5A), Department Supervisors verify overnight cleaning completion per zone: sales floor swept/mopped, restrooms cleaned and stocked, entrance glass cleaned, checkout counters sanitized, trash bins emptied
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W743_Flow18</bpmn:incoming>
        <bpmn:outgoing>W743_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W743_Task9" name="Zone-by-zone checklist completion — Each Department Supervisor completes mobile…">
        <bpmn:documentation>Step 2: Zone-by-zone checklist completion — Each Department Supervisor completes mobile checklist for their zone (10–15 items per zone: floor condition, shelf dust, display cleanliness, signage condition, lighting cleanliness, spill kit availability)
Responsible (R): Department Supervisor
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W743_Flow19</bpmn:incoming>
        <bpmn:outgoing>W743_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W743_Task10" name="Failed item remediation — Any failed checklist items trigger immediate…">
        <bpmn:documentation>Step 3: Failed item remediation — Any failed checklist items trigger immediate remediation task; assign to janitorial staff or floor associate
Responsible (R): Department Supervisor
Accountable (A): Department Supervisor
Duration: 5–15 min</bpmn:documentation>
        <bpmn:incoming>W743_Flow20</bpmn:incoming>
        <bpmn:outgoing>W743_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W743_Task11" name="Mid-day spot check — Store Manager or Assistant Store Manager conducts random…">
        <bpmn:documentation>Step 4: Mid-day spot check — Store Manager or Assistant Store Manager conducts random spot check of 3–5 zones; logs observations
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W743_Flow21</bpmn:incoming>
        <bpmn:outgoing>W743_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W743_Task12" name="Post-closing deep clean — After store closes (W5F), janitorial staff executes…">
        <bpmn:documentation>Step 5: Post-closing deep clean — After store closes (W5F), janitorial staff executes deep clean per zone: floor mopping/polishing, restroom sanitization, break room cleaning, stockroom sweeping, outdoor area cleanup
Responsible (R): Janitorial Staff
Accountable (A): Department Supervisor
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W743_Flow22</bpmn:incoming>
        <bpmn:outgoing>W743_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W743_Task13" name="Chemical inventory management — Track cleaning chemical usage and inventory…">
        <bpmn:documentation>Step 6: Chemical inventory management — Track cleaning chemical usage and inventory; reorder trigger when below 2-week supply; ensure MSDS (W698) available for all chemicals
Responsible (R): Maintenance Associate
Accountable (A): Store Manager
Duration: 15 min/week</bpmn:documentation>
        <bpmn:incoming>W743_Flow23</bpmn:incoming>
        <bpmn:outgoing>W743_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W743_Task14" name="Monthly sanitation compliance report — System compiles daily checklist…">
        <bpmn:documentation>Step 7: Monthly sanitation compliance report — System compiles daily checklist completion rates and failed items per store; Regional Manager reviews for chronic issues
Responsible (R): System / Regional Manager
Accountable (A): Regional Manager
Duration: Automated + 1 hour review</bpmn:documentation>
        <bpmn:incoming>W743_Flow24</bpmn:incoming>
        <bpmn:outgoing>W743_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W743_End15" name="Complete">
        <bpmn:incoming>W743_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W743_Annotation16">
        <bpmn:text>Controls: - CTL-260 (ensure controlled execution — Store Facility &amp; Safety (PA-07.2).) | - operational: Department Supervisor review and approval gate
Owner: Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
