      <bpmn:sequenceFlow id="W1505_Flow24" sourceRef="W1505_Task11" targetRef="W1505_Task12" />
      <bpmn:sequenceFlow id="W1505_Flow25" sourceRef="W1505_Task12" targetRef="W1505_Task13" />
      <bpmn:sequenceFlow id="W1505_Flow26" sourceRef="W1505_Task13" targetRef="W1505_Task14" />
      <bpmn:sequenceFlow id="W1505_Flow27" sourceRef="W1505_Task14" targetRef="W1505_Task15" />
      <bpmn:sequenceFlow id="W1505_Flow28" sourceRef="W1505_Task15" targetRef="W1505_End16" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1505_diag">
      <bpmndi:BPMNPlane id="W1505_plane" bpmnElement="W_W1505">
        <bpmndi:BPMNShape id="W1505_Lane1_di" bpmnElement="W1505_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2210" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1505_Lane2_di" bpmnElement="W1505_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="2210" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1505_Lane3_di" bpmnElement="W1505_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="2210" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1505_Lane4_di" bpmnElement="W1505_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="2210" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1505_Task7_di" bpmnElement="W1505_Task7"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1505_Task8_di" bpmnElement="W1505_Task8"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1505_Task9_di" bpmnElement="W1505_Task9"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1505_Task10_di" bpmnElement="W1505_Task10"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1505_Task11_di" bpmnElement="W1505_Task11"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1505_Task12_di" bpmnElement="W1505_Task12"><dc:Bounds x="1450" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1505_Task13_di" bpmnElement="W1505_Task13"><dc:Bounds x="1660" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1505_Task14_di" bpmnElement="W1505_Task14"><dc:Bounds x="1870" y="465" width="180" height="80" /></bpmndi:BPMNShape>
