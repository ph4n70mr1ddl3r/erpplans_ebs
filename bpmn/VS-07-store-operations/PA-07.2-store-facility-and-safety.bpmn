      <bpmn:sequenceFlow id="W471_Flow20" sourceRef="W471_Task7" targetRef="W471_Task8" />
      <bpmn:sequenceFlow id="W471_Flow21" sourceRef="W471_Task8" targetRef="W471_Task9" />
      <bpmn:sequenceFlow id="W471_Flow22" sourceRef="W471_Task9" targetRef="W471_Task10" />
      <bpmn:sequenceFlow id="W471_Flow23" sourceRef="W471_Task10" targetRef="W471_Task11" />
      <bpmn:sequenceFlow id="W471_Flow24" sourceRef="W471_Task11" targetRef="W471_Task12" />
      <bpmn:sequenceFlow id="W471_Flow25" sourceRef="W471_Task12" targetRef="W471_Task13" />
      <bpmn:sequenceFlow id="W471_Flow26" sourceRef="W471_Task13" targetRef="W471_End14" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W471_diag">
