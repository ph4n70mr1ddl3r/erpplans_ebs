    <bpmn:process id="W_W720" name="W720. Store-Level Daily Safety Briefing &amp; Toolbox Talk" isExecutable="false">
      <bpmn:documentation>Trigger: Start of each store operating day
Frequency: Daily (all 200 stores)
Volume: 200 daily safety briefings (~5–10 min each)
Owner: Store Manager
Participants: All on-shift store staff (~15–20 per shift), Department Supervisors
Source: workflow W720 — Store-Level Daily Safety Briefing &amp; Toolbox Talk</bpmn:documentation>
      <bpmn:laneSet id="W720_LaneSet4">
        <bpmn:lane id="W720_Lane1" name="System">
        <bpmn:flowNodeRef>W720_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W720_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W720_Lane2" name="Department Supervisor">
        <bpmn:flowNodeRef>W720_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W720_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W720_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W720_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W720_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W720_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W720_Start5" name="Start of each store operating day">
        <bpmn:outgoing>W720_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W720_Task6" name="Topic selection">
        <bpmn:documentation>Step 1: Topic selection: system auto-selects daily safety topic from rotating 30-day calendar: (a) topics rotate through: hazmat handling per W237, ladder safety, manual lifting techniques, forklift/yard safety per W438, fire safety per W582, electrical safety, slip/trip/fall prevention, customer area safety, PPE compliance per W172, emergency procedures per W330, heat stress (summer), typhoon preparedness per W576, cash handling safety, robbery response per W717, first aid awareness per W501; (b) Store Manager can override with store-specific topic if recent incident warrants; (c) system provides 1-page briefing card with key talking points
Responsible (R): System / Store Manager
Accountable (A): Store Manager
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W720_Flow14</bpmn:incoming>
        <bpmn:outgoing>W720_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W720_Task7" name="Team gathering">
        <bpmn:documentation>Step 2: Team gathering: at start of shift (or shift changeover), Department Supervisors gather their teams: (a) all on-shift employees in each department assemble; (b) Store Manager rotates between departments for daily briefing or holds single all-staff briefing before store opening per W5A; (c) briefing conducted at department workstation or break area
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W720_Flow15</bpmn:incoming>
        <bpmn:outgoing>W720_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W720_Task8" name="Briefing delivery">
        <bpmn:documentation>Step 3: Briefing delivery: Store Manager or Department Supervisor delivers briefing: (a) present today&#x27;s safety topic (2-3 key points from briefing card); (b) highlight any store-specific hazards observed: wet floor in lumber yard, damaged racking in backroom, broken exterior light; (c) review any incidents from previous day (without naming individuals): what happened, what was the corrective action, what to watch for; (d) remind staff of any active safety alerts: product recall per W29, construction near store entrance, seasonal weather warning per W576; (e) ask if anyone has safety concerns to report per W559
Responsible (R): Store Manager / Dept Supervisor
Accountable (A): Store Manager
Duration: 5-7 min</bpmn:documentation>
        <bpmn:incoming>W720_Flow16</bpmn:incoming>
        <bpmn:outgoing>W720_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W720_Task9" name="Attendance and documentation">
        <bpmn:documentation>Step 4: Attendance and documentation: (a) Department Supervisor records attendance (verbal roll call or badge scan); (b) system logs: date, time, department, topic, number of attendees, Store Manager name; (c) employees who missed briefing (late arrival, day off) receive topic via mobile app notification; (d) system tracks completion rate: target 95% of on-shift employees attend daily
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W720_Flow17</bpmn:incoming>
        <bpmn:outgoing>W720_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W720_Task10" name="Monthly effectiveness review">
        <bpmn:documentation>Step 5: Monthly effectiveness review: Store Manager reviews monthly safety briefing metrics: (a) attendance rate by department and day; (b) topic coverage: all 30 topics covered in rotation?; (c) correlation with incident trends: did briefing on a topic precede reduction in related incidents?; (d) employee feedback: any topics requested for addition?; (e) report included in monthly store performance review per W575
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W720_Flow18</bpmn:incoming>
        <bpmn:outgoing>W720_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W720_End11" name="Complete">
        <bpmn:incoming>W720_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W720_Annotation12">
        <bpmn:text>Controls: - CTL-260 (ensure controlled execution — Store Facility &amp; Safety (PA-07.2).) | - operational: rotating 30 topics, incorporating real store incidents, and varying delivery format (discussion, demonstration, video); operational: mobile app topic delivery and requiring missed-topic acknowledgment
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W720_Assoc13" sourceRef="W720_Annotation12" targetRef="W720_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W720_Flow14" sourceRef="W720_Start5" targetRef="W720_Task6" />
      <bpmn:sequenceFlow id="W720_Flow15" sourceRef="W720_Task6" targetRef="W720_Task7" />
      <bpmn:sequenceFlow id="W720_Flow16" sourceRef="W720_Task7" targetRef="W720_Task8" />
      <bpmn:sequenceFlow id="W720_Flow17" sourceRef="W720_Task8" targetRef="W720_Task9" />
      <bpmn:sequenceFlow id="W720_Flow18" sourceRef="W720_Task9" targetRef="W720_Task10" />
      <bpmn:sequenceFlow id="W720_Flow19" sourceRef="W720_Task10" targetRef="W720_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W720_diag">
      <bpmndi:BPMNPlane id="W720_plane" bpmnElement="W_W720">
        <bpmndi:BPMNShape id="W720_Lane1_di" bpmnElement="W720_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
