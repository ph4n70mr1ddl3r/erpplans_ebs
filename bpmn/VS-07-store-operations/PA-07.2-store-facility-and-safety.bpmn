        <bpmndi:BPMNEdge id="W1119_Flow20_di" bpmnElement="W1119_Flow20"><di:waypoint x="1420" y="335" /><di:waypoint x="1470" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1119_Assoc14_di" bpmnElement="W1119_Assoc14"><di:waypoint x="340" y="800" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1125" name="W1125. Store-Level Seasonal Typhoon Pre-Positioning &amp; Emergency Stock Buffer Management" isExecutable="false">
      <bpmn:documentation>Trigger: PAGASA typhoon warning Signal No. 1 or above, or annual rainy season preparedness directive (June 1 activation), or supply chain disruption alert from HQ
Frequency: Annual full activation (June); targeted activation ~20 times/year during typhoon events
Volume: 200 stores × pre-positioned emergency SKU list (~50–80 items per store)
Owner: Store Manager
Participants: Store Manager, Department Supervisors, Supply Chain Planning Team (HQ), DC Operations
Source: workflow W1125 — Store-Level Seasonal Typhoon Pre-Positioning &amp; Emergency Stock Buffer Management</bpmn:documentation>
      <bpmn:laneSet id="W1125_LaneSet4">
        <bpmn:lane id="W1125_Lane1" name="Supply Chain Planner">
        <bpmn:flowNodeRef>W1125_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1125_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1125_Lane2" name="DC Operations">
        <bpmn:flowNodeRef>W1125_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1125_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W1125_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1125_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1125_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1125_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1125_Start5" name="PAGASA typhoon warning Signal No. 1 or above, or annual rainy season preparedness…">
        <bpmn:outgoing>W1125_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1125_Task6" name="Annual Emergency SKU List Review &amp; Buffer Quantity Setting">
        <bpmn:documentation>Step 1: Annual Emergency SKU List Review &amp; Buffer Quantity Setting: (a) In May each year, Supply Chain Planning Team reviews emergency SKU list based on prior year typhoon sales data, new product additions, and regional demand patterns; (b) each store receives a customized list based on regional typhoon risk (Mindanao: moderate, Visayas: high, Luzon/NCR: high, Bicol: very high); (c) buffer quantities set at 2–3× normal weekly demand for the top 50–80 emergency SKUs; (d) total buffer investment per store: ~PHP 300,000–500,000 (~PHP 60M–100M chain-wide); (e) buffer quantities loaded into ERP as seasonal safety stock override
Responsible (R): Supply Chain Planner
Accountable (A): VP Supply Chain
Duration: 2–3 days (annual)</bpmn:documentation>
        <bpmn:incoming>W1125_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1125_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1125_Task7" name="Pre-Season Buffer Build-Up">
        <bpmn:documentation>Step 2: Pre-Season Buffer Build-Up: (a) starting June 1, DCs prioritize emergency SKU replenishment to bring all stores to buffer levels before peak typhoon season; (b) stores receive weekly emergency SKU deliveries in addition to regular replenishment; (c) store receiving clerk segregates emergency buffer stock in designated backroom area with clear labeling (&quot;Typhoon Emergency Buffer — Do Not Pick for Regular Sales&quot;); (d) buffer stock tracked separately in ERP with &quot;emergency reserve&quot; inventory status
Responsible (R): DC Operations / Receiving Clerk
Accountable (A): Store Manager
Duration: Ongoing (June)</bpmn:documentation>
        <bpmn:incoming>W1125_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1125_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1125_Task8" name="Typhoon Event Activation">
        <bpmn:documentation>Step 3: Typhoon Event Activation: (a) when PAGASA raises Signal No. 1 or above in store&#x27;s region, Store Manager activates emergency protocol; (b) emergency buffer stock released from reserve status to available inventory; (c) emergency items moved to prominent front-of-store display area (near entrance); (d) POS system applies regular pricing (no price gouging per DTI Price Act RA 7581 compliance W468); (e) Store Manager requests emergency replenishment from DC via priority order (bypass normal replenishment lead time); (f) customer purchase limits may be imposed for critical items (e.g., max 5 tarpaulins per customer) to prevent hoarding
Responsible (R): Store Manager / Stock Associates
Accountable (A): Store Manager
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W1125_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1125_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1125_Task9" name="Post-Typhoon Replenishment &amp; Buffer Restoration">
        <bpmn:documentation>Step 4: Post-Typhoon Replenishment &amp; Buffer Restoration: (a) after typhoon passes and store reopens (per W850), Store Manager conducts emergency inventory count of typhoon SKUs; (b) system generates emergency replenishment order to restore buffer to pre-event levels; (c) DC prioritizes emergency replenishment shipments (24–48 hour delivery SLA vs. normal 2–3 days); (d) if DC stock insufficient, Supply Chain team activates emergency procurement (W60) and alternative vendor sourcing (W921); (e) post-typhoon sales data analyzed for buffer quantity adjustment (increase high-demand items, reduce low-demand items)
Responsible (R): Store Manager / Supply Chain Planner
Accountable (A): VP Supply Chain
Duration: 1–2 days post-event</bpmn:documentation>
        <bpmn:incoming>W1125_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1125_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1125_Task10" name="Seasonal Wind-Down &amp; Buffer Liquidation">
        <bpmn:documentation>Step 5: Seasonal Wind-Down &amp; Buffer Liquidation: (a) in December (end of typhoon season), remaining emergency buffer stock reviewed; (b) items that are regular sellers (cement, plywood, nails) returned to normal inventory status; (c) typhoon-specific items (extra-large tarps, sandbags, emergency sheeting) either: retained at reduced buffer level for year-round standby, or liquidated via seasonal clearance (W93); (d) buffer performance report generated: stockout frequency, sales uplift, buffer utilization rate, carrying cost vs. revenue benefit
Responsible (R): Store Manager / Supply Chain Planner
Accountable (A): VP Supply Chain
Duration: 1 day (December)</bpmn:documentation>
        <bpmn:incoming>W1125_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1125_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1125_End11" name="Complete">
        <bpmn:incoming>W1125_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1125_Annotation12">
        <bpmn:text>Controls: - CTL-260 (ensure controlled execution — Store Facility &amp; Safety (PA-07.2).) | - operational: purchase-limit/price-freeze configuration changes logged with dual approval before deployment
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1125_Assoc13" sourceRef="W1125_Annotation12" targetRef="W1125_Start5" associationDirection="None" />
