        <bpmndi:BPMNShape id="W1023_Task10_di" bpmnElement="W1023_Task10"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1023_Task11_di" bpmnElement="W1023_Task11"><dc:Bounds x="1240" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1023_Task12_di" bpmnElement="W1023_Task12"><dc:Bounds x="1450" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1023_Start6_di" bpmnElement="W1023_Start6"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1023_End13_di" bpmnElement="W1023_End13"><dc:Bounds x="1680" y="657" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1023_Annotation14_di" bpmnElement="W1023_Annotation14"><dc:Bounds x="160" y="800" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1023_Flow16_di" bpmnElement="W1023_Flow16"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1023_Flow17_di" bpmnElement="W1023_Flow17"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1023_Flow18_di" bpmnElement="W1023_Flow18"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1023_Flow19_di" bpmnElement="W1023_Flow19"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1023_Flow20_di" bpmnElement="W1023_Flow20"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1023_Flow21_di" bpmnElement="W1023_Flow21"><di:waypoint x="1420" y="675" /><di:waypoint x="1450" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1023_Flow22_di" bpmnElement="W1023_Flow22"><di:waypoint x="1630" y="165" /><di:waypoint x="1680" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1023_Assoc15_di" bpmnElement="W1023_Assoc15"><di:waypoint x="340" y="800" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
