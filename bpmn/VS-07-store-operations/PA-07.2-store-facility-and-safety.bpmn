      <bpmndi:BPMNPlane id="W1119_plane" bpmnElement="W_W1119">
        <bpmndi:BPMNShape id="W1119_Lane1_di" bpmnElement="W1119_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
