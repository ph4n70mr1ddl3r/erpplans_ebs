      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W330" name="W330. In-Store Emergency Response Protocol" isExecutable="false">
      <bpmn:documentation>Trigger: Any emergency event occurring within the store premises that threatens the safety of customers, staff, or the public — including fire, medical emergency, structural failure (e.g., racking collapse, roof leak), bomb threat, civil disturbance, chemical spill (in-store), or severe weather while customers are present
Frequency: Rare; hopefully &lt; 1 actual emergency per store per year; drills conducted quarterly per W158
Volume: 200 stores × ~467 customers/day + 29 staff/store = ~99,000+ people on premises per operating day chain-wide
Owner: Store Manager (immediate response); Facilities Coordinator (post-incident coordination)
Participants: Store Manager, all store staff, Security Guard, Facilities Coordinator, Loss Prevention Officer, HR, Legal, local emergency services (PNP, BFP, EMS)
Source: workflow W330 — In-Store Emergency Response Protocol</bpmn:documentation>
      <bpmn:laneSet id="W330_LaneSet8">
        <bpmn:lane id="W330_Lane1" name="Staff Member">
        <bpmn:flowNodeRef>W330_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W330_Start9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W330_Lane2" name="Trained Staff">
        <bpmn:flowNodeRef>W330_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W330_Lane3" name="All Staff">
        <bpmn:flowNodeRef>W330_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W330_Lane4" name="Store Manager">
        <bpmn:flowNodeRef>W330_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W330_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W330_Task17</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W330_Lane5" name="Dept. Supervisor">
        <bpmn:flowNodeRef>W330_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W330_Lane6" name="Emergency Services">
        <bpmn:flowNodeRef>W330_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W330_Lane7" name="Facilities Coordinator">
        <bpmn:flowNodeRef>W330_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W330_Task19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W330_End20</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W330_Start9" name="Any emergency event occurring within the store premises that threatens the safety of…">
        <bpmn:outgoing>W330_Flow23</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W330_Task10" name="Emergency detection and assessment">
        <bpmn:documentation>Step 1: Emergency detection and assessment: First staff member to identify the emergency announces the situation to Store Manager (via radio or PA system); Store Manager classifies: (a) Minor — localized, contained, no evacuation needed (e.g., small spill, minor medical issue), (b) Major — threatens multiple areas, requires evacuation (e.g., fire, structural failure, bomb threat, chemical release), (c) Life-threatening — immediate danger to life, requires immediate evacuation and emergency services (e.g., large fire, active threat)
Responsible (R): Staff Member / Store Manager
Accountable (A): Store Manager
Duration: &lt; 1 min</bpmn:documentation>
        <bpmn:incoming>W330_Flow23</bpmn:incoming>
        <bpmn:outgoing>W330_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W330_Task11" name="Minor emergency response">
        <bpmn:documentation>Step 2: Minor emergency response: Store Manager dispatches trained first responder (at least 2 staff per store hold first aid/CPR certification): (a) Medical: first aid administered, customer/staff offered ambulance transport if needed, incident logged per W140 adapted for customer context, (b) Spill: hazmat spill kit deployed, area cordoned, cleanup per W238 adapted for retail quantities, (c) Structural: area evacuated internally, Facilities Coordinator contacted for W47 emergency work order
Responsible (R): Trained Staff / Store Manager
Accountable (A): Store Manager
Duration: 15–60 min</bpmn:documentation>
        <bpmn:incoming>W330_Flow24</bpmn:incoming>
        <bpmn:outgoing>W330_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W330_Task12" name="Major/Life-threatening — Evacuation">
        <bpmn:documentation>Step 3: Major/Life-threatening — Evacuation: Store Manager activates store PA evacuation announcement (pre-recorded in English and Filipino); assigns staff to evacuation duties: (a) Floor marshals guide customers to nearest emergency exit (minimum 2 exits per store per BFP Fire Code), (b) Receiving dock staff secures dock doors and assists backroom evacuation, (c) Security guard manages main entrance — prevents new customers from entering, assists mobility-impaired customers, (d) Lumber yard/outdoor area staff guide customers to outdoor assembly point; headcount conducted at assembly point
Responsible (R): All Staff
Accountable (A): Store Manager
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W330_Flow25</bpmn:incoming>
        <bpmn:outgoing>W330_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W330_Task13" name="Emergency services notification">
        <bpmn:documentation>Step 4: Emergency services notification: Store Manager (or designated backup) contacts: (a) BFP (Bureau of Fire Protection) for fire/structural: 911 or local fire station, (b) EMS for medical emergency: local hospital ambulance, (c) PNP for security threat/civil disturbance: nearest police station; Store Manager provides: store address, nature of emergency, estimated number of persons, known injuries, hazardous materials present (paint, solvents)
Responsible (R): Store Manager / Security Guard
Accountable (A): Store Manager
Duration: 2–3 min</bpmn:documentation>
        <bpmn:incoming>W330_Flow26</bpmn:incoming>
        <bpmn:outgoing>W330_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W330_Task14" name="Headcount and missing persons">
        <bpmn:documentation>Step 5: Headcount and missing persons: At assembly point, Department Supervisors conduct staff headcount against shift schedule (W34); Store Manager accounts for all on-duty staff; if anyone missing: (a) do NOT re-enter building, (b) inform arriving emergency services of missing person&#x27;s last known location, (c) emergency services conduct search and rescue; for customers: Store Manager makes PA announcement asking customers to check their companions
Responsible (R): Dept. Supervisor / Store Manager
Accountable (A): Store Manager
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W330_Flow27</bpmn:incoming>
        <bpmn:outgoing>W330_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W330_Task15" name="Incident command">
        <bpmn:documentation>Step 6: Incident command: Store Manager serves as Incident Commander until emergency services arrive; upon arrival, transfers command to senior emergency services officer; Store Manager provides: building layout, hazmat locations, utility shutoff locations, number of occupants, known injuries
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: Until relieved</bpmn:documentation>
        <bpmn:incoming>W330_Flow28</bpmn:incoming>
        <bpmn:outgoing>W330_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W330_Task16" name="All-clear and re-entry">
        <bpmn:documentation>Step 7: All-clear and re-entry: Only emergency services officer gives all-clear; Store Manager: (a) inspects store for safety before allowing re-entry, (b) if store is unsafe: closes store per W45 emergency closure provisions, (c) if safe: allows staff and customers to return, resumes operations
Responsible (R): Emergency Services / Store Manager
Accountable (A): Store Manager
Duration: Varies</bpmn:documentation>
        <bpmn:incoming>W330_Flow29</bpmn:incoming>
        <bpmn:outgoing>W330_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W330_Task17" name="Incident reporting">
        <bpmn:documentation>Step 8: Incident reporting: Within 2 hours of incident: Store Manager files incident report in system: (a) time, location, nature of emergency, (b) number of persons affected, injuries, property damage, (c) response actions taken, (d) root cause (if known); Facilities Coordinator and HR notified; within 24 hours: Facilities Coordinator files regulatory report to BFP (if fire), DOLE (if employee injury per W140), LGU (if public safety incident)
Responsible (R): Store Manager / Facilities Coordinator
Accountable (A): VP Store Operations
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W330_Flow30</bpmn:incoming>
        <bpmn:outgoing>W330_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W330_Task18" name="Post-incident actions">
        <bpmn:documentation>Step 9: Post-incident actions: (a) Facilities Coordinator arranges cleanup, repair, or temporary closure per W47, (b) HR initiates Critical Incident Stress Debriefing for affected staff, (c) Legal reviews incident for liability exposure and insurance claim per W59/W285, (d) Loss Prevention Officer investigates cause for prevention (W37), (e) VP Store Operations issues lessons-learned bulletin to all stores within 1 week
Responsible (R): Facilities Coordinator / HR / Legal / LPO
Accountable (A): VP Store Operations
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W330_Flow31</bpmn:incoming>
        <bpmn:outgoing>W330_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W330_Task19" name="Quarterly drill">
        <bpmn:documentation>Step 10: Quarterly drill: Facilities Coordinator schedules and coordinates quarterly emergency evacuation drill per W158 (BC drill); drill includes: evacuation timing target (&lt; 5 minutes for full store evacuation), headcount accuracy verification, emergency equipment testing (fire extinguishers, alarms, emergency lighting, first aid kits), post-drill debrief with improvement actions
Responsible (R): Facilities Coordinator / Store Manager
Accountable (A): VP Store Operations
Duration: 1 hour/quarter/store</bpmn:documentation>
        <bpmn:incoming>W330_Flow32</bpmn:incoming>
        <bpmn:outgoing>W330_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W330_End20" name="Complete">
        <bpmn:incoming>W330_Flow33</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W330_Annotation21">
        <bpmn:text>Controls: - CTL-260 (ensure controlled execution — Store Facility &amp; Safety (PA-07.2).) | - operational: Store Manager (immediate response); Facilities Coordinator (post-incident coordination) review and approval gate
Owner: Store Manager (immediate response); Facilities Coordinator (post-incident coordination)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W330_Assoc22" sourceRef="W330_Annotation21" targetRef="W330_Start9" associationDirection="None" />
      <bpmn:sequenceFlow id="W330_Flow23" sourceRef="W330_Start9" targetRef="W330_Task10" />
      <bpmn:sequenceFlow id="W330_Flow24" sourceRef="W330_Task10" targetRef="W330_Task11" />
      <bpmn:sequenceFlow id="W330_Flow25" sourceRef="W330_Task11" targetRef="W330_Task12" />
      <bpmn:sequenceFlow id="W330_Flow26" sourceRef="W330_Task12" targetRef="W330_Task13" />
      <bpmn:sequenceFlow id="W330_Flow27" sourceRef="W330_Task13" targetRef="W330_Task14" />
      <bpmn:sequenceFlow id="W330_Flow28" sourceRef="W330_Task14" targetRef="W330_Task15" />
      <bpmn:sequenceFlow id="W330_Flow29" sourceRef="W330_Task15" targetRef="W330_Task16" />
      <bpmn:sequenceFlow id="W330_Flow30" sourceRef="W330_Task16" targetRef="W330_Task17" />
      <bpmn:sequenceFlow id="W330_Flow31" sourceRef="W330_Task17" targetRef="W330_Task18" />
      <bpmn:sequenceFlow id="W330_Flow32" sourceRef="W330_Task18" targetRef="W330_Task19" />
      <bpmn:sequenceFlow id="W330_Flow33" sourceRef="W330_Task19" targetRef="W330_End20" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W330_diag">
