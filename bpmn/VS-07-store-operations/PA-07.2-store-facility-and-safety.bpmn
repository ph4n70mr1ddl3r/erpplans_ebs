    <bpmn:process id="W_W1103" name="W1103. Store-Level Outdoor Lumber Yard Rain Protection &amp; Inventory Preservation" isExecutable="false">
      <bpmn:documentation>Trigger: Philippine Weather Bureau (PAGASA) weather advisory, approaching typhoon signal, daily rainy season protocol activation (June–November), or routine daily tarp deployment schedule
Frequency: Daily during rainy season (June–November, ~180 days); as-needed during dry season (~30 events)
Volume: 1 lumber yard per store × 200 stores = 200 daily activations during rainy season
Owner: Receiving Clerk / Stock Associate (Lumber Yard)
Participants: Stock Associate (Lumber Yard), Department Supervisor (Lumber &amp; Building Materials), Store Manager
Source: workflow W1103 — Store-Level Outdoor Lumber Yard Rain Protection &amp; Inventory Preservation</bpmn:documentation>
      <bpmn:laneSet id="W1103_LaneSet2">
        <bpmn:lane id="W1103_Lane1" name="Stock Associate">
        <bpmn:flowNodeRef>W1103_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1103_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1103_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1103_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1103_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1103_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1103_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1103_Start3" name="Philippine Weather Bureau (PAGASA) weather advisory, approaching typhoon signal, daily…">
        <bpmn:outgoing>W1103_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1103_Task4" name="Daily Weather Check &amp; Protection Decision">
        <bpmn:documentation>Step 1: Daily Weather Check &amp; Protection Decision: At 6:00 AM (before yard opening), Stock Associate checks: (a) PAGASA 24-hour weather forecast via mobile app integration in store manager dashboard; (b) current conditions at store location; (c) rainy season daily protocol requires full tarp deployment regardless of morning weather (June–November); (d) dry season: deploy only if &gt;40% rain probability; (e) typhoon signal raised: activate W576 full emergency protocol in addition to yard protection
Responsible (R): Stock Associate
Accountable (A): Department Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1103_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1103_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1103_Task5" name="Tarp &amp; Cover Deployment">
        <bpmn:documentation>Step 2: Tarp &amp; Cover Deployment: Stock Associate deploys protection: (a) heavy-duty woven polyethylene tarps (6m × 10m, UV-treated, replace annually) placed over exposed lumber stacks; (b) tarps secured with bungee cords and concrete blocks at corners; (c) cement bags covered with plastic sheeting or moved under covered area; (d) plywood stacks covered on top and sides facing prevailing wind direction; (e) steel rebar bundles do not require covering but should be elevated on dunnage (wooden pallets/blocks) to prevent ground moisture wicking; (f) roofing GI sheets checked for proper stacking (flat, not leaning) to prevent wind damage and water pooling
Responsible (R): Stock Associate
Accountable (A): Department Supervisor
Duration: 20–30 min</bpmn:documentation>
        <bpmn:incoming>W1103_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1103_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1103_Task6" name="Post-Rain Inspection &amp; Damage Assessment">
        <bpmn:documentation>Step 3: Post-Rain Inspection &amp; Damage Assessment: After rain event: (a) remove tarps and inspect lumber for water absorption (surface wet vs. penetrated); (b) separate any warped, swollen, or water-stained pieces; (c) wet lumber stacked with spacers (stickers) between layers for air drying; (d) water-damaged cement bags inspected — hardened lumps mean bag is unsellable and must be dispositioned per W91 (damaged goods); (e) damaged pieces tagged with markdown label per W549 (damaged/open-box item processing); (f) system inventory adjustment initiated per W92 if product is unsalvageable
Responsible (R): Stock Associate
Accountable (A): Department Supervisor
Duration: 15–20 min</bpmn:documentation>
        <bpmn:incoming>W1103_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1103_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1103_Task7" name="Inventory Damage Reporting &amp; Markdown">
        <bpmn:documentation>Step 4: Inventory Damage Reporting &amp; Markdown: (a) Stock Associate logs damaged items in ERP: item, quantity, damage type (water warp, cement hardened, mold, rust); (b) system auto-applies markdown based on damage severity: 10–20% for surface water marks on lumber, 30–50% for warped/cupped boards, 100% write-off for hardened cement; (c) markdown items moved to designated clearance area in lumber yard; (d) total damage value tracked per store per weather event for insurance claim documentation (W858) and shrinkage reporting (W845)
Responsible (R): Stock Associate / System
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1103_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1103_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1103_Task8" name="Tarp Maintenance &amp; Replacement Tracking">
        <bpmn:documentation>Step 5: Tarp Maintenance &amp; Replacement Tracking: (a) tarps inspected weekly for tears, UV degradation, and grommet damage; (b) damaged tarps replaced from store maintenance supply; (c) tarp replacement tracked in Oracle eAM (W47, fit-gap F5) as consumable expense; (d) annual tarp budget: ~PHP 15,000–25,000 per store (10–15 tarps × PHP 1,500–2,000 each)
Responsible (R): Stock Associate
Accountable (A): Store Manager
Duration: 5 min/week</bpmn:documentation>
        <bpmn:incoming>W1103_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1103_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1103_End9" name="Complete">
        <bpmn:incoming>W1103_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1103_Annotation10">
        <bpmn:text>Controls: - CTL-260 (ensure controlled execution — Store Facility &amp; Safety (PA-07.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Receiving Clerk / Stock Associate (Lumber Yard)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1103_Assoc11" sourceRef="W1103_Annotation10" targetRef="W1103_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W1103_Flow12" sourceRef="W1103_Start3" targetRef="W1103_Task4" />
      <bpmn:sequenceFlow id="W1103_Flow13" sourceRef="W1103_Task4" targetRef="W1103_Task5" />
      <bpmn:sequenceFlow id="W1103_Flow14" sourceRef="W1103_Task5" targetRef="W1103_Task6" />
      <bpmn:sequenceFlow id="W1103_Flow15" sourceRef="W1103_Task6" targetRef="W1103_Task7" />
      <bpmn:sequenceFlow id="W1103_Flow16" sourceRef="W1103_Task7" targetRef="W1103_Task8" />
      <bpmn:sequenceFlow id="W1103_Flow17" sourceRef="W1103_Task8" targetRef="W1103_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1103_diag">
      <bpmndi:BPMNPlane id="W1103_plane" bpmnElement="W_W1103">
        <bpmndi:BPMNShape id="W1103_Lane1_di" bpmnElement="W1103_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
