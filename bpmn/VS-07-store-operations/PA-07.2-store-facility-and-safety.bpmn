      <bpmn:sequenceFlow id="W1003_Flow19" sourceRef="W1003_Task9" targetRef="W1003_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1003_diag">
      <bpmndi:BPMNPlane id="W1003_plane" bpmnElement="W_W1003">
        <bpmndi:BPMNShape id="W1003_Lane1_di" bpmnElement="W1003_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
