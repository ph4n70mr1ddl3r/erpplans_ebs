    <bpmn:process id="W_W1156" name="W1156. Store-Level Customer Construction Site Safety Equipment Rental &amp; Delivery" isExecutable="false">
      <bpmn:documentation>Trigger: Customer inquires about safety equipment for a construction project, or customer purchases construction materials that require safety equipment, or pro desk referral for project accounts
Frequency: ~800–1,200 safety equipment rental transactions/month across all stores
Volume: 1–20 equipment items per rental
Owner: Department Supervisor (Tools &amp; Hardware)
Participants: Sales Associate, Department Supervisor, Customer, Delivery Partner (if delivery requested)
Source: workflow W1156 — Store-Level Customer Construction Site Safety Equipment Rental &amp; Delivery</bpmn:documentation>
      <bpmn:laneSet id="W1156_LaneSet4">
        <bpmn:lane id="W1156_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W1156_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1156_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1156_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1156_Lane2" name="System">
        <bpmn:flowNodeRef>W1156_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1156_Lane3" name="Department Supervisor">
        <bpmn:flowNodeRef>W1156_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1156_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1156_Start5" name="Customer inquires about safety equipment for a construction project, or customer…">
        <bpmn:outgoing>W1156_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1156_Task6" name="Rental Booking &amp; Safety Assessment">
        <bpmn:documentation>Step 1: Rental Booking &amp; Safety Assessment: (a) customer requests safety equipment rental; (b) sales associate identifies project type and duration: roofing (safety harness, roof brackets, anchor points), scaffolding work (full-body harness, hard hat, safety net), concrete pouring (steel-toe boots, gloves, hard hat), excavation (shoring equipment, gas detector), general construction (hard hat, safety vest, goggles, gloves); (c) associate creates rental agreement in ERP: equipment items, rental duration, daily/weekly rate, deposit amount (50–100% of equipment retail value), delivery option; (d) customer presents valid ID and signs rental agreement with safety acknowledgment: &quot;Customer acknowledges responsibility for proper use of safety equipment and has received basic usage instructions&quot;; (e) deposit collected via POS (refundable upon return of equipment in good condition)
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W1156_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1156_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1156_Task7" name="Equipment Preparation &amp; Delivery">
        <bpmn:documentation>Step 2: Equipment Preparation &amp; Delivery: (a) stock associate retrieves rental equipment from dedicated rental storage area (separate from sale inventory); (b) equipment pre-inspected: harness — check stitching, D-rings, webbing for wear or damage; hard hat — check for cracks, suspension integrity; scaffolding — check for rust, bent components, missing pins; fire extinguisher — check pressure gauge, inspection date; (c) equipment cleaned and sanitized (especially hard hats and respirators); (d) customer briefed on proper usage: harness donning and adjustment, scaffolding assembly basics, fire extinguisher PASS technique (Pull, Aim, Squeeze, Sweep); (e) if delivery requested: equipment loaded and dispatched per W5D with delivery fee
Responsible (R): Sales Associate / Stock Associate
Accountable (A): Department Supervisor
Duration: 15–20 min</bpmn:documentation>
        <bpmn:incoming>W1156_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1156_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1156_Task8" name="Rental Duration Monitoring &amp; Extension Management">
        <bpmn:documentation>Step 3: Rental Duration Monitoring &amp; Extension Management: (a) system tracks active rentals with auto-generated alerts: 2 days before rental end — associate contacts customer for return or extension; (b) if customer extends: rental agreement updated with new end date and additional rental fee charged to deposit; (c) if rental overdue by &gt;2 days: customer contacted for return scheduling; overdue fees accrue at 150% of daily rate; (d) if rental overdue by &gt;7 days and customer unresponsive: deposit forfeited and equipment re-ordered from vendor; (e) monthly active rental report generated: equipment utilization rate, average rental duration, overdue rate, rental revenue
Responsible (R): System / Sales Associate
Accountable (A): Department Supervisor
Duration: 2–3 min/rental</bpmn:documentation>
        <bpmn:incoming>W1156_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1156_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1156_Task9" name="Return Inspection &amp; Deposit Refund">
        <bpmn:documentation>Step 4: Return Inspection &amp; Deposit Refund: (a) customer returns equipment to store receiving dock; (b) department supervisor inspects returned equipment against rental agreement: all items returned, no damage beyond normal wear, all components present (harness has all D-rings, scaffolding has all pins); (c) inspection outcomes: full deposit refund — equipment in good condition; partial deposit refund — minor damage (rental fee for damaged items deducted from deposit); deposit forfeiture — equipment lost, stolen, or severely damaged; (d) deposit refund processed via POS (cash refund or credit back to card); (e) equipment returned to rental storage, cleaned, and made available for next rental
Responsible (R): Department Supervisor / Sales Associate
Accountable (A): Department Supervisor
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W1156_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1156_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1156_End10" name="Complete">
        <bpmn:incoming>W1156_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1156_Annotation11">
        <bpmn:text>Controls: - CTL-260 (ensure controlled execution — Store Facility &amp; Safety (PA-07.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Department Supervisor (Tools &amp; Hardware)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1156_Assoc12" sourceRef="W1156_Annotation11" targetRef="W1156_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1156_Flow13" sourceRef="W1156_Start5" targetRef="W1156_Task6" />
      <bpmn:sequenceFlow id="W1156_Flow14" sourceRef="W1156_Task6" targetRef="W1156_Task7" />
      <bpmn:sequenceFlow id="W1156_Flow15" sourceRef="W1156_Task7" targetRef="W1156_Task8" />
      <bpmn:sequenceFlow id="W1156_Flow16" sourceRef="W1156_Task8" targetRef="W1156_Task9" />
      <bpmn:sequenceFlow id="W1156_Flow17" sourceRef="W1156_Task9" targetRef="W1156_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1156_diag">
      <bpmndi:BPMNPlane id="W1156_plane" bpmnElement="W_W1156">
        <bpmndi:BPMNShape id="W1156_Lane1_di" bpmnElement="W1156_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1156_Lane2_di" bpmnElement="W1156_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1156_Lane3_di" bpmnElement="W1156_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1156_Task6_di" bpmnElement="W1156_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1156_Task7_di" bpmnElement="W1156_Task7"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1156_Task8_di" bpmnElement="W1156_Task8"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1156_Task9_di" bpmnElement="W1156_Task9"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1156_Start5_di" bpmnElement="W1156_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1156_End10_di" bpmnElement="W1156_End10"><dc:Bounds x="1260" y="487" width="36" height="36" /></bpmndi:BPMNShape>
