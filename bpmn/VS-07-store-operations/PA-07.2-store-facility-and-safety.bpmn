        <bpmndi:BPMNEdge id="W1302_Flow18_di" bpmnElement="W1302_Flow18"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1302_Flow19_di" bpmnElement="W1302_Flow19"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
