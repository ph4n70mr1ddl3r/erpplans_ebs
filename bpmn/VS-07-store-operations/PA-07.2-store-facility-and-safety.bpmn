    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W580" name="W580. Store-Level Emergency Manual Operations Protocol (Total System/Power Failure)" isExecutable="false">
      <bpmn:documentation>Trigger: Total POS/ERP system failure or extended power outage exceeding UPS battery life (typically 30–60 min) at store level
Frequency: Rare — ~0.5–1 total system failure events per store per year (~100–200 chain-wide, mostly power-related in provincial areas and bridged by UPS); concentrated at ~10–20 chain-wide per month during typhoon season
Volume: When activated: all transactions at affected store(s) processed manually until restoration
Owner: Store Manager
Participants: All Store Staff on duty during failure
Source: workflow W580 — Store-Level Emergency Manual Operations Protocol (Total System/Power Failure)</bpmn:documentation>
      <bpmn:laneSet id="W580_LaneSet4">
        <bpmn:lane id="W580_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W580_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W580_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W580_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W580_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W580_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W580_Lane2" name="Lead Cashier">
        <bpmn:flowNodeRef>W580_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W580_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W580_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W580_Lane3" name="Cashier">
        <bpmn:flowNodeRef>W580_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W580_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W580_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W580_Start5" name="Total POS/ERP system failure or extended power outage exceeding UPS battery life…">
        <bpmn:outgoing>W580_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W580_Task6" name="Determine scope: single store (local power/ISP issue) or area outage; check POS…">
        <bpmn:documentation>Step 1: Determine scope: single store (local power/ISP issue) or area outage; check POS connectivity status on all terminals; if all terminals offline and WAN indicator red — declare manual operations
Responsible (R): Store Manager
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W580_Flow18</bpmn:incoming>
        <bpmn:outgoing>W580_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W580_Task7" name="Activate manual operations kit (pre-positioned in store office): (a)…">
        <bpmn:documentation>Step 2: Activate manual operations kit (pre-positioned in store office): (a) pre-printed receipt books (BIR-compliant format with sequential numbering), (b) backup price book (printed monthly, laminated — contains top 5,000 SKUs by velocity with SRP and trade prices), (c) calculator, (d) manual transaction log forms, (e) cash drawer count form, (f) emergency contact list
Responsible (R): Lead Cashier
Accountable (A): Store Manager
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W580_Flow19</bpmn:incoming>
        <bpmn:outgoing>W580_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W580_Task8" name="Manual cash handling: (a) assign one manual cash drawer per operational…">
        <bpmn:documentation>Step 3: Manual cash handling: (a) assign one manual cash drawer per operational checkout point, (b) count starting float and log, (c) all transactions are cash-only (no card, e-wallet, or loyalty) — post signage at entrance &quot;CASH ONLY — system temporarily unavailable&quot;
Responsible (R): Lead Cashier
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W580_Flow20</bpmn:incoming>
        <bpmn:outgoing>W580_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W580_Task9" name="Manual transaction processing: for each customer transaction — (a) look up item…">
        <bpmn:documentation>Step 4: Manual transaction processing: for each customer transaction — (a) look up item price in backup price book or use shelf tag price, (b) manually calculate totals on calculator, (c) compute VAT (12% inclusive — prices in book are VAT-inclusive), (d) write receipt in pre-printed BIR receipt book (duplicate: customer copy + store copy), (e) record transaction in manual log: date, time, receipt number, item(s), quantity, total amount, tender, change, customer name (if willing)
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 5–10 min per transaction</bpmn:documentation>
        <bpmn:incoming>W580_Flow21</bpmn:incoming>
        <bpmn:outgoing>W580_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W580_Task10" name="Manual loyalty recording: if customer presents loyalty card, record loyalty…">
        <bpmn:documentation>Step 5: Manual loyalty recording: if customer presents loyalty card, record loyalty card number and transaction amount in separate loyalty log for retroactive points posting upon system restoration
Responsible (R): Cashier
Accountable (A): —
Duration: 30 sec</bpmn:documentation>
        <bpmn:incoming>W580_Flow22</bpmn:incoming>
        <bpmn:outgoing>W580_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W580_Task11" name="Safe drop every 2 hours: Lead Cashier counts cash accumulated, completes safe…">
        <bpmn:documentation>Step 6: Safe drop every 2 hours: Lead Cashier counts cash accumulated, completes safe drop slip, and secures in safe to limit cash exposure
Responsible (R): Lead Cashier
Accountable (A): Store Manager
Duration: 5 min per drop</bpmn:documentation>
        <bpmn:incoming>W580_Flow23</bpmn:incoming>
        <bpmn:outgoing>W580_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W580_Task12" name="If failure exceeds 4 hours: Store Manager declares mandatory closure — (a)…">
        <bpmn:documentation>Step 7: If failure exceeds 4 hours: Store Manager declares mandatory closure — (a) process remaining customers, (b) secure all cash in safe, (c) post closure signage, (d) notify Regional Manager
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W580_Flow24</bpmn:incoming>
        <bpmn:outgoing>W580_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W580_Task13" name="Upon system restoration: (a) enter all manual transactions into POS with audit…">
        <bpmn:documentation>Step 8: Upon system restoration: (a) enter all manual transactions into POS with audit flag &quot;MANUAL-RECOVERY&quot; and corresponding receipt number, (b) verify cash on hand matches total of system entries + starting float, (c) post loyalty points for recorded loyalty card transactions, (d) Store Manager reconciles and signs off
Responsible (R): Store Manager
Accountable (A): —
Duration: 1–2 hours (depending on transaction volume)</bpmn:documentation>
        <bpmn:incoming>W580_Flow25</bpmn:incoming>
        <bpmn:outgoing>W580_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W580_Task14" name="Post-incident report: Store Manager submits incident report to IT and Regional…">
        <bpmn:documentation>Step 9: Post-incident report: Store Manager submits incident report to IT and Regional Manager — duration of outage, number of manual transactions, total manual revenue, any discrepancies, root cause if known
Responsible (R): Store Manager
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W580_Flow26</bpmn:incoming>
        <bpmn:outgoing>W580_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W580_End15" name="Complete">
        <bpmn:incoming>W580_Flow27</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W580_Annotation16">
        <bpmn:text>Controls: - CTL-260 (ensure controlled execution — Store Facility &amp; Safety (PA-07.2).) | - operational: express-item-only policy during manual mode (limit to top 500 SKUs in price book); operational: VAT-inclusive price book and calculator requirement; operational: post-recovery reconciliation and manual log cross-reference
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W580_Assoc17" sourceRef="W580_Annotation16" targetRef="W580_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W580_Flow18" sourceRef="W580_Start5" targetRef="W580_Task6" />
      <bpmn:sequenceFlow id="W580_Flow19" sourceRef="W580_Task6" targetRef="W580_Task7" />
      <bpmn:sequenceFlow id="W580_Flow20" sourceRef="W580_Task7" targetRef="W580_Task8" />
      <bpmn:sequenceFlow id="W580_Flow21" sourceRef="W580_Task8" targetRef="W580_Task9" />
      <bpmn:sequenceFlow id="W580_Flow22" sourceRef="W580_Task9" targetRef="W580_Task10" />
      <bpmn:sequenceFlow id="W580_Flow23" sourceRef="W580_Task10" targetRef="W580_Task11" />
      <bpmn:sequenceFlow id="W580_Flow24" sourceRef="W580_Task11" targetRef="W580_Task12" />
      <bpmn:sequenceFlow id="W580_Flow25" sourceRef="W580_Task12" targetRef="W580_Task13" />
      <bpmn:sequenceFlow id="W580_Flow26" sourceRef="W580_Task13" targetRef="W580_Task14" />
      <bpmn:sequenceFlow id="W580_Flow27" sourceRef="W580_Task14" targetRef="W580_End15" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W580_diag">
      <bpmndi:BPMNPlane id="W580_plane" bpmnElement="W_W580">
        <bpmndi:BPMNShape id="W580_Lane1_di" bpmnElement="W580_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2210" height="170" /></bpmndi:BPMNShape>
