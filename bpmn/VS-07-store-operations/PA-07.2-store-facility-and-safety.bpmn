      <bpmn:sequenceFlow id="W470_Flow27" sourceRef="W470_Task13" targetRef="W470_Task14" />
      <bpmn:sequenceFlow id="W470_Flow28" sourceRef="W470_Task14" targetRef="W470_Task15" />
      <bpmn:sequenceFlow id="W470_Flow29" sourceRef="W470_Task15" targetRef="W470_End16" />
    </bpmn:process>
