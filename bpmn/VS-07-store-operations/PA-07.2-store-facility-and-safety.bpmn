      <bpmn:sequenceFlow id="W1135_Flow15" sourceRef="W1135_Task7" targetRef="W1135_Task8" />
      <bpmn:sequenceFlow id="W1135_Flow16" sourceRef="W1135_Task8" targetRef="W1135_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1135_diag">
      <bpmndi:BPMNPlane id="W1135_plane" bpmnElement="W_W1135">
        <bpmndi:BPMNShape id="W1135_Lane1_di" bpmnElement="W1135_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1135_Lane2_di" bpmnElement="W1135_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1135_Task5_di" bpmnElement="W1135_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1135_Task6_di" bpmnElement="W1135_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1135_Task7_di" bpmnElement="W1135_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
