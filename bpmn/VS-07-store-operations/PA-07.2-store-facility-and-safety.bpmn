<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-07.2-store-facility-and-safety" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W47" name="W47. Store Facility Maintenance &amp; Work Orders" isExecutable="false">
      <bpmn:documentation>Trigger: Equipment failure, scheduled preventive maintenance, safety inspection finding, or store staff report
Frequency: Continuous; preventive maintenance on fixed schedules per equipment type
Volume: ~2,000–3,000 maintenance work orders/month across 200 stores + 4 DCs (~10–15 per location per month)
Owner: Store Manager (store-level); Facilities Coordinator (HQ oversight)
Participants: Maintenance/Utility staff, Store Manager, Facilities Coordinator, external contractors, Finance
Source: workflow W47 — Store Facility Maintenance &amp; Work Orders</bpmn:documentation>
      <bpmn:laneSet id="W47_LaneSet5">
        <bpmn:lane id="W47_Lane1" name="Maintenance">
        <bpmn:flowNodeRef>W47_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W47_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W47_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W47_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W47_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W47_Lane3" name="System">
        <bpmn:flowNodeRef>W47_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W47_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W47_Lane4" name="Facilities Coordinator">
        <bpmn:flowNodeRef>W47_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W47_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W47_Start6" name="Equipment failure, scheduled preventive maintenance, safety inspection finding, or store…">
        <bpmn:outgoing>W47_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W47_Task7" name="Issue identified: (a) store staff reports equipment malfunction (POS terminal…">
        <bpmn:documentation>Step 1: Issue identified: (a) store staff reports equipment malfunction (POS terminal, paint mixer, lumber saw, forklift, HVAC, lighting, plumbing, roll-up door), (b) scheduled preventive maintenance triggers, (c) safety inspection reveals deficiency
Responsible (R): Maintenance / Utility Staff
Accountable (A): Store Manager
Duration: 5 min (reporting)</bpmn:documentation>
        <bpmn:incoming>W47_Flow16</bpmn:incoming>
        <bpmn:outgoing>W47_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W47_Task8" name="Maintenance staff or Store Manager creates work order in system: location…">
        <bpmn:documentation>Step 2: Maintenance staff or Store Manager creates work order in system: location, equipment/area, issue description, priority (critical / high / medium / low), photos if applicable
Responsible (R): Store Manager / Maintenance
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W47_Flow17</bpmn:incoming>
        <bpmn:outgoing>W47_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W47_Task9" name="System classifies work order: (a) in-store capability — Maintenance/Utility…">
        <bpmn:documentation>Step 3: System classifies work order: (a) in-store capability — Maintenance/Utility staff can resolve with available tools and parts, (b) requires external contractor (specialized repair: HVAC, electrical, plumbing, elevator/escalator), (c) requires equipment vendor service (POS, forklift, paint mixer under warranty or service contract), (d) requires capex (major repair exceeding PHP 50,000 → route to W21 capex workflow)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W47_Flow18</bpmn:incoming>
        <bpmn:outgoing>W47_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W47_Task10" name="Work order completed: repair verified by Store Manager; work order closed in…">
        <bpmn:documentation>Step 4: Work order completed: repair verified by Store Manager; work order closed in system with resolution code, actual labor hours, parts cost, and contractor/vendor cost
Responsible (R): Store Manager / Maintenance
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W47_Flow19</bpmn:incoming>
        <bpmn:outgoing>W47_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W47_Task11" name="System posts maintenance costs: parts and labor to store maintenance expense…">
        <bpmn:documentation>Step 5: System posts maintenance costs: parts and labor to store maintenance expense GL; contractor invoices routed to AP per W7C (non-PO) or against maintenance contract PO
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W47_Flow20</bpmn:incoming>
        <bpmn:outgoing>W47_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W47_Task12" name="Monthly: Facilities Coordinator reviews maintenance report by location: total…">
        <bpmn:documentation>Step 6: Monthly: Facilities Coordinator reviews maintenance report by location: total cost per store, top issue categories, contractor response time SLA compliance, recurring issues
Responsible (R): Facilities Coordinator
Accountable (A): VP Store Operations
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W47_Flow21</bpmn:incoming>
        <bpmn:outgoing>W47_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W47_End13" name="Complete">
        <bpmn:incoming>W47_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W47_Annotation14">
        <bpmn:text>Controls: - CTL-260 (ensure controlled execution — Store Facility &amp; Safety (PA-07.2).) | - operational: Store Manager (store-level); Facilities Coordinator (HQ oversight) review and approval gate
Owner: Store Manager (store-level); Facilities Coordinator (HQ oversight)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W47_Assoc15" sourceRef="W47_Annotation14" targetRef="W47_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W47_Flow16" sourceRef="W47_Start6" targetRef="W47_Task7" />
      <bpmn:sequenceFlow id="W47_Flow17" sourceRef="W47_Task7" targetRef="W47_Task8" />
      <bpmn:sequenceFlow id="W47_Flow18" sourceRef="W47_Task8" targetRef="W47_Task9" />
      <bpmn:sequenceFlow id="W47_Flow19" sourceRef="W47_Task9" targetRef="W47_Task10" />
      <bpmn:sequenceFlow id="W47_Flow20" sourceRef="W47_Task10" targetRef="W47_Task11" />
      <bpmn:sequenceFlow id="W47_Flow21" sourceRef="W47_Task11" targetRef="W47_Task12" />
      <bpmn:sequenceFlow id="W47_Flow22" sourceRef="W47_Task12" targetRef="W47_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W47_diag">
      <bpmndi:BPMNPlane id="W47_plane" bpmnElement="W_W47">
        <bpmndi:BPMNShape id="W47_Lane1_di" bpmnElement="W47_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W47_Lane2_di" bpmnElement="W47_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W47_Lane3_di" bpmnElement="W47_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W47_Lane4_di" bpmnElement="W47_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W47_Task7_di" bpmnElement="W47_Task7"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W47_Task8_di" bpmnElement="W47_Task8"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W47_Task9_di" bpmnElement="W47_Task9"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W47_Task10_di" bpmnElement="W47_Task10"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W47_Task11_di" bpmnElement="W47_Task11"><dc:Bounds x="1240" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W47_Task12_di" bpmnElement="W47_Task12"><dc:Bounds x="1450" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W47_Start6_di" bpmnElement="W47_Start6"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W47_End13_di" bpmnElement="W47_End13"><dc:Bounds x="1680" y="657" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W47_Annotation14_di" bpmnElement="W47_Annotation14"><dc:Bounds x="160" y="800" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W47_Flow16_di" bpmnElement="W47_Flow16"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W47_Flow17_di" bpmnElement="W47_Flow17"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W47_Flow18_di" bpmnElement="W47_Flow18"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W47_Flow19_di" bpmnElement="W47_Flow19"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W47_Flow20_di" bpmnElement="W47_Flow20"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W47_Flow21_di" bpmnElement="W47_Flow21"><di:waypoint x="1420" y="505" /><di:waypoint x="1450" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W47_Flow22_di" bpmnElement="W47_Flow22"><di:waypoint x="1630" y="675" /><di:waypoint x="1680" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W47_Assoc15_di" bpmnElement="W47_Assoc15"><di:waypoint x="340" y="800" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W71" name="W71. Store Physical Security &amp; Access Control" isExecutable="false">
      <bpmn:documentation>Trigger: Daily security operations; alarm events; periodic access audits; security incidents
Frequency: Continuous; daily guard operations; monthly access reviews; quarterly security audits
Volume: 200 stores × 24/7 security; 4 DCs × 24/7 security; ~6,911 active access credentials
Owner: Store Manager (store-level); DC Manager (DC-level); Facilities Coordinator (oversight)
Participants: Security guards (contracted), Store Manager, DC Manager, Facilities Coordinator, HR, IT, Loss Prevention Officer
Source: workflow W71 — Store Physical Security &amp; Access Control</bpmn:documentation>
      <bpmn:laneSet id="W71_LaneSet8">
        <bpmn:lane id="W71_Lane1" name="Security Guard">
        <bpmn:flowNodeRef>W71_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W71_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W71_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W71_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W71_Task23</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W71_Start9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W71_Lane2" name="HR Assistant">
        <bpmn:flowNodeRef>W71_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W71_Lane3" name="IT">
        <bpmn:flowNodeRef>W71_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W71_Task21</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W71_Lane4" name="Store Manager">
        <bpmn:flowNodeRef>W71_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W71_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W71_Task19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W71_Task22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W71_Task27</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W71_Lane5" name="Alarm Monitoring Co.">
        <bpmn:flowNodeRef>W71_Task18</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W71_Lane6" name="System">
        <bpmn:flowNodeRef>W71_Task20</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W71_Lane7" name="Facilities Coordinator">
        <bpmn:flowNodeRef>W71_Task24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W71_Task25</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W71_Task26</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W71_Task28</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W71_End29</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W71_Start9" name="Daily security operations; alarm events; periodic access audits; security incidents">
        <bpmn:outgoing>W71_Flow32</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W71_Task10" name="Opening: guard on duty disarms alarm (or receives handoff from night-shift…">
        <bpmn:documentation>Step 1: Opening: guard on duty disarms alarm (or receives handoff from night-shift guard); performs exterior walkthrough checking for signs of break-in, vandalism, or tampering with outdoor yard inventory; reports findings to Store Manager before staff arrival (W5A step 2)
Responsible (R): Security Guard
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W71_Flow32</bpmn:incoming>
        <bpmn:outgoing>W71_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W71_Task11" name="During operating hours: guard monitors store entrance/exit; controls access to…">
        <bpmn:documentation>Step 2: During operating hours: guard monitors store entrance/exit; controls access to receiving dock and backroom areas (only authorized personnel via access badge); assists with customer bag checks on exit per company policy
Responsible (R): Security Guard
Accountable (A): Store Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W71_Flow33</bpmn:incoming>
        <bpmn:outgoing>W71_Flow34</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W71_Task12" name="Closing: guard monitors final customer exit; secures receiving dock; performs…">
        <bpmn:documentation>Step 3: Closing: guard monitors final customer exit; secures receiving dock; performs exterior walkthrough; arms alarm system after Store Manager confirms all staff departed (W5F step 9)
Responsible (R): Security Guard
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W71_Flow34</bpmn:incoming>
        <bpmn:outgoing>W71_Flow35</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W71_Task13" name="Night shift (if applicable): guard patrols exterior perimeter hourly; checks…">
        <bpmn:documentation>Step 4: Night shift (if applicable): guard patrols exterior perimeter hourly; checks outdoor yard inventory area; monitors alarm system; responds to alarm activations per incident response protocol
Responsible (R): Security Guard
Accountable (A): Facilities Coordinator
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W71_Flow35</bpmn:incoming>
        <bpmn:outgoing>W71_Flow36</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W71_Task14" name="New employee access: HR Assistant creates access badge during onboarding (W15…">
        <bpmn:documentation>Step 5: New employee access: HR Assistant creates access badge during onboarding (W15 step 9); system assigns access level by role (cashier = POS area + backroom; stock associate = sales floor + backroom + receiving; store manager = all areas); badge activated in access control system
Responsible (R): HR Assistant / IT
Accountable (A): Store Manager
Duration: 10 min/employee</bpmn:documentation>
        <bpmn:incoming>W71_Flow36</bpmn:incoming>
        <bpmn:outgoing>W71_Flow37</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W71_Task15" name="Access deactivation: upon employee separation (W43 step 5), IT deactivates…">
        <bpmn:documentation>Step 6: Access deactivation: upon employee separation (W43 step 5), IT deactivates access badge within same business day; Store Manager collects physical badge; system logs deactivation with timestamp; if badge not returned, system notes &quot;badge not returned&quot; and access is blocked electronically
Responsible (R): IT / Store Manager
Accountable (A): Store Manager
Duration: 5 min/employee</bpmn:documentation>
        <bpmn:incoming>W71_Flow37</bpmn:incoming>
        <bpmn:outgoing>W71_Flow38</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W71_Task16" name="Lost badge: employee reports lost badge to Store Manager immediately; Store…">
        <bpmn:documentation>Step 7: Lost badge: employee reports lost badge to Store Manager immediately; Store Manager deactivates lost badge in system and issues replacement; system logs lost badge event with employee ID and replacement badge number; if pattern of repeated lost badges (&gt; 2 in 12 months), escalated to HR for review
Responsible (R): Store Manager / IT
Accountable (A): Facilities Coordinator
Duration: 10 min/occurrence</bpmn:documentation>
        <bpmn:incoming>W71_Flow38</bpmn:incoming>
        <bpmn:outgoing>W71_Flow39</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W71_Task17" name="Master key / safe key control: Store Manager holds master key and safe key…">
        <bpmn:documentation>Step 8: Master key / safe key control: Store Manager holds master key and safe key; Assistant Store Manager holds backup; keys inventoried monthly; key issuance log maintained for all mechanical keys (backroom, electrical room, roof access); Facilities Coordinator audits key logs quarterly across all stores
Responsible (R): Store Manager / Facilities Coordinator
Accountable (A): VP Store Operations
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W71_Flow39</bpmn:incoming>
        <bpmn:outgoing>W71_Flow40</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W71_Task18" name="Alarm activation after hours: alarm monitoring company contacts designated…">
        <bpmn:documentation>Step 9: Alarm activation after hours: alarm monitoring company contacts designated Store Manager (or backup contact list); if no response within 15 minutes, monitoring company dispatches guard and contacts Facilities Coordinator; for confirmed intrusion, monitoring company contacts PNP and Store Manager proceeds to store
Responsible (R): Alarm Monitoring Co. / Store Manager
Accountable (A): Facilities Coordinator
Duration: As needed</bpmn:documentation>
        <bpmn:incoming>W71_Flow40</bpmn:incoming>
        <bpmn:outgoing>W71_Flow41</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W71_Task19" name="Alarm event documentation: Store Manager investigates cause of alarm (false…">
        <bpmn:documentation>Step 10: Alarm event documentation: Store Manager investigates cause of alarm (false alarm, intrusion attempt, animal, weather); documents findings in system with alarm event reference, CCTV footage review timestamp, and resolution; false alarm frequency tracked per store per month; stores with &gt; 5 false alarms/month flagged for alarm system maintenance (W47)
Responsible (R): Store Manager
Accountable (A): Facilities Coordinator
Duration: 15 min/event</bpmn:documentation>
        <bpmn:incoming>W71_Flow41</bpmn:incoming>
        <bpmn:outgoing>W71_Flow42</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W71_Task20" name="CCTV system health monitoring: system automatically checks CCTV camera status…">
        <bpmn:documentation>Step 11: CCTV system health monitoring: system automatically checks CCTV camera status every 4 hours (online/offline); if camera goes offline, system alerts IT Helpdesk (W48) and Store Manager; IT prioritizes CCTV camera restoration as P2 incident (W48 SLA matrix); Facilities Coordinator reviews weekly CCTV health report across all stores; stores with &gt; 10% cameras offline for &gt; 24 hours flagged for immediate action
Responsible (R): System / IT / Facilities Coordinator
Accountable (A): CIO
Duration: Automated + 30 min/week review</bpmn:documentation>
        <bpmn:incoming>W71_Flow42</bpmn:incoming>
        <bpmn:outgoing>W71_Flow43</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W71_Task21" name="CCTV recording retention: minimum 30 days online storage, 90 days archived per…">
        <bpmn:documentation>Step 12: CCTV recording retention: minimum 30 days online storage, 90 days archived per W37 CCTV integration specification; Facilities Coordinator validates retention compliance quarterly; recording storage capacity monitored by IT; capacity expansion planned before reaching 80% threshold
Responsible (R): IT / Facilities Coordinator
Accountable (A): CIO
Duration: Quarterly review</bpmn:documentation>
        <bpmn:incoming>W71_Flow43</bpmn:incoming>
        <bpmn:outgoing>W71_Flow44</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W71_Task22" name="Break-in / robbery: Store Manager (or night guard) contacts PNP immediately…">
        <bpmn:documentation>Step 13: Break-in / robbery: Store Manager (or night guard) contacts PNP immediately; secures scene; Facilities Coordinator and VP Store Operations notified within 1 hour; Loss Prevention Officer activated for investigation; inventory loss assessed per W37 confirmed theft write-off process; insurance claim filed per W59 if loss exceeds deductible
Responsible (R): Store Manager / LPO
Accountable (A): VP Store Operations
Duration: Varies</bpmn:documentation>
        <bpmn:incoming>W71_Flow44</bpmn:incoming>
        <bpmn:outgoing>W71_Flow45</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W71_Task23" name="Vendor / contractor access: visiting vendors and contractors sign in at guard…">
        <bpmn:documentation>Step 14: Vendor / contractor access: visiting vendors and contractors sign in at guard station; issued temporary visitor badge with time-limited access; guard verifies vendor identity against scheduled appointment list (W18B for DSD, W47 for maintenance contractors); visitor badge collected on exit; sign-in log retained for 90 days
Responsible (R): Security Guard / Vendor
Accountable (A): Store Manager
Duration: 5 min/visitor</bpmn:documentation>
        <bpmn:incoming>W71_Flow45</bpmn:incoming>
        <bpmn:outgoing>W71_Flow46</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W71_Task24" name="Monthly: Facilities Coordinator generates security incident summary per store…">
        <bpmn:documentation>Step 15: Monthly: Facilities Coordinator generates security incident summary per store: alarm events, break-in attempts, false alarm frequency, badge incidents, camera downtime; includes in monthly report to VP Store Operations
Responsible (R): Facilities Coordinator
Accountable (A): VP Store Operations
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W71_Flow46</bpmn:incoming>
        <bpmn:outgoing>W71_Flow47</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W71_Task25" name="Quarterly: LPO includes physical security incidents in loss prevention review…">
        <bpmn:documentation>Step 16: Quarterly: LPO includes physical security incidents in loss prevention review (W37); Facilities Coordinator conducts physical security audit at 10–15 sampled stores per quarter (rotating): checks alarm functionality, camera coverage adequacy, key control compliance, guard force performance, and outdoor yard security
Responsible (R): Facilities Coordinator / LPO
Accountable (A): VP Store Operations
Duration: Quarterly audit</bpmn:documentation>
        <bpmn:incoming>W71_Flow47</bpmn:incoming>
        <bpmn:outgoing>W71_Flow48</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W71_Task26" name="Security services contracted through licensed security agency (separate from…">
        <bpmn:documentation>Step 17: Security services contracted through licensed security agency (separate from BuildRight entities); Facilities Coordinator manages contract per W62 (non-PO vendor contract); contract specifies guard deployment (typically 2 guards per store: 1 day + 1 night shift), qualifications (licensed, trained, vetted), equipment (uniforms, radios, flashlights), and response protocols
Responsible (R): Facilities Coordinator
Accountable (A): VP Store Operations
Duration: Per W62</bpmn:documentation>
        <bpmn:incoming>W71_Flow48</bpmn:incoming>
        <bpmn:outgoing>W71_Flow49</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W71_Task27" name="Store Manager rates guard performance daily (attendance, alertness, incident…">
        <bpmn:documentation>Step 18: Store Manager rates guard performance daily (attendance, alertness, incident response); monthly aggregate rating submitted to Facilities Coordinator; Facilities Coordinator escalates underperforming guard agencies to contract review per W62 SLA tracking
Responsible (R): Store Manager / Facilities Coordinator
Accountable (A): VP Store Operations
Duration: 15 min/month</bpmn:documentation>
        <bpmn:incoming>W71_Flow49</bpmn:incoming>
        <bpmn:outgoing>W71_Flow50</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W71_Task28" name="Annual: Facilities Coordinator and Legal review security service contract…">
        <bpmn:documentation>Step 19: Annual: Facilities Coordinator and Legal review security service contract; benchmarks rates and service quality against alternative agencies; renews or re-tenders per W62 contract lifecycle
Responsible (R): Facilities Coordinator / Legal
Accountable (A): VP Store Operations
Duration: Per W62</bpmn:documentation>
        <bpmn:incoming>W71_Flow50</bpmn:incoming>
        <bpmn:outgoing>W71_Flow51</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W71_End29" name="Complete">
        <bpmn:incoming>W71_Flow51</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W71_Annotation30">
        <bpmn:text>Controls: - CTL-260 (ensure controlled execution — Store Facility &amp; Safety (PA-07.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Store Manager (store-level); DC Manager (DC-level); Facilities Coordinator (oversight)</bpmn:text>
      </bpmn:textAnnotation>
