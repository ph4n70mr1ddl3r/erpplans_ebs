      <bpmn:startEvent id="W503_Start7" name="Scheduled pest control service visit; pest incident reported by staff; monthly sanitation…">
        <bpmn:outgoing>W503_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W503_Task8" name="Pest control vendor technician arrives per monthly schedule; conducts…">
        <bpmn:documentation>Step 1: Pest control vendor technician arrives per monthly schedule; conducts inspection of store zones (sales floor, receiving dock, lumber yard, garden center, break room, storage areas)
Responsible (R): Vendor Technician
Accountable (A): Store Manager
Duration: 45 min</bpmn:documentation>
        <bpmn:incoming>W503_Flow19</bpmn:incoming>
        <bpmn:outgoing>W503_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W503_Task9" name="Technician documents findings per zone: pest type (rodent, cockroach, ant…">
        <bpmn:documentation>Step 2: Technician documents findings per zone: pest type (rodent, cockroach, ant, termite, bird, fly), severity (none/low/medium/high), treatment applied, bait station refill, trap count
Responsible (R): Vendor Technician
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W503_Flow20</bpmn:incoming>
        <bpmn:outgoing>W503_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W503_Task10" name="Technician enters service report into system via vendor portal or tablet…">
        <bpmn:documentation>Step 3: Technician enters service report into system via vendor portal or tablet: zone-by-zone findings, chemicals applied (for MSDS tracking), next visit recommendations, corrective actions required by store
Responsible (R): Vendor Technician
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W503_Flow21</bpmn:incoming>
        <bpmn:outgoing>W503_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W503_Task11" name="If pest incident reported between visits: staff logs incident in system (pest…">
        <bpmn:documentation>Step 4: If pest incident reported between visits: staff logs incident in system (pest type, location, photo); system auto-escalates to pest control vendor for emergency visit within 48 hours SLA
Responsible (R): Maintenance Staff
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W503_Flow22</bpmn:incoming>
        <bpmn:outgoing>W503_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W503_Task12" name="Monthly: Store Manager completes sanitation self-audit checklist per zone…">
        <bpmn:documentation>Step 5: Monthly: Store Manager completes sanitation self-audit checklist per zone: cleanliness score, spill/drainage issues, food/organic waste storage compliance, loading dock cleanliness, break room hygiene
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W503_Flow23</bpmn:incoming>
        <bpmn:outgoing>W503_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W503_Task13" name="System aggregates pest control and sanitation scores per store; flag stores…">
        <bpmn:documentation>Step 6: System aggregates pest control and sanitation scores per store; flag stores scoring below threshold (&lt;70% sanitation or &gt;3 high-severity pest findings) for Regional Manager review
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W503_Flow24</bpmn:incoming>
        <bpmn:outgoing>W503_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W503_Task14" name="Quarterly: pest control vendor conducts deep treatment (fogging, drain…">
        <bpmn:documentation>Step 7: Quarterly: pest control vendor conducts deep treatment (fogging, drain treatment, termite inspection for lumber yards); separate work order with extended preparation requirements
Responsible (R): Vendor Technician
Accountable (A): Facilities Coordinator
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W503_Flow25</bpmn:incoming>
        <bpmn:outgoing>W503_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W503_Task15" name="Annually: Facilities Coordinator reviews pest control vendor performance…">
        <bpmn:documentation>Step 8: Annually: Facilities Coordinator reviews pest control vendor performance (response time, incident reduction rate, audit scores); renews or rebids contract; feeds into vendor review (W242)
Responsible (R): Facilities Coordinator
Accountable (A): COO
Duration: 4 hours/year</bpmn:documentation>
        <bpmn:incoming>W503_Flow26</bpmn:incoming>
        <bpmn:outgoing>W503_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W503_End16" name="Complete">
        <bpmn:incoming>W503_Flow27</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W503_Annotation17">
        <bpmn:text>Controls: - CTL-260 (ensure controlled execution — Store Facility &amp; Safety (PA-07.2).) | - operational: quarterly deep treatment and annual termite inspection; operational: scheduling treatments outside store hours and covering merchandise; operational: proactive monthly treatments and rapid incident response
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
