        <bpmndi:BPMNShape id="W1103_Task6_di" bpmnElement="W1103_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1103_Task7_di" bpmnElement="W1103_Task7"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1103_Task8_di" bpmnElement="W1103_Task8"><dc:Bounds x="1240" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1103_Start3_di" bpmnElement="W1103_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1103_End9_di" bpmnElement="W1103_End9"><dc:Bounds x="1470" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1103_Annotation10_di" bpmnElement="W1103_Annotation10"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1103_Flow12_di" bpmnElement="W1103_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1103_Flow13_di" bpmnElement="W1103_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1103_Flow14_di" bpmnElement="W1103_Flow14"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1103_Flow15_di" bpmnElement="W1103_Flow15"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1103_Flow16_di" bpmnElement="W1103_Flow16"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1103_Flow17_di" bpmnElement="W1103_Flow17"><di:waypoint x="1420" y="165" /><di:waypoint x="1470" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1103_Assoc11_di" bpmnElement="W1103_Assoc11"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1108" name="W1108. Store-Level Forklift Operator Daily Certification Check &amp; Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: Start of each store operating day; forklift pre-use before loading or receiving operations
Frequency: Daily (each operating day, 365 days/year)
Volume: 1–2 forklift operators per store × ~150 stores = ~150–300 daily checks
Owner: Receiving Clerk / Department Supervisor (Lumber Yard)
Participants: Forklift Operator, Receiving Clerk, Department Supervisor, Store Manager
Source: workflow W1108 — Store-Level Forklift Operator Daily Certification Check &amp; Compliance</bpmn:documentation>
      <bpmn:laneSet id="W1108_LaneSet3">
        <bpmn:lane id="W1108_Lane1" name="System">
        <bpmn:flowNodeRef>W1108_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1108_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1108_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1108_Lane2" name="Forklift Operator">
        <bpmn:flowNodeRef>W1108_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1108_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1108_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1108_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1108_Start4" name="Start of each store operating day; forklift pre-use before loading or receiving operations">
        <bpmn:outgoing>W1108_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1108_Task5" name="Operator Identity &amp; Certification Verification">
        <bpmn:documentation>Step 1: Operator Identity &amp; Certification Verification: (a) designated forklift operator for the day reports to Receiving Clerk at start of shift; (b) operator swipes employee badge at the forklift safety station terminal (tablet at receiving dock); (c) system retrieves and displays: (i) employee name, ID, and photo; (ii) TESDA forklift certification number and expiration date; (iii) last annual refresher training completion date; (iv) last medical examination date and fitness-to-operate status; (v) any incident history or safety violations; (d) system performs automated checks: ✓ TESDA certification valid and not expired; ✓ Refresher training completed within last 12 months; ✓ Medical exam completed within last 12 months; ✓ No outstanding safety violations; (e) if all checks pass: system authorizes operation and logs the daily clearance; (f) if any check fails: system blocks authorization, displays reason, and notifies Department Supervisor and Store Manager; operator cannot use forklift until issue resolved
Responsible (R): System / Receiving Clerk
Accountable (A): Department Supervisor
Duration: 3–5 min</bpmn:documentation>
        <bpmn:incoming>W1108_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1108_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1108_Task6" name="Operator Fitness-to-Operate Self-Assessment">
        <bpmn:documentation>Step 2: Operator Fitness-to-Operate Self-Assessment: (a) operator completes a brief digital self-assessment on the tablet (modeled on DOLE-recommended pre-work checklist): (i) &quot;Are you feeling well and rested today?&quot; (Yes/No); (ii) &quot;Have you consumed alcohol within the last 8 hours?&quot; (Yes/No); (iii) &quot;Are you currently taking any medication that may impair alertness or coordination?&quot; (Yes/No); (iv) &quot;Are you experiencing any pain, dizziness, or visual disturbance?&quot; (Yes/No); (b) any &quot;Yes&quot; response to items (ii)–(iv) or &quot;No&quot; to item (i) triggers a mandatory hold: operator is redirected to Store Manager for evaluation; (c) self-assessment results logged in HR system with timestamp
Responsible (R): Forklift Operator
Accountable (A): Department Supervisor
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W1108_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1108_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1108_Task7" name="Pre-Operation Forklift Equipment Check">
        <bpmn:documentation>Step 3: Pre-Operation Forklift Equipment Check (per W1015): (a) operator performs the standard daily forklift equipment inspection per W1015 — fluid levels, tires, forks, mast, seatbelt, horn, lights, backup alarm; (b) inspection results entered into tablet system; (c) system cross-references: operator cleared (Step 1) AND equipment passed inspection (Step 3) = FORKLIFT AUTHORIZED FOR USE TODAY; (d) if equipment fails inspection: forklift placed out of service, maintenance work order created per W47, alternative manual handling arranged for the day
Responsible (R): Forklift Operator
Accountable (A): Department Supervisor
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W1108_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1108_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1108_Task8" name="Incident Reporting &amp; Post-Incident Re-Certification">
        <bpmn:documentation>Step 4: Incident Reporting &amp; Post-Incident Re-Certification: (a) if any forklift incident occurs during the day (near-miss, property damage, injury), operator must immediately: (i) stop operations; (ii) secure the area; (iii) report to Department Supervisor; (iv) complete incident report form in system per W140 (OHS incident management); (b) after any incident, operator&#x27;s daily clearance is revoked and a re-evaluation is required before resuming forklift operations; (c) for serious incidents (injury, major property damage), operator is suspended from forklift duty pending investigation and may require re-training
Responsible (R): Forklift Operator / Department Supervisor
Accountable (A): Store Manager
Duration: varies</bpmn:documentation>
        <bpmn:incoming>W1108_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1108_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1108_Task9" name="Monthly Compliance Dashboard &amp; Audit Trail">
        <bpmn:documentation>Step 5: Monthly Compliance Dashboard &amp; Audit Trail: (a) system generates monthly forklift compliance report per store and consolidated at corporate: (i) daily operator clearance completion rate; (ii) certification expiration tracking (30/60/90-day advance warnings); (iii) refresher training compliance rate; (iv) medical examination compliance rate; (v) incident count and type; (vi) equipment inspection pass rate; (b) report submitted to HR (training/certification tracking), Safety (W141 workplace safety audit), and Internal Audit (W337 payroll &amp; statutory compliance audit); (c) DOLE inspection-ready documentation maintained electronically: all daily checks, certification copies, training records, and incident reports
Responsible (R): System / HR
Accountable (A): Store Manager
Duration: 30 min/month (automated report)</bpmn:documentation>
        <bpmn:incoming>W1108_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1108_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1108_End10" name="Complete">
        <bpmn:incoming>W1108_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1108_Annotation11">
        <bpmn:text>Controls: - CTL-260 (ensure controlled execution — Store Facility &amp; Safety (PA-07.2).) | - operational: must provide 90/60/30-day advance alerts
Owner: Receiving Clerk / Department Supervisor (Lumber Yard)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1108_Assoc12" sourceRef="W1108_Annotation11" targetRef="W1108_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1108_Flow13" sourceRef="W1108_Start4" targetRef="W1108_Task5" />
      <bpmn:sequenceFlow id="W1108_Flow14" sourceRef="W1108_Task5" targetRef="W1108_Task6" />
