    <bpmn:process id="W_W428" name="W428. Community Disaster Relief &amp; Emergency Response" isExecutable="false">
      <bpmn:documentation>Trigger: Natural disaster (Typhoon, Earthquake, Flood) affecting a store region; or LGU/NGO request for emergency supply allocation
Frequency: Stochastically, ~5–10 times per year during monsoon/typhoon season
Volume: Variable (batch allocation of hundreds of SKUs)
Owner: VP Store Operations
Participants: COO, Store Manager, Supply Planner, LGU Representatives, NGO Partners
Source: workflow W428 — Community Disaster Relief &amp; Emergency Response</bpmn:documentation>
      <bpmn:laneSet id="W428_LaneSet7">
        <bpmn:lane id="W428_Lane1" name="COO">
        <bpmn:flowNodeRef>W428_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W428_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W428_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W428_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W428_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W428_Lane3" name="Finance Mgr">
        <bpmn:flowNodeRef>W428_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W428_Lane4" name="Stock Associate">
        <bpmn:flowNodeRef>W428_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W428_Lane5" name="Supply Planner">
        <bpmn:flowNodeRef>W428_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W428_Lane6" name="Finance">
        <bpmn:flowNodeRef>W428_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W428_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W428_Start8" name="Natural disaster (Typhoon, Earthquake, Flood) affecting a store region; or LGU/NGO…">
        <bpmn:outgoing>W428_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W428_Task9" name="Emergency Declaration">
        <bpmn:documentation>Step 1: Emergency Declaration: COO declares &quot;Disaster Response Mode&quot; for a specific region; system activates &quot;Disaster Priority&quot; flag in ERP
Responsible (R): COO
Accountable (A): CEO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W428_Flow19</bpmn:incoming>
        <bpmn:outgoing>W428_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W428_Task10" name="Inventory Ring-fencing">
        <bpmn:documentation>Step 2: Inventory Ring-fencing: Store Manager identifies &quot;Relief SKUs&quot; (generators, tarps, plywood, cement, flashlights); system reserves 50% of on-hand stock for &quot;Priority Relief Allocation&quot; (blocks ecommerce and standard POS sales for these quantities)
Responsible (R): Store Manager
Accountable (A): System
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W428_Flow20</bpmn:incoming>
        <bpmn:outgoing>W428_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W428_Task11" name="Relief Allocation Intake">
        <bpmn:documentation>Step 3: Relief Allocation Intake: Store Manager receives requests from LGU (City/Municipal Govt) or authorized NGOs (Red Cross, etc.); creates &quot;Relief Sales Order&quot; in system
Responsible (R): Store Manager
Accountable (A): VP Store Operations
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W428_Flow21</bpmn:incoming>
        <bpmn:outgoing>W428_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W428_Task12" name="Pricing &amp; Payment">
        <bpmn:documentation>Step 4: Pricing &amp; Payment: Relief orders applied with pre-approved &quot;Humanitarian Discount&quot;; payment terms set to &quot;Deferred Relief Term&quot; (Net 90) for LGU accounts to expedite release
Responsible (R): Finance Mgr
Accountable (A): CFO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W428_Flow22</bpmn:incoming>
        <bpmn:outgoing>W428_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W428_Task13" name="Priority Fulfillment">
        <bpmn:documentation>Step 5: Priority Fulfillment: Stock Associates prioritize picking and staging for relief trucks; bypasses standard BOPIS and home delivery queues
Responsible (R): Stock Associate
Accountable (A): Dept Supervisor
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W428_Flow23</bpmn:incoming>
        <bpmn:outgoing>W428_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W428_Task14" name="Emergency Replenishment">
        <bpmn:documentation>Step 6: Emergency Replenishment: Supply Planner triggers immediate &quot;Push&quot; transfers from safe DCs to the disaster-hit region, bypassing standard reorder points (W31)
Responsible (R): Supply Planner
Accountable (A): VP Supply Chain
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W428_Flow24</bpmn:incoming>
        <bpmn:outgoing>W428_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W428_Task15" name="Audit &amp; Tracking">
        <bpmn:documentation>Step 7: Audit &amp; Tracking: System tracks all &quot;Relief Mode&quot; transactions separately for ESG reporting (W114) and post-disaster tax claims
Responsible (R): Finance
Accountable (A): Controller
Duration: 1 day (post-event)</bpmn:documentation>
        <bpmn:incoming>W428_Flow25</bpmn:incoming>
        <bpmn:outgoing>W428_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W428_End16" name="Complete">
        <bpmn:incoming>W428_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W428_Annotation17">
        <bpmn:text>Controls: - CTL-260 (ensure controlled execution — Store Facility &amp; Safety (PA-07.2).) | - operational: VP Store Operations review and approval gate
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
