    <bpmn:process id="W_W579" name="W579. Store-Level Daily Equipment &amp; Specialized Fixture Safety Check" isExecutable="false">
      <bpmn:documentation>Trigger: Store opening (daily, after alarm disarm and before customer entry)
Frequency: Daily per store; each equipment item checked before first use
Volume: 200 stores × ~15 equipment items per store = 3,000 daily checks
Owner: Store Manager
Participants: Department Supervisors, Stock Associates
Source: workflow W579 — Store-Level Daily Equipment &amp; Specialized Fixture Safety Check</bpmn:documentation>
      <bpmn:laneSet id="W579_LaneSet7">
        <bpmn:lane id="W579_Lane1" name="Stock Associate">
        <bpmn:flowNodeRef>W579_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W579_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W579_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W579_Lane2" name="Paint Dept Supervisor">
        <bpmn:flowNodeRef>W579_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W579_Lane3" name="Lumber Dept Supervisor">
        <bpmn:flowNodeRef>W579_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W579_Lane4" name="Department Supervisors">
        <bpmn:flowNodeRef>W579_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W579_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W579_Lane5" name="Department Supervisor">
        <bpmn:flowNodeRef>W579_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W579_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W579_Lane6" name="Store Manager">
        <bpmn:flowNodeRef>W579_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W579_End18</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W579_Start8" name="Store opening (daily, after alarm disarm and before customer entry)">
        <bpmn:outgoing>W579_Flow21</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W579_Task9" name="Forklift pre-use inspection: fluid levels (oil, hydraulic, coolant), tire…">
        <bpmn:documentation>Step 1: Forklift pre-use inspection: fluid levels (oil, hydraulic, coolant), tire condition, horn, lights, backup alarm, seat belt, forks condition; enter results in equipment safety app
Responsible (R): Stock Associate
Accountable (A): Department Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W579_Flow21</bpmn:incoming>
        <bpmn:outgoing>W579_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W579_Task10" name="Pallet jack inspection: wheel condition, hydraulic pump operation, handle…">
        <bpmn:documentation>Step 2: Pallet jack inspection: wheel condition, hydraulic pump operation, handle function, fork tips not bent
Responsible (R): Stock Associate
Accountable (A): Department Supervisor
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W579_Flow22</bpmn:incoming>
        <bpmn:outgoing>W579_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W579_Task11" name="Paint mixing machine: calibration check (run test mix with water), colorant…">
        <bpmn:documentation>Step 3: Paint mixing machine: calibration check (run test mix with water), colorant level verification for all tinting stations, mixing blade condition, guard in place
Responsible (R): Paint Dept Supervisor
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W579_Flow23</bpmn:incoming>
        <bpmn:outgoing>W579_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W579_Task12" name="Lumber/panel saw: blade guard verified and functional, blade condition (no…">
        <bpmn:documentation>Step 4: Lumber/panel saw: blade guard verified and functional, blade condition (no chipped teeth), emergency stop button tested, power cord insulation intact
Responsible (R): Lumber Dept Supervisor
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W579_Flow24</bpmn:incoming>
        <bpmn:outgoing>W579_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W579_Task13" name="Ladder stability check: all ladders in store (step ladders, extension ladders)…">
        <bpmn:documentation>Step 5: Ladder stability check: all ladders in store (step ladders, extension ladders) — feet intact, rungs secure, no visible damage
Responsible (R): Department Supervisors
Accountable (A): Store Manager
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W579_Flow25</bpmn:incoming>
        <bpmn:outgoing>W579_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W579_Task14" name="Electrical tool inspection (if demo tools available): insulation check on power…">
        <bpmn:documentation>Step 6: Electrical tool inspection (if demo tools available): insulation check on power cords, ground pin intact, no visible damage
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W579_Flow26</bpmn:incoming>
        <bpmn:outgoing>W579_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W579_Task15" name="Log all results in equipment safety app: item ID, check type, pass/fail…">
        <bpmn:documentation>Step 7: Log all results in equipment safety app: item ID, check type, pass/fail, inspector name, timestamp
Responsible (R): Department Supervisors
Accountable (A): Store Manager
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W579_Flow27</bpmn:incoming>
        <bpmn:outgoing>W579_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W579_Task16" name="If any item fails: (a) tag out-of-service with red tag (lock-out/tag-out), (b)…">
        <bpmn:documentation>Step 8: If any item fails: (a) tag out-of-service with red tag (lock-out/tag-out), (b) notify Store Manager immediately, (c) system auto-generates maintenance work order per W47, (d) Store Manager determines if safe alternative exists (e.g., hand saw instead of panel saw), (e) equipment not returned to service until maintenance clears
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 5 min per failure</bpmn:documentation>
        <bpmn:incoming>W579_Flow28</bpmn:incoming>
        <bpmn:outgoing>W579_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W579_Task17" name="Weekly: Store Manager reviews equipment safety log for recurring failures…">
        <bpmn:documentation>Step 9: Weekly: Store Manager reviews equipment safety log for recurring failures; schedules preventive maintenance for items showing degradation patterns
Responsible (R): Store Manager
Accountable (A): —
Duration: 15 min/week</bpmn:documentation>
        <bpmn:incoming>W579_Flow29</bpmn:incoming>
        <bpmn:outgoing>W579_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W579_End18" name="Complete">
        <bpmn:incoming>W579_Flow30</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W579_Annotation19">
        <bpmn:text>Controls: - CTL-260 (ensure controlled execution — Store Facility &amp; Safety (PA-07.2).) | - operational: Store Manager sign-off requirement on completed checklist before store opens; operational: daily calibration check and monthly professional calibration service; operational: daily blade condition check and mandatory blade replacement at configured interval (regardless of visual condition)
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W579_Assoc20" sourceRef="W579_Annotation19" targetRef="W579_Start8" associationDirection="None" />
