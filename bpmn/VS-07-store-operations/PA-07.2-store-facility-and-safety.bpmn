    <bpmn:process id="W_W741" name="W741. Store-Level Fuel Inventory &amp; Backup Generator Management" isExecutable="false">
      <bpmn:documentation>Trigger: Daily fuel level check (scheduled); generator start test (weekly); or power outage event (W470)
Frequency: Daily fuel check; weekly generator test
Volume: ~150 stores with backup generators (typhoon/brownout-prone areas; per the Background and staffing basis)
Owner: Store Maintenance Associate
Participants: Store Manager, Maintenance Associate, Fuel Supplier, Finance (fuel expense)
Source: workflow W741 — Store-Level Fuel Inventory &amp; Backup Generator Management</bpmn:documentation>
      <bpmn:laneSet id="W741_LaneSet3">
        <bpmn:lane id="W741_Lane1" name="Maintenance Associate">
        <bpmn:flowNodeRef>W741_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W741_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W741_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W741_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W741_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W741_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W741_Lane2" name="System">
        <bpmn:flowNodeRef>W741_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W741_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W741_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W741_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W741_Start4" name="Daily fuel level check (scheduled); generator start test (weekly); or power outage event…">
        <bpmn:outgoing>W741_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W741_Task5" name="Daily fuel level check — Maintenance Associate records diesel tank level via…">
        <bpmn:documentation>Step 1: Daily fuel level check — Maintenance Associate records diesel tank level via dipstick or digital gauge at start of shift; enters reading in system
Responsible (R): Maintenance Associate
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W741_Flow16</bpmn:incoming>
        <bpmn:outgoing>W741_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W741_Task6" name="Reorder trigger — If fuel level below 40% capacity, system auto-generates fuel…">
        <bpmn:documentation>Step 2: Reorder trigger — If fuel level below 40% capacity, system auto-generates fuel replenishment request to contracted supplier; if below 20%, system flags as urgent
Responsible (R): System / Maintenance Associate
Accountable (A): Store Manager
Duration: Automated + 5 min</bpmn:documentation>
        <bpmn:incoming>W741_Flow17</bpmn:incoming>
        <bpmn:outgoing>W741_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W741_Task7" name="Fuel delivery receipt — Fuel supplier delivers diesel; Maintenance Associate…">
        <bpmn:documentation>Step 3: Fuel delivery receipt — Fuel supplier delivers diesel; Maintenance Associate verifies quantity delivered vs. invoice; system records delivery and updates tank level
Responsible (R): Maintenance Associate
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W741_Flow18</bpmn:incoming>
        <bpmn:outgoing>W741_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W741_Task8" name="Weekly generator start test — Every Monday, Maintenance Associate starts…">
        <bpmn:documentation>Step 4: Weekly generator start test — Every Monday, Maintenance Associate starts generator and runs for 15 minutes under load; records start time, voltage output, unusual sounds/vibrations
Responsible (R): Maintenance Associate
Accountable (A): Store Manager
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W741_Flow19</bpmn:incoming>
        <bpmn:outgoing>W741_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W741_Task9" name="Monthly load bank test — Monthly full-load test (1 hour); records voltage…">
        <bpmn:documentation>Step 5: Monthly load bank test — Monthly full-load test (1 hour); records voltage stability, oil pressure, coolant temperature
Responsible (R): Maintenance Associate
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W741_Flow20</bpmn:incoming>
        <bpmn:outgoing>W741_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W741_Task10" name="Maintenance scheduling — System tracks generator runtime hours; auto-generates…">
        <bpmn:documentation>Step 6: Maintenance scheduling — System tracks generator runtime hours; auto-generates PM work orders per manufacturer schedule (oil change every 250 hours, filter replacement every 500 hours)
Responsible (R): System / Maintenance Associate
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W741_Flow21</bpmn:incoming>
        <bpmn:outgoing>W741_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W741_Task11" name="Outage event execution — When power outage occurs, Maintenance Associate starts…">
        <bpmn:documentation>Step 7: Outage event execution — When power outage occurs, Maintenance Associate starts generator within 3 minutes (per W470); records start time and fuel level; monitors throughout outage; records end time and fuel consumed
Responsible (R): Maintenance Associate
Accountable (A): Store Manager
Duration: Duration of outage</bpmn:documentation>
        <bpmn:incoming>W741_Flow22</bpmn:incoming>
        <bpmn:outgoing>W741_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W741_Task12" name="Fuel expense reporting — System accumulates fuel costs per store; monthly…">
        <bpmn:documentation>Step 8: Fuel expense reporting — System accumulates fuel costs per store; monthly report to Finance for W489 store-level budget tracking
Responsible (R): System / Finance
Accountable (A): Finance
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W741_Flow23</bpmn:incoming>
        <bpmn:outgoing>W741_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W741_End13" name="Complete">
        <bpmn:incoming>W741_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W741_Annotation14">
        <bpmn:text>Controls: - CTL-260 (ensure controlled execution — Store Facility &amp; Safety (PA-07.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Store Maintenance Associate</bpmn:text>
      </bpmn:textAnnotation>
