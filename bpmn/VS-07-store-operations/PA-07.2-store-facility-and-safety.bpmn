        <bpmndi:BPMNEdge id="W5536_Flow21_di" bpmnElement="W5536_Flow21"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5536_Flow22_di" bpmnElement="W5536_Flow22"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
