        <bpmndi:BPMNShape id="W720_Task8_di" bpmnElement="W720_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W720_Task9_di" bpmnElement="W720_Task9"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W720_Task10_di" bpmnElement="W720_Task10"><dc:Bounds x="1240" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W720_Start5_di" bpmnElement="W720_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W720_End11_di" bpmnElement="W720_End11"><dc:Bounds x="1470" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W720_Annotation12_di" bpmnElement="W720_Annotation12"><dc:Bounds x="160" y="630" width="360" height="100" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W720_Flow14_di" bpmnElement="W720_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W720_Flow15_di" bpmnElement="W720_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W720_Flow16_di" bpmnElement="W720_Flow16"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W720_Flow17_di" bpmnElement="W720_Flow17"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W720_Flow18_di" bpmnElement="W720_Flow18"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W720_Flow19_di" bpmnElement="W720_Flow19"><di:waypoint x="1420" y="505" /><di:waypoint x="1470" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W720_Assoc13_di" bpmnElement="W720_Assoc13"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W722" name="W722. Store-Level Exterior Display &amp; Garden Center Daily Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Store opening per W5A; or weather event affecting exterior displays
Frequency: Daily (all stores with exterior/garden areas)
Volume: ~200 stores with outdoor/garden center areas (per VS-145)
Owner: Department Supervisor (Garden/Outdoor)
Participants: Sales Associate, Stock Associate, Store Manager
Source: workflow W722 — Store-Level Exterior Display &amp; Garden Center Daily Operations</bpmn:documentation>
      <bpmn:laneSet id="W722_LaneSet4">
        <bpmn:lane id="W722_Lane1" name="Stock Associate">
        <bpmn:flowNodeRef>W722_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W722_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W722_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W722_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W722_Lane2" name="Dept Supervisor">
        <bpmn:flowNodeRef>W722_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W722_Lane3" name="Sales Associate">
        <bpmn:flowNodeRef>W722_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W722_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W722_Start5" name="Store opening per W5A; or weather event affecting exterior displays">
        <bpmn:outgoing>W722_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W722_Task6" name="Morning exterior inspection">
        <bpmn:documentation>Step 1: Morning exterior inspection: before store opening per W5A, Stock Associate or Department Supervisor inspects exterior area: (a) check for overnight damage: vandalism, theft evidence, storm damage, animal disturbance; (b) check plant health: wilting, pest infestation, sun damage; water plants as needed; (c) check display stability: outdoor fixtures secured against wind, lumber stacks stable per W3B; (d) check safety hazards: standing water after rain, slippery surfaces, blocked drainage, loose pavers; (e) check signage: exterior promotional signage intact and current, price tags weather-resistant; (f) report issues to Store Manager for resolution
Responsible (R): Stock Associate / Dept Supervisor
Accountable (A): Store Manager
Duration: 15-20 min</bpmn:documentation>
        <bpmn:incoming>W722_Flow14</bpmn:incoming>
        <bpmn:outgoing>W722_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W722_Task7" name="Display setup and merchandising">
        <bpmn:documentation>Step 2: Display setup and merchandising: Stock Associate sets up exterior displays: (a) position seasonal promotional displays per W583 merchandising plan; (b) arrange garden plants for maximum visual appeal and accessibility; (c) set up any vendor demonstration areas per W721 if applicable; (d) ensure all exterior items have weather-resistant price tags or signage per W181; (e) verify outdoor lighting is functional for evening display visibility
Responsible (R): Stock Associate
Accountable (A): Dept Supervisor
Duration: 20-30 min</bpmn:documentation>
        <bpmn:incoming>W722_Flow15</bpmn:incoming>
        <bpmn:outgoing>W722_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W722_Task8" name="Weather-responsive operations">
        <bpmn:documentation>Step 3: Weather-responsive operations: throughout the day, Department Supervisor monitors weather conditions: (a) if rain approaching: (i) move vulnerable items (electrical, metal prone to rust, cardboard-packaged goods) under cover; (ii) secure lightweight items against wind; (iii) deploy non-slip mats at entry points; (iv) ensure drainage channels are clear; (b) if extreme heat: (i) increase plant watering frequency; (ii) move heat-sensitive items to shade; (iii) ensure outdoor staff take hydration breaks per W720 safety briefing; (c) if typhoon warning per W576: activate full exterior protection protocol
Responsible (R): Dept Supervisor
Accountable (A): Store Manager
Duration: 10-15 min per weather event</bpmn:documentation>
        <bpmn:incoming>W722_Flow16</bpmn:incoming>
        <bpmn:outgoing>W722_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W722_Task9" name="Customer assistance in exterior area">
        <bpmn:documentation>Step 4: Customer assistance in exterior area: Sales Associate provides customer service in exterior/garden area: (a) assist customers with plant selection and care advice; (b) help customers load bulky exterior items (pavers, outdoor furniture, lumber) per W438 yard loading operations; (c) guide customers on quantity calculations for garden and outdoor projects; (d) for live plants: provide care instructions and guarantee terms; (e) alert Stock Associate for replenishment when exterior stock runs low
Responsible (R): Sales Associate
Accountable (A): Dept Supervisor
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W722_Flow17</bpmn:incoming>
        <bpmn:outgoing>W722_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W722_Task10" name="End-of-day exterior close-down">
        <bpmn:documentation>Step 5: End-of-day exterior close-down: before store closing per W574: (a) secure exterior area: lock gates, bring high-value portable items inside; (b) final plant watering if needed; (c) cover vulnerable displays with weather protection if overnight rain forecast; (d) turn off exterior display lighting; (e) check for any items that need markdown due to weather damage or plant decline per W93; (f) Department Supervisor logs exterior area status in daily closing report
Responsible (R): Stock Associate / Dept Supervisor
Accountable (A): Store Manager
Duration: 15-20 min</bpmn:documentation>
        <bpmn:incoming>W722_Flow18</bpmn:incoming>
        <bpmn:outgoing>W722_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W722_End11" name="Complete">
        <bpmn:incoming>W722_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W722_Annotation12">
        <bpmn:text>Controls: - CTL-260 (ensure controlled execution — Store Facility &amp; Safety (PA-07.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Department Supervisor (Garden/Outdoor)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W722_Assoc13" sourceRef="W722_Annotation12" targetRef="W722_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W722_Flow14" sourceRef="W722_Start5" targetRef="W722_Task6" />
      <bpmn:sequenceFlow id="W722_Flow15" sourceRef="W722_Task6" targetRef="W722_Task7" />
      <bpmn:sequenceFlow id="W722_Flow16" sourceRef="W722_Task7" targetRef="W722_Task8" />
      <bpmn:sequenceFlow id="W722_Flow17" sourceRef="W722_Task8" targetRef="W722_Task9" />
