        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W504_Start6" name="Content schedule update from HQ marketing; new promotional campaign; ad-hoc content…">
        <bpmn:outgoing>W504_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W504_Task7" name="Marketing Content Manager creates digital signage content schedule: assigns…">
        <bpmn:documentation>Step 1: Marketing Content Manager creates digital signage content schedule: assigns content to screen zones (entrance, aisle endcaps, checkout area, lumber yard, garden center, paint section, service desk) and time slots
Responsible (R): Content Manager
Accountable (A): CMO
Duration: 2 hours/week</bpmn:documentation>
        <bpmn:incoming>W504_Flow19</bpmn:incoming>
        <bpmn:outgoing>W504_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W504_Task8" name="Creative Team produces zone-specific content: promotional videos, product…">
        <bpmn:documentation>Step 2: Creative Team produces zone-specific content: promotional videos, product spotlights, price highlights, brand ads, seasonal themes, safety reminders, store hours
Responsible (R): Creative Team
Accountable (A): Content Manager
Duration: Per campaign</bpmn:documentation>
        <bpmn:incoming>W504_Flow20</bpmn:incoming>
        <bpmn:outgoing>W504_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W504_Task9" name="Content Manager uploads content to digital signage content management system…">
        <bpmn:documentation>Step 3: Content Manager uploads content to digital signage content management system (CMS); assigns to store clusters, zones, and schedule
Responsible (R): Content Manager
Accountable (A): —
Duration: 1 hour/week</bpmn:documentation>
        <bpmn:incoming>W504_Flow21</bpmn:incoming>
        <bpmn:outgoing>W504_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W504_Task10" name="System validates content: resolution compliance per screen type, duration…">
        <bpmn:documentation>Step 4: System validates content: resolution compliance per screen type, duration limits, brand guideline compliance (colors, fonts, logos), DOH/DTI-required health/safety notice inclusion
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W504_Flow22</bpmn:incoming>
        <bpmn:outgoing>W504_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W504_Task11" name="System distributes content to store endpoints during off-peak hours…">
        <bpmn:documentation>Step 5: System distributes content to store endpoints during off-peak hours (overnight); confirms download and activation per screen per store
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W504_Flow23</bpmn:incoming>
        <bpmn:outgoing>W504_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W504_Task12" name="System captures automated screenshots of each screen per store at random…">
        <bpmn:documentation>Step 6: System captures automated screenshots of each screen per store at random intervals (3x/day); flags screens showing error, offline, or incorrect content for IT Support follow-up
Responsible (R): System
Accountable (A): IT Support
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W504_Flow24</bpmn:incoming>
        <bpmn:outgoing>W504_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W504_Task13" name="Store Manager submits ad-hoc content change request (e.g., local event…">
        <bpmn:documentation>Step 7: Store Manager submits ad-hoc content change request (e.g., local event promotion, store-specific announcement); request routed to Content Manager for approval and production
Responsible (R): Store Manager
Accountable (A): Content Manager
Duration: 15 min/request</bpmn:documentation>
        <bpmn:incoming>W504_Flow25</bpmn:incoming>
        <bpmn:outgoing>W504_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W504_Task14" name="Monthly: Content Manager reviews playback compliance dashboard: content uptime…">
        <bpmn:documentation>Step 8: Monthly: Content Manager reviews playback compliance dashboard: content uptime per screen, content rotation adherence, error rate by store; identifies chronic problem screens for IT maintenance (W265)
Responsible (R): Content Manager
Accountable (A): CMO
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W504_Flow26</bpmn:incoming>
        <bpmn:outgoing>W504_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W504_Task15" name="Quarterly: Content Manager reviews content effectiveness with campaign team…">
        <bpmn:documentation>Step 9: Quarterly: Content Manager reviews content effectiveness with campaign team: dwell time at endcap screens, campaign performance lift at digital signage stores vs. non-digital
Responsible (R): Content Manager
Accountable (A): VP Marketing
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W504_Flow27</bpmn:incoming>
        <bpmn:outgoing>W504_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W504_End16" name="Complete">
        <bpmn:incoming>W504_Flow28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W504_Annotation17">
        <bpmn:text>Controls: - CTL-260 (ensure controlled execution — Store Facility &amp; Safety (PA-07.2).) | - operational: playback compliance monitoring and POS hardware maintenance workflow (W265); operational: content validation and integration with pricing master (W289); operational: overnight distribution during off-peak and content pre-caching
Owner: Marketing Content Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W504_Assoc18" sourceRef="W504_Annotation17" targetRef="W504_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W504_Flow19" sourceRef="W504_Start6" targetRef="W504_Task7" />
      <bpmn:sequenceFlow id="W504_Flow20" sourceRef="W504_Task7" targetRef="W504_Task8" />
      <bpmn:sequenceFlow id="W504_Flow21" sourceRef="W504_Task8" targetRef="W504_Task9" />
      <bpmn:sequenceFlow id="W504_Flow22" sourceRef="W504_Task9" targetRef="W504_Task10" />
      <bpmn:sequenceFlow id="W504_Flow23" sourceRef="W504_Task10" targetRef="W504_Task11" />
      <bpmn:sequenceFlow id="W504_Flow24" sourceRef="W504_Task11" targetRef="W504_Task12" />
      <bpmn:sequenceFlow id="W504_Flow25" sourceRef="W504_Task12" targetRef="W504_Task13" />
      <bpmn:sequenceFlow id="W504_Flow26" sourceRef="W504_Task13" targetRef="W504_Task14" />
      <bpmn:sequenceFlow id="W504_Flow27" sourceRef="W504_Task14" targetRef="W504_Task15" />
      <bpmn:sequenceFlow id="W504_Flow28" sourceRef="W504_Task15" targetRef="W504_End16" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W504_diag">
      <bpmndi:BPMNPlane id="W504_plane" bpmnElement="W_W504">
