    <bpmn:process id="W_W501" name="W501. Store-Level First Aid &amp; Medical Emergency Response" isExecutable="false">
      <bpmn:documentation>Trigger: Customer or employee medical emergency in store; or scheduled first aid kit audit
Frequency: Ad hoc (emergencies: ~20–30 incidents/month across 200 stores); quarterly kit audits
Volume: ~1 emergency per store per 6–9 months; 200 stores × 4 quarterly audits = 800 audits/year
Owner: Store Manager
Participants: Certified First Aider, Store Manager, HR Coordinator, Safety Officer
Source: workflow W501 — Store-Level First Aid &amp; Medical Emergency Response</bpmn:documentation>
      <bpmn:laneSet id="W501_LaneSet5">
        <bpmn:lane id="W501_Lane1" name="First Aider">
        <bpmn:flowNodeRef>W501_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W501_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W501_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W501_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W501_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W501_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W501_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W501_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W501_Lane3" name="System">
        <bpmn:flowNodeRef>W501_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W501_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W501_Lane4" name="Safety Officer">
        <bpmn:flowNodeRef>W501_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W501_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W501_Start6" name="Customer or employee medical emergency in store; or scheduled first aid kit audit">
        <bpmn:outgoing>W501_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W501_Task7" name="Certified First Aider responds to medical emergency; assesses situation…">
        <bpmn:documentation>Step 1: Certified First Aider responds to medical emergency; assesses situation (conscious/unconscious, breathing, bleeding, seizure, cardiac, allergic reaction); activates store emergency protocol if severe
Responsible (R): First Aider
Accountable (A): Store Manager
Duration: 5 min initial</bpmn:documentation>
        <bpmn:incoming>W501_Flow19</bpmn:incoming>
        <bpmn:outgoing>W501_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W501_Task8" name="If severe emergency: First Aider directs colleague to call local emergency…">
        <bpmn:documentation>Step 2: If severe emergency: First Aider directs colleague to call local emergency services (911 or local hospital); assigns colleague to meet ambulance at store entrance and clear path
Responsible (R): First Aider
Accountable (A): Store Manager
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W501_Flow20</bpmn:incoming>
        <bpmn:outgoing>W501_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W501_Task9" name="First Aider administers first aid per training protocol: CPR/AED if cardiac…">
        <bpmn:documentation>Step 3: First Aider administers first aid per training protocol: CPR/AED if cardiac, pressure for bleeding, recovery position for unconscious breathing patient, epinephrine auto-injector if anaphylaxis (employee only, if prescribed)
Responsible (R): First Aider
Accountable (A): Store Manager
Duration: Variable</bpmn:documentation>
        <bpmn:incoming>W501_Flow21</bpmn:incoming>
        <bpmn:outgoing>W501_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W501_Task10" name="Store Manager notifies HR Coordinator of employee medical emergency; for…">
        <bpmn:documentation>Step 4: Store Manager notifies HR Coordinator of employee medical emergency; for customer emergencies, Store Manager contacts insurance coordinator if liability claim may arise (W285)
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W501_Flow22</bpmn:incoming>
        <bpmn:outgoing>W501_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W501_Task11" name="First Aider completes first aid incident report in system: date/time, location…">
        <bpmn:documentation>Step 5: First Aider completes first aid incident report in system: date/time, location in store, individual type (customer/employee), nature of emergency, first aid administered, outcome, whether ambulance called
Responsible (R): First Aider
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W501_Flow23</bpmn:incoming>
        <bpmn:outgoing>W501_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W501_Task12" name="System routes incident report: employee incidents → HR for DOLE reporting…">
        <bpmn:documentation>Step 6: System routes incident report: employee incidents → HR for DOLE reporting (W436); customer incidents → Legal/Insurance for potential liability (W285); all incidents → Safety Officer for trend analysis
Responsible (R): System
Accountable (A): Safety Officer
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W501_Flow24</bpmn:incoming>
        <bpmn:outgoing>W501_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W501_Task13" name="Monthly: Safety Officer reviews first aid incident register across stores…">
        <bpmn:documentation>Step 7: Monthly: Safety Officer reviews first aid incident register across stores; identifies patterns (specific zones, times, causes); recommends preventive measures
Responsible (R): Safety Officer
Accountable (A): COO
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W501_Flow25</bpmn:incoming>
        <bpmn:outgoing>W501_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W501_Task14" name="Quarterly: First Aider conducts first aid kit audit per DOLE-prescribed…">
        <bpmn:documentation>Step 8: Quarterly: First Aider conducts first aid kit audit per DOLE-prescribed contents checklist; records stock levels; submits restocking request through system
Responsible (R): First Aider
Accountable (A): Store Manager
Duration: 30 min/store</bpmn:documentation>
        <bpmn:incoming>W501_Flow26</bpmn:incoming>
        <bpmn:outgoing>W501_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W501_Task15" name="System generates restocking order for items below minimum threshold; routes to…">
        <bpmn:documentation>Step 9: System generates restocking order for items below minimum threshold; routes to procurement (W136) for replenishment
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W501_Flow27</bpmn:incoming>
        <bpmn:outgoing>W501_Flow28</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W501_End16" name="Complete">
        <bpmn:incoming>W501_Flow28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W501_Annotation17">
        <bpmn:text>Controls: - CTL-260 (ensure controlled execution — Store Facility &amp; Safety (PA-07.2).) | - operational: requiring ≥2 certified first aiders per store at all times (minimum from 29-person staff); operational: quarterly AED test and battery check as part of kit audit; operational: proper incident documentation and trained first aiders
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W501_Assoc18" sourceRef="W501_Annotation17" targetRef="W501_Start6" associationDirection="None" />
