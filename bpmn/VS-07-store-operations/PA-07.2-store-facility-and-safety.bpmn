    <bpmn:process id="W_W502" name="W502. Store-Level Non-Hazardous Waste Management" isExecutable="false">
      <bpmn:documentation>Trigger: Daily waste accumulation at store; scheduled waste hauler pickup; monthly waste volume reporting
Frequency: Daily waste handling per store; scheduled hauler pickup (2–3x/week); monthly reporting
Volume: ~200–400 kg/store/week (cardboard ~50%, plastic packaging ~15%, wood scrap ~10%, general waste ~25%); 200 stores × ~40,000–80,000 kg/week total (~40–80 MT/week)
Owner: Store Manager
Participants: Maintenance/Utility Staff, Waste Hauler Vendor, Facilities Coordinator
Source: workflow W502 — Store-Level Non-Hazardous Waste Management</bpmn:documentation>
      <bpmn:laneSet id="W502_LaneSet5">
        <bpmn:lane id="W502_Lane1" name="Maintenance Staff">
        <bpmn:flowNodeRef>W502_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W502_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W502_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W502_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W502_Lane2" name="System">
        <bpmn:flowNodeRef>W502_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W502_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W502_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W502_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W502_Lane4" name="Facilities Coordinator">
        <bpmn:flowNodeRef>W502_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W502_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W502_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W502_Start6" name="Daily waste accumulation at store; scheduled waste hauler pickup; monthly waste volume…">
        <bpmn:outgoing>W502_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W502_Task7" name="Maintenance/Utility Staff segregates waste into designated bins per waste…">
        <bpmn:documentation>Step 1: Maintenance/Utility Staff segregates waste into designated bins per waste stream: cardboard (baled), plastic packaging, wood/lumber scrap, general waste, organic waste (garden centers)
Responsible (R): Maintenance Staff
Accountable (A): Store Manager
Duration: 30 min/day</bpmn:documentation>
        <bpmn:incoming>W502_Flow18</bpmn:incoming>
        <bpmn:outgoing>W502_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W502_Task8" name="For cardboard: Maintenance Staff operates cardboard baler; bales are stored for…">
        <bpmn:documentation>Step 2: For cardboard: Maintenance Staff operates cardboard baler; bales are stored for hauler pickup; system tracks bale count and estimated weight per bale
Responsible (R): Maintenance Staff
Accountable (A): Store Manager
Duration: 15 min/day</bpmn:documentation>
        <bpmn:incoming>W502_Flow19</bpmn:incoming>
        <bpmn:outgoing>W502_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W502_Task9" name="Waste hauler arrives per schedule (2–3x/week); Maintenance Staff records waste…">
        <bpmn:documentation>Step 3: Waste hauler arrives per schedule (2–3x/week); Maintenance Staff records waste collected by stream: estimated weight per type, hauler truck plate, driver name
Responsible (R): Maintenance Staff
Accountable (A): Store Manager
Duration: 15 min/pickup</bpmn:documentation>
        <bpmn:incoming>W502_Flow20</bpmn:incoming>
        <bpmn:outgoing>W502_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W502_Task10" name="System captures waste collection data: auto-calculates monthly waste volume per…">
        <bpmn:documentation>Step 4: System captures waste collection data: auto-calculates monthly waste volume per store by stream; compares against waste budget allocation
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W502_Flow21</bpmn:incoming>
        <bpmn:outgoing>W502_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W502_Task11" name="For recyclable streams (cardboard, plastic): system calculates recycling…">
        <bpmn:documentation>Step 5: For recyclable streams (cardboard, plastic): system calculates recycling revenue based on prevailing market rate per kg; revenue posted to store P&amp;L as waste recycling income
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W502_Flow22</bpmn:incoming>
        <bpmn:outgoing>W502_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W502_Task12" name="Monthly: Store Manager reviews waste volume report; identifies stores with…">
        <bpmn:documentation>Step 6: Monthly: Store Manager reviews waste volume report; identifies stores with waste volume exceeding baseline by &gt;20%; initiates root cause investigation (over-packaging from vendor, receiving practices)
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W502_Flow23</bpmn:incoming>
        <bpmn:outgoing>W502_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W502_Task13" name="Quarterly: Facilities Coordinator reviews waste hauler vendor performance…">
        <bpmn:documentation>Step 7: Quarterly: Facilities Coordinator reviews waste hauler vendor performance (pickup reliability, contamination rejection rate, cost per kg); feeds into vendor review (W242)
Responsible (R): Facilities Coordinator
Accountable (A): COO
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W502_Flow24</bpmn:incoming>
        <bpmn:outgoing>W502_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W502_Task14" name="Annually: Facilities Coordinator sets waste reduction targets per store…">
        <bpmn:documentation>Step 8: Annually: Facilities Coordinator sets waste reduction targets per store; cardboard recycling target ≥90%; overall waste-to-landfill reduction target; tracks against ESG metrics (W192)
Responsible (R): Facilities Coordinator
Accountable (A): COO
Duration: 4 hours/year</bpmn:documentation>
        <bpmn:incoming>W502_Flow25</bpmn:incoming>
        <bpmn:outgoing>W502_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W502_End15" name="Complete">
        <bpmn:incoming>W502_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W502_Annotation16">
        <bpmn:text>Controls: - CTL-260 (ensure controlled execution — Store Facility &amp; Safety (PA-07.2).) | - operational: backup hauler arrangement and hauler SLA in vendor contract; operational: increasing pickup frequency during peak periods; operational: proper bin signage and staff training
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
