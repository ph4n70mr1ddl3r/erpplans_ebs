    <bpmn:process id="W_W1047" name="W1047. Store-Level Rainy Season Floor Safety, Anti-Slip Mat &amp; Entrance Canopy Management" isExecutable="false">
      <bpmn:documentation>Trigger: Philippine rainy season onset (June–November, per PAGASA); or continuous rainfall for ≥2 hours at store location; or customer slip incident near entrance
Frequency: Daily during rainy season (June–November); ~180 days/year across the 200-store chain
Volume: 1 deployment per store per rainy day; ongoing maintenance during rainy season
Owner: Store Manager
Participants: Maintenance/Utility Staff, Sales Associates, Customer Service Rep, LP Officer
Source: workflow W1047 — Store-Level Rainy Season Floor Safety, Anti-Slip Mat &amp; Entrance Canopy Management</bpmn:documentation>
      <bpmn:laneSet id="W1047_LaneSet4">
        <bpmn:lane id="W1047_Lane1" name="Maintenance">
        <bpmn:flowNodeRef>W1047_Task6</bpmn:flowNodeRef>
