    <bpmn:process id="W_W601" name="W601. Store-Level Daily HR Operations &amp; People Management" isExecutable="false">
      <bpmn:documentation>Trigger: Start of store business day; ongoing throughout operating hours
Frequency: Daily per store
Volume: ~29 employees per store; 200 stores
Owner: Store Manager
Participants: Store Manager, Department Supervisors, employees, HR Coordinator (HQ)
Source: workflow W601 — Store-Level Daily HR Operations &amp; People Management</bpmn:documentation>
      <bpmn:laneSet id="W601_LaneSet5">
        <bpmn:lane id="W601_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W601_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W601_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W601_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W601_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W601_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W601_Lane2" name="Department Supervisor">
        <bpmn:flowNodeRef>W601_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W601_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W601_Lane3" name="Employee">
        <bpmn:flowNodeRef>W601_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W601_Lane4" name="System">
        <bpmn:flowNodeRef>W601_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W601_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W601_Start6" name="Start of store business day; ongoing throughout operating hours">
        <bpmn:outgoing>W601_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W601_Task7" name="Store Manager reviews daily attendance report from biometric/RFID system…">
        <bpmn:documentation>Step 1: Store Manager reviews daily attendance report from biometric/RFID system; identifies absences, late arrivals, and missing punches
Responsible (R): Store Manager
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W601_Flow18</bpmn:incoming>
        <bpmn:outgoing>W601_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W601_Task8" name="For unplanned absences: Department Supervisor contacts employee to determine…">
        <bpmn:documentation>Step 2: For unplanned absences: Department Supervisor contacts employee to determine reason (sick leave, emergency, AWOL); system auto-flags &quot;absent without notification&quot; if no contact by 1 hour after shift start
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W601_Flow19</bpmn:incoming>
        <bpmn:outgoing>W601_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W601_Task9" name="Leave approval for same-day requests: Store Manager approves/denies based on…">
        <bpmn:documentation>Step 3: Leave approval for same-day requests: Store Manager approves/denies based on department coverage; emergency leave auto-approved per policy; system updates attendance record and payroll input
Responsible (R): Store Manager
Accountable (A): —
Duration: 3 min/request</bpmn:documentation>
        <bpmn:incoming>W601_Flow20</bpmn:incoming>
        <bpmn:outgoing>W601_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W601_Task10" name="Overtime authorization: Department Supervisor submits overtime request with…">
        <bpmn:documentation>Step 4: Overtime authorization: Department Supervisor submits overtime request with business justification (unexpected customer traffic, delivery backlog, inventory count); Store Manager approves/denies; system tracks overtime budget utilization vs. monthly allocation per W602
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W601_Flow21</bpmn:incoming>
        <bpmn:outgoing>W601_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W601_Task11" name="Shift swap requests: Employee A initiates swap with Employee B (same skill…">
        <bpmn:documentation>Step 5: Shift swap requests: Employee A initiates swap with Employee B (same skill set); both confirm; Department Supervisor verifies coverage; Store Manager approves; system updates schedule and attendance rules
Responsible (R): Employee
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W601_Flow22</bpmn:incoming>
        <bpmn:outgoing>W601_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W601_Task12" name="Employee relations quick-check: Store Manager conducts brief check-in with any…">
        <bpmn:documentation>Step 6: Employee relations quick-check: Store Manager conducts brief check-in with any employee flagged for attendance issues, performance concerns (per W72), or personal matters affecting work; documents outcome
Responsible (R): Store Manager
Accountable (A): —
Duration: 5 min/employee</bpmn:documentation>
        <bpmn:incoming>W601_Flow23</bpmn:incoming>
        <bpmn:outgoing>W601_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W601_Task13" name="System generates daily HR summary: attendance rate, overtime hours, leave…">
        <bpmn:documentation>Step 7: System generates daily HR summary: attendance rate, overtime hours, leave usage, open HR action items; auto-submits to Regional Manager HR dashboard
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W601_Flow24</bpmn:incoming>
        <bpmn:outgoing>W601_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W601_Task14" name="Weekly (Fridays): Store Manager reviews upcoming week schedule for coverage…">
        <bpmn:documentation>Step 8: Weekly (Fridays): Store Manager reviews upcoming week schedule for coverage gaps; submits schedule change requests to HR Coordinator; confirms weekend staffing adequacy
Responsible (R): Store Manager
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W601_Flow25</bpmn:incoming>
        <bpmn:outgoing>W601_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W601_End15" name="Complete">
        <bpmn:incoming>W601_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W601_Annotation16">
        <bpmn:text>Controls: - CTL-262 (ensure controlled execution — Store Staffing &amp; People (PA-07.4).) | - operational: backup RFID badge scanning; operational: real-time overtime budget tracking in Step 4
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
