    <bpmn:process id="W_W1030" name="W1030. Multi-Store District Manager Weekly Operations Review &amp; Compliance Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly scheduled review (every Monday); also triggered by significant operational incident
Frequency: Weekly × ~10–15 district managers (200 stores ÷ ~15 stores per district)
Volume: 15 stores per district manager per week
Owner: District Manager (Regional Operations Manager)
Participants: Store Managers (15 per district), LP Officer, HR Business Partner, Finance Analyst
Source: workflow W1030 — Multi-Store District Manager Weekly Operations Review &amp; Compliance Audit</bpmn:documentation>
      <bpmn:laneSet id="W1030_LaneSet2">
        <bpmn:lane id="W1030_Lane1" name="District Manager">
        <bpmn:flowNodeRef>W1030_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1030_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1030_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1030_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1030_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1030_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1030_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1030_Start3" name="Weekly scheduled review (every Monday); also triggered by significant operational incident">
        <bpmn:outgoing>W1030_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1030_Task4" name="Monday Morning District Dashboard Review">
        <bpmn:documentation>Step 1: Monday Morning District Dashboard Review: DM reviews BI dashboard for all 15 stores in district: (a) Sales performance: week-over-week revenue, ATV, units per transaction, sales vs. budget, sales per sqm; red-flag stores &gt; 10% below budget for 2+ consecutive weeks; (b) Inventory health: stockout rate by category, overstock alerts, replenishment order fill rate from DC, shrinkage trend; (c) Customer experience: customer satisfaction score (daily pulse from W608), NPS trend, complaint count and resolution time per W597; (d) Labor: overtime hours, labor cost as % of sales, attendance rate, unfilled positions; (e) Cash &amp; financial: cash variance per W958, petty cash balance, bank deposit timeliness per W541; (f) Compliance: planogram compliance score (W573), price accuracy (W667), safety incident count (W140); (g) DM identifies 2–3 stores requiring priority visit this week based on performance outliers
Responsible (R): District Manager
Accountable (A): COO
Duration: 60–90 min</bpmn:documentation>
        <bpmn:incoming>W1030_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1030_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1030_Task5" name="Store Visit &amp; Structured Audit (2–3 stores/day, Tue–Thu)">
        <bpmn:documentation>Step 2: Store Visit &amp; Structured Audit (2–3 stores/day, Tue–Thu): DM visits selected stores with standardized audit checklist on tablet: (a) Store exterior: parking lot cleanliness, signage condition, cart corral (W1028), garden center appearance (W722), security lighting; (b) Store entrance: welcome experience, promotional signage per W262, loyalty program visibility, basket/cart availability; (c) Selling floor: planogram compliance (check 3 random aisles per W573), shelf stock level (identify 5 empty shelf positions), pricing accuracy (scan 10 random items per W667), promotional display execution per W262, cleanliness and aisle obstruction; (d) Backroom: receiving area organization, damaged goods quarantine area (W91), hazmat storage compliance (W236), cycle count documentation (W6); (e) Customer service counter: BOPIS staging area (W11), return processing compliance (W12), queue management; (f) Cash office: safe count vs. system per W764, deposit preparation per W541, POS reconciliation documentation; (g) Safety: fire extinguisher inspection tags (W758), emergency exit clearance, PPE compliance in lumber yard; (h) People: observe 2–3 employee-customer interactions, check staff scheduling board, discuss any HR issues with Store Manager
Responsible (R): District Manager
Accountable (A): COO
Duration: 90–120 min per store</bpmn:documentation>
        <bpmn:incoming>W1030_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1030_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1030_Task6" name="Store Manager Coaching &amp; Action Plan">
        <bpmn:documentation>Step 3: Store Manager Coaching &amp; Action Plan: During store visit, DM conducts 15–20 minute coaching session with Store Manager: (a) review Store Manager&#x27;s weekly self-assessment per W575; (b) discuss top 3 performance gaps identified in dashboard and audit; (c) agree on 2–3 specific action items with deadlines (typically 1–2 weeks); (d) for high-performing stores: recognize achievements, capture best practices for sharing across district; (e) for underperforming stores: develop improvement plan with weekly checkpoints; (f) for new stores (&lt; 6 months old): accelerated coaching per W702 (New Store Opening) milestones; (g) document coaching notes in system for follow-up tracking
Responsible (R): District Manager
Accountable (A): Store Manager
Duration: 15–20 min per store</bpmn:documentation>
        <bpmn:incoming>W1030_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1030_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1030_Task7" name="LP &amp; Compliance Follow-Up">
        <bpmn:documentation>Step 4: LP &amp; Compliance Follow-Up: DM reviews loss prevention exceptions with LP Officer: (a) exception-based reporting alerts per W837: high-risk transactions, void/refund patterns, cash handling anomalies; (b) CCTV incident review per W838: any flagged events requiring investigation; (c) shrinkage investigation status: open cases per W845 and resolution timeline; (d) compliance issues from audit: pricing errors, planogram violations, safety deficiencies; (e) DM and LP Officer agree on corrective actions and escalation for serious issues (theft investigation per W839, fraud per W841)
Responsible (R): District Manager / LP Officer
Accountable (A): COO
Duration: 15–30 min/week</bpmn:documentation>
        <bpmn:incoming>W1030_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1030_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1030_Task8" name="Friday Summary Report &amp; HQ Communication">
        <bpmn:documentation>Step 5: Friday Summary Report &amp; HQ Communication: DM compiles weekly district summary: (a) district sales performance: total revenue, vs. budget, vs. last year, top 3 and bottom 3 stores; (b) audit findings summary: common issues across stores, systemic problems requiring HQ intervention; (c) action items from store visits with status (new/in-progress/completed); (d) resource requests: staffing (W555), capital (W21), maintenance (W47), or vendor issues; (e) competitive intelligence: any competitor activity observed during store visits (new store opening, aggressive pricing per W329); (f) submit report to COO via standardized template; (g) participate in weekly DM conference call with COO and other DMs (30 min): share cross-district learnings, escalate systemic issues, align on priorities
Responsible (R): District Manager
Accountable (A): COO
Duration: 60–90 min</bpmn:documentation>
        <bpmn:incoming>W1030_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1030_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1030_End9" name="Complete">
        <bpmn:incoming>W1030_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1030_Annotation10">
        <bpmn:text>Controls: - CTL-262 (ensure controlled execution — Store Staffing &amp; People (PA-07.4).) | - operational: District Manager (Regional Operations Manager) review and approval gate; operational: periodic reconciliation against source documents
Owner: District Manager (Regional Operations Manager)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1030_Assoc11" sourceRef="W1030_Annotation10" targetRef="W1030_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W1030_Flow12" sourceRef="W1030_Start3" targetRef="W1030_Task4" />
      <bpmn:sequenceFlow id="W1030_Flow13" sourceRef="W1030_Task4" targetRef="W1030_Task5" />
      <bpmn:sequenceFlow id="W1030_Flow14" sourceRef="W1030_Task5" targetRef="W1030_Task6" />
      <bpmn:sequenceFlow id="W1030_Flow15" sourceRef="W1030_Task6" targetRef="W1030_Task7" />
      <bpmn:sequenceFlow id="W1030_Flow16" sourceRef="W1030_Task7" targetRef="W1030_Task8" />
      <bpmn:sequenceFlow id="W1030_Flow17" sourceRef="W1030_Task8" targetRef="W1030_End9" />
    </bpmn:process>
