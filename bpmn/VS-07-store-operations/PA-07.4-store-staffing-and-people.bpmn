    <bpmn:process id="W_W609" name="W609. Store-Level New Employee Buddy System &amp; First-Week Onboarding" isExecutable="false">
      <bpmn:documentation>Trigger: New hire first day at store (following HQ onboarding per W15)
Frequency: As needed; ~1,200–1,600 new hires/year across 200 stores (~6–8 per store per year per profile §11.4)
Volume: 1 new hire per event; ~100–130 active buddy assignments at any time (~30-day window on ~1,200–1,600 hires/year)
Owner: Store Manager
Participants: New employee, assigned Buddy (experienced Sales Associate), Department Supervisor, Store Manager
Source: workflow W609 — Store-Level New Employee Buddy System &amp; First-Week Onboarding</bpmn:documentation>
      <bpmn:laneSet id="W609_LaneSet5">
        <bpmn:lane id="W609_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W609_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W609_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W609_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W609_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W609_Lane2" name="Buddy">
        <bpmn:flowNodeRef>W609_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W609_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W609_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W609_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W609_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W609_Lane3" name="New Hire">
        <bpmn:flowNodeRef>W609_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W609_Lane4" name="System">
        <bpmn:flowNodeRef>W609_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W609_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W609_Start6" name="New hire first day at store (following HQ onboarding per W15)">
        <bpmn:outgoing>W609_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W609_Task7" name="Prior to new hire arrival: Store Manager assigns Buddy from same department —…">
        <bpmn:documentation>Step 1: Prior to new hire arrival: Store Manager assigns Buddy from same department — selection criteria: ≥ 6 months tenure, performance rating ≥ satisfactory, completed Buddy training module; system checks Buddy eligibility and current assignment load (max 1 buddy at a time)
Responsible (R): Store Manager
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W609_Flow20</bpmn:incoming>
        <bpmn:outgoing>W609_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W609_Task8" name="Day 1">
        <bpmn:documentation>Step 2: Day 1: Buddy meets new hire at store entrance; provides store tour (selling floor, backroom, break room, emergency exits, first aid station, restrooms); introduces to all team members by name and role
Responsible (R): Buddy
Accountable (A): Dept. Supervisor
Duration: 60 min</bpmn:documentation>
        <bpmn:incoming>W609_Flow21</bpmn:incoming>
        <bpmn:outgoing>W609_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W609_Task9" name="Buddy guides new hire through department-specific orientation: product…">
        <bpmn:documentation>Step 3: Buddy guides new hire through department-specific orientation: product locations, top 20 selling SKUs, shelf layout, price tag reading, safety hazards specific to department (heavy items in lumber, chemicals in paint, sharp tools in hardware)
Responsible (R): Buddy
Accountable (A): Dept. Supervisor
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W609_Flow22</bpmn:incoming>
        <bpmn:outgoing>W609_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W609_Task10" name="Days 2-3">
        <bpmn:documentation>Step 4: Days 2-3: Buddy shadows and is shadowed — new hire observes Buddy handling customer interactions, POS transactions (if cashier), and department tasks; Buddy explains reasoning and shares tips; new hire attempts first customer interactions with Buddy present
Responsible (R): Buddy
Accountable (A): Dept. Supervisor
Duration: Full shift</bpmn:documentation>
        <bpmn:incoming>W609_Flow23</bpmn:incoming>
        <bpmn:outgoing>W609_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W609_Task11" name="Days 4-5">
        <bpmn:documentation>Step 5: Days 4-5: New hire handles customer interactions independently with Buddy available for questions; Department Supervisor conducts 15-minute check-in to assess comfort level and identify knowledge gaps
Responsible (R): New Hire / Dept. Supervisor
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W609_Flow24</bpmn:incoming>
        <bpmn:outgoing>W609_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W609_Task12" name="End of Week 1">
        <bpmn:documentation>Step 6: End of Week 1: Buddy completes first-week assessment form: new hire&#x27;s product knowledge (top 20 SKUs), customer interaction confidence, POS familiarity, safety awareness, areas needing improvement; Department Supervisor reviews and adds comments
Responsible (R): Buddy
Accountable (A): Dept. Supervisor
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W609_Flow25</bpmn:incoming>
        <bpmn:outgoing>W609_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W609_Task13" name="Store Manager reviews first-week assessment; schedules additional training for…">
        <bpmn:documentation>Step 7: Store Manager reviews first-week assessment; schedules additional training for identified gaps; if performance is below expectations, extends buddy period by 1 week with specific improvement targets
Responsible (R): Store Manager
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W609_Flow26</bpmn:incoming>
        <bpmn:outgoing>W609_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W609_Task14" name="Weeks 2-4">
        <bpmn:documentation>Step 8: Weeks 2-4: Buddy check-ins reduce to twice weekly; Department Supervisor conducts weekly progress assessment; by Week 4, new hire should meet basic competency thresholds per W518 (if cashier) or department standards
Responsible (R): Buddy / Dept. Supervisor
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W609_Flow27</bpmn:incoming>
        <bpmn:outgoing>W609_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W609_Task15" name="End of Month 1">
        <bpmn:documentation>Step 9: End of Month 1: Store Manager conducts formal 30-day review; if competency thresholds met, buddy assignment formally ends; if not met, remediation plan created with HR Coordinator; system updates employee record with onboarding completion status
Responsible (R): Store Manager
Accountable (A): HR Coordinator
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W609_Flow28</bpmn:incoming>
        <bpmn:outgoing>W609_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W609_Task16" name="System tracks buddy program metrics per store: average onboarding duration…">
        <bpmn:documentation>Step 10: System tracks buddy program metrics per store: average onboarding duration, 30-day competency pass rate, 90-day retention rate for buddy-supported hires vs. non-buddy; monthly report to HR Coordinator
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W609_Flow29</bpmn:incoming>
        <bpmn:outgoing>W609_Flow30</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W609_End17" name="Complete">
        <bpmn:incoming>W609_Flow30</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W609_Annotation18">
        <bpmn:text>Controls: - CTL-262 (ensure controlled execution — Store Staffing &amp; People (PA-07.4).) | - operational: mandatory Buddy training module and Store Manager selection oversight; operational: assigning backup Buddy and cross-training multiple eligible buddies per department
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W609_Assoc19" sourceRef="W609_Annotation18" targetRef="W609_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W609_Flow20" sourceRef="W609_Start6" targetRef="W609_Task7" />
      <bpmn:sequenceFlow id="W609_Flow21" sourceRef="W609_Task7" targetRef="W609_Task8" />
      <bpmn:sequenceFlow id="W609_Flow22" sourceRef="W609_Task8" targetRef="W609_Task9" />
      <bpmn:sequenceFlow id="W609_Flow23" sourceRef="W609_Task9" targetRef="W609_Task10" />
      <bpmn:sequenceFlow id="W609_Flow24" sourceRef="W609_Task10" targetRef="W609_Task11" />
      <bpmn:sequenceFlow id="W609_Flow25" sourceRef="W609_Task11" targetRef="W609_Task12" />
      <bpmn:sequenceFlow id="W609_Flow26" sourceRef="W609_Task12" targetRef="W609_Task13" />
      <bpmn:sequenceFlow id="W609_Flow27" sourceRef="W609_Task13" targetRef="W609_Task14" />
      <bpmn:sequenceFlow id="W609_Flow28" sourceRef="W609_Task14" targetRef="W609_Task15" />
      <bpmn:sequenceFlow id="W609_Flow29" sourceRef="W609_Task15" targetRef="W609_Task16" />
      <bpmn:sequenceFlow id="W609_Flow30" sourceRef="W609_Task16" targetRef="W609_End17" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W609_diag">
