    <bpmn:process id="W_W205" name="W205. Employee Purchase Program &amp; Internal Staff Sales" isExecutable="false">
      <bpmn:documentation>Trigger: Employee wishes to purchase merchandise for personal use
Frequency: Daily; ~1,000 transactions/month across group
Volume: Covers all 6,932+ employees
Owner: Store Manager / HR Manager
Participants: Employee (Buyer), Cashier, HR (for eligibility)
Source: workflow W205 — Employee Purchase Program &amp; Internal Staff Sales</bpmn:documentation>
      <bpmn:laneSet id="W205_LaneSet6">
        <bpmn:lane id="W205_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W205_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W205_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W205_Lane2" name="System">
        <bpmn:flowNodeRef>W205_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W205_Lane3" name="Employee">
        <bpmn:flowNodeRef>W205_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W205_Lane4" name="Store Manager">
        <bpmn:flowNodeRef>W205_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W205_Lane5" name="LP Analyst">
        <bpmn:flowNodeRef>W205_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W205_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W205_Start7" name="Employee wishes to purchase merchandise for personal use">
        <bpmn:outgoing>W205_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W205_Task8" name="Eligibility Check">
        <bpmn:documentation>Step 1: Eligibility Check: Employee presents ID at POS; System verifies active employment status and &quot;Monthly Purchase Limit&quot; (e.g., PHP 20,000/month)
Responsible (R): Cashier / System
Accountable (A): HR Manager
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W205_Flow16</bpmn:incoming>
        <bpmn:outgoing>W205_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W205_Task9" name="Discount Application">
        <bpmn:documentation>Step 2: Discount Application: System applies &quot;Staff Discount&quot; (e.g., Cost + 5% or 15% off SRP) based on product category rules
Responsible (R): System
Accountable (A): —
Duration: Real-time</bpmn:documentation>
        <bpmn:incoming>W205_Flow17</bpmn:incoming>
        <bpmn:outgoing>W205_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W205_Task10" name="Payment">
        <bpmn:documentation>Step 3: Payment: Employee pays via Cash, Card, or &quot;Payroll Deduction&quot; (W10/W76)
Responsible (R): Employee
Accountable (A): Cashier
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W205_Flow18</bpmn:incoming>
        <bpmn:outgoing>W205_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W205_Task11" name="Verification">
        <bpmn:documentation>Step 4: Verification: Manager signs receipt; confirms items are for personal use (not resale)
Responsible (R): Store Manager
Accountable (A): —
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W205_Flow19</bpmn:incoming>
        <bpmn:outgoing>W205_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W205_Task12" name="Audit">
        <bpmn:documentation>Step 5: Audit: LP Team reviews high-frequency staff purchases for potential abuse (W37)
Responsible (R): LP Analyst
Accountable (A): VP Legal
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W205_Flow20</bpmn:incoming>
        <bpmn:outgoing>W205_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W205_End13" name="Complete">
        <bpmn:incoming>W205_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W205_Annotation14">
        <bpmn:text>Controls: - CTL-262 (ensure controlled execution — Store Staffing &amp; People (PA-07.4).) | - operational: Store Manager / HR Manager review and approval gate
Owner: Store Manager / HR Manager</bpmn:text>
      </bpmn:textAnnotation>
