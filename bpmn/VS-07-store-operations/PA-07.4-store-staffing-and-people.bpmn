    <bpmn:process id="W_W603" name="W603. Store-Level Employee Disciplinary Process &amp; DOLE Due Process Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: Employee policy violation, attendance infraction, performance issue, misconduct, or customer complaint against employee
Frequency: As needed; estimated ~80–120 incidents/month across 200 stores
Volume: ~0.4-0.6 incidents per store per month
Owner: Store Manager
Participants: Store Manager, Department Supervisor, employee, HR Coordinator (HQ), HR Business Partner, witness(es)
Source: workflow W603 — Store-Level Employee Disciplinary Process &amp; DOLE Due Process Compliance</bpmn:documentation>
      <bpmn:laneSet id="W603_LaneSet7">
        <bpmn:lane id="W603_Lane1" name="Dept. Supervisor">
        <bpmn:flowNodeRef>W603_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W603_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W603_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W603_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W603_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W603_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W603_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W603_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W603_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W603_Lane3" name="Employee">
        <bpmn:flowNodeRef>W603_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W603_Lane4" name="HR Business Partner">
        <bpmn:flowNodeRef>W603_Task17</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W603_Lane5" name="System">
        <bpmn:flowNodeRef>W603_Task18</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W603_Lane6" name="HR Coordinator">
        <bpmn:flowNodeRef>W603_Task19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W603_End20</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W603_Start8" name="Employee policy violation, attendance infraction, performance issue, misconduct, or…">
        <bpmn:outgoing>W603_Flow23</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W603_Task9" name="Incident occurs or is reported: Department Supervisor or Store Manager…">
        <bpmn:documentation>Step 1: Incident occurs or is reported: Department Supervisor or Store Manager documents initial observation with date, time, location, nature of incident, witnesses; system creates disciplinary case record
Responsible (R): Dept. Supervisor / Store Manager
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W603_Flow23</bpmn:incoming>
        <bpmn:outgoing>W603_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W603_Task10" name="Store Manager conducts preliminary fact-finding: interviews employee…">
        <bpmn:documentation>Step 2: Store Manager conducts preliminary fact-finding: interviews employee, witnesses, reviews CCTV footage (per W207), reviews system transaction logs if POS-related
Responsible (R): Store Manager
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W603_Flow24</bpmn:incoming>
        <bpmn:outgoing>W603_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W603_Task11" name="Store Manager classifies offense severity per policy matrix: Minor (tardiness…">
        <bpmn:documentation>Step 3: Store Manager classifies offense severity per policy matrix: Minor (tardiness, dress code, minor policy violation), Moderate (insubordination, repeated minor offenses, customer service failure), Severe (theft, fraud, violence, safety violation, gross misconduct)
Responsible (R): Store Manager
Accountable (A): HR Coordinator
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W603_Flow25</bpmn:incoming>
        <bpmn:outgoing>W603_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W603_Task12" name="For Minor offenses — Verbal Warning">
        <bpmn:documentation>Step 4: For Minor offenses — Verbal Warning: Store Manager conducts private counseling with employee; documents verbal warning in system with date, nature, and improvement expectation; system tracks verbal warning count (3 verbal warnings = 1 written warning)
Responsible (R): Store Manager
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W603_Flow26</bpmn:incoming>
        <bpmn:outgoing>W603_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W603_Task13" name="For Moderate offenses or repeated Minor — Written Warning">
        <bpmn:documentation>Step 5: For Moderate offenses or repeated Minor — Written Warning: Store Manager drafts written notice of explanation (NTE) per DOLE two-notice rule; employee given 5 business days to submit written explanation; NTE references specific company policy violated and incident details
Responsible (R): Store Manager
Accountable (A): HR Coordinator
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W603_Flow27</bpmn:incoming>
        <bpmn:outgoing>W603_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W603_Task14" name="Employee submits written explanation or waives right to respond; Store Manager…">
        <bpmn:documentation>Step 6: Employee submits written explanation or waives right to respond; Store Manager and HR Coordinator evaluate explanation; if explanation is unsatisfactory, proceed to Step 7
Responsible (R): Employee / HR Coordinator
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W603_Flow28</bpmn:incoming>
        <bpmn:outgoing>W603_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W603_Task15" name="Notice of Decision (NOD)">
        <bpmn:documentation>Step 7: Notice of Decision (NOD): Store Manager issues written decision with disciplinary action: written warning, suspension (1-30 days per severity), or termination recommendation for severe offenses; HR Coordinator reviews for DOLE compliance before issuance
Responsible (R): Store Manager
Accountable (A): HR Business Partner
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W603_Flow29</bpmn:incoming>
        <bpmn:outgoing>W603_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W603_Task16" name="For Severe offenses — Preventive Suspension">
        <bpmn:documentation>Step 8: For Severe offenses — Preventive Suspension: If investigation requires more than 5 days, employee placed on preventive suspension (max 30 days per Labor Code) with pay; Store Manager coordinates with HR Business Partner for investigation
Responsible (R): Store Manager
Accountable (A): HR Business Partner
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W603_Flow30</bpmn:incoming>
        <bpmn:outgoing>W603_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W603_Task17" name="For termination cases">
        <bpmn:documentation>Step 9: For termination cases: HR Business Partner conducts independent review; ensures two-notice rule compliance, just cause per Article 297 Labor Code, and due process documentation; Legal Counsel reviews if employee is regular status; final termination decision by VP Legal &amp; Compliance
Responsible (R): HR Business Partner
Accountable (A): VP Legal
Duration: 60 min</bpmn:documentation>
        <bpmn:incoming>W603_Flow31</bpmn:incoming>
        <bpmn:outgoing>W603_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W603_Task18" name="All disciplinary actions recorded in employee master (W292) with immutable…">
        <bpmn:documentation>Step 10: All disciplinary actions recorded in employee master (W292) with immutable audit trail; system flags employees with active disciplinary actions for promotion/transfer eligibility check
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W603_Flow32</bpmn:incoming>
        <bpmn:outgoing>W603_Flow33</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W603_Task19" name="Monthly: HR Coordinator generates store-level disciplinary summary report…">
        <bpmn:documentation>Step 11: Monthly: HR Coordinator generates store-level disciplinary summary report; Regional Manager reviews for pattern analysis (specific stores with high incident rates may indicate management or training issues)
Responsible (R): HR Coordinator
Accountable (A): Regional Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W603_Flow33</bpmn:incoming>
        <bpmn:outgoing>W603_Flow34</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W603_End20" name="Complete">
        <bpmn:incoming>W603_Flow34</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W603_Annotation21">
        <bpmn:text>Controls: - CTL-262 (ensure controlled execution — Store Staffing &amp; People (PA-07.4).) | - operational: system-enforced workflow with mandatory NTE issuance before NOD; operational: policy matrix with offense severity classification and HR Coordinator review in Steps 5 and 7
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W603_Assoc22" sourceRef="W603_Annotation21" targetRef="W603_Start8" associationDirection="None" />
      <bpmn:sequenceFlow id="W603_Flow23" sourceRef="W603_Start8" targetRef="W603_Task9" />
      <bpmn:sequenceFlow id="W603_Flow24" sourceRef="W603_Task9" targetRef="W603_Task10" />
      <bpmn:sequenceFlow id="W603_Flow25" sourceRef="W603_Task10" targetRef="W603_Task11" />
      <bpmn:sequenceFlow id="W603_Flow26" sourceRef="W603_Task11" targetRef="W603_Task12" />
      <bpmn:sequenceFlow id="W603_Flow27" sourceRef="W603_Task12" targetRef="W603_Task13" />
      <bpmn:sequenceFlow id="W603_Flow28" sourceRef="W603_Task13" targetRef="W603_Task14" />
      <bpmn:sequenceFlow id="W603_Flow29" sourceRef="W603_Task14" targetRef="W603_Task15" />
      <bpmn:sequenceFlow id="W603_Flow30" sourceRef="W603_Task15" targetRef="W603_Task16" />
      <bpmn:sequenceFlow id="W603_Flow31" sourceRef="W603_Task16" targetRef="W603_Task17" />
      <bpmn:sequenceFlow id="W603_Flow32" sourceRef="W603_Task17" targetRef="W603_Task18" />
      <bpmn:sequenceFlow id="W603_Flow33" sourceRef="W603_Task18" targetRef="W603_Task19" />
      <bpmn:sequenceFlow id="W603_Flow34" sourceRef="W603_Task19" targetRef="W603_End20" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W603_diag">
      <bpmndi:BPMNPlane id="W603_plane" bpmnElement="W_W603">
        <bpmndi:BPMNShape id="W603_Lane1_di" bpmnElement="W603_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2630" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W603_Lane2_di" bpmnElement="W603_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="2630" height="170" /></bpmndi:BPMNShape>
