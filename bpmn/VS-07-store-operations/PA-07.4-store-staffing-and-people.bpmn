        <bpmndi:BPMNShape id="W603_Lane5_di" bpmnElement="W603_Lane5" isHorizontal="true"><dc:Bounds x="160" y="760" width="2630" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W603_Lane6_di" bpmnElement="W603_Lane6" isHorizontal="true"><dc:Bounds x="160" y="930" width="2630" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W603_Task9_di" bpmnElement="W603_Task9"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W603_Task10_di" bpmnElement="W603_Task10"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W603_Task11_di" bpmnElement="W603_Task11"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W603_Task12_di" bpmnElement="W603_Task12"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W603_Task13_di" bpmnElement="W603_Task13"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W603_Task14_di" bpmnElement="W603_Task14"><dc:Bounds x="1450" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W603_Task15_di" bpmnElement="W603_Task15"><dc:Bounds x="1660" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W603_Task16_di" bpmnElement="W603_Task16"><dc:Bounds x="1870" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W603_Task17_di" bpmnElement="W603_Task17"><dc:Bounds x="2080" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W603_Task18_di" bpmnElement="W603_Task18"><dc:Bounds x="2290" y="805" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W603_Task19_di" bpmnElement="W603_Task19"><dc:Bounds x="2500" y="975" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W603_Start8_di" bpmnElement="W603_Start8"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W603_End20_di" bpmnElement="W603_End20"><dc:Bounds x="2730" y="997" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W603_Annotation21_di" bpmnElement="W603_Annotation21"><dc:Bounds x="160" y="1140" width="360" height="86" /></bpmndi:BPMNShape>
