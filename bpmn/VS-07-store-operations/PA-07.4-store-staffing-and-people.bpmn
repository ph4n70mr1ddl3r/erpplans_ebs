    <bpmn:process id="W_W739" name="W739. Store-Level Daily Huddle &amp; Morning Team Briefing" isExecutable="false">
      <bpmn:documentation>Trigger: Store opening preparation (scheduled daily, 15 minutes before store opens)
Frequency: Daily per store
Volume: 200 stores × 1 huddle/day
Owner: Store Manager
Participants: All on-shift store associates, Department Supervisors, Store Manager
Source: workflow W739 — Store-Level Daily Huddle &amp; Morning Team Briefing</bpmn:documentation>
      <bpmn:laneSet id="W739_LaneSet4">
        <bpmn:lane id="W739_Lane1" name="System">
        <bpmn:flowNodeRef>W739_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W739_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W739_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W739_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W739_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W739_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W739_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W739_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W739_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W739_Lane3" name="All associates">
        <bpmn:flowNodeRef>W739_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W739_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W739_Start5" name="Store opening preparation (scheduled daily, 15 minutes before store opens)">
        <bpmn:outgoing>W739_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W739_Task6" name="Pre-huddle preparation — Store Manager reviews overnight system alerts…">
        <bpmn:documentation>Step 1: Pre-huddle preparation — Store Manager reviews overnight system alerts (low-stock alerts from W554, LP overnight alerts from W562, memo inbox from W571), pulls daily targets from W665 KPI dashboard, and identifies key talking points
Responsible (R): System / Store Manager
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W739_Flow17</bpmn:incoming>
        <bpmn:outgoing>W739_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W739_Task7" name="Team assembly — All on-shift associates gather at designated briefing area…">
        <bpmn:documentation>Step 2: Team assembly — All on-shift associates gather at designated briefing area; Store Manager confirms attendance against shift roster (W34)
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W739_Flow18</bpmn:incoming>
        <bpmn:outgoing>W739_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W739_Task8" name="Yesterday&#x27;s performance flash — Store Manager shares prior-day sales vs…">
        <bpmn:documentation>Step 3: Yesterday&#x27;s performance flash — Store Manager shares prior-day sales vs. target, top-performing departments, conversion rate, and any customer service highlights or issues from W608
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W739_Flow19</bpmn:incoming>
        <bpmn:outgoing>W739_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W739_Task9" name="Today&#x27;s priorities — Daily sales target, active promotions (W13), planogram…">
        <bpmn:documentation>Step 4: Today&#x27;s priorities — Daily sales target, active promotions (W13), planogram changes (W573), incoming deliveries (W18/W18B), scheduled services (W544), and special events (W147)
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W739_Flow20</bpmn:incoming>
        <bpmn:outgoing>W739_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W739_Task10" name="Safety minute — Quick safety reminder (topic rotates weekly: forklift safety…">
        <bpmn:documentation>Step 5: Safety minute — Quick safety reminder (topic rotates weekly: forklift safety, ladder safety, hazmat handling, fire safety, customer slip prevention) per W655 training schedule
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W739_Flow21</bpmn:incoming>
        <bpmn:outgoing>W739_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W739_Task11" name="Policy update &amp; memo acknowledgment — Any new policy directives, product…">
        <bpmn:documentation>Step 6: Policy update &amp; memo acknowledgment — Any new policy directives, product recalls (W29), price changes (W40), or urgent communications from W716
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W739_Flow22</bpmn:incoming>
        <bpmn:outgoing>W739_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W739_Task12" name="Staffing &amp; assignment confirmation — Confirm department coverage, break…">
        <bpmn:documentation>Step 7: Staffing &amp; assignment confirmation — Confirm department coverage, break schedules per DOLE requirements (W753), special assignments (inventory count zones, promo setup, vendor demos W745)
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W739_Flow23</bpmn:incoming>
        <bpmn:outgoing>W739_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W739_Task13" name="Team dispersal to stations — Associates proceed to assigned stations; opening…">
        <bpmn:documentation>Step 8: Team dispersal to stations — Associates proceed to assigned stations; opening procedures per W5A begin
Responsible (R): All associates
Accountable (A): Store Manager
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W739_Flow24</bpmn:incoming>
        <bpmn:outgoing>W739_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W739_End14" name="Complete">
        <bpmn:incoming>W739_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W739_Annotation15">
        <bpmn:text>Controls: - CTL-262 (ensure controlled execution — Store Staffing &amp; People (PA-07.4).) | - operational: Store Manager review and approval gate
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
