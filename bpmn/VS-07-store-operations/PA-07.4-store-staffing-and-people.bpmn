    <bpmn:process id="W_W602" name="W602. Store-Level Labor Cost Monitoring &amp; Overtime Budget Control" isExecutable="false">
      <bpmn:documentation>Trigger: Start of pay period (semi-monthly); weekly review trigger
Frequency: Daily monitoring; weekly review; semi-monthly reconciliation
Volume: 200 stores; ~5,800 store employees; ~PHP 180M/month store payroll
Owner: Store Manager
Participants: Store Manager, Department Supervisors, Regional Manager, HR Coordinator, Finance Analyst
Source: workflow W602 — Store-Level Labor Cost Monitoring &amp; Overtime Budget Control</bpmn:documentation>
      <bpmn:laneSet id="W602_LaneSet5">
        <bpmn:lane id="W602_Lane1" name="System">
        <bpmn:flowNodeRef>W602_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W602_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W602_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W602_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W602_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W602_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W602_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W602_Lane3" name="Department Supervisor">
        <bpmn:flowNodeRef>W602_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W602_Lane4" name="Finance Analyst">
        <bpmn:flowNodeRef>W602_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W602_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W602_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W602_Start6" name="Start of pay period (semi-monthly); weekly review trigger">
        <bpmn:outgoing>W602_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W602_Task7" name="System calculates daily labor cost flash: total regular hours × hourly rate +…">
        <bpmn:documentation>Step 1: System calculates daily labor cost flash: total regular hours × hourly rate + overtime hours × premium rate + holiday premium (if applicable) + night differential; compares to daily budget allocation
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W602_Flow18</bpmn:incoming>
        <bpmn:outgoing>W602_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W602_Task8" name="Store Manager reviews daily labor cost as % of daily revenue on morning…">
        <bpmn:documentation>Step 2: Store Manager reviews daily labor cost as % of daily revenue on morning dashboard; target: labor cost ≤ 12% of store revenue; amber alert at &gt; 14%; red alert at &gt; 16%
Responsible (R): Store Manager
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W602_Flow19</bpmn:incoming>
        <bpmn:outgoing>W602_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W602_Task9" name="If amber/red alert: Store Manager reviews overtime authorization log (per W601…">
        <bpmn:documentation>Step 3: If amber/red alert: Store Manager reviews overtime authorization log (per W601 Step 4) and identifies departments exceeding allocation; implements corrective action (reduce remaining week overtime, adjust schedules)
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W602_Flow20</bpmn:incoming>
        <bpmn:outgoing>W602_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W602_Task10" name="Weekly (Monday): Store Manager reviews prior week labor cost report with…">
        <bpmn:documentation>Step 4: Weekly (Monday): Store Manager reviews prior week labor cost report with breakdown by department, overtime category (customer-driven vs. operational), and trend vs. prior 4 weeks
Responsible (R): Store Manager
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W602_Flow21</bpmn:incoming>
        <bpmn:outgoing>W602_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W602_Task11" name="Department Supervisors submit overtime forecast for upcoming week with business…">
        <bpmn:documentation>Step 5: Department Supervisors submit overtime forecast for upcoming week with business justification; Store Manager approves aggregate overtime budget allocation per department
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W602_Flow22</bpmn:incoming>
        <bpmn:outgoing>W602_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W602_Task12" name="Semi-monthly: Store Manager reconciles actual payroll (from W10) vs. store…">
        <bpmn:documentation>Step 6: Semi-monthly: Store Manager reconciles actual payroll (from W10) vs. store labor budget; investigates variances &gt; 5%; submits variance explanation to Regional Manager and Finance Analyst
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W602_Flow23</bpmn:incoming>
        <bpmn:outgoing>W602_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W602_Task13" name="Finance Analyst consolidates 200-store labor cost flash report for CFO review…">
        <bpmn:documentation>Step 7: Finance Analyst consolidates 200-store labor cost flash report for CFO review; identifies top/bottom 10 stores by labor cost %; flags chronic over-budget stores for remediation
Responsible (R): Finance Analyst
Accountable (A): CFO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W602_Flow24</bpmn:incoming>
        <bpmn:outgoing>W602_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W602_Task14" name="Quarterly: Finance and HR review store-level labor budgets against actual…">
        <bpmn:documentation>Step 8: Quarterly: Finance and HR review store-level labor budgets against actual; adjust allocation formulas based on store revenue, format size, and seasonal patterns
Responsible (R): Finance Analyst
Accountable (A): CFO
Duration: 4 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W602_Flow25</bpmn:incoming>
        <bpmn:outgoing>W602_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W602_End15" name="Complete">
        <bpmn:incoming>W602_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W602_Annotation16">
        <bpmn:text>Controls: - CTL-262 (ensure controlled execution — Store Staffing &amp; People (PA-07.4).) | - operational: tracking absolute hours vs. budget in addition to percentage; operational: automated holiday calendar in payroll module per HR-011; operational: system requirement for same-day overtime entry in W601
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W602_Assoc17" sourceRef="W602_Annotation16" targetRef="W602_Start6" associationDirection="None" />
