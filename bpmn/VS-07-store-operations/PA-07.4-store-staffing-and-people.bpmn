<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-07.4-store-staffing-and-people" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W45" name="W45. Store Closure / Relocation" isExecutable="false">
      <bpmn:documentation>Trigger: Persistent underperformance, lease expiry non-renewal, market exit, or relocation to better site
Frequency: Occasional (estimated 2–5 closures/relocations per year as network matures to 300+ stores)
Volume: 1 store at a time; each takes 2–3 months from decision to final close-out
Owner: VP Store Operations
Participants: COO, VP Store Operations, Real Estate (Property Mgmt Inc.), IT, Finance, HR, Supply Chain, Marketing
Source: workflow W45 — Store Closure / Relocation</bpmn:documentation>
      <bpmn:laneSet id="W45_LaneSet15">
        <bpmn:lane id="W45_Lane1" name="VP Store Operations">
        <bpmn:flowNodeRef>W45_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W45_Start16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W45_Lane2" name="CEO">
        <bpmn:flowNodeRef>W45_Task18</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W45_Lane3" name="Property Mgr Inc.">
        <bpmn:flowNodeRef>W45_Task19</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W45_Lane4" name="Supply Planner">
        <bpmn:flowNodeRef>W45_Task20</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W45_Lane5" name="Closing Store Staff">
        <bpmn:flowNodeRef>W45_Task21</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W45_Lane6" name="HR Assistant">
        <bpmn:flowNodeRef>W45_Task22</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W45_Lane7" name="Marketing">
        <bpmn:flowNodeRef>W45_Task23</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W45_Lane8" name="CS Manager">
        <bpmn:flowNodeRef>W45_Task24</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W45_Lane9" name="AR Clerk">
        <bpmn:flowNodeRef>W45_Task25</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W45_Lane10" name="IT Team">
        <bpmn:flowNodeRef>W45_Task26</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W45_Lane11" name="Cost Accountant">
        <bpmn:flowNodeRef>W45_Task27</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W45_Lane12" name="IT">
        <bpmn:flowNodeRef>W45_Task28</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W45_Lane13" name="Controller">
        <bpmn:flowNodeRef>W45_Task29</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W45_Lane14" name="System">
        <bpmn:flowNodeRef>W45_Task30</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W45_End31</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W45_Start16" name="Persistent underperformance, lease expiry non-renewal, market exit, or relocation to…">
        <bpmn:outgoing>W45_Flow34</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W45_Task17" name="Store performance review triggers closure decision: sustained negative EBITDA…">
        <bpmn:documentation>Step 1: Store performance review triggers closure decision: sustained negative EBITDA, declining foot traffic, lease renewal at unfavorable terms, or strategic market exit
Responsible (R): VP Store Operations / CFO
Accountable (A): CEO
Duration: Decision meeting</bpmn:documentation>
        <bpmn:incoming>W45_Flow34</bpmn:incoming>
        <bpmn:outgoing>W45_Flow35</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W45_Task18" name="CEO and Board approve closure/relocation; VP Store Operations appointed as…">
        <bpmn:documentation>Step 2: CEO and Board approve closure/relocation; VP Store Operations appointed as closure lead
Responsible (R): CEO / Board
Accountable (A): CEO
Duration: Board meeting</bpmn:documentation>
        <bpmn:incoming>W45_Flow35</bpmn:incoming>
        <bpmn:outgoing>W45_Flow36</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W45_Task19" name="Property Mgr Inc. negotiates lease termination with landlord; settles any…">
        <bpmn:documentation>Step 3: Property Mgr Inc. negotiates lease termination with landlord; settles any penalties or early termination fees
Responsible (R): Property Mgr Inc.
Accountable (A): CFO
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W45_Flow36</bpmn:incoming>
        <bpmn:outgoing>W45_Flow37</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W45_Task20" name="Supply Planner creates mass inventory redistribution plan: system generates…">
        <bpmn:documentation>Step 4: Supply Planner creates mass inventory redistribution plan: system generates transfer orders from closing store to nearest stores and serving DC; prioritizes by item velocity and destination need
Responsible (R): Supply Planner
Accountable (A): Supply Planning Manager
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W45_Flow37</bpmn:incoming>
        <bpmn:outgoing>W45_Flow38</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W45_Task21" name="DC and receiving stores process inbound transfers per standard receiving (W22…">
        <bpmn:documentation>Step 5: DC and receiving stores process inbound transfers per standard receiving (W22, W3); closing store picks and ships inventory in waves over 1–2 weeks
Responsible (R): Closing Store Staff
Accountable (A): DC Supervisor / Store Manager
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W45_Flow38</bpmn:incoming>
        <bpmn:outgoing>W45_Flow39</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W45_Task22" name="HR initiates employee action: (a) redeploy high-performers to nearby stores…">
        <bpmn:documentation>Step 6: HR initiates employee action: (a) redeploy high-performers to nearby stores (transfer, not separation), (b) offer voluntary separation to others, (c) process separations per W43 for staff not redeployed; peak: up to 29 separations per store (the full §12.1 store headcount)
Responsible (R): HR Assistant / HR Head
Accountable (A): CHRO
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W45_Flow39</bpmn:incoming>
        <bpmn:outgoing>W45_Flow40</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W45_Task23" name="Marketing executes customer communication plan: notify loyalty members of…">
        <bpmn:documentation>Step 7: Marketing executes customer communication plan: notify loyalty members of closure, redirect to nearest store, offer relocation promotion (e.g., extra loyalty points at new nearest store), update store locator on website/app
Responsible (R): Marketing
Accountable (A): CMO
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W45_Flow40</bpmn:incoming>
        <bpmn:outgoing>W45_Flow41</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W45_Task24" name="Customer Service handles inbound inquiries from trade/corporate accounts…">
        <bpmn:documentation>Step 8: Customer Service handles inbound inquiries from trade/corporate accounts; reassigns accounts to nearest store&#x27;s Sales Rep or Regional Manager
Responsible (R): CS Manager / Sales Rep
Accountable (A): VP Store Operations
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W45_Flow41</bpmn:incoming>
        <bpmn:outgoing>W45_Flow42</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W45_Task25" name="AR Clerk reviews and collects any outstanding trade/corporate account balances…">
        <bpmn:documentation>Step 9: AR Clerk reviews and collects any outstanding trade/corporate account balances specific to closing store location
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W45_Flow42</bpmn:incoming>
        <bpmn:outgoing>W45_Flow43</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W45_Task26" name="IT decommissions store infrastructure: POS terminals, network equipment, RF…">
        <bpmn:documentation>Step 10: IT decommissions store infrastructure: POS terminals, network equipment, RF devices (reverse of W16.3); deactivates store location in ERP system; removes from price file and replenishment routing
Responsible (R): IT Team
Accountable (A): CIO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W45_Flow43</bpmn:incoming>
        <bpmn:outgoing>W45_Flow44</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W45_Task27" name="Cost Accountant disposes store fixtures and fixed assets per W39…">
        <bpmn:documentation>Step 11: Cost Accountant disposes store fixtures and fixed assets per W39 (disposal/retirement); capitalizes any leasehold improvement write-offs
Responsible (R): Cost Accountant
Accountable (A): Controller
Duration: Per W39</bpmn:documentation>
        <bpmn:incoming>W45_Flow44</bpmn:incoming>
        <bpmn:outgoing>W45_Flow45</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W45_Task28" name="System deactivates store location master: location status set to &quot;Closed&quot;; no…">
        <bpmn:documentation>Step 12: System deactivates store location master: location status set to &quot;Closed&quot;; no further transactions posted; location excluded from reports and dashboards
Responsible (R): IT / Controller
Accountable (A): CFO
Duration: Automated + 15 min</bpmn:documentation>
        <bpmn:incoming>W45_Flow45</bpmn:incoming>
        <bpmn:outgoing>W45_Flow46</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W45_Task29" name="Controller runs final store P&amp;L and balance sheet reconciliation: all inventory…">
        <bpmn:documentation>Step 13: Controller runs final store P&amp;L and balance sheet reconciliation: all inventory cleared, all AP/AR settled, all assets disposed; final profit/loss on closure recognized
Responsible (R): Controller
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W45_Flow46</bpmn:incoming>
        <bpmn:outgoing>W45_Flow47</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W45_Task30" name="Post-closure: system retains closed store data for 10-year retention period…">
        <bpmn:documentation>Step 14: Post-closure: system retains closed store data for 10-year retention period (BIR); historical data accessible for reporting but location excluded from active operations
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W45_Flow47</bpmn:incoming>
        <bpmn:outgoing>W45_Flow48</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W45_End31" name="Complete">
        <bpmn:incoming>W45_Flow48</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W45_Annotation32">
        <bpmn:text>Controls: - CTL-262 (ensure controlled execution — Store Staffing &amp; People (PA-07.4).) | - operational: VP Store Operations review and approval gate; operational: periodic reconciliation against source documents
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W45_Assoc33" sourceRef="W45_Annotation32" targetRef="W45_Start16" associationDirection="None" />
