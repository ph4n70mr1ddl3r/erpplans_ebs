    <bpmn:process id="W_W578" name="W578. Store-Level Payday Weekend &amp; Peak Day Operational Readiness" isExecutable="false">
      <bpmn:documentation>Trigger: Predictable high-traffic days: paydays (15th, 30th/31st), holidays, sale events, month-end
Frequency: ~4–6 predictable peak days per month per store
Volume: Payday weekends show 30–50% sales uplift vs. normal weekend; contractor trade customers spike on 15th/30th
Owner: Store Manager
Participants: Store Manager, Lead Cashier, Stock Associates, LP
Source: workflow W578 — Store-Level Payday Weekend &amp; Peak Day Operational Readiness</bpmn:documentation>
      <bpmn:laneSet id="W578_LaneSet5">
        <bpmn:lane id="W578_Lane1" name="System">
        <bpmn:flowNodeRef>W578_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W578_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W578_Lane2" name="Lead Cashier">
        <bpmn:flowNodeRef>W578_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W578_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W578_Lane3" name="Stock Associate">
        <bpmn:flowNodeRef>W578_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W578_Lane4" name="Store Manager">
        <bpmn:flowNodeRef>W578_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W578_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W578_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W578_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W578_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W578_Start6" name="Predictable high-traffic days: paydays (15th, 30th/31st), holidays, sale events, month-end">
        <bpmn:outgoing>W578_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W578_Task7" name="3 days before">
        <bpmn:documentation>Step 1: 3 days before: system analyzes historical sales patterns by store for upcoming peak day — predicts transaction volume, ATV, peak hours, and top-selling categories
Responsible (R): System
Accountable (A): Store Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W578_Flow18</bpmn:incoming>
        <bpmn:outgoing>W578_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W578_Task8" name="2 days before">
        <bpmn:documentation>Step 2: 2 days before: increase cash floats per forecast (typical payday float: 1.5× normal); coordinate with CIT service per W174 for additional cash delivery
Responsible (R): Lead Cashier
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W578_Flow19</bpmn:incoming>
        <bpmn:outgoing>W578_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W578_Task9" name="2 days before">
        <bpmn:documentation>Step 3: 2 days before: inventory top-up for fast-moving SKUs identified by forecast — coordinate with backroom Stock Associates for shelf stocking per W554
Responsible (R): Stock Associate
Accountable (A): Department Supervisor
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W578_Flow20</bpmn:incoming>
        <bpmn:outgoing>W578_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W578_Task10" name="1 day before">
        <bpmn:documentation>Step 4: 1 day before: confirm additional cashier deployment per W34 (flex up to all terminals); activate backup POS terminal if normally idle; verify POS system connectivity
Responsible (R): Store Manager
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W578_Flow21</bpmn:incoming>
        <bpmn:outgoing>W578_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W578_Task11" name="1 day before">
        <bpmn:documentation>Step 5: 1 day before: queue management preparation — set up express lane, stage mPOS tablets per W206, activate scan &amp; go per W547
Responsible (R): Lead Cashier
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W578_Flow22</bpmn:incoming>
        <bpmn:outgoing>W578_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W578_Task12" name="Day of — morning">
        <bpmn:documentation>Step 6: Day of — morning: all-hands briefing: expected traffic, key promotions active, express lane assignments, LP heightened awareness
Responsible (R): Store Manager
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W578_Flow23</bpmn:incoming>
        <bpmn:outgoing>W578_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W578_Task13" name="Day of — during peak">
        <bpmn:documentation>Step 7: Day of — during peak: Store Manager monitors queue length and checkout wait times; activates queue-busting (mPOS, additional cashier) if wait exceeds 5 minutes; LP patrols high-theft departments
Responsible (R): Store Manager
Accountable (A): —
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W578_Flow24</bpmn:incoming>
        <bpmn:outgoing>W578_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W578_Task14" name="Day after">
        <bpmn:documentation>Step 8: Day after: post-peak flash report — actual vs. predicted sales, checkout wait times, stockouts, LP incidents
Responsible (R): Store Manager
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W578_Flow25</bpmn:incoming>
        <bpmn:outgoing>W578_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W578_End15" name="Complete">
        <bpmn:incoming>W578_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W578_Annotation16">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: conservative 1; operational: pre-peak terminal verification (Step 4) and spare terminal pre-positioning during Ber months; operational: opening with full cashier deployment on payday mornings (all 3 terminals from 8:00 AM)
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W578_Assoc17" sourceRef="W578_Annotation16" targetRef="W578_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W578_Flow18" sourceRef="W578_Start6" targetRef="W578_Task7" />
      <bpmn:sequenceFlow id="W578_Flow19" sourceRef="W578_Task7" targetRef="W578_Task8" />
      <bpmn:sequenceFlow id="W578_Flow20" sourceRef="W578_Task8" targetRef="W578_Task9" />
      <bpmn:sequenceFlow id="W578_Flow21" sourceRef="W578_Task9" targetRef="W578_Task10" />
      <bpmn:sequenceFlow id="W578_Flow22" sourceRef="W578_Task10" targetRef="W578_Task11" />
      <bpmn:sequenceFlow id="W578_Flow23" sourceRef="W578_Task11" targetRef="W578_Task12" />
      <bpmn:sequenceFlow id="W578_Flow24" sourceRef="W578_Task12" targetRef="W578_Task13" />
      <bpmn:sequenceFlow id="W578_Flow25" sourceRef="W578_Task13" targetRef="W578_Task14" />
      <bpmn:sequenceFlow id="W578_Flow26" sourceRef="W578_Task14" targetRef="W578_End15" />
    </bpmn:process>
