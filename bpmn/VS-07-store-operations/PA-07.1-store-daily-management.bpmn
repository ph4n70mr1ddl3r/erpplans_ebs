    <bpmn:process id="W_W445" name="W445. Display &amp; Demo Infrastructure Maintenance" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled preventive maintenance (PM) or report of non-functional store display (e.g., dead lightbulb, leaking demo faucet)
Frequency: Weekly (Inspections); Daily (Minor repairs)
Volume: ~50–100 active &quot;live&quot; demos per store
Owner: Store Manager
Participants: Maintenance / Utility, Department Supervisor, Vendor Rep
Source: workflow W445 — Display &amp; Demo Infrastructure Maintenance</bpmn:documentation>
      <bpmn:laneSet id="W445_LaneSet3">
        <bpmn:lane id="W445_Lane1" name="Dept Supervisor">
        <bpmn:flowNodeRef>W445_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W445_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W445_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W445_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W445_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W445_Lane2" name="Maintenance">
        <bpmn:flowNodeRef>W445_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W445_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W445_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W445_Start4" name="Scheduled preventive maintenance (PM) or report of non-functional store display (e.g…">
        <bpmn:outgoing>W445_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W445_Task5" name="Daily Walkthrough">
        <bpmn:documentation>Step 1: Daily Walkthrough: Supervisor inspects all &quot;Live Demos&quot; (Lighting, Plumbing, Power Tools) for safety and functionality
Responsible (R): Dept Supervisor
Accountable (A): Store Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W445_Flow14</bpmn:incoming>
        <bpmn:outgoing>W445_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W445_Task6" name="Fault Logging">
        <bpmn:documentation>Step 2: Fault Logging: Non-functional displays logged as a &quot;Maintenance Request&quot; in the Store Operations App
Responsible (R): Dept Supervisor
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W445_Flow15</bpmn:incoming>
        <bpmn:outgoing>W445_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W445_Task7" name="Safety Isolation">
        <bpmn:documentation>Step 3: Safety Isolation: If a fault is electrical or involves water (leaks), Maintenance immediately isolates the power/water source
Responsible (R): Maintenance
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W445_Flow16</bpmn:incoming>
        <bpmn:outgoing>W445_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W445_Task8" name="Repair/Component Replacement">
        <bpmn:documentation>Step 4: Repair/Component Replacement: Maintenance replaces consumables (bulbs, batteries) or fixes minor hardware issues
Responsible (R): Maintenance
Accountable (A): —
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W445_Flow17</bpmn:incoming>
        <bpmn:outgoing>W445_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W445_Task9" name="Vendor Coordination">
        <bpmn:documentation>Step 5: Vendor Coordination: For complex/branded displays (e.g., custom kitchen modules), Supervisor notifies the Vendor Rep for specialized repair
Responsible (R): Dept Supervisor
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W445_Flow18</bpmn:incoming>
        <bpmn:outgoing>W445_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W445_Task10" name="Completion &amp; Verification">
        <bpmn:documentation>Step 6: Completion &amp; Verification: Display tested for functionality; &quot;Live Demo&quot; status restored in the system
Responsible (R): Dept Supervisor
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W445_Flow19</bpmn:incoming>
        <bpmn:outgoing>W445_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W445_End11" name="Complete">
        <bpmn:incoming>W445_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W445_Annotation12">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
