      <bpmn:sequenceFlow id="W702_Flow25" sourceRef="W702_Task12" targetRef="W702_Task13" />
      <bpmn:sequenceFlow id="W702_Flow26" sourceRef="W702_Task13" targetRef="W702_Task14" />
      <bpmn:sequenceFlow id="W702_Flow27" sourceRef="W702_Task14" targetRef="W702_Task15" />
      <bpmn:sequenceFlow id="W702_Flow28" sourceRef="W702_Task15" targetRef="W702_Task16" />
      <bpmn:sequenceFlow id="W702_Flow29" sourceRef="W702_Task16" targetRef="W702_Task17" />
      <bpmn:sequenceFlow id="W702_Flow30" sourceRef="W702_Task17" targetRef="W702_Task18" />
      <bpmn:sequenceFlow id="W702_Flow31" sourceRef="W702_Task18" targetRef="W702_End19" />
    </bpmn:process>
