      <bpmndi:BPMNPlane id="W1091_plane" bpmnElement="W_W1091">
        <bpmndi:BPMNShape id="W1091_Lane1_di" bpmnElement="W1091_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
