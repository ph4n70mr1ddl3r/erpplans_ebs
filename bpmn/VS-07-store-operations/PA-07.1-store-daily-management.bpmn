    <bpmn:process id="W_W5G" name="W5G. Offline POS Recovery &amp; Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: POS terminal or store network connectivity restored after an offline period (terminals operated in local/offline mode per W535)
Frequency: As-needed — triggered by any connectivity interruption; rare but high-impact when it occurs
Volume: Occasional; longer offline periods produce larger reconciliation batches
Owner: Store Manager
Participants: Cashier, Store Manager, IT Helpdesk (W48), Cash Office, Loss Prevention (W37)
Source: workflow W5G — Offline POS Recovery &amp; Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W5G_LaneSet4">
        <bpmn:lane id="W5G_Lane1" name="System">
        <bpmn:flowNodeRef>W5G_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5G_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5G_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5G_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5G_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5G_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5G_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5G_Lane2" name="Cashier">
        <bpmn:flowNodeRef>W5G_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5G_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W5G_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5G_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5G_Start5" name="POS terminal or store network connectivity restored after an offline period (terminals…">
        <bpmn:outgoing>W5G_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W5G_Task6" name="System auto-detects network restoration; POS terminal transitions from…">
        <bpmn:documentation>Step 1: System auto-detects network restoration; POS terminal transitions from offline/local mode to online mode; begins replaying queued offline transactions from last-acknowledged sequence number (per W533.10)
Responsible (R): System
Accountable (A): Store Manager
Duration: 2–5 min per offline shift</bpmn:documentation>
        <bpmn:incoming>W5G_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5G_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W5G_Task7" name="ERP receives replayed offline events; deduplicates against any already-received…">
        <bpmn:documentation>Step 2: ERP receives replayed offline events; deduplicates against any already-received transactions and processes them in original sequence order; zero-data-loss guarantee
Responsible (R): System
Accountable (A): IT Helpdesk
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W5G_Flow18</bpmn:incoming>
        <bpmn:outgoing>W5G_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W5G_Task8" name="Inventory adjustment reconciliation: system compares POS deduction log (from…">
        <bpmn:documentation>Step 3: Inventory adjustment reconciliation: system compares POS deduction log (from continuous/offline events) with ERP on-hand quantity changes; flags discrepancies where POS deducted but ERP on-hand does not match; generates reconciliation exceptions (NR-3)
Responsible (R): System
Accountable (A): Store Manager
Duration: Automated + review</bpmn:documentation>
        <bpmn:incoming>W5G_Flow19</bpmn:incoming>
        <bpmn:outgoing>W5G_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W5G_Task9" name="Void/return log reconciliation: void and return transactions from offline…">
        <bpmn:documentation>Step 4: Void/return log reconciliation: void and return transactions from offline events are cross-checked against ERP void/return register; verifies void authorization chain (cashier → authorizer) is complete for every void including offline voids (NR-4)
Responsible (R): System
Accountable (A): Store Manager
Duration: Automated + review</bpmn:documentation>
        <bpmn:incoming>W5G_Flow20</bpmn:incoming>
        <bpmn:outgoing>W5G_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W5G_Task10" name="Loyalty points reconciliation: points earned and redeemed via offline events…">
        <bpmn:documentation>Step 5: Loyalty points reconciliation: points earned and redeemed via offline events reconciled with central loyalty engine; resolves conflicts where points were earned offline but the same customer redeemed online simultaneously (W5G.5) (NR-5)
Responsible (R): System
Accountable (A): Store Manager
Duration: Automated + 10 min if conflict</bpmn:documentation>
        <bpmn:incoming>W5G_Flow21</bpmn:incoming>
        <bpmn:outgoing>W5G_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W5G_Task11" name="Electronic payment settlement reconciliation: offline card/e-wallet…">
        <bpmn:documentation>Step 6: Electronic payment settlement reconciliation: offline card/e-wallet transactions matched against acquirer settlement reports; flags unmatched or declined-after-offline transactions
Responsible (R): Cashier / Store Manager
Accountable (A): Store Manager
Duration: 10 min review</bpmn:documentation>
        <bpmn:incoming>W5G_Flow22</bpmn:incoming>
        <bpmn:outgoing>W5G_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5G_Task12" name="Store Manager reviews reconciliation exception report; investigates and…">
        <bpmn:documentation>Step 7: Store Manager reviews reconciliation exception report; investigates and resolves each discrepancy (re-post, adjust, or escalate); unresolved items escalated to IT Helpdesk (W48 P2) or Loss Prevention (W37) if theft/fraud suspected
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 15–30 min depending on exceptions</bpmn:documentation>
        <bpmn:incoming>W5G_Flow23</bpmn:incoming>
        <bpmn:outgoing>W5G_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W5G_Task13" name="System generates offline-recovery reconciliation report attached to the day&#x27;s…">
        <bpmn:documentation>Step 8: System generates offline-recovery reconciliation report attached to the day&#x27;s Z-report (W5F); all offline transactions, replay status, and exceptions archived for 10-year BIR retention
Responsible (R): System
Accountable (A): Store Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W5G_Flow24</bpmn:incoming>
        <bpmn:outgoing>W5G_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W5G_End14" name="Complete">
        <bpmn:incoming>W5G_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5G_Annotation15">
        <bpmn:text>Controls: (none recorded)
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5G_Assoc16" sourceRef="W5G_Annotation15" targetRef="W5G_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W5G_Flow17" sourceRef="W5G_Start5" targetRef="W5G_Task6" />
