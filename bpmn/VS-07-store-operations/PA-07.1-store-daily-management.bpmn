    <bpmn:process id="W_W606" name="W606. Store-Level Water &amp; Utility Conservation Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Start of billing cycle; daily monitoring
Frequency: Daily monitoring; monthly review per utility bill cycle
Volume: 200 stores; ~PHP 650,000–1,100,000/month utility cost per store (consistent with W111&#x27;s PHP 80–150/sqm/month over 8,000–15,000 sqm; electricity, water, gas for forklift)
Owner: Store Manager
Participants: Store Manager, Department Supervisors, Maintenance Staff, Finance Analyst, Facilities Coordinator
Source: workflow W606 — Store-Level Water &amp; Utility Conservation Operations</bpmn:documentation>
      <bpmn:laneSet id="W606_LaneSet6">
        <bpmn:lane id="W606_Lane1" name="Maintenance Staff">
        <bpmn:flowNodeRef>W606_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W606_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
