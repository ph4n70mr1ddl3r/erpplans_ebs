    <bpmn:process id="W_W581" name="W581. Store-Level Vendor Representative Access &amp; Activity Management" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor representative (promodizer, merchandiser, product trainer, brand ambassador) arrives at store
Frequency: ~5–15 vendor reps per store per day; ~1,000–3,000 visits chain-wide daily
Volume: ~500–1,500 active vendor representatives across 200 stores (supporting ~1,000–3,000 chain-wide visits/day per the Frequency)
Owner: Store Manager
Participants: Department Supervisors, Security Guard, Vendor Representative
Source: workflow W581 — Store-Level Vendor Representative Access &amp; Activity Management</bpmn:documentation>
      <bpmn:laneSet id="W581_LaneSet5">
        <bpmn:lane id="W581_Lane1" name="Security Guard">
        <bpmn:flowNodeRef>W581_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W581_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W581_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W581_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W581_Lane2" name="Department Supervisor">
        <bpmn:flowNodeRef>W581_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W581_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W581_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W581_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W581_Lane3" name="Vendor Representative">
        <bpmn:flowNodeRef>W581_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W581_Lane4" name="Store Manager">
        <bpmn:flowNodeRef>W581_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W581_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W581_Start6" name="Vendor representative (promodizer, merchandiser, product trainer, brand ambassador)…">
        <bpmn:outgoing>W581_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W581_Task7" name="Vendor rep arrives at store entrance; presents government-issued ID to Security…">
        <bpmn:documentation>Step 1: Vendor rep arrives at store entrance; presents government-issued ID to Security Guard; Guard verifies vendor rep is on approved vendor representative list (maintained by Store Manager and updated monthly per vendor coordination)
Responsible (R): Security Guard
Accountable (A): Store Manager
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W581_Flow19</bpmn:incoming>
        <bpmn:outgoing>W581_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W581_Task8" name="Security Guard issues temporary visitor badge with: vendor name, company, date…">
        <bpmn:documentation>Step 2: Security Guard issues temporary visitor badge with: vendor name, company, date, time-in; badge is time-limited (max 8 hours); vendor rep signs visitor log
Responsible (R): Security Guard
Accountable (A): —
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W581_Flow20</bpmn:incoming>
        <bpmn:outgoing>W581_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W581_Task9" name="Vendor rep directed to relevant Department Supervisor for activity assignment…">
        <bpmn:documentation>Step 3: Vendor rep directed to relevant Department Supervisor for activity assignment; Supervisor reviews planned activities (vendor visit schedule provided by Buyer/Category Manager in advance via system)
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W581_Flow21</bpmn:incoming>
        <bpmn:outgoing>W581_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W581_Task10" name="Department Supervisor assigns specific tasks: (a) shelf stocking/replenishment…">
        <bpmn:documentation>Step 4: Department Supervisor assigns specific tasks: (a) shelf stocking/replenishment for vendor products, (b) product demonstration for customers, (c) inventory audit of vendor SKUs, (d) product knowledge training for store staff, (e) promotional display setup per W262, (f) price tag update per W63
Responsible (R): Department Supervisor
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W581_Flow22</bpmn:incoming>
        <bpmn:outgoing>W581_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W581_Task11" name="Vendor rep executes assigned activities under Department Supervisor oversight…">
        <bpmn:documentation>Step 5: Vendor rep executes assigned activities under Department Supervisor oversight; time tracked via badge scan (check-in/check-out at department zones)
Responsible (R): Vendor Representative
Accountable (A): Department Supervisor
Duration: 2–6 hours</bpmn:documentation>
        <bpmn:incoming>W581_Flow23</bpmn:incoming>
        <bpmn:outgoing>W581_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W581_Task12" name="Activity output verification: Department Supervisor reviews completed work —…">
        <bpmn:documentation>Step 6: Activity output verification: Department Supervisor reviews completed work — shelf stocking completed, demo materials cleaned up, inventory counts reconciled, training attendance documented
Responsible (R): Department Supervisor
Accountable (A): —
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W581_Flow24</bpmn:incoming>
        <bpmn:outgoing>W581_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W581_Task13" name="Incident reporting: if vendor rep causes any issue (customer complaint, safety…">
        <bpmn:documentation>Step 7: Incident reporting: if vendor rep causes any issue (customer complaint, safety violation, merchandise damage, unauthorized area access), Department Supervisor documents incident and reports to Store Manager
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 5 min per incident</bpmn:documentation>
        <bpmn:incoming>W581_Flow25</bpmn:incoming>
        <bpmn:outgoing>W581_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W581_Task14" name="Vendor rep checks out at security desk: badge returned, time-out recorded…">
        <bpmn:documentation>Step 8: Vendor rep checks out at security desk: badge returned, time-out recorded; Security Guard collects badge and signs out visitor log
Responsible (R): Security Guard
Accountable (A): —
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W581_Flow26</bpmn:incoming>
        <bpmn:outgoing>W581_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W581_Task15" name="Weekly: Store Manager compiles vendor rep activity summary (visits, hours…">
        <bpmn:documentation>Step 9: Weekly: Store Manager compiles vendor rep activity summary (visits, hours, activities completed, incidents); shared with Buyer/Category Manager for vendor coordination per W269
Responsible (R): Store Manager
Accountable (A): —
Duration: 15 min/week</bpmn:documentation>
        <bpmn:incoming>W581_Flow27</bpmn:incoming>
        <bpmn:outgoing>W581_Flow28</bpmn:outgoing>
      </bpmn:userTask>
