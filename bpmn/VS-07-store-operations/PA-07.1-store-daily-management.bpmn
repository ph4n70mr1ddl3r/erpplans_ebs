      <bpmn:startEvent id="W667_Start6" name="Daily morning opening routine; system price change alerts">
        <bpmn:outgoing>W667_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W667_Task7" name="System pushes overnight price changes to POS terminals per W533 and POS-047…">
        <bpmn:documentation>Step 1: System pushes overnight price changes to POS terminals per W533 and POS-047; Stock Associate receives daily price change notification on handheld listing affected SKUs with old and new prices
Responsible (R): System / Stock Associate
Accountable (A): Department Supervisor
Duration: 5-10 min</bpmn:documentation>
        <bpmn:incoming>W667_Flow18</bpmn:incoming>
        <bpmn:outgoing>W667_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W667_Task8" name="Stock Associate prints and replaces shelf labels/price tags for all changed…">
        <bpmn:documentation>Step 2: Stock Associate prints and replaces shelf labels/price tags for all changed SKUs per W181; verifies label matches new system price; flags items where shelf label cannot be located (potential out-of-shelf)
Responsible (R): Stock Associate
Accountable (A): Department Supervisor
Duration: 20-25 min</bpmn:documentation>
        <bpmn:incoming>W667_Flow19</bpmn:incoming>
        <bpmn:outgoing>W667_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W667_Task9" name="Department Supervisor performs morning spot-check: scans 20-30 random SKUs…">
        <bpmn:documentation>Step 3: Department Supervisor performs morning spot-check: scans 20-30 random SKUs across departments with handheld price verification tool; system compares scanned barcode price vs. POS system price vs. shelf label
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 10-15 min</bpmn:documentation>
        <bpmn:incoming>W667_Flow20</bpmn:incoming>
        <bpmn:outgoing>W667_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W667_Task10" name="For any mismatches: Stock Associate immediately corrects shelf label and…">
        <bpmn:documentation>Step 4: For any mismatches: Stock Associate immediately corrects shelf label and verifies POS price; if POS price is incorrect, Department Supervisor escalates to Store Manager for manual price override per W553
Responsible (R): Stock Associate / Department Supervisor
Accountable (A): Store Manager
Duration: 5-10 min</bpmn:documentation>
        <bpmn:incoming>W667_Flow21</bpmn:incoming>
        <bpmn:outgoing>W667_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W667_Task11" name="Weekly: Store Manager conducts comprehensive shelf walk in one department…">
        <bpmn:documentation>Step 5: Weekly: Store Manager conducts comprehensive shelf walk in one department (rotating weekly across 4 departments); verifies price accuracy, promotional display pricing per W523, and DTI price freeze compliance per POS-024
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W667_Flow22</bpmn:incoming>
        <bpmn:outgoing>W667_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W667_Task12" name="Store Manager logs price verification results in compliance module; system…">
        <bpmn:documentation>Step 6: Store Manager logs price verification results in compliance module; system calculates store-level price accuracy rate (target ≥ 99%)
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 15-20 min</bpmn:documentation>
        <bpmn:incoming>W667_Flow23</bpmn:incoming>
        <bpmn:outgoing>W667_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W667_Task13" name="Monthly: system generates price compliance report for Regional Manager with…">
        <bpmn:documentation>Step 7: Monthly: system generates price compliance report for Regional Manager with store ranking; bottom-quartile stores receive corrective action plan
Responsible (R): System
Accountable (A): Regional Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W667_Flow24</bpmn:incoming>
        <bpmn:outgoing>W667_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W667_Task14" name="Price verification data feeds into W69 (price compliance audit) and W553…">
        <bpmn:documentation>Step 8: Price verification data feeds into W69 (price compliance audit) and W553 (pricing error detection)
Responsible (R): System
Accountable (A): Compliance Team
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W667_Flow25</bpmn:incoming>
        <bpmn:outgoing>W667_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W667_End15" name="Complete">
        <bpmn:incoming>W667_Flow26</bpmn:incoming>
      </bpmn:endEvent>
