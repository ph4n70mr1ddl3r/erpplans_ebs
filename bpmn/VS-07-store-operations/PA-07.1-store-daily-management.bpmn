      <bpmn:sequenceFlow id="W1070_Flow14" sourceRef="W1070_Task6" targetRef="W1070_Task7" />
      <bpmn:sequenceFlow id="W1070_Flow15" sourceRef="W1070_Task7" targetRef="W1070_Task8" />
      <bpmn:sequenceFlow id="W1070_Flow16" sourceRef="W1070_Task8" targetRef="W1070_End9" />
    </bpmn:process>
