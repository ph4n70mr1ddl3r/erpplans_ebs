      <bpmn:sequenceFlow id="W432_Flow18" sourceRef="W432_Task8" targetRef="W432_Task9" />
      <bpmn:sequenceFlow id="W432_Flow19" sourceRef="W432_Task9" targetRef="W432_Task10" />
      <bpmn:sequenceFlow id="W432_Flow20" sourceRef="W432_Task10" targetRef="W432_End11" />
    </bpmn:process>
