        <bpmn:flowNodeRef>W574_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W574_End19</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W574_Start7" name="Store operating hours end (typically 8:00 PM, or 9:00 PM during extended hours)">
        <bpmn:outgoing>W574_Flow22</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W574_Task8" name="Announce last call 15 minutes before closing; PA system announcement in English…">
        <bpmn:documentation>Step 1: Announce last call 15 minutes before closing; PA system announcement in English and Filipino
Responsible (R): Lead Cashier
Accountable (A): Store Manager
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W574_Flow22</bpmn:incoming>
        <bpmn:outgoing>W574_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W574_Task9" name="Escort remaining customers to checkout and then to exit; no new transactions…">
        <bpmn:documentation>Step 2: Escort remaining customers to checkout and then to exit; no new transactions after posted closing time
Responsible (R): Sales Associate
Accountable (A): Store Manager
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W574_Flow23</bpmn:incoming>
        <bpmn:outgoing>W574_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W574_Task10" name="Run Z-report (end-of-day reading) on all POS terminals; verify all terminals…">
        <bpmn:documentation>Step 3: Run Z-report (end-of-day reading) on all POS terminals; verify all terminals report successfully
Responsible (R): Lead Cashier
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W574_Flow24</bpmn:incoming>
        <bpmn:outgoing>W574_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W574_Task11" name="Count cash per drawer against system Z-report totals; flag any variances…">
        <bpmn:documentation>Step 4: Count cash per drawer against system Z-report totals; flag any variances exceeding PHP 100 per drawer
Responsible (R): Lead Cashier
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W574_Flow25</bpmn:incoming>
        <bpmn:outgoing>W574_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W574_Task12" name="Resolve cashier over/short variances per W272; document unresolved variances…">
        <bpmn:documentation>Step 5: Resolve cashier over/short variances per W272; document unresolved variances for next-day follow-up
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W574_Flow26</bpmn:incoming>
        <bpmn:outgoing>W574_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W574_Task13" name="Prepare bank deposit per W541 (cash, coin, checks separated; deposit slip…">
        <bpmn:documentation>Step 6: Prepare bank deposit per W541 (cash, coin, checks separated; deposit slip completed; smart safe or deposit bag sealed)
Responsible (R): Lead Cashier
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W574_Flow27</bpmn:incoming>
        <bpmn:outgoing>W574_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W574_Task14" name="Store security walkthrough: yard/lumber area, receiving dock, paint room…">
        <bpmn:documentation>Step 7: Store security walkthrough: yard/lumber area, receiving dock, paint room, garden center, sales floor aisles, break room, restrooms — check for: remaining customers, safety hazards, open doors/windows, water leaks
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W574_Flow28</bpmn:incoming>
        <bpmn:outgoing>W574_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W574_Task15" name="Verify all equipment secured: paint mixer covered and powered off, lumber/panel…">
        <bpmn:documentation>Step 8: Verify all equipment secured: paint mixer covered and powered off, lumber/panel saw blade guards on and power disconnected, forklifts parked and keys removed to lockbox, pallet jacks returned to designated area, ladders secured
Responsible (R): Stock Associate
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W574_Flow29</bpmn:incoming>
        <bpmn:outgoing>W574_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W574_Task16" name="Verify all refrigerated/temperature-sensitive items (adhesives, certain…">
        <bpmn:documentation>Step 9: Verify all refrigerated/temperature-sensitive items (adhesives, certain chemicals) are within acceptable range per W587 temperature protocol if applicable
Responsible (R): Stock Associate
Accountable (A): Store Manager
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W574_Flow30</bpmn:incoming>
        <bpmn:outgoing>W574_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W574_Task17" name="Set alarm system; verify all entry points locked (front doors, receiving dock…">
        <bpmn:documentation>Step 10: Set alarm system; verify all entry points locked (front doors, receiving dock, emergency exits, yard gate, office)
Responsible (R): Security Guard
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W574_Flow31</bpmn:incoming>
        <bpmn:outgoing>W574_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W574_Task18" name="Submit daily sales summary to Regional Manager via system dashboard: total…">
        <bpmn:documentation>Step 11: Submit daily sales summary to Regional Manager via system dashboard: total sales vs. target, transaction count, top 5 SKUs, cash over/short total, any incidents noted
Responsible (R): Store Manager
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W574_Flow32</bpmn:incoming>
        <bpmn:outgoing>W574_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W574_End19" name="Complete">
        <bpmn:incoming>W574_Flow33</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W574_Annotation20">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: mid-day cash sweeps per W278 reducing drawer cash levels; operational: last-call announcement 15 min before close and polite escort by Sales Associate; operational: Store Manager sign-off requirement on digital closing checklist
Owner: Store Manager (or Assistant Manager)</bpmn:text>
      </bpmn:textAnnotation>
