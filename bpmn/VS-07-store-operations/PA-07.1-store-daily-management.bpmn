    <bpmn:process id="W_W1537" name="W1537. Store-Level Parking Lot &amp; Exterior Area Daily Operations, Customer Vehicle Flow &amp; Security Management" isExecutable="false">
      <bpmn:documentation>Trigger: Daily store opening; or special event (sale weekend, delivery truck arrival)
Frequency: Daily (200 stores)
Volume: ~200–400 customer vehicles per store per day; ~2–3 delivery trucks per store per week (per profile §7.3)
Owner: Assistant Store Manager
Participants: Assistant Store Manager, Maintenance/Utility, Receiving Clerk, Security Guard
Source: workflow W1537 — Store-Level Parking Lot &amp; Exterior Area Daily Operations, Customer Vehicle Flow &amp; Security Management</bpmn:documentation>
      <bpmn:laneSet id="W1537_LaneSet5">
        <bpmn:lane id="W1537_Lane1" name="Maintenance">
        <bpmn:flowNodeRef>W1537_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1537_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1537_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1537_Lane2" name="Assistant Store Manager">
        <bpmn:flowNodeRef>W1537_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1537_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1537_Lane3" name="Receiving Clerk">
        <bpmn:flowNodeRef>W1537_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1537_Lane4" name="Security Guard">
        <bpmn:flowNodeRef>W1537_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1537_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1537_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1537_Start6" name="Daily store opening; or special event (sale weekend, delivery truck arrival)">
        <bpmn:outgoing>W1537_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1537_Task7" name="Morning exterior inspection">
        <bpmn:documentation>Step 1: Morning exterior inspection: Maintenance/Utility conducts pre-opening walk-through of parking lot, loading zone, and receiving area — check for overnight damage, debris, standing water (rainy season), proper lighting, signage visibility, speed bump condition; reports issues to Assistant Store Manager
Responsible (R): Maintenance/Utility
Accountable (A): Assistant Store Manager
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W1537_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1537_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1537_Task8" name="Traffic flow setup">
        <bpmn:documentation>Step 2: Traffic flow setup: For peak days (sale weekends, paydays — W578), Assistant Store Manager deploys traffic cones, directional signage, and additional parking guidance; coordinates with Security Guard for vehicle entry/exit flow management; activates overflow parking if needed
Responsible (R): Assistant Store Manager
Accountable (A): Store Manager
Duration: 15 min (peak days)</bpmn:documentation>
        <bpmn:incoming>W1537_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1537_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1537_Task9" name="Delivery truck staging">
        <bpmn:documentation>Step 3: Delivery truck staging: Receiving Clerk manages delivery truck queue in designated receiving area; trucks directed to appropriate dock door based on merchandise type; customer vehicles separated from delivery truck traffic for safety
Responsible (R): Receiving Clerk
Accountable (A): Assistant Store Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1537_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1537_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1537_Task10" name="Customer loading zone management">
        <bpmn:documentation>Step 4: Customer loading zone management: Designated loading zone near lumber yard exit for customers loading bulky purchases; Assistant Store Manager ensures loading zone is clear of abandoned vehicles (15-minute limit); Sales Associates assist with loading assistance per W950
Responsible (R): Assistant Store Manager / Sales Associate
Accountable (A): Store Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1537_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1537_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1537_Task11" name="Security patrol">
        <bpmn:documentation>Step 5: Security patrol: Security Guard conducts periodic exterior patrol — parking lot crime prevention (vehicle break-in deterrence), suspicious activity monitoring, perimeter fence check; CCTV exterior cameras monitored from security station
Responsible (R): Security Guard
Accountable (A): Store Manager
Duration: Every 2 hours</bpmn:documentation>
        <bpmn:incoming>W1537_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1537_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1537_Task12" name="Rainy season operations">
        <bpmn:documentation>Step 6: Rainy season operations: During Philippine rainy season (June–October), Maintenance/Utility deploys wet floor mats at store entrances, canopy umbrellas at cart return areas, additional drainage checks for parking lot flooding; Assistant Store Manager activates one-way traffic flow if parking lot partially flooded
Responsible (R): Maintenance/Utility
Accountable (A): Assistant Store Manager
Duration: As needed</bpmn:documentation>
        <bpmn:incoming>W1537_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1537_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1537_Task13" name="End-of-day exterior close">
        <bpmn:documentation>Step 7: End-of-day exterior close: Security Guard verifies all customer vehicles have departed; locks exterior gates; checks for abandoned items in parking lot; activates overnight security lighting and CCTV; reports any incidents or damage discovered
Responsible (R): Security Guard
Accountable (A): Assistant Store Manager
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W1537_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1537_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1537_End14" name="Complete">
        <bpmn:incoming>W1537_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1537_Annotation15">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Assistant Store Manager</bpmn:text>
      </bpmn:textAnnotation>
