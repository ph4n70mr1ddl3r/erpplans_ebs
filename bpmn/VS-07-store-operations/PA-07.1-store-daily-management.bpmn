    <bpmn:process id="W_W182" name="W182. Gift / Home Registry Lifecycle" isExecutable="false">
      <bpmn:documentation>Trigger: Customer (Home Builder/Renovator) creates a &quot;Project Wishlist&quot; or &quot;Registry&quot;
Frequency: ~50–100 new registries per month
Volume: Average registry value PHP 20,000–100,000; 10–30 items per registry
Owner: Customer Service Rep (CSR)
Participants: Customer, Sales Associate, Gift Givers
Source: workflow W182 — Gift / Home Registry Lifecycle</bpmn:documentation>
      <bpmn:laneSet id="W182_LaneSet5">
        <bpmn:lane id="W182_Lane1" name="Customer">
        <bpmn:flowNodeRef>W182_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W182_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W182_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W182_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W182_Lane2" name="Cashier">
        <bpmn:flowNodeRef>W182_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W182_Lane3" name="CSR">
        <bpmn:flowNodeRef>W182_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W182_Lane4" name="System">
        <bpmn:flowNodeRef>W182_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W182_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W182_Start6" name="Customer (Home Builder/Renovator) creates a &quot;Project Wishlist&quot; or &quot;Registry&quot;">
        <bpmn:outgoing>W182_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W182_Task7" name="Creation">
        <bpmn:documentation>Step 1: Creation: Customer creates Registry via Website or In-store Tablet; specifies &quot;Housewarming&quot; or &quot;Renovation Project&quot;
Responsible (R): Customer
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W182_Flow16</bpmn:incoming>
        <bpmn:outgoing>W182_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W182_Task8" name="Item Selection">
        <bpmn:documentation>Step 2: Item Selection: Customer walks store with Sales Associate; scans items into Registry using Mobile App
Responsible (R): Customer / Assoc
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W182_Flow17</bpmn:incoming>
        <bpmn:outgoing>W182_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W182_Task9" name="Sharing">
        <bpmn:documentation>Step 3: Sharing: Customer shares Registry link with family/friends; or provides &quot;Registry ID&quot; for in-store lookup
Responsible (R): Customer
Accountable (A): —
Duration: —</bpmn:documentation>
        <bpmn:incoming>W182_Flow18</bpmn:incoming>
        <bpmn:outgoing>W182_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W182_Task10" name="Purchase">
        <bpmn:documentation>Step 4: Purchase: Giver buys item from Registry (In-store or Online); system marks item as &quot;Purchased&quot; to prevent duplicates
Responsible (R): Cashier / System
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W182_Flow19</bpmn:incoming>
        <bpmn:outgoing>W182_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W182_Task11" name="Fulfillment">
        <bpmn:documentation>Step 5: Fulfillment: Items can be picked up by Giver, or held at CSR counter for &quot;Consolidated Delivery&quot; to the Registry Owner
Responsible (R): CSR
Accountable (A): Store Mgr
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W182_Flow20</bpmn:incoming>
        <bpmn:outgoing>W182_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W182_Task12" name="Completion">
        <bpmn:documentation>Step 6: Completion: Registry Owner receives &quot;Completion Discount&quot; (e.g., 10% off remaining items) after the event date
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W182_Flow21</bpmn:incoming>
        <bpmn:outgoing>W182_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W182_End13" name="Complete">
        <bpmn:incoming>W182_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W182_Annotation14">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Customer Service Rep (CSR)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W182_Assoc15" sourceRef="W182_Annotation14" targetRef="W182_Start6" associationDirection="None" />
