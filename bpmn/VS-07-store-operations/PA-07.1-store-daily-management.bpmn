    <bpmn:process id="W_W173" name="W173. Store-Level Solar Energy Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Daily performance tracking; or &quot;Inverter Failure&quot; alert from IoT system
Frequency: Daily monitoring; Quarterly cleaning
Volume: Applicable to ~80 stores with rooftop solar installations
Owner: Facilities Coordinator
Participants: Store Maintenance, Solar Vendor (External)
Source: workflow W173 — Store-Level Solar Energy Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W173_LaneSet4">
        <bpmn:lane id="W173_Lane1" name="System">
        <bpmn:flowNodeRef>W173_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W173_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W173_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W173_Lane2" name="Maintenance">
        <bpmn:flowNodeRef>W173_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W173_Lane3" name="Finance">
        <bpmn:flowNodeRef>W173_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W173_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W173_Start5" name="Daily performance tracking; or &quot;Inverter Failure&quot; alert from IoT system">
        <bpmn:outgoing>W173_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W173_Task6" name="Generation Tracking">
        <bpmn:documentation>Step 1: Generation Tracking: System pulls data from Solar Inverters; compares &quot;Actual Generation&quot; vs. &quot;Expected&quot; (based on weather/irradiance)
Responsible (R): System
Accountable (A): Facilities Coord
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W173_Flow13</bpmn:incoming>
        <bpmn:outgoing>W173_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W173_Task7" name="Anomaly Detection">
        <bpmn:documentation>Step 2: Anomaly Detection: If generation drops &gt; 15% below expected: system creates a W47 maintenance ticket; Facilities Coordinator reviews CCTV/Drone footage for panel obstructions (dust, debris)
Responsible (R): System
Accountable (A): Facilities Coord
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W173_Flow14</bpmn:incoming>
        <bpmn:outgoing>W173_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W173_Task8" name="Cleaning Routine">
        <bpmn:documentation>Step 3: Cleaning Routine: Quarterly: Store Maintenance or Vendor performs panel cleaning to remove soot/dust (critical in high-traffic/industrial areas)
Responsible (R): Maintenance
Accountable (A): Store Mgr
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W173_Flow15</bpmn:incoming>
        <bpmn:outgoing>W173_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W173_Task9" name="Savings Verification">
        <bpmn:documentation>Step 4: Savings Verification: Monthly: Finance compares Solar Generation (Self-Consumption) against Meralco/Utility bill reduction to verify ROI
Responsible (R): Finance
Accountable (A): Controller
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W173_Flow16</bpmn:incoming>
        <bpmn:outgoing>W173_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W173_End10" name="Complete">
        <bpmn:incoming>W173_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W173_Annotation11">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: Facilities Coordinator review and approval gate
Owner: Facilities Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W173_Assoc12" sourceRef="W173_Annotation11" targetRef="W173_Start5" associationDirection="None" />
