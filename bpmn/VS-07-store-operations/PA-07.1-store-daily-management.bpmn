    <bpmn:process id="W_W12A" name="W12A. In-Store Returns" isExecutable="false">
      <bpmn:documentation>Trigger: Customer brings item to Customer Service counter for return/exchange
Frequency: ~2% of POS transactions ≈ 56,000/month = ~1,867 returns/day chain-wide; ~9 per store/day
Volume: ~56,000 returns/month chain-wide
Owner: Customer Service Rep
Participants: CSR, Store Manager (approval for high-value or no-receipt returns), Stock Associate (restock)
Source: workflow W12A — In-Store Returns</bpmn:documentation>
      <bpmn:laneSet id="W12A_LaneSet6">
        <bpmn:lane id="W12A_Lane1" name="Customer">
        <bpmn:flowNodeRef>W12A_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W12A_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W12A_Lane2" name="CSR">
        <bpmn:flowNodeRef>W12A_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W12A_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W12A_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W12A_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W12A_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W12A_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W12A_Lane4" name="System">
        <bpmn:flowNodeRef>W12A_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W12A_Lane5" name="Stock Associate">
        <bpmn:flowNodeRef>W12A_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W12A_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W12A_Start7" name="Customer brings item to Customer Service counter for return/exchange">
        <bpmn:outgoing>W12A_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W12A_Task8" name="Customer presents item and receipt (or provides transaction details) at CSR…">
        <bpmn:documentation>Step 1: Customer presents item and receipt (or provides transaction details) at CSR counter
Responsible (R): Customer
Accountable (A): —
Duration: —</bpmn:documentation>
        <bpmn:incoming>W12A_Flow19</bpmn:incoming>
        <bpmn:outgoing>W12A_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W12A_Task9" name="CSR looks up original transaction in system by receipt number or loyalty card">
        <bpmn:documentation>Step 2: CSR looks up original transaction in system by receipt number or loyalty card
Responsible (R): CSR
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W12A_Flow20</bpmn:incoming>
        <bpmn:outgoing>W12A_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W12A_Task10" name="CSR inspects item condition (resalable, damaged, defective)">
        <bpmn:documentation>Step 3: CSR inspects item condition (resalable, damaged, defective)
Responsible (R): CSR
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W12A_Flow21</bpmn:incoming>
        <bpmn:outgoing>W12A_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W12A_Task11" name="If return within policy and with receipt: CSR processes return in system">
        <bpmn:documentation>Step 4: If return within policy and with receipt: CSR processes return in system
Responsible (R): CSR
Accountable (A): Store Manager
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W12A_Flow22</bpmn:incoming>
        <bpmn:outgoing>W12A_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W12A_Task12" name="If no receipt or outside standard policy: escalate to Store Manager for approval">
        <bpmn:documentation>Step 5: If no receipt or outside standard policy: escalate to Store Manager for approval
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W12A_Flow23</bpmn:incoming>
        <bpmn:outgoing>W12A_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W12A_Task13" name="System processes refund (original tender method) or issues store credit; for…">
        <bpmn:documentation>Step 6: System processes refund (original tender method) or issues store credit; for split-tender transactions (e.g., customer paid PHP 1,000 cash + PHP 800 credit card): system refunds pro-rata to each original tender method in proportion to the amount paid via each method; if cash refund would exceed store cash availability threshold, system defaults to card or e-wallet refund for the excess portion; Store Manager can override with authorization
Responsible (R): System / CSR
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W12A_Flow24</bpmn:incoming>
        <bpmn:outgoing>W12A_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W12A_Task14" name="Inventory returned to stock (if resalable) or flagged as damaged/defective">
        <bpmn:documentation>Step 7: Inventory returned to stock (if resalable) or flagged as damaged/defective
Responsible (R): Stock Associate
Accountable (A): Dept. Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W12A_Flow25</bpmn:incoming>
        <bpmn:outgoing>W12A_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W12A_Task15" name="Defective items flagged for Return to Vendor (RTV) process">
