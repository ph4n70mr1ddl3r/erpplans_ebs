      <bpmn:sequenceFlow id="W1085_Flow16" sourceRef="W1085_Task7" targetRef="W1085_Task8" />
      <bpmn:sequenceFlow id="W1085_Flow17" sourceRef="W1085_Task8" targetRef="W1085_Task9" />
      <bpmn:sequenceFlow id="W1085_Flow18" sourceRef="W1085_Task9" targetRef="W1085_Task10" />
      <bpmn:sequenceFlow id="W1085_Flow19" sourceRef="W1085_Task10" targetRef="W1085_End11" />
    </bpmn:process>
