        <bpmndi:BPMNShape id="W1537_Annotation15_di" bpmnElement="W1537_Annotation15"><dc:Bounds x="160" y="800" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1537_Flow17_di" bpmnElement="W1537_Flow17"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1537_Flow18_di" bpmnElement="W1537_Flow18"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1537_Flow19_di" bpmnElement="W1537_Flow19"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1537_Flow20_di" bpmnElement="W1537_Flow20"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1537_Flow21_di" bpmnElement="W1537_Flow21"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1537_Flow22_di" bpmnElement="W1537_Flow22"><di:waypoint x="1420" y="675" /><di:waypoint x="1450" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1537_Flow23_di" bpmnElement="W1537_Flow23"><di:waypoint x="1630" y="165" /><di:waypoint x="1660" y="675" /></bpmndi:BPMNEdge>
