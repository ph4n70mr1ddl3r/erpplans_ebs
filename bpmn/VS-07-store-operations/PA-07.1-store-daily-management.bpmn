    <bpmn:process id="W_W574" name="W574. Store-Level Daily Closing Procedure" isExecutable="false">
      <bpmn:documentation>Trigger: Store operating hours end (typically 8:00 PM, or 9:00 PM during extended hours)
Frequency: Daily per store
Volume: 200 stores × 365 days = 73,000 closings/year
Owner: Store Manager (or Assistant Manager)
Participants: Store Manager, Lead Cashier, Security Guard, Stock Associate
Source: workflow W574 — Store-Level Daily Closing Procedure</bpmn:documentation>
      <bpmn:laneSet id="W574_LaneSet6">
        <bpmn:lane id="W574_Lane1" name="Lead Cashier">
        <bpmn:flowNodeRef>W574_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W574_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W574_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W574_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W574_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W574_Lane2" name="Sales Associate">
        <bpmn:flowNodeRef>W574_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W574_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W574_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W574_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W574_Task18</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W574_Lane4" name="Stock Associate">
        <bpmn:flowNodeRef>W574_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W574_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
