        <bpmndi:BPMNEdge id="W1142_Flow12_di" bpmnElement="W1142_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1142_Flow13_di" bpmnElement="W1142_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1142_Flow14_di" bpmnElement="W1142_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1142_Flow15_di" bpmnElement="W1142_Flow15"><di:waypoint x="1210" y="165" /><di:waypoint x="1260" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1142_Assoc10_di" bpmnElement="W1142_Assoc10"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1243" name="W1243. Store-Level Customer Lumber Grading Verification, Quality Dispute &amp; Claims Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer reports lumber quality issue (warped, cracked, wrong grade, under-sized) at store
Frequency: ~5–10 quality disputes per store per month; ~1,000–2,000 incidents/month chain-wide
Volume: ~200 stores × ~7 incidents/month = ~1,400 incidents/month; ~16,800 incidents/year
Owner: Department Supervisor (Lumber &amp; Building Materials)
Participants: Department Supervisor, Store Manager, Customer, Vendor Account Manager, Merchandise Analyst
Source: workflow W1243 — Store-Level Customer Lumber Grading Verification, Quality Dispute &amp; Claims Processing</bpmn:documentation>
      <bpmn:laneSet id="W1243_LaneSet4">
        <bpmn:lane id="W1243_Lane1" name="Department Supervisor">
        <bpmn:flowNodeRef>W1243_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1243_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1243_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1243_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1243_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1243_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W1243_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1243_Lane3" name="Category Manager">
        <bpmn:flowNodeRef>W1243_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1243_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1243_Start5" name="Customer reports lumber quality issue (warped, cracked, wrong grade, under-sized) at store">
        <bpmn:outgoing>W1243_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1243_Task6" name="Customer complaint intake">
        <bpmn:documentation>Step 1: Customer complaint intake: Department Supervisor receives complaint at lumber yard or customer service counter: (a) customer presents receipt and lumber in question; (b) Supervisor inspects lumber: measure dimensions (caliper check), check for warp/bow/twist, assess knot frequency and size, check moisture indicators; (c) document issue with photos via handheld device
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W1243_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1243_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1243_Task7" name="Grade verification">
        <bpmn:documentation>Step 2: Grade verification: Supervisor checks lumber against grade standard: (a) verify species and grade marked on lumber or delivery tag; (b) compare against vendor specification in item master per W252; (c) for Philippine lumber: verify against DTI/PISO grading standards; (d) for import lumber: verify against applicable grading rule (e.g., WWPA, NLGA)
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W1243_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1243_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1243_Task8" name="Dispute resolution">
        <bpmn:documentation>Step 3: Dispute resolution: Based on inspection: (a) if lumber clearly does not meet claimed grade: immediate exchange or refund per W12A; (b) if borderline (within tolerance): offer courtesy exchange for customer goodwill, especially for trade accounts; (c) if customer claim is invalid (correct grade, normal characteristics): explain grading standards, offer alternative selection; (d) all outcomes logged in system with photos
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W1243_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1243_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1243_Task9" name="Vendor claim (if vendor-caused)">
        <bpmn:documentation>Step 4: Vendor claim (if vendor-caused): If issue is systemic (multiple complaints for same batch/vendor): (a) Store Manager escalates to Category Manager with evidence; (b) Category Manager files vendor quality claim per W110 (Supplier Quality &amp; CAPA); (c) if pattern persists: escalate to vendor QBR per W1224; (d) vendor may issue credit, replace stock, or implement corrective action
Responsible (R): Store Manager / Category Manager
Accountable (A): VP Merchandising
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1243_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1243_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1243_Task10" name="Inventory action">
        <bpmn:documentation>Step 5: Inventory action: (a) returned lumber that is still saleable: restock with correct grade label; (b) defective lumber: move to damaged goods area per W91; (c) if batch-wide issue: quarantine remaining stock per W219 pending vendor response; (d) system adjusts inventory accordingly
Responsible (R): Department Supervisor / Stock Associate
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1243_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1243_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1243_Task11" name="Monthly dispute analytics">
        <bpmn:documentation>Step 6: Monthly dispute analytics: Category Manager reviews lumber quality dispute data: (a) dispute rate by vendor and species; (b) common defect types; (c) resolution rate and cost (refunds, exchanges, vendor credits); (d) adjust vendor scorecard and purchasing decisions per W44
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1243_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1243_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1243_End12" name="Complete">
        <bpmn:incoming>W1243_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1243_Annotation13">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: Department Supervisor (Lumber &amp; Building Materials) review and approval gate
Owner: Department Supervisor (Lumber &amp; Building Materials)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1243_Assoc14" sourceRef="W1243_Annotation13" targetRef="W1243_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1243_Flow15" sourceRef="W1243_Start5" targetRef="W1243_Task6" />
      <bpmn:sequenceFlow id="W1243_Flow16" sourceRef="W1243_Task6" targetRef="W1243_Task7" />
      <bpmn:sequenceFlow id="W1243_Flow17" sourceRef="W1243_Task7" targetRef="W1243_Task8" />
      <bpmn:sequenceFlow id="W1243_Flow18" sourceRef="W1243_Task8" targetRef="W1243_Task9" />
      <bpmn:sequenceFlow id="W1243_Flow19" sourceRef="W1243_Task9" targetRef="W1243_Task10" />
      <bpmn:sequenceFlow id="W1243_Flow20" sourceRef="W1243_Task10" targetRef="W1243_Task11" />
      <bpmn:sequenceFlow id="W1243_Flow21" sourceRef="W1243_Task11" targetRef="W1243_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1243_diag">
