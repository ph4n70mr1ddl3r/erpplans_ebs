        <bpmn:flowNodeRef>W29_Task26</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W29_Lane10" name="VP Merchandising + Legal">
        <bpmn:flowNodeRef>W29_Task27</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W29_Lane11" name="VP Merchandising + Internal Audit">
        <bpmn:flowNodeRef>W29_Task28</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W29_End29</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W29_Start13" name="DTI/BPS recall notice, vendor recall notification, or internal quality discovery">
        <bpmn:outgoing>W29_Flow32</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W29_Task14" name="Recall trigger received: DTI/BPS directive, vendor notification, or internal…">
        <bpmn:documentation>Step 1: Recall trigger received: DTI/BPS directive, vendor notification, or internal quality report
Responsible (R): Buyer / Legal
Accountable (A): VP Merchandising
Duration: —</bpmn:documentation>
        <bpmn:incoming>W29_Flow32</bpmn:incoming>
        <bpmn:outgoing>W29_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W29_Task15" name="VP Merchandising activates recall protocol: identifies affected SKUs, lot…">
        <bpmn:documentation>Step 2: VP Merchandising activates recall protocol: identifies affected SKUs, lot numbers, batch numbers, date ranges
Responsible (R): VP Merchandising
Accountable (A): COO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W29_Flow33</bpmn:incoming>
        <bpmn:outgoing>W29_Flow34</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W29_Task16" name="System generates affected inventory report: locations holding the identified…">
        <bpmn:documentation>Step 3: System generates affected inventory report: locations holding the identified lots/batches, quantities on hand, quantities sold (with customer data if traceable via loyalty or B2B account)
Responsible (R): System
Accountable (A): VP Merchandising
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W29_Flow34</bpmn:incoming>
        <bpmn:outgoing>W29_Flow35</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W29_Task17" name="Buyer contacts vendor for recall instructions (return, destroy, credit terms)">
        <bpmn:documentation>Step 4: Buyer contacts vendor for recall instructions (return, destroy, credit terms)
Responsible (R): Buyer
Accountable (A): VP Merchandising
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W29_Flow35</bpmn:incoming>
        <bpmn:outgoing>W29_Flow36</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W29_Task18" name="IT immediately blocks affected items at POS: system flags items as &quot;recall — do…">
        <bpmn:documentation>Step 5: IT immediately blocks affected items at POS: system flags items as &quot;recall — do not sell&quot;; cashiers see alert when scanning
Responsible (R): IT
Accountable (A): CIO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W29_Flow36</bpmn:incoming>
        <bpmn:outgoing>W29_Flow37</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W29_Task19" name="Ecommerce: system removes affected items from website; cancels pending orders…">
        <bpmn:documentation>Step 6: Ecommerce: system removes affected items from website; cancels pending orders containing recalled items; initiates refunds
Responsible (R): System / Ecom Team
Accountable (A): CMO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W29_Flow37</bpmn:incoming>
        <bpmn:outgoing>W29_Flow38</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W29_Task20" name="Store Ops instructs all stores to pull affected items from shelves immediately…">
        <bpmn:documentation>Step 7: Store Ops instructs all stores to pull affected items from shelves immediately; quarantine in backroom
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W29_Flow38</bpmn:incoming>
        <bpmn:outgoing>W29_Flow39</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W29_Task21" name="Marketing issues public recall notice (press release, social media, website…">
        <bpmn:documentation>Step 8: Marketing issues public recall notice (press release, social media, website banner, in-store signage)
Responsible (R): Marketing
Accountable (A): CMO
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W29_Flow39</bpmn:incoming>
        <bpmn:outgoing>W29_Flow40</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W29_Task22" name="Customer Service handles inbound inquiries; processes returns/exchanges for…">
        <bpmn:documentation>Step 9: Customer Service handles inbound inquiries; processes returns/exchanges for recalled items (no receipt required)
Responsible (R): CSR / Call Center
Accountable (A): VP Store Operations
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W29_Flow40</bpmn:incoming>
        <bpmn:outgoing>W29_Flow41</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W29_Task23" name="System tracks all recalled items returned by customers; matches against sold…">
        <bpmn:documentation>Step 10: System tracks all recalled items returned by customers; matches against sold quantities to gauge recall coverage
Responsible (R): System
Accountable (A): VP Merchandising
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W29_Flow41</bpmn:incoming>
        <bpmn:outgoing>W29_Flow42</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W29_Task24" name="Store Managers report quarantine completion; system records inventory hold per…">
        <bpmn:documentation>Step 11: Store Managers report quarantine completion; system records inventory hold per location
Responsible (R): Store Manager
Accountable (A): VP Store Operations
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W29_Flow42</bpmn:incoming>
        <bpmn:outgoing>W29_Flow43</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W29_Task25" name="Per vendor instructions: initiate RTV or on-site destruction with documentation">
        <bpmn:documentation>Step 12: Per vendor instructions: initiate RTV or on-site destruction with documentation
Responsible (R): Buyer / DC Supervisor
Accountable (A): VP Merchandising
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W29_Flow43</bpmn:incoming>
        <bpmn:outgoing>W29_Flow44</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W29_Task26" name="Legal prepares regulatory report (DTI/BPS) documenting recall scope, actions…">
        <bpmn:documentation>Step 13: Legal prepares regulatory report (DTI/BPS) documenting recall scope, actions taken, and customer notifications
Responsible (R): Legal
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W29_Flow44</bpmn:incoming>
        <bpmn:outgoing>W29_Flow45</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W29_Task27" name="Post-recall: VP Merchandising and Legal conduct after-action review; update…">
        <bpmn:documentation>Step 14: Post-recall: VP Merchandising and Legal conduct after-action review; update quality procedures
Responsible (R): VP Merchandising + Legal
Accountable (A): COO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W29_Flow45</bpmn:incoming>
        <bpmn:outgoing>W29_Flow46</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W29_Task28" name="Annual mock recall exercise: VP Merchandising and Internal Audit conduct a…">
        <bpmn:documentation>Step 15: Annual mock recall exercise: VP Merchandising and Internal Audit conduct a simulated recall on 2–3 randomly selected lot-tracked items; test forward and backward traceability (W29.3), POS blocking speed (W29.5), ecommerce removal (W29.6), and customer notification completeness; measure time from recall activation to all stores confirming quarantine; results documented and shared with Category Managers and Buyers; vendor recall clause compliance verified — all vendor contracts (W2C, W36) must include recall cooperation obligations (response SLA, cost responsibility, product replacement or credit terms)
Responsible (R): VP Merchandising + Internal Audit
Accountable (A): COO
Duration: 4 hours/year</bpmn:documentation>
        <bpmn:incoming>W29_Flow46</bpmn:incoming>
        <bpmn:outgoing>W29_Flow47</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W29_End29" name="Complete">
        <bpmn:incoming>W29_Flow47</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W29_Annotation30">
        <bpmn:text>Controls: - CTL-36 (ensure recall execution.) | - operational: lot/batch traceability with POS blocking (W29.3/W29.5) so targeted customer notification stays possible
Owner: VP Merchandising (product side); VP Store Operations (execution)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W29_Assoc31" sourceRef="W29_Annotation30" targetRef="W29_Start13" associationDirection="None" />
