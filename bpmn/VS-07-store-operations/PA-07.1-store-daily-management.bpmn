    <bpmn:process id="W_W950" name="W950. Store-Level Customer Vehicle Loading Assistance &amp; Load Securing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer purchases bulky or heavy items requiring assistance to load into their vehicle, or customer requests loading help at the yard/loading area
Frequency: ~40,000–60,000 loading events/month chain-wide (~200–300/store/month)
Volume: 1–10 items per loading event; average 3–4 items
Owner: Store Manager
Participants: Stock Associate (Loader), Customer, Receiving Clerk (yard coordination), Sales Associate (item retrieval)
Source: workflow W950 — Store-Level Customer Vehicle Loading Assistance &amp; Load Securing</bpmn:documentation>
      <bpmn:laneSet id="W950_LaneSet3">
        <bpmn:lane id="W950_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W950_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W950_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W950_Lane2" name="Stock Associate">
        <bpmn:flowNodeRef>W950_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W950_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W950_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W950_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W950_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W950_Start4" name="Customer purchases bulky or heavy items requiring assistance to load into their vehicle…">
        <bpmn:outgoing>W950_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W950_Task5" name="Loading Request Initiation">
        <bpmn:documentation>Step 1: Loading Request Initiation: Customer completes purchase at POS; cashier identifies items requiring loading assistance: (a) heavy items (&gt; 15kg per piece); (b) oversized items (length &gt; 1.5m or volume &gt; 0.1cbm); (c) fragile items (glass per W943, tiles, mirrors); (d) multi-item purchases (&gt; 5 pieces); cashier prints loading slip with item list, quantities, and vehicle loading zone assignment; customer drives to designated loading zone (yard area for lumber/building materials, side door for general merchandise); Stock Associate notified via handheld of pending loading job
Responsible (R): Cashier / System
Accountable (A): Store Manager
Duration: 2–3 min</bpmn:documentation>
        <bpmn:incoming>W950_Flow13</bpmn:incoming>
        <bpmn:outgoing>W950_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W950_Task6" name="Vehicle Assessment &amp; Load Planning">
        <bpmn:documentation>Step 2: Vehicle Assessment &amp; Load Planning: Stock Associate meets customer at loading zone; assesses: (a) vehicle type — pickup truck (open bed), SUV/van, sedan, multicab, motorcycle/sidecar; (b) vehicle condition — tire condition, suspension, cargo capacity; (c) load plan — item placement sequence (heaviest items first/bottom, fragile items on top), weight distribution (left-right balance), and space optimization; for motorcycles with sidecars: max load 100kg total, items secured to sidecar frame only; for sedans: items inside cabin only (no trunk protrusion per LTO regulations); Stock Associate advises customer if vehicle cannot safely carry all items — offers: (a) split delivery (partial load now + delivery per W668 for remainder); (b) customer returns with larger vehicle; (c) expedited delivery scheduling
Responsible (R): Stock Associate
Accountable (A): Store Manager
Duration: 3–5 min</bpmn:documentation>
        <bpmn:incoming>W950_Flow14</bpmn:incoming>
        <bpmn:outgoing>W950_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W950_Task7" name="Physical Loading Execution">
        <bpmn:documentation>Step 3: Physical Loading Execution: Stock Associate(s) load items into/onto vehicle: (a) uses proper lifting techniques (bent knees, straight back, team lift for items &gt; 25kg per W697 ergonomics); (b) positions items per load plan; (c) protects vehicle surfaces with protective blankets/mats (BuildRight-provided); (d) protects merchandise with edge protection (cardboard corners for tiles/plywood); for yard items (lumber, cement, steel): Stock Associate uses yard forklift or hand truck per equipment safety protocol per W579; customer must remain in designated safe zone during forklift operations per W649; items that extend beyond vehicle length (lumber, pipes): Stock Associate attaches red flag per LTO regulations
Responsible (R): Stock Associate
Accountable (A): Store Manager
Duration: 5–15 min</bpmn:documentation>
        <bpmn:incoming>W950_Flow15</bpmn:incoming>
        <bpmn:outgoing>W950_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W950_Task8" name="Load Securing &amp; Safety Verification">
        <bpmn:documentation>Step 4: Load Securing &amp; Safety Verification: Stock Associate secures load using: (a) ratchet straps (provided by BuildRight at cost); (b) nylon rope (available for purchase or complimentary for small loads); (c) bungee cords (customer-provided or available for purchase); verifies: (a) load stability — no shifting when vehicle gently rocked; (b) no protruding sharp edges; (c) clear driver visibility (no items blocking rear window or mirrors); (d) tailgate/hood secure; Stock Associate signs off on loading slip: &quot;Load secured, safety verified&quot;; customer countersigns acknowledging load acceptance and safe loading confirmation
Responsible (R): Stock Associate / Customer
Accountable (A): Store Manager
Duration: 3–5 min</bpmn:documentation>
        <bpmn:incoming>W950_Flow16</bpmn:incoming>
        <bpmn:outgoing>W950_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W950_Task9" name="Post-Loading Documentation &amp; Zone Cleanup">
        <bpmn:documentation>Step 5: Post-Loading Documentation &amp; Zone Cleanup: Stock Associate returns loading slip to customer service counter; system records loading event for analytics (loading time, items, vehicle type, associate ID); loading zone cleared for next customer; loading equipment (hand trucks, forklift, blankets, straps) returned to storage; daily: Store Manager reviews loading log for safety incidents and service time metrics
Responsible (R): Stock Associate / System
Accountable (A): Store Manager
Duration: 2–3 min</bpmn:documentation>
        <bpmn:incoming>W950_Flow17</bpmn:incoming>
        <bpmn:outgoing>W950_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W950_End10" name="Complete">
        <bpmn:incoming>W950_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W950_Annotation11">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: team-lift policy for items &gt; 25kg
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W950_Assoc12" sourceRef="W950_Annotation11" targetRef="W950_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W950_Flow13" sourceRef="W950_Start4" targetRef="W950_Task5" />
      <bpmn:sequenceFlow id="W950_Flow14" sourceRef="W950_Task5" targetRef="W950_Task6" />
      <bpmn:sequenceFlow id="W950_Flow15" sourceRef="W950_Task6" targetRef="W950_Task7" />
      <bpmn:sequenceFlow id="W950_Flow16" sourceRef="W950_Task7" targetRef="W950_Task8" />
      <bpmn:sequenceFlow id="W950_Flow17" sourceRef="W950_Task8" targetRef="W950_Task9" />
      <bpmn:sequenceFlow id="W950_Flow18" sourceRef="W950_Task9" targetRef="W950_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W950_diag">
      <bpmndi:BPMNPlane id="W950_plane" bpmnElement="W_W950">
        <bpmndi:BPMNShape id="W950_Lane1_di" bpmnElement="W950_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W950_Lane2_di" bpmnElement="W950_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W950_Task5_di" bpmnElement="W950_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W950_Task6_di" bpmnElement="W950_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W950_Task7_di" bpmnElement="W950_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W950_Task8_di" bpmnElement="W950_Task8"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W950_Task9_di" bpmnElement="W950_Task9"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W950_Start4_di" bpmnElement="W950_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W950_End10_di" bpmnElement="W950_End10"><dc:Bounds x="1470" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W950_Annotation11_di" bpmnElement="W950_Annotation11"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W950_Flow13_di" bpmnElement="W950_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W950_Flow14_di" bpmnElement="W950_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W950_Flow15_di" bpmnElement="W950_Flow15"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W950_Flow16_di" bpmnElement="W950_Flow16"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W950_Flow17_di" bpmnElement="W950_Flow17"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W950_Flow18_di" bpmnElement="W950_Flow18"><di:waypoint x="1420" y="335" /><di:waypoint x="1470" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W950_Assoc12_di" bpmnElement="W950_Assoc12"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W951" name="W951. Store-Level Bulk Material Breaking &amp; Custom Quantity Packaging" isExecutable="false">
      <bpmn:documentation>Trigger: Customer requests a quantity smaller than the standard package/bundle for a bulk material (e.g., 5 individual cement bags from a pallet, 1 piece from a 10-pack, or 2 meters from a 50-meter roll)
Frequency: ~8,000–12,000 transactions/month chain-wide (~40–60/store/month)
Volume: 1–5 line items per transaction
Owner: Department Supervisor
Participants: Sales Associate, Customer, Stock Associate (bulk area handling), Receiving Clerk
Source: workflow W951 — Store-Level Bulk Material Breaking &amp; Custom Quantity Packaging</bpmn:documentation>
      <bpmn:laneSet id="W951_LaneSet4">
        <bpmn:lane id="W951_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W951_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W951_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W951_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W951_Lane2" name="Stock Associate">
        <bpmn:flowNodeRef>W951_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W951_Lane3" name="Department Supervisor">
        <bpmn:flowNodeRef>W951_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W951_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W951_Start5" name="Customer requests a quantity smaller than the standard package/bundle for a bulk material…">
        <bpmn:outgoing>W951_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W951_Task6" name="Customer Request &amp; Quantity Confirmation">
        <bpmn:documentation>Step 1: Customer Request &amp; Quantity Confirmation: Customer requests quantity smaller than standard package; Sales Associate confirms: (a) item and standard package size (e.g., cement: sold per bag but stocked on pallet of 40; nails: sold per kg but stocked in 25kg boxes; tiles: sold per piece but stocked in cartons of 10–20); (b) requested quantity; (c) whether item is already available in broken quantities from previous W439 repackaging; (d) if not pre-broken, Sales Associate checks breakability policy — some items (sealed adhesives, safety equipment) cannot be broken from original packaging for safety/warranty reasons
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 3–5 min</bpmn:documentation>
        <bpmn:incoming>W951_Flow13</bpmn:incoming>
        <bpmn:outgoing>W951_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W951_Task7" name="Bulk Break Execution">
        <bpmn:documentation>Step 2: Bulk Break Execution: Stock Associate retrieves full package from bulk storage area; performs breaking: (a) cement/lumber: individual units already separable — count and pull requested quantity; (b) nails/screws in bulk boxes: weigh requested quantity on scale, bag in plastic bag, label with weight and unit price; (c) wire/cable on rolls: measure and cut requested length; (d) tiles in cartons: open carton, count requested pieces, re-seal remaining carton with tape and update carton count label; (e) chemicals (paint, thinner, adhesive): decant into smaller container if policy allows, or sell minimum original container; Stock Associate creates a &quot;broken pack&quot; inventory adjustment in the system: original pack reduced by broken quantity; broken quantity created as individual unit(s) with same SKU
Responsible (R): Stock Associate
Accountable (A): Department Supervisor
Duration: 5–15 min</bpmn:documentation>
        <bpmn:incoming>W951_Flow14</bpmn:incoming>
        <bpmn:outgoing>W951_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W951_Task8" name="Pricing &amp; POS Processing">
        <bpmn:documentation>Step 3: Pricing &amp; POS Processing: System prices the broken quantity: (a) individual unit price from pricing master (W289) — same unit price as if sold individually; (b) if no individual price exists, system calculates pro-rata from pack price (pack price ÷ pack quantity); (c) no bulk-breaking surcharge (absorbed as customer service); customer pays at POS with broken items; system updates inventory: original pack reduced, individual units sold, remaining broken pack inventory available for next customer
Responsible (R): Sales Associate / Cashier
Accountable (A): Department Supervisor
Duration: 3–5 min</bpmn:documentation>
        <bpmn:incoming>W951_Flow15</bpmn:incoming>
        <bpmn:outgoing>W951_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W951_Task9" name="Broken Pack Inventory Management">
        <bpmn:documentation>Step 4: Broken Pack Inventory Management: At end of day, Department Supervisor reviews broken pack inventory report: (a) partially broken packs that have been open &gt; 7 days — assess for restocking (re-seal and return to shelf) or markdown (damaged packaging per W549); (b) broken pack accuracy — verify physical count matches system count; discrepancy investigated per W514; (c) fast-breaking items identified for proactive repackaging per W439 to reduce on-demand breaking time
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 15–20 min/day</bpmn:documentation>
        <bpmn:incoming>W951_Flow16</bpmn:incoming>
        <bpmn:outgoing>W951_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W951_End10" name="Complete">
        <bpmn:incoming>W951_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W951_Annotation11">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: due to miscounting, unlabeled partial packs, or pilferage
Owner: Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W951_Assoc12" sourceRef="W951_Annotation11" targetRef="W951_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W951_Flow13" sourceRef="W951_Start5" targetRef="W951_Task6" />
      <bpmn:sequenceFlow id="W951_Flow14" sourceRef="W951_Task6" targetRef="W951_Task7" />
      <bpmn:sequenceFlow id="W951_Flow15" sourceRef="W951_Task7" targetRef="W951_Task8" />
      <bpmn:sequenceFlow id="W951_Flow16" sourceRef="W951_Task8" targetRef="W951_Task9" />
      <bpmn:sequenceFlow id="W951_Flow17" sourceRef="W951_Task9" targetRef="W951_End10" />
    </bpmn:process>
