    <bpmn:process id="W_W1130" name="W1130. Store-Level Paint Tinting Machine Calibration Verification &amp; Color Accuracy Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly scheduled calibration check, or customer complaint about color mismatch, or new tinting colorant cartridge installation
Frequency: Weekly calibration (200 stores); ad-hoc calibration after complaints (~50–100/month chain-wide)
Volume: 1 tinting machine per store × 200 stores = 200 weekly calibrations
Owner: Department Supervisor / Sales Associate
Participants: Paint Associate / Department Supervisor, Vendor Technical Support (as needed)
Source: workflow W1130 — Store-Level Paint Tinting Machine Calibration Verification &amp; Color Accuracy Audit</bpmn:documentation>
      <bpmn:laneSet id="W1130_LaneSet3">
        <bpmn:lane id="W1130_Lane1" name="Paint Associate">
        <bpmn:flowNodeRef>W1130_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1130_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1130_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1130_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1130_Lane2" name="Department Supervisor">
        <bpmn:flowNodeRef>W1130_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1130_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1130_Start4" name="Weekly scheduled calibration check, or customer complaint about color mismatch, or new…">
        <bpmn:outgoing>W1130_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1130_Task5" name="Weekly Calibration Verification">
        <bpmn:documentation>Step 1: Weekly Calibration Verification: (a) designated Paint Associate performs weekly calibration check every Monday before store opening; (b) test dispense: machine dispenses each colorant into graduated cylinder — verify volume matches expected dispense (e.g., 10 pulses should equal exactly 10 mL ± 0.2 mL); (c) check colorant cartridge levels and expiration dates; (d) check colorant consistency — stir test for each cartridge (colorant should be smooth, no lumps, no separation); (e) check machine cleanliness — nozzle cleaning per manufacturer schedule; (f) check software version — ensure tinting software is updated with latest color formulas from paint vendors; (g) record calibration results in Oracle eAM (fit-gap F5)
Responsible (R): Paint Associate
Accountable (A): Department Supervisor
Duration: 20–30 min</bpmn:documentation>
        <bpmn:incoming>W1130_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1130_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1130_Task6" name="Color Accuracy Test Mix">
        <bpmn:documentation>Step 2: Color Accuracy Test Mix: (a) mix standard test colors using verified machine: 3 test colors from each major paint vendor (e.g., Davies, Boysen, Dutch Boy, Nippon Paint); (b) apply test mix to standard color card (white card stock) using drawdown bar for uniform film thickness; (c) allow to dry for 15 minutes (accelerated drying with heat gun if needed); (d) compare dried sample against vendor-provided color standard under standardized lighting (D65 daylight lamp at paint station); (e) visual pass/fail: test sample should be indistinguishable from standard at arm&#x27;s length; (f) if discrepancy visible: measure color difference (ΔE) using portable spectrophotometer (if available); acceptable ΔE &lt; 2.0; (g) photograph test sample alongside standard for digital record
Responsible (R): Paint Associate
Accountable (A): Department Supervisor
Duration: 15–20 min</bpmn:documentation>
        <bpmn:incoming>W1130_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1130_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1130_Task7" name="Calibration Adjustment &amp; Vendor Escalation">
        <bpmn:documentation>Step 3: Calibration Adjustment &amp; Vendor Escalation: (a) if any colorant dispense is outside tolerance (± 0.2 mL per 10 pulses): perform machine recalibration per manufacturer procedure; (b) if colorant is expired, separated, or contaminated: replace cartridge with fresh stock from backroom; (c) if test color fails visual comparison: clean nozzles, check base paint lot, re-mix test sample; (d) if failure persists after cleaning and re-mix: log service request with tinting machine vendor for on-site technician visit; (e) in the interim: machine flagged as &quot;restricted — standard formulas only&quot; (no custom color matching) until technician resolves; (f) estimated downtime: 1–3 business days for vendor technician visit
Responsible (R): Paint Associate / Vendor Technician
Accountable (A): Department Supervisor
Duration: 15–60 min</bpmn:documentation>
        <bpmn:incoming>W1130_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1130_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1130_Task8" name="Customer Complaint Response &amp; Re-Mix">
        <bpmn:documentation>Step 4: Customer Complaint Response &amp; Re-Mix: (a) if customer reports color mismatch: Department Supervisor reviews complaint details — formula used, base paint type, intended application; (b) check if complaint coincides with calibration issue already identified; (c) if machine error confirmed: offer free re-mix at full quantity + complimentary sample for customer to verify before leaving store; (d) wrong-color paint from complaint dispositioned: donate to community project per W444, or return to vendor for credit per W88; (e) complaint logged in ERP with root cause (calibration drift, colorant issue, customer expectation mismatch); (f) monthly complaint rate tracked per store — stores exceeding 2% complaint rate receive vendor priority service visit
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W1130_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1130_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1130_End9" name="Complete">
        <bpmn:incoming>W1130_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1130_Annotation10">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: Department Supervisor (Paint &amp; Finishes) or designated Paint Associate review and approval gate
Owner: Department Supervisor / Sales Associate</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1130_Assoc11" sourceRef="W1130_Annotation10" targetRef="W1130_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1130_Flow12" sourceRef="W1130_Start4" targetRef="W1130_Task5" />
      <bpmn:sequenceFlow id="W1130_Flow13" sourceRef="W1130_Task5" targetRef="W1130_Task6" />
      <bpmn:sequenceFlow id="W1130_Flow14" sourceRef="W1130_Task6" targetRef="W1130_Task7" />
      <bpmn:sequenceFlow id="W1130_Flow15" sourceRef="W1130_Task7" targetRef="W1130_Task8" />
      <bpmn:sequenceFlow id="W1130_Flow16" sourceRef="W1130_Task8" targetRef="W1130_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1130_diag">
      <bpmndi:BPMNPlane id="W1130_plane" bpmnElement="W_W1130">
        <bpmndi:BPMNShape id="W1130_Lane1_di" bpmnElement="W1130_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1130_Lane2_di" bpmnElement="W1130_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
