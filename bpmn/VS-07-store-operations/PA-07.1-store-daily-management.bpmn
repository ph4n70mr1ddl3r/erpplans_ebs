        <bpmndi:BPMNShape id="W1130_Task6_di" bpmnElement="W1130_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1130_Task7_di" bpmnElement="W1130_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1130_Task8_di" bpmnElement="W1130_Task8"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1130_Start4_di" bpmnElement="W1130_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1130_End9_di" bpmnElement="W1130_End9"><dc:Bounds x="1260" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1130_Annotation10_di" bpmnElement="W1130_Annotation10"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1130_Flow12_di" bpmnElement="W1130_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1130_Flow13_di" bpmnElement="W1130_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1130_Flow14_di" bpmnElement="W1130_Flow14"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1130_Flow15_di" bpmnElement="W1130_Flow15"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1130_Flow16_di" bpmnElement="W1130_Flow16"><di:waypoint x="1210" y="335" /><di:waypoint x="1260" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1130_Assoc11_di" bpmnElement="W1130_Assoc11"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1133" name="W1133. Store-Level Customer Special Order Cancellation &amp; Partial Refund Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer requests cancellation of a special order (non-stock / made-to-order item), or ordered item no longer needed
Frequency: ~800–1,200 special order cancellations/month across all stores (~20–30% of the 3,000–5,000 special orders/month canon)
Volume: 1 order per cancellation request
Owner: Customer Service Rep
Participants: Customer Service Rep, Department Supervisor, Customer, Vendor (if order already placed with vendor)
Source: workflow W1133 — Store-Level Customer Special Order Cancellation &amp; Partial Refund Processing</bpmn:documentation>
      <bpmn:laneSet id="W1133_LaneSet3">
        <bpmn:lane id="W1133_Lane1" name="Customer Service Rep">
        <bpmn:flowNodeRef>W1133_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1133_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1133_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1133_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1133_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1133_Lane2" name="Department Supervisor">
        <bpmn:flowNodeRef>W1133_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1133_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1133_Start4" name="Customer requests cancellation of a special order (non-stock / made-to-order item), or…">
        <bpmn:outgoing>W1133_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1133_Task5" name="Cancellation Request Intake">
        <bpmn:documentation>Step 1: Cancellation Request Intake: (a) customer contacts store (in-person, phone, or app) to cancel special order; (b) CSR retrieves order in ERP: order number, item description, quantity, total value, deposit paid, order status (pending vendor PO, in production, shipped to DC, ready for pickup); (c) CSR verifies customer identity against order record; (d) documents cancellation reason in system
Responsible (R): Customer Service Rep
Accountable (A): Customer Service Rep
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W1133_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1133_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1133_Task6" name="Cancellation Eligibility &amp; Refund Tier Determination">
        <bpmn:documentation>Step 2: Cancellation Eligibility &amp; Refund Tier Determination: (a) system checks order status and determines refund tier: Tier 1 — Full Refund: order not yet sent to vendor (status: &quot;Pending&quot;) → 100% refund of deposit, no cancellation fee; Tier 2 — Partial Refund: order sent to vendor but not yet in production (status: &quot;PO Issued&quot;) → refund minus 10% restocking/cancellation fee; Tier 3 — Limited Refund: item in production or shipped by vendor (status: &quot;In Production&quot; or &quot;Shipped&quot;) → refund minus 30–50% depending on vendor&#x27;s ability to cancel or return; Tier 4 — No Refund: custom-made item completed and received at store (status: &quot;Ready for Pickup&quot;) → no refund; item treated as regular inventory after 30-day hold period, customer forfeits deposit; (b) CSR explains refund tier to customer with rationale
Responsible (R): Customer Service Rep / System
Accountable (A): Department Supervisor
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W1133_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1133_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1133_Task7" name="Vendor Cancellation Coordination (Tier 2–3)">
        <bpmn:documentation>Step 3: Vendor Cancellation Coordination (Tier 2–3): (a) for orders already placed with vendor: CSR contacts vendor to request order cancellation; (b) vendor response options: cancellation accepted at no charge → Tier 1 refund to customer; cancellation accepted with restocking fee → customer charged vendor&#x27;s fee; cancellation not possible (custom fabrication complete) → item shipped to store, customer charged full amount, deposit forfeited; (c) vendor cancellation response recorded in ERP; (d) if vendor agrees to cancel: ERP cancels PO and initiates any prepayment recovery per W498
Responsible (R): Customer Service Rep
Accountable (A): Department Supervisor
Duration: 10–20 min</bpmn:documentation>
        <bpmn:incoming>W1133_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1133_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1133_Task8" name="Refund Processing &amp; Deposit Settlement">
        <bpmn:documentation>Step 4: Refund Processing &amp; Deposit Settlement: (a) CSR processes refund per determined tier: refund to original payment method (credit card reversal, GCash refund, bank transfer) per W101; or store credit issuance per W781 (offered as alternative with 5% bonus value as incentive); (b) system reverses sales order and any linked PO; (c) refund receipt generated and emailed to customer; (d) if partial refund: customer signs digital acknowledgment of cancellation terms and refund amount
Responsible (R): Customer Service Rep / System
Accountable (A): Department Supervisor
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W1133_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1133_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1133_Task9" name="Post-Cancellation Inventory Handling">
        <bpmn:documentation>Step 5: Post-Cancellation Inventory Handling: (a) if vendor ships item despite cancellation (Tier 3): item received at store and dispositioned — attempt resale as special order to another customer (if generic enough); list on clearance per W93 if no alternative buyer within 30 days; (b) cancellation analytics tracked: cancellation rate by category, reason, and vendor; (c) high-cancellation categories flagged for assortment review (W1) — may indicate items that should be carried as stock items
Responsible (R): Department Supervisor / System
Accountable (A): Store Manager
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W1133_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1133_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1133_End10" name="Complete">
        <bpmn:incoming>W1133_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1133_Annotation11">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: Customer Service Rep review and approval gate
Owner: Customer Service Rep</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1133_Assoc12" sourceRef="W1133_Annotation11" targetRef="W1133_Start4" associationDirection="None" />
