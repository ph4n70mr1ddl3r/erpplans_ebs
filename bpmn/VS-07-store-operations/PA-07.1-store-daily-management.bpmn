    <bpmn:process id="W_W575" name="W575. Store-Level Weekly Sales &amp; Operations Review" isExecutable="false">
      <bpmn:documentation>Trigger: Every Monday morning (or first working day of the week)
Frequency: Weekly per store; Regional Manager reviews bottom-quartile stores
Volume: 200 stores × 52 weeks = 10,400 reviews/year
Owner: Store Manager
Participants: Store Manager, Department Supervisors, Regional Manager (for flagged stores)
Source: workflow W575 — Store-Level Weekly Sales &amp; Operations Review</bpmn:documentation>
      <bpmn:laneSet id="W575_LaneSet3">
        <bpmn:lane id="W575_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W575_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W575_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W575_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W575_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W575_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W575_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W575_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W575_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W575_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W575_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W575_Lane2" name="Regional Manager">
        <bpmn:flowNodeRef>W575_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W575_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W575_Start4" name="Every Monday morning (or first working day of the week)">
        <bpmn:outgoing>W575_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W575_Task5" name="Store Manager reviews system-generated weekly scorecard: sales vs. budget by…">
        <bpmn:documentation>Step 1: Store Manager reviews system-generated weekly scorecard: sales vs. budget by department, average transaction value (ATV), transaction count trend, gross margin by department
Responsible (R): Store Manager
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W575_Flow18</bpmn:incoming>
        <bpmn:outgoing>W575_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W575_Task6" name="Review promotional sell-through vs. plan for any promotions active during the…">
        <bpmn:documentation>Step 2: Review promotional sell-through vs. plan for any promotions active during the week
Responsible (R): Store Manager
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W575_Flow19</bpmn:incoming>
        <bpmn:outgoing>W575_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W575_Task7" name="Review customer satisfaction scores and top 3 complaint categories per W597">
        <bpmn:documentation>Step 3: Review customer satisfaction scores and top 3 complaint categories per W597
Responsible (R): Store Manager
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W575_Flow20</bpmn:incoming>
        <bpmn:outgoing>W575_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W575_Task8" name="Review shrinkage and LP incidents; compare vs. prior week and vs. regional…">
        <bpmn:documentation>Step 4: Review shrinkage and LP incidents; compare vs. prior week and vs. regional average
Responsible (R): Store Manager
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W575_Flow21</bpmn:incoming>
        <bpmn:outgoing>W575_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W575_Task9" name="Review staffing effectiveness: labor cost % of revenue, overtime hours…">
        <bpmn:documentation>Step 5: Review staffing effectiveness: labor cost % of revenue, overtime hours, absenteeism rate per W594
Responsible (R): Store Manager
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W575_Flow22</bpmn:incoming>
        <bpmn:outgoing>W575_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W575_Task10" name="Review facility and equipment issues: open maintenance work orders per W47…">
        <bpmn:documentation>Step 6: Review facility and equipment issues: open maintenance work orders per W47, equipment safety check failures per W579
Responsible (R): Store Manager
Accountable (A): —
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W575_Flow23</bpmn:incoming>
        <bpmn:outgoing>W575_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W575_Task11" name="Identify top 3 action items for the coming week with owners, deadlines, and…">
        <bpmn:documentation>Step 7: Identify top 3 action items for the coming week with owners, deadlines, and expected outcomes
Responsible (R): Store Manager
Accountable (A): Department Supervisors
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W575_Flow24</bpmn:incoming>
        <bpmn:outgoing>W575_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W575_Task12" name="Brief Department Supervisors on key findings and action items during Monday…">
        <bpmn:documentation>Step 8: Brief Department Supervisors on key findings and action items during Monday morning huddle
Responsible (R): Store Manager
Accountable (A): Department Supervisors
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W575_Flow25</bpmn:incoming>
        <bpmn:outgoing>W575_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W575_Task13" name="Submit weekly report to Regional Manager via system (auto-populated from…">
        <bpmn:documentation>Step 9: Submit weekly report to Regional Manager via system (auto-populated from scorecard with Store Manager commentary)
Responsible (R): Store Manager
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W575_Flow26</bpmn:incoming>
        <bpmn:outgoing>W575_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W575_Task14" name="Regional Manager reviews bottom-quartile stores by sales performance and takes…">
        <bpmn:documentation>Step 10: Regional Manager reviews bottom-quartile stores by sales performance and takes action (call, visit, or escalation to VP Store Operations)
Responsible (R): Regional Manager
Accountable (A): VP Store Operations
Duration: 30 min/week across portfolio</bpmn:documentation>
        <bpmn:incoming>W575_Flow27</bpmn:incoming>
        <bpmn:outgoing>W575_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W575_End15" name="Complete">
        <bpmn:incoming>W575_Flow28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W575_Annotation16">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: Regional Manager follow-up on bottom-quartile stores and requiring Store Manager commentary on variance explanations; operational: carrying forward incomplete items to next week&#x27;s review and tracking in system; operational: focusing on bottom quartile and exception-flagged stores only
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
