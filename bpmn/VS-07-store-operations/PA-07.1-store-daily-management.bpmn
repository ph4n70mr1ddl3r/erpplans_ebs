        <bpmn:flowNodeRef>W5E_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5E_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5E_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5E_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5E_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5E_Start3" name="Issue discovered during W5A store opening sequence that prevents normal opening by…">
        <bpmn:outgoing>W5E_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5E_Task4" name="Store Manager identifies delay issue during W5A opening sequence; assesses…">
        <bpmn:documentation>Step 1: Store Manager identifies delay issue during W5A opening sequence; assesses severity per delay scenario table above
Responsible (R): Store Manager
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W5E_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5E_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5E_Task5" name="Store Manager contacts appropriate support: IT Helpdesk (W48) for system…">
        <bpmn:documentation>Step 2: Store Manager contacts appropriate support: IT Helpdesk (W48) for system issues, Facilities Coordinator (W47) for physical issues, alarm company for security issues
Responsible (R): Store Manager
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W5E_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5E_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5E_Task6" name="Store Manager decides: (a) delay opening by estimated fix time, or (b) open in…">
        <bpmn:documentation>Step 3: Store Manager decides: (a) delay opening by estimated fix time, or (b) open in minimum viable configuration per scenario table
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W5E_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5E_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5E_Task7" name="If delaying: Store Manager posts &quot;Opening at [time]&quot; signage on store entrance…">
        <bpmn:documentation>Step 4: If delaying: Store Manager posts &quot;Opening at [time]&quot; signage on store entrance; updates store status in system; Regional Manager notified
Responsible (R): Store Manager
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W5E_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5E_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5E_Task8" name="If opening with reduced capacity: Store Manager assigns available staff to…">
        <bpmn:documentation>Step 5: If opening with reduced capacity: Store Manager assigns available staff to critical positions (minimum 1 cashier, 1 floor, 1 manager); remaining terminals shuttered; DSD receiving deferred
Responsible (R): Store Manager
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W5E_Flow18</bpmn:incoming>
        <bpmn:outgoing>W5E_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5E_Task9" name="Upon issue resolution: Store Manager transitions to full operations…">
        <bpmn:documentation>Step 6: Upon issue resolution: Store Manager transitions to full operations; communicates &quot;now open&quot; via store signage and system update; reconciles manual transactions (if any) per W5G upon system restoration
Responsible (R): Store Manager
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W5E_Flow19</bpmn:incoming>
        <bpmn:outgoing>W5E_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5E_Task10" name="Store Manager documents delay incident in system: root cause, duration of…">
        <bpmn:documentation>Step 7: Store Manager documents delay incident in system: root cause, duration of delay, impact on sales (estimated lost revenue), corrective action taken; includes in daily report to Regional Manager
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W5E_Flow20</bpmn:incoming>
        <bpmn:outgoing>W5E_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5E_End11" name="Complete">
        <bpmn:incoming>W5E_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5E_Annotation12">
        <bpmn:text>Controls: (none recorded)
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
