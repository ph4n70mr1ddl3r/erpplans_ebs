<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-07.1-store-daily-management" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W5" name="W5. Daily Store Operations" isExecutable="false">
      <bpmn:documentation>Source: workflow W5 — Daily Store Operations</bpmn:documentation>
      <bpmn:laneSet id="W5_LaneSet2">
        <bpmn:lane id="W5_Lane1" name="Unassigned">
        <bpmn:flowNodeRef>W5_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5_Start3" name="Trigger">
        <bpmn:outgoing>W5_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5_Task4" name="Execute Daily Store Operations">
        <bpmn:documentation>Step 1: Execute Daily Store Operations
Responsible (R): Unassigned
Accountable (A): Unassigned
Duration: —</bpmn:documentation>
        <bpmn:incoming>W5_Flow8</bpmn:incoming>
        <bpmn:outgoing>W5_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5_End5" name="Complete">
        <bpmn:incoming>W5_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5_Annotation6">
        <bpmn:text>Controls: (none recorded)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5_Assoc7" sourceRef="W5_Annotation6" targetRef="W5_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W5_Flow8" sourceRef="W5_Start3" targetRef="W5_Task4" />
      <bpmn:sequenceFlow id="W5_Flow9" sourceRef="W5_Task4" targetRef="W5_End5" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5_diag">
      <bpmndi:BPMNPlane id="W5_plane" bpmnElement="W_W5">
        <bpmndi:BPMNShape id="W5_Lane1_di" bpmnElement="W5_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="530" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5_Task4_di" bpmnElement="W5_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5_Start3_di" bpmnElement="W5_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5_End5_di" bpmnElement="W5_End5"><dc:Bounds x="630" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5_Annotation6_di" bpmnElement="W5_Annotation6"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W5_Flow8_di" bpmnElement="W5_Flow8"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5_Flow9_di" bpmnElement="W5_Flow9"><di:waypoint x="580" y="165" /><di:waypoint x="630" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5_Assoc7_di" bpmnElement="W5_Assoc7"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5A" name="W5A. Store Opening" isExecutable="false">
      <bpmn:documentation>Trigger: Store operating hours begin (typically 8:00 AM)
Frequency: Daily per store
Volume: 200 stores × 365 days = 73,000 openings/year
Owner: Store Manager (or Assistant Manager)
Participants: Store Manager, Cashier, Stock Associate, Security Guard
Source: workflow W5A — Store Opening</bpmn:documentation>
      <bpmn:laneSet id="W5A_LaneSet4">
        <bpmn:lane id="W5A_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W5A_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5A_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5A_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5A_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5A_Lane2" name="Cashier">
        <bpmn:flowNodeRef>W5A_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5A_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5A_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5A_Lane3" name="Stock Associate">
        <bpmn:flowNodeRef>W5A_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5A_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5A_Start5" name="Store operating hours begin (typically 8:00 AM)">
        <bpmn:outgoing>W5A_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5A_Task6" name="Store Manager or Asst. Manager arrives; disarms alarm, unlocks">
        <bpmn:documentation>Step 1: Store Manager or Asst. Manager arrives; disarms alarm, unlocks
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W5A_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5A_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5A_Task7" name="Walk store floor: check for overnight issues (leaks, break-in signs, safety…">
        <bpmn:documentation>Step 2: Walk store floor: check for overnight issues (leaks, break-in signs, safety hazards)
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W5A_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5A_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5A_Task8" name="Boot up POS terminals; verify system connectivity">
        <bpmn:documentation>Step 3: Boot up POS terminals; verify system connectivity
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W5A_Flow18</bpmn:incoming>
        <bpmn:outgoing>W5A_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5A_Task9" name="Count and load cash floats into each cash drawer (PHP 20,000/terminal × 3 = PHP…">
        <bpmn:documentation>Step 4: Count and load cash floats into each cash drawer (PHP 20,000/terminal × 3 = PHP 60,000 per store — the till float per W764, distinct from the PHP 20,000 petty-cash float per W25)
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W5A_Flow19</bpmn:incoming>
        <bpmn:outgoing>W5A_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5A_Task10" name="Log in to POS; confirm local data store is current (continuous sync status…">
        <bpmn:documentation>Step 5: Log in to POS; confirm local data store is current (continuous sync status green, last event received &lt; 5 min ago)
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W5A_Flow20</bpmn:incoming>
        <bpmn:outgoing>W5A_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5A_Task11" name="Assign cashiers to terminals; brief on any promotions starting today">
        <bpmn:documentation>Step 6: Assign cashiers to terminals; brief on any promotions starting today
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W5A_Flow21</bpmn:incoming>
        <bpmn:outgoing>W5A_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5A_Task12" name="Stock Associates begin replenishing shelves from backroom (ongoing)">
        <bpmn:documentation>Step 7: Stock Associates begin replenishing shelves from backroom (ongoing)
Responsible (R): Stock Associate
Accountable (A): Department Supervisor
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W5A_Flow22</bpmn:incoming>
        <bpmn:outgoing>W5A_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5A_End13" name="Complete">
        <bpmn:incoming>W5A_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5A_Annotation14">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Store Manager (or Assistant Manager)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5A_Assoc15" sourceRef="W5A_Annotation14" targetRef="W5A_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W5A_Flow16" sourceRef="W5A_Start5" targetRef="W5A_Task6" />
      <bpmn:sequenceFlow id="W5A_Flow17" sourceRef="W5A_Task6" targetRef="W5A_Task7" />
      <bpmn:sequenceFlow id="W5A_Flow18" sourceRef="W5A_Task7" targetRef="W5A_Task8" />
      <bpmn:sequenceFlow id="W5A_Flow19" sourceRef="W5A_Task8" targetRef="W5A_Task9" />
      <bpmn:sequenceFlow id="W5A_Flow20" sourceRef="W5A_Task9" targetRef="W5A_Task10" />
      <bpmn:sequenceFlow id="W5A_Flow21" sourceRef="W5A_Task10" targetRef="W5A_Task11" />
      <bpmn:sequenceFlow id="W5A_Flow22" sourceRef="W5A_Task11" targetRef="W5A_Task12" />
      <bpmn:sequenceFlow id="W5A_Flow23" sourceRef="W5A_Task12" targetRef="W5A_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5A_diag">
      <bpmndi:BPMNPlane id="W5A_plane" bpmnElement="W_W5A">
        <bpmndi:BPMNShape id="W5A_Lane1_di" bpmnElement="W5A_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5A_Lane2_di" bpmnElement="W5A_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5A_Lane3_di" bpmnElement="W5A_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5A_Task6_di" bpmnElement="W5A_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5A_Task7_di" bpmnElement="W5A_Task7"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5A_Task8_di" bpmnElement="W5A_Task8"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5A_Task9_di" bpmnElement="W5A_Task9"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5A_Task10_di" bpmnElement="W5A_Task10"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5A_Task11_di" bpmnElement="W5A_Task11"><dc:Bounds x="1450" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5A_Task12_di" bpmnElement="W5A_Task12"><dc:Bounds x="1660" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5A_Start5_di" bpmnElement="W5A_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5A_End13_di" bpmnElement="W5A_End13"><dc:Bounds x="1890" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5A_Annotation14_di" bpmnElement="W5A_Annotation14"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W5A_Flow16_di" bpmnElement="W5A_Flow16"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5A_Flow17_di" bpmnElement="W5A_Flow17"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5A_Flow18_di" bpmnElement="W5A_Flow18"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5A_Flow19_di" bpmnElement="W5A_Flow19"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5A_Flow20_di" bpmnElement="W5A_Flow20"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5A_Flow21_di" bpmnElement="W5A_Flow21"><di:waypoint x="1420" y="335" /><di:waypoint x="1450" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5A_Flow22_di" bpmnElement="W5A_Flow22"><di:waypoint x="1630" y="165" /><di:waypoint x="1660" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5A_Flow23_di" bpmnElement="W5A_Flow23"><di:waypoint x="1840" y="505" /><di:waypoint x="1890" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5A_Assoc15_di" bpmnElement="W5A_Assoc15"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5B" name="W5B. In-Store Selling" isExecutable="false">
      <bpmn:documentation>Trigger: Customer enters store
Frequency: Continuous during operating hours
Volume: ~14,000 transactions/store/month; ~467/day
Owner: Department Supervisors (floor), Lead Cashier (checkout)
Participants: Sales Associate, Cashier, Store Manager, Customer
Source: workflow W5B — In-Store Selling</bpmn:documentation>
      <bpmn:laneSet id="W5B_LaneSet4">
        <bpmn:lane id="W5B_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W5B_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5B_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5B_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5B_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5B_Lane2" name="Cashier">
        <bpmn:flowNodeRef>W5B_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5B_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5B_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5B_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5B_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5B_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5B_Task17</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5B_Lane3" name="System">
        <bpmn:flowNodeRef>W5B_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5B_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5B_End18</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5B_Start5" name="Customer enters store">
        <bpmn:outgoing>W5B_Flow21</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5B_Task6" name="Customer browses; Sales Associate provides assistance, product advice">
        <bpmn:documentation>Step 1: Customer browses; Sales Associate provides assistance, product advice
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: Varies</bpmn:documentation>
        <bpmn:incoming>W5B_Flow21</bpmn:incoming>
        <bpmn:outgoing>W5B_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5B_Task7" name="If item is catch-weight (lumber, wire): Associate measures/cuts; generates…">
        <bpmn:documentation>Step 2: If item is catch-weight (lumber, wire): Associate measures/cuts; generates weight/length label
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 3–5 min</bpmn:documentation>
        <bpmn:incoming>W5B_Flow22</bpmn:incoming>
        <bpmn:outgoing>W5B_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5B_Task8" name="If paint mixing: Associate mixes paint per customer color choice; system…">
        <bpmn:documentation>Step 3: If paint mixing: Associate mixes paint per customer color choice; system creates custom SKU
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W5B_Flow23</bpmn:incoming>
        <bpmn:outgoing>W5B_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5B_Task9" name="Customer brings items to checkout; Cashier scans barcodes">
        <bpmn:documentation>Step 4: Customer brings items to checkout; Cashier scans barcodes
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: ~2 min/txn</bpmn:documentation>
        <bpmn:incoming>W5B_Flow24</bpmn:incoming>
        <bpmn:outgoing>W5B_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5B_Task10" name="If loyalty member: Cashier scans loyalty card or asks for mobile number">
        <bpmn:documentation>Step 5: If loyalty member: Cashier scans loyalty card or asks for mobile number
Responsible (R): Cashier
Accountable (A): —
Duration: 15 sec</bpmn:documentation>
        <bpmn:incoming>W5B_Flow25</bpmn:incoming>
        <bpmn:outgoing>W5B_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W5B_Task11" name="System calculates totals: applies promos, quantity breaks, loyalty discounts">
        <bpmn:documentation>Step 6: System calculates totals: applies promos, quantity breaks, loyalty discounts
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W5B_Flow26</bpmn:incoming>
        <bpmn:outgoing>W5B_Flow27</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W5B_Task12" name="Customer pays (cash, card, e-wallet, split tender)">
        <bpmn:documentation>Step 7: Customer pays (cash, card, e-wallet, split tender)
Responsible (R): Cashier
Accountable (A): —
Duration: 30–60 sec</bpmn:documentation>
        <bpmn:incoming>W5B_Flow27</bpmn:incoming>
        <bpmn:outgoing>W5B_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W5B_Task13" name="Receipt printed; transaction published as event to ERP message bus — inventory…">
        <bpmn:documentation>Step 8: Receipt printed; transaction published as event to ERP message bus — inventory deducted in near-real-time (&lt; 30 sec), GL posted, loyalty updated (per W533)
Responsible (R): System / Cashier
Accountable (A): —
Duration: 15 sec</bpmn:documentation>
        <bpmn:incoming>W5B_Flow28</bpmn:incoming>
        <bpmn:outgoing>W5B_Flow29</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W5B_Task14" name="Age-restricted items trigger cashier confirmation prompt">
        <bpmn:documentation>Step 9: Age-restricted items trigger cashier confirmation prompt
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 10 sec</bpmn:documentation>
        <bpmn:incoming>W5B_Flow29</bpmn:incoming>
        <bpmn:outgoing>W5B_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5B_Task15" name="Void transaction">
        <bpmn:documentation>Step 10: Void transaction: Cashier or Store Manager initiates void before transaction is finalized (pre-void) or after finalization (post-void); manager authorization (swipe/card) required for any void; system logs void with cashier ID, authorizing manager ID, original transaction number, void reason code, and timestamp; system reverses inventory deduction, payment, loyalty points earned/redeemed, and promo usage; voided transaction retained in full audit trail (not deleted)
Responsible (R): Cashier / Store Manager
Accountable (A): Store Manager
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W5B_Flow30</bpmn:incoming>
        <bpmn:outgoing>W5B_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5B_Task16" name="Price dispute at POS">
        <bpmn:documentation>Step 11: Price dispute at POS: customer claims the scanned price differs from the displayed shelf tag; Cashier visually verifies shelf tag; if discrepancy confirmed: (a) Cashier honors the shelf tag price (customer-friendly policy per DTI price tag accuracy requirements), (b) Cashier applies price override with reason code &quot;Shelf Tag Discrepancy&quot; — manager authorization required per standard W5B.4a override rules, (c) system logs dispute with original price, shelf tag price, cashier ID, authorizing manager ID, and item barcode; (d) system creates shelf tag discrepancy ticket auto-routed to Department Supervisor for immediate shelf tag correction (W63) and inclusion in next W69 price audit cycle; if the shelf tag price is higher than the scanned (system) price, Cashier informs customer that the lower system price applies — no override needed
Responsible (R): Cashier / Store Manager
Accountable (A): Store Manager
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W5B_Flow31</bpmn:incoming>
        <bpmn:outgoing>W5B_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5B_Task17" name="Employee purchase">
        <bpmn:documentation>Step 12: Employee purchase: employee presents employee ID badge at checkout; Cashier selects &quot;Employee Purchase&quot; tender type in POS; system applies configured employee discount (default 10% off SRP, configurable by company policy) and enforces purchase limits (max PHP 20,000/month per employee, max 3 units per SKU per month); discount does not stack with promotional pricing — lower of employee discount or promo price applies; employee discount excluded from catch-weight and clearance items; system logs employee purchase with employee ID, discount applied, and monthly running total; monthly: Store Manager receives employee purchase summary report; purchases exceeding monthly limit require Store Manager override with justification; employee purchases are not eligible for loyalty points earning
Responsible (R): Cashier / Employee
Accountable (A): Store Manager
Duration: 1 min additional</bpmn:documentation>
        <bpmn:incoming>W5B_Flow32</bpmn:incoming>
        <bpmn:outgoing>W5B_Flow33</bpmn:outgoing>
