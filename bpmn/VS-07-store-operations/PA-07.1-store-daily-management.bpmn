      </bpmn:startEvent>
      <bpmn:userTask id="W5F_Task6" name="Announce closing; last customers checked out">
        <bpmn:documentation>Step 1: Announce closing; last customers checked out
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W5F_Flow18</bpmn:incoming>
        <bpmn:outgoing>W5F_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5F_Task7" name="Run Z-report on each POS terminal (sales summary by tender type)">
        <bpmn:documentation>Step 2: Run Z-report on each POS terminal (sales summary by tender type)
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 5 min/terminal</bpmn:documentation>
        <bpmn:incoming>W5F_Flow19</bpmn:incoming>
        <bpmn:outgoing>W5F_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5F_Task8" name="Count physical cash in each drawer; compare to Z-report">
        <bpmn:documentation>Step 3: Count physical cash in each drawer; compare to Z-report
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 10 min/terminal</bpmn:documentation>
        <bpmn:incoming>W5F_Flow20</bpmn:incoming>
        <bpmn:outgoing>W5F_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5F_Task9" name="Investigate and document any cash variance &gt; PHP 200">
        <bpmn:documentation>Step 4: Investigate and document any cash variance &gt; PHP 200
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 10 min if any</bpmn:documentation>
        <bpmn:incoming>W5F_Flow21</bpmn:incoming>
        <bpmn:outgoing>W5F_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5F_Task10" name="Prepare cash deposit (cash + checks); secure in safe">
        <bpmn:documentation>Step 5: Prepare cash deposit (cash + checks); secure in safe
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W5F_Flow22</bpmn:incoming>
        <bpmn:outgoing>W5F_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5F_Task11" name="Log out of POS; shut down terminals">
        <bpmn:documentation>Step 6: Log out of POS; shut down terminals
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W5F_Flow23</bpmn:incoming>
        <bpmn:outgoing>W5F_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5F_Task12" name="Store Manager reviews daily sales summary on dashboard">
        <bpmn:documentation>Step 7: Store Manager reviews daily sales summary on dashboard
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W5F_Flow24</bpmn:incoming>
        <bpmn:outgoing>W5F_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5F_Task13" name="Complete daily checklist (safety, cleanliness, equipment)">
        <bpmn:documentation>Step 8: Complete daily checklist (safety, cleanliness, equipment)
Responsible (R): Maintenance/Utility
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W5F_Flow25</bpmn:incoming>
        <bpmn:outgoing>W5F_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5F_Task14" name="Arm alarm; lock up">
        <bpmn:documentation>Step 9: Arm alarm; lock up
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W5F_Flow26</bpmn:incoming>
        <bpmn:outgoing>W5F_Flow27</bpmn:outgoing>
      </bpmn:userTask>
