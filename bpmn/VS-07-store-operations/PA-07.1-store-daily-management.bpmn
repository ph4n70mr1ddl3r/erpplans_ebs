    <bpmn:process id="W_W16" name="W16. New Store Opening" isExecutable="false">
      <bpmn:documentation>Trigger: Board approval of new store location
Frequency: ~10–15 new stores/year
Volume: 1 store at a time; each takes 3–6 months from approval to opening
Owner: VP Store Operations
Participants: COO, VP Store Operations, Real Estate, IT, Merchandising, HR, Supply Chain, Marketing
Source: workflow W16 — New Store Opening</bpmn:documentation>
      <bpmn:laneSet id="W16_LaneSet13">
        <bpmn:lane id="W16_Lane1" name="Property Mgr Inc.">
        <bpmn:flowNodeRef>W16_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W16_Start14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W16_Lane2" name="Store Ops + Contractor">
        <bpmn:flowNodeRef>W16_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W16_Lane3" name="IT Team">
        <bpmn:flowNodeRef>W16_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W16_Task18</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W16_Lane4" name="Category Manager">
        <bpmn:flowNodeRef>W16_Task19</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W16_Lane5" name="Supply Planner">
        <bpmn:flowNodeRef>W16_Task20</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W16_Lane6" name="DC Team">
        <bpmn:flowNodeRef>W16_Task21</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W16_Lane7" name="Recruitment Officer">
        <bpmn:flowNodeRef>W16_Task22</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W16_Lane8" name="Store Ops + HR">
        <bpmn:flowNodeRef>W16_Task23</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W16_Lane9" name="New Store Staff">
        <bpmn:flowNodeRef>W16_Task24</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W16_Lane10" name="Marketing">
        <bpmn:flowNodeRef>W16_Task25</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W16_Lane11" name="Store Manager">
        <bpmn:flowNodeRef>W16_Task26</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W16_Lane12" name="All">
        <bpmn:flowNodeRef>W16_Task27</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W16_End28</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W16_Start14" name="Board approval of new store location">
        <bpmn:outgoing>W16_Flow31</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W16_Task15" name="Real Estate secures lease; negotiates terms with landlord">
        <bpmn:documentation>Step 1: Real Estate secures lease; negotiates terms with landlord
Responsible (R): Property Mgr Inc.
Accountable (A): COO
Duration: 1–2 months</bpmn:documentation>
        <bpmn:incoming>W16_Flow31</bpmn:incoming>
        <bpmn:outgoing>W16_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W16_Task16" name="Store fit-out: layout design, shelving, signage, POS cabling, paint">
        <bpmn:documentation>Step 2: Store fit-out: layout design, shelving, signage, POS cabling, paint
Responsible (R): Store Ops + Contractor
Accountable (A): COO
Duration: 2–3 months</bpmn:documentation>
        <bpmn:incoming>W16_Flow32</bpmn:incoming>
        <bpmn:outgoing>W16_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W16_Task17" name="IT installs connectivity (fiber/LTE), POS terminals, network equipment">
        <bpmn:documentation>Step 3: IT installs connectivity (fiber/LTE), POS terminals, network equipment
Responsible (R): IT Team
Accountable (A): CIO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W16_Flow33</bpmn:incoming>
        <bpmn:outgoing>W16_Flow34</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W16_Task18" name="IT configures store location in ERP system (location master, tax registration…">
        <bpmn:documentation>Step 4: IT configures store location in ERP system (location master, tax registration, GL segments)
Responsible (R): IT Team
Accountable (A): CIO
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W16_Flow34</bpmn:incoming>
        <bpmn:outgoing>W16_Flow35</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W16_Task19" name="Merchandising assigns SKU assortment to new store; sets initial order quantities">
        <bpmn:documentation>Step 5: Merchandising assigns SKU assortment to new store; sets initial order quantities
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W16_Flow35</bpmn:incoming>
        <bpmn:outgoing>W16_Flow36</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W16_Task20" name="Supply Chain plans initial fill: DC generates transfer orders for opening stock">
        <bpmn:documentation>Step 6: Supply Chain plans initial fill: DC generates transfer orders for opening stock
Responsible (R): Supply Planner
Accountable (A): Supply Chain Manager
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W16_Flow36</bpmn:incoming>
        <bpmn:outgoing>W16_Flow37</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W16_Task21" name="DC picks, packs, and ships opening inventory to new store">
        <bpmn:documentation>Step 7: DC picks, packs, and ships opening inventory to new store
Responsible (R): DC Team
Accountable (A): DC Manager
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W16_Flow37</bpmn:incoming>
        <bpmn:outgoing>W16_Flow38</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W16_Task22" name="HR recruits store staff (~30 people); assigns Store Manager first">
        <bpmn:documentation>Step 8: HR recruits store staff (~30 people); assigns Store Manager first
Responsible (R): Recruitment Officer
Accountable (A): CHRO
Duration: 4–6 weeks</bpmn:documentation>
        <bpmn:incoming>W16_Flow38</bpmn:incoming>
        <bpmn:outgoing>W16_Flow39</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W16_Task23" name="Store Manager + staff training (POS, processes, safety, product knowledge)">
        <bpmn:documentation>Step 9: Store Manager + staff training (POS, processes, safety, product knowledge)
Responsible (R): Store Ops + HR
Accountable (A): VP Store Operations
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W16_Flow39</bpmn:incoming>
        <bpmn:outgoing>W16_Flow40</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W16_Task24" name="Receiving and stocking: new team receives goods and merchandises store floor">
        <bpmn:documentation>Step 10: Receiving and stocking: new team receives goods and merchandises store floor
Responsible (R): New Store Staff
Accountable (A): Store Manager
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W16_Flow40</bpmn:incoming>
        <bpmn:outgoing>W16_Flow41</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W16_Task25" name="Marketing executes grand opening campaign">
        <bpmn:documentation>Step 11: Marketing executes grand opening campaign
Responsible (R): Marketing
Accountable (A): CMO
Duration: 2 weeks (lead)</bpmn:documentation>
        <bpmn:incoming>W16_Flow41</bpmn:incoming>
        <bpmn:outgoing>W16_Flow42</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W16_Task26" name="Soft opening (friends &amp; family, VIP); iron out issues">
        <bpmn:documentation>Step 12: Soft opening (friends &amp; family, VIP); iron out issues
Responsible (R): Store Manager
Accountable (A): VP Store Operations
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W16_Flow42</bpmn:incoming>
        <bpmn:outgoing>W16_Flow43</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W16_Task27" name="Grand opening">
        <bpmn:documentation>Step 13: Grand opening
Responsible (R): All
Accountable (A): COO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W16_Flow43</bpmn:incoming>
        <bpmn:outgoing>W16_Flow44</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W16_End28" name="Complete">
        <bpmn:incoming>W16_Flow44</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W16_Annotation29">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
