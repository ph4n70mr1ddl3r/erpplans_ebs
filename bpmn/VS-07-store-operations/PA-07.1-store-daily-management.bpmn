    <bpmn:process id="W_W177" name="W177. Vending &amp; Concessionaire Management" isExecutable="false">
      <bpmn:documentation>Trigger: New concessionaire application; monthly rent/commission calculation
Frequency: ~1–3 new concessionaire onboardings per store per year; monthly billing cycle
Volume: ~200–600 active concessionaire agreements chain-wide (1–3 per store across 200 stores)
Owner: Store Manager
Participants: Concessionaire, Finance (AR), Store Operations
Source: workflow W177 — Vending &amp; Concessionaire Management</bpmn:documentation>
      <bpmn:laneSet id="W177_LaneSet5">
        <bpmn:lane id="W177_Lane1" name="Store Mgr">
        <bpmn:flowNodeRef>W177_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W177_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W177_Lane2" name="Finance">
        <bpmn:flowNodeRef>W177_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W177_Lane3" name="Cashier">
        <bpmn:flowNodeRef>W177_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W177_Lane4" name="AR Clerk">
        <bpmn:flowNodeRef>W177_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W177_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W177_Start6" name="New concessionaire application; monthly rent/commission calculation">
        <bpmn:outgoing>W177_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W177_Task7" name="Onboarding">
        <bpmn:documentation>Step 1: Onboarding: Store Manager reviews application for in-store cafe, snack bar, or ATM space; validates compliance with safety/health standards
Responsible (R): Store Mgr
Accountable (A): —
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W177_Flow14</bpmn:incoming>
        <bpmn:outgoing>W177_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W177_Task8" name="Contract Setup">
        <bpmn:documentation>Step 2: Contract Setup: Legal/Finance setup lease in ERP (W117); defines Rent or % Commission on Sales
Responsible (R): Finance
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W177_Flow15</bpmn:incoming>
        <bpmn:outgoing>W177_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W177_Task9" name="Sales Tracking">
        <bpmn:documentation>Step 3: Sales Tracking: If commission-based: Concessionaire sales are rung through a dedicated &quot;Non-Inventory&quot; SKU at POS; system tracks total monthly throughput
Responsible (R): Cashier
Accountable (A): —
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W177_Flow16</bpmn:incoming>
        <bpmn:outgoing>W177_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W177_Task10" name="Billing">
        <bpmn:documentation>Step 4: Billing: Monthly: Finance generates invoice for Rent + Utilities + Commission; offsets any payments collected on behalf of concessionaire
Responsible (R): AR Clerk
Accountable (A): Controller
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W177_Flow17</bpmn:incoming>
        <bpmn:outgoing>W177_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W177_End11" name="Complete">
        <bpmn:incoming>W177_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W177_Annotation12">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: Store Manager review and approval gate
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W177_Assoc13" sourceRef="W177_Annotation12" targetRef="W177_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W177_Flow14" sourceRef="W177_Start6" targetRef="W177_Task7" />
      <bpmn:sequenceFlow id="W177_Flow15" sourceRef="W177_Task7" targetRef="W177_Task8" />
      <bpmn:sequenceFlow id="W177_Flow16" sourceRef="W177_Task8" targetRef="W177_Task9" />
      <bpmn:sequenceFlow id="W177_Flow17" sourceRef="W177_Task9" targetRef="W177_Task10" />
      <bpmn:sequenceFlow id="W177_Flow18" sourceRef="W177_Task10" targetRef="W177_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W177_diag">
      <bpmndi:BPMNPlane id="W177_plane" bpmnElement="W_W177">
