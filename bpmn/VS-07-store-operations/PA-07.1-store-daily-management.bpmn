    <bpmn:process id="W_W463" name="W463. Catch-Weight &amp; Cut-to-Length Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer selects a variable-unit item (Lumber, Pipe, Wire, Bulk Nails)
Frequency: High; ~20–30% of big-box hardware transactions
Volume: Variable (per meter, per board foot, per kg)
Owner: Department Supervisor
Participants: Customer, Sales Associate, Cashier
Source: workflow W463 — Catch-Weight &amp; Cut-to-Length Processing</bpmn:documentation>
      <bpmn:laneSet id="W463_LaneSet5">
        <bpmn:lane id="W463_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W463_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W463_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W463_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W463_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W463_Lane2" name="Cashier">
        <bpmn:flowNodeRef>W463_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W463_Lane3" name="System">
        <bpmn:flowNodeRef>W463_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W463_Lane4" name="Dept Supervisor">
        <bpmn:flowNodeRef>W463_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W463_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W463_Start6" name="Customer selects a variable-unit item (Lumber, Pipe, Wire, Bulk Nails)">
        <bpmn:outgoing>W463_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W463_Task7" name="Selection">
        <bpmn:documentation>Step 1: Selection: Customer identifies material; Sales Associate assists in measuring/cutting
Responsible (R): Sales Associate
Accountable (A): —
Duration: 2-5 min</bpmn:documentation>
        <bpmn:incoming>W463_Flow16</bpmn:incoming>
        <bpmn:outgoing>W463_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W463_Task8" name="Measurement">
        <bpmn:documentation>Step 2: Measurement: Associate uses calibrated tool (tape measure, scale, counter) to determine quantity
Responsible (R): Sales Associate
Accountable (A): Dept Supervisor
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W463_Flow17</bpmn:incoming>
        <bpmn:outgoing>W463_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W463_Task9" name="Tag Generation">
        <bpmn:documentation>Step 3: Tag Generation: Associate enters quantity into the Department Tablet; system generates a &quot;Measurement Slip&quot; or temporary barcode
Responsible (R): Sales Associate
Accountable (A): —
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W463_Flow18</bpmn:incoming>
        <bpmn:outgoing>W463_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W463_Task10" name="POS Scan">
        <bpmn:documentation>Step 4: POS Scan: Cashier scans the slip at POS; system retrieves the price based on Unit of Measure (UOM) (e.g., PHP 150/meter)
Responsible (R): Cashier
Accountable (A): —
Duration: 30 sec</bpmn:documentation>
        <bpmn:incoming>W463_Flow19</bpmn:incoming>
        <bpmn:outgoing>W463_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W463_Task11" name="Inventory Update">
        <bpmn:documentation>Step 5: Inventory Update: System reduces inventory in base UOM (e.g., reduces total roll length by 5 meters)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W463_Flow20</bpmn:incoming>
        <bpmn:outgoing>W463_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W463_Task12" name="Reconciliation">
        <bpmn:documentation>Step 6: Reconciliation: Weekly, Department Supervisor performs a &quot;Remnant Audit&quot; to check for unaccounted waste/off-cuts
Responsible (R): Dept Supervisor
Accountable (A): Store Manager
Duration: 1 hour/week</bpmn:documentation>
        <bpmn:incoming>W463_Flow21</bpmn:incoming>
        <bpmn:outgoing>W463_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W463_End13" name="Complete">
        <bpmn:incoming>W463_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W463_Annotation14">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: periodic reconciliation against source documents
Owner: Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W463_Assoc15" sourceRef="W463_Annotation14" targetRef="W463_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W463_Flow16" sourceRef="W463_Start6" targetRef="W463_Task7" />
      <bpmn:sequenceFlow id="W463_Flow17" sourceRef="W463_Task7" targetRef="W463_Task8" />
      <bpmn:sequenceFlow id="W463_Flow18" sourceRef="W463_Task8" targetRef="W463_Task9" />
      <bpmn:sequenceFlow id="W463_Flow19" sourceRef="W463_Task9" targetRef="W463_Task10" />
      <bpmn:sequenceFlow id="W463_Flow20" sourceRef="W463_Task10" targetRef="W463_Task11" />
      <bpmn:sequenceFlow id="W463_Flow21" sourceRef="W463_Task11" targetRef="W463_Task12" />
      <bpmn:sequenceFlow id="W463_Flow22" sourceRef="W463_Task12" targetRef="W463_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W463_diag">
      <bpmndi:BPMNPlane id="W463_plane" bpmnElement="W_W463">
        <bpmndi:BPMNShape id="W463_Lane1_di" bpmnElement="W463_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W463_Lane2_di" bpmnElement="W463_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W463_Lane3_di" bpmnElement="W463_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W463_Lane4_di" bpmnElement="W463_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W463_Task7_di" bpmnElement="W463_Task7"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
