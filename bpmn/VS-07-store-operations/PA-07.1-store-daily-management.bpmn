    <bpmn:process id="W_W278" name="W278. Mid-Day Cash Skimming / Till Sweeps" isExecutable="false">
      <bpmn:documentation>Trigger: A POS till exceeds the maximum allowable cash holding threshold (e.g., PHP 50,000) during trading hours.
Frequency: Daily, multiple times per store
Volume: 2-5 skims per POS terminal per day
Owner: Store Cashier Supervisor
Participants: Cashier, Vault Custodian / Supervisor
Source: workflow W278 — Mid-Day Cash Skimming / Till Sweeps</bpmn:documentation>
      <bpmn:laneSet id="W278_LaneSet4">
        <bpmn:lane id="W278_Lane1" name="System">
        <bpmn:flowNodeRef>W278_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W278_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W278_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W278_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W278_Lane2" name="Cashier Supervisor">
        <bpmn:flowNodeRef>W278_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W278_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W278_Lane3" name="Cashier">
        <bpmn:flowNodeRef>W278_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W278_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W278_Start5" name="A POS till exceeds the maximum allowable cash holding threshold (e.g., PHP 50,000) during…">
        <bpmn:outgoing>W278_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W278_Task6" name="POS system alerts Cashier and Supervisor that the till has exceeded the PHP…">
        <bpmn:documentation>Step 1: POS system alerts Cashier and Supervisor that the till has exceeded the PHP 50,000 cash holding threshold
Responsible (R): System
Accountable (A): Cashier Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W278_Flow15</bpmn:incoming>
        <bpmn:outgoing>W278_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W278_Task7" name="Supervisor initiates a &quot;Cash Drop / Skim&quot; transaction on the POS terminal…">
        <bpmn:documentation>Step 2: Supervisor initiates a &quot;Cash Drop / Skim&quot; transaction on the POS terminal without closing the active shift
Responsible (R): Cashier Supervisor
Accountable (A): Store Manager
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W278_Flow16</bpmn:incoming>
        <bpmn:outgoing>W278_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W278_Task8" name="Cashier counts out the excess large bills (PHP 500 and PHP 1,000 denominations)…">
        <bpmn:documentation>Step 3: Cashier counts out the excess large bills (PHP 500 and PHP 1,000 denominations) under dual-witness with Supervisor
Responsible (R): Cashier
Accountable (A): Cashier Supervisor
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W278_Flow17</bpmn:incoming>
        <bpmn:outgoing>W278_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W278_Task9" name="POS prints a skim receipt showing amount, cashier ID, supervisor ID, and…">
        <bpmn:documentation>Step 4: POS prints a skim receipt showing amount, cashier ID, supervisor ID, and timestamp; both sign the physical receipt
Responsible (R): System
Accountable (A): Cashier Supervisor
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W278_Flow18</bpmn:incoming>
        <bpmn:outgoing>W278_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W278_Task10" name="Supervisor immediately walks to back-office and deposits the skimmed cash into…">
        <bpmn:documentation>Step 5: Supervisor immediately walks to back-office and deposits the skimmed cash into the Smart Safe (W212); Safe logs the deposit with unique transaction ID
Responsible (R): Cashier Supervisor
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W278_Flow19</bpmn:incoming>
        <bpmn:outgoing>W278_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W278_Task11" name="At EOD (W5F), the system calculates Total Cash = (Current Till + Sum of All…">
        <bpmn:documentation>Step 6: At EOD (W5F), the system calculates Total Cash = (Current Till + Sum of All Skims) for final Z-report balancing
Responsible (R): System
Accountable (A): Cashier Supervisor
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W278_Flow20</bpmn:incoming>
        <bpmn:outgoing>W278_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W278_End12" name="Complete">
        <bpmn:incoming>W278_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W278_Annotation13">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: dual-sign and CCTV
Owner: Store Cashier Supervisor</bpmn:text>
      </bpmn:textAnnotation>
