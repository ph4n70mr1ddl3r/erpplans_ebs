    <bpmn:process id="W_W170" name="W170. Senior Citizen &amp; PWD Discount Compliance (PH Legal)" isExecutable="false">
      <bpmn:documentation>Trigger: Customer presents Senior Citizen (SC) or Person with Disability (PWD) ID at POS
Frequency: High; ~5–10% of retail transactions in the Philippines
Volume: ~140,000–280,000 transactions/month chain-wide (5–10% of 2.8M per the Frequency)
Owner: Lead Cashier
Participants: Cashier, SC/PWD Customer, Store Manager (for high-value overrides)
Source: workflow W170 — Senior Citizen &amp; PWD Discount Compliance (PH Legal)</bpmn:documentation>
      <bpmn:laneSet id="W170_LaneSet4">
        <bpmn:lane id="W170_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W170_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W170_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W170_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W170_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W170_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W170_Lane2" name="System">
        <bpmn:flowNodeRef>W170_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W170_Lane3" name="Finance">
        <bpmn:flowNodeRef>W170_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W170_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W170_Start5" name="Customer presents Senior Citizen (SC) or Person with Disability (PWD) ID at POS">
        <bpmn:outgoing>W170_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W170_Task6" name="Identification">
        <bpmn:documentation>Step 1: Identification: Customer presents OSCA (Senior) or PWD ID card + Purchase Book
Responsible (R): Cashier
Accountable (A): —
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W170_Flow15</bpmn:incoming>
        <bpmn:outgoing>W170_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W170_Task7" name="Validation">
        <bpmn:documentation>Step 2: Validation: Cashier verifies ID authenticity and matches name to the customer; checks Purchase Book for prior purchases of the same items to ensure within weekly quantity limits (e.g., PHP 1,300/week for basic goods)
Responsible (R): Cashier
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W170_Flow16</bpmn:incoming>
        <bpmn:outgoing>W170_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W170_Task8" name="POS Entry">
        <bpmn:documentation>Step 3: POS Entry: Cashier selects &quot;SC/PWD Discount&quot; in POS; system prompts for ID number and Name; system automatically filters items eligible for discount/VAT-exempt status per BIR/DTI rules
Responsible (R): Cashier
Accountable (A): —
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W170_Flow17</bpmn:incoming>
        <bpmn:outgoing>W170_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W170_Task9" name="Transaction">
        <bpmn:documentation>Step 4: Transaction: System applies 20% discount on eligible items and removes 12% VAT; receipt prints with mandatory SC/PWD disclosure (Name, ID#, Gross Sale, Discount, VAT Exempt Sales)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W170_Flow18</bpmn:incoming>
        <bpmn:outgoing>W170_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W170_Task10" name="Logbook Entry">
        <bpmn:documentation>Step 5: Logbook Entry: Cashier manually records transaction in the mandatory BIR/OSCA Logbook (Legal requirement for audit)
Responsible (R): Cashier
Accountable (A): Lead Cashier
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W170_Flow19</bpmn:incoming>
        <bpmn:outgoing>W170_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W170_Task11" name="Filing">
        <bpmn:documentation>Step 6: Filing: Monthly: Finance consolidates SC/PWD sales for BIR Form 2550M (VAT) and 1702 (Income Tax) reporting, claiming the discount as a deductible expense
Responsible (R): Finance
Accountable (A): Controller
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W170_Flow20</bpmn:incoming>
        <bpmn:outgoing>W170_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W170_End12" name="Complete">
        <bpmn:incoming>W170_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W170_Annotation13">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Lead Cashier</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W170_Assoc14" sourceRef="W170_Annotation13" targetRef="W170_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W170_Flow15" sourceRef="W170_Start5" targetRef="W170_Task6" />
