        <bpmn:flowNodeRef>W29_Task21</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W29_Lane7" name="CSR">
        <bpmn:flowNodeRef>W29_Task22</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W29_Lane8" name="Store Manager">
        <bpmn:flowNodeRef>W29_Task24</bpmn:flowNodeRef>
        </bpmn:lane>
