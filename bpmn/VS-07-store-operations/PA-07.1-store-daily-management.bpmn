    <bpmn:process id="W_W33" name="W33. Warranty Claim Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer brings defective product to store within warranty period, or submits claim online
Frequency: ~2,000–3,000 warranty claims/month chain-wide (per the canon); ~10–15 per store per month
Volume: Primarily power tools, appliances, plumbing fixtures, electrical equipment
Owner: Customer Service Rep (in-store)
Participants: CSR, Department Supervisor, Buyer, Vendor, Customer
Source: workflow W33 — Warranty Claim Processing</bpmn:documentation>
      <bpmn:laneSet id="W33_LaneSet6">
        <bpmn:lane id="W33_Lane1" name="Customer">
        <bpmn:flowNodeRef>W33_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W33_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W33_Lane2" name="CSR">
        <bpmn:flowNodeRef>W33_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W33_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W33_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W33_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W33_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W33_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W33_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W33_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W33_Task19</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W33_Lane3" name="Buyer">
        <bpmn:flowNodeRef>W33_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W33_Lane4" name="Category Manager">
        <bpmn:flowNodeRef>W33_Task17</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W33_Lane5" name="System">
        <bpmn:flowNodeRef>W33_Task20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W33_End21</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W33_Start7" name="Customer brings defective product to store within warranty period, or submits claim online">
        <bpmn:outgoing>W33_Flow24</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W33_Task8" name="Customer brings defective item to CSR counter with proof of purchase (receipt…">
        <bpmn:documentation>Step 1: Customer brings defective item to CSR counter with proof of purchase (receipt, loyalty lookup, or bank statement)
Responsible (R): Customer
Accountable (A): —
Duration: —</bpmn:documentation>
        <bpmn:incoming>W33_Flow24</bpmn:incoming>
        <bpmn:outgoing>W33_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W33_Task9" name="CSR looks up original transaction; verifies item is within warranty period…">
        <bpmn:documentation>Step 2: CSR looks up original transaction; verifies item is within warranty period (system displays warranty terms per SKU)
Responsible (R): CSR
Accountable (A): Dept. Supervisor
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W33_Flow25</bpmn:incoming>
        <bpmn:outgoing>W33_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W33_Task10" name="CSR inspects item and documents defect: photographs, written description…">
        <bpmn:documentation>Step 3: CSR inspects item and documents defect: photographs, written description, defect category (manufacturing defect, premature wear, DOA)
Responsible (R): CSR
Accountable (A): Dept. Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W33_Flow26</bpmn:incoming>
        <bpmn:outgoing>W33_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W33_Task11" name="System creates warranty claim record: linked to original transaction, SKU…">
        <bpmn:documentation>Step 4: System creates warranty claim record: linked to original transaction, SKU, serial/lot number (if tracked), customer contact, defect description, photos
Responsible (R): CSR
Accountable (A): Dept. Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W33_Flow27</bpmn:incoming>
        <bpmn:outgoing>W33_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W33_Task12" name="CSR determines resolution path based on warranty policy and defect type: (a)…">
        <bpmn:documentation>Step 5: CSR determines resolution path based on warranty policy and defect type: (a) direct replacement from store stock, (b) send to vendor for repair, or (c) refund if item cannot be repaired/replaced
Responsible (R): CSR
Accountable (A): Dept. Supervisor
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W33_Flow28</bpmn:incoming>
        <bpmn:outgoing>W33_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W33_Task13" name="If direct replacement">
        <bpmn:documentation>Step 6: If direct replacement: CSR processes replacement in system; new item issued to customer; defective unit removed from inventory; system creates RTV record linked to warranty claim
Responsible (R): CSR
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W33_Flow29</bpmn:incoming>
        <bpmn:outgoing>W33_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W33_Task14" name="If vendor repair">
        <bpmn:documentation>Step 7: If vendor repair: CSR labels item with warranty claim number; stages in backroom for vendor pickup or shipment to vendor service center; system creates RTV shipment record
Responsible (R): CSR
Accountable (A): Dept. Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W33_Flow30</bpmn:incoming>
        <bpmn:outgoing>W33_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W33_Task15" name="If refund">
        <bpmn:documentation>Step 8: If refund: CSR processes refund per W12 return workflow; warranty claim closed with refund as resolution
Responsible (R): CSR
Accountable (A): Store Manager
Duration: Per W12</bpmn:documentation>
        <bpmn:incoming>W33_Flow31</bpmn:incoming>
        <bpmn:outgoing>W33_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W33_Task16" name="Buyer is notified of warranty claim for vendor-owned items; Buyer tracks vendor…">
        <bpmn:documentation>Step 9: Buyer is notified of warranty claim for vendor-owned items; Buyer tracks vendor response SLA (repair: 15 business days; replacement: 10 business days)
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: Automated notification + 5 min/claim</bpmn:documentation>
        <bpmn:incoming>W33_Flow32</bpmn:incoming>
        <bpmn:outgoing>W33_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W33_Task17" name="If vendor repair/replacement exceeds SLA: Buyer escalates to Category Manager…">
        <bpmn:documentation>Step 10: If vendor repair/replacement exceeds SLA: Buyer escalates to Category Manager; Category Manager may authorize store to issue replacement from stock pending vendor resolution
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 10 min/escalation</bpmn:documentation>
        <bpmn:incoming>W33_Flow33</bpmn:incoming>
        <bpmn:outgoing>W33_Flow34</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W33_Task18" name="Repaired/replaced item received from vendor: CSR notifies customer for pickup…">
        <bpmn:documentation>Step 11: Repaired/replaced item received from vendor: CSR notifies customer for pickup; system links incoming item to original warranty claim
Responsible (R): CSR
Accountable (A): Dept. Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W33_Flow34</bpmn:incoming>
        <bpmn:outgoing>W33_Flow35</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W33_Task19" name="Customer receives repaired/replaced item; warranty claim closed in system">
        <bpmn:documentation>Step 12: Customer receives repaired/replaced item; warranty claim closed in system
Responsible (R): CSR
Accountable (A): —
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W33_Flow35</bpmn:incoming>
        <bpmn:outgoing>W33_Flow36</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W33_Task20" name="Monthly: system generates warranty claim report by vendor, SKU, defect type…">
        <bpmn:documentation>Step 13: Monthly: system generates warranty claim report by vendor, SKU, defect type; Buyer reviews with top vendors during vendor performance review (W44)
Responsible (R): System / Buyer
Accountable (A): Category Manager
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W33_Flow36</bpmn:incoming>
        <bpmn:outgoing>W33_Flow37</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W33_End21" name="Complete">
        <bpmn:incoming>W33_Flow37</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W33_Annotation22">
        <bpmn:text>Controls: - CTL-37 (ensure warranty claim validity.) | - operational: transaction lookup but does not always catch sophisticated fraud
Owner: Customer Service Rep (in-store)</bpmn:text>
      </bpmn:textAnnotation>
