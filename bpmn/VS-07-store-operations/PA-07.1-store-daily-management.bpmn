    <bpmn:process id="W_W665" name="W665. Store-Level KPI Dashboard &amp; Daily Performance Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Daily system-generated KPI refresh at 06:00
Frequency: Daily dashboard review; weekly Store Manager review; monthly Regional Manager consolidation
Volume: 200 stores generating daily KPI snapshots
Owner: Store Manager (daily); Regional Manager (weekly consolidation)
Participants: Department Supervisor, Stock Associate, Cashier Lead, Regional Manager
Source: workflow W665 — Store-Level KPI Dashboard &amp; Daily Performance Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W665_LaneSet5">
        <bpmn:lane id="W665_Lane1" name="System">
        <bpmn:flowNodeRef>W665_Task7</bpmn:flowNodeRef>
