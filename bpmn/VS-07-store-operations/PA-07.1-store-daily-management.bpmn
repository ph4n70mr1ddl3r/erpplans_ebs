    <bpmn:process id="W_W826" name="W826. Store-Level Layaway Payment Reminder &amp; Forfeiture Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Layaway installment payment due per schedule created in W75; payment overdue &gt; 7 days
Frequency: Weekly; ~100–200 overdue layaway accounts chain-wide at any time
Volume: ~100–200 overdue accounts/month; ~5–10% of active layaway plans reach forfeiture stage
Owner: CSR
Participants: CSR, Store Manager, Customer
Source: workflow W826 — Store-Level Layaway Payment Reminder &amp; Forfeiture Processing</bpmn:documentation>
      <bpmn:laneSet id="W826_LaneSet3">
        <bpmn:lane id="W826_Lane1" name="System">
        <bpmn:flowNodeRef>W826_Task5</bpmn:flowNodeRef>
