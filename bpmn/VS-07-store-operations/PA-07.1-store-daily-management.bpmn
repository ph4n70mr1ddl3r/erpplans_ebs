    <bpmn:process id="W_W12C" name="W12C. Cross-Store Returns (Purchased at Store A, Returned at Store B)" isExecutable="false">
      <bpmn:documentation>Trigger: Customer brings item to a different store than where it was purchased
Frequency: ~10–20% of all returns (≈5,600–11,200/month chain-wide)
Volume: Common for chain-wide customers (contractors, travelers) and loyalty members
Owner: Customer Service Rep (receiving store)
Participants: CSR (Store B), Store Manager (Store B), Stock Associate (Store B)
Source: workflow W12C — Cross-Store Returns (Purchased at Store A, Returned at Store B)</bpmn:documentation>
      <bpmn:laneSet id="W12C_LaneSet5">
        <bpmn:lane id="W12C_Lane1" name="Customer">
        <bpmn:flowNodeRef>W12C_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W12C_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W12C_Lane2" name="CSR">
        <bpmn:flowNodeRef>W12C_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W12C_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W12C_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W12C_Lane3" name="System">
        <bpmn:flowNodeRef>W12C_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W12C_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W12C_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W12C_Lane4" name="Stock Associate">
        <bpmn:flowNodeRef>W12C_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W12C_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W12C_Start6" name="Customer brings item to a different store than where it was purchased">
        <bpmn:outgoing>W12C_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W12C_Task7" name="Customer presents item and receipt (or loyalty card for transaction lookup) at…">
        <bpmn:documentation>Step 1: Customer presents item and receipt (or loyalty card for transaction lookup) at CSR counter of Store B (different from purchase Store A)
Responsible (R): Customer
Accountable (A): —
Duration: —</bpmn:documentation>
        <bpmn:incoming>W12C_Flow18</bpmn:incoming>
        <bpmn:outgoing>W12C_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W12C_Task8" name="CSR looks up original transaction in system by receipt number or loyalty card…">
        <bpmn:documentation>Step 2: CSR looks up original transaction in system by receipt number or loyalty card; system supports cross-store transaction lookup across all 200 locations
Responsible (R): CSR
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W12C_Flow19</bpmn:incoming>
        <bpmn:outgoing>W12C_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W12C_Task9" name="CSR inspects item condition (resalable, damaged, defective) per standard W12A.3">
        <bpmn:documentation>Step 3: CSR inspects item condition (resalable, damaged, defective) per standard W12A.3
Responsible (R): CSR
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W12C_Flow20</bpmn:incoming>
        <bpmn:outgoing>W12C_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W12C_Task10" name="CSR processes cross-store return in system; Store Manager approval required for…">
        <bpmn:documentation>Step 4: CSR processes cross-store return in system; Store Manager approval required for cross-store returns above PHP 5,000 (higher threshold than same-store due to fraud risk)
Responsible (R): CSR
Accountable (A): Store Manager
Duration: 3–5 min</bpmn:documentation>
        <bpmn:incoming>W12C_Flow21</bpmn:incoming>
        <bpmn:outgoing>W12C_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W12C_Task11" name="System posts financial reversal to original purchase store (Store A): reverses…">
        <bpmn:documentation>Step 5: System posts financial reversal to original purchase store (Store A): reverses revenue and COGS at Store A for correct store P&amp;L attribution
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W12C_Flow22</bpmn:incoming>
        <bpmn:outgoing>W12C_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W12C_Task12" name="System receives returned inventory at Store B: increases Store B inventory…">
        <bpmn:documentation>Step 6: System receives returned inventory at Store B: increases Store B inventory; system automatically creates an inter-store inventory adjustment to account for the physical inventory movement (Store B gains inventory, Store A&#x27;s books already reflect the COGS reversal from step 5)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W12C_Flow23</bpmn:incoming>
        <bpmn:outgoing>W12C_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W12C_Task13" name="System processes refund to original tender method per W12A.6 split-tender…">
        <bpmn:documentation>Step 7: System processes refund to original tender method per W12A.6 split-tender rules; refund debited from Store A&#x27;s cash accountability (system-level, not physical cash at Store B)
Responsible (R): System / CSR
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W12C_Flow24</bpmn:incoming>
        <bpmn:outgoing>W12C_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W12C_Task14" name="Inventory returned to stock at Store B (if resalable) or flagged as…">
        <bpmn:documentation>Step 8: Inventory returned to stock at Store B (if resalable) or flagged as damaged/defective per W12A.7–8
Responsible (R): Stock Associate
Accountable (A): Dept. Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W12C_Flow25</bpmn:incoming>
