    <bpmn:process id="W_W5E" name="W5E. Store Opening Delay Procedure" isExecutable="false">
      <bpmn:documentation>Trigger: Issue discovered during W5A store opening sequence that prevents normal opening by scheduled store opening time
Frequency: Occasional — estimated 2–4 delayed openings per store per year
Volume: Variable — from 15-minute delay to full-day closure
Owner: Store Manager
Participants: Store Manager, IT Helpdesk (W48), Facilities Coordinator (W47), Regional Manager
Source: workflow W5E — Store Opening Delay Procedure</bpmn:documentation>
      <bpmn:laneSet id="W5E_LaneSet2">
        <bpmn:lane id="W5E_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W5E_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5E_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5E_Task6</bpmn:flowNodeRef>
