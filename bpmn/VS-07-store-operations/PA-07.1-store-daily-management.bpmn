    <bpmn:process id="W_W1419" name="W1419. Store-Level Daily Sales Flash Report Generation &amp; HQ Consolidation Dashboard Update" isExecutable="false">
      <bpmn:documentation>Trigger: Store end-of-day (EOD) system close; daily at each store&#x27;s closing time (typically 8:00–9:00 PM)
Frequency: Daily per store; consolidated at HQ by 10:00 AM next business day
Volume: 200 stores × 365 days = 73,000 daily flash reports/year
Owner: Store Manager (store-level); VP Store Operations (HQ consolidation)
Participants: Store Manager, Cashier, VP Store Operations, FP&amp;A Analyst, VP Merchandising, CEO
Source: workflow W1419 — Store-Level Daily Sales Flash Report Generation &amp; HQ Consolidation Dashboard Update</bpmn:documentation>
      <bpmn:laneSet id="W1419_LaneSet5">
        <bpmn:lane id="W1419_Lane1" name="System">
