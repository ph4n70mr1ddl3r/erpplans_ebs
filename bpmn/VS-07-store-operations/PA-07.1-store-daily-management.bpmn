    <bpmn:process id="W_W5D" name="W5D. In-Store Customer Delivery Scheduling" isExecutable="false">
      <bpmn:documentation>Trigger: Walk-in customer purchases bulky items (lumber, cement, appliances, tiles, fixtures) at POS and requests home delivery
Frequency: ~5–10 delivery requests per store per week; ~4,000–8,000/month chain-wide
Volume: Avg 2–5 items per delivery; avg delivery value PHP 3,000–15,000
Owner: Sales Associate (intake); DC Dispatch / Fleet Manager (carrier coordination)
Participants: Sales Associate, Cashier, Customer, DC Dispatch, 3PL Carrier
Source: workflow W5D — In-Store Customer Delivery Scheduling</bpmn:documentation>
      <bpmn:laneSet id="W5D_LaneSet6">
        <bpmn:lane id="W5D_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W5D_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5D_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5D_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5D_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5D_Lane2" name="System">
        <bpmn:flowNodeRef>W5D_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5D_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5D_Lane3" name="Cashier">
        <bpmn:flowNodeRef>W5D_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5D_Lane4" name="Carrier">
        <bpmn:flowNodeRef>W5D_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5D_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5D_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5D_Lane5" name="Store Manager">
        <bpmn:flowNodeRef>W5D_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5D_End18</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5D_Start7" name="Walk-in customer purchases bulky items (lumber, cement, appliances, tiles, fixtures) at…">
        <bpmn:outgoing>W5D_Flow21</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5D_Task8" name="Customer selects bulky/heavy items in store; Sales Associate identifies items…">
        <bpmn:documentation>Step 1: Customer selects bulky/heavy items in store; Sales Associate identifies items needing delivery and confirms customer wants home delivery instead of self-transport
Responsible (R): Sales Associate
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W5D_Flow21</bpmn:incoming>
        <bpmn:outgoing>W5D_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5D_Task9" name="Sales Associate opens delivery order in POS/terminal: scans items, confirms…">
        <bpmn:documentation>Step 2: Sales Associate opens delivery order in POS/terminal: scans items, confirms quantities, captures delivery address (street, barangay, city/municipality, province, landmark), customer name, mobile number, preferred delivery date (next available), and notes (gate code, floor level, elevator access)
Responsible (R): Sales Associate
Accountable (A): Dept. Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W5D_Flow22</bpmn:incoming>
        <bpmn:outgoing>W5D_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W5D_Task10" name="System calculates delivery fee based on delivery zone (distance from store…">
        <bpmn:documentation>Step 3: System calculates delivery fee based on delivery zone (distance from store using configured rate cards per zone/weight/tier — same carrier rate cards as W19 home delivery); displays fee to Sales Associate and customer; delivery fee added to transaction total
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W5D_Flow23</bpmn:incoming>
        <bpmn:outgoing>W5D_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W5D_Task11" name="Customer pays for merchandise + delivery fee at POS; system creates delivery…">
        <bpmn:documentation>Step 4: Customer pays for merchandise + delivery fee at POS; system creates delivery order linked to POS transaction; delivery fee posted to Delivery Revenue (Cr.) / Cash (Dr.); merchandise revenue and COGS posted per standard W5B
Responsible (R): Cashier / Customer
Accountable (A): Store Manager
Duration: Part of checkout</bpmn:documentation>
        <bpmn:incoming>W5D_Flow24</bpmn:incoming>
        <bpmn:outgoing>W5D_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W5D_Task12" name="System transmits delivery order to carrier pool: selects 3PL carrier per…">
        <bpmn:documentation>Step 5: System transmits delivery order to carrier pool: selects 3PL carrier per delivery zone (same W19 carrier selection logic — Lalamove, Transportify, or own fleet if available); creates carrier pickup request with store address as origin, customer address as destination, item description, estimated weight, and preferred delivery date/time
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W5D_Flow25</bpmn:incoming>
        <bpmn:outgoing>W5D_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W5D_Task13" name="Carrier accepts pickup request; driver dispatched to store; system sends…">
        <bpmn:documentation>Step 6: Carrier accepts pickup request; driver dispatched to store; system sends tracking link to customer via SMS with estimated delivery window
Responsible (R): Carrier / System
Accountable (A): DC Dispatch
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W5D_Flow26</bpmn:incoming>
        <bpmn:outgoing>W5D_Flow27</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W5D_Task14" name="Sales Associate or Stock Associate stages paid items at store dispatch area…">
        <bpmn:documentation>Step 7: Sales Associate or Stock Associate stages paid items at store dispatch area; hands items to carrier driver with delivery order printout; driver confirms pickup on carrier app
Responsible (R): Sales Associate / Carrier
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W5D_Flow27</bpmn:incoming>
        <bpmn:outgoing>W5D_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5D_Task15" name="Carrier delivers to customer address; obtains proof of delivery (photo…">
        <bpmn:documentation>Step 8: Carrier delivers to customer address; obtains proof of delivery (photo, signature); system marks delivery order as &quot;Delivered&quot;
Responsible (R): Carrier
Accountable (A): —
Duration: Varies by distance</bpmn:documentation>
        <bpmn:incoming>W5D_Flow28</bpmn:incoming>
        <bpmn:outgoing>W5D_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5D_Task16" name="If delivery fails (customer unavailable): follows same failed delivery…">
        <bpmn:documentation>Step 9: If delivery fails (customer unavailable): follows same failed delivery lifecycle as W19.12 — carrier attempts re-delivery or returns items to store; Sales Associate contacts customer to reschedule; if customer cancels, system refunds delivery fee and processes merchandise return per W12
Responsible (R): Carrier / Sales Associate
Accountable (A): Store Manager
Duration: Per W19.12</bpmn:documentation>
        <bpmn:incoming>W5D_Flow29</bpmn:incoming>
        <bpmn:outgoing>W5D_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5D_Task17" name="Weekly: Store Manager reviews in-store delivery report — delivery count…">
        <bpmn:documentation>Step 10: Weekly: Store Manager reviews in-store delivery report — delivery count, revenue, delivery fee collected, carrier performance (on-time %, damage rate); flags high delivery fee refund rates for carrier escalation per W62B
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 15 min/week</bpmn:documentation>
        <bpmn:incoming>W5D_Flow30</bpmn:incoming>
        <bpmn:outgoing>W5D_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5D_End18" name="Complete">
        <bpmn:incoming>W5D_Flow31</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5D_Annotation19">
        <bpmn:text>Controls: (none recorded)
Owner: Sales Associate (intake); DC Dispatch / Fleet Manager (carrier coordination)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5D_Assoc20" sourceRef="W5D_Annotation19" targetRef="W5D_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W5D_Flow21" sourceRef="W5D_Start7" targetRef="W5D_Task8" />
      <bpmn:sequenceFlow id="W5D_Flow22" sourceRef="W5D_Task8" targetRef="W5D_Task9" />
