    <bpmn:process id="W_W67" name="W67. Monthly Store Performance Review" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly review calendar (by day 10 of each month, following W9A close and W35 monthly reporting)
Frequency: Monthly per store; conducted by Regional Manager
Volume: 200 stores ÷ ~6 Regional Managers ≈ 33 stores/Regional Manager/month; ~2–3 reviews/day over 15–20 working days
Owner: Regional Manager
Participants: Regional Manager, Store Manager, Assistant Store Manager
Source: workflow W67 — Monthly Store Performance Review</bpmn:documentation>
      <bpmn:laneSet id="W67_LaneSet4">
        <bpmn:lane id="W67_Lane1" name="System">
        <bpmn:flowNodeRef>W67_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W67_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W67_Lane2" name="Regional Manager">
        <bpmn:flowNodeRef>W67_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W67_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W67_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W67_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W67_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W67_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W67_Lane3" name="VP Store Operations">
        <bpmn:flowNodeRef>W67_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W67_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W67_Start5" name="Monthly review calendar (by day 10 of each month, following W9A close and W35 monthly…">
        <bpmn:outgoing>W67_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W67_Task6" name="System generates Store Performance Scorecard per store (auto-distributed by day…">
        <bpmn:documentation>Step 1: System generates Store Performance Scorecard per store (auto-distributed by day 7): revenue vs. budget and vs. prior year, gross margin %, labor cost % of revenue, shrinkage rate (from W6/W37), customer satisfaction score (from W65), BOPIS fill rate, receiving accuracy, training completion rate, safety incidents, cash variance incidents, POS exception count
Responsible (R): System
Accountable (A): Controller
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W67_Flow17</bpmn:incoming>
        <bpmn:outgoing>W67_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W67_Task7" name="Regional Manager reviews scorecards for all ~33 assigned stores (per the Volume…">
        <bpmn:documentation>Step 2: Regional Manager reviews scorecards for all ~33 assigned stores (per the Volume basis); identifies top 5 performers, bottom 5 performers, and stores with material variances (&gt; ±5% revenue, &gt; ±2% margin, &gt; 1.5% shrinkage)
Responsible (R): Regional Manager
Accountable (A): VP Store Operations
Duration: 3–4 hours/month</bpmn:documentation>
        <bpmn:incoming>W67_Flow18</bpmn:incoming>
        <bpmn:outgoing>W67_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W67_Task8" name="Regional Manager conducts 45–60 minute review meeting (in-person or video call)…">
        <bpmn:documentation>Step 3: Regional Manager conducts 45–60 minute review meeting (in-person or video call) with each Store Manager: (a) review scorecard performance vs. budget and vs. prior month, (b) discuss root causes for material variances, (c) review action items from prior month — status and results, (d) agree on 2–3 specific action items for next month (e.g., reduce shrinkage in lumber department, improve BOPIS pickup SLA, schedule training for new cashiers), (e) discuss HR matters (staffing gaps, performance issues, training needs)
Responsible (R): Regional Manager
Accountable (A): VP Store Operations
Duration: 45–60 min/store</bpmn:documentation>
        <bpmn:incoming>W67_Flow19</bpmn:incoming>
        <bpmn:outgoing>W67_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W67_Task9" name="For bottom 5 performers: Regional Manager develops targeted improvement plan…">
        <bpmn:documentation>Step 4: For bottom 5 performers: Regional Manager develops targeted improvement plan with Store Manager — specific KPIs to improve, timeline, and resources needed; copies VP Store Operations
Responsible (R): Regional Manager
Accountable (A): VP Store Operations
Duration: 30 min/store</bpmn:documentation>
        <bpmn:incoming>W67_Flow20</bpmn:incoming>
        <bpmn:outgoing>W67_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W67_Task10" name="For top 5 performers: Regional Manager recognizes performance; discusses best…">
        <bpmn:documentation>Step 5: For top 5 performers: Regional Manager recognizes performance; discusses best practices to share with other stores; identifies candidates for store manager development or new store opening leadership
Responsible (R): Regional Manager
Accountable (A): VP Store Operations
Duration: 15 min/store</bpmn:documentation>
        <bpmn:incoming>W67_Flow21</bpmn:incoming>
        <bpmn:outgoing>W67_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W67_Task11" name="Regional Manager enters agreed action items into system per store; system…">
        <bpmn:documentation>Step 6: Regional Manager enters agreed action items into system per store; system tracks action item completion; Store Manager updates status before next review
Responsible (R): Regional Manager / Store Manager
Accountable (A): VP Store Operations
Duration: 10 min/store</bpmn:documentation>
        <bpmn:incoming>W67_Flow22</bpmn:incoming>
        <bpmn:outgoing>W67_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W67_Task12" name="Regional Manager presents monthly store portfolio summary to VP Store…">
        <bpmn:documentation>Step 7: Regional Manager presents monthly store portfolio summary to VP Store Operations: top/bottom performers, common themes, resource requests, capital needs; VP Store Operations decides on escalations and resource allocation
Responsible (R): Regional Manager
Accountable (A): VP Store Operations
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W67_Flow23</bpmn:incoming>
        <bpmn:outgoing>W67_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W67_Task13" name="Quarterly: VP Store Operations includes store performance trends in management…">
        <bpmn:documentation>Step 8: Quarterly: VP Store Operations includes store performance trends in management committee meeting (W35 step 14); bottom 10 stores flagged for COO attention
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W67_Flow24</bpmn:incoming>
        <bpmn:outgoing>W67_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W67_End14" name="Complete">
        <bpmn:incoming>W67_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W67_Annotation15">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: Regional Manager review and approval gate
Owner: Regional Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W67_Assoc16" sourceRef="W67_Annotation15" targetRef="W67_Start5" associationDirection="None" />
