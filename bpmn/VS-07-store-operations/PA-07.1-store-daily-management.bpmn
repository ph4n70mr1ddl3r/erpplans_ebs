    <bpmn:process id="W_W212" name="W212. Automated Store Cash Management &amp; Smart Safe Integration" isExecutable="false">
      <bpmn:documentation>Trigger: Shift end; or cash drawer limit reached
Frequency: 2–3 times per day per cashier
Volume: Covers all 200 stores; ~600 POS terminals
Owner: Store Cashier Supervisor
Participants: Cashier, Supervisor, CIT (Cash-in-Transit) Partner
Source: workflow W212 — Automated Store Cash Management &amp; Smart Safe Integration</bpmn:documentation>
      <bpmn:laneSet id="W212_LaneSet4">
        <bpmn:lane id="W212_Lane1" name="System">
        <bpmn:flowNodeRef>W212_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W212_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W212_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W212_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W212_Lane2" name="Cashier">
        <bpmn:flowNodeRef>W212_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W212_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W212_Lane3" name="CIT Partner">
        <bpmn:flowNodeRef>W212_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W212_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W212_Start5" name="Shift end; or cash drawer limit reached">
        <bpmn:outgoing>W212_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W212_Task6" name="Drawer Limit Alert">
        <bpmn:documentation>Step 1: Drawer Limit Alert: System triggers alert when POS cash drawer exceeds threshold (e.g., PHP 50,000)
Responsible (R): System
Accountable (A): Cashier
Duration: Real-time</bpmn:documentation>
        <bpmn:incoming>W212_Flow15</bpmn:incoming>
        <bpmn:outgoing>W212_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W212_Task7" name="Cash Skimming">
        <bpmn:documentation>Step 2: Cash Skimming: Cashier counts excess cash; Supervisor verifies; records &quot;Skim&quot; in POS
Responsible (R): Cashier
Accountable (A): Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W212_Flow16</bpmn:incoming>
        <bpmn:outgoing>W212_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W212_Task8" name="Smart Safe Deposit">
        <bpmn:documentation>Step 3: Smart Safe Deposit: Cashier inserts bills into the in-store Smart Safe; safe validates bills and counts in real-time
Responsible (R): Cashier
Accountable (A): —
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W212_Flow17</bpmn:incoming>
        <bpmn:outgoing>W212_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W212_Task9" name="Credit Recognition">
        <bpmn:documentation>Step 4: Credit Recognition: Smart Safe API sends deposit confirmation to ERP/Bank; Bank provides &quot;Same-Day Credit&quot; to BuildRight&#x27;s account
Responsible (R): System
Accountable (A): Finance
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W212_Flow18</bpmn:incoming>
        <bpmn:outgoing>W212_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W212_Task10" name="EOD Reconciliation">
        <bpmn:documentation>Step 5: EOD Reconciliation: At EOD, system reconciles POS Sales vs. Smart Safe Deposits vs. Remaining Drawer Cash; flags variances
Responsible (R): System
Accountable (A): Supervisor
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W212_Flow19</bpmn:incoming>
        <bpmn:outgoing>W212_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W212_Task11" name="CIT Pickup">
        <bpmn:documentation>Step 6: CIT Pickup: CIT partner (e.g., G4S/Securicor) empties safe when full; system logs pickup; safe resets for next cycle
Responsible (R): CIT Partner
Accountable (A): —
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W212_Flow20</bpmn:incoming>
        <bpmn:outgoing>W212_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W212_End12" name="Complete">
        <bpmn:incoming>W212_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W212_Annotation13">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: periodic reconciliation against source documents
Owner: Store Cashier Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W212_Assoc14" sourceRef="W212_Annotation13" targetRef="W212_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W212_Flow15" sourceRef="W212_Start5" targetRef="W212_Task6" />
      <bpmn:sequenceFlow id="W212_Flow16" sourceRef="W212_Task6" targetRef="W212_Task7" />
      <bpmn:sequenceFlow id="W212_Flow17" sourceRef="W212_Task7" targetRef="W212_Task8" />
      <bpmn:sequenceFlow id="W212_Flow18" sourceRef="W212_Task8" targetRef="W212_Task9" />
      <bpmn:sequenceFlow id="W212_Flow19" sourceRef="W212_Task9" targetRef="W212_Task10" />
      <bpmn:sequenceFlow id="W212_Flow20" sourceRef="W212_Task10" targetRef="W212_Task11" />
      <bpmn:sequenceFlow id="W212_Flow21" sourceRef="W212_Task11" targetRef="W212_End12" />
    </bpmn:process>
