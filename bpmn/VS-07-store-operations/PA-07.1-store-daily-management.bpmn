    <bpmn:process id="W_W952" name="W952. Store-Level Customer Gratuity &amp; Service Tip Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer offers a tip/gratuity to BuildRight staff for loading assistance (W950), delivery, cutting/fabrication services (W943–W946), or other exceptional service
Frequency: ~10,000–15,000 tip events/month chain-wide (~50–75/store/month)
Volume: PHP 20–200 per tip event (average ~PHP 50)
Owner: Store Manager
Participants: Customer, Sales Associate/Stock Associate, Store Manager, HR/Payroll, Finance
Source: workflow W952 — Store-Level Customer Gratuity &amp; Service Tip Processing</bpmn:documentation>
      <bpmn:laneSet id="W952_LaneSet4">
        <bpmn:lane id="W952_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W952_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W952_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W952_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W952_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W952_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W952_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W952_Lane3" name="Payroll Officer">
        <bpmn:flowNodeRef>W952_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W952_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W952_Start5" name="Customer offers a tip/gratuity to BuildRight staff for loading assistance (W950)…">
        <bpmn:outgoing>W952_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W952_Task6" name="Service Delivery &amp; Tip Offer">
        <bpmn:documentation>Step 1: Service Delivery &amp; Tip Offer: Customer receives service (loading, cutting, delivery, etc.) and offers tip; the Sales Associate / Stock Associate follows policy: (a) initial response: politely declines (&quot;It&#x27;s our pleasure to help, sir/ma&#x27;am — no tip needed&quot;); (b) if customer insists: accepts graciously with verbal thank-you; (c) never solicits tips or suggests tip amounts; (d) provides same quality service regardless of whether customer tips
Responsible (R): Sales Associate / Stock Associate
Accountable (A): Store Manager
Duration: 0 min (during service)</bpmn:documentation>
        <bpmn:incoming>W952_Flow14</bpmn:incoming>
        <bpmn:outgoing>W952_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W952_Task7" name="Tip Recording &amp; Deposit">
        <bpmn:documentation>Step 2: Tip Recording &amp; Deposit: Associate records tip at end of shift: (a) cash tips: counts and records amount on daily tip log at customer service counter; (b) system entry: Associate enters tip amount in employee self-service portal with date, service type, and amount; (c) cash tips placed in sealed envelope with Associate&#x27;s name and amount, deposited in store safe; tips held in safe until weekly processing; digital tips (if customer tips via digital payment — future capability) automatically recorded
Responsible (R): Sales Associate / Stock Associate
Accountable (A): Store Manager
Duration: 5 min/end of shift</bpmn:documentation>
        <bpmn:incoming>W952_Flow15</bpmn:incoming>
        <bpmn:outgoing>W952_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W952_Task8" name="Weekly Tip Pooling &amp; Distribution">
        <bpmn:documentation>Step 3: Weekly Tip Pooling &amp; Distribution: Weekly (every Monday): (a) Store Manager collects all tip envelopes from safe; (b) verifies amounts against daily tip logs; (c) applies tip pool distribution policy: Option A (individual): Associate keeps tips received for their service; Option B (team pool): all tips pooled and distributed equally among all front-line associates who worked that week; store selects one policy — recommend team pool for fairness; (d) system records distributed tip amounts per employee for payroll processing
Responsible (R): Store Manager
Accountable (A): HR/Payroll
Duration: 30 min/week</bpmn:documentation>
        <bpmn:incoming>W952_Flow16</bpmn:incoming>
        <bpmn:outgoing>W952_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W952_Task9" name="Tax Withholding &amp; Payroll Integration">
        <bpmn:documentation>Step 4: Tax Withholding &amp; Payroll Integration: (a) tips are taxable compensation per BIR Revenue Regulations; (b) Payroll Officer includes weekly tip income in employee&#x27;s semi-monthly payroll computation per W10; (c) tips added to taxable income for withholding tax computation per TRAIN law tables; (d) tips included in SSS, PhilHealth, Pag-IBIG contribution base per statutory requirements; (e) net tip amount (after withholding) added to employee&#x27;s payroll credit; (f) pay slip shows tip income separately for transparency
Responsible (R): Payroll Officer / System
Accountable (A): Payroll Manager
Duration: Automated per W10</bpmn:documentation>
        <bpmn:incoming>W952_Flow17</bpmn:incoming>
        <bpmn:outgoing>W952_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W952_Task10" name="Monthly Tip Analytics &amp; Policy Review">
        <bpmn:documentation>Step 5: Monthly Tip Analytics &amp; Policy Review: Store Manager reviews: (a) total tip amount by store, department, and associate; (b) tip frequency and average amount by service type; (c) correlation between tip activity and customer satisfaction scores per W608; (d) any associates with tip amounts significantly above/below peers — investigated for potential preferential service or tip solicitation; (e) quarterly: HR reviews tip policy effectiveness and fairness; adjusts pool distribution method if needed
Responsible (R): Store Manager / HR
Accountable (A): CHRO
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W952_Flow18</bpmn:incoming>
        <bpmn:outgoing>W952_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W952_End11" name="Complete">
        <bpmn:incoming>W952_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W952_Annotation12">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: with dual verification (associate + Store Manager) per W541 controls
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W952_Assoc13" sourceRef="W952_Annotation12" targetRef="W952_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W952_Flow14" sourceRef="W952_Start5" targetRef="W952_Task6" />
      <bpmn:sequenceFlow id="W952_Flow15" sourceRef="W952_Task6" targetRef="W952_Task7" />
      <bpmn:sequenceFlow id="W952_Flow16" sourceRef="W952_Task7" targetRef="W952_Task8" />
      <bpmn:sequenceFlow id="W952_Flow17" sourceRef="W952_Task8" targetRef="W952_Task9" />
      <bpmn:sequenceFlow id="W952_Flow18" sourceRef="W952_Task9" targetRef="W952_Task10" />
      <bpmn:sequenceFlow id="W952_Flow19" sourceRef="W952_Task10" targetRef="W952_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W952_diag">
      <bpmndi:BPMNPlane id="W952_plane" bpmnElement="W_W952">
        <bpmndi:BPMNShape id="W952_Lane1_di" bpmnElement="W952_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
