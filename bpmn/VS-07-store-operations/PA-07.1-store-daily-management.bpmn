    <bpmn:process id="W_W742" name="W742. Store-Level Key, Access Card &amp; Secure Area Daily Management" isExecutable="false">
      <bpmn:documentation>Trigger: Employee onboarding (W15), separation (W43), shift start/end, lost key/card report
Frequency: Daily access transactions; periodic audits
Volume: 200 stores × ~29 employees × average 2 access credentials = ~11,600 active credentials
Owner: Store Manager
Participants: Store Manager, Floor Associates, IT (W152), Security Guard, HR
Source: workflow W742 — Store-Level Key, Access Card &amp; Secure Area Daily Management</bpmn:documentation>
      <bpmn:laneSet id="W742_LaneSet5">
        <bpmn:lane id="W742_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W742_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W742_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W742_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W742_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W742_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W742_Lane2" name="IT">
        <bpmn:flowNodeRef>W742_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W742_Lane3" name="System">
        <bpmn:flowNodeRef>W742_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W742_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W742_Lane4" name="Employee">
        <bpmn:flowNodeRef>W742_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W742_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W742_Start6" name="Employee onboarding (W15), separation (W43), shift start/end, lost key/card report">
        <bpmn:outgoing>W742_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W742_Task7" name="Credential issuance — At onboarding (W15), Store Manager issues access card…">
        <bpmn:documentation>Step 1: Credential issuance — At onboarding (W15), Store Manager issues access card and/or physical keys based on role; system records issuance with employee ID, credential type, and access level
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W742_Flow18</bpmn:incoming>
        <bpmn:outgoing>W742_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W742_Task8" name="Access level configuration — IT configures access card permissions per role…">
        <bpmn:documentation>Step 2: Access level configuration — IT configures access card permissions per role: floor associate (sales floor, break room), stock associate (+ stockroom), cashier (+ cash office during shift), department supervisor (+ chemical storage), store manager (all areas)
Responsible (R): IT
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W742_Flow19</bpmn:incoming>
        <bpmn:outgoing>W742_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W742_Task9" name="Shift-based access activation — At shift start, system activates access card…">
        <bpmn:documentation>Step 3: Shift-based access activation — At shift start, system activates access card for authorized areas; at shift end, system deactivates non-common areas
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W742_Flow20</bpmn:incoming>
        <bpmn:outgoing>W742_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W742_Task10" name="Lost/stolen credential reporting — Employee reports lost key/card immediately…">
        <bpmn:documentation>Step 4: Lost/stolen credential reporting — Employee reports lost key/card immediately; Store Manager deactivates access card in system and reissues; physical key loss triggers lock rekey for affected area
Responsible (R): Employee / Store Manager
Accountable (A): Store Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W742_Flow21</bpmn:incoming>
        <bpmn:outgoing>W742_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W742_Task11" name="Quarterly combination change — Safe combination and alarm code changed…">
        <bpmn:documentation>Step 5: Quarterly combination change — Safe combination and alarm code changed quarterly; Store Manager updates system record and distributes new codes to authorized personnel via sealed envelope
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W742_Flow22</bpmn:incoming>
        <bpmn:outgoing>W742_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W742_Task12" name="Separation credential collection — At offboarding (W43), Store Manager collects…">
        <bpmn:documentation>Step 6: Separation credential collection — At offboarding (W43), Store Manager collects all physical keys and access cards; IT deactivates electronic access same day
Responsible (R): Store Manager / IT
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W742_Flow23</bpmn:incoming>
        <bpmn:outgoing>W742_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W742_Task13" name="Monthly credential audit — Store Manager reconciles active credentials against…">
        <bpmn:documentation>Step 7: Monthly credential audit — Store Manager reconciles active credentials against current employee roster; flags unreturned credentials from separated employees
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W742_Flow24</bpmn:incoming>
        <bpmn:outgoing>W742_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W742_Task14" name="Security incident escalation — If unauthorized access detected (door forced…">
        <bpmn:documentation>Step 8: Security incident escalation — If unauthorized access detected (door forced, access at unusual hours), system triggers alert to Store Manager and LP (W37)
Responsible (R): System / LP
Accountable (A): LP
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W742_Flow25</bpmn:incoming>
        <bpmn:outgoing>W742_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W742_End15" name="Complete">
        <bpmn:incoming>W742_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W742_Annotation16">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: periodic reconciliation against source documents
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
