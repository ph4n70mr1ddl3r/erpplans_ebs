    <bpmn:process id="W_W999" name="W999. Store-Level Customer Tile &amp; Flooring Sample Loan &amp; Return Program" isExecutable="false">
      <bpmn:documentation>Trigger: Customer requests to borrow tile/flooring samples for home evaluation before purchase
Frequency: ~6,000–8,000 sample loans/month chain-wide (~30–40/store/month)
Volume: 1–5 samples per loan; average 3 samples
Owner: Department Supervisor (Tiles &amp; Flooring)
Participants: Sales Associate (Tile Specialist), Customer, Receiving Clerk (sample returns)
Source: workflow W999 — Store-Level Customer Tile &amp; Flooring Sample Loan &amp; Return Program</bpmn:documentation>
      <bpmn:laneSet id="W999_LaneSet3">
        <bpmn:lane id="W999_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W999_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W999_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W999_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W999_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W999_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W999_Lane2" name="System">
        <bpmn:flowNodeRef>W999_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W999_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W999_Start4" name="Customer requests to borrow tile/flooring samples for home evaluation before purchase">
        <bpmn:outgoing>W999_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W999_Task5" name="Sample Selection &amp; Loan Request">
        <bpmn:documentation>Step 1: Sample Selection &amp; Loan Request: Customer selects tile/flooring product(s) from display; Sales Associate provides: (a) display sample swatch (10×10 cm or 20×20 cm tile piece mounted on display board with SKU label); (b) if product has no display sample: Sales Associate cuts a sample from a stock tile using tile cutter (top 30 stores with CNC glass/tile cutter) or provides manufacturer&#x27;s sample brochure/card; (c) customer selects 1–5 samples for home evaluation; (d) Sales Associate verifies samples are available for loan (not already loaned out)
Responsible (R): Sales Associate / Customer
Accountable (A): Department Supervisor
Duration: 5–8 min</bpmn:documentation>
        <bpmn:incoming>W999_Flow13</bpmn:incoming>
        <bpmn:outgoing>W999_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W999_Task6" name="Loan Registration &amp; Deposit Processing">
        <bpmn:documentation>Step 2: Loan Registration &amp; Deposit Processing: Sales Associate registers sample loan in system: (a) customer presents loyalty card or provides name and mobile number for tracking; (b) system records: sample SKU(s), customer ID, loan date, due date (7 calendar days from loan); (c) system generates sample loan receipt with: customer name, sample descriptions, loan date, return deadline, deposit amount; (d) customer pays refundable deposit per sample — PHP 100/sample for ceramic/porcelain, PHP 200/sample for natural stone/premium tiles; deposit collected at POS via separate tender type &quot;Sample Deposit&quot; per W25; (e) system flags sample inventory as &quot;on loan&quot; and prevents other customers from borrowing same sample until returned
Responsible (R): Sales Associate / Cashier
Accountable (A): Department Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W999_Flow14</bpmn:incoming>
        <bpmn:outgoing>W999_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W999_Task7" name="Customer Home Evaluation Period">
        <bpmn:documentation>Step 3: Customer Home Evaluation Period: Customer takes samples home for up to 7 days; during this period: (a) customer evaluates tile appearance under natural and artificial lighting at home; (b) customer compares tile with existing wall color, furniture, and cabinetry; (c) customer can return samples earlier if decision is made; (d) system sends automated reminder at Day 5 via SMS if samples not yet returned; (e) at Day 7: if samples not returned, system sends final reminder with grace period extension to Day 10; (f) at Day 10: if samples not returned, deposit is forfeited and customer is charged per sample at full retail price; sample flagged as &quot;sold&quot; in inventory
Responsible (R): System
Accountable (A): Department Supervisor
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W999_Flow15</bpmn:incoming>
        <bpmn:outgoing>W999_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W999_Task8" name="Sample Return &amp; Deposit Refund">
        <bpmn:documentation>Step 4: Sample Return &amp; Deposit Refund: Customer returns samples: (a) Receiving Clerk or Sales Associate inspects returned samples for damage (cracks, chips, stains from customer use); (b) if undamaged: system processes deposit refund via POS — refunded to original payment method per W101; (c) if damaged: Sales Associate assesses damage severity — minor cosmetic damage (still displayable): full refund; significant damage (not displayable): deposit forfeited to cover sample replacement cost; (d) system updates sample inventory status to &quot;available&quot; for next loan; (e) damaged samples dispositioned per W91 (damaged goods)
Responsible (R): Sales Associate / Receiving Clerk
Accountable (A): Department Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W999_Flow16</bpmn:incoming>
        <bpmn:outgoing>W999_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W999_Task9" name="Conversion Follow-Up &amp; Purchase Assistance">
        <bpmn:documentation>Step 5: Conversion Follow-Up &amp; Purchase Assistance: When customer returns samples: (a) Sales Associate asks if customer has made a decision; (b) if yes: Sales Associate assists with tile quantity calculation per W963 and order processing; (c) if no: Sales Associate offers additional sample options, alternative tile suggestions, or design consultation per W211; (d) system tracks conversion rate: sample loan → purchase; Category Manager reviews conversion metrics quarterly to optimize sample inventory and program effectiveness
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W999_Flow17</bpmn:incoming>
        <bpmn:outgoing>W999_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W999_End10" name="Complete">
        <bpmn:incoming>W999_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W999_Annotation11">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: refundable deposit system mitigates financial loss (repeat non-returners flagged); operational: must track deposits as a liability per W25
Owner: Department Supervisor (Tiles &amp; Flooring)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W999_Assoc12" sourceRef="W999_Annotation11" targetRef="W999_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W999_Flow13" sourceRef="W999_Start4" targetRef="W999_Task5" />
      <bpmn:sequenceFlow id="W999_Flow14" sourceRef="W999_Task5" targetRef="W999_Task6" />
      <bpmn:sequenceFlow id="W999_Flow15" sourceRef="W999_Task6" targetRef="W999_Task7" />
      <bpmn:sequenceFlow id="W999_Flow16" sourceRef="W999_Task7" targetRef="W999_Task8" />
      <bpmn:sequenceFlow id="W999_Flow17" sourceRef="W999_Task8" targetRef="W999_Task9" />
      <bpmn:sequenceFlow id="W999_Flow18" sourceRef="W999_Task9" targetRef="W999_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W999_diag">
      <bpmndi:BPMNPlane id="W999_plane" bpmnElement="W_W999">
        <bpmndi:BPMNShape id="W999_Lane1_di" bpmnElement="W999_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
