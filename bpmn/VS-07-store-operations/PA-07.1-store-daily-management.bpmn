      <bpmn:sequenceFlow id="W1142_Flow14" sourceRef="W1142_Task6" targetRef="W1142_Task7" />
      <bpmn:sequenceFlow id="W1142_Flow15" sourceRef="W1142_Task7" targetRef="W1142_End8" />
    </bpmn:process>
