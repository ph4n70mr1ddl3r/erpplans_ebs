    <bpmn:process id="W_W28" name="W28. Gift Card &amp; Store Credit Lifecycle" isExecutable="false">
      <bpmn:documentation>Trigger: Customer purchases or receives a gift card; or customer issued store credit as refund
Frequency: Continuous at POS and online
Volume: ~8,000–12,000 active gift cards/month; ~500–800 store credits issued/month (from returns without receipt)
Owner: Customer Service Rep (in-store); Marketing (gift card program)
Participants: Cashier, CSR, Customer, Marketing, Finance (breakage accounting)
Source: workflow W28 — Gift Card &amp; Store Credit Lifecycle</bpmn:documentation>
      <bpmn:laneSet id="W28_LaneSet5">
        <bpmn:lane id="W28_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W28_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W28_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W28_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W28_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W28_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W28_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W28_Lane2" name="System">
        <bpmn:flowNodeRef>W28_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W28_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W28_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W28_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W28_Lane3" name="CSR">
        <bpmn:flowNodeRef>W28_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W28_Lane4" name="Cost Accountant">
        <bpmn:flowNodeRef>W28_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W28_End18</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W28_Start6" name="Customer purchases or receives a gift card; or customer issued store credit as refund">
        <bpmn:outgoing>W28_Flow21</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W28_Task7" name="Customer purchases gift card at POS: Cashier selects &quot;Sell Gift Card&quot;…">
        <bpmn:documentation>Step 1: Customer purchases gift card at POS: Cashier selects &quot;Sell Gift Card&quot;; scans/activates new card; loads amount
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W28_Flow21</bpmn:incoming>
        <bpmn:outgoing>W28_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W28_Task8" name="System activates gift card number; records liability (unredeemed balance) on…">
        <bpmn:documentation>Step 2: System activates gift card number; records liability (unredeemed balance) on balance sheet
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W28_Flow22</bpmn:incoming>
        <bpmn:outgoing>W28_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W28_Task9" name="Customer (or recipient) presents gift card at checkout; Cashier scans barcode…">
        <bpmn:documentation>Step 3: Customer (or recipient) presents gift card at checkout; Cashier scans barcode or enters card number
Responsible (R): Cashier
Accountable (A): —
Duration: 15 sec</bpmn:documentation>
        <bpmn:incoming>W28_Flow23</bpmn:incoming>
        <bpmn:outgoing>W28_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W28_Task10" name="System validates card is active and has sufficient balance; applies as payment…">
        <bpmn:documentation>Step 4: System validates card is active and has sufficient balance; applies as payment method
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W28_Flow24</bpmn:incoming>
        <bpmn:outgoing>W28_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W28_Task11" name="If partial redemption: remaining balance stays on card; receipt shows new…">
        <bpmn:documentation>Step 5: If partial redemption: remaining balance stays on card; receipt shows new balance
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W28_Flow25</bpmn:incoming>
        <bpmn:outgoing>W28_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W28_Task12" name="If customer requests balance inquiry: Cashier scans card; system displays…">
        <bpmn:documentation>Step 6: If customer requests balance inquiry: Cashier scans card; system displays balance on receipt or customer display
Responsible (R): Cashier
Accountable (A): —
Duration: 10 sec</bpmn:documentation>
        <bpmn:incoming>W28_Flow26</bpmn:incoming>
        <bpmn:outgoing>W28_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W28_Task13" name="Customer can reload existing gift card at POS or online">
        <bpmn:documentation>Step 7: Customer can reload existing gift card at POS or online
Responsible (R): Cashier / Customer (online)
Accountable (A): —
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W28_Flow27</bpmn:incoming>
        <bpmn:outgoing>W28_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W28_Task14" name="Store credit issued (W12 returns with no receipt or outside policy): system…">
        <bpmn:documentation>Step 8: Store credit issued (W12 returns with no receipt or outside policy): system generates store credit voucher with unique barcode and amount
Responsible (R): CSR
Accountable (A): Store Manager
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W28_Flow28</bpmn:incoming>
        <bpmn:outgoing>W28_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W28_Task15" name="Store credit redeemed at POS: Cashier scans voucher barcode; applies as…">
        <bpmn:documentation>Step 9: Store credit redeemed at POS: Cashier scans voucher barcode; applies as payment; system marks voucher as fully/partially used
Responsible (R): Cashier
Accountable (A): —
Duration: 30 sec</bpmn:documentation>
        <bpmn:incoming>W28_Flow29</bpmn:incoming>
        <bpmn:outgoing>W28_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W28_Task16" name="Loyalty/promotional gift-card program-term expiry (RA 10962-exempt instruments…">
        <bpmn:documentation>Step 10: Loyalty/promotional gift-card program-term expiry (RA 10962-exempt instruments only): system flags program-expired cards and Finance recognizes breakage income; sold gift checks carry no expiry per RA 10962 (Gift Check Act of 2017)
Responsible (R): System
Accountable (A): Controller
Duration: Automated (monthly batch)</bpmn:documentation>
        <bpmn:incoming>W28_Flow30</bpmn:incoming>
        <bpmn:outgoing>W28_Flow31</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W28_Task17" name="Monthly: Finance reviews gift card liability report (total outstanding, aging…">
        <bpmn:documentation>Step 11: Monthly: Finance reviews gift card liability report (total outstanding, aging, breakage recognized)
Responsible (R): Cost Accountant
Accountable (A): Controller
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W28_Flow31</bpmn:incoming>
        <bpmn:outgoing>W28_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W28_End18" name="Complete">
        <bpmn:incoming>W28_Flow32</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W28_Annotation19">
        <bpmn:text>Controls: - CTL-33 (ensure gift card liability accuracy.); CTL-49 (prevent unauthorized gift card balance manipulation.) | - operational: CSR investigation with Store Manager approval gate on manual gift-card balance adjustments; store-credit voucher issuance requires manager approval with return-receipt match
Owner: Customer Service Rep (in-store); Marketing (gift card program)</bpmn:text>
      </bpmn:textAnnotation>
