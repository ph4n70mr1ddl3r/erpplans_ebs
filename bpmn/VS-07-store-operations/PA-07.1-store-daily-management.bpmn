    <bpmn:process id="W_W432" name="W432. Solo Parent Discount Compliance (RA 11861)" isExecutable="false">
      <bpmn:documentation>Trigger: Customer presents Solo Parent ID at POS
Frequency: High; ~2–4% of retail transactions
Volume: ~56,000–112,000 transactions/month chain-wide (2–4% of the 2.8M monthly POS volume)
Owner: Lead Cashier
Participants: Cashier, Solo Parent Customer, Store Manager
Source: workflow W432 — Solo Parent Discount Compliance (RA 11861)</bpmn:documentation>
      <bpmn:laneSet id="W432_LaneSet3">
        <bpmn:lane id="W432_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W432_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W432_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W432_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W432_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W432_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W432_Lane2" name="System">
        <bpmn:flowNodeRef>W432_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W432_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W432_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W432_Start4" name="Customer presents Solo Parent ID at POS">
        <bpmn:outgoing>W432_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W432_Task5" name="Identification">
        <bpmn:documentation>Step 1: Identification: Customer presents valid Solo Parent ID (issued by LGU/DSWD) and Solo Parent Booklet
Responsible (R): Cashier
Accountable (A): —
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W432_Flow14</bpmn:incoming>
        <bpmn:outgoing>W432_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W432_Task6" name="Validation">
        <bpmn:documentation>Step 2: Validation: Cashier verifies Solo Parent ID validity and that each item is on the RA 11861 eligible-item list (no monthly purchase cap under the IRR)
Responsible (R): Cashier
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W432_Flow15</bpmn:incoming>
        <bpmn:outgoing>W432_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W432_Task7" name="POS Selection">
        <bpmn:documentation>Step 3: POS Selection: Cashier selects &quot;Solo Parent&quot; discount type; system prompts for ID number and name
Responsible (R): Cashier
Accountable (A): —
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W432_Flow16</bpmn:incoming>
        <bpmn:outgoing>W432_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W432_Task8" name="Item Filtering">
        <bpmn:documentation>Step 4: Item Filtering: System automatically applies 10% discount and VAT-exemption ONLY to eligible SKUs (mapped in Item Master)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W432_Flow17</bpmn:incoming>
        <bpmn:outgoing>W432_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W432_Task9" name="Transaction">
        <bpmn:documentation>Step 5: Transaction: Receipt prints with mandatory Solo Parent disclosure (Name, ID#, Gross Sale, Discount, VAT Exempt Sales)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W432_Flow18</bpmn:incoming>
        <bpmn:outgoing>W432_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W432_Task10" name="Manual Log">
        <bpmn:documentation>Step 6: Manual Log: Cashier records transaction in the physical Solo Parent Logbook as required by the LGU
Responsible (R): Cashier
Accountable (A): Lead Cashier
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W432_Flow19</bpmn:incoming>
        <bpmn:outgoing>W432_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W432_End11" name="Complete">
        <bpmn:incoming>W432_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W432_Annotation12">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Lead Cashier</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W432_Assoc13" sourceRef="W432_Annotation12" targetRef="W432_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W432_Flow14" sourceRef="W432_Start4" targetRef="W432_Task5" />
