    <bpmn:process id="W_W5F" name="W5F. Store Closing &amp; End-of-Day" isExecutable="false">
      <bpmn:documentation>Trigger: Store operating hours end (typically 7:00–9:00 PM)
Frequency: Daily per store
Volume: ~200 stores closing daily
Owner: Store Manager (or Assistant Manager)
Participants: Cashier, Store Manager, Maintenance/Utility Staff, Armored Car Guard
Source: workflow W5F — Store Closing &amp; End-of-Day</bpmn:documentation>
      <bpmn:laneSet id="W5F_LaneSet4">
        <bpmn:lane id="W5F_Lane1" name="Cashier">
