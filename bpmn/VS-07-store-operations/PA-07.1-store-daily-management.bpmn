        <bpmn:flowNodeRef>W1419_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1419_Start6" name="Store end-of-day (EOD) system close; daily at each store&#x27;s closing time (typically…">
        <bpmn:outgoing>W1419_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1419_Task7" name="Automated store-level flash generation">
        <bpmn:documentation>Step 1: Automated store-level flash generation (at store close): System automatically generates daily flash per store upon Z-report completion per W574: (a) total revenue (gross), (b) number of transactions, (c) average transaction value (ATV), (d) top 10 selling items by revenue, (e) category breakdown (% of daily sales by category), (f) returns/voids count and value, (g) payment method split (cash/card/e-wallet), (h) vs. daily target (system compares to plan — daily target = monthly plan ÷ operating days), (i) vs. same day last year (YoY comparison)
Responsible (R): System
Accountable (A): Store Manager
Duration: Automated (&lt; 5 min)</bpmn:documentation>
        <bpmn:incoming>W1419_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1419_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1419_Task8" name="Store Manager review">
        <bpmn:documentation>Step 2: Store Manager review: Store Manager reviews flash report on store manager mobile app: (a) verify revenue vs. daily target — if below 80% of target, Store Manager must add commentary (foot traffic observation, weather, local events), (b) review ATV — if significantly below PHP 1,800, may indicate price scanning issues or customer mix shift, (c) acknowledge receipt in system (tracks store-level compliance)
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W1419_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1419_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1419_Task9" name="HQ overnight consolidation">
        <bpmn:documentation>Step 3: HQ overnight consolidation (by 6:00 AM next day): System consolidates all 200 store flash reports: (a) chain-wide total revenue, transactions, ATV, (b) regional breakdown (Mindanao, Visayas, Luzon, NCR, North/Central Luzon), (c) top 10 stores by revenue, (d) bottom 10 stores by variance-to-target, (e) category performance (which categories are trending above/below plan for the day), (f) BOPIS and ecommerce contribution to daily revenue, (g) cash/card/e-wallet split chain-wide
Responsible (R): System
Accountable (A): VP Store Operations
Duration: Automated (&lt; 30 min)</bpmn:documentation>
        <bpmn:incoming>W1419_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1419_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1419_Task10" name="Morning executive review">
        <bpmn:documentation>Step 4: Morning executive review (by 10:00 AM): (a) VP Store Operations reviews consolidated flash: identify stores below 80% of target — email flag to Regional Manager for follow-up, (b) FP&amp;A Analyst reviews daily revenue run-rate: are we tracking to monthly plan? calculate implied monthly revenue based on actual days elapsed + projected remaining days, (c) VP Merchandising reviews category performance: identify categories significantly above/below daily plan — trigger action (promotion boost, allocation change), (d) CEO receives one-page daily flash summary via mobile app
Responsible (R): VP Store Operations / FP&amp;A Analyst / VP Merchandising
Accountable (A): CEO
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W1419_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1419_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1419_Task11" name="Exception escalation">
        <bpmn:documentation>Step 5: Exception escalation: (a) stores below 70% of daily target for 2+ consecutive days: Regional Manager must visit store within 48 hours and report root cause, (b) stores with ATV drop &gt; 20% vs. same day last year: Loss Prevention team reviews for potential POS manipulation per W562, (c) chain-wide daily revenue below 90% of plan for 3+ consecutive days: VP Store Operations convenes emergency review with Merchandising, Marketing, and FP&amp;A
Responsible (R): Regional Manager / VP Store Operations
Accountable (A): COO
Duration: As needed</bpmn:documentation>
        <bpmn:incoming>W1419_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1419_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1419_End12" name="Complete">
        <bpmn:incoming>W1419_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1419_Annotation13">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: tracking acknowledgment compliance in Store Manager KPI scorecard; operational: running a second consolidation at noon with updated data; operational: exception-based escalation (only flag variances, not routine results)
Owner: Store Manager (store-level); VP Store Operations (HQ consolidation)</bpmn:text>
      </bpmn:textAnnotation>
