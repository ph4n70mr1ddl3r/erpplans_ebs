      <bpmn:sequenceFlow id="W5507_Flow21" sourceRef="W5507_Task11" targetRef="W5507_Task12" />
      <bpmn:sequenceFlow id="W5507_Flow22" sourceRef="W5507_Task12" targetRef="W5507_Task13" />
      <bpmn:sequenceFlow id="W5507_Flow23" sourceRef="W5507_Task13" targetRef="W5507_End14" />
    </bpmn:process>
