      <bpmn:sequenceFlow id="W5G_Flow21" sourceRef="W5G_Task9" targetRef="W5G_Task10" />
      <bpmn:sequenceFlow id="W5G_Flow22" sourceRef="W5G_Task10" targetRef="W5G_Task11" />
      <bpmn:sequenceFlow id="W5G_Flow23" sourceRef="W5G_Task11" targetRef="W5G_Task12" />
      <bpmn:sequenceFlow id="W5G_Flow24" sourceRef="W5G_Task12" targetRef="W5G_Task13" />
      <bpmn:sequenceFlow id="W5G_Flow25" sourceRef="W5G_Task13" targetRef="W5G_End14" />
    </bpmn:process>
