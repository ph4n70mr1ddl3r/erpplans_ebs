      <bpmn:sequenceFlow id="W5574_Flow22" sourceRef="W5574_Task10" targetRef="W5574_Task11" />
      <bpmn:sequenceFlow id="W5574_Flow23" sourceRef="W5574_Task11" targetRef="W5574_Task12" />
      <bpmn:sequenceFlow id="W5574_Flow24" sourceRef="W5574_Task12" targetRef="W5574_Task13" />
      <bpmn:sequenceFlow id="W5574_Flow25" sourceRef="W5574_Task13" targetRef="W5574_Task14" />
      <bpmn:sequenceFlow id="W5574_Flow26" sourceRef="W5574_Task14" targetRef="W5574_Task15" />
      <bpmn:sequenceFlow id="W5574_Flow27" sourceRef="W5574_Task15" targetRef="W5574_Task16" />
      <bpmn:sequenceFlow id="W5574_Flow28" sourceRef="W5574_Task16" targetRef="W5574_End17" />
    </bpmn:process>
