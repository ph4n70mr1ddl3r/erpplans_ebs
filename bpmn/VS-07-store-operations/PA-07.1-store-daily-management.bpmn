        <bpmndi:BPMNShape id="W999_Task7_di" bpmnElement="W999_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W999_Task8_di" bpmnElement="W999_Task8"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W999_Task9_di" bpmnElement="W999_Task9"><dc:Bounds x="1240" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W999_Start4_di" bpmnElement="W999_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W999_End10_di" bpmnElement="W999_End10"><dc:Bounds x="1470" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W999_Annotation11_di" bpmnElement="W999_Annotation11"><dc:Bounds x="160" y="460" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W999_Flow13_di" bpmnElement="W999_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W999_Flow14_di" bpmnElement="W999_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W999_Flow15_di" bpmnElement="W999_Flow15"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W999_Flow16_di" bpmnElement="W999_Flow16"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W999_Flow17_di" bpmnElement="W999_Flow17"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W999_Flow18_di" bpmnElement="W999_Flow18"><di:waypoint x="1420" y="165" /><di:waypoint x="1470" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W999_Assoc12_di" bpmnElement="W999_Assoc12"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1049" name="W1049. Store-Level Customer Tool Sharpening, Blade Replacement &amp; Small Engine Maintenance Service" isExecutable="false">
      <bpmn:documentation>Trigger: Customer brings dull/broken tool for sharpening or blade replacement, or requests small engine (lawnmower, chainsaw, generator) tune-up
Frequency: ~1,500–2,500 service requests/month across all stores
Volume: 1–3 items per customer visit
Owner: Tools &amp; Hardware Department Supervisor
Participants: Sales Associate (Tool Section), Service Technician, Customer
Source: workflow W1049 — Store-Level Customer Tool Sharpening, Blade Replacement &amp; Small Engine Maintenance Service</bpmn:documentation>
      <bpmn:laneSet id="W1049_LaneSet3">
        <bpmn:lane id="W1049_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W1049_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1049_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1049_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1049_Lane2" name="Service Technician">
        <bpmn:flowNodeRef>W1049_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1049_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1049_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1049_Start4" name="Customer brings dull/broken tool for sharpening or blade replacement, or requests small…">
        <bpmn:outgoing>W1049_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1049_Task5" name="Service Request Intake &amp; Assessment">
        <bpmn:documentation>Step 1: Service Request Intake &amp; Assessment: Sales Associate receives customer&#x27;s tool/equipment and performs initial assessment: (a) item type — hand saw, chisel, plane blade, drill bit, knife, scissors, mower blade, chainsaw chain, other; (b) for small engines: lawnmower, chainsaw, brush cutter, portable generator, pressure washer; (c) condition assessment — dull (normal wear), chipped/damaged blade, broken tooth, bent, rusty; (d) determine serviceability: (i) sharpenable items: hand saws, chisels, plane blades, mower blades, chainsaw chains, knives, scissors — accept for sharpening; (ii) replacement-only items: drill bits &lt;6mm (not economical to sharpen), broken saw blades — sell replacement; (iii) non-serviceable items: severely damaged, counterfeit/unsafe brands — decline with explanation; (e) for small engines: diagnose issue — routine maintenance (oil change, filter clean, spark plug), starting problem, running rough, other — per W440 if complex repair needed; (f) system creates service work order per W544 with customer details, item description, requested service, and estimated completion time
Responsible (R): Sales Associate
Accountable (A): Tools &amp; Hardware Dept Supervisor
Duration: 5–8 min</bpmn:documentation>
        <bpmn:incoming>W1049_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1049_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1049_Task6" name="Sharpening Execution">
        <bpmn:documentation>Step 2: Sharpening Execution: Service Technician performs sharpening at dedicated workbench: (a) Hand saw sharpening: clamp saw in vise, use triangular file to sharpen each tooth to original profile and set; verify tooth set uniformity with saw set tool; test cut on scrap wood; (b) Chisel sharpening: use bench grinder with water cooling (prevent heat bluing) to restore primary bevel (25° or 30°), then hone on sharpening stone (1000-grit then 6000-grit) for mirror edge; verify sharpness on paper test; (c) Mower blade sharpening: remove blade from mower, clamp in vise, use angle grinder to sharpen cutting edge to original angle, balance blade on balancer pin (unbalanced blade causes vibration damage); reinstall; (d) Chainsaw chain sharpening: use appropriate round file size per chain pitch, file each cutter at correct depth gauge setting, verify with chain gauge tool; (e) Drill bit sharpening (&gt;6mm): use drill bit sharpening jig on bench grinder, verify point angle (118° standard, 135° for harder materials); (f) system logs service completion on work order
Responsible (R): Service Technician
Accountable (A): Tools &amp; Hardware Dept Supervisor
Duration: 10–30 min (varies by item)</bpmn:documentation>
        <bpmn:incoming>W1049_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1049_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1049_Task7" name="Small Engine Maintenance Execution">
        <bpmn:documentation>Step 3: Small Engine Maintenance Execution: For small engine tune-up requests: (a) drain old engine oil into collection pan — dispose per W82 (hazardous waste); (b) replace with correct oil grade (SAE 30 for most small engines in Philippine climate); (c) clean or replace air filter (foam: wash and oil; paper: replace); (d) replace spark plug with correct model per engine specification; (e) check and clean fuel filter; (f) inspect fuel line for cracks/leaks; (g) check pull-start cord for fraying; (h) test start engine — verify smooth idle and acceleration; (i) if engine fails to start or runs poorly after basic maintenance, escalate to W440 (power tool service &amp; repair center) for diagnostic repair
Responsible (R): Service Technician
Accountable (A): Tools &amp; Hardware Dept Supervisor
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W1049_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1049_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1049_Task8" name="Customer Notification &amp; Collection">
        <bpmn:documentation>Step 4: Customer Notification &amp; Collection: (a) system sends SMS notification to customer: &quot;Your tool/equipment service is complete. Please collect at BuildRight [Store Name] Tool Service Counter. Service fee: PHP [amount]&quot;; (b) customer presents service receipt for item collection; (c) customer verifies service quality (test sharpness or engine start at counter); (d) service fee collected at POS per W544 (service work order); (e) if customer declined service after assessment (e.g., opted for replacement instead), original item returned and replacement sale processed; (f) system closes service work order and logs service history linked to original sale transaction (for warranty tools)
Responsible (R): Sales Associate / POS Cashier
Accountable (A): Tools &amp; Hardware Dept Supervisor
Duration: 3–5 min</bpmn:documentation>
        <bpmn:incoming>W1049_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1049_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1049_End9" name="Complete">
        <bpmn:incoming>W1049_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1049_Annotation10">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Tools &amp; Hardware Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1049_Assoc11" sourceRef="W1049_Annotation10" targetRef="W1049_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1049_Flow12" sourceRef="W1049_Start4" targetRef="W1049_Task5" />
      <bpmn:sequenceFlow id="W1049_Flow13" sourceRef="W1049_Task5" targetRef="W1049_Task6" />
      <bpmn:sequenceFlow id="W1049_Flow14" sourceRef="W1049_Task6" targetRef="W1049_Task7" />
      <bpmn:sequenceFlow id="W1049_Flow15" sourceRef="W1049_Task7" targetRef="W1049_Task8" />
      <bpmn:sequenceFlow id="W1049_Flow16" sourceRef="W1049_Task8" targetRef="W1049_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1049_diag">
      <bpmndi:BPMNPlane id="W1049_plane" bpmnElement="W_W1049">
        <bpmndi:BPMNShape id="W1049_Lane1_di" bpmnElement="W1049_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1049_Lane2_di" bpmnElement="W1049_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1049_Task5_di" bpmnElement="W1049_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1049_Task6_di" bpmnElement="W1049_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1049_Task7_di" bpmnElement="W1049_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1049_Task8_di" bpmnElement="W1049_Task8"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1049_Start4_di" bpmnElement="W1049_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1049_End9_di" bpmnElement="W1049_End9"><dc:Bounds x="1260" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1049_Annotation10_di" bpmnElement="W1049_Annotation10"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1049_Flow12_di" bpmnElement="W1049_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1049_Flow13_di" bpmnElement="W1049_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1049_Flow14_di" bpmnElement="W1049_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
