        <bpmndi:BPMNEdge id="W463_Assoc15_di" bpmnElement="W463_Assoc15"><di:waypoint x="340" y="800" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W524" name="W524. Demo / Display Unit Selling at POS" isExecutable="false">
      <bpmn:documentation>Trigger: Customer inquires about purchasing a demo or display unit from the store floor; or Store Manager decides to sell aged display unit to free floor space
Frequency: Occasional — ~5–10 display unit sales per store per month
Volume: ~1,000–2,000 display unit sales/month chain-wide (5–10/store/month per the Frequency)
Owner: Sales Associate (condition assessment); Store Manager (pricing approval and POS processing)
Participants: Sales Associate, Store Manager, Customer, Merchandising Coordinator (replacement order)
Source: workflow W524 — Demo / Display Unit Selling at POS</bpmn:documentation>
      <bpmn:laneSet id="W524_LaneSet6">
        <bpmn:lane id="W524_Lane1" name="Customer">
        <bpmn:flowNodeRef>W524_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W524_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W524_Lane2" name="Sales Associate">
        <bpmn:flowNodeRef>W524_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W524_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W524_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W524_Lane3" name="System">
        <bpmn:flowNodeRef>W524_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W524_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W524_Lane4" name="Store Manager">
        <bpmn:flowNodeRef>W524_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W524_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W524_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W524_Lane5" name="Merchandising Coordinator">
        <bpmn:flowNodeRef>W524_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W524_End18</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W524_Start7" name="Customer inquires about purchasing a demo or display unit from the store floor; or Store…">
        <bpmn:outgoing>W524_Flow21</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W524_Task8" name="Customer expresses interest in purchasing floor display or demo unit (e.g…">
        <bpmn:documentation>Step 1: Customer expresses interest in purchasing floor display or demo unit (e.g., power tool on display, faucet fixture, appliance demo unit, tile display panel); or Store Manager identifies aged display unit for sale (display unit on floor &gt; 6 months per Merchandising guidelines)
Responsible (R): Customer / Store Manager
Accountable (A): —
Duration: —</bpmn:documentation>
        <bpmn:incoming>W524_Flow21</bpmn:incoming>
        <bpmn:outgoing>W524_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W524_Task9" name="Sales Associate inspects display unit condition: cosmetic condition (scratches…">
        <bpmn:documentation>Step 2: Sales Associate inspects display unit condition: cosmetic condition (scratches, dents, discoloration), completeness (all accessories, manuals, remote, hoses, attachments present), functionality (power on test for power tools/appliances, mechanical test for fixtures); documents condition with photos on tablet
Responsible (R): Sales Associate
Accountable (A): Dept. Supervisor
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W524_Flow22</bpmn:incoming>
        <bpmn:outgoing>W524_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W524_Task10" name="Sales Associate enters condition assessment in system: selects display unit…">
        <bpmn:documentation>Step 3: Sales Associate enters condition assessment in system: selects display unit SKU, condition grade (A — like new, minor cosmetic; B — visible wear, fully functional; C — significant wear, minor functional limitation; D — functional but poor cosmetic); system records assessment with photos
Responsible (R): Sales Associate
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W524_Flow23</bpmn:incoming>
        <bpmn:outgoing>W524_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W524_Task11" name="System calculates suggested selling price based on condition grade and display…">
        <bpmn:documentation>Step 4: System calculates suggested selling price based on condition grade and display duration: Condition A — 85% of SRP; Condition B — 70% of SRP; Condition C — 55% of SRP; Condition D — 40% of SRP; configurable depreciation schedule per category in item master (W252)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W524_Flow24</bpmn:incoming>
        <bpmn:outgoing>W524_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W524_Task12" name="Store Manager reviews condition assessment and suggested price; can adjust…">
        <bpmn:documentation>Step 5: Store Manager reviews condition assessment and suggested price; can adjust price within ±10% of system-suggested price without further approval; price adjustments &gt; 10% require Regional Manager approval via W5B.4a price override process
Responsible (R): Store Manager
Accountable (A): Regional Manager (if &gt; 10%)
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W524_Flow25</bpmn:incoming>
        <bpmn:outgoing>W524_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W524_Task13" name="Store Manager informs customer of display unit status, condition, and price…">
        <bpmn:documentation>Step 6: Store Manager informs customer of display unit status, condition, and price; discloses that item is a display/demo unit with visible wear; provides modified warranty terms (standard warranty duration reduced by 50% for display units, or manufacturer warranty if still valid); customer verbally agrees
Responsible (R): Store Manager / Customer
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W524_Flow26</bpmn:incoming>
        <bpmn:outgoing>W524_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W524_Task14" name="Customer agrees to purchase; Store Manager processes sale at POS: scans display…">
        <bpmn:documentation>Step 7: Customer agrees to purchase; Store Manager processes sale at POS: scans display unit barcode (system recognizes display unit flag); selects &quot;Display Unit Sale&quot; transaction type; system applies approved price; system prints customer disclosure on receipt: &quot;DISPLAY UNIT — Sold As-Is with [X]-month warranty&quot;; system sets return policy for this transaction to &quot;No Returns — Display Unit Final Sale&quot; per W532
Responsible (R): Store Manager
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W524_Flow27</bpmn:incoming>
        <bpmn:outgoing>W524_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W524_Task15" name="Sales Associate removes display unit from floor; safely disconnects…">
        <bpmn:documentation>Step 8: Sales Associate removes display unit from floor; safely disconnects power/water/gas if applicable; packages item or provides carry-out assistance per W531; cleans display area and stages for replacement unit
Responsible (R): Sales Associate
Accountable (A): Dept. Supervisor
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W524_Flow28</bpmn:incoming>
        <bpmn:outgoing>W524_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W524_Task16" name="System automatically creates replenishment request for replacement display/demo…">
        <bpmn:documentation>Step 9: System automatically creates replenishment request for replacement display/demo unit: if item is current assortment → auto-generates internal transfer request (W22) or purchase suggestion (W2A) to restock display; if item is being discontinued → no replacement; system updates planogram compliance status (W86) to show empty display position
Responsible (R): System
Accountable (A): Merchandising Coordinator
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W524_Flow29</bpmn:incoming>
        <bpmn:outgoing>W524_Flow30</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W524_Task17" name="Monthly: Merchandising Coordinator reviews display unit sales report — units…">
        <bpmn:documentation>Step 10: Monthly: Merchandising Coordinator reviews display unit sales report — units sold, condition grades, average discount from SRP, replacement order status; identifies categories with high display unit turnover for potential display strategy adjustment
Responsible (R): Merchandising Coordinator
Accountable (A): VP Merchandising
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W524_Flow30</bpmn:incoming>
        <bpmn:outgoing>W524_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W524_End18" name="Complete">
        <bpmn:incoming>W524_Flow31</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W524_Annotation19">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: must clearly track warranty terms per display sale transaction
Owner: Sales Associate (condition assessment); Store Manager (pricing approval and POS processing)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W524_Assoc20" sourceRef="W524_Annotation19" targetRef="W524_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W524_Flow21" sourceRef="W524_Start7" targetRef="W524_Task8" />
      <bpmn:sequenceFlow id="W524_Flow22" sourceRef="W524_Task8" targetRef="W524_Task9" />
      <bpmn:sequenceFlow id="W524_Flow23" sourceRef="W524_Task9" targetRef="W524_Task10" />
