        <bpmn:flowNodeRef>W606_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W606_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W606_Lane4" name="Finance Analyst">
        <bpmn:flowNodeRef>W606_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W606_Lane5" name="Facilities Coordinator">
        <bpmn:flowNodeRef>W606_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W606_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W606_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W606_Start7" name="Start of billing cycle; daily monitoring">
        <bpmn:outgoing>W606_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W606_Task8" name="System auto-captures utility meter readings via IoT sensors (electricity…">
        <bpmn:documentation>Step 1: System auto-captures utility meter readings via IoT sensors (electricity, water) where installed; manual meter readings captured by Maintenance Staff daily at stores without IoT
Responsible (R): Maintenance Staff
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W606_Flow19</bpmn:incoming>
        <bpmn:outgoing>W606_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W606_Task9" name="System calculates daily utility consumption vs. budget allocation; displays…">
        <bpmn:documentation>Step 2: System calculates daily utility consumption vs. budget allocation; displays consumption per sqm benchmark on Store Manager dashboard; alerts on &gt; 15% daily variance from 30-day average
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W606_Flow20</bpmn:incoming>
        <bpmn:outgoing>W606_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W606_Task10" name="Store Manager conducts daily conservation walkthrough: (a) verify air…">
        <bpmn:documentation>Step 3: Store Manager conducts daily conservation walkthrough: (a) verify air conditioning set to 24°C policy, (b) check for water leaks in garden center and restrooms, (c) verify non-selling area lights off during daytime, (d) check forklift charging schedule (off-peak hours), (e) verify lumber yard sprinkler timer operation
Responsible (R): Store Manager
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W606_Flow21</bpmn:incoming>
        <bpmn:outgoing>W606_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W606_Task11" name="If leak or waste detected: Store Manager creates maintenance work order (per…">
        <bpmn:documentation>Step 4: If leak or waste detected: Store Manager creates maintenance work order (per W47) with urgency classification; for water emergencies (burst pipe), activates immediate shutoff and emergency repair protocol
Responsible (R): Store Manager
Accountable (A): Facilities Coordinator
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W606_Flow22</bpmn:incoming>
        <bpmn:outgoing>W606_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W606_Task12" name="Monthly: Finance Analyst receives utility bills per store; system auto-compares…">
        <bpmn:documentation>Step 5: Monthly: Finance Analyst receives utility bills per store; system auto-compares bill to meter reading data; flags discrepancies &gt; 10% for investigation (billing error, meter malfunction, theft)
Responsible (R): Finance Analyst
Accountable (A): Controller
Duration: 30 min/store</bpmn:documentation>
        <bpmn:incoming>W606_Flow23</bpmn:incoming>
        <bpmn:outgoing>W606_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W606_Task13" name="Monthly: Store Manager reviews utility cost as % of store operating budget…">
        <bpmn:documentation>Step 6: Monthly: Store Manager reviews utility cost as % of store operating budget (W489); identifies top 3 utility cost drivers; implements conservation action items for next month
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W606_Flow24</bpmn:incoming>
        <bpmn:outgoing>W606_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W606_Task14" name="Quarterly: Facilities Coordinator conducts utility benchmark analysis across…">
        <bpmn:documentation>Step 7: Quarterly: Facilities Coordinator conducts utility benchmark analysis across 200 stores — identifies bottom 10% performers (highest utility cost per sqm); coordinates energy audit for worst-performing stores; shares best practices from top 10% performers
Responsible (R): Facilities Coordinator
Accountable (A): COO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W606_Flow25</bpmn:incoming>
        <bpmn:outgoing>W606_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W606_Task15" name="Annually: Facilities Coordinator evaluates utility cost reduction projects (LED…">
        <bpmn:documentation>Step 8: Annually: Facilities Coordinator evaluates utility cost reduction projects (LED retrofit, solar panel installation per W173, water recycling for garden centers, inverter AC upgrade); presents business case to CFO for capital approval (per W21)
Responsible (R): Facilities Coordinator
Accountable (A): CFO
Duration: 8 hours</bpmn:documentation>
        <bpmn:incoming>W606_Flow26</bpmn:incoming>
        <bpmn:outgoing>W606_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W606_End16" name="Complete">
        <bpmn:incoming>W606_Flow27</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W606_Annotation17">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: daily reading checklist with compliance tracking; operational: automated bill-to-meter comparison in Step 5; operational: lease-level utility allocation agreements tracked in W117
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
