        <bpmndi:BPMNEdge id="W562_Flow22_di" bpmnElement="W562_Flow22"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W562_Flow23_di" bpmnElement="W562_Flow23"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W562_Flow24_di" bpmnElement="W562_Flow24"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W562_Flow25_di" bpmnElement="W562_Flow25"><di:waypoint x="1420" y="335" /><di:waypoint x="1450" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W562_Flow26_di" bpmnElement="W562_Flow26"><di:waypoint x="1630" y="335" /><di:waypoint x="1660" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W562_Flow27_di" bpmnElement="W562_Flow27"><di:waypoint x="1840" y="335" /><di:waypoint x="1870" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W562_Flow28_di" bpmnElement="W562_Flow28"><di:waypoint x="2050" y="335" /><di:waypoint x="2080" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W562_Flow29_di" bpmnElement="W562_Flow29"><di:waypoint x="2260" y="165" /><di:waypoint x="2290" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W562_Flow30_di" bpmnElement="W562_Flow30"><di:waypoint x="2470" y="335" /><di:waypoint x="2500" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W562_Flow31_di" bpmnElement="W562_Flow31"><di:waypoint x="2680" y="335" /><di:waypoint x="2710" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W562_Flow32_di" bpmnElement="W562_Flow32"><di:waypoint x="2890" y="165" /><di:waypoint x="2940" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W562_Assoc19_di" bpmnElement="W562_Assoc19"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W571" name="W571. Store-Level Daily Communication &amp; Memo Acknowledgment" isExecutable="false">
      <bpmn:documentation>Trigger: HQ issues daily communication, policy update, task assignment, or urgent memo via ERP communication module
Frequency: ~10–20 communications per day from HQ to stores; Store Manager daily review
Volume: Higher during promotional changeover (bi-monthly), policy changes, seasonal transitions, price freeze events
Owner: VP Store Operations (HQ-side); Store Manager (store-side)
Participants: Store Operations Coordinator, Store Manager, Department Supervisors, IT (system support)
Source: workflow W571 — Store-Level Daily Communication &amp; Memo Acknowledgment</bpmn:documentation>
      <bpmn:laneSet id="W571_LaneSet5">
        <bpmn:lane id="W571_Lane1" name="HQ Department Lead">
        <bpmn:flowNodeRef>W571_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W571_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W571_Lane2" name="System">
        <bpmn:flowNodeRef>W571_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W571_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W571_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W571_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W571_Task18</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W571_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W571_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W571_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W571_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W571_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W571_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W571_Lane4" name="Regional Manager">
        <bpmn:flowNodeRef>W571_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W571_End19</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W571_Start6" name="HQ issues daily communication, policy update, task assignment, or urgent memo via ERP…">
        <bpmn:outgoing>W571_Flow22</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W571_Task7" name="HQ department creates communication item in ERP">
        <bpmn:documentation>Step 1: HQ department creates communication item in ERP: authorized HQ department (Merchandising, HR, IT, Compliance, Store Operations, Finance, Safety) creates communication item in ERP communication module: (a) subject line (clear, action-oriented), (b) body content (markdown supported with images, tables, file attachments), (c) priority level (Urgent — red, Standard — yellow, Informational — green), (d) target audience (all stores, regional [select region], specific stores [multi-select], by store class [e.g., stores with garden center]), (e) category (promotional, pricing, policy, recall, safety, HR, IT, operations, seasonal), (f) acknowledgment deadline (Urgent: 4 hours, Standard: 24 hours, Informational: 72 hours), (g) execution confirmation required (yes/no — if yes, Store Manager must confirm task completion with optional photo evidence); submit for distribution
Responsible (R): HQ Department Lead
Accountable (A): VP Store Operations
Duration: 10–20 min per communication</bpmn:documentation>
        <bpmn:incoming>W571_Flow22</bpmn:incoming>
        <bpmn:outgoing>W571_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W571_Task8" name="Communication module pushes to targeted Store Managers">
        <bpmn:documentation>Step 2: Communication module pushes to targeted Store Managers: system distributes communication to targeted Store Managers: (a) item appears on Store Manager&#x27;s ERP dashboard under &quot;Communications&quot; tab, (b) unread count badge displayed on dashboard, (c) communication categorized and color-coded by priority, (d) full content and attachments accessible via dashboard and mobile app
Responsible (R): System
Accountable (A): —
Duration: Automated (within 60 seconds of creation)</bpmn:documentation>
        <bpmn:incoming>W571_Flow23</bpmn:incoming>
        <bpmn:outgoing>W571_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W571_Task9" name="Urgent items trigger push notification and SMS">
        <bpmn:documentation>Step 3: Urgent items trigger push notification and SMS: for Urgent priority communications: (a) push notification sent to Store Manager&#x27;s mobile app immediately, (b) SMS sent to Store Manager&#x27;s registered mobile number with subject line and link (for managers who may not have app open), (c) reminder push notification every 2 hours until acknowledged, (d) if not acknowledged within 4 hours: escalate to Regional Manager (Step 11); for Standard items: appear in daily communication digest email sent at 7:00 AM; for Informational items: appear in weekly digest
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W571_Flow24</bpmn:incoming>
        <bpmn:outgoing>W571_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W571_Task10" name="Store Manager opens communication during morning briefing">
        <bpmn:documentation>Step 4: Store Manager opens communication during morning briefing: Store Manager reviews communications during morning huddle (W5A store opening): (a) opens dashboard on tablet or office PC, (b) reviews new communications sorted by priority (Urgent first), (c) reads full content of each communication, (d) identifies action items requiring cascade to Department Supervisors
Responsible (R): Store Manager
Accountable (A): —
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W571_Flow25</bpmn:incoming>
        <bpmn:outgoing>W571_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W571_Task11" name="For task-type communications — assign to Department Supervisor">
        <bpmn:documentation>Step 5: For task-type communications — assign to Department Supervisor: if communication requires execution (e.g., &quot;Set up promotional endcap for Power Tool Festival by Friday&quot;): (a) Store Manager assigns task to specific Department Supervisor via communication module, (b) sets due date and expected completion evidence (photo, checklist, system confirmation), (c) task appears on Department Supervisor&#x27;s handheld dashboard, (d) Store Manager tracks task status from communication detail screen
Responsible (R): Store Manager
Accountable (A): —
Duration: 3–5 min per task-type communication</bpmn:documentation>
        <bpmn:incoming>W571_Flow26</bpmn:incoming>
        <bpmn:outgoing>W571_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W571_Task12" name="For policy-type communications — review with supervisors during daily huddle">
        <bpmn:documentation>Step 6: For policy-type communications — review with supervisors during daily huddle: if communication is a policy update or operational directive: (a) Store Manager reviews key points with Department Supervisors during morning huddle, (b) supervisors acknowledge understanding verbally and sign huddle attendance log, (c) Store Manager records huddle completion in communication module as documentation of cascade
Responsible (R): Store Manager
Accountable (A): —
Duration: 5–10 min per policy communication</bpmn:documentation>
        <bpmn:incoming>W571_Flow27</bpmn:incoming>
        <bpmn:outgoing>W571_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W571_Task13" name="Store Manager acknowledges receipt and confirms understanding">
        <bpmn:documentation>Step 7: Store Manager acknowledges receipt and confirms understanding: Store Manager clicks &quot;Acknowledge&quot; button on each communication: (a) system records timestamp, Store Manager ID, and store ID, (b) acknowledgment status changes to &quot;Read &amp; Acknowledged&quot; with timestamp, (c) communication moves from &quot;Unread&quot; to &quot;Acknowledged&quot; queue but remains accessible; checkbox with text &quot;I have read and understood this communication&quot; — prevents accidental acknowledgment without reading
Responsible (R): Store Manager
Accountable (A): —
Duration: 30 sec per communication</bpmn:documentation>
        <bpmn:incoming>W571_Flow28</bpmn:incoming>
        <bpmn:outgoing>W571_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W571_Task14" name="For execution-required items — confirm completion with evidence">
        <bpmn:documentation>Step 8: For execution-required items — confirm completion with evidence: for communications marked as &quot;execution confirmation required&quot;: (a) after Store Manager or Department Supervisor completes the task (e.g., promotional display set up per W523, recall items pulled from shelf per W29), (b) Store Manager opens the communication and clicks &quot;Confirm Completion&quot;, (c) uploads required evidence: photo of completed display, screenshot of system confirmation, or checklist sign-off, (d) system records completion timestamp and evidence; Regional Manager can review completion evidence for quality spot-check
Responsible (R): Store Manager / Department Supervisor
Accountable (A): Store Manager
Duration: 5–10 min per execution confirmation</bpmn:documentation>
        <bpmn:incoming>W571_Flow29</bpmn:incoming>
        <bpmn:outgoing>W571_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W571_Task15" name="System tracks acknowledgment rate and completion status per store">
        <bpmn:documentation>Step 9: System tracks acknowledgment rate and completion status per store: system maintains real-time tracking dashboard: (a) per communication: acknowledgment rate (X of 200 stores acknowledged), completion rate (for execution-required items), average time-to-acknowledgment, stores not yet acknowledged, (b) per store: acknowledgment compliance rate (last 30 days), overdue items count, average response time, (c) per priority level: Urgent SLA compliance (4-hour target); dashboard accessible to VP Store Operations and Regional Managers
Responsible (R): System
Accountable (A): —
Duration: Automated (real-time tracking)</bpmn:documentation>
        <bpmn:incoming>W571_Flow30</bpmn:incoming>
        <bpmn:outgoing>W571_Flow31</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W571_Task16" name="Regional Manager reviews non-acknowledging stores and follows up">
        <bpmn:documentation>Step 10: Regional Manager reviews non-acknowledging stores and follows up: Regional Manager reviews communication compliance dashboard: (a) identifies stores with overdue acknowledgments, (b) calls or messages Store Manager directly for follow-up, (c) documents reason for delayed acknowledgment (system issue, Store Manager absence, connectivity problem), (d) if systemic issue (e.g., ISP outage in region): escalates to IT (W48) for resolution and extends acknowledgment deadline for affected stores
Responsible (R): Regional Manager
Accountable (A): —
Duration: 15–30 min/day</bpmn:documentation>
        <bpmn:incoming>W571_Flow31</bpmn:incoming>
        <bpmn:outgoing>W571_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W571_Task17" name="Unacknowledged urgent items after 4 hours escalate to Regional Manager">
        <bpmn:documentation>Step 11: Unacknowledged urgent items after 4 hours escalate to Regional Manager: for Urgent communications not acknowledged within 4-hour SLA: (a) system auto-escalates to Regional Manager with store name and communication subject, (b) Regional Manager contacts Store Manager via phone call (mandatory — not just message), (c) Regional Manager can acknowledge on behalf of Store Manager with note explaining circumstance (e.g., &quot;Store Manager on emergency leave — I confirmed with Assistant Manager over phone&quot;), (d) escalation logged in audit trail
Responsible (R): System / Regional Manager
Accountable (A): Regional Manager
Duration: 5–10 min per escalation</bpmn:documentation>
        <bpmn:incoming>W571_Flow32</bpmn:incoming>
        <bpmn:outgoing>W571_Flow33</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W571_Task18" name="Monthly communication compliance dashboard">
        <bpmn:documentation>Step 12: Monthly communication compliance dashboard: system generates monthly compliance report: (a) overall chain-wide acknowledgment rate (target: &gt; 95% within SLA), (b) completion rate for execution-required items, (c) average response time by priority level, (d) bottom 10 stores by compliance rate (flagged for Store Manager coaching), (e) top 5 most impactful communications (highest execution-required volume), (f) communication volume trend (per department, per category); report feeds into W67 store performance review as &quot;Communication Compliance&quot; KPI
Responsible (R): System
Accountable (A): VP Store Operations
Duration: Automated (monthly report generation)</bpmn:documentation>
        <bpmn:incoming>W571_Flow33</bpmn:incoming>
        <bpmn:outgoing>W571_Flow34</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W571_End19" name="Complete">
        <bpmn:incoming>W571_Flow34</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W571_Annotation20">
        <bpmn:text>Controls: - CTL-259 (ensure controlled execution — Store Daily Management (PA-07.1).) | - operational: strict categorization (only genuinely urgent items marked Urgent), mandatory reading confirmation checkbox, and HQ communication guidelines limiting daily volume; operational: periodic spot-checks by Regional Manager and supervisor cascade documentation requirement for policy and task-type communications
Owner: VP Store Operations (HQ-side); Store Manager (store-side)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W571_Assoc21" sourceRef="W571_Annotation20" targetRef="W571_Start6" associationDirection="None" />
