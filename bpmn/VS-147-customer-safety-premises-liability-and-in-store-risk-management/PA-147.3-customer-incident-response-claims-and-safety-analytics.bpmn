      <bpmn:startEvent id="W4405_Start4" name="Notifiable incident (W4401); fatality; major injury; fire">
        <bpmn:outgoing>W4405_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4405_Task5" name="Compliance/Legal determine notifiability &amp; recipient per the matrix — BFP…">
        <bpmn:documentation>Step 1: Compliance/Legal determine notifiability &amp; recipient per the matrix — BFP (fire), DOLE (if worker involved / OSH-reportable), LGU (local incident/permit), DTI/Consumer (product-related), insurer (per policy 24-hr)
Responsible (R): Compliance / Legal / Insurance
Accountable (A): VP Legal / Head of Customer Safety
Duration: Immediate</bpmn:documentation>
        <bpmn:incoming>W4405_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4405_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4405_Task6" name="Compliance/Legal file the notification within statutory window (often 24–72…">
        <bpmn:documentation>Step 2: Compliance/Legal file the notification within statutory window (often 24–72 hrs), preserve evidence (VS-88), and manage regulator follow-up/inspection (W4391)
Responsible (R): Compliance / Legal / HSE
Accountable (A): VP Legal
Duration: Per window</bpmn:documentation>
        <bpmn:incoming>W4405_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4405_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4405_Task7" name="Insurance notify insurer/TPA within policy window, cooperate with…">
        <bpmn:documentation>Step 3: Insurance notify insurer/TPA within policy window, cooperate with investigation, and manage any breach-of-notice coverage issue (W4387/W4403)
Responsible (R): Insurance / Legal
Accountable (A): CFO / Head of Internal Audit &amp; Risk
Duration: Per window</bpmn:documentation>
        <bpmn:incoming>W4405_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4405_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4405_End8" name="Complete">
        <bpmn:incoming>W4405_Flow14</bpmn:incoming>
      </bpmn:endEvent>
