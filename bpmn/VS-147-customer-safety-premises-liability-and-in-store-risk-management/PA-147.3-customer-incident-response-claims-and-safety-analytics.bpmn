      <bpmndi:BPMNPlane id="W5555_plane" bpmnElement="W_W5555">
        <bpmndi:BPMNShape id="W5555_Lane1_di" bpmnElement="W5555_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2000" height="170" /></bpmndi:BPMNShape>
