      <bpmndi:BPMNPlane id="W4403_plane" bpmnElement="W_W4403">
        <bpmndi:BPMNShape id="W4403_Lane1_di" bpmnElement="W4403_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4403_Lane2_di" bpmnElement="W4403_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4403_Task5_di" bpmnElement="W4403_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4403_Task6_di" bpmnElement="W4403_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4403_Task7_di" bpmnElement="W4403_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4403_Start4_di" bpmnElement="W4403_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4403_End8_di" bpmnElement="W4403_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4403_Annotation9_di" bpmnElement="W4403_Annotation9"><dc:Bounds x="160" y="460" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4403_Flow11_di" bpmnElement="W4403_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4403_Flow12_di" bpmnElement="W4403_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4403_Flow13_di" bpmnElement="W4403_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4403_Flow14_di" bpmnElement="W4403_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4403_Assoc10_di" bpmnElement="W4403_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4404" name="W4404. Customer-Safety Corrective &amp; Preventive Action (CAPA)" isExecutable="false">
      <bpmn:documentation>Trigger: Incident investigation (W4402); audit finding (W4407); repeat hazard
Frequency: Per finding
Volume: Hundreds–thousands of corrective actions/yr across ~205 sites
Owner: Customer Safety / HSE (VS-24) / Store Manager
Participants: HSE (VS-24), Store Ops (VS-07), IFM (VS-138), Merchandising (VS-55), Real Estate (VS-20/VS-97), Training (VS-19.4)
Source: workflow W4404 — Customer-Safety Corrective &amp; Preventive Action (CAPA)</bpmn:documentation>
      <bpmn:laneSet id="W4404_LaneSet3">
        <bpmn:lane id="W4404_Lane1" name="Customer Safety">
        <bpmn:flowNodeRef>W4404_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4404_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4404_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4404_Lane2" name="Store Ops">
        <bpmn:flowNodeRef>W4404_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4404_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4404_Start4" name="Incident investigation (W4402); audit finding (W4407); repeat hazard">
        <bpmn:outgoing>W4404_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4404_Task5" name="Customer Safety/HSE open CAPA per finding — corrective (fix this instance) +…">
        <bpmn:documentation>Step 1: Customer Safety/HSE open CAPA per finding — corrective (fix this instance) + preventive (fix the system), assign owner/due-date, and link to root cause (W4402)
Responsible (R): Customer Safety / HSE
Accountable (A): Head of Customer Safety
Duration: Per finding</bpmn:documentation>
        <bpmn:incoming>W4404_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4404_Flow12</bpmn:outgoing>
