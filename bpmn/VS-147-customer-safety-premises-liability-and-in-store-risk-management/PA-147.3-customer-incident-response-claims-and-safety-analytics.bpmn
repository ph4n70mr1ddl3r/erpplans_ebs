        <bpmndi:BPMNEdge id="W4401_Flow12_di" bpmnElement="W4401_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4401_Flow13_di" bpmnElement="W4401_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4401_Flow14_di" bpmnElement="W4401_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4401_Assoc10_di" bpmnElement="W4401_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4402" name="W4402. Customer Incident Investigation, Documentation &amp; Root Cause" isExecutable="false">
      <bpmn:documentation>Trigger: Recordable/severe incident (W4401); repeat near-miss
Frequency: Per recordable incident
Volume: ~tens–hundreds of investigations/yr (severity-driven)
Owner: Customer Safety / HSE (VS-24) / Store Manager
Participants: HSE (VS-24), Store Ops (VS-07), Risk (VS-21), Legal (VS-100), Insurance (VS-26), IFM (VS-138)
Source: workflow W4402 — Customer Incident Investigation, Documentation &amp; Root Cause</bpmn:documentation>
      <bpmn:laneSet id="W4402_LaneSet2">
        <bpmn:lane id="W4402_Lane1" name="Customer Safety">
        <bpmn:flowNodeRef>W4402_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4402_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4402_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4402_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4402_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4402_Start3" name="Recordable/severe incident (W4401); repeat near-miss">
        <bpmn:outgoing>W4402_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4402_Task4" name="Customer Safety/HSE investigate — scene/witness/equipment/merchandise/CCTV…">
        <bpmn:documentation>Step 1: Customer Safety/HSE investigate — scene/witness/equipment/merchandise/CCTV review, sequence-of-events, contributing factors (design, maintenance, training, staffing, procedure)
Responsible (R): Customer Safety / HSE / Store
Accountable (A): Head of Customer Safety
Duration: Days–weeks</bpmn:documentation>
        <bpmn:incoming>W4402_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4402_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4402_Task5" name="Customer Safety/HSE determine root cause (5-Whys/fishbone), assign causal…">
        <bpmn:documentation>Step 2: Customer Safety/HSE determine root cause (5-Whys/fishbone), assign causal factors to standards/design/maintenance/training, and document findings &amp; evidence
Responsible (R): Customer Safety / HSE / Risk
Accountable (A): Head of Customer Safety
Duration: Per investigation</bpmn:documentation>
        <bpmn:incoming>W4402_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4402_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4402_Task6" name="Customer Safety/Risk feed findings into CAPA (W4404), standards change (W4386)…">
        <bpmn:documentation>Step 3: Customer Safety/Risk feed findings into CAPA (W4404), standards change (W4386), training (W4406), and the loss-data loop (W4385); retain records (VS-88)
Responsible (R): Customer Safety / Risk / Legal
Accountable (A): Head of Customer Safety / Head of Internal Audit &amp; Risk
Duration: Per investigation</bpmn:documentation>
        <bpmn:incoming>W4402_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4402_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4402_End7" name="Complete">
        <bpmn:incoming>W4402_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4402_Annotation8">
        <bpmn:text>Controls: - CTL-673 (ensure controlled execution — Customer Incident Response, Claims &amp; Safety Analytics (PA-147.3).) | - CTL-673: structured root-cause investigation; no-blame culture; evidence preserved/retained (VS-88); findings feed CAPA (W4404)
Owner: Customer Safety / HSE (VS-24) / Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4402_Assoc9" sourceRef="W4402_Annotation8" targetRef="W4402_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4402_Flow10" sourceRef="W4402_Start3" targetRef="W4402_Task4" />
      <bpmn:sequenceFlow id="W4402_Flow11" sourceRef="W4402_Task4" targetRef="W4402_Task5" />
      <bpmn:sequenceFlow id="W4402_Flow12" sourceRef="W4402_Task5" targetRef="W4402_Task6" />
      <bpmn:sequenceFlow id="W4402_Flow13" sourceRef="W4402_Task6" targetRef="W4402_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4402_diag">
      <bpmndi:BPMNPlane id="W4402_plane" bpmnElement="W_W4402">
        <bpmndi:BPMNShape id="W4402_Lane1_di" bpmnElement="W4402_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4402_Task4_di" bpmnElement="W4402_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
