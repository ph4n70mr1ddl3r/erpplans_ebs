<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-147.3-customer-incident-response-claims-and-safety-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4401" name="W4401. Customer Incident &amp; Accident Response (First Aid, Stabilize, Secure)" isExecutable="false">
      <bpmn:documentation>Trigger: Customer injury/near-miss/property-damage on premises
Frequency: Per incident (~daily across 200 stores for minor; severe less frequent)
Volume: Minor incidents ~ hundreds/yr; recordable/severe fewer; near-misses (if captured) thousands
Owner: Store Manager / First Aider (VS-83) / Customer Safety
Participants: Store Ops (VS-07), First Aider/Clinic (VS-83), HSE (VS-24), Security (VS-23), Customer Safety, Insurance (VS-26)
Source: workflow W4401 — Customer Incident &amp; Accident Response (First Aid, Stabilize, Secure)</bpmn:documentation>
      <bpmn:laneSet id="W4401_LaneSet3">
        <bpmn:lane id="W4401_Lane1" name="First Aider">
        <bpmn:flowNodeRef>W4401_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4401_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4401_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W4401_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4401_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4401_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4401_Start4" name="Customer injury/near-miss/property-damage on premises">
        <bpmn:outgoing>W4401_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4401_Task5" name="Store/First Aider secure the scene (stop hazard, cone-off, evacuate if needed)…">
        <bpmn:documentation>Step 1: Store/First Aider secure the scene (stop hazard, cone-off, evacuate if needed), provide first aid/clinic referral, call emergency services for serious injury, and care for the customer
Responsible (R): First Aider / Store Ops / Security
Accountable (A): Store Manager
Duration: Immediate (minutes)</bpmn:documentation>
        <bpmn:incoming>W4401_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4401_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4401_Task6" name="Store/Customer Safety capture the incident in the system (W4392) —…">
        <bpmn:documentation>Step 2: Store/Customer Safety capture the incident in the system (W4392) — what/when/where, customer details (PII per VS-91), witnesses, photos/CCTV, equipment/merchandise involved
Responsible (R): Store Manager / Customer Safety
Accountable (A): Store Manager
Duration: Within hours</bpmn:documentation>
        <bpmn:incoming>W4401_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4401_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4401_Task7" name="Store/Customer Safety preserve evidence (CCTV clip, damaged item, spill…">
        <bpmn:documentation>Step 3: Store/Customer Safety preserve evidence (CCTV clip, damaged item, spill sample), notify insurance (W4387/W4405), and avoid admission of liability (per legal W4387)
Responsible (R): Store Manager / Customer Safety / Insurance
Accountable (A): Store Manager / Head of Customer Safety
Duration: Within 24 hrs</bpmn:documentation>
        <bpmn:incoming>W4401_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4401_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4401_End8" name="Complete">
        <bpmn:incoming>W4401_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4401_Annotation9">
        <bpmn:text>Controls: - CTL-673 (ensure controlled execution — Customer Incident Response, Claims &amp; Safety Analytics (PA-147.3).) | - CTL-673: trained first-aider every shift; scene secured; evidence captured (photo/CCTV/witness); no admission of liability; insurance notified within 24 hrs
Owner: Store Manager / First Aider (VS-83) / Customer Safety</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4401_Assoc10" sourceRef="W4401_Annotation9" targetRef="W4401_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4401_Flow11" sourceRef="W4401_Start4" targetRef="W4401_Task5" />
      <bpmn:sequenceFlow id="W4401_Flow12" sourceRef="W4401_Task5" targetRef="W4401_Task6" />
      <bpmn:sequenceFlow id="W4401_Flow13" sourceRef="W4401_Task6" targetRef="W4401_Task7" />
      <bpmn:sequenceFlow id="W4401_Flow14" sourceRef="W4401_Task7" targetRef="W4401_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4401_diag">
      <bpmndi:BPMNPlane id="W4401_plane" bpmnElement="W_W4401">
        <bpmndi:BPMNShape id="W4401_Lane1_di" bpmnElement="W4401_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4401_Lane2_di" bpmnElement="W4401_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
