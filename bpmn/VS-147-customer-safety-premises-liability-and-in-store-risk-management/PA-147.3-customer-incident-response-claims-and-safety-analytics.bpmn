        <bpmndi:BPMNEdge id="W4402_Flow11_di" bpmnElement="W4402_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4402_Flow12_di" bpmnElement="W4402_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4402_Flow13_di" bpmnElement="W4402_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4402_Assoc9_di" bpmnElement="W4402_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4403" name="W4403. Customer Injury/Premises-Liability Claim Handling &amp; TPA Liaison" isExecutable="false">
      <bpmn:documentation>Trigger: Customer/claimant demand; lawyer letter; TPA referral
Frequency: Per claim (~tens–hundreds/yr)
Volume: Claims across ~205 sites; aggregate claim-cost exposure
Owner: Insurance (VS-26) / Legal (VS-100) / Customer Safety
Participants: Insurance (VS-26), Legal (VS-100), TPA, Treasury (VS-18), Risk (VS-21), Store (VS-07), Customer Safety
Source: workflow W4403 — Customer Injury/Premises-Liability Claim Handling &amp; TPA Liaison</bpmn:documentation>
      <bpmn:laneSet id="W4403_LaneSet3">
        <bpmn:lane id="W4403_Lane1" name="Insurance">
        <bpmn:flowNodeRef>W4403_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4403_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4403_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4403_Lane2" name="Legal">
        <bpmn:flowNodeRef>W4403_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4403_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4403_Start4" name="Customer/claimant demand; lawyer letter; TPA referral">
        <bpmn:outgoing>W4403_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4403_Task5" name="Insurance/Legal open the claim in the system, acknowledge to claimant (no…">
        <bpmn:documentation>Step 1: Insurance/Legal open the claim in the system, acknowledge to claimant (no admission), assign TPA/adjuster, and set reserve per framework (W4387)
Responsible (R): Insurance / Legal / TPA
Accountable (A): CFO / Head of Internal Audit &amp; Risk / VP Legal
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W4403_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4403_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4403_Task6" name="Insurance/Legal/TPA investigate liability &amp; damages (gather evidence W4402…">
        <bpmn:documentation>Step 2: Insurance/Legal/TPA investigate liability &amp; damages (gather evidence W4402, medical/damage proof, comparative-negligence), negotiate, and recommend settle/defend within authority
Responsible (R): Insurance / Legal / TPA
Accountable (A): CFO / VP Legal (settlement authority)
Duration: Weeks–months</bpmn:documentation>
        <bpmn:incoming>W4403_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4403_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4403_Task7" name="Legal manage litigation if unreached (VS-100), Treasury fund settlement…">
        <bpmn:documentation>Step 3: Legal manage litigation if unreached (VS-100), Treasury fund settlement (VS-18), Insurance recover from insurer/TPA close &amp; feed loss-data to prevention (W4385)
Responsible (R): Legal / Treasury / Insurance
Accountable (A): VP Legal / CFO
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W4403_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4403_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4403_End8" name="Complete">
        <bpmn:incoming>W4403_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4403_Annotation9">
        <bpmn:text>Controls: - CTL-673 (ensure controlled execution — Customer Incident Response, Claims &amp; Safety Analytics (PA-147.3).) | - CTL-673: no-admission protocol; TPA/adjuster assigned; reserve per framework; settlement within authority matrix; loss-data fed to prevention
Owner: Insurance (VS-26) / Legal (VS-100) / Customer Safety</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4403_Assoc10" sourceRef="W4403_Annotation9" targetRef="W4403_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4403_Flow11" sourceRef="W4403_Start4" targetRef="W4403_Task5" />
      <bpmn:sequenceFlow id="W4403_Flow12" sourceRef="W4403_Task5" targetRef="W4403_Task6" />
      <bpmn:sequenceFlow id="W4403_Flow13" sourceRef="W4403_Task6" targetRef="W4403_Task7" />
      <bpmn:sequenceFlow id="W4403_Flow14" sourceRef="W4403_Task7" targetRef="W4403_End8" />
    </bpmn:process>
