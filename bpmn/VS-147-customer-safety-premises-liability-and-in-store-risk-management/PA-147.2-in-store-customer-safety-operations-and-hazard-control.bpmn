<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-147.2-in-store-customer-safety-operations-and-hazard-control" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4393" name="W4393. Daily Store Safety Inspection, Hazard Hunt &amp; Housekeeping" isExecutable="false">
      <bpmn:documentation>Trigger: Store open; shift change; scheduled cycle
Frequency: Daily (open + mid-day + close) per site
Volume: 200 stores × ~3 inspections/day × ~360 days ≈ ~216,000 inspections/yr
Owner: Store Manager (VS-07) / Customer Safety
Participants: Store Ops (VS-07), HSE (VS-24), Stock Associates, IFM (VS-138), Customer Safety
Source: workflow W4393 — Daily Store Safety Inspection, Hazard Hunt &amp; Housekeeping</bpmn:documentation>
      <bpmn:laneSet id="W4393_LaneSet4">
        <bpmn:lane id="W4393_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W4393_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4393_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4393_Lane2" name="Store Ops">
        <bpmn:flowNodeRef>W4393_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4393_Lane3" name="Customer Safety">
        <bpmn:flowNodeRef>W4393_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4393_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4393_Start5" name="Store open; shift change; scheduled cycle">
        <bpmn:outgoing>W4393_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4393_Task6" name="Store team run the documented safety walk per zone (sales floor, lumber/tile…">
        <bpmn:documentation>Step 1: Store team run the documented safety walk per zone (sales floor, lumber/tile yard, parking) against the hazard register (W4386) — spills, obstacles, damaged racking, blocked egress, exposed sharps, unstable stacks
Responsible (R): Store Manager / Stock Associates
Accountable (A): Store Manager
Duration: ~20–30 min/inspection</bpmn:documentation>
        <bpmn:incoming>W4393_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4393_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4393_Task7" name="Store team correct immediate hazards (spill clean-up, cone-off, restack…">
        <bpmn:documentation>Step 2: Store team correct immediate hazards (spill clean-up, cone-off, restack, remove) or escalate to IFM (VS-138)/HSE, and log every finding into the incident system (W4392) including near-misses
Responsible (R): Store Ops / IFM / HSE
Accountable (A): Store Manager
Duration: Per finding</bpmn:documentation>
        <bpmn:incoming>W4393_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4393_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4393_Task8" name="Customer Safety/HSE trend findings, identify repeat hazards, and trigger…">
        <bpmn:documentation>Step 3: Customer Safety/HSE trend findings, identify repeat hazards, and trigger corrective action (W4404) or standard change (W4386)
Responsible (R): Customer Safety / HSE
Accountable (A): Head of Customer Safety
Duration: Weekly/monthly</bpmn:documentation>
        <bpmn:incoming>W4393_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4393_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4393_End9" name="Complete">
        <bpmn:incoming>W4393_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4393_Annotation10">
        <bpmn:text>Controls: - CTL-164 (ensure customer safety &amp; premises-liability control.) | - CTL-672: documented daily walk vs hazard register; immediate-hazard correction; findings logged incl. near-miss; trends reviewed (W4404)
Owner: Store Manager (VS-07) / Customer Safety</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4393_Assoc11" sourceRef="W4393_Annotation10" targetRef="W4393_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W4393_Flow12" sourceRef="W4393_Start5" targetRef="W4393_Task6" />
      <bpmn:sequenceFlow id="W4393_Flow13" sourceRef="W4393_Task6" targetRef="W4393_Task7" />
      <bpmn:sequenceFlow id="W4393_Flow14" sourceRef="W4393_Task7" targetRef="W4393_Task8" />
      <bpmn:sequenceFlow id="W4393_Flow15" sourceRef="W4393_Task8" targetRef="W4393_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4393_diag">
      <bpmndi:BPMNPlane id="W4393_plane" bpmnElement="W_W4393">
        <bpmndi:BPMNShape id="W4393_Lane1_di" bpmnElement="W4393_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4393_Lane2_di" bpmnElement="W4393_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4393_Lane3_di" bpmnElement="W4393_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4393_Task6_di" bpmnElement="W4393_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4393_Task7_di" bpmnElement="W4393_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4393_Task8_di" bpmnElement="W4393_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4393_Start5_di" bpmnElement="W4393_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4393_End9_di" bpmnElement="W4393_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
