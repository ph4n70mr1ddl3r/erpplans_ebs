      <bpmndi:BPMNPlane id="W4395_plane" bpmnElement="W_W4395">
        <bpmndi:BPMNShape id="W4395_Lane1_di" bpmnElement="W4395_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4395_Lane2_di" bpmnElement="W4395_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
