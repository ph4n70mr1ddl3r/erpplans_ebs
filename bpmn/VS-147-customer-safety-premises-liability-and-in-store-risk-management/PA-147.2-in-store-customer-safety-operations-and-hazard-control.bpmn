    <bpmn:process id="W_W4394" name="W4394. Aisle, Merchandise-Stack &amp; Falling-Stock Safety Control" isExecutable="false">
      <bpmn:documentation>Trigger: Daily inspection (W4393); replenishment; restock; damage
Frequency: Continuous (per replenishment/restock)
Volume: ~50,000 replenishment orders/month (production-calibrated per data-volumes §1.1) + daily restocking across 200 stores
Owner: Store Manager / Merchandising (VS-55) / Customer Safety
Participants: Merchandising (VS-55), Store Ops (VS-07), Stock Associates, IFM (VS-138), HSE (VS-24)
Source: workflow W4394 — Aisle, Merchandise-Stack &amp; Falling-Stock Safety Control</bpmn:documentation>
      <bpmn:laneSet id="W4394_LaneSet3">
        <bpmn:lane id="W4394_Lane1" name="Stock Associates">
        <bpmn:flowNodeRef>W4394_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4394_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4394_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4394_Lane2" name="Merchandising">
        <bpmn:flowNodeRef>W4394_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4394_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4394_Start4" name="Daily inspection (W4393); replenishment; restock; damage">
        <bpmn:outgoing>W4394_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4394_Task5" name="Stock team apply safe-stacking/pallet/racking standards per merchandise type…">
        <bpmn:documentation>Step 1: Stock team apply safe-stacking/pallet/racking standards per merchandise type (cement max-height, tile-palette banding, lumber cribbing/stickers, appliance restraint) per W4389/W4386
Responsible (R): Stock Associates / Merchandising
Accountable (A): Store Manager
Duration: Per replenishment</bpmn:documentation>
        <bpmn:incoming>W4394_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4394_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4394_Task6" name="Stock team verify clear-aisle width, no overhang into pedestrian aisles, stable…">
        <bpmn:documentation>Step 2: Stock team verify clear-aisle width, no overhang into pedestrian aisles, stable endcaps, and blocked/restricted access for unstable loads; quarantine damaged/unstable stock
Responsible (R): Stock Associates / HSE
Accountable (A): Store Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4394_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4394_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4394_Task7" name="Merchandising/IFM audit racking integrity (load capacity, damage, anchorage)…">
        <bpmn:documentation>Step 3: Merchandising/IFM audit racking integrity (load capacity, damage, anchorage) periodically and on damage; repair/replace unsafe racking
Responsible (R): Merchandising / IFM / HSE
Accountable (A): VP Merchandising / IFM Lead
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W4394_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4394_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4394_End8" name="Complete">
        <bpmn:incoming>W4394_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4394_Annotation9">
        <bpmn:text>Controls: - CTL-164 (ensure customer safety &amp; premises-liability control.) | - CTL-672: stacking standards enforced per merchandise type; racking integrity audited; unstable stock quarantined; clear-aisle maintained
Owner: Store Manager / Merchandising (VS-55) / Customer Safety</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4394_Assoc10" sourceRef="W4394_Annotation9" targetRef="W4394_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4394_Flow11" sourceRef="W4394_Start4" targetRef="W4394_Task5" />
      <bpmn:sequenceFlow id="W4394_Flow12" sourceRef="W4394_Task5" targetRef="W4394_Task6" />
      <bpmn:sequenceFlow id="W4394_Flow13" sourceRef="W4394_Task6" targetRef="W4394_Task7" />
      <bpmn:sequenceFlow id="W4394_Flow14" sourceRef="W4394_Task7" targetRef="W4394_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4394_diag">
      <bpmndi:BPMNPlane id="W4394_plane" bpmnElement="W_W4394">
        <bpmndi:BPMNShape id="W4394_Lane1_di" bpmnElement="W4394_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4394_Lane2_di" bpmnElement="W4394_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4394_Task5_di" bpmnElement="W4394_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4394_Task6_di" bpmnElement="W4394_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4394_Task7_di" bpmnElement="W4394_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
