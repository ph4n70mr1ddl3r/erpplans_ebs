        <bpmndi:BPMNShape id="W4394_End8_di" bpmnElement="W4394_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4394_Annotation9_di" bpmnElement="W4394_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4394_Flow11_di" bpmnElement="W4394_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4394_Flow12_di" bpmnElement="W4394_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4394_Flow13_di" bpmnElement="W4394_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4394_Flow14_di" bpmnElement="W4394_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4394_Assoc10_di" bpmnElement="W4394_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4395" name="W4395. Powered Equipment (Forklift/Reach/Order-Picker) In-Sales-Area Safety" isExecutable="false">
      <bpmn:documentation>Trigger: Equipment movement in customer-occupied area; replenishment during trading
Frequency: Continuous during trading hours
Volume: 200 stores × multiple powered-equipment moves/day (lumber/tile/cement/appliance restock)
Owner: Store Manager / HSE (VS-24) / Customer Safety
Participants: Store Ops (VS-07), HSE (VS-24), Stock Associates (operators), IFM (VS-138), Contingent (VS-98)
Source: workflow W4395 — Powered Equipment (Forklift/Reach/Order-Picker) In-Sales-Area Safety</bpmn:documentation>
      <bpmn:laneSet id="W4395_LaneSet3">
        <bpmn:lane id="W4395_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W4395_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4395_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4395_Lane2" name="HSE">
        <bpmn:flowNodeRef>W4395_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4395_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4395_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4395_Start4" name="Equipment movement in customer-occupied area; replenishment during trading">
        <bpmn:outgoing>W4395_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4395_Task5" name="Store Manager/HSE enforce equipment-in-sales-area rules — preferred off-hours…">
        <bpmn:documentation>Step 1: Store Manager/HSE enforce equipment-in-sales-area rules — preferred off-hours movement, segregated lanes (W4389), reverse-spotter/blue-light/horn, pedestrian-right-of-way, exclusion zones
Responsible (R): Store Manager / HSE / Operators
Accountable (A): Store Manager / Head of Customer Safety
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4395_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4395_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4395_Task6" name="HSE/Store Ops certify operators (license, refresher), inspect equipment pre-use…">
        <bpmn:documentation>Step 2: HSE/Store Ops certify operators (license, refresher), inspect equipment pre-use (horns, lights, brakes, reverse alarms), and remove unsafe equipment from service
Responsible (R): HSE / Store Ops / IFM
Accountable (A): Store Manager / HSE Lead
Duration: Per shift/pre-use</bpmn:documentation>
        <bpmn:incoming>W4395_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4395_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4395_Task7" name="HSE/Customer Safety audit adherence, investigate any equipment-customer…">
        <bpmn:documentation>Step 3: HSE/Customer Safety audit adherence, investigate any equipment-customer near-miss/incident (W4401/W4402), and tighten rules on learning
Responsible (R): HSE / Customer Safety
Accountable (A): Head of Customer Safety
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W4395_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4395_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4395_End8" name="Complete">
        <bpmn:incoming>W4395_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4395_Annotation9">
        <bpmn:text>Controls: - CTL-672 (ensure controlled execution — In-Store Customer Safety Operations &amp; Hazard Control (PA-147.2).) | - CTL-672: off-hours preference + spotter + exclusion zone + pedestrian-right-of-way; operator certified; equipment pre-use inspected; incidents investigated (W4402)
Owner: Store Manager / HSE (VS-24) / Customer Safety</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4395_Assoc10" sourceRef="W4395_Annotation9" targetRef="W4395_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4395_Flow11" sourceRef="W4395_Start4" targetRef="W4395_Task5" />
      <bpmn:sequenceFlow id="W4395_Flow12" sourceRef="W4395_Task5" targetRef="W4395_Task6" />
      <bpmn:sequenceFlow id="W4395_Flow13" sourceRef="W4395_Task6" targetRef="W4395_Task7" />
      <bpmn:sequenceFlow id="W4395_Flow14" sourceRef="W4395_Task7" targetRef="W4395_End8" />
    </bpmn:process>
