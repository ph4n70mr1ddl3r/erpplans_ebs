    <bpmn:process id="W_W4396" name="W4396. Parking Lot, Exterior &amp; Site-Access Customer Safety" isExecutable="false">
      <bpmn:documentation>Trigger: Daily inspection (W4393); incident; site change
Frequency: Daily + on change
Volume: 200 store + 4 DC parking/exterior sites
Owner: Store Manager / IFM (VS-138) / Loss Prevention (VS-23)
Participants: IFM (VS-138), Store Ops (VS-07), Loss Prevention (VS-23), Security (VS-138/VS-23), Customer Safety
Source: workflow W4396 — Parking Lot, Exterior &amp; Site-Access Customer Safety</bpmn:documentation>
      <bpmn:laneSet id="W4396_LaneSet3">
        <bpmn:lane id="W4396_Lane1" name="IFM">
        <bpmn:flowNodeRef>W4396_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4396_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4396_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4396_Lane2" name="Loss Prevention">
        <bpmn:flowNodeRef>W4396_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4396_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4396_Start4" name="Daily inspection (W4393); incident; site change">
        <bpmn:outgoing>W4396_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4396_Task5" name="IFM/Store inspect parking lot &amp; exterior — lighting coverage/burnouts…">
        <bpmn:documentation>Step 1: IFM/Store inspect parking lot &amp; exterior — lighting coverage/burnouts, crosswalks/striping, potholes, drainage/flood, speed bumps, signage, cart corrals, curbs/wheel-stops — and correct/escalate
Responsible (R): IFM / Store Ops / Security
Accountable (A): Store Manager / IFM Lead
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W4396_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4396_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4396_Task6" name="Loss Prevention/Security manage parking security (patrol, CCTV coverage…">
        <bpmn:documentation>Step 2: Loss Prevention/Security manage parking security (patrol, CCTV coverage, lighting-on-at-dusk, valet/courtesy if offered) and curbside/BOPIS pickup-zone safety (W4528)
Responsible (R): Loss Prevention / Security / Store Ops
Accountable (A): Store Manager / LP Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4396_Flow12</bpmn:incoming>
