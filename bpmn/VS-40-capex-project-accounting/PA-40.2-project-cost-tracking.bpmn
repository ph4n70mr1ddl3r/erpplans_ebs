        <bpmndi:BPMNEdge id="W1819_Flow14_di" bpmnElement="W1819_Flow14"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1819_Flow15_di" bpmnElement="W1819_Flow15"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1819_Flow16_di" bpmnElement="W1819_Flow16"><di:waypoint x="1210" y="335" /><di:waypoint x="1260" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1819_Assoc11_di" bpmnElement="W1819_Assoc11"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1820" name="W1820. Construction Progress Payment &amp; Contractor Billing" isExecutable="false">
      <bpmn:documentation>Trigger: Contractor submits progress billing (typically monthly)
Frequency: ~4–8 progress billings per construction project
Volume: ~40–120 progress billings/year (10–15 new stores × 4–8 billings)
Owner: COO
Participants: COO, Project Engineer, Project Accountant, Contractor
Source: workflow W1820 — Construction Progress Payment &amp; Contractor Billing</bpmn:documentation>
      <bpmn:laneSet id="W1820_LaneSet5">
        <bpmn:lane id="W1820_Lane1" name="Contractor">
        <bpmn:flowNodeRef>W1820_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1820_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1820_Lane2" name="Project Engineer">
        <bpmn:flowNodeRef>W1820_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1820_Lane3" name="COO">
        <bpmn:flowNodeRef>W1820_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1820_Lane4" name="AP">
        <bpmn:flowNodeRef>W1820_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1820_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1820_Start6" name="Contractor submits progress billing (typically monthly)">
        <bpmn:outgoing>W1820_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1820_Task7" name="Contractor submits progress billing with: (a) % completion claimed, (b) work…">
        <bpmn:documentation>Step 1: Contractor submits progress billing with: (a) % completion claimed, (b) work completed this period (description and quantities), (c) materials delivered and installed, (d) billing amount = total contract × % completion − previous billings, (e) supporting documentation: photos, delivery receipts, inspection reports
Responsible (R): Contractor
Accountable (A): COO
Duration: Monthly per project</bpmn:documentation>
        <bpmn:incoming>W1820_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1820_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1820_Task8" name="Project Engineer verifies progress claim: (a) site inspection: confirm claimed…">
        <bpmn:documentation>Step 2: Project Engineer verifies progress claim: (a) site inspection: confirm claimed work is actually completed, (b) quantity verification: measure installed items vs. claimed quantities, (c) quality check: installed work meets specifications, (d) recommends approved billing % (may be less than contractor&#x27;s claim if work incomplete or deficient)
Responsible (R): Project Engineer
Accountable (A): COO
Duration: 1–2 days/billing</bpmn:documentation>
        <bpmn:incoming>W1820_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1820_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1820_Task9" name="COO approves progress payment: (a) approved amount = contract × approved % −…">
        <bpmn:documentation>Step 3: COO approves progress payment: (a) approved amount = contract × approved % − previous payments − retention (typically 10% retention until project completion and final acceptance), (b) Project Accountant records: debit CIP, credit AP (contractor), (c) retention withheld: recorded as AP retention liability
Responsible (R): COO / Project Accountant
Accountable (A): CFO (for amounts &gt; PHP 5M)
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1820_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1820_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1820_Task10" name="AP processes payment per standard payment cycle; retention released upon: (a)…">
        <bpmn:documentation>Step 4: AP processes payment per standard payment cycle; retention released upon: (a) project completion certificate signed, (b) punch list items resolved (typically 3–6 months post-completion), (c) CFO approves retention release
Responsible (R): AP / COO
Accountable (A): CFO
Duration: Per retention schedule</bpmn:documentation>
        <bpmn:incoming>W1820_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1820_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1820_End11" name="Complete">
        <bpmn:incoming>W1820_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1820_Annotation12">
        <bpmn:text>Controls: - CTL-362 (ensure controlled execution — Project Cost Tracking &amp; Capitalization (PA-40.2).) | - operational: COO review and approval gate
Owner: COO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1820_Assoc13" sourceRef="W1820_Annotation12" targetRef="W1820_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1820_Flow14" sourceRef="W1820_Start6" targetRef="W1820_Task7" />
      <bpmn:sequenceFlow id="W1820_Flow15" sourceRef="W1820_Task7" targetRef="W1820_Task8" />
      <bpmn:sequenceFlow id="W1820_Flow16" sourceRef="W1820_Task8" targetRef="W1820_Task9" />
      <bpmn:sequenceFlow id="W1820_Flow17" sourceRef="W1820_Task9" targetRef="W1820_Task10" />
      <bpmn:sequenceFlow id="W1820_Flow18" sourceRef="W1820_Task10" targetRef="W1820_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1820_diag">
      <bpmndi:BPMNPlane id="W1820_plane" bpmnElement="W_W1820">
        <bpmndi:BPMNShape id="W1820_Lane1_di" bpmnElement="W1820_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1820_Lane2_di" bpmnElement="W1820_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1820_Lane3_di" bpmnElement="W1820_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1820_Lane4_di" bpmnElement="W1820_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1820_Task7_di" bpmnElement="W1820_Task7"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1820_Task8_di" bpmnElement="W1820_Task8"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1820_Task9_di" bpmnElement="W1820_Task9"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1820_Task10_di" bpmnElement="W1820_Task10"><dc:Bounds x="1030" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1820_Start6_di" bpmnElement="W1820_Start6"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1820_End11_di" bpmnElement="W1820_End11"><dc:Bounds x="1260" y="657" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1820_Annotation12_di" bpmnElement="W1820_Annotation12"><dc:Bounds x="160" y="800" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1820_Flow14_di" bpmnElement="W1820_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1820_Flow15_di" bpmnElement="W1820_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1820_Flow16_di" bpmnElement="W1820_Flow16"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1820_Flow17_di" bpmnElement="W1820_Flow17"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1820_Flow18_di" bpmnElement="W1820_Flow18"><di:waypoint x="1210" y="675" /><di:waypoint x="1260" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1820_Assoc13_di" bpmnElement="W1820_Assoc13"><di:waypoint x="340" y="800" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
