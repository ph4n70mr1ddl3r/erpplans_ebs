    <bpmn:process id="W_W1823" name="W1823. Project Cost Capitalization vs. Expense Determination" isExecutable="false">
      <bpmn:documentation>Trigger: Cost incurred for capex-related item; determination needed whether to capitalize or expense
Frequency: Every cost transaction (~200–500/month)
Volume: ~2,500–6,000 determinations/year
Owner: Project Accountant
Participants: Project Accountant, Accounting Manager, CFO
Source: workflow W1823 — Project Cost Capitalization vs. Expense Determination</bpmn:documentation>
      <bpmn:laneSet id="W1823_LaneSet3">
        <bpmn:lane id="W1823_Lane1" name="Project Accountant">
        <bpmn:flowNodeRef>W1823_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1823_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1823_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1823_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1823_Lane2" name="Accounting Manager">
        <bpmn:flowNodeRef>W1823_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1823_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1823_Start4" name="Cost incurred for capex-related item; determination needed whether to capitalize or…">
        <bpmn:outgoing>W1823_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1823_Task5" name="Capitalize">
        <bpmn:documentation>Step 1: Capitalization policy per PFRS/IAS 16: Capitalize (add to CIP → future fixed asset): (a) purchase price of asset (including non-recoverable taxes, delivery, installation), (b) costs directly attributable to bringing asset to working condition (site preparation, initial delivery, installation, testing), (c) professional fees directly attributable (architect, engineer, project management), (d) borrowing costs directly attributable to qualifying asset per PFRS 23 (W1824), (e) demolition/dismantling costs of old assets (if replacement project), (f) initial operating losses: NOT capitalized (expensed)
Responsible (R): Project Accountant
Accountable (A): Accounting Manager
Duration: Per transaction</bpmn:documentation>
        <bpmn:incoming>W1823_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1823_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1823_Task6" name="Expense">
        <bpmn:documentation>Step 2: Expense (charge to P&amp;L in period incurred): (a) costs below capitalization threshold (PHP 20K), (b) training costs for staff to operate new asset, (c) general administrative overhead not directly attributable, (d) operating losses in initial period (new store ramp-up losses), (e) marketing and promotional costs (grand opening), (f) relocation costs, (g) maintenance costs (vs. improvement — distinction per W1695)
Responsible (R): Project Accountant
Accountable (A): Accounting Manager
Duration: Per transaction</bpmn:documentation>
        <bpmn:incoming>W1823_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1823_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1823_Task7" name="Gray area determinations escalated to Accounting Manager: (a) software…">
        <bpmn:documentation>Step 3: Gray area determinations escalated to Accounting Manager: (a) software customization vs. license (customization = capitalize; license = intangible asset), (b) repair during construction (capitalize if part of project scope), (c) change order due to design error (capitalize — part of project cost), (d) insurance claim recovery during construction (reduce project cost)
Responsible (R): Project Accountant
Accountable (A): Accounting Manager
Duration: As needed</bpmn:documentation>
        <bpmn:incoming>W1823_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1823_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1823_Task8" name="Monthly: Accounting Manager reviews all capitalized costs for appropriateness…">
        <bpmn:documentation>Step 4: Monthly: Accounting Manager reviews all capitalized costs for appropriateness; any items incorrectly capitalized are reclassified to expense; policy guidance updated for common errors
Responsible (R): Accounting Manager
Accountable (A): CFO
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W1823_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1823_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1823_End9" name="Complete">
        <bpmn:incoming>W1823_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1823_Annotation10">
        <bpmn:text>Controls: - CTL-362 (ensure controlled execution — Project Cost Tracking &amp; Capitalization (PA-40.2).) | - operational: Project Accountant review and approval gate
Owner: Project Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1823_Assoc11" sourceRef="W1823_Annotation10" targetRef="W1823_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1823_Flow12" sourceRef="W1823_Start4" targetRef="W1823_Task5" />
      <bpmn:sequenceFlow id="W1823_Flow13" sourceRef="W1823_Task5" targetRef="W1823_Task6" />
      <bpmn:sequenceFlow id="W1823_Flow14" sourceRef="W1823_Task6" targetRef="W1823_Task7" />
      <bpmn:sequenceFlow id="W1823_Flow15" sourceRef="W1823_Task7" targetRef="W1823_Task8" />
      <bpmn:sequenceFlow id="W1823_Flow16" sourceRef="W1823_Task8" targetRef="W1823_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1823_diag">
      <bpmndi:BPMNPlane id="W1823_plane" bpmnElement="W_W1823">
        <bpmndi:BPMNShape id="W1823_Lane1_di" bpmnElement="W1823_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1823_Lane2_di" bpmnElement="W1823_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1823_Task5_di" bpmnElement="W1823_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1823_Task6_di" bpmnElement="W1823_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1823_Task7_di" bpmnElement="W1823_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1823_Task8_di" bpmnElement="W1823_Task8"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1823_Start4_di" bpmnElement="W1823_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1823_End9_di" bpmnElement="W1823_End9"><dc:Bounds x="1260" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1823_Annotation10_di" bpmnElement="W1823_Annotation10"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1823_Flow12_di" bpmnElement="W1823_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1823_Flow13_di" bpmnElement="W1823_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1823_Flow14_di" bpmnElement="W1823_Flow14"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1823_Flow15_di" bpmnElement="W1823_Flow15"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1823_Flow16_di" bpmnElement="W1823_Flow16"><di:waypoint x="1210" y="335" /><di:waypoint x="1260" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1823_Assoc11_di" bpmnElement="W1823_Assoc11"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1824" name="W1824. Capitalized Interest Calculation &amp; Recording" isExecutable="false">
      <bpmn:documentation>Trigger: Active capex project with qualifying asset financed by borrowing; monthly close
Frequency: Monthly calculation during construction period
Volume: Only for projects financed by specific borrowing (typically large new stores or DC projects &gt; PHP 50M)
Owner: Treasury
Participants: Treasury, Project Accountant, Accounting Manager
Source: workflow W1824 — Capitalized Interest Calculation &amp; Recording</bpmn:documentation>
      <bpmn:laneSet id="W1824_LaneSet2">
        <bpmn:lane id="W1824_Lane1" name="Treasury">
        <bpmn:flowNodeRef>W1824_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1824_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1824_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1824_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1824_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1824_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1824_Start3" name="Active capex project with qualifying asset financed by borrowing; monthly close">
        <bpmn:outgoing>W1824_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1824_Task4" name="Per PFRS 23 (Borrowing Costs): capitalize borrowing costs directly attributable…">
        <bpmn:documentation>Step 1: Per PFRS 23 (Borrowing Costs): capitalize borrowing costs directly attributable to acquisition, construction, or production of a qualifying asset: (a) qualifying asset: asset that takes substantial time to get ready for intended use (new store construction, DC expansion qualify), (b) capitalization period: from when expenditures and borrowing costs are incurred until asset is substantially ready for use, (c) capitalization ceases when substantially all activities necessary to prepare the asset are complete
Responsible (R): Treasury
Accountable (A): Accounting Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W1824_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1824_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1824_Task5" name="Calculation: (a) for specific borrowing: actual interest incurred on the loan…">
        <bpmn:documentation>Step 2: Calculation: (a) for specific borrowing: actual interest incurred on the loan financing the project, (b) for general borrowing: weighted average cost of outstanding borrowings × cumulative expenditures on the asset, (c) capitalization amount cannot exceed actual interest incurred, (d) calculation performed monthly
Responsible (R): Treasury
Accountable (A): CFO
Duration: 1–2 hours/project/month</bpmn:documentation>
        <bpmn:incoming>W1824_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1824_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1824_Task6" name="Journal entry: (a) debit: CIP (capitalized interest), (b) credit: interest…">
        <bpmn:documentation>Step 3: Journal entry: (a) debit: CIP (capitalized interest), (b) credit: interest expense (reduces P&amp;L interest expense), (c) capitalized interest becomes part of the asset&#x27;s cost and is depreciated over its useful life
Responsible (R): Treasury / Project Accountant
Accountable (A): Accounting Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W1824_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1824_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1824_Task7" name="Capitalization ceases when store opens (substantially ready for use); any…">
        <bpmn:documentation>Step 4: Capitalization ceases when store opens (substantially ready for use); any interest after opening is expensed
Responsible (R): Treasury
Accountable (A): Accounting Manager
Duration: At project completion</bpmn:documentation>
        <bpmn:incoming>W1824_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1824_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1824_End8" name="Complete">
        <bpmn:incoming>W1824_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1824_Annotation9">
        <bpmn:text>Controls: - CTL-362 (ensure controlled execution — Project Cost Tracking &amp; Capitalization (PA-40.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Treasury</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1824_Assoc10" sourceRef="W1824_Annotation9" targetRef="W1824_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W1824_Flow11" sourceRef="W1824_Start3" targetRef="W1824_Task4" />
      <bpmn:sequenceFlow id="W1824_Flow12" sourceRef="W1824_Task4" targetRef="W1824_Task5" />
      <bpmn:sequenceFlow id="W1824_Flow13" sourceRef="W1824_Task5" targetRef="W1824_Task6" />
      <bpmn:sequenceFlow id="W1824_Flow14" sourceRef="W1824_Task6" targetRef="W1824_Task7" />
      <bpmn:sequenceFlow id="W1824_Flow15" sourceRef="W1824_Task7" targetRef="W1824_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1824_diag">
      <bpmndi:BPMNPlane id="W1824_plane" bpmnElement="W_W1824">
        <bpmndi:BPMNShape id="W1824_Lane1_di" bpmnElement="W1824_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1824_Task4_di" bpmnElement="W1824_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1824_Task5_di" bpmnElement="W1824_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1824_Task6_di" bpmnElement="W1824_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1824_Task7_di" bpmnElement="W1824_Task7"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1824_Start3_di" bpmnElement="W1824_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1824_End8_di" bpmnElement="W1824_End8"><dc:Bounds x="1260" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1824_Annotation9_di" bpmnElement="W1824_Annotation9"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1824_Flow11_di" bpmnElement="W1824_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1824_Flow12_di" bpmnElement="W1824_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1824_Flow13_di" bpmnElement="W1824_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1824_Flow14_di" bpmnElement="W1824_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1824_Flow15_di" bpmnElement="W1824_Flow15"><di:waypoint x="1210" y="165" /><di:waypoint x="1260" y="165" /></bpmndi:BPMNEdge>
