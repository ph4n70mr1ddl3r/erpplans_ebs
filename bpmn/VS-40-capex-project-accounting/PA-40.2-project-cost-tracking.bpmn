<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-40.2-project-cost-tracking" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1819" name="W1819. Project Cost Capture &amp; Allocation" isExecutable="false">
      <bpmn:documentation>Trigger: Invoice received, goods received, or labor cost incurred for capex project
Frequency: ~200–500 cost entries/month across active projects
Volume: ~2,500–6,000 cost entries/year
Owner: Project Accountant
Participants: Project Accountant, Project Manager, AP, Department Head
Source: workflow W1819 — Project Cost Capture &amp; Allocation</bpmn:documentation>
      <bpmn:laneSet id="W1819_LaneSet3">
        <bpmn:lane id="W1819_Lane1" name="System">
        <bpmn:flowNodeRef>W1819_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1819_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1819_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1819_Lane2" name="Project Accountant">
        <bpmn:flowNodeRef>W1819_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1819_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1819_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1819_Start4" name="Invoice received, goods received, or labor cost incurred for capex project">
        <bpmn:outgoing>W1819_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1819_Task5" name="vendor invoices">
        <bpmn:documentation>Step 1: Cost capture methods: (a) vendor invoices linked to PO: AP matches invoice to PO and GR; cost auto-allocated to project, (b) internal labor: project time tracked by timesheet; labor cost allocated from payroll to project (capitalized if directly attributable), (c) internal purchases: requisitions for project materials charged to project cost center, (d) overhead allocation: project management costs, insurance, permits allocated based on policy
Responsible (R): System / Project Accountant
Accountable (A): Accounting Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W1819_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1819_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1819_Task6" name="System auto-allocates costs to project based on PO reference: (a) each PO…">
        <bpmn:documentation>Step 2: System auto-allocates costs to project based on PO reference: (a) each PO references a capex project number, (b) invoice matching against PO auto-charges cost to project CIP account, (c) costs categorized: materials, labor, equipment, services, permits, contingency, (d) running total per project updated in real-time
Responsible (R): System
Accountable (A): Project Accountant
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1819_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1819_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1819_Task7" name="Project Accountant reviews unallocated costs weekly: (a) invoices received…">
        <bpmn:documentation>Step 3: Project Accountant reviews unallocated costs weekly: (a) invoices received without project reference — identify correct project and allocate, (b) costs charged to wrong project — reclassify, (c) costs charged to operating expense that should be capitalized — journal entry to reclassify to CIP
Responsible (R): Project Accountant
Accountable (A): Accounting Manager
Duration: 2–4 hours/week</bpmn:documentation>
        <bpmn:incoming>W1819_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1819_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1819_Task8" name="Monthly: Project Accountant reconciles project CIP accounts to project budget…">
        <bpmn:documentation>Step 4: Monthly: Project Accountant reconciles project CIP accounts to project budget and actual costs; unresolved items escalated to Project Manager
Responsible (R): Project Accountant
Accountable (A): Accounting Manager
Duration: 1–2 days/month</bpmn:documentation>
        <bpmn:incoming>W1819_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1819_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1819_End9" name="Complete">
        <bpmn:incoming>W1819_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1819_Annotation10">
        <bpmn:text>Controls: - CTL-362 (ensure controlled execution — Project Cost Tracking &amp; Capitalization (PA-40.2).) | - operational: Project Accountant review and approval gate; periodic reconciliation against source documents
Owner: Project Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1819_Assoc11" sourceRef="W1819_Annotation10" targetRef="W1819_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1819_Flow12" sourceRef="W1819_Start4" targetRef="W1819_Task5" />
      <bpmn:sequenceFlow id="W1819_Flow13" sourceRef="W1819_Task5" targetRef="W1819_Task6" />
      <bpmn:sequenceFlow id="W1819_Flow14" sourceRef="W1819_Task6" targetRef="W1819_Task7" />
      <bpmn:sequenceFlow id="W1819_Flow15" sourceRef="W1819_Task7" targetRef="W1819_Task8" />
      <bpmn:sequenceFlow id="W1819_Flow16" sourceRef="W1819_Task8" targetRef="W1819_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1819_diag">
      <bpmndi:BPMNPlane id="W1819_plane" bpmnElement="W_W1819">
        <bpmndi:BPMNShape id="W1819_Lane1_di" bpmnElement="W1819_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
