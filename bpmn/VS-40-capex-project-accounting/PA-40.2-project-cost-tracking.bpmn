    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1821" name="W1821. Project Material &amp; Equipment Cost Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Materials or equipment received for capex project
Frequency: ~50–100 material receipts/month across active projects
Volume: ~600–1,200 receipts/year
Owner: Project Accountant
Participants: Project Accountant, Receiving Clerk, Project Manager
Source: workflow W1821 — Project Material &amp; Equipment Cost Tracking</bpmn:documentation>
      <bpmn:laneSet id="W1821_LaneSet4">
        <bpmn:lane id="W1821_Lane1" name="Receiving Clerk">
        <bpmn:flowNodeRef>W1821_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1821_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1821_Lane2" name="Project Accountant">
        <bpmn:flowNodeRef>W1821_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1821_Lane3" name="Project Manager">
        <bpmn:flowNodeRef>W1821_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1821_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1821_Start5" name="Materials or equipment received for capex project">
        <bpmn:outgoing>W1821_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1821_Task6" name="Materials and equipment received at project site or DC: (a) receiving clerk…">
        <bpmn:documentation>Step 1: Materials and equipment received at project site or DC: (a) receiving clerk processes GR against PO, (b) PO references capex project number, (c) system auto-charges cost to project CIP, (d) materials stored at project site or DC until needed
Responsible (R): Receiving Clerk
Accountable (A): Project Manager
Duration: Per receipt</bpmn:documentation>
        <bpmn:incoming>W1821_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1821_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1821_Task7" name="Special cost tracking for new store projects: (a) POS terminals (3 per store)…">
        <bpmn:documentation>Step 2: Special cost tracking for new store projects: (a) POS terminals (3 per store): tracked individually as future fixed assets, (b) shelving and racking: tracked as bulk material cost → allocated to component assets at turnover, (c) signage: tracked per store, (d) generator: tracked as individual asset, (e) paint, cement, electrical supplies: bulk materials tracked as construction cost → component of leasehold improvement asset
Responsible (R): Project Accountant
Accountable (A): Accounting Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W1821_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1821_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1821_Task8" name="Waste and surplus tracking: (a) unused materials at project completion…">
        <bpmn:documentation>Step 3: Waste and surplus tracking: (a) unused materials at project completion: returned to vendor for credit or transferred to next project, (b) wasted materials (damage, spoilage): documented and written off to project cost, (c) surplus inventory at store opening: transferred to store operating inventory (reclass from CIP to inventory asset)
Responsible (R): Project Manager / Project Accountant
Accountable (A): COO
Duration: At project completion</bpmn:documentation>
        <bpmn:incoming>W1821_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1821_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1821_End9" name="Complete">
        <bpmn:incoming>W1821_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1821_Annotation10">
        <bpmn:text>Controls: - CTL-210 (ensure capex authorization &amp; commitment control.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Project Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1821_Assoc11" sourceRef="W1821_Annotation10" targetRef="W1821_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1821_Flow12" sourceRef="W1821_Start5" targetRef="W1821_Task6" />
      <bpmn:sequenceFlow id="W1821_Flow13" sourceRef="W1821_Task6" targetRef="W1821_Task7" />
      <bpmn:sequenceFlow id="W1821_Flow14" sourceRef="W1821_Task7" targetRef="W1821_Task8" />
      <bpmn:sequenceFlow id="W1821_Flow15" sourceRef="W1821_Task8" targetRef="W1821_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1821_diag">
      <bpmndi:BPMNPlane id="W1821_plane" bpmnElement="W_W1821">
        <bpmndi:BPMNShape id="W1821_Lane1_di" bpmnElement="W1821_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1821_Lane2_di" bpmnElement="W1821_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1821_Lane3_di" bpmnElement="W1821_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1821_Task6_di" bpmnElement="W1821_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1821_Task7_di" bpmnElement="W1821_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1821_Task8_di" bpmnElement="W1821_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1821_Start5_di" bpmnElement="W1821_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1821_End9_di" bpmnElement="W1821_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
