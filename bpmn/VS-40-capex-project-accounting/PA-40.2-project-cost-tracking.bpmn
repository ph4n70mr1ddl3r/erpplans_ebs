      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1825" name="W1825. Project Budget vs. Actual Variance Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly management reporting
Frequency: Monthly
Volume: ~30–50 active projects
Owner: FP&amp;A
Participants: FP&amp;A, Project Manager, COO, CIO, CFO
Source: workflow W1825 — Project Budget vs. Actual Variance Reporting</bpmn:documentation>
      <bpmn:laneSet id="W1825_LaneSet3">
        <bpmn:lane id="W1825_Lane1" name="System">
        <bpmn:flowNodeRef>W1825_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1825_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1825_Lane2" name="FP&amp;A">
        <bpmn:flowNodeRef>W1825_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1825_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1825_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1825_Start4" name="Monthly management reporting">
        <bpmn:outgoing>W1825_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1825_Task5" name="System generates project-level budget vs. actual report: (a) approved budget by…">
        <bpmn:documentation>Step 1: System generates project-level budget vs. actual report: (a) approved budget by cost category, (b) committed costs (POs issued), (c) incurred costs (invoices processed), (d) paid costs (payments made), (e) remaining budget, (f) forecast to complete (Project Manager estimate), (g) forecast total cost = incurred + forecast to complete, (h) variance = forecast total − approved budget
Responsible (R): System
Accountable (A): FP&amp;A
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1825_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1825_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1825_Task6" name="FP&amp;A analyzes variances: (a) favorable (&lt; budget): identify if scope reduction…">
        <bpmn:documentation>Step 2: FP&amp;A analyzes variances: (a) favorable (&lt; budget): identify if scope reduction, value engineering, or under-delivery, (b) unfavorable (&gt; budget): identify root cause (scope increase, cost escalation, design error, contractor delay), (c) trend: is variance increasing or stable? (d) contingency utilization: how much contingency remains?
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: 1–2 days/month</bpmn:documentation>
        <bpmn:incoming>W1825_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1825_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1825_Task7" name="Project-level variance actions: (a) &lt; 5% over budget: Project Manager manages…">
        <bpmn:documentation>Step 3: Project-level variance actions: (a) &lt; 5% over budget: Project Manager manages within contingency, (b) 5–15% over budget: requires change order per W1815 and VP approval, (c) &gt; 15% over budget: requires CFO/CEO review and may require additional board approval, (d) systemic overrun pattern (multiple projects over budget): triggers process review
Responsible (R): FP&amp;A / CFO
Accountable (A): CEO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W1825_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1825_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1825_End8" name="Complete">
        <bpmn:incoming>W1825_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1825_Annotation9">
        <bpmn:text>Controls: - CTL-362 (ensure controlled execution — Project Cost Tracking &amp; Capitalization (PA-40.2).) | - operational: FP&amp;A review and approval gate
Owner: FP&amp;A</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1825_Assoc10" sourceRef="W1825_Annotation9" targetRef="W1825_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1825_Flow11" sourceRef="W1825_Start4" targetRef="W1825_Task5" />
      <bpmn:sequenceFlow id="W1825_Flow12" sourceRef="W1825_Task5" targetRef="W1825_Task6" />
      <bpmn:sequenceFlow id="W1825_Flow13" sourceRef="W1825_Task6" targetRef="W1825_Task7" />
      <bpmn:sequenceFlow id="W1825_Flow14" sourceRef="W1825_Task7" targetRef="W1825_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1825_diag">
      <bpmndi:BPMNPlane id="W1825_plane" bpmnElement="W_W1825">
        <bpmndi:BPMNShape id="W1825_Lane1_di" bpmnElement="W1825_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1825_Lane2_di" bpmnElement="W1825_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1825_Task5_di" bpmnElement="W1825_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1825_Task6_di" bpmnElement="W1825_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1825_Task7_di" bpmnElement="W1825_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1825_Start4_di" bpmnElement="W1825_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1825_End8_di" bpmnElement="W1825_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1825_Annotation9_di" bpmnElement="W1825_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1825_Flow11_di" bpmnElement="W1825_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1825_Flow12_di" bpmnElement="W1825_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1825_Flow13_di" bpmnElement="W1825_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1825_Flow14_di" bpmnElement="W1825_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1825_Assoc10_di" bpmnElement="W1825_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1826" name="W1826. Multi-Entity Project Cost Allocation" isExecutable="false">
      <bpmn:documentation>Trigger: Capex project benefits multiple entities (e.g., IT system used by all 5 entities)
Frequency: ~10–20 multi-entity allocations/year
Volume: Primarily IT and shared service projects
Owner: FP&amp;A
Participants: FP&amp;A, CFO, CIO
Source: workflow W1826 — Multi-Entity Project Cost Allocation</bpmn:documentation>
      <bpmn:laneSet id="W1826_LaneSet3">
        <bpmn:lane id="W1826_Lane1" name="FP&amp;A">
        <bpmn:flowNodeRef>W1826_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1826_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1826_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1826_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1826_Lane2" name="System">
        <bpmn:flowNodeRef>W1826_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1826_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1826_Start4" name="Capex project benefits multiple entities (e.g., IT system used by all 5 entities)">
        <bpmn:outgoing>W1826_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1826_Task5" name="Multi-entity project examples: (a) ERP system upgrade: benefits all 5 entities…">
        <bpmn:documentation>Step 1: Multi-entity project examples: (a) ERP system upgrade: benefits all 5 entities — allocated by headcount or revenue, (b) new DC (BuildRight Logistics Inc.): primarily benefits Depot Inc. (stores it serves) — allocation by store volume, (c) corporate HQ renovation: allocated to Holdings Inc., (d) ecommerce platform: primarily Digital Commerce Inc. and Depot Inc. — allocated by order volume
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: Per project</bpmn:documentation>
        <bpmn:incoming>W1826_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1826_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1826_Task6" name="Allocation methodology: (a) headcount-based: total headcount per entity (Depot…">
        <bpmn:documentation>Step 2: Allocation methodology: (a) headcount-based: total headcount per entity (Depot: 5,800 store staff + 600 DC staff; Digital Commerce: ~30; Property: ~15; Holdings/HQ: ~511 active per profile §3.3/§11.1 (the TO&#x27;s 532-role design retains the disabled—prepared Trade department — 2026-09-23 (x) — and the deferred—prepared TPS and OMO build squads — 2026-09-23 (ad)/(ah); promoted 2026-09-14; gap-filled 2026-09-18) — total ~6,911), (b) revenue-based: revenue per entity, (c) usage-based: transaction volume per entity, (d) methodology documented and approved by CFO; consistently applied
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1826_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1826_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1826_Task7" name="System posts intercompany allocations: (a) primary entity incurs cost →…">
        <bpmn:documentation>Step 3: System posts intercompany allocations: (a) primary entity incurs cost → allocates to other entities via intercompany journal entries, (b) each entity records its share as capex in its own CIP, (c) intercompany receivable/payable created for the allocation amount
Responsible (R): System / Project Accountant
Accountable (A): Accounting Manager
Duration: Monthly or at project completion</bpmn:documentation>
        <bpmn:incoming>W1826_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1826_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1826_Task8" name="Transfer pricing documentation: for intercompany cost allocations, ensure…">
        <bpmn:documentation>Step 4: Transfer pricing documentation: for intercompany cost allocations, ensure arm&#x27;s-length basis per BIR transfer pricing rules per W1731
Responsible (R): FP&amp;A / Tax Accountant
Accountable (A): CFO
Duration: At allocation</bpmn:documentation>
        <bpmn:incoming>W1826_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1826_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1826_End9" name="Complete">
        <bpmn:incoming>W1826_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1826_Annotation10">
        <bpmn:text>Controls: - CTL-362 (ensure controlled execution — Project Cost Tracking &amp; Capitalization (PA-40.2).) | - operational: FP&amp;A review and approval gate
Owner: FP&amp;A</bpmn:text>
      </bpmn:textAnnotation>
