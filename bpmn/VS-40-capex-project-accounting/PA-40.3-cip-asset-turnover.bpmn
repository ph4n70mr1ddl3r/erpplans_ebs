        <bpmndi:BPMNEdge id="W1827_Flow14_di" bpmnElement="W1827_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1827_Flow15_di" bpmnElement="W1827_Flow15"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1827_Flow16_di" bpmnElement="W1827_Flow16"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1827_Flow17_di" bpmnElement="W1827_Flow17"><di:waypoint x="1210" y="335" /><di:waypoint x="1260" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1827_Assoc12_di" bpmnElement="W1827_Assoc12"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1828" name="W1828. Project Completion Certification &amp; Asset Turnover" isExecutable="false">
      <bpmn:documentation>Trigger: Project reaches practical completion (asset ready for intended use)
Frequency: ~10–15 store completions/year + ~20–35 other capex project completions (remodels, DC, IT, equipment)
Volume: ~30–50 turnovers/year
Owner: COO (construction) / CIO (IT) / Department Head (other)
Participants: Project Manager, COO, Store Manager (for new stores), Project Accountant, Fixed Asset Accountant
Source: workflow W1828 — Project Completion Certification &amp; Asset Turnover</bpmn:documentation>
      <bpmn:laneSet id="W1828_LaneSet3">
        <bpmn:lane id="W1828_Lane1" name="Project Manager">
        <bpmn:flowNodeRef>W1828_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1828_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1828_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1828_Lane2" name="Project Accountant">
        <bpmn:flowNodeRef>W1828_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1828_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1828_Start4" name="Project reaches practical completion (asset ready for intended use)">
        <bpmn:outgoing>W1828_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1828_Task5" name="ready for its intended use">
        <bpmn:documentation>Step 1: Project Manager confirms practical completion: (a) all construction/installation work complete (punch list items may remain but are not critical to operation), (b) systems tested and operational (IT projects: UAT passed; stores: POS live), (c) safety inspection passed, (d) occupancy permit received (if required), (e) asset is ready for its intended use per PFRS — this is the trigger for depreciation start (not the grand opening date)
Responsible (R): Project Manager
Accountable (A): COO / CIO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1828_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1828_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1828_Task6" name="Completion certificate prepared and signed: (a) Project Manager certifies…">
        <bpmn:documentation>Step 2: Completion certificate prepared and signed: (a) Project Manager certifies completion, (b) COO or CIO accepts, (c) Store Manager (for new stores) confirms operational readiness, (d) punch list items documented with agreed resolution timeline, (e) custody handover: the completed assets pass to the operating custodian of record — Store Manager for new stores, the owning department head otherwise — and registration assigns the custodian per W1690 so no asset turns over unowned
Responsible (R): Project Manager / COO
Accountable (A): COO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1828_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1828_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1828_Task7" name="Project Accountant initiates CIP-to-asset turnover per W1829: (a) reviews all…">
        <bpmn:documentation>Step 3: Project Accountant initiates CIP-to-asset turnover per W1829: (a) reviews all CIP costs for completeness and accuracy, (b) ensures all invoices received and allocated, (c) accrues any known but uninvoiced costs, (d) transfers CIP balance to completed fixed assets
Responsible (R): Project Accountant
Accountable (A): Accounting Manager
Duration: 2–4 days</bpmn:documentation>
        <bpmn:incoming>W1828_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1828_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1828_End8" name="Complete">
        <bpmn:incoming>W1828_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1828_Annotation9">
        <bpmn:text>Controls: - CTL-363 (ensure controlled execution — Construction-in-Progress &amp; Asset Turnover (PA-40.3).) | - operational: COO (construction) / CIO (IT) / Department Head (other) review and approval gate
Owner: COO (construction) / CIO (IT) / Department Head (other)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1828_Assoc10" sourceRef="W1828_Annotation9" targetRef="W1828_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1828_Flow11" sourceRef="W1828_Start4" targetRef="W1828_Task5" />
      <bpmn:sequenceFlow id="W1828_Flow12" sourceRef="W1828_Task5" targetRef="W1828_Task6" />
      <bpmn:sequenceFlow id="W1828_Flow13" sourceRef="W1828_Task6" targetRef="W1828_Task7" />
      <bpmn:sequenceFlow id="W1828_Flow14" sourceRef="W1828_Task7" targetRef="W1828_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1828_diag">
      <bpmndi:BPMNPlane id="W1828_plane" bpmnElement="W_W1828">
        <bpmndi:BPMNShape id="W1828_Lane1_di" bpmnElement="W1828_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1828_Lane2_di" bpmnElement="W1828_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1828_Task5_di" bpmnElement="W1828_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1828_Task6_di" bpmnElement="W1828_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1828_Task7_di" bpmnElement="W1828_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1828_Start4_di" bpmnElement="W1828_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1828_End8_di" bpmnElement="W1828_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1828_Annotation9_di" bpmnElement="W1828_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1828_Flow11_di" bpmnElement="W1828_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1828_Flow12_di" bpmnElement="W1828_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1828_Flow13_di" bpmnElement="W1828_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1828_Flow14_di" bpmnElement="W1828_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1828_Assoc10_di" bpmnElement="W1828_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1829" name="W1829. CIP-to-Fixed Asset Conversion Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Project completion certified (W1828)
Frequency: ~30–50 conversions/year
Volume: 1 conversion per completed project (may result in multiple fixed assets)
Owner: Fixed Asset Accountant
Participants: Fixed Asset Accountant, Project Accountant, Accounting Manager
Source: workflow W1829 — CIP-to-Fixed Asset Conversion Processing</bpmn:documentation>
      <bpmn:laneSet id="W1829_LaneSet3">
        <bpmn:lane id="W1829_Lane1" name="Fixed Asset Accountant">
        <bpmn:flowNodeRef>W1829_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1829_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1829_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1829_Lane2" name="System">
        <bpmn:flowNodeRef>W1829_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1829_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1829_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1829_Start4" name="Project completion certified (W1828)">
        <bpmn:outgoing>W1829_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1829_Task5" name="new store example">
        <bpmn:documentation>Step 1: Fixed Asset Accountant decomposes project cost into component assets per W1694: (a) new store example (total cost PHP 50M): (i) leasehold improvements: PHP 20M (depreciate over lease term 10–15 years), (ii) HVAC system: PHP 5M (10–15 years), (iii) electrical installation: PHP 4M (15–20 years), (iv) plumbing: PHP 3M (15–20 years), (v) racking/shelving: PHP 5M (10 years), (vi) POS system (3 terminals): PHP 1.5M (5 years), (vii) signage: PHP 2M (7–10 years), (viii) generator: PHP 1.5M (7 years), (ix) CCTV system: PHP 1M (5 years), (x) initial inventory: PHP 5M (not fixed asset — transferred to inventory), (xi) pre-opening expenses (training, marketing): PHP 2M (not fixed asset — expensed), (xii) contingency unused: returned to capex pool
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 1–2 days/project</bpmn:documentation>
        <bpmn:incoming>W1829_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1829_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1829_Task6" name="ready-for-use date">
        <bpmn:documentation>Step 2: System processes CIP-to-asset conversion: (a) CIP account debited to zero, (b) new fixed asset records created with component structures, (c) each component assigned useful life and depreciation method per W1691, (d) depreciation begins from the ready-for-use date (completion certificate date, not grand opening date), (e) pre-opening and non-capitalizable costs reclassified from CIP to expense
Responsible (R): System
Accountable (A): Fixed Asset Accountant
Duration: 30 min/project</bpmn:documentation>
        <bpmn:incoming>W1829_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1829_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1829_Task7" name="Journal entries posted: (a) debit: fixed asset accounts (gross) per component…">
        <bpmn:documentation>Step 3: Journal entries posted: (a) debit: fixed asset accounts (gross) per component, (b) credit: CIP account (cleared to zero), (c) debit: pre-opening expense (for non-capitalized costs), (d) debit: inventory (for initial stock), (e) credit: CIP (for above reclassifications)
Responsible (R): System
Accountable (A): Accounting Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1829_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1829_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1829_Task8" name="Fixed Asset Accountant verifies new asset records: (a) total asset value = CIP…">
        <bpmn:documentation>Step 4: Fixed Asset Accountant verifies new asset records: (a) total asset value = CIP balance before conversion (no unexplained difference), (b) depreciation start date correct, (c) useful life per component is appropriate, (d) asset tags ordered per W1692
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1829_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1829_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1829_End9" name="Complete">
        <bpmn:incoming>W1829_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1829_Annotation10">
        <bpmn:text>Controls: - CTL-363 (ensure controlled execution — Construction-in-Progress &amp; Asset Turnover (PA-40.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Fixed Asset Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1829_Assoc11" sourceRef="W1829_Annotation10" targetRef="W1829_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1829_Flow12" sourceRef="W1829_Start4" targetRef="W1829_Task5" />
      <bpmn:sequenceFlow id="W1829_Flow13" sourceRef="W1829_Task5" targetRef="W1829_Task6" />
      <bpmn:sequenceFlow id="W1829_Flow14" sourceRef="W1829_Task6" targetRef="W1829_Task7" />
      <bpmn:sequenceFlow id="W1829_Flow15" sourceRef="W1829_Task7" targetRef="W1829_Task8" />
      <bpmn:sequenceFlow id="W1829_Flow16" sourceRef="W1829_Task8" targetRef="W1829_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1829_diag">
      <bpmndi:BPMNPlane id="W1829_plane" bpmnElement="W_W1829">
        <bpmndi:BPMNShape id="W1829_Lane1_di" bpmnElement="W1829_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1829_Lane2_di" bpmnElement="W1829_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1829_Task5_di" bpmnElement="W1829_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1829_Task6_di" bpmnElement="W1829_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1829_Task7_di" bpmnElement="W1829_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1829_Task8_di" bpmnElement="W1829_Task8"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1829_Start4_di" bpmnElement="W1829_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1829_End9_di" bpmnElement="W1829_End9"><dc:Bounds x="1260" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1829_Annotation10_di" bpmnElement="W1829_Annotation10"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
