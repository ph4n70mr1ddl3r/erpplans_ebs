    <bpmn:process id="W_W2751" name="W2751. Project Closeout Documentation &amp; Archiving" isExecutable="false">
      <bpmn:documentation>Trigger: Project completed and asset turned over (W1828–1829) or abandoned (W2750)
Frequency: ~30–50 closeouts/year
Volume: 1 closeout package per project
Owner: Project Manager
Participants: Project Manager, Project Accountant, COO, FP&amp;A
Source: workflow W2751 — Project Closeout Documentation &amp; Archiving</bpmn:documentation>
      <bpmn:laneSet id="W2751_LaneSet3">
        <bpmn:lane id="W2751_Lane1" name="Project Manager">
        <bpmn:flowNodeRef>W2751_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2751_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2751_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2751_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2751_Lane2" name="System">
        <bpmn:flowNodeRef>W2751_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2751_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2751_Start4" name="Project completed and asset turned over (W1828–1829) or abandoned (W2750)">
        <bpmn:outgoing>W2751_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2751_Task5" name="Project closeout checklist: (a) all costs received and allocated to project…">
        <bpmn:documentation>Step 1: Project closeout checklist: (a) all costs received and allocated to project, (b) all POs closed (no open commitments), (c) all vendor invoices received and paid (including retention release if applicable), (d) CIP account cleared (zero balance after turnover), (e) fixed assets registered per W1690, (f) asset tags applied per W1692, (g) project completion certificate signed, (h) post-implementation review scheduled per W2748
Responsible (R): Project Manager / Project Accountant
Accountable (A): COO / CIO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2751_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2751_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2751_Task6" name="Documentation archive: (a) original capex request and business case, (b)…">
        <bpmn:documentation>Step 2: Documentation archive: (a) original capex request and business case, (b) financial evaluation and approval documentation, (c) all vendor contracts and POs, (d) contractor progress billings and payment records, (e) change orders with approvals, (f) completion certificate and turnover documentation, (g) warranty certificates from contractors and equipment vendors, (h) as-built drawings (for construction projects), (i) post-implementation review, (j) budget vs. actual final report
Responsible (R): Project Manager
Accountable (A): COO / CIO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2751_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2751_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2751_Task7" name="Archive retention: (a) project documentation retained for asset useful life +…">
        <bpmn:documentation>Step 3: Archive retention: (a) project documentation retained for asset useful life + 10 years (for tax and audit purposes), (b) stored in document management system (electronic) and physical archive (for signed originals), (c) indexed by project number for retrieval
Responsible (R): Project Manager / Project Accountant
Accountable (A): Accounting Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2751_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2751_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2751_Task8" name="System project status changed to &quot;Closed&quot;; no further costs can be charged to…">
        <bpmn:documentation>Step 4: System project status changed to &quot;Closed&quot;; no further costs can be charged to the project
Responsible (R): System
Accountable (A): Project Accountant
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2751_Flow15</bpmn:incoming>
        <bpmn:outgoing>W2751_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2751_End9" name="Complete">
        <bpmn:incoming>W2751_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2751_Annotation10">
        <bpmn:text>Controls: - CTL-363 (ensure controlled execution — Construction-in-Progress &amp; Asset Turnover (PA-40.3).) | - operational: Project Manager review and approval gate
Owner: Project Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2751_Assoc11" sourceRef="W2751_Annotation10" targetRef="W2751_Start4" associationDirection="None" />
