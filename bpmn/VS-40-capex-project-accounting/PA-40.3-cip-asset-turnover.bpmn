    <bpmn:process id="W_W2748" name="W2748. Post-Implementation Review &amp; Actual vs. Projected ROI Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: 12 months after project completion
Frequency: ~30–50 post-implementation reviews/year (one per completed project, per W1828)
Volume: 1 review per completed project
Owner: FP&amp;A
Participants: FP&amp;A, Project Sponsor, Department Head, CFO
Source: workflow W2748 — Post-Implementation Review &amp; Actual vs. Projected ROI Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2748_LaneSet2">
        <bpmn:lane id="W2748_Lane1" name="FP&amp;A">
        <bpmn:flowNodeRef>W2748_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2748_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2748_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2748_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2748_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2748_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2748_Start3" name="12 months after project completion">
        <bpmn:outgoing>W2748_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2748_Task4" name="cost">
        <bpmn:documentation>Step 1: FP&amp;A compares actual project outcomes to original business case: (a) cost: actual total cost vs. approved budget (typically actual is 5–15% over budget for construction projects), (b) timeline: actual completion date vs. planned (typically 1–3 months delayed), (c) revenue: for new stores — actual Year 1 revenue vs. projected revenue per W1652, (d) profitability: store EBITDA margin vs. projected, (e) payback: actual payback trajectory vs. projected payback period, (f) IRR/NPV: recalculate with actual cash flows
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: 1–2 days/project</bpmn:documentation>
        <bpmn:incoming>W2748_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2748_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2748_Task5" name="For non-revenue projects (IT, equipment replacement): (a) cost savings achieved…">
        <bpmn:documentation>Step 2: For non-revenue projects (IT, equipment replacement): (a) cost savings achieved vs. projected, (b) operational improvements measured vs. baseline, (c) user satisfaction survey, (d) compliance achieved (if regulatory project)
Responsible (R): FP&amp;A
Accountable (A): Department Head
Duration: 1 day/project</bpmn:documentation>
        <bpmn:incoming>W2748_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2748_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2748_Task6" name="FP&amp;A prepares post-implementation review report: (a) summary of actual vs…">
        <bpmn:documentation>Step 3: FP&amp;A prepares post-implementation review report: (a) summary of actual vs. projected, (b) key learnings (what went well, what didn&#x27;t), (c) calibration: how accurate were original projections? (d) recommendations for future similar projects, (e) presented to steering committee or CFO
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2748_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2748_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2748_Task7" name="Annual: FP&amp;A compiles post-implementation results across all completed…">
        <bpmn:documentation>Step 4: Annual: FP&amp;A compiles post-implementation results across all completed projects; identifies systematic biases in project estimation (e.g., consistently overestimating revenue, underestimating costs); adjusts estimation methodology for future business cases
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: 1 day/year</bpmn:documentation>
        <bpmn:incoming>W2748_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2748_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2748_End8" name="Complete">
        <bpmn:incoming>W2748_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2748_Annotation9">
        <bpmn:text>Controls: - CTL-363 (ensure controlled execution — Construction-in-Progress &amp; Asset Turnover (PA-40.3).) | - operational: FP&amp;A review and approval gate
Owner: FP&amp;A</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2748_Assoc10" sourceRef="W2748_Annotation9" targetRef="W2748_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2748_Flow11" sourceRef="W2748_Start3" targetRef="W2748_Task4" />
      <bpmn:sequenceFlow id="W2748_Flow12" sourceRef="W2748_Task4" targetRef="W2748_Task5" />
      <bpmn:sequenceFlow id="W2748_Flow13" sourceRef="W2748_Task5" targetRef="W2748_Task6" />
      <bpmn:sequenceFlow id="W2748_Flow14" sourceRef="W2748_Task6" targetRef="W2748_Task7" />
      <bpmn:sequenceFlow id="W2748_Flow15" sourceRef="W2748_Task7" targetRef="W2748_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2748_diag">
      <bpmndi:BPMNPlane id="W2748_plane" bpmnElement="W_W2748">
        <bpmndi:BPMNShape id="W2748_Lane1_di" bpmnElement="W2748_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2748_Task4_di" bpmnElement="W2748_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2748_Task5_di" bpmnElement="W2748_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2748_Task6_di" bpmnElement="W2748_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2748_Task7_di" bpmnElement="W2748_Task7"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2748_Start3_di" bpmnElement="W2748_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2748_End8_di" bpmnElement="W2748_End8"><dc:Bounds x="1260" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2748_Annotation9_di" bpmnElement="W2748_Annotation9"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2748_Flow11_di" bpmnElement="W2748_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2748_Flow12_di" bpmnElement="W2748_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2748_Flow13_di" bpmnElement="W2748_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2748_Flow14_di" bpmnElement="W2748_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2748_Flow15_di" bpmnElement="W2748_Flow15"><di:waypoint x="1210" y="165" /><di:waypoint x="1260" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2748_Assoc10_di" bpmnElement="W2748_Assoc10"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2749" name="W2749. Partial Asset Turnover (Phased Project Completion)" isExecutable="false">
      <bpmn:documentation>Trigger: Part of a large project is ready for use before the entire project is complete
Frequency: ~5–10 partial turnovers/year (primarily multi-store builds, DC expansions)
Volume: Occasional — depends on project phasing
Owner: Fixed Asset Accountant
Participants: Fixed Asset Accountant, Project Manager, Accounting Manager
Source: workflow W2749 — Partial Asset Turnover (Phased Project Completion)</bpmn:documentation>
      <bpmn:laneSet id="W2749_LaneSet4">
        <bpmn:lane id="W2749_Lane1" name="Project Manager">
        <bpmn:flowNodeRef>W2749_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2749_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2749_Lane2" name="Fixed Asset Accountant">
        <bpmn:flowNodeRef>W2749_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2749_Lane3" name="System">
        <bpmn:flowNodeRef>W2749_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2749_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2749_Start5" name="Part of a large project is ready for use before the entire project is complete">
        <bpmn:outgoing>W2749_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2749_Task6" name="Scenarios requiring partial turnover: (a) DC expansion: new wing operational…">
        <bpmn:documentation>Step 1: Scenarios requiring partial turnover: (a) DC expansion: new wing operational while second wing still under construction, (b) multi-store build: first 3 stores of a 5-store batch open before remaining 2, (c) IT rollout: phase 1 modules live while phase 2 still in development
Responsible (R): Project Manager
Accountable (A): Department Head
Duration: Event-driven</bpmn:documentation>
        <bpmn:incoming>W2749_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2749_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2749_Task7" name="Fixed Asset Accountant allocates CIP costs between completed and in-progress…">
        <bpmn:documentation>Step 2: Fixed Asset Accountant allocates CIP costs between completed and in-progress portions: (a) completed portion: identify specific costs attributable to the ready-for-use portion, (b) in-progress portion: remaining costs stay in CIP, (c) apportionment methodology: direct identification where possible; proportional allocation for shared costs (e.g., project management, permits)
Responsible (R): Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2749_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2749_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2749_Task8" name="System processes partial turnover: (a) completed portion transferred from CIP…">
        <bpmn:documentation>Step 3: System processes partial turnover: (a) completed portion transferred from CIP to fixed assets, (b) depreciation begins on completed portion, (c) remaining CIP continues to accumulate costs until next phase completes, (d) subsequent turnovers processed same way until project fully complete
Responsible (R): System
Accountable (A): Fixed Asset Accountant
Duration: Per phase</bpmn:documentation>
        <bpmn:incoming>W2749_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2749_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2749_End9" name="Complete">
        <bpmn:incoming>W2749_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2749_Annotation10">
        <bpmn:text>Controls: - CTL-210 (ensure capex authorization &amp; commitment control.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Fixed Asset Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2749_Assoc11" sourceRef="W2749_Annotation10" targetRef="W2749_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2749_Flow12" sourceRef="W2749_Start5" targetRef="W2749_Task6" />
      <bpmn:sequenceFlow id="W2749_Flow13" sourceRef="W2749_Task6" targetRef="W2749_Task7" />
      <bpmn:sequenceFlow id="W2749_Flow14" sourceRef="W2749_Task7" targetRef="W2749_Task8" />
      <bpmn:sequenceFlow id="W2749_Flow15" sourceRef="W2749_Task8" targetRef="W2749_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2749_diag">
      <bpmndi:BPMNPlane id="W2749_plane" bpmnElement="W_W2749">
        <bpmndi:BPMNShape id="W2749_Lane1_di" bpmnElement="W2749_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2749_Lane2_di" bpmnElement="W2749_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2749_Lane3_di" bpmnElement="W2749_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2749_Task6_di" bpmnElement="W2749_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2749_Task7_di" bpmnElement="W2749_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2749_Task8_di" bpmnElement="W2749_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2749_Start5_di" bpmnElement="W2749_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2749_End9_di" bpmnElement="W2749_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2749_Annotation10_di" bpmnElement="W2749_Annotation10"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2749_Flow12_di" bpmnElement="W2749_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2749_Flow13_di" bpmnElement="W2749_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2749_Flow14_di" bpmnElement="W2749_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2749_Flow15_di" bpmnElement="W2749_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2749_Assoc11_di" bpmnElement="W2749_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2750" name="W2750. Abandoned Project Write-Off &amp; Cost Recovery" isExecutable="false">
      <bpmn:documentation>Trigger: Decision to abandon or indefinitely suspend a capex project
Frequency: ~1–3 abandoned projects/year (low frequency but high impact)
Volume: Low
Owner: CFO
Participants: CFO, FP&amp;A, Project Manager, CEO, Board
Source: workflow W2750 — Abandoned Project Write-Off &amp; Cost Recovery</bpmn:documentation>
      <bpmn:laneSet id="W2750_LaneSet6">
        <bpmn:lane id="W2750_Lane1" name="Project Manager">
        <bpmn:flowNodeRef>W2750_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2750_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2750_Lane2" name="CFO">
        <bpmn:flowNodeRef>W2750_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2750_Lane3" name="Approver per tier">
        <bpmn:flowNodeRef>W2750_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2750_Lane4" name="Project Accountant">
        <bpmn:flowNodeRef>W2750_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2750_Lane5" name="COO">
        <bpmn:flowNodeRef>W2750_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2750_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2750_Start7" name="Decision to abandon or indefinitely suspend a capex project">
        <bpmn:outgoing>W2750_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2750_Task8" name="Triggers for project abandonment: (a) site issues discovered during…">
        <bpmn:documentation>Step 1: Triggers for project abandonment: (a) site issues discovered during construction (soil, legal, environmental), (b) market conditions change (trade area no longer viable — competitor opens nearby, economic downturn), (c) regulatory block (permit denied, zoning change), (d) strategic pivot (company changes expansion plan), (e) contractor failure (contractor abandons project)
Responsible (R): Project Manager / COO
Accountable (A): CEO
Duration: Event-driven</bpmn:documentation>
        <bpmn:incoming>W2750_Flow16</bpmn:incoming>
        <bpmn:outgoing>W2750_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2750_Task9" name="CFO and FP&amp;A assess financial impact: (a) total CIP costs incurred to date, (b)…">
        <bpmn:documentation>Step 2: CFO and FP&amp;A assess financial impact: (a) total CIP costs incurred to date, (b) recovery potential: (i) materials salvageable and reusable (transfer to other projects), (ii) equipment already purchased (sell, return to vendor, or redeploy), (iii) contractor claims and counterclaims, (iv) insurance recovery (if applicable), (c) net write-off amount = CIP costs − recoveries
Responsible (R): CFO / FP&amp;A
Accountable (A): CEO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2750_Flow17</bpmn:incoming>
        <bpmn:outgoing>W2750_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2750_Task10" name="Write-off approval: (a) &lt; PHP 5M: CFO approval, (b) PHP 5–50M: CEO approval…">
        <bpmn:documentation>Step 3: Write-off approval: (a) &lt; PHP 5M: CFO approval, (b) PHP 5–50M: CEO approval, (c) &gt; PHP 50M: Board approval, (d) write-off recognized as non-current asset disposal loss (not inventory write-off)
Responsible (R): Approver per tier
Accountable (A): Board (if material)
Duration: 1–5 days</bpmn:documentation>
        <bpmn:incoming>W2750_Flow18</bpmn:incoming>
        <bpmn:outgoing>W2750_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2750_Task11" name="Write-off processing: (a) CIP balance written off to P&amp;L (debit: project…">
        <bpmn:documentation>Step 4: Write-off processing: (a) CIP balance written off to P&amp;L (debit: project abandonment loss, credit: CIP), (b) recoverable amounts recorded as receivable, (c) when recovery received: credit to project abandonment loss (partial offset), (d) Board notified at next meeting regardless of amount
Responsible (R): Project Accountant / Fixed Asset Accountant
Accountable (A): Accounting Manager
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2750_Flow19</bpmn:incoming>
        <bpmn:outgoing>W2750_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2750_Task12" name="Lessons learned documented per W2751; preventive measures implemented to reduce…">
        <bpmn:documentation>Step 5: Lessons learned documented per W2751; preventive measures implemented to reduce future abandonment risk
Responsible (R): COO / CIO
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2750_Flow20</bpmn:incoming>
        <bpmn:outgoing>W2750_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2750_End13" name="Complete">
        <bpmn:incoming>W2750_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2750_Annotation14">
        <bpmn:text>Controls: - CTL-363 (ensure controlled execution — Construction-in-Progress &amp; Asset Turnover (PA-40.3).) | - operational: CFO review and approval gate
Owner: CFO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2750_Assoc15" sourceRef="W2750_Annotation14" targetRef="W2750_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W2750_Flow16" sourceRef="W2750_Start7" targetRef="W2750_Task8" />
      <bpmn:sequenceFlow id="W2750_Flow17" sourceRef="W2750_Task8" targetRef="W2750_Task9" />
      <bpmn:sequenceFlow id="W2750_Flow18" sourceRef="W2750_Task9" targetRef="W2750_Task10" />
      <bpmn:sequenceFlow id="W2750_Flow19" sourceRef="W2750_Task10" targetRef="W2750_Task11" />
      <bpmn:sequenceFlow id="W2750_Flow20" sourceRef="W2750_Task11" targetRef="W2750_Task12" />
      <bpmn:sequenceFlow id="W2750_Flow21" sourceRef="W2750_Task12" targetRef="W2750_End13" />
    </bpmn:process>
