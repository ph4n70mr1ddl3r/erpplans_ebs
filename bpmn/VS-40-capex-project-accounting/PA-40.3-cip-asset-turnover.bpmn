<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-40.3-cip-asset-turnover" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1827" name="W1827. Construction-in-Progress (CIP) Account Management" isExecutable="false">
      <bpmn:documentation>Trigger: First cost incurred on approved capex project
Frequency: Continuous for active projects
Volume: ~30–50 active CIP accounts at any time (one per active capex project, per the PA-40.1 ~30–50-project register)
Owner: Project Accountant
Participants: Project Accountant, Accounting Manager, FP&amp;A
Source: workflow W1827 — Construction-in-Progress (CIP) Account Management</bpmn:documentation>
      <bpmn:laneSet id="W1827_LaneSet4">
        <bpmn:lane id="W1827_Lane1" name="System">
        <bpmn:flowNodeRef>W1827_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1827_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1827_Lane2" name="Project Accountant">
        <bpmn:flowNodeRef>W1827_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1827_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1827_Lane3" name="Accounting Manager">
        <bpmn:flowNodeRef>W1827_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1827_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1827_Start5" name="First cost incurred on approved capex project">
        <bpmn:outgoing>W1827_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1827_Task6" name="CIP account structure in GL: (a) one CIP account per active capex project…">
        <bpmn:documentation>Step 1: CIP account structure in GL: (a) one CIP account per active capex project (e.g., CIP-BRD-001 Mindanao Store, CIP-IT-ERP-Upgrade), (b) sub-accounts by cost category: materials, labor, services, equipment, professional fees, capitalized interest, (c) entity-specific: each entity&#x27;s CIP tracked separately, (d) group-level CIP visible for consolidation
Responsible (R): System
Accountable (A): Accounting Manager
Duration: Per project creation</bpmn:documentation>
        <bpmn:incoming>W1827_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1827_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1827_Task7" name="Monthly CIP management: (a) all project costs accumulated in CIP (not…">
        <bpmn:documentation>Step 2: Monthly CIP management: (a) all project costs accumulated in CIP (not depreciated — CIP assets are not yet in use), (b) monthly review per W1705 (CIP reconciliation), (c) CIP aging report: flag projects in CIP &gt; 12 months (risk of stalled or abandoned projects), (d) CIP balance should increase as project progresses and decrease to zero when asset is turned over
Responsible (R): Project Accountant
Accountable (A): Accounting Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W1827_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1827_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1827_Task8" name="CIP balance sheet presentation: (a) CIP classified as non-current asset (part…">
        <bpmn:documentation>Step 3: CIP balance sheet presentation: (a) CIP classified as non-current asset (part of Property, Plant &amp; Equipment) in balance sheet, (b) separate line item or combined with fixed assets (materiality-dependent), (c) CIP balance = total costs incurred but not yet capitalized as completed assets
Responsible (R): Accounting Manager
Accountable (A): CFO
Duration: At reporting date</bpmn:documentation>
        <bpmn:incoming>W1827_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1827_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1827_Task9" name="Impairment of CIP: if project is stalled or abandoned, CIP must be assessed for…">
        <bpmn:documentation>Step 4: Impairment of CIP: if project is stalled or abandoned, CIP must be assessed for impairment per PAS 36 (same as W1700 for completed assets); abandoned projects written off per W2750
Responsible (R): Project Accountant
Accountable (A): Accounting Manager
Duration: If triggered</bpmn:documentation>
        <bpmn:incoming>W1827_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1827_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1827_End10" name="Complete">
        <bpmn:incoming>W1827_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1827_Annotation11">
        <bpmn:text>Controls: - CTL-363 (ensure controlled execution — Construction-in-Progress &amp; Asset Turnover (PA-40.3).) | - operational: Project Accountant review and approval gate; periodic reconciliation against source documents
Owner: Project Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1827_Assoc12" sourceRef="W1827_Annotation11" targetRef="W1827_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1827_Flow13" sourceRef="W1827_Start5" targetRef="W1827_Task6" />
      <bpmn:sequenceFlow id="W1827_Flow14" sourceRef="W1827_Task6" targetRef="W1827_Task7" />
      <bpmn:sequenceFlow id="W1827_Flow15" sourceRef="W1827_Task7" targetRef="W1827_Task8" />
      <bpmn:sequenceFlow id="W1827_Flow16" sourceRef="W1827_Task8" targetRef="W1827_Task9" />
      <bpmn:sequenceFlow id="W1827_Flow17" sourceRef="W1827_Task9" targetRef="W1827_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1827_diag">
      <bpmndi:BPMNPlane id="W1827_plane" bpmnElement="W_W1827">
        <bpmndi:BPMNShape id="W1827_Lane1_di" bpmnElement="W1827_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
