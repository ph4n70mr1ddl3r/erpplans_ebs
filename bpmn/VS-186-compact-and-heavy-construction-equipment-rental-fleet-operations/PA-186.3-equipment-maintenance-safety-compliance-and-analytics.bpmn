      <bpmn:userTask id="W5342_Task6" name="Compute utilization (rented-hours ÷ available-hours) and idle-time by class…">
        <bpmn:documentation>Step 1: Compute utilization (rented-hours ÷ available-hours) and idle-time by class, hub, and region from telematics.
Responsible (R): Rental Fleet Manager
Accountable (A): Rental Fleet Manager
Duration: 3 hours</bpmn:documentation>
        <bpmn:incoming>W5342_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5342_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5342_Task7" name="Compute realized rate vs. rate card (W5325) and yield (revenue ÷ capex) per…">
        <bpmn:documentation>Step 2: Compute realized rate vs. rate card (W5325) and yield (revenue ÷ capex) per class.
Responsible (R): Finance Business Partner
Accountable (A): COO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W5342_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5342_Flow16</bpmn:outgoing>
