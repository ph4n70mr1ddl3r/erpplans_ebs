    <bpmn:process id="W_W5337" name="W5337. Heavy Equipment Preventive Maintenance Schedule, Service Bay &amp; Mechanic Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Telematics hour-meter threshold (W5324); calendar PM; return inspection flagged (W5334)
Frequency: ~1 PM per unit per ~250 operating hours; ~1,500–2,500 PM events/yr
Volume: 1 work-order per PM event
Owner: Rental Fleet Mechanic Lead
Participants: Mechanics, Parts Clerk, OEM Service Partner
Source: workflow W5337 — Heavy Equipment Preventive Maintenance Schedule, Service Bay &amp; Mechanic Operations</bpmn:documentation>
      <bpmn:laneSet id="W5337_LaneSet4">
        <bpmn:lane id="W5337_Lane1" name="Rental Fleet Mechanic Lead">
        <bpmn:flowNodeRef>W5337_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5337_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5337_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5337_Lane2" name="Mechanic">
        <bpmn:flowNodeRef>W5337_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5337_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5337_Lane3" name="Parts Clerk">
        <bpmn:flowNodeRef>W5337_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5337_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5337_Start5" name="Telematics hour-meter threshold (W5324); calendar PM; return inspection flagged (W5334)">
        <bpmn:outgoing>W5337_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5337_Task6" name="Auto-generate PM work-order from the hour-meter threshold; pull the unit from…">
        <bpmn:documentation>Step 1: Auto-generate PM work-order from the hour-meter threshold; pull the unit from availability.
Responsible (R): Rental Fleet Mechanic Lead
Accountable (A): Rental Fleet Mechanic Lead
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W5337_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5337_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5337_Task7" name="Execute class-specific PM (engine oil, hydraulics, filters, tracks/tires…">
        <bpmn:documentation>Step 2: Execute class-specific PM (engine oil, hydraulics, filters, tracks/tires, safety devices, electrics) in the service bay.
Responsible (R): Mechanic
Accountable (A): Rental Fleet Mechanic Lead
Duration: 2–6 hours</bpmn:documentation>
        <bpmn:incoming>W5337_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5337_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5337_Task8" name="Replace wear parts from the on-hand kit (W5322); raise parts-replenishment if…">
        <bpmn:documentation>Step 3: Replace wear parts from the on-hand kit (W5322); raise parts-replenishment if below min.
Responsible (R): Parts Clerk
Accountable (A): Rental Fleet Mechanic Lead
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W5337_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5337_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5337_Task9" name="Record PM completion, hour-meter-in, parts used, and mechanic hours in the…">
        <bpmn:documentation>Step 4: Record PM completion, hour-meter-in, parts used, and mechanic hours in the asset history.
Responsible (R): Mechanic
Accountable (A): Rental Fleet Mechanic Lead
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W5337_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5337_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5337_Task10" name="Return unit to Available; notify any waitlist (VS-12.2 W1318).">
        <bpmn:documentation>Step 5: Return unit to Available; notify any waitlist (VS-12.2 W1318).
Responsible (R): Rental Fleet Mechanic Lead
Accountable (A): Rental Fleet Mechanic Lead
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W5337_Flow18</bpmn:incoming>
        <bpmn:outgoing>W5337_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5337_End11" name="Complete">
        <bpmn:incoming>W5337_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5337_Annotation12">
        <bpmn:text>Controls: - CTL-104: rental-fleet PM &amp; availability integrity; operational: no-unit-to-Available-without-PM-close.
Owner: Rental Fleet Mechanic Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5337_Assoc13" sourceRef="W5337_Annotation12" targetRef="W5337_Start5" associationDirection="None" />
