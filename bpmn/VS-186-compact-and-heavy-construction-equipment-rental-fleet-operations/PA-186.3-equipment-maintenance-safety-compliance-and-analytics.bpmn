    <bpmn:process id="W_W5341" name="W5341. Equipment Rental Accident, Injury &amp; Third-Party Damage Incident Management" isExecutable="false">
      <bpmn:documentation>Trigger: Accident/injury/third-party damage involving rented equipment (at jobsite or in transit)
Frequency: Rare (~0.5–2% of rentals); high severity
Volume: ~30–100 incidents/yr
Owner: HSE Officer
Participants: Rental Fleet Manager, Legal (VS-100), Insurance (VS-26), Corporate Security (VS-159), Customer, Police
Source: workflow W5341 — Equipment Rental Accident, Injury &amp; Third-Party Damage Incident Management</bpmn:documentation>
      <bpmn:laneSet id="W5341_LaneSet4">
