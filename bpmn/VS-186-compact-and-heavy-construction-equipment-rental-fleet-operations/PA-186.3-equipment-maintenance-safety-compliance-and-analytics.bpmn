      <bpmn:startEvent id="W5341_Start5" name="Accident/injury/third-party damage involving rented equipment (at jobsite or in transit)">
        <bpmn:outgoing>W5341_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5341_Task6" name="Secure the scene and ensure medical aid; preserve the unit and evidence (DOLE…">
        <bpmn:documentation>Step 1: Secure the scene and ensure medical aid; preserve the unit and evidence (DOLE reportable threshold).
Responsible (R): HSE Officer
Accountable (A): HSE Officer
Duration: immediate</bpmn:documentation>
        <bpmn:incoming>W5341_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5341_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5341_Task7" name="Capture incident facts: telematics (W5332), logbook (W5340), operator…">
        <bpmn:documentation>Step 2: Capture incident facts: telematics (W5332), logbook (W5340), operator competency record (W5326), and witness statements.
Responsible (R): HSE Officer
Accountable (A): HSE Officer
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W5341_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5341_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5341_Task8" name="Notify insurance/captive within the policy notice window (W5327/VS-26); file…">
        <bpmn:documentation>Step 3: Notify insurance/captive within the policy notice window (W5327/VS-26); file DOLE reportable if applicable (VS-24).
Responsible (R): Risk &amp; Insurance Manager
Accountable (A): HSE Officer
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W5341_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5341_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5341_Task9" name="Coordinate legal defense and third-party claim handling (VS-100/VS-26); engage…">
        <bpmn:documentation>Step 4: Coordinate legal defense and third-party claim handling (VS-100/VS-26); engage Corporate Security for fraud/foul-play (VS-159).
Responsible (R): Legal Counsel
Accountable (A): HSE Officer
Duration: varies</bpmn:documentation>
        <bpmn:incoming>W5341_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5341_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5341_Task10" name="Root-cause analysis; corrective action to fleet/PM/training (W5337/W5326)…">
        <bpmn:documentation>Step 5: Root-cause analysis; corrective action to fleet/PM/training (W5337/W5326); capture lessons-learned (VS-133).
Responsible (R): HSE Officer
Accountable (A): HSE Officer
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5341_Flow18</bpmn:incoming>
        <bpmn:outgoing>W5341_Flow19</bpmn:outgoing>
      </bpmn:userTask>
