        <bpmn:outgoing>W5344_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5344_Task6" name="Map demand vs. fleet by hub/region and season (rainy-season dewatering pumps…">
