Responsible (R): Rental Fleet Manager
Accountable (A): Rental Fleet Manager
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5344_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5344_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5344_Task7" name="Identify rebalancing moves from low- to high-demand hubs using utilization…">
