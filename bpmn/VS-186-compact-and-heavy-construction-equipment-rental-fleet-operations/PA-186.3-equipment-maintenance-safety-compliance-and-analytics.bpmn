Responsible (R): Supply Planner
Accountable (A): Rental Fleet Manager
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W5344_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5344_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5344_Task8" name="Execute inter-DC/store transfers via logistics (W5331/VS-06) with in-transit…">
