    <bpmn:process id="W_W5338" name="W5338. Equipment Breakdown, Field Service Dispatch &amp; Substitute Unit Provisioning" isExecutable="false">
      <bpmn:documentation>Trigger: In-rental breakdown reported by customer or telematics fault code
Frequency: ~1–3% of rentals
Volume: ~50–150 breakdowns/yr
Owner: Rental Fleet Mechanic Lead
Participants: Field Service Tech/OEM, Logistics Dispatcher, Customer, Credit/Billing
Source: workflow W5338 — Equipment Breakdown, Field Service Dispatch &amp; Substitute Unit Provisioning</bpmn:documentation>
      <bpmn:laneSet id="W5338_LaneSet5">
        <bpmn:lane id="W5338_Lane1" name="Rental Fleet Mechanic Lead">
        <bpmn:flowNodeRef>W5338_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5338_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5338_Lane2" name="Logistics Dispatcher">
        <bpmn:flowNodeRef>W5338_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5338_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5338_Lane3" name="Mechanic">
        <bpmn:flowNodeRef>W5338_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5338_Lane4" name="Credit">
        <bpmn:flowNodeRef>W5338_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5338_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5338_Start6" name="In-rental breakdown reported by customer or telematics fault code">
        <bpmn:outgoing>W5338_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5338_Task7" name="Triage the reported fault (telematics code + customer description); decide…">
        <bpmn:documentation>Step 1: Triage the reported fault (telematics code + customer description); decide field-repair vs. swap-out.
Responsible (R): Rental Fleet Mechanic Lead
Accountable (A): Rental Fleet Mechanic Lead
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W5338_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5338_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5338_Task8" name="Dispatch a field service tech or OEM partner to the jobsite (links VS-12/VS-06…">
        <bpmn:documentation>Step 2: Dispatch a field service tech or OEM partner to the jobsite (links VS-12/VS-06 dispatch).
Responsible (R): Logistics Dispatcher
Accountable (A): Rental Fleet Mechanic Lead
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5338_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5338_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5338_Task9" name="If swap-out: source a substitute unit, deliver (W5331), and hand over (W5330)…">
        <bpmn:documentation>Step 3: If swap-out: source a substitute unit, deliver (W5331), and hand over (W5330) to keep the customer&#x27;s job running (VS-12.2 W1374 pattern).
Responsible (R): Logistics Dispatcher
Accountable (A): Rental Fleet Mechanic Lead
Duration: 0.5–1 day</bpmn:documentation>
        <bpmn:incoming>W5338_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5338_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5338_Task10" name="Recover the broken unit to the bay; diagnose, repair, and route to PM (W5337).">
        <bpmn:documentation>Step 4: Recover the broken unit to the bay; diagnose, repair, and route to PM (W5337).
Responsible (R): Mechanic
Accountable (A): Rental Fleet Mechanic Lead
Duration: varies</bpmn:documentation>
        <bpmn:incoming>W5338_Flow18</bpmn:incoming>
        <bpmn:outgoing>W5338_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5338_Task11" name="Adjust billing (no-charge for downtime), and capture root-cause for…">
        <bpmn:documentation>Step 5: Adjust billing (no-charge for downtime), and capture root-cause for fleet-quality feedback to procurement (W5322).
Responsible (R): Credit/Billing
Accountable (A): Rental Fleet Mechanic Lead
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W5338_Flow19</bpmn:incoming>
        <bpmn:outgoing>W5338_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5338_End12" name="Complete">
        <bpmn:incoming>W5338_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5338_Annotation13">
        <bpmn:text>Controls: - CTL-104: breakdown-repair accountability &amp; substitute-unit recovery; operational: downtime no-charge rule for non-customer-caused failures.
Owner: Rental Fleet Mechanic Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5338_Assoc14" sourceRef="W5338_Annotation13" targetRef="W5338_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W5338_Flow15" sourceRef="W5338_Start6" targetRef="W5338_Task7" />
      <bpmn:sequenceFlow id="W5338_Flow16" sourceRef="W5338_Task7" targetRef="W5338_Task8" />
      <bpmn:sequenceFlow id="W5338_Flow17" sourceRef="W5338_Task8" targetRef="W5338_Task9" />
      <bpmn:sequenceFlow id="W5338_Flow18" sourceRef="W5338_Task9" targetRef="W5338_Task10" />
      <bpmn:sequenceFlow id="W5338_Flow19" sourceRef="W5338_Task10" targetRef="W5338_Task11" />
      <bpmn:sequenceFlow id="W5338_Flow20" sourceRef="W5338_Task11" targetRef="W5338_End12" />
    </bpmn:process>
