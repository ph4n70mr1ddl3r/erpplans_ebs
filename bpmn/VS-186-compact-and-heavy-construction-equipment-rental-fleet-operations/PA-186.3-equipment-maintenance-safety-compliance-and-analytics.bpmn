    <bpmn:process id="W_W5342" name="W5342. Fleet Utilization, Idle-Time, Rate-Realization &amp; Yield Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly/monthly fleet-performance review
Frequency: Weekly
Volume: 1 review per hub weekly; 1 group review monthly
Owner: Rental Fleet Manager
Participants: COO, Finance Business Partner, BI/Analytics (VS-28)
Source: workflow W5342 — Fleet Utilization, Idle-Time, Rate-Realization &amp; Yield Analytics</bpmn:documentation>
