    <bpmn:process id="W_W869" name="W869. Vendor Dispute Resolution &amp; Issue Ticketing" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor submits dispute ticket via portal, or BuildRight initiates dispute (receiving variance, quality issue, delivery failure)
Frequency: ~150–250 vendor disputes per month across all vendors
Volume: Average resolution time: 5–10 business days; ~15% escalate to Procurement Manager
Owner: Procurement Specialist / AP Accountant
Participants: Vendor Contact, Procurement Specialist, AP Accountant, Warehouse Receiving Lead, Quality Inspector
Source: workflow W869 — Vendor Dispute Resolution &amp; Issue Ticketing</bpmn:documentation>
      <bpmn:laneSet id="W869_LaneSet6">
        <bpmn:lane id="W869_Lane1" name="Vendor Contact">
        <bpmn:flowNodeRef>W869_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W869_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W869_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W869_Lane2" name="Portal System">
        <bpmn:flowNodeRef>W869_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W869_Lane3" name="Resolver">
        <bpmn:flowNodeRef>W869_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W869_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W869_Lane4" name="Procurement Manager">
        <bpmn:flowNodeRef>W869_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W869_Lane5" name="AP Accountant">
        <bpmn:flowNodeRef>W869_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W869_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W869_Start7" name="Vendor submits dispute ticket via portal, or BuildRight initiates dispute (receiving…">
        <bpmn:outgoing>W869_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W869_Task8" name="Vendor or BuildRight creates dispute ticket — categorize as: (a) Payment…">
        <bpmn:documentation>Step 1: Vendor or BuildRight creates dispute ticket — categorize as: (a) Payment Dispute (short payment, late payment, unauthorized deduction), (b) PO Dispute (cancellation, specification change, quantity change), (c) Delivery Dispute (late delivery, wrong item, damaged goods), (d) Quality Dispute (product defect, non-conformance), (e) Pricing Dispute (contract price vs. invoiced price)
Responsible (R): Vendor Contact / Procurement Specialist
Accountable (A): Procurement Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W869_Flow18</bpmn:incoming>
        <bpmn:outgoing>W869_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W869_Task9" name="Auto-route ticket to appropriate resolver — (a) Payment → AP, (b) PO →…">
        <bpmn:documentation>Step 2: Auto-route ticket to appropriate resolver — (a) Payment → AP, (b) PO → Procurement, (c) Delivery → Warehouse + Procurement, (d) Quality → Quality Inspector + Procurement, (e) Pricing → Procurement + Merchandising; SLA: first response within 4 hours
Responsible (R): Portal System (automated)
Accountable (A): Procurement Manager
Duration: 5 min (automated)</bpmn:documentation>
        <bpmn:incoming>W869_Flow19</bpmn:incoming>
        <bpmn:outgoing>W869_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W869_Task10" name="Investigate dispute — resolver reviews supporting documents in portal (PO, GRN…">
        <bpmn:documentation>Step 3: Investigate dispute — resolver reviews supporting documents in portal (PO, GRN, invoice, photos, quality report); contacts vendor if clarification needed; documents findings
Responsible (R): Resolver (role varies)
Accountable (A): Procurement Manager
Duration: 30–120 min</bpmn:documentation>
        <bpmn:incoming>W869_Flow20</bpmn:incoming>
        <bpmn:outgoing>W869_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W869_Task11" name="Propose resolution — options: (a) Vendor credit note / BuildRight debit memo…">
        <bpmn:documentation>Step 4: Propose resolution — options: (a) Vendor credit note / BuildRight debit memo, (b) Replacement shipment, (c) Price adjustment, (d) Claim denied with evidence; submit proposal via portal
Responsible (R): Resolver
Accountable (A): Procurement Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W869_Flow21</bpmn:incoming>
        <bpmn:outgoing>W869_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W869_Task12" name="Vendor accepts or counters — vendor reviews proposal, accepts (ticket…">
        <bpmn:documentation>Step 5: Vendor accepts or counters — vendor reviews proposal, accepts (ticket resolved), counters with alternative, or escalates to Procurement Manager; SLA: vendor response within 48 hours
Responsible (R): Vendor Contact
Accountable (A): Procurement Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W869_Flow22</bpmn:incoming>
        <bpmn:outgoing>W869_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W869_Task13" name="Escalation to Procurement Manager — unresolved disputes escalated after 5…">
        <bpmn:documentation>Step 6: Escalation to Procurement Manager — unresolved disputes escalated after 5 business days or vendor counters; Procurement Manager reviews, mediates, and makes final determination
Responsible (R): Procurement Manager
Accountable (A): COO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W869_Flow23</bpmn:incoming>
        <bpmn:outgoing>W869_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W869_Task14" name="Execute resolution and close ticket — apply agreed adjustment in ERP (credit…">
        <bpmn:documentation>Step 7: Execute resolution and close ticket — apply agreed adjustment in ERP (credit note, debit memo, price update), close ticket with resolution summary, and update vendor scorecard
Responsible (R): AP Accountant / Procurement Specialist
Accountable (A): Procurement Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W869_Flow24</bpmn:incoming>
        <bpmn:outgoing>W869_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W869_End15" name="Complete">
        <bpmn:incoming>W869_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W869_Annotation16">
        <bpmn:text>Controls: - CTL-249 (ensure controlled execution — Vendor Portal &amp; Collaboration (PA-03.4).) | - operational: Procurement Specialist / AP Accountant review and approval gate
Owner: Procurement Specialist / AP Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W869_Assoc17" sourceRef="W869_Annotation16" targetRef="W869_Start7" associationDirection="None" />
