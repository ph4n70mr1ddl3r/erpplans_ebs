    <bpmn:process id="W_W672" name="W672. VMI Quarterly Business Review &amp; Program Optimization" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly VMI program review cycle
Frequency: Quarterly business review with each VMI vendor; annual program optimization
Volume: 12 VMI vendors covering ~300 SKUs; ~PHP 500M-1B annual VMI spend
Owner: Procurement Manager
Participants: Senior Buyer, Category Manager, DC Operations Manager, VMI Vendor Representative
Source: workflow W672 — VMI Quarterly Business Review &amp; Program Optimization</bpmn:documentation>
      <bpmn:laneSet id="W672_LaneSet6">
        <bpmn:lane id="W672_Lane1" name="Senior Buyer">
        <bpmn:flowNodeRef>W672_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W672_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W672_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W672_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W672_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W672_Lane3" name="DC Operations Manager">
        <bpmn:flowNodeRef>W672_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W672_Lane4" name="Procurement Manager">
        <bpmn:flowNodeRef>W672_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W672_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W672_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W672_Lane5" name="VP Supply Chain">
        <bpmn:flowNodeRef>W672_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W672_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W672_Start7" name="Quarterly VMI program review cycle">
        <bpmn:outgoing>W672_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W672_Task8" name="System generates quarterly VMI program performance report per vendor: in-stock…">
        <bpmn:documentation>Step 1: System generates quarterly VMI program performance report per vendor: in-stock rate (target ≥ 97%), forecast accuracy (target ≥ 85%), fill rate, days of supply, lead time adherence, inventory turns, write-offs/damages, and sell-through vs. forecast
Responsible (R): Senior Buyer
Accountable (A): Procurement Manager
Duration: 3 hours</bpmn:documentation>
        <bpmn:incoming>W672_Flow19</bpmn:incoming>
        <bpmn:outgoing>W672_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W672_Task9" name="Prepare vendor-specific QBR package: performance scorecard with trend (vs…">
        <bpmn:documentation>Step 2: Prepare vendor-specific QBR package: performance scorecard with trend (vs. prior quarter, vs. same quarter last year), exception summary from daily monitoring (W621), upcoming seasonal demand changes, and new product introductions
Responsible (R): Senior Buyer
Accountable (A): Procurement Manager
Duration: 3 hours</bpmn:documentation>
        <bpmn:incoming>W672_Flow20</bpmn:incoming>
        <bpmn:outgoing>W672_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W672_Task10" name="Review VMI pricing compliance: actual invoice prices vs. contracted terms…">
        <bpmn:documentation>Step 3: Review VMI pricing compliance: actual invoice prices vs. contracted terms, rebate accrual status per W27, and any PPV per W633
Responsible (R): Category Manager
Accountable (A): Procurement Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W672_Flow21</bpmn:incoming>
        <bpmn:outgoing>W672_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W672_Task11" name="Provide operational feedback: delivery reliability, ASN accuracy, packaging…">
        <bpmn:documentation>Step 4: Provide operational feedback: delivery reliability, ASN accuracy, packaging quality, putaway efficiency, and any receiving exceptions
Responsible (R): DC Operations Manager
Accountable (A): Procurement Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W672_Flow22</bpmn:incoming>
        <bpmn:outgoing>W672_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W672_Task12" name="Conduct QBR meeting with VMI vendor representative: review performance, discuss…">
        <bpmn:documentation>Step 5: Conduct QBR meeting with VMI vendor representative: review performance, discuss improvement opportunities, address recurring exceptions, and align on upcoming demand changes
Responsible (R): Procurement Manager
Accountable (A): VP Supply Chain
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W672_Flow23</bpmn:incoming>
        <bpmn:outgoing>W672_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W672_Task13" name="Document joint action items: vendor commits to specific improvements (e.g…">
        <bpmn:documentation>Step 6: Document joint action items: vendor commits to specific improvements (e.g., increase safety stock for seasonal items, improve forecast accuracy by 5%); BuildRight commits to information sharing improvements (e.g., more granular demand data, earlier promotional communication)
Responsible (R): Procurement Manager
Accountable (A): Procurement Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W672_Flow24</bpmn:incoming>
        <bpmn:outgoing>W672_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W672_Task14" name="Evaluate VMI program holistically: compare VMI performance vs. non-VMI…">
        <bpmn:documentation>Step 7: Evaluate VMI program holistically: compare VMI performance vs. non-VMI procurement for same categories; assess total cost of ownership (inventory carrying cost, ordering cost, stockout cost); recommend program expansion, modification, or termination per vendor
Responsible (R): Procurement Manager
Accountable (A): VP Supply Chain
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W672_Flow25</bpmn:incoming>
        <bpmn:outgoing>W672_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W672_Task15" name="Annual: VP Supply Chain reviews VMI program strategy: vendor selection…">
        <bpmn:documentation>Step 8: Annual: VP Supply Chain reviews VMI program strategy: vendor selection criteria, SKU eligibility, program expansion roadmap, technology integration improvements
Responsible (R): VP Supply Chain
Accountable (A): COO
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W672_Flow26</bpmn:incoming>
        <bpmn:outgoing>W672_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W672_End16" name="Complete">
        <bpmn:incoming>W672_Flow27</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W672_Annotation17">
        <bpmn:text>Controls: - CTL-249 (ensure controlled execution — Vendor Portal &amp; Collaboration (PA-03.4).) | - operational: Procurement Manager review and approval gate
Owner: Procurement Manager</bpmn:text>
      </bpmn:textAnnotation>
