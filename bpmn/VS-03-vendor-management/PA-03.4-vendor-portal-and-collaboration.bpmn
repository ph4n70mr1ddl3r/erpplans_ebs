      <bpmn:sequenceFlow id="W593_Flow18" sourceRef="W593_Task6" targetRef="W593_Task7" />
      <bpmn:sequenceFlow id="W593_Flow19" sourceRef="W593_Task7" targetRef="W593_Task8" />
      <bpmn:sequenceFlow id="W593_Flow20" sourceRef="W593_Task8" targetRef="W593_Task9" />
