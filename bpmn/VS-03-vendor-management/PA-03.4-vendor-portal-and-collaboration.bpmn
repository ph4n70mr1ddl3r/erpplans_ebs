    <bpmn:process id="W_W872" name="W872. Vendor RFQ &amp; Bid Submission Portal Management" isExecutable="false">
      <bpmn:documentation>Trigger: Procurement initiates RFQ (Request for Quotation) or tender for category sourcing, new vendor evaluation, or competitive bidding
Frequency: ~2–3 RFQs per month; 2–3 formal tenders per quarter
Volume: Each RFQ sent to 3–5 vendors; formal tender to 5–10 vendors
Owner: Procurement Manager / Category Manager
Participants: Vendor Contact, Procurement Manager, Category Manager, Merchandising Manager, Finance Controller
Source: workflow W872 — Vendor RFQ &amp; Bid Submission Portal Management</bpmn:documentation>
      <bpmn:laneSet id="W872_LaneSet4">
        <bpmn:lane id="W872_Lane1" name="Procurement Manager">
        <bpmn:flowNodeRef>W872_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W872_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W872_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W872_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W872_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W872_Lane2" name="Vendor Contact">
        <bpmn:flowNodeRef>W872_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W872_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W872_Lane3" name="Procurement Specialist">
        <bpmn:flowNodeRef>W872_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W872_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W872_Start5" name="Procurement initiates RFQ (Request for Quotation) or tender for category sourcing, new…">
        <bpmn:outgoing>W872_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W872_Task6" name="Create RFQ in portal — Procurement specifies: (a) item specifications and…">
        <bpmn:documentation>Step 1: Create RFQ in portal — Procurement specifies: (a) item specifications and quantities, (b) required delivery schedule, (c) evaluation criteria (price, quality, delivery, terms), (d) bid submission deadline (typically 7–14 days), (e) terms and conditions; invite selected vendors
Responsible (R): Procurement Manager
Accountable (A): Category Manager
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W872_Flow16</bpmn:incoming>
        <bpmn:outgoing>W872_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W872_Task7" name="Vendor downloads RFQ documents and prepares bid — vendor reviews…">
        <bpmn:documentation>Step 2: Vendor downloads RFQ documents and prepares bid — vendor reviews specifications, prepares pricing (itemized), confirms availability and delivery schedule, and uploads supporting documents (product specs, samples, references)
Responsible (R): Vendor Contact
Accountable (A): Vendor Account Manager
Duration: 2–8 hours (over RFQ period)</bpmn:documentation>
        <bpmn:incoming>W872_Flow17</bpmn:incoming>
        <bpmn:outgoing>W872_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W872_Task8" name="Vendor submits bid via portal — bids are sealed (not visible to Procurement or…">
        <bpmn:documentation>Step 3: Vendor submits bid via portal — bids are sealed (not visible to Procurement or other vendors) until submission deadline; system confirms receipt and timestamp; late submissions automatically rejected
Responsible (R): Vendor Contact
Accountable (A): Procurement Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W872_Flow18</bpmn:incoming>
        <bpmn:outgoing>W872_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W872_Task9" name="Bid opening and evaluation — after deadline, Procurement unseals all bids…">
        <bpmn:documentation>Step 4: Bid opening and evaluation — after deadline, Procurement unseals all bids; system presents comparison matrix (price ranking, delivery commitment, terms comparison); evaluation committee scores each bid against criteria
Responsible (R): Procurement Manager
Accountable (A): Category Manager
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W872_Flow19</bpmn:incoming>
        <bpmn:outgoing>W872_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W872_Task10" name="Clarification and negotiation — shortlisted vendors invited for clarification…">
        <bpmn:documentation>Step 5: Clarification and negotiation — shortlisted vendors invited for clarification round (via portal messaging); negotiate final terms (price, MOQ, payment terms, delivery frequency); document all negotiations
Responsible (R): Procurement Manager
Accountable (A): Finance Controller
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W872_Flow20</bpmn:incoming>
        <bpmn:outgoing>W872_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W872_Task11" name="Award decision and notification — winning vendor receives award notification…">
        <bpmn:documentation>Step 6: Award decision and notification — winning vendor receives award notification via portal; unsuccessful vendors receive thank-you notification with general feedback; award posted to PO creation
Responsible (R): Procurement Manager
Accountable (A): COO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W872_Flow21</bpmn:incoming>
        <bpmn:outgoing>W872_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W872_Task12" name="Archive RFQ and bids — all bid documents, evaluation scoring, and negotiation…">
        <bpmn:documentation>Step 7: Archive RFQ and bids — all bid documents, evaluation scoring, and negotiation records archived per retention policy (10 years for audit trail); update vendor scorecard with bid responsiveness
Responsible (R): Procurement Specialist
Accountable (A): Procurement Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W872_Flow22</bpmn:incoming>
        <bpmn:outgoing>W872_Flow23</bpmn:outgoing>
      </bpmn:userTask>
