    <bpmn:process id="W_W422" name="W422. VMI Collaborative Data Sharing &amp; Replenishment Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly scheduled data sync for Vendor Managed Inventory (VMI) partners (e.g., Boysen, Holcim)
Frequency: Weekly (typically Sunday night for Monday review)
Volume: ~12 VMI vendors (per profile §6.5)
Owner: Inventory Planner
Participants: Buyer, Vendor Sales Rep, IT (Data Integration), DC Receiving
Source: workflow W422 — VMI Collaborative Data Sharing &amp; Replenishment Execution</bpmn:documentation>
      <bpmn:laneSet id="W422_LaneSet6">
        <bpmn:lane id="W422_Lane1" name="System">
        <bpmn:flowNodeRef>W422_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W422_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W422_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W422_Lane2" name="Vendor Rep">
        <bpmn:flowNodeRef>W422_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W422_Lane3" name="Inventory Planner">
        <bpmn:flowNodeRef>W422_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W422_Lane4" name="DC Receiving">
        <bpmn:flowNodeRef>W422_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W422_Lane5" name="Buyer">
        <bpmn:flowNodeRef>W422_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W422_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W422_Start7" name="Weekly scheduled data sync for Vendor Managed Inventory (VMI) partners (e.g., Boysen…">
        <bpmn:outgoing>W422_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W422_Task8" name="Data Export">
        <bpmn:documentation>Step 1: Data Export: System automatically generates and transmits &quot;VMI Data Package&quot; to vendor via EDI/SFTP: (a) SOH by location, (b) Sales-out (sell-through) last 7 days, (c) Open POs/Transfers, (d) Minimum/Maximum stock targets (W312)
Responsible (R): System
Accountable (A): IT Ops
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W422_Flow17</bpmn:incoming>
        <bpmn:outgoing>W422_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W422_Task9" name="Vendor Planning">
        <bpmn:documentation>Step 2: Vendor Planning: Vendor reviews data; calculates replenishment requirement to maintain target weeks-of-supply; proposes a &quot;VMI PO&quot; in the Vendor Portal
Responsible (R): Vendor Rep
Accountable (A): —
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W422_Flow18</bpmn:incoming>
        <bpmn:outgoing>W422_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W422_Task10" name="Review &amp; Approval">
        <bpmn:documentation>Step 3: Review &amp; Approval: Inventory Planner reviews vendor-proposed POs; checks against total open budget (OTB) and DC capacity; approves or modifies the PO in ERP
Responsible (R): Inventory Planner
Accountable (A): Category Mgr
Duration: 1 hour/vendor</bpmn:documentation>
        <bpmn:incoming>W422_Flow19</bpmn:incoming>
        <bpmn:outgoing>W422_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W422_Task11" name="PO Conversion">
        <bpmn:documentation>Step 4: PO Conversion: Approved proposal converts into a live Purchase Order (W2); system notifies Vendor to proceed with shipment
Responsible (R): System
Accountable (A): Buyer
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W422_Flow20</bpmn:incoming>
        <bpmn:outgoing>W422_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W422_Task12" name="Priority Receiving">
        <bpmn:documentation>Step 5: Priority Receiving: DC Receiving identifies VMI shipments; performs priority tally and putaway to ensure fast data feedback loop
Responsible (R): DC Receiving
Accountable (A): DC Manager
Duration: Per W3</bpmn:documentation>
        <bpmn:incoming>W422_Flow21</bpmn:incoming>
        <bpmn:outgoing>W422_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W422_Task13" name="Performance Review">
        <bpmn:documentation>Step 6: Performance Review: Monthly: Buyer and Vendor review &quot;VMI Service Level&quot; (Fill Rate vs. In-Stock %); adjust Min/Max parameters in W312 if needed
Responsible (R): Buyer
Accountable (A): Category Mgr
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W422_Flow22</bpmn:incoming>
        <bpmn:outgoing>W422_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W422_End14" name="Complete">
        <bpmn:incoming>W422_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W422_Annotation15">
        <bpmn:text>Controls: - CTL-249 (ensure controlled execution — Vendor Portal &amp; Collaboration (PA-03.4).) | - operational: Inventory Planner review and approval gate
Owner: Inventory Planner</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W422_Assoc16" sourceRef="W422_Annotation15" targetRef="W422_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W422_Flow17" sourceRef="W422_Start7" targetRef="W422_Task8" />
      <bpmn:sequenceFlow id="W422_Flow18" sourceRef="W422_Task8" targetRef="W422_Task9" />
      <bpmn:sequenceFlow id="W422_Flow19" sourceRef="W422_Task9" targetRef="W422_Task10" />
      <bpmn:sequenceFlow id="W422_Flow20" sourceRef="W422_Task10" targetRef="W422_Task11" />
      <bpmn:sequenceFlow id="W422_Flow21" sourceRef="W422_Task11" targetRef="W422_Task12" />
      <bpmn:sequenceFlow id="W422_Flow22" sourceRef="W422_Task12" targetRef="W422_Task13" />
      <bpmn:sequenceFlow id="W422_Flow23" sourceRef="W422_Task13" targetRef="W422_End14" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W422_diag">
      <bpmndi:BPMNPlane id="W422_plane" bpmnElement="W_W422">
        <bpmndi:BPMNShape id="W422_Lane1_di" bpmnElement="W422_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W422_Lane2_di" bpmnElement="W422_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W422_Lane3_di" bpmnElement="W422_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W422_Lane4_di" bpmnElement="W422_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W422_Lane5_di" bpmnElement="W422_Lane5" isHorizontal="true"><dc:Bounds x="160" y="760" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W422_Task8_di" bpmnElement="W422_Task8"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W422_Task9_di" bpmnElement="W422_Task9"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W422_Task10_di" bpmnElement="W422_Task10"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
