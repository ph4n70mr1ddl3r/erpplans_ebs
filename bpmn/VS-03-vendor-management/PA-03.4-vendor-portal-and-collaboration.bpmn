    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W866" name="W866. Vendor Self-Service Purchase Order Acknowledgment &amp; Confirmation" isExecutable="false">
      <bpmn:documentation>Trigger: New PO issued by BuildRight procurement; PO status changed to &quot;Sent to Vendor&quot; in ERP
Frequency: ~1,200–1,600 POs per month across ~800–1,000 active vendors (profile §6.5)
Volume: Each PO contains 5–50 line items; vendor acknowledgment expected within 24–48 hours
Owner: Procurement Specialist / Vendor Account Manager
Participants: Vendor Contact, Procurement Specialist, Warehouse Receiving Team
Source: workflow W866 — Vendor Self-Service Purchase Order Acknowledgment &amp; Confirmation</bpmn:documentation>
      <bpmn:laneSet id="W866_LaneSet4">
        <bpmn:lane id="W866_Lane1" name="ERP System">
        <bpmn:flowNodeRef>W866_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W866_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W866_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W866_Lane2" name="Vendor Contact">
        <bpmn:flowNodeRef>W866_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W866_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W866_Lane3" name="Procurement Specialist">
        <bpmn:flowNodeRef>W866_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W866_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W866_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W866_Start5" name="New PO issued by BuildRight procurement; PO status changed to &quot;Sent to Vendor&quot; in ERP">
        <bpmn:outgoing>W866_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W866_Task6" name="PO issued and pushed to vendor portal — ERP automatically sends PO to vendor…">
        <bpmn:documentation>Step 1: PO issued and pushed to vendor portal — ERP automatically sends PO to vendor portal with email notification; PO includes item, quantity, delivery date, ship-to location, and special instructions
Responsible (R): ERP System (automated)
Accountable (A): Procurement Manager
Duration: 5 min (automated)</bpmn:documentation>
        <bpmn:incoming>W866_Flow15</bpmn:incoming>
        <bpmn:outgoing>W866_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W866_Task7" name="Vendor reviews PO in portal — vendor sees PO details, delivery requirements…">
        <bpmn:documentation>Step 2: Vendor reviews PO in portal — vendor sees PO details, delivery requirements, and pricing; can acknowledge all lines, propose changes (quantity, date), or reject with reason
Responsible (R): Vendor Contact
Accountable (A): Vendor Account Manager
Duration: 15–30 min per PO</bpmn:documentation>
        <bpmn:incoming>W866_Flow16</bpmn:incoming>
        <bpmn:outgoing>W866_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W866_Task8" name="Vendor submits acknowledgment — options: (a) Full Accept — confirm all lines as…">
        <bpmn:documentation>Step 3: Vendor submits acknowledgment — options: (a) Full Accept — confirm all lines as ordered, (b) Partial Accept — confirm available lines, propose alternatives for rest, (c) Reject — decline PO with reason (discontinued, pricing dispute, capacity); system updates PO status in real-time
Responsible (R): Vendor Contact
Accountable (A): Vendor Account Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W866_Flow17</bpmn:incoming>
        <bpmn:outgoing>W866_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W866_Task9" name="Procurement reviews vendor response — for Full Accept: auto-confirm in ERP; for…">
        <bpmn:documentation>Step 4: Procurement reviews vendor response — for Full Accept: auto-confirm in ERP; for Partial Accept: Procurement Specialist reviews proposals, accepts/modifies/rejects; for Reject: determine alternative vendor or escalate
Responsible (R): Procurement Specialist
Accountable (A): Procurement Manager
Duration: 10–30 min per PO</bpmn:documentation>
        <bpmn:incoming>W866_Flow18</bpmn:incoming>
        <bpmn:outgoing>W866_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W866_Task10" name="Send ASN reminder — if PO confirmed and delivery date is within 3 days…">
        <bpmn:documentation>Step 5: Send ASN reminder — if PO confirmed and delivery date is within 3 days, automated reminder to submit ASN (Advanced Shipping Notice) via portal; ASN required before DC receiving
Responsible (R): ERP System (automated)
Accountable (A): Procurement Specialist
Duration: 5 min (automated)</bpmn:documentation>
        <bpmn:incoming>W866_Flow19</bpmn:incoming>
        <bpmn:outgoing>W866_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W866_Task11" name="Escalate unacknowledged POs — POs not acknowledged within 48 hours trigger…">
        <bpmn:documentation>Step 6: Escalate unacknowledged POs — POs not acknowledged within 48 hours trigger automated escalation: email to vendor, notification to Procurement Specialist, and follow-up call for critical orders
Responsible (R): Procurement Specialist
Accountable (A): Procurement Manager
Duration: 15 min per escalation</bpmn:documentation>
        <bpmn:incoming>W866_Flow20</bpmn:incoming>
        <bpmn:outgoing>W866_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W866_End12" name="Complete">
        <bpmn:incoming>W866_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W866_Annotation13">
        <bpmn:text>Controls: - CTL-249 (ensure controlled execution — Vendor Portal &amp; Collaboration (PA-03.4).) | - operational: Procurement Specialist / Vendor Account Manager review and approval gate
Owner: Procurement Specialist / Vendor Account Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W866_Assoc14" sourceRef="W866_Annotation13" targetRef="W866_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W866_Flow15" sourceRef="W866_Start5" targetRef="W866_Task6" />
