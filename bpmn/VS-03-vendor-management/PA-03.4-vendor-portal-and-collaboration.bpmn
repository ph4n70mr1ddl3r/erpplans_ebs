        <bpmndi:BPMNEdge id="W867_Flow17_di" bpmnElement="W867_Flow17"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W867_Flow18_di" bpmnElement="W867_Flow18"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W867_Flow19_di" bpmnElement="W867_Flow19"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W867_Flow20_di" bpmnElement="W867_Flow20"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W867_Flow21_di" bpmnElement="W867_Flow21"><di:waypoint x="1420" y="675" /><di:waypoint x="1450" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W867_Flow22_di" bpmnElement="W867_Flow22"><di:waypoint x="1630" y="165" /><di:waypoint x="1680" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W867_Assoc15_di" bpmnElement="W867_Assoc15"><di:waypoint x="340" y="800" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
