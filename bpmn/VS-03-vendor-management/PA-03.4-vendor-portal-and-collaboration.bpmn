    <bpmn:process id="W_W868" name="W868. Vendor Catalog &amp; Product Information Self-Service Management" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor needs to update product information (new items, discontinued items, specification changes, images); or BuildRight MDM team requests vendor catalog refresh
Frequency: ~200–300 catalog update requests per month across all vendors
Volume: ~55,000 total SKU master; ~2,500–3,500 catalog updates per year (the 200–300 requests/month above)
Owner: MDM Specialist / Procurement Specialist
Participants: Vendor Contact, MDM Specialist, Merchandising Manager, Ecommerce Content Manager
Source: workflow W868 — Vendor Catalog &amp; Product Information Self-Service Management</bpmn:documentation>
      <bpmn:laneSet id="W868_LaneSet5">
        <bpmn:lane id="W868_Lane1" name="Vendor Contact">
        <bpmn:flowNodeRef>W868_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W868_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W868_Lane2" name="Portal System">
        <bpmn:flowNodeRef>W868_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W868_Lane3" name="MDM Specialist">
        <bpmn:flowNodeRef>W868_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W868_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W868_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W868_Lane4" name="Merchandising Manager">
        <bpmn:flowNodeRef>W868_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W868_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W868_Start6" name="Vendor needs to update product information (new items, discontinued items, specification…">
        <bpmn:outgoing>W868_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W868_Task7" name="Vendor submits catalog update request via portal — options: (a) New Item…">
        <bpmn:documentation>Step 1: Vendor submits catalog update request via portal — options: (a) New Item Submission (with specs, images, pricing, compliance docs), (b) Item Discontinuation Notice, (c) Specification Update (dimensions, weight, materials, packaging), (d) Image/Media Update
Responsible (R): Vendor Contact
Accountable (A): MDM Specialist
Duration: 15 min per item</bpmn:documentation>
        <bpmn:incoming>W868_Flow16</bpmn:incoming>
        <bpmn:outgoing>W868_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W868_Task8" name="Automated data quality check — portal validates: (a) mandatory fields…">
        <bpmn:documentation>Step 2: Automated data quality check — portal validates: (a) mandatory fields completed, (b) image resolution meets minimum (500×500px), (c) weight/dimension within category norms, (d) barcode/UPC format valid; flag failures for vendor correction
Responsible (R): Portal System (automated)
Accountable (A): MDM Specialist
Duration: 5 min (automated)</bpmn:documentation>
        <bpmn:incoming>W868_Flow17</bpmn:incoming>
        <bpmn:outgoing>W868_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W868_Task9" name="MDM review and enrichment — MDM Specialist reviews submission: (a) verify…">
        <bpmn:documentation>Step 3: MDM review and enrichment — MDM Specialist reviews submission: (a) verify against existing catalog for duplicates, (b) map to BuildRight category taxonomy, (c) assign internal SKU if new item, (d) validate compliance documentation (PS marking, FCC, DENR)
Responsible (R): MDM Specialist
Accountable (A): Merchandising Manager
Duration: 20 min per item</bpmn:documentation>
        <bpmn:incoming>W868_Flow18</bpmn:incoming>
        <bpmn:outgoing>W868_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W868_Task10" name="Merchandising approval (for new items) — new item submissions routed to…">
        <bpmn:documentation>Step 4: Merchandising approval (for new items) — new item submissions routed to Merchandising for assortment decision: accept into active assortment, add as special-order-only, or reject with reason
Responsible (R): Merchandising Manager
Accountable (A): Procurement Manager
Duration: 10 min per item</bpmn:documentation>
        <bpmn:incoming>W868_Flow19</bpmn:incoming>
        <bpmn:outgoing>W868_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W868_Task11" name="Update ERP master data — approved changes propagated to Item Master, ecommerce…">
        <bpmn:documentation>Step 5: Update ERP master data — approved changes propagated to Item Master, ecommerce catalog, POS product database, and WMS slotting; vendor receives notification of update completion
Responsible (R): MDM Specialist
Accountable (A): MDM Manager
Duration: 10 min per item</bpmn:documentation>
        <bpmn:incoming>W868_Flow20</bpmn:incoming>
        <bpmn:outgoing>W868_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W868_Task12" name="Monthly catalog health report — portal generates vendor catalog completeness…">
        <bpmn:documentation>Step 6: Monthly catalog health report — portal generates vendor catalog completeness score (% of items with complete specs, images, compliance docs); share with vendors to drive improvement
Responsible (R): MDM Specialist
Accountable (A): Procurement Manager
Duration: 2 hours monthly</bpmn:documentation>
        <bpmn:incoming>W868_Flow21</bpmn:incoming>
        <bpmn:outgoing>W868_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W868_End13" name="Complete">
        <bpmn:incoming>W868_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W868_Annotation14">
        <bpmn:text>Controls: - CTL-249 (ensure controlled execution — Vendor Portal &amp; Collaboration (PA-03.4).) | - operational: MDM Specialist / Procurement Specialist review and approval gate
Owner: MDM Specialist / Procurement Specialist</bpmn:text>
      </bpmn:textAnnotation>
