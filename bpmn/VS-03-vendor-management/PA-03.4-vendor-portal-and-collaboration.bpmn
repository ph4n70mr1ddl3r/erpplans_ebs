<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-03.4-vendor-portal-and-collaboration" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W20" name="W20. Vendor Managed Inventory (VMI)" isExecutable="false">
      <bpmn:documentation>Trigger: VMI vendor reviews sell-through data or system sends replenishment signal
Frequency: Varies by vendor (typically weekly or bi-weekly)
Volume: ~300 SKUs from 12 key vendors
Owner: Buyer (oversight)
Participants: VMI Vendor, Buyer, Receiving Clerk (DC or Store), AP Clerk
Source: workflow W20 — Vendor Managed Inventory (VMI)</bpmn:documentation>
      <bpmn:laneSet id="W20_LaneSet5">
        <bpmn:lane id="W20_Lane1" name="System">
        <bpmn:flowNodeRef>W20_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W20_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W20_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W20_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W20_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W20_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W20_Lane2" name="VMI Vendor">
        <bpmn:flowNodeRef>W20_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W20_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W20_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W20_Lane3" name="Buyer">
        <bpmn:flowNodeRef>W20_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W20_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W20_Lane4" name="Receiving Clerk">
        <bpmn:flowNodeRef>W20_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W20_End18</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W20_Start6" name="VMI vendor reviews sell-through data or system sends replenishment signal">
        <bpmn:outgoing>W20_Flow21</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W20_Task7" name="System shares sell-through data and current stock levels with VMI vendor (EDI…">
        <bpmn:documentation>Step 1: System shares sell-through data and current stock levels with VMI vendor (EDI or portal)
Responsible (R): System
Accountable (A): Buyer
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W20_Flow21</bpmn:incoming>
        <bpmn:outgoing>W20_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W20_Task8" name="VMI vendor analyzes data and determines replenishment quantities">
        <bpmn:documentation>Step 2: VMI vendor analyzes data and determines replenishment quantities
Responsible (R): VMI Vendor
Accountable (A): VMI Vendor
Duration: External</bpmn:documentation>
        <bpmn:incoming>W20_Flow22</bpmn:incoming>
        <bpmn:outgoing>W20_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W20_Task9" name="VMI vendor creates shipment; provides Advance Shipping Notice (ASN) to system">
        <bpmn:documentation>Step 3: VMI vendor creates shipment; provides Advance Shipping Notice (ASN) to system
Responsible (R): VMI Vendor
Accountable (A): Buyer
Duration: External</bpmn:documentation>
        <bpmn:incoming>W20_Flow23</bpmn:incoming>
        <bpmn:outgoing>W20_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W20_Task10" name="Buyer reviews and confirms ASN; or system auto-confirms if within agreed…">
        <bpmn:documentation>Step 4: Buyer reviews and confirms ASN; or system auto-confirms if within agreed parameters
Responsible (R): Buyer / System
Accountable (A): Buyer
Duration: 10 min/batch</bpmn:documentation>
        <bpmn:incoming>W20_Flow24</bpmn:incoming>
        <bpmn:outgoing>W20_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W20_Task11" name="Vendor ships goods to DC or store per agreement">
        <bpmn:documentation>Step 5: Vendor ships goods to DC or store per agreement
Responsible (R): VMI Vendor
Accountable (A): —
Duration: External</bpmn:documentation>
        <bpmn:incoming>W20_Flow25</bpmn:incoming>
        <bpmn:outgoing>W20_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W20_Task12" name="Receiving Clerk processes Goods Receipt against ASN (standard receiving process)">
        <bpmn:documentation>Step 6: Receiving Clerk processes Goods Receipt against ASN (standard receiving process)
Responsible (R): Receiving Clerk
Accountable (A): Dept. Supervisor / DC Supervisor
Duration: Per W3 or W18</bpmn:documentation>
        <bpmn:incoming>W20_Flow26</bpmn:incoming>
        <bpmn:outgoing>W20_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W20_Task13" name="Goods recorded as vendor-owned inventory in system (non-valuated until sold)">
        <bpmn:documentation>Step 7: Goods recorded as vendor-owned inventory in system (non-valuated until sold)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W20_Flow27</bpmn:incoming>
        <bpmn:outgoing>W20_Flow28</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W20_Task14" name="At POS: system records sell-through event per VMI SKU; ownership transfers at…">
        <bpmn:documentation>Step 8: At POS: system records sell-through event per VMI SKU; ownership transfers at point of sale
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W20_Flow28</bpmn:incoming>
        <bpmn:outgoing>W20_Flow29</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W20_Task15" name="Monthly: system generates VMI sell-through report per vendor showing units sold…">
        <bpmn:documentation>Step 9: Monthly: system generates VMI sell-through report per vendor showing units sold × agreed price
Responsible (R): System
Accountable (A): Buyer
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W20_Flow29</bpmn:incoming>
        <bpmn:outgoing>W20_Flow30</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W20_Task16" name="Buyer reviews sell-through report; confirms settlement">
        <bpmn:documentation>Step 10: Buyer reviews sell-through report; confirms settlement
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 1 hour/month/vendor</bpmn:documentation>
        <bpmn:incoming>W20_Flow30</bpmn:incoming>
        <bpmn:outgoing>W20_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W20_Task17" name="System generates AP invoice from sell-through data; vendor payment processed">
        <bpmn:documentation>Step 11: System generates AP invoice from sell-through data; vendor payment processed
Responsible (R): System / AP Clerk
Accountable (A): AP Supervisor
Duration: Automated + 30 min</bpmn:documentation>
        <bpmn:incoming>W20_Flow31</bpmn:incoming>
        <bpmn:outgoing>W20_Flow32</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W20_End18" name="Complete">
        <bpmn:incoming>W20_Flow32</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W20_Annotation19">
        <bpmn:text>Controls: - CTL-249 (ensure controlled execution — Vendor Portal &amp; Collaboration (PA-03.4).) | - operational: Buyer (oversight) review and approval gate
Owner: Buyer (oversight)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W20_Assoc20" sourceRef="W20_Annotation19" targetRef="W20_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W20_Flow21" sourceRef="W20_Start6" targetRef="W20_Task7" />
