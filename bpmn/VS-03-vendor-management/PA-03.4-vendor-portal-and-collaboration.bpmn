        <bpmndi:BPMNShape id="W867_Task10_di" bpmnElement="W867_Task10"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W867_Task11_di" bpmnElement="W867_Task11"><dc:Bounds x="1240" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W867_Task12_di" bpmnElement="W867_Task12"><dc:Bounds x="1450" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W867_Start6_di" bpmnElement="W867_Start6"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W867_End13_di" bpmnElement="W867_End13"><dc:Bounds x="1680" y="657" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W867_Annotation14_di" bpmnElement="W867_Annotation14"><dc:Bounds x="160" y="800" width="360" height="86" /></bpmndi:BPMNShape>
