    <bpmn:process id="W_W871" name="W871. Supplier Scorecard Portal Publication &amp; Performance Transparency" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly scorecard calculation cycle (automated from ERP data); or quarterly business review (QBR) preparation
Frequency: Monthly scorecard publication; quarterly QBR meeting
Volume: ~800 vendor scorecards generated monthly; top 100 vendors reviewed in quarterly QBR
Owner: Procurement Manager
Participants: Vendor Contact, Procurement Manager, Category Manager, Supply Chain Planner
Source: workflow W871 — Supplier Scorecard Portal Publication &amp; Performance Transparency</bpmn:documentation>
      <bpmn:laneSet id="W871_LaneSet5">
        <bpmn:lane id="W871_Lane1" name="ERP System">
        <bpmn:flowNodeRef>W871_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W871_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W871_Lane2" name="Procurement Specialist">
        <bpmn:flowNodeRef>W871_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W871_Lane3" name="Vendor Contact">
        <bpmn:flowNodeRef>W871_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W871_Lane4" name="Procurement Manager">
        <bpmn:flowNodeRef>W871_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W871_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W871_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W871_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W871_Start6" name="Monthly scorecard calculation cycle (automated from ERP data); or quarterly business…">
        <bpmn:outgoing>W871_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W871_Task7" name="Calculate monthly vendor scorecard — ERP automatically computes: (a) On-Time…">
        <bpmn:documentation>Step 1: Calculate monthly vendor scorecard — ERP automatically computes: (a) On-Time Delivery % (target: ≥ 95%), (b) In-Full Delivery % (target: ≥ 98%), (c) Quality Rejection Rate (target: &lt; 1%), (d) Invoice Accuracy % (target: ≥ 98%), (e) Price Competitiveness (vs. market index), (f) Responsiveness (PO acknowledgment within 48h), (g) Compliance Status (documents current)
Responsible (R): ERP System (automated)
Accountable (A): Procurement Manager
Duration: 30 min (automated)</bpmn:documentation>
        <bpmn:incoming>W871_Flow16</bpmn:incoming>
        <bpmn:outgoing>W871_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W871_Task8" name="Publish scorecard to vendor portal — vendor sees own scorecard with trend vs…">
        <bpmn:documentation>Step 2: Publish scorecard to vendor portal — vendor sees own scorecard with trend vs. prior months, category ranking (anonymized peer comparison), and improvement areas; flag vendors below threshold for action plan
Responsible (R): Procurement Specialist
Accountable (A): Procurement Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W871_Flow17</bpmn:incoming>
        <bpmn:outgoing>W871_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W871_Task9" name="Vendor reviews and acknowledges scorecard — vendor logs in, reviews scores, and…">
        <bpmn:documentation>Step 3: Vendor reviews and acknowledges scorecard — vendor logs in, reviews scores, and can submit improvement plan for underperforming areas; acknowledgment required within 5 business days
Responsible (R): Vendor Contact
Accountable (A): Procurement Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W871_Flow18</bpmn:incoming>
        <bpmn:outgoing>W871_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W871_Task10" name="Procurement reviews vendor improvement plans — for vendors scoring below 70%…">
        <bpmn:documentation>Step 4: Procurement reviews vendor improvement plans — for vendors scoring below 70% composite: review submitted improvement plan, accept or request revision, set 90-day review milestone
Responsible (R): Procurement Manager
Accountable (A): COO
Duration: 30 min per underperformer</bpmn:documentation>
        <bpmn:incoming>W871_Flow19</bpmn:incoming>
        <bpmn:outgoing>W871_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W871_Task11" name="Quarterly business review (top 100 vendors) — present detailed scorecard…">
        <bpmn:documentation>Step 5: Quarterly business review (top 100 vendors) — present detailed scorecard, discuss performance trends, review upcoming demand forecast, address issues, and align on improvement targets
Responsible (R): Procurement Manager
Accountable (A): Category Manager
Duration: 1 hour per vendor (quarterly)</bpmn:documentation>
        <bpmn:incoming>W871_Flow20</bpmn:incoming>
        <bpmn:outgoing>W871_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W871_Task12" name="Annual vendor classification — based on 12-month scorecard performance…">
        <bpmn:documentation>Step 6: Annual vendor classification — based on 12-month scorecard performance: Strategic Partner (top 10%), Preferred Vendor (11–40%), Approved Vendor (41–80%), Probationary (bottom 20%); adjust PO allocation and payment terms accordingly
Responsible (R): Procurement Manager
Accountable (A): COO
Duration: 8 hours (annual)</bpmn:documentation>
        <bpmn:incoming>W871_Flow21</bpmn:incoming>
        <bpmn:outgoing>W871_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W871_End13" name="Complete">
        <bpmn:incoming>W871_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W871_Annotation14">
        <bpmn:text>Controls: - CTL-249 (ensure controlled execution — Vendor Portal &amp; Collaboration (PA-03.4).) | - operational: Procurement Manager review and approval gate
Owner: Procurement Manager</bpmn:text>
      </bpmn:textAnnotation>
