      <bpmn:sequenceFlow id="W866_Flow17" sourceRef="W866_Task7" targetRef="W866_Task8" />
      <bpmn:sequenceFlow id="W866_Flow18" sourceRef="W866_Task8" targetRef="W866_Task9" />
      <bpmn:sequenceFlow id="W866_Flow19" sourceRef="W866_Task9" targetRef="W866_Task10" />
