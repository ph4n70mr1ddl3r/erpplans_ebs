        <bpmndi:BPMNEdge id="W865_Flow15_di" bpmnElement="W865_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W865_Flow16_di" bpmnElement="W865_Flow16"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
