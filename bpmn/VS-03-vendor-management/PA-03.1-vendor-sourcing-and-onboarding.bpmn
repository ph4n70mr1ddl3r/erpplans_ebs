    <bpmn:process id="W_W761" name="W761. Supplier Innovation &amp; New Product Introduction Collaboration Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor proposes new product or technology; or BuildRight identifies innovation opportunity during W624 competitor visits or W130 competitive intelligence
Frequency: Monthly collaboration meetings; ad-hoc proposals
Volume: ~10–20 active supplier innovation projects at any time
Owner: Category Manager
Participants: Category Manager, Procurement Manager, VP Merchandising, Vendor Innovation Team, Quality (W150)
Source: workflow W761 — Supplier Innovation &amp; New Product Introduction Collaboration Processing</bpmn:documentation>
      <bpmn:laneSet id="W761_LaneSet4">
        <bpmn:lane id="W761_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W761_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W761_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W761_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W761_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W761_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W761_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W761_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W761_Lane2" name="Quality Team">
        <bpmn:flowNodeRef>W761_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W761_Lane3" name="VP Merchandising">
        <bpmn:flowNodeRef>W761_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W761_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W761_Start5" name="Vendor proposes new product or technology; or BuildRight identifies innovation…">
        <bpmn:outgoing>W761_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W761_Task6" name="Innovation opportunity identification — Source: (a) vendor proposal during JBP…">
        <bpmn:documentation>Step 1: Innovation opportunity identification — Source: (a) vendor proposal during JBP meeting (W155), (b) competitor product gap from W624/W130, (c) customer request trend from W507/W156 CDP, (d) industry trade show intelligence
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W761_Flow17</bpmn:incoming>
        <bpmn:outgoing>W761_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W761_Task7" name="Business case development — Category Manager prepares business case: (a) market…">
        <bpmn:documentation>Step 2: Business case development — Category Manager prepares business case: (a) market size and growth, (b) competitive landscape, (c) BuildRight differentiation potential, (d) estimated volume and margin, (e) investment required (listing fee, display, training)
Responsible (R): Category Manager
Accountable (A): —
Duration: 8 hours</bpmn:documentation>
        <bpmn:incoming>W761_Flow18</bpmn:incoming>
        <bpmn:outgoing>W761_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W761_Task8" name="Vendor collaboration meeting — Category Manager meets with vendor innovation…">
        <bpmn:documentation>Step 3: Vendor collaboration meeting — Category Manager meets with vendor innovation team: (a) review product specifications, (b) discuss exclusivity or launch window, (c) agree on sampling and testing plan (W625), (d) negotiate margin and promotional support (W513)
Responsible (R): Category Manager
Accountable (A): Vendor
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W761_Flow19</bpmn:incoming>
        <bpmn:outgoing>W761_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W761_Task9" name="Product testing &amp; certification — New product undergoes quality testing per…">
        <bpmn:documentation>Step 4: Product testing &amp; certification — New product undergoes quality testing per W625 (lab testing) and regulatory certification (W447 DTI-BPS, W479 FDA, W467 FPA as applicable)
Responsible (R): Quality Team
Accountable (A): Category Manager
Duration: 2–8 weeks</bpmn:documentation>
        <bpmn:incoming>W761_Flow20</bpmn:incoming>
        <bpmn:outgoing>W761_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W761_Task10" name="Pilot store selection — Category Manager selects 10–20 pilot stores based on…">
        <bpmn:documentation>Step 5: Pilot store selection — Category Manager selects 10–20 pilot stores based on: (a) customer demographics, (b) department sales volume, (c) planogram space availability (W314), (d) store manager capability
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W761_Flow21</bpmn:incoming>
        <bpmn:outgoing>W761_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W761_Task11" name="Pilot execution — Execute pilot per W64 (new product pilot): product placement…">
        <bpmn:documentation>Step 6: Pilot execution — Execute pilot per W64 (new product pilot): product placement, associate training (W51), promotional activation (W13), and 30-day performance monitoring
Responsible (R): Category Manager
Accountable (A): Store Operations
Duration: Per W64</bpmn:documentation>
        <bpmn:incoming>W761_Flow22</bpmn:incoming>
        <bpmn:outgoing>W761_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W761_Task12" name="Performance review &amp; rollout decision — Category Manager reviews pilot results…">
        <bpmn:documentation>Step 7: Performance review &amp; rollout decision — Category Manager reviews pilot results: sales vs. target, margin, customer feedback (W608), associate feedback; recommends: (a) full rollout per W564, (b) extended pilot, or (c) discontinue
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W761_Flow23</bpmn:incoming>
        <bpmn:outgoing>W761_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W761_Task13" name="Annual innovation review — VP Merchandising presents annual innovation…">
        <bpmn:documentation>Step 8: Annual innovation review — VP Merchandising presents annual innovation portfolio: products launched, success rate, revenue contribution, and innovation pipeline for next year
Responsible (R): VP Merchandising
Accountable (A): CEO
Duration: 4 hours/year</bpmn:documentation>
        <bpmn:incoming>W761_Flow24</bpmn:incoming>
        <bpmn:outgoing>W761_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W761_End14" name="Complete">
        <bpmn:incoming>W761_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W761_Annotation15">
        <bpmn:text>Controls: - CTL-246 (ensure controlled execution — Vendor Sourcing &amp; Onboarding (PA-03.1).) | - operational: Category Manager review and approval gate
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
