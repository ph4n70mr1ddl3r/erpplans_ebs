      <bpmn:sequenceFlow id="W1157_Flow14" sourceRef="W1157_Task6" targetRef="W1157_Task7" />
      <bpmn:sequenceFlow id="W1157_Flow15" sourceRef="W1157_Task7" targetRef="W1157_Task8" />
      <bpmn:sequenceFlow id="W1157_Flow16" sourceRef="W1157_Task8" targetRef="W1157_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1157_diag">
      <bpmndi:BPMNPlane id="W1157_plane" bpmnElement="W_W1157">
        <bpmndi:BPMNShape id="W1157_Lane1_di" bpmnElement="W1157_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
