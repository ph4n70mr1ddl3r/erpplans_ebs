    <bpmn:process id="W_W244" name="W244. Vendor Invoice Dispute &amp; Discrepancy Resolution" isExecutable="false">
      <bpmn:documentation>Trigger: 3-Way Match fails (discrepancy between PO, GR, or Vendor Invoice in price or quantity) in W7
Frequency: Weekly
Volume: ~50–100 invoice disputes per month
Owner: AP Supervisor
Participants: AP Clerk, Buyer (Merchandising), Vendor Account Manager
Source: workflow W244 — Vendor Invoice Dispute &amp; Discrepancy Resolution</bpmn:documentation>
      <bpmn:laneSet id="W244_LaneSet4">
        <bpmn:lane id="W244_Lane1" name="AP Clerk">
        <bpmn:flowNodeRef>W244_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W244_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W244_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W244_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W244_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W244_Lane2" name="System">
        <bpmn:flowNodeRef>W244_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W244_Lane3" name="AP Supervisor">
        <bpmn:flowNodeRef>W244_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W244_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W244_Start5" name="3-Way Match fails (discrepancy between PO, GR, or Vendor Invoice in price or quantity) in…">
        <bpmn:outgoing>W244_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W244_Task6" name="Discrepancy Identification">
        <bpmn:documentation>Step 1: Discrepancy Identification: System flags 3-way match failure (W7 step 3). AP Clerk isolates invoice in &quot;Disputed&quot; status.
Responsible (R): AP Clerk
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W244_Flow15</bpmn:incoming>
        <bpmn:outgoing>W244_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W244_Task7" name="Categorization">
        <bpmn:documentation>Step 2: Categorization: System classifies discrepancy: (a) Price variance (invoice price &gt; PO price), or (b) Quantity variance (invoice quantity &gt; GR quantity).
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W244_Flow16</bpmn:incoming>
        <bpmn:outgoing>W244_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W244_Task8" name="Internal Review">
        <bpmn:documentation>Step 3: Internal Review: AP Clerk routes price variance to the Buyer for review. Buyer either: (a) Approves invoice (PO was outdated, updates contract price books), or (b) Rejects price, generating a Debit Note request in ERP.
Responsible (R): AP Clerk / Buyer
Accountable (A): Category Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W244_Flow17</bpmn:incoming>
        <bpmn:outgoing>W244_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W244_Task9" name="Quantity Reconciliation">
        <bpmn:documentation>Step 4: Quantity Reconciliation: For quantity variance, AP Clerk cross-references GR slip and DC warehouse log. If short-shipped, routes to Vendor for confirmation.
Responsible (R): AP Clerk
Accountable (A): AP Supervisor
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W244_Flow18</bpmn:incoming>
        <bpmn:outgoing>W244_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W244_Task10" name="Dispute Communication">
        <bpmn:documentation>Step 5: Dispute Communication: Buyer/AP Supervisor sends automated Dispute Notice with supporting system logs to the vendor via the Vendor Portal (VS-03.4 / W593).
Responsible (R): AP Supervisor
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W244_Flow19</bpmn:incoming>
        <bpmn:outgoing>W244_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W244_Task11" name="Settlement">
        <bpmn:documentation>Step 6: Settlement: Vendor accepts debit note or issues corrected invoice/Credit Note. AP Clerk posts Credit/Debit Note in ERP to match the variance and approves invoice for payment run.
Responsible (R): AP Clerk / Vendor
Accountable (A): AP Supervisor
Duration: 2–5 days</bpmn:documentation>
        <bpmn:incoming>W244_Flow20</bpmn:incoming>
        <bpmn:outgoing>W244_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W244_End12" name="Complete">
        <bpmn:incoming>W244_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W244_Annotation13">
        <bpmn:text>Controls: - CTL-246 (ensure controlled execution — Vendor Sourcing &amp; Onboarding (PA-03.1).) | - operational: AP Supervisor review and approval gate; operational: periodic reconciliation against source documents
Owner: AP Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W244_Assoc14" sourceRef="W244_Annotation13" targetRef="W244_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W244_Flow15" sourceRef="W244_Start5" targetRef="W244_Task6" />
      <bpmn:sequenceFlow id="W244_Flow16" sourceRef="W244_Task6" targetRef="W244_Task7" />
      <bpmn:sequenceFlow id="W244_Flow17" sourceRef="W244_Task7" targetRef="W244_Task8" />
      <bpmn:sequenceFlow id="W244_Flow18" sourceRef="W244_Task8" targetRef="W244_Task9" />
      <bpmn:sequenceFlow id="W244_Flow19" sourceRef="W244_Task9" targetRef="W244_Task10" />
      <bpmn:sequenceFlow id="W244_Flow20" sourceRef="W244_Task10" targetRef="W244_Task11" />
      <bpmn:sequenceFlow id="W244_Flow21" sourceRef="W244_Task11" targetRef="W244_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W244_diag">
      <bpmndi:BPMNPlane id="W244_plane" bpmnElement="W_W244">
        <bpmndi:BPMNShape id="W244_Lane1_di" bpmnElement="W244_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W244_Lane2_di" bpmnElement="W244_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W244_Lane3_di" bpmnElement="W244_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1580" height="170" /></bpmndi:BPMNShape>
