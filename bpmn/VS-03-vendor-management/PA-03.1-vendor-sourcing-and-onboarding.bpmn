    <bpmn:process id="W_W150" name="W150. Product Quality Testing &amp; Certification" isExecutable="false">
      <bpmn:documentation>Trigger: New product onboarding (W1); new vendor onboarding (W36); or scheduled periodic audit
Frequency: Ad-hoc (new items); Annual (periodic)
Volume: ~500–1,000 items tested/year (primarily private label and structural materials)
Owner: Quality Manager
Participants: Category Manager, Vendor, external testing lab (e.g., TUV, SGS), DC Receiving
Source: workflow W150 — Product Quality Testing &amp; Certification</bpmn:documentation>
      <bpmn:laneSet id="W150_LaneSet3">
        <bpmn:lane id="W150_Lane1" name="Vendor">
        <bpmn:flowNodeRef>W150_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W150_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W150_Lane2" name="Quality Mgr">
        <bpmn:flowNodeRef>W150_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W150_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W150_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W150_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W150_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W150_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W150_Start4" name="New product onboarding (W1); new vendor onboarding (W36); or scheduled periodic audit">
        <bpmn:outgoing>W150_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W150_Task5" name="Sample Submission">
        <bpmn:documentation>Step 1: Sample Submission: Vendor provides physical samples of the product for testing
Responsible (R): Vendor
Accountable (A): Category Mgr
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W150_Flow14</bpmn:incoming>
        <bpmn:outgoing>W150_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W150_Task6" name="Documentation Review">
        <bpmn:documentation>Step 2: Documentation Review: Quality Manager verifies mandatory Philippine certifications (PS Mark for local, ICC for imported regulated items)
Responsible (R): Quality Mgr
Accountable (A): Quality Mgr
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W150_Flow15</bpmn:incoming>
        <bpmn:outgoing>W150_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W150_Task7" name="Internal Testing">
        <bpmn:documentation>Step 3: Internal Testing: Basic &quot;Fit &amp; Finish&quot; testing at HQ or DC lab (e.g., measuring tile thickness, weighing cement bags)
Responsible (R): Quality Mgr
Accountable (A): Category Mgr
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W150_Flow16</bpmn:incoming>
        <bpmn:outgoing>W150_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W150_Task8" name="External Lab Testing">
        <bpmn:documentation>Step 4: External Lab Testing: Send samples to accredited 3rd-party lab for structural/chemical testing (e.g., steel tensile strength, paint lead content)
Responsible (R): Quality Mgr
Accountable (A): —
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W150_Flow17</bpmn:incoming>
        <bpmn:outgoing>W150_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W150_Task9" name="Decision">
        <bpmn:documentation>Step 5: Decision: (a) Pass: System flags SKU as &quot;QC Approved&quot;; (b) Fail: Item rejected; Vendor must remediate or SKU is blocked from sale
Responsible (R): Quality Mgr
Accountable (A): VP Merch
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W150_Flow18</bpmn:incoming>
        <bpmn:outgoing>W150_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W150_Task10" name="Periodic Audit">
        <bpmn:documentation>Step 6: Periodic Audit: Random samples pulled from DC stock (W3) and sent for re-testing to ensure consistent quality
Responsible (R): Quality Mgr
Accountable (A): Quality Mgr
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W150_Flow19</bpmn:incoming>
        <bpmn:outgoing>W150_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W150_End11" name="Complete">
        <bpmn:incoming>W150_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W150_Annotation12">
        <bpmn:text>Controls: - CTL-246 (ensure controlled execution — Vendor Sourcing &amp; Onboarding (PA-03.1).) | - operational: Quality Manager review and approval gate
Owner: Quality Manager</bpmn:text>
      </bpmn:textAnnotation>
