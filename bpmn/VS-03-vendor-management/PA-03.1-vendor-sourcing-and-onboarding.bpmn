    <bpmn:process id="W_W633" name="W633. Purchase Price Variance (PPV) Analysis &amp; Cost Management" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly PPV report generation; triggered by vendor price increase notification
Frequency: Monthly analysis; quarterly comprehensive review
Volume: ~35,000 active SKUs monitored; ~500–800 SKUs with material variance monthly
Owner: FP&amp;A Analyst
Participants: Category Manager, Senior Buyer, Cost Accountant
Source: workflow W633 — Purchase Price Variance (PPV) Analysis &amp; Cost Management</bpmn:documentation>
      <bpmn:laneSet id="W633_LaneSet6">
        <bpmn:lane id="W633_Lane1" name="System">
        <bpmn:flowNodeRef>W633_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W633_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W633_Lane2" name="FP&amp;A Analyst">
        <bpmn:flowNodeRef>W633_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W633_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W633_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W633_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W633_Lane3" name="Category Manager">
        <bpmn:flowNodeRef>W633_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W633_Lane4" name="Cost Accountant">
        <bpmn:flowNodeRef>W633_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W633_Lane5" name="Senior Buyer">
        <bpmn:flowNodeRef>W633_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W633_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W633_Start7" name="Monthly PPV report generation; triggered by vendor price increase notification">
        <bpmn:outgoing>W633_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W633_Task8" name="System auto-generates PPV report comparing standard cost to actual PO cost per…">
        <bpmn:documentation>Step 1: System auto-generates PPV report comparing standard cost to actual PO cost per SKU per vendor for the period
Responsible (R): System
Accountable (A): FP&amp;A Analyst
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W633_Flow19</bpmn:incoming>
        <bpmn:outgoing>W633_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W633_Task9" name="FP&amp;A Analyst reviews PPV report filtering for material variances (&gt; 3% or &gt; PHP…">
        <bpmn:documentation>Step 2: FP&amp;A Analyst reviews PPV report filtering for material variances (&gt; 3% or &gt; PHP 50 per unit); categorizes as favorable or unfavorable
Responsible (R): FP&amp;A Analyst
Accountable (A): Finance Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W633_Flow20</bpmn:incoming>
        <bpmn:outgoing>W633_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W633_Task10" name="FP&amp;A Analyst performs root cause classification: vendor price increase…">
        <bpmn:documentation>Step 3: FP&amp;A Analyst performs root cause classification: vendor price increase, commodity market movement, FX impact on imports, negotiation gap, specification change, UOM error, or data entry error
Responsible (R): FP&amp;A Analyst
Accountable (A): Finance Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W633_Flow21</bpmn:incoming>
        <bpmn:outgoing>W633_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W633_Task11" name="For commodity-exposed categories (cement, steel, copper wire, lumber), FP&amp;A…">
        <bpmn:documentation>Step 4: For commodity-exposed categories (cement, steel, copper wire, lumber), FP&amp;A Analyst compares actual purchase prices against published commodity indices
Responsible (R): FP&amp;A Analyst
Accountable (A): Finance Manager
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W633_Flow22</bpmn:incoming>
        <bpmn:outgoing>W633_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W633_Task12" name="Category Manager reviews unfavorable PPV for top 50 SKUs by financial impact…">
        <bpmn:documentation>Step 5: Category Manager reviews unfavorable PPV for top 50 SKUs by financial impact; develops action plan (renegotiate with vendor, seek alternative source per W631, adjust selling price, absorb margin impact)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W633_Flow23</bpmn:incoming>
        <bpmn:outgoing>W633_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W633_Task13" name="Cost Accountant assesses PPV impact on inventory valuation (WAC recalculation)…">
        <bpmn:documentation>Step 6: Cost Accountant assesses PPV impact on inventory valuation (WAC recalculation) and gross margin by category
Responsible (R): Cost Accountant
Accountable (A): Finance Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W633_Flow24</bpmn:incoming>
        <bpmn:outgoing>W633_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W633_Task14" name="Senior Buyer executes approved action plan (vendor renegotiation, source…">
        <bpmn:documentation>Step 7: Senior Buyer executes approved action plan (vendor renegotiation, source switch, PO amendment)
Responsible (R): Senior Buyer
Accountable (A): Category Manager
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W633_Flow25</bpmn:incoming>
        <bpmn:outgoing>W633_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W633_Task15" name="FP&amp;A Analyst updates standard costs quarterly based on PPV trends, commodity…">
        <bpmn:documentation>Step 8: FP&amp;A Analyst updates standard costs quarterly based on PPV trends, commodity outlook, and FX forecast; submits for Finance Manager approval
Responsible (R): FP&amp;A Analyst
Accountable (A): Finance Manager
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W633_Flow26</bpmn:incoming>
        <bpmn:outgoing>W633_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W633_End16" name="Complete">
        <bpmn:incoming>W633_Flow27</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W633_Annotation17">
        <bpmn:text>Controls: - CTL-246 (ensure controlled execution — Vendor Sourcing &amp; Onboarding (PA-03.1).) | - operational: FP&amp;A Analyst review and approval gate
Owner: FP&amp;A Analyst</bpmn:text>
      </bpmn:textAnnotation>
