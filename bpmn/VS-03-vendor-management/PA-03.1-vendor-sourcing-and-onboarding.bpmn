    <bpmn:process id="W_W155" name="W155. Vendor Strategic Collaboration &amp; Joint Business Planning (JBP)" isExecutable="false">
      <bpmn:documentation>Trigger: Annual planning cycle with &quot;Top 20&quot; strategic vendors
Frequency: Annual (with quarterly progress reviews)
Volume: Covers 20 key vendors (~45% of COGS)
Owner: VP for Merchandising
Participants: Category Managers, Buyers, Vendor Executives, Supply Chain Planners
Source: workflow W155 — Vendor Strategic Collaboration &amp; Joint Business Planning (JBP)</bpmn:documentation>
      <bpmn:laneSet id="W155_LaneSet5">
        <bpmn:lane id="W155_Lane1" name="Buyer">
        <bpmn:flowNodeRef>W155_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W155_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
