      <bpmn:startEvent id="W160_Start5" name="Onboarding new private label vendor (W129); or annual compliance cycle">
        <bpmn:outgoing>W160_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W160_Task6" name="Self-Assessment">
        <bpmn:documentation>Step 1: Self-Assessment: Vendor submits social compliance questionnaire (labor practices, safety, environmental)
Responsible (R): Vendor
Accountable (A): Quality Mgr
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W160_Flow13</bpmn:incoming>
        <bpmn:outgoing>W160_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W160_Task7" name="On-site Audit">
        <bpmn:documentation>Step 2: On-site Audit: Internal or 3rd-party audit (SGS/TUV) of factory floor, dormitories, and payroll records
Responsible (R): External Auditor
Accountable (A): Quality Mgr
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W160_Flow14</bpmn:incoming>
        <bpmn:outgoing>W160_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W160_Task8" name="CAPA">
        <bpmn:documentation>Step 3: CAPA: If violations found, vendor must submit and execute Corrective Action Plan (W110)
Responsible (R): Vendor
Accountable (A): Quality Mgr
Duration: 30 days</bpmn:documentation>
        <bpmn:incoming>W160_Flow15</bpmn:incoming>
        <bpmn:outgoing>W160_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W160_Task9" name="Certification">
        <bpmn:documentation>Step 4: Certification: Issue &quot;BuildRight Approved Factory&quot; status in ERP; linked to W2 PO creation
Responsible (R): Quality Mgr
Accountable (A): VP Merch
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W160_Flow16</bpmn:incoming>
        <bpmn:outgoing>W160_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W160_End10" name="Complete">
        <bpmn:incoming>W160_Flow17</bpmn:incoming>
      </bpmn:endEvent>
