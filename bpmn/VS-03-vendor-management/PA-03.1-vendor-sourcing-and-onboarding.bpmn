      <bpmn:sequenceFlow id="W915_Flow16" sourceRef="W915_Task7" targetRef="W915_Task8" />
      <bpmn:sequenceFlow id="W915_Flow17" sourceRef="W915_Task8" targetRef="W915_Task9" />
      <bpmn:sequenceFlow id="W915_Flow18" sourceRef="W915_Task9" targetRef="W915_Task10" />
      <bpmn:sequenceFlow id="W915_Flow19" sourceRef="W915_Task10" targetRef="W915_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W915_diag">
      <bpmndi:BPMNPlane id="W915_plane" bpmnElement="W_W915">
        <bpmndi:BPMNShape id="W915_Lane1_di" bpmnElement="W915_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
