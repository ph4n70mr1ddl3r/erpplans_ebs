        <bpmndi:BPMNEdge id="W761_Flow25_di" bpmnElement="W761_Flow25"><di:waypoint x="2050" y="505" /><di:waypoint x="2100" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W761_Assoc16_di" bpmnElement="W761_Assoc16"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
