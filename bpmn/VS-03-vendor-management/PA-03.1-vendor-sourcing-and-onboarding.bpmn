      <bpmn:sequenceFlow id="W1087_Flow19" sourceRef="W1087_Task10" targetRef="W1087_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1087_diag">
      <bpmndi:BPMNPlane id="W1087_plane" bpmnElement="W_W1087">
        <bpmndi:BPMNShape id="W1087_Lane1_di" bpmnElement="W1087_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
