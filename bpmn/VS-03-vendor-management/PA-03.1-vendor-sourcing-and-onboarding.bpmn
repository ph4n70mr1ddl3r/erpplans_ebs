    <bpmn:process id="W_W670" name="W670. Supplier Emergency Onboarding &amp; Rapid Activation" isExecutable="false">
      <bpmn:documentation>Trigger: Emergency procurement need (W60), supply disruption requiring alternative source (W558), or single-source vendor failure
Frequency: As needed; estimated 5-10 emergency activations per year
Volume: 1-3 vendors per activation event
Owner: Procurement Manager
Participants: Senior Buyer, AP Analyst, Quality Manager, Legal Counsel, Finance Manager
Source: workflow W670 — Supplier Emergency Onboarding &amp; Rapid Activation</bpmn:documentation>
      <bpmn:laneSet id="W670_LaneSet8">
        <bpmn:lane id="W670_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W670_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W670_Start9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W670_Lane2" name="Procurement Manager">
        <bpmn:flowNodeRef>W670_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W670_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W670_Task19</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W670_Lane3" name="Senior Buyer">
        <bpmn:flowNodeRef>W670_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W670_Task17</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W670_Lane4" name="Legal Counsel">
        <bpmn:flowNodeRef>W670_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
