    <bpmn:process id="W_W136" name="W136. Indirect / Non-Merchandise Procurement" isExecutable="false">
      <bpmn:documentation>Trigger: Requisition for supplies, services, or equipment not for resale
Frequency: Ongoing
Volume: ~300–400 indirect POs/month (supplies, fixtures, marketing materials)
Owner: Indirect Procurement Manager
Participants: Requesting Dept, Buyer, Vendor, Finance (AP)
Source: workflow W136 — Indirect / Non-Merchandise Procurement</bpmn:documentation>
      <bpmn:laneSet id="W136_LaneSet4">
        <bpmn:lane id="W136_Lane1" name="Requestor">
        <bpmn:flowNodeRef>W136_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W136_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W136_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W136_Lane2" name="Buyer">
        <bpmn:flowNodeRef>W136_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W136_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W136_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W136_Lane3" name="AP Specialist">
        <bpmn:flowNodeRef>W136_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W136_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W136_Start5" name="Requisition for supplies, services, or equipment not for resale">
        <bpmn:outgoing>W136_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W136_Task6" name="Requisition: Dept user creates purchase request (PR) in ERP">
        <bpmn:documentation>Step 1: Requisition: Dept user creates purchase request (PR) in ERP
Responsible (R): Requestor
Accountable (A): Dept Head
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W136_Flow15</bpmn:incoming>
        <bpmn:outgoing>W136_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W136_Task7" name="Sourcing / Bidding: Buyer obtains 3 quotes for non-contract items">
        <bpmn:documentation>Step 2: Sourcing / Bidding: Buyer obtains 3 quotes for non-contract items
Responsible (R): Buyer
Accountable (A): Procurement Mgr
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W136_Flow16</bpmn:incoming>
        <bpmn:outgoing>W136_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W136_Task8" name="Vendor Selection: Evaluate quotes based on TCO (Total Cost of Ownership)">
        <bpmn:documentation>Step 3: Vendor Selection: Evaluate quotes based on TCO (Total Cost of Ownership)
Responsible (R): Buyer
Accountable (A): Procurement Mgr
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W136_Flow17</bpmn:incoming>
        <bpmn:outgoing>W136_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W136_Task9" name="PO Creation: Convert approved PR to PO and transmit to vendor">
        <bpmn:documentation>Step 4: PO Creation: Convert approved PR to PO and transmit to vendor
Responsible (R): Buyer
Accountable (A): Procurement Mgr
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W136_Flow18</bpmn:incoming>
        <bpmn:outgoing>W136_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W136_Task10" name="Receipt &amp; Verification: Requestor confirms receipt of goods or service…">
        <bpmn:documentation>Step 5: Receipt &amp; Verification: Requestor confirms receipt of goods or service completion
Responsible (R): Requestor
Accountable (A): Dept Head
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W136_Flow19</bpmn:incoming>
        <bpmn:outgoing>W136_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W136_Task11" name="Invoice Processing: Finance matches Invoice to PO and Receipt (3-way match)">
        <bpmn:documentation>Step 6: Invoice Processing: Finance matches Invoice to PO and Receipt (3-way match)
Responsible (R): AP Specialist
Accountable (A): AP Supervisor
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W136_Flow20</bpmn:incoming>
        <bpmn:outgoing>W136_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W136_End12" name="Complete">
        <bpmn:incoming>W136_Flow21</bpmn:incoming>
      </bpmn:endEvent>
