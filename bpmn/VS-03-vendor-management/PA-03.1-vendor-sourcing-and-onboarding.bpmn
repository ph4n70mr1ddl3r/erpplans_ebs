        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W671_Start6" name="Weekly commodity price review; material price movement alerts">
        <bpmn:outgoing>W671_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W671_Task7" name="Pull weekly commodity price data from published Philippine market indices…">
        <bpmn:documentation>Step 1: Pull weekly commodity price data from published Philippine market indices: cement (per bag/bulk), steel rebar (per kg), copper (LME + Philippine premium), lumber (per board foot local species), paint raw materials (titanium dioxide, resins), PVC resin; compare against BuildRight&#x27;s actual PO prices per W633 PPV analysis
Responsible (R): FP&amp;A Analyst
Accountable (A): Category Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W671_Flow17</bpmn:incoming>
        <bpmn:outgoing>W671_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W671_Task8" name="Review price trend dashboard: current price vs. 4-week average, 12-month range…">
        <bpmn:documentation>Step 2: Review price trend dashboard: current price vs. 4-week average, 12-month range, and BuildRight contract price; system flags commodities with &gt; 5% weekly movement or &gt; 15% quarterly movement
Responsible (R): Category Manager
Accountable (A): VP Supply Chain
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W671_Flow18</bpmn:incoming>
        <bpmn:outgoing>W671_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W671_Task9" name="For commodities in upward trend: assess forward buying opportunity considering…">
        <bpmn:documentation>Step 3: For commodities in upward trend: assess forward buying opportunity considering storage capacity at 4 DCs, working capital impact, and demand forecast per W31; calculate optimal forward buy quantity
Responsible (R): Category Manager
Accountable (A): VP Supply Chain
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W671_Flow19</bpmn:incoming>
        <bpmn:outgoing>W671_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W671_Task10" name="For commodities in downward trend: evaluate spot purchase opportunity vs…">
        <bpmn:documentation>Step 4: For commodities in downward trend: evaluate spot purchase opportunity vs. existing contract commitments; identify contract buy-out or renegotiation opportunities
Responsible (R): Category Manager
Accountable (A): VP Supply Chain
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W671_Flow20</bpmn:incoming>
        <bpmn:outgoing>W671_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W671_Task11" name="Execute commodity procurement strategy: forward contracts for 3-6 month…">
        <bpmn:documentation>Step 5: Execute commodity procurement strategy: forward contracts for 3-6 month coverage on volatile commodities, spot purchasing for favorable dips, blanket PO adjustments per W2C for stable commodities
Responsible (R): Senior Buyer
Accountable (A): Category Manager
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W671_Flow21</bpmn:incoming>
        <bpmn:outgoing>W671_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W671_Task12" name="Monthly: produce commodity market briefing for VP Supply Chain including price…">
        <bpmn:documentation>Step 6: Monthly: produce commodity market briefing for VP Supply Chain including price outlook (3-month forward), procurement strategy recommendation, margin impact forecast per W85, and hedging consideration per W80 (for import commodities with FX exposure)
Responsible (R): Category Manager
Accountable (A): VP Supply Chain
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W671_Flow22</bpmn:incoming>
        <bpmn:outgoing>W671_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W671_Task13" name="Quarterly: VP Supply Chain conducts commodity sourcing optimization review…">
        <bpmn:documentation>Step 7: Quarterly: VP Supply Chain conducts commodity sourcing optimization review: vendor diversification, local vs. import mix, alternative material evaluation, long-term contract structuring
Responsible (R): VP Supply Chain
Accountable (A): COO
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W671_Flow23</bpmn:incoming>
        <bpmn:outgoing>W671_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W671_End14" name="Complete">
        <bpmn:incoming>W671_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W671_Annotation15">
        <bpmn:text>Controls: - CTL-246 (ensure controlled execution — Vendor Sourcing &amp; Onboarding (PA-03.1).) | - operational: Category Manager review and approval gate
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
