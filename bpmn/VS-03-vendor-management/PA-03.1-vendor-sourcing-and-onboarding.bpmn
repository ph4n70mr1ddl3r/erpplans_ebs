        <bpmn:outgoing>W631_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W631_Task8" name="Category Manager compiles total spend analysis by vendor, SKU, and sub-category…">
        <bpmn:documentation>Step 1: Category Manager compiles total spend analysis by vendor, SKU, and sub-category from ERP analytics
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 2 days/category</bpmn:documentation>
        <bpmn:incoming>W631_Flow18</bpmn:incoming>
        <bpmn:outgoing>W631_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W631_Task9" name="FP&amp;A Analyst provides category gross margin trend, cost-to-serve analysis, and…">
        <bpmn:documentation>Step 2: FP&amp;A Analyst provides category gross margin trend, cost-to-serve analysis, and demand forecast
Responsible (R): FP&amp;A Analyst
Accountable (A): VP Merchandising
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W631_Flow19</bpmn:incoming>
        <bpmn:outgoing>W631_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W631_Task10" name="Supply Chain Planner provides vendor risk assessment (W491/W558 data), lead…">
        <bpmn:documentation>Step 3: Supply Chain Planner provides vendor risk assessment (W491/W558 data), lead time analysis, and single-source dependency mapping
Responsible (R): Supply Chain Planner
Accountable (A): VP Merchandising
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W631_Flow20</bpmn:incoming>
        <bpmn:outgoing>W631_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W631_Task11" name="Category Manager performs Kraljic portfolio analysis classifying each…">
        <bpmn:documentation>Step 4: Category Manager performs Kraljic portfolio analysis classifying each sub-category as Strategic, Leverage, Bottleneck, or Routine
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W631_Flow21</bpmn:incoming>
        <bpmn:outgoing>W631_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W631_Task12" name="Team develops sourcing strategy per sub-category: single-source vs…">
        <bpmn:documentation>Step 5: Team develops sourcing strategy per sub-category: single-source vs. multi-source, local vs. import, long-term contract vs. spot purchase, vendor consolidation or expansion targets
Responsible (R): Senior Buyer
Accountable (A): VP Merchandising
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W631_Flow22</bpmn:incoming>
        <bpmn:outgoing>W631_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W631_Task13" name="VP Merchandising approves category sourcing strategy with documented rationale">
        <bpmn:documentation>Step 6: VP Merchandising approves category sourcing strategy with documented rationale
Responsible (R): VP Merchandising
Accountable (A): COO
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W631_Flow23</bpmn:incoming>
        <bpmn:outgoing>W631_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W631_Task14" name="Category strategy documented in ERP procurement module with vendor allocation…">
        <bpmn:documentation>Step 7: Category strategy documented in ERP procurement module with vendor allocation targets, approved vendor list, and sourcing rules
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W631_Flow24</bpmn:incoming>
        <bpmn:outgoing>W631_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W631_End15" name="Complete">
        <bpmn:incoming>W631_Flow25</bpmn:incoming>
      </bpmn:endEvent>
