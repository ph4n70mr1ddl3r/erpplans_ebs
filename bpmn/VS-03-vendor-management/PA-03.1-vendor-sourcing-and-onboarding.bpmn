    <bpmn:process id="W_W161" name="W161. Vendor Price Protection &amp; Market Markdown Claims" isExecutable="false">
      <bpmn:documentation>Trigger: Retail price reduction (W40, W93) or competitive price match (W61) impacting stocking items
Frequency: Monthly or per major price event
Volume: Covers all SKU categories with price protection agreements
Owner: Pricing Analyst
Participants: Buyer, Category Manager, Vendor, Finance (AR/AP)
Source: workflow W161 — Vendor Price Protection &amp; Market Markdown Claims</bpmn:documentation>
      <bpmn:laneSet id="W161_LaneSet6">
        <bpmn:lane id="W161_Lane1" name="Pricing Analyst">
        <bpmn:flowNodeRef>W161_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W161_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W161_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W161_Lane2" name="System">
        <bpmn:flowNodeRef>W161_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W161_Lane3" name="Buyer">
        <bpmn:flowNodeRef>W161_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W161_Lane4" name="Vendor">
        <bpmn:flowNodeRef>W161_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W161_Lane5" name="Finance">
        <bpmn:flowNodeRef>W161_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W161_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W161_Start7" name="Retail price reduction (W40, W93) or competitive price match (W61) impacting stocking…">
        <bpmn:outgoing>W161_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W161_Task8" name="Eligibility Review">
        <bpmn:documentation>Step 1: Eligibility Review: Identify SKUs with active price protection clauses in vendor contracts (W62) upon retail price change
Responsible (R): Pricing Analyst
Accountable (A): Category Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W161_Flow17</bpmn:incoming>
        <bpmn:outgoing>W161_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W161_Task9" name="Stock-on-Hand Capture">
        <bpmn:documentation>Step 2: Stock-on-Hand Capture: System takes a snapshot of group-wide inventory (stores + DCs) at the moment of price change
Responsible (R): System
Accountable (A): —
Duration: Real-time</bpmn:documentation>
        <bpmn:incoming>W161_Flow18</bpmn:incoming>
        <bpmn:outgoing>W161_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W161_Task10" name="Claim Calculation">
        <bpmn:documentation>Step 3: Claim Calculation: Calculate claim amount = (Old Retail - New Retail) × Inventory Count; or (Old Cost - New Cost) × Inventory Count, depending on contract
Responsible (R): Pricing Analyst
Accountable (A): Category Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W161_Flow19</bpmn:incoming>
        <bpmn:outgoing>W161_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W161_Task11" name="Vendor Validation">
        <bpmn:documentation>Step 4: Vendor Validation: Transmit claim report to vendor for verification and approval; negotiate discrepancies
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 3-5 days</bpmn:documentation>
        <bpmn:incoming>W161_Flow20</bpmn:incoming>
        <bpmn:outgoing>W161_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W161_Task12" name="Credit Note Issuance">
        <bpmn:documentation>Step 5: Credit Note Issuance: Vendor issues Credit Memo to offset future payables; or system auto-deducts from next PO payment if pre-authorized
Responsible (R): Vendor / Finance
Accountable (A): Buyer
Duration: 5-10 days</bpmn:documentation>
        <bpmn:incoming>W161_Flow21</bpmn:incoming>
        <bpmn:outgoing>W161_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W161_Task13" name="Margin Recovery">
        <bpmn:documentation>Step 6: Margin Recovery: Update product costing (W85) to reflect the recovered margin; update P&amp;L for category (W102)
Responsible (R): Finance
Accountable (A): Category Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W161_Flow22</bpmn:incoming>
        <bpmn:outgoing>W161_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W161_End14" name="Complete">
        <bpmn:incoming>W161_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W161_Annotation15">
        <bpmn:text>Controls: - CTL-246 (ensure controlled execution — Vendor Sourcing &amp; Onboarding (PA-03.1).) | - operational: Pricing Analyst review and approval gate
Owner: Pricing Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W161_Assoc16" sourceRef="W161_Annotation15" targetRef="W161_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W161_Flow17" sourceRef="W161_Start7" targetRef="W161_Task8" />
