        <bpmn:flowNodeRef>W155_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W155_Lane3" name="Demand Planner">
        <bpmn:flowNodeRef>W155_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W155_Lane4" name="VP Merch">
        <bpmn:flowNodeRef>W155_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W155_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W155_Start6" name="Annual planning cycle with &quot;Top 20&quot; strategic vendors">
        <bpmn:outgoing>W155_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W155_Task7" name="Performance Review">
        <bpmn:documentation>Step 1: Performance Review: Jointly review prior year: fill rates (W44), margin, growth, and rebate achievement (W27)
Responsible (R): Buyer / Vendor
Accountable (A): Category Mgr
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W155_Flow14</bpmn:incoming>
        <bpmn:outgoing>W155_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W155_Task8" name="Growth Targets">
        <bpmn:documentation>Step 2: Growth Targets: Set consensus growth targets and market share goals for the next 12 months
Responsible (R): Category Mgr
Accountable (A): VP Merch
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W155_Flow15</bpmn:incoming>
        <bpmn:outgoing>W155_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W155_Task9" name="Supply Chain Alignment">
        <bpmn:documentation>Step 3: Supply Chain Alignment: Share long-term demand forecasts (W31) to help vendor plan production capacity
Responsible (R): Demand Planner
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W155_Flow16</bpmn:incoming>
        <bpmn:outgoing>W155_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W155_Task10" name="JBP Document">
        <bpmn:documentation>Step 4: JBP Document: Sign joint plan covering exclusive SKUs, marketing co-op (W153), and logistics efficiency
Responsible (R): VP Merch
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W155_Flow17</bpmn:incoming>
        <bpmn:outgoing>W155_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W155_End11" name="Complete">
        <bpmn:incoming>W155_Flow18</bpmn:incoming>
      </bpmn:endEvent>
