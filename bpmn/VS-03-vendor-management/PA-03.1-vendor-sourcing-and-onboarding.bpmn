      <bpmn:sequenceFlow id="W788_Flow20" sourceRef="W788_Task8" targetRef="W788_Task9" />
      <bpmn:sequenceFlow id="W788_Flow21" sourceRef="W788_Task9" targetRef="W788_Task10" />
      <bpmn:sequenceFlow id="W788_Flow22" sourceRef="W788_Task10" targetRef="W788_Task11" />
      <bpmn:sequenceFlow id="W788_Flow23" sourceRef="W788_Task11" targetRef="W788_Task12" />
