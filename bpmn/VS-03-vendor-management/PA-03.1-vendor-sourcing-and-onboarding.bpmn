    <bpmn:process id="W_W669" name="W669. Vendor Contract Compliance Monitoring &amp; Enforcement" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly contract compliance review cycle; contract milestone dates
Frequency: Monthly monitoring; quarterly comprehensive review
Volume: ~150–200 active vendor contracts (blanket POs per W2C, annual supply agreements, service contracts)
Owner: Procurement Manager
Participants: Senior Buyer, Category Manager, AP Analyst, Legal Counsel
Source: workflow W669 — Vendor Contract Compliance Monitoring &amp; Enforcement</bpmn:documentation>
      <bpmn:laneSet id="W669_LaneSet5">
        <bpmn:lane id="W669_Lane1" name="Senior Buyer">
        <bpmn:flowNodeRef>W669_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W669_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W669_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W669_Lane2" name="Procurement Manager">
        <bpmn:flowNodeRef>W669_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W669_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W669_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W669_Lane3" name="AP Analyst">
        <bpmn:flowNodeRef>W669_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W669_Lane4" name="Category Manager">
        <bpmn:flowNodeRef>W669_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W669_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W669_Start6" name="Monthly contract compliance review cycle; contract milestone dates">
        <bpmn:outgoing>W669_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W669_Task7" name="System auto-generates contract compliance dashboard from active contracts…">
        <bpmn:documentation>Step 1: System auto-generates contract compliance dashboard from active contracts: upcoming renewal dates (90/60/30-day alerts), pricing term adherence, volume commitment tracking (actual vs. committed), rebate threshold progress per W27, delivery performance against SLA per W44
Responsible (R): Senior Buyer
Accountable (A): Procurement Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W669_Flow17</bpmn:incoming>
        <bpmn:outgoing>W669_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W669_Task8" name="Review compliance exceptions: vendor billing above contract price, deliveries…">
        <bpmn:documentation>Step 2: Review compliance exceptions: vendor billing above contract price, deliveries outside agreed lead times, quality failures per W110 CAPA, volume shortfalls below minimum commitment
Responsible (R): Senior Buyer
Accountable (A): Procurement Manager
Duration: 3 hours</bpmn:documentation>
        <bpmn:incoming>W669_Flow18</bpmn:incoming>
        <bpmn:outgoing>W669_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W669_Task9" name="Escalate material non-compliance: first offense → vendor notification with…">
        <bpmn:documentation>Step 3: Escalate material non-compliance: first offense → vendor notification with 15-day remediation period; repeat offense → formal meeting with vendor management; chronic non-compliance → contract termination review with Legal Counsel
Responsible (R): Procurement Manager
Accountable (A): VP Supply Chain
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W669_Flow19</bpmn:incoming>
        <bpmn:outgoing>W669_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W669_Task10" name="Cross-reference vendor invoices against contract pricing: flag line items where…">
        <bpmn:documentation>Step 4: Cross-reference vendor invoices against contract pricing: flag line items where invoiced price exceeds contract price; auto-generate debit memo for overcharges per W244
Responsible (R): AP Analyst
Accountable (A): Procurement Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W669_Flow20</bpmn:incoming>
        <bpmn:outgoing>W669_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W669_Task11" name="Review volume commitment tracking: identify vendors where BuildRight is…">
        <bpmn:documentation>Step 5: Review volume commitment tracking: identify vendors where BuildRight is under-committing (risking unfavorable terms at renewal) or over-committing (excess inventory risk)
Responsible (R): Category Manager
Accountable (A): Procurement Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W669_Flow21</bpmn:incoming>
        <bpmn:outgoing>W669_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W669_Task12" name="Quarterly: produce comprehensive contract compliance report for VP Supply Chain…">
        <bpmn:documentation>Step 6: Quarterly: produce comprehensive contract compliance report for VP Supply Chain including compliance rate by vendor, financial impact of non-compliance, contract renewal calendar, renegotiation strategy for expiring contracts
Responsible (R): Procurement Manager
Accountable (A): VP Supply Chain
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W669_Flow22</bpmn:incoming>
        <bpmn:outgoing>W669_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W669_Task13" name="Coordinate with Legal Counsel for contract amendments, renewals, and…">
        <bpmn:documentation>Step 7: Coordinate with Legal Counsel for contract amendments, renewals, and terminations per W62 review process
Responsible (R): Procurement Manager
Accountable (A): Legal Counsel
Duration: 3 hours</bpmn:documentation>
        <bpmn:incoming>W669_Flow23</bpmn:incoming>
        <bpmn:outgoing>W669_Flow24</bpmn:outgoing>
      </bpmn:userTask>
