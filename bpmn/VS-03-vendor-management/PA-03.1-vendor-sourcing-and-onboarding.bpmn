        <bpmn:flowNodeRef>W670_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W670_End20</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W670_Start9" name="Emergency procurement need (W60), supply disruption requiring alternative source (W558)…">
        <bpmn:outgoing>W670_Flow23</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W670_Task10" name="Trigger event: supply disruption, emergency procurement need, or vendor…">
        <bpmn:documentation>Step 1: Trigger event: supply disruption, emergency procurement need, or vendor failure; requesting party submits emergency vendor request with justification, required product/service, timeline urgency, and estimated spend
Responsible (R): Category Manager / VP Supply Chain / Store Ops
Accountable (A): Procurement Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W670_Flow23</bpmn:incoming>
        <bpmn:outgoing>W670_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W670_Task11" name="Activate expedited onboarding track: compresses standard W36 onboarding…">
        <bpmn:documentation>Step 2: Activate expedited onboarding track: compresses standard W36 onboarding (normally 2-4 weeks) to 3-5 business days
Responsible (R): Procurement Manager
Accountable (A): VP Supply Chain
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W670_Flow24</bpmn:incoming>
        <bpmn:outgoing>W670_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W670_Task12" name="Perform accelerated due diligence: TIN verification, business registration…">
        <bpmn:documentation>Step 3: Perform accelerated due diligence: TIN verification, business registration check (SEC/DTI), basic financial viability assessment, reference check (2 past customers); waives Tier B/C documentary requirements per W620 for emergency
Responsible (R): Senior Buyer
Accountable (A): Procurement Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W670_Flow25</bpmn:incoming>
        <bpmn:outgoing>W670_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W670_Task13" name="Perform abbreviated compliance check: sanctions screening, PEP check, basic…">
        <bpmn:documentation>Step 4: Perform abbreviated compliance check: sanctions screening, PEP check, basic anti-corruption screening per W656; waived: full site visit, social compliance audit
Responsible (R): Legal Counsel
Accountable (A): Procurement Manager
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W670_Flow26</bpmn:incoming>
        <bpmn:outgoing>W670_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W670_Task14" name="Approve temporary payment terms (COD or Net 15 initially; standard terms after…">
        <bpmn:documentation>Step 5: Approve temporary payment terms (COD or Net 15 initially; standard terms after full onboarding completion); set temporary credit exposure limit
Responsible (R): Finance Manager
Accountable (A): CFO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W670_Flow27</bpmn:incoming>
        <bpmn:outgoing>W670_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W670_Task15" name="Create vendor master record with &quot;Emergency - Provisional&quot; status and 90-day…">
        <bpmn:documentation>Step 6: Create vendor master record with &quot;Emergency - Provisional&quot; status and 90-day full-activation deadline; provisional status restricts to designated emergency POs only
Responsible (R): AP Analyst
Accountable (A): Procurement Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W670_Flow28</bpmn:incoming>
        <bpmn:outgoing>W670_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W670_Task16" name="Establish interim quality protocol: 100% inspection on first 3 shipments per…">
        <bpmn:documentation>Step 7: Establish interim quality protocol: 100% inspection on first 3 shipments per PUR-016 before reverting to standard AQL sampling
Responsible (R): Quality Manager
Accountable (A): Procurement Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W670_Flow29</bpmn:incoming>
        <bpmn:outgoing>W670_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W670_Task17" name="Place emergency PO; system tracks emergency PO performance separately for…">
        <bpmn:documentation>Step 8: Place emergency PO; system tracks emergency PO performance separately for post-event review
Responsible (R): Senior Buyer
Accountable (A): Procurement Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W670_Flow30</bpmn:incoming>
        <bpmn:outgoing>W670_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W670_Task18" name="Within 90 days: ensure full vendor onboarding completion per W620 Tier A/B…">
        <bpmn:documentation>Step 9: Within 90 days: ensure full vendor onboarding completion per W620 Tier A/B requirements; if vendor fails full due diligence, initiate transition to qualified alternative
Responsible (R): Procurement Manager
Accountable (A): VP Supply Chain
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W670_Flow31</bpmn:incoming>
        <bpmn:outgoing>W670_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W670_Task19" name="Post-event: conduct root cause analysis of supply disruption and emergency…">
        <bpmn:documentation>Step 10: Post-event: conduct root cause analysis of supply disruption and emergency activation; update approved vendor list and sourcing strategy per W631
Responsible (R): Procurement Manager
Accountable (A): VP Supply Chain
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W670_Flow32</bpmn:incoming>
        <bpmn:outgoing>W670_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W670_End20" name="Complete">
        <bpmn:incoming>W670_Flow33</bpmn:incoming>
      </bpmn:endEvent>
