        <bpmndi:BPMNShape id="W1100_End11_di" bpmnElement="W1100_End11"><dc:Bounds x="1470" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1100_Annotation12_di" bpmnElement="W1100_Annotation12"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1100_Flow14_di" bpmnElement="W1100_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1100_Flow15_di" bpmnElement="W1100_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1100_Flow16_di" bpmnElement="W1100_Flow16"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1100_Flow17_di" bpmnElement="W1100_Flow17"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1100_Flow18_di" bpmnElement="W1100_Flow18"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1100_Flow19_di" bpmnElement="W1100_Flow19"><di:waypoint x="1420" y="505" /><di:waypoint x="1470" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1100_Assoc13_di" bpmnElement="W1100_Assoc13"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1105" name="W1105. Vendor Early Payment Discount Capture &amp; Dynamic Discounting Optimization" isExecutable="false">
      <bpmn:documentation>Trigger: AP payment run execution (W556), or vendor invoice with early payment discount terms received, or weekly treasury cash surplus review (W589)
Frequency: Weekly (during AP payment run planning); continuous (real-time discount opportunity alerts)
Volume: ~1,200–1,600 vendor invoices reviewed per payment run for discount capture opportunity
Owner: AP Manager (Finance)
Participants: AP Manager, Treasury Analyst, CFO (approval threshold)
Source: workflow W1105 — Vendor Early Payment Discount Capture &amp; Dynamic Discounting Optimization</bpmn:documentation>
      <bpmn:laneSet id="W1105_LaneSet4">
        <bpmn:lane id="W1105_Lane1" name="System">
        <bpmn:flowNodeRef>W1105_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1105_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1105_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1105_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1105_Lane2" name="Treasury Analyst">
        <bpmn:flowNodeRef>W1105_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1105_Lane3" name="AP Manager">
        <bpmn:flowNodeRef>W1105_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1105_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1105_Start5" name="AP payment run execution (W556), or vendor invoice with early payment discount terms…">
        <bpmn:outgoing>W1105_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1105_Task6" name="Invoice Discount Terms Extraction &amp; Opportunity Identification">
        <bpmn:documentation>Step 1: Invoice Discount Terms Extraction &amp; Opportunity Identification: (a) during weekly AP payment run preparation, system scans all approved and unmatched invoices for early payment discount terms; (b) system extracts: vendor ID, invoice number, invoice amount, invoice date, discount terms (e.g., &quot;2/10 Net 30&quot; = 2% discount if paid within 10 days, full amount due in 30 days), discount eligibility deadline date, net due date; (c) system calculates: discount amount available (invoice amount × discount %), days until discount deadline, effective annualized return of taking the discount (e.g., 2/10 Net 30 = 36.7% annualized return); (d) system prioritizes invoices by: (i) highest effective annualized return, (ii) largest absolute discount amount, (iii) discount deadline approaching (&lt; 3 days); (e) system flags invoices where taking the discount exceeds the company&#x27;s minimum threshold for early payment (currently set at 12% annualized return, exceeding BuildRight&#x27;s weighted average cost of capital)
Responsible (R): System
Accountable (A): AP Manager
Duration: automated</bpmn:documentation>
        <bpmn:incoming>W1105_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1105_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1105_Task7" name="Cash Position Validation &amp; Payment Capacity Check">
        <bpmn:documentation>Step 2: Cash Position Validation &amp; Payment Capacity Check: (a) Treasury Analyst reviews current cash position from W589 (weekly cash flow forecast); (b) system displays: available cash for early payments = total cash balance − upcoming committed payments (payroll, tax remittances, rent, Capex scheduled payments) − minimum cash reserve threshold (set by treasury policy); (c) system ranks discount opportunities that pass the minimum threshold and calculates total early payment amount required; (d) if total early payment required exceeds available cash, system recommends prioritization: highest annualized return first, then largest absolute discount, until cash is fully allocated; (e) Treasury Analyst confirms available cash and approves the early payment budget for the week
Responsible (R): Treasury Analyst
Accountable (A): CFO
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W1105_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1105_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1105_Task8" name="Dynamic Discounting Offer Generation (Vendor Opt-In Program)">
        <bpmn:documentation>Step 3: Dynamic Discounting Offer Generation (Vendor Opt-In Program): (a) for vendors enrolled in the dynamic discounting program (W324), system generates early payment offers: (i) for invoices with standard Net 30 terms (no built-in discount), system offers to pay in 10 days in exchange for a negotiated discount (typically 1.0–1.5%); (ii) for invoices with existing discount terms (e.g., 2/10 Net 30), system may offer to pay even earlier (e.g., Day 5) for an enhanced discount (e.g., 2.5%); (b) offers transmitted to vendors via vendor portal (W866) or email; (c) vendors accept/reject within 24 hours; (d) accepted dynamic discounts are added to the payment run
Responsible (R): System / AP Manager
Accountable (A): AP Manager
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W1105_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1105_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1105_Task9" name="Early Payment Execution &amp; Discount Capture">
        <bpmn:documentation>Step 4: Early Payment Execution &amp; Discount Capture: (a) AP Manager adds discount-eligible invoices and dynamic discounting offers to the current week&#x27;s AP payment run (W556); (b) system calculates payment amount = invoice amount − discount amount; (c) payment method selected per vendor preference: bank transfer (BDO, BPI, Metrobank, Chinabank), PDC (W424), or check; (d) system records discount taken in AP subledger: debit AP (full invoice amount), credit Cash (payment amount), credit Purchase Discount (discount amount); (e) discount captured tracked per vendor per month for vendor scorecard (W44, W706)
Responsible (R): AP Manager / System
Accountable (A): CFO (if &gt; PHP 5M single vendor early payment)
Duration: 20–30 min</bpmn:documentation>
        <bpmn:incoming>W1105_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1105_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1105_Task10" name="Monthly Discount Capture Reporting &amp; Program Optimization">
        <bpmn:documentation>Step 5: Monthly Discount Capture Reporting &amp; Program Optimization: (a) system generates monthly discount capture report: (i) total invoices eligible for discount, (ii) total discounts captured (amount and count), (iii) total discounts missed (amount and count) with reason code (insufficient cash, processing delay, vendor dispute), (iv) effective annualized return on early payments, (v) dynamic discounting program participation rate, (vi) top 20 vendors by discount value; (b) AP Manager and Treasury Analyst review missed discount opportunities and root causes; (c) process improvements identified: (i) invoice processing speed improvement to capture more invoices within discount windows, (ii) vendor negotiation for better discount terms during contract renewal, (iii) cash reserve threshold adjustment; (d) report submitted to CFO for quarterly program review
Responsible (R): System / AP Manager
Accountable (A): CFO
Duration: 1–2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1105_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1105_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1105_End11" name="Complete">
        <bpmn:incoming>W1105_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1105_Annotation12">
        <bpmn:text>Controls: - CTL-246 (ensure controlled execution — Vendor Sourcing &amp; Onboarding (PA-03.1).) | - operational: must track actual discount realized vs. offered
Owner: AP Manager (Finance)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1105_Assoc13" sourceRef="W1105_Annotation12" targetRef="W1105_Start5" associationDirection="None" />
