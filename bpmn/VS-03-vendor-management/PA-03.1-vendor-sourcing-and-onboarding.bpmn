    <bpmn:process id="W_W632" name="W632. Competitive Bidding &amp; Tender Management" isExecutable="false">
      <bpmn:documentation>Trigger: Procurement requirement exceeding PHP 500,000 for non-blanket-PO categories; new vendor evaluation; contract renewal requiring re-tender
Frequency: ~15–25 tenders/year
Volume: ~3–5 active tenders at any time
Owner: Senior Buyer
Participants: Category Manager, VP Merchandising (approver), Legal (contract review), Quality (technical evaluation)
Source: workflow W632 — Competitive Bidding &amp; Tender Management</bpmn:documentation>
      <bpmn:laneSet id="W632_LaneSet5">
        <bpmn:lane id="W632_Lane1" name="Senior Buyer">
        <bpmn:flowNodeRef>W632_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W632_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W632_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W632_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W632_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W632_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W632_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W632_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W632_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W632_Lane3" name="Quality representative">
        <bpmn:flowNodeRef>W632_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W632_Lane4" name="VP Merchandising">
        <bpmn:flowNodeRef>W632_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W632_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W632_Start6" name="Procurement requirement exceeding PHP 500,000 for non-blanket-PO categories; new vendor…">
        <bpmn:outgoing>W632_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W632_Task7" name="Senior Buyer prepares tender specification document: item descriptions…">
        <bpmn:documentation>Step 1: Senior Buyer prepares tender specification document: item descriptions, quantities, delivery schedule, quality standards, evaluation criteria, and terms
Responsible (R): Senior Buyer
Accountable (A): Category Manager
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W632_Flow19</bpmn:incoming>
        <bpmn:outgoing>W632_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W632_Task8" name="Category Manager approves tender specification and evaluation matrix (weighted…">
        <bpmn:documentation>Step 2: Category Manager approves tender specification and evaluation matrix (weighted: price 40%, quality 25%, delivery 20%, financial stability 15%)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W632_Flow20</bpmn:incoming>
        <bpmn:outgoing>W632_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W632_Task9" name="Senior Buyer publishes RFQ to qualified vendors via vendor portal (minimum 3…">
        <bpmn:documentation>Step 3: Senior Buyer publishes RFQ to qualified vendors via vendor portal (minimum 3 vendors; 5 for strategic categories); sets response deadline (typically 14 business days)
Responsible (R): Senior Buyer
Accountable (A): Category Manager
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W632_Flow21</bpmn:incoming>
        <bpmn:outgoing>W632_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W632_Task10" name="Senior Buyer receives and logs vendor responses; conducts bid opening with…">
        <bpmn:documentation>Step 4: Senior Buyer receives and logs vendor responses; conducts bid opening with Category Manager witness; prepares bid tabulation summary
Responsible (R): Senior Buyer
Accountable (A): Category Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W632_Flow22</bpmn:incoming>
        <bpmn:outgoing>W632_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W632_Task11" name="Quality evaluates technical compliance (samples, specifications…">
        <bpmn:documentation>Step 5: Quality evaluates technical compliance (samples, specifications, certifications) for technically qualifying bidders
Responsible (R): Quality representative
Accountable (A): Category Manager
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W632_Flow23</bpmn:incoming>
        <bpmn:outgoing>W632_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W632_Task12" name="Senior Buyer conducts commercial evaluation using weighted scoring matrix…">
        <bpmn:documentation>Step 6: Senior Buyer conducts commercial evaluation using weighted scoring matrix; identifies preferred and backup vendor
Responsible (R): Senior Buyer
Accountable (A): Category Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W632_Flow24</bpmn:incoming>
        <bpmn:outgoing>W632_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W632_Task13" name="Category Manager reviews evaluation, negotiates final terms with preferred…">
        <bpmn:documentation>Step 7: Category Manager reviews evaluation, negotiates final terms with preferred vendor if needed (best-and-final-offer round if competition is close)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W632_Flow25</bpmn:incoming>
        <bpmn:outgoing>W632_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W632_Task14" name="VP Merchandising approves award for bids &gt; PHP 1M; COO approves for bids &gt; PHP…">
        <bpmn:documentation>Step 8: VP Merchandising approves award for bids &gt; PHP 1M; COO approves for bids &gt; PHP 5M
Responsible (R): VP Merchandising/COO
Accountable (A): COO
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W632_Flow26</bpmn:incoming>
        <bpmn:outgoing>W632_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W632_Task15" name="Senior Buyer communicates award and decline notifications; creates blanket PO…">
        <bpmn:documentation>Step 9: Senior Buyer communicates award and decline notifications; creates blanket PO (W2C) or standard PO (W2) per award outcome
Responsible (R): Senior Buyer
Accountable (A): Category Manager
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W632_Flow27</bpmn:incoming>
        <bpmn:outgoing>W632_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W632_End16" name="Complete">
        <bpmn:incoming>W632_Flow28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W632_Annotation17">
        <bpmn:text>Controls: - CTL-246 (ensure controlled execution — Vendor Sourcing &amp; Onboarding (PA-03.1).) | - operational: Senior Buyer review and approval gate
Owner: Senior Buyer</bpmn:text>
      </bpmn:textAnnotation>
