<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-03.1-vendor-sourcing-and-onboarding" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W36" name="W36. Vendor Onboarding" isExecutable="false">
      <bpmn:documentation>Trigger: New vendor identified by Buyer or Category Manager (new product sourcing, alternative supplier, new brand)
Frequency: ~50–100 new vendors/year (replacing churned vendors + new categories)
Volume: Peaks during seasonal planning (W32) and new store openings (W16)
Owner: Buyer
Participants: Buyer, Category Manager, AP Clerk, Finance (credit assessment), IT (portal setup)
Source: workflow W36 — Vendor Onboarding</bpmn:documentation>
      <bpmn:laneSet id="W36_LaneSet7">
        <bpmn:lane id="W36_Lane1" name="Buyer">
        <bpmn:flowNodeRef>W36_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W36_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W36_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W36_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W36_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W36_Task19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W36_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W36_Lane2" name="AP Clerk">
        <bpmn:flowNodeRef>W36_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W36_Lane3" name="Category Manager">
        <bpmn:flowNodeRef>W36_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W36_Lane4" name="System">
        <bpmn:flowNodeRef>W36_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W36_Lane5" name="Merchandise Planner">
        <bpmn:flowNodeRef>W36_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W36_Lane6" name="IT Team">
        <bpmn:flowNodeRef>W36_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W36_End20</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W36_Start8" name="New vendor identified by Buyer or Category Manager (new product sourcing, alternative…">
        <bpmn:outgoing>W36_Flow23</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W36_Task9" name="Buyer identifies need for new vendor; collects basic information: company name…">
        <bpmn:documentation>Step 1: Buyer identifies need for new vendor; collects basic information: company name, contact person, product categories offered, business registration
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W36_Flow23</bpmn:incoming>
        <bpmn:outgoing>W36_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W36_Task10" name="Buyer sends vendor application form to prospective vendor; vendor provides…">
        <bpmn:documentation>Step 2: Buyer sends vendor application form to prospective vendor; vendor provides: DTI/SEC registration, BIR TIN, business permit, tax compliance certificate, bank certificate, product catalog with SRP
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: External (vendor-dependent)</bpmn:documentation>
        <bpmn:incoming>W36_Flow24</bpmn:incoming>
        <bpmn:outgoing>W36_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W36_Task11" name="AP Clerk or Finance validates vendor documents: confirms TIN is valid, business…">
        <bpmn:documentation>Step 3: AP Clerk or Finance validates vendor documents: confirms TIN is valid, business permit is current, bank details verified
Responsible (R): AP Clerk
Accountable (A): AP Supervisor
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W36_Flow25</bpmn:incoming>
        <bpmn:outgoing>W36_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W36_Task12" name="Buyer evaluates vendor capability: product quality (sample review), pricing…">
        <bpmn:documentation>Step 4: Buyer evaluates vendor capability: product quality (sample review), pricing competitiveness (vs. current vendors), delivery lead time, minimum order quantities, payment terms offered
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W36_Flow26</bpmn:incoming>
        <bpmn:outgoing>W36_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W36_Task13" name="Category Manager approves vendor for onboarding (or rejects with reason)">
        <bpmn:documentation>Step 5: Category Manager approves vendor for onboarding (or rejects with reason)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W36_Flow27</bpmn:incoming>
        <bpmn:outgoing>W36_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W36_Task14" name="Buyer creates vendor master record in system: name, TIN, address, contact…">
        <bpmn:documentation>Step 6: Buyer creates vendor master record in system: name, TIN, address, contact details, payment terms, bank account, currency, lead time, assigned category, entity(ies)
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W36_Flow28</bpmn:incoming>
        <bpmn:outgoing>W36_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W36_Task15" name="System assigns vendor number; configures: approval tier for PO amounts, default…">
        <bpmn:documentation>Step 7: System assigns vendor number; configures: approval tier for PO amounts, default PO delivery location(s), matching tolerance for invoice price variance
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W36_Flow29</bpmn:incoming>
        <bpmn:outgoing>W36_Flow30</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W36_Task16" name="Merchandise Planner maps vendor&#x27;s product catalog to item master: creates new…">
        <bpmn:documentation>Step 8: Merchandise Planner maps vendor&#x27;s product catalog to item master: creates new SKUs or links to existing SKUs; sets vendor-specific cost, lead time, minimum order quantity, order multiple
Responsible (R): Merchandise Planner
Accountable (A): Buyer
Duration: 1–2 hours/vendor (varies by catalog size)</bpmn:documentation>
        <bpmn:incoming>W36_Flow30</bpmn:incoming>
        <bpmn:outgoing>W36_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W36_Task17" name="IT configures vendor portal access (if vendor uses portal): credentials, PO…">
        <bpmn:documentation>Step 9: IT configures vendor portal access (if vendor uses portal): credentials, PO visibility, invoice submission capability
Responsible (R): IT Team
Accountable (A): Buyer
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W36_Flow31</bpmn:incoming>
        <bpmn:outgoing>W36_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W36_Task18" name="Buyer places trial PO (small initial order) to validate vendor reliability…">
        <bpmn:documentation>Step 10: Buyer places trial PO (small initial order) to validate vendor reliability, product quality at scale, and delivery performance
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: Per W2</bpmn:documentation>
        <bpmn:incoming>W36_Flow32</bpmn:incoming>
        <bpmn:outgoing>W36_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W36_Task19" name="After 3 trial orders: Buyer completes vendor scorecard baseline (delivery…">
        <bpmn:documentation>Step 11: After 3 trial orders: Buyer completes vendor scorecard baseline (delivery on-time %, quality reject rate, invoice accuracy) for future performance tracking (W44)
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W36_Flow33</bpmn:incoming>
        <bpmn:outgoing>W36_Flow34</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W36_End20" name="Complete">
        <bpmn:incoming>W36_Flow34</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W36_Annotation21">
        <bpmn:text>Controls: - CTL-06 (prevent unauthorized vendor onboarding.); CTL-42 (prevent vendor payment fraud via bank account change.) | - operational: Buyer review and approval gate
Owner: Buyer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W36_Assoc22" sourceRef="W36_Annotation21" targetRef="W36_Start8" associationDirection="None" />
      <bpmn:sequenceFlow id="W36_Flow23" sourceRef="W36_Start8" targetRef="W36_Task9" />
      <bpmn:sequenceFlow id="W36_Flow24" sourceRef="W36_Task9" targetRef="W36_Task10" />
      <bpmn:sequenceFlow id="W36_Flow25" sourceRef="W36_Task10" targetRef="W36_Task11" />
      <bpmn:sequenceFlow id="W36_Flow26" sourceRef="W36_Task11" targetRef="W36_Task12" />
      <bpmn:sequenceFlow id="W36_Flow27" sourceRef="W36_Task12" targetRef="W36_Task13" />
      <bpmn:sequenceFlow id="W36_Flow28" sourceRef="W36_Task13" targetRef="W36_Task14" />
      <bpmn:sequenceFlow id="W36_Flow29" sourceRef="W36_Task14" targetRef="W36_Task15" />
      <bpmn:sequenceFlow id="W36_Flow30" sourceRef="W36_Task15" targetRef="W36_Task16" />
      <bpmn:sequenceFlow id="W36_Flow31" sourceRef="W36_Task16" targetRef="W36_Task17" />
      <bpmn:sequenceFlow id="W36_Flow32" sourceRef="W36_Task17" targetRef="W36_Task18" />
      <bpmn:sequenceFlow id="W36_Flow33" sourceRef="W36_Task18" targetRef="W36_Task19" />
      <bpmn:sequenceFlow id="W36_Flow34" sourceRef="W36_Task19" targetRef="W36_End20" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W36_diag">
      <bpmndi:BPMNPlane id="W36_plane" bpmnElement="W_W36">
        <bpmndi:BPMNShape id="W36_Lane1_di" bpmnElement="W36_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2630" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W36_Lane2_di" bpmnElement="W36_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="2630" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W36_Lane3_di" bpmnElement="W36_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="2630" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W36_Lane4_di" bpmnElement="W36_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="2630" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W36_Lane5_di" bpmnElement="W36_Lane5" isHorizontal="true"><dc:Bounds x="160" y="760" width="2630" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W36_Lane6_di" bpmnElement="W36_Lane6" isHorizontal="true"><dc:Bounds x="160" y="930" width="2630" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W36_Task9_di" bpmnElement="W36_Task9"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W36_Task10_di" bpmnElement="W36_Task10"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W36_Task11_di" bpmnElement="W36_Task11"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W36_Task12_di" bpmnElement="W36_Task12"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W36_Task13_di" bpmnElement="W36_Task13"><dc:Bounds x="1240" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W36_Task14_di" bpmnElement="W36_Task14"><dc:Bounds x="1450" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W36_Task15_di" bpmnElement="W36_Task15"><dc:Bounds x="1660" y="635" width="180" height="80" /></bpmndi:BPMNShape>
