        <bpmndi:BPMNShape id="W244_Task7_di" bpmnElement="W244_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W244_Task8_di" bpmnElement="W244_Task8"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W244_Task9_di" bpmnElement="W244_Task9"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W244_Task10_di" bpmnElement="W244_Task10"><dc:Bounds x="1240" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W244_Task11_di" bpmnElement="W244_Task11"><dc:Bounds x="1450" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W244_Start5_di" bpmnElement="W244_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W244_End12_di" bpmnElement="W244_End12"><dc:Bounds x="1680" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W244_Annotation13_di" bpmnElement="W244_Annotation13"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W244_Flow15_di" bpmnElement="W244_Flow15"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W244_Flow16_di" bpmnElement="W244_Flow16"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W244_Flow17_di" bpmnElement="W244_Flow17"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W244_Flow18_di" bpmnElement="W244_Flow18"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W244_Flow19_di" bpmnElement="W244_Flow19"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W244_Flow20_di" bpmnElement="W244_Flow20"><di:waypoint x="1420" y="505" /><di:waypoint x="1450" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W244_Flow21_di" bpmnElement="W244_Flow21"><di:waypoint x="1630" y="165" /><di:waypoint x="1680" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W244_Assoc14_di" bpmnElement="W244_Assoc14"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W245" name="W245. Vendor Performance Chargebacks &amp; Penalties Management" isExecutable="false">
      <bpmn:documentation>Trigger: Incomplete shipment, late delivery, or poor product quality at GR (W3/W18) resulting in scorecard failure (W44)
Frequency: Ongoing
Volume: ~100–150 chargeback events/month across all DCs
Owner: Supplier Compliance Manager
Participants: DC Receiving Supervisor, Category Manager, Vendor Compliance, AP Specialist
Source: workflow W245 — Vendor Performance Chargebacks &amp; Penalties Management</bpmn:documentation>
      <bpmn:laneSet id="W245_LaneSet6">
        <bpmn:lane id="W245_Lane1" name="DC Supervisor">
        <bpmn:flowNodeRef>W245_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W245_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W245_Lane2" name="System">
        <bpmn:flowNodeRef>W245_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W245_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W245_Lane3" name="Supplier Compliance">
        <bpmn:flowNodeRef>W245_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W245_Lane4" name="Vendor">
        <bpmn:flowNodeRef>W245_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W245_Lane5" name="AP Specialist">
        <bpmn:flowNodeRef>W245_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W245_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W245_Start7" name="Incomplete shipment, late delivery, or poor product quality at GR (W3/W18) resulting in…">
        <bpmn:outgoing>W245_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W245_Task8" name="Log Discrepancy">
        <bpmn:documentation>Step 1: Log Discrepancy: DC Receiving Supervisor logs delivery failure at GR (shortage, damage, packaging non-compliance) or late arrival (&gt; 2 hours past SLA).
Responsible (R): DC Supervisor
Accountable (A): DC Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W245_Flow17</bpmn:incoming>
        <bpmn:outgoing>W245_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W245_Task9" name="Fines Engine Execution">
        <bpmn:documentation>Step 2: Fines Engine Execution: System references Supplier Compliance Agreement (W62) and auto-calculates fee/penalty: (a) Fill rate failure: 2% of unfulfilled value; (b) Late delivery: PHP 5,000 flat penalty; (c) Packaging non-compliance: PHP 2,500 penalty.
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W245_Flow18</bpmn:incoming>
        <bpmn:outgoing>W245_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W245_Task10" name="Notification">
        <bpmn:documentation>Step 3: Notification: System triggers a &quot;Compliance Infraction Report&quot; with photographs and receiving logs, sending it to the vendor via the Vendor Portal (VS-03.4 / W593) with copy to the Category Manager.
Responsible (R): Supplier Compliance
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W245_Flow19</bpmn:incoming>
        <bpmn:outgoing>W245_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W245_Task11" name="Dispute Window">
        <bpmn:documentation>Step 4: Dispute Window: Vendor has 5 business days to dispute infraction by uploading carrier proof or force majeure evidence; compliance manager reviews and makes final ruling.
Responsible (R): Vendor / Compliance Mgr
Accountable (A): Supplier Compliance Mgr
Duration: 5 days</bpmn:documentation>
        <bpmn:incoming>W245_Flow20</bpmn:incoming>
        <bpmn:outgoing>W245_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W245_Task12" name="Chargeback Posting">
        <bpmn:documentation>Step 5: Chargeback Posting: If infraction upheld, system automatically generates an AR invoice / AP Debit Note (Dr. Vendor Chargeback Receivable / Cr. Procurement Penalty Income) in the vendor&#x27;s ledger.
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W245_Flow21</bpmn:incoming>
        <bpmn:outgoing>W245_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W245_Task13" name="Deduction Reconciliation">
        <bpmn:documentation>Step 6: Deduction Reconciliation: At next AP payment cycle (W7), matching engine auto-applies debit note as deduction against vendor&#x27;s invoice payment, netting the settlement.
Responsible (R): AP Specialist
Accountable (A): AP Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W245_Flow22</bpmn:incoming>
        <bpmn:outgoing>W245_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W245_End14" name="Complete">
        <bpmn:incoming>W245_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W245_Annotation15">
        <bpmn:text>Controls: - CTL-246 (ensure controlled execution — Vendor Sourcing &amp; Onboarding (PA-03.1).) | - operational: Supplier Compliance Manager review and approval gate; operational: periodic reconciliation against source documents
Owner: Supplier Compliance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W245_Assoc16" sourceRef="W245_Annotation15" targetRef="W245_Start7" associationDirection="None" />
