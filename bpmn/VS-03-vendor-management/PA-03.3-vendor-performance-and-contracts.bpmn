        <bpmndi:BPMNShape id="W1230_Task10_di" bpmnElement="W1230_Task10"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1230_Task11_di" bpmnElement="W1230_Task11"><dc:Bounds x="1240" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1230_Task12_di" bpmnElement="W1230_Task12"><dc:Bounds x="1450" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1230_Task13_di" bpmnElement="W1230_Task13"><dc:Bounds x="1660" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1230_Start6_di" bpmnElement="W1230_Start6"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1230_End14_di" bpmnElement="W1230_End14"><dc:Bounds x="1890" y="657" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1230_Annotation15_di" bpmnElement="W1230_Annotation15"><dc:Bounds x="160" y="800" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1230_Flow17_di" bpmnElement="W1230_Flow17"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1230_Flow18_di" bpmnElement="W1230_Flow18"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1230_Flow19_di" bpmnElement="W1230_Flow19"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1230_Flow20_di" bpmnElement="W1230_Flow20"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1230_Flow21_di" bpmnElement="W1230_Flow21"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1230_Flow22_di" bpmnElement="W1230_Flow22"><di:waypoint x="1420" y="505" /><di:waypoint x="1450" y="675" /></bpmndi:BPMNEdge>
