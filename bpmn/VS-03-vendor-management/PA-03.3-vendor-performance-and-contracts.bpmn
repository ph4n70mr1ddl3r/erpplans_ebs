      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1236" name="W1236. Vendor Promotional Funding, Co-Op Advertising &amp; Markdown Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: Completion of promotional event (bi-monthly sale or monthly hot deal); vendor funding claim period closes
Frequency: 6 major bi-monthly promotions + 12 monthly hot deal cycles = ~18 promotional funding reconciliation cycles/year
Volume: ~100–200 vendor-funded promotional items per event across ~50–80 participating vendors
Owner: Merchandise Analyst
Participants: Merchandise Analyst, Category Manager, Marketing Manager, Finance – AP, Vendor Account Manager
Source: workflow W1236 — Vendor Promotional Funding, Co-Op Advertising &amp; Markdown Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W1236_LaneSet5">
        <bpmn:lane id="W1236_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W1236_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1236_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1236_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1236_Lane2" name="Marketing Manager">
        <bpmn:flowNodeRef>W1236_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1236_Lane3" name="Merchandise Analyst">
        <bpmn:flowNodeRef>W1236_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1236_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1236_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1236_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1236_Lane4" name="Finance – AP">
        <bpmn:flowNodeRef>W1236_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1236_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1236_Start6" name="Completion of promotional event (bi-monthly sale or monthly hot deal); vendor funding…">
        <bpmn:outgoing>W1236_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1236_Task7" name="Pre-promotion funding agreement">
        <bpmn:documentation>Step 1: Pre-promotion funding agreement: Before event: (a) Category Manager negotiates promotional funding terms with vendor: markdown allowance per unit, co-op advertising contribution, volume bonus thresholds; (b) terms recorded in ERP promotional funding agreement per W300; (c) system links funding terms to promotional price in POS/ecommerce
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: Per vendor negotiation</bpmn:documentation>
        <bpmn:incoming>W1236_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1236_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1236_Task8" name="Co-op advertising cost tracking">
        <bpmn:documentation>Step 2: Co-op advertising cost tracking: Marketing Manager tracks co-op advertising costs: (a) catalog printing cost allocation per vendor (based on page/space); (b) digital advertising spend attributable to vendor products; (c) in-store display material costs (signage, endcap displays); (d) social media campaign costs for vendor-funded items
Responsible (R): Marketing Manager
Accountable (A): Category Manager
Duration: 2–4 hours/event</bpmn:documentation>
        <bpmn:incoming>W1236_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1236_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1236_Task9" name="Post-promotion sell-through extraction">
        <bpmn:documentation>Step 3: Post-promotion sell-through extraction: After event concludes: (a) system extracts promotional SKU sell-through data: units sold per SKU per store/channel; (b) compare actual sales vs. vendor-committed volume; (c) identify items that achieved volume bonus thresholds
Responsible (R): Merchandise Analyst
Accountable (A): Category Manager
Duration: 2–3 hours/event</bpmn:documentation>
        <bpmn:incoming>W1236_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1236_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1236_Task10" name="Vendor funding claim calculation">
        <bpmn:documentation>Step 4: Vendor funding claim calculation: Merchandise Analyst calculates: (a) markdown allowance due: (regular price – promo price) × units sold × vendor share %; (b) co-op advertising reimbursement: per agreed allocation; (c) volume bonus earned: per threshold structure; (d) deductions: vendor-funded items not displayed per W262 compliance, agreed sell-through shortfall penalties; (e) net vendor funding claim
Responsible (R): Merchandise Analyst
Accountable (A): Category Manager
Duration: 3–5 hours/event</bpmn:documentation>
        <bpmn:incoming>W1236_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1236_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1236_Task11" name="Category Manager review and approval">
        <bpmn:documentation>Step 5: Category Manager review and approval: Category Manager reviews claims: (a) verify calculations match agreement terms; (b) validate sell-through data; (c) approve claim for vendor submission; (d) escalate disputed items to VP Merchandising
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1–2 hours/event</bpmn:documentation>
        <bpmn:incoming>W1236_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1236_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1236_Task12" name="Vendor claim submission &amp; dispute resolution">
        <bpmn:documentation>Step 6: Vendor claim submission &amp; dispute resolution: (a) submit funding claim to vendor with supporting documentation; (b) vendor reviews and may dispute quantities or calculations; (c) Merchandise Analyst resolves disputes with supporting POS/ecommerce transaction data; (d) agree final settlement amount
Responsible (R): Merchandise Analyst / Vendor
Accountable (A): Category Manager
Duration: 1–5 hours/event</bpmn:documentation>
        <bpmn:incoming>W1236_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1236_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1236_Task13" name="AP credit memo &amp; settlement">
        <bpmn:documentation>Step 7: AP credit memo &amp; settlement: (a) upon vendor agreement: create vendor credit memo in AP per W7; (b) credit memo offsets future vendor payments; (c) post to GL: promotional expense reduced by vendor funding recovery; (d) update promotional ROI analytics per W13
Responsible (R): Finance – AP
Accountable (A): Finance Manager
Duration: 30 min/vendor</bpmn:documentation>
        <bpmn:incoming>W1236_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1236_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1236_Task14" name="Promotional funding analytics">
        <bpmn:documentation>Step 8: Promotional funding analytics: Quarterly: (a) vendor funding recovery rate (% of eligible funding actually collected); (b) promotional ROI with and without vendor funding; (c) vendor payment timeliness; (d) funding terms benchmarking across vendors
Responsible (R): Merchandise Analyst
Accountable (A): Category Manager
Duration: 4 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1236_Flow25</bpmn:incoming>
        <bpmn:outgoing>W1236_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1236_End15" name="Complete">
        <bpmn:incoming>W1236_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1236_Annotation16">
        <bpmn:text>Controls: - CTL-248 (ensure controlled execution — Vendor Performance &amp; Contracts (PA-03.3).) | - operational: Merchandise Analyst review and approval gate
Owner: Merchandise Analyst</bpmn:text>
      </bpmn:textAnnotation>
