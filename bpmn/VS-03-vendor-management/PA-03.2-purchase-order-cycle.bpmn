        <bpmndi:BPMNShape id="W1006_Task8_di" bpmnElement="W1006_Task8"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1006_Task9_di" bpmnElement="W1006_Task9"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1006_Task10_di" bpmnElement="W1006_Task10"><dc:Bounds x="1240" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1006_Start5_di" bpmnElement="W1006_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1006_End11_di" bpmnElement="W1006_End11"><dc:Bounds x="1470" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1006_Annotation12_di" bpmnElement="W1006_Annotation12"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1006_Flow14_di" bpmnElement="W1006_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1006_Flow15_di" bpmnElement="W1006_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1006_Flow16_di" bpmnElement="W1006_Flow16"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1006_Flow17_di" bpmnElement="W1006_Flow17"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1006_Flow18_di" bpmnElement="W1006_Flow18"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1006_Flow19_di" bpmnElement="W1006_Flow19"><di:waypoint x="1420" y="505" /><di:waypoint x="1470" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1006_Assoc13_di" bpmnElement="W1006_Assoc13"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
