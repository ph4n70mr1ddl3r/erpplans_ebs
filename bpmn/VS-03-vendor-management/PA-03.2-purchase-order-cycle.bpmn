    <bpmn:process id="W_W2" name="W2. Procurement — Purchase Order Cycle" isExecutable="false">
      <bpmn:documentation>Source: workflow W2 — Procurement — Purchase Order Cycle</bpmn:documentation>
      <bpmn:laneSet id="W2_LaneSet2">
