        <bpmndi:BPMNEdge id="W60_Flow20_di" bpmnElement="W60_Flow20"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W60_Flow21_di" bpmnElement="W60_Flow21"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
