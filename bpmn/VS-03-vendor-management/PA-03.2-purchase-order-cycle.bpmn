      <bpmn:sequenceFlow id="W1006_Flow18" sourceRef="W1006_Task9" targetRef="W1006_Task10" />
      <bpmn:sequenceFlow id="W1006_Flow19" sourceRef="W1006_Task10" targetRef="W1006_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1006_diag">
      <bpmndi:BPMNPlane id="W1006_plane" bpmnElement="W_W1006">
        <bpmndi:BPMNShape id="W1006_Lane1_di" bpmnElement="W1006_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
