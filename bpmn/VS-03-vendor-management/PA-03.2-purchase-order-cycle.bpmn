    <bpmn:process id="W_W2A" name="W2A. Auto-Replenishment (Stocking Items)" isExecutable="false">
      <bpmn:documentation>Trigger: SKU hits reorder point (ROP) in system
Frequency: Daily review; POs generated daily
Volume: ~1,200 merchandise POs/month (auto-replenishment + ad-hoc; ~8,400 lines at the production-measured ~7 lines/PO); ~12,000 PO lines/month all types (~144,000/year, per profile §6.6); excludes ~80–240 blanket/contract release orders/month (W2C), ~20–30 import POs/month (W2B), and ~30–50 non-merchandise POs/month (capex, IT, supplies); total all types: ~1,600–1,900 POs/month (the production-calibrated 55–65/day canon per data-volumes §1.1 — the merchandise + enumerated-class sum ~1,330–1,520 plus the further release/service PO classes inside the measured total)
Owner: Buyer
Participants: System (auto-suggest), Buyer, Category Manager (approval if &gt; PHP 50K), Purchasing / PO Specialist
Source: workflow W2A — Auto-Replenishment (Stocking Items)</bpmn:documentation>
      <bpmn:laneSet id="W2A_LaneSet5">
        <bpmn:lane id="W2A_Lane1" name="System">
        <bpmn:flowNodeRef>W2A_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2A_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2A_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2A_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2A_Lane2" name="Buyer">
        <bpmn:flowNodeRef>W2A_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2A_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2A_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2A_Lane3" name="Category Manager">
        <bpmn:flowNodeRef>W2A_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2A_Lane4" name="VP Merchandising">
        <bpmn:flowNodeRef>W2A_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2A_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2A_Start6" name="SKU hits reorder point (ROP) in system">
        <bpmn:outgoing>W2A_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2A_Task7" name="System calculates ROP breaches based on: avg daily demand × lead time + safety…">
        <bpmn:documentation>Step 1: System calculates ROP breaches based on: avg daily demand × lead time + safety stock
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2A_Flow18</bpmn:incoming>
        <bpmn:outgoing>W2A_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W2A_Task8" name="System generates suggested POs grouped by vendor, consolidated across DCs">
        <bpmn:documentation>Step 2: System generates suggested POs grouped by vendor, consolidated across DCs
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2A_Flow19</bpmn:incoming>
        <bpmn:outgoing>W2A_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2A_Task9" name="Buyer reviews suggested PO list each morning: check quantities, adjust if needed">
        <bpmn:documentation>Step 3: Buyer reviews suggested PO list each morning: check quantities, adjust if needed
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 1–2 hours/day</bpmn:documentation>
        <bpmn:incoming>W2A_Flow20</bpmn:incoming>
        <bpmn:outgoing>W2A_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2A_Task10" name="Buyer confirms or modifies PO quantities, delivery dates, and DC destinations">
        <bpmn:documentation>Step 4: Buyer confirms or modifies PO quantities, delivery dates, and DC destinations
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 1–2 hours/day</bpmn:documentation>
        <bpmn:incoming>W2A_Flow21</bpmn:incoming>
        <bpmn:outgoing>W2A_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2A_Task11" name="If PO total &gt; PHP 50K: route to Category Manager for approval">
        <bpmn:documentation>Step 5: If PO total &gt; PHP 50K: route to Category Manager for approval
Responsible (R): Category Manager
Accountable (A): Category Manager
Duration: 15 min/PO</bpmn:documentation>
        <bpmn:incoming>W2A_Flow22</bpmn:incoming>
        <bpmn:outgoing>W2A_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2A_Task12" name="If PO total &gt; PHP 500K: route to VP Merchandising for approval">
        <bpmn:documentation>Step 6: If PO total &gt; PHP 500K: route to VP Merchandising for approval
Responsible (R): VP Merchandising
Accountable (A): VP Merchandising
Duration: 15 min/PO</bpmn:documentation>
        <bpmn:incoming>W2A_Flow23</bpmn:incoming>
        <bpmn:outgoing>W2A_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2A_Task13" name="Approved PO transmitted to vendor (email, EDI, or vendor portal); vendors with…">
        <bpmn:documentation>Step 7: Approved PO transmitted to vendor (email, EDI, or vendor portal); vendors with portal access can view PO details, confirm delivery dates, and submit invoices through the portal
Responsible (R): System / Buyer
Accountable (A): Buyer
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2A_Flow24</bpmn:incoming>
        <bpmn:outgoing>W2A_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2A_Task14" name="Buyer tracks open POs; follows up on overdue deliveries">
        <bpmn:documentation>Step 8: Buyer tracks open POs; follows up on overdue deliveries
Responsible (R): Buyer
Accountable (A): Buyer
Duration: 1 hour/day</bpmn:documentation>
        <bpmn:incoming>W2A_Flow25</bpmn:incoming>
        <bpmn:outgoing>W2A_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2A_End15" name="Complete">
        <bpmn:incoming>W2A_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2A_Annotation16">
        <bpmn:text>Controls: - CTL-247 (ensure controlled execution — Purchase Order Cycle (PA-03.2).) | - operational: Buyer review and approval gate
Owner: Buyer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2A_Assoc17" sourceRef="W2A_Annotation16" targetRef="W2A_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W2A_Flow18" sourceRef="W2A_Start6" targetRef="W2A_Task7" />
      <bpmn:sequenceFlow id="W2A_Flow19" sourceRef="W2A_Task7" targetRef="W2A_Task8" />
      <bpmn:sequenceFlow id="W2A_Flow20" sourceRef="W2A_Task8" targetRef="W2A_Task9" />
      <bpmn:sequenceFlow id="W2A_Flow21" sourceRef="W2A_Task9" targetRef="W2A_Task10" />
      <bpmn:sequenceFlow id="W2A_Flow22" sourceRef="W2A_Task10" targetRef="W2A_Task11" />
      <bpmn:sequenceFlow id="W2A_Flow23" sourceRef="W2A_Task11" targetRef="W2A_Task12" />
      <bpmn:sequenceFlow id="W2A_Flow24" sourceRef="W2A_Task12" targetRef="W2A_Task13" />
      <bpmn:sequenceFlow id="W2A_Flow25" sourceRef="W2A_Task13" targetRef="W2A_Task14" />
      <bpmn:sequenceFlow id="W2A_Flow26" sourceRef="W2A_Task14" targetRef="W2A_End15" />
    </bpmn:process>
