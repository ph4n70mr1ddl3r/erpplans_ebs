        <bpmndi:BPMNEdge id="W62_Flow23_di" bpmnElement="W62_Flow23"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W62_Flow24_di" bpmnElement="W62_Flow24"><di:waypoint x="1210" y="675" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W62_Flow25_di" bpmnElement="W62_Flow25"><di:waypoint x="1420" y="335" /><di:waypoint x="1450" y="845" /></bpmndi:BPMNEdge>
