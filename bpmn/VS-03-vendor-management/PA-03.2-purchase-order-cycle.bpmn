    <bpmn:process id="W_W62B" name="W62B. 3PL / Delivery Partner Onboarding &amp; Offboarding" isExecutable="false">
      <bpmn:documentation>Trigger: New delivery partner identified (new service area, capacity expansion, carrier diversification); or existing partner termination (performance failure, contract expiry, business exit)
Frequency: ~5–10 new partner evaluations/year; ~2–3 offboardings/year
Volume: Active partners: ~5–10 delivery partners (Lalamove, Transportify, own fleet surrogates, regional carriers, inter-island shipping lines)
Owner: Fleet Manager / DC Dispatch Supervisor
Participants: Fleet Manager, DC Dispatch, IT (API integration), Finance, Legal
Source: workflow W62B — 3PL / Delivery Partner Onboarding &amp; Offboarding</bpmn:documentation>
      <bpmn:laneSet id="W62B_LaneSet5">
        <bpmn:lane id="W62B_Lane1" name="Fleet Manager">
        <bpmn:flowNodeRef>W62B_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W62B_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W62B_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W62B_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W62B_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W62B_Lane2" name="IT Team">
        <bpmn:flowNodeRef>W62B_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W62B_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W62B_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W62B_Lane3" name="Legal">
        <bpmn:flowNodeRef>W62B_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W62B_Lane4" name="Approver">
        <bpmn:flowNodeRef>W62B_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W62B_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W62B_Start6" name="New delivery partner identified (new service area, capacity expansion, carrier…">
        <bpmn:outgoing>W62B_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W62B_Task7" name="Fleet Manager or DC Dispatch identifies need for new delivery partner: coverage…">
        <bpmn:documentation>Step 1: Fleet Manager or DC Dispatch identifies need for new delivery partner: coverage gap, capacity constraint, cost benchmarking, or service quality issue with existing partner
Responsible (R): Fleet Manager
Accountable (A): Supply Chain Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W62B_Flow19</bpmn:incoming>
        <bpmn:outgoing>W62B_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W62B_Task8" name="Fleet Manager solicits proposals from 2–3 candidate partners; evaluates on…">
        <bpmn:documentation>Step 2: Fleet Manager solicits proposals from 2–3 candidate partners; evaluates on: delivery coverage (zones, islands), rate card per zone/weight/tier, SLA terms (on-time %, damage rate), API integration capability (order creation, tracking, proof of delivery), insurance coverage, business permits, tax compliance
Responsible (R): Fleet Manager
Accountable (A): Supply Chain Manager
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W62B_Flow20</bpmn:incoming>
        <bpmn:outgoing>W62B_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W62B_Task9" name="IT evaluates API integration feasibility: order creation, real-time tracking…">
        <bpmn:documentation>Step 3: IT evaluates API integration feasibility: order creation, real-time tracking, proof of delivery capture, webhook/callback for status updates; estimates integration timeline and cost
Responsible (R): IT Team
Accountable (A): CIO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W62B_Flow21</bpmn:incoming>
        <bpmn:outgoing>W62B_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W62B_Task10" name="Legal reviews contract terms: liability for lost/damaged goods, data privacy…">
        <bpmn:documentation>Step 4: Legal reviews contract terms: liability for lost/damaged goods, data privacy (RA 10173 — delivery partner may access customer name, phone, address), insurance requirements, termination clause
Responsible (R): Legal
Accountable (A): VP Legal
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W62B_Flow22</bpmn:incoming>
        <bpmn:outgoing>W62B_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W62B_Task11" name="Approval per W62 tiered matrix (carrier contracts typically annual value ≤ PHP…">
        <bpmn:documentation>Step 5: Approval per W62 tiered matrix (carrier contracts typically annual value ≤ PHP 2M → VP + CFO; &gt; PHP 2M → CEO)
Responsible (R): Approver
Accountable (A): Approver
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W62B_Flow23</bpmn:incoming>
        <bpmn:outgoing>W62B_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W62B_Task12" name="IT configures API integration in staging environment; conducts integration…">
        <bpmn:documentation>Step 6: IT configures API integration in staging environment; conducts integration testing with carrier test environment; validates order creation, status callbacks, and proof of delivery flow; Fleet Manager and DC Dispatch conduct pilot with limited order volume for 1–2 weeks
Responsible (R): IT Team / Fleet Manager
Accountable (A): CIO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W62B_Flow24</bpmn:incoming>
        <bpmn:outgoing>W62B_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W62B_Task13" name="Go-live: IT activates API integration in production; DC Dispatch adds partner…">
        <bpmn:documentation>Step 7: Go-live: IT activates API integration in production; DC Dispatch adds partner to carrier selection logic; system routes orders to new partner per configured zones and rates
Responsible (R): IT Team / Fleet Manager
Accountable (A): Supply Chain Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W62B_Flow25</bpmn:incoming>
        <bpmn:outgoing>W62B_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W62B_Task14" name="Monthly: Fleet Manager monitors new partner performance per W19.7 3PL…">
        <bpmn:documentation>Step 8: Monthly: Fleet Manager monitors new partner performance per W19.7 3PL management dashboard (on-time %, damage rate, cost per delivery, customer complaint rate); underperformance escalated per W44 vendor scorecard methodology
Responsible (R): Fleet Manager
Accountable (A): Supply Chain Manager
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W62B_Flow26</bpmn:incoming>
        <bpmn:outgoing>W62B_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W62B_Task15" name="Offboarding">
        <bpmn:documentation>Step 9: Offboarding: if partner termination required (performance, contract expiry, or business decision) — Fleet Manager coordinates with DC Dispatch to redirect order volume to alternative partners; IT deactivates API integration; system removes partner from carrier selection; Finance settles outstanding carrier invoices; Legal confirms data deletion per RA 10173 (partner must delete customer data collected during service); system archives partner record with termination date, reason, and performance history
Responsible (R): Fleet Manager / IT / Finance / Legal
Accountable (A): Supply Chain Manager
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W62B_Flow27</bpmn:incoming>
        <bpmn:outgoing>W62B_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W62B_End16" name="Complete">
        <bpmn:incoming>W62B_Flow28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W62B_Annotation17">
        <bpmn:text>Controls: (none recorded)
Owner: Fleet Manager / DC Dispatch Supervisor</bpmn:text>
      </bpmn:textAnnotation>
