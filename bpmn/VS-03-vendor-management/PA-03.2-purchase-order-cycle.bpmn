        <bpmndi:BPMNShape id="W1137_Lane3_di" bpmnElement="W1137_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1137_Task6_di" bpmnElement="W1137_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1137_Task7_di" bpmnElement="W1137_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1137_Task8_di" bpmnElement="W1137_Task8"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1137_Task9_di" bpmnElement="W1137_Task9"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1137_Task10_di" bpmnElement="W1137_Task10"><dc:Bounds x="1240" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1137_Start5_di" bpmnElement="W1137_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1137_End11_di" bpmnElement="W1137_End11"><dc:Bounds x="1470" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1137_Annotation12_di" bpmnElement="W1137_Annotation12"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1137_Flow14_di" bpmnElement="W1137_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1137_Flow15_di" bpmnElement="W1137_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1137_Flow16_di" bpmnElement="W1137_Flow16"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1137_Flow17_di" bpmnElement="W1137_Flow17"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1137_Flow18_di" bpmnElement="W1137_Flow18"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1137_Flow19_di" bpmnElement="W1137_Flow19"><di:waypoint x="1420" y="165" /><di:waypoint x="1470" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1137_Assoc13_di" bpmnElement="W1137_Assoc13"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1411" name="W1411. Import PO Customs Documentation Package Preparation, Broker Coordination &amp; Compliance Checklist" isExecutable="false">
      <bpmn:documentation>Trigger: Import PO confirmed (W2B) and vendor ships goods; documentation package must be prepared before goods arrive at Philippine port
Frequency: ~400–600 TEUs/month (profile §7.1); each import PO typically requires one customs documentation package; ~20–30 import POs/month (many POs are multi-container)
Volume: ~20–30 documentation packages/month (1 per import PO per the Frequency); peak during pre-season build-up (Feb–Mar, Sep–Oct)
Owner: Customs Broker Coordinator (Finance/Supply Chain)
Participants: Customs Broker Coordinator, Buyer, Customs Broker (licensed), Vendor (documentation), Freight Forwarder, Treasury (LC/draft payment per W232)
Source: workflow W1411 — Import PO Customs Documentation Package Preparation, Broker Coordination &amp; Compliance Checklist</bpmn:documentation>
      <bpmn:laneSet id="W1411_LaneSet3">
        <bpmn:lane id="W1411_Lane1" name="Customs Broker Coordinator">
        <bpmn:flowNodeRef>W1411_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1411_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1411_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1411_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1411_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1411_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1411_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1411_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1411_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1411_Lane2" name="Customs Broker">
        <bpmn:flowNodeRef>W1411_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1411_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1411_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1411_Start4" name="Import PO confirmed (W2B) and vendor ships goods; documentation package must be prepared…">
        <bpmn:outgoing>W1411_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1411_Task5" name="Upon PO confirmation (W2B), Customs Broker Coordinator creates an import entry…">
        <bpmn:documentation>Step 1: Upon PO confirmation (W2B), Customs Broker Coordinator creates an import entry checklist for the PO: (a) Commercial Invoice (CI) — from vendor, (b) Packing List (PL) — from vendor, (c) Bill of Lading (B/L) or Airway Bill — from shipping line or freight forwarder, (d) Certificate of Origin (CO) — from vendor/chamber of commerce (required for ASEAN-Korea FTA, ASEAN-Japan CEPA, or other preferential tariff rates), (e) Import Permit / Clearance — from DTI-BPS for regulated products (steel, cement, electrical products per ICC/SOC requirements W447), (f) Sales Contract or Purchase Order — from BuildRight, (g) Insurance Certificate — if CIF terms; or BuildRight&#x27;s open marine cargo policy if FOB terms, (h) Fumigation Certificate — for wooden packaging materials (ISPM-15 compliance), (i) Material Safety Data Sheet (MSDS) — for paint, chemicals, solvents, (j) FDA Certification — for household hazardous substances (W479), (k) Letter of Credit documents — if LC payment terms (W232)
Responsible (R): Customs Broker Coordinator
Accountable (A): Supply Planning Manager
Duration: 30 min/PO</bpmn:documentation>
        <bpmn:incoming>W1411_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1411_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1411_Task6" name="Customs Broker Coordinator contacts vendor to confirm documentation readiness…">
        <bpmn:documentation>Step 2: Customs Broker Coordinator contacts vendor to confirm documentation readiness: vendor is contractually required to send documents within 48 hours of vessel sailing; Coordinator sends reminder at vessel sailing and at 48-hour mark
Responsible (R): Customs Broker Coordinator
Accountable (A): Buyer
Duration: 15 min/PO</bpmn:documentation>
        <bpmn:incoming>W1411_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1411_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1411_Task7" name="Vendor submits documents via email or vendor portal: Commercial Invoice…">
        <bpmn:documentation>Step 3: Vendor submits documents via email or vendor portal: Commercial Invoice, Packing List, Bill of Lading, Certificate of Origin; Customs Broker Coordinator logs receipt date and verifies completeness against checklist (step 1)
Responsible (R): Customs Broker Coordinator
Accountable (A): —
Duration: 15 min/PO</bpmn:documentation>
        <bpmn:incoming>W1411_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1411_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1411_Task8" name="Customs Broker Coordinator reviews each document for accuracy: (a) CI total…">
        <bpmn:documentation>Step 4: Customs Broker Coordinator reviews each document for accuracy: (a) CI total matches PO value, (b) CI item descriptions match PO item descriptions and HS codes, (c) PL quantities match CI quantities, (d) B/L container numbers match booking confirmation, (e) CO origin country matches vendor location and claimed preferential tariff, (f) HS code classification is correct per Philippine Tariff and Customs Code (TCCP) — incorrect HS codes result in duty underpayment (penalties) or overpayment (cash flow loss)
Responsible (R): Customs Broker Coordinator
Accountable (A): Customs Broker
Duration: 30 min/PO</bpmn:documentation>
        <bpmn:incoming>W1411_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1411_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1411_Task9" name="If discrepancies found: Customs Broker Coordinator contacts vendor for…">
        <bpmn:documentation>Step 5: If discrepancies found: Customs Broker Coordinator contacts vendor for corrected documents; if vendor cannot correct before vessel arrival: Coordinator works with Customs Broker to determine if document can be corrected during customs filing or if amendment is needed post-clearance (higher risk)
Responsible (R): Customs Broker Coordinator
Accountable (A): Buyer
Duration: 15–60 min</bpmn:documentation>
        <bpmn:incoming>W1411_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1411_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1411_Task10" name="Customs Broker Coordinator delivers complete documentation package to licensed…">
        <bpmn:documentation>Step 6: Customs Broker Coordinator delivers complete documentation package to licensed Customs Broker: (a) all original documents or certified true copies, (b) import entry data pre-filled in BOC E2M system format, (c) HS code recommendations with tariff rate and duty estimate, (d) payment instructions for duties and taxes (Treasury provides fund per W232)
Responsible (R): Customs Broker Coordinator
Accountable (A): Customs Broker
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1411_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1411_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1411_Task11" name="Customs Broker files import entry with BOC through E2M system: system validates…">
        <bpmn:documentation>Step 7: Customs Broker files import entry with BOC through E2M system: system validates HS codes, calculates duties (customs duty + 12% VAT on CIF + duty + landed cost components), and generates assessment notice; Broker pays duties and taxes via BOC-accredited bank or electronic payment (ADB - Authorized Depository Bank)
Responsible (R): Customs Broker
Accountable (A): Customs Broker Coordinator
Duration: 1–2 days (filing + payment + BOC processing)</bpmn:documentation>
        <bpmn:incoming>W1411_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1411_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1411_Task12" name="BOC releases cargo (green lane: auto-release; yellow lane: document review; red…">
        <bpmn:documentation>Step 8: BOC releases cargo (green lane: auto-release; yellow lane: document review; red lane: physical examination); Coordinator tracks release status daily; if red lane: Broker coordinates physical examination with BOC examiner; examination adds 3–7 days to clearance time
Responsible (R): Customs Broker / Customs Broker Coordinator
Accountable (A): Supply Planning Manager
Duration: 1–7 days</bpmn:documentation>
        <bpmn:incoming>W1411_Flow25</bpmn:incoming>
        <bpmn:outgoing>W1411_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1411_Task13" name="Upon BOC release: Coordinator triggers port drayage and DC delivery (W1169)…">
        <bpmn:documentation>Step 9: Upon BOC release: Coordinator triggers port drayage and DC delivery (W1169); provides delivery instructions to freight forwarder with container number, DC destination, and delivery appointment; all customs documents archived in ERP document management for 10-year BIR retention (W256)
Responsible (R): Customs Broker Coordinator
Accountable (A): Logistics Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1411_Flow26</bpmn:incoming>
        <bpmn:outgoing>W1411_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1411_Task14" name="Monthly: Customs Broker Coordinator generates import compliance dashboard: (a)…">
        <bpmn:documentation>Step 10: Monthly: Customs Broker Coordinator generates import compliance dashboard: (a) average clearance time (vessel arrival to cargo release) by port of entry, (b) document completeness rate at first submission (% of POs with zero discrepancies), (c) demurrage cost incurred (from W249), (d) red lane examination frequency, (e) duty and tax payments by entity; dashboard shared with Supply Planning Manager and Controller
Responsible (R): Customs Broker Coordinator
Accountable (A): Controller
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1411_Flow27</bpmn:incoming>
        <bpmn:outgoing>W1411_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1411_End15" name="Complete">
        <bpmn:incoming>W1411_Flow28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1411_Annotation16">
        <bpmn:text>Controls: - CTL-247 (ensure controlled execution — Purchase Order Cycle (PA-03.2).) | - operational: Customs Broker Coordinator (Finance/Supply Chain) review and approval gate
Owner: Customs Broker Coordinator (Finance/Supply Chain)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1411_Assoc17" sourceRef="W1411_Annotation16" targetRef="W1411_Start4" associationDirection="None" />
