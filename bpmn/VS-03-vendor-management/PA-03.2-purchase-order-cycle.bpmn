    <bpmn:process id="W_W2C" name="W2C. Blanket Purchase Orders" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor disputes rebate settlement amount calculated by BuildRight&#x27;s system (W27 step 6)
Frequency: Occasional — estimated 5–10 disputes/year
Volume: Primarily with the top 20 vendors by spend (the top-20 = 45% of COGS concentration canon); typically covers 20–60% of purchasing volume for staple categories (cement, paint, lumber, electrical cable, plumbing fittings)
Owner: Buyer
Participants: Buyer, Category Manager, Cost Accountant, Finance Manager
Source: workflow W2C — Blanket Purchase Orders</bpmn:documentation>
      <bpmn:laneSet id="W2C_LaneSet9">
        <bpmn:lane id="W2C_Lane1" name="Buyer">
        <bpmn:flowNodeRef>W2C_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2C_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2C_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2C_Task20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2C_Task23</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2C_Task24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2C_Task25</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2C_Task26</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2C_Start10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2C_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W2C_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2C_Lane3" name="Controller">
        <bpmn:flowNodeRef>W2C_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2C_Lane4" name="System">
        <bpmn:flowNodeRef>W2C_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2C_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2C_Task19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2C_Task22</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2C_Lane5" name="Vendor">
        <bpmn:flowNodeRef>W2C_Task18</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2C_Lane6" name="Buyer + Category Manager">
        <bpmn:flowNodeRef>W2C_Task21</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2C_Lane7" name="Finance Manager">
        <bpmn:flowNodeRef>W2C_Task27</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2C_Lane8" name="Cost Accountant">
        <bpmn:flowNodeRef>W2C_Task28</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2C_End29</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2C_Start10" name="Vendor disputes rebate settlement amount calculated by BuildRight&#x27;s system (W27 step 6)">
        <bpmn:outgoing>W2C_Flow32</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2C_Task11" name="Buyer negotiates annual supply agreement with vendor: product range, pricing…">
        <bpmn:documentation>Step 1: Buyer negotiates annual supply agreement with vendor: product range, pricing tiers, minimum/maximum commitment quantities, delivery schedule, payment terms, rebate structure
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 4–8 hours/vendor</bpmn:documentation>
        <bpmn:incoming>W2C_Flow32</bpmn:incoming>
        <bpmn:outgoing>W2C_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2C_Task12" name="Category Manager approves contract terms; VP Merchandising approves if total…">
        <bpmn:documentation>Step 2: Category Manager approves contract terms; VP Merchandising approves if total contract value &gt; PHP 5M
Responsible (R): Category Manager / VP
Accountable (A): VP Merchandising
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W2C_Flow33</bpmn:incoming>
        <bpmn:outgoing>W2C_Flow34</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2C_Task13" name="Finance validates contract commitment against annual purchase budget">
        <bpmn:documentation>Step 3: Finance validates contract commitment against annual purchase budget
Responsible (R): Controller
Accountable (A): CFO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W2C_Flow34</bpmn:incoming>
        <bpmn:outgoing>W2C_Flow35</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2C_Task14" name="Buyer creates Blanket PO in system: vendor, SKU lines with contract price…">
        <bpmn:documentation>Step 4: Buyer creates Blanket PO in system: vendor, SKU lines with contract price, validity period (typically 1 year), min/max commitment quantities, agreed delivery schedule or release parameters
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W2C_Flow35</bpmn:incoming>
        <bpmn:outgoing>W2C_Flow36</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2C_Task15" name="System enforces contract pricing on all release orders; alerts Buyer if release…">
        <bpmn:documentation>Step 5: System enforces contract pricing on all release orders; alerts Buyer if release quantity would exceed maximum commitment
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2C_Flow36</bpmn:incoming>
        <bpmn:outgoing>W2C_Flow37</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W2C_Task16" name="Buyer or system creates Release Order against Blanket PO (per agreed schedule…">
        <bpmn:documentation>Step 6: Buyer or system creates Release Order against Blanket PO (per agreed schedule or triggered by ROP): specifies exact quantity and delivery date for this release
Responsible (R): Buyer / System
Accountable (A): Buyer
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W2C_Flow37</bpmn:incoming>
        <bpmn:outgoing>W2C_Flow38</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W2C_Task17" name="Release Order follows standard PO approval (W2A.5–6) if release value exceeds…">
        <bpmn:documentation>Step 7: Release Order follows standard PO approval (W2A.5–6) if release value exceeds threshold; otherwise auto-approved within contract parameters
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2C_Flow38</bpmn:incoming>
        <bpmn:outgoing>W2C_Flow39</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2C_Task18" name="Vendor ships per release order; standard receiving (W3) and AP matching (W7)…">
        <bpmn:documentation>Step 8: Vendor ships per release order; standard receiving (W3) and AP matching (W7) apply
Responsible (R): Vendor
Accountable (A): Buyer
Duration: Per W3/W7</bpmn:documentation>
        <bpmn:incoming>W2C_Flow39</bpmn:incoming>
        <bpmn:outgoing>W2C_Flow40</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2C_Task19" name="System tracks cumulative released quantity and value against contract…">
        <bpmn:documentation>Step 9: System tracks cumulative released quantity and value against contract commitment; Buyer monitors to ensure min-commit targets are met
Responsible (R): System
Accountable (A): Buyer
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2C_Flow40</bpmn:incoming>
        <bpmn:outgoing>W2C_Flow41</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2C_Task20" name="Monthly: Buyer reviews contract utilization report; identifies contracts below…">
        <bpmn:documentation>Step 10: Monthly: Buyer reviews contract utilization report; identifies contracts below minimum commitment pace (risk of penalty or unfavorable renegotiation)
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W2C_Flow41</bpmn:incoming>
        <bpmn:outgoing>W2C_Flow42</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2C_Task21" name="Quarterly: Buyer and Category Manager evaluate contract performance vs. spot…">
        <bpmn:documentation>Step 11: Quarterly: Buyer and Category Manager evaluate contract performance vs. spot buying; decide renewal, renegotiation, or termination
Responsible (R): Buyer + Category Manager
Accountable (A): VP Merchandising
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W2C_Flow42</bpmn:incoming>
        <bpmn:outgoing>W2C_Flow43</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2C_Task22" name="At contract expiry: system alerts Buyer 60 days before; if not renewed, system…">
        <bpmn:documentation>Step 12: At contract expiry: system alerts Buyer 60 days before; if not renewed, system blocks further release orders
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2C_Flow43</bpmn:incoming>
        <bpmn:outgoing>W2C_Flow44</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2C_Task23" name="Vendor disputes settlement amount: Buyer receives vendor&#x27;s written objection…">
        <bpmn:documentation>Step 13: Vendor disputes settlement amount: Buyer receives vendor&#x27;s written objection with vendor&#x27;s calculation
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W2C_Flow44</bpmn:incoming>
        <bpmn:outgoing>W2C_Flow45</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2C_Task24" name="Buyer and Cost Accountant jointly review: compare BuildRight&#x27;s settlement data…">
        <bpmn:documentation>Step 14: Buyer and Cost Accountant jointly review: compare BuildRight&#x27;s settlement data (qualifying volume, rebate rate applied) to vendor&#x27;s claim; identify specific discrepancy (volume count difference, rate tier interpretation, timing gap, excluded transactions)
Responsible (R): Buyer / Cost Accountant
Accountable (A): Category Manager
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W2C_Flow45</bpmn:incoming>
        <bpmn:outgoing>W2C_Flow46</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2C_Task25" name="If BuildRight calculation confirmed correct: Buyer responds to vendor with…">
        <bpmn:documentation>Step 15: If BuildRight calculation confirmed correct: Buyer responds to vendor with supporting data; dispute closed; no settlement adjustment
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W2C_Flow46</bpmn:incoming>
        <bpmn:outgoing>W2C_Flow47</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2C_Task26" name="If partial vendor claim valid: Buyer proposes adjusted settlement; Category…">
        <bpmn:documentation>Step 16: If partial vendor claim valid: Buyer proposes adjusted settlement; Category Manager approves adjustment; Cost Accountant posts adjustment with Category Manager approval and documentation in system
Responsible (R): Buyer / Category Manager / Cost Accountant
Accountable (A): Finance Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W2C_Flow47</bpmn:incoming>
        <bpmn:outgoing>W2C_Flow48</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2C_Task27" name="If dispute unresolved within 15 business days: Buyer escalates to Finance…">
        <bpmn:documentation>Step 17: If dispute unresolved within 15 business days: Buyer escalates to Finance Manager for mediation; Finance Manager reviews both calculations and makes binding recommendation within 5 business days
Responsible (R): Finance Manager
Accountable (A): CFO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W2C_Flow48</bpmn:incoming>
        <bpmn:outgoing>W2C_Flow49</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2C_Task28" name="Monthly: Cost Accountant tracks rebate dispute frequency and resolution time…">
        <bpmn:documentation>Step 18: Monthly: Cost Accountant tracks rebate dispute frequency and resolution time per vendor; feeds into vendor scorecard (W44); chronic disputing vendors flagged for contract renegotiation (W2C)
Responsible (R): Cost Accountant
Accountable (A): Controller
Duration: 15 min/month</bpmn:documentation>
        <bpmn:incoming>W2C_Flow49</bpmn:incoming>
        <bpmn:outgoing>W2C_Flow50</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2C_End29" name="Complete">
        <bpmn:incoming>W2C_Flow50</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2C_Annotation30">
        <bpmn:text>Controls: - CTL-247 (ensure controlled execution — Purchase Order Cycle (PA-03.2).) | - operational: Buyer review and approval gate
Owner: Buyer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2C_Assoc31" sourceRef="W2C_Annotation30" targetRef="W2C_Start10" associationDirection="None" />
