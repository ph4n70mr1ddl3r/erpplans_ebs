    <bpmn:process id="W_W2B" name="W2B. Import Purchase Orders" isExecutable="false">
      <bpmn:documentation>Trigger: Seasonal buy plan or replenishment of import SKUs
Frequency: ~20–30 import POs/month
Volume: ~400–600 TEUs/month across all import vendors (per model-company-profile §7.1); ~15–25 TEUs per major import PO
Owner: Buyer (with Import Coordinator)
Participants: Buyer, Import Coordinator, Finance (LC), Customs Broker, Warehouse (receiving), Purchasing / PO Specialist
Source: workflow W2B — Import Purchase Orders</bpmn:documentation>
      <bpmn:laneSet id="W2B_LaneSet9">
        <bpmn:lane id="W2B_Lane1" name="Buyer">
        <bpmn:flowNodeRef>W2B_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2B_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2B_Start10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2B_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W2B_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2B_Lane3" name="Treasury Analyst">
        <bpmn:flowNodeRef>W2B_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2B_Task23</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2B_Lane4" name="Import Coordinator">
        <bpmn:flowNodeRef>W2B_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2B_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2B_Task19</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2B_Lane5" name="Vendor">
        <bpmn:flowNodeRef>W2B_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2B_Lane6" name="Customs Broker">
        <bpmn:flowNodeRef>W2B_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2B_Task20</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2B_Lane7" name="Receiving Clerk">
        <bpmn:flowNodeRef>W2B_Task21</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2B_Lane8" name="System">
        <bpmn:flowNodeRef>W2B_Task22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2B_End24</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2B_Start10" name="Seasonal buy plan or replenishment of import SKUs">
        <bpmn:outgoing>W2B_Flow27</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2B_Task11" name="Buyer creates import PO with estimated landed cost (FOB + freight + duty +…">
        <bpmn:documentation>Step 1: Buyer creates import PO with estimated landed cost (FOB + freight + duty + insurance)
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 30 min/PO</bpmn:documentation>
        <bpmn:incoming>W2B_Flow27</bpmn:incoming>
        <bpmn:outgoing>W2B_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2B_Task12" name="Route for approval (&gt; PHP 50K → Category Manager; &gt; PHP 500K → VP…">
        <bpmn:documentation>Step 2: Route for approval (&gt; PHP 50K → Category Manager; &gt; PHP 500K → VP Merchandising; &gt; PHP 2M → CFO)
Responsible (R): Category Manager / VP / CFO
Accountable (A): As per tier
Duration: 15–30 min/PO</bpmn:documentation>
        <bpmn:incoming>W2B_Flow28</bpmn:incoming>
        <bpmn:outgoing>W2B_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2B_Task13" name="Finance opens Letter of Credit (LC) with bank or arranges TT payment">
        <bpmn:documentation>Step 3: Finance opens Letter of Credit (LC) with bank or arranges TT payment
Responsible (R): Treasury Analyst
Accountable (A): CFO
Duration: 1–2 hours/PO</bpmn:documentation>
        <bpmn:incoming>W2B_Flow29</bpmn:incoming>
        <bpmn:outgoing>W2B_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2B_Task14" name="Buyer confirms order with vendor; vendor provides Proforma Invoice">
        <bpmn:documentation>Step 4: Buyer confirms order with vendor; vendor provides Proforma Invoice
Responsible (R): Buyer
Accountable (A): Buyer
Duration: 30 min/PO</bpmn:documentation>
        <bpmn:incoming>W2B_Flow30</bpmn:incoming>
        <bpmn:outgoing>W2B_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2B_Task15" name="Import Coordinator arranges freight booking (container)">
        <bpmn:documentation>Step 5: Import Coordinator arranges freight booking (container)
Responsible (R): Import Coordinator
Accountable (A): Buyer
Duration: 1 hour/PO</bpmn:documentation>
        <bpmn:incoming>W2B_Flow31</bpmn:incoming>
        <bpmn:outgoing>W2B_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2B_Task16" name="Vendor ships; provides Bill of Lading (BL), Packing List, Commercial Invoice">
        <bpmn:documentation>Step 6: Vendor ships; provides Bill of Lading (BL), Packing List, Commercial Invoice
Responsible (R): Vendor
Accountable (A): —
Duration: External</bpmn:documentation>
        <bpmn:incoming>W2B_Flow32</bpmn:incoming>
        <bpmn:outgoing>W2B_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2B_Task17" name="Import Coordinator receives shipping docs; engages customs broker">
        <bpmn:documentation>Step 7: Import Coordinator receives shipping docs; engages customs broker
Responsible (R): Import Coordinator
Accountable (A): Import Coordinator
Duration: 1 hour/PO</bpmn:documentation>
        <bpmn:incoming>W2B_Flow33</bpmn:incoming>
        <bpmn:outgoing>W2B_Flow34</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2B_Task18" name="Customs broker files import entry; pays duties/taxes">
        <bpmn:documentation>Step 8: Customs broker files import entry; pays duties/taxes
Responsible (R): Customs Broker
Accountable (A): Import Coordinator
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2B_Flow34</bpmn:incoming>
        <bpmn:outgoing>W2B_Flow35</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2B_Task19" name="Import Coordinator tracks shipment status; updates ETA in system">
        <bpmn:documentation>Step 9: Import Coordinator tracks shipment status; updates ETA in system
Responsible (R): Import Coordinator
Accountable (A): Buyer
Duration: 15 min/day per PO</bpmn:documentation>
        <bpmn:incoming>W2B_Flow35</bpmn:incoming>
        <bpmn:outgoing>W2B_Flow36</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2B_Task20" name="Goods arrive at port; customs clearance and release">
        <bpmn:documentation>Step 10: Goods arrive at port; customs clearance and release
Responsible (R): Customs Broker
Accountable (A): Import Coordinator
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W2B_Flow36</bpmn:incoming>
        <bpmn:outgoing>W2B_Flow37</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2B_Task21" name="Transport to DC; Receiving clerk processes Goods Receipt">
        <bpmn:documentation>Step 11: Transport to DC; Receiving clerk processes Goods Receipt
Responsible (R): Receiving Clerk (DC)
Accountable (A): DC Manager
Duration: 2–4 hours/container</bpmn:documentation>
        <bpmn:incoming>W2B_Flow37</bpmn:incoming>
        <bpmn:outgoing>W2B_Flow38</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2B_Task22" name="System calculates actual landed cost (duty, freight, insurance allocated per…">
        <bpmn:documentation>Step 12: System calculates actual landed cost (duty, freight, insurance allocated per SKU) using GR exchange rate
Responsible (R): System
Accountable (A): Finance
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2B_Flow38</bpmn:incoming>
        <bpmn:outgoing>W2B_Flow39</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2B_Task23" name="Finance reconciles LC/TT payment with PO and Goods Receipt; system posts FX…">
        <bpmn:documentation>Step 13: Finance reconciles LC/TT payment with PO and Goods Receipt; system posts FX gain/loss if invoice rate differs from GR rate
Responsible (R): Treasury Analyst
Accountable (A): CFO
Duration: 30 min/PO</bpmn:documentation>
        <bpmn:incoming>W2B_Flow39</bpmn:incoming>
        <bpmn:outgoing>W2B_Flow40</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2B_End24" name="Complete">
        <bpmn:incoming>W2B_Flow40</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2B_Annotation25">
        <bpmn:text>Controls: (none recorded)
Owner: Buyer (with Import Coordinator)</bpmn:text>
      </bpmn:textAnnotation>
