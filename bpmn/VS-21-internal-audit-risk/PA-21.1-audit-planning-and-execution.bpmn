        <bpmn:flowNodeRef>W333_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W333_Lane4" name="Head of IA">
        <bpmn:flowNodeRef>W333_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W333_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W333_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W333_Start6" name="Finalized Audit Report with findings and CAPs">
        <bpmn:outgoing>W333_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W333_Task7" name="Log all findings, Corrective Action Plans (CAPs), owners, and due dates into…">
        <bpmn:documentation>Step 1: Log all findings, Corrective Action Plans (CAPs), owners, and due dates into the in-house Audit &amp; GRC platform (BUILD — fit-gap H11)
Responsible (R): Audit Team
Accountable (A): Head of IA
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W333_Flow16</bpmn:incoming>
        <bpmn:outgoing>W333_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W333_Task8" name="Send automated reminders to Action Owners 14 days and 7 days prior to CAP…">
        <bpmn:documentation>Step 2: Send automated reminders to Action Owners 14 days and 7 days prior to CAP deadline
Responsible (R): System
Accountable (A): Internal Audit
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W333_Flow17</bpmn:incoming>
        <bpmn:outgoing>W333_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W333_Task9" name="Action Owner submits evidence of remediation to Internal Audit">
        <bpmn:documentation>Step 3: Action Owner submits evidence of remediation to Internal Audit
Responsible (R): Action Owner
Accountable (A): Action Owner
Duration: Variable</bpmn:documentation>
        <bpmn:incoming>W333_Flow18</bpmn:incoming>
        <bpmn:outgoing>W333_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W333_Task10" name="Perform follow-up testing (re-audit) to validate that the control is operating…">
        <bpmn:documentation>Step 4: Perform follow-up testing (re-audit) to validate that the control is operating effectively
Responsible (R): Audit Team
Accountable (A): Head of IA
Duration: 2–5 days</bpmn:documentation>
        <bpmn:incoming>W333_Flow19</bpmn:incoming>
        <bpmn:outgoing>W333_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W333_Task11" name="Close finding if validated; escalate to Executive Team if CAP is delayed or…">
        <bpmn:documentation>Step 5: Close finding if validated; escalate to Executive Team if CAP is delayed or evidence is insufficient
Responsible (R): Head of IA
Accountable (A): CEO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W333_Flow20</bpmn:incoming>
        <bpmn:outgoing>W333_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W333_Task12" name="Generate quarterly Open Issues Report for the Board Audit Committee…">
        <bpmn:documentation>Step 6: Generate quarterly Open Issues Report for the Board Audit Committee, highlighting overdue high-risk findings
Responsible (R): Head of IA
Accountable (A): Audit Committee
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W333_Flow21</bpmn:incoming>
        <bpmn:outgoing>W333_Flow22</bpmn:outgoing>
      </bpmn:userTask>
