      <bpmn:userTask id="W351_Task6" name="PBC Tracking">
        <bpmn:documentation>Step 1: PBC Tracking: Manage the &quot;Prepared by Client&quot; list and ensure timely data submission
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W351_Flow14</bpmn:incoming>
        <bpmn:outgoing>W351_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W351_Task7" name="Walkthrough Coordination">
        <bpmn:documentation>Step 2: Walkthrough Coordination: Facilitate meetings between External Auditors and BPOs
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W351_Flow15</bpmn:incoming>
        <bpmn:outgoing>W351_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W351_Task8" name="Adjustment Review">
        <bpmn:documentation>Step 3: Adjustment Review: Review proposed audit adjustments for materiality and accuracy
Responsible (R): Head of IA
Accountable (A): CFO
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W351_Flow16</bpmn:incoming>
        <bpmn:outgoing>W351_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W351_Task9" name="Statutory Filing">
        <bpmn:documentation>Step 4: Statutory Filing: Verify timely filing of Audited Financial Statements (AFS) with SEC/BIR
Responsible (R): Auditor
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W351_Flow17</bpmn:incoming>
        <bpmn:outgoing>W351_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W351_Task10" name="GIS Filing">
        <bpmn:documentation>Step 5: GIS Filing: Verify accuracy of the General Information Sheet (GIS) submitted to SEC
Responsible (R): Legal
Accountable (A): Head of IA
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W351_Flow18</bpmn:incoming>
        <bpmn:outgoing>W351_Flow19</bpmn:outgoing>
      </bpmn:userTask>
