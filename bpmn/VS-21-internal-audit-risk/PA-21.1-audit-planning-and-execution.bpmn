    <bpmn:process id="W_W338" name="W338. Segregation of Duties (SOD) Review &amp; Remediation" isExecutable="false">
      <bpmn:documentation>Trigger: Semi-annual review or major system change
Frequency: Semi-annual
Volume: Review of ~1,000–1,500 system users
Owner: IT Auditor / Head of IA
Participants: IT Manager, Business Process Owners (BPO), CIO
Source: workflow W338 — Segregation of Duties (SOD) Review &amp; Remediation</bpmn:documentation>
      <bpmn:laneSet id="W338_LaneSet6">
        <bpmn:lane id="W338_Lane1" name="IT Auditor">
        <bpmn:flowNodeRef>W338_Task8</bpmn:flowNodeRef>
