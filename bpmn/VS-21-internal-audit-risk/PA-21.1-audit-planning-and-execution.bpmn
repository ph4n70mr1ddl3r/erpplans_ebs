    <bpmn:process id="W_W361" name="W361. Corporate Treasury, Cash Management &amp; Investment Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Annual audit plan
Frequency: Annual
Volume: Covers all bank accounts, debt facilities, and investment portfolios
Owner: Internal Audit / Senior Auditor
Participants: Treasury Manager, CFO, Banking Partners
Source: workflow W361 — Corporate Treasury, Cash Management &amp; Investment Audit</bpmn:documentation>
      <bpmn:laneSet id="W361_LaneSet3">
        <bpmn:lane id="W361_Lane1" name="Auditor">
        <bpmn:flowNodeRef>W361_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W361_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W361_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W361_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W361_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W361_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W361_Lane2" name="IT Auditor">
        <bpmn:flowNodeRef>W361_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W361_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W361_Start4" name="Annual audit plan">
        <bpmn:outgoing>W361_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W361_Task5" name="Policy Compliance Review">
        <bpmn:documentation>Step 1: Policy Compliance Review: Verify that all treasury activities (W233, W318, W319) comply with the Board-approved Treasury Policy
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W361_Flow14</bpmn:incoming>
        <bpmn:outgoing>W361_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W361_Task6" name="Bank Mandate Audit">
        <bpmn:documentation>Step 2: Bank Mandate Audit: Verify bank signatories (W317) are current and authorized by Board Resolution
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W361_Flow15</bpmn:incoming>
        <bpmn:outgoing>W361_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W361_Task7" name="Liquidity Forecast Test">
        <bpmn:documentation>Step 3: Liquidity Forecast Test: Audit the accuracy of cash flow forecasts (W233) vs. actual movements
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W361_Flow16</bpmn:incoming>
        <bpmn:outgoing>W361_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W361_Task8" name="Investment Valuation">
        <bpmn:documentation>Step 4: Investment Valuation: Verify physical/digital existence of surplus cash investments (W318) and correct valuation
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W361_Flow17</bpmn:incoming>
        <bpmn:outgoing>W361_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W361_Task9" name="Debt &amp; Covenant Audit">
        <bpmn:documentation>Step 5: Debt &amp; Covenant Audit: Verify compliance with all bank covenants for active debt facilities (W319)
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W361_Flow18</bpmn:incoming>
        <bpmn:outgoing>W361_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W361_Task10" name="Payment Security Test">
