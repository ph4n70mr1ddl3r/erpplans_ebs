Responsible (R): IT Auditor
Accountable (A): Head of IA
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W331_Flow17</bpmn:incoming>
        <bpmn:outgoing>W331_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W331_Task8" name="Execute Change Management testing: Sample ERP changes to verify approval…">
