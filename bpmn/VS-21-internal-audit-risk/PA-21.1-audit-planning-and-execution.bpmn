    <bpmn:process id="W_W363" name="W363. Insurance Program &amp; Claims Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Annual audit plan (post-renewal season)
Frequency: Annual
Volume: ~10–15 major policies (Property, Marine, D&amp;O, Cyber)
Owner: Internal Audit
Participants: Risk Manager, Legal, Finance, Insurance Broker
Source: workflow W363 — Insurance Program &amp; Claims Audit</bpmn:documentation>
      <bpmn:laneSet id="W363_LaneSet2">
        <bpmn:lane id="W363_Lane1" name="Auditor">
        <bpmn:flowNodeRef>W363_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W363_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W363_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W363_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W363_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W363_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W363_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W363_Start3" name="Annual audit plan (post-renewal season)">
        <bpmn:outgoing>W363_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W363_Task4" name="Coverage Gap Analysis">
        <bpmn:documentation>Step 1: Coverage Gap Analysis: Compare current insurance policies (W59) against the Enterprise Risk Register (W122) to identify uninsured risks
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W363_Flow12</bpmn:incoming>
        <bpmn:outgoing>W363_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W363_Task5" name="Asset Valuation Audit">
        <bpmn:documentation>Step 2: Asset Valuation Audit: Verify that declared values for property and inventory (W59) match latest ERP balances
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W363_Flow13</bpmn:incoming>
        <bpmn:outgoing>W363_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W363_Task6" name="Premium Audit">
        <bpmn:documentation>Step 3: Premium Audit: Reconcile insurance premium payments in AP (W7) to signed policy contracts
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W363_Flow14</bpmn:incoming>
        <bpmn:outgoing>W363_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W363_Task7" name="Claims Integrity">
        <bpmn:documentation>Step 4: Claims Integrity: Sample insurance claims (W285) to verify they were filed timely and proceeds were correctly accounted for
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W363_Flow15</bpmn:incoming>
        <bpmn:outgoing>W363_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W363_Task8" name="Broker Performance Review">
        <bpmn:documentation>Step 5: Broker Performance Review: Review broker selection process and adherence to service level agreements
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W363_Flow16</bpmn:incoming>
        <bpmn:outgoing>W363_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W363_End9" name="Complete">
        <bpmn:incoming>W363_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W363_Annotation10">
        <bpmn:text>Controls: - CTL-304 (ensure controlled execution — Audit Planning &amp; Execution (PA-21.1).) | - operational: Internal Audit review and approval gate; periodic reconciliation against source documents
Owner: Internal Audit</bpmn:text>
      </bpmn:textAnnotation>
