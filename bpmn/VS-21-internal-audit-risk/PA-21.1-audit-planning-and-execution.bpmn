Responsible (R): IT Auditor
Accountable (A): Head of IA
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W338_Flow20</bpmn:incoming>
        <bpmn:outgoing>W338_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W338_Task11" name="Review exceptions with Business Process Owners; define remediation (remove…">
