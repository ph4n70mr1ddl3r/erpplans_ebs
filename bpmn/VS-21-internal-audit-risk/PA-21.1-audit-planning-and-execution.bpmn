    <bpmn:process id="W_W120" name="W120. Internal Audit Planning &amp; Risk Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: Annual planning cycle
Frequency: Annual (with quarterly updates)
Volume: ~30–40 high-priority audits planned per year
Owner: Head of Internal Audit
Participants: Audit Team, Board Audit Committee, CEO, CFO
Source: workflow W120 — Internal Audit Planning &amp; Risk Assessment</bpmn:documentation>
      <bpmn:laneSet id="W120_LaneSet3">
        <bpmn:lane id="W120_Lane1" name="Audit Team">
        <bpmn:flowNodeRef>W120_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W120_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W120_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W120_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W120_Lane2" name="Head of IA">
        <bpmn:flowNodeRef>W120_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W120_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W120_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W120_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W120_Start4" name="Annual planning cycle">
        <bpmn:outgoing>W120_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W120_Task5" name="Gather data on risk indicators: shrinkage (W92), margin exceptions (W85), high…">
        <bpmn:documentation>Step 1: Gather data on risk indicators: shrinkage (W92), margin exceptions (W85), high turnover
Responsible (R): Audit Team
Accountable (A): Head of IA
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W120_Flow14</bpmn:incoming>
        <bpmn:outgoing>W120_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W120_Task6" name="Survey department heads on process risks and control weaknesses">
        <bpmn:documentation>Step 2: Survey department heads on process risks and control weaknesses
Responsible (R): Audit Team
Accountable (A): Head of IA
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W120_Flow15</bpmn:incoming>
        <bpmn:outgoing>W120_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W120_Task7" name="Rank entities/processes by risk score (Impact x Likelihood)">
        <bpmn:documentation>Step 3: Rank entities/processes by risk score (Impact x Likelihood)
Responsible (R): Head of IA
Accountable (A): Head of IA
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W120_Flow16</bpmn:incoming>
        <bpmn:outgoing>W120_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W120_Task8" name="Develop Annual Audit Plan (list of stores, DCs, and processes to be audited)">
        <bpmn:documentation>Step 4: Develop Annual Audit Plan (list of stores, DCs, and processes to be audited)
Responsible (R): Head of IA
Accountable (A): CEO
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W120_Flow17</bpmn:incoming>
        <bpmn:outgoing>W120_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W120_Task9" name="Present plan to Board Audit Committee for final approval">
        <bpmn:documentation>Step 5: Present plan to Board Audit Committee for final approval
Responsible (R): Head of IA
Accountable (A): Audit Committee
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W120_Flow18</bpmn:incoming>
        <bpmn:outgoing>W120_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W120_Task10" name="Allocate audit staff and timeline in the in-house Audit &amp; GRC platform (BUILD —…">
        <bpmn:documentation>Step 6: Allocate audit staff and timeline in the in-house Audit &amp; GRC platform (BUILD — fit-gap H11)
Responsible (R): Audit Team
Accountable (A): Head of IA
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W120_Flow19</bpmn:incoming>
        <bpmn:outgoing>W120_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W120_End11" name="Complete">
        <bpmn:incoming>W120_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W120_Annotation12">
        <bpmn:text>Controls: - CTL-304 (ensure controlled execution — Audit Planning &amp; Execution (PA-21.1).) | - operational: Head of Internal Audit review and approval gate
Owner: Head of Internal Audit</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W120_Assoc13" sourceRef="W120_Annotation12" targetRef="W120_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W120_Flow14" sourceRef="W120_Start4" targetRef="W120_Task5" />
      <bpmn:sequenceFlow id="W120_Flow15" sourceRef="W120_Task5" targetRef="W120_Task6" />
      <bpmn:sequenceFlow id="W120_Flow16" sourceRef="W120_Task6" targetRef="W120_Task7" />
      <bpmn:sequenceFlow id="W120_Flow17" sourceRef="W120_Task7" targetRef="W120_Task8" />
      <bpmn:sequenceFlow id="W120_Flow18" sourceRef="W120_Task8" targetRef="W120_Task9" />
      <bpmn:sequenceFlow id="W120_Flow19" sourceRef="W120_Task9" targetRef="W120_Task10" />
      <bpmn:sequenceFlow id="W120_Flow20" sourceRef="W120_Task10" targetRef="W120_End11" />
    </bpmn:process>
