        <bpmn:outgoing>W334_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W334_Task6" name="Identify critical vendors (IT services, data hosting, major supply chain…">
        <bpmn:documentation>Step 1: Identify critical vendors (IT services, data hosting, major supply chain partners)
Responsible (R): Audit Team
Accountable (A): Head of IA
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W334_Flow15</bpmn:incoming>
        <bpmn:outgoing>W334_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W334_Task7" name="Request and review SOC 2 reports, ISO 27001 certifications, and SLA performance">
        <bpmn:documentation>Step 2: Request and review SOC 2 reports, ISO 27001 certifications, and SLA performance
Responsible (R): Audit Team
Accountable (A): Head of IA
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W334_Flow16</bpmn:incoming>
        <bpmn:outgoing>W334_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W334_Task8" name="Conduct on-site or remote vendor control audit and process walkthrough">
        <bpmn:documentation>Step 3: Conduct on-site or remote vendor control audit and process walkthrough
Responsible (R): Audit Team
Accountable (A): Head of IA
Duration: 3-5 days</bpmn:documentation>
        <bpmn:incoming>W334_Flow17</bpmn:incoming>
        <bpmn:outgoing>W334_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W334_Task9" name="Evaluate data privacy compliance (DPA) and IT security practices of vendor">
        <bpmn:documentation>Step 4: Evaluate data privacy compliance (DPA) and IT security practices of vendor
Responsible (R): IT Auditor
Accountable (A): Head of IA
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W334_Flow18</bpmn:incoming>
        <bpmn:outgoing>W334_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W334_Task10" name="Issue Vendor Audit Report with identified control gaps and remediation requests">
        <bpmn:documentation>Step 5: Issue Vendor Audit Report with identified control gaps and remediation requests
Responsible (R): Audit Team
Accountable (A): Head of IA
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W334_Flow19</bpmn:incoming>
        <bpmn:outgoing>W334_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W334_Task11" name="Track vendor CAPs; suspend vendor contract if critical vulnerabilities remain…">
        <bpmn:documentation>Step 6: Track vendor CAPs; suspend vendor contract if critical vulnerabilities remain unresolved
Responsible (R): Procurement
Accountable (A): VP Legal
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W334_Flow20</bpmn:incoming>
        <bpmn:outgoing>W334_Flow21</bpmn:outgoing>
      </bpmn:userTask>
