Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W340_Flow18</bpmn:incoming>
        <bpmn:outgoing>W340_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W340_Task9" name="Review manager overrides for the last 7 days: Voids, refunds, price changes">
        <bpmn:documentation>Step 6: Review manager overrides for the last 7 days: Voids, refunds, price changes
Responsible (R): Auditor
Accountable (A): Store Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W340_Flow19</bpmn:incoming>
        <bpmn:outgoing>W340_Flow20</bpmn:outgoing>
      </bpmn:userTask>
