    <bpmn:process id="W_W334" name="W334. Third-Party Vendor Risk &amp; Compliance Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Annual audit plan or high-risk vendor onboarding
Frequency: Annual
Volume: Top 15-20 critical/high-risk vendors audited per year
Owner: Internal Audit
Participants: Procurement, Information Security, Legal, Vendor
Source: workflow W334 — Third-Party Vendor Risk &amp; Compliance Audit</bpmn:documentation>
