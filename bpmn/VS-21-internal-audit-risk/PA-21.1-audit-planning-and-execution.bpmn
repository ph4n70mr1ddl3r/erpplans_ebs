        <bpmn:outgoing>W340_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W340_Task5" name="Count cash in vault, petty cash float, and all active registers">
        <bpmn:documentation>Step 2: Count cash in vault, petty cash float, and all active registers
Responsible (R): Auditor
Accountable (A): Store Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W340_Flow15</bpmn:incoming>
        <bpmn:outgoing>W340_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W340_Task6" name="Pull real-time &quot;Cash-in-Drawer&quot; reports from POS and vault balances from ERP">
        <bpmn:documentation>Step 3: Pull real-time &quot;Cash-in-Drawer&quot; reports from POS and vault balances from ERP
Responsible (R): Auditor
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W340_Flow16</bpmn:incoming>
        <bpmn:outgoing>W340_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W340_Task7" name="Reconcile physical count vs. system balance; identify shortages/overages">
        <bpmn:documentation>Step 4: Reconcile physical count vs. system balance; identify shortages/overages
Responsible (R): Auditor
Accountable (A): Store Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W340_Flow17</bpmn:incoming>
        <bpmn:outgoing>W340_Flow18</bpmn:outgoing>
      </bpmn:userTask>
