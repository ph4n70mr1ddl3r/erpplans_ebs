Accountable (A): CIO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W331_Flow16</bpmn:incoming>
        <bpmn:outgoing>W331_Flow17</bpmn:outgoing>
      </bpmn:userTask>
