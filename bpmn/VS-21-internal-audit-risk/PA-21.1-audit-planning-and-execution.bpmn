    <bpmn:process id="W_W121" name="W121. Operational Audit Execution (Store/DC/HQ)" isExecutable="false">
      <bpmn:documentation>Trigger: Approved Audit Plan (W120) or special request from CEO
Frequency: Monthly (rotational)
Volume: ~3–4 audits executed per month
Owner: Senior Internal Auditor
Participants: Audit Team, Store/DC Manager (Auditee)
Source: workflow W121 — Operational Audit Execution (Store/DC/HQ)</bpmn:documentation>
      <bpmn:laneSet id="W121_LaneSet5">
        <bpmn:lane id="W121_Lane1" name="Audit Team">
        <bpmn:flowNodeRef>W121_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W121_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W121_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W121_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W121_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W121_Lane2" name="Senior Auditor">
        <bpmn:flowNodeRef>W121_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W121_Lane3" name="Auditee">
        <bpmn:flowNodeRef>W121_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W121_Lane4" name="Head of IA">
        <bpmn:flowNodeRef>W121_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W121_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W121_Start6" name="Approved Audit Plan (W120) or special request from CEO">
        <bpmn:outgoing>W121_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W121_Task7" name="Announcement of audit (or unannounced for cash/inventory checks)">
        <bpmn:documentation>Step 1: Announcement of audit (or unannounced for cash/inventory checks)
Responsible (R): Audit Team
Accountable (A): Head of IA
Duration: —</bpmn:documentation>
        <bpmn:incoming>W121_Flow17</bpmn:incoming>
        <bpmn:outgoing>W121_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W121_Task8" name="Fieldwork: Test controls for POS (W5), Inventory (W4), Petty Cash (W25), LP…">
        <bpmn:documentation>Step 2: Fieldwork: Test controls for POS (W5), Inventory (W4), Petty Cash (W25), LP (W37)
Responsible (R): Audit Team
Accountable (A): Senior Auditor
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W121_Flow18</bpmn:incoming>
        <bpmn:outgoing>W121_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W121_Task9" name="Identify discrepancies: Missing documents, unauthorized overrides, stock…">
        <bpmn:documentation>Step 3: Identify discrepancies: Missing documents, unauthorized overrides, stock variance
Responsible (R): Audit Team
Accountable (A): Senior Auditor
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W121_Flow19</bpmn:incoming>
        <bpmn:outgoing>W121_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W121_Task10" name="Exit Meeting: Discuss preliminary findings with the Auditee">
        <bpmn:documentation>Step 4: Exit Meeting: Discuss preliminary findings with the Auditee
Responsible (R): Senior Auditor
Accountable (A): Senior Auditor
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W121_Flow20</bpmn:incoming>
        <bpmn:outgoing>W121_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W121_Task11" name="Draft Audit Report: Categorize findings (Critical, Major, Minor)">
        <bpmn:documentation>Step 5: Draft Audit Report: Categorize findings (Critical, Major, Minor)
Responsible (R): Audit Team
Accountable (A): Senior Auditor
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W121_Flow21</bpmn:incoming>
        <bpmn:outgoing>W121_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W121_Task12" name="Management Response: Auditee provides Corrective Action Plan (CAP)">
        <bpmn:documentation>Step 6: Management Response: Auditee provides Corrective Action Plan (CAP)
Responsible (R): Auditee
Accountable (A): Auditee
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W121_Flow22</bpmn:incoming>
        <bpmn:outgoing>W121_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W121_Task13" name="Final Report Distribution &amp; Filing in ERP">
        <bpmn:documentation>Step 7: Final Report Distribution &amp; Filing in ERP
Responsible (R): Head of IA
Accountable (A): Audit Committee
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W121_Flow23</bpmn:incoming>
        <bpmn:outgoing>W121_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W121_End14" name="Complete">
        <bpmn:incoming>W121_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W121_Annotation15">
        <bpmn:text>Controls: - CTL-224 (ensure audit-plan execution &amp; remediation.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Senior Internal Auditor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W121_Assoc16" sourceRef="W121_Annotation15" targetRef="W121_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W121_Flow17" sourceRef="W121_Start6" targetRef="W121_Task7" />
      <bpmn:sequenceFlow id="W121_Flow18" sourceRef="W121_Task7" targetRef="W121_Task8" />
      <bpmn:sequenceFlow id="W121_Flow19" sourceRef="W121_Task8" targetRef="W121_Task9" />
