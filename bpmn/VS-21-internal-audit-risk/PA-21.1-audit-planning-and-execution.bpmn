        </bpmn:lane>
        <bpmn:lane id="W355_Lane4" name="IT Auditor">
        <bpmn:flowNodeRef>W355_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W355_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W355_Start6" name="Annual audit cycle">
        <bpmn:outgoing>W355_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W355_Task7" name="Trademark Inventory">
        <bpmn:documentation>Step 1: Trademark Inventory: Reconcile active trademarks in use vs. Legal registration records
Responsible (R): Legal
Accountable (A): VP Legal
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W355_Flow15</bpmn:incoming>
        <bpmn:outgoing>W355_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W355_Task8" name="Packaging Compliance">
        <bpmn:documentation>Step 2: Packaging Compliance: Audit private label packaging for correct logo usage and legal disclaimers
Responsible (R): Auditor
Accountable (A): Brand Mgr
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W355_Flow16</bpmn:incoming>
        <bpmn:outgoing>W355_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W355_Task9" name="Licensing Audit">
        <bpmn:documentation>Step 3: Licensing Audit: Verify that royalties for third-party licensed brands (if any) are correctly paid
Responsible (R): Auditor
Accountable (A): Finance
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W355_Flow17</bpmn:incoming>
        <bpmn:outgoing>W355_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W355_Task10" name="Market Monitoring">
        <bpmn:documentation>Step 4: Market Monitoring: Review &quot;Brand Protection&quot; reports for counterfeit or infringing goods in the market
Responsible (R): Marketing
Accountable (A): Legal
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W355_Flow18</bpmn:incoming>
        <bpmn:outgoing>W355_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W355_Task11" name="Domain &amp; Social Check">
        <bpmn:documentation>Step 5: Domain &amp; Social Check: Verify company-owned domains and social handles are secured and active
Responsible (R): IT Auditor
Accountable (A): Marketing
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W355_Flow19</bpmn:incoming>
        <bpmn:outgoing>W355_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W355_End12" name="Complete">
        <bpmn:incoming>W355_Flow20</bpmn:incoming>
      </bpmn:endEvent>
