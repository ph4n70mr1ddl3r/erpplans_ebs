    <bpmn:process id="W_W351" name="W351. External Audit Coordination &amp; Statutory Filing Support" isExecutable="false">
      <bpmn:documentation>Trigger: Year-end audit kickoff
Frequency: Annual
Volume: 5 Legal Entities
Owner: Head of IA / Finance Controller
Participants: External Auditors, Finance Team, Business Process Owners
Source: workflow W351 — External Audit Coordination &amp; Statutory Filing Support</bpmn:documentation>
