        <bpmn:outgoing>W338_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W338_Task8" name="Extract User-Role matrix from ERP showing all assigned permissions">
        <bpmn:documentation>Step 1: Extract User-Role matrix from ERP showing all assigned permissions
Responsible (R): IT Auditor
Accountable (A): Head of IA
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W338_Flow18</bpmn:incoming>
        <bpmn:outgoing>W338_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W338_Task9" name="Run SOD conflict report against defined conflict matrix (e.g., User can create…">
        <bpmn:documentation>Step 2: Run SOD conflict report against defined conflict matrix (e.g., User can create Vendor AND approve Payment)
Responsible (R): System
Accountable (A): IT Auditor
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W338_Flow19</bpmn:incoming>
        <bpmn:outgoing>W338_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
