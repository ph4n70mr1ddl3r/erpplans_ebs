    <bpmn:process id="W_W354" name="W354. AML &amp; Sanctions Screening (Wholesale/B2B) Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly review
Frequency: Quarterly
Volume: ~200+ Wholesale/Project accounts
Owner: Compliance Officer / Internal Audit
Participants: Credit Manager, Sales Ops, Legal
Source: workflow W354 — AML &amp; Sanctions Screening (Wholesale/B2B) Audit</bpmn:documentation>
      <bpmn:laneSet id="W354_LaneSet4">
        <bpmn:lane id="W354_Lane1" name="Auditor">
        <bpmn:flowNodeRef>W354_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W354_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W354_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W354_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W354_Lane2" name="System">
        <bpmn:flowNodeRef>W354_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W354_Lane3" name="Legal">
        <bpmn:flowNodeRef>W354_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W354_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W354_Start5" name="Quarterly review">
        <bpmn:outgoing>W354_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W354_Task6" name="KYC Review">
        <bpmn:documentation>Step 1: KYC Review: Sample new wholesale accounts to verify completeness of &quot;Know Your Customer&quot; docs
Responsible (R): Auditor
Accountable (A): Compliance
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W354_Flow14</bpmn:incoming>
        <bpmn:outgoing>W354_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W354_Task7" name="Sanctions Check">
        <bpmn:documentation>Step 2: Sanctions Check: Run customer list against OFAC, UN, and local AMLC watchlists
Responsible (R): System
Accountable (A): Compliance
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W354_Flow15</bpmn:incoming>
        <bpmn:outgoing>W354_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W354_Task8" name="Transaction Monitoring">
        <bpmn:documentation>Step 3: Transaction Monitoring: Audit large cash-equivalent or structured payments for red flags
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W354_Flow16</bpmn:incoming>
        <bpmn:outgoing>W354_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W354_Task9" name="Ultimate Beneficial Owner (UBO)">
        <bpmn:documentation>Step 4: Ultimate Beneficial Owner (UBO): Verify UBO documentation for corporate project accounts
Responsible (R): Auditor
Accountable (A): Compliance
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W354_Flow17</bpmn:incoming>
        <bpmn:outgoing>W354_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W354_Task10" name="Reporting">
        <bpmn:documentation>Step 5: Reporting: Report suspicious activities to the AMLC (if required) via Legal Counsel
Responsible (R): Legal
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W354_Flow18</bpmn:incoming>
        <bpmn:outgoing>W354_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W354_End11" name="Complete">
        <bpmn:incoming>W354_Flow19</bpmn:incoming>
      </bpmn:endEvent>
