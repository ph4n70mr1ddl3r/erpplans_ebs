    <bpmn:process id="W_W159" name="W159. Anti-Bribery &amp; Corruption (ABC) Monitoring &amp; Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Periodic audit cycle; or &quot;Red Flag&quot; system alert
Frequency: Quarterly monitoring; Annual audit
Volume: Covers high-risk areas (Procurement, Permits, Real Estate)
Owner: Compliance Officer
Participants: Internal Audit, Procurement, Legal
Source: workflow W159 — Anti-Bribery &amp; Corruption (ABC) Monitoring &amp; Audit</bpmn:documentation>
      <bpmn:laneSet id="W159_LaneSet5">
        <bpmn:lane id="W159_Lane1" name="Compliance Officer">
        <bpmn:flowNodeRef>W159_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W159_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W159_Lane2" name="Procurement">
        <bpmn:flowNodeRef>W159_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W159_Lane3" name="HR">
        <bpmn:flowNodeRef>W159_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W159_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W159_Lane4" name="Internal Audit">
        <bpmn:flowNodeRef>W159_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W159_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W159_Start6" name="Periodic audit cycle; or &quot;Red Flag&quot; system alert">
        <bpmn:outgoing>W159_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W159_Task7" name="Red Flag Monitoring">
        <bpmn:documentation>Step 1: Red Flag Monitoring: Monitor high-risk transactions: non-PO payments to &quot;consultants,&quot; gifts/entertainment expenses, and unusual vendor credit notes
Responsible (R): Compliance Officer
Accountable (A): Head of IA
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W159_Flow15</bpmn:incoming>
        <bpmn:outgoing>W159_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W159_Task8" name="Vendor Due Diligence">
        <bpmn:documentation>Step 2: Vendor Due Diligence: Perform background checks on vendors in high-risk categories (Construction, Government Sales)
Responsible (R): Procurement
Accountable (A): Compliance Officer
Duration: 1 day/vendor</bpmn:documentation>
        <bpmn:incoming>W159_Flow16</bpmn:incoming>
        <bpmn:outgoing>W159_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W159_Task9" name="Conflict of Interest (COI)">
        <bpmn:documentation>Step 3: Conflict of Interest (COI): Annual collection of COI disclosures from all employees in Procurement and Management
Responsible (R): HR
Accountable (A): Legal
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W159_Flow17</bpmn:incoming>
        <bpmn:outgoing>W159_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W159_Task10" name="Audit">
        <bpmn:documentation>Step 4: Audit: Detailed audit of LGU permit payments (W54) and land acquisition fees to ensure compliance with the Foreign Corrupt Practices Act (FCPA) and local anti-graft laws
Responsible (R): Internal Audit
Accountable (A): VP Legal
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W159_Flow18</bpmn:incoming>
        <bpmn:outgoing>W159_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W159_Task11" name="Training">
        <bpmn:documentation>Step 5: Training: Mandatory ABC training for all employees with spending authority
Responsible (R): HR / Compliance
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W159_Flow19</bpmn:incoming>
        <bpmn:outgoing>W159_Flow20</bpmn:outgoing>
      </bpmn:userTask>
