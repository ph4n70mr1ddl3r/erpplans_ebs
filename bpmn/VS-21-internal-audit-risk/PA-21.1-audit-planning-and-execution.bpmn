    <bpmn:process id="W_W333" name="W333. Audit Issue Remediation &amp; CAP Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Finalized Audit Report with findings and CAPs
Frequency: Monthly review; Quarterly reporting
Volume: ~50–100 open audit findings across the enterprise
Owner: Internal Audit
Participants: Auditees (Action Owners), Executive Team, Audit Committee
Source: workflow W333 — Audit Issue Remediation &amp; CAP Tracking</bpmn:documentation>
      <bpmn:laneSet id="W333_LaneSet5">
        <bpmn:lane id="W333_Lane1" name="Audit Team">
        <bpmn:flowNodeRef>W333_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W333_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W333_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W333_Lane2" name="System">
        <bpmn:flowNodeRef>W333_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
