    <bpmn:process id="W_W352" name="W352. Fixed Asset Verification &amp; Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Annual / Bi-annual cycle
Frequency: Annual (rotational across store/DC locations)
Volume: Covers the full fixed-asset register — PHP 8–10B gross, ~5,000–8,000 assets (shelving, fleet, IT, machinery)
Owner: Internal Audit / Fixed Asset Accountant
Participants: Store/DC Managers, Maintenance, IT, Finance
Source: workflow W352 — Fixed Asset Verification &amp; Audit</bpmn:documentation>
      <bpmn:laneSet id="W352_LaneSet3">
        <bpmn:lane id="W352_Lane1" name="Finance">
        <bpmn:flowNodeRef>W352_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W352_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W352_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W352_Lane2" name="Auditor">
        <bpmn:flowNodeRef>W352_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W352_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W352_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W352_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W352_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W352_Start4" name="Annual / Bi-annual cycle">
        <bpmn:outgoing>W352_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W352_Task5" name="Asset List Extraction">
        <bpmn:documentation>Step 1: Asset List Extraction: Generate current Fixed Asset Register (FAR) from ERP (W276)
Responsible (R): Finance
Accountable (A): Head of IA
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W352_Flow14</bpmn:incoming>
        <bpmn:outgoing>W352_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W352_Task6" name="Physical Count">
        <bpmn:documentation>Step 2: Physical Count: Perform site-to-floor and floor-to-site verification of asset tags
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 2-3 days</bpmn:documentation>
        <bpmn:incoming>W352_Flow15</bpmn:incoming>
        <bpmn:outgoing>W352_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W352_Task7" name="Condition Assessment">
        <bpmn:documentation>Step 3: Condition Assessment: Verify physical condition and continued utility of assets
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W352_Flow16</bpmn:incoming>
        <bpmn:outgoing>W352_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W352_Task8" name="Tagging Verification">
        <bpmn:documentation>Step 4: Tagging Verification: Ensure new acquisitions are properly tagged and logged in the system
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W352_Flow17</bpmn:incoming>
        <bpmn:outgoing>W352_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W352_Task9" name="Reconciliation">
        <bpmn:documentation>Step 5: Reconciliation: Reconcile physical count to FAR; identify missing, disposed, or unrecorded assets
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W352_Flow18</bpmn:incoming>
        <bpmn:outgoing>W352_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W352_Task10" name="Adjustment &amp; Reporting">
        <bpmn:documentation>Step 6: Adjustment &amp; Reporting: Post write-offs for missing assets; report significant variances to CFO
Responsible (R): Finance
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W352_Flow19</bpmn:incoming>
        <bpmn:outgoing>W352_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W352_End11" name="Complete">
        <bpmn:incoming>W352_Flow20</bpmn:incoming>
      </bpmn:endEvent>
