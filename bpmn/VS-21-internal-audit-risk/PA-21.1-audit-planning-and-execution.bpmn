Responsible (R): IT Auditor
Accountable (A): Head of IA
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W331_Flow18</bpmn:incoming>
        <bpmn:outgoing>W331_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W331_Task9" name="Assess Cybersecurity posture: Review penetration testing results, vulnerability…">
