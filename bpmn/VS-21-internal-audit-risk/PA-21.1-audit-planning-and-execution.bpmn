    <bpmn:process id="W_W345" name="W345. Logistics, Fleet &amp; Fuel Management Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Fuel cost spikes or high fleet maintenance variance
Frequency: Semi-annual
Volume: Audit of fleet operations for 4 DCs and ~40 company-owned trucks (rest 3PL-contracted, per the fleet canon)
Owner: Internal Audit
Participants: Fleet Manager, VP Supply Chain, 3PL Partners
Source: workflow W345 — Logistics, Fleet &amp; Fuel Management Audit</bpmn:documentation>
      <bpmn:laneSet id="W345_LaneSet2">
        <bpmn:lane id="W345_Lane1" name="Auditor">
        <bpmn:flowNodeRef>W345_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W345_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W345_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W345_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W345_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W345_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W345_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W345_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W345_Start3" name="Fuel cost spikes or high fleet maintenance variance">
        <bpmn:outgoing>W345_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W345_Task4" name="Fuel Reconciliation">
        <bpmn:documentation>Step 1: Fuel Reconciliation: Reconcile fuel card charges vs. GPS mileage and vehicle fuel efficiency standards
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W345_Flow13</bpmn:incoming>
        <bpmn:outgoing>W345_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W345_Task5" name="Maintenance Audit">
        <bpmn:documentation>Step 2: Maintenance Audit: Verify that fleet repairs match maintenance logs and parts were actually replaced
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W345_Flow14</bpmn:incoming>
        <bpmn:outgoing>W345_Flow15</bpmn:outgoing>
      </bpmn:userTask>
