    <bpmn:process id="W_W342" name="W342. Inventory Observation &amp; Cycle Count Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Annual physical inventory (W42) or high-shrinkage alerts (W37)
Frequency: Annual (full counts) / Quarterly (cycle count audit)
Volume: All 4 DCs and sample of 20–30 high-risk stores
Owner: Internal Audit
Participants: DC/Store Operations, Inventory Control, External Auditors
Source: workflow W342 — Inventory Observation &amp; Cycle Count Audit</bpmn:documentation>
      <bpmn:laneSet id="W342_LaneSet2">
        <bpmn:lane id="W342_Lane1" name="Auditor">
        <bpmn:flowNodeRef>W342_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W342_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W342_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W342_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W342_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W342_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W342_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W342_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W342_Start3" name="Annual physical inventory (W42) or high-shrinkage alerts (W37)">
        <bpmn:outgoing>W342_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W342_Task4" name="Pre-Count Audit">
        <bpmn:documentation>Step 1: Pre-Count Audit: Verify that the &quot;Cut-off&quot; is clean (no pending GRs or Shipments) and area is organized
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W342_Flow13</bpmn:incoming>
        <bpmn:outgoing>W342_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W342_Task5" name="Observation">
        <bpmn:documentation>Step 2: Observation: Observe the counting teams to ensure they follow the approved SOP (W42)
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W342_Flow14</bpmn:incoming>
        <bpmn:outgoing>W342_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W342_Task6" name="Test Counts">
        <bpmn:documentation>Step 3: Test Counts: Perform independent test counts of high-value or high-variance SKUs
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W342_Flow15</bpmn:incoming>
        <bpmn:outgoing>W342_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W342_Task7" name="Reconciliation Review">
        <bpmn:documentation>Step 4: Reconciliation Review: Verify that all count sheets are uploaded and variances are investigated before posting
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W342_Flow16</bpmn:incoming>
        <bpmn:outgoing>W342_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W342_Task8" name="System Posting Audit">
        <bpmn:documentation>Step 5: System Posting Audit: Confirm that final adjustments are correctly posted to the GL (W92)
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W342_Flow17</bpmn:incoming>
        <bpmn:outgoing>W342_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W342_Task9" name="Root Cause Analysis">
        <bpmn:documentation>Step 6: Root Cause Analysis: Audit the shrinkage classification for accuracy (W37)
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W342_Flow18</bpmn:incoming>
        <bpmn:outgoing>W342_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W342_End10" name="Complete">
        <bpmn:incoming>W342_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W342_Annotation11">
        <bpmn:text>Controls: - CTL-304 (ensure controlled execution — Audit Planning &amp; Execution (PA-21.1).) | - operational: Internal Audit review and approval gate; periodic reconciliation against source documents
Owner: Internal Audit</bpmn:text>
      </bpmn:textAnnotation>
