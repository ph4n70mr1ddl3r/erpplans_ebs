    <bpmn:process id="W_W362" name="W362. Master Data Governance &amp; Data Quality Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Annual audit plan or system integrity alerts
Frequency: Annual
Volume: Samples from Item (W252), Vendor (W287), and Finance (W288) masters
Owner: IT Auditor / Data Analyst
Participants: MDM Lead, IT Manager, Business Process Owners
Source: workflow W362 — Master Data Governance &amp; Data Quality Audit</bpmn:documentation>
      <bpmn:laneSet id="W362_LaneSet4">
        <bpmn:lane id="W362_Lane1" name="IT Auditor">
        <bpmn:flowNodeRef>W362_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W362_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W362_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W362_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W362_Lane2" name="Auditor">
        <bpmn:flowNodeRef>W362_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W362_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W362_Lane3" name="Data Analyst">
        <bpmn:flowNodeRef>W362_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W362_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W362_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W362_Start5" name="Annual audit plan or system integrity alerts">
        <bpmn:outgoing>W362_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W362_Task6" name="Access Control Audit">
        <bpmn:documentation>Step 1: Access Control Audit: Verify that only the MDM team has &quot;Create/Edit&quot; rights for master data (W252-W288)
Responsible (R): IT Auditor
Accountable (A): Head of IA
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W362_Flow16</bpmn:incoming>
        <bpmn:outgoing>W362_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W362_Task7" name="Workflow Integrity">
        <bpmn:documentation>Step 2: Workflow Integrity: Trace sample master data creations to verify all required approvals were obtained
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W362_Flow17</bpmn:incoming>
        <bpmn:outgoing>W362_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W362_Task8" name="Data Quality Profiling">
        <bpmn:documentation>Step 3: Data Quality Profiling: Run scripts to identify duplicates, missing mandatory fields, and formatting errors in the Item and Vendor masters
Responsible (R): Data Analyst
Accountable (A): IT Auditor
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W362_Flow18</bpmn:incoming>
        <bpmn:outgoing>W362_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W362_Task9" name="Deduplication Audit">
        <bpmn:documentation>Step 4: Deduplication Audit: Verify efficacy of the customer deduplication process (W253)
Responsible (R): Data Analyst
Accountable (A): IT Auditor
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W362_Flow19</bpmn:incoming>
        <bpmn:outgoing>W362_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W362_Task10" name="Tax/Regulatory Master Test">
        <bpmn:documentation>Step 5: Tax/Regulatory Master Test: Verify accuracy of tax codes and regulatory tags (W293)
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W362_Flow20</bpmn:incoming>
        <bpmn:outgoing>W362_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W362_Task11" name="Interface Audit">
        <bpmn:documentation>Step 6: Interface Audit: Verify that master data syncs correctly from ERP to POS and E-commerce (W50/W180)
Responsible (R): IT Auditor
Accountable (A): CIO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W362_Flow21</bpmn:incoming>
        <bpmn:outgoing>W362_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W362_Task12" name="DGC Reporting">
        <bpmn:documentation>Step 7: DGC Reporting: Compile audit findings into the Master Data Quality &amp; Governance report and present to the Enterprise Data Governance Council (W474) to drive policy adjustments and enforce Data Steward accountability
Responsible (R): IT Auditor
Accountable (A): DGC Chair
Duration: 2 hours/annual</bpmn:documentation>
        <bpmn:incoming>W362_Flow22</bpmn:incoming>
        <bpmn:outgoing>W362_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W362_End13" name="Complete">
        <bpmn:incoming>W362_Flow23</bpmn:incoming>
      </bpmn:endEvent>
