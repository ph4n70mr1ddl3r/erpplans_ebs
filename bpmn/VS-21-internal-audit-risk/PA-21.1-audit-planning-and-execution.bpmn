    <bpmn:process id="W_W343" name="W343. Lease &amp; CAM (Common Area Maintenance) Compliance Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Annual audit plan
Frequency: Annual (rotational across store portfolio)
Volume: ~30–40 leases audited per year
Owner: Internal Audit / Real Estate Compliance
Participants: Finance (Lease Accounting), Legal, Mall/Landlord Management
Source: workflow W343 — Lease &amp; CAM (Common Area Maintenance) Compliance Audit</bpmn:documentation>
      <bpmn:laneSet id="W343_LaneSet3">
        <bpmn:lane id="W343_Lane1" name="Auditor">
        <bpmn:flowNodeRef>W343_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W343_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W343_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W343_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W343_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W343_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W343_Lane2" name="Legal">
        <bpmn:flowNodeRef>W343_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W343_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W343_Start4" name="Annual audit plan">
        <bpmn:outgoing>W343_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W343_Task5" name="Contract Review">
        <bpmn:documentation>Step 1: Contract Review: Extract lease terms: base rent, escalation clauses, and CAM/Utility formula from Legal (W230)
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W343_Flow14</bpmn:incoming>
        <bpmn:outgoing>W343_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W343_Task6" name="Payment Recalculation">
        <bpmn:documentation>Step 2: Payment Recalculation: Re-calculate rent and escalations vs. actual payments in ERP (W7)
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W343_Flow15</bpmn:incoming>
        <bpmn:outgoing>W343_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W343_Task7" name="CAM Audit">
        <bpmn:documentation>Step 3: CAM Audit: Request and audit landlord&#x27;s CAM breakdown; verify pro-rata share calculations
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W343_Flow16</bpmn:incoming>
        <bpmn:outgoing>W343_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W343_Task8" name="Sales-Percentage Rent Audit">
        <bpmn:documentation>Step 4: Sales-Percentage Rent Audit: Verify that &quot;Gross Sales&quot; reported to landlord matches POS records
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W343_Flow17</bpmn:incoming>
        <bpmn:outgoing>W343_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W343_Task9" name="Utility Surcharge Review">
        <bpmn:documentation>Step 5: Utility Surcharge Review: Verify that landlord electricity/water markups comply with lease terms
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W343_Flow18</bpmn:incoming>
        <bpmn:outgoing>W343_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W343_Task10" name="Recovery Claim">
        <bpmn:documentation>Step 6: Recovery Claim: Issue formal demand to landlord for overcharges identified
Responsible (R): Legal
Accountable (A): CFO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W343_Flow19</bpmn:incoming>
        <bpmn:outgoing>W343_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W343_End11" name="Complete">
        <bpmn:incoming>W343_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W343_Annotation12">
        <bpmn:text>Controls: - CTL-304 (ensure controlled execution — Audit Planning &amp; Execution (PA-21.1).) | - operational: Internal Audit / Real Estate Compliance review and approval gate
Owner: Internal Audit / Real Estate Compliance</bpmn:text>
      </bpmn:textAnnotation>
