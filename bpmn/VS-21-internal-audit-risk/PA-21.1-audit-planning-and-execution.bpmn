    <bpmn:process id="W_W336" name="W336. Quality Assurance &amp; Improvement Program (QAIP)" isExecutable="false">
      <bpmn:documentation>Trigger: IIA standard compliance requirements
Frequency: Annual internal review, every 5 years external assessment
Volume: 1 comprehensive review per year
Owner: Head of Internal Audit
Participants: Audit Team, Audit Committee, External Assessor
Source: workflow W336 — Quality Assurance &amp; Improvement Program (QAIP)</bpmn:documentation>
      <bpmn:laneSet id="W336_LaneSet5">
        <bpmn:lane id="W336_Lane1" name="Head of IA">
        <bpmn:flowNodeRef>W336_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W336_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W336_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W336_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W336_Lane2" name="Senior Auditor">
        <bpmn:flowNodeRef>W336_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W336_Lane3" name="Audit Team">
        <bpmn:flowNodeRef>W336_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W336_Lane4" name="External Firm">
        <bpmn:flowNodeRef>W336_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W336_End13</bpmn:flowNodeRef>
        </bpmn:lane>
