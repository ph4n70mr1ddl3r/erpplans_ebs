    <bpmn:process id="W_W466" name="W466. Loss Prevention &amp; Asset Protection (LPAP)" isExecutable="false">
      <bpmn:documentation>Trigger: High-shrinkage alert or weekly exception-based report
Frequency: Weekly (Reports); Monthly (Audits)
Volume: All stores; focus on Top 10 high-shrink locations
Owner: Loss Prevention Manager
Participants: Store Manager, Security Lead, Auditor, HR
Source: workflow W466 — Loss Prevention &amp; Asset Protection (LPAP)</bpmn:documentation>
      <bpmn:laneSet id="W466_LaneSet6">
        <bpmn:lane id="W466_Lane1" name="LP Analyst">
        <bpmn:flowNodeRef>W466_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W466_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W466_Lane2" name="LP Manager">
        <bpmn:flowNodeRef>W466_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W466_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W466_Lane3" name="Stock Associate">
        <bpmn:flowNodeRef>W466_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W466_Lane4" name="Security Lead">
        <bpmn:flowNodeRef>W466_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W466_Lane5" name="Store Manager">
        <bpmn:flowNodeRef>W466_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W466_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W466_Start7" name="High-shrinkage alert or weekly exception-based report">
        <bpmn:outgoing>W466_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W466_Task8" name="Exception Review">
        <bpmn:documentation>Step 1: Exception Review: Pull weekly &quot;Exception-Based Report&quot; (EBR): Voids, high-value refunds, open-drawer events without sale
Responsible (R): LP Analyst
Accountable (A): —
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W466_Flow17</bpmn:incoming>
        <bpmn:outgoing>W466_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W466_Task9" name="CCTV Reconciliation">
        <bpmn:documentation>Step 2: CCTV Reconciliation: Match EBR events to CCTV footage to verify employee and customer behavior
Responsible (R): LP Manager
Accountable (A): Store Manager
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W466_Flow18</bpmn:incoming>
        <bpmn:outgoing>W466_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W466_Task10" name="High-Value Audit">
        <bpmn:documentation>Step 3: High-Value Audit: Perform weekly count of &quot;High-Target&quot; SKUs (Power tools, expensive fixtures, copper wire)
Responsible (R): Stock Associate
Accountable (A): Store Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W466_Flow19</bpmn:incoming>
        <bpmn:outgoing>W466_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W466_Task11" name="Bag &amp; Locker Checks">
        <bpmn:documentation>Step 4: Bag &amp; Locker Checks: Security Lead performs random unannounced bag/locker checks of store staff
Responsible (R): Security Lead
Accountable (A): Store Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W466_Flow20</bpmn:incoming>
        <bpmn:outgoing>W466_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W466_Task12" name="Incident Investigation">
        <bpmn:documentation>Step 5: Incident Investigation: If theft is suspected, LP Manager conducts interviews and reviews digital trails
Responsible (R): LP Manager
Accountable (A): CHRO
Duration: 1-3 days</bpmn:documentation>
        <bpmn:incoming>W466_Flow21</bpmn:incoming>
        <bpmn:outgoing>W466_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W466_Task13" name="Corrective Action">
        <bpmn:documentation>Step 6: Corrective Action: Update EAS (Electronic Article Surveillance) tag placement or modify physical layout to reduce blind spots
Responsible (R): Store Manager
Accountable (A): LP Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W466_Flow22</bpmn:incoming>
        <bpmn:outgoing>W466_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W466_End14" name="Complete">
        <bpmn:incoming>W466_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W466_Annotation15">
        <bpmn:text>Controls: - CTL-304 (ensure controlled execution — Audit Planning &amp; Execution (PA-21.1).) | - operational: Loss Prevention Manager review and approval gate; periodic reconciliation against source documents
Owner: Loss Prevention Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W466_Assoc16" sourceRef="W466_Annotation15" targetRef="W466_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W466_Flow17" sourceRef="W466_Start7" targetRef="W466_Task8" />
      <bpmn:sequenceFlow id="W466_Flow18" sourceRef="W466_Task8" targetRef="W466_Task9" />
      <bpmn:sequenceFlow id="W466_Flow19" sourceRef="W466_Task9" targetRef="W466_Task10" />
      <bpmn:sequenceFlow id="W466_Flow20" sourceRef="W466_Task10" targetRef="W466_Task11" />
      <bpmn:sequenceFlow id="W466_Flow21" sourceRef="W466_Task11" targetRef="W466_Task12" />
      <bpmn:sequenceFlow id="W466_Flow22" sourceRef="W466_Task12" targetRef="W466_Task13" />
      <bpmn:sequenceFlow id="W466_Flow23" sourceRef="W466_Task13" targetRef="W466_End14" />
    </bpmn:process>
