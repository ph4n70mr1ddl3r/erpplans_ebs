    <bpmn:process id="W_W355" name="W355. Intellectual Property (IP) &amp; Brand Protection Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Annual audit cycle
Frequency: Annual
Volume: ~10–15 house brands and trademarks
Owner: Internal Audit / Legal Counsel
Participants: Marketing (Brand Managers), Merchandising, Legal
Source: workflow W355 — Intellectual Property (IP) &amp; Brand Protection Audit</bpmn:documentation>
      <bpmn:laneSet id="W355_LaneSet5">
        <bpmn:lane id="W355_Lane1" name="Legal">
        <bpmn:flowNodeRef>W355_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W355_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W355_Lane2" name="Auditor">
        <bpmn:flowNodeRef>W355_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W355_Task9</bpmn:flowNodeRef>
