        <bpmndi:BPMNShape id="W1328_Lane3_di" bpmnElement="W1328_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1328_Task6_di" bpmnElement="W1328_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
