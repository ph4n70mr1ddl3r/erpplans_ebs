        <bpmndi:BPMNShape id="W1330_Task10_di" bpmnElement="W1330_Task10"><dc:Bounds x="1450" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1330_Start4_di" bpmnElement="W1330_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
