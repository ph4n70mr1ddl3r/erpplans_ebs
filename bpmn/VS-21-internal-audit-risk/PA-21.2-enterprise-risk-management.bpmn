<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-21.2-enterprise-risk-management" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W122" name="W122. Enterprise Risk Management (ERM) Review" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly risk committee meeting
Frequency: Quarterly
Volume: Top 20 corporate risks reviewed
Owner: Head of Internal Audit (acting as Risk Officer)
Participants: Executive Team (C-Level), Board of Directors
Source: workflow W122 — Enterprise Risk Management (ERM) Review</bpmn:documentation>
      <bpmn:laneSet id="W122_LaneSet3">
        <bpmn:lane id="W122_Lane1" name="Head of IA">
        <bpmn:flowNodeRef>W122_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W122_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W122_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W122_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W122_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W122_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W122_Lane2" name="Executive Team">
        <bpmn:flowNodeRef>W122_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W122_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W122_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W122_Start4" name="Quarterly risk committee meeting">
        <bpmn:outgoing>W122_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W122_Task5" name="Update Enterprise Risk Register: Financial, Operational, Strategic, Compliance">
        <bpmn:documentation>Step 1: Update Enterprise Risk Register: Financial, Operational, Strategic, Compliance
Responsible (R): Head of IA
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W122_Flow15</bpmn:incoming>
        <bpmn:outgoing>W122_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W122_Task6" name="Assess external risks: Inflation, port congestion, regulatory changes…">
        <bpmn:documentation>Step 2: Assess external risks: Inflation, port congestion, regulatory changes, competition
Responsible (R): Executive Team
Accountable (A): CEO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W122_Flow16</bpmn:incoming>
        <bpmn:outgoing>W122_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W122_Task7" name="Review mitigation plans for top risks (e.g., FX Hedging W80, DR Plan W55)">
        <bpmn:documentation>Step 3: Review mitigation plans for top risks (e.g., FX Hedging W80, DR Plan W55)
Responsible (R): Head of IA
Accountable (A): CFO/CIO
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W122_Flow17</bpmn:incoming>
        <bpmn:outgoing>W122_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W122_Task8" name="Validate Risk Appetite Statement with Board of Directors — confirm thresholds…">
        <bpmn:documentation>Step 4: Validate Risk Appetite Statement with Board of Directors — confirm thresholds for revenue volatility, FX exposure, inventory shrinkage, and operational downtime remain aligned with strategic direction
Responsible (R): Head of IA
Accountable (A): Audit Committee
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W122_Flow18</bpmn:incoming>
        <bpmn:outgoing>W122_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W122_Task9" name="Assign mitigation owners for each top-20 risk with measurable KPIs and firm…">
        <bpmn:documentation>Step 5: Assign mitigation owners for each top-20 risk with measurable KPIs and firm deadlines for next quarter
Responsible (R): Executive Team
Accountable (A): CEO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W122_Flow19</bpmn:incoming>
        <bpmn:outgoing>W122_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W122_Task10" name="Generate Risk Heat Map (Impact vs. Likelihood matrix) for visual presentation —…">
        <bpmn:documentation>Step 6: Generate Risk Heat Map (Impact vs. Likelihood matrix) for visual presentation — categorize risks as Critical (red), High (orange), Medium (yellow), Low (green)
Responsible (R): Head of IA
Accountable (A): Head of IA
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W122_Flow20</bpmn:incoming>
        <bpmn:outgoing>W122_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W122_Task11" name="Present Risk Dashboard and Heat Map to Board Risk Committee; obtain formal…">
        <bpmn:documentation>Step 7: Present Risk Dashboard and Heat Map to Board Risk Committee; obtain formal recommendations and sign-off; set up action item tracker for next quarter follow-through
Responsible (R): Head of IA
Accountable (A): CEO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W122_Flow21</bpmn:incoming>
        <bpmn:outgoing>W122_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W122_End12" name="Complete">
        <bpmn:incoming>W122_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W122_Annotation13">
        <bpmn:text>Controls: - CTL-305 (ensure controlled execution — Enterprise Risk Management (PA-21.2).) | - operational: Head of Internal Audit (acting as Risk Officer) review and approval gate
Owner: Head of Internal Audit (acting as Risk Officer)</bpmn:text>
      </bpmn:textAnnotation>
