    <bpmn:process id="W_W356" name="W356. Whistleblower System &amp; Non-Retaliation Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Annual audit plan
Frequency: Annual
Volume: ~30–50 tips reviewed annually for process integrity
Owner: Head of Internal Audit / Compliance Officer
Participants: HR, Legal, Third-party Hotline Provider
Source: workflow W356 — Whistleblower System &amp; Non-Retaliation Audit</bpmn:documentation>
      <bpmn:laneSet id="W356_LaneSet4">
        <bpmn:lane id="W356_Lane1" name="IT Auditor">
        <bpmn:flowNodeRef>W356_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W356_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W356_Lane2" name="Auditor">
        <bpmn:flowNodeRef>W356_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W356_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W356_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W356_Lane3" name="Head of IA">
        <bpmn:flowNodeRef>W356_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W356_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W356_Start5" name="Annual audit plan">
        <bpmn:outgoing>W356_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W356_Task6" name="System Access Audit">
        <bpmn:documentation>Step 1: System Access Audit: Verify that only authorized personnel have access to the whistleblower intake system
Responsible (R): IT Auditor
Accountable (A): Head of IA
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W356_Flow14</bpmn:incoming>
        <bpmn:outgoing>W356_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W356_Task7" name="Confidentiality Test">
        <bpmn:documentation>Step 2: Confidentiality Test: Sample cases to ensure informant identities are redacted in investigation reports
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W356_Flow15</bpmn:incoming>
        <bpmn:outgoing>W356_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W356_Task8" name="Timeliness Review">
        <bpmn:documentation>Step 3: Timeliness Review: Audit the time from initial tip to committee review and final resolution (KPI vs. Actual)
Responsible (R): Auditor
Accountable (A): Compliance
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W356_Flow16</bpmn:incoming>
        <bpmn:outgoing>W356_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W356_Task9" name="Non-Retaliation Check">
        <bpmn:documentation>Step 4: Non-Retaliation Check: Survey/Interview a sample of known informants (where identity is disclosed to IA) to verify no adverse employment actions occurred
Responsible (R): Head of IA
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W356_Flow17</bpmn:incoming>
        <bpmn:outgoing>W356_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W356_Task10" name="Hotline Efficacy">
        <bpmn:documentation>Step 5: Hotline Efficacy: Test the third-party hotline (if applicable) with &quot;mystery&quot; reports to verify intake accuracy
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W356_Flow18</bpmn:incoming>
        <bpmn:outgoing>W356_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W356_End11" name="Complete">
        <bpmn:incoming>W356_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W356_Annotation12">
        <bpmn:text>Controls: - CTL-305 (ensure controlled execution — Enterprise Risk Management (PA-21.2).) | - operational: anonymous intake with authorized-access controls to preserve reporting confidence
Owner: Head of Internal Audit / Compliance Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W356_Assoc13" sourceRef="W356_Annotation12" targetRef="W356_Start5" associationDirection="None" />
