      <bpmn:sequenceFlow id="W1328_Flow17" sourceRef="W1328_Task7" targetRef="W1328_Task8" />
      <bpmn:sequenceFlow id="W1328_Flow18" sourceRef="W1328_Task8" targetRef="W1328_Task9" />
      <bpmn:sequenceFlow id="W1328_Flow19" sourceRef="W1328_Task9" targetRef="W1328_Task10" />
      <bpmn:sequenceFlow id="W1328_Flow20" sourceRef="W1328_Task10" targetRef="W1328_Task11" />
      <bpmn:sequenceFlow id="W1328_Flow21" sourceRef="W1328_Task11" targetRef="W1328_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1328_diag">
      <bpmndi:BPMNPlane id="W1328_plane" bpmnElement="W_W1328">
        <bpmndi:BPMNShape id="W1328_Lane1_di" bpmnElement="W1328_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
