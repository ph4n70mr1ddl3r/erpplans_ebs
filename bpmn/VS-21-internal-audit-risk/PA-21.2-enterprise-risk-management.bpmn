      <bpmndi:BPMNPlane id="W1462_plane" bpmnElement="W_W1462">
        <bpmndi:BPMNShape id="W1462_Lane1_di" bpmnElement="W1462_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
