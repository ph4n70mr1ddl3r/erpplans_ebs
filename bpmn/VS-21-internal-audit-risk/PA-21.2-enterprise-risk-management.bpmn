        <bpmndi:BPMNShape id="W1328_Task9_di" bpmnElement="W1328_Task9"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1328_Task10_di" bpmnElement="W1328_Task10"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1328_Task11_di" bpmnElement="W1328_Task11"><dc:Bounds x="1450" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1328_Start5_di" bpmnElement="W1328_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1328_End12_di" bpmnElement="W1328_End12"><dc:Bounds x="1680" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1328_Annotation13_di" bpmnElement="W1328_Annotation13"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1328_Flow15_di" bpmnElement="W1328_Flow15"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1328_Flow16_di" bpmnElement="W1328_Flow16"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1328_Flow17_di" bpmnElement="W1328_Flow17"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1328_Flow18_di" bpmnElement="W1328_Flow18"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1328_Flow19_di" bpmnElement="W1328_Flow19"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1328_Flow20_di" bpmnElement="W1328_Flow20"><di:waypoint x="1420" y="335" /><di:waypoint x="1450" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1328_Flow21_di" bpmnElement="W1328_Flow21"><di:waypoint x="1630" y="505" /><di:waypoint x="1680" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1328_Assoc14_di" bpmnElement="W1328_Assoc14"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1329" name="W1329. Key Risk Indicator (KRI) Monitoring &amp; Automated Alert Management" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly KRI reporting cycle; or automated alert triggered by KRI threshold breach
Frequency: Monthly KRI dashboard review; automated daily/weekly threshold monitoring; quarterly KRI calibration
Volume: ~40–50 KRIs across 8 risk categories (financial, operational, supply chain, compliance, technology, people, reputational, strategic)
Owner: Head of Internal Audit (acting as Risk Officer)
Participants: BI Analyst, Department Heads (KRI owners), CFO, CEO
Source: workflow W1329 — Key Risk Indicator (KRI) Monitoring &amp; Automated Alert Management</bpmn:documentation>
      <bpmn:laneSet id="W1329_LaneSet4">
        <bpmn:lane id="W1329_Lane1" name="Head of IA">
        <bpmn:flowNodeRef>W1329_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1329_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1329_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1329_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1329_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1329_Lane2" name="BI Analyst">
        <bpmn:flowNodeRef>W1329_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1329_Lane3" name="Department Heads">
        <bpmn:flowNodeRef>W1329_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1329_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1329_Start5" name="Monthly KRI reporting cycle; or automated alert triggered by KRI threshold breach">
        <bpmn:outgoing>W1329_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1329_Task6" name="KRI definition &amp; threshold setting">
        <bpmn:documentation>Step 1: KRI definition &amp; threshold setting: Head of IA defines KRIs for each of the top 20 corporate risks from W122: (a) for each risk, identify 2–3 leading indicators that predict risk escalation (e.g., Risk: Supply chain disruption → KRIs: vendor OTIF rate, port congestion index, safety stock coverage days), (b) set three threshold levels per KRI: Green (normal — within risk appetite), Amber (elevated — approaching risk limit, requires monitoring), Red (critical — exceeds risk appetite, requires immediate action), (c) define data source, calculation methodology, and reporting frequency for each KRI, (d) examples: Financial: days sales outstanding (DSO), current ratio, FX exposure as % of revenue; Operational: store revenue variance to plan, inventory turnover, shrinkage rate; Supply chain: vendor OTIF rate, import lead time variance, DC throughput; Compliance: open audit findings aging, regulatory permit expiry count; Technology: system uptime %, cybersecurity incident count, data backup success rate; People: employee turnover rate, vacancy rate, training completion %; Reputational: CSAT score, social media sentiment, NPS; Strategic: new store revenue ramp vs. plan, ecommerce GMV growth rate, market share trend
Responsible (R): Head of IA / BI Analyst
Accountable (A): CEO
Duration: 5–8 days (initial setup); 1 day/year (refresh)</bpmn:documentation>
        <bpmn:incoming>W1329_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1329_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1329_Task7" name="Automated KRI dashboard configuration">
        <bpmn:documentation>Step 2: Automated KRI dashboard configuration: BI Analyst configures KRI dashboard in BI platform: (a) data feeds from ERP modules (finance, supply chain, HR, POS, IT monitoring), (b) threshold rules with automated color-coding (Green/Amber/Red), (c) trend visualization (3-month rolling, 12-month trend), (d) drill-down capability from KRI to underlying data, (e) automated alert generation: email + dashboard notification when KRI crosses threshold, (f) alert routing: Amber → Department Head (KRI owner), Red → Department Head + VP + Head of IA
Responsible (R): BI Analyst
Accountable (A): BI Manager
Duration: 3–5 days (initial); 1 day/quarter (maintenance)</bpmn:documentation>
        <bpmn:incoming>W1329_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1329_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1329_Task8" name="Monthly KRI dashboard review">
        <bpmn:documentation>Step 3: Monthly KRI dashboard review: Head of IA reviews KRI dashboard monthly: (a) status of all 40–50 KRIs — count of Green/Amber/Red, (b) new Amber/Red KRIs since last month — identify emerging risks, (c) KRIs that improved or worsened — trend analysis, (d) for each Amber KRI: confirm Department Head is aware and monitoring, (e) for each Red KRI: confirm action plan is in place with deadline, (f) escalate persistent Red KRIs (&gt; 2 consecutive months) to CEO, (g) generate monthly KRI summary for CFO and CEO
Responsible (R): Head of IA
Accountable (A): CEO
Duration: 2–3 hours/month</bpmn:documentation>
        <bpmn:incoming>W1329_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1329_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1329_Task9" name="Department Head KRI ownership">
        <bpmn:documentation>Step 4: Department Head KRI ownership: Each Department Head owns specific KRIs and is responsible for: (a) reviewing their KRIs weekly (automated dashboard access), (b) investigating Amber alerts within 5 business days, (c) developing and executing action plans for Red KRIs, (d) reporting corrective action progress to Head of IA monthly, (e) proposing threshold adjustments if KRI is generating excessive false positives or is no longer relevant
Responsible (R): Department Heads
Accountable (A): VP (respective function)
Duration: ~1 hour/week</bpmn:documentation>
        <bpmn:incoming>W1329_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1329_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1329_Task10" name="Quarterly KRI calibration">
        <bpmn:documentation>Step 5: Quarterly KRI calibration: Head of IA reviews KRI effectiveness quarterly: (a) which KRIs provided actionable early warning vs. which were noise?, (b) should any KRIs be added (new risks identified in W122) or removed (no longer relevant)?, (c) are thresholds appropriately calibrated — too sensitive (excessive Amber/Red alerts) or too loose (risks materialize without alert)?, (d) compare KRI alerts to actual risk events — did KRIs predict the risks that materialized?, (e) adjust thresholds and KRI definitions based on calibration findings
Responsible (R): Head of IA / BI Analyst
Accountable (A): CEO
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W1329_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1329_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1329_Task11" name="Annual KRI effectiveness report">
        <bpmn:documentation>Step 6: Annual KRI effectiveness report: Head of IA prepares annual KRI effectiveness report for Board Risk Committee: (a) summary of all KRI alerts during the year, (b) prediction accuracy: % of risk events that were preceded by a KRI alert, (c) response effectiveness: time from alert to action plan, (d) calibration changes made during the year, (e) recommendations for KRI framework improvements, (f) integration with W122 annual ERM report
Responsible (R): Head of IA
Accountable (A): Board Risk Committee
Duration: 2 days/year</bpmn:documentation>
        <bpmn:incoming>W1329_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1329_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1329_End12" name="Complete">
        <bpmn:incoming>W1329_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1329_Annotation13">
        <bpmn:text>Controls: - CTL-305 (ensure controlled execution — Enterprise Risk Management (PA-21.2).) | - operational: quarterly calibration to reduce false positives and threshold adjustment; operational: using proxy indicators and manual assessment where needed; operational: using counter-metrics and Internal Audit spot checks
Owner: Head of Internal Audit (acting as Risk Officer)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1329_Assoc14" sourceRef="W1329_Annotation13" targetRef="W1329_Start5" associationDirection="None" />
