    <bpmn:process id="W_W123" name="W123. Fraud Investigation Protocol" isExecutable="false">
      <bpmn:documentation>Trigger: Whistleblower tip (W79), LP Exception (W37), or Audit discovery
Frequency: Ad-hoc
Volume: ~5–10 investigations/year
Owner: Head of Internal Audit
Participants: HR (for employee discipline), Legal (for prosecution), Security
Source: workflow W123 — Fraud Investigation Protocol</bpmn:documentation>
      <bpmn:laneSet id="W123_LaneSet5">
        <bpmn:lane id="W123_Lane1" name="Audit Team">
        <bpmn:flowNodeRef>W123_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W123_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W123_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W123_Lane2" name="Head of IA">
        <bpmn:flowNodeRef>W123_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W123_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W123_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W123_Lane3" name="HR Manager">
        <bpmn:flowNodeRef>W123_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W123_Lane4" name="Legal Counsel">
        <bpmn:flowNodeRef>W123_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W123_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W123_Start6" name="Whistleblower tip (W79), LP Exception (W37), or Audit discovery">
        <bpmn:outgoing>W123_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W123_Task7" name="Intake of report/discovery; initial evidence review (CCTV, ERP logs)">
        <bpmn:documentation>Step 1: Intake of report/discovery; initial evidence review (CCTV, ERP logs)
Responsible (R): Audit Team
Accountable (A): Head of IA
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W123_Flow17</bpmn:incoming>
        <bpmn:outgoing>W123_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W123_Task8" name="Form Investigation Committee (IA, HR, Legal)">
        <bpmn:documentation>Step 2: Form Investigation Committee (IA, HR, Legal)
Responsible (R): Head of IA
Accountable (A): CEO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W123_Flow18</bpmn:incoming>
        <bpmn:outgoing>W123_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W123_Task9" name="Detailed Forensic Audit: Transaction tracing, witness interviews">
        <bpmn:documentation>Step 3: Detailed Forensic Audit: Transaction tracing, witness interviews
Responsible (R): Audit Team
Accountable (A): Head of IA
Duration: 1–3 weeks</bpmn:documentation>
        <bpmn:incoming>W123_Flow19</bpmn:incoming>
        <bpmn:outgoing>W123_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W123_Task10" name="Investigative Report: Document findings, suspects, and loss value">
        <bpmn:documentation>Step 4: Investigative Report: Document findings, suspects, and loss value
Responsible (R): Head of IA
Accountable (A): CEO
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W123_Flow20</bpmn:incoming>
        <bpmn:outgoing>W123_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W123_Task11" name="Administrative Hearing / Disciplinary Action">
        <bpmn:documentation>Step 5: Administrative Hearing / Disciplinary Action
Responsible (R): HR Manager
Accountable (A): CHRO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W123_Flow21</bpmn:incoming>
        <bpmn:outgoing>W123_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W123_Task12" name="Legal Action (if applicable): Filing of criminal/civil cases">
        <bpmn:documentation>Step 6: Legal Action (if applicable): Filing of criminal/civil cases
Responsible (R): Legal Counsel
Accountable (A): VP Legal
Duration: 1–3 months</bpmn:documentation>
        <bpmn:incoming>W123_Flow22</bpmn:incoming>
        <bpmn:outgoing>W123_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W123_Task13" name="Control Gap Remediation: Update process to prevent recurrence">
        <bpmn:documentation>Step 7: Control Gap Remediation: Update process to prevent recurrence
Responsible (R): Head of IA
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W123_Flow23</bpmn:incoming>
        <bpmn:outgoing>W123_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W123_End14" name="Complete">
        <bpmn:incoming>W123_Flow24</bpmn:incoming>
      </bpmn:endEvent>
