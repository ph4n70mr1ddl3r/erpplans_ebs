    <bpmn:process id="W_W1462" name="W1462. Store-Level Cash Handling Risk Assessment &amp; Robbery/Fraud Incident Response" isExecutable="false">
      <bpmn:documentation>Trigger: Store robbery or theft incident; quarterly cash handling risk assessment; or new store opening
Frequency: Risk assessment: quarterly per store; Incident response: as-needed (~2–4 robbery attempts/month across 200 stores)
Volume: ~200 stores assessed quarterly; ~24–48 robbery incidents/year; ~100–200 internal fraud investigations/year
Owner: Regional Loss Prevention Officer
Participants: Regional LP Officer, Store Manager, COO, VP Legal, PNP, Insurance Claims Processor
Source: workflow W1462 — Store-Level Cash Handling Risk Assessment &amp; Robbery/Fraud Incident Response</bpmn:documentation>
      <bpmn:laneSet id="W1462_LaneSet3">
        <bpmn:lane id="W1462_Lane1" name="Regional LP Officer">
        <bpmn:flowNodeRef>W1462_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1462_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1462_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1462_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1462_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1462_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1462_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W1462_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1462_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1462_Start4" name="Store robbery or theft incident; quarterly cash handling risk assessment; or new store…">
        <bpmn:outgoing>W1462_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1462_Task5" name="Quarterly risk assessment">
        <bpmn:documentation>Step 1: Quarterly risk assessment: Visit each store quarterly; observe cash handling per W517/W541/W1415; inspect safe, CCTV, access controls; review POS void/override/refund exception reports
Responsible (R): Regional LP Officer
Accountable (A): COO
Duration: 2–3 hours/store</bpmn:documentation>
        <bpmn:incoming>W1462_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1462_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1462_Task6" name="Risk scoring">
        <bpmn:documentation>Step 2: Risk scoring: Assign Cash Handling Risk Score (1–5); 4–5 stores get mandatory remediation within 2 weeks; 30-day follow-up
Responsible (R): Regional LP Officer
Accountable (A): COO
Duration: 1 hour/store</bpmn:documentation>
        <bpmn:incoming>W1462_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1462_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1462_Task7" name="Robbery response">
        <bpmn:documentation>Step 3: Robbery response: Immediate: safety, call PNP, panic alarm; Short-term: Robbery Incident Report, evidence preservation, PNP investigation, employee trauma support; Insurance: file claim per W863
Responsible (R): Store Manager / Regional LP Officer
Accountable (A): COO
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W1462_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1462_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1462_Task8" name="Internal fraud investigation">
        <bpmn:documentation>Step 4: Internal fraud investigation: Review exception data (cashier shortages, high void/refund rates, sweethearting); discreet CCTV investigation; if confirmed: suspend, VP Legal review, termination per W53
Responsible (R): Regional LP Officer
Accountable (A): VP Legal
Duration: 4–8 hours/case</bpmn:documentation>
        <bpmn:incoming>W1462_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1462_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1462_Task9" name="Post-incident security upgrade">
        <bpmn:documentation>Step 5: Post-incident security upgrade: Evaluate improvements (CCTV, time-lock safe, armored car frequency, security guard); CAPEX per W21
Responsible (R): Regional LP Officer
Accountable (A): COO
Duration: 2–4 hours/incident</bpmn:documentation>
        <bpmn:incoming>W1462_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1462_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1462_Task10" name="Monthly LP report">
        <bpmn:documentation>Step 6: Monthly LP report: Stores assessed, risk scores, incidents by region, cash loss vs. budget, insurance status, trends
Responsible (R): Regional LP Officer
Accountable (A): COO
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1462_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1462_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1462_End11" name="Complete">
        <bpmn:incoming>W1462_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1462_Annotation12">
        <bpmn:text>Controls: - CTL-305 (ensure controlled execution — Enterprise Risk Management (PA-21.2).) | - operational: Regional Loss Prevention Officer review and approval gate
Owner: Regional Loss Prevention Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1462_Assoc13" sourceRef="W1462_Annotation12" targetRef="W1462_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1462_Flow14" sourceRef="W1462_Start4" targetRef="W1462_Task5" />
