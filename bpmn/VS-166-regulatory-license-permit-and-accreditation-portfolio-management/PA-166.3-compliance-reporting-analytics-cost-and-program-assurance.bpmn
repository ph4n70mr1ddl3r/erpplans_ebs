    <bpmn:process id="W_W4857" name="W4857. Executive Compliance Dashboard, Board Reporting &amp; KPI Suite" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly/quarterly executive &amp; board cycle (VS-36); KPI refresh
Frequency: Monthly + quarterly board
Volume: 1 executive dashboard; ~board reporting cycles
Owner: Compliance Portfolio Manager / Analytics (VS-28)
Participants: VP Legal &amp; Compliance, CCO, domain owners, Board/Audit &amp; Risk Committee
Source: workflow W4857 — Executive Compliance Dashboard, Board Reporting &amp; KPI Suite</bpmn:documentation>
      <bpmn:laneSet id="W4857_LaneSet3">
        <bpmn:lane id="W4857_Lane1" name="Analytics">
        <bpmn:flowNodeRef>W4857_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4857_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4857_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4857_Lane2" name="VP Legal &amp; Compliance">
        <bpmn:flowNodeRef>W4857_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4857_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4857_Start4" name="Monthly/quarterly executive &amp; board cycle (VS-36); KPI refresh">
        <bpmn:outgoing>W4857_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4857_Task5" name="Maintain the KPI suite: coverage %, on-time-renewal %, expiring-soon, at-risk…">
        <bpmn:documentation>Step 1: Maintain the KPI suite: coverage %, on-time-renewal %, expiring-soon, at-risk, lapse incidents, penalty $, inspection findings, regulator-change adoption %, provider performance, cost; slice by entity/site/domain
Responsible (R): Analytics / Compliance Operations
Accountable (A): Compliance Portfolio Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4857_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4857_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4857_Task6" name="Maintain the executive dashboard (W4845): real-time portfolio health, heat-map…">
        <bpmn:documentation>Step 2: Maintain the executive dashboard (W4845): real-time portfolio health, heat-map by site/domain, top risks, trend; distribute monthly to executives and domain owners
Responsible (R): Analytics / Compliance Operations
Accountable (A): Compliance Portfolio Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4857_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4857_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4857_Task7" name="Report to the board/audit &amp; risk committee (VS-36.1) quarterly: portfolio…">
        <bpmn:documentation>Step 3: Report to the board/audit &amp; risk committee (VS-36.1) quarterly: portfolio status, material risks (store-closing/bid-blocking), lapse/penalty/inspection events, emerging regulatory risk (W4847), and program maturity (W4864); ensure officer-personal-liability exposure is disclosed
Responsible (R): VP Legal &amp; Compliance / Compliance Portfolio Manager
Accountable (A): VP Legal &amp; Compliance / Board Audit &amp; Risk Committee
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4857_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4857_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4857_End8" name="Complete">
        <bpmn:incoming>W4857_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4857_Annotation9">
        <bpmn:text>Controls: - CTL-730 (ensure controlled execution — Compliance Reporting, Analytics, Cost &amp; Program Assurance (PA-166.3).) | - CTL-730: KPIs reconciled to source data; quarterly board reporting; officer-liability disclosed
Owner: Compliance Portfolio Manager / Analytics (VS-28)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4857_Assoc10" sourceRef="W4857_Annotation9" targetRef="W4857_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4857_Flow11" sourceRef="W4857_Start4" targetRef="W4857_Task5" />
      <bpmn:sequenceFlow id="W4857_Flow12" sourceRef="W4857_Task5" targetRef="W4857_Task6" />
      <bpmn:sequenceFlow id="W4857_Flow13" sourceRef="W4857_Task6" targetRef="W4857_Task7" />
      <bpmn:sequenceFlow id="W4857_Flow14" sourceRef="W4857_Task7" targetRef="W4857_End8" />
    </bpmn:process>
