    <bpmn:process id="W_W4864" name="W4864. Program Maturity Assessment, Operating-Model Optimization &amp; Continuous Improvement" isExecutable="false">
      <bpmn:documentation>Trigger: Annual program review; maturity assessment; major incident (W4853/W4858); strategy refresh (W4841)
Frequency: Annual + on incident
Volume: 1 program
Owner: VP Legal &amp; Compliance / Chief Compliance Officer / Compliance Portfolio Manager
Participants: Strategy (VS-33), Internal Audit (VS-21), OpEx (VS-133), domain owners
Source: workflow W4864 — Program Maturity Assessment, Operating-Model Optimization &amp; Continuous Improvement</bpmn:documentation>
      <bpmn:laneSet id="W4864_LaneSet2">
        <bpmn:lane id="W4864_Lane1" name="Compliance Portfolio">
