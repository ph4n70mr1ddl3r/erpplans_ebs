        <bpmn:flowNodeRef>W4861_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4861_Start4" name="Data-quality review; master-data change (VS-29); duplicate detection; analytics anomaly">
        <bpmn:outgoing>W4861_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4861_Task5" name="Govern the register&#x27;s data quality: the data model (W4841), mandatory fields…">
        <bpmn:documentation>Step 1: Govern the register&#x27;s data quality: the data model (W4841), mandatory fields, validation rules, and the update SLA from domain owners; designate the register as the single source of truth synced to/from the site/entity master (VS-29)
Responsible (R): Compliance Operations / Master Data
Accountable (A): Compliance Portfolio Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4861_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4861_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4861_Task6" name="Detect &amp; resolve data issues: duplicates (same permit entered twice), gaps…">
        <bpmn:documentation>Step 2: Detect &amp; resolve data issues: duplicates (same permit entered twice), gaps (missing expiry/owner/evidence), stale entries (expired not updated), and mismatches (register vs finance/records/portals); run periodic cleanup campaigns
Responsible (R): Master Data / Compliance Operations / Analytics
Accountable (A): Compliance Portfolio Manager
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W4861_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4861_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4861_Task7" name="Enforce data-quality KPIs (completeness, accuracy, timeliness), report…">
        <bpmn:documentation>Step 3: Enforce data-quality KPIs (completeness, accuracy, timeliness), report register-health to governance (W4864), and continuously improve the data model and integrations (e.g., auto-sync from regulator portals, finance, store lifecycle)
Responsible (R): Master Data / Analytics
Accountable (A): Compliance Portfolio Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4861_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4861_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4861_End8" name="Complete">
        <bpmn:incoming>W4861_Flow14</bpmn:incoming>
      </bpmn:endEvent>
