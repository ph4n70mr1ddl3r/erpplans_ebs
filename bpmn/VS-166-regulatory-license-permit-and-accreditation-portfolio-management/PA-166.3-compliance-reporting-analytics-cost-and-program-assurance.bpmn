        <bpmn:outgoing>W4862_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4862_Task5" name="Analyze &amp; benchmark: vs prior periods, vs industry/peer benchmarks (where…">
