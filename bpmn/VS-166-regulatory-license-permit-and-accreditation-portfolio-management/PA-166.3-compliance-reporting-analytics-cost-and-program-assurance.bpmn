      <bpmndi:BPMNPlane id="W4857_plane" bpmnElement="W_W4857">
        <bpmndi:BPMNShape id="W4857_Lane1_di" bpmnElement="W4857_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
