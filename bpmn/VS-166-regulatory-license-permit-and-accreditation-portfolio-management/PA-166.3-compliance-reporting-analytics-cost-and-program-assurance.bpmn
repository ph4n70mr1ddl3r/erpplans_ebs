    <bpmn:process id="W_W4859" name="W4859. Permit-Portfolio Cost Management &amp; Compliance-Spend Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Annual budget cycle; quarterly cost review; provider/fee benchmarking
Frequency: Quarterly + annual budget
Volume: Group compliance-spend (fees, providers W4854, internal cost)
Owner: Compliance Portfolio Manager / Finance (VS-17.4 FP&amp;A)
Participants: Domain owners, Procurement (VS-03/VS-34), Treasury (VS-18)
Source: workflow W4859 — Permit-Portfolio Cost Management &amp; Compliance-Spend Analytics</bpmn:documentation>
      <bpmn:laneSet id="W4859_LaneSet4">
        <bpmn:lane id="W4859_Lane1" name="Compliance Operations">
        <bpmn:flowNodeRef>W4859_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4859_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4859_Lane2" name="Finance">
        <bpmn:flowNodeRef>W4859_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4859_Lane3" name="Compliance Portfolio">
        <bpmn:flowNodeRef>W4859_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4859_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4859_Start5" name="Annual budget cycle; quarterly cost review; provider/fee benchmarking">
        <bpmn:outgoing>W4859_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4859_Task6" name="Maintain the compliance-spend ledger: permit/license fees, renewal fees…">
        <bpmn:documentation>Step 1: Maintain the compliance-spend ledger: permit/license fees, renewal fees, third-party provider fees (W4854), internal staffing, penalty/fine payments (W4858), by entity/site/domain/regulator; reconcile to finance (VS-17)
Responsible (R): Compliance Operations / Finance
Accountable (A): Compliance Portfolio Manager / CFO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4859_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4859_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4859_Task7" name="Analyze cost: trend, cost-per-site, benchmark fees/providers, identify cost-out…">
        <bpmn:documentation>Step 2: Analyze cost: trend, cost-per-site, benchmark fees/providers, identify cost-out (provider consolidation, fee negotiation, in-sourcing vs out-sourcing), and forecast the renewal-fee burden; integrate into the annual budget (VS-17.4)
Responsible (R): Finance / Compliance Portfolio / Procurement
Accountable (A): Compliance Portfolio Manager / CFO
Duration: Quarterly + annual</bpmn:documentation>
        <bpmn:incoming>W4859_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4859_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4859_Task8" name="Drive cost optimization: consolidate providers (W4854), negotiate fee schedules…">
        <bpmn:documentation>Step 3: Drive cost optimization: consolidate providers (W4854), negotiate fee schedules (with Government Affairs VS-104 where regulator-set), eliminate duplicate/unused permits, and report cost-out to governance (W4864) and analytics (W4862)
Responsible (R): Compliance Portfolio / Procurement / Finance
Accountable (A): VP Legal &amp; Compliance / CFO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4859_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4859_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4859_End9" name="Complete">
        <bpmn:incoming>W4859_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4859_Annotation10">
        <bpmn:text>Controls: - CTL-730 (ensure controlled execution — Compliance Reporting, Analytics, Cost &amp; Program Assurance (PA-166.3).) | - CTL-730: compliance-spend reconciled to finance; cost-out risk-aware; budgeted annually
Owner: Compliance Portfolio Manager / Finance (VS-17.4 FP&amp;A)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4859_Assoc11" sourceRef="W4859_Annotation10" targetRef="W4859_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W4859_Flow12" sourceRef="W4859_Start5" targetRef="W4859_Task6" />
      <bpmn:sequenceFlow id="W4859_Flow13" sourceRef="W4859_Task6" targetRef="W4859_Task7" />
      <bpmn:sequenceFlow id="W4859_Flow14" sourceRef="W4859_Task7" targetRef="W4859_Task8" />
      <bpmn:sequenceFlow id="W4859_Flow15" sourceRef="W4859_Task8" targetRef="W4859_End9" />
    </bpmn:process>
