      <bpmndi:BPMNPlane id="W4859_plane" bpmnElement="W_W4859">
        <bpmndi:BPMNShape id="W4859_Lane1_di" bpmnElement="W4859_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4859_Lane2_di" bpmnElement="W4859_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4859_Lane3_di" bpmnElement="W4859_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4859_Task6_di" bpmnElement="W4859_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4859_Task7_di" bpmnElement="W4859_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4859_Task8_di" bpmnElement="W4859_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
