    <bpmn:process id="W_W4858" name="W4858. Penalty/Fine Management, Dispute Resolution &amp; Regulatory-Debt Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Penalty/fine notice (from any regulator); inspection finding (W4852); dispute
Frequency: Ad hoc
Volume: ~10–20 penalty events per year (mostly minor LGU/administrative)
Owner: Compliance Portfolio Manager / Legal (VS-100.3) / Finance
Participants: Domain owners, Finance (VS-17 payment), Government Affairs (VS-104), External counsel
Source: workflow W4858 — Penalty/Fine Management, Dispute Resolution &amp; Regulatory-Debt Tracking</bpmn:documentation>
      <bpmn:laneSet id="W4858_LaneSet4">
        <bpmn:lane id="W4858_Lane1" name="Compliance Operations">
        <bpmn:flowNodeRef>W4858_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4858_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4858_Lane2" name="Legal">
        <bpmn:flowNodeRef>W4858_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4858_Lane3" name="Compliance Portfolio Manager">
        <bpmn:flowNodeRef>W4858_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4858_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4858_Start5" name="Penalty/fine notice (from any regulator); inspection finding (W4852); dispute">
        <bpmn:outgoing>W4858_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4858_Task6" name="Receive &amp; log the penalty/fine notice, assess validity &amp; exposure (fine amount…">
        <bpmn:documentation>Step 1: Receive &amp; log the penalty/fine notice, assess validity &amp; exposure (fine amount, recurring nature, license/operational impact), decide pay-vs-dispute, and assign the owner; record in the regulatory-debt tracker
Responsible (R): Compliance Operations / Legal / Domain Owner
Accountable (A): Compliance Portfolio Manager / VP Legal &amp; Compliance
Duration: Per event (immediate)</bpmn:documentation>
        <bpmn:incoming>W4858_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4858_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4858_Task7" name="Execute: pay the fine (VS-17) or file the dispute/appeal within the deadline…">
        <bpmn:documentation>Step 2: Execute: pay the fine (VS-17) or file the dispute/appeal within the deadline (with Legal/Government Affairs/external counsel), negotiate mitigation, and manage any license/operational consequence (W4853) during the dispute
Responsible (R): Legal / Finance / Government Affairs / Domain Owner
Accountable (A): VP Legal &amp; Compliance / CFO
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4858_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4858_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4858_Task8" name="Close &amp; learn: record the outcome in the audit trail (W4846) and legal matter…">
        <bpmn:documentation>Step 3: Close &amp; learn: record the outcome in the audit trail (W4846) and legal matter (VS-100.3), conduct root-cause (ownership failure, process failure, provider failure W4854), strengthen controls, and feed penalty-trend to risk tiering (W4848), governance (W4864), and analytics (W4862)
Responsible (R): Compliance Portfolio Manager / Internal Audit
Accountable (A): VP Legal &amp; Compliance
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4858_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4858_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4858_End9" name="Complete">
        <bpmn:incoming>W4858_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4858_Annotation10">
        <bpmn:text>Controls: - CTL-730 (ensure controlled execution — Compliance Reporting, Analytics, Cost &amp; Program Assurance (PA-166.3).) | - CTL-730: penalty disputes/payments within deadline; debt tracked; root-cause reviewed
Owner: Compliance Portfolio Manager / Legal (VS-100.3) / Finance</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4858_Assoc11" sourceRef="W4858_Annotation10" targetRef="W4858_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W4858_Flow12" sourceRef="W4858_Start5" targetRef="W4858_Task6" />
      <bpmn:sequenceFlow id="W4858_Flow13" sourceRef="W4858_Task6" targetRef="W4858_Task7" />
      <bpmn:sequenceFlow id="W4858_Flow14" sourceRef="W4858_Task7" targetRef="W4858_Task8" />
      <bpmn:sequenceFlow id="W4858_Flow15" sourceRef="W4858_Task8" targetRef="W4858_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4858_diag">
      <bpmndi:BPMNPlane id="W4858_plane" bpmnElement="W_W4858">
        <bpmndi:BPMNShape id="W4858_Lane1_di" bpmnElement="W4858_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4858_Lane2_di" bpmnElement="W4858_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4858_Lane3_di" bpmnElement="W4858_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
