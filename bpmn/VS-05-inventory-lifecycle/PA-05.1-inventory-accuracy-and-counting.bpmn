    <bpmn:process id="W_W6" name="W6. Cycle Counting &amp; Inventory Accuracy" isExecutable="false">
      <bpmn:documentation>Trigger: Daily schedule (rolling through all sections)
Frequency: Daily per store; each SKU counted at least once per quarter
Volume: ~700 SKUs/day per store; 200 stores × 700 = 140,000 SKU counts/day chain-wide
Owner: Department Supervisor
Participants: Stock Associate (counter), Department Supervisor (reviewer), Store Manager (approver for adjustments)
Source: workflow W6 — Cycle Counting &amp; Inventory Accuracy</bpmn:documentation>
      <bpmn:laneSet id="W6_LaneSet5">
        <bpmn:lane id="W6_Lane1" name="System">
        <bpmn:flowNodeRef>W6_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W6_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W6_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W6_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W6_Lane2" name="Stock Associate">
        <bpmn:flowNodeRef>W6_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W6_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W6_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W6_Lane3" name="Dept. Supervisor">
        <bpmn:flowNodeRef>W6_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W6_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W6_Lane4" name="Store Manager">
        <bpmn:flowNodeRef>W6_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W6_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W6_Start6" name="Daily schedule (rolling through all sections)">
        <bpmn:outgoing>W6_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W6_Task7" name="System generates daily count assignment by section/aisle">
        <bpmn:documentation>Step 1: System generates daily count assignment by section/aisle
Responsible (R): System
Accountable (A): —
Duration: Automated (nightly)</bpmn:documentation>
        <bpmn:incoming>W6_Flow19</bpmn:incoming>
        <bpmn:outgoing>W6_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W6_Task8" name="Stock Associate retrieves count sheet on handheld/RF device">
        <bpmn:documentation>Step 2: Stock Associate retrieves count sheet on handheld/RF device
Responsible (R): Stock Associate
Accountable (A): Department Supervisor
Duration: —</bpmn:documentation>
        <bpmn:incoming>W6_Flow20</bpmn:incoming>
        <bpmn:outgoing>W6_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W6_Task9" name="Physically count each SKU in assigned section; enter quantity into device (4…">
        <bpmn:documentation>Step 3: Physically count each SKU in assigned section; enter quantity into device (4 Stock Associates each count ~175 SKUs/day, taking ~30 min each at ~10 sec/SKU)
Responsible (R): Stock Associate
Accountable (A): Department Supervisor
Duration: ~40 min per associate</bpmn:documentation>
        <bpmn:incoming>W6_Flow21</bpmn:incoming>
        <bpmn:outgoing>W6_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W6_Task10" name="System compares physical count to system count; flags variances">
        <bpmn:documentation>Step 4: System compares physical count to system count; flags variances
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W6_Flow22</bpmn:incoming>
        <bpmn:outgoing>W6_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W6_Task11" name="For flagged items: Stock Associate recounts (blind recount)">
        <bpmn:documentation>Step 5: For flagged items: Stock Associate recounts (blind recount)
Responsible (R): Stock Associate
Accountable (A): Department Supervisor
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W6_Flow23</bpmn:incoming>
        <bpmn:outgoing>W6_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W6_Task12" name="If variance confirmed: Department Supervisor reviews and approves adjustment">
        <bpmn:documentation>Step 6: If variance confirmed: Department Supervisor reviews and approves adjustment
Responsible (R): Dept. Supervisor
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W6_Flow24</bpmn:incoming>
        <bpmn:outgoing>W6_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W6_Task13" name="If adjustment &gt; PHP 10,000 or &gt; 5% of SKU value: Store Manager approval required">
        <bpmn:documentation>Step 7: If adjustment &gt; PHP 10,000 or &gt; 5% of SKU value: Store Manager approval required
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 5 min each</bpmn:documentation>
        <bpmn:incoming>W6_Flow25</bpmn:incoming>
        <bpmn:outgoing>W6_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W6_Task14" name="System posts inventory adjustment; audit trail recorded">
        <bpmn:documentation>Step 8: System posts inventory adjustment; audit trail recorded
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W6_Flow26</bpmn:incoming>
        <bpmn:outgoing>W6_Flow27</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W6_Task15" name="Root cause analysis for recurring variances (theft, damage, receiving errors)">
        <bpmn:documentation>Step 9: Root cause analysis for recurring variances (theft, damage, receiving errors)
Responsible (R): Dept. Supervisor
Accountable (A): Store Manager
Duration: Weekly review</bpmn:documentation>
        <bpmn:incoming>W6_Flow27</bpmn:incoming>
        <bpmn:outgoing>W6_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W6_End16" name="Complete">
        <bpmn:incoming>W6_Flow28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W6_Annotation17">
        <bpmn:text>Controls: - CTL-11 (separate inventory counting from adjustment approval.); CTL-21 (ensure inventory accuracy.) | - operational: Department Supervisor review and approval gate
Owner: Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
