    <bpmn:process id="W_W23" name="W23. Consignment Inventory Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Consignment goods received at store/DC; or consignment goods sold
Frequency: ~15–25 consignment vendors; settlement monthly
Volume: ~300 consignment SKUs from ~15–25 consignment vendors (primarily appliances, select tiles, fixtures; one register with W1188/W1275/W925)
Owner: Buyer (consignment agreements)
Participants: Buyer, Receiving Clerk, Cashier, AP Clerk, Consignment Vendor
Source: workflow W23 — Consignment Inventory Operations</bpmn:documentation>
      <bpmn:laneSet id="W23_LaneSet7">
        <bpmn:lane id="W23_Lane1" name="Buyer">
        <bpmn:flowNodeRef>W23_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W23_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W23_Task18</bpmn:flowNodeRef>
