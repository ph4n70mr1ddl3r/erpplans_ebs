        </bpmn:lane>
        <bpmn:lane id="W23_Lane2" name="Merchandise Planner">
        <bpmn:flowNodeRef>W23_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W23_Lane3" name="Receiving Clerk">
        <bpmn:flowNodeRef>W23_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W23_Lane4" name="System">
        <bpmn:flowNodeRef>W23_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W23_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W23_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W23_Lane5" name="Cashier">
        <bpmn:flowNodeRef>W23_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W23_Lane6" name="AP Clerk">
        <bpmn:flowNodeRef>W23_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W23_End19</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W23_Start8" name="Consignment goods received at store/DC; or consignment goods sold">
        <bpmn:outgoing>W23_Flow22</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W23_Task9" name="Buyer establishes consignment agreement: vendor, SKUs, consignment price…">
        <bpmn:documentation>Step 1: Buyer establishes consignment agreement: vendor, SKUs, consignment price, settlement terms
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: Per vendor setup</bpmn:documentation>
        <bpmn:incoming>W23_Flow22</bpmn:incoming>
        <bpmn:outgoing>W23_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W23_Task10" name="System flags consignment items in item master with vendor ownership indicator">
        <bpmn:documentation>Step 2: System flags consignment items in item master with vendor ownership indicator
Responsible (R): Merchandise Planner
Accountable (A): Buyer
Duration: 5 min/SKU</bpmn:documentation>
        <bpmn:incoming>W23_Flow23</bpmn:incoming>
        <bpmn:outgoing>W23_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W23_Task11" name="Vendor delivers consignment goods; Receiving Clerk processes GR (standard…">
        <bpmn:documentation>Step 3: Vendor delivers consignment goods; Receiving Clerk processes GR (standard receiving)
Responsible (R): Receiving Clerk
Accountable (A): Dept. Supervisor
Duration: Per W3/W18</bpmn:documentation>
        <bpmn:incoming>W23_Flow24</bpmn:incoming>
        <bpmn:outgoing>W23_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W23_Task12" name="System records consignment receipt as non-valuated inventory (vendor-owned)">
        <bpmn:documentation>Step 4: System records consignment receipt as non-valuated inventory (vendor-owned)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W23_Flow25</bpmn:incoming>
        <bpmn:outgoing>W23_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W23_Task13" name="Consignment items displayed and sold on sales floor; POS scans barcode normally">
        <bpmn:documentation>Step 5: Consignment items displayed and sold on sales floor; POS scans barcode normally
Responsible (R): Cashier
Accountable (A): —
Duration: Part of sale</bpmn:documentation>
        <bpmn:incoming>W23_Flow26</bpmn:incoming>
        <bpmn:outgoing>W23_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W23_Task14" name="At sale: system records sell-through event; ownership transfers from vendor to…">
        <bpmn:documentation>Step 6: At sale: system records sell-through event; ownership transfers from vendor to company to customer; system posts GL entries: Dr. Cost of Goods Sold / Cr. Consignment Vendor Payable (at consignment cost); simultaneously Dr. Cash or Accounts Receivable / Cr. Revenue (at selling price)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W23_Flow27</bpmn:incoming>
        <bpmn:outgoing>W23_Flow28</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W23_Task15" name="Monthly: system generates consignment sell-through report per vendor (units…">
        <bpmn:documentation>Step 7: Monthly: system generates consignment sell-through report per vendor (units sold × consignment price)
Responsible (R): System
Accountable (A): Buyer
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W23_Flow28</bpmn:incoming>
        <bpmn:outgoing>W23_Flow29</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W23_Task16" name="Buyer reviews and confirms settlement report">
        <bpmn:documentation>Step 8: Buyer reviews and confirms settlement report
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 1 hour/vendor/month</bpmn:documentation>
        <bpmn:incoming>W23_Flow29</bpmn:incoming>
        <bpmn:outgoing>W23_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W23_Task17" name="AP Clerk processes consignment vendor payment based on confirmed sell-through…">
        <bpmn:documentation>Step 9: AP Clerk processes consignment vendor payment based on confirmed sell-through; system generates AP invoice from sell-through data: Dr. Consignment Vendor Payable / Cr. Cash (settles the accrued liability from step 6)
Responsible (R): AP Clerk
Accountable (A): AP Supervisor
Duration: Per W7</bpmn:documentation>
        <bpmn:incoming>W23_Flow30</bpmn:incoming>
        <bpmn:outgoing>W23_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W23_Task18" name="Quarterly: Buyer reviews consignment SKU performance; identifies slow movers…">
        <bpmn:documentation>Step 10: Quarterly: Buyer reviews consignment SKU performance; identifies slow movers for return to vendor; coordinates physical pickup with vendor (vendor arranges collection or Buyer schedules transport); Receiving Clerk processes return shipment in system (reduces non-valuated consignment inventory; no GL posting since goods remain vendor-owned throughout); vendor confirms received quantities and issues updated consignment stock list; system updates consignment on-hand quantities
Responsible (R): Buyer / Receiving Clerk
Accountable (A): Category Manager
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W23_Flow31</bpmn:incoming>
        <bpmn:outgoing>W23_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W23_End19" name="Complete">
        <bpmn:incoming>W23_Flow32</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W23_Annotation20">
        <bpmn:text>Controls: - CTL-38 (ensure consignment settlement accuracy.) | - operational: Buyer (consignment agreements) review and approval gate; operational: periodic reconciliation against source documents
Owner: Buyer (consignment agreements)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W23_Assoc21" sourceRef="W23_Annotation20" targetRef="W23_Start8" associationDirection="None" />
