      <bpmn:sequenceFlow id="W1486_Flow13" sourceRef="W1486_Task5" targetRef="W1486_Task6" />
      <bpmn:sequenceFlow id="W1486_Flow14" sourceRef="W1486_Task6" targetRef="W1486_Task7" />
      <bpmn:sequenceFlow id="W1486_Flow15" sourceRef="W1486_Task7" targetRef="W1486_Task8" />
      <bpmn:sequenceFlow id="W1486_Flow16" sourceRef="W1486_Task8" targetRef="W1486_End9" />
    </bpmn:process>
