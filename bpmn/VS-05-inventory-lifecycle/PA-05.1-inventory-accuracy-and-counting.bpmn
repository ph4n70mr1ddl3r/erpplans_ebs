      <bpmn:sequenceFlow id="W4_Flow35" sourceRef="W4_Task18" targetRef="W4_Task19" />
      <bpmn:sequenceFlow id="W4_Flow36" sourceRef="W4_Task19" targetRef="W4_Task20" />
      <bpmn:sequenceFlow id="W4_Flow37" sourceRef="W4_Task20" targetRef="W4_Task21" />
      <bpmn:sequenceFlow id="W4_Flow38" sourceRef="W4_Task21" targetRef="W4_Task22" />
      <bpmn:sequenceFlow id="W4_Flow39" sourceRef="W4_Task22" targetRef="W4_Task23" />
      <bpmn:sequenceFlow id="W4_Flow40" sourceRef="W4_Task23" targetRef="W4_Task24" />
      <bpmn:sequenceFlow id="W4_Flow41" sourceRef="W4_Task24" targetRef="W4_End25" />
    </bpmn:process>
