    <bpmn:process id="W_W42" name="W42. Annual Physical Inventory Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Year-end close calendar (typically December 31 or last business day of fiscal year)
Frequency: Annual; each store and DC counted once per year
Volume: 35,000 SKUs × ~205 locations (200 stores + 4 DCs); executed in coordinated 3–5 day window per region
Owner: Cost Accountant (overall); Store Manager (per store); DC Manager (per DC)
Participants: Cost Accountant, Store Managers, DC Managers, all store staff, inventory count teams, IT, Internal Audit
Source: workflow W42 — Annual Physical Inventory Execution</bpmn:documentation>
      <bpmn:laneSet id="W42_LaneSet11">
        <bpmn:lane id="W42_Lane1" name="Cost Accountant">
        <bpmn:flowNodeRef>W42_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W42_Task28</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W42_Task29</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W42_Start12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W42_Lane2" name="IT Team">
        <bpmn:flowNodeRef>W42_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W42_Task27</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W42_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W42_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W42_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W42_Lane4" name="Internal Audit">
        <bpmn:flowNodeRef>W42_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W42_Task25</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W42_Task31</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W42_Lane5" name="System">
        <bpmn:flowNodeRef>W42_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W42_Task21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W42_Task26</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W42_Lane6" name="Count Teams">
        <bpmn:flowNodeRef>W42_Task19</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W42_Lane7" name="Team Leader">
        <bpmn:flowNodeRef>W42_Task20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W42_Task23</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W42_Lane8" name="Recount Team">
        <bpmn:flowNodeRef>W42_Task22</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W42_Lane9" name="Approver">
        <bpmn:flowNodeRef>W42_Task24</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W42_Lane10" name="Controller">
        <bpmn:flowNodeRef>W42_Task30</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W42_End32</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W42_Start12" name="Year-end close calendar (typically December 31 or last business day of fiscal year)">
        <bpmn:outgoing>W42_Flow35</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W42_Task13" name="Cost Accountant issues physical inventory instructions: count dates…">
        <bpmn:documentation>Step 1: Cost Accountant issues physical inventory instructions: count dates, methodology, team assignments, system freeze schedule
Responsible (R): Cost Accountant
Accountable (A): Controller
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W42_Flow35</bpmn:incoming>
        <bpmn:outgoing>W42_Flow36</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W42_Task14" name="IT configures count sheets in system: generate zone-based count sheets per…">
        <bpmn:documentation>Step 2: IT configures count sheets in system: generate zone-based count sheets per location with expected system quantities (hidden for blind count)
Responsible (R): IT Team
Accountable (A): Cost Accountant
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W42_Flow36</bpmn:incoming>
        <bpmn:outgoing>W42_Flow37</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W42_Task15" name="Store Managers organize count teams: assign zones (8 zones per store)…">
        <bpmn:documentation>Step 3: Store Managers organize count teams: assign zones (8 zones per store), designate team leaders, schedule shifts for 2-day count
Responsible (R): Store Manager
Accountable (A): VP Store Operations
Duration: 2 hours/store</bpmn:documentation>
        <bpmn:incoming>W42_Flow37</bpmn:incoming>
        <bpmn:outgoing>W42_Flow38</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W42_Task16" name="Store Managers ensure all receiving and shipments are posted before count…">
        <bpmn:documentation>Step 4: Store Managers ensure all receiving and shipments are posted before count; process pending transactions; stage goods in correct locations
Responsible (R): Store Manager
Accountable (A): VP Store Operations
Duration: 4 hours/store</bpmn:documentation>
        <bpmn:incoming>W42_Flow38</bpmn:incoming>
        <bpmn:outgoing>W42_Flow39</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W42_Task17" name="Internal Audit prepares to observe counts at selected locations (sample: 20–30…">
        <bpmn:documentation>Step 5: Internal Audit prepares to observe counts at selected locations (sample: 20–30 stores + all DCs)
Responsible (R): Internal Audit
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W42_Flow39</bpmn:incoming>
        <bpmn:outgoing>W42_Flow40</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W42_Task18" name="System freezes inventory transactions at count locations (no sales, receiving…">
        <bpmn:documentation>Step 6: System freezes inventory transactions at count locations (no sales, receiving, or transfers during count window)
Responsible (R): System / IT
Accountable (A): Cost Accountant
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W42_Flow40</bpmn:incoming>
        <bpmn:outgoing>W42_Flow41</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W42_Task19" name="Count teams physically count every SKU in assigned zone: two-person teams (one…">
        <bpmn:documentation>Step 7: Count teams physically count every SKU in assigned zone: two-person teams (one counts, one records on RF device/count sheet)
Responsible (R): Count Teams
Accountable (A): Team Leader
Duration: 6–10 hours/location</bpmn:documentation>
        <bpmn:incoming>W42_Flow41</bpmn:incoming>
        <bpmn:outgoing>W42_Flow42</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W42_Task20" name="Team leaders submit zone counts; system compares to system quantities (blind…">
        <bpmn:documentation>Step 8: Team leaders submit zone counts; system compares to system quantities (blind count — system quantity only revealed after team submits)
Responsible (R): Team Leader
Accountable (A): Store Manager
Duration: Per zone</bpmn:documentation>
        <bpmn:incoming>W42_Flow42</bpmn:incoming>
        <bpmn:outgoing>W42_Flow43</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W42_Task21" name="System generates variance report per zone: items where physical count differs…">
        <bpmn:documentation>Step 9: System generates variance report per zone: items where physical count differs from system count
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W42_Flow43</bpmn:incoming>
        <bpmn:outgoing>W42_Flow44</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W42_Task22" name="For items with variance: recount team (different from original) performs blind…">
        <bpmn:documentation>Step 10: For items with variance: recount team (different from original) performs blind recount
Responsible (R): Recount Team
Accountable (A): Store Manager
Duration: 2–4 hours/location</bpmn:documentation>
        <bpmn:incoming>W42_Flow44</bpmn:incoming>
        <bpmn:outgoing>W42_Flow45</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W42_Task23" name="If recount confirms variance: Team Leader investigates and documents root cause…">
        <bpmn:documentation>Step 11: If recount confirms variance: Team Leader investigates and documents root cause (theft, damage, receiving error, data entry error)
Responsible (R): Team Leader
Accountable (A): Store Manager
Duration: 15 min/item</bpmn:documentation>
        <bpmn:incoming>W42_Flow45</bpmn:incoming>
        <bpmn:outgoing>W42_Flow46</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W42_Task24" name="Store Manager reviews and approves adjustments per tier: (a) adjustment ≤ PHP…">
        <bpmn:documentation>Step 12: Store Manager reviews and approves adjustments per tier: (a) adjustment ≤ PHP 10,000: Store Manager, (b) adjustment PHP 10,001–100,000: Regional Manager, (c) adjustment &gt; PHP 100,000: Controller
Responsible (R): Approver
Accountable (A): Approver
Duration: 5–15 min/adjustment</bpmn:documentation>
        <bpmn:incoming>W42_Flow46</bpmn:incoming>
        <bpmn:outgoing>W42_Flow47</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W42_Task25" name="Internal Audit observes counts at sampled locations; validates methodology…">
        <bpmn:documentation>Step 13: Internal Audit observes counts at sampled locations; validates methodology compliance and count accuracy
Responsible (R): Internal Audit
Accountable (A): CFO
Duration: Full count day</bpmn:documentation>
        <bpmn:incoming>W42_Flow47</bpmn:incoming>
        <bpmn:outgoing>W42_Flow48</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W42_Task26" name="System posts approved inventory adjustments; updates inventory valuation; posts…">
        <bpmn:documentation>Step 14: System posts approved inventory adjustments; updates inventory valuation; posts to GL (gain/loss on inventory)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W42_Flow48</bpmn:incoming>
        <bpmn:outgoing>W42_Flow49</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W42_Task27" name="System unfreezes inventory transactions; normal operations resume">
        <bpmn:documentation>Step 15: System unfreezes inventory transactions; normal operations resume
Responsible (R): IT Team
Accountable (A): Cost Accountant
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W42_Flow49</bpmn:incoming>
        <bpmn:outgoing>W42_Flow50</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W42_Task28" name="Cost Accountant reconciles total inventory valuation post-adjustment to GL…">
        <bpmn:documentation>Step 16: Cost Accountant reconciles total inventory valuation post-adjustment to GL inventory accounts
Responsible (R): Cost Accountant
Accountable (A): Controller
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W42_Flow50</bpmn:incoming>
        <bpmn:outgoing>W42_Flow51</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W42_Task29" name="Cost Accountant generates physical inventory summary report: total adjustments…">
        <bpmn:documentation>Step 17: Cost Accountant generates physical inventory summary report: total adjustments by location, by category, by variance type (gain/loss), shrinkage as % of sales
Responsible (R): Cost Accountant
Accountable (A): Controller
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W42_Flow51</bpmn:incoming>
        <bpmn:outgoing>W42_Flow52</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W42_Task30" name="Controller and CFO review physical inventory results; identify high-shrinkage…">
        <bpmn:documentation>Step 18: Controller and CFO review physical inventory results; identify high-shrinkage locations for loss prevention action (W37)
Responsible (R): Controller
Accountable (A): CFO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W42_Flow52</bpmn:incoming>
        <bpmn:outgoing>W42_Flow53</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W42_Task31" name="Internal Audit issues observation report with recommendations for count process…">
        <bpmn:documentation>Step 19: Internal Audit issues observation report with recommendations for count process improvement
Responsible (R): Internal Audit
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W42_Flow53</bpmn:incoming>
        <bpmn:outgoing>W42_Flow54</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W42_End32" name="Complete">
        <bpmn:incoming>W42_Flow54</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W42_Annotation33">
        <bpmn:text>Controls: - CTL-21 (ensure inventory accuracy.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Cost Accountant (overall); Store Manager (per store); DC Manager (per DC)</bpmn:text>
      </bpmn:textAnnotation>
