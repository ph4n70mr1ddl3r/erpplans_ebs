    <bpmn:process id="W_W1188" name="W1188. Consignment Inventory Monthly Reconciliation &amp; Vendor Settlement Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly consignment settlement cycle (last business day of month)
Frequency: Monthly
Volume: ~300 consignment SKUs from ~15–25 consignment vendors across 200 stores; ~60,000 SKU-location consignment records
Owner: Inventory Accountant
Participants: Inventory Accountant, Category Manager, AP Clerk, Vendor (consignment partner), Store Manager
Source: workflow W1188 — Consignment Inventory Monthly Reconciliation &amp; Vendor Settlement Processing</bpmn:documentation>
      <bpmn:laneSet id="W1188_LaneSet7">
        <bpmn:lane id="W1188_Lane1" name="System">
        <bpmn:flowNodeRef>W1188_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1188_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1188_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1188_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W1188_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1188_Lane3" name="Inventory Accountant">
        <bpmn:flowNodeRef>W1188_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1188_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1188_Lane4" name="Vendor">
        <bpmn:flowNodeRef>W1188_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1188_Lane5" name="AP Clerk">
        <bpmn:flowNodeRef>W1188_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1188_Lane6" name="Category Manager">
        <bpmn:flowNodeRef>W1188_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1188_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1188_Start8" name="Monthly consignment settlement cycle (last business day of month)">
        <bpmn:outgoing>W1188_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1188_Task9" name="System sell-through extraction">
        <bpmn:documentation>Step 1: System sell-through extraction: System extracts consignment SKU sales for the month by vendor by store; generates &quot;Sold Consignment Report&quot; with quantity sold, POS transaction references, and selling price
Responsible (R): System
Accountable (A): Inventory Accountant
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1188_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1188_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1188_Task10" name="Physical count reconciliation">
        <bpmn:documentation>Step 2: Physical count reconciliation: For top 50 consignment SKUs (by value) at each store: Store Manager conducts spot count of consignment inventory on hand; system compares physical on-hand vs. system on-hand (received − sold); flags variances &gt; 2 units or &gt; PHP 5,000
Responsible (R): Store Manager
Accountable (A): Inventory Accountant
Duration: 2 hours/store/month (200 stores × 2 hours = 400 hours/month; distributed across store staff)</bpmn:documentation>
        <bpmn:incoming>W1188_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1188_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1188_Task11" name="Variance investigation">
        <bpmn:documentation>Step 3: Variance investigation: For flagged variances: Inventory Accountant investigates — (a) unrecorded sales (POS scan miss), (b) damage/defect not reported, (c) theft/shrinkage, (d) receiving count error; resolves and adjusts system inventory per W92 (inventory adjustment)
Responsible (R): Inventory Accountant
Accountable (A): Controller
Duration: 2 hours/week</bpmn:documentation>
        <bpmn:incoming>W1188_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1188_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1188_Task12" name="Vendor settlement report generation">
        <bpmn:documentation>Step 4: Vendor settlement report generation: System generates monthly &quot;Consignment Settlement Report&quot; per vendor: (a) opening balance (units and value), (b) units received during month, (c) units sold during month (settlement quantity), (d) units on hand (closing balance), (e) settlement amount = units sold × consignment cost price; attaches POS transaction detail as supporting evidence
Responsible (R): System / Inventory Accountant
Accountable (A): Controller
Duration: 1 hour/vendor</bpmn:documentation>
        <bpmn:incoming>W1188_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1188_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1188_Task13" name="Vendor review and confirmation">
        <bpmn:documentation>Step 5: Vendor review and confirmation: Vendor reviews settlement report via vendor portal (W705) within 5 business days; confirms quantities or disputes; disputes routed to W869 (vendor dispute resolution)
Responsible (R): Vendor
Accountable (A): —
Duration: Vendor-side</bpmn:documentation>
        <bpmn:incoming>W1188_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1188_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1188_Task14" name="Settlement payment processing">
        <bpmn:documentation>Step 6: Settlement payment processing: Upon vendor confirmation (or after 5-business-day auto-acceptance): AP Clerk processes consignment settlement payment per vendor payment terms (typically Net 15 from settlement date); system creates AP invoice linked to settlement report
Responsible (R): AP Clerk
Accountable (A): Controller
Duration: 30 min/vendor</bpmn:documentation>
        <bpmn:incoming>W1188_Flow25</bpmn:incoming>
        <bpmn:outgoing>W1188_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1188_Task15" name="Aging consignment review">
        <bpmn:documentation>Step 7: Aging consignment review: Inventory Accountant reviews consignment inventory aging: (a) items on hand &gt; 180 days flagged for discussion with Category Manager, (b) items on hand &gt; 365 days flagged for return-to-vendor per W88 or markdown per W93, (c) items on hand &gt; 540 days automatically trigger vendor return notification
Responsible (R): Inventory Accountant / Category Manager
Accountable (A): VP Merchandising
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1188_Flow26</bpmn:incoming>
        <bpmn:outgoing>W1188_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1188_Task16" name="Quarterly vendor consignment review">
        <bpmn:documentation>Step 8: Quarterly vendor consignment review: Category Manager conducts quarterly consignment program review with each vendor: (a) sell-through rate by SKU, (b) days on hand, (c) margin contribution, (d) decision to continue, expand, or discontinue consignment for specific SKUs
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 2 hours/vendor/quarter</bpmn:documentation>
        <bpmn:incoming>W1188_Flow27</bpmn:incoming>
        <bpmn:outgoing>W1188_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1188_End17" name="Complete">
        <bpmn:incoming>W1188_Flow28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1188_Annotation18">
        <bpmn:text>Controls: - CTL-253 (ensure controlled execution — Inventory Accuracy &amp; Counting (PA-05.1).) | - operational: attaching POS transaction detail as evidence in Step 4; operational: monthly top-50-per-store consignment spot count with variance investigation and adjustment per W92; operational: distinct consignment SKU numbering and receiving protocol in W23
Owner: Inventory Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1188_Assoc19" sourceRef="W1188_Annotation18" targetRef="W1188_Start8" associationDirection="None" />
      <bpmn:sequenceFlow id="W1188_Flow20" sourceRef="W1188_Start8" targetRef="W1188_Task9" />
      <bpmn:sequenceFlow id="W1188_Flow21" sourceRef="W1188_Task9" targetRef="W1188_Task10" />
      <bpmn:sequenceFlow id="W1188_Flow22" sourceRef="W1188_Task10" targetRef="W1188_Task11" />
      <bpmn:sequenceFlow id="W1188_Flow23" sourceRef="W1188_Task11" targetRef="W1188_Task12" />
      <bpmn:sequenceFlow id="W1188_Flow24" sourceRef="W1188_Task12" targetRef="W1188_Task13" />
      <bpmn:sequenceFlow id="W1188_Flow25" sourceRef="W1188_Task13" targetRef="W1188_Task14" />
      <bpmn:sequenceFlow id="W1188_Flow26" sourceRef="W1188_Task14" targetRef="W1188_Task15" />
      <bpmn:sequenceFlow id="W1188_Flow27" sourceRef="W1188_Task15" targetRef="W1188_Task16" />
      <bpmn:sequenceFlow id="W1188_Flow28" sourceRef="W1188_Task16" targetRef="W1188_End17" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1188_diag">
      <bpmndi:BPMNPlane id="W1188_plane" bpmnElement="W_W1188">
        <bpmndi:BPMNShape id="W1188_Lane1_di" bpmnElement="W1188_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2000" height="170" /></bpmndi:BPMNShape>
