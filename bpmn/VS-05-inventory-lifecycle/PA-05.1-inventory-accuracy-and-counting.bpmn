        <bpmndi:BPMNEdge id="W1188_Flow24_di" bpmnElement="W1188_Flow24"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1188_Flow25_di" bpmnElement="W1188_Flow25"><di:waypoint x="1420" y="675" /><di:waypoint x="1450" y="845" /></bpmndi:BPMNEdge>
