<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-05.1-inventory-accuracy-and-counting" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4" name="W4. Store Replenishment (DC → Store)" isExecutable="false">
      <bpmn:documentation>Trigger: System generates replenishment suggestion based on min/max or demand forecast
Frequency: 2–3 physical deliveries per store per week; ~50,000 replenishment orders/month total (production-calibrated per data-volumes §1.1; each delivery consolidates that store&#x27;s ~20–30 transfer orders since the previous drop)
Volume: ~167 orders/day across all DCs (~42 per DC/day); avg ~50 lines per order
Owner: Supply Planner
Participants: Supply Planner, DC Pick/Pack/Ship team, Truck Driver, Store Receiving Clerk, Store Manager
Source: workflow W4 — Store Replenishment (DC → Store)</bpmn:documentation>
      <bpmn:laneSet id="W4_LaneSet10">
        <bpmn:lane id="W4_Lane1" name="System">
        <bpmn:flowNodeRef>W4_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4_Task19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4_Start11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4_Lane2" name="Supply Planner">
        <bpmn:flowNodeRef>W4_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4_Lane3" name="WMS">
        <bpmn:flowNodeRef>W4_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4_Lane4" name="Picker">
        <bpmn:flowNodeRef>W4_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4_Lane5" name="Packer">
        <bpmn:flowNodeRef>W4_Task17</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4_Lane6" name="Loading Crew">
        <bpmn:flowNodeRef>W4_Task18</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4_Lane7" name="Driver">
        <bpmn:flowNodeRef>W4_Task20</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4_Lane8" name="Receiving Clerk">
        <bpmn:flowNodeRef>W4_Task21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4_Task22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4_Task23</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4_Lane9" name="Stock Associate">
        <bpmn:flowNodeRef>W4_Task24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4_End25</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4_Start11" name="System generates replenishment suggestion based on min/max or demand forecast">
        <bpmn:outgoing>W4_Flow28</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W4_Task12" name="System calculates replenishment needs per store: current stock vs. min/max or…">
        <bpmn:documentation>Step 1: System calculates replenishment needs per store: current stock vs. min/max or forecast
Responsible (R): System
Accountable (A): —
Duration: Automated (nightly)</bpmn:documentation>
        <bpmn:incoming>W4_Flow28</bpmn:incoming>
        <bpmn:outgoing>W4_Flow29</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W4_Task13" name="Supply Planner reviews suggested orders each morning; adjusts for promotions…">
        <bpmn:documentation>Step 2: Supply Planner reviews suggested orders each morning; adjusts for promotions, seasonality, store-specific factors
Responsible (R): Supply Planner
Accountable (A): Supply Planning Manager
Duration: 2–3 hours/day</bpmn:documentation>
        <bpmn:incoming>W4_Flow29</bpmn:incoming>
        <bpmn:outgoing>W4_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4_Task14" name="Planner confirms orders; system groups into waves by DC and delivery route">
        <bpmn:documentation>Step 3: Planner confirms orders; system groups into waves by DC and delivery route
Responsible (R): Supply Planner
Accountable (A): Supply Planning Manager
Duration: 1 hour/day</bpmn:documentation>
        <bpmn:incoming>W4_Flow30</bpmn:incoming>
        <bpmn:outgoing>W4_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4_Task15" name="DC receives pick wave; WMS assigns pick tasks to staff by zone">
        <bpmn:documentation>Step 4: DC receives pick wave; WMS assigns pick tasks to staff by zone
Responsible (R): WMS / DC Supervisor
Accountable (A): DC Supervisor
Duration: 5 min (assignment)</bpmn:documentation>
        <bpmn:incoming>W4_Flow31</bpmn:incoming>
        <bpmn:outgoing>W4_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4_Task16" name="Picker pick items from bins per RF gun direction; scan-confirm each item">
        <bpmn:documentation>Step 5: Picker pick items from bins per RF gun direction; scan-confirm each item
Responsible (R): Picker
Accountable (A): DC Supervisor
Duration: 2–4 hours/wave</bpmn:documentation>
        <bpmn:incoming>W4_Flow32</bpmn:incoming>
        <bpmn:outgoing>W4_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4_Task17" name="Packers pack into store-labeled totes/cases; scan-confirm shipment">
        <bpmn:documentation>Step 6: Packers pack into store-labeled totes/cases; scan-confirm shipment
Responsible (R): Packer
Accountable (A): DC Supervisor
Duration: 1–2 hours/wave</bpmn:documentation>
        <bpmn:incoming>W4_Flow33</bpmn:incoming>
        <bpmn:outgoing>W4_Flow34</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4_Task18" name="Load truck per route sequence (multi-drop)">
        <bpmn:documentation>Step 7: Load truck per route sequence (multi-drop)
Responsible (R): Loading Crew
Accountable (A): DC Supervisor
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W4_Flow34</bpmn:incoming>
        <bpmn:outgoing>W4_Flow35</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W4_Task19" name="System creates Transfer Order; in-transit inventory created">
        <bpmn:documentation>Step 8: System creates Transfer Order; in-transit inventory created
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W4_Flow35</bpmn:incoming>
        <bpmn:outgoing>W4_Flow36</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W4_Task20" name="Truck departs DC; ETA communicated to store">
        <bpmn:documentation>Step 9: Truck departs DC; ETA communicated to store
Responsible (R): Driver
Accountable (A): DC Dispatch
Duration: —</bpmn:documentation>
        <bpmn:incoming>W4_Flow36</bpmn:incoming>
        <bpmn:outgoing>W4_Flow37</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4_Task21" name="Store Receiving Clerk unloads truck; scans each item/case against Transfer Order">
        <bpmn:documentation>Step 10: Store Receiving Clerk unloads truck; scans each item/case against Transfer Order
Responsible (R): Receiving Clerk (Store)
Accountable (A): Store Manager
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W4_Flow37</bpmn:incoming>
        <bpmn:outgoing>W4_Flow38</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4_Task22" name="Discrepancies (shortage, damage) flagged in system; DC notified">
        <bpmn:documentation>Step 11: Discrepancies (shortage, damage) flagged in system; DC notified
Responsible (R): Receiving Clerk (Store)
Accountable (A): Store Manager
Duration: 5 min if any</bpmn:documentation>
        <bpmn:incoming>W4_Flow38</bpmn:incoming>
        <bpmn:outgoing>W4_Flow39</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4_Task23" name="Store confirms receipt; in-transit inventory becomes store inventory">
        <bpmn:documentation>Step 12: Store confirms receipt; in-transit inventory becomes store inventory
Responsible (R): Receiving Clerk (Store)
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W4_Flow39</bpmn:incoming>
        <bpmn:outgoing>W4_Flow40</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4_Task24" name="Replenishment moved to sales floor or backroom stock">
        <bpmn:documentation>Step 13: Replenishment moved to sales floor or backroom stock
Responsible (R): Stock Associate
Accountable (A): Department Supervisor
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W4_Flow40</bpmn:incoming>
        <bpmn:outgoing>W4_Flow41</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4_End25" name="Complete">
        <bpmn:incoming>W4_Flow41</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4_Annotation26">
        <bpmn:text>Controls: - CTL-25 (safeguard inventory in transit.) | - operational: Supply Planner review and approval gate
Owner: Supply Planner</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4_Assoc27" sourceRef="W4_Annotation26" targetRef="W4_Start11" associationDirection="None" />
      <bpmn:sequenceFlow id="W4_Flow28" sourceRef="W4_Start11" targetRef="W4_Task12" />
