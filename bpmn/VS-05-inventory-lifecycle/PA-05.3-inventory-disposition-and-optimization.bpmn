    <bpmn:process id="W_W219" name="W219. Store Inventory Quarantine &amp; Recertification" isExecutable="false">
      <bpmn:documentation>Trigger: Customer return (W12), cycle count discrepancy, or receive inspection identifies suspected, damaged, or expired stock
Frequency: Daily across all stores
Volume: ~20–50 items/store/month
Owner: Store Quality Inspector
Participants: Store Quality Inspector, Stock Associate, Store Manager, Category Manager
Source: workflow W219 — Store Inventory Quarantine &amp; Recertification</bpmn:documentation>
      <bpmn:laneSet id="W219_LaneSet4">
        <bpmn:lane id="W219_Lane1" name="CSR">
        <bpmn:flowNodeRef>W219_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W219_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W219_Lane2" name="Stock Associate">
        <bpmn:flowNodeRef>W219_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W219_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W219_Lane3" name="Quality Inspector">
        <bpmn:flowNodeRef>W219_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W219_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W219_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W219_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W219_Start5" name="Customer return (W12), cycle count discrepancy, or receive inspection identifies…">
        <bpmn:outgoing>W219_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W219_Task6" name="Quarantine Creation">
        <bpmn:documentation>Step 1: Quarantine Creation: CSR or Stock Associate flags stock as &quot;Damaged&quot; or &quot;Suspect&quot;; system moves inventory from &quot;Saleable&quot; status to &quot;Quarantined&quot; status (Dr. Quarantined Inventory / Cr. Saleable Inventory) and moves to quarantine location
Responsible (R): CSR / Stock Associate
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W219_Flow15</bpmn:incoming>
        <bpmn:outgoing>W219_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W219_Task7" name="Physical Segregation">
        <bpmn:documentation>Step 2: Physical Segregation: Stock Associate prints &quot;Quarantine Label&quot; from system; attaches to item and physically moves to the secure store quarantine cage
Responsible (R): Stock Associate
Accountable (A): Dept. Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W219_Flow16</bpmn:incoming>
        <bpmn:outgoing>W219_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W219_Task8" name="Inspection &amp; Evaluation">
        <bpmn:documentation>Step 3: Inspection &amp; Evaluation: Store Quality Inspector performs physical inspection; uploads photo evidence to system; classifies defect (e.g., cosmetic package damage, internal mechanical fault, paint tint mismatch)
Responsible (R): Quality Inspector
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W219_Flow17</bpmn:incoming>
        <bpmn:outgoing>W219_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W219_Task9" name="Disposition Determination">
        <bpmn:documentation>Step 4: Disposition Determination: Inspector enters recommended disposition: (a) *Refurbish &amp; Recertify* (repackage, clean, test); (b) *B-Grade Downgrade* (cosmetic damage, sell on discount); (c) *Scrap / Write-off*; (d) *Return to Vendor (RTV)*
Responsible (R): Quality Inspector
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W219_Flow18</bpmn:incoming>
        <bpmn:outgoing>W219_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W219_Task10" name="Action Execution">
        <bpmn:documentation>Step 5: Action Execution: &lt;br&gt;• (a) *Refurbish*: Stock Associate performs repacking; system updates status to &quot;Saleable&quot; (Dr. Saleable Inventory / Cr. Quarantined Inventory);&lt;br&gt;• (b) *B-Grade*: System moves SKU to &quot;B-Grade/Clearance&quot; status and auto-applies standard clearance markdown (W93);&lt;br&gt;• (c) *Scrap*: Store Manager approves; system posts inventory adjustment (Dr. Scrap Expense / Cr. Quarantined Inventory) and schedules disposal (W82);&lt;br&gt;• (d) *RTV*: System generates Return to Vendor request (W88)
Responsible (R): Stock Associate / System
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W219_Flow19</bpmn:incoming>
        <bpmn:outgoing>W219_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W219_Task11" name="Discrepancy Reporting">
        <bpmn:documentation>Step 6: Discrepancy Reporting: Quality Inspector generates monthly quarantine velocity and defect report to highlight recurring SKU failures to Category Managers
Responsible (R): Quality Inspector
Accountable (A): Store Manager
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W219_Flow20</bpmn:incoming>
        <bpmn:outgoing>W219_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W219_End12" name="Complete">
        <bpmn:incoming>W219_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W219_Annotation13">
        <bpmn:text>Controls: - CTL-255 (ensure controlled execution — Inventory Disposition &amp; Optimization (PA-05.3).) | - operational: Store Quality Inspector review and approval gate
Owner: Store Quality Inspector</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W219_Assoc14" sourceRef="W219_Annotation13" targetRef="W219_Start5" associationDirection="None" />
