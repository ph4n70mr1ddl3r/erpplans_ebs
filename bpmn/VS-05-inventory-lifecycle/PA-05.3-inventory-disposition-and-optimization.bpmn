        <bpmndi:BPMNShape id="W1280_Start8_di" bpmnElement="W1280_Start8"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1280_End17_di" bpmnElement="W1280_End17"><dc:Bounds x="2100" y="997" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1280_Annotation18_di" bpmnElement="W1280_Annotation18"><dc:Bounds x="160" y="1140" width="360" height="72" /></bpmndi:BPMNShape>
