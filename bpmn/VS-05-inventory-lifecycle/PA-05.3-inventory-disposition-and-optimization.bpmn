    <bpmn:process id="W_W220" name="W220. Slow-Moving &amp; Obsolete Inventory (SLOB) Provisioning &amp; Liquidation" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly inventory aging cycle or system alert on aging thresholds
Frequency: Monthly
Volume: Reviewing ~500–1,000 slow-moving SKUs chain-wide
Owner: Inventory Control Manager
Participants: Inventory Control Manager, Category Manager, CFO, VP Merchandising, Store Managers
Source: workflow W220 — Slow-Moving &amp; Obsolete Inventory (SLOB) Provisioning &amp; Liquidation</bpmn:documentation>
      <bpmn:laneSet id="W220_LaneSet4">
        <bpmn:lane id="W220_Lane1" name="System">
        <bpmn:flowNodeRef>W220_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W220_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W220_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W220_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W220_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W220_Lane2" name="Inventory Control Mgr">
        <bpmn:flowNodeRef>W220_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W220_Lane3" name="Category Manager">
        <bpmn:flowNodeRef>W220_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W220_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W220_Start5" name="Monthly inventory aging cycle or system alert on aging thresholds">
        <bpmn:outgoing>W220_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W220_Task6" name="Aging Detection">
        <bpmn:documentation>Step 1: Aging Detection: System generates monthly aging report showing SKUs with &gt; 180 days since last sale or inventory age exceeding category-specific thresholds (e.g., lumber shelf life, paint expiry)
Responsible (R): System
Accountable (A): Inventory Control Mgr
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W220_Flow15</bpmn:incoming>
        <bpmn:outgoing>W220_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W220_Task7" name="Obsolescence Provisioning">
        <bpmn:documentation>Step 2: Obsolescence Provisioning: Finance automatically calculates SLOB provision using standardized logic (e.g., 50% provision for 180–270 days age, 100% provision for &gt; 270 days); system posts journal (Dr. Inventory Obsolescence Expense / Cr. SLOB Inventory Allowance)
Responsible (R): System / Financial Analyst
Accountable (A): CFO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W220_Flow16</bpmn:incoming>
        <bpmn:outgoing>W220_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W220_Task8" name="Liquidation Campaign Proposal">
        <bpmn:documentation>Step 3: Liquidation Campaign Proposal: Inventory Control Manager routes the aging SKU list to the respective Category Manager with recommended liquidation strategies: (a) in-store clearance markdown (W93); (b) bulk wholesaler buy-out (W146); (c) stock transfer to high-velocity stores (W204); (d) vendor buy-back
Responsible (R): Inventory Control Mgr
Accountable (A): Category Manager
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W220_Flow17</bpmn:incoming>
        <bpmn:outgoing>W220_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W220_Task9" name="Strategy Approval">
        <bpmn:documentation>Step 4: Strategy Approval: Category Manager selects liquidation route; CFO/VP Merchandising approves any margin impact exceeding PHP 100K
Responsible (R): Category Manager
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W220_Flow18</bpmn:incoming>
        <bpmn:outgoing>W220_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W220_Task10" name="Campaign Execution">
        <bpmn:documentation>Step 5: Campaign Execution: &lt;br&gt;• For in-store clearance: system applies pricing markdown;&lt;br&gt;• For redistribution: system auto-generates transfer orders (W204);&lt;br&gt;• For wholesaler: system creates Wholesale Sales Order (W146)
Responsible (R): System / Category Manager
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W220_Flow19</bpmn:incoming>
        <bpmn:outgoing>W220_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W220_Task11" name="Allowance Release">
        <bpmn:documentation>Step 6: Allowance Release: Upon actual sale of liquidated items or approved physical scrap write-off: system releases the provision allowance (Dr. SLOB Inventory Allowance / Cr. Inventory Asset) to realize the final inventory value
Responsible (R): System
Accountable (A): Financial Analyst
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W220_Flow20</bpmn:incoming>
        <bpmn:outgoing>W220_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W220_End12" name="Complete">
        <bpmn:incoming>W220_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W220_Annotation13">
        <bpmn:text>Controls: - CTL-255 (ensure controlled execution — Inventory Disposition &amp; Optimization (PA-05.3).) | - operational: Inventory Control Manager review and approval gate
Owner: Inventory Control Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W220_Assoc14" sourceRef="W220_Annotation13" targetRef="W220_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W220_Flow15" sourceRef="W220_Start5" targetRef="W220_Task6" />
      <bpmn:sequenceFlow id="W220_Flow16" sourceRef="W220_Task6" targetRef="W220_Task7" />
      <bpmn:sequenceFlow id="W220_Flow17" sourceRef="W220_Task7" targetRef="W220_Task8" />
      <bpmn:sequenceFlow id="W220_Flow18" sourceRef="W220_Task8" targetRef="W220_Task9" />
      <bpmn:sequenceFlow id="W220_Flow19" sourceRef="W220_Task9" targetRef="W220_Task10" />
      <bpmn:sequenceFlow id="W220_Flow20" sourceRef="W220_Task10" targetRef="W220_Task11" />
      <bpmn:sequenceFlow id="W220_Flow21" sourceRef="W220_Task11" targetRef="W220_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W220_diag">
      <bpmndi:BPMNPlane id="W220_plane" bpmnElement="W_W220">
        <bpmndi:BPMNShape id="W220_Lane1_di" bpmnElement="W220_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W220_Lane2_di" bpmnElement="W220_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W220_Lane3_di" bpmnElement="W220_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W220_Task6_di" bpmnElement="W220_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W220_Task7_di" bpmnElement="W220_Task7"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W220_Task8_di" bpmnElement="W220_Task8"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
