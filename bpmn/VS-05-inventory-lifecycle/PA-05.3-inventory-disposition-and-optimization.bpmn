<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-05.3-inventory-disposition-and-optimization" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W91" name="W91. Damaged &amp; Defective Goods Disposition" isExecutable="false">
      <bpmn:documentation>Trigger: Damaged or defective goods identified during receiving (W3, W18), cycle counting (W6), daily operations (W5), or customer return (W12)
Frequency: ~3,200–5,400 damaged/defective units/month across all locations
Volume: ~15–25 per store per month; ~50–100 per DC per month
Owner: Store Manager (store-level); DC Supervisor (DC-level)
Participants: Store Manager, DC Supervisor, Stock Associate, Receiving Clerk, Buyer, Category Manager, Controller
Source: workflow W91 — Damaged &amp; Defective Goods Disposition</bpmn:documentation>
      <bpmn:laneSet id="W91_LaneSet6">
        <bpmn:lane id="W91_Lane1" name="Stock Associate">
        <bpmn:flowNodeRef>W91_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W91_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W91_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W91_Lane2" name="Dept. Supervisor">
        <bpmn:flowNodeRef>W91_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W91_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W91_Lane3" name="DC Supervisor">
        <bpmn:flowNodeRef>W91_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W91_Lane4" name="System">
        <bpmn:flowNodeRef>W91_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W91_Lane5" name="Category Manager">
        <bpmn:flowNodeRef>W91_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W91_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W91_Start7" name="Damaged or defective goods identified during receiving (W3, W18), cycle counting (W6)…">
        <bpmn:outgoing>W91_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W91_Task8" name="Identification and documentation">
        <bpmn:documentation>Step 1: Identification and documentation: (a) Store Associate, Stock Associate, or Receiving Clerk discovers damaged/defective item; (b) scans item barcode and selects damage type: (i) transit damage (DC→Store or vendor→DC/Store), (ii) in-store handling damage (dropped, shelving collapse, water damage), (iii) customer-caused damage (opened package, broken seal on display), (iv) vendor manufacturing defect (functional failure, missing parts, cosmetic defect out of box), (v) age/expiry deterioration (expired paint, hardened adhesive, rusted hardware), (vi) environmental damage (flood, typhoon — W49); (c) takes photo of damage; (d) system creates damage report with timestamp, location, item, quantity, damage type, and photo evidence
Responsible (R): Stock Associate / Receiving Clerk
Accountable (A): Dept. Supervisor / DC Supervisor
Duration: 5 min/item</bpmn:documentation>
        <bpmn:incoming>W91_Flow18</bpmn:incoming>
        <bpmn:outgoing>W91_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W91_Task9" name="Quarantine and physical segregation">
        <bpmn:documentation>Step 2: Quarantine and physical segregation: System moves damaged items to &quot;Damaged/Defective&quot; inventory status (unavailable for sale, unavailable for replenishment calculation); physical items moved to designated damaged goods area in store backroom or DC quarantine zone
Responsible (R): Stock Associate / Receiving Clerk
Accountable (A): Store Manager / DC Supervisor
Duration: 5 min/item</bpmn:documentation>
        <bpmn:incoming>W91_Flow19</bpmn:incoming>
        <bpmn:outgoing>W91_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W91_Task10" name="Liability assessment">
        <bpmn:documentation>Step 3: Liability assessment: (a) Vendor liability — damage type is vendor defect, transit damage from vendor, or wrong item received: route to W88 (Return to Vendor) for vendor credit or replacement; (b) Carrier liability — damage type is transit damage from DC to store or 3PL delivery to customer: route to carrier claim (W19.12b for ecommerce, W66 for inter-island, W52 for fleet); (c) BuildRight liability — in-store handling damage, customer-caused damage, environmental damage: no external recovery possible; proceed to disposition decision; (d) Undetermined — route to Buyer for vendor negotiation or DC Supervisor for carrier investigation
Responsible (R): Dept. Supervisor / DC Supervisor
Accountable (A): Store Manager / DC Supervisor
Duration: 5 min/item</bpmn:documentation>
        <bpmn:incoming>W91_Flow20</bpmn:incoming>
        <bpmn:outgoing>W91_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W91_Task11" name="Disposition decision">
        <bpmn:documentation>Step 4: Disposition decision (BuildRight-liability items only — vendor/carrier items follow W88 or carrier claim): (a) Markdown and sell at discount — item is cosmetically damaged but functionally usable (e.g., dented can of paint, scratched tile, box-damaged appliance); system routes to W93 (Markdown &amp; Clearance) for discounted sale; (b) Donate — item is functional but not saleable at any price (e.g., display model replaced by newer version); coordinate with CSR for community donation program; requires Controller approval; (c) Scrap/dispose — item is non-functional, hazardous (paint/chemical per W82), or broken beyond any use; system routes to disposal with proper documentation; (d) Return to regular stock — item was incorrectly flagged (e.g., packaging scuff but product perfect); system reverses damage status
Responsible (R): Dept. Supervisor / Store Manager / DC Supervisor
Accountable (A): Store Manager / DC Supervisor
Duration: 5 min/item</bpmn:documentation>
        <bpmn:incoming>W91_Flow21</bpmn:incoming>
        <bpmn:outgoing>W91_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W91_Task12" name="DC-level consolidation">
        <bpmn:documentation>Step 5: DC-level consolidation: DC Supervisor consolidates damaged/defective items from DC operations and items returned from stores (via W22B store-to-DC return); sorts by vendor for potential consolidated RTV shipment per W88; disposes of scrap items in bulk per W82 (hazardous materials) or general waste protocols
Responsible (R): DC Supervisor
Accountable (A): Supply Chain Manager
Duration: 1 hour/week</bpmn:documentation>
        <bpmn:incoming>W91_Flow22</bpmn:incoming>
        <bpmn:outgoing>W91_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W91_Task13" name="Financial impact recording">
        <bpmn:documentation>Step 6: Financial impact recording: System calculates damage/defective value at WAC per item; records in damage/defective register: total value by damage type, by location, by category; feeds into shrinkage report per W37 (loss prevention) and W92 (inventory adjustment)
Responsible (R): System
Accountable (A): Controller
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W91_Flow23</bpmn:incoming>
        <bpmn:outgoing>W91_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W91_Task14" name="Monthly damage analysis">
        <bpmn:documentation>Step 7: Monthly damage analysis: Category Manager and Controller review monthly damage/defective report: (a) damage rate by category (target: &lt; 0.5% of inventory value), (b) damage rate by location (flag stores &gt; 1% rate), (c) damage rate by damage type (trend analysis), (d) top 20 items by damage frequency (possible packaging improvement or vendor quality issue), (e) vendor defect rate feeds into W44 vendor scorecard; (f) transit damage rate by carrier feeds into W52/W62B carrier performance
Responsible (R): Category Manager / Controller
Accountable (A): VP Merchandising / CFO
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W91_Flow24</bpmn:incoming>
        <bpmn:outgoing>W91_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W91_End15" name="Complete">
        <bpmn:incoming>W91_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W91_Annotation16">
        <bpmn:text>Controls: - CTL-255 (ensure controlled execution — Inventory Disposition &amp; Optimization (PA-05.3).) | - operational: Store Manager (store-level); DC Supervisor (DC-level) review and approval gate
Owner: Store Manager (store-level); DC Supervisor (DC-level)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W91_Assoc17" sourceRef="W91_Annotation16" targetRef="W91_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W91_Flow18" sourceRef="W91_Start7" targetRef="W91_Task8" />
      <bpmn:sequenceFlow id="W91_Flow19" sourceRef="W91_Task8" targetRef="W91_Task9" />
      <bpmn:sequenceFlow id="W91_Flow20" sourceRef="W91_Task9" targetRef="W91_Task10" />
      <bpmn:sequenceFlow id="W91_Flow21" sourceRef="W91_Task10" targetRef="W91_Task11" />
      <bpmn:sequenceFlow id="W91_Flow22" sourceRef="W91_Task11" targetRef="W91_Task12" />
      <bpmn:sequenceFlow id="W91_Flow23" sourceRef="W91_Task12" targetRef="W91_Task13" />
      <bpmn:sequenceFlow id="W91_Flow24" sourceRef="W91_Task13" targetRef="W91_Task14" />
      <bpmn:sequenceFlow id="W91_Flow25" sourceRef="W91_Task14" targetRef="W91_End15" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W91_diag">
      <bpmndi:BPMNPlane id="W91_plane" bpmnElement="W_W91">
        <bpmndi:BPMNShape id="W91_Lane1_di" bpmnElement="W91_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W91_Lane2_di" bpmnElement="W91_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
