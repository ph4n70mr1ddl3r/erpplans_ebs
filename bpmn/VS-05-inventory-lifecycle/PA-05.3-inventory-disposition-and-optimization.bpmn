    <bpmn:process id="W_W1258" name="W1258. Multi-Location Inventory Aging Dashboard &amp; Automated Write-Down Recommendation Engine" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled — monthly aging analysis refresh; weekly dashboard update; ad-hoc triggered by NRV (Net Realizable Value) threshold breach or write-down accrual requirement at month-end
Frequency: Monthly aging analysis; weekly dashboard refresh; quarter-end write-down review
Volume: 35,000 active SKUs across ~205 locations (200 stores + 4 DCs); ~7M inventory records in aging analysis
Owner: Inventory Controller / Finance Analyst
Participants: Category Manager, Store Manager, DC Operations Manager, Finance Controller, VP Merchandising
Source: workflow W1258 — Multi-Location Inventory Aging Dashboard &amp; Automated Write-Down Recommendation Engine</bpmn:documentation>
      <bpmn:laneSet id="W1258_LaneSet6">
        <bpmn:lane id="W1258_Lane1" name="System">
