      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1438" name="W1438. Seasonal SKU End-of-Life Transition, Markdown Cadence &amp; Remaining Stock Balancing Across Stores" isExecutable="false">
      <bpmn:documentation>Trigger: Seasonal calendar transition (e.g., rainy season → ber-months); or seasonal SKU sell-through falls below 30% of initial allocation with 4 weeks remaining in season
Frequency: 4–6 major seasonal transitions per year (Jan–Feb post-holiday renovation, Mar–Apr summer, Jun–Aug rainy season, Sep–Oct ber-months, Nov–Dec Christmas); each transition involves ~500–800 seasonal SKUs
Volume: ~500–800 seasonal SKUs per transition; ~200 stores; ~100,000–160,000 store-level SKU-location combinations requiring disposition decision
Owner: Category Manager (Merchandising)
Participants: Category Manager, Merchandise Planner, Pricing Analyst, Store Managers, VP Merchandising, Marketing Campaign Manager
Source: workflow W1438 — Seasonal SKU End-of-Life Transition, Markdown Cadence &amp; Remaining Stock Balancing Across Stores</bpmn:documentation>
      <bpmn:laneSet id="W1438_LaneSet4">
        <bpmn:lane id="W1438_Lane1" name="Merchandise Planner">
        <bpmn:flowNodeRef>W1438_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1438_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1438_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1438_Lane2" name="Pricing Analyst">
        <bpmn:flowNodeRef>W1438_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1438_Lane3" name="Category Manager">
        <bpmn:flowNodeRef>W1438_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1438_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1438_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1438_Start5" name="Seasonal calendar transition (e.g., rainy season → ber-months); or seasonal SKU…">
        <bpmn:outgoing>W1438_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1438_Task6" name="Seasonal sell-through monitoring">
        <bpmn:documentation>Step 1: Seasonal sell-through monitoring: Merchandise Planner monitors weekly sell-through rate for all seasonal SKUs: (a) system generates weekly sell-through report by SKU by store, (b) flag SKUs with &lt; 30% sell-through at midpoint of selling window, (c) flag SKUs with &lt; 60% sell-through at 75% of selling window, (d) flag stores with disproportionate remaining inventory vs. chain average
Responsible (R): Merchandise Planner
Accountable (A): Category Manager
Duration: 2 hours/week</bpmn:documentation>
        <bpmn:incoming>W1438_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1438_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1438_Task7" name="Cross-store inventory balancing">
        <bpmn:documentation>Step 2: Cross-store inventory balancing: For SKUs with high remaining inventory at specific stores but strong sell-through at other stores: (a) Merchandise Planner identifies transfer candidates: stores with &gt; 2 weeks supply of seasonal SKU AND stores with &lt; 1 week supply still receiving customer inquiries, (b) create inter-store transfer orders per W22 (transfer process) — seasonal inventory transferred from overstocked to understocked stores, (c) prioritize transfers for bulky items (garden furniture, Christmas displays) that consume shelf space at slow-selling locations, (d) target: complete balancing within 1 week of identification
Responsible (R): Merchandise Planner / Logistics Coordinator
Accountable (A): Category Manager
Duration: 4 hours/transition</bpmn:documentation>
        <bpmn:incoming>W1438_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1438_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1438_Task8" name="Progressive markdown cadence activation">
        <bpmn:documentation>Step 3: Progressive markdown cadence activation: Based on sell-through monitoring: (a) Phase 1 markdown (25% off): triggered at 75% of selling window for SKUs with &lt; 50% sell-through; applies to all stores chain-wide, (b) Phase 2 markdown (40% off): triggered at 85% of selling window for SKUs with &lt; 70% sell-through, (c) Phase 3 markdown (60% off): triggered at 95% of selling window for ALL remaining seasonal SKUs regardless of sell-through; final clearance push, (d) Phase 4 clearance/bulk-out: any remaining inventory after selling window closes — offer to discount retailers, liquidators, or LGU donation; Pricing Analyst executes markdown in ERP with effective dates; POS auto-applies markdown price
Responsible (R): Pricing Analyst / Category Manager
Accountable (A): VP Merchandising
Duration: 2 hours per markdown phase</bpmn:documentation>
        <bpmn:incoming>W1438_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1438_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1438_Task9" name="Post-season write-off and shelf reset">
        <bpmn:documentation>Step 4: Post-season write-off and shelf reset: After selling window closes: (a) Merchandise Planner compiles remaining seasonal inventory report by store, (b) for items not sold at Phase 3 clearance: Category Manager approves write-off per W92 (shrinkage authorization) or donation per W1106, (c) Store Managers execute shelf reset: remove seasonal signage, clear seasonal shelves, restock with next-season merchandise per planogram, (d) system updates seasonal SKU status to &quot;inactive&quot; until next season&#x27;s assortment planning per W1
Responsible (R): Category Manager / Store Manager
Accountable (A): VP Merchandising
Duration: 1–2 days per store</bpmn:documentation>
        <bpmn:incoming>W1438_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1438_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1438_Task10" name="Post-season performance review">
        <bpmn:documentation>Step 5: Post-season performance review: Category Manager conducts seasonal performance review: (a) sell-through rate by SKU, (b) markdown cost (margin erosion from progressive markdowns), (c) leftover inventory value and write-off cost, (d) cross-store transfer effectiveness, (e) total seasonal category revenue vs. plan, (f) recommend adjustments for next year&#x27;s seasonal buy quantities and allocation by store
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 4 hours/season</bpmn:documentation>
        <bpmn:incoming>W1438_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1438_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1438_End11" name="Complete">
        <bpmn:incoming>W1438_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1438_Annotation12">
        <bpmn:text>Controls: - CTL-255 (ensure controlled execution — Inventory Disposition &amp; Optimization (PA-05.3).) | - operational: Category Manager (Merchandising) review and approval gate
Owner: Category Manager (Merchandising)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1438_Assoc13" sourceRef="W1438_Annotation12" targetRef="W1438_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1438_Flow14" sourceRef="W1438_Start5" targetRef="W1438_Task6" />
      <bpmn:sequenceFlow id="W1438_Flow15" sourceRef="W1438_Task6" targetRef="W1438_Task7" />
      <bpmn:sequenceFlow id="W1438_Flow16" sourceRef="W1438_Task7" targetRef="W1438_Task8" />
      <bpmn:sequenceFlow id="W1438_Flow17" sourceRef="W1438_Task8" targetRef="W1438_Task9" />
      <bpmn:sequenceFlow id="W1438_Flow18" sourceRef="W1438_Task9" targetRef="W1438_Task10" />
      <bpmn:sequenceFlow id="W1438_Flow19" sourceRef="W1438_Task10" targetRef="W1438_End11" />
    </bpmn:process>
