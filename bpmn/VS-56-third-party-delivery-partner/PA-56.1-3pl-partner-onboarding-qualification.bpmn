    <bpmn:process id="W_W2196" name="W2196. 3PL Partner Performance Scorecard" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly review cycle
Frequency: Monthly
Volume: ~10–15 scorecards/month
Owner: Logistics Manager
Participants: VP Supply Chain, COO
Source: workflow W2196 — 3PL Partner Performance Scorecard</bpmn:documentation>
      <bpmn:laneSet id="W2196_LaneSet3">
        <bpmn:lane id="W2196_Lane1" name="System">
        <bpmn:flowNodeRef>W2196_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2196_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2196_Lane2" name="Logistics Manager">
        <bpmn:flowNodeRef>W2196_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2196_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2196_Start4" name="Monthly review cycle">
        <bpmn:outgoing>W2196_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2196_Task5" name="System generates scorecard: on-time delivery rate (≥95%), damage rate (&lt;0.5%)…">
        <bpmn:documentation>Step 1: System generates scorecard: on-time delivery rate (≥95%), damage rate (&lt;0.5%), order acceptance rate, avg delivery time, complaint rate, driver professionalism; Manager reviews with partner
Responsible (R): System / Logistics Manager
Accountable (A): VP Supply Chain
Duration: 1–2 hours/partner</bpmn:documentation>
        <bpmn:incoming>W2196_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2196_Flow11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2196_Task6" name="Below-target partners get 30-day corrective action plans; quarterly: VP reviews…">
        <bpmn:documentation>Step 2: Below-target partners get 30-day corrective action plans; quarterly: VP reviews portfolio for retention/reallocation/new sourcing decisions
Responsible (R): Logistics Manager
Accountable (A): COO
Duration: 2–3 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W2196_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2196_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2196_End7" name="Complete">
        <bpmn:incoming>W2196_Flow12</bpmn:incoming>
      </bpmn:endEvent>
