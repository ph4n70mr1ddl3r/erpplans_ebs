    <bpmn:process id="W_W2197" name="W2197. 3PL Contract Termination &amp; Transition" isExecutable="false">
      <bpmn:documentation>Trigger: Partner underperformance or strategic decision
Frequency: Ad-hoc; ~1–2/year
Volume: ~1–2 transitions/year
Owner: Logistics Manager
Participants: Procurement, IT, VP Supply Chain, Finance
Source: workflow W2197 — 3PL Contract Termination &amp; Transition</bpmn:documentation>
      <bpmn:laneSet id="W2197_LaneSet2">
        <bpmn:lane id="W2197_Lane1" name="Logistics Manager">
        <bpmn:flowNodeRef>W2197_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2197_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2197_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2197_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2197_Start3" name="Partner underperformance or strategic decision">
        <bpmn:outgoing>W2197_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2197_Task4" name="Manager initiates termination per contract terms (60–90 days notice); documents…">
        <bpmn:documentation>Step 1: Manager initiates termination per contract terms (60–90 days notice); documents justification; Procurement sources replacement; IT begins integration
Responsible (R): Logistics Manager / Procurement / IT
Accountable (A): VP Supply Chain
Duration: 30–60 days</bpmn:documentation>
        <bpmn:incoming>W2197_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2197_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2197_Task5" name="Executes volume transition over 2–4 weeks; closes financial settlement with…">
        <bpmn:documentation>Step 2: Executes volume transition over 2–4 weeks; closes financial settlement with departing partner
Responsible (R): Logistics Manager
Accountable (A): Finance
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W2197_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2197_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2197_End6" name="Complete">
        <bpmn:incoming>W2197_Flow11</bpmn:incoming>
      </bpmn:endEvent>
