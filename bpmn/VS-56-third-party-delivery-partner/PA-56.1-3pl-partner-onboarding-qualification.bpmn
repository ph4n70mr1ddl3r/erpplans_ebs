<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-56.1-3pl-partner-onboarding-qualification" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2190" name="W2190. Delivery Partner Identification &amp; Screening" isExecutable="false">
      <bpmn:documentation>Trigger: Need for new delivery capacity or partner replacement
Frequency: Ad-hoc; typically 2–4 new partners/year
Volume: ~2–4 evaluations/year; ~10–15 active partners
Owner: Logistics Manager
Participants: Procurement, VP Supply Chain, Legal, Finance, CFO
Source: workflow W2190 — Delivery Partner Identification &amp; Screening</bpmn:documentation>
      <bpmn:laneSet id="W2190_LaneSet3">
        <bpmn:lane id="W2190_Lane1" name="Logistics Manager">
        <bpmn:flowNodeRef>W2190_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2190_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2190_Lane2" name="Legal">
        <bpmn:flowNodeRef>W2190_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2190_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2190_Start4" name="Need for new delivery capacity or partner replacement">
        <bpmn:outgoing>W2190_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2190_Task5" name="Logistics Manager identifies potential partners based on geographic coverage…">
        <bpmn:documentation>Step 1: Logistics Manager identifies potential partners based on geographic coverage, vehicle fleet, pricing, and reputation; Procurement conducts due diligence (DTI/SEC registration, insurance, safety record, references)
Responsible (R): Logistics Manager / Procurement
Accountable (A): VP Supply Chain
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W2190_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2190_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2190_Task6" name="Legal reviews contract: SLA terms, liability, insurance, data privacy (RA…">
        <bpmn:documentation>Step 2: Legal reviews contract: SLA terms, liability, insurance, data privacy (RA 10173), rate card, payment terms, termination; Finance evaluates pricing and sets up vendor master
Responsible (R): Legal / Finance
Accountable (A): CFO
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W2190_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2190_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2190_End7" name="Complete">
        <bpmn:incoming>W2190_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2190_Annotation8">
        <bpmn:text>Controls: - CTL-06: 3PL vendor-master onboarding; CTL-167 (TPRM risk-tiering — links to VS-161); operational: VP Supply Chain + CFO sign-off
Owner: Logistics Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2190_Assoc9" sourceRef="W2190_Annotation8" targetRef="W2190_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2190_Flow10" sourceRef="W2190_Start4" targetRef="W2190_Task5" />
      <bpmn:sequenceFlow id="W2190_Flow11" sourceRef="W2190_Task5" targetRef="W2190_Task6" />
      <bpmn:sequenceFlow id="W2190_Flow12" sourceRef="W2190_Task6" targetRef="W2190_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2190_diag">
      <bpmndi:BPMNPlane id="W2190_plane" bpmnElement="W_W2190">
        <bpmndi:BPMNShape id="W2190_Lane1_di" bpmnElement="W2190_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2190_Lane2_di" bpmnElement="W2190_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2190_Task5_di" bpmnElement="W2190_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2190_Task6_di" bpmnElement="W2190_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2190_Start4_di" bpmnElement="W2190_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2190_End7_di" bpmnElement="W2190_End7"><dc:Bounds x="840" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2190_Annotation8_di" bpmnElement="W2190_Annotation8"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2190_Flow10_di" bpmnElement="W2190_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2190_Flow11_di" bpmnElement="W2190_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2190_Flow12_di" bpmnElement="W2190_Flow12"><di:waypoint x="790" y="335" /><di:waypoint x="840" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2190_Assoc9_di" bpmnElement="W2190_Assoc9"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2191" name="W2191. 3PL System Integration &amp; Onboarding" isExecutable="false">
      <bpmn:documentation>Trigger: Contract signed with new partner
Frequency: ~2–4 integrations/year
Volume: ~2–4/year
Owner: IT Integration Lead
Participants: IT, Logistics Manager, CIO, VP Supply Chain
Source: workflow W2191 — 3PL System Integration &amp; Onboarding</bpmn:documentation>
      <bpmn:laneSet id="W2191_LaneSet3">
        <bpmn:lane id="W2191_Lane1" name="IT">
        <bpmn:flowNodeRef>W2191_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2191_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2191_Lane2" name="Logistics Manager">
        <bpmn:flowNodeRef>W2191_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2191_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2191_Start4" name="Contract signed with new partner">
        <bpmn:outgoing>W2191_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2191_Task5" name="IT configures API integration: order push, delivery status, proof of delivery…">
        <bpmn:documentation>Step 1: IT configures API integration: order push, delivery status, proof of delivery, driver tracking; tests in sandbox; Logistics Manager trains partner on BuildRight processes
Responsible (R): IT / Logistics Manager
Accountable (A): CIO
Duration: 5–10 days</bpmn:documentation>
        <bpmn:incoming>W2191_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2191_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2191_Task6" name="Pilot period: 2-week controlled rollout with 1 DC; monitors performance vs…">
        <bpmn:documentation>Step 2: Pilot period: 2-week controlled rollout with 1 DC; monitors performance vs. SLA; full rollout upon meeting pilot criteria
Responsible (R): Logistics Manager
Accountable (A): VP Supply Chain
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W2191_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2191_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2191_End7" name="Complete">
        <bpmn:incoming>W2191_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2191_Annotation8">
        <bpmn:text>Controls: - CTL-397 (ensure controlled execution — 3PL Partner Onboarding &amp; Qualification (PA-56.1).) | - CTL-397: API/integration integrity — links to VS-27; operational: CIO sign-off on go-live after pilot
Owner: IT Integration Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2191_Assoc9" sourceRef="W2191_Annotation8" targetRef="W2191_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2191_Flow10" sourceRef="W2191_Start4" targetRef="W2191_Task5" />
      <bpmn:sequenceFlow id="W2191_Flow11" sourceRef="W2191_Task5" targetRef="W2191_Task6" />
      <bpmn:sequenceFlow id="W2191_Flow12" sourceRef="W2191_Task6" targetRef="W2191_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2191_diag">
      <bpmndi:BPMNPlane id="W2191_plane" bpmnElement="W_W2191">
        <bpmndi:BPMNShape id="W2191_Lane1_di" bpmnElement="W2191_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2191_Lane2_di" bpmnElement="W2191_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2191_Task5_di" bpmnElement="W2191_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2191_Task6_di" bpmnElement="W2191_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2191_Start4_di" bpmnElement="W2191_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2191_End7_di" bpmnElement="W2191_End7"><dc:Bounds x="840" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2191_Annotation8_di" bpmnElement="W2191_Annotation8"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2191_Flow10_di" bpmnElement="W2191_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2191_Flow11_di" bpmnElement="W2191_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2191_Flow12_di" bpmnElement="W2191_Flow12"><di:waypoint x="790" y="335" /><di:waypoint x="840" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2191_Assoc9_di" bpmnElement="W2191_Assoc9"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2192" name="W2192. Driver &amp; Vehicle Compliance Verification" isExecutable="false">
      <bpmn:documentation>Trigger: Partner onboarding or annual re-certification
Frequency: Annual; onboarding as needed
Volume: ~200–300 drivers across all 3PL partners
Owner: Logistics Coordinator
Participants: Logistics Manager
Source: workflow W2192 — Driver &amp; Vehicle Compliance Verification</bpmn:documentation>
      <bpmn:laneSet id="W2192_LaneSet2">
        <bpmn:lane id="W2192_Lane1" name="Logistics Coordinator">
        <bpmn:flowNodeRef>W2192_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2192_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2192_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2192_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2192_Start3" name="Partner onboarding or annual re-certification">
        <bpmn:outgoing>W2192_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2192_Task4" name="Coordinator verifies driver credentials: professional license, drug test…">
        <bpmn:documentation>Step 1: Coordinator verifies driver credentials: professional license, drug test, background check, BuildRight safety training; verifies vehicle compliance: registration, insurance, roadworthiness
Responsible (R): Logistics Coordinator
Accountable (A): Logistics Manager
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W2192_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2192_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2192_Task5" name="Annual re-certification: partners submit updated documents; non-compliant…">
        <bpmn:documentation>Step 2: Annual re-certification: partners submit updated documents; non-compliant drivers/vehicles suspended until cleared
Responsible (R): Logistics Coordinator
Accountable (A): Logistics Manager
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2192_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2192_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2192_End6" name="Complete">
        <bpmn:incoming>W2192_Flow11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2192_Annotation7">
        <bpmn:text>Controls: - CTL-180 (ensure 3PL delivery-partner compliance &amp; performance.) | - CTL-397: driver/vehicle compliance — links to VS-167, VS-06; CTL-153 (driver personal-data privacy — links to VS-91); operational: Logistics Manager sign-off
Owner: Logistics Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2192_Assoc8" sourceRef="W2192_Annotation7" targetRef="W2192_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2192_Flow9" sourceRef="W2192_Start3" targetRef="W2192_Task4" />
      <bpmn:sequenceFlow id="W2192_Flow10" sourceRef="W2192_Task4" targetRef="W2192_Task5" />
      <bpmn:sequenceFlow id="W2192_Flow11" sourceRef="W2192_Task5" targetRef="W2192_End6" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2192_diag">
      <bpmndi:BPMNPlane id="W2192_plane" bpmnElement="W_W2192">
        <bpmndi:BPMNShape id="W2192_Lane1_di" bpmnElement="W2192_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2192_Task4_di" bpmnElement="W2192_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2192_Task5_di" bpmnElement="W2192_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2192_Start3_di" bpmnElement="W2192_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2192_End6_di" bpmnElement="W2192_End6"><dc:Bounds x="840" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2192_Annotation7_di" bpmnElement="W2192_Annotation7"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2192_Flow9_di" bpmnElement="W2192_Flow9"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2192_Flow10_di" bpmnElement="W2192_Flow10"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2192_Flow11_di" bpmnElement="W2192_Flow11"><di:waypoint x="790" y="165" /><di:waypoint x="840" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2192_Assoc8_di" bpmnElement="W2192_Assoc8"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2193" name="W2193. 3PL Rate Card Negotiation &amp; Renewal" isExecutable="false">
      <bpmn:documentation>Trigger: Annual rate card review or significant cost change
Frequency: Annual; ad-hoc for fuel price changes
Volume: ~10–15 rate cards
Owner: Logistics Manager
Participants: Procurement, Finance, CFO
Source: workflow W2193 — 3PL Rate Card Negotiation &amp; Renewal</bpmn:documentation>
      <bpmn:laneSet id="W2193_LaneSet3">
        <bpmn:lane id="W2193_Lane1" name="Logistics Manager">
        <bpmn:flowNodeRef>W2193_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2193_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2193_Lane2" name="Finance">
        <bpmn:flowNodeRef>W2193_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2193_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2193_Start4" name="Annual rate card review or significant cost change">
        <bpmn:outgoing>W2193_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2193_Task5" name="Logistics Manager analyzes spend, volume, and market rates; benchmarks vs. spot…">
        <bpmn:documentation>Step 1: Logistics Manager analyzes spend, volume, and market rates; benchmarks vs. spot rates; negotiates: base per-km rate, weight surcharges, waiting time, multi-drop discounts, peak surcharges
Responsible (R): Logistics Manager
Accountable (A): Procurement
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2193_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2193_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2193_Task6" name="Finance validates cost impact; approves; updated rate card configured in ERP">
        <bpmn:documentation>Step 2: Finance validates cost impact; approves; updated rate card configured in ERP
Responsible (R): Finance
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2193_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2193_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2193_End7" name="Complete">
        <bpmn:incoming>W2193_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2193_Annotation8">
        <bpmn:text>Controls: - CTL-397: 3PL-contract accuracy — links to VS-03; CTL-48 (rate-dispute resolution); operational: CFO sign-off
Owner: Logistics Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2193_Assoc9" sourceRef="W2193_Annotation8" targetRef="W2193_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2193_Flow10" sourceRef="W2193_Start4" targetRef="W2193_Task5" />
      <bpmn:sequenceFlow id="W2193_Flow11" sourceRef="W2193_Task5" targetRef="W2193_Task6" />
      <bpmn:sequenceFlow id="W2193_Flow12" sourceRef="W2193_Task6" targetRef="W2193_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2193_diag">
      <bpmndi:BPMNPlane id="W2193_plane" bpmnElement="W_W2193">
        <bpmndi:BPMNShape id="W2193_Lane1_di" bpmnElement="W2193_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2193_Lane2_di" bpmnElement="W2193_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2193_Task5_di" bpmnElement="W2193_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2193_Task6_di" bpmnElement="W2193_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2193_Start4_di" bpmnElement="W2193_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2193_End7_di" bpmnElement="W2193_End7"><dc:Bounds x="840" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2193_Annotation8_di" bpmnElement="W2193_Annotation8"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2193_Flow10_di" bpmnElement="W2193_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2193_Flow11_di" bpmnElement="W2193_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2193_Flow12_di" bpmnElement="W2193_Flow12"><di:waypoint x="790" y="335" /><di:waypoint x="840" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2193_Assoc9_di" bpmnElement="W2193_Assoc9"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2194" name="W2194. 3PL Insurance &amp; Liability Management" isExecutable="false">
      <bpmn:documentation>Trigger: Insurance renewal or delivery incident
Frequency: Annual renewal; ad-hoc for incidents
Volume: ~10–15 partner policies
Owner: Logistics Manager
Participants: Legal, Finance, CFO
Source: workflow W2194 — 3PL Insurance &amp; Liability Management</bpmn:documentation>
      <bpmn:laneSet id="W2194_LaneSet2">
        <bpmn:lane id="W2194_Lane1" name="Logistics Manager">
        <bpmn:flowNodeRef>W2194_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2194_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2194_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2194_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2194_Start3" name="Insurance renewal or delivery incident">
        <bpmn:outgoing>W2194_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2194_Task4" name="Manager ensures all partners maintain required insurance (vehicle, cargo…">
        <bpmn:documentation>Step 1: Manager ensures all partners maintain required insurance (vehicle, cargo, third-party liability); tracks expiry dates; files claims for incidents (damage, loss, accident)
Responsible (R): Logistics Manager
Accountable (A): Legal
Duration: 2–3 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W2194_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2194_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2194_Task5" name="Annual: reviews insurance adequacy; adjusts coverage based on claims history…">
        <bpmn:documentation>Step 2: Annual: reviews insurance adequacy; adjusts coverage based on claims history and delivery volume growth
Responsible (R): Logistics Manager / Finance
Accountable (A): CFO
Duration: 1 day/year</bpmn:documentation>
        <bpmn:incoming>W2194_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2194_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2194_End6" name="Complete">
        <bpmn:incoming>W2194_Flow11</bpmn:incoming>
      </bpmn:endEvent>
