    <bpmn:process id="W_W2195" name="W2195. 3PL Capacity Planning &amp; Allocation" isExecutable="false">
      <bpmn:documentation>Trigger: Seasonal capacity review or new store openings
Frequency: Quarterly; ad-hoc for openings
Volume: 4 DCs; ~17,200 deliveries/month (the W19 home-delivery canon)
Owner: Logistics Manager
Participants: VP Supply Chain, DC Operations
Source: workflow W2195 — 3PL Capacity Planning &amp; Allocation</bpmn:documentation>
      <bpmn:laneSet id="W2195_LaneSet2">
        <bpmn:lane id="W2195_Lane1" name="Logistics Manager">
        <bpmn:flowNodeRef>W2195_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2195_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2195_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2195_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2195_Start3" name="Seasonal capacity review or new store openings">
        <bpmn:outgoing>W2195_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2195_Task4" name="Manager forecasts capacity needs: seasonal peaks, new stores (~10–15/year)…">
        <bpmn:documentation>Step 1: Manager forecasts capacity needs: seasonal peaks, new stores (~10–15/year), replenishment volume; allocates across partners by capacity, performance, cost; ensures no single partner &gt;50%
Responsible (R): Logistics Manager
Accountable (A): VP Supply Chain
Duration: 2–3 days/quarter</bpmn:documentation>
        <bpmn:incoming>W2195_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2195_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2195_Task5" name="Coordinates surge capacity for peaks: pre-books vehicles, temporary agreements…">
        <bpmn:documentation>Step 2: Coordinates surge capacity for peaks: pre-books vehicles, temporary agreements, adjusts DC scheduling
Responsible (R): Logistics Manager
Accountable (A): DC Operations
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2195_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2195_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2195_End6" name="Complete">
        <bpmn:incoming>W2195_Flow11</bpmn:incoming>
      </bpmn:endEvent>
