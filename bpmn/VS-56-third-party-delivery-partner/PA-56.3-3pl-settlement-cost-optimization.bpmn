    <bpmn:process id="W_W2207" name="W2207. Per-Delivery Cost Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly analysis cycle — Per-Delivery Cost
Frequency: Monthly
Volume: ~17,200 deliveries analyzed (the W19 home-delivery canon)
Owner: Logistics Finance Analyst
Participants: Finance Manager
Source: workflow W2207 — Per-Delivery Cost Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2207_LaneSet2">
        <bpmn:lane id="W2207_Lane1" name="Logistics Finance Analyst">
        <bpmn:flowNodeRef>W2207_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2207_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2207_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2207_Start3" name="Monthly analysis cycle — Per-Delivery Cost">
        <bpmn:outgoing>W2207_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2207_Task4" name="Analyst calculates per-delivery cost by partner, route, category, delivery…">
        <bpmn:documentation>Step 1: Analyst calculates per-delivery cost by partner, route, category, delivery type; identifies high-cost routes and partners; recommends optimization actions
Responsible (R): Logistics Finance Analyst
Accountable (A): Finance Manager
Duration: 4–6 hours/month</bpmn:documentation>
        <bpmn:incoming>W2207_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2207_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2207_End5" name="Complete">
        <bpmn:incoming>W2207_Flow9</bpmn:incoming>
      </bpmn:endEvent>
