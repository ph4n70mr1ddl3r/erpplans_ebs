    <bpmn:process id="W_W2206" name="W2206. Monthly 3PL Invoice Processing" isExecutable="false">
      <bpmn:documentation>Trigger: 3PL partner submits monthly invoice
Frequency: Monthly; ~10–15 invoices
Volume: ~PHP 30–50M/month total logistics
Owner: Logistics Finance Analyst
Participants: Finance Manager
Source: workflow W2206 — Monthly 3PL Invoice Processing</bpmn:documentation>
      <bpmn:laneSet id="W2206_LaneSet2">
        <bpmn:lane id="W2206_Lane1" name="Logistics Finance Analyst">
        <bpmn:flowNodeRef>W2206_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2206_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2206_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2206_Start3" name="3PL partner submits monthly invoice">
        <bpmn:outgoing>W2206_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2206_Task4" name="Analyst matches invoice vs. system delivery records: validates count…">
        <bpmn:documentation>Step 1: Analyst matches invoice vs. system delivery records: validates count, distances, surcharges, SLA penalties; investigates discrepancies with partner; approves adjusted invoice; payment Net 30
Responsible (R): Logistics Finance Analyst
Accountable (A): Finance Manager
Duration: 4–6 hours/month</bpmn:documentation>
        <bpmn:incoming>W2206_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2206_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2206_End5" name="Complete">
        <bpmn:incoming>W2206_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2206_Annotation6">
        <bpmn:text>Controls: - CTL-399 (ensure controlled execution — 3PL Settlement &amp; Cost Optimization (PA-56.3).) | - operational: invoice/POD-match integrity; CTL-178 (3PL SLA reviews documented with penalties applied at billing); operational: Finance Manager sign-off
Owner: Logistics Finance Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2206_Assoc7" sourceRef="W2206_Annotation6" targetRef="W2206_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2206_Flow8" sourceRef="W2206_Start3" targetRef="W2206_Task4" />
      <bpmn:sequenceFlow id="W2206_Flow9" sourceRef="W2206_Task4" targetRef="W2206_End5" />
    </bpmn:process>
