      </bpmn:startEvent>
      <bpmn:userTask id="W2212_Task4" name="Reviews payment terms (Net 30/60) per partner; negotiates early-payment…">
        <bpmn:documentation>Step 1: Reviews payment terms (Net 30/60) per partner; negotiates early-payment discounts; balances cash-flow benefit vs. partner relationship; Finance sets up in ERP
Responsible (R): Logistics Manager / Finance
Accountable (A): CFO
Duration: 1–2 days/year</bpmn:documentation>
        <bpmn:incoming>W2212_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2212_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2212_End5" name="Complete">
        <bpmn:incoming>W2212_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2212_Annotation6">
        <bpmn:text>Controls: - CTL-42: partner bank-detail guard (vendor-payment-fraud discipline applied to 3PL partners); CTL-399 (payment-terms accuracy at 3PL settlement); operational: CFO sign-off
Owner: Logistics Manager</bpmn:text>
      </bpmn:textAnnotation>
