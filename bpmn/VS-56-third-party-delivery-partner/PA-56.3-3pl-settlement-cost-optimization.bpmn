        <bpmn:flowNodeRef>W2211_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2211_Start3" name="Monthly cycle — Delivery Cost Allocation Category">
        <bpmn:outgoing>W2211_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2211_Task4" name="Analyst allocates delivery cost to merchandise categories: weight/volume-based…">
        <bpmn:documentation>Step 1: Analyst allocates delivery cost to merchandise categories: weight/volume-based, route-based; computes landed cost per category (links to VS-158 / W85 product costing); identifies high-delivery-cost categories
Responsible (R): Logistics Finance Analyst
Accountable (A): Finance Manager
Duration: 4–6 hours/month</bpmn:documentation>
        <bpmn:incoming>W2211_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2211_Flow9</bpmn:outgoing>
      </bpmn:userTask>
