    <bpmn:process id="W_W2211" name="W2211. Delivery Cost Allocation by Category" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly cycle — Delivery Cost Allocation Category
Frequency: Monthly
Volume: 13 categories
Owner: Logistics Finance Analyst
Participants: Finance Manager
Source: workflow W2211 — Delivery Cost Allocation by Category</bpmn:documentation>
      <bpmn:laneSet id="W2211_LaneSet2">
        <bpmn:lane id="W2211_Lane1" name="Logistics Finance Analyst">
