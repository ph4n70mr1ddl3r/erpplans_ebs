    <bpmn:process id="W_W2210" name="W2210. 3PL Fuel Surcharge Management" isExecutable="false">
      <bpmn:documentation>Trigger: Significant fuel price change (&gt;5%)
Frequency: Ad-hoc; ~2–4/year
Volume: ~10–15 partners
Owner: Logistics Manager
Participants: Finance, CFO
Source: workflow W2210 — 3PL Fuel Surcharge Management</bpmn:documentation>
      <bpmn:laneSet id="W2210_LaneSet2">
        <bpmn:lane id="W2210_Lane1" name="Logistics Manager">
        <bpmn:flowNodeRef>W2210_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2210_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2210_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2210_Start3" name="Significant fuel price change (&gt;5%)">
        <bpmn:outgoing>W2210_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2210_Task4" name="Activates fuel-surcharge adjustment clause in 3PL contracts; adjusts…">
        <bpmn:documentation>Step 1: Activates fuel-surcharge adjustment clause in 3PL contracts; adjusts per-delivery rates; Finance validates; communicates to partners; implements in ERP
Responsible (R): Logistics Manager / Finance
Accountable (A): CFO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2210_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2210_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2210_End5" name="Complete">
        <bpmn:incoming>W2210_Flow9</bpmn:incoming>
      </bpmn:endEvent>
