        <bpmn:outgoing>W2208_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2208_Task4" name="Benchmarks partner rates vs. market (spot rates, industry surveys); identifies…">
        <bpmn:documentation>Step 1: Benchmarks partner rates vs. market (spot rates, industry surveys); identifies above-market partners for renegotiation or replacement; feeds the W2197 termination/transition decision
Responsible (R): Logistics Manager
Accountable (A): VP Supply Chain
Duration: 2–3 days/quarter</bpmn:documentation>
        <bpmn:incoming>W2208_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2208_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2208_End5" name="Complete">
        <bpmn:incoming>W2208_Flow9</bpmn:incoming>
      </bpmn:endEvent>
