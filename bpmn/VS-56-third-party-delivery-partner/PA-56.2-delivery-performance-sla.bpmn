    <bpmn:process id="W_W2202" name="W2202. Proof of Delivery &amp; Documentation" isExecutable="false">
      <bpmn:documentation>Trigger: Every delivery completion
Frequency: Every delivery (~10,000/month)
Volume: ~10,000 PODs/month
Owner: 3PL Driver / Receiving Clerk
Participants: Logistics Coordinator
Source: workflow W2202 — Proof of Delivery &amp; Documentation</bpmn:documentation>
      <bpmn:laneSet id="W2202_LaneSet2">
        <bpmn:lane id="W2202_Lane1" name="3PL Driver">
        <bpmn:flowNodeRef>W2202_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2202_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2202_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2202_Start3" name="Every delivery completion">
        <bpmn:outgoing>W2202_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2202_Task4" name="Driver obtains POD: digital signature + GPS + timestamp; system stores with…">
        <bpmn:documentation>Step 1: Driver obtains POD: digital signature + GPS + timestamp; system stores with delivery record; auto-matches for settlement
Responsible (R): 3PL Driver / System
Accountable (A): Logistics Coordinator
Duration: 2 min/delivery</bpmn:documentation>
        <bpmn:incoming>W2202_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2202_Flow9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2202_End5" name="Complete">
        <bpmn:incoming>W2202_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2202_Annotation6">
        <bpmn:text>Controls: - CTL-398 (ensure controlled execution — Delivery Performance &amp; SLA Management (PA-56.2).) | - operational: POD integrity; delivery-fraud detection; operational: Logistics Coordinator settlement-match review
Owner: 3PL Driver / Receiving Clerk</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2202_Assoc7" sourceRef="W2202_Annotation6" targetRef="W2202_Start3" associationDirection="None" />
