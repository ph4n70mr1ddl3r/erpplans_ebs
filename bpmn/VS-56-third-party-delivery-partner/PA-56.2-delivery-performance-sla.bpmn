    <bpmn:process id="W_W2198" name="W2198. Real-Time Delivery Tracking &amp; Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Active deliveries in progress
Frequency: Continuous; ~17,200 deliveries/month
Volume: ~573 deliveries/day (~17,200/month)
Owner: Logistics Coordinator
Participants: Logistics Manager, Store Manager
Source: workflow W2198 — Real-Time Delivery Tracking &amp; Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W2198_LaneSet3">
        <bpmn:lane id="W2198_Lane1" name="System">
        <bpmn:flowNodeRef>W2198_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2198_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2198_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W2198_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2198_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2198_Start4" name="Active deliveries in progress">
        <bpmn:outgoing>W2198_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2198_Task5" name="System tracks all 3PL deliveries: driver location, ETA, status; Coordinator…">
        <bpmn:documentation>Step 1: System tracks all 3PL deliveries: driver location, ETA, status; Coordinator monitors exceptions (delays &gt;30 min, no-show, breakdown, route deviation); auto-alerts store of ETA
Responsible (R): System / Logistics Coord
Accountable (A): Logistics Manager
Duration: Real-time</bpmn:documentation>
        <bpmn:incoming>W2198_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2198_Flow11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W2198_Task6" name="Store confirms receipt; exceptions escalated to Logistics Manager for…">
        <bpmn:documentation>Step 2: Store confirms receipt; exceptions escalated to Logistics Manager for corrective action
Responsible (R): Store Manager / System
Accountable (A): Logistics Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W2198_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2198_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2198_End7" name="Complete">
        <bpmn:incoming>W2198_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2198_Annotation8">
        <bpmn:text>Controls: - CTL-180 (ensure 3PL delivery-partner compliance &amp; performance.) | - CTL-398 (delivery-tracking integrity — links to VS-06); operational: Logistics Manager escalation on exceptions
Owner: Logistics Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2198_Assoc9" sourceRef="W2198_Annotation8" targetRef="W2198_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2198_Flow10" sourceRef="W2198_Start4" targetRef="W2198_Task5" />
      <bpmn:sequenceFlow id="W2198_Flow11" sourceRef="W2198_Task5" targetRef="W2198_Task6" />
      <bpmn:sequenceFlow id="W2198_Flow12" sourceRef="W2198_Task6" targetRef="W2198_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2198_diag">
      <bpmndi:BPMNPlane id="W2198_plane" bpmnElement="W_W2198">
        <bpmndi:BPMNShape id="W2198_Lane1_di" bpmnElement="W2198_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
