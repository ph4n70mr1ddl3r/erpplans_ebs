    <bpmn:process id="W_W2201" name="W2201. Delivery Quality Inspection" isExecutable="false">
      <bpmn:documentation>Trigger: Store receives delivery from 3PL
Frequency: ~1,800–2,400 store delivery drops/month (2–3 per store per week)
Volume: ~60–80 drops/day chain-wide (the consolidation canon per data-volumes §1.1)
Owner: Store Receiving Clerk
Participants: Receiving Clerk, Store Manager, Logistics Manager
Source: workflow W2201 — Delivery Quality Inspection</bpmn:documentation>
      <bpmn:laneSet id="W2201_LaneSet3">
        <bpmn:lane id="W2201_Lane1" name="Receiving Clerk">
        <bpmn:flowNodeRef>W2201_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2201_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2201_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W2201_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2201_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2201_Start4" name="Store receives delivery from 3PL">
        <bpmn:outgoing>W2201_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2201_Task5" name="Clerk inspects: damage, count vs. manifest, item condition; records GR; damaged…">
        <bpmn:documentation>Step 1: Clerk inspects: damage, count vs. manifest, item condition; records GR; damaged items photographed, noted on POD, damage record created and routed to damage-claim handling process
Responsible (R): Receiving Clerk
Accountable (A): Store Manager
Duration: 10–15 min/delivery</bpmn:documentation>
        <bpmn:incoming>W2201_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2201_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2201_Task6" name="Weekly: Store Manager reports quality issues; patterns by partner or route…">
        <bpmn:documentation>Step 2: Weekly: Store Manager reports quality issues; patterns by partner or route investigated
Responsible (R): Store Manager
Accountable (A): Logistics Manager
Duration: 15 min/week</bpmn:documentation>
        <bpmn:incoming>W2201_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2201_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2201_End7" name="Complete">
        <bpmn:incoming>W2201_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2201_Annotation8">
        <bpmn:text>Controls: - CTL-24: receiving-fraud detection; CTL-75 (damage-claim detection &amp; recovery — links to VS-90); operational: Store Manager weekly sign-off
Owner: Store Receiving Clerk</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2201_Assoc9" sourceRef="W2201_Annotation8" targetRef="W2201_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2201_Flow10" sourceRef="W2201_Start4" targetRef="W2201_Task5" />
      <bpmn:sequenceFlow id="W2201_Flow11" sourceRef="W2201_Task5" targetRef="W2201_Task6" />
      <bpmn:sequenceFlow id="W2201_Flow12" sourceRef="W2201_Task6" targetRef="W2201_End7" />
    </bpmn:process>
