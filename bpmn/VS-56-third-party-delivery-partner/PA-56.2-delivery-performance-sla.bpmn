    <bpmn:process id="W_W2200" name="W2200. Customer Home Delivery SLA Management" isExecutable="false">
      <bpmn:documentation>Trigger: Ecommerce home delivery orders
Frequency: Daily; 2–5 business day SLA
Volume: ~17,200 home deliveries/month
Owner: Ecommerce Logistics Coordinator
Participants: Ecom Logistics Coordinator, Customer Service
Source: workflow W2200 — Customer Home Delivery SLA Management</bpmn:documentation>
      <bpmn:laneSet id="W2200_LaneSet2">
        <bpmn:lane id="W2200_Lane1" name="System">
        <bpmn:flowNodeRef>W2200_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2200_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2200_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2200_Start3" name="Ecommerce home delivery orders">
        <bpmn:outgoing>W2200_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2200_Task4" name="System assigns to optimal partner by location/size/cost; tracks 2-day Metro /…">
        <bpmn:documentation>Step 1: System assigns to optimal partner by location/size/cost; tracks 2-day Metro / 3–5 day provincial SLA; proactively contacts customers for delays; failed deliveries rescheduled within 24 hours
Responsible (R): System / Ecom Logistics Coord
Accountable (A): Customer Service
Duration: 2–3 hours/day</bpmn:documentation>
        <bpmn:incoming>W2200_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2200_Flow9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2200_End5" name="Complete">
        <bpmn:incoming>W2200_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2200_Annotation6">
        <bpmn:text>Controls: - CTL-398 (home-delivery SLA — links to VS-60); CTL-44 (delivery-record integrity); operational: CS supervisor sign-off
Owner: Ecommerce Logistics Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2200_Assoc7" sourceRef="W2200_Annotation6" targetRef="W2200_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2200_Flow8" sourceRef="W2200_Start3" targetRef="W2200_Task4" />
      <bpmn:sequenceFlow id="W2200_Flow9" sourceRef="W2200_Task4" targetRef="W2200_End5" />
    </bpmn:process>
