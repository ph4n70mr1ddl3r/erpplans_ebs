    <bpmn:process id="W_W2205" name="W2205. Seasonal Delivery Surge Management" isExecutable="false">
      <bpmn:documentation>Trigger: Peak season (Christmas, summer)
Frequency: 2–3 major peaks/year
Volume: ~30–50% volume increase
Owner: Logistics Manager
Participants: VP Supply Chain
Source: workflow W2205 — Seasonal Delivery Surge Management</bpmn:documentation>
      <bpmn:laneSet id="W2205_LaneSet2">
        <bpmn:lane id="W2205_Lane1" name="Logistics Manager">
        <bpmn:flowNodeRef>W2205_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2205_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2205_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2205_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2205_Start3" name="Peak season (Christmas, summer)">
        <bpmn:outgoing>W2205_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2205_Task4" name="Manager forecasts peak volume; pre-books 3PL capacity 4–6 weeks ahead…">
        <bpmn:documentation>Step 1: Manager forecasts peak volume; pre-books 3PL capacity 4–6 weeks ahead; implements surge plan: extended windows, additional routes, temporary drivers, DC overtime
Responsible (R): Logistics Manager
Accountable (A): VP Supply Chain
Duration: 1–3 weeks</bpmn:documentation>
        <bpmn:incoming>W2205_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2205_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2205_Task5" name="Post-peak: analyzes vs. plan; adjusts for next peak; updates contracts with…">
        <bpmn:documentation>Step 2: Post-peak: analyzes vs. plan; adjusts for next peak; updates contracts with peak rate agreements
Responsible (R): Logistics Manager
Accountable (A): VP Supply Chain
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W2205_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2205_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2205_End6" name="Complete">
        <bpmn:incoming>W2205_Flow11</bpmn:incoming>
      </bpmn:endEvent>
