    <bpmn:process id="W_W2203" name="W2203. Delivery Exception Management" isExecutable="false">
      <bpmn:documentation>Trigger: Delivery issue reported
Frequency: ~500–800 exceptions/month (~5–8%)
Volume: ~500–800/month
Owner: Logistics Coordinator
Participants: Logistics Manager
Source: workflow W2203 — Delivery Exception Management</bpmn:documentation>
      <bpmn:laneSet id="W2203_LaneSet2">
        <bpmn:lane id="W2203_Lane1" name="Logistics Coordinator">
        <bpmn:flowNodeRef>W2203_Task4</bpmn:flowNodeRef>
