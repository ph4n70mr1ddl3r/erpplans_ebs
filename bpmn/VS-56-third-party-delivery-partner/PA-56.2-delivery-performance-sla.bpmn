    <bpmn:process id="W_W2204" name="W2204. Multi-Stop Route Optimization" isExecutable="false">
      <bpmn:documentation>Trigger: Daily delivery planning
Frequency: Daily; 4 DCs
Volume: ~4 DCs × 5–8 routes × 2–3 stops
Owner: DC Dispatch Supervisor
Participants: Logistics Manager
Source: workflow W2204 — Multi-Stop Route Optimization</bpmn:documentation>
      <bpmn:laneSet id="W2204_LaneSet2">
        <bpmn:lane id="W2204_Lane1" name="System">
        <bpmn:flowNodeRef>W2204_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2204_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2204_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
