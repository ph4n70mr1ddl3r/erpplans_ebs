    <bpmn:process id="W_W2199" name="W2199. SLA Compliance Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Daily SLA report
Frequency: Daily
Volume: ~17,200 deliveries/month; 1–3 day SLA
Owner: Logistics Coordinator
Participants: Logistics Manager
Source: workflow W2199 — SLA Compliance Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W2199_LaneSet2">
        <bpmn:lane id="W2199_Lane1" name="System">
        <bpmn:flowNodeRef>W2199_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2199_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2199_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2199_Start3" name="Daily SLA report">
        <bpmn:outgoing>W2199_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2199_Task4" name="System calculates daily SLA compliance by partner, DC, route, store…">
        <bpmn:documentation>Step 1: System calculates daily SLA compliance by partner, DC, route, store; Coordinator investigates breaches (traffic, weather, capacity, dispatch delay); implements corrections
Responsible (R): System / Logistics Coord
Accountable (A): Logistics Manager
Duration: 1–2 hours/day</bpmn:documentation>
        <bpmn:incoming>W2199_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2199_Flow9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2199_End5" name="Complete">
        <bpmn:incoming>W2199_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2199_Annotation6">
        <bpmn:text>Controls: - CTL-180 (ensure 3PL delivery-partner compliance &amp; performance.) | - CTL-398 (SLA-accuracy — links to VS-56); operational: Logistics Manager daily sign-off
Owner: Logistics Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2199_Assoc7" sourceRef="W2199_Annotation6" targetRef="W2199_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2199_Flow8" sourceRef="W2199_Start3" targetRef="W2199_Task4" />
      <bpmn:sequenceFlow id="W2199_Flow9" sourceRef="W2199_Task4" targetRef="W2199_End5" />
    </bpmn:process>
