        <bpmn:outgoing>W2204_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2204_Task4" name="System generates optimized routes: groups by geography, minimizes distance…">
        <bpmn:documentation>Step 1: System generates optimized routes: groups by geography, minimizes distance, balances capacity; Supervisor reviews and adjusts for priorities, last-minute orders, road closures
Responsible (R): System / DC Dispatch Supervisor
Accountable (A): Logistics Manager
Duration: 1–2 hours/day</bpmn:documentation>
        <bpmn:incoming>W2204_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2204_Flow9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2204_End5" name="Complete">
        <bpmn:incoming>W2204_Flow9</bpmn:incoming>
      </bpmn:endEvent>
