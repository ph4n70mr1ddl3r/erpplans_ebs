    <bpmn:process id="W_W5243" name="W5243. Direct Delivery Container Devanning and Joint Quantity Survey at Jobsite" isExecutable="false">
      <bpmn:documentation>Trigger: Container arrival at jobsite
Frequency: Per container delivery
Volume: ~100-150 containers devanned annually
Owner: B2B Sourcing Quality Inspector
Participants: Customer Site Engineer, Drayage Driver, Quantity Surveyor
Source: workflow W5243 — Direct Delivery Container Devanning and Joint Quantity Survey at Jobsite</bpmn:documentation>
      <bpmn:laneSet id="W5243_LaneSet3">
