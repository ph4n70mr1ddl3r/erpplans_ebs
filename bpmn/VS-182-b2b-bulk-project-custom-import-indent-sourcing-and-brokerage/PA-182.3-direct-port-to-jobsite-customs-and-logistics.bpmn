        <bpmn:documentation>Step 1: Verify unloading zone space availability and ground stability at jobsite.
Responsible (R): Customer Site Coordinator
Accountable (A): Customer Site Coordinator
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W5242_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5242_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5242_Task6" name="Mobilize mobile cranes, forklift operators, and rigging crew matching cargo…">
        <bpmn:documentation>Step 2: Mobilize mobile cranes, forklift operators, and rigging crew matching cargo dimensions.
Responsible (R): Customer Site Coordinator
Accountable (A): Customer Site Coordinator
Duration: 2-3 hours</bpmn:documentation>
        <bpmn:incoming>W5242_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5242_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5242_Task7" name="Establish safety perimeter and secure overhead power line clearances.">
        <bpmn:documentation>Step 3: Establish safety perimeter and secure overhead power line clearances.
Responsible (R): Safety Officer
Accountable (A): Customer Site Coordinator
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W5242_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5242_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5242_Task8" name="Transmit site readiness confirmation to drayage dispatcher.">
        <bpmn:documentation>Step 4: Transmit site readiness confirmation to drayage dispatcher.
Responsible (R): Customer Site Coordinator
Accountable (A): Customer Site Coordinator
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W5242_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5242_Flow16</bpmn:outgoing>
      </bpmn:userTask>
