        <bpmn:outgoing>W5243_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5243_Task6" name="Unload materials and perform joint physical count (BuildRight inspector +…">
        <bpmn:documentation>Step 2: Unload materials and perform joint physical count (BuildRight inspector + customer surveyor).
Responsible (R): Quantity Surveyor
Accountable (A): B2B Sourcing Quality Inspector
Duration: 2-4 hours</bpmn:documentation>
        <bpmn:incoming>W5243_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5243_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5243_Task7" name="Inspect materials for visual transit damage, warping, or water ingress.">
