      </bpmn:startEvent>
      <bpmn:userTask id="W5241_Task5" name="Conduct physical route survey to identify height clearances, bridge weight…">
        <bpmn:documentation>Step 1: Conduct physical route survey to identify height clearances, bridge weight limits, and truck bans.
Responsible (R): Logistics Fleet Supervisor
Accountable (A): Logistics Fleet Supervisor
Duration: 3-5 hours</bpmn:documentation>
        <bpmn:incoming>W5241_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5241_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5241_Task6" name="Secure local LGU special permits for oversized cargo or route exemptions.">
        <bpmn:documentation>Step 2: Secure local LGU special permits for oversized cargo or route exemptions.
Responsible (R): Logistics Fleet Supervisor
Accountable (A): Logistics Fleet Supervisor
Duration: 2-3 hours</bpmn:documentation>
        <bpmn:incoming>W5241_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5241_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5241_Task7" name="Establish transit schedule avoiding municipal truck ban hours (typically peak…">
        <bpmn:documentation>Step 3: Establish transit schedule avoiding municipal truck ban hours (typically peak commute windows).
Responsible (R): Freight Coordinator
Accountable (A): Logistics Fleet Supervisor
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5241_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5241_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5241_Task8" name="Brief transport crew on route restrictions and emergency contact protocols.">
        <bpmn:documentation>Step 4: Brief transport crew on route restrictions and emergency contact protocols.
Responsible (R): Logistics Fleet Supervisor
Accountable (A): Logistics Fleet Supervisor
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5241_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5241_Flow16</bpmn:outgoing>
      </bpmn:userTask>
