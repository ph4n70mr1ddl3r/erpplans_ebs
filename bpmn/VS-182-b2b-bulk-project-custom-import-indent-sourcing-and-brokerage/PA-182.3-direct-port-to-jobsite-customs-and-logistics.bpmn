Responsible (R): B2B Sourcing Quality Inspector
Accountable (A): B2B Sourcing Quality Inspector
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5243_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5243_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5243_Task8" name="Draft Joint Quantity Survey (JQS) statement; sign off by inspector and client.">
