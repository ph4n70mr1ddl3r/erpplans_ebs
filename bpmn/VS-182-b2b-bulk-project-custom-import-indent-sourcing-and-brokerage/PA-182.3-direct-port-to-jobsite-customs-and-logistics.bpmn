    <bpmn:process id="W_W5242" name="W5242. Jobsite Unloading Site Readiness and Heavy Equipment Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Route survey approval (W5241)
Frequency: Per scheduled delivery date
Volume: ~40-50 unloading preparations annually
Owner: Customer Site Coordinator
Participants: Logistics Fleet Supervisor, Heavy Equipment Operator, Safety Officer (VS-147)
Source: workflow W5242 — Jobsite Unloading Site Readiness and Heavy Equipment Coordination</bpmn:documentation>
      <bpmn:laneSet id="W5242_LaneSet3">
        <bpmn:lane id="W5242_Lane1" name="Customer Site Coordinator">
        <bpmn:flowNodeRef>W5242_Task5</bpmn:flowNodeRef>
