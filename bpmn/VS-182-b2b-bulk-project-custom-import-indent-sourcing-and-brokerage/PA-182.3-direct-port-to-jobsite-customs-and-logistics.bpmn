    <bpmn:process id="W_W5241" name="W5241. Direct Port-to-Jobsite Transit Logistics Planning and Route Survey" isExecutable="false">
      <bpmn:documentation>Trigger: Approved drayage schedule (W5240)
Frequency: Per jobsite delivery project
Volume: ~40-50 route surveys annually
Owner: Logistics Fleet Supervisor
Participants: Freight Coordinator, Drayage Carrier Dispatcher, Customer Site Engineer
Source: workflow W5241 — Direct Port-to-Jobsite Transit Logistics Planning and Route Survey</bpmn:documentation>
      <bpmn:laneSet id="W5241_LaneSet3">
        <bpmn:lane id="W5241_Lane1" name="Logistics Fleet Supervisor">
        <bpmn:flowNodeRef>W5241_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5241_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5241_Task8</bpmn:flowNodeRef>
