      <bpmn:sequenceFlow id="W3939_Flow12" sourceRef="W3939_Task5" targetRef="W3939_Task6" />
      <bpmn:sequenceFlow id="W3939_Flow13" sourceRef="W3939_Task6" targetRef="W3939_End7" />
    </bpmn:process>
