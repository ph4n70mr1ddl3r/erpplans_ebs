      <bpmn:sequenceFlow id="W3945_Flow11" sourceRef="W3945_Task4" targetRef="W3945_Task5" />
      <bpmn:sequenceFlow id="W3945_Flow12" sourceRef="W3945_Task5" targetRef="W3945_Task6" />
      <bpmn:sequenceFlow id="W3945_Flow13" sourceRef="W3945_Task6" targetRef="W3945_End7" />
    </bpmn:process>
