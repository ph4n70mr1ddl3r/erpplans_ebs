        <bpmndi:BPMNShape id="W3306_Task7_di" bpmnElement="W3306_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3306_Start4_di" bpmnElement="W3306_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3306_End8_di" bpmnElement="W3306_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3306_Annotation9_di" bpmnElement="W3306_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3306_Flow11_di" bpmnElement="W3306_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3306_Flow12_di" bpmnElement="W3306_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3306_Flow13_di" bpmnElement="W3306_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3306_Flow14_di" bpmnElement="W3306_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3306_Assoc10_di" bpmnElement="W3306_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3307" name="W3307. Annual Salary Structure Design, Range Setting &amp; Range Penetration" isExecutable="false">
      <bpmn:documentation>Trigger: Annual compensation review; market-data refresh (W3308)
Frequency: Annual
Volume: One structure per entity/region (5 entities)
Owner: Compensation &amp; Benefits Manager
Participants: C&amp;B Manager, CHRO, CFO, FP&amp;A (links to VS-17.4), Payroll (links to VS-19.2), Compensation Analyst
Source: workflow W3307 — Annual Salary Structure Design, Range Setting &amp; Range Penetration</bpmn:documentation>
      <bpmn:laneSet id="W3307_LaneSet3">
        <bpmn:lane id="W3307_Lane1" name="C&amp;B Manager">
        <bpmn:flowNodeRef>W3307_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3307_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3307_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3307_Lane2" name="CHRO">
        <bpmn:flowNodeRef>W3307_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3307_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3307_Start4" name="Annual compensation review; market-data refresh (W3308)">
        <bpmn:outgoing>W3307_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3307_Task5" name="C&amp;B Manager designs the annual salary structure: per grade, minimum / midpoint…">
        <bpmn:documentation>Step 1: C&amp;B Manager designs the annual salary structure: per grade, minimum / midpoint / maximum (range spread typically 30–50%), informed by market data (W3308), pay positioning (e.g., 50th/75th percentile), internal equity, and budget (W3327)
Responsible (R): C&amp;B Manager
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3307_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3307_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3307_Task6" name="CHRO/CFO review structure cost impact, affordability vs labor-budget (links to…">
        <bpmn:documentation>Step 2: CHRO/CFO review structure cost impact, affordability vs labor-budget (links to VS-33.1), and market competitiveness; approve structure and effective date; set range-penetration targets by grade/tenure
Responsible (R): CHRO / CFO
Accountable (A): CEO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3307_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3307_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3307_Task7" name="C&amp;B Manager loads the structure into HRIS/payroll (links to VS-19.2), publish…">
        <bpmn:documentation>Step 3: C&amp;B Manager loads the structure into HRIS/payroll (links to VS-19.2), publish to HRBP/managers, and monitor range penetration and compliance (W3311)
Responsible (R): C&amp;B Manager
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3307_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3307_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3307_End8" name="Complete">
        <bpmn:incoming>W3307_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3307_Annotation9">
        <bpmn:text>Controls: - CTL-535 (ensure controlled execution — Job Architecture, Pay Structure &amp; Market Benchmarking (PA-102.1).) | - operational: cost modeling (W3327) and CFO review; operational: market benchmarking (W3308)
Owner: Compensation &amp; Benefits Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3307_Assoc10" sourceRef="W3307_Annotation9" targetRef="W3307_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3307_Flow11" sourceRef="W3307_Start4" targetRef="W3307_Task5" />
      <bpmn:sequenceFlow id="W3307_Flow12" sourceRef="W3307_Task5" targetRef="W3307_Task6" />
      <bpmn:sequenceFlow id="W3307_Flow13" sourceRef="W3307_Task6" targetRef="W3307_Task7" />
      <bpmn:sequenceFlow id="W3307_Flow14" sourceRef="W3307_Task7" targetRef="W3307_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3307_diag">
      <bpmndi:BPMNPlane id="W3307_plane" bpmnElement="W_W3307">
        <bpmndi:BPMNShape id="W3307_Lane1_di" bpmnElement="W3307_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3307_Lane2_di" bpmnElement="W3307_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3307_Task5_di" bpmnElement="W3307_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3307_Task6_di" bpmnElement="W3307_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3307_Task7_di" bpmnElement="W3307_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3307_Start4_di" bpmnElement="W3307_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3307_End8_di" bpmnElement="W3307_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3307_Annotation9_di" bpmnElement="W3307_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3307_Flow11_di" bpmnElement="W3307_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3307_Flow12_di" bpmnElement="W3307_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3307_Flow13_di" bpmnElement="W3307_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3307_Flow14_di" bpmnElement="W3307_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3307_Assoc10_di" bpmnElement="W3307_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
