      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3306" name="W3306. Job Evaluation, Grading &amp; Job Architecture (Career Framework) Maintenance" isExecutable="false">
      <bpmn:documentation>Trigger: New/changed job; periodic architecture review
Frequency: Annual + on change
Volume: ~250–350 jobs into the grading structure
Owner: Compensation &amp; Benefits Manager
Participants: C&amp;B Manager, HRBP, CHRO, Executives, Job-evaluation committee
Source: workflow W3306 — Job Evaluation, Grading &amp; Job Architecture (Career Framework) Maintenance</bpmn:documentation>
      <bpmn:laneSet id="W3306_LaneSet3">
        <bpmn:lane id="W3306_Lane1" name="C&amp;B Manager">
        <bpmn:flowNodeRef>W3306_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3306_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3306_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3306_Lane2" name="Committee">
        <bpmn:flowNodeRef>W3306_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3306_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3306_Start4" name="New/changed job; periodic architecture review">
        <bpmn:outgoing>W3306_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3306_Task5" name="C&amp;B Manager evaluate each job against the job-evaluation methodology (e.g…">
        <bpmn:documentation>Step 1: C&amp;B Manager evaluate each job against the job-evaluation methodology (e.g., point-factor: know-how, problem-solving, accountability, scope) and assign a grade/band; build/maintain the career framework (job family, levels, progression criteria)
Responsible (R): C&amp;B Manager
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3306_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3306_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3306_Task6" name="Job-evaluation committee (HR + business + finance) review borderline/contested…">
        <bpmn:documentation>Step 2: Job-evaluation committee (HR + business + finance) review borderline/contested grades for consistency and equity; approve the architecture and grade assignments
Responsible (R): Committee
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3306_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3306_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3306_Task7" name="C&amp;B Manager publish the career framework, map incumbents to grades, and link to…">
        <bpmn:documentation>Step 3: C&amp;B Manager publish the career framework, map incumbents to grades, and link to succession/development (links to VS-19.1/VS-19.4) and pay structure (W3307); update HR master (links to VS-29.2)
Responsible (R): C&amp;B Manager
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3306_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3306_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3306_End8" name="Complete">
        <bpmn:incoming>W3306_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3306_Annotation9">
        <bpmn:text>Controls: - CTL-535 (ensure controlled execution — Job Architecture, Pay Structure &amp; Market Benchmarking (PA-102.1).) | - operational: methodology and committee review; operational: annual refresh
Owner: Compensation &amp; Benefits Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3306_Assoc10" sourceRef="W3306_Annotation9" targetRef="W3306_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3306_Flow11" sourceRef="W3306_Start4" targetRef="W3306_Task5" />
      <bpmn:sequenceFlow id="W3306_Flow12" sourceRef="W3306_Task5" targetRef="W3306_Task6" />
      <bpmn:sequenceFlow id="W3306_Flow13" sourceRef="W3306_Task6" targetRef="W3306_Task7" />
      <bpmn:sequenceFlow id="W3306_Flow14" sourceRef="W3306_Task7" targetRef="W3306_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3306_diag">
      <bpmndi:BPMNPlane id="W3306_plane" bpmnElement="W_W3306">
        <bpmndi:BPMNShape id="W3306_Lane1_di" bpmnElement="W3306_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3306_Lane2_di" bpmnElement="W3306_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3306_Task5_di" bpmnElement="W3306_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
