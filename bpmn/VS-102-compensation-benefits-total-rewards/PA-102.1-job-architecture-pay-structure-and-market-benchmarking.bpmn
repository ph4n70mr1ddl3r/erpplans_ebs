    <bpmn:process id="W_W3308" name="W3308. Market Compensation Benchmarking Survey Participation &amp; Pay Positioning" isExecutable="false">
      <bpmn:documentation>Trigger: Annual survey cycle; ad-hoc market intelligence
Frequency: Annual + ad-hoc
Volume: ~150–250 benchmarked jobs
Owner: Compensation &amp; Benefits Manager
Participants: C&amp;B Manager, Survey providers, CHRO, Strategic Planning (links to VS-33.3)
Source: workflow W3308 — Market Compensation Benchmarking Survey Participation &amp; Pay Positioning</bpmn:documentation>
      <bpmn:laneSet id="W3308_LaneSet2">
        <bpmn:lane id="W3308_Lane1" name="C&amp;B Manager">
        <bpmn:flowNodeRef>W3308_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3308_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3308_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3308_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3308_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3308_Start3" name="Annual survey cycle; ad-hoc market intelligence">
        <bpmn:outgoing>W3308_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3308_Task4" name="C&amp;B Manager select compensation surveys (Philippine retail/industry), match…">
        <bpmn:documentation>Step 1: C&amp;B Manager select compensation surveys (Philippine retail/industry), match BuildRight jobs to survey benchmark jobs using job descriptions (W3305), and submit anonymized pay data per survey methodology
Responsible (R): C&amp;B Manager
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3308_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3308_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3308_Task5" name="C&amp;B Manager analyze survey cuts (base, TCC, short-term incentive, benefits) by…">
        <bpmn:documentation>Step 2: C&amp;B Manager analyze survey cuts (base, TCC, short-term incentive, benefits) by grade/family; determine BuildRight&#x27;s market position (percentile) and gaps; recommend pay positioning and hot-skill premiums
Responsible (R): C&amp;B Manager
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3308_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3308_Flow12</bpmn:outgoing>
      </bpmn:userTask>
