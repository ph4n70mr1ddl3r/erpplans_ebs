<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-102.1-job-architecture-pay-structure-and-market-benchmarking" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3305" name="W3305. Job Analysis, Documentation &amp; Job Description Management" isExecutable="false">
      <bpmn:documentation>Trigger: New role creation; role change; annual job-architecture refresh
Frequency: Continuous + annual
Volume: ~250–350 distinct jobs across 6,911 employees
Owner: Compensation &amp; Benefits Manager
Participants: C&amp;B Manager, HR Business Partners, Hiring Managers, Master Data (links to VS-29), Compensation Analyst
Source: workflow W3305 — Job Analysis, Documentation &amp; Job Description Management</bpmn:documentation>
      <bpmn:laneSet id="W3305_LaneSet2">
        <bpmn:lane id="W3305_Lane1" name="C&amp;B Manager">
        <bpmn:flowNodeRef>W3305_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3305_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3305_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3305_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3305_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3305_Start3" name="New role creation; role change; annual job-architecture refresh">
        <bpmn:outgoing>W3305_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3305_Task4" name="C&amp;B Manager conduct job analysis with hiring managers: capture purpose, key…">
        <bpmn:documentation>Step 1: C&amp;B Manager conduct job analysis with hiring managers: capture purpose, key accountabilities, decision rights, scope (people/budget/revenue), required competencies, qualifications, and working conditions (store/DC/HQ, shift)
Responsible (R): C&amp;B Manager / HRBP
Accountable (A): CHRO
Duration: Per job</bpmn:documentation>
        <bpmn:incoming>W3305_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3305_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3305_Task5" name="C&amp;B Manager document the standardized job description (job code, title, family…">
        <bpmn:documentation>Step 2: C&amp;B Manager document the standardized job description (job code, title, family, level, FLSA/exempt status, physical/safety requirements); store in the HR master (links to VS-29.2) and link to recruitment (links to VS-19.1) and payroll (links to VS-19.2)
Responsible (R): C&amp;B Manager
Accountable (A): CHRO
Duration: Per job</bpmn:documentation>
        <bpmn:incoming>W3305_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3305_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3305_Task6" name="C&amp;B Manager maintain job-description version control, periodic review cadence…">
        <bpmn:documentation>Step 3: C&amp;B Manager maintain job-description version control, periodic review cadence, and change governance; retire obsolete jobs and update incumbents/payroll
Responsible (R): C&amp;B Manager / HRBP
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3305_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3305_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3305_End7" name="Complete">
        <bpmn:incoming>W3305_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3305_Annotation8">
        <bpmn:text>Controls: - CTL-535 (ensure controlled execution — Job Architecture, Pay Structure &amp; Market Benchmarking (PA-102.1).) | - operational: annual refresh; operational: templates and governance
Owner: Compensation &amp; Benefits Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3305_Assoc9" sourceRef="W3305_Annotation8" targetRef="W3305_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3305_Flow10" sourceRef="W3305_Start3" targetRef="W3305_Task4" />
      <bpmn:sequenceFlow id="W3305_Flow11" sourceRef="W3305_Task4" targetRef="W3305_Task5" />
      <bpmn:sequenceFlow id="W3305_Flow12" sourceRef="W3305_Task5" targetRef="W3305_Task6" />
      <bpmn:sequenceFlow id="W3305_Flow13" sourceRef="W3305_Task6" targetRef="W3305_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3305_diag">
      <bpmndi:BPMNPlane id="W3305_plane" bpmnElement="W_W3305">
        <bpmndi:BPMNShape id="W3305_Lane1_di" bpmnElement="W3305_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3305_Task4_di" bpmnElement="W3305_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
