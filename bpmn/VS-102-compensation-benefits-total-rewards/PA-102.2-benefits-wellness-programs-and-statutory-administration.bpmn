    <bpmn:process id="W_W3315" name="W3315. Retirement, Pension &amp; Long-Service Benefit Program Management" isExecutable="false">
      <bpmn:documentation>Trigger: Program design; retirement-event; annual review
Frequency: On event + annual
Volume: Retirement-eligible population
Owner: Compensation &amp; Benefits Manager
Participants: C&amp;B Manager, Finance/Treasury (links to VS-18), Payroll (links to VS-19.2), Separation (links to VS-19.5), Trustee/Fund Manager
Source: workflow W3315 — Retirement, Pension &amp; Long-Service Benefit Program Management</bpmn:documentation>
      <bpmn:laneSet id="W3315_LaneSet2">
        <bpmn:lane id="W3315_Lane1" name="C&amp;B Manager">
        <bpmn:flowNodeRef>W3315_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3315_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3315_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3315_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3315_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3315_Start3" name="Program design; retirement-event; annual review">
        <bpmn:outgoing>W3315_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3315_Task4" name="C&amp;B Manager design/maintain the retirement benefit program (defined-benefit or…">
        <bpmn:documentation>Step 1: C&amp;B Manager design/maintain the retirement benefit program (defined-benefit or defined-contribution, trust fund, vesting) compliant with Retirement Pay Law (RA 7641); coordinate funding with Treasury (links to VS-18) and actuarial valuation with Finance (links to VS-17.1)
Responsible (R): C&amp;B Manager / Finance
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3315_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3315_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3315_Task5" name="C&amp;B Manager/Payroll process retirement and long-service benefits on separation…">
        <bpmn:documentation>Step 2: C&amp;B Manager/Payroll process retirement and long-service benefits on separation (links to VS-19.5 W643 final pay), compute retirement pay per law/plan, coordinate trust-fund release with trustee, and tax-treat per BIR (links to VS-79)
Responsible (R): C&amp;B Manager / Payroll
Accountable (A): CHRO
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3315_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3315_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3315_Task6" name="C&amp;B Manager/Finance review actuarial assumptions, funding ratio, and PFRS…">
        <bpmn:documentation>Step 3: C&amp;B Manager/Finance review actuarial assumptions, funding ratio, and PFRS disclosure (links to VS-17.1/VS-17.4); report to CHRO/CFO and audit (links to VS-21.1)
Responsible (R): C&amp;B Manager / Finance
Accountable (A): CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3315_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3315_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3315_End7" name="Complete">
        <bpmn:incoming>W3315_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3315_Annotation8">
        <bpmn:text>Controls: - CTL-536 (ensure controlled execution — Benefits, Wellness Programs &amp; Statutory Administration (PA-102.2).) | - operational: actuarial review and funding plan; operational: legal review
Owner: Compensation &amp; Benefits Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3315_Assoc9" sourceRef="W3315_Annotation8" targetRef="W3315_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3315_Flow10" sourceRef="W3315_Start3" targetRef="W3315_Task4" />
      <bpmn:sequenceFlow id="W3315_Flow11" sourceRef="W3315_Task4" targetRef="W3315_Task5" />
      <bpmn:sequenceFlow id="W3315_Flow12" sourceRef="W3315_Task5" targetRef="W3315_Task6" />
      <bpmn:sequenceFlow id="W3315_Flow13" sourceRef="W3315_Task6" targetRef="W3315_End7" />
    </bpmn:process>
