      <bpmndi:BPMNPlane id="W3314_plane" bpmnElement="W_W3314">
        <bpmndi:BPMNShape id="W3314_Lane1_di" bpmnElement="W3314_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
