    <bpmn:process id="W_W3314" name="W3314. Statutory Benefits (SSS/PhilHealth/Pag-IBIG) Program Administration &amp; Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly statutory cycle; regulatory change (links to VS-22.3)
Frequency: Monthly + on change
Volume: 6,932 employees across 5 entities
Owner: Compensation &amp; Benefits Manager
Participants: C&amp;B Manager, Payroll (links to VS-19.2 W1527/W1306), Legal (links to VS-100), Government Affairs (links to VS-104)
Source: workflow W3314 — Statutory Benefits (SSS/PhilHealth/Pag-IBIG) Program Administration &amp; Compliance</bpmn:documentation>
      <bpmn:laneSet id="W3314_LaneSet3">
        <bpmn:lane id="W3314_Lane1" name="C&amp;B Manager">
        <bpmn:flowNodeRef>W3314_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3314_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3314_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3314_Lane2" name="Payroll">
        <bpmn:flowNodeRef>W3314_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3314_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3314_Start4" name="Monthly statutory cycle; regulatory change (links to VS-22.3)">
        <bpmn:outgoing>W3314_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3314_Task5" name="C&amp;B Manager maintain statutory-benefits program parameters…">
        <bpmn:documentation>Step 1: C&amp;B Manager maintain statutory-benefits program parameters (SSS/PhilHealth/Pag-IBIG contribution tables, employer/employee share, PRN generation) in line with current law; monitor regulatory change (links to VS-22.3) and government liaison (links to VS-104)
Responsible (R): C&amp;B Manager
Accountable (A): CHRO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3314_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3314_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3314_Task6" name="Payroll (links to VS-19.2) compute and remit monthly contributions per entity…">
        <bpmn:documentation>Step 2: Payroll (links to VS-19.2) compute and remit monthly contributions per entity, generate and submit government-portal files, reconcile to payroll, and handle employee inquiries (SSS loans, Pag-IBIG claims)
Responsible (R): Payroll / C&amp;B Manager
Accountable (A): CHRO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3314_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3314_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3314_Task7" name="C&amp;B Manager audit statutory compliance across 5 entities, support government…">
        <bpmn:documentation>Step 3: C&amp;B Manager audit statutory compliance across 5 entities, support government audit/inspection response (links to VS-22.2), and report compliance to CHRO/Legal
Responsible (R): C&amp;B Manager
Accountable (A): CHRO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3314_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3314_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3314_End8" name="Complete">
        <bpmn:incoming>W3314_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3314_Annotation9">
        <bpmn:text>Controls: - CTL-122 (ensure pay equity &amp; statutory benefits compliance.) | - operational: monthly discipline and reconciliation (links to VS-19); operational: change monitoring
Owner: Compensation &amp; Benefits Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3314_Assoc10" sourceRef="W3314_Annotation9" targetRef="W3314_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3314_Flow11" sourceRef="W3314_Start4" targetRef="W3314_Task5" />
      <bpmn:sequenceFlow id="W3314_Flow12" sourceRef="W3314_Task5" targetRef="W3314_Task6" />
      <bpmn:sequenceFlow id="W3314_Flow13" sourceRef="W3314_Task6" targetRef="W3314_Task7" />
      <bpmn:sequenceFlow id="W3314_Flow14" sourceRef="W3314_Task7" targetRef="W3314_End8" />
    </bpmn:process>
