      <bpmndi:BPMNPlane id="W3315_plane" bpmnElement="W_W3315">
        <bpmndi:BPMNShape id="W3315_Lane1_di" bpmnElement="W3315_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
