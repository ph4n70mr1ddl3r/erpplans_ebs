<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-102.2-benefits-wellness-programs-and-statutory-administration" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3313" name="W3313. Employee Benefits Program Design, Enrollment &amp; Annual Renewal (HMO/Medical)" isExecutable="false">
      <bpmn:documentation>Trigger: Annual renewal; program redesign; enrollment window
Frequency: Annual + on change
Volume: 6,932 employees + dependents
Owner: Compensation &amp; Benefits Manager
Participants: C&amp;B Manager, HMO providers, Broker, Payroll (links to VS-19.2), HRBP, Employees
Source: workflow W3313 — Employee Benefits Program Design, Enrollment &amp; Annual Renewal (HMO/Medical)</bpmn:documentation>
      <bpmn:laneSet id="W3313_LaneSet2">
        <bpmn:lane id="W3313_Lane1" name="C&amp;B Manager">
        <bpmn:flowNodeRef>W3313_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3313_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3313_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3313_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3313_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3313_Start3" name="Annual renewal; program redesign; enrollment window">
        <bpmn:outgoing>W3313_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3313_Task4" name="C&amp;B Manager design/maintain the HMO/medical benefits program: plan tiers…">
        <bpmn:documentation>Step 1: C&amp;B Manager design/maintain the HMO/medical benefits program: plan tiers (employee/dependent/level), coverage (inpatient/outpatient/ER), provider network, co-pay, and employee cost-share; benchmark competitiveness (W3308) and cost (W3320)
Responsible (R): C&amp;B Manager / Broker
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3313_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3313_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3313_Task5" name="C&amp;B Manager conduct annual renewal: collect utilization data (W3320), negotiate…">
        <bpmn:documentation>Step 2: C&amp;B Manager conduct annual renewal: collect utilization data (W3320), negotiate rates/terms with HMO and broker (links to VS-34.2), secure budget approval (W3327), and execute renewal; run open-enrollment for employee elections
Responsible (R): C&amp;B Manager / Broker
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3313_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3313_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3313_Task6" name="C&amp;B Manager/Payroll process enrollment changes, dependent adds/drops, and…">
        <bpmn:documentation>Step 3: C&amp;B Manager/Payroll process enrollment changes, dependent adds/drops, and premium deductions via payroll (links to VS-19.2); handle eligibility/life-event changes (W3318) and maintain the benefits master
Responsible (R): C&amp;B Manager / Payroll
Accountable (A): CHRO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3313_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3313_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3313_End7" name="Complete">
        <bpmn:incoming>W3313_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3313_Annotation8">
        <bpmn:text>Controls: - CTL-122 (ensure pay equity &amp; statutory benefits compliance.) | - operational: plan redesign, negotiation, and utilization management; operational: controls and self-service (links to VS-103)
Owner: Compensation &amp; Benefits Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3313_Assoc9" sourceRef="W3313_Annotation8" targetRef="W3313_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3313_Flow10" sourceRef="W3313_Start3" targetRef="W3313_Task4" />
      <bpmn:sequenceFlow id="W3313_Flow11" sourceRef="W3313_Task4" targetRef="W3313_Task5" />
      <bpmn:sequenceFlow id="W3313_Flow12" sourceRef="W3313_Task5" targetRef="W3313_Task6" />
      <bpmn:sequenceFlow id="W3313_Flow13" sourceRef="W3313_Task6" targetRef="W3313_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3313_diag">
      <bpmndi:BPMNPlane id="W3313_plane" bpmnElement="W_W3313">
        <bpmndi:BPMNShape id="W3313_Lane1_di" bpmnElement="W3313_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
