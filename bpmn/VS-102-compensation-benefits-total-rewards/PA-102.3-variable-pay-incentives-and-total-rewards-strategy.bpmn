      <bpmndi:BPMNPlane id="W3321_plane" bpmnElement="W_W3321">
        <bpmndi:BPMNShape id="W3321_Lane1_di" bpmnElement="W3321_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
