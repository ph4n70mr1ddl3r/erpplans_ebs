      <bpmn:sequenceFlow id="W3323_Flow12" sourceRef="W3323_Task5" targetRef="W3323_Task6" />
      <bpmn:sequenceFlow id="W3323_Flow13" sourceRef="W3323_Task6" targetRef="W3323_Task7" />
      <bpmn:sequenceFlow id="W3323_Flow14" sourceRef="W3323_Task7" targetRef="W3323_End8" />
    </bpmn:process>
