    <bpmn:process id="W_W3322" name="W3322. Sales Commission &amp; Trade-Incentive Plan Design, Calculation &amp; Payout" isExecutable="false">
      <bpmn:documentation>Trigger: Annual plan; new sales motion (trade per VS-43, project per VS-11)
Frequency: Monthly/quarterly payout
Volume: Sales/trade/account population
Owner: Compensation &amp; Benefits Manager
Participants: C&amp;B Manager, Sales/Trade leadership (links to VS-11/VS-43), Finance (links to VS-17.4), Payroll (links to VS-19.2), Sales Ops
Source: workflow W3322 — Sales Commission &amp; Trade-Incentive Plan Design, Calculation &amp; Payout</bpmn:documentation>
      <bpmn:laneSet id="W3322_LaneSet3">
        <bpmn:lane id="W3322_Lane1" name="C&amp;B Manager">
        <bpmn:flowNodeRef>W3322_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3322_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3322_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3322_Lane2" name="Sales Ops">
        <bpmn:flowNodeRef>W3322_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3322_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3322_Start4" name="Annual plan; new sales motion (trade per VS-43, project per VS-11)">
        <bpmn:outgoing>W3322_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3322_Task5" name="C&amp;B Manager/Sales leadership design the commission/trade-incentive plan: quota…">
        <bpmn:documentation>Step 1: C&amp;B Manager/Sales leadership design the commission/trade-incentive plan: quota setting, rate structures (tiered, accelerator), SPIFs, credit/attribution rules (per account/order links to VS-11.2/VS-16), clawback, and cap; align to margin not just revenue (links to VS-101 margin)
Responsible (R): C&amp;B Manager / Sales leadership
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3322_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3322_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3322_Task6" name="Sales Ops/Finance compute commissions from sales results (links to VS-16…">
        <bpmn:documentation>Step 2: Sales Ops/Finance compute commissions from sales results (links to VS-16 O2C/VS-08 POS), validate against quotas/credit rules, handle disputes, and reconcile to revenue/margin; obtain sales-leadership approval
Responsible (R): Sales Ops / Finance
Accountable (A): Sales leadership
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3322_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3322_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3322_Task7" name="Payroll (links to VS-19.2) executes commission payout with tax (links to…">
        <bpmn:documentation>Step 3: Payroll (links to VS-19.2) executes commission payout with tax (links to VS-79); C&amp;B Manager audit plan cost vs budget (W3327) and effectiveness (W3328) and adjust the plan
Responsible (R): C&amp;B Manager / Payroll
Accountable (A): CHRO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3322_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3322_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3322_End8" name="Complete">
        <bpmn:incoming>W3322_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3322_Annotation9">
        <bpmn:text>Controls: - CTL-537 (ensure controlled execution — Variable Pay, Incentives &amp; Total Rewards Strategy (PA-102.3).) | - operational: documented attribution rules; operational: margin-weighted design (links to VS-101)
Owner: Compensation &amp; Benefits Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3322_Assoc10" sourceRef="W3322_Annotation9" targetRef="W3322_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3322_Flow11" sourceRef="W3322_Start4" targetRef="W3322_Task5" />
      <bpmn:sequenceFlow id="W3322_Flow12" sourceRef="W3322_Task5" targetRef="W3322_Task6" />
      <bpmn:sequenceFlow id="W3322_Flow13" sourceRef="W3322_Task6" targetRef="W3322_Task7" />
      <bpmn:sequenceFlow id="W3322_Flow14" sourceRef="W3322_Task7" targetRef="W3322_End8" />
    </bpmn:process>
