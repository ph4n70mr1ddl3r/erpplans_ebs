    <bpmn:process id="W_W3327" name="W3327. Compensation &amp; Benefits Budget Planning, Forecasting &amp; Spend Control" isExecutable="false">
      <bpmn:documentation>Trigger: Annual budget cycle (links to VS-33.1); reforecast
Frequency: Annual + quarterly reforecast
Volume: 5-entity C&amp;B budget
Owner: Compensation &amp; Benefits Manager
Participants: C&amp;B Manager, CHRO, Finance/FP&amp;A (links to VS-17.4), CFO, Entity HR leads
Source: workflow W3327 — Compensation &amp; Benefits Budget Planning, Forecasting &amp; Spend Control</bpmn:documentation>
      <bpmn:laneSet id="W3327_LaneSet3">
        <bpmn:lane id="W3327_Lane1" name="C&amp;B Manager">
        <bpmn:flowNodeRef>W3327_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3327_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3327_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3327_Lane2" name="CHRO">
        <bpmn:flowNodeRef>W3327_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3327_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3327_Start4" name="Annual budget cycle (links to VS-33.1); reforecast">
        <bpmn:outgoing>W3327_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3327_Task5" name="C&amp;B Manager/Finance build the annual C&amp;B budget: merit increase (W3311)…">
        <bpmn:documentation>Step 1: C&amp;B Manager/Finance build the annual C&amp;B budget: merit increase (W3311), structure movement (W3307), STI/LTI funding (W3321/W3324), benefits cost (W3320), allowances/recognition (W3316/W3326); align to corporate labor budget (links to VS-33.1)
Responsible (R): C&amp;B Manager / Finance
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3327_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3327_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3327_Task6" name="CHRO/CFO review affordability vs revenue/EBITDA (links to VS-33), approve…">
        <bpmn:documentation>Step 2: CHRO/CFO review affordability vs revenue/EBITDA (links to VS-33), approve budget and envelopes per entity, and set spend-control gates for merit/hire/promotion
Responsible (R): CHRO / CFO
Accountable (A): CEO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3327_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3327_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3327_Task7" name="C&amp;B Manager/Finance monitor actual C&amp;B spend vs budget monthly, reforecast…">
        <bpmn:documentation>Step 3: C&amp;B Manager/Finance monitor actual C&amp;B spend vs budget monthly, reforecast quarterly, manage exceptions (W3311 outliers, W3321 funding), and report to CHRO/CFO
Responsible (R): C&amp;B Manager / Finance
Accountable (A): CHRO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3327_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3327_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3327_End8" name="Complete">
        <bpmn:incoming>W3327_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3327_Annotation9">
        <bpmn:text>Controls: - CTL-122 (ensure pay equity &amp; statutory benefits compliance.) | - operational: gates and monthly monitoring; operational: scenario planning (W3328)
Owner: Compensation &amp; Benefits Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3327_Assoc10" sourceRef="W3327_Annotation9" targetRef="W3327_Start4" associationDirection="None" />
