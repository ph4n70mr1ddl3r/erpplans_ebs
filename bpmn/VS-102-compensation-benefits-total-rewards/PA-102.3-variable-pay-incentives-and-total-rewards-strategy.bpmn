    <bpmn:process id="W_W3324" name="W3324. Long-Term Incentive (LTI), Retention &amp; Recognition Program Design" isExecutable="false">
      <bpmn:documentation>Trigger: Executive/retention need; annual LTI cycle
Frequency: Annual
Volume: Executive/key-talent population
Owner: CHRO
Participants: CHRO, C&amp;B Manager, Legal (links to VS-100), Finance (links to VS-17.4), Compensation Committee (links to VS-36)
Source: workflow W3324 — Long-Term Incentive (LTI), Retention &amp; Recognition Program Design</bpmn:documentation>
      <bpmn:laneSet id="W3324_LaneSet4">
        <bpmn:lane id="W3324_Lane1" name="CHRO">
        <bpmn:flowNodeRef>W3324_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3324_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3324_Lane2" name="Legal">
        <bpmn:flowNodeRef>W3324_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3324_Lane3" name="C&amp;B Manager">
        <bpmn:flowNodeRef>W3324_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3324_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3324_Start5" name="Executive/retention need; annual LTI cycle">
        <bpmn:outgoing>W3324_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3324_Task6" name="CHRO/C&amp;B Manager design LTI and retention programs for executives/key talent…">
        <bpmn:documentation>Step 1: CHRO/C&amp;B Manager design LTI and retention programs for executives/key talent (phantom equity, performance shares, retention bonus, cliff vesting) benchmarked to market (W3308); align to long-term corporate strategy (links to VS-33)
Responsible (R): CHRO / C&amp;B Manager
Accountable (A): Compensation Committee
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3324_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3324_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3324_Task7" name="Legal/Finance structure awards (PFRS expense recognition links to VS-17.1…">
        <bpmn:documentation>Step 2: Legal/Finance structure awards (PFRS expense recognition links to VS-17.1, vesting conditions, performance conditions, documentation, tax links to VS-79); obtain committee/board approval (links to VS-36)
Responsible (R): Legal / Finance
Accountable (A): Compensation Committee
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3324_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3324_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3324_Task8" name="C&amp;B Manager administer vesting, performance certification, forfeiture, and…">
        <bpmn:documentation>Step 3: C&amp;B Manager administer vesting, performance certification, forfeiture, and payout via payroll (links to VS-19.2); track LTI liability and report to committee and audit (links to VS-21.1)
Responsible (R): C&amp;B Manager
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3324_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3324_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3324_End9" name="Complete">
        <bpmn:incoming>W3324_Flow15</bpmn:incoming>
      </bpmn:endEvent>
