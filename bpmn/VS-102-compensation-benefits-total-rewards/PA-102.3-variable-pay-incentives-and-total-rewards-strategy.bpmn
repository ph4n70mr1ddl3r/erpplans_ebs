    <bpmn:process id="W_W3321" name="W3321. Short-Term Incentive (STI) / Bonus Plan Design &amp; Administration" isExecutable="false">
      <bpmn:documentation>Trigger: Annual STI cycle; plan redesign
Frequency: Annual
Volume: ~HQ/management population (5 entities)
Owner: Compensation &amp; Benefits Manager
Participants: C&amp;B Manager, CHRO, Finance (links to VS-17.4), Payroll (links to VS-19.2), Managers, Compensation Committee (links to VS-36)
Source: workflow W3321 — Short-Term Incentive (STI) / Bonus Plan Design &amp; Administration</bpmn:documentation>
      <bpmn:laneSet id="W3321_LaneSet3">
        <bpmn:lane id="W3321_Lane1" name="C&amp;B Manager">
        <bpmn:flowNodeRef>W3321_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3321_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3321_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3321_Lane2" name="Finance">
        <bpmn:flowNodeRef>W3321_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3321_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3321_Start4" name="Annual STI cycle; plan redesign">
        <bpmn:outgoing>W3321_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3321_Task5" name="C&amp;B Manager/CHRO design the STI/bonus plan: eligibility, performance measures…">
        <bpmn:documentation>Step 1: C&amp;B Manager/CHRO design the STI/bonus plan: eligibility, performance measures (corporate, business-unit, individual links to VS-19.4 performance), weighting, targets/funding formula, cap, and payout curve; align to corporate performance (links to VS-33.2)
Responsible (R): C&amp;B Manager / CHRO
Accountable (A): Compensation Committee
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3321_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3321_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3321_Task6" name="Finance/C&amp;B Manager compute plan funding against actual performance (links to…">
        <bpmn:documentation>Step 2: Finance/C&amp;B Manager compute plan funding against actual performance (links to VS-33.2 CPM), validate affordability vs budget (W3327), and obtain committee/CEO approval (links to VS-36); model payout scenarios
Responsible (R): Finance / C&amp;B Manager
Accountable (A): CEO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3321_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3321_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3321_Task7" name="Managers assign individual performance ratings (links to VS-19.4); C&amp;B Manager…">
        <bpmn:documentation>Step 3: Managers assign individual performance ratings (links to VS-19.4); C&amp;B Manager calculate payouts, Payroll (links to VS-19.2) executes with tax (links to VS-79), communicate to employees, and audit for governance (links to VS-21.1)
Responsible (R): C&amp;B Manager / Payroll
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3321_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3321_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3321_End8" name="Complete">
        <bpmn:incoming>W3321_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3321_Annotation9">
        <bpmn:text>Controls: - CTL-537 (ensure controlled execution — Variable Pay, Incentives &amp; Total Rewards Strategy (PA-102.3).) | - operational: funding formula and approval; operational: clear measures and calibration
Owner: Compensation &amp; Benefits Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3321_Assoc10" sourceRef="W3321_Annotation9" targetRef="W3321_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3321_Flow11" sourceRef="W3321_Start4" targetRef="W3321_Task5" />
      <bpmn:sequenceFlow id="W3321_Flow12" sourceRef="W3321_Task5" targetRef="W3321_Task6" />
      <bpmn:sequenceFlow id="W3321_Flow13" sourceRef="W3321_Task6" targetRef="W3321_Task7" />
      <bpmn:sequenceFlow id="W3321_Flow14" sourceRef="W3321_Task7" targetRef="W3321_End8" />
    </bpmn:process>
