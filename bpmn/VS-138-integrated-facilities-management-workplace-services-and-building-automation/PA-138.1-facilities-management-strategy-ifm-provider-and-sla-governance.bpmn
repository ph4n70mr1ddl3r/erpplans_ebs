    <bpmn:process id="W_W4170" name="W4170. IFM Provider Strategy, Sourcing &amp; Contract Management" isExecutable="false">
      <bpmn:documentation>Trigger: Contract renewal; new service line; new-store cluster
Frequency: Per contract + annual review
Volume: ~10–30 facilities-service contracts (national/regional providers)
Owner: Procurement (VS-34) / Head of Facilities
Participants: Legal (VS-100.3), Finance (VS-15/VS-17.4), Store Ops (VS-07), Risk (VS-21.2)
Source: workflow W4170 — IFM Provider Strategy, Sourcing &amp; Contract Management</bpmn:documentation>
      <bpmn:laneSet id="W4170_LaneSet3">
        <bpmn:lane id="W4170_Lane1" name="Procurement">
        <bpmn:flowNodeRef>W4170_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4170_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4170_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4170_Lane2" name="Facilities">
        <bpmn:flowNodeRef>W4170_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4170_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4170_Start4" name="Contract renewal; new service line; new-store cluster">
        <bpmn:outgoing>W4170_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4170_Task5" name="Facilities/Procurement run RFP/sourcing for IFM service lines (cleaning, pest…">
        <bpmn:documentation>Step 1: Facilities/Procurement run RFP/sourcing for IFM service lines (cleaning, pest, guarding, HVAC, grounds, cafeteria), evaluating capability, coverage, price, safety/ESG, and references
Responsible (R): Procurement / Facilities
Accountable (A): Head of Facilities
Duration: Per RFP</bpmn:documentation>
        <bpmn:incoming>W4170_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4170_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4170_Task6" name="Facilities/Procurement/Legal structure contracts (SLA, scope, pricing…">
        <bpmn:documentation>Step 2: Facilities/Procurement/Legal structure contracts (SLA, scope, pricing, performance penalties, termination, insurance, ABC compliance links to VS-86.3), and onboard the provider (links to VS-98 contingent workforce)
Responsible (R): Procurement / Legal / Facilities
Accountable (A): Head of Facilities
Duration: Per contract</bpmn:documentation>
        <bpmn:incoming>W4170_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4170_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4170_Task7" name="Facilities manage the contract lifecycle (renewal, scope change, performance)…">
        <bpmn:documentation>Step 3: Facilities manage the contract lifecycle (renewal, scope change, performance), and consolidate providers for leverage where sensible
Responsible (R): Facilities / Procurement
Accountable (A): Head of Facilities
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4170_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4170_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4170_End8" name="Complete">
        <bpmn:incoming>W4170_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4170_Annotation9">
        <bpmn:text>Controls: - CTL-644 (ensure controlled execution — Facilities Management Strategy, IFM Provider &amp; SLA Governance (PA-138.1).) | - CTL-644: facilities contracts with SLA/penalty/exit clauses; ABC due diligence (VS-86.3); insurance verified
Owner: Procurement (VS-34) / Head of Facilities</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4170_Assoc10" sourceRef="W4170_Annotation9" targetRef="W4170_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4170_Flow11" sourceRef="W4170_Start4" targetRef="W4170_Task5" />
      <bpmn:sequenceFlow id="W4170_Flow12" sourceRef="W4170_Task5" targetRef="W4170_Task6" />
      <bpmn:sequenceFlow id="W4170_Flow13" sourceRef="W4170_Task6" targetRef="W4170_Task7" />
      <bpmn:sequenceFlow id="W4170_Flow14" sourceRef="W4170_Task7" targetRef="W4170_End8" />
    </bpmn:process>
