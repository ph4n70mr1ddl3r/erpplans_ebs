      <bpmn:sequenceFlow id="W4179_Flow12" sourceRef="W4179_Task5" targetRef="W4179_Task6" />
      <bpmn:sequenceFlow id="W4179_Flow13" sourceRef="W4179_Task6" targetRef="W4179_Task7" />
      <bpmn:sequenceFlow id="W4179_Flow14" sourceRef="W4179_Task7" targetRef="W4179_End8" />
    </bpmn:process>
