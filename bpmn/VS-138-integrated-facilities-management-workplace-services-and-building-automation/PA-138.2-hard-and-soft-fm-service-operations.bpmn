    <bpmn:process id="W_W4178" name="W4178. Pest Control, Vector &amp; Rodent Management" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled cycle; sighting report; audit/inspection
Frequency: Monthly/bimonthly preventive + reactive
Volume: ~205 sites (tropical pest pressure: rodents, termites, cockroaches, mosquitoes)
Owner: Facilities Soft-Services Lead / Licensed Pest-Control Provider
Participants: Site staff (VS-07/VS-04), Provider, HSE (VS-24.3), Food/cafeteria (W4182)
Source: workflow W4178 — Pest Control, Vector &amp; Rodent Management</bpmn:documentation>
      <bpmn:laneSet id="W4178_LaneSet3">
        <bpmn:lane id="W4178_Lane1" name="Provider">
        <bpmn:flowNodeRef>W4178_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4178_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4178_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4178_Lane2" name="Site Staff">
        <bpmn:flowNodeRef>W4178_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4178_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4178_Start4" name="Scheduled cycle; sighting report; audit/inspection">
        <bpmn:outgoing>W4178_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4178_Task5" name="Facilities/Provider run the preventive pest-control cycle (inspection…">
        <bpmn:documentation>Step 1: Facilities/Provider run the preventive pest-control cycle (inspection, baiting/trapping, treatment) by a licensed provider (FPA-licensed pesticide applicator), per site standard
Responsible (R): Provider / Facilities Soft-Services Lead
Accountable (A): Facilities Soft-Services Lead
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W4178_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4178_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4178_Task6" name="Site staff report sightings (rodent, termite, insect) via helpdesk (W4174)…">
        <bpmn:documentation>Step 2: Site staff report sightings (rodent, termite, insect) via helpdesk (W4174); provider responds reactively, escalating structural risk (termites links to W4172 condition)
Responsible (R): Site Staff / Provider
Accountable (A): Facilities Soft-Services Lead
Duration: Reactive</bpmn:documentation>
        <bpmn:incoming>W4178_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4178_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4178_Task7" name="Facilities/Provider manage pesticide chemical safety (SDS, application records…">
        <bpmn:documentation>Step 3: Facilities/Provider manage pesticide chemical safety (SDS, application records, re-entry intervals links to VS-24.3/VS-114), document for audit, and monitor infestation trends (W4192 analytics)
Responsible (R): Provider / Facilities Soft-Services Lead / HSE
Accountable (A): Facilities Soft-Services Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4178_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4178_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4178_End8" name="Complete">
        <bpmn:incoming>W4178_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4178_Annotation9">
        <bpmn:text>Controls: - CTL-139 (ensure facilities compliance &amp; vendor performance.) | - CTL-645: FPA-licensed applicator; pesticide SDS/application records (VS-24.3/VS-114); audit-ready
Owner: Facilities Soft-Services Lead / Licensed Pest-Control Provider</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4178_Assoc10" sourceRef="W4178_Annotation9" targetRef="W4178_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4178_Flow11" sourceRef="W4178_Start4" targetRef="W4178_Task5" />
      <bpmn:sequenceFlow id="W4178_Flow12" sourceRef="W4178_Task5" targetRef="W4178_Task6" />
      <bpmn:sequenceFlow id="W4178_Flow13" sourceRef="W4178_Task6" targetRef="W4178_Task7" />
      <bpmn:sequenceFlow id="W4178_Flow14" sourceRef="W4178_Task7" targetRef="W4178_End8" />
    </bpmn:process>
