    <bpmn:process id="W_W4177" name="W4177. Janitorial, Cleaning &amp; Hygiene Service Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Daily/periodic schedule; special clean (post-typhoon, spill, event)
Frequency: Daily (stores/DC/HQ) + periodic deep clean
Volume: ~205 sites × daily cleaning (selling floor, restrooms, backroom, yards, HQ offices)
Owner: Facilities Soft-Services Lead / Cleaning Provider
Participants: Site staff (VS-07/VS-04), Provider workforce (VS-98), HSE (VS-24), Store Ops
Source: workflow W4177 — Janitorial, Cleaning &amp; Hygiene Service Operations</bpmn:documentation>
      <bpmn:laneSet id="W4177_LaneSet3">
        <bpmn:lane id="W4177_Lane1" name="Provider">
        <bpmn:flowNodeRef>W4177_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4177_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4177_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4177_Lane2" name="Facilities Soft-Services Lead">
        <bpmn:flowNodeRef>W4177_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4177_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4177_Start4" name="Daily/periodic schedule; special clean (post-typhoon, spill, event)">
        <bpmn:outgoing>W4177_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4177_Task5" name="Facilities/Provider execute the daily cleaning schedule per site-type standard…">
        <bpmn:documentation>Step 1: Facilities/Provider execute the daily cleaning schedule per site-type standard (floor, restrooms, glass, backroom, yard) with checklists and photo evidence, resourced by the provider workforce (VS-98)
Responsible (R): Provider / Facilities Soft-Services Lead
Accountable (A): Facilities Soft-Services Lead
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W4177_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4177_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4177_Task6" name="Facilities schedule periodic deep cleans (floor stripping/waxing, high-level…">
        <bpmn:documentation>Step 2: Facilities schedule periodic deep cleans (floor stripping/waxing, high-level dusting, facade) and special cleans (post-typhoon VS-69, spill/biohazard, post-event), coordinating with site operations
Responsible (R): Facilities Soft-Services Lead / Provider
Accountable (A): Facilities Soft-Services Lead
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W4177_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4177_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4177_Task7" name="Facilities/Provider stock cleaning consumables, manage hygiene supplies…">
        <bpmn:documentation>Step 3: Facilities/Provider stock cleaning consumables, manage hygiene supplies (restroom, sanitizing stations), verify quality with the site, and report cleaning SLA (W4171/W4176)
Responsible (R): Provider / Facilities Soft-Services Lead
Accountable (A): Facilities Soft-Services Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4177_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4177_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4177_End8" name="Complete">
        <bpmn:incoming>W4177_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4177_Annotation9">
        <bpmn:text>Controls: - CTL-645 (ensure controlled execution — Hard &amp; Soft FM Service Operations (Cleaning, Pest, Security, Grounds, Workplace) (PA-138.2).) | - CTL-645 (cleaning checklist with verification; cleaning-chemical SDS/PPE (VS-24.3/VS-114))
Owner: Facilities Soft-Services Lead / Cleaning Provider</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4177_Assoc10" sourceRef="W4177_Annotation9" targetRef="W4177_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4177_Flow11" sourceRef="W4177_Start4" targetRef="W4177_Task5" />
      <bpmn:sequenceFlow id="W4177_Flow12" sourceRef="W4177_Task5" targetRef="W4177_Task6" />
      <bpmn:sequenceFlow id="W4177_Flow13" sourceRef="W4177_Task6" targetRef="W4177_Task7" />
      <bpmn:sequenceFlow id="W4177_Flow14" sourceRef="W4177_Task7" targetRef="W4177_End8" />
    </bpmn:process>
