    <bpmn:process id="W_W5114" name="W5114. Store-Visit Execution, Retail-Standards Audit &amp; Compliance Scoring" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled visit (W5113); targeted follow-up; incident
Frequency: Per the cadence
Volume: ~2,400–4,800 visits/yr chain-wide (200 stores × 12–24 tier-based visits/store/yr) across ~19 field managers (~6 RMs + ~13 DMs)
Owner: Regional/District Manager
Participants: Store Manager (VS-07), Department Supervisors, LP (VS-23), CX (VS-13), Facilities (VS-138), Field Compliance Auditor
Source: workflow W5114 — Store-Visit Execution, Retail-Standards Audit &amp; Compliance Scoring</bpmn:documentation>
      <bpmn:laneSet id="W5114_LaneSet2">
        <bpmn:lane id="W5114_Lane1" name="Regional">
        <bpmn:flowNodeRef>W5114_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5114_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5114_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5114_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5114_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5114_Start3" name="Scheduled visit (W5113); targeted follow-up; incident">
        <bpmn:outgoing>W5114_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5114_Task4" name="Execute the store walk &amp; standards audit: opening/closing, salesfloor, lumber…">
        <bpmn:documentation>Step 1: Execute the store walk &amp; standards audit: opening/closing, salesfloor, lumber yard, receiving/backroom, customer service, restrooms, safety/HSE (links VS-24), and the structured retail-standards checklist scoring
Responsible (R): Regional/District Manager / Store Manager
Accountable (A): Regional/District Manager
Duration: Per visit (3–5 hrs)</bpmn:documentation>
        <bpmn:incoming>W5114_Flow10</bpmn:incoming>
        <bpmn:outgoing>W5114_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5114_Task5" name="Review operating performance with the Store Manager: P&amp;L (W5109), CX, shrink…">
        <bpmn:documentation>Step 2: Review operating performance with the Store Manager: P&amp;L (W5109), CX, shrink, staff, prior action-items (W5118), and the coaching conversation (W5115)
Responsible (R): Regional/District Manager / Store Manager
Accountable (A): Regional/District Manager
Duration: Per visit</bpmn:documentation>
        <bpmn:incoming>W5114_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5114_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5114_Task6" name="Document &amp; log the visit: the standards score, findings, action-items assigned…">
        <bpmn:documentation>Step 3: Document &amp; log the visit: the standards score, findings, action-items assigned (W5118), and the system entry for analytics (W5120)
Responsible (R): Regional/District Manager
Accountable (A): Regional/District Manager
Duration: Per visit</bpmn:documentation>
        <bpmn:incoming>W5114_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5114_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5114_End7" name="Complete">
        <bpmn:incoming>W5114_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5114_Annotation8">
        <bpmn:text>Controls: - CTL-102 (ensure field retail-standards execution.) | - CTL-762: structured checklist used; audit competency certified (W5108); independent assurance cross-check (VS-146)
Owner: Regional/District Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5114_Assoc9" sourceRef="W5114_Annotation8" targetRef="W5114_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W5114_Flow10" sourceRef="W5114_Start3" targetRef="W5114_Task4" />
      <bpmn:sequenceFlow id="W5114_Flow11" sourceRef="W5114_Task4" targetRef="W5114_Task5" />
      <bpmn:sequenceFlow id="W5114_Flow12" sourceRef="W5114_Task5" targetRef="W5114_Task6" />
      <bpmn:sequenceFlow id="W5114_Flow13" sourceRef="W5114_Task6" targetRef="W5114_End7" />
    </bpmn:process>
