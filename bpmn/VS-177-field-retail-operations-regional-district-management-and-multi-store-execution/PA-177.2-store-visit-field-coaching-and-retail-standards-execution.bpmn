      <bpmn:sequenceFlow id="W5115_Flow12" sourceRef="W5115_Task5" targetRef="W5115_Task6" />
      <bpmn:sequenceFlow id="W5115_Flow13" sourceRef="W5115_Task6" targetRef="W5115_End7" />
    </bpmn:process>
