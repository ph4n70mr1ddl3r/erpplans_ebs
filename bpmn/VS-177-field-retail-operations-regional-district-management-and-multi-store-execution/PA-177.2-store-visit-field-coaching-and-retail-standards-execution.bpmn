        <bpmndi:BPMNEdge id="W5114_Flow13_di" bpmnElement="W5114_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5114_Assoc9_di" bpmnElement="W5114_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5115" name="W5115. Store-Manager Coaching, Development &amp; Performance Conversations" isExecutable="false">
      <bpmn:documentation>Trigger: Store visit (W5114); performance cycle; development plan
Frequency: Per visit + formal cycles
Volume: ~15 store managers per District Manager; ~33 per Regional Manager (profile §12.1)
Owner: Regional/District Manager
Participants: Store Managers (VS-07), HR/HRBP (VS-103), L&amp;D (VS-19.4), Director Field Retail Operations
Source: workflow W5115 — Store-Manager Coaching, Development &amp; Performance Conversations</bpmn:documentation>
      <bpmn:laneSet id="W5115_LaneSet2">
        <bpmn:lane id="W5115_Lane1" name="Regional">
        <bpmn:flowNodeRef>W5115_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5115_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5115_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5115_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5115_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5115_Start3" name="Store visit (W5114); performance cycle; development plan">
        <bpmn:outgoing>W5115_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5115_Task4" name="Prepare the coaching: review the Store Manager&#x27;s performance (W5109)…">
        <bpmn:documentation>Step 1: Prepare the coaching: review the Store Manager&#x27;s performance (W5109), strengths/gaps, the development plan, and prior coaching follow-ups
Responsible (R): Regional/District Manager / HRBP
Accountable (A): Regional/District Manager
Duration: Per visit</bpmn:documentation>
        <bpmn:incoming>W5115_Flow10</bpmn:incoming>
        <bpmn:outgoing>W5115_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5115_Task5" name="Conduct the coaching conversation: structured feedback…">
        <bpmn:documentation>Step 2: Conduct the coaching conversation: structured feedback (situation-behavior-impact), goal-setting, the development action, and the performance-conduct conversation where needed (links VS-84/VS-19.1)
Responsible (R): Regional/District Manager / Store Manager
Accountable (A): Regional/District Manager
Duration: Per visit</bpmn:documentation>
        <bpmn:incoming>W5115_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5115_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5115_Task6" name="Document &amp; follow-up: log the coaching, the agreed actions (W5118), the…">
        <bpmn:documentation>Step 3: Document &amp; follow-up: log the coaching, the agreed actions (W5118), the development plan update, and escalate performance cases to HR where formal action is needed
Responsible (R): Regional/District Manager / HRBP
Accountable (A): Regional/District Manager
Duration: Per visit</bpmn:documentation>
        <bpmn:incoming>W5115_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5115_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5115_End7" name="Complete">
        <bpmn:incoming>W5115_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5115_Annotation8">
        <bpmn:text>Controls: - CTL-762 (ensure controlled execution — Store Visit, Field Coaching &amp; Retail Standards Execution (PA-177.2).) | - CTL-762: structured coaching method used; coaching documented; formal-action cases HRBP-supported (VS-103/VS-84)
Owner: Regional/District Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5115_Assoc9" sourceRef="W5115_Annotation8" targetRef="W5115_Start3" associationDirection="None" />
