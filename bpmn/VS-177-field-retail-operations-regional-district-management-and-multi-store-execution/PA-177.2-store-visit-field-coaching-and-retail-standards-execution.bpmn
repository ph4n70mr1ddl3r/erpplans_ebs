      <bpmn:sequenceFlow id="W5113_Flow12" sourceRef="W5113_Task5" targetRef="W5113_Task6" />
      <bpmn:sequenceFlow id="W5113_Flow13" sourceRef="W5113_Task6" targetRef="W5113_End7" />
    </bpmn:process>
