        <bpmndi:BPMNShape id="W5115_Annotation8_di" bpmnElement="W5115_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W5115_Flow10_di" bpmnElement="W5115_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5115_Flow11_di" bpmnElement="W5115_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5115_Flow12_di" bpmnElement="W5115_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5115_Flow13_di" bpmnElement="W5115_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5115_Assoc9_di" bpmnElement="W5115_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5116" name="W5116. Retail-Execution Field Audit (Planogram/Price/Signage/Merchandising Standards)" isExecutable="false">
      <bpmn:documentation>Trigger: Visit (W5114); new-planogram rollout (VS-55); promotion/reset; complaint
Frequency: Per visit + campaign-based
Volume: ~per-visit audit across the standards domains
Owner: Regional/District Manager / Operations-Standards Specialist
Participants: Store Ops (VS-07), Merchandising (VS-01/VS-55), Pricing (VS-01.2/VS-118), LP (VS-23), Planogram (VS-55), Labeling (VS-151)
Source: workflow W5116 — Retail-Execution Field Audit (Planogram/Price/Signage/Merchandising Standards)</bpmn:documentation>
      <bpmn:laneSet id="W5116_LaneSet2">
        <bpmn:lane id="W5116_Lane1" name="Regional">
        <bpmn:flowNodeRef>W5116_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5116_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5116_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5116_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5116_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5116_Start3" name="Visit (W5114); new-planogram rollout (VS-55); promotion/reset; complaint">
        <bpmn:outgoing>W5116_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5116_Task4" name="Audit the retail-execution standards: planogram compliance (VS-55)…">
        <bpmn:documentation>Step 1: Audit the retail-execution standards: planogram compliance (VS-55), price/shelf-label accuracy &amp; price-tag presence (VS-151/RA 7394), promotional-signage compliance (VS-14), merchandising standards, and end-cap/display execution
Responsible (R): Regional/District Manager / Ops-Standards
Accountable (A): Regional/District Manager
Duration: Per visit</bpmn:documentation>
        <bpmn:incoming>W5116_Flow10</bpmn:incoming>
        <bpmn:outgoing>W5116_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5116_Task5" name="Reconcile to source-of-truth: spot-check shelf price vs POS/price-file (VS-118…">
        <bpmn:documentation>Step 2: Reconcile to source-of-truth: spot-check shelf price vs POS/price-file (VS-118 revenue assurance), planogram vs space plan (VS-55), and signage vs promo calendar (VS-14)
Responsible (R): Regional/District Manager / Pricing / Merch
Accountable (A): Regional/District Manager
Duration: Per visit</bpmn:documentation>
        <bpmn:incoming>W5116_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5116_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5116_Task6" name="Log discrepancies &amp; assign action: price-tag reprint (VS-151), planogram reset…">
