      <bpmn:sequenceFlow id="W4459_Flow12" sourceRef="W4459_Task5" targetRef="W4459_Task6" />
      <bpmn:sequenceFlow id="W4459_Flow13" sourceRef="W4459_Task6" targetRef="W4459_End7" />
    </bpmn:process>
