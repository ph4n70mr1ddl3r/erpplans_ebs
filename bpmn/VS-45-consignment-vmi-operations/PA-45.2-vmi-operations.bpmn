    <bpmn:process id="W_W1940" name="W1940. VMI Promotional Stock Planning &amp; Allocation" isExecutable="false">
      <bpmn:documentation>Trigger: Promotional calendar event involving VMI SKUs
Frequency: ~6 major promos/year; ~2–3 VMI SKUs per promo
Volume: ~12–18 VMI promo events/year
Owner: Category Manager
Participants: Category Manager, VP Supply Chain, Pricing Analyst, Vendor
Source: workflow W1940 — VMI Promotional Stock Planning &amp; Allocation</bpmn:documentation>
      <bpmn:laneSet id="W1940_LaneSet4">
        <bpmn:lane id="W1940_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W1940_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1940_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1940_Lane2" name="Vendor">
        <bpmn:flowNodeRef>W1940_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1940_Lane3" name="VP Supply Chain">
        <bpmn:flowNodeRef>W1940_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1940_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1940_Start5" name="Promotional calendar event involving VMI SKUs">
        <bpmn:outgoing>W1940_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1940_Task6" name="Category Manager plans VMI promotional stock: (a) identify VMI SKUs in upcoming…">
        <bpmn:documentation>Step 1: Category Manager plans VMI promotional stock: (a) identify VMI SKUs in upcoming promo per W13, (b) estimate incremental demand: historical promo lift × base demand, (c) communicate to vendor: (i) promo dates, (ii) expected volume increase, (iii) required pre-positioning: extra stock in DCs 2 weeks before promo, (d) negotiate vendor contribution to promotional cost per PUR-026
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1–2 days/promo</bpmn:documentation>
        <bpmn:incoming>W1940_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1940_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1940_Task7" name="Vendor adjusts VMI replenishment: (a) vendor pre-ships promotional stock to…">
        <bpmn:documentation>Step 2: Vendor adjusts VMI replenishment: (a) vendor pre-ships promotional stock to DCs, (b) VMI system temporarily overrides max stock level for promo period, (c) additional PO created for promo stock (separate from auto-replenishment), (d) promo stock received and staged for rapid deployment to stores
Responsible (R): Vendor / VP Supply Chain
Accountable (A): Category Manager
Duration: Pre-promo</bpmn:documentation>
        <bpmn:incoming>W1940_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1940_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1940_Task8" name="Post-promo: (a) VP Supply Chain reconciles promo VMI stock: (i) promo qty sold…">
        <bpmn:documentation>Step 3: Post-promo: (a) VP Supply Chain reconciles promo VMI stock: (i) promo qty sold vs. promo qty received, (ii) unsold promo stock: return to vendor or sell at regular price, (b) Category Manager reviews promo performance per VMI vendor, (c) VMI parameters reset to standard levels
Responsible (R): VP Supply Chain / Category Manager
Accountable (A): VP Merchandising
Duration: 2–3 days/post-promo</bpmn:documentation>
        <bpmn:incoming>W1940_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1940_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1940_End9" name="Complete">
        <bpmn:incoming>W1940_Flow15</bpmn:incoming>
      </bpmn:endEvent>
