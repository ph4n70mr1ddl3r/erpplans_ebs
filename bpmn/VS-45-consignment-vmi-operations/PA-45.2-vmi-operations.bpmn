<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-45.2-vmi-operations" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1934" name="W1934. VMI Agreement Setup &amp; Parameter Configuration" isExecutable="false">
      <bpmn:documentation>Trigger: New VMI vendor onboarding; annual VMI agreement renewal
Frequency: ~2–3 new VMI vendors/year; 12 vendors reviewed annually
Volume: ~300 VMI SKUs across 12 key vendors
Owner: VP Supply Chain
Participants: VP Supply Chain, Category Manager, VP Merchandising, Vendor
Source: workflow W1934 — VMI Agreement Setup &amp; Parameter Configuration</bpmn:documentation>
      <bpmn:laneSet id="W1934_LaneSet3">
        <bpmn:lane id="W1934_Lane1" name="VP Supply Chain">
        <bpmn:flowNodeRef>W1934_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1934_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1934_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1934_Lane2" name="System">
        <bpmn:flowNodeRef>W1934_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1934_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1934_Start4" name="New VMI vendor onboarding; annual VMI agreement renewal">
        <bpmn:outgoing>W1934_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1934_Task5" name="VP Supply Chain negotiates VMI agreement with vendor: (a) scope: which SKUs are…">
        <bpmn:documentation>Step 1: VP Supply Chain negotiates VMI agreement with vendor: (a) scope: which SKUs are VMI-managed, which locations (DCs, stores, or both), (b) inventory parameters: minimum stock level, maximum stock level, reorder point, reorder quantity per SKU per location, (c) data sharing: BuildRight provides daily stock levels, sales data, forecast; vendor manages replenishment decisions, (d) service level: target fill rate ≥ 97%, lead time commitment, (e) ownership: VMI stock is BuildRight-owned (unlike consignment), vendor manages replenishment but BuildRight owns inventory upon receipt, (f) settlement: standard PO-based, 3-way match per W7
Responsible (R): VP Supply Chain / Category Manager
Accountable (A): VP Merchandising
Duration: Per negotiation</bpmn:documentation>
        <bpmn:incoming>W1934_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1934_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1934_Task6" name="System configuration: (a) VMI flag set on applicable SKUs in item master, (b)…">
        <bpmn:documentation>Step 2: System configuration: (a) VMI flag set on applicable SKUs in item master, (b) VMI parameters per SKU per location: min/max/ROP/ROQ, (c) data sharing schedule: daily automated stock/sales feed to vendor, (d) auto-replenishment: vendor-generated replenishment suggestions auto-create PO upon BuildRight approval or auto-approve per threshold, (e) auto-confirmation: GR auto-confirmed against VMI ASN within tolerance
Responsible (R): System / IT
Accountable (A): VP Supply Chain
Duration: 2–4 hours/vendor</bpmn:documentation>
        <bpmn:incoming>W1934_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1934_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1934_Task7" name="Test cycle: (a) run 4-week VMI pilot with vendor for 1 DC, (b) measure: fill…">
        <bpmn:documentation>Step 3: Test cycle: (a) run 4-week VMI pilot with vendor for 1 DC, (b) measure: fill rate, stockout frequency, overstock instances, GR accuracy, (c) adjust parameters based on pilot results, (d) roll out to all applicable locations
Responsible (R): VP Supply Chain
Accountable (A): VP Merchandising
Duration: 4 weeks</bpmn:documentation>
        <bpmn:incoming>W1934_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1934_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1934_End8" name="Complete">
        <bpmn:incoming>W1934_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1934_Annotation9">
        <bpmn:text>Controls: - CTL-377 (ensure controlled execution — Vendor-Managed Inventory (VMI) Operations (PA-45.2).) | - operational: VP Supply Chain review and approval gate
Owner: VP Supply Chain</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1934_Assoc10" sourceRef="W1934_Annotation9" targetRef="W1934_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1934_Flow11" sourceRef="W1934_Start4" targetRef="W1934_Task5" />
      <bpmn:sequenceFlow id="W1934_Flow12" sourceRef="W1934_Task5" targetRef="W1934_Task6" />
      <bpmn:sequenceFlow id="W1934_Flow13" sourceRef="W1934_Task6" targetRef="W1934_Task7" />
      <bpmn:sequenceFlow id="W1934_Flow14" sourceRef="W1934_Task7" targetRef="W1934_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1934_diag">
      <bpmndi:BPMNPlane id="W1934_plane" bpmnElement="W_W1934">
        <bpmndi:BPMNShape id="W1934_Lane1_di" bpmnElement="W1934_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1934_Lane2_di" bpmnElement="W1934_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1934_Task5_di" bpmnElement="W1934_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1934_Task6_di" bpmnElement="W1934_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1934_Task7_di" bpmnElement="W1934_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1934_Start4_di" bpmnElement="W1934_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1934_End8_di" bpmnElement="W1934_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1934_Annotation9_di" bpmnElement="W1934_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1934_Flow11_di" bpmnElement="W1934_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1934_Flow12_di" bpmnElement="W1934_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1934_Flow13_di" bpmnElement="W1934_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1934_Flow14_di" bpmnElement="W1934_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1934_Assoc10_di" bpmnElement="W1934_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1935" name="W1935. VMI Data Sharing &amp; Demand Signal Transmission" isExecutable="false">
      <bpmn:documentation>Trigger: Daily automated schedule
Frequency: Daily
Volume: ~300 VMI SKUs × ~204 locations (4 DCs + 200 stores) = ~61,200 data points/day
Owner: System
Participants: System, VP Supply Chain, Vendor
Source: workflow W1935 — VMI Data Sharing &amp; Demand Signal Transmission</bpmn:documentation>
      <bpmn:laneSet id="W1935_LaneSet3">
        <bpmn:lane id="W1935_Lane1" name="System">
        <bpmn:flowNodeRef>W1935_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1935_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1935_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1935_Lane2" name="VP Supply Chain">
        <bpmn:flowNodeRef>W1935_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1935_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1935_Start4" name="Daily automated schedule">
        <bpmn:outgoing>W1935_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1935_Task5" name="System compiles daily VMI data package per vendor: (a) current stock level per…">
        <bpmn:documentation>Step 1: System compiles daily VMI data package per vendor: (a) current stock level per SKU per location, (b) daily sales (units) per SKU per location, (c) in-transit stock (VMI POs not yet received), (d) pending returns, (e) forecast data (if available from W31 demand forecast), (f) promotional calendar impact (upcoming promos affecting VMI SKUs)
Responsible (R): System
Accountable (A): VP Supply Chain
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1935_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1935_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1935_Task6" name="System transmits data to vendor: (a) preferred: API/EDI transmission directly…">
        <bpmn:documentation>Step 2: System transmits data to vendor: (a) preferred: API/EDI transmission directly to vendor&#x27;s VMI system, (b) fallback: automated email with CSV/Excel attachment, (c) transmission log maintained for audit trail
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1935_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1935_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1935_Task7" name="VP Supply Chain monitors data transmission: (a) daily check: did all 12 vendors…">
        <bpmn:documentation>Step 3: VP Supply Chain monitors data transmission: (a) daily check: did all 12 vendors receive data successfully?, (b) failed transmission: retry within 2 hours, (c) vendor feedback: any data quality issues reported?, (d) monthly: review data accuracy (do vendor&#x27;s stock numbers match BuildRight&#x27;s?)
Responsible (R): VP Supply Chain
Accountable (A): —
Duration: 15–30 min/day</bpmn:documentation>
        <bpmn:incoming>W1935_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1935_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1935_End8" name="Complete">
        <bpmn:incoming>W1935_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1935_Annotation9">
        <bpmn:text>Controls: - CTL-377 (ensure controlled execution — Vendor-Managed Inventory (VMI) Operations (PA-45.2).) | - operational: System review and approval gate
Owner: System</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1935_Assoc10" sourceRef="W1935_Annotation9" targetRef="W1935_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1935_Flow11" sourceRef="W1935_Start4" targetRef="W1935_Task5" />
      <bpmn:sequenceFlow id="W1935_Flow12" sourceRef="W1935_Task5" targetRef="W1935_Task6" />
      <bpmn:sequenceFlow id="W1935_Flow13" sourceRef="W1935_Task6" targetRef="W1935_Task7" />
      <bpmn:sequenceFlow id="W1935_Flow14" sourceRef="W1935_Task7" targetRef="W1935_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1935_diag">
      <bpmndi:BPMNPlane id="W1935_plane" bpmnElement="W_W1935">
        <bpmndi:BPMNShape id="W1935_Lane1_di" bpmnElement="W1935_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1935_Lane2_di" bpmnElement="W1935_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1935_Task5_di" bpmnElement="W1935_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1935_Task6_di" bpmnElement="W1935_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1935_Task7_di" bpmnElement="W1935_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1935_Start4_di" bpmnElement="W1935_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1935_End8_di" bpmnElement="W1935_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1935_Annotation9_di" bpmnElement="W1935_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1935_Flow11_di" bpmnElement="W1935_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1935_Flow12_di" bpmnElement="W1935_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1935_Flow13_di" bpmnElement="W1935_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1935_Flow14_di" bpmnElement="W1935_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1935_Assoc10_di" bpmnElement="W1935_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1936" name="W1936. VMI Automated Replenishment &amp; ASN Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor generates replenishment suggestion based on VMI data
Frequency: ~200–300 VMI replenishment orders/month
Volume: ~300 VMI SKUs across 12 vendors
Owner: VP Supply Chain
Participants: VP Supply Chain, Buyer, Vendor
Source: workflow W1936 — VMI Automated Replenishment &amp; ASN Processing</bpmn:documentation>
      <bpmn:laneSet id="W1936_LaneSet4">
        <bpmn:lane id="W1936_Lane1" name="Vendor">
        <bpmn:flowNodeRef>W1936_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1936_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1936_Lane2" name="System">
        <bpmn:flowNodeRef>W1936_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1936_Lane3" name="Buyer">
        <bpmn:flowNodeRef>W1936_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1936_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1936_Start5" name="Vendor generates replenishment suggestion based on VMI data">
        <bpmn:outgoing>W1936_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1936_Task6" name="Vendor reviews VMI data and generates replenishment order: (a) vendor&#x27;s VMI…">
        <bpmn:documentation>Step 1: Vendor reviews VMI data and generates replenishment order: (a) vendor&#x27;s VMI system calculates replenishment needs based on min/max parameters and recent sales, (b) vendor creates ASN (Advance Shipping Notice) with: SKU, qty, ship date, estimated arrival, (c) ASN transmitted to BuildRight system via API/EDI
Responsible (R): Vendor
Accountable (A): VP Supply Chain
Duration: Vendor-driven</bpmn:documentation>
        <bpmn:incoming>W1936_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1936_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1936_Task7" name="BuildRight system processes ASN: (a) auto-create PO from ASN (within VMI…">
        <bpmn:documentation>Step 2: BuildRight system processes ASN: (a) auto-create PO from ASN (within VMI agreement parameters), (b) validate: (i) total PO value within VMI agreement spending limit, (ii) SKU qty within min/max parameters, (iii) delivery schedule aligns with DC/store receiving capacity, (c) if within tolerance: auto-approve PO, (d) if outside tolerance: route to Buyer for manual review
Responsible (R): System / Buyer
Accountable (A): VP Supply Chain
Duration: Automated + exception handling</bpmn:documentation>
        <bpmn:incoming>W1936_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1936_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1936_Task8" name="Buyer reviews exceptions: (a) vendor suggests qty above max level: reject or…">
        <bpmn:documentation>Step 3: Buyer reviews exceptions: (a) vendor suggests qty above max level: reject or approve with reason (e.g., upcoming promo), (b) vendor suggests SKUs not in VMI agreement: reject, (c) vendor suggests delivery to non-VMI location: reject, (d) document exception resolution
Responsible (R): Buyer
Accountable (A): VP Supply Chain
Duration: 15–30 min/exception</bpmn:documentation>
        <bpmn:incoming>W1936_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1936_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1936_End9" name="Complete">
        <bpmn:incoming>W1936_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1936_Annotation10">
        <bpmn:text>Controls: - CTL-377 (ensure controlled execution — Vendor-Managed Inventory (VMI) Operations (PA-45.2).) | - operational: periodic VMI parameter review with min/max and spending caps
Owner: VP Supply Chain</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1936_Assoc11" sourceRef="W1936_Annotation10" targetRef="W1936_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1936_Flow12" sourceRef="W1936_Start5" targetRef="W1936_Task6" />
      <bpmn:sequenceFlow id="W1936_Flow13" sourceRef="W1936_Task6" targetRef="W1936_Task7" />
      <bpmn:sequenceFlow id="W1936_Flow14" sourceRef="W1936_Task7" targetRef="W1936_Task8" />
      <bpmn:sequenceFlow id="W1936_Flow15" sourceRef="W1936_Task8" targetRef="W1936_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1936_diag">
      <bpmndi:BPMNPlane id="W1936_plane" bpmnElement="W_W1936">
        <bpmndi:BPMNShape id="W1936_Lane1_di" bpmnElement="W1936_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1936_Lane2_di" bpmnElement="W1936_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1936_Lane3_di" bpmnElement="W1936_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1936_Task6_di" bpmnElement="W1936_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1936_Task7_di" bpmnElement="W1936_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1936_Task8_di" bpmnElement="W1936_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1936_Start5_di" bpmnElement="W1936_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1936_End9_di" bpmnElement="W1936_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1936_Annotation10_di" bpmnElement="W1936_Annotation10"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1936_Flow12_di" bpmnElement="W1936_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1936_Flow13_di" bpmnElement="W1936_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1936_Flow14_di" bpmnElement="W1936_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1936_Flow15_di" bpmnElement="W1936_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1936_Assoc11_di" bpmnElement="W1936_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1937" name="W1937. VMI Goods Receipt &amp; Auto-Confirmation" isExecutable="false">
      <bpmn:documentation>Trigger: VMI delivery arrives at DC or store
Frequency: ~200–300 VMI receipts/month
Volume: ~300 VMI SKUs
Owner: Receiving Clerk
Participants: Receiving Clerk, System, Vendor
Source: workflow W1937 — VMI Goods Receipt &amp; Auto-Confirmation</bpmn:documentation>
      <bpmn:laneSet id="W1937_LaneSet3">
        <bpmn:lane id="W1937_Lane1" name="Receiving Clerk">
        <bpmn:flowNodeRef>W1937_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1937_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1937_Lane2" name="System">
        <bpmn:flowNodeRef>W1937_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1937_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1937_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1937_Start4" name="VMI delivery arrives at DC or store">
        <bpmn:outgoing>W1937_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1937_Task5" name="Receiving Clerk processes VMI delivery: (a) scan ASN barcode or enter PO…">
        <bpmn:documentation>Step 1: Receiving Clerk processes VMI delivery: (a) scan ASN barcode or enter PO number, (b) verify quantities against ASN, (c) standard goods receipt process: scan items, check condition, (d) system posts GR: (i) inventory increases at WAC (BuildRight-owned, unlike consignment), (ii) GR/IR created for 3-way match, (iii) AP liability created
Responsible (R): Receiving Clerk
Accountable (A): Department Supervisor
Duration: 15–30 min/receipt</bpmn:documentation>
        <bpmn:incoming>W1937_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1937_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1937_Task6" name="Auto-confirmation: (a) if GR qty within ASN tolerance (typically ±2%), system…">
        <bpmn:documentation>Step 2: Auto-confirmation: (a) if GR qty within ASN tolerance (typically ±2%), system auto-confirms receipt to vendor via API, (b) vendor&#x27;s VMI system updates stock position automatically, (c) if GR qty outside tolerance: manual discrepancy resolution with vendor per W244
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1937_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1937_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1937_Task7" name="Invoice matching: (a) vendor invoice received, (b) system performs 3-way match…">
        <bpmn:documentation>Step 3: Invoice matching: (a) vendor invoice received, (b) system performs 3-way match: PO → GR → Invoice, (c) standard AP processing per W7
Responsible (R): System / AP Clerk
Accountable (A): AP Manager
Duration: Per standard AP cycle</bpmn:documentation>
        <bpmn:incoming>W1937_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1937_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1937_End8" name="Complete">
        <bpmn:incoming>W1937_Flow14</bpmn:incoming>
      </bpmn:endEvent>
