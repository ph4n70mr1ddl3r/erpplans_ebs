    <bpmn:process id="W_W1941" name="W1941. VMI Vendor Performance &amp; Compliance Review" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly VMI vendor review
Frequency: Quarterly
Volume: 12 VMI vendors reviewed
Owner: VP Supply Chain
Participants: VP Supply Chain, Category Manager, Vendor
Source: workflow W1941 — VMI Vendor Performance &amp; Compliance Review</bpmn:documentation>
      <bpmn:laneSet id="W1941_LaneSet2">
        <bpmn:lane id="W1941_Lane1" name="VP Supply Chain">
        <bpmn:flowNodeRef>W1941_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1941_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1941_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1941_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1941_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1941_Start3" name="Quarterly VMI vendor review">
        <bpmn:outgoing>W1941_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1941_Task4" name="VP Supply Chain compiles quarterly VMI scorecard per vendor: (a) fill rate: %…">
        <bpmn:documentation>Step 1: VP Supply Chain compiles quarterly VMI scorecard per vendor: (a) fill rate: % of VMI SKUs at or above minimum stock level, (b) stockout rate: % of VMI SKUs at zero stock, (c) overstock rate: % of VMI SKUs above maximum stock level, (d) replenishment lead time: average days from stock signal to delivery, (e) ASN accuracy: % of receipts matching ASN within tolerance, (f) GR accuracy: % of deliveries with quantity discrepancies, (g) promo stock compliance: did vendor deliver promo stock on time and in full?
Responsible (R): VP Supply Chain
Accountable (A): VP Merchandising
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W1941_Flow10</bpmn:incoming>
        <bpmn:outgoing>W1941_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1941_Task5" name="VP Supply Chain meets with each VMI vendor: (a) present scorecard results, (b)…">
        <bpmn:documentation>Step 2: VP Supply Chain meets with each VMI vendor: (a) present scorecard results, (b) discuss improvement areas, (c) set targets for next quarter, (d) review VMI parameter adequacy: do min/max levels need adjustment?, (e) discuss new product introductions or phase-outs planned
Responsible (R): VP Supply Chain
Accountable (A): VP Merchandising
Duration: 1–2 hours/vendor/quarter</bpmn:documentation>
        <bpmn:incoming>W1941_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1941_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1941_Task6" name="Annual: VP Supply Chain evaluates VMI program effectiveness: (a) compare VMI…">
        <bpmn:documentation>Step 3: Annual: VP Supply Chain evaluates VMI program effectiveness: (a) compare VMI vendor performance to non-VMI vendor performance (fill rate, stockout, inventory turns), (b) calculate VMI program ROI: (reduced procurement labor + reduced stockouts) vs. (VMI system cost + vendor data sharing infrastructure), (c) recommend VMI program expansion or contraction
Responsible (R): VP Supply Chain
Accountable (A): VP Merchandising
Duration: 2–3 days/year</bpmn:documentation>
        <bpmn:incoming>W1941_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1941_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1941_End7" name="Complete">
        <bpmn:incoming>W1941_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1941_Annotation8">
        <bpmn:text>Controls: - CTL-377 (ensure controlled execution — Vendor-Managed Inventory (VMI) Operations (PA-45.2).) | - operational: VP Supply Chain review and approval gate
Owner: VP Supply Chain</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1941_Assoc9" sourceRef="W1941_Annotation8" targetRef="W1941_Start3" associationDirection="None" />
