      <bpmn:sequenceFlow id="W1941_Flow11" sourceRef="W1941_Task4" targetRef="W1941_Task5" />
      <bpmn:sequenceFlow id="W1941_Flow12" sourceRef="W1941_Task5" targetRef="W1941_Task6" />
      <bpmn:sequenceFlow id="W1941_Flow13" sourceRef="W1941_Task6" targetRef="W1941_End7" />
    </bpmn:process>
