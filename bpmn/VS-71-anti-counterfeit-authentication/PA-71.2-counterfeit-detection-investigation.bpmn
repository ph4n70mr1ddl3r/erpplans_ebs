        <bpmndi:BPMNShape id="W2559_Start4_di" bpmnElement="W2559_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2559_End8_di" bpmnElement="W2559_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2559_Annotation9_di" bpmnElement="W2559_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2559_Flow11_di" bpmnElement="W2559_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2559_Flow12_di" bpmnElement="W2559_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2559_Flow13_di" bpmnElement="W2559_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2559_Flow14_di" bpmnElement="W2559_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2559_Assoc10_di" bpmnElement="W2559_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2560" name="W2560. Vendor Counterfeit Alert &amp; Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Confirmed counterfeit product traced to vendor supply
Frequency: ~3–5 vendor alerts/month
Volume: ~3–5/month
Owner: LP Manager
Participants: LP Manager, Procurement, Legal, Vendor Brand Protection
Source: workflow W2560 — Vendor Counterfeit Alert &amp; Coordination</bpmn:documentation>
      <bpmn:laneSet id="W2560_LaneSet3">
        <bpmn:lane id="W2560_Lane1" name="LP Manager">
        <bpmn:flowNodeRef>W2560_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2560_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2560_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2560_Lane2" name="Procurement">
        <bpmn:flowNodeRef>W2560_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2560_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2560_Start4" name="Confirmed counterfeit product traced to vendor supply">
        <bpmn:outgoing>W2560_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2560_Task5" name="LP Manager notifies vendor brand protection team: provides counterfeit sample…">
        <bpmn:documentation>Step 1: LP Manager notifies vendor brand protection team: provides counterfeit sample details, batch/lot information, quantity affected, photographic evidence; requests vendor authentication assessment and batch trace
Responsible (R): LP Manager
Accountable (A): COO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2560_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2560_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2560_Task6" name="Vendor confirms authenticity status; if confirmed counterfeit from vendor…">
        <bpmn:documentation>Step 2: Vendor confirms authenticity status; if confirmed counterfeit from vendor supply: Procurement suspends pending orders from affected batch, arranges product return/replacement, negotiates vendor responsibility (replacement, credit, investigation cost contribution); if vendor supply chain compromised: vendor implements corrective measures
Responsible (R): Procurement / LP Manager / Vendor
Accountable (A): VP Merchandising
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2560_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2560_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2560_Task7" name="LP Manager and Legal update vendor contract: add anti-counterfeit clause with…">
        <bpmn:documentation>Step 3: LP Manager and Legal update vendor contract: add anti-counterfeit clause with penalties, require vendor serialization and authentication cooperation, establish joint investigation protocol; includes vendor scorecard impact for counterfeit incidents
Responsible (R): LP Manager / Legal
Accountable (A): VP Legal
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W2560_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2560_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2560_End8" name="Complete">
        <bpmn:incoming>W2560_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2560_Annotation9">
        <bpmn:text>Controls: - CTL-443 (ensure controlled execution — Counterfeit Detection &amp; Investigation (PA-71.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: LP Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2560_Assoc10" sourceRef="W2560_Annotation9" targetRef="W2560_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2560_Flow11" sourceRef="W2560_Start4" targetRef="W2560_Task5" />
      <bpmn:sequenceFlow id="W2560_Flow12" sourceRef="W2560_Task5" targetRef="W2560_Task6" />
      <bpmn:sequenceFlow id="W2560_Flow13" sourceRef="W2560_Task6" targetRef="W2560_Task7" />
      <bpmn:sequenceFlow id="W2560_Flow14" sourceRef="W2560_Task7" targetRef="W2560_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2560_diag">
      <bpmndi:BPMNPlane id="W2560_plane" bpmnElement="W_W2560">
        <bpmndi:BPMNShape id="W2560_Lane1_di" bpmnElement="W2560_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2560_Lane2_di" bpmnElement="W2560_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2560_Task5_di" bpmnElement="W2560_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2560_Task6_di" bpmnElement="W2560_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2560_Task7_di" bpmnElement="W2560_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2560_Start4_di" bpmnElement="W2560_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2560_End8_di" bpmnElement="W2560_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2560_Annotation9_di" bpmnElement="W2560_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2560_Flow11_di" bpmnElement="W2560_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2560_Flow12_di" bpmnElement="W2560_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2560_Flow13_di" bpmnElement="W2560_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2560_Flow14_di" bpmnElement="W2560_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2560_Assoc10_di" bpmnElement="W2560_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2561" name="W2561. Law Enforcement &amp; Regulatory Reporting for Counterfeiting" isExecutable="false">
      <bpmn:documentation>Trigger: Large-scale counterfeiting case or organized counterfeiting ring identified
Frequency: 1–3 cases/year
Volume: 1–3/year
Owner: VP Legal
Participants: VP Legal, LP Manager, NBI/DTI, Law Enforcement
Source: workflow W2561 — Law Enforcement &amp; Regulatory Reporting for Counterfeiting</bpmn:documentation>
      <bpmn:laneSet id="W2561_LaneSet2">
        <bpmn:lane id="W2561_Lane1" name="VP Legal">
        <bpmn:flowNodeRef>W2561_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2561_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2561_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2561_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2561_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2561_Start3" name="Large-scale counterfeiting case or organized counterfeiting ring identified">
        <bpmn:outgoing>W2561_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2561_Task4" name="VP Legal evaluates case for law enforcement referral: severity (value, volume…">
        <bpmn:documentation>Step 1: VP Legal evaluates case for law enforcement referral: severity (value, volume, organized ring indicator), strength of evidence, jurisdictional considerations; for qualifying cases (typically &gt;PHP 200K value or organized operation): prepares formal complaint
Responsible (R): VP Legal
Accountable (A): CEO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2561_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2561_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2561_Task5" name="Legal files complaint with appropriate agency: NBI Intellectual Property Rights…">
        <bpmn:documentation>Step 2: Legal files complaint with appropriate agency: NBI Intellectual Property Rights Division for organized counterfeiting, DTI for consumer protection violations, local PNP for criminal cases; provides evidence package, sworn statements, product samples
Responsible (R): VP Legal
Accountable (A): CEO
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W2561_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2561_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2561_Task6" name="Legal coordinates with law enforcement: provides testimony, expert witnesses…">
        <bpmn:documentation>Step 3: Legal coordinates with law enforcement: provides testimony, expert witnesses, additional evidence as requested; tracks case progress; protects BuildRight interests and reputation throughout proceedings
Responsible (R): VP Legal
Accountable (A): CEO
Duration: 1–12 months</bpmn:documentation>
        <bpmn:incoming>W2561_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2561_Flow13</bpmn:outgoing>
      </bpmn:userTask>
