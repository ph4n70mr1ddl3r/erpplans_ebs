    <bpmn:process id="W_W2562" name="W2562. Customer Counterfeit Product Exchange &amp; Restitution" isExecutable="false">
      <bpmn:documentation>Trigger: Customer returns product confirmed or suspected as counterfeit
Frequency: ~10–20 cases/month
Volume: ~10–20/month
Owner: Customer Service Manager
Participants: Customer Service Mgr, LP Officer, Store Manager, Customer
Source: workflow W2562 — Customer Counterfeit Product Exchange &amp; Restitution</bpmn:documentation>
      <bpmn:laneSet id="W2562_LaneSet3">
        <bpmn:lane id="W2562_Lane1" name="Customer Service Rep">
        <bpmn:flowNodeRef>W2562_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2562_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2562_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2562_Lane2" name="LP Officer">
        <bpmn:flowNodeRef>W2562_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2562_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2562_Start4" name="Customer returns product confirmed or suspected as counterfeit">
        <bpmn:outgoing>W2562_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2562_Task5" name="Customer reports suspected counterfeit: presents product and receipt; Customer…">
        <bpmn:documentation>Step 1: Customer reports suspected counterfeit: presents product and receipt; Customer Service verifies purchase history, checks product against authentication database; if confirmed or highly suspected counterfeit: immediately offers resolution
Responsible (R): Customer Service Rep / LP Officer
Accountable (A): Store Manager
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W2562_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2562_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2562_Task6" name="Resolution options: (a) Full refund + replacement with genuine product, (b)…">
        <bpmn:documentation>Step 2: Resolution options: (a) Full refund + replacement with genuine product, (b) Store credit with 10% goodwill bonus, (c) Upgrade to higher-spec genuine product at no additional cost; LP Officer collects suspected counterfeit and logs in evidence system
Responsible (R): Customer Service Rep / LP Officer
Accountable (A): Store Manager
Duration: 15–20 min</bpmn:documentation>
        <bpmn:incoming>W2562_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2562_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2562_Task7" name="LP Officer uses case for investigation: traces product source, determines if…">
        <bpmn:documentation>Step 3: LP Officer uses case for investigation: traces product source, determines if from BuildRight stock (internal issue) or customer-acquired elsewhere and falsely claiming; for confirmed BuildRight-sourced counterfeits: escalates to full investigation (W2559)
Responsible (R): LP Officer
Accountable (A): LP Manager
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W2562_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2562_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2562_End8" name="Complete">
        <bpmn:incoming>W2562_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2562_Annotation9">
        <bpmn:text>Controls: - CTL-233 (ensure anti-counterfeit program integrity.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Customer Service Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2562_Assoc10" sourceRef="W2562_Annotation9" targetRef="W2562_Start4" associationDirection="None" />
