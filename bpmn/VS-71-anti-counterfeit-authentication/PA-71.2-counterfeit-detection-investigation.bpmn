    <bpmn:process id="W_W2565" name="W2565. Internal Counterfeit Prevention &amp; Staff Integrity Program" isExecutable="false">
      <bpmn:documentation>Trigger: Annual program cycle or internal counterfeit incident
Frequency: Annual program; incident-driven updates
Volume: 6,925 employees
Owner: LP Manager
Participants: LP Manager, HR, Store Managers, Ethics Committee
Source: workflow W2565 — Internal Counterfeit Prevention &amp; Staff Integrity Program</bpmn:documentation>
      <bpmn:laneSet id="W2565_LaneSet3">
        <bpmn:lane id="W2565_Lane1" name="LP Manager">
        <bpmn:flowNodeRef>W2565_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2565_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2565_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2565_Lane2" name="HR">
        <bpmn:flowNodeRef>W2565_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2565_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2565_Start4" name="Annual program cycle or internal counterfeit incident">
        <bpmn:outgoing>W2565_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2565_Task5" name="LP Manager designs internal prevention program: staff integrity expectations…">
        <bpmn:documentation>Step 1: LP Manager designs internal prevention program: staff integrity expectations regarding product authentication, prohibited activities (selling personal items on store floor, facilitating gray market diversion), whistleblower protection, anonymous reporting hotline
Responsible (R): LP Manager / HR
Accountable (A): COO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2565_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2565_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2565_Task6" name="HR delivers integrity training: included in new hire orientation and annual…">
        <bpmn:documentation>Step 2: HR delivers integrity training: included in new hire orientation and annual refresher; covers counterfeit awareness, ethical sourcing obligations, consequence framework for facilitating counterfeiting or diversion; sign annual integrity pledge
Responsible (R): HR / LP Manager
Accountable (A): CHRO
Duration: 2 hours per employee</bpmn:documentation>
        <bpmn:incoming>W2565_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2565_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2565_Task7" name="LP Manager implements preventive controls: surprise authentication spot-checks…">
        <bpmn:documentation>Step 3: LP Manager implements preventive controls: surprise authentication spot-checks at stores, receiving area CCTV monitoring, serial number reconciliation for high-risk categories, tip investigation within 48 hours; maintains confidential reporting channel
Responsible (R): LP Manager
Accountable (A): COO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2565_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2565_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2565_End8" name="Complete">
        <bpmn:incoming>W2565_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2565_Annotation9">
        <bpmn:text>Controls: - CTL-443 (ensure controlled execution — Counterfeit Detection &amp; Investigation (PA-71.2).) | - operational: periodic reconciliation against source documents
Owner: LP Manager</bpmn:text>
      </bpmn:textAnnotation>
