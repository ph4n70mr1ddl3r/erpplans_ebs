      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2559" name="W2559. Counterfeit Investigation &amp; Evidence Collection" isExecutable="false">
      <bpmn:documentation>Trigger: Confirmed counterfeit detection requiring full investigation
Frequency: ~5–10 full investigations/month
Volume: ~5–10/month
Owner: LP Manager
Participants: LP Manager, LP Officer, Legal, Procurement, Vendor
Source: workflow W2559 — Counterfeit Investigation &amp; Evidence Collection</bpmn:documentation>
      <bpmn:laneSet id="W2559_LaneSet3">
        <bpmn:lane id="W2559_Lane1" name="LP Manager">
        <bpmn:flowNodeRef>W2559_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2559_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2559_Lane2" name="LP Officer">
        <bpmn:flowNodeRef>W2559_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2559_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2559_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2559_Start4" name="Confirmed counterfeit detection requiring full investigation">
        <bpmn:outgoing>W2559_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2559_Task5" name="LP Manager initiates formal investigation: assigns case number, assigns LP…">
        <bpmn:documentation>Step 1: LP Manager initiates formal investigation: assigns case number, assigns LP Officer as lead investigator; determines scope (single product, vendor, store, category); sets investigation timeline (target: 30-day resolution)
Responsible (R): LP Manager
Accountable (A): COO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W2559_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2559_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2559_Task6" name="LP Officer collects evidence: product samples, packaging, labeling; traces…">
        <bpmn:documentation>Step 2: LP Officer collects evidence: product samples, packaging, labeling; traces supply chain (vendor PO → shipment → GR → putaway → shelf); interviews relevant staff (receiving clerk, stock associate, department supervisor); reviews CCTV footage of receiving and stocking areas
Responsible (R): LP Officer
Accountable (A): LP Manager
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W2559_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2559_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2559_Task7" name="LP Officer compiles investigation report: root cause determination…">
        <bpmn:documentation>Step 3: LP Officer compiles investigation report: root cause determination (vendor-supplied counterfeit, supply chain diversion, internal substitution), evidence chain of custody, financial impact assessment; LP Manager reviews and determines action: vendor notification, contract action, staff discipline, law enforcement referral
Responsible (R): LP Officer / LP Manager
Accountable (A): COO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2559_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2559_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2559_End8" name="Complete">
        <bpmn:incoming>W2559_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2559_Annotation9">
        <bpmn:text>Controls: - CTL-443 (ensure controlled execution — Counterfeit Detection &amp; Investigation (PA-71.2).) | - operational: LP Manager review and approval gate
Owner: LP Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2559_Assoc10" sourceRef="W2559_Annotation9" targetRef="W2559_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2559_Flow11" sourceRef="W2559_Start4" targetRef="W2559_Task5" />
      <bpmn:sequenceFlow id="W2559_Flow12" sourceRef="W2559_Task5" targetRef="W2559_Task6" />
      <bpmn:sequenceFlow id="W2559_Flow13" sourceRef="W2559_Task6" targetRef="W2559_Task7" />
      <bpmn:sequenceFlow id="W2559_Flow14" sourceRef="W2559_Task7" targetRef="W2559_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2559_diag">
      <bpmndi:BPMNPlane id="W2559_plane" bpmnElement="W_W2559">
        <bpmndi:BPMNShape id="W2559_Lane1_di" bpmnElement="W2559_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2559_Lane2_di" bpmnElement="W2559_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
