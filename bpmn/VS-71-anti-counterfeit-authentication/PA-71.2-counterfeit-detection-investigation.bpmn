    <bpmn:process id="W_W2563" name="W2563. Online Marketplace Counterfeit Monitoring &amp; Takedown" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly monitoring scan or vendor brand alert
Frequency: Weekly monitoring; 5–10 takedown requests/month
Volume: ~50–100 suspicious listings identified/month
Owner: LP Analyst
Participants: LP Analyst, LP Manager, Legal, Marketplace Platforms
Source: workflow W2563 — Online Marketplace Counterfeit Monitoring &amp; Takedown</bpmn:documentation>
      <bpmn:laneSet id="W2563_LaneSet3">
        <bpmn:lane id="W2563_Lane1" name="LP Analyst">
        <bpmn:flowNodeRef>W2563_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2563_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2563_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2563_Lane2" name="Legal">
        <bpmn:flowNodeRef>W2563_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2563_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2563_Start4" name="Weekly monitoring scan or vendor brand alert">
        <bpmn:outgoing>W2563_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2563_Task5" name="LP Analyst monitors online marketplaces (Shopee, Lazada, FB Marketplace…">
        <bpmn:documentation>Step 1: LP Analyst monitors online marketplaces (Shopee, Lazada, FB Marketplace, Carousell): searches for BuildRight-exclusive brands, private label products, high-risk categories (power tools, electrical); identifies suspicious listings based on pricing (significantly below SRP), product imagery (BuildRight packaging used without authorization), seller location patterns
Responsible (R): LP Analyst
Accountable (A): LP Manager
Duration: 4–6 hours/week</bpmn:documentation>
        <bpmn:incoming>W2563_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2563_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2563_Task6" name="Analyst validates suspicious listings: purchases sample for authentication (if…">
        <bpmn:documentation>Step 2: Analyst validates suspicious listings: purchases sample for authentication (if warranted), cross-references with BuildRight serial numbers, checks if seller is authorized dealer; for confirmed counterfeits: files takedown request with marketplace platform using brand registry tools
Responsible (R): LP Analyst
Accountable (A): LP Manager
Duration: 2–3 hours/case</bpmn:documentation>
        <bpmn:incoming>W2563_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2563_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2563_Task7" name="Legal follows up on takedown requests: tracks platform response timeline…">
        <bpmn:documentation>Step 3: Legal follows up on takedown requests: tracks platform response timeline (typically 3–7 days), escalates non-responsive platforms, coordinates with vendor brand protection teams for joint takedown actions; maintains marketplace enforcement log
Responsible (R): Legal / LP Analyst
Accountable (A): VP Legal
Duration: 1–2 hours/week</bpmn:documentation>
        <bpmn:incoming>W2563_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2563_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2563_End8" name="Complete">
        <bpmn:incoming>W2563_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2563_Annotation9">
        <bpmn:text>Controls: - CTL-233 (ensure anti-counterfeit program integrity.) | - operational: standard operating procedures; system-enforced validation rules
Owner: LP Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2563_Assoc10" sourceRef="W2563_Annotation9" targetRef="W2563_Start4" associationDirection="None" />
