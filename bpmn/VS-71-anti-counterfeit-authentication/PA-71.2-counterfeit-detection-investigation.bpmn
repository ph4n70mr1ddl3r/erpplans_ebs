    <bpmn:process id="W_W2564" name="W2564. Counterfeit Trend Analysis &amp; Threat Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly LP review cycle
Frequency: Monthly
Volume: 1 monthly report
Owner: LP Analyst
Participants: LP Analyst, LP Manager, Category Manager
Source: workflow W2564 — Counterfeit Trend Analysis &amp; Threat Assessment</bpmn:documentation>
      <bpmn:laneSet id="W2564_LaneSet3">
        <bpmn:lane id="W2564_Lane1" name="LP Analyst">
        <bpmn:flowNodeRef>W2564_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2564_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2564_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2564_Lane2" name="LP Manager">
        <bpmn:flowNodeRef>W2564_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2564_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2564_Start4" name="Monthly LP review cycle">
        <bpmn:outgoing>W2564_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2564_Task5" name="LP Analyst compiles counterfeit trend data: incidents by category (power tools…">
        <bpmn:documentation>Step 1: LP Analyst compiles counterfeit trend data: incidents by category (power tools highest risk), by brand, by source (vendor, DC, store, external), by geographic region, by detection method (QR scan, visual, customer report); calculates counterfeit rate per 10,000 units sold
Responsible (R): LP Analyst
Accountable (A): LP Manager
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2564_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2564_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2564_Task6" name="Analyst performs threat assessment: identifies emerging counterfeiting patterns…">
        <bpmn:documentation>Step 2: Analyst performs threat assessment: identifies emerging counterfeiting patterns (new categories, improved fake quality), seasonal trends (holiday season spike), high-risk vendors or stores; produces risk heat map by category and region
Responsible (R): LP Analyst
Accountable (A): LP Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2564_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2564_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2564_Task7" name="LP Manager presents findings to Category Manager and COO: recommends prevention…">
        <bpmn:documentation>Step 3: LP Manager presents findings to Category Manager and COO: recommends prevention investments (additional serialization categories, enhanced inspection procedures), enforcement priorities (focus on highest-loss categories), vendor engagement actions; updates annual anti-counterfeit strategy
Responsible (R): LP Manager
Accountable (A): COO
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2564_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2564_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2564_End8" name="Complete">
        <bpmn:incoming>W2564_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2564_Annotation9">
        <bpmn:text>Controls: - CTL-443 (ensure controlled execution — Counterfeit Detection &amp; Investigation (PA-71.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: LP Analyst</bpmn:text>
      </bpmn:textAnnotation>
