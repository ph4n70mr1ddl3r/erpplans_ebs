<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-71.2-counterfeit-detection-investigation" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2558" name="W2558. In-Store Counterfeit Product Detection &amp; Seizure" isExecutable="false">
      <bpmn:documentation>Trigger: Staff identifies suspected counterfeit during receiving, stocking, or customer interaction
Frequency: ~20–30 detections/month across all stores
Volume: ~20–30/month
Owner: Department Supervisor
Participants: Dept Supervisor, LP Officer, Store Manager, Receiving Clerk
Source: workflow W2558 — In-Store Counterfeit Product Detection &amp; Seizure</bpmn:documentation>
      <bpmn:laneSet id="W2558_LaneSet4">
        <bpmn:lane id="W2558_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W2558_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2558_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2558_Lane2" name="Department Supervisor">
        <bpmn:flowNodeRef>W2558_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2558_Lane3" name="LP Officer">
        <bpmn:flowNodeRef>W2558_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2558_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2558_Start5" name="Staff identifies suspected counterfeit during receiving, stocking, or customer interaction">
        <bpmn:outgoing>W2558_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2558_Task6" name="Staff member identifies suspected counterfeit: packaging quality deviation…">
        <bpmn:documentation>Step 1: Staff member identifies suspected counterfeit: packaging quality deviation (printing, color, material), product weight/feel difference, missing security features (hologram, serialization QR), price discrepancy with market; escalates to Department Supervisor
Responsible (R): Sales Associate / Receiving Clerk
Accountable (A): Department Supervisor
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W2558_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2558_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2558_Task7" name="Supervisor conducts initial assessment: compares against authentic reference…">
        <bpmn:documentation>Step 2: Supervisor conducts initial assessment: compares against authentic reference sample, scans QR code (if present), checks serial number in system; if suspected counterfeit confirmed: segregates product in LP quarantine area, documents with photos, logs in LP case system
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 20–30 min</bpmn:documentation>
        <bpmn:incoming>W2558_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2558_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2558_Task8" name="LP Officer conducts on-site investigation within 48 hours: collects evidence…">
        <bpmn:documentation>Step 3: LP Officer conducts on-site investigation within 48 hours: collects evidence (product, packaging, labels), traces product origin (PO → GR → shelf), determines if breach occurred at vendor, DC, or store level; escalates confirmed cases to LP Manager for full investigation (W2559)
Responsible (R): LP Officer
Accountable (A): LP Manager
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W2558_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2558_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2558_End9" name="Complete">
        <bpmn:incoming>W2558_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2558_Annotation10">
        <bpmn:text>Controls: - CTL-233 (ensure anti-counterfeit program integrity.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2558_Assoc11" sourceRef="W2558_Annotation10" targetRef="W2558_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2558_Flow12" sourceRef="W2558_Start5" targetRef="W2558_Task6" />
      <bpmn:sequenceFlow id="W2558_Flow13" sourceRef="W2558_Task6" targetRef="W2558_Task7" />
      <bpmn:sequenceFlow id="W2558_Flow14" sourceRef="W2558_Task7" targetRef="W2558_Task8" />
      <bpmn:sequenceFlow id="W2558_Flow15" sourceRef="W2558_Task8" targetRef="W2558_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2558_diag">
      <bpmndi:BPMNPlane id="W2558_plane" bpmnElement="W_W2558">
        <bpmndi:BPMNShape id="W2558_Lane1_di" bpmnElement="W2558_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2558_Lane2_di" bpmnElement="W2558_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
