    <bpmn:process id="W_W2556" name="W2556. Serialization Label &amp; Packaging Standard Management" isExecutable="false">
      <bpmn:documentation>Trigger: New product introduction or packaging redesign
Frequency: 5–10 updates/month
Volume: ~500 serialized SKUs
Owner: Category Manager
Participants: Category Mgr, Vendor, LP Manager, Merchandising
Source: workflow W2556 — Serialization Label &amp; Packaging Standard Management</bpmn:documentation>
      <bpmn:laneSet id="W2556_LaneSet4">
        <bpmn:lane id="W2556_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W2556_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2556_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2556_Lane2" name="Vendor">
        <bpmn:flowNodeRef>W2556_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2556_Lane3" name="Quality Inspector">
        <bpmn:flowNodeRef>W2556_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2556_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2556_Start5" name="New product introduction or packaging redesign">
        <bpmn:outgoing>W2556_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2556_Task6" name="Category Manager defines serialization requirements per product category: power…">
        <bpmn:documentation>Step 1: Category Manager defines serialization requirements per product category: power tools (mandatory vendor serialization + BuildRight QR), electrical components (mandatory for circuit breakers, wiring), appliances (mandatory serial + extended warranty QR), accessories (optional based on price point)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2556_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2556_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2556_Task7" name="Vendor implements serialization standards: provides specification for QR…">
        <bpmn:documentation>Step 2: Vendor implements serialization standards: provides specification for QR placement on packaging, data format for ASN transmission, minimum label durability requirements (must survive Philippine humidity and handling); BuildRight LP reviews and approves
Responsible (R): Vendor / LP Manager
Accountable (A): Category Manager
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2556_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2556_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2556_Task8" name="Quality Inspector verifies packaging compliance during incoming inspection: QR…">
        <bpmn:documentation>Step 3: Quality Inspector verifies packaging compliance during incoming inspection: QR code present and scannable, label placement per specification, packaging security features (tamper-evident seals, holograms for premium products); non-compliant shipments quarantined until resolved
Responsible (R): Quality Inspector
Accountable (A): LP Manager
Duration: Per GR (5–10 min)</bpmn:documentation>
        <bpmn:incoming>W2556_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2556_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2556_End9" name="Complete">
        <bpmn:incoming>W2556_Flow15</bpmn:incoming>
      </bpmn:endEvent>
