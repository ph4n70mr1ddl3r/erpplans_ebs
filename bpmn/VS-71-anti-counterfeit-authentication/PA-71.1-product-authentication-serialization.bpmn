    <bpmn:process id="W_W2557" name="W2557. Product Authentication Staff Training" isExecutable="false">
      <bpmn:documentation>Trigger: New hire onboarding or annual refresher
Frequency: Annual certification; onboarding for new hires
Volume: ~800–1,000 staff in receiving, customer service, and sales roles
Owner: Training Manager
Participants: Training Mgr, LP Manager, Category Manager
Source: workflow W2557 — Product Authentication Staff Training</bpmn:documentation>
      <bpmn:laneSet id="W2557_LaneSet3">
        <bpmn:lane id="W2557_Lane1" name="Training Manager">
        <bpmn:flowNodeRef>W2557_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2557_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2557_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2557_Lane2" name="LP Manager">
        <bpmn:flowNodeRef>W2557_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2557_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2557_Start4" name="New hire onboarding or annual refresher">
        <bpmn:outgoing>W2557_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2557_Task5" name="Training Manager develops authentication curriculum: product authentication…">
        <bpmn:documentation>Step 1: Training Manager develops authentication curriculum: product authentication fundamentals, QR code scanning procedures, counterfeit identification techniques (visual, weight, packaging quality), escalation procedures for suspected counterfeits, customer communication scripts
Responsible (R): Training Manager / LP Manager
Accountable (A): LP Manager
Duration: 1 week initial</bpmn:documentation>
        <bpmn:incoming>W2557_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2557_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2557_Task6" name="Delivery: online module (2 hours) covering identification techniques and…">
        <bpmn:documentation>Step 2: Delivery: online module (2 hours) covering identification techniques and procedures; in-store practical workshop (2 hours) with authentic vs. counterfeit sample comparison for key brands (Bosch, Makita, DeWalt, Schneider Electric); certification quiz (90% pass rate)
Responsible (R): Training Manager
Accountable (A): CHRO
Duration: 4 hours per cohort</bpmn:documentation>
        <bpmn:incoming>W2557_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2557_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2557_Task7" name="LP Manager conducts monthly counterfeit awareness updates: new counterfeiting…">
        <bpmn:documentation>Step 3: LP Manager conducts monthly counterfeit awareness updates: new counterfeiting trends, specific brand alerts from vendors, recent investigation outcomes; distributes via OLA and store communication system
Responsible (R): LP Manager
Accountable (A): COO
Duration: 1–2 hours/month</bpmn:documentation>
        <bpmn:incoming>W2557_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2557_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2557_End8" name="Complete">
        <bpmn:incoming>W2557_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2557_Annotation9">
        <bpmn:text>Controls: - CTL-442 (ensure controlled execution — Product Authentication &amp; Serialization (PA-71.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Training Manager</bpmn:text>
      </bpmn:textAnnotation>
