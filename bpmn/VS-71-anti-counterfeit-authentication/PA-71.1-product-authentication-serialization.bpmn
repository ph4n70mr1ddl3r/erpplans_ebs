<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-71.1-product-authentication-serialization" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2550" name="W2550. High-Risk Product Serialization &amp; Registration" isExecutable="false">
      <bpmn:documentation>Trigger: Inbound receipt of serialized products (power tools, high-value electrical, premium fixtures)
Frequency: Per goods receipt; ~2,000–3,000 serialized units/month
Volume: ~500 SKUs requiring serialization across power tools, premium electrical, appliances
Owner: Receiving Clerk / DC Warehouse Supervisor
Participants: Receiving Clerk, Quality Inspector, LP Officer
Source: workflow W2550 — High-Risk Product Serialization &amp; Registration</bpmn:documentation>
      <bpmn:laneSet id="W2550_LaneSet3">
        <bpmn:lane id="W2550_Lane1" name="Receiving Clerk">
        <bpmn:flowNodeRef>W2550_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2550_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2550_Lane2" name="System">
        <bpmn:flowNodeRef>W2550_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2550_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2550_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2550_Start4" name="Inbound receipt of serialized products (power tools, high-value electrical, premium…">
        <bpmn:outgoing>W2550_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2550_Task5" name="Receiving Clerk scans vendor serial numbers/QR codes during goods receipt…">
        <bpmn:documentation>Step 1: Receiving Clerk scans vendor serial numbers/QR codes during goods receipt; system validates against vendor master serialization file (ASN); flags units with missing, duplicate, or non-matching serial numbers for investigation
Responsible (R): Receiving Clerk
Accountable (A): DC Ops Manager
Duration: 5–10 min per shipment</bpmn:documentation>
        <bpmn:incoming>W2550_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2550_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2550_Task6" name="System registers each serial number in authentication database: vendor, model…">
        <bpmn:documentation>Step 2: System registers each serial number in authentication database: vendor, model, manufacturing date, batch/lot, import documentation reference; generates BuildRight authentication QR label applied to packaging
Responsible (R): System / Receiving Clerk
Accountable (A): LP Manager
Duration: 2–3 min per unit</bpmn:documentation>
        <bpmn:incoming>W2550_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2550_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W2550_Task7" name="For products without vendor serialization (local brands): system generates…">
        <bpmn:documentation>Step 3: For products without vendor serialization (local brands): system generates BuildRight-unique serial at GR; records origin vendor, PO reference, and receipt date; enables full chain-of-custody tracking from receipt to sale
Responsible (R): System / Receiving Clerk
Accountable (A): LP Manager
Duration: 1–2 min per unit</bpmn:documentation>
        <bpmn:incoming>W2550_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2550_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2550_End8" name="Complete">
        <bpmn:incoming>W2550_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2550_Annotation9">
        <bpmn:text>Controls: - CTL-233 (ensure anti-counterfeit program integrity.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Receiving Clerk / DC Warehouse Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2550_Assoc10" sourceRef="W2550_Annotation9" targetRef="W2550_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2550_Flow11" sourceRef="W2550_Start4" targetRef="W2550_Task5" />
      <bpmn:sequenceFlow id="W2550_Flow12" sourceRef="W2550_Task5" targetRef="W2550_Task6" />
      <bpmn:sequenceFlow id="W2550_Flow13" sourceRef="W2550_Task6" targetRef="W2550_Task7" />
      <bpmn:sequenceFlow id="W2550_Flow14" sourceRef="W2550_Task7" targetRef="W2550_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2550_diag">
      <bpmndi:BPMNPlane id="W2550_plane" bpmnElement="W_W2550">
        <bpmndi:BPMNShape id="W2550_Lane1_di" bpmnElement="W2550_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2550_Lane2_di" bpmnElement="W2550_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2550_Task5_di" bpmnElement="W2550_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2550_Task6_di" bpmnElement="W2550_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2550_Task7_di" bpmnElement="W2550_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
