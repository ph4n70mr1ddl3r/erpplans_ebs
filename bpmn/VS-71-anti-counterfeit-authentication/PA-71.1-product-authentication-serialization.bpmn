        <bpmndi:BPMNShape id="W2550_Annotation9_di" bpmnElement="W2550_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2550_Flow11_di" bpmnElement="W2550_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2550_Flow12_di" bpmnElement="W2550_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2550_Flow13_di" bpmnElement="W2550_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2550_Flow14_di" bpmnElement="W2550_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2550_Assoc10_di" bpmnElement="W2550_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2551" name="W2551. QR Code Authentication System Management" isExecutable="false">
      <bpmn:documentation>Trigger: Customer or staff scans product QR code
Frequency: Continuous; ~5,000–10,000 scans/month
Volume: ~500,000+ active QR codes in system
Owner: IT Application Manager
Participants: IT App Manager, LP Manager, Vendors
Source: workflow W2551 — QR Code Authentication System Management</bpmn:documentation>
      <bpmn:laneSet id="W2551_LaneSet4">
        <bpmn:lane id="W2551_Lane1" name="IT Application Manager">
        <bpmn:flowNodeRef>W2551_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2551_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2551_Lane2" name="System">
        <bpmn:flowNodeRef>W2551_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2551_Lane3" name="IT">
        <bpmn:flowNodeRef>W2551_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2551_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2551_Start5" name="Customer or staff scans product QR code">
        <bpmn:outgoing>W2551_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2551_Task6" name="IT maintains authentication platform: QR code generation engine, scan…">
        <bpmn:documentation>Step 1: IT maintains authentication platform: QR code generation engine, scan validation API, mobile-responsive result page, analytics backend; ensures 99.9% uptime for customer-facing verification; manages vendor API integrations for real-time validation
Responsible (R): IT Application Manager
Accountable (A): CIO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2551_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2551_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2551_Task7" name="When QR scanned: system validates code authenticity, returns product…">
        <bpmn:documentation>Step 2: When QR scanned: system validates code authenticity, returns product information (brand, model, manufacturing date, authorized retailer confirmation, warranty status); flags previously scanned codes (potential counterfeiting indicator) for LP investigation
Responsible (R): System
Accountable (A): LP Manager
Duration: &lt;3 seconds per scan</bpmn:documentation>
        <bpmn:incoming>W2551_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2551_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2551_Task8" name="IT generates weekly authentication analytics: scan volume by product category…">
        <bpmn:documentation>Step 3: IT generates weekly authentication analytics: scan volume by product category and region, authentication failure rate, geographic scan patterns, repeat-scan alerts (same code scanned at different locations = counterfeiting indicator)
Responsible (R): IT / LP Analyst
Accountable (A): LP Manager
Duration: 2–3 hours/week</bpmn:documentation>
        <bpmn:incoming>W2551_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2551_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2551_End9" name="Complete">
        <bpmn:incoming>W2551_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2551_Annotation10">
        <bpmn:text>Controls: - CTL-442 (ensure controlled execution — Product Authentication &amp; Serialization (PA-71.1).) | - operational: unique per-unit codes and geographic scan anomaly detection; authentication-platform uptime SLA monitored (99.9% target) with offline-verification fallback and vendor-API failover tested quarterly
Owner: IT Application Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2551_Assoc11" sourceRef="W2551_Annotation10" targetRef="W2551_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2551_Flow12" sourceRef="W2551_Start5" targetRef="W2551_Task6" />
      <bpmn:sequenceFlow id="W2551_Flow13" sourceRef="W2551_Task6" targetRef="W2551_Task7" />
      <bpmn:sequenceFlow id="W2551_Flow14" sourceRef="W2551_Task7" targetRef="W2551_Task8" />
      <bpmn:sequenceFlow id="W2551_Flow15" sourceRef="W2551_Task8" targetRef="W2551_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2551_diag">
      <bpmndi:BPMNPlane id="W2551_plane" bpmnElement="W_W2551">
        <bpmndi:BPMNShape id="W2551_Lane1_di" bpmnElement="W2551_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2551_Lane2_di" bpmnElement="W2551_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2551_Lane3_di" bpmnElement="W2551_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2551_Task6_di" bpmnElement="W2551_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2551_Task7_di" bpmnElement="W2551_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2551_Task8_di" bpmnElement="W2551_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2551_Start5_di" bpmnElement="W2551_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2551_End9_di" bpmnElement="W2551_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2551_Annotation10_di" bpmnElement="W2551_Annotation10"><dc:Bounds x="160" y="630" width="360" height="100" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2551_Flow12_di" bpmnElement="W2551_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2551_Flow13_di" bpmnElement="W2551_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2551_Flow14_di" bpmnElement="W2551_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2551_Flow15_di" bpmnElement="W2551_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2551_Assoc11_di" bpmnElement="W2551_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2552" name="W2552. Customer Product Verification Support" isExecutable="false">
      <bpmn:documentation>Trigger: Customer reports suspected counterfeit product or requests verification
Frequency: ~50–100 inquiries/month
Volume: ~50–100/month via customer service, in-store, online
Owner: Customer Service Representative
Participants: Customer Service Rep, LP Officer, Category Manager, Vendor
Source: workflow W2552 — Customer Product Verification Support</bpmn:documentation>
      <bpmn:laneSet id="W2552_LaneSet3">
        <bpmn:lane id="W2552_Lane1" name="Customer Service Rep">
        <bpmn:flowNodeRef>W2552_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2552_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2552_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2552_Lane2" name="LP Officer">
        <bpmn:flowNodeRef>W2552_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2552_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2552_Start4" name="Customer reports suspected counterfeit product or requests verification">
        <bpmn:outgoing>W2552_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2552_Task5" name="Customer submits verification request: product photos, QR code scan result…">
        <bpmn:documentation>Step 1: Customer submits verification request: product photos, QR code scan result, purchase receipt, reason for suspicion (poor quality, packaging differences, performance issues); Customer Service logs in authentication case system
Responsible (R): Customer Service Rep
Accountable (A): LP Manager
Duration: 15–20 min</bpmn:documentation>
        <bpmn:incoming>W2552_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2552_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2552_Task6" name="LP Officer reviews case: compares product images against authentic reference…">
        <bpmn:documentation>Step 2: LP Officer reviews case: compares product images against authentic reference library, validates serial number in database, checks purchase history for source store verification; if counterfeit confirmed: escalates to LP Manager and initiates investigation (W2559)
Responsible (R): LP Officer
Accountable (A): LP Manager
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W2552_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2552_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2552_Task7" name="Customer Service communicates result: if authentic — reassures customer and…">
        <bpmn:documentation>Step 3: Customer Service communicates result: if authentic — reassures customer and explains verification; if counterfeit — offers replacement with genuine product, issues refund, requests customer cooperation in investigation (source information); documents all interactions
Responsible (R): Customer Service Rep
Accountable (A): LP Manager
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W2552_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2552_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2552_End8" name="Complete">
        <bpmn:incoming>W2552_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2552_Annotation9">
        <bpmn:text>Controls: - CTL-442 (ensure controlled execution — Product Authentication &amp; Serialization (PA-71.1).) | - operational: Customer Service Representative review and approval gate
Owner: Customer Service Representative</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2552_Assoc10" sourceRef="W2552_Annotation9" targetRef="W2552_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2552_Flow11" sourceRef="W2552_Start4" targetRef="W2552_Task5" />
      <bpmn:sequenceFlow id="W2552_Flow12" sourceRef="W2552_Task5" targetRef="W2552_Task6" />
      <bpmn:sequenceFlow id="W2552_Flow13" sourceRef="W2552_Task6" targetRef="W2552_Task7" />
      <bpmn:sequenceFlow id="W2552_Flow14" sourceRef="W2552_Task7" targetRef="W2552_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2552_diag">
      <bpmndi:BPMNPlane id="W2552_plane" bpmnElement="W_W2552">
        <bpmndi:BPMNShape id="W2552_Lane1_di" bpmnElement="W2552_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2552_Lane2_di" bpmnElement="W2552_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2552_Task5_di" bpmnElement="W2552_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2552_Task6_di" bpmnElement="W2552_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2552_Task7_di" bpmnElement="W2552_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2552_Start4_di" bpmnElement="W2552_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2552_End8_di" bpmnElement="W2552_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2552_Annotation9_di" bpmnElement="W2552_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2552_Flow11_di" bpmnElement="W2552_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2552_Flow12_di" bpmnElement="W2552_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2552_Flow13_di" bpmnElement="W2552_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2552_Flow14_di" bpmnElement="W2552_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2552_Assoc10_di" bpmnElement="W2552_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2553" name="W2553. Vendor Serialization Compliance Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Annual vendor audit cycle or serialization non-compliance incident
Frequency: Annual per vendor; ad-hoc for incidents
Volume: ~50–80 vendors with serialization-required products
Owner: LP Manager
Participants: LP Manager, Procurement, Quality, Vendor
Source: workflow W2553 — Vendor Serialization Compliance Audit</bpmn:documentation>
      <bpmn:laneSet id="W2553_LaneSet3">
        <bpmn:lane id="W2553_Lane1" name="LP Manager">
        <bpmn:flowNodeRef>W2553_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2553_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2553_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2553_Lane2" name="Procurement">
        <bpmn:flowNodeRef>W2553_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2553_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2553_Start4" name="Annual vendor audit cycle or serialization non-compliance incident">
        <bpmn:outgoing>W2553_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2553_Task5" name="LP Manager reviews vendor serialization compliance rate: percentage of…">
        <bpmn:documentation>Step 1: LP Manager reviews vendor serialization compliance rate: percentage of shipments with complete ASN serialization data, serial number format consistency, QR code quality, packaging integrity; identifies non-compliant vendors
Responsible (R): LP Manager
Accountable (A): COO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2553_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2553_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2553_Task6" name="For non-compliant vendors: Procurement conducts vendor meeting to communicate…">
        <bpmn:documentation>Step 2: For non-compliant vendors: Procurement conducts vendor meeting to communicate requirements, timeline for compliance, and consequences (shipment rejection, vendor scorecard impact); Quality inspects suspect vendor products for authenticity indicators
Responsible (R): Procurement / Quality
Accountable (A): VP Merchandising
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2553_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2553_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2553_Task7" name="LP Manager establishes serialization compliance as vendor scorecard KPI…">
        <bpmn:documentation>Step 3: LP Manager establishes serialization compliance as vendor scorecard KPI (minimum 95% compliance); includes in vendor contracts; quarterly review of compliance trends; persistent non-compliance triggers vendor review and potential replacement
Responsible (R): LP Manager / Procurement
Accountable (A): VP Merchandising
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2553_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2553_Flow14</bpmn:outgoing>
      </bpmn:userTask>
