    <bpmn:process id="W_W1158" name="W1158. Store-Level Customer Project Material List Sharing &amp; Contractor Collaborative Shopping" isExecutable="false">
      <bpmn:documentation>Trigger: Customer saves a project material list in Project Vault (W894) and shares it with their contractor, or contractor requests access to customer&#x27;s material list, or customer presents shared material list for collaborative purchase
Frequency: ~2,000–3,000 shared lists/month across all stores
Volume: 1 shared list per project; 1–3 collaborators per list
Owner: Sales Associate
Participants: Sales Associate, Customer (Homeowner), Contractor/Builder, BuildRight Loyalty System
Source: workflow W1158 — Store-Level Customer Project Material List Sharing &amp; Contractor Collaborative Shopping</bpmn:documentation>
      <bpmn:laneSet id="W1158_LaneSet4">
        <bpmn:lane id="W1158_Lane1" name="Customer">
        <bpmn:flowNodeRef>W1158_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1158_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1158_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1158_Lane2" name="Sales Associate">
        <bpmn:flowNodeRef>W1158_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1158_Lane3" name="System">
        <bpmn:flowNodeRef>W1158_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1158_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1158_Start5" name="Customer saves a project material list in Project Vault (W894) and shares it with their…">
        <bpmn:outgoing>W1158_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1158_Task6" name="Project Material List Creation &amp; Sharing">
        <bpmn:documentation>Step 1: Project Material List Creation &amp; Sharing: (a) homeowner creates project material list in BuildRight app or in-store kiosk (linked to W894 Project Vault); (b) list includes: room/area, selected materials (tiles, paint, fixtures), quantities (based on calculator W823), preferred brands, budget range; (c) homeowner shares list with contractor via: unique share link sent via SMS/email, or contractor&#x27;s loyalty card number lookup in system; (d) contractor receives notification with shared list access; (e) contractor reviews list on their mobile device or in-store kiosk
Responsible (R): Customer (Homeowner)
Accountable (A): Customer
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W1158_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1158_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1158_Task7" name="Contractor Review &amp; List Modification">
        <bpmn:documentation>Step 2: Contractor Review &amp; List Modification: (a) contractor opens shared list and reviews each item: confirms product selection appropriate for project, adjusts quantities based on professional experience (e.g., &quot;Homeowner calculated 22 sqm tiles but I know we need 25 sqm for the layout pattern&quot;), suggests alternative products (&quot;This waterproofing membrane is better for Philippine tropical conditions&quot;), flags missing items (&quot;We need waterproofing tape for the corners — not on the list&quot;); (b) contractor saves modifications with comments visible to homeowner; (c) system notifies homeowner of contractor&#x27;s changes for approval; (d) homeowner approves or discusses changes in-app or in-store
Responsible (R): Customer (Contractor)
Accountable (A): Customer
Duration: 10–20 min</bpmn:documentation>
        <bpmn:incoming>W1158_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1158_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1158_Task8" name="Collaborative Purchase Authorization">
        <bpmn:documentation>Step 3: Collaborative Purchase Authorization: (a) once list is finalized, either party can initiate purchase; (b) system supports flexible payment and pickup options: homeowner pays online → contractor picks up in-store (with authorization code); homeowner pays in-store → contractor picks up later (with authorization code); contractor pays on trade account → homeowner reimburses separately; split payment: homeowner pays for materials, contractor pays for installation accessories; (c) purchase authorization linked to shared list: each line item marked as &quot;purchased&quot; when bought by either party; (d) system prevents double-purchase: if contractor buys tiles from shared list, tiles marked as purchased and homeowner sees update
Responsible (R): Sales Associate / System
Accountable (A): Department Supervisor
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W1158_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1158_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1158_Task9" name="Project Completion Tracking &amp; Post-Project Review">
        <bpmn:documentation>Step 4: Project Completion Tracking &amp; Post-Project Review: (a) system tracks purchase completion: items purchased / total items on shared list; (b) both parties receive progress notifications: &quot;15 of 18 items purchased. Remaining: 10 sqm wall tiles, 2 boxes grout, 1 tube silicone sealant.&quot;; (c) when all items purchased: system generates project completion summary with total cost, breakdown by party, and purchase dates; (d) both parties invited to leave project review / rating; (e) if homeowner satisfied with contractor: contractor referral promoted per W904 (contractor referral service); (f) completed project list archived in both parties&#x27; Project Vault for future reference or reorder
Responsible (R): System / Sales Associate
Accountable (A): Department Supervisor
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1158_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1158_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1158_End10" name="Complete">
        <bpmn:incoming>W1158_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1158_Annotation11">
        <bpmn:text>Controls: - CTL-267 (ensure controlled execution — Project Estimation &amp; Advisory (PA-09.2).) | - operational: must handle authorization codes securely
Owner: Sales Associate</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1158_Assoc12" sourceRef="W1158_Annotation11" targetRef="W1158_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1158_Flow13" sourceRef="W1158_Start5" targetRef="W1158_Task6" />
      <bpmn:sequenceFlow id="W1158_Flow14" sourceRef="W1158_Task6" targetRef="W1158_Task7" />
      <bpmn:sequenceFlow id="W1158_Flow15" sourceRef="W1158_Task7" targetRef="W1158_Task8" />
      <bpmn:sequenceFlow id="W1158_Flow16" sourceRef="W1158_Task8" targetRef="W1158_Task9" />
      <bpmn:sequenceFlow id="W1158_Flow17" sourceRef="W1158_Task9" targetRef="W1158_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1158_diag">
      <bpmndi:BPMNPlane id="W1158_plane" bpmnElement="W_W1158">
        <bpmndi:BPMNShape id="W1158_Lane1_di" bpmnElement="W1158_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1158_Lane2_di" bpmnElement="W1158_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
