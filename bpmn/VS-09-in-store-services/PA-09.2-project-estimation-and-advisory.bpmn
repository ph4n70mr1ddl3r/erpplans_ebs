      <bpmndi:BPMNPlane id="W997_plane" bpmnElement="W_W997">
        <bpmndi:BPMNShape id="W997_Lane1_di" bpmnElement="W997_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
