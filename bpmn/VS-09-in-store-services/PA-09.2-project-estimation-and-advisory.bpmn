      <bpmndi:BPMNPlane id="W998_plane" bpmnElement="W_W998">
        <bpmndi:BPMNShape id="W998_Lane1_di" bpmnElement="W998_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
