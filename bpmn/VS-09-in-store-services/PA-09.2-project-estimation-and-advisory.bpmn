      <bpmndi:BPMNPlane id="W1083_plane" bpmnElement="W_W1083">
        <bpmndi:BPMNShape id="W1083_Lane1_di" bpmnElement="W1083_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
