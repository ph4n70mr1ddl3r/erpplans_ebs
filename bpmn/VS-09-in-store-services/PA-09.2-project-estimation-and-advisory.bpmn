        <bpmndi:BPMNShape id="W1158_End10_di" bpmnElement="W1158_End10"><dc:Bounds x="1260" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1158_Annotation11_di" bpmnElement="W1158_Annotation11"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
