    </bpmn:process>
    <bpmndi:BPMNDiagram id="W967_diag">
      <bpmndi:BPMNPlane id="W967_plane" bpmnElement="W_W967">
        <bpmndi:BPMNShape id="W967_Lane1_di" bpmnElement="W967_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W967_Lane2_di" bpmnElement="W967_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
