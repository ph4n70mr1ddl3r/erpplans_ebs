        <bpmndi:BPMNShape id="W1284_Task7_di" bpmnElement="W1284_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1284_Task8_di" bpmnElement="W1284_Task8"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1284_Task9_di" bpmnElement="W1284_Task9"><dc:Bounds x="1240" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1284_Task10_di" bpmnElement="W1284_Task10"><dc:Bounds x="1450" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1284_Task11_di" bpmnElement="W1284_Task11"><dc:Bounds x="1660" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1284_Start4_di" bpmnElement="W1284_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1284_End12_di" bpmnElement="W1284_End12"><dc:Bounds x="1890" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1284_Annotation13_di" bpmnElement="W1284_Annotation13"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1284_Flow15_di" bpmnElement="W1284_Flow15"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1284_Flow16_di" bpmnElement="W1284_Flow16"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1284_Flow17_di" bpmnElement="W1284_Flow17"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1284_Flow18_di" bpmnElement="W1284_Flow18"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1284_Flow19_di" bpmnElement="W1284_Flow19"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1284_Flow20_di" bpmnElement="W1284_Flow20"><di:waypoint x="1420" y="165" /><di:waypoint x="1450" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1284_Flow21_di" bpmnElement="W1284_Flow21"><di:waypoint x="1630" y="335" /><di:waypoint x="1660" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1284_Flow22_di" bpmnElement="W1284_Flow22"><di:waypoint x="1840" y="165" /><di:waypoint x="1890" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1284_Assoc14_di" bpmnElement="W1284_Assoc14"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
