        <bpmndi:BPMNShape id="W823_Task13_di" bpmnElement="W823_Task13"><dc:Bounds x="1870" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W823_Start5_di" bpmnElement="W823_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
