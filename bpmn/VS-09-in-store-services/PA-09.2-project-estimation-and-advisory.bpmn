      <bpmn:sequenceFlow id="W1053_Flow14" sourceRef="W1053_Task6" targetRef="W1053_Task7" />
      <bpmn:sequenceFlow id="W1053_Flow15" sourceRef="W1053_Task7" targetRef="W1053_Task8" />
      <bpmn:sequenceFlow id="W1053_Flow16" sourceRef="W1053_Task8" targetRef="W1053_End9" />
    </bpmn:process>
