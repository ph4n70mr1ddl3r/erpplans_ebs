      <bpmndi:BPMNPlane id="W1000_plane" bpmnElement="W_W1000">
        <bpmndi:BPMNShape id="W1000_Lane1_di" bpmnElement="W1000_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
