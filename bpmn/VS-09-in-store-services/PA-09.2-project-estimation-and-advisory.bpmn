      <bpmn:sequenceFlow id="W1069_Flow15" sourceRef="W1069_Task6" targetRef="W1069_Task7" />
      <bpmn:sequenceFlow id="W1069_Flow16" sourceRef="W1069_Task7" targetRef="W1069_Task8" />
      <bpmn:sequenceFlow id="W1069_Flow17" sourceRef="W1069_Task8" targetRef="W1069_Task9" />
      <bpmn:sequenceFlow id="W1069_Flow18" sourceRef="W1069_Task9" targetRef="W1069_End10" />
    </bpmn:process>
