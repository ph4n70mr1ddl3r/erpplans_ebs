      <bpmn:sequenceFlow id="W1284_Flow19" sourceRef="W1284_Task8" targetRef="W1284_Task9" />
      <bpmn:sequenceFlow id="W1284_Flow20" sourceRef="W1284_Task9" targetRef="W1284_Task10" />
      <bpmn:sequenceFlow id="W1284_Flow21" sourceRef="W1284_Task10" targetRef="W1284_Task11" />
      <bpmn:sequenceFlow id="W1284_Flow22" sourceRef="W1284_Task11" targetRef="W1284_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1284_diag">
      <bpmndi:BPMNPlane id="W1284_plane" bpmnElement="W_W1284">
        <bpmndi:BPMNShape id="W1284_Lane1_di" bpmnElement="W1284_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1284_Lane2_di" bpmnElement="W1284_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
