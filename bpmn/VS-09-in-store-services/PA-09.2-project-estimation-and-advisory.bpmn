        <bpmndi:BPMNShape id="W1000_Task7_di" bpmnElement="W1000_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1000_Task8_di" bpmnElement="W1000_Task8"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
