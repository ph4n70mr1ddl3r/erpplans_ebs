    <bpmn:process id="W_W1227" name="W1227. Store-Level Customer Kitchen &amp; Bathroom Complete Renovation Material Calculator &amp; Project Quote" isExecutable="false">
      <bpmn:documentation>Trigger: Customer requests a complete material list for a kitchen or bathroom renovation project
Frequency: ~15–25 renovation material calculations per store per month; ~3,000–5,000/month chain-wide
Volume: 200 stores × ~20 calculations/month = ~4,000/month
Owner: Department Supervisor (Tiles &amp; Flooring / Plumbing)
Participants: Department Supervisor, Sales Associate, Customer
Source: workflow W1227 — Store-Level Customer Kitchen &amp; Bathroom Complete Renovation Material Calculator &amp; Project Quote</bpmn:documentation>
      <bpmn:laneSet id="W1227_LaneSet3">
        <bpmn:lane id="W1227_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W1227_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1227_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1227_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1227_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1227_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1227_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1227_Lane2" name="System">
        <bpmn:flowNodeRef>W1227_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1227_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1227_Start4" name="Customer requests a complete material list for a kitchen or bathroom renovation project">
        <bpmn:outgoing>W1227_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1227_Task5" name="Room dimension capture">
        <bpmn:documentation>Step 1: Room dimension capture: Sales Associate captures room dimensions with customer: (a) bathroom: length × width × height, location of door and window; (b) kitchen: length × width, countertop run length, sink location; (c) note special requirements (walk-in shower, double vanity, island)
Responsible (R): Sales Associate
Accountable (A): —
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W1227_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1227_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1227_Task6" name="Material calculation">
        <bpmn:documentation>Step 2: Material calculation: Using ERP project calculator tool: (a) floor tiles: room area + 10% wastage = tiles needed (converted to boxes by tiles/box); (b) wall tiles: wall area (less door/window) + 10% wastage; (c) adhesive: kg per sqm per manufacturer spec; (d) grout: kg per sqm per joint width; (e) plumbing fittings: calculated from layout ( elbows, tees, adapters per standard bathroom/kitchen configuration); (f) fixtures: 1 toilet, 1 faucet, 1 sink per standard bathroom; (g) waterproofing: area × coats per manufacturer
Responsible (R): System / Sales Associate
Accountable (A): Department Supervisor
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W1227_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1227_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1227_Task7" name="Product selection">
        <bpmn:documentation>Step 3: Product selection: Customer selects specific products: (a) tile design and size (affects quantity — larger tiles = fewer pieces); (b) fixture brands and models (price range); (c) color/finish preferences; (d) system updates quantities based on selected product specifications
Responsible (R): Sales Associate / Customer
Accountable (A): —
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W1227_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1227_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1227_Task8" name="Project quote generation">
        <bpmn:documentation>Step 4: Project quote generation: System generates complete project quote: (a) line-by-line material list with quantities, unit prices, and line totals; (b) categorized by trade (tiles, plumbing, electrical, fixtures); (c) project total; (d) estimated installation materials (not labor — labor is customer&#x27;s responsibility); (e) optional: trade account pricing if customer is registered contractor per W58
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1227_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1227_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1227_Task9" name="Quote review &amp; adjustment">
        <bpmn:documentation>Step 5: Quote review &amp; adjustment: (a) customer reviews quote; (b) Sales Associate adjusts quantities, swaps products, or removes items per customer preference; (c) system recalculates totals; (d) save quote to customer&#x27;s loyalty account for future retrieval
Responsible (R): Sales Associate / Customer
Accountable (A): —
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W1227_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1227_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1227_Task10" name="Conversion to sale">
        <bpmn:documentation>Step 6: Conversion to sale: If customer proceeds: (a) convert quote to sales order per W58 quotation-to-order; (b) if trade account: apply trade pricing per W112; (c) arrange delivery per W19 if needed for bulky items; (d) if not ready to buy: save quote for future (valid for 30 days with price protection)
Responsible (R): Sales Associate
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1227_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1227_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1227_End11" name="Complete">
        <bpmn:incoming>W1227_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1227_Annotation12">
        <bpmn:text>Controls: - CTL-267 (ensure controlled execution — Project Estimation &amp; Advisory (PA-09.2).) | - operational: must recalculate dynamically
Owner: Department Supervisor (Tiles &amp; Flooring / Plumbing)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1227_Assoc13" sourceRef="W1227_Annotation12" targetRef="W1227_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1227_Flow14" sourceRef="W1227_Start4" targetRef="W1227_Task5" />
      <bpmn:sequenceFlow id="W1227_Flow15" sourceRef="W1227_Task5" targetRef="W1227_Task6" />
      <bpmn:sequenceFlow id="W1227_Flow16" sourceRef="W1227_Task6" targetRef="W1227_Task7" />
      <bpmn:sequenceFlow id="W1227_Flow17" sourceRef="W1227_Task7" targetRef="W1227_Task8" />
      <bpmn:sequenceFlow id="W1227_Flow18" sourceRef="W1227_Task8" targetRef="W1227_Task9" />
      <bpmn:sequenceFlow id="W1227_Flow19" sourceRef="W1227_Task9" targetRef="W1227_Task10" />
      <bpmn:sequenceFlow id="W1227_Flow20" sourceRef="W1227_Task10" targetRef="W1227_End11" />
    </bpmn:process>
