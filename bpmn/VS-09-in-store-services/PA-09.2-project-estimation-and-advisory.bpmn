    <bpmn:process id="W_W949" name="W949. Customer AI-Powered Home Renovation Visualizer &amp; Material Estimator" isExecutable="false">
      <bpmn:documentation>Trigger: Customer opens the &quot;Plan My Renovation&quot; tool in BuildRight mobile app or website, or accesses it via in-store self-service kiosk (W924)
Frequency: ~15,000–25,000 sessions/month (including browsing sessions that do not convert to orders)
Volume: ~3,000–5,000 material lists generated/month; ~30–35% conversion to orders
Owner: Ecommerce Manager
Participants: Customer, Ecommerce Platform, Category Manager (material data validation), PIM System, Merchandise Planner
Source: workflow W949 — Customer AI-Powered Home Renovation Visualizer &amp; Material Estimator</bpmn:documentation>
      <bpmn:laneSet id="W949_LaneSet3">
        <bpmn:lane id="W949_Lane1" name="Customer">
        <bpmn:flowNodeRef>W949_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W949_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W949_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W949_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W949_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W949_Lane2" name="System">
        <bpmn:flowNodeRef>W949_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W949_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W949_Start4" name="Customer opens the &quot;Plan My Renovation&quot; tool in BuildRight mobile app or website, or…">
        <bpmn:outgoing>W949_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W949_Task5" name="Space Input &amp; Photo Upload">
        <bpmn:documentation>Step 1: Space Input &amp; Photo Upload: Customer opens tool and selects room type (bathroom, kitchen, bedroom, living room, exterior/landscaping); uploads photo of current space via: (a) mobile camera (live capture); (b) photo gallery; (c) selects from stock room templates if no photo available; optionally inputs room dimensions (width × length × ceiling height); system analyzes photo using computer vision (W203) to identify: room type, existing fixtures, wall/floor material, lighting conditions, and approximate dimensions using depth estimation
Responsible (R): Customer / System
Accountable (A): Ecommerce Manager
Duration: 2–5 min</bpmn:documentation>
        <bpmn:incoming>W949_Flow13</bpmn:incoming>
        <bpmn:outgoing>W949_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W949_Task6" name="Style Selection &amp; AI Visualization">
        <bpmn:documentation>Step 2: Style Selection &amp; AI Visualization: Customer browses renovation style gallery organized by: (a) design style — Modern, Modern Filipino, Industrial, Scandinavian, Minimalist, Traditional Filipino; (b) project scope — full renovation, cosmetic refresh, fixture upgrade; (c) budget tier — Budget-Friendly (PHP 15,000–50,000), Mid-Range (PHP 50,000–200,000), Premium (PHP 200,000+); customer selects style; AI model generates 2–3 renovation visualization images showing the customer&#x27;s actual space with proposed changes; customer can iterate: (a) &quot;show me different tiles&quot;; (b) &quot;change wall color to blue&quot;; (c) &quot;add a shower enclosure&quot;; system regenerates visualization in 10–30 seconds; customer selects preferred visualization
Responsible (R): Customer / AI System
Accountable (A): Ecommerce Manager
Duration: 5–15 min</bpmn:documentation>
        <bpmn:incoming>W949_Flow14</bpmn:incoming>
        <bpmn:outgoing>W949_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W949_Task7" name="Auto-Generated Material List &amp; Quantities">
        <bpmn:documentation>Step 3: Auto-Generated Material List &amp; Quantities: System generates material list based on selected visualization and room dimensions: (a) floor tiles — calculates area (sqm), recommends 3 BuildRight tile options with price per tile, adds 10% wastage allowance; (b) wall tiles/paint — calculates wall area, recommends options; (c) fixtures — identifies fixtures shown in visualization (toilet, sink, faucet, shower head, etc.), recommends BuildRight products; (d) plumbing materials — pipes, fittings, valves based on fixture layout; (e) electrical materials — wiring, switches, outlets if electrical changes detected; (f) construction materials — cement, sand, adhesive, grout, waterproofing; (g) labor estimate — optional: estimated labor hours by trade (plumber, electrician, tile setter) based on Philippine standard rates per region; total estimated project cost displayed with breakdown by category
Responsible (R): System
Accountable (A): Category Manager
Duration: 1–2 min (automated)</bpmn:documentation>
        <bpmn:incoming>W949_Flow15</bpmn:incoming>
        <bpmn:outgoing>W949_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W949_Task8" name="Product Selection &amp; Cart Building">
        <bpmn:documentation>Step 4: Product Selection &amp; Cart Building: Customer reviews material list; for each item: system shows 3 alternatives (budget, recommended, premium) with photos, specifications, price, and availability at preferred store; customer can: (a) accept recommended product; (b) select alternative; (c) adjust quantity; (d) remove item; (e) add additional items not in auto-generated list; system updates total project cost in real-time; customer adds selected items to cart or saves material list to Project Vault (W894) for later
Responsible (R): Customer / System
Accountable (A): Ecommerce Manager
Duration: 5–15 min</bpmn:documentation>
        <bpmn:incoming>W949_Flow16</bpmn:incoming>
        <bpmn:outgoing>W949_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W949_Task9" name="Order &amp; Project Save">
        <bpmn:documentation>Step 5: Order &amp; Project Save: Customer either: (a) proceeds to checkout — standard ecommerce order flow per W536 with BOPIS or home delivery; (b) saves project to Project Vault — material list saved with renovation images for future access, sharing with contractor (W904), or reorder; (c) schedules in-store consultation — for complex projects, customer books pro desk appointment per W895 to review material list with a specialist; (d) downloads PDF material list — formatted for contractor reference with product codes, quantities, and BuildRight store locations
Responsible (R): Customer / System
Accountable (A): Ecommerce Manager
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W949_Flow17</bpmn:incoming>
        <bpmn:outgoing>W949_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W949_End10" name="Complete">
        <bpmn:incoming>W949_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W949_Annotation11">
        <bpmn:text>Controls: - CTL-267 (ensure controlled execution — Project Estimation &amp; Advisory (PA-09.2).) | - operational: applies conservative wastage factors (10% tiles, 5% paint, 15% construction materials)
Owner: Ecommerce Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W949_Assoc12" sourceRef="W949_Annotation11" targetRef="W949_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W949_Flow13" sourceRef="W949_Start4" targetRef="W949_Task5" />
      <bpmn:sequenceFlow id="W949_Flow14" sourceRef="W949_Task5" targetRef="W949_Task6" />
      <bpmn:sequenceFlow id="W949_Flow15" sourceRef="W949_Task6" targetRef="W949_Task7" />
      <bpmn:sequenceFlow id="W949_Flow16" sourceRef="W949_Task7" targetRef="W949_Task8" />
      <bpmn:sequenceFlow id="W949_Flow17" sourceRef="W949_Task8" targetRef="W949_Task9" />
      <bpmn:sequenceFlow id="W949_Flow18" sourceRef="W949_Task9" targetRef="W949_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W949_diag">
      <bpmndi:BPMNPlane id="W949_plane" bpmnElement="W_W949">
