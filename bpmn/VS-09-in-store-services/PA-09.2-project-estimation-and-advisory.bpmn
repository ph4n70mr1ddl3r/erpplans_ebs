      <bpmndi:BPMNPlane id="W1069_plane" bpmnElement="W_W1069">
        <bpmndi:BPMNShape id="W1069_Lane1_di" bpmnElement="W1069_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
