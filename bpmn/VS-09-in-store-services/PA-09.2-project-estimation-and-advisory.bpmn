<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-09.2-project-estimation-and-advisory" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W823" name="W823. Store-Level Customer Material Calculator &amp; Quantity Estimation Service" isExecutable="false">
      <bpmn:documentation>Trigger: Customer requests material quantity calculation for a project (floor tiling, wall painting, fencing, cement work)
Frequency: Daily; ~15–25 estimation requests per store per month
Volume: 200 stores x 20 requests = ~4,000 estimations/month; ~70% converted to immediate purchase
Owner: Sales Associate
Participants: Sales Associate, Department Supervisor, Customer
Source: workflow W823 — Store-Level Customer Material Calculator &amp; Quantity Estimation Service</bpmn:documentation>
      <bpmn:laneSet id="W823_LaneSet4">
        <bpmn:lane id="W823_Lane1" name="Customer">
        <bpmn:flowNodeRef>W823_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W823_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W823_Lane2" name="Sales Associate">
        <bpmn:flowNodeRef>W823_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W823_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W823_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W823_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W823_Lane3" name="System">
        <bpmn:flowNodeRef>W823_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W823_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W823_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W823_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W823_Start5" name="Customer requests material quantity calculation for a project (floor tiling, wall…">
        <bpmn:outgoing>W823_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W823_Task6" name="Customer approaches Sales Associate with project dimensions and material…">
        <bpmn:documentation>Step 1: Customer approaches Sales Associate with project dimensions and material question — &quot;I&#x27;m tiling my bathroom, it&#x27;s 3 meters by 4 meters, using 60x60 cm tiles&quot; or &quot;I need to pour a concrete slab, 5 meters by 3 meters, 4 inches thick&quot;
Responsible (R): Customer / Sales Associate
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W823_Flow17</bpmn:incoming>
        <bpmn:outgoing>W823_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W823_Task7" name="Sales Associate opens material calculator on POS terminal or handheld device…">
        <bpmn:documentation>Step 2: Sales Associate opens material calculator on POS terminal or handheld device: (a) selects material type (tiles, paint, cement, lumber, wire, pipes, roofing), (b) enters project dimensions (area, length, volume as applicable), (c) enters application parameters (tile grout gap, paint coats, slab thickness, stud spacing)
Responsible (R): Sales Associate
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W823_Flow18</bpmn:incoming>
        <bpmn:outgoing>W823_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W823_Task8" name="System calculates quantities using: (a) product specifications from W252 item…">
        <bpmn:documentation>Step 3: System calculates quantities using: (a) product specifications from W252 item master (tile dimensions, paint coverage per liter, cement yield per bag), (b) wastage factors by material type (tiles: +10-15%, paint: +5-10%, cement: +5%, lumber: +15%), (c) Philippine construction standards (hollow block per sqm, rebar spacing per structural plan, concrete mix ratios — 1:2:4 for general purpose, 1:1.5:3 for structural)
Responsible (R): System
Accountable (A): —
Duration: Automated (&lt; 5 sec)</bpmn:documentation>
        <bpmn:incoming>W823_Flow19</bpmn:incoming>
        <bpmn:outgoing>W823_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W823_Task9" name="System displays: (a) calculated quantity with wastage — &quot;You need 42 tiles (37…">
        <bpmn:documentation>Step 4: System displays: (a) calculated quantity with wastage — &quot;You need 42 tiles (37 exact + 5 wastage at 12%)&quot;, (b) available stock at store per POS-013 real-time inventory, (c) alternatives if preferred item out of stock per W279 substitution rules, (d) price per unit and total estimated cost, (e) complementary materials needed (&quot;For tiling, you&#x27;ll also need tile adhesive at 4-5 kg/sqm and grout — shall I add those?&quot;)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W823_Flow20</bpmn:incoming>
        <bpmn:outgoing>W823_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W823_Task10" name="Customer reviews estimate: Sales Associate can adjust parameters — reduce…">
        <bpmn:documentation>Step 5: Customer reviews estimate: Sales Associate can adjust parameters — reduce wastage if professional installer (from 15% to 8%), change quality tier (economy vs. premium tile), modify dimensions if customer corrects measurement
Responsible (R): Sales Associate / Customer
Accountable (A): —
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W823_Flow21</bpmn:incoming>
        <bpmn:outgoing>W823_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W823_Task11" name="If customer decides to purchase: Sales Associate adds items to transaction at…">
        <bpmn:documentation>Step 6: If customer decides to purchase: Sales Associate adds items to transaction at POS per W5B or creates quotation per W542 if customer wants to think about it; quotation valid for 7 days with estimated quantities locked
Responsible (R): Sales Associate
Accountable (A): —
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W823_Flow22</bpmn:incoming>
        <bpmn:outgoing>W823_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W823_Task12" name="If customer wants to compare options: Sales Associate runs alternative…">
        <bpmn:documentation>Step 7: If customer wants to compare options: Sales Associate runs alternative calculations with different products/tiers — e.g., compare 60x60 porcelain tile vs. 30x60 ceramic tile quantity and cost difference
Responsible (R): Sales Associate
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W823_Flow23</bpmn:incoming>
        <bpmn:outgoing>W823_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W823_Task13" name="Post-sale: system logs estimation for analytics — estimation accuracy…">
        <bpmn:documentation>Step 8: Post-sale: system logs estimation for analytics — estimation accuracy (comparison of estimated vs. actual purchase quantity for repeat customers), conversion rate (estimate to sale), most estimated materials by store and region, popular project types by store trade area
Responsible (R): System
Accountable (A): Department Supervisor
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W823_Flow24</bpmn:incoming>
        <bpmn:outgoing>W823_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W823_End14" name="Complete">
        <bpmn:incoming>W823_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W823_Annotation15">
        <bpmn:text>Controls: - CTL-267 (ensure controlled execution — Project Estimation &amp; Advisory (PA-09.2).) | - operational: Sales Associate review and approval gate
Owner: Sales Associate</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W823_Assoc16" sourceRef="W823_Annotation15" targetRef="W823_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W823_Flow17" sourceRef="W823_Start5" targetRef="W823_Task6" />
      <bpmn:sequenceFlow id="W823_Flow18" sourceRef="W823_Task6" targetRef="W823_Task7" />
      <bpmn:sequenceFlow id="W823_Flow19" sourceRef="W823_Task7" targetRef="W823_Task8" />
      <bpmn:sequenceFlow id="W823_Flow20" sourceRef="W823_Task8" targetRef="W823_Task9" />
      <bpmn:sequenceFlow id="W823_Flow21" sourceRef="W823_Task9" targetRef="W823_Task10" />
      <bpmn:sequenceFlow id="W823_Flow22" sourceRef="W823_Task10" targetRef="W823_Task11" />
      <bpmn:sequenceFlow id="W823_Flow23" sourceRef="W823_Task11" targetRef="W823_Task12" />
      <bpmn:sequenceFlow id="W823_Flow24" sourceRef="W823_Task12" targetRef="W823_Task13" />
      <bpmn:sequenceFlow id="W823_Flow25" sourceRef="W823_Task13" targetRef="W823_End14" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W823_diag">
      <bpmndi:BPMNPlane id="W823_plane" bpmnElement="W_W823">
        <bpmndi:BPMNShape id="W823_Lane1_di" bpmnElement="W823_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2000" height="170" /></bpmndi:BPMNShape>
