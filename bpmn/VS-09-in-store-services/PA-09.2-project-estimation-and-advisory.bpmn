      <bpmn:sequenceFlow id="W1080_Flow15" sourceRef="W1080_Task7" targetRef="W1080_Task8" />
      <bpmn:sequenceFlow id="W1080_Flow16" sourceRef="W1080_Task8" targetRef="W1080_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1080_diag">
      <bpmndi:BPMNPlane id="W1080_plane" bpmnElement="W_W1080">
        <bpmndi:BPMNShape id="W1080_Lane1_di" bpmnElement="W1080_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
