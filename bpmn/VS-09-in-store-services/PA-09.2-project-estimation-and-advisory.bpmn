      <bpmn:sequenceFlow id="W1060_Flow14" sourceRef="W1060_Task6" targetRef="W1060_Task7" />
      <bpmn:sequenceFlow id="W1060_Flow15" sourceRef="W1060_Task7" targetRef="W1060_Task8" />
      <bpmn:sequenceFlow id="W1060_Flow16" sourceRef="W1060_Task8" targetRef="W1060_End9" />
    </bpmn:process>
