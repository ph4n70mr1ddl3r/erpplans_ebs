      <bpmn:sequenceFlow id="W1056_Flow14" sourceRef="W1056_Task6" targetRef="W1056_Task7" />
      <bpmn:sequenceFlow id="W1056_Flow15" sourceRef="W1056_Task7" targetRef="W1056_Task8" />
      <bpmn:sequenceFlow id="W1056_Flow16" sourceRef="W1056_Task8" targetRef="W1056_End9" />
    </bpmn:process>
