    <bpmn:process id="W_W827" name="W827. Store-Level Building Material Load Calculation &amp; Safety Advisory" isExecutable="false">
      <bpmn:documentation>Trigger: Customer purchases structural building materials (cement, steel rebar, lumber for framing, hollow blocks for load-bearing walls) in significant quantities
Frequency: Weekly; ~50–80 advisory requests per month per store for structural material purchases
Volume: 200 stores x 60 requests/month = ~12,000 advisory interactions/month
Owner: Department Supervisor (Lumber &amp; Building Materials)
Participants: Department Supervisor, Sales Associate, Customer
Source: workflow W827 — Store-Level Building Material Load Calculation &amp; Safety Advisory</bpmn:documentation>
      <bpmn:laneSet id="W827_LaneSet4">
        <bpmn:lane id="W827_Lane1" name="System">
        <bpmn:flowNodeRef>W827_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W827_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W827_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W827_Lane2" name="Sales Associate">
        <bpmn:flowNodeRef>W827_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W827_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W827_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W827_Lane3" name="Department Supervisor">
        <bpmn:flowNodeRef>W827_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W827_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W827_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W827_Start5" name="Customer purchases structural building materials (cement, steel rebar, lumber for…">
        <bpmn:outgoing>W827_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W827_Task6" name="Sales Associate identifies customer purchasing structural materials above…">
        <bpmn:documentation>Step 1: Sales Associate identifies customer purchasing structural materials above threshold quantities: (a) cement &gt; 50 bags (indicates structural pour, not patching), (b) steel rebar &gt; 20 pieces of any size (indicates reinforcement work), (c) lumber &gt; 50 board feet designated for framing use (not finishing), (d) hollow blocks &gt; 200 pieces (indicates wall construction); POS system flags these transactions with advisory prompt per threshold configuration
Responsible (R): System / Sales Associate
Accountable (A): —
Duration: Automated at scan</bpmn:documentation>
        <bpmn:incoming>W827_Flow16</bpmn:incoming>
        <bpmn:outgoing>W827_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W827_Task7" name="Sales Associate asks customer about project scope: &quot;What are you building? Is…">
        <bpmn:documentation>Step 2: Sales Associate asks customer about project scope: &quot;What are you building? Is this for structural or non-structural use?&quot; — determines whether advisory is required: (a) non-structural projects (garden wall, pavers, non-load-bearing partition, fence under 2 meters): advisory not required but general guidance offered, (b) structural projects (load-bearing wall, floor slab, column, beam, foundation, second-floor extension, retaining wall &gt; 1 meter): full advisory per steps 3-6
Responsible (R): Sales Associate
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W827_Flow17</bpmn:incoming>
        <bpmn:outgoing>W827_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W827_Task8" name="If structural project identified: Sales Associate activates load calculation…">
        <bpmn:documentation>Step 3: If structural project identified: Sales Associate activates load calculation reference tool on POS terminal or handheld device: (a) provides general material specifications per Philippine building code — standard concrete mix ratio 1:2:4 (cement:sand:gravel) for general structural use, 1:1.5:3 for reinforced concrete; minimum rebar size for columns (12mm minimum per standard practice, 16mm preferred); standard hollow block wall thickness (150mm for load-bearing, 100mm for non-load-bearing); minimum beam depth-to-span ratio, (b) displays safety disclaimer prominently: &quot;These are general reference guidelines only, based on standard Philippine construction practices. For structural construction, BuildRight strongly recommends consulting a licensed civil engineer per National Building Code PD 1096. BuildRight assumes no liability for structural failures resulting from customer&#x27;s construction decisions.&quot;, (c) prints or displays material specification reference sheet — includes standard mix ratios, rebar spacing guidelines, concrete curing times, and engineering referral contacts (list of 3-5 licensed engineers in store&#x27;s trade area)
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W827_Flow18</bpmn:incoming>
        <bpmn:outgoing>W827_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W827_Task9" name="Department Supervisor reviews for high-risk purchases: (a) if customer appears…">
        <bpmn:documentation>Step 4: Department Supervisor reviews for high-risk purchases: (a) if customer appears to be building a multi-story structure without engineering plans — customer mentions second floor, mezzanine, or roof deck; purchasing structural steel beams, large-diameter rebar (20mm+), or high-strength cement, (b) if material selection is clearly inadequate for stated purpose — e.g., 10mm rebar for columns when 16mm minimum is standard practice; buying hollow blocks for a 3-meter high boundary wall without columns; ordering insufficient cement bags for stated slab area (calculated per W823 material calculator shows shortage), (c) Supervisor provides additional advisory: reinforces recommendation to consult engineer, may decline sale of clearly inadequate materials for stated structural purpose (rare — customer advised, not refused), (d) documents additional advisory interaction in system
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 5-10 min for high-risk cases</bpmn:documentation>
        <bpmn:incoming>W827_Flow19</bpmn:incoming>
        <bpmn:outgoing>W827_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W827_Task10" name="System logs advisory interaction for liability protection: (a) customer account…">
        <bpmn:documentation>Step 5: System logs advisory interaction for liability protection: (a) customer account or transaction ID, (b) materials purchased with quantities, (c) advisory provided — reference sheet printed, safety disclaimer displayed, verbal advisory confirmed, (d) customer acknowledgment — customer signs or confirms advisory received on POS terminal or delivery receipt, (e) log retained per W256 document retention policy — minimum 10 years for construction-related advisory records per Philippine legal requirement
Responsible (R): System / Sales Associate
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W827_Flow20</bpmn:incoming>
        <bpmn:outgoing>W827_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W827_Task11" name="Optional value-added service: Sales Associate offers referral to BuildRight&#x27;s…">
        <bpmn:documentation>Step 6: Optional value-added service: Sales Associate offers referral to BuildRight&#x27;s design consultancy service per W148 (project planning with professional engineer) or installation service per W138 (BuildRight-certified contractor for assembly/installation): &quot;We can connect you with a licensed engineer who can design your project properly. Would you like to schedule a consultation?&quot; — estimated 10-15% conversion to consultancy service
Responsible (R): Sales Associate
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W827_Flow21</bpmn:incoming>
        <bpmn:outgoing>W827_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W827_Task12" name="Monthly advisory analytics: (a) advisory interaction rate — percentage of…">
        <bpmn:documentation>Step 7: Monthly advisory analytics: (a) advisory interaction rate — percentage of structural material transactions above threshold that triggered advisory (target: 100%), (b) conversion to design/installation services — customers who used W148 or W138 after receiving advisory, (c) customer feedback on advisory helpfulness — post-interaction survey per W708, (d) advisory log completeness — percentage of advisory interactions with all required fields documented (target: &gt;95%), (e) high-risk case frequency and outcome tracking
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W827_Flow22</bpmn:incoming>
        <bpmn:outgoing>W827_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W827_End13" name="Complete">
        <bpmn:incoming>W827_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W827_Annotation14">
        <bpmn:text>Controls: - CTL-267 (ensure controlled execution — Project Estimation &amp; Advisory (PA-09.2).) | - operational: prominent disclaimer, referral to licensed professionals, and regular review of reference content by structural engineer consultant
Owner: Department Supervisor (Lumber &amp; Building Materials)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W827_Assoc15" sourceRef="W827_Annotation14" targetRef="W827_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W827_Flow16" sourceRef="W827_Start5" targetRef="W827_Task6" />
      <bpmn:sequenceFlow id="W827_Flow17" sourceRef="W827_Task6" targetRef="W827_Task7" />
      <bpmn:sequenceFlow id="W827_Flow18" sourceRef="W827_Task7" targetRef="W827_Task8" />
      <bpmn:sequenceFlow id="W827_Flow19" sourceRef="W827_Task8" targetRef="W827_Task9" />
      <bpmn:sequenceFlow id="W827_Flow20" sourceRef="W827_Task9" targetRef="W827_Task10" />
      <bpmn:sequenceFlow id="W827_Flow21" sourceRef="W827_Task10" targetRef="W827_Task11" />
      <bpmn:sequenceFlow id="W827_Flow22" sourceRef="W827_Task11" targetRef="W827_Task12" />
      <bpmn:sequenceFlow id="W827_Flow23" sourceRef="W827_Task12" targetRef="W827_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W827_diag">
      <bpmndi:BPMNPlane id="W827_plane" bpmnElement="W_W827">
        <bpmndi:BPMNShape id="W827_Lane1_di" bpmnElement="W827_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W827_Lane2_di" bpmnElement="W827_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W827_Lane3_di" bpmnElement="W827_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1790" height="170" /></bpmndi:BPMNShape>
