    <bpmn:process id="W_W992" name="W992. Customer Garden &amp; Landscape Design Consultation &amp; Material Estimation Service" isExecutable="false">
      <bpmn:documentation>Trigger: Customer requests garden/landscape design assistance at store garden section or via mobile app
Frequency: ~2,000–3,000 consultations/month chain-wide (~10–15/store/month); peaks March–May (PH summer)
Volume: 1 project per consultation
Owner: Department Supervisor (Garden &amp; Outdoor)
Participants: Sales Associate (Garden Specialist), Customer, Category Manager (pricing)
Source: workflow W992 — Customer Garden &amp; Landscape Design Consultation &amp; Material Estimation Service</bpmn:documentation>
      <bpmn:laneSet id="W992_LaneSet3">
        <bpmn:lane id="W992_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W992_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W992_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W992_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W992_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W992_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W992_Lane2" name="System">
        <bpmn:flowNodeRef>W992_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W992_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W992_Start4" name="Customer requests garden/landscape design assistance at store garden section or via…">
        <bpmn:outgoing>W992_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W992_Task5" name="Project Scope &amp; Site Assessment">
        <bpmn:documentation>Step 1: Project Scope &amp; Site Assessment: Customer provides: (a) garden area dimensions (length × width in meters); (b) current condition — bare soil, lawn, existing plants, concrete/paved; (c) sun exposure — full sun (6+ hours), partial shade (3–6 hours), full shade (&lt;3 hours); (d) soil type — clay (common in PH), sandy, loam, rocky (customer observation or soil test kit); (e) drainage — standing water after rain, good drainage, sloped; (f) project type — new garden, garden renovation, container/balcony garden, vegetable garden, ornamental garden, xeriscaping (drought-resistant); (g) budget range; (h) maintenance commitment — low (weekend gardener), medium, high (daily attention); (i) existing structures — pergola, fence per W987, walkway, patio
Responsible (R): Sales Associate / Customer
Accountable (A): Department Supervisor
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W992_Flow13</bpmn:incoming>
        <bpmn:outgoing>W992_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W992_Task6" name="Garden Design &amp; Plant Selection">
        <bpmn:documentation>Step 2: Garden Design &amp; Plant Selection: Sales Associate designs: (a) functional zones — patio/seating area, planting beds, walkway, lawn area, vegetable patch, utility area (compost, hose storage); (b) hardscape plan — paver type (concrete pavers, natural stone, permeable pavers), walkway width (0.9–1.2m), edging material, retaining wall (if slope requires); (c) softscape plan — plant selection based on PH hardiness, sun exposure, and maintenance level: shade trees (narra, acacia, fire tree), ornamental shrubs (bougainvillea, ixora, santan), ground cover (carabao grass, Korean grass), flowering plants (gumamela, sampaguita, orchids), vegetables (tomato, chili, pechay, okra); (d) irrigation plan — drip irrigation system (water-efficient), sprinkler heads, timer/controller, rain sensor; (e) drainage plan — French drain or surface drainage to prevent standing water during monsoon
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W992_Flow14</bpmn:incoming>
        <bpmn:outgoing>W992_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W992_Task7" name="Material Takeoff &amp; Quantity Calculation">
        <bpmn:documentation>Step 3: Material Takeoff &amp; Quantity Calculation: System calculates: (a) hardscape materials — pavers (area ÷ paver coverage + 5% waste), edging (linear meters), base material (gravel/sand per sqm depth), polymeric sand (for joints), retaining wall blocks (if applicable); (b) soil amendments — garden soil (cubic meters based on bed area × 0.15m depth), compost/organic matter, fertilizer (NPK ratio based on plant selection); (c) plants — quantity based on spacing requirements per species; (d) irrigation — drip line length, emitter quantity, connector fittings, timer, filter, pressure regulator; (e) landscape fabric (sqm for weed barrier under pavers and planting beds); (f) mulch (cubic meters based on bed area × 0.05m depth); (g) accessories — garden hose, hose reel, sprinkler, pruning shears, gloves, pots and planters (for container garden)
Responsible (R): System / Sales Associate
Accountable (A): Department Supervisor
Duration: 5–8 min (automated)</bpmn:documentation>
        <bpmn:incoming>W992_Flow15</bpmn:incoming>
        <bpmn:outgoing>W992_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W992_Task8" name="Cross-Sell Outdoor Living Products">
        <bpmn:documentation>Step 4: Cross-Sell Outdoor Living Products: Sales Associate recommends: (a) outdoor lighting — solar path lights, garden spotlights, string lights; (b) outdoor furniture — garden bench, dining set, lounge chairs; (c) water feature — fountain kit, small pond liner, water pump per W984; (d) pest control — organic insecticide, snail bait, mosquito control; (e) garden tools — shovel, rake, trowel, wheelbarrow, pruning saw; (f) vertical garden system (for small spaces/condominiums); (g) shade structure — pergola kit, shade sail, umbrella
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 5–8 min</bpmn:documentation>
        <bpmn:incoming>W992_Flow16</bpmn:incoming>
        <bpmn:outgoing>W992_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W992_Task9" name="Quotation &amp; Order Processing">
        <bpmn:documentation>Step 5: Quotation &amp; Order Processing: Customer reviews design and material list; Sales Associate: (a) presents itemized materials grouped by category (hardscape, softscape, irrigation, accessories); (b) creates POS quotation per W542 valid for 14 days; (c) for hardscape materials (pavers, gravel, sand): schedules delivery per W5D; (d) offers garden installation service referral per W138 (landscaping contractor); (e) offers fencing service per W987 if garden boundary fencing needed; (f) quotation saved to customer loyalty account per W894; (g) provides seasonal planting calendar specific to customer&#x27;s PH region
Responsible (R): Sales Associate / Customer
Accountable (A): Department Supervisor
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W992_Flow17</bpmn:incoming>
        <bpmn:outgoing>W992_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W992_End10" name="Complete">
        <bpmn:incoming>W992_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W992_Annotation11">
        <bpmn:text>Controls: - CTL-267 (ensure controlled execution — Project Estimation &amp; Advisory (PA-09.2).) | - operational: Department Supervisor (Garden &amp; Outdoor) review and approval gate
Owner: Department Supervisor (Garden &amp; Outdoor)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W992_Assoc12" sourceRef="W992_Annotation11" targetRef="W992_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W992_Flow13" sourceRef="W992_Start4" targetRef="W992_Task5" />
      <bpmn:sequenceFlow id="W992_Flow14" sourceRef="W992_Task5" targetRef="W992_Task6" />
      <bpmn:sequenceFlow id="W992_Flow15" sourceRef="W992_Task6" targetRef="W992_Task7" />
      <bpmn:sequenceFlow id="W992_Flow16" sourceRef="W992_Task7" targetRef="W992_Task8" />
      <bpmn:sequenceFlow id="W992_Flow17" sourceRef="W992_Task8" targetRef="W992_Task9" />
      <bpmn:sequenceFlow id="W992_Flow18" sourceRef="W992_Task9" targetRef="W992_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W992_diag">
      <bpmndi:BPMNPlane id="W992_plane" bpmnElement="W_W992">
        <bpmndi:BPMNShape id="W992_Lane1_di" bpmnElement="W992_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W992_Lane2_di" bpmnElement="W992_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W992_Task5_di" bpmnElement="W992_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W992_Task6_di" bpmnElement="W992_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
