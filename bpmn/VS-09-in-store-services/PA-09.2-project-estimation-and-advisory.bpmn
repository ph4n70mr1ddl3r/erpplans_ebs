        <bpmndi:BPMNEdge id="W997_Flow12_di" bpmnElement="W997_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W997_Flow13_di" bpmnElement="W997_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W997_Flow14_di" bpmnElement="W997_Flow14"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W997_Flow15_di" bpmnElement="W997_Flow15"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W997_Flow16_di" bpmnElement="W997_Flow16"><di:waypoint x="1210" y="165" /><di:waypoint x="1260" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W997_Assoc11_di" bpmnElement="W997_Assoc11"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W998" name="W998. Customer Septic Tank &amp; Wastewater System Sizing Recommendation Service" isExecutable="false">
      <bpmn:documentation>Trigger: Customer (homeowner, contractor, or developer) requests septic tank sizing for new construction or renovation
Frequency: ~1,500–2,500 consultations/month chain-wide (~7–12/store/month)
Volume: 1 system per consultation
Owner: Department Supervisor (Plumbing)
Participants: Sales Associate (Plumbing Specialist), Customer, Category Manager (pricing)
Source: workflow W998 — Customer Septic Tank &amp; Wastewater System Sizing Recommendation Service</bpmn:documentation>
      <bpmn:laneSet id="W998_LaneSet3">
        <bpmn:lane id="W998_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W998_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W998_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W998_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W998_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W998_Lane2" name="System">
        <bpmn:flowNodeRef>W998_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W998_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W998_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W998_Start4" name="Customer (homeowner, contractor, or developer) requests septic tank sizing for new…">
        <bpmn:outgoing>W998_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W998_Task5" name="Wastewater Load Assessment">
        <bpmn:documentation>Step 1: Wastewater Load Assessment: Sales Associate collects: (a) number of occupants/users; (b) building type — residential (single-family, multi-family), commercial, institutional; (c) number of bathrooms, kitchens, laundry areas; (d) water source — municipal supply or well pump per W984 (affects water consumption per capita); (e) soil type — clay (poor percolation), sandy (good percolation), loam; (f) available space for septic tank installation; (g) water table depth (high water table in coastal/lowland PH requires waterproof tank construction and may prevent drain field installation); (h) LGU requirements — some LGUs mandate minimum tank size or specific construction standards
Responsible (R): Sales Associate / Customer
Accountable (A): Department Supervisor
Duration: 8–12 min</bpmn:documentation>
        <bpmn:incoming>W998_Flow13</bpmn:incoming>
        <bpmn:outgoing>W998_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W998_Task6" name="Septic Tank Sizing Calculation">
        <bpmn:documentation>Step 2: Septic Tank Sizing Calculation: System calculates per the Sanitation Code (PD 856, Ch. XVII) and the National Plumbing Code of the Philippines (NPCP): (a) daily wastewater volume = occupants × water consumption (150 L/person/day residential) × 80% (wastewater generation factor); (b) septic tank capacity = daily volume × 2–3 days retention time (minimum per DENR: 1.0 cubic meters effective capacity for residential); (c) recommended tank size — 1.0 cu.m. (1–3 occupants), 1.5 cu.m. (4–6 occupants), 2.0 cu.m. (7–10 occupants), 3.0 cu.m. (10–15 occupants), custom &gt;3.0 cu.m. for commercial/institutional; (d) tank type recommendation — pre-fabricated polyethylene (fastest installation, 1-day setup, ideal for residential) or CHB-constructed (for custom sizes &gt;3.0 cu.m. or where pre-fabricated delivery is impractical); (e) drain field sizing (if applicable) — percolation test result determines drain field area; for high water table or clay soil: sealed tank without drain field, requiring periodic desludging by LGU-accredited desludging service
Responsible (R): System / Sales Associate
Accountable (A): Department Supervisor
Duration: 3–5 min (automated)</bpmn:documentation>
        <bpmn:incoming>W998_Flow14</bpmn:incoming>
        <bpmn:outgoing>W998_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W998_Task7" name="Material Takeoff">
        <bpmn:documentation>Step 3: Material Takeoff: System generates bill of materials: (a) Pre-fabricated option: septic tank unit (selected size), inlet/outlet PVC pipes (4&quot; diameter), pipe fittings (elbows, tees), concrete base mix (cement + sand + gravel for pad), waterproofing membrane, access cover/riser, vent pipe, sealant; (b) CHB-constructed option: CHB hollow blocks (quantity based on tank dimensions × wall area × 1.05 waste), cement (bags for mortar and plaster), sand, rebar (10mm for wall reinforcement), waterproofing cement additive, inlet/outlet PVC pipes and fittings, concrete mix for base slab and cover slab, waterproofing membrane (applied to interior walls), access cover, vent pipe; (c) connection materials from building DWV to septic tank per W989 plumbing layout
Responsible (R): System / Sales Associate
Accountable (A): Department Supervisor
Duration: 3–5 min (automated)</bpmn:documentation>
        <bpmn:incoming>W998_Flow15</bpmn:incoming>
        <bpmn:outgoing>W998_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W998_Task8" name="Regulatory Compliance &amp; Installation Guidance">
        <bpmn:documentation>Step 4: Regulatory Compliance &amp; Installation Guidance: Sales Associate provides: (a) DENR compliance confirmation — tank sizing meets the Sanitation Code (PD 856, Ch. XVII) minimum effective-capacity requirements (1.0 cu.m. residential, per Step 2); (b) LGU building permit guidance — customer must include septic tank plan in building permit application per W54; some LGUs require DENR-accredited installer certification; (c) maintenance recommendations — desludging every 3–5 years by LGU-accredited desludging service (BuildRight does not provide desludging services); (d) environmental advisories — no chemical/grease discharge to septic tank (kills treatment bacteria); recommend biological septic tank additive (enzyme tablets sold in store) to maintain treatment efficiency; (e) for high water table areas: advisement that sealed tank requires more frequent desludging since no drain field absorption
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 5–8 min</bpmn:documentation>
        <bpmn:incoming>W998_Flow16</bpmn:incoming>
        <bpmn:outgoing>W998_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W998_Task9" name="Quotation &amp; Order Processing">
        <bpmn:documentation>Step 5: Quotation &amp; Order Processing: Customer reviews recommendation; Sales Associate: (a) presents complete material list with pricing; (b) offers plumbing layout design per W989 for complete DWV system design; (c) offers water tank/pump sizing per W984 for complete water system planning; (d) creates POS quotation per W542; (e) for pre-fabricated tanks: schedules delivery per W5D (tanks are bulky and heavy — 1.5 cu.m. tank weighs ~80 kg empty); (f) quotation saved to customer loyalty account per W894
Responsible (R): Sales Associate / Customer
Accountable (A): Department Supervisor
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W998_Flow17</bpmn:incoming>
        <bpmn:outgoing>W998_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W998_End10" name="Complete">
        <bpmn:incoming>W998_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W998_Annotation11">
        <bpmn:text>Controls: - CTL-267 (ensure controlled execution — Project Estimation &amp; Advisory (PA-09.2).) | - operational: Department Supervisor (Plumbing) review and approval gate
Owner: Department Supervisor (Plumbing)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W998_Assoc12" sourceRef="W998_Annotation11" targetRef="W998_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W998_Flow13" sourceRef="W998_Start4" targetRef="W998_Task5" />
      <bpmn:sequenceFlow id="W998_Flow14" sourceRef="W998_Task5" targetRef="W998_Task6" />
      <bpmn:sequenceFlow id="W998_Flow15" sourceRef="W998_Task6" targetRef="W998_Task7" />
      <bpmn:sequenceFlow id="W998_Flow16" sourceRef="W998_Task7" targetRef="W998_Task8" />
      <bpmn:sequenceFlow id="W998_Flow17" sourceRef="W998_Task8" targetRef="W998_Task9" />
      <bpmn:sequenceFlow id="W998_Flow18" sourceRef="W998_Task9" targetRef="W998_End10" />
    </bpmn:process>
