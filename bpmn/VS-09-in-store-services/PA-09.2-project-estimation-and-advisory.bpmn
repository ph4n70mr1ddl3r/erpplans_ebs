    <bpmn:process id="W_W1000" name="W1000. Customer Ceiling System Material Calculator &amp; Design Recommendation Service" isExecutable="false">
      <bpmn:documentation>Trigger: Customer requests ceiling material estimation at store or via mobile app
Frequency: ~3,000–4,000 calculations/month chain-wide (~15–20/store/month)
Volume: 1–3 rooms per calculation; average 1.8 rooms
Owner: Department Supervisor (Lumber &amp; Building Materials)
Participants: Sales Associate (Building Materials Specialist), Customer, Category Manager (pricing)
Source: workflow W1000 — Customer Ceiling System Material Calculator &amp; Design Recommendation Service</bpmn:documentation>
      <bpmn:laneSet id="W1000_LaneSet3">
        <bpmn:lane id="W1000_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W1000_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1000_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1000_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1000_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1000_Lane2" name="System">
        <bpmn:flowNodeRef>W1000_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1000_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1000_Start4" name="Customer requests ceiling material estimation at store or via mobile app">
        <bpmn:outgoing>W1000_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1000_Task5" name="Room Assessment &amp; Ceiling Type Selection">
        <bpmn:documentation>Step 1: Room Assessment &amp; Ceiling Type Selection: Customer provides: (a) room dimensions — length × width (in meters) for each room needing ceiling; (b) ceiling height (distance from floor to bottom of ceiling joists/rafters); (c) room type — bedroom, living room, kitchen, bathroom, office, commercial space; (d) ceiling type preference — gypsum board (smooth finish, paintable, standard for living rooms/bedrooms), PVC panels (waterproof, easy install, ideal for bathrooms/kitchens), acoustic tiles (sound absorption, commercial/office), plywood (traditional, paintable); (e) existing condition — open joists (new ceiling), old ceiling to replace, ceiling repair; (f) special features — recessed lighting, ceiling fan, aircon ducting, access panel for plumbing/electrical maintenance
Responsible (R): Sales Associate / Customer
Accountable (A): Department Supervisor
Duration: 8–12 min</bpmn:documentation>
        <bpmn:incoming>W1000_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1000_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1000_Task6" name="Material Quantity Calculation">
        <bpmn:documentation>Step 2: Material Quantity Calculation: System calculates: (a) ceiling area = room length × room width (per room); (b) Gypsum board system: gypsum board sheets (1.2m × 2.4m standard, coverage 2.88 sqm/sheet) = ceiling area ÷ 2.88 × 1.10 waste factor; metal furring channels (main runners at 1.2m spacing + cross tees at 0.4m spacing) = calculated by area and grid spacing; hanger wires (per m² of ceiling, typically 4–6 per sheet); drywall screws (30–40 per sheet); joint tape (linear meters = total joint length); joint compound (kg per sqm for 3-coat finish); corner beads (linear meters of exposed edges); (c) PVC panel system: PVC ceiling panels (width × length per product) = ceiling width ÷ panel width × ceiling length ÷ panel length; mounting clips/track (linear meters = perimeter + intermediate supports); screws; (d) Acoustic tile system: ceiling tiles (600mm × 600mm standard) = area ÷ 0.36 sqm × 1.05 waste; T-bar grid (main runners + cross tees per layout); wall molding (perimeter); hanger wires; (e) accessories — insulation (fiberglass blanket per W983 for thermal/sound), recessed light housings (per W991 electrical design), access panel, mold-resistant primer (for bathrooms/kitchens)
Responsible (R): System / Sales Associate
Accountable (A): Department Supervisor
Duration: 3–5 min (automated)</bpmn:documentation>
        <bpmn:incoming>W1000_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1000_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1000_Task7" name="Cross-Sell Ceiling-Mounted Products">
        <bpmn:documentation>Step 3: Cross-Sell Ceiling-Mounted Products: Sales Associate recommends: (a) recessed LED downlights (per W991 electrical circuit planning); (b) ceiling fan (energy-efficient alternative to aircon per W985); (c) ceiling-mounted smoke detector per W476 fire safety; (d) insulation upgrade (fiberglass blanket reduces indoor temperature by 2–4°C in PH homes with GI sheet roofing); (e) decorative ceiling medallion (for chandelier/pendant light installations); (f) PVC cove molding for ceiling-wall junction finishing
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 5–8 min</bpmn:documentation>
        <bpmn:incoming>W1000_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1000_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1000_Task8" name="Quotation &amp; Order Processing">
        <bpmn:documentation>Step 4: Quotation &amp; Order Processing: Customer reviews material list; Sales Associate: (a) presents itemized materials grouped by system type; (b) offers delivery per W5D for bulky gypsum boards (1.2m × 2.4m sheets require covered truck transport — cannot be exposed to rain); (c) offers installation service referral per W138 (ceiling installer); (d) offers electrical layout per W991 if ceiling-mounted lighting planned; (e) creates POS quotation per W542 valid for 14 days; (f) quotation saved to customer loyalty account per W894
Responsible (R): Sales Associate / Customer
Accountable (A): Department Supervisor
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W1000_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1000_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1000_End9" name="Complete">
        <bpmn:incoming>W1000_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1000_Annotation10">
        <bpmn:text>Controls: - CTL-267 (ensure controlled execution — Project Estimation &amp; Advisory (PA-09.2).) | - operational: per W140
Owner: Department Supervisor (Lumber &amp; Building Materials)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1000_Assoc11" sourceRef="W1000_Annotation10" targetRef="W1000_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1000_Flow12" sourceRef="W1000_Start4" targetRef="W1000_Task5" />
      <bpmn:sequenceFlow id="W1000_Flow13" sourceRef="W1000_Task5" targetRef="W1000_Task6" />
      <bpmn:sequenceFlow id="W1000_Flow14" sourceRef="W1000_Task6" targetRef="W1000_Task7" />
      <bpmn:sequenceFlow id="W1000_Flow15" sourceRef="W1000_Task7" targetRef="W1000_Task8" />
      <bpmn:sequenceFlow id="W1000_Flow16" sourceRef="W1000_Task8" targetRef="W1000_End9" />
    </bpmn:process>
