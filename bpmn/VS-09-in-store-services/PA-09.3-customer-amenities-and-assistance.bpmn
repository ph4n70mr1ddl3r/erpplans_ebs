      <bpmn:sequenceFlow id="W773_Flow20" sourceRef="W773_Task8" targetRef="W773_Task9" />
      <bpmn:sequenceFlow id="W773_Flow21" sourceRef="W773_Task9" targetRef="W773_Task10" />
      <bpmn:sequenceFlow id="W773_Flow22" sourceRef="W773_Task10" targetRef="W773_Task11" />
      <bpmn:sequenceFlow id="W773_Flow23" sourceRef="W773_Task11" targetRef="W773_Task12" />
      <bpmn:sequenceFlow id="W773_Flow24" sourceRef="W773_Task12" targetRef="W773_Task13" />
      <bpmn:sequenceFlow id="W773_Flow25" sourceRef="W773_Task13" targetRef="W773_Task14" />
      <bpmn:sequenceFlow id="W773_Flow26" sourceRef="W773_Task14" targetRef="W773_End15" />
    </bpmn:process>
