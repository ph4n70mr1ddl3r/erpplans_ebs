      <bpmn:sequenceFlow id="W772_Flow19" sourceRef="W772_Task7" targetRef="W772_Task8" />
      <bpmn:sequenceFlow id="W772_Flow20" sourceRef="W772_Task8" targetRef="W772_Task9" />
