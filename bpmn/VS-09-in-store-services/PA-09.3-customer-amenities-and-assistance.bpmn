<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-09.3-customer-amenities-and-assistance" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W746" name="W746. Store-Level Building Material Sample Management &amp; Customer Selection Assistance" isExecutable="false">
      <bpmn:documentation>Trigger: Customer requests to view or compare material samples (tiles, countertops, wood, paint, fabric, flooring)
Frequency: Daily; ~10–20 sample requests per store per day
Volume: 200 stores × ~15 sample requests/day = ~3,000 sample interactions/day chain-wide
Owner: Department Supervisor (Building Materials)
Participants: Floor Associate, Department Supervisor, Customer, Merchandising (W1)
Source: workflow W746 — Store-Level Building Material Sample Management &amp; Customer Selection Assistance</bpmn:documentation>
      <bpmn:laneSet id="W746_LaneSet4">
        <bpmn:lane id="W746_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W746_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W746_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W746_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W746_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W746_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W746_Lane2" name="System">
        <bpmn:flowNodeRef>W746_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W746_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W746_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W746_Lane3" name="Department Supervisor">
        <bpmn:flowNodeRef>W746_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W746_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W746_Start5" name="Customer requests to view or compare material samples (tiles, countertops, wood, paint…">
        <bpmn:outgoing>W746_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W746_Task6" name="Sample library maintenance — Daily: Sales Associate verifies sample board…">
        <bpmn:documentation>Step 1: Sample library maintenance — Daily: Sales Associate verifies sample board displays are complete, organized, and labeled; reports missing or damaged samples for replacement
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W746_Flow17</bpmn:incoming>
        <bpmn:outgoing>W746_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W746_Task7" name="Customer sample request — Customer requests to view samples; Sales Associate…">
        <bpmn:documentation>Step 2: Customer sample request — Customer requests to view samples; Sales Associate guides customer to sample display area, provides sample boards, and offers to check inventory availability for preferred options
Responsible (R): Sales Associate
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W746_Flow18</bpmn:incoming>
        <bpmn:outgoing>W746_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W746_Task8" name="Sample checkout — For take-home samples (tile pieces, wood samples, paint…">
        <bpmn:documentation>Step 3: Sample checkout — For take-home samples (tile pieces, wood samples, paint swatches), Sales Associate checks out sample against customer loyalty account; system tracks sample borrower and due date (7-day loan period)
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W746_Flow19</bpmn:incoming>
        <bpmn:outgoing>W746_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W746_Task9" name="Selection consultation — Sales Associate assists with quantity calculation…">
        <bpmn:documentation>Step 4: Selection consultation — Sales Associate assists with quantity calculation (square meters of tiles, linear meters of lumber, liters of paint), provides product specifications from W50 PIM, and generates quotation (W542)
Responsible (R): Sales Associate
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W746_Flow20</bpmn:incoming>
        <bpmn:outgoing>W746_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W746_Task10" name="Sample return tracking — System tracks overdue sample loans; sends automated…">
        <bpmn:documentation>Step 5: Sample return tracking — System tracks overdue sample loans; sends automated reminders at 7 and 14 days; after 21 days, system flags for W605 return fraud review if patterns suggest abuse
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W746_Flow21</bpmn:incoming>
        <bpmn:outgoing>W746_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W746_Task11" name="Sample replenishment — When sample inventory drops below threshold, system…">
        <bpmn:documentation>Step 6: Sample replenishment — When sample inventory drops below threshold, system generates replenishment request to merchandising (W1) or vendor; merchandising ships new samples via W4
Responsible (R): System / Department Supervisor
Accountable (A): —
Duration: 5 min/request</bpmn:documentation>
        <bpmn:incoming>W746_Flow22</bpmn:incoming>
        <bpmn:outgoing>W746_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W746_Task12" name="Seasonal sample rotation — At seasonal transitions (W583), Department…">
        <bpmn:documentation>Step 7: Seasonal sample rotation — At seasonal transitions (W583), Department Supervisor coordinates with merchandising to rotate sample displays for new seasonal products
Responsible (R): Department Supervisor
Accountable (A): Merchandising
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W746_Flow23</bpmn:incoming>
        <bpmn:outgoing>W746_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W746_Task13" name="Sample performance analytics — System tracks which samples drive the highest…">
        <bpmn:documentation>Step 8: Sample performance analytics — System tracks which samples drive the highest conversion to sale; merchandising uses data for assortment decisions (W1) and planogram placement (W314)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W746_Flow24</bpmn:incoming>
        <bpmn:outgoing>W746_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W746_End14" name="Complete">
        <bpmn:incoming>W746_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W746_Annotation15">
        <bpmn:text>Controls: - CTL-268 (ensure controlled execution — Customer Amenities &amp; Assistance (PA-09.3).) | - operational: Department Supervisor (Building Materials) review and approval gate
Owner: Department Supervisor (Building Materials)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W746_Assoc16" sourceRef="W746_Annotation15" targetRef="W746_Start5" associationDirection="None" />
