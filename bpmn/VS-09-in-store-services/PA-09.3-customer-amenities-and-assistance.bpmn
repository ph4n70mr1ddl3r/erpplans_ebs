      <bpmn:sequenceFlow id="W2742_Flow17" sourceRef="W2742_Task7" targetRef="W2742_Task8" />
      <bpmn:sequenceFlow id="W2742_Flow18" sourceRef="W2742_Task8" targetRef="W2742_Task9" />
      <bpmn:sequenceFlow id="W2742_Flow19" sourceRef="W2742_Task9" targetRef="W2742_Task10" />
      <bpmn:sequenceFlow id="W2742_Flow20" sourceRef="W2742_Task10" targetRef="W2742_Task11" />
      <bpmn:sequenceFlow id="W2742_Flow21" sourceRef="W2742_Task11" targetRef="W2742_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2742_diag">
