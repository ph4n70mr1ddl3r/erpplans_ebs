    <bpmn:process id="W_W775" name="W775. Store-Level Customer Loyalty Card Replacement &amp; Account Recovery" isExecutable="false">
      <bpmn:documentation>Trigger: Customer reports lost, damaged, or defective loyalty card; or customer forgets loyalty number
Frequency: Daily; ~3–5 replacement requests per store per day
Volume: 200 stores × ~4 replacements/day = ~800 replacements/day chain-wide (~292,000/year)
Owner: Customer Service Rep
Participants: CSR, Customer
Source: workflow W775 — Store-Level Customer Loyalty Card Replacement &amp; Account Recovery</bpmn:documentation>
      <bpmn:laneSet id="W775_LaneSet3">
        <bpmn:lane id="W775_Lane1" name="CSR">
        <bpmn:flowNodeRef>W775_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W775_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W775_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W775_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W775_Lane2" name="System">
        <bpmn:flowNodeRef>W775_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W775_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W775_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W775_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W775_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W775_Start4" name="Customer reports lost, damaged, or defective loyalty card; or customer forgets loyalty…">
        <bpmn:outgoing>W775_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W775_Task5" name="Customer identification and account lookup">
        <bpmn:documentation>Step 1: Customer identification and account lookup: CSR looks up customer account: (a) by mobile number (primary), (b) by name + birthday, (c) by email address, (d) by scanning old card barcode if partially readable; verifies customer identity by confirming 2 of: registered phone, address, or last transaction details
Responsible (R): CSR
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W775_Flow15</bpmn:incoming>
        <bpmn:outgoing>W775_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W775_Task6" name="Account status verification">
        <bpmn:documentation>Step 2: Account status verification: System displays account: (a) active status, (b) current points balance, (c) current tier (Bronze/Silver/Gold/Platinum per W17), (d) any account flags (frozen per W496 fraud, merged per W619); confirms account is valid and not flagged for fraud
Responsible (R): System
Accountable (A): CSR
Duration: Instant</bpmn:documentation>
        <bpmn:incoming>W775_Flow16</bpmn:incoming>
        <bpmn:outgoing>W775_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W775_Task7" name="Old card deactivation">
        <bpmn:documentation>Step 3: Old card deactivation: If old card is being replaced: system deactivates old card barcode and links; if card was lost, system flags old card as &quot;Lost — Do Not Honor&quot; to prevent unauthorized use of points
Responsible (R): System
Accountable (A): —
Duration: Instant</bpmn:documentation>
        <bpmn:incoming>W775_Flow17</bpmn:incoming>
        <bpmn:outgoing>W775_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W775_Task8" name="New card issuance">
        <bpmn:documentation>Step 4: New card issuance: CSR issues replacement: (a) physical card — scans new blank card barcode and links to account, (b) digital card — sends new digital card link via SMS/email for mobile wallet; system logs replacement with date, store, and CSR ID
Responsible (R): CSR
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W775_Flow18</bpmn:incoming>
        <bpmn:outgoing>W775_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W775_Task9" name="Account verification">
        <bpmn:documentation>Step 5: Account verification: CSR verifies: (a) new card scans correctly at POS terminal, (b) points balance displays correctly, (c) customer tier and benefits are intact, (d) customer confirms information is current (phone, email, address per RA 10173 consent)
Responsible (R): CSR
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W775_Flow19</bpmn:incoming>
        <bpmn:outgoing>W775_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W775_Task10" name="Customer communication">
        <bpmn:documentation>Step 6: Customer communication: System sends confirmation: &quot;Your BuildRight loyalty card has been replaced at [Store Name]. Your points balance: [X]. Your tier: [Y]. If you did not request this replacement, please contact us immediately at [hotline].&quot;
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W775_Flow20</bpmn:incoming>
        <bpmn:outgoing>W775_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W775_Task11" name="Replacement analytics">
        <bpmn:documentation>Step 7: Replacement analytics: Monthly: system reports: (a) replacement rate by store, (b) replacement reason (lost, damaged, defective), (c) time-to-resolution, (d) flagged accounts (repeated replacements may indicate fraud per W496)
Responsible (R): System
Accountable (A): CRM Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W775_Flow21</bpmn:incoming>
        <bpmn:outgoing>W775_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W775_End12" name="Complete">
        <bpmn:incoming>W775_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W775_Annotation13">
        <bpmn:text>Controls: - CTL-268 (ensure controlled execution — Customer Amenities &amp; Assistance (PA-09.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Customer Service Rep</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W775_Assoc14" sourceRef="W775_Annotation13" targetRef="W775_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W775_Flow15" sourceRef="W775_Start4" targetRef="W775_Task5" />
      <bpmn:sequenceFlow id="W775_Flow16" sourceRef="W775_Task5" targetRef="W775_Task6" />
      <bpmn:sequenceFlow id="W775_Flow17" sourceRef="W775_Task6" targetRef="W775_Task7" />
      <bpmn:sequenceFlow id="W775_Flow18" sourceRef="W775_Task7" targetRef="W775_Task8" />
      <bpmn:sequenceFlow id="W775_Flow19" sourceRef="W775_Task8" targetRef="W775_Task9" />
      <bpmn:sequenceFlow id="W775_Flow20" sourceRef="W775_Task9" targetRef="W775_Task10" />
      <bpmn:sequenceFlow id="W775_Flow21" sourceRef="W775_Task10" targetRef="W775_Task11" />
      <bpmn:sequenceFlow id="W775_Flow22" sourceRef="W775_Task11" targetRef="W775_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W775_diag">
      <bpmndi:BPMNPlane id="W775_plane" bpmnElement="W_W775">
        <bpmndi:BPMNShape id="W775_Lane1_di" bpmnElement="W775_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W775_Lane2_di" bpmnElement="W775_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W775_Task5_di" bpmnElement="W775_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W775_Task6_di" bpmnElement="W775_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W775_Task7_di" bpmnElement="W775_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
