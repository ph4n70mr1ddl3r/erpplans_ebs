      <bpmn:sequenceFlow id="W772_Flow23" sourceRef="W772_Task11" targetRef="W772_Task12" />
      <bpmn:sequenceFlow id="W772_Flow24" sourceRef="W772_Task12" targetRef="W772_Task13" />
      <bpmn:sequenceFlow id="W772_Flow25" sourceRef="W772_Task13" targetRef="W772_End14" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W772_diag">
      <bpmndi:BPMNPlane id="W772_plane" bpmnElement="W_W772">
        <bpmndi:BPMNShape id="W772_Lane1_di" bpmnElement="W772_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2000" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W772_Lane2_di" bpmnElement="W772_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="2000" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W772_Lane3_di" bpmnElement="W772_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="2000" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W772_Task6_di" bpmnElement="W772_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W772_Task7_di" bpmnElement="W772_Task7"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W772_Task8_di" bpmnElement="W772_Task8"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W772_Task9_di" bpmnElement="W772_Task9"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W772_Task10_di" bpmnElement="W772_Task10"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W772_Task11_di" bpmnElement="W772_Task11"><dc:Bounds x="1450" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W772_Task12_di" bpmnElement="W772_Task12"><dc:Bounds x="1660" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W772_Task13_di" bpmnElement="W772_Task13"><dc:Bounds x="1870" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W772_Start5_di" bpmnElement="W772_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W772_End14_di" bpmnElement="W772_End14"><dc:Bounds x="2100" y="487" width="36" height="36" /></bpmndi:BPMNShape>
