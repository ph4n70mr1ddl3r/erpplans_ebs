    <bpmn:process id="W_W931" name="W931. Store-Level Customer Comfort Room &amp; Amenity Daily Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Daily (morning store opening per W5A)
Frequency: Daily, 200 stores
Volume: 1–3 customer comfort rooms per store (sales floor, lumber yard area if separate); PWD-accessible comfort room per BP 344 required per location
Owner: Maintenance / Utility Staff
Participants: Maintenance Staff, Department Supervisor, Store Manager
Source: workflow W931 — Store-Level Customer Comfort Room &amp; Amenity Daily Operations</bpmn:documentation>
      <bpmn:laneSet id="W931_LaneSet5">
        <bpmn:lane id="W931_Lane1" name="Maintenance Staff">
        <bpmn:flowNodeRef>W931_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W931_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W931_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W931_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W931_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W931_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W931_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W931_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W931_Lane2" name="System">
        <bpmn:flowNodeRef>W931_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W931_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W931_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W931_Lane4" name="Dept. Supervisor">
        <bpmn:flowNodeRef>W931_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W931_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W931_Start6" name="Daily (morning store opening per W5A)">
        <bpmn:outgoing>W931_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W931_Task7" name="Maintenance Staff performs morning comfort room opening checklist (before store…">
        <bpmn:documentation>Step 1: Maintenance Staff performs morning comfort room opening checklist (before store opening per W5A): verify door locks functional, PWD-accessible door auto-opener working, lights and exhaust fan operational, water supply running, toilet and sink functional, no leaks or plumbing issues; any critical failure (no water, broken toilet) triggers immediate facility maintenance work order (W47) with &quot;urgent&quot; priority
Responsible (R): Maintenance Staff
Accountable (A): Store Manager
Duration: 10 min/room</bpmn:documentation>
        <bpmn:incoming>W931_Flow20</bpmn:incoming>
        <bpmn:outgoing>W931_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W931_Task8" name="Maintenance Staff stocks consumables to par level: toilet paper (minimum 2…">
        <bpmn:documentation>Step 2: Maintenance Staff stocks consumables to par level: toilet paper (minimum 2 rolls per stall), hand soap (dispenser &gt; 25% full), paper towels or hand dryer functional, sanitary supplies (covered bin with liner), floor mat; stocks PWD-specific supplies: grab rail stability verified, emergency pull cord functional
Responsible (R): Maintenance Staff
Accountable (A): Dept. Supervisor
Duration: 5 min/room</bpmn:documentation>
        <bpmn:incoming>W931_Flow21</bpmn:incoming>
        <bpmn:outgoing>W931_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W931_Task9" name="Maintenance Staff performs morning deep clean: toilet bowl and seat…">
        <bpmn:documentation>Step 3: Maintenance Staff performs morning deep clean: toilet bowl and seat disinfection, sink and counter cleaning, mirror wipe, floor mopping with disinfectant, trash removal and liner replacement, air freshener/ventilation check; cleaning chemical inventory deducted from store supplies inventory
Responsible (R): Maintenance Staff
Accountable (A): Dept. Supervisor
Duration: 15 min/room</bpmn:documentation>
        <bpmn:incoming>W931_Flow22</bpmn:incoming>
        <bpmn:outgoing>W931_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W931_Task10" name="System logs morning checklist completion with Maintenance Staff ID and…">
        <bpmn:documentation>Step 4: System logs morning checklist completion with Maintenance Staff ID and timestamp; incomplete items auto-generate facility maintenance work order per W47; checklist stored for LGU sanitary permit compliance documentation (W448)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W931_Flow23</bpmn:incoming>
        <bpmn:outgoing>W931_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W931_Task11" name="Mid-day (12:00–1:00 PM): Maintenance Staff performs mid-day restocking and spot…">
        <bpmn:documentation>Step 5: Mid-day (12:00–1:00 PM): Maintenance Staff performs mid-day restocking and spot clean of high-traffic comfort rooms; check consumables, wipe surfaces, remove trash if &gt;75% full; quick check per zone (sales floor + lumber yard if applicable)
Responsible (R): Maintenance Staff
Accountable (A): Dept. Supervisor
Duration: 5 min/room</bpmn:documentation>
        <bpmn:incoming>W931_Flow24</bpmn:incoming>
        <bpmn:outgoing>W931_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W931_Task12" name="Afternoon (3:00–4:00 PM): Maintenance Staff performs afternoon spot check and…">
        <bpmn:documentation>Step 6: Afternoon (3:00–4:00 PM): Maintenance Staff performs afternoon spot check and restock per mid-day protocol
Responsible (R): Maintenance Staff
Accountable (A): Dept. Supervisor
Duration: 5 min/room</bpmn:documentation>
        <bpmn:incoming>W931_Flow25</bpmn:incoming>
        <bpmn:outgoing>W931_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W931_Task13" name="End-of-day (after store closing per W574): Maintenance Staff performs closing…">
        <bpmn:documentation>Step 7: End-of-day (after store closing per W574): Maintenance Staff performs closing deep clean per morning protocol (step 3); stocks to par level for next morning; locks comfort room doors; system logs closing checklist
Responsible (R): Maintenance Staff
Accountable (A): Store Manager
Duration: 15 min/room</bpmn:documentation>
        <bpmn:incoming>W931_Flow26</bpmn:incoming>
        <bpmn:outgoing>W931_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W931_Task14" name="Weekly (Saturday): Maintenance Staff performs weekly deep maintenance — grout…">
        <bpmn:documentation>Step 8: Weekly (Saturday): Maintenance Staff performs weekly deep maintenance — grout cleaning, drain check and clearing, exhaust fan dust removal, tile scrubbing, PWD grab rail tightening, mirror re-polishing; logs completion
Responsible (R): Maintenance Staff
Accountable (A): Store Manager
Duration: 30 min/room</bpmn:documentation>
        <bpmn:incoming>W931_Flow27</bpmn:incoming>
        <bpmn:outgoing>W931_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W931_Task15" name="Monthly: Store Manager conducts comfort room inspection using LGU sanitary…">
        <bpmn:documentation>Step 9: Monthly: Store Manager conducts comfort room inspection using LGU sanitary permit standards checklist (W448); rates cleanliness, supply availability, PWD accessibility, and fixture condition; scores below 80% trigger corrective action plan within 7 days
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 15 min/store</bpmn:documentation>
        <bpmn:incoming>W931_Flow28</bpmn:incoming>
        <bpmn:outgoing>W931_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W931_Task16" name="Monthly: Department Supervisor reviews comfort room supply consumption report —…">
        <bpmn:documentation>Step 10: Monthly: Department Supervisor reviews comfort room supply consumption report — toilet paper, soap, paper towel, cleaning chemical usage per room vs. par level benchmarks; flags stores with &gt;20% over-consumption for investigation (waste, theft, or higher-than-expected traffic)
Responsible (R): Dept. Supervisor
Accountable (A): Store Manager
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W931_Flow29</bpmn:incoming>
        <bpmn:outgoing>W931_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W931_End17" name="Complete">
        <bpmn:incoming>W931_Flow30</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W931_Annotation18">
        <bpmn:text>Controls: - CTL-268 (ensure controlled execution — Customer Amenities &amp; Assistance (PA-09.3).) | - operational: Maintenance / Utility Staff review and approval gate
Owner: Maintenance / Utility Staff</bpmn:text>
      </bpmn:textAnnotation>
