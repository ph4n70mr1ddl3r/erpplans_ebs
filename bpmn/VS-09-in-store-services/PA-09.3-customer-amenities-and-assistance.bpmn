    <bpmn:process id="W_W1239" name="W1239. Store-Level Power Tool Live Demo, Safety Briefing &amp; Customer Engagement Event" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled demo event (weekly or bi-weekly per store) or customer request for product demonstration
Frequency: ~2–4 demo events per store per month; ~400–800 events/month chain-wide
Volume: 200 stores × ~3 events/month = ~600 events/month; ~7,200/year
Owner: Department Supervisor (Tools &amp; Hardware)
Participants: Department Supervisor, Sales Associate, Vendor Promodizer, Customer
Source: workflow W1239 — Store-Level Power Tool Live Demo, Safety Briefing &amp; Customer Engagement Event</bpmn:documentation>
      <bpmn:laneSet id="W1239_LaneSet3">
        <bpmn:lane id="W1239_Lane1" name="Department Supervisor">
        <bpmn:flowNodeRef>W1239_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1239_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1239_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1239_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1239_Lane2" name="Sales Associate">
        <bpmn:flowNodeRef>W1239_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1239_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1239_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1239_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1239_Start4" name="Scheduled demo event (weekly or bi-weekly per store) or customer request for product…">
        <bpmn:outgoing>W1239_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1239_Task5" name="Event planning">
        <bpmn:documentation>Step 1: Event planning: Department Supervisor schedules demo event: (a) coordinate with vendor promodizer per W269 for product availability; (b) select featured products (new arrivals, seasonal bestsellers, high-margin items); (c) prepare demo area (clear space, ensure power supply, set up workbench); (d) prepare safety equipment (safety glasses, ear protection, dust mask per W140); (e) announce event on store PA system per W1121 and social media per W142
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1239_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1239_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1239_Task6" name="Safety briefing">
        <bpmn:documentation>Step 2: Safety briefing: Before demo begins: (a) brief attendees on safety precautions per W140 (eye protection mandatory, secure loose clothing, keep hands clear of blades); (b) identify emergency stop location; (c) brief on fire extinguisher location per W1051; (d) ensure children are supervised
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1239_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1239_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1239_Task7" name="Product demonstration">
        <bpmn:documentation>Step 3: Product demonstration: (a) demonstrate tool features and capabilities; (b) show proper technique (cutting, drilling, sanding); (c) compare models (entry-level vs. professional); (d) demonstrate accessory changes; (e) highlight safety features; (f) answer customer questions
Responsible (R): Sales Associate / Vendor Promodizer
Accountable (A): Department Supervisor
Duration: 20–30 min</bpmn:documentation>
        <bpmn:incoming>W1239_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1239_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1239_Task8" name="Hands-on customer trial">
        <bpmn:documentation>Step 4: Hands-on customer trial: For customers interested: (a) guide customer through supervised trial per W1162 try-before-you-buy; (b) Sales Associate assists with technique; (c) ensure safety equipment worn; (d) answer usage questions
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 5–10 min/customer</bpmn:documentation>
        <bpmn:incoming>W1239_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1239_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1239_Task9" name="Sales conversion">
        <bpmn:documentation>Step 5: Sales conversion: (a) assist customer with model selection based on their needs; (b) recommend accessories and consumables (blades, drill bits, batteries); (c) process sale at POS or trade counter per W112; (d) offer extended warranty registration per W935
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1239_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1239_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1239_Task10" name="Post-event cleanup &amp; reporting">
        <bpmn:documentation>Step 6: Post-event cleanup &amp; reporting: (a) clean and secure demo tools; (b) return demo area to normal; (c) record event attendance, sales generated, and customer feedback; (d) report to Category Manager for vendor coordination per W269
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1239_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1239_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1239_End11" name="Complete">
        <bpmn:incoming>W1239_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1239_Annotation12">
        <bpmn:text>Controls: - CTL-268 (ensure controlled execution — Customer Amenities &amp; Assistance (PA-09.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Department Supervisor (Tools &amp; Hardware)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1239_Assoc13" sourceRef="W1239_Annotation12" targetRef="W1239_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1239_Flow14" sourceRef="W1239_Start4" targetRef="W1239_Task5" />
      <bpmn:sequenceFlow id="W1239_Flow15" sourceRef="W1239_Task5" targetRef="W1239_Task6" />
      <bpmn:sequenceFlow id="W1239_Flow16" sourceRef="W1239_Task6" targetRef="W1239_Task7" />
      <bpmn:sequenceFlow id="W1239_Flow17" sourceRef="W1239_Task7" targetRef="W1239_Task8" />
      <bpmn:sequenceFlow id="W1239_Flow18" sourceRef="W1239_Task8" targetRef="W1239_Task9" />
      <bpmn:sequenceFlow id="W1239_Flow19" sourceRef="W1239_Task9" targetRef="W1239_Task10" />
      <bpmn:sequenceFlow id="W1239_Flow20" sourceRef="W1239_Task10" targetRef="W1239_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1239_diag">
      <bpmndi:BPMNPlane id="W1239_plane" bpmnElement="W_W1239">
        <bpmndi:BPMNShape id="W1239_Lane1_di" bpmnElement="W1239_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1239_Lane2_di" bpmnElement="W1239_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1580" height="170" /></bpmndi:BPMNShape>
