    <bpmn:process id="W_W608" name="W608. Store-Level Customer Feedback Collection &amp; Daily CX Pulse Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Customer completes transaction at POS or visits store
Frequency: Daily per store
Volume: ~467 transactions/store/day; target ~1–2 feedback responses/store/day via random sampling (2% sample × 5–15% response, plus QR walk-ins)
Owner: Store Manager
Participants: Store Manager, Customer Service Counter staff, CX Analyst (HQ)
Source: workflow W608 — Store-Level Customer Feedback Collection &amp; Daily CX Pulse Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W608_LaneSet5">
        <bpmn:lane id="W608_Lane1" name="System">
        <bpmn:flowNodeRef>W608_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W608_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W608_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W608_Lane2" name="CS Counter Staff">
        <bpmn:flowNodeRef>W608_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W608_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W608_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W608_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W608_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W608_Lane4" name="CX Analyst">
        <bpmn:flowNodeRef>W608_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W608_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W608_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W608_Start6" name="Customer completes transaction at POS or visits store">
        <bpmn:outgoing>W608_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W608_Task7" name="System randomly selects ~2% of daily transactions for feedback invitation…">
        <bpmn:documentation>Step 1: System randomly selects ~2% of daily transactions for feedback invitation; customer receives SMS/email survey link 2 hours after transaction (configurable); survey is 3-question micro-survey: overall satisfaction (1-5), recommend likelihood (NPS 0-10), free-text comment
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W608_Flow18</bpmn:incoming>
        <bpmn:outgoing>W608_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W608_Task8" name="In-store: Customer Service Counter displays QR code for instant feedback; BOPIS…">
        <bpmn:documentation>Step 2: In-store: Customer Service Counter displays QR code for instant feedback; BOPIS pickup customers receive feedback prompt at counter
Responsible (R): CS Counter Staff
Accountable (A): —
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W608_Flow19</bpmn:incoming>
        <bpmn:outgoing>W608_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W608_Task9" name="System aggregates daily feedback into CX Pulse dashboard: NPS score…">
        <bpmn:documentation>Step 3: System aggregates daily feedback into CX Pulse dashboard: NPS score, satisfaction rating, sentiment analysis of free-text comments, trending keywords (positive and negative)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W608_Flow20</bpmn:incoming>
        <bpmn:outgoing>W608_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W608_Task10" name="Store Manager reviews CX Pulse dashboard as part of morning routine; focuses…">
        <bpmn:documentation>Step 4: Store Manager reviews CX Pulse dashboard as part of morning routine; focuses on: (a) previous day&#x27;s NPS change, (b) negative feedback requiring follow-up, (c) recurring themes by department
Responsible (R): Store Manager
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W608_Flow21</bpmn:incoming>
        <bpmn:outgoing>W608_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W608_Task11" name="For negative feedback (rating ≤ 2 or NPS detractor): system auto-creates…">
        <bpmn:documentation>Step 5: For negative feedback (rating ≤ 2 or NPS detractor): system auto-creates follow-up task assigned to Store Manager; Store Manager reviews specific transaction details and determines appropriate service recovery action per W604 Step 5
Responsible (R): Store Manager
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W608_Flow22</bpmn:incoming>
        <bpmn:outgoing>W608_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W608_Task12" name="Weekly: Store Manager reviews CX Pulse trend in weekly operations review…">
        <bpmn:documentation>Step 6: Weekly: Store Manager reviews CX Pulse trend in weekly operations review (W575); identifies top 3 customer pain points for the week; assigns corrective actions to Department Supervisors
Responsible (R): Store Manager
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W608_Flow23</bpmn:incoming>
        <bpmn:outgoing>W608_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W608_Task13" name="Monthly: CX Analyst generates store CX benchmark report — NPS by store…">
        <bpmn:documentation>Step 7: Monthly: CX Analyst generates store CX benchmark report — NPS by store, satisfaction by department, feedback volume, response rate, improvement actions completed; identifies top/bottom 10 stores; distributes to Regional Managers
Responsible (R): CX Analyst
Accountable (A): CMO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W608_Flow24</bpmn:incoming>
        <bpmn:outgoing>W608_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W608_Task14" name="Quarterly: CX team reviews feedback pattern analysis feeding into systemic…">
        <bpmn:documentation>Step 8: Quarterly: CX team reviews feedback pattern analysis feeding into systemic improvement workflow (W507); adjusts survey questions based on current CX priorities; reviews survey fatigue metrics and adjusts sampling rate
Responsible (R): CX Analyst
Accountable (A): CMO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W608_Flow25</bpmn:incoming>
        <bpmn:outgoing>W608_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W608_End15" name="Complete">
        <bpmn:incoming>W608_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W608_Annotation16">
        <bpmn:text>Controls: - CTL-266 (ensure controlled execution — Custom Fabrication &amp; Processing (PA-09.1).) | - operational: loyalty points incentive for survey completion and in-store QR code alternative; operational: 30-day cooldown period per customer and rotating survey methods; operational: automated triage (only responses mentioning specific issues trigger follow-up tasks)
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W608_Assoc17" sourceRef="W608_Annotation16" targetRef="W608_Start6" associationDirection="None" />
