    <bpmn:process id="W_W273" name="W273. In-Store Endless Aisle &amp; Vendor Direct-to-Customer Delivery" isExecutable="false">
      <bpmn:documentation>Trigger: Customer wants to purchase an out-of-stock or non-ranged bulky item while physically in the store.
Frequency: Moderate
Volume: ~1–2 per store per week (a subset of the ~3,000–5,000 monthly special orders chain-wide per the canon)
Owner: Store Selling Staff
Participants: Customer, Cashier, Vendor, Ecommerce Fulfillment
Source: workflow W273 — In-Store Endless Aisle &amp; Vendor Direct-to-Customer Delivery</bpmn:documentation>
      <bpmn:laneSet id="W273_LaneSet5">
        <bpmn:lane id="W273_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W273_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W273_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W273_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W273_Lane2" name="Cashier">
        <bpmn:flowNodeRef>W273_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W273_Lane3" name="System">
        <bpmn:flowNodeRef>W273_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W273_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W273_Lane4" name="Vendor">
        <bpmn:flowNodeRef>W273_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W273_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W273_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W273_Start6" name="Customer wants to purchase an out-of-stock or non-ranged bulky item while physically in…">
        <bpmn:outgoing>W273_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W273_Task7" name="Sales Associate helps customer browse the extended catalog (Endless Aisle) on…">
        <bpmn:documentation>Step 1: Sales Associate helps customer browse the extended catalog (Endless Aisle) on in-store tablet or POS kiosk, checking vendor real-time inventory (ECOM-001)
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W273_Flow17</bpmn:incoming>
        <bpmn:outgoing>W273_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W273_Task8" name="Associate creates a Drop-Ship Sales Order in the system, linked to the…">
        <bpmn:documentation>Step 2: Associate creates a Drop-Ship Sales Order in the system, linked to the customer&#x27;s profile (W156) and the selected vendor/SKU
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W273_Flow18</bpmn:incoming>
        <bpmn:outgoing>W273_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W273_Task9" name="Customer pays at the physical POS — cashier processes as &quot;Endless Aisle /…">
        <bpmn:documentation>Step 3: Customer pays at the physical POS — cashier processes as &quot;Endless Aisle / Special Order&quot; tender type
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W273_Flow19</bpmn:incoming>
        <bpmn:outgoing>W273_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W273_Task10" name="System auto-generates a Drop-Ship Purchase Order (W38) to the vendor with…">
        <bpmn:documentation>Step 4: System auto-generates a Drop-Ship Purchase Order (W38) to the vendor with customer delivery address and expected delivery date
Responsible (R): System
Accountable (A): Purchasing Dept
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W273_Flow20</bpmn:incoming>
        <bpmn:outgoing>W273_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W273_Task11" name="Vendor picks, packs, and ships directly to the customer&#x27;s home; system sends…">
        <bpmn:documentation>Step 5: Vendor picks, packs, and ships directly to the customer&#x27;s home; system sends tracking SMS/email to customer
Responsible (R): Vendor / 3PL
Accountable (A): Logistics
Duration: 1-5 days</bpmn:documentation>
        <bpmn:incoming>W273_Flow21</bpmn:incoming>
        <bpmn:outgoing>W273_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W273_Task12" name="Upon delivery, customer signs POD (Proof of Delivery); vendor uploads to…">
        <bpmn:documentation>Step 6: Upon delivery, customer signs POD (Proof of Delivery); vendor uploads to BuildRight portal
Responsible (R): Vendor
Accountable (A): AP Clerk
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W273_Flow22</bpmn:incoming>
        <bpmn:outgoing>W273_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W273_Task13" name="System 3-way matches: POS payment ↔ Drop-Ship PO ↔ Vendor invoice + POD…">
        <bpmn:documentation>Step 7: System 3-way matches: POS payment ↔ Drop-Ship PO ↔ Vendor invoice + POD; settles vendor payment per W7
Responsible (R): System
Accountable (A): AP Clerk
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W273_Flow23</bpmn:incoming>
        <bpmn:outgoing>W273_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W273_End14" name="Complete">
        <bpmn:incoming>W273_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W273_Annotation15">
        <bpmn:text>Controls: - CTL-266 (ensure controlled execution — Custom Fabrication &amp; Processing (PA-09.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Store Selling Staff</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W273_Assoc16" sourceRef="W273_Annotation15" targetRef="W273_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W273_Flow17" sourceRef="W273_Start6" targetRef="W273_Task7" />
      <bpmn:sequenceFlow id="W273_Flow18" sourceRef="W273_Task7" targetRef="W273_Task8" />
      <bpmn:sequenceFlow id="W273_Flow19" sourceRef="W273_Task8" targetRef="W273_Task9" />
      <bpmn:sequenceFlow id="W273_Flow20" sourceRef="W273_Task9" targetRef="W273_Task10" />
      <bpmn:sequenceFlow id="W273_Flow21" sourceRef="W273_Task10" targetRef="W273_Task11" />
      <bpmn:sequenceFlow id="W273_Flow22" sourceRef="W273_Task11" targetRef="W273_Task12" />
      <bpmn:sequenceFlow id="W273_Flow23" sourceRef="W273_Task12" targetRef="W273_Task13" />
      <bpmn:sequenceFlow id="W273_Flow24" sourceRef="W273_Task13" targetRef="W273_End14" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W273_diag">
      <bpmndi:BPMNPlane id="W273_plane" bpmnElement="W_W273">
        <bpmndi:BPMNShape id="W273_Lane1_di" bpmnElement="W273_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
