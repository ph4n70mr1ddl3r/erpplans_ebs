      <bpmn:sequenceFlow id="W943_Flow14" sourceRef="W943_Task4" targetRef="W943_Task5" />
      <bpmn:sequenceFlow id="W943_Flow15" sourceRef="W943_Task5" targetRef="W943_Task6" />
      <bpmn:sequenceFlow id="W943_Flow16" sourceRef="W943_Task6" targetRef="W943_Task7" />
      <bpmn:sequenceFlow id="W943_Flow17" sourceRef="W943_Task7" targetRef="W943_Task8" />
      <bpmn:sequenceFlow id="W943_Flow18" sourceRef="W943_Task8" targetRef="W943_Task9" />
      <bpmn:sequenceFlow id="W943_Flow19" sourceRef="W943_Task9" targetRef="W943_End10" />
    </bpmn:process>
