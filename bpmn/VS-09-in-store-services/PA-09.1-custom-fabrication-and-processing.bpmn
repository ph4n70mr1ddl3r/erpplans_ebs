    <bpmn:process id="W_W1150" name="W1150. Store-Level Customer Lumber &amp; Plywood Moisture Content Testing &amp; Quality Verification" isExecutable="false">
      <bpmn:documentation>Trigger: Customer requests moisture content verification for lumber or plywood purchase, or receiving inspection identifies potential moisture damage, or routine quality sampling
Frequency: ~1,500–2,500 moisture tests/month across all stores (higher during rainy season)
Volume: 1–10 boards/sheets per test
Owner: Department Supervisor (Lumber &amp; Building Materials)
Participants: Sales Associate (Lumber Yard), Customer
Source: workflow W1150 — Store-Level Customer Lumber &amp; Plywood Moisture Content Testing &amp; Quality Verification</bpmn:documentation>
      <bpmn:laneSet id="W1150_LaneSet3">
        <bpmn:lane id="W1150_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W1150_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1150_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1150_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1150_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1150_Lane2" name="System">
        <bpmn:flowNodeRef>W1150_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1150_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1150_Start4" name="Customer requests moisture content verification for lumber or plywood purchase, or…">
        <bpmn:outgoing>W1150_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1150_Task5" name="Customer Moisture Test Request">
        <bpmn:documentation>Step 1: Customer Moisture Test Request: (a) customer selects lumber or plywood from yard display; (b) customer requests moisture content test, or sales associate proactively offers test for structural-grade lumber; (c) sales associate retrieves pin-type moisture meter from tool station; (d) selects appropriate test setting on meter: softwood, hardwood, or plywood mode
Responsible (R): Sales Associate
Accountable (A): Sales Associate
Duration: 1–2 min</bpmn:documentation>
        <bpmn:incoming>W1150_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1150_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1150_Task6" name="Moisture Content Measurement">
        <bpmn:documentation>Step 2: Moisture Content Measurement: (a) sales associate inserts meter pins into wood surface at 2–3 points along the board length (middle and both ends); (b) meter displays moisture content percentage; (c) associate records readings in mobile ERP app linked to the specific board/batch; (d) moisture content interpreted against standards: kiln-dried lumber: target 12–18% (acceptable), 18–22% (borderline — advise customer to acclimate before use), &gt;22% (too wet — do not sell as kiln-dried, offer as air-dried at reduced price); plywood: target ≤14% (acceptable), 14–18% (borderline), &gt;18% (potential delamination risk — do not sell for structural use); (e) associate communicates results to customer with explanation of implications
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 3–5 min</bpmn:documentation>
        <bpmn:incoming>W1150_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1150_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1150_Task7" name="Quality Grading &amp; Pricing Adjustment">
        <bpmn:documentation>Step 3: Quality Grading &amp; Pricing Adjustment: (a) if moisture content is within acceptable range: board sold at standard kiln-dried price with moisture reading noted on sales receipt; (b) if moisture content is borderline: customer informed and given option to purchase at standard price with advisory to acclimate wood before installation, or select a different board; (c) if moisture content is excessive: board reclassified from &quot;kiln-dried&quot; to &quot;air-dried/green&quot; in system with corresponding markdown (10–20% discount per W93); (d) if board shows visible defects (warping, mold, delamination): quarantined and dispositioned per W91 (damaged goods)
Responsible (R): Sales Associate / System
Accountable (A): Department Supervisor
Duration: 2–3 min</bpmn:documentation>
        <bpmn:incoming>W1150_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1150_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1150_Task8" name="Batch-Level Quality Tracking">
        <bpmn:documentation>Step 4: Batch-Level Quality Tracking: (a) moisture readings aggregated by supplier batch/lot for quality tracking; (b) batches with consistently high moisture content (&gt;25% of readings above threshold) flagged for vendor feedback per W110 (supplier quality CAPA); (c) seasonal moisture trend analysis: during rainy season (June–November), expect higher moisture readings → adjust storage practices (cover lumber stacks, improve ventilation); (d) monthly lumber quality report generated: average moisture by species and grade, moisture-related markdown cost, vendor quality scores
Responsible (R): System / Department Supervisor
Accountable (A): Store Manager
Duration: Automated + 30 min/month review</bpmn:documentation>
        <bpmn:incoming>W1150_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1150_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1150_End9" name="Complete">
        <bpmn:incoming>W1150_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1150_Annotation10">
        <bpmn:text>Controls: - CTL-266 (ensure controlled execution — Custom Fabrication &amp; Processing (PA-09.1).) | - operational: weekly
Owner: Department Supervisor (Lumber &amp; Building Materials)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1150_Assoc11" sourceRef="W1150_Annotation10" targetRef="W1150_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1150_Flow12" sourceRef="W1150_Start4" targetRef="W1150_Task5" />
      <bpmn:sequenceFlow id="W1150_Flow13" sourceRef="W1150_Task5" targetRef="W1150_Task6" />
      <bpmn:sequenceFlow id="W1150_Flow14" sourceRef="W1150_Task6" targetRef="W1150_Task7" />
      <bpmn:sequenceFlow id="W1150_Flow15" sourceRef="W1150_Task7" targetRef="W1150_Task8" />
      <bpmn:sequenceFlow id="W1150_Flow16" sourceRef="W1150_Task8" targetRef="W1150_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1150_diag">
      <bpmndi:BPMNPlane id="W1150_plane" bpmnElement="W_W1150">
        <bpmndi:BPMNShape id="W1150_Lane1_di" bpmnElement="W1150_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
