    <bpmn:process id="W_W604" name="W604. Store-Level Customer Experience Standards &amp; Daily Service Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Store operating hours begin (part of W5A store opening)
Frequency: Daily per store
Volume: ~14,000 customer transactions per store per month; ~467 per day
Owner: Store Manager
Participants: Store Manager, Department Supervisors, all customer-facing staff, Customer Service Counter staff
Source: workflow W604 — Store-Level Customer Experience Standards &amp; Daily Service Operations</bpmn:documentation>
      <bpmn:laneSet id="W604_LaneSet7">
        <bpmn:lane id="W604_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W604_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W604_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W604_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W604_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W604_Lane2" name="Dept. Supervisor">
        <bpmn:flowNodeRef>W604_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W604_Lane3" name="All Staff">
        <bpmn:flowNodeRef>W604_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W604_Lane4" name="CS Counter Staff">
        <bpmn:flowNodeRef>W604_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W604_Lane5" name="Frontline Staff">
        <bpmn:flowNodeRef>W604_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W604_Lane6" name="System">
        <bpmn:flowNodeRef>W604_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W604_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W604_Start8" name="Store operating hours begin (part of W5A store opening)">
        <bpmn:outgoing>W604_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W604_Task9" name="Store Manager or Assistant Store Manager conducts 5-minute CX briefing during…">
        <bpmn:documentation>Step 1: Store Manager or Assistant Store Manager conducts 5-minute CX briefing during morning huddle: highlights today&#x27;s CX focus (greeting standard, wait time, service recovery from yesterday&#x27;s issues); shares one CX success story
Responsible (R): Store Manager
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W604_Flow20</bpmn:incoming>
        <bpmn:outgoing>W604_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W604_Task10" name="Department Supervisors verify CX touchpoints are ready: checkout areas clean…">
        <bpmn:documentation>Step 2: Department Supervisors verify CX touchpoints are ready: checkout areas clean and organized, customer service counter staffed, returns area clear, BOPIS pickup zone staged, promotional signage accurate
Responsible (R): Dept. Supervisor
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W604_Flow21</bpmn:incoming>
        <bpmn:outgoing>W604_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W604_Task11" name="Throughout the day: customer-facing staff execute CX standards — greeting…">
        <bpmn:documentation>Step 3: Throughout the day: customer-facing staff execute CX standards — greeting within 10 seconds of customer entering department, proactive offer of assistance, product knowledge support, and farewell at checkout
Responsible (R): All Staff
Accountable (A): Dept. Supervisor
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W604_Flow22</bpmn:incoming>
        <bpmn:outgoing>W604_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W604_Task12" name="Customer Service Counter: staff handle walk-in inquiries, returns (W12), BOPIS…">
        <bpmn:documentation>Step 4: Customer Service Counter: staff handle walk-in inquiries, returns (W12), BOPIS pickups (W11), special orders (W545), warranty claims (W33), and complaints (W41) per SLA targets; system tracks queue wait times
Responsible (R): CS Counter Staff
Accountable (A): Store Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W604_Flow23</bpmn:incoming>
        <bpmn:outgoing>W604_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W604_Task13" name="Service recovery">
        <bpmn:documentation>Step 5: Service recovery: when a customer expresses dissatisfaction (complaint, long wait, stock-out): (a) frontline staff acknowledges immediately, (b) offers immediate resolution per empowerment guidelines (10% discount, free delivery, expedited order), (c) if unresolved, escalates to Department Supervisor then Store Manager, (d) system logs service recovery action
Responsible (R): Frontline Staff
Accountable (A): Store Manager
Duration: 5-15 min</bpmn:documentation>
        <bpmn:incoming>W604_Flow24</bpmn:incoming>
        <bpmn:outgoing>W604_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W604_Task14" name="Mid-day: Store Manager walks sales floor for 15-minute CX observation — staff…">
        <bpmn:documentation>Step 6: Mid-day: Store Manager walks sales floor for 15-minute CX observation — staff greeting compliance, department appearance, customer queue lengths, bathroom cleanliness, parking lot order
Responsible (R): Store Manager
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W604_Flow25</bpmn:incoming>
        <bpmn:outgoing>W604_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W604_Task15" name="End of day: system generates CX daily dashboard — average queue wait time…">
        <bpmn:documentation>Step 7: End of day: system generates CX daily dashboard — average queue wait time, service recovery count, customer feedback scores (if collected via W608), BOPIS pickup SLA compliance, complaint count
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W604_Flow26</bpmn:incoming>
        <bpmn:outgoing>W604_Flow27</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W604_Task16" name="Weekly: Store Manager reviews CX metrics in weekly operations review (W575)…">
        <bpmn:documentation>Step 8: Weekly: Store Manager reviews CX metrics in weekly operations review (W575); identifies departments needing CX improvement; assigns CX coaching targets
Responsible (R): Store Manager
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W604_Flow27</bpmn:incoming>
        <bpmn:outgoing>W604_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W604_End17" name="Complete">
        <bpmn:incoming>W604_Flow28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W604_Annotation18">
        <bpmn:text>Controls: - CTL-266 (ensure controlled execution — Custom Fabrication &amp; Processing (PA-09.1).) | - operational: morning briefing, mid-day walkthrough, and mystery shopping program (W566); operational: clear empowerment matrix and system-enforced authorization tiers; operational: rotating feedback methods (SMS survey, QR code, in-app) and limiting to random sample
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W604_Assoc19" sourceRef="W604_Annotation18" targetRef="W604_Start8" associationDirection="None" />
