      <bpmndi:BPMNPlane id="W1063_plane" bpmnElement="W_W1063">
        <bpmndi:BPMNShape id="W1063_Lane1_di" bpmnElement="W1063_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
