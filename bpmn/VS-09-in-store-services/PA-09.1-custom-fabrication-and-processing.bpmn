    <bpmn:process id="W_W607" name="W607. Store-Level Product Demo &amp; Trial Station Daily Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Store operating hours begin; part of daily store operations
Frequency: Daily per store
Volume: ~2–4 demo stations per store (power tool testing, paint mixing, tile/lumber cutting, appliance testing)
Owner: Department Supervisor
Participants: Department Supervisor, Sales Associate, Stock Associate, Maintenance Staff
Source: workflow W607 — Store-Level Product Demo &amp; Trial Station Daily Operations</bpmn:documentation>
      <bpmn:laneSet id="W607_LaneSet4">
        <bpmn:lane id="W607_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W607_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W607_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W607_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W607_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W607_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W607_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W607_Lane2" name="Dept. Supervisor">
        <bpmn:flowNodeRef>W607_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W607_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W607_Lane3" name="Category Manager">
        <bpmn:flowNodeRef>W607_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W607_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W607_Start5" name="Store operating hours begin; part of daily store operations">
        <bpmn:outgoing>W607_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W607_Task6" name="Sales Associate powers on demo stations during store opening (W5A); verifies…">
        <bpmn:documentation>Step 1: Sales Associate powers on demo stations during store opening (W5A); verifies equipment operational — power tool testing station (drill, sander, circular saw with safety guards), paint mixing station (colorant levels, tinting machine calibration), appliance display (plugged in, functioning)
Responsible (R): Sales Associate
Accountable (A): Dept. Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W607_Flow17</bpmn:incoming>
        <bpmn:outgoing>W607_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W607_Task7" name="Sales Associate verifies demo station supplies: safety goggles and ear…">
        <bpmn:documentation>Step 2: Sales Associate verifies demo station supplies: safety goggles and ear protection available, test material stock (wood scraps for cutting station, paint sample cards, tile samples for display), product information brochures stocked
Responsible (R): Sales Associate
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W607_Flow18</bpmn:incoming>
        <bpmn:outgoing>W607_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W607_Task8" name="Throughout the day: Sales Associate conducts product demonstrations for…">
        <bpmn:documentation>Step 3: Throughout the day: Sales Associate conducts product demonstrations for interested customers; demonstrates power tool features, explains paint mixing options (W168), shows appliance features; logs demonstration count in system for vendor reporting
Responsible (R): Sales Associate
Accountable (A): —
Duration: 5-15 min/demo</bpmn:documentation>
        <bpmn:incoming>W607_Flow19</bpmn:incoming>
        <bpmn:outgoing>W607_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W607_Task9" name="Customer trial: Sales Associate supervises customer hands-on trial with…">
        <bpmn:documentation>Step 4: Customer trial: Sales Associate supervises customer hands-on trial with mandatory safety briefing (eye protection, proper grip, emergency shutoff location); customer signs trial waiver for power tools
Responsible (R): Sales Associate
Accountable (A): Dept. Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W607_Flow20</bpmn:incoming>
        <bpmn:outgoing>W607_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W607_Task10" name="Mid-day: Department Supervisor spot-checks demo stations for cleanliness…">
        <bpmn:documentation>Step 5: Mid-day: Department Supervisor spot-checks demo stations for cleanliness, safety compliance, and supply levels; replenishes test materials as needed
Responsible (R): Dept. Supervisor
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W607_Flow21</bpmn:incoming>
        <bpmn:outgoing>W607_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W607_Task11" name="End of day: Sales Associate powers down demo equipment; cleans station; secures…">
        <bpmn:documentation>Step 6: End of day: Sales Associate powers down demo equipment; cleans station; secures power tools in locked cabinet; records demo station usage count and any equipment issues in system
Responsible (R): Sales Associate
Accountable (A): Dept. Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W607_Flow22</bpmn:incoming>
        <bpmn:outgoing>W607_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W607_Task12" name="Weekly: Department Supervisor reviews demo station usage analytics and sales…">
        <bpmn:documentation>Step 7: Weekly: Department Supervisor reviews demo station usage analytics and sales conversion rate (demos conducted → products sold); identifies underperforming stations for repositioning or removal; reports to Store Manager
Responsible (R): Dept. Supervisor
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W607_Flow23</bpmn:incoming>
        <bpmn:outgoing>W607_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W607_Task13" name="Monthly: Merchandising team reviews demo station effectiveness across 200…">
        <bpmn:documentation>Step 8: Monthly: Merchandising team reviews demo station effectiveness across 200 stores; updates demo product selection based on new arrivals (W564) and seasonal trends; coordinates with vendor for demo unit replacement per W524
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W607_Flow24</bpmn:incoming>
        <bpmn:outgoing>W607_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W607_End14" name="Complete">
        <bpmn:incoming>W607_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W607_Annotation15">
        <bpmn:text>Controls: - CTL-266 (ensure controlled execution — Custom Fabrication &amp; Processing (PA-09.1).) | - operational: mandatory safety briefing, safety equipment provision, and customer trial waiver; operational: scheduled preventive maintenance and quarterly demo unit replacement program
Owner: Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
