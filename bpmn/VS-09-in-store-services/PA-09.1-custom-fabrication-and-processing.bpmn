      <bpmn:sequenceFlow id="W608_Flow21" sourceRef="W608_Task9" targetRef="W608_Task10" />
      <bpmn:sequenceFlow id="W608_Flow22" sourceRef="W608_Task10" targetRef="W608_Task11" />
      <bpmn:sequenceFlow id="W608_Flow23" sourceRef="W608_Task11" targetRef="W608_Task12" />
      <bpmn:sequenceFlow id="W608_Flow24" sourceRef="W608_Task12" targetRef="W608_Task13" />
      <bpmn:sequenceFlow id="W608_Flow25" sourceRef="W608_Task13" targetRef="W608_Task14" />
      <bpmn:sequenceFlow id="W608_Flow26" sourceRef="W608_Task14" targetRef="W608_End15" />
    </bpmn:process>
