    <bpmn:process id="W_W954" name="W954. Customer Delivery &amp; Installation Quality Follow-Up Verification" isExecutable="false">
      <bpmn:documentation>Trigger: Delivery confirmed (W19, W668) or installation completed (W138) — system triggers post-service follow-up
Frequency: ~24,000–29,000 follow-ups/month (covering ~17,200 ecommerce home deliveries + 5,000–8,000 in-store delivery orders + 2,200–3,500 installations)
Volume: 1 follow-up per delivery/installation event
Owner: Customer Experience Manager
Participants: Customer, Customer Service Representative, Installation Technician, Category Manager (quality issues), Store Manager (delivery issues)
Source: workflow W954 — Customer Delivery &amp; Installation Quality Follow-Up Verification</bpmn:documentation>
      <bpmn:laneSet id="W954_LaneSet5">
        <bpmn:lane id="W954_Lane1" name="System">
        <bpmn:flowNodeRef>W954_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W954_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W954_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W954_Lane2" name="Customer">
        <bpmn:flowNodeRef>W954_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W954_Lane3" name="Customer Service Rep">
        <bpmn:flowNodeRef>W954_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W954_Lane4" name="Customer Experience Manager">
        <bpmn:flowNodeRef>W954_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W954_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W954_Start6" name="Delivery confirmed (W19, W668) or installation completed (W138) — system triggers…">
        <bpmn:outgoing>W954_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W954_Task7" name="Automated Follow-Up Trigger">
        <bpmn:documentation>Step 1: Automated Follow-Up Trigger: System detects delivery confirmation (proof-of-delivery scanned per W592) or installation completion (technician signs off in system per W138); 24 hours after delivery/installation: system sends automated follow-up via: (a) SMS — brief quality check (3 questions) with link to mobile app survey; (b) email — detailed satisfaction survey with photo upload capability; (c) mobile app push notification — quick rating (1–5 stars) + optional feedback text; customer selects preferred channel from profile settings
Responsible (R): System
Accountable (A): Customer Experience Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W954_Flow15</bpmn:incoming>
        <bpmn:outgoing>W954_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W954_Task8" name="Customer Response Collection">
        <bpmn:documentation>Step 2: Customer Response Collection: Customer responds: (a) positive response (4–5 stars, no issues reported) → system sends thank-you message, offers related product recommendations, and credits loyalty points (25 points for survey completion); triggers review solicitation (W510) for positive experiences; (b) neutral response (3 stars, no specific issues) → system sends thank-you and invites detailed feedback; Customer Service Representative reviews within 48 hours; (c) negative response (1–2 stars OR specific issue reported) → immediately escalated to Customer Service Representative for live follow-up per step 3
Responsible (R): Customer / System
Accountable (A): Customer Experience Manager
Duration: 2–5 min (customer)</bpmn:documentation>
        <bpmn:incoming>W954_Flow16</bpmn:incoming>
        <bpmn:outgoing>W954_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W954_Task9" name="Issue Resolution Follow-Up">
        <bpmn:documentation>Step 3: Issue Resolution Follow-Up: For negative responses: (a) Customer Service Representative calls customer within 4 hours of negative response during business hours; (b) documents issue: delivery damage, wrong item, missing item, installation quality, installation behavior/professionalism, timing/punctuality; (c) categorizes issue per root cause taxonomy (delivery, installation, product, logistics); (d) resolves or escalates: (i) delivery damage → claim per W860 insurance or W91 disposition; (ii) wrong/missing item → replacement per W12 returns; (iii) installation quality → service rework per W795; (iv) technician behavior → escalated to the Installation Services Coordinator per W600 contractor management; (e) resolution tracked per W597 SLA (target: 48-hour resolution for delivery issues, 72-hour for installation issues)
Responsible (R): Customer Service Rep
Accountable (A): Customer Experience Manager
Duration: 15–30 min/case</bpmn:documentation>
        <bpmn:incoming>W954_Flow17</bpmn:incoming>
        <bpmn:outgoing>W954_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W954_Task10" name="Quality Data Aggregation &amp; Vendor/Technician Scorecard">
        <bpmn:documentation>Step 4: Quality Data Aggregation &amp; Vendor/Technician Scorecard: (a) weekly: system aggregates follow-up data by: delivery partner, installation technician, product category, store, region; (b) delivery partner scorecard: on-time rate, damage rate, customer satisfaction score, POD compliance; shared with delivery partners per W242 performance review; (c) installation technician scorecard: quality rating, rework rate, professionalism score, timeliness; feeds into W600 contractor accreditation; (d) product category quality: identifies products with high damage-in-transit rates for packaging improvement review with Category Manager
Responsible (R): System / Customer Experience Manager
Accountable (A): Head of Trade / Account Management / COO
Duration: 2–3 hours/week</bpmn:documentation>
        <bpmn:incoming>W954_Flow18</bpmn:incoming>
        <bpmn:outgoing>W954_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W954_Task11" name="Monthly CX Reporting &amp; Continuous Improvement">
        <bpmn:documentation>Step 5: Monthly CX Reporting &amp; Continuous Improvement: Monthly report to C-suite: (a) follow-up response rate (target: ≥ 40%); (b) CSAT score for deliveries and installations; (c) top 5 issues by frequency and severity; (d) resolution rate and time; (e) delivery partner and technician rankings; (f) trend analysis (month-over-month, quarter-over-quarter); findings feed into: (i) delivery partner contract renewal per W62B; (ii) installation technician accreditation per W600; (iii) product packaging improvement per Category Manager; (iv) store operations improvement per W575 weekly review
Responsible (R): Customer Experience Manager
Accountable (A): CMO / COO
Duration: 3–4 hours/month</bpmn:documentation>
        <bpmn:incoming>W954_Flow19</bpmn:incoming>
        <bpmn:outgoing>W954_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W954_End12" name="Complete">
        <bpmn:incoming>W954_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W954_Annotation13">
        <bpmn:text>Controls: - CTL-266 (ensure controlled execution — Custom Fabrication &amp; Processing (PA-09.1).) | - operational: Customer Experience Manager review and approval gate
Owner: Customer Experience Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W954_Assoc14" sourceRef="W954_Annotation13" targetRef="W954_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W954_Flow15" sourceRef="W954_Start6" targetRef="W954_Task7" />
      <bpmn:sequenceFlow id="W954_Flow16" sourceRef="W954_Task7" targetRef="W954_Task8" />
      <bpmn:sequenceFlow id="W954_Flow17" sourceRef="W954_Task8" targetRef="W954_Task9" />
      <bpmn:sequenceFlow id="W954_Flow18" sourceRef="W954_Task9" targetRef="W954_Task10" />
      <bpmn:sequenceFlow id="W954_Flow19" sourceRef="W954_Task10" targetRef="W954_Task11" />
      <bpmn:sequenceFlow id="W954_Flow20" sourceRef="W954_Task11" targetRef="W954_End12" />
    </bpmn:process>
