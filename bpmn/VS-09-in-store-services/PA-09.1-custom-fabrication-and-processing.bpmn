    <bpmn:process id="W_W1104" name="W1104. Customer Tool Rental Return Damage Assessment &amp; Billing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer returns a rented tool or equipment at the store customer service counter
Frequency: ~3,000–4,000 rental returns/month across all stores (complement to W139 tool rental operations)
Volume: 1–3 tools per return transaction
Owner: Customer Service Representative
Participants: Customer Service Representative, Department Supervisor (Tools), Customer
Source: workflow W1104 — Customer Tool Rental Return Damage Assessment &amp; Billing</bpmn:documentation>
      <bpmn:laneSet id="W1104_LaneSet3">
        <bpmn:lane id="W1104_Lane1" name="Customer Service Representative">
        <bpmn:flowNodeRef>W1104_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1104_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1104_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1104_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1104_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1104_Lane2" name="Stock Associate">
        <bpmn:flowNodeRef>W1104_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1104_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1104_Start4" name="Customer returns a rented tool or equipment at the store customer service counter">
        <bpmn:outgoing>W1104_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1104_Task5" name="Rental Record Retrieval &amp; Pre-Return Verification">
        <bpmn:documentation>Step 1: Rental Record Retrieval &amp; Pre-Return Verification: (a) Customer Service Representative (CSR) scans the customer&#x27;s rental agreement barcode or looks up by loyalty card/phone number; (b) system displays: tool ID, tool description, rental start date/time, agreed return date/time, rental rate, security deposit amount, pre-rental condition notes, and photos of tool at issuance; (c) CSR verifies customer identity (government ID matching rental agreement); (d) system auto-calculates elapsed rental time and any overdue charges: overdue rate = 1.5× standard daily rate per day late
Responsible (R): Customer Service Representative
Accountable (A): Customer Service Representative
Duration: 3–5 min</bpmn:documentation>
        <bpmn:incoming>W1104_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1104_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1104_Task6" name="Physical Tool Inspection &amp; Condition Comparison">
        <bpmn:documentation>Step 2: Physical Tool Inspection &amp; Condition Comparison: CSR inspects returned tool against pre-rental condition: (a) visual inspection for new scratches, dents, cracks, or missing parts; (b) functional test: power on, run for 30 seconds, check for unusual noise or vibration; (c) accessory check: verify all accessories listed at issuance are returned (blades, bits, chargers, batteries, cables, manuals, carrying case); (d) cleanliness check: tool should be returned free of excessive concrete dust, paint, or mud (reasonable use debris is acceptable); (e) for electrical tools: inspect cord for cuts, check plug integrity; (f) for gas-powered equipment: check fuel level (should be returned with minimum fuel), oil condition; (g) for scaffolding: verify all pins, braces, and platforms are present and undamaged; (h) CSR photographs any damage or missing items using store tablet
Responsible (R): Customer Service Representative
Accountable (A): Department Supervisor (Tools)
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W1104_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1104_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1104_Task7" name="Damage Classification &amp; Assessment">
        <bpmn:documentation>Step 3: Damage Classification &amp; Assessment: CSR classifies tool condition: (a) Normal Wear — minor cosmetic scratches, expected consumable wear (blade dulling, brush wear), dust/debris from normal use → no additional charge; (b) Minor Damage — small dent, scuffed housing, missing low-value accessory (screw, washer) → flat PHP 150–500 cleaning/minor repair surcharge; (c) Moderate Damage — cracked housing, damaged cord, bent blade, broken accessory → repair cost estimate generated by system based on tool type and damage code, typically PHP 500–2,000; (d) Major Damage — motor burnout, cracked frame, missing major component (battery, blade guard) → full repair or replacement cost, capped at the tool&#x27;s current replacement value; (e) Total Loss — tool returned non-functional, submerged in water, dropped from height, or stolen → security deposit forfeited + additional charge up to replacement value per rental agreement terms. For categories (c)–(e), Department Supervisor is called for visual confirmation and approval
Responsible (R): Customer Service Representative
Accountable (A): Department Supervisor (Tools)
Duration: 5–8 min</bpmn:documentation>
        <bpmn:incoming>W1104_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1104_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1104_Task8" name="Security Deposit Settlement &amp; Additional Billing">
        <bpmn:documentation>Step 4: Security Deposit Settlement &amp; Additional Billing: (a) system calculates final bill: base rental charge + overdue charges (if any) + damage surcharge (if any) - security deposit held; (b) if net amount is positive (customer owes more): customer pays balance via POS (W5B); (c) if net amount is negative (deposit exceeds charges): refund processed to original payment method per W101 (customer refund processing), or issued as store credit per W781; (d) system generates itemized rental return receipt with condition assessment details; (e) customer signs digital acknowledgment of return condition; (f) if customer disputes damage assessment, escalate to Store Manager per dispute resolution hierarchy
Responsible (R): Customer Service Representative / POS
Accountable (A): Department Supervisor (Tools)
Duration: 5–7 min</bpmn:documentation>
        <bpmn:incoming>W1104_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1104_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1104_Task9" name="Post-Return Tool Reconditioning &amp; Availability Update">
        <bpmn:documentation>Step 5: Post-Return Tool Reconditioning &amp; Availability Update: (a) tool placed in designated &quot;inspection/reconditioning&quot; area in backroom; (b) if Normal Wear: CSR cleans tool (compressed air, wipe down), functional test confirmation, return to rental shelf; system updates tool status to &quot;Available&quot;; (c) if Minor/Moderate Damage: tool sent to in-store repair station (W440 — power tool service &amp; repair center) with damage assessment form; system updates status to &quot;In Repair&quot; with estimated availability date; (d) if Major Damage / Total Loss: tool dispositioned per W91 (damaged goods disposition) if uneconomical to repair, or sent to vendor for factory refurbishment; insurance claim filed per W859 (vehicle &amp; fleet insurance) if rental tool is covered under rental equipment policy; (e) system tracks repair turnaround time and updates rental availability calendar
Responsible (R): Stock Associate / CSR
Accountable (A): Department Supervisor (Tools)
Duration: 10–20 min (for normal wear); varies for repair</bpmn:documentation>
        <bpmn:incoming>W1104_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1104_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1104_End10" name="Complete">
        <bpmn:incoming>W1104_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1104_Annotation11">
        <bpmn:text>Controls: - CTL-266 (ensure controlled execution — Custom Fabrication &amp; Processing (PA-09.1).) | - operational: Customer Service Representative review and approval gate
Owner: Customer Service Representative</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1104_Assoc12" sourceRef="W1104_Annotation11" targetRef="W1104_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1104_Flow13" sourceRef="W1104_Start4" targetRef="W1104_Task5" />
      <bpmn:sequenceFlow id="W1104_Flow14" sourceRef="W1104_Task5" targetRef="W1104_Task6" />
      <bpmn:sequenceFlow id="W1104_Flow15" sourceRef="W1104_Task6" targetRef="W1104_Task7" />
      <bpmn:sequenceFlow id="W1104_Flow16" sourceRef="W1104_Task7" targetRef="W1104_Task8" />
      <bpmn:sequenceFlow id="W1104_Flow17" sourceRef="W1104_Task8" targetRef="W1104_Task9" />
      <bpmn:sequenceFlow id="W1104_Flow18" sourceRef="W1104_Task9" targetRef="W1104_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1104_diag">
      <bpmndi:BPMNPlane id="W1104_plane" bpmnElement="W_W1104">
        <bpmndi:BPMNShape id="W1104_Lane1_di" bpmnElement="W1104_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1104_Lane2_di" bpmnElement="W1104_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1104_Task5_di" bpmnElement="W1104_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1104_Task6_di" bpmnElement="W1104_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1104_Task7_di" bpmnElement="W1104_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1104_Task8_di" bpmnElement="W1104_Task8"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1104_Task9_di" bpmnElement="W1104_Task9"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1104_Start4_di" bpmnElement="W1104_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1104_End10_di" bpmnElement="W1104_End10"><dc:Bounds x="1470" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1104_Annotation11_di" bpmnElement="W1104_Annotation11"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1104_Flow13_di" bpmnElement="W1104_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1104_Flow14_di" bpmnElement="W1104_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1104_Flow15_di" bpmnElement="W1104_Flow15"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1104_Flow16_di" bpmnElement="W1104_Flow16"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1104_Flow17_di" bpmnElement="W1104_Flow17"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1104_Flow18_di" bpmnElement="W1104_Flow18"><di:waypoint x="1420" y="335" /><di:waypoint x="1470" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1104_Assoc12_di" bpmnElement="W1104_Assoc12"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1109" name="W1109. Customer Project Material Surplus Buy-Back &amp; Recycling Program" isExecutable="false">
      <bpmn:documentation>Trigger: Customer brings unused/surplus building materials to store for buy-back, or customer requests a project completion surplus pickup
Frequency: ~3,000–5,000 surplus buy-back transactions/month across all stores
Volume: 1–10 items per transaction
Owner: Customer Service Representative
Participants: Customer Service Representative, Department Supervisor, Customer
Source: workflow W1109 — Customer Project Material Surplus Buy-Back &amp; Recycling Program</bpmn:documentation>
      <bpmn:laneSet id="W1109_LaneSet4">
        <bpmn:lane id="W1109_Lane1" name="Customer Service Representative">
        <bpmn:flowNodeRef>W1109_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1109_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1109_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1109_Lane2" name="Stock Associate">
        <bpmn:flowNodeRef>W1109_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1109_Lane3" name="System">
        <bpmn:flowNodeRef>W1109_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1109_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1109_Start5" name="Customer brings unused/surplus building materials to store for buy-back, or customer…">
        <bpmn:outgoing>W1109_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1109_Task6" name="Surplus Material Intake &amp; Eligibility Check">
        <bpmn:documentation>Step 1: Surplus Material Intake &amp; Eligibility Check: (a) Customer brings surplus materials to the customer service counter; (b) CSR verifies eligibility: (i) items must be BuildRight-branded or identifiable as BuildRight inventory (receipt, loyalty account purchase history, or SKU barcode scan); (ii) items must be in resalable condition: unopened packaging (cement bags intact, tile boxes sealed, paint cans unopened) or minimally used and clean (lumber without damage, full-length); (iii) items must not be hazardous materials requiring special handling (paint/chemicals must be unopened); (iv) items must be in the current active catalog (not discontinued); (c) system looks up original purchase price from customer&#x27;s transaction history; (d) items not meeting eligibility criteria are declined with explanation and disposal guidance offered per W502 (non-hazardous waste management)
Responsible (R): Customer Service Representative
Accountable (A): Customer Service Representative
Duration: 5–8 min</bpmn:documentation>
        <bpmn:incoming>W1109_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1109_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1109_Task7" name="Condition Grading &amp; Buy-Back Valuation">
        <bpmn:documentation>Step 2: Condition Grading &amp; Buy-Back Valuation: (a) CSR grades each item&#x27;s condition: Grade A — unopened, original packaging intact, current catalog item → buy-back at 70% of original purchase price; Grade B — opened but complete and undamaged, or minor cosmetic imperfection → buy-back at 50% of original purchase price; Grade C — partial quantity (e.g., half a bag of cement, cut lumber), clean and usable → buy-back at 30% of original purchase price; (b) system auto-calculates buy-back values based on grade and original purchase price; (c) customer chooses compensation: (i) store credit (additional 10% bonus on buy-back value, incentivizing reinvestment at BuildRight), (ii) cash refund via GCash or bank transfer (3–5 day processing), (iii) loyalty points (converted at standard rate); (d) Department Supervisor reviews and approves any single transaction exceeding PHP 10,000 in buy-back value
Responsible (R): Customer Service Representative
Accountable (A): Department Supervisor (if &gt; PHP 10K)
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W1109_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1109_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1109_Task8" name="Surplus Item Processing &amp; Resale Preparation">
        <bpmn:documentation>Step 3: Surplus Item Processing &amp; Resale Preparation: (a) surplus items are processed for resale: Grade A items restocked to original shelf location via standard inventory putaway; Grade B items labeled as &quot;Open Box — Surplus Buy-Back&quot; with discounted price per W549 (damaged/open-box item processing) and placed in designated clearance area; Grade C items labeled as &quot;Partial/Remnant — Surplus&quot; with calculated price and placed in the remnant/cutoff section (common for lumber, wire, pipes); (b) system creates inventory receipt at buy-back cost (not original cost) to ensure accurate margin tracking; (c) resale price set by system: Grade A at 90% SRP, Grade B at 70% SRP, Grade C at 50% SRP (or per-unit pricing for remnants); (d) buy-back inventory flagged in system for shrinkage reporting exclusion (to avoid inflating shrinkage numbers with intentional markdowns)
Responsible (R): Stock Associate / System
Accountable (A): Department Supervisor
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W1109_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1109_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1109_Task9" name="Accounting &amp; Reporting">
        <bpmn:documentation>Step 4: Accounting &amp; Reporting: (a) buy-back transaction recorded: debit Inventory (at buy-back cost), debit Buy-Back Expense (difference between buy-back cost and original cost if still on hand), credit Cash/Store Credit/GC Payable; (b) monthly buy-back program report: total items bought back by category, total buy-back cost, total resale revenue, net program margin, customer participation rate; (c) program ROI calculated: (resale revenue − buy-back cost − processing labor) / buy-back cost; (d) report shared with Category Manager for pricing optimization and program viability assessment
Responsible (R): System / Finance
Accountable (A): Category Manager
Duration: automated monthly</bpmn:documentation>
        <bpmn:incoming>W1109_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1109_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1109_End10" name="Complete">
        <bpmn:incoming>W1109_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1109_Annotation11">
        <bpmn:text>Controls: - CTL-266 (ensure controlled execution — Custom Fabrication &amp; Processing (PA-09.1).) | - operational: Customer Service Representative review and approval gate
Owner: Customer Service Representative</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1109_Assoc12" sourceRef="W1109_Annotation11" targetRef="W1109_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1109_Flow13" sourceRef="W1109_Start5" targetRef="W1109_Task6" />
      <bpmn:sequenceFlow id="W1109_Flow14" sourceRef="W1109_Task6" targetRef="W1109_Task7" />
      <bpmn:sequenceFlow id="W1109_Flow15" sourceRef="W1109_Task7" targetRef="W1109_Task8" />
      <bpmn:sequenceFlow id="W1109_Flow16" sourceRef="W1109_Task8" targetRef="W1109_Task9" />
      <bpmn:sequenceFlow id="W1109_Flow17" sourceRef="W1109_Task9" targetRef="W1109_End10" />
    </bpmn:process>
