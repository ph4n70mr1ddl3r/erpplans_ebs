    <bpmn:process id="W_W1148" name="W1148. Store-Level Customer Construction Site Vehicle Access Assessment &amp; Delivery Feasibility" isExecutable="false">
      <bpmn:documentation>Trigger: Customer orders delivery of construction materials to a construction site address, or customer requests delivery feasibility check before placing order
Frequency: ~2,000–3,000 delivery feasibility assessments/month across all stores
Volume: 1 assessment per delivery address
Owner: Sales Associate / Department Supervisor
Participants: Sales Associate, Customer, Delivery Partner, Store Receiving Clerk (for feedback loop)
Source: workflow W1148 — Store-Level Customer Construction Site Vehicle Access Assessment &amp; Delivery Feasibility</bpmn:documentation>
      <bpmn:laneSet id="W1148_LaneSet3">
        <bpmn:lane id="W1148_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W1148_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1148_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1148_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1148_Lane2" name="Delivery Driver">
        <bpmn:flowNodeRef>W1148_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1148_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1148_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1148_Start4" name="Customer orders delivery of construction materials to a construction site address, or…">
        <bpmn:outgoing>W1148_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1148_Task5" name="Delivery Address Capture &amp; Preliminary Assessment">
        <bpmn:documentation>Step 1: Delivery Address Capture &amp; Preliminary Assessment: (a) customer provides delivery address (or GPS coordinates for construction sites without formal addresses); (b) sales associate enters address into ERP delivery module; (c) system checks against delivery address database: previously delivered addresses show access notes (e.g., &quot;10-wheeler accessible,&quot; &quot;6-wheeler only,&quot; &quot;hand-carry last 50m&quot;); (d) for new addresses: system performs geo-fencing check (W1031) to confirm address is within delivery coverage area; (e) associate asks customer key access questions: &quot;Can a 10-wheeler truck access the site directly?&quot;, &quot;Are there height restrictions (overhead wires, gates)?&quot;, &quot;Is the road paved or unpaved?&quot;, &quot;Any weight-restricted bridges on the route?&quot;, &quot;Is the site accessible during rainy weather?&quot;
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 3–5 min</bpmn:documentation>
        <bpmn:incoming>W1148_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1148_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1148_Task6" name="Vehicle Type Matching &amp; Route Assessment">
        <bpmn:documentation>Step 2: Vehicle Type Matching &amp; Route Assessment: (a) based on assessment, system recommends vehicle type: 10-wheeler wing van (standard — for sites with full access), 6-wheeler truck (for narrow streets — reduced payload ~60%), forward/multi-cab (for very tight access — reduced payload ~25%), or motorcycle + sidecar (for extremely tight access — bags of cement, small items only); (b) if customer&#x27;s order exceeds recommended vehicle capacity: order split into multiple trips, or staged delivery scheduled per W974; (c) for remote/island sites: system identifies need for inter-island ferry (W66) or boat transfer, with additional logistics cost and lead time; (d) delivery fee recalculated based on vehicle type and route complexity; (e) customer informed of delivery method, vehicle type, and any access limitations
Responsible (R): Sales Associate / System
Accountable (A): Department Supervisor
Duration: 2–3 min</bpmn:documentation>
        <bpmn:incoming>W1148_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1148_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1148_Task7" name="Delivery Execution with Access Contingency">
        <bpmn:documentation>Step 3: Delivery Execution with Access Contingency: (a) delivery dispatched with correct vehicle type and driver briefed on access conditions; (b) driver confirms arrival and access assessment upon reaching site area — if access is worse than expected: contacts store for guidance; (c) contingency options: transfer goods to smaller vehicle (if pre-arranged), hand-carry materials from nearest accessible point (labor surcharge applies), or reschedule with appropriate vehicle; (d) for sites requiring manual carry (common in Philippine urban residential areas): driver and helper carry materials from truck to site, with carry distance and labor time documented; (e) delivery confirmation and POD captured per W1126
Responsible (R): Delivery Driver / Sales Associate
Accountable (A): Department Supervisor
Duration: Variable (delivery transit + access time)</bpmn:documentation>
        <bpmn:incoming>W1148_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1148_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1148_Task8" name="Post-Delivery Access Record Update">
        <bpmn:documentation>Step 4: Post-Delivery Access Record Update: (a) after delivery, driver submits access assessment feedback via mobile app: actual vehicle used, access conditions encountered, any problems, recommended vehicle for future deliveries; (b) feedback updates delivery address database in system for future reference; (c) if access was worse than assessed: root cause reviewed (was customer&#x27;s information inaccurate? did conditions change? was assessment insufficient?); (d) systematic access issues (e.g., a subdivision regularly denying truck entry) escalated to supply chain team for route optimization and carrier selection adjustment
Responsible (R): Delivery Driver / System
Accountable (A): Department Supervisor
Duration: 2–3 min</bpmn:documentation>
        <bpmn:incoming>W1148_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1148_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1148_End9" name="Complete">
        <bpmn:incoming>W1148_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1148_Annotation10">
        <bpmn:text>Controls: - CTL-266 (ensure controlled execution — Custom Fabrication &amp; Processing (PA-09.1).) | - operational: Sales Associate / Department Supervisor review and approval gate
Owner: Sales Associate / Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1148_Assoc11" sourceRef="W1148_Annotation10" targetRef="W1148_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1148_Flow12" sourceRef="W1148_Start4" targetRef="W1148_Task5" />
      <bpmn:sequenceFlow id="W1148_Flow13" sourceRef="W1148_Task5" targetRef="W1148_Task6" />
      <bpmn:sequenceFlow id="W1148_Flow14" sourceRef="W1148_Task6" targetRef="W1148_Task7" />
      <bpmn:sequenceFlow id="W1148_Flow15" sourceRef="W1148_Task7" targetRef="W1148_Task8" />
      <bpmn:sequenceFlow id="W1148_Flow16" sourceRef="W1148_Task8" targetRef="W1148_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1148_diag">
      <bpmndi:BPMNPlane id="W1148_plane" bpmnElement="W_W1148">
        <bpmndi:BPMNShape id="W1148_Lane1_di" bpmnElement="W1148_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1148_Lane2_di" bpmnElement="W1148_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1148_Task5_di" bpmnElement="W1148_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
