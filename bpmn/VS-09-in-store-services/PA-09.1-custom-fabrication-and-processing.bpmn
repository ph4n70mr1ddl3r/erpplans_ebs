    <bpmn:process id="W_W1054" name="W1054. Store-Level Customer Wire &amp; Cable Cut-to-Length Spool Service" isExecutable="false">
      <bpmn:documentation>Trigger: Customer requests specific length of electrical wire or cable (shorter than full roll)
Frequency: ~6,000–8,000 cut-to-length requests/month across all stores (electrical category: 10% of SKUs, ~3,500 items; wire/cable is the highest-volume electrical SKU by linear meters sold)
Volume: 1–5 cuts per customer visit
Owner: Electrical Department Supervisor
Participants: Sales Associate (Electrical Section), Customer
Source: workflow W1054 — Store-Level Customer Wire &amp; Cable Cut-to-Length Spool Service</bpmn:documentation>
      <bpmn:laneSet id="W1054_LaneSet4">
        <bpmn:lane id="W1054_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W1054_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1054_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1054_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1054_Lane2" name="System">
        <bpmn:flowNodeRef>W1054_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1054_Lane3" name="POS Cashier">
        <bpmn:flowNodeRef>W1054_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1054_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1054_Start5" name="Customer requests specific length of electrical wire or cable (shorter than full roll)">
        <bpmn:outgoing>W1054_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1054_Task6" name="Customer Requirement Intake">
        <bpmn:documentation>Step 1: Customer Requirement Intake: Sales Associate gathers wire/cable specifications: (a) wire type — THHN/THWN building wire, flat cord, extension cord wire, speaker wire, coaxial (RG-6/RG-59), CAT6 LAN cable, automotive wire, welding cable; (b) wire gauge/size — AWG size (14, 12, 10, 8, 6) or mm² (2.0mm², 3.5mm², 5.5mm², 8.0mm², 14mm², 22mm²); (c) conductor type — solid or stranded; (d) insulation color (for building wire: black, white, green/bare, red, blue, yellow per standard color coding); (e) required length in meters; (f) number of conductors needed (e.g., for a single-phase circuit: 1 black + 1 white + 1 green = 3 conductors, each × circuit length); (g) application — outlet wiring, lighting circuit, aircon circuit, subpanel feeder, grounding, data/communications
Responsible (R): Sales Associate
Accountable (A): Electrical Department Supervisor
Duration: 3–5 min</bpmn:documentation>
        <bpmn:incoming>W1054_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1054_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1054_Task7" name="Inventory Check &amp; Pricing">
        <bpmn:documentation>Step 2: Inventory Check &amp; Pricing: (a) system checks real-time inventory (W533) for the requested wire type/gauge/color in full-roll stock; (b) if full roll available: system calculates cut-to-length price = (per-meter price from full roll) × length requested + cutting service fee (PHP 10–20 per cut, waived for purchases &gt;PHP 300); (c) system displays per-meter price and total cost for customer confirmation; (d) if insufficient remaining length on open roll, system checks for additional rolls in stock or at nearby stores per W214; (e) system validates remaining length on open spool — if customer request would leave &lt;5m on the spool, offer the remaining full length at a discount to avoid small unusable offcuts
Responsible (R): System / Sales Associate
Accountable (A): Electrical Department Supervisor
Duration: 1–2 min</bpmn:documentation>
        <bpmn:incoming>W1054_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1054_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1054_Task8" name="Cutting Execution">
        <bpmn:documentation>Step 3: Cutting Execution: Sales Associate performs wire cutting at dedicated electrical cutting station: (a) select correct wire roll from spool rack (verified by type, gauge, color, and lot/batch number per W3 inventory procedures); (b) measure required length using calibrated measuring tape or the cutting station&#x27;s built-in meter counter; (c) mark cut point; (d) cut wire cleanly using wire cutter/cable snips (for wire ≤10 AWG) or cable cutter (for wire ≥8 AWG); (e) for cuts &gt;20m: unroll from spool rack along the floor measuring path (most stores have a 10m measuring lane marked on the floor near the electrical section); (f) verify cut length within ±0.1m tolerance; (g) strip 10mm of insulation from both ends to verify conductor quality (no oxidation, correct stranding); (h) coil cut length neatly and secure with wire tie or tape; (i) label with wire type, gauge, length, and per-meter price on tag; (j) system decrements inventory from spool roll (partial unit deduction per catch-weight logic W463)
Responsible (R): Sales Associate
Accountable (A): Electrical Department Supervisor
Duration: 3–10 min (depending on length; longer lengths require floor unrolling)</bpmn:documentation>
        <bpmn:incoming>W1054_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1054_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1054_Task9" name="Transaction Processing">
        <bpmn:documentation>Step 4: Transaction Processing: (a) system generates line item for cut wire: SKU, type, gauge, color, length (m), per-meter price, total price, cutting service fee (if applicable); (b) customer pays at POS per W5B (in-store selling) or W542 (quotation conversion); (c) system updates spool remaining length in inventory; (d) if spool remaining length reaches zero, system auto-generates replenishment suggestion per W2A (auto-replenishment)
Responsible (R): POS Cashier / System
Accountable (A): Electrical Department Supervisor
Duration: 2–3 min</bpmn:documentation>
        <bpmn:incoming>W1054_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1054_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1054_End10" name="Complete">
        <bpmn:incoming>W1054_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1054_Annotation11">
        <bpmn:text>Controls: - CTL-266 (ensure controlled execution — Custom Fabrication &amp; Processing (PA-09.1).) | - operational: weekly spool reconciliation (physical remaining-length measurement) per INV-001
Owner: Electrical Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1054_Assoc12" sourceRef="W1054_Annotation11" targetRef="W1054_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1054_Flow13" sourceRef="W1054_Start5" targetRef="W1054_Task6" />
      <bpmn:sequenceFlow id="W1054_Flow14" sourceRef="W1054_Task6" targetRef="W1054_Task7" />
      <bpmn:sequenceFlow id="W1054_Flow15" sourceRef="W1054_Task7" targetRef="W1054_Task8" />
      <bpmn:sequenceFlow id="W1054_Flow16" sourceRef="W1054_Task8" targetRef="W1054_Task9" />
      <bpmn:sequenceFlow id="W1054_Flow17" sourceRef="W1054_Task9" targetRef="W1054_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1054_diag">
      <bpmndi:BPMNPlane id="W1054_plane" bpmnElement="W_W1054">
        <bpmndi:BPMNShape id="W1054_Lane1_di" bpmnElement="W1054_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
