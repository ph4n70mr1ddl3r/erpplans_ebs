    <bpmn:process id="W_W744" name="W744. Store-Level Special Order Follow-Up &amp; Proactive Customer Notification" isExecutable="false">
      <bpmn:documentation>Trigger: Special order (W545) status change (item shipped, item received at store, item ready for pickup, order overdue)
Frequency: Daily; triggered by open special orders
Volume: ~10–25 active special orders per store at any time; ~300–500 status changes/day chain-wide
Owner: Department Supervisor
Participants: CSR, Stock Associate, Customer, Supply Chain (W4/W22)
Source: workflow W744 — Store-Level Special Order Follow-Up &amp; Proactive Customer Notification</bpmn:documentation>
      <bpmn:laneSet id="W744_LaneSet5">
        <bpmn:lane id="W744_Lane1" name="Department Supervisor">
        <bpmn:flowNodeRef>W744_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W744_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W744_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W744_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W744_Lane2" name="System">
        <bpmn:flowNodeRef>W744_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W744_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W744_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W744_Lane3" name="Stock Associate">
        <bpmn:flowNodeRef>W744_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W744_Lane4" name="Store Manager">
        <bpmn:flowNodeRef>W744_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W744_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W744_Start6" name="Special order (W545) status change (item shipped, item received at store, item ready for…">
        <bpmn:outgoing>W744_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W744_Task7" name="Daily open order review — Department Supervisor reviews all open special orders…">
        <bpmn:documentation>Step 1: Daily open order review — Department Supervisor reviews all open special orders in their department sorted by age; system highlights orders approaching or past promised delivery date
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W744_Flow18</bpmn:incoming>
        <bpmn:outgoing>W744_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W744_Task8" name="Supply chain status check — For orders with pending fulfillment, Supervisor…">
        <bpmn:documentation>Step 2: Supply chain status check — For orders with pending fulfillment, Supervisor checks shipment status via W250 control tower or W4 replenishment tracker; contacts DC or supplying store if no update
Responsible (R): Department Supervisor
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W744_Flow19</bpmn:incoming>
        <bpmn:outgoing>W744_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W744_Task9" name="Customer proactive notification — For significant status changes (item shipped…">
        <bpmn:documentation>Step 3: Customer proactive notification — For significant status changes (item shipped, item received, ready for pickup, delay notification), system sends automated SMS/email to customer; Supervisor calls for high-value orders (&gt; PHP 10,000)
Responsible (R): System / Department Supervisor
Accountable (A): —
Duration: Automated + 5 min per high-value</bpmn:documentation>
        <bpmn:incoming>W744_Flow20</bpmn:incoming>
        <bpmn:outgoing>W744_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W744_Task10" name="Received item inspection — When special order arrives at store (W109), Stock…">
        <bpmn:documentation>Step 4: Received item inspection — When special order arrives at store (W109), Stock Associate inspects item condition, verifies against order specifications (correct model, color, size, quantity)
Responsible (R): Stock Associate
Accountable (A): Department Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W744_Flow21</bpmn:incoming>
        <bpmn:outgoing>W744_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W744_Task11" name="Customer pickup scheduling — Supervisor contacts customer to confirm pickup…">
        <bpmn:documentation>Step 5: Customer pickup scheduling — Supervisor contacts customer to confirm pickup date/time; for bulky items, coordinates carry-out assistance (W438) or home delivery scheduling (W5D)
Responsible (R): Department Supervisor
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W744_Flow22</bpmn:incoming>
        <bpmn:outgoing>W744_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W744_Task12" name="Overdue order escalation — Orders past promised date by &gt; 5 business days…">
        <bpmn:documentation>Step 6: Overdue order escalation — Orders past promised date by &gt; 5 business days auto-escalate to Store Manager; Store Manager contacts customer with revised estimate and service recovery offer
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W744_Flow23</bpmn:incoming>
        <bpmn:outgoing>W744_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W744_Task13" name="Unclaimed order management — Orders not picked up within 14 days of…">
        <bpmn:documentation>Step 7: Unclaimed order management — Orders not picked up within 14 days of notification: system sends final notice; after 21 days, order cancellation initiated per W545 cancellation policy; deposit retained per terms
Responsible (R): System / CSR
Accountable (A): Store Manager
Duration: Automated + 5 min</bpmn:documentation>
        <bpmn:incoming>W744_Flow24</bpmn:incoming>
        <bpmn:outgoing>W744_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W744_Task14" name="Monthly special order analytics — System generates report: fill rate, average…">
        <bpmn:documentation>Step 8: Monthly special order analytics — System generates report: fill rate, average lead time, on-time pickup rate, cancellation rate, top categories; Store Manager reviews with team during W575 weekly review
Responsible (R): System / Store Manager
Accountable (A): Store Manager
Duration: Automated + 15 min review</bpmn:documentation>
        <bpmn:incoming>W744_Flow25</bpmn:incoming>
        <bpmn:outgoing>W744_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W744_End15" name="Complete">
        <bpmn:incoming>W744_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W744_Annotation16">
        <bpmn:text>Controls: - CTL-266 (ensure controlled execution — Custom Fabrication &amp; Processing (PA-09.1).) | - operational: prioritization to prevent overdue orders from falling through cracks
Owner: Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
