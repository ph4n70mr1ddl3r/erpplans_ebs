    <bpmn:process id="W_W1140" name="W1140. Customer Post-Construction Punch List Material Fulfillment &amp; Callback Order" isExecutable="false">
      <bpmn:documentation>Trigger: Customer (project account or contractor) identifies punch list items after construction walkthrough, or defect-liability period claim
Frequency: ~300–500 punch list orders/month across all stores
Volume: 5–20 line items per punch list order
Owner: Sales Associate (Project Liaison)
Participants: Sales Associate (Project Liaison), Customer, Department Supervisor, Vendor (if warranty claim)
Source: workflow W1140 — Customer Post-Construction Punch List Material Fulfillment &amp; Callback Order</bpmn:documentation>
      <bpmn:laneSet id="W1140_LaneSet3">
        <bpmn:lane id="W1140_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W1140_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1140_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1140_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1140_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1140_Lane2" name="Stock Associate">
        <bpmn:flowNodeRef>W1140_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1140_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1140_Start4" name="Customer (project account or contractor) identifies punch list items after construction…">
        <bpmn:outgoing>W1140_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1140_Task5" name="Punch List Receipt &amp; Item Identification">
        <bpmn:documentation>Step 1: Punch List Receipt &amp; Item Identification: (a) customer (typically contractor or project manager) provides punch list: item description, quantity needed, location in project, urgency; (b) project liaison reviews punch list against original project order to identify: items already purchased from BuildRight (may be under warranty — route to W33), items not in original order (new sale), items needing exact batch/shade match (tiles — route to W421 batch/shade reconciliation); (c) for each punch list item, system checks: current stock availability at assigned store and nearby stores, exact product match (same SKU or approved substitute per W279), vendor lead time if out-of-stock
Responsible (R): Sales Associate (Project Liaison)
Accountable (A): Department Supervisor
Duration: 15–25 min</bpmn:documentation>
        <bpmn:incoming>W1140_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1140_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1140_Task6" name="Priority Order Processing">
        <bpmn:documentation>Step 2: Priority Order Processing: (a) punch list order flagged as priority in ERP: expedited picking (if in-stock), priority replenishment from DC (24-hour delivery SLA), or emergency vendor order (W60); (b) for batch-critical items (tiles, paint): system verifies batch/shade match against original project order; if exact batch unavailable: customer notified of closest available shade and samples offered per W999; (c) for warranty items: separate warranty claim order created per W33 with no charge to customer (vendor bears cost if within warranty period); (d) delivery scheduled: site delivery per W980 or BOPIS pickup per W11 — customer&#x27;s preference; (e) rush delivery option: same-day delivery via 3PL partner (Lalamove, Transportify) for urgent punch list items at subsidized delivery cost
Responsible (R): Sales Associate / System
Accountable (A): Department Supervisor
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W1140_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1140_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1140_Task7" name="Order Fulfillment &amp; Delivery">
        <bpmn:documentation>Step 3: Order Fulfillment &amp; Delivery: (a) if picking from store stock: Stock Associate picks items with extra care (punch list items are individually critical — no damaged pieces); (b) items verified by project liaison before dispatch: correct shade/batch, correct specifications, correct quantity; (c) delivery arranged per customer preference; (d) for items requiring vendor order: vendor PO issued with &quot;Punch List Priority&quot; flag, delivery tracked via W1132 logistics scorecard; (e) customer notified of expected delivery time and any partial shipment status
Responsible (R): Stock Associate / Sales Associate
Accountable (A): Department Supervisor
Duration: 20–30 min</bpmn:documentation>
        <bpmn:incoming>W1140_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1140_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1140_Task8" name="Punch List Close-Out &amp; Project Completion">
        <bpmn:documentation>Step 4: Punch List Close-Out &amp; Project Completion: (a) upon delivery confirmation, project liaison follows up with customer to verify satisfaction; (b) all punch list items crossed off; (c) if any items still outstanding: additional order placed immediately; (d) final project order value updated in ERP including punch list additions; (e) project marked &quot;Complete — Punch List Cleared&quot;; (f) retention release initiated per W1134 if applicable; (g) customer satisfaction survey sent per W65
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W1140_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1140_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1140_End9" name="Complete">
        <bpmn:incoming>W1140_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1140_Annotation10">
        <bpmn:text>Controls: - CTL-266 (ensure controlled execution — Custom Fabrication &amp; Processing (PA-09.1).) | - operational: Sales Associate (Project Liaison) review and approval gate; operational: periodic reconciliation against source documents
Owner: Sales Associate (Project Liaison)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1140_Assoc11" sourceRef="W1140_Annotation10" targetRef="W1140_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1140_Flow12" sourceRef="W1140_Start4" targetRef="W1140_Task5" />
      <bpmn:sequenceFlow id="W1140_Flow13" sourceRef="W1140_Task5" targetRef="W1140_Task6" />
      <bpmn:sequenceFlow id="W1140_Flow14" sourceRef="W1140_Task6" targetRef="W1140_Task7" />
      <bpmn:sequenceFlow id="W1140_Flow15" sourceRef="W1140_Task7" targetRef="W1140_Task8" />
      <bpmn:sequenceFlow id="W1140_Flow16" sourceRef="W1140_Task8" targetRef="W1140_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1140_diag">
      <bpmndi:BPMNPlane id="W1140_plane" bpmnElement="W_W1140">
        <bpmndi:BPMNShape id="W1140_Lane1_di" bpmnElement="W1140_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
