        <bpmndi:BPMNShape id="W916_Task10_di" bpmnElement="W916_Task10"><dc:Bounds x="1240" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W916_Task11_di" bpmnElement="W916_Task11"><dc:Bounds x="1450" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W916_Start5_di" bpmnElement="W916_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W916_End12_di" bpmnElement="W916_End12"><dc:Bounds x="1680" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W916_Annotation13_di" bpmnElement="W916_Annotation13"><dc:Bounds x="160" y="630" width="360" height="114" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W916_Flow15_di" bpmnElement="W916_Flow15"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
