        <bpmndi:BPMNShape id="W922_End10_di" bpmnElement="W922_End10"><dc:Bounds x="1470" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W922_Annotation11_di" bpmnElement="W922_Annotation11"><dc:Bounds x="160" y="460" width="360" height="114" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W922_Flow13_di" bpmnElement="W922_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W922_Flow14_di" bpmnElement="W922_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W922_Flow15_di" bpmnElement="W922_Flow15"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W922_Flow16_di" bpmnElement="W922_Flow16"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W922_Flow17_di" bpmnElement="W922_Flow17"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W922_Flow18_di" bpmnElement="W922_Flow18"><di:waypoint x="1420" y="335" /><di:waypoint x="1470" y="335" /></bpmndi:BPMNEdge>
