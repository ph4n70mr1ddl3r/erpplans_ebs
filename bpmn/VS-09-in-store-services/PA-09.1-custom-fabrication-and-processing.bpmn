      <bpmn:sequenceFlow id="W953_Flow17" sourceRef="W953_Task8" targetRef="W953_Task9" />
      <bpmn:sequenceFlow id="W953_Flow18" sourceRef="W953_Task9" targetRef="W953_Task10" />
      <bpmn:sequenceFlow id="W953_Flow19" sourceRef="W953_Task10" targetRef="W953_Task11" />
      <bpmn:sequenceFlow id="W953_Flow20" sourceRef="W953_Task11" targetRef="W953_End12" />
    </bpmn:process>
