    <bpmn:process id="W_W1046" name="W1046. Customer Door &amp; Window Measurement, Sizing &amp; Custom Order Service" isExecutable="false">
      <bpmn:documentation>Trigger: Customer requests door or window sizing assistance, custom-order door/window, or replacement for existing unit
Frequency: ~2,500–3,500 customer interactions/month across all stores
Volume: 1–4 door/window units per customer project
Owner: Lumber &amp; Building Materials Department Supervisor
Participants: Sales Associate (Building Materials Section), Special Order Coordinator, Customer
Source: workflow W1046 — Customer Door &amp; Window Measurement, Sizing &amp; Custom Order Service</bpmn:documentation>
      <bpmn:laneSet id="W1046_LaneSet4">
        <bpmn:lane id="W1046_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W1046_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1046_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1046_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1046_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1046_Lane2" name="System">
        <bpmn:flowNodeRef>W1046_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1046_Lane3" name="Receiving Clerk">
        <bpmn:flowNodeRef>W1046_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1046_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1046_Start5" name="Customer requests door or window sizing assistance, custom-order door/window, or…">
        <bpmn:outgoing>W1046_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1046_Task6" name="Project Requirement Intake">
        <bpmn:documentation>Step 1: Project Requirement Intake: Sales Associate identifies the door/window need: (a) new construction (rough opening not yet built — recommend standard sizes); (b) replacement (existing unit to be replaced — requires precise measurement of existing frame and rough opening); (c) renovation/upgrade (existing opening to receive new unit — requires measurement of finished opening); (d) door type — interior flush, interior panel, main entrance (solid wood, metal-clad, fiberglass), fire-rated (1-hour, 2-hour), bi-fold, sliding; (e) window type — sliding aluminum, casement, fixed, awning, jalousie (replacement blades only); (f) material preference — wood (narra, tanguile, molave), aluminum, steel, fiberglass, PVC/uPVC; (g) finish — primed, pre-finished, raw (for on-site finishing)
Responsible (R): Sales Associate
Accountable (A): Lumber &amp; Building Materials Dept Supervisor
Duration: 5–8 min</bpmn:documentation>
        <bpmn:incoming>W1046_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1046_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1046_Task7" name="Measurement Guidance &amp; Data Collection">
        <bpmn:documentation>Step 2: Measurement Guidance &amp; Data Collection: Sales Associate provides measurement guidance (if customer has not yet measured) or records customer-provided measurements: (a) for door replacement: (i) existing door slab width and height; (ii) frame interior width and height (jamb-to-jamb); (iii) rough opening width and height (framing to framing, behind the jambs); (iv) wall thickness (for jamb depth); (v) hinge side (left-hand or right-hand swing); (vi) lock bore hole location; (b) for window replacement: (i) glass/viewable area width and height; (ii) frame exterior width and height; (iii) rough opening width and height; (iv) wall thickness; (v) sill height from floor; (vi) number of panels/slides; (c) system records all measurements with unit (mm or inches) and provides a printable measurement worksheet; (d) if customer cannot provide measurements, system generates on-site measurement service request per W442 (site technical survey &amp; measurement services) with service fee
Responsible (R): Sales Associate
Accountable (A): Lumber &amp; Building Materials Dept Supervisor
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W1046_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1046_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1046_Task8" name="Sizing Recommendation &amp; Availability Check">
        <bpmn:documentation>Step 3: Sizing Recommendation &amp; Availability Check: (a) system compares customer measurements against standard size catalog — if within 5mm tolerance of a standard size, recommend stock item for immediate purchase; (b) if no standard size matches, system flags for custom order; (c) system checks real-time inventory (W533) for matching stock items at customer&#x27;s store and nearby stores within 50 km per W214 (inter-store transfer); (d) for custom orders: system generates custom specification with manufacturer — door/window type, dimensions (width × height × thickness/frame depth), material, finish, glass type (clear, tinted, frosted, tempered, laminated), hardware (lockset, hinges, handles), fire rating (if applicable); (e) system estimates custom order lead time: 7–10 days for doors, 10–14 days for windows, 14–21 days for fire-rated doors
Responsible (R): System / Sales Associate
Accountable (A): Lumber &amp; Building Materials Dept Supervisor
Duration: 3–5 min</bpmn:documentation>
        <bpmn:incoming>W1046_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1046_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1046_Task9" name="Custom Order Placement &amp; Deposit Collection">
        <bpmn:documentation>Step 4: Custom Order Placement &amp; Deposit Collection: (a) for custom orders: Sales Associate creates special order in system per W545 (special order &amp; customer order processing); (b) system generates custom order quote with: specification details, manufacturer, estimated lead time, total price, 50% deposit requirement; (c) customer reviews and approves quote; (d) system collects 50% deposit at POS per W546 (deposit &amp; progress payment collection); (e) special order transmitted to partner manufacturer via vendor portal (W866); (f) system sets expected delivery date and sends confirmation to customer via SMS/email; (g) for stock items at nearby stores: system initiates inter-store transfer per W214 with 2–3 day delivery
Responsible (R): Sales Associate / Special Order Coordinator
Accountable (A): Lumber &amp; Building Materials Dept Supervisor
Duration: 5–8 min</bpmn:documentation>
        <bpmn:incoming>W1046_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1046_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1046_Task10" name="Delivery Notification &amp; Customer Pickup/Delivery">
        <bpmn:documentation>Step 5: Delivery Notification &amp; Customer Pickup/Delivery: (a) when custom order arrives at store (7–21 days): receiving clerk processes goods receipt per W109; (b) system sends automated notification to customer via SMS/email: &quot;Your custom door/window order #XXX has arrived at BuildRight [Store Name]. Please pick up within 5 days or call to schedule home delivery per W5D&quot;; (c) customer picks up at customer service counter — verify order against receipt and customer ID; (d) remaining 50% balance collected at POS; (e) for bulky items: offer home delivery scheduling per W5D with delivery fee; (f) system closes special order and updates vendor performance metrics per W44
Responsible (R): Receiving Clerk / Customer Service Rep / Sales Associate
Accountable (A): Lumber &amp; Building Materials Dept Supervisor
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W1046_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1046_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1046_End11" name="Complete">
        <bpmn:incoming>W1046_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1046_Annotation12">
        <bpmn:text>Controls: - CTL-266 (ensure controlled execution — Custom Fabrication &amp; Processing (PA-09.1).) | - operational: Lumber &amp; Building Materials Department Supervisor review and approval gate
Owner: Lumber &amp; Building Materials Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1046_Assoc13" sourceRef="W1046_Annotation12" targetRef="W1046_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1046_Flow14" sourceRef="W1046_Start5" targetRef="W1046_Task6" />
      <bpmn:sequenceFlow id="W1046_Flow15" sourceRef="W1046_Task6" targetRef="W1046_Task7" />
      <bpmn:sequenceFlow id="W1046_Flow16" sourceRef="W1046_Task7" targetRef="W1046_Task8" />
      <bpmn:sequenceFlow id="W1046_Flow17" sourceRef="W1046_Task8" targetRef="W1046_Task9" />
      <bpmn:sequenceFlow id="W1046_Flow18" sourceRef="W1046_Task9" targetRef="W1046_Task10" />
      <bpmn:sequenceFlow id="W1046_Flow19" sourceRef="W1046_Task10" targetRef="W1046_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1046_diag">
      <bpmndi:BPMNPlane id="W1046_plane" bpmnElement="W_W1046">
        <bpmndi:BPMNShape id="W1046_Lane1_di" bpmnElement="W1046_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1046_Lane2_di" bpmnElement="W1046_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1046_Lane3_di" bpmnElement="W1046_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1046_Task6_di" bpmnElement="W1046_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
