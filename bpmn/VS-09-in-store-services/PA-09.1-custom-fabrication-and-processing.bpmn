      <bpmn:sequenceFlow id="W1122_Flow17" sourceRef="W1122_Task8" targetRef="W1122_Task9" />
      <bpmn:sequenceFlow id="W1122_Flow18" sourceRef="W1122_Task9" targetRef="W1122_Task10" />
      <bpmn:sequenceFlow id="W1122_Flow19" sourceRef="W1122_Task10" targetRef="W1122_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1122_diag">
      <bpmndi:BPMNPlane id="W1122_plane" bpmnElement="W_W1122">
        <bpmndi:BPMNShape id="W1122_Lane1_di" bpmnElement="W1122_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1122_Lane2_di" bpmnElement="W1122_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1122_Lane3_di" bpmnElement="W1122_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1370" height="170" /></bpmndi:BPMNShape>
