    <bpmn:process id="W_W1146" name="W1146. Store-Level Customer Cement &amp; Bagged Material Shelf Life Monitoring &amp; Freshness Guarantee" isExecutable="false">
      <bpmn:documentation>Trigger: Daily stock check identifies cement or bagged material approaching shelf life limit, or customer concern about material freshness, or receiving inspection flags age concern
Frequency: ~6,000 shelf-life checks/month across all stores (daily for cement at each store, weekly for other bagged materials)
Volume: 35,000 active SKUs; ~200–300 cement/bagged material SKUs per store requiring shelf life monitoring
Owner: Department Supervisor (Lumber &amp; Building Materials)
Participants: Stock Associate, Department Supervisor, Receiving Clerk, Vendor (for returns)
Source: workflow W1146 — Store-Level Customer Cement &amp; Bagged Material Shelf Life Monitoring &amp; Freshness Guarantee</bpmn:documentation>
      <bpmn:laneSet id="W1146_LaneSet4">
        <bpmn:lane id="W1146_Lane1" name="Receiving Clerk">
        <bpmn:flowNodeRef>W1146_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1146_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1146_Lane2" name="Stock Associate">
        <bpmn:flowNodeRef>W1146_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1146_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1146_Lane3" name="Cashier">
        <bpmn:flowNodeRef>W1146_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1146_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1146_Start5" name="Daily stock check identifies cement or bagged material approaching shelf life limit, or…">
        <bpmn:outgoing>W1146_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1146_Task6" name="Receiving Date Capture &amp; Shelf Life Assignment">
        <bpmn:documentation>Step 1: Receiving Date Capture &amp; Shelf Life Assignment: (a) when cement or bagged materials are received at store (from DC per W4 or DSD per W18), receiving clerk scans batch/lot number and manufacture date from packaging; (b) system calculates expiry date: cement — 90 days from manufacture date (reduced to 75 days during June–November rainy season); mortar/grout mix — 12 months from manufacture; waterproofing compounds — 18 months from manufacture; (c) expiry date assigned in inventory record; (d) system alerts if received batch already exceeds 50% of shelf life (e.g., cement received at 50+ days old) — flags for priority shelving and early sale
Responsible (R): Receiving Clerk / System
Accountable (A): Department Supervisor
Duration: 30–60 sec/pallet</bpmn:documentation>
        <bpmn:incoming>W1146_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1146_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1146_Task7" name="Daily Shelf Life Monitoring &amp; FEFO Rotation">
        <bpmn:documentation>Step 2: Daily Shelf Life Monitoring &amp; FEFO Rotation: (a) each morning, stock associate performs shelf life spot-check on cement and bagged materials display; (b) system-generated daily alert lists items within 14 days of expiry; (c) stock associate physically rotates stock using FEFO: oldest stock pulled to front, newest stock placed behind; (d) for cement: check for hardened lumps, torn bags, water stains — remove and quarantine any compromised bags; (e) physical rotation confirmed in system with scan of batch barcode on oldest stock
Responsible (R): Stock Associate
Accountable (A): Department Supervisor
Duration: 15–20 min/day</bpmn:documentation>
        <bpmn:incoming>W1146_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1146_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1146_Task8" name="Customer Freshness Guarantee at POS">
        <bpmn:documentation>Step 3: Customer Freshness Guarantee at POS: (a) when customer purchases cement or age-sensitive materials, cashier scans batch barcode at checkout; (b) system displays manufacture date and remaining shelf life; (c) if batch is within 30 days of expiry for cement, or 60 days for other bagged materials: POS prompts cashier to offer freshest batch; (d) if fresher batch available in backroom, stock associate retrieves it; (e) receipt prints manufacture date and &quot;Freshness Guaranteed&quot; statement with batch number; (f) for large cement orders (50+ bags): customer may request freshness verification certificate for project documentation
Responsible (R): Cashier / Stock Associate
Accountable (A): Department Supervisor
Duration: 30–60 sec/transaction</bpmn:documentation>
        <bpmn:incoming>W1146_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1146_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1146_Task9" name="Near-Expiry Markdown &amp; Disposal">
        <bpmn:documentation>Step 4: Near-Expiry Markdown &amp; Disposal: (a) items reaching 14 days before expiry automatically flagged for markdown: 20% discount at 14 days, 40% at 7 days; (b) markdown applied in POS system with &quot;Near-Expiry — Use Immediately&quot; shelf label; (c) customer informed of reduced shelf life and advised to use within stated period; (d) items past expiry removed from shelf, quarantined, and dispositioned: return to vendor if return agreement exists per W88 (RTV); dispose via authorized construction waste hauler if non-returnable; (e) disposal recorded in system with waste code and documentation for DENR compliance (W82)
Responsible (R): Stock Associate / System
Accountable (A): Department Supervisor
Duration: 5–10 min/batch</bpmn:documentation>
        <bpmn:incoming>W1146_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1146_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1146_End10" name="Complete">
        <bpmn:incoming>W1146_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1146_Annotation11">
        <bpmn:text>Controls: - CTL-266 (ensure controlled execution — Custom Fabrication &amp; Processing (PA-09.1).) | - operational: ergonomic training required for stock associates
Owner: Department Supervisor (Lumber &amp; Building Materials)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1146_Assoc12" sourceRef="W1146_Annotation11" targetRef="W1146_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1146_Flow13" sourceRef="W1146_Start5" targetRef="W1146_Task6" />
      <bpmn:sequenceFlow id="W1146_Flow14" sourceRef="W1146_Task6" targetRef="W1146_Task7" />
      <bpmn:sequenceFlow id="W1146_Flow15" sourceRef="W1146_Task7" targetRef="W1146_Task8" />
      <bpmn:sequenceFlow id="W1146_Flow16" sourceRef="W1146_Task8" targetRef="W1146_Task9" />
      <bpmn:sequenceFlow id="W1146_Flow17" sourceRef="W1146_Task9" targetRef="W1146_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1146_diag">
      <bpmndi:BPMNPlane id="W1146_plane" bpmnElement="W_W1146">
        <bpmndi:BPMNShape id="W1146_Lane1_di" bpmnElement="W1146_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1146_Lane2_di" bpmnElement="W1146_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
