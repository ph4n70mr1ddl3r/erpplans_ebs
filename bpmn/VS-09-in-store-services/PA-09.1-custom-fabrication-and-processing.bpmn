      <bpmn:sequenceFlow id="W17_Flow26" sourceRef="W17_Task11" targetRef="W17_Task12" />
      <bpmn:sequenceFlow id="W17_Flow27" sourceRef="W17_Task12" targetRef="W17_Task13" />
      <bpmn:sequenceFlow id="W17_Flow28" sourceRef="W17_Task13" targetRef="W17_Task14" />
      <bpmn:sequenceFlow id="W17_Flow29" sourceRef="W17_Task14" targetRef="W17_Task15" />
      <bpmn:sequenceFlow id="W17_Flow30" sourceRef="W17_Task15" targetRef="W17_Task16" />
      <bpmn:sequenceFlow id="W17_Flow31" sourceRef="W17_Task16" targetRef="W17_Task17" />
      <bpmn:sequenceFlow id="W17_Flow32" sourceRef="W17_Task17" targetRef="W17_End18" />
    </bpmn:process>
