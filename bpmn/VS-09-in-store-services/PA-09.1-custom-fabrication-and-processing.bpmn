    <bpmn:process id="W_W438" name="W438. Yard Dispatch &amp; Customer Vehicle Loading Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Customer completes purchase of bulky items (Lumber, Cement, Steel, Sand) at POS
Frequency: High; ~7–10 customer loading events per store per day (matching W950&#x27;s monthly volume)
Volume: Variable (from 5 bags of cement to full truckloads of lumber)
Owner: Yard Supervisor
Participants: Customer, Yard Associate (Porter), Forklift Operator, Security Guard
Source: workflow W438 — Yard Dispatch &amp; Customer Vehicle Loading Operations</bpmn:documentation>
      <bpmn:laneSet id="W438_LaneSet5">
        <bpmn:lane id="W438_Lane1" name="System">
        <bpmn:flowNodeRef>W438_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W438_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W438_Lane2" name="Customer">
        <bpmn:flowNodeRef>W438_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W438_Lane3" name="Yard Associate">
        <bpmn:flowNodeRef>W438_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W438_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W438_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W438_Lane4" name="Security Guard">
        <bpmn:flowNodeRef>W438_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W438_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W438_Start6" name="Customer completes purchase of bulky items (Lumber, Cement, Steel, Sand) at POS">
        <bpmn:outgoing>W438_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W438_Task7" name="Dispatch Notification">
        <bpmn:documentation>Step 1: Dispatch Notification: Upon payment at POS, system sends &quot;Loading Instruction&quot; to the Yard Supervisor&#x27;s tablet
Responsible (R): System
Accountable (A): Yard Supervisor
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W438_Flow16</bpmn:incoming>
        <bpmn:outgoing>W438_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W438_Task8" name="Vehicle Arrival">
        <bpmn:documentation>Step 2: Vehicle Arrival: Customer drives to the Loading Bay; presents &quot;Paid&quot; receipt or &quot;Loading Slip&quot; to the Guard
Responsible (R): Customer / Guard
Accountable (A): Yard Supervisor
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W438_Flow17</bpmn:incoming>
        <bpmn:outgoing>W438_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W438_Task9" name="Order Verification">
        <bpmn:documentation>Step 3: Order Verification: Yard Associate scans the Loading Slip barcode; system displays items and quantities to be loaded
Responsible (R): Yard Associate
Accountable (A): Yard Supervisor
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W438_Flow18</bpmn:incoming>
        <bpmn:outgoing>W438_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W438_Task10" name="Loading">
        <bpmn:documentation>Step 4: Loading: Associate or Forklift Operator loads materials into the customer&#x27;s vehicle; follows safety guidelines (e.g., no overloading, proper weight distribution)
Responsible (R): Yard Associate / Forklift Op
Accountable (A): —
Duration: 5–15 min</bpmn:documentation>
        <bpmn:incoming>W438_Flow19</bpmn:incoming>
        <bpmn:outgoing>W438_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W438_Task11" name="Validation &amp; Signature">
        <bpmn:documentation>Step 5: Validation &amp; Signature: Associate confirms quantity loaded on tablet; customer signs digitally to acknowledge receipt of goods in good condition
Responsible (R): Yard Associate
Accountable (A): Customer
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W438_Flow20</bpmn:incoming>
        <bpmn:outgoing>W438_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W438_Task12" name="Exit Clearance">
        <bpmn:documentation>Step 6: Exit Clearance: Guard checks vehicle interior/bed against the &quot;Cleared Loading Slip&quot;; verifies exit timestamp; releases vehicle
Responsible (R): Security Guard
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W438_Flow21</bpmn:incoming>
        <bpmn:outgoing>W438_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W438_End13" name="Complete">
        <bpmn:incoming>W438_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W438_Annotation14">
        <bpmn:text>Controls: - CTL-266 (ensure controlled execution — Custom Fabrication &amp; Processing (PA-09.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Yard Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W438_Assoc15" sourceRef="W438_Annotation14" targetRef="W438_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W438_Flow16" sourceRef="W438_Start6" targetRef="W438_Task7" />
