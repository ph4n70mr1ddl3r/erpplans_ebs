    <bpmn:process id="W_W945" name="W945. Customer Key Duplication &amp; Lock Rekeying Service" isExecutable="false">
      <bpmn:documentation>Trigger: Customer requests key duplication or lock rekeying at the in-store hardware service counter
Frequency: ~6,000–8,000 transactions/month chain-wide (~30–40/store/month)
Volume: 1–5 keys per duplication transaction; 1–3 locks per rekeying transaction
Owner: Department Supervisor (Tools/Hardware)
Participants: Sales Associate (Hardware Specialist), Customer, Category Manager (key blank inventory)
Source: workflow W945 — Customer Key Duplication &amp; Lock Rekeying Service</bpmn:documentation>
      <bpmn:laneSet id="W945_LaneSet2">
        <bpmn:lane id="W945_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W945_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W945_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W945_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W945_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W945_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W945_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W945_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W945_Start3" name="Customer requests key duplication or lock rekeying at the in-store hardware service…">
        <bpmn:outgoing>W945_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W945_Task4" name="Customer Request &amp; Key Identification">
        <bpmn:documentation>Step 1: Customer Request &amp; Key Identification: Customer presents original key(s) for duplication or lock cylinder for rekeying; Sales Associate identifies: (a) key type — standard flat key (Yale, Master, Weiser, local brands), dimple key, tubular key, automotive key (basic — no transponder), or high-security restricted key (system flags restricted brands that cannot be duplicated per IP agreements per W126); (b) key blank availability — system checks key blank inventory per type; (c) for rekeying: lock brand, number of pins, and cylinder type (rim cylinder, mortise cylinder, tubular latch)
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 3–5 min</bpmn:documentation>
        <bpmn:incoming>W945_Flow12</bpmn:incoming>
        <bpmn:outgoing>W945_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W945_Task5" name="Service Execution — Key Duplication">
        <bpmn:documentation>Step 2: Service Execution — Key Duplication: Sales Associate selects matching key blank from inventory; mounts original and blank in key duplicating machine; aligns cutting wheel; operates machine (trace-and-cut, 30–60 seconds per key); deburrs cut key on brush wheel; tests key in test lock (store maintains a test lock set for common key types); if key does not operate smoothly, adjusts and re-cuts on new blank (defective blank dispositioned per W91); repeats for additional copies
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 2–5 min/key</bpmn:documentation>
        <bpmn:incoming>W945_Flow13</bpmn:incoming>
        <bpmn:outgoing>W945_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W945_Task6" name="Service Execution — Lock Rekeying">
        <bpmn:documentation>Step 3: Service Execution — Lock Rekeying: Sales Associate removes lock cylinder from customer-provided lock or from new lock purchased in-store; disassembles cylinder using pin kit; removes old pins; installs new pin configuration matching new key (randomly selected from key blank stock or customer-provided new key); reassembles cylinder; tests new key operation; old pins returned to pin kit inventory; customer receives new key(s) with rekeyed lock
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 15–30 min/lock</bpmn:documentation>
        <bpmn:incoming>W945_Flow14</bpmn:incoming>
        <bpmn:outgoing>W945_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W945_Task7" name="Payment &amp; Handover">
        <bpmn:documentation>Step 4: Payment &amp; Handover: Customer verifies key(s) operate correctly in original lock (for duplication) or test lock (for rekeying); Sales Associate processes payment at POS: duplication fee per key + rekeying fee per lock + key blank cost + new lock (if purchased); system creates service ticket and posts revenue to service income account; customer receives keys with BuildRight key tag (branded, includes store phone number for reorders)
Responsible (R): Sales Associate / Cashier
Accountable (A): Department Supervisor
Duration: 3–5 min</bpmn:documentation>
        <bpmn:incoming>W945_Flow15</bpmn:incoming>
        <bpmn:outgoing>W945_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W945_Task8" name="Daily Key Blank Replenishment">
        <bpmn:documentation>Step 5: Daily Key Blank Replenishment: At end of day, Sales Associate counts key blank inventory by type; system auto-generates replenishment transfer request from DC or vendor for blanks below reorder point; key blanks are low-cost, high-turn items maintained at 200–300 blanks per store across common types
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 15 min/day</bpmn:documentation>
        <bpmn:incoming>W945_Flow16</bpmn:incoming>
        <bpmn:outgoing>W945_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W945_End9" name="Complete">
        <bpmn:incoming>W945_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W945_Annotation10">
        <bpmn:text>Controls: - CTL-266 (ensure controlled execution — Custom Fabrication &amp; Processing (PA-09.1).) | - operational: must flag restricted key types and Sales Associates must decline with customer explanation
Owner: Department Supervisor (Tools/Hardware)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W945_Assoc11" sourceRef="W945_Annotation10" targetRef="W945_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W945_Flow12" sourceRef="W945_Start3" targetRef="W945_Task4" />
      <bpmn:sequenceFlow id="W945_Flow13" sourceRef="W945_Task4" targetRef="W945_Task5" />
      <bpmn:sequenceFlow id="W945_Flow14" sourceRef="W945_Task5" targetRef="W945_Task6" />
      <bpmn:sequenceFlow id="W945_Flow15" sourceRef="W945_Task6" targetRef="W945_Task7" />
      <bpmn:sequenceFlow id="W945_Flow16" sourceRef="W945_Task7" targetRef="W945_Task8" />
      <bpmn:sequenceFlow id="W945_Flow17" sourceRef="W945_Task8" targetRef="W945_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W945_diag">
      <bpmndi:BPMNPlane id="W945_plane" bpmnElement="W_W945">
        <bpmndi:BPMNShape id="W945_Lane1_di" bpmnElement="W945_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
