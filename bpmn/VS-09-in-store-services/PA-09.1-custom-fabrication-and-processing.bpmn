    <bpmn:process id="W_W740" name="W740. Store-Level Customer Complaint On-the-Spot Resolution &amp; Floor Staff Empowerment" isExecutable="false">
      <bpmn:documentation>Trigger: Customer expresses dissatisfaction to any floor associate or department supervisor
Frequency: Daily across 200 stores; estimated 200–400 on-the-spot resolutions/day chain-wide
Volume: ~1–2 per store per day (200–400/day chain-wide — 80%+ of all customer issues resolved at floor level before the ~2,000–3,000/month formal W41 complaints)
Owner: Department Supervisor
Participants: Floor Associate, Department Supervisor, Store Manager (escalation), Customer
Source: workflow W740 — Store-Level Customer Complaint On-the-Spot Resolution &amp; Floor Staff Empowerment</bpmn:documentation>
      <bpmn:laneSet id="W740_LaneSet5">
        <bpmn:lane id="W740_Lane1" name="Floor Associate">
        <bpmn:flowNodeRef>W740_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W740_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W740_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W740_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W740_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W740_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W740_Lane2" name="Department Supervisor">
        <bpmn:flowNodeRef>W740_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W740_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W740_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W740_Lane4" name="System">
        <bpmn:flowNodeRef>W740_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W740_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W740_Start6" name="Customer expresses dissatisfaction to any floor associate or department supervisor">
        <bpmn:outgoing>W740_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W740_Task7" name="Issue identification — Floor associate observes or is informed of customer…">
        <bpmn:documentation>Step 1: Issue identification — Floor associate observes or is informed of customer dissatisfaction; determines issue category (pricing, availability, quality, service, policy)
Responsible (R): Floor Associate
Accountable (A): Department Supervisor
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W740_Flow18</bpmn:incoming>
        <bpmn:outgoing>W740_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W740_Task8" name="Empathy &amp; acknowledgment — Associate acknowledges the concern using trained…">
        <bpmn:documentation>Step 2: Empathy &amp; acknowledgment — Associate acknowledges the concern using trained empathy phrases; assures customer the issue will be addressed immediately
Responsible (R): Floor Associate
Accountable (A): —
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W740_Flow19</bpmn:incoming>
        <bpmn:outgoing>W740_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W740_Task9" name="Issue assessment — Associate determines if within their resolution authority…">
        <bpmn:documentation>Step 3: Issue assessment — Associate determines if within their resolution authority: pricing discrepancy ≤ PHP 500, product exchange of same value, rain check for out-of-stock, fetching item from backroom, calling department expert
Responsible (R): Floor Associate
Accountable (A): Department Supervisor
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W740_Flow20</bpmn:incoming>
        <bpmn:outgoing>W740_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W740_Task10" name="Resolution execution — If within authority: apply resolution immediately (price…">
        <bpmn:documentation>Step 4: Resolution execution — If within authority: apply resolution immediately (price adjustment via W5B, exchange via W12A, rain check issuance, expedited retrieval); if outside authority, escalate to Step 5
Responsible (R): Floor Associate
Accountable (A): Department Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W740_Flow21</bpmn:incoming>
        <bpmn:outgoing>W740_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W740_Task11" name="Supervisor escalation — For issues exceeding associate authority: pricing…">
        <bpmn:documentation>Step 5: Supervisor escalation — For issues exceeding associate authority: pricing discrepancy &gt; PHP 500, return without receipt, defective high-value item, policy exception request — Department Supervisor applies resolution using extended authority matrix
Responsible (R): Department Supervisor
Accountable (A): Department Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W740_Flow22</bpmn:incoming>
        <bpmn:outgoing>W740_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W740_Task12" name="Store Manager escalation — For issues exceeding supervisor authority (refund &gt;…">
        <bpmn:documentation>Step 6: Store Manager escalation — For issues exceeding supervisor authority (refund &gt; PHP 5,000, safety concern, discrimination complaint, threat of DTI escalation) — escalate to Store Manager
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W740_Flow23</bpmn:incoming>
        <bpmn:outgoing>W740_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W740_Task13" name="Resolution logging — Regardless of resolution level, associate logs the issue…">
        <bpmn:documentation>Step 7: Resolution logging — Regardless of resolution level, associate logs the issue in the system: category, resolution type, time to resolve, customer satisfaction indicator (satisfied/neutral/dissatisfied)
Responsible (R): Floor Associate
Accountable (A): Department Supervisor
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W740_Flow24</bpmn:incoming>
        <bpmn:outgoing>W740_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W740_Task14" name="Pattern flagging — System aggregates daily on-the-spot resolutions; flags…">
        <bpmn:documentation>Step 8: Pattern flagging — System aggregates daily on-the-spot resolutions; flags recurring issues (same SKU pricing error, same department service complaints) for root cause action via W507
Responsible (R): System / Department Supervisor
Accountable (A): Department Supervisor
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W740_Flow25</bpmn:incoming>
        <bpmn:outgoing>W740_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W740_End15" name="Complete">
