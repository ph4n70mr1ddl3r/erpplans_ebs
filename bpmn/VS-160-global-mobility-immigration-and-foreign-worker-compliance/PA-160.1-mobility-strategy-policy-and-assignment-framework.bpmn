      <bpmn:sequenceFlow id="W4704_Flow12" sourceRef="W4704_Task5" targetRef="W4704_Task6" />
      <bpmn:sequenceFlow id="W4704_Flow13" sourceRef="W4704_Task6" targetRef="W4704_End7" />
    </bpmn:process>
