        <bpmndi:BPMNEdge id="W4698_Flow11_di" bpmnElement="W4698_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4698_Flow12_di" bpmnElement="W4698_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4698_Flow13_di" bpmnElement="W4698_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4698_Assoc9_di" bpmnElement="W4698_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4699" name="W4699. Mobility Cost-Budget, Package Design &amp; Balance-Sheet vs. Lump-Sum" isExecutable="false">
      <bpmn:documentation>Trigger: Assignment costing; annual mobility budget
Frequency: Per assignment + annual budget
Volume: ~20–40 assignments/year; 1 mobility budget
Owner: Head of Global Mobility / Finance Partner
Participants: Finance/FP&amp;A (VS-17.4), Comp &amp; Benefits (VS-102), Tax (VS-79), Procurement (VS-34)
Source: workflow W4699 — Mobility Cost-Budget, Package Design &amp; Balance-Sheet vs. Lump-Sum</bpmn:documentation>
      <bpmn:laneSet id="W4699_LaneSet2">
        <bpmn:lane id="W4699_Lane1" name="Global Mobility">
        <bpmn:flowNodeRef>W4699_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4699_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4699_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4699_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4699_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4699_Start3" name="Assignment costing; annual mobility budget">
        <bpmn:outgoing>W4699_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4699_Task4" name="Cost each assignment: base salary, assignment allowances (premium, hardship…">
        <bpmn:documentation>Step 1: Cost each assignment: base salary, assignment allowances (premium, hardship, cost-of-living differential), housing (VS-144/W4716), relocation, tax-equalization cost, schooling (dependents), and return trips; choose balance-sheet (maintain home-country spend + host differentials) vs. lump-sum (VS-102)
Responsible (R): Global Mobility / Finance / Comp
Accountable (A): Head of Global Mobility / CFO
Duration: Per assignment</bpmn:documentation>
        <bpmn:incoming>W4699_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4699_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4699_Task5" name="Build the annual mobility budget (by entity VS-72); approve assignments per the…">
        <bpmn:documentation>Step 2: Build the annual mobility budget (by entity VS-72); approve assignments per the cost-approval matrix (tiered by cost); track actual vs. budget
Responsible (R): Global Mobility / FP&amp;A
Accountable (A): CHRO / CFO
Duration: Annual + per assignment</bpmn:documentation>
        <bpmn:incoming>W4699_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4699_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4699_Task6" name="Identify cost-optimization (localization W4718 vs. continued expatriation…">
        <bpmn:documentation>Step 3: Identify cost-optimization (localization W4718 vs. continued expatriation, package benchmarking VS-102) and report mobility spend analytics (W4720)
Responsible (R): Global Mobility / Finance
Accountable (A): CHRO / CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4699_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4699_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4699_End7" name="Complete">
        <bpmn:incoming>W4699_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4699_Annotation8">
        <bpmn:text>Controls: - CTL-710 (ensure controlled execution — Mobility Strategy, Policy &amp; Assignment Framework (PA-160.1).) | - CTL-710: assignment cost per policy and approval matrix; actual-vs-budget tracked; localization reviewed
Owner: Head of Global Mobility / Finance Partner</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4699_Assoc9" sourceRef="W4699_Annotation8" targetRef="W4699_Start3" associationDirection="None" />
