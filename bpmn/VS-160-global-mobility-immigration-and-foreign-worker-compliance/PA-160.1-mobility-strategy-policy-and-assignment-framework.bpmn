      <bpmn:sequenceFlow id="W4699_Flow12" sourceRef="W4699_Task5" targetRef="W4699_Task6" />
      <bpmn:sequenceFlow id="W4699_Flow13" sourceRef="W4699_Task6" targetRef="W4699_End7" />
    </bpmn:process>
