      <bpmn:sequenceFlow id="W4698_Flow11" sourceRef="W4698_Task4" targetRef="W4698_Task5" />
      <bpmn:sequenceFlow id="W4698_Flow12" sourceRef="W4698_Task5" targetRef="W4698_Task6" />
      <bpmn:sequenceFlow id="W4698_Flow13" sourceRef="W4698_Task6" targetRef="W4698_End7" />
    </bpmn:process>
