      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4698" name="W4698. Assignment Types: Long-Term, Short-Term, Commuter, Localization &amp; Business-Visitor Policy" isExecutable="false">
      <bpmn:documentation>Trigger: Assignment need; policy application
Frequency: Per assignment
Volume: ~20–40 assignments/year across types (foreign executives, seconded experts, provincial transfers)
Owner: Head of Global Mobility
Participants: HR Business Partners (VS-19/VS-103), Tax (VS-79), Immigration (PA-160.2), hiring managers
Source: workflow W4698 — Assignment Types: Long-Term, Short-Term, Commuter, Localization &amp; Business-Visitor Policy</bpmn:documentation>
      <bpmn:laneSet id="W4698_LaneSet2">
        <bpmn:lane id="W4698_Lane1" name="Global Mobility">
        <bpmn:flowNodeRef>W4698_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4698_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4698_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4698_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4698_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4698_Start3" name="Assignment need; policy application">
        <bpmn:outgoing>W4698_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4698_Task4" name="Classify each assignment by type — long-term (LT, typically &gt;12 months, with…">
        <bpmn:documentation>Step 1: Classify each assignment by type — long-term (LT, typically &gt;12 months, with relocation/family), short-term (ST, &lt;12 months, no family relocation), commuter (regular cross-border without relocation), localization (permanent host-country conversion), and business-visitor (short meetings, no work-permit) — each with distinct immigration/tax/payroll treatment
Responsible (R): Global Mobility / HRBP / Tax
Accountable (A): Head of Global Mobility
Duration: Per assignment</bpmn:documentation>
        <bpmn:incoming>W4698_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4698_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4698_Task5" name="Apply the per-type package and compliance (immigration W4705–W4707, payroll/tax…">
        <bpmn:documentation>Step 2: Apply the per-type package and compliance (immigration W4705–W4707, payroll/tax W4713/W4714, housing W4716, duty-of-care W4704) and confirm the assignment meets the policy test (genuine business need, not labor-only-contracting avoidance VS-98)
Responsible (R): Global Mobility / HRBP
Accountable (A): Head of Global Mobility / CHRO
Duration: Per assignment</bpmn:documentation>
        <bpmn:incoming>W4698_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4698_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4698_Task6" name="Document the assignment decision and terms in the assignment letter; ensure the…">
        <bpmn:documentation>Step 3: Document the assignment decision and terms in the assignment letter; ensure the business-visitor vs. work-permit line is not crossed (visitor doing productive work = immigration violation)
Responsible (R): Global Mobility / Legal
Accountable (A): Head of Global Mobility / VP Legal
Duration: Per assignment</bpmn:documentation>
        <bpmn:incoming>W4698_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4698_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4698_End7" name="Complete">
        <bpmn:incoming>W4698_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4698_Annotation8">
        <bpmn:text>Controls: - CTL-710 (ensure controlled execution — Mobility Strategy, Policy &amp; Assignment Framework (PA-160.1).) | - CTL-710: classification framework applied; business-visitor vs. work-permit line enforced; genuine-business-need documented
Owner: Head of Global Mobility</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4698_Assoc9" sourceRef="W4698_Annotation8" targetRef="W4698_Start3" associationDirection="None" />
