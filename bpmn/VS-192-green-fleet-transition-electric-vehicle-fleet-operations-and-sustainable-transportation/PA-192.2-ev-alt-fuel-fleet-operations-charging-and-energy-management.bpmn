    <bpmn:process id="W_W5474" name="W5474. Depot Charging Station Operations, Maintenance &amp; Uptime Management" isExecutable="false">
      <bpmn:documentation>Trigger: Chargers commissioned (W5468); daily operations; fault alerts
Frequency: Continuous; preventive maintenance per OEM schedule
Volume: Charging points across 4 DCs + stores (fleet-dedicated and shared with VS-163)
Owner: Facilities &amp; Energy Manager (VS-138)
Participants: Charger vendor/EPC, Fleet (VS-06), HSE (VS-24), EV-host ops (VS-163)
Source: workflow W5474 — Depot Charging Station Operations, Maintenance &amp; Uptime Management</bpmn:documentation>
      <bpmn:laneSet id="W5474_LaneSet3">
        <bpmn:lane id="W5474_Lane1" name="Facilities">
        <bpmn:flowNodeRef>W5474_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5474_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5474_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5474_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5474_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5474_Lane2" name="Facilities Analyst">
        <bpmn:flowNodeRef>W5474_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5474_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5474_Start4" name="Chargers commissioned (W5468); daily operations; fault alerts">
        <bpmn:outgoing>W5474_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5474_Task5" name="Operate the charger network (availability monitoring, session initiation…">
        <bpmn:documentation>Step 1: Operate the charger network (availability monitoring, session initiation support, fault triage) for both fleet-dedicated and shared customer-facing units (VS-163).
Responsible (R): Facilities / EV-Host Ops
Accountable (A): Facilities &amp; Energy Manager
Duration: daily</bpmn:documentation>
        <bpmn:incoming>W5474_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5474_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5474_Task6" name="Execute preventive maintenance per OEM schedule (connector/cable inspection…">
        <bpmn:documentation>Step 2: Execute preventive maintenance per OEM schedule (connector/cable inspection, cooling, firmware updates, ground-fault/earth-leakage tests) and maintain a charger asset register with uptime SLA.
Responsible (R): Facilities / Charger Vendor
Accountable (A): Facilities &amp; Energy Manager
Duration: per schedule</bpmn:documentation>
        <bpmn:incoming>W5474_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5474_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5474_Task7" name="Triage and resolve faults (error codes, communication faults, payment/OCPP…">
        <bpmn:documentation>Step 3: Triage and resolve faults (error codes, communication faults, payment/OCPP issues, hardware faults) under a vendor SLA; escalate to OEM field service; provide a backup charger or diesel fallback.
Responsible (R): Facilities / Charger Vendor
Accountable (A): Facilities &amp; Energy Manager
Duration: per fault</bpmn:documentation>
        <bpmn:incoming>W5474_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5474_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5474_Task8" name="Track and report charger uptime/availability (target e.g., ≥98%), MTBF/MTTR…">
        <bpmn:documentation>Step 4: Track and report charger uptime/availability (target e.g., ≥98%), MTBF/MTTR, and session success-rate per site; drive vendor performance against SLA.
Responsible (R): Facilities Analyst
Accountable (A): Facilities &amp; Energy Manager
Duration: monthly</bpmn:documentation>
        <bpmn:incoming>W5474_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5474_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5474_Task9" name="Coordinate HSE (VS-24) for any safety event (arc-flash, cable damage…">
        <bpmn:documentation>Step 5: Coordinate HSE (VS-24) for any safety event (arc-flash, cable damage, fire-signs) and feed incidents into the battery-fire/high-voltage safety program (W5483).
Responsible (R): Facilities / HSE
Accountable (A): Facilities &amp; Energy Manager
Duration: per event</bpmn:documentation>
        <bpmn:incoming>W5474_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5474_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5474_End10" name="Complete">
        <bpmn:incoming>W5474_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5474_Annotation11">
        <bpmn:text>Controls: - CTL-807 (ensure controlled execution — EV / Alt-Fuel Fleet Operations, Charging &amp; Energy Management (PA-192.2).) | - operational: charger-vendor TPRM/SLA; BFP/electrical-permit verification; uptime evidence; N+1 redundancy policy for depot fleet chargers; staged firmware rollout.
Owner: Facilities &amp; Energy Manager (VS-138)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5474_Assoc12" sourceRef="W5474_Annotation11" targetRef="W5474_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5474_Flow13" sourceRef="W5474_Start4" targetRef="W5474_Task5" />
      <bpmn:sequenceFlow id="W5474_Flow14" sourceRef="W5474_Task5" targetRef="W5474_Task6" />
      <bpmn:sequenceFlow id="W5474_Flow15" sourceRef="W5474_Task6" targetRef="W5474_Task7" />
      <bpmn:sequenceFlow id="W5474_Flow16" sourceRef="W5474_Task7" targetRef="W5474_Task8" />
      <bpmn:sequenceFlow id="W5474_Flow17" sourceRef="W5474_Task8" targetRef="W5474_Task9" />
      <bpmn:sequenceFlow id="W5474_Flow18" sourceRef="W5474_Task9" targetRef="W5474_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5474_diag">
      <bpmndi:BPMNPlane id="W5474_plane" bpmnElement="W_W5474">
        <bpmndi:BPMNShape id="W5474_Lane1_di" bpmnElement="W5474_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5474_Lane2_di" bpmnElement="W5474_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5474_Task5_di" bpmnElement="W5474_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
