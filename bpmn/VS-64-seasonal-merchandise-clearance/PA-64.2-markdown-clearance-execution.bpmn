    <bpmn:process id="W_W2392" name="W2392. Store-Level Clearance Event Execution" isExecutable="false">
      <bpmn:documentation>Trigger: End-of-season clearance event
Frequency: 6/year; 200 stores
Volume: ~1,200 clearance events/year
Owner: Store Manager
Participants: Store Manager, Marketing, Merch Coord
Source: workflow W2392 — Store-Level Clearance Event Execution</bpmn:documentation>
      <bpmn:laneSet id="W2392_LaneSet2">
        <bpmn:lane id="W2392_Lane1" name="Marketing">
        <bpmn:flowNodeRef>W2392_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2392_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2392_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2392_Start3" name="End-of-season clearance event">
        <bpmn:outgoing>W2392_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2392_Task4" name="Marketing promotes clearance event (social media, email, in-store signage)…">
        <bpmn:documentation>Step 1: Marketing promotes clearance event (social media, email, in-store signage); Store Manager sets up clearance zone; staff applies clearance labels; manages customer flow during event
Responsible (R): Marketing / Store Manager
Accountable (A): Regional Ops Mgr
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2392_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2392_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2392_End5" name="Complete">
        <bpmn:incoming>W2392_Flow9</bpmn:incoming>
      </bpmn:endEvent>
