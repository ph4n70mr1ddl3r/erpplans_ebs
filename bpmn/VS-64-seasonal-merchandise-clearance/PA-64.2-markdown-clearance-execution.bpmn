    <bpmn:process id="W_W2395" name="W2395. Clearance Pricing Compliance Audit" isExecutable="false">
      <bpmn:documentation>Trigger: During clearance event
Frequency: Per clearance event (6/year); 200 stores
Volume: ~1,200 compliance checks/year
Owner: Merchandising Coordinator
Participants: Merch Coord, Store Manager, Regional Ops
Source: workflow W2395 — Clearance Pricing Compliance Audit</bpmn:documentation>
      <bpmn:laneSet id="W2395_LaneSet2">
        <bpmn:lane id="W2395_Lane1" name="Merch Coordinator">
        <bpmn:flowNodeRef>W2395_Task4</bpmn:flowNodeRef>
