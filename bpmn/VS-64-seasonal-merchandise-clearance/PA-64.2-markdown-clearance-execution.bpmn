        <bpmn:outgoing>W2394_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2394_Task4" name="Finance calculates vendor markdown allowance per agreement: unsold inventory ×…">
        <bpmn:documentation>Step 1: Finance calculates vendor markdown allowance per agreement: unsold inventory × agreed support %; submits claim to vendor; vendor validates and credits; Finance records in AP
Responsible (R): Finance Analyst
Accountable (A): Finance Manager
Duration: 2–3 days/season</bpmn:documentation>
        <bpmn:incoming>W2394_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2394_Flow9</bpmn:outgoing>
      </bpmn:userTask>
