    <bpmn:process id="W_W2390" name="W2390. Sell-Through Based Markdown Trigger" isExecutable="false">
      <bpmn:documentation>Trigger: Seasonal SKU sell-through falls below plan threshold
Frequency: Continuous during season; ~200–300 markdown decisions/season
Volume: ~200–300 decisions/season
Owner: Category Manager
Participants: Category Mgr, Pricing Analyst, Merch Planner, Promotions Specialist, Promotions &amp; Vendor-Funding Coordinator
Source: workflow W2390 — Sell-Through Based Markdown Trigger</bpmn:documentation>
      <bpmn:laneSet id="W2390_LaneSet3">
        <bpmn:lane id="W2390_Lane1" name="System">
        <bpmn:flowNodeRef>W2390_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2390_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2390_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W2390_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2390_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2390_Start4" name="Seasonal SKU sell-through falls below plan threshold">
        <bpmn:outgoing>W2390_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2390_Task5" name="System monitors sell-through vs. plan; auto-flags SKUs below threshold: &lt;40%…">
        <bpmn:documentation>Step 1: System monitors sell-through vs. plan; auto-flags SKUs below threshold: &lt;40% sold at mid-season, &lt;70% at 75% of season; Pricing Analyst recommends markdown level based on residual inventory and weeks remaining
Responsible (R): System / Pricing Analyst
Accountable (A): Category Manager
Duration: Automated + 30 min/decision</bpmn:documentation>
        <bpmn:incoming>W2390_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2390_Flow11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2390_Task6" name="Category Manager approves markdown; system updates price; POS reflects new…">
        <bpmn:documentation>Step 2: Category Manager approves markdown; system updates price; POS reflects new price; shelf labels updated; customer communication if significant price reduction
Responsible (R): Category Manager / IT
Accountable (A): VP Merchandising
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W2390_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2390_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2390_End7" name="Complete">
        <bpmn:incoming>W2390_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2390_Annotation8">
        <bpmn:text>Controls: - CTL-176 (ensure markdown &amp; clearance pricing compliance.) | - CTL-422 (price-change authorization — links to VS-08 / W40 price-change execution); operational: Category Manager markdown approval
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2390_Assoc9" sourceRef="W2390_Annotation8" targetRef="W2390_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2390_Flow10" sourceRef="W2390_Start4" targetRef="W2390_Task5" />
      <bpmn:sequenceFlow id="W2390_Flow11" sourceRef="W2390_Task5" targetRef="W2390_Task6" />
      <bpmn:sequenceFlow id="W2390_Flow12" sourceRef="W2390_Task6" targetRef="W2390_End7" />
    </bpmn:process>
