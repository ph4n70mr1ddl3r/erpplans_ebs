    <bpmn:process id="W_W2393" name="W2393. Clearance Inventory Consolidation" isExecutable="false">
      <bpmn:documentation>Trigger: Post-clearance remaining inventory
Frequency: Per season; after clearance event
Volume: ~5–15% of seasonal inventory unsold after clearance
Owner: Merchandising Planner
Participants: Merch Planner, DC Ops, Store Managers
Source: workflow W2393 — Clearance Inventory Consolidation</bpmn:documentation>
      <bpmn:laneSet id="W2393_LaneSet2">
        <bpmn:lane id="W2393_Lane1" name="Merchandising Planner">
        <bpmn:flowNodeRef>W2393_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2393_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2393_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2393_Start3" name="Post-clearance remaining inventory">
        <bpmn:outgoing>W2393_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2393_Task4" name="Planner identifies remaining clearance inventory across stores; determines…">
        <bpmn:documentation>Step 1: Planner identifies remaining clearance inventory across stores; determines disposition: (a) transfer to stores still selling (regional variation), (b) consolidate at DC for bulk sale to discount buyers, (c) return to vendor per markdown agreement, (d) donate for tax benefit
Responsible (R): Merchandising Planner
Accountable (A): Category Manager
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2393_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2393_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2393_End5" name="Complete">
        <bpmn:incoming>W2393_Flow9</bpmn:incoming>
      </bpmn:endEvent>
