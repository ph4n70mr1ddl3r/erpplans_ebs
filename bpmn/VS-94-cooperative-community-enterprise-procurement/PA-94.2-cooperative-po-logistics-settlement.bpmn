    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3122" name="W3122. Cooperative Production Monitoring &amp; Progress Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: PO placed; weekly progress check
Frequency: Weekly during production
Volume: All open coop POs
Owner: Sustainability Sourcing Manager
Participants: Sustainability Sourcing Mgr, Coop Representatives, Quality, Logistics
Source: workflow W3122 — Cooperative Production Monitoring &amp; Progress Tracking</bpmn:documentation>
      <bpmn:laneSet id="W3122_LaneSet4">
        <bpmn:lane id="W3122_Lane1" name="Coop Representatives">
        <bpmn:flowNodeRef>W3122_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3122_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3122_Lane2" name="Sustainability Sourcing Mgr">
        <bpmn:flowNodeRef>W3122_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3122_Lane3" name="Quality Inspector">
        <bpmn:flowNodeRef>W3122_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3122_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3122_Start5" name="PO placed; weekly progress check">
        <bpmn:outgoing>W3122_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3122_Task6" name="Coop Representatives submit weekly progress: units produced, on-hand raw…">
        <bpmn:documentation>Step 1: Coop Representatives submit weekly progress: units produced, on-hand raw material, in-process, expected completion, any blockers (weather, labor, material supply, equipment)
Responsible (R): Coop Representatives
Accountable (A): Sustainability Sourcing Manager
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W3122_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3122_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3122_Task7" name="Sustainability Sourcing Mgr reviews progress vs. plan; for at-risk POs: re-plan…">
        <bpmn:documentation>Step 2: Sustainability Sourcing Mgr reviews progress vs. plan; for at-risk POs: re-plan with coop, expedite, partial-ship approval, or communicate revised delivery to Planning (links to VS-02) and stores
Responsible (R): Sustainability Sourcing Mgr
Accountable (A): Sustainability Sourcing Manager
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W3122_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3122_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3122_Task8" name="Quality performs in-line (in-process) inspection if applicable; corrective…">
        <bpmn:documentation>Step 3: Quality performs in-line (in-process) inspection if applicable; corrective action before shipment to reduce rejects at receipt (links to W3125)
Responsible (R): Quality Inspector
Accountable (A): Quality Manager
Duration: As needed</bpmn:documentation>
        <bpmn:incoming>W3122_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3122_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3122_End9" name="Complete">
        <bpmn:incoming>W3122_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3122_Annotation10">
        <bpmn:text>Controls: - CTL-68 (ensure cooperative vendor qualification &amp; settlement integrity.) | - operational: simple mobile/SMS-based reporting and periodic on-site visit
Owner: Sustainability Sourcing Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3122_Assoc11" sourceRef="W3122_Annotation10" targetRef="W3122_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3122_Flow12" sourceRef="W3122_Start5" targetRef="W3122_Task6" />
      <bpmn:sequenceFlow id="W3122_Flow13" sourceRef="W3122_Task6" targetRef="W3122_Task7" />
      <bpmn:sequenceFlow id="W3122_Flow14" sourceRef="W3122_Task7" targetRef="W3122_Task8" />
      <bpmn:sequenceFlow id="W3122_Flow15" sourceRef="W3122_Task8" targetRef="W3122_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3122_diag">
      <bpmndi:BPMNPlane id="W3122_plane" bpmnElement="W_W3122">
        <bpmndi:BPMNShape id="W3122_Lane1_di" bpmnElement="W3122_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3122_Lane2_di" bpmnElement="W3122_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
