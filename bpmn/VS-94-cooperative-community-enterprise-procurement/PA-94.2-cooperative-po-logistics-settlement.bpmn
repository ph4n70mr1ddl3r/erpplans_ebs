    <bpmn:process id="W_W3126" name="W3126. Cooperative Invoice, Livelihood Settlement &amp; Direct-to-Account Pay" isExecutable="false">
      <bpmn:documentation>Trigger: Goods accepted; invoice received
Frequency: Per PO settlement
Volume: Per coop PO
Owner: Sustainability Sourcing Manager
Participants: Sustainability Sourcing Mgr, AP (links to VS-15), Finance, Treasury (links to VS-18), Coop Representatives
Source: workflow W3126 — Cooperative Invoice, Livelihood Settlement &amp; Direct-to-Account Pay</bpmn:documentation>
      <bpmn:laneSet id="W3126_LaneSet4">
        <bpmn:lane id="W3126_Lane1" name="AP Clerk">
        <bpmn:flowNodeRef>W3126_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3126_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3126_Lane2" name="Finance Analyst">
        <bpmn:flowNodeRef>W3126_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3126_Lane3" name="Treasury Analyst">
        <bpmn:flowNodeRef>W3126_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3126_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3126_Start5" name="Goods accepted; invoice received">
        <bpmn:outgoing>W3126_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3126_Task6" name="Coop submits invoice per accepted quantity at contract price (W3116); AP…">
        <bpmn:documentation>Step 1: Coop submits invoice per accepted quantity at contract price (W3116); AP performs match: PO → GR (W3125) → Invoice, with adjustment for any partial-reject/short-ship; validate fair-trade price compliance
Responsible (R): AP Clerk
Accountable (A): Finance Manager
Duration: Per invoice</bpmn:documentation>
        <bpmn:incoming>W3126_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3126_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3126_Task7" name="Sustainability Sourcing Mgr/Finance execute direct-to-coop-account settlement…">
        <bpmn:documentation>Step 2: Sustainability Sourcing Mgr/Finance execute direct-to-coop-account settlement: payment to coop&#x27;s CDA-registered bank account; for indigenous/artisanal work, consider direct-to-beneficiary split per contract; favor faster terms than mainstream (e.g., net 15 vs. net 30)
Responsible (R): Finance Analyst / Treasury
Accountable (A): CFO
Duration: Per settlement</bpmn:documentation>
        <bpmn:incoming>W3126_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3126_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3126_Task8" name="Treasury (links to VS-18) process payment via bank transfer (not cheque — rural…">
        <bpmn:documentation>Step 3: Treasury (links to VS-18) process payment via bank transfer (not cheque — rural banking friction); confirm receipt with coop; record in AP subledger and impact tracker (links to W3129)
Responsible (R): Treasury Analyst
Accountable (A): Finance Manager
Duration: Per payment</bpmn:documentation>
        <bpmn:incoming>W3126_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3126_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3126_End9" name="Complete">
        <bpmn:incoming>W3126_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3126_Annotation10">
        <bpmn:text>Controls: - CTL-68 (ensure cooperative vendor qualification &amp; settlement integrity.) | - operational: mandatory direct-to-bank and expedited terms
Owner: Sustainability Sourcing Manager</bpmn:text>
      </bpmn:textAnnotation>
