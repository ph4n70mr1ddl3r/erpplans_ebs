<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-94.2-cooperative-po-logistics-settlement" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3121" name="W3121. Cooperative Demand Aggregation &amp; PO Placement" isExecutable="false">
      <bpmn:documentation>Trigger: Demand plan (links to VS-02); coop production cycle; new SKU introduction
Frequency: Per cycle (often monthly/seasonal)
Volume: ~10–40 coop POs/month
Owner: Sustainability Sourcing Manager
Participants: Sustainability Sourcing Mgr, Buyer (links to VS-03), Inventory Planning, Coop Representatives
Source: workflow W3121 — Cooperative Demand Aggregation &amp; PO Placement</bpmn:documentation>
      <bpmn:laneSet id="W3121_LaneSet4">
        <bpmn:lane id="W3121_Lane1" name="Inventory Planner">
        <bpmn:flowNodeRef>W3121_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3121_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3121_Lane2" name="Buyer">
        <bpmn:flowNodeRef>W3121_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3121_Lane3" name="System">
        <bpmn:flowNodeRef>W3121_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3121_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3121_Start5" name="Demand plan (links to VS-02); coop production cycle; new SKU introduction">
        <bpmn:outgoing>W3121_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3121_Task6" name="Inventory Planning/Sustainability Sourcing Mgr aggregate demand across stores…">
        <bpmn:documentation>Step 1: Inventory Planning/Sustainability Sourcing Mgr aggregate demand across stores for coop-sourced SKUs (links to VS-02); respect coop production capacity, minimum viable batch, and lead time; smooth demand to fit coop labor
Responsible (R): Inventory Planner / Sustainability Sourcing Mgr
Accountable (A): Sustainability Sourcing Manager
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W3121_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3121_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3121_Task7" name="Buyer/Sustainability Sourcing Mgr place PO (links to VS-03) with contract…">
        <bpmn:documentation>Step 2: Buyer/Sustainability Sourcing Mgr place PO (links to VS-03) with contract pricing (W3116), delivery window aligned to coop cycle (W3123), and clear spec reference (W3118); PO communicated in coop&#x27;s preferred language/channel and acknowledged
Responsible (R): Buyer / Sustainability Sourcing Mgr
Accountable (A): Sustainability Sourcing Manager
Duration: Per PO</bpmn:documentation>
        <bpmn:incoming>W3121_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3121_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W3121_Task8" name="System reserves commitment against capacity-building / advance-financing…">
        <bpmn:documentation>Step 3: System reserves commitment against capacity-building / advance-financing facility if applicable (links to W3127); flag PO as coop-sourced for impact tracking (links to W3129)
Responsible (R): System
Accountable (A): Sustainability Sourcing Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W3121_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3121_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W3121_End9" name="Complete">
        <bpmn:incoming>W3121_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3121_Annotation10">
        <bpmn:text>Controls: - CTL-512 (ensure controlled execution — Cooperative Purchase Order, Logistics &amp; Livelihood Settlement (PA-94.2).) | - operational: minimum-offtake commitment (W3116) and demand smoothing
Owner: Sustainability Sourcing Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3121_Assoc11" sourceRef="W3121_Annotation10" targetRef="W3121_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3121_Flow12" sourceRef="W3121_Start5" targetRef="W3121_Task6" />
      <bpmn:sequenceFlow id="W3121_Flow13" sourceRef="W3121_Task6" targetRef="W3121_Task7" />
      <bpmn:sequenceFlow id="W3121_Flow14" sourceRef="W3121_Task7" targetRef="W3121_Task8" />
      <bpmn:sequenceFlow id="W3121_Flow15" sourceRef="W3121_Task8" targetRef="W3121_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3121_diag">
      <bpmndi:BPMNPlane id="W3121_plane" bpmnElement="W_W3121">
        <bpmndi:BPMNShape id="W3121_Lane1_di" bpmnElement="W3121_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3121_Lane2_di" bpmnElement="W3121_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
