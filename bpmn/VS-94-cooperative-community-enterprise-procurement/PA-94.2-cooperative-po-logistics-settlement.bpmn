    <bpmn:process id="W_W3125" name="W3125. Cooperative Goods Receipt, Quality Inspection &amp; Acceptance" isExecutable="false">
      <bpmn:documentation>Trigger: Coop shipment arrives at BuildRight DC
Frequency: Per shipment
Volume: Per coop shipment (often small-batch)
Owner: Quality Manager
Participants: DC Receiving (links to VS-04), Quality, Sustainability Sourcing Mgr, Finance
Source: workflow W3125 — Cooperative Goods Receipt, Quality Inspection &amp; Acceptance</bpmn:documentation>
      <bpmn:laneSet id="W3125_LaneSet4">
        <bpmn:lane id="W3125_Lane1" name="DC Receiving Clerk">
        <bpmn:flowNodeRef>W3125_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3125_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3125_Lane2" name="Quality Inspector">
        <bpmn:flowNodeRef>W3125_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3125_Lane3" name="Quality">
        <bpmn:flowNodeRef>W3125_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3125_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3125_Start5" name="Coop shipment arrives at BuildRight DC">
        <bpmn:outgoing>W3125_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3125_Task6" name="DC Receiving (links to VS-04 W3) receives coop shipment: ASN/PO match, count…">
        <bpmn:documentation>Step 1: DC Receiving (links to VS-04 W3) receives coop shipment: ASN/PO match, count verification, condition check (damage in transit), special handling for fragile/handicraft/agricultural; flag for quality inspection
Responsible (R): DC Receiving Clerk
Accountable (A): DC Supervisor
Duration: Per receipt</bpmn:documentation>
        <bpmn:incoming>W3125_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3125_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3125_Task7" name="Quality performs AQL inspection per spec (W3118): dimensions, materials…">
        <bpmn:documentation>Step 2: Quality performs AQL inspection per spec (W3118): dimensions, materials, finish, packaging/labeling, lot/traceability; classify defects; accept / partial-reject / reject with documented evidence and photos
Responsible (R): Quality Inspector
Accountable (A): Quality Manager
Duration: Per receipt</bpmn:documentation>
        <bpmn:incoming>W3125_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3125_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3125_Task8" name="For accept: putaway to inventory (links to VS-05); for partial-reject: notify…">
        <bpmn:documentation>Step 3: For accept: putaway to inventory (links to VS-05); for partial-reject: notify coop, agree disposition (rework/credit/discount); for reject: hold, document, file quality claim (W3128); post to AP for settlement (W3126)
Responsible (R): Quality / Sustainability Sourcing Mgr / Finance
Accountable (A): Quality Manager
Duration: Per receipt</bpmn:documentation>
        <bpmn:incoming>W3125_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3125_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3125_End9" name="Complete">
        <bpmn:incoming>W3125_Flow15</bpmn:incoming>
      </bpmn:endEvent>
