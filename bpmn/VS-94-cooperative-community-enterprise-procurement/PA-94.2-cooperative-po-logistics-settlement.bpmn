        <bpmndi:BPMNEdge id="W3122_Flow13_di" bpmnElement="W3122_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3122_Flow14_di" bpmnElement="W3122_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3122_Flow15_di" bpmnElement="W3122_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3122_Assoc11_di" bpmnElement="W3122_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3123" name="W3123. Cooperative Harvest / Production Cycle &amp; Seasonal Calendar Management" isExecutable="false">
      <bpmn:documentation>Trigger: Annual seasonal planning; agricultural harvest cycle; festival/religious calendar
Frequency: Annual + per-cycle
Volume: All coop-sourced categories
Owner: Sustainability Sourcing Manager
Participants: Sustainability Sourcing Mgr, Category (links to VS-01/VS-64), Inventory Planning, Coop Representatives
Source: workflow W3123 — Cooperative Harvest / Production Cycle &amp; Seasonal Calendar Management</bpmn:documentation>
      <bpmn:laneSet id="W3123_LaneSet3">
        <bpmn:lane id="W3123_Lane1" name="Sustainability Sourcing Mgr">
        <bpmn:flowNodeRef>W3123_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3123_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3123_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3123_Lane2" name="Category">
        <bpmn:flowNodeRef>W3123_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3123_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3123_Start4" name="Annual seasonal planning; agricultural harvest cycle; festival/religious calendar">
        <bpmn:outgoing>W3123_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3123_Task5" name="Sustainability Sourcing Mgr/Coop map each coop&#x27;s production/harvest calendar…">
        <bpmn:documentation>Step 1: Sustainability Sourcing Mgr/Coop map each coop&#x27;s production/harvest calendar: agricultural harvest (garden/plants), festival-driven handicraft (Christmas/baskets), rainy-season limitations, religious/community feasts; document constraint windows
Responsible (R): Sustainability Sourcing Mgr / Coop
Accountable (A): Sustainability Sourcing Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3123_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3123_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3123_Task6" name="Category/Planning (links to VS-01/VS-64) align BuildRight promotional/seasonal…">
        <bpmn:documentation>Step 2: Category/Planning (links to VS-01/VS-64) align BuildRight promotional/seasonal plan to coop capacity: pre-position ahead of coop downtimes; avoid peak-demand during coop capacity troughs; plan forward stock (links to VS-64)
Responsible (R): Category / Inventory Planner
Accountable (A): VP Merchandising
Duration: Annual + per-cycle</bpmn:documentation>
        <bpmn:incoming>W3123_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3123_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3123_Task7" name="Sustainability Sourcing Mgr communicates confirmed seasonal PO plan to coops…">
        <bpmn:documentation>Step 3: Sustainability Sourcing Mgr communicates confirmed seasonal PO plan to coops with adequate lead time; manage exceptions (force-majeure weather — typhoon links to VS-69; raw-material shortage) with planning
Responsible (R): Sustainability Sourcing Mgr
Accountable (A): Sustainability Sourcing Manager
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W3123_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3123_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3123_End8" name="Complete">
        <bpmn:incoming>W3123_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3123_Annotation9">
        <bpmn:text>Controls: - CTL-512 (ensure controlled execution — Cooperative Purchase Order, Logistics &amp; Livelihood Settlement (PA-94.2).) | - operational: joint planning and forward-stock buffer
Owner: Sustainability Sourcing Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3123_Assoc10" sourceRef="W3123_Annotation9" targetRef="W3123_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3123_Flow11" sourceRef="W3123_Start4" targetRef="W3123_Task5" />
      <bpmn:sequenceFlow id="W3123_Flow12" sourceRef="W3123_Task5" targetRef="W3123_Task6" />
      <bpmn:sequenceFlow id="W3123_Flow13" sourceRef="W3123_Task6" targetRef="W3123_Task7" />
      <bpmn:sequenceFlow id="W3123_Flow14" sourceRef="W3123_Task7" targetRef="W3123_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3123_diag">
      <bpmndi:BPMNPlane id="W3123_plane" bpmnElement="W_W3123">
        <bpmndi:BPMNShape id="W3123_Lane1_di" bpmnElement="W3123_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3123_Lane2_di" bpmnElement="W3123_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
