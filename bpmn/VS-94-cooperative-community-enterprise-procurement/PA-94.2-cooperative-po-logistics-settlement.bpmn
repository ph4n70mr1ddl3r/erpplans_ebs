        <bpmndi:BPMNShape id="W3123_Start4_di" bpmnElement="W3123_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3123_End8_di" bpmnElement="W3123_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3123_Annotation9_di" bpmnElement="W3123_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3123_Flow11_di" bpmnElement="W3123_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3123_Flow12_di" bpmnElement="W3123_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3123_Flow13_di" bpmnElement="W3123_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3123_Flow14_di" bpmnElement="W3123_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3123_Assoc10_di" bpmnElement="W3123_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3124" name="W3124. Cooperative Inbound Logistics, Consolidation &amp; Last-Mile Pickup" isExecutable="false">
      <bpmn:documentation>Trigger: Coop production complete; ready-for-shipment notice
Frequency: Per shipment
Volume: Often small-parcel / LTL from remote coop locations
Owner: Sustainability Sourcing Manager
Participants: Sustainability Sourcing Mgr, Logistics (links to VS-06), 3PL (links to VS-56), Coop Representatives
Source: workflow W3124 — Cooperative Inbound Logistics, Consolidation &amp; Last-Mile Pickup</bpmn:documentation>
      <bpmn:laneSet id="W3124_LaneSet3">
        <bpmn:lane id="W3124_Lane1" name="Logistics Coordinator">
        <bpmn:flowNodeRef>W3124_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3124_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3124_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3124_Lane2" name="Logistics">
        <bpmn:flowNodeRef>W3124_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3124_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3124_Start4" name="Coop production complete; ready-for-shipment notice">
        <bpmn:outgoing>W3124_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3124_Task5" name="Coop notifies ready-for-shipment with quantity, packaging, dimensions, weight…">
        <bpmn:documentation>Step 1: Coop notifies ready-for-shipment with quantity, packaging, dimensions, weight, pickup location; Logistics plans most-economical mode: 3PL small-parcel (links to VS-56), own-fleet backhaul (links to VS-06), or consolidation with nearby coops
Responsible (R): Logistics Coordinator
Accountable (A): Sustainability Sourcing Manager
Duration: Per shipment</bpmn:documentation>
        <bpmn:incoming>W3124_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3124_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3124_Task6" name="For remote barangay pickups: arrange last-mile collection (motorcycle/tricycle…">
        <bpmn:documentation>Step 2: For remote barangay pickups: arrange last-mile collection (motorcycle/tricycle to consolidation point, then truck); document chain-of-custody; address rural infrastructure limits (road condition, typhoon disruption — links to VS-69)
Responsible (R): Logistics Coordinator / 3PL
Accountable (A): Sustainability Sourcing Manager
Duration: Per shipment</bpmn:documentation>
        <bpmn:incoming>W3124_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3124_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3124_Task7" name="Logistics/Coop handle export/import-equivalent paperwork if crossing regions or…">
        <bpmn:documentation>Step 3: Logistics/Coop handle export/import-equivalent paperwork if crossing regions or with indigenous products (CITES-equivalent, DENR permits for plant/forest materials — links to VS-22/VS-87); track in-transit to BuildRight DC
Responsible (R): Logistics / Coop / Regulatory
Accountable (A): Sustainability Sourcing Manager
Duration: Per shipment</bpmn:documentation>
        <bpmn:incoming>W3124_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3124_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3124_End8" name="Complete">
        <bpmn:incoming>W3124_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3124_Annotation9">
        <bpmn:text>Controls: - CTL-512 (ensure controlled execution — Cooperative Purchase Order, Logistics &amp; Livelihood Settlement (PA-94.2).) | - operational: consolidation, backhaul optimization, and DC pickup window flexibility
Owner: Sustainability Sourcing Manager</bpmn:text>
      </bpmn:textAnnotation>
