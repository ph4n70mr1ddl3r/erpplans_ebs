        <bpmndi:BPMNEdge id="W2006_Flow13_di" bpmnElement="W2006_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2006_Flow14_di" bpmnElement="W2006_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2006_Flow15_di" bpmnElement="W2006_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2006_Assoc11_di" bpmnElement="W2006_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2007" name="W2007. Multi-Channel Campaign Orchestration &amp; Launch" isExecutable="false">
      <bpmn:documentation>Trigger: Campaign creative approved and ready for launch
Frequency: ~30–50 multi-channel campaigns/quarter
Volume: Per campaign
Owner: Marketing Manager
Participants: Marketing Manager, Visual Merchandiser, Digital Marketing Manager
Source: workflow W2007 — Multi-Channel Campaign Orchestration &amp; Launch</bpmn:documentation>
      <bpmn:laneSet id="W2007_LaneSet2">
        <bpmn:lane id="W2007_Lane1" name="Marketing Manager">
        <bpmn:flowNodeRef>W2007_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2007_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2007_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2007_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2007_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2007_Start3" name="Campaign creative approved and ready for launch">
        <bpmn:outgoing>W2007_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2007_Task4" name="Campaign orchestration: (a) simultaneous launch across booked channels…">
        <bpmn:documentation>Step 1: Campaign orchestration: (a) simultaneous launch across booked channels: in-store placements, ecommerce ads, digital signage, (b) coordinate timing with vendor&#x27;s promotional pricing activation per W13, (c) ensure product availability at stores running campaign (ATP check)
Responsible (R): Marketing Manager
Accountable (A): CMO
Duration: 1 day/campaign</bpmn:documentation>
        <bpmn:incoming>W2007_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2007_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2007_Task5" name="Launch checklist: (a) in-store materials installed per W2000, (b) ecommerce ads…">
        <bpmn:documentation>Step 2: Launch checklist: (a) in-store materials installed per W2000, (b) ecommerce ads live and serving, (c) digital signage content playing, (d) print catalog/flyer distributed (if applicable), (e) all placements verified with photo evidence or screenshot
Responsible (R): Marketing Manager
Accountable (A): CMO
Duration: Per launch</bpmn:documentation>
        <bpmn:incoming>W2007_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2007_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2007_Task6" name="Post-launch monitoring (first 48 hours): (a) check ecommerce ad impressions and…">
        <bpmn:documentation>Step 3: Post-launch monitoring (first 48 hours): (a) check ecommerce ad impressions and clicks, (b) verify in-store installation compliance from store photos, (c) address any issues: creative errors, placement issues, product stockouts at campaign stores
Responsible (R): Marketing Manager / Digital Marketing Manager
Accountable (A): CMO
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W2007_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2007_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2007_End7" name="Complete">
        <bpmn:incoming>W2007_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2007_Annotation8">
        <bpmn:text>Controls: - CTL-386 (ensure controlled execution — Vendor Advertising Campaign Execution (PA-48.2).) | - operational: standard operating procedures; system-enforced validation rules | ---
Owner: Marketing Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2007_Assoc9" sourceRef="W2007_Annotation8" targetRef="W2007_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2007_Flow10" sourceRef="W2007_Start3" targetRef="W2007_Task4" />
      <bpmn:sequenceFlow id="W2007_Flow11" sourceRef="W2007_Task4" targetRef="W2007_Task5" />
      <bpmn:sequenceFlow id="W2007_Flow12" sourceRef="W2007_Task5" targetRef="W2007_Task6" />
      <bpmn:sequenceFlow id="W2007_Flow13" sourceRef="W2007_Task6" targetRef="W2007_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2007_diag">
      <bpmndi:BPMNPlane id="W2007_plane" bpmnElement="W_W2007">
        <bpmndi:BPMNShape id="W2007_Lane1_di" bpmnElement="W2007_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2007_Task4_di" bpmnElement="W2007_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2007_Task5_di" bpmnElement="W2007_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2007_Task6_di" bpmnElement="W2007_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2007_Start3_di" bpmnElement="W2007_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2007_End7_di" bpmnElement="W2007_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2007_Annotation8_di" bpmnElement="W2007_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2007_Flow10_di" bpmnElement="W2007_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2007_Flow11_di" bpmnElement="W2007_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2007_Flow12_di" bpmnElement="W2007_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2007_Flow13_di" bpmnElement="W2007_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2007_Assoc9_di" bpmnElement="W2007_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2008" name="W2008. In-Store Campaign Compliance Monitoring &amp; Photo Verification" isExecutable="false">
      <bpmn:documentation>Trigger: Campaign active; weekly compliance cycle
Frequency: Weekly during active campaigns
Volume: ~50–100 active in-store campaigns
Owner: Visual Merchandiser
Participants: Visual Merchandiser, Store Manager
Source: workflow W2008 — In-Store Campaign Compliance Monitoring &amp; Photo Verification</bpmn:documentation>
      <bpmn:laneSet id="W2008_LaneSet2">
        <bpmn:lane id="W2008_Lane1" name="Visual Merchandiser">
        <bpmn:flowNodeRef>W2008_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2008_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2008_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2008_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2008_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2008_Start3" name="Campaign active; weekly compliance cycle">
        <bpmn:outgoing>W2008_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2008_Task4" name="Weekly: Visual Merchandiser requests campaign compliance photos from stores…">
        <bpmn:documentation>Step 1: Weekly: Visual Merchandiser requests campaign compliance photos from stores: (a) Store Manager photographs each active placement, (b) uploads to campaign management system, (c) Visual Merchandiser reviews: (i) correct placement location, (ii) materials in good condition, (iii) products displayed correctly on endcaps
Responsible (R): Visual Merchandiser / Store Manager
Accountable (A): Marketing Manager
Duration: 15 min/store/week</bpmn:documentation>
        <bpmn:incoming>W2008_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2008_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2008_Task5" name="Compliance scoring: (a) fully compliant: materials installed correctly and in…">
        <bpmn:documentation>Step 2: Compliance scoring: (a) fully compliant: materials installed correctly and in good condition, (b) partially compliant: installed but with issues (wrong location, damaged materials), (c) non-compliant: not installed or removed, (d) store compliance score tracked per W67 (store performance)
Responsible (R): Visual Merchandiser
Accountable (A): Marketing Manager
Duration: 1–2 hours/week</bpmn:documentation>
        <bpmn:incoming>W2008_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2008_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2008_Task6" name="Remediation: (a) non-compliant stores: re-ship materials and request…">
        <bpmn:documentation>Step 3: Remediation: (a) non-compliant stores: re-ship materials and request re-installation within 3 days, (b) repeated non-compliance: escalate to Regional Manager, (c) compliance rate target: ≥ 90% of stores compliant within first week of campaign
Responsible (R): Visual Merchandiser / Store Manager
Accountable (A): Marketing Manager
Duration: Per campaign</bpmn:documentation>
        <bpmn:incoming>W2008_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2008_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2008_End7" name="Complete">
        <bpmn:incoming>W2008_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2008_Annotation8">
        <bpmn:text>Controls: - CTL-386 (ensure controlled execution — Vendor Advertising Campaign Execution (PA-48.2).) | - operational: Visual Merchandiser review and approval gate | ---
Owner: Visual Merchandiser</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2008_Assoc9" sourceRef="W2008_Annotation8" targetRef="W2008_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2008_Flow10" sourceRef="W2008_Start3" targetRef="W2008_Task4" />
      <bpmn:sequenceFlow id="W2008_Flow11" sourceRef="W2008_Task4" targetRef="W2008_Task5" />
      <bpmn:sequenceFlow id="W2008_Flow12" sourceRef="W2008_Task5" targetRef="W2008_Task6" />
      <bpmn:sequenceFlow id="W2008_Flow13" sourceRef="W2008_Task6" targetRef="W2008_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2008_diag">
      <bpmndi:BPMNPlane id="W2008_plane" bpmnElement="W_W2008">
        <bpmndi:BPMNShape id="W2008_Lane1_di" bpmnElement="W2008_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2008_Task4_di" bpmnElement="W2008_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2008_Task5_di" bpmnElement="W2008_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2008_Task6_di" bpmnElement="W2008_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2008_Start3_di" bpmnElement="W2008_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2008_End7_di" bpmnElement="W2008_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2008_Annotation8_di" bpmnElement="W2008_Annotation8"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2008_Flow10_di" bpmnElement="W2008_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2008_Flow11_di" bpmnElement="W2008_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2008_Flow12_di" bpmnElement="W2008_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2008_Flow13_di" bpmnElement="W2008_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2008_Assoc9_di" bpmnElement="W2008_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2009" name="W2009. Ecommerce Campaign Performance Optimization &amp; A/B Testing" isExecutable="false">
      <bpmn:documentation>Trigger: Ecommerce ad campaign active; optimization cycle
Frequency: Continuous during active campaigns
Volume: ~50–100 active ecommerce campaigns
Owner: Digital Marketing Manager
Participants: Digital Marketing Manager, Ecommerce Manager
Source: workflow W2009 — Ecommerce Campaign Performance Optimization &amp; A/B Testing</bpmn:documentation>
      <bpmn:laneSet id="W2009_LaneSet2">
        <bpmn:lane id="W2009_Lane1" name="Digital Marketing Manager">
        <bpmn:flowNodeRef>W2009_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2009_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2009_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2009_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2009_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2009_Start3" name="Ecommerce ad campaign active; optimization cycle">
        <bpmn:outgoing>W2009_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2009_Task4" name="Daily monitoring: (a) impressions, clicks, CTR, CPC, spend, conversions (sales…">
        <bpmn:documentation>Step 1: Daily monitoring: (a) impressions, clicks, CTR, CPC, spend, conversions (sales attributed to ad), (b) ROAS: revenue from ad clicks ÷ ad spend, (c) flag campaigns with CTR &lt; 0.5% or ROAS &lt; 3x for optimization
Responsible (R): Digital Marketing Manager
Accountable (A): CMO
Duration: 30 min/day</bpmn:documentation>
        <bpmn:incoming>W2009_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2009_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2009_Task5" name="Optimization actions: (a) adjust bids: increase CPC for high-performing…">
        <bpmn:documentation>Step 2: Optimization actions: (a) adjust bids: increase CPC for high-performing keywords, decrease for low-performing, (b) A/B test: rotate banner creative, test different headlines, (c) targeting refinement: narrow audience segments for better conversion, (d) budget reallocation: shift spend from underperforming to overperforming placements
Responsible (R): Digital Marketing Manager
Accountable (A): CMO
Duration: 1–2 hours/week</bpmn:documentation>
        <bpmn:incoming>W2009_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2009_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2009_Task6" name="Monthly: report optimization results to vendor with recommendations for next…">
        <bpmn:documentation>Step 3: Monthly: report optimization results to vendor with recommendations for next campaign cycle
Responsible (R): Digital Marketing Manager
Accountable (A): CMO
Duration: Per vendor</bpmn:documentation>
        <bpmn:incoming>W2009_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2009_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2009_End7" name="Complete">
        <bpmn:incoming>W2009_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2009_Annotation8">
