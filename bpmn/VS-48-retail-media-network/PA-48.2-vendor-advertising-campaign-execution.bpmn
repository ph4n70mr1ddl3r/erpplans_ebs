    <bpmn:process id="W_W2012" name="W2012. Seasonal Media Package Development &amp; Sales" isExecutable="false">
      <bpmn:documentation>Trigger: Seasonal planning cycle (aligned to BuildRight&#x27;s seasonal calendar)
Frequency: 6 seasonal packages/year (bi-monthly)
Volume: ~30–60 seasonal packages sold/year (within the 5–10/season availability)
Owner: Marketing Manager
Participants: Marketing Manager, Retail Media &amp; Marketplace Manager, VP Merchandising, Vendor
Source: workflow W2012 — Seasonal Media Package Development &amp; Sales</bpmn:documentation>
      <bpmn:laneSet id="W2012_LaneSet3">
        <bpmn:lane id="W2012_Lane1" name="Marketing Manager">
        <bpmn:flowNodeRef>W2012_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2012_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2012_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2012_Lane2" name="Retail Media &amp; Marketplace Manager">
        <bpmn:flowNodeRef>W2012_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2012_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2012_Start4" name="Seasonal planning cycle (aligned to BuildRight&#x27;s seasonal calendar)">
        <bpmn:outgoing>W2012_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2012_Task5" name="Marketing Manager develops seasonal media package: (a) season: summer (garden…">
        <bpmn:documentation>Step 1: Marketing Manager develops seasonal media package: (a) season: summer (garden, outdoor, aircon), rainy (waterproofing, flood control), Ber-months (holiday, home improvement), etc., (b) package components: (i) endcap in all stores for 2 weeks, (ii) homepage banner for 1 week, (iii) catalog feature page, (iv) social media mention, (c) package pricing: 20–30% discount vs. à la carte booking, (d) limited availability: 5–10 packages per season
Responsible (R): Marketing Manager
Accountable (A): CMO
Duration: 1 week/season</bpmn:documentation>
        <bpmn:incoming>W2012_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2012_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2012_Task6" name="Retail Media &amp; Marketplace Manager sells seasonal packages to vendors: (a)…">
        <bpmn:documentation>Step 2: Retail Media &amp; Marketplace Manager sells seasonal packages to vendors: (a) priority offer to existing media vendors, (b) present seasonal sales opportunity (higher foot traffic during seasonal peaks), (c) close deals before seasonal catalog deadline
Responsible (R): Retail Media &amp; Marketplace Manager
Accountable (A): Marketing Manager
Duration: 2–3 weeks/season</bpmn:documentation>
        <bpmn:incoming>W2012_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2012_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2012_Task7" name="Execution: (a) package campaigns launched per W2007 multi-channel…">
        <bpmn:documentation>Step 3: Execution: (a) package campaigns launched per W2007 multi-channel orchestration, (b) all package components tracked as single campaign
Responsible (R): Marketing Manager
Accountable (A): CMO
Duration: Per season</bpmn:documentation>
        <bpmn:incoming>W2012_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2012_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2012_End8" name="Complete">
        <bpmn:incoming>W2012_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2012_Annotation9">
        <bpmn:text>Controls: - CTL-386 (ensure controlled execution — Vendor Advertising Campaign Execution (PA-48.2).) | - operational: standard operating procedures; system-enforced validation rules | ---
Owner: Marketing Manager</bpmn:text>
