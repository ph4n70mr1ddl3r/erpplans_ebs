    <bpmn:process id="W_W2011" name="W2011. Retail Media Campaign Reporting &amp; Vendor Presentation" isExecutable="false">
      <bpmn:documentation>Trigger: Campaign completion; monthly/quarterly reporting cycle
Frequency: Per campaign completion; monthly vendor reports
Volume: ~50–100 campaign reports/quarter
Owner: Marketing Manager
Participants: Marketing Manager, Retail Media &amp; Marketplace Manager, Vendor
Source: workflow W2011 — Retail Media Campaign Reporting &amp; Vendor Presentation</bpmn:documentation>
      <bpmn:laneSet id="W2011_LaneSet4">
        <bpmn:lane id="W2011_Lane1" name="System">
        <bpmn:flowNodeRef>W2011_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2011_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2011_Lane2" name="Retail Media &amp; Marketplace Manager">
        <bpmn:flowNodeRef>W2011_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2011_Lane3" name="Marketing Manager">
        <bpmn:flowNodeRef>W2011_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2011_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2011_Start5" name="Campaign completion; monthly/quarterly reporting cycle">
        <bpmn:outgoing>W2011_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2011_Task6" name="System generates campaign performance report: (a) in-store: store compliance…">
        <bpmn:documentation>Step 1: System generates campaign performance report: (a) in-store: store compliance rate, estimated impressions (foot traffic × placement location), associated product sales lift (pre vs. during campaign), (b) ecommerce: impressions, clicks, CTR, CPC, ROAS, attributed revenue, (c) print: distribution count, redemption rate (if promo code used)
Responsible (R): System
Accountable (A): Marketing Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2011_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2011_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2011_Task7" name="Retail Media &amp; Marketplace Manager presents report to vendor: (a) campaign…">
        <bpmn:documentation>Step 2: Retail Media &amp; Marketplace Manager presents report to vendor: (a) campaign performance vs. objectives, (b) ROI analysis: vendor investment vs. sales lift, (c) recommendations for next campaign: optimization insights, (d) upsell: suggest additional placements or channels based on performance
Responsible (R): Retail Media &amp; Marketplace Manager
Accountable (A): Marketing Manager
Duration: 30–60 min/vendor</bpmn:documentation>
        <bpmn:incoming>W2011_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2011_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2011_Task8" name="Quarterly: Marketing Manager compiles retail media network performance for CMO…">
        <bpmn:documentation>Step 3: Quarterly: Marketing Manager compiles retail media network performance for CMO: (a) total media revenue, (b) fill rate: % of inventory sold, (c) vendor retention: % of vendors rebooking, (d) top-performing placements by revenue and vendor ROI
Responsible (R): Marketing Manager
Accountable (A): CMO
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W2011_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2011_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2011_End9" name="Complete">
        <bpmn:incoming>W2011_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2011_Annotation10">
        <bpmn:text>Controls: - CTL-386 (ensure controlled execution — Vendor Advertising Campaign Execution (PA-48.2).) | - operational: standard operating procedures; system-enforced validation rules | ---
Owner: Marketing Manager</bpmn:text>
      </bpmn:textAnnotation>
