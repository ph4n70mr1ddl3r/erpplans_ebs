        <bpmndi:BPMNEdge id="W2012_Flow11_di" bpmnElement="W2012_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2012_Flow12_di" bpmnElement="W2012_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2012_Flow13_di" bpmnElement="W2012_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2012_Flow14_di" bpmnElement="W2012_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2012_Assoc10_di" bpmnElement="W2012_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2013" name="W2013. Retail Media Campaign Exception &amp; Quality Issue Resolution" isExecutable="false">
      <bpmn:documentation>Trigger: Media campaign quality issue or exception
Frequency: ~10–20 quality issues/quarter
Volume: Per issue
Owner: Marketing Manager
Participants: Marketing Manager, Visual Merchandiser, Digital Marketing Manager, Vendor
Source: workflow W2013 — Retail Media Campaign Exception &amp; Quality Issue Resolution</bpmn:documentation>
      <bpmn:laneSet id="W2013_LaneSet2">
        <bpmn:lane id="W2013_Lane1" name="Marketing Manager">
        <bpmn:flowNodeRef>W2013_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2013_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2013_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2013_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2013_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2013_Start3" name="Media campaign quality issue or exception">
        <bpmn:outgoing>W2013_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2013_Task4" name="Issue identification: (a) in-store: materials not installed, installed…">
        <bpmn:documentation>Step 1: Issue identification: (a) in-store: materials not installed, installed incorrectly, damaged, removed prematurely, (b) ecommerce: ad not serving, creative error, wrong product linked, (c) digital signage: screen malfunction, wrong content playing
Responsible (R): Marketing Manager
Accountable (A): CMO
Duration: Per issue</bpmn:documentation>
        <bpmn:incoming>W2013_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2013_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2013_Task5" name="Resolution: (a) in-store: re-ship and re-install within 5 days, (b) ecommerce…">
        <bpmn:documentation>Step 2: Resolution: (a) in-store: re-ship and re-install within 5 days, (b) ecommerce: fix within 24 hours, (c) digital signage: fix within 48 hours, (d) for all issues: extend campaign duration to compensate for downtime/issue period
Responsible (R): Marketing Manager / Visual Merchandiser
Accountable (A): CMO
Duration: Per issue</bpmn:documentation>
        <bpmn:incoming>W2013_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2013_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2013_Task6" name="Vendor compensation: (a) if issue caused by BuildRight: credit vendor for…">
        <bpmn:documentation>Step 3: Vendor compensation: (a) if issue caused by BuildRight: credit vendor for affected period (pro-rata refund or campaign extension), (b) if issue caused by vendor (late creative, wrong specs): no compensation, (c) document all issues for quality improvement tracking
Responsible (R): Marketing Manager
Accountable (A): CMO
Duration: Per issue</bpmn:documentation>
        <bpmn:incoming>W2013_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2013_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2013_End7" name="Complete">
        <bpmn:incoming>W2013_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2013_Annotation8">
        <bpmn:text>Controls: - CTL-386 (ensure controlled execution — Vendor Advertising Campaign Execution (PA-48.2).) | - operational: standard operating procedures; system-enforced validation rules | ---
Owner: Marketing Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2013_Assoc9" sourceRef="W2013_Annotation8" targetRef="W2013_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2013_Flow10" sourceRef="W2013_Start3" targetRef="W2013_Task4" />
      <bpmn:sequenceFlow id="W2013_Flow11" sourceRef="W2013_Task4" targetRef="W2013_Task5" />
      <bpmn:sequenceFlow id="W2013_Flow12" sourceRef="W2013_Task5" targetRef="W2013_Task6" />
      <bpmn:sequenceFlow id="W2013_Flow13" sourceRef="W2013_Task6" targetRef="W2013_End7" />
    </bpmn:process>
