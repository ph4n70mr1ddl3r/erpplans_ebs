    <bpmn:process id="W_W2019" name="W2019. Retail Media Annual Business Plan &amp; Revenue Forecasting" isExecutable="false">
      <bpmn:documentation>Trigger: Annual planning cycle
Frequency: Annual
Volume: Consolidated media business plan
Owner: CMO
Participants: CMO, CFO, COO
Source: workflow W2019 — Retail Media Annual Business Plan &amp; Revenue Forecasting</bpmn:documentation>
      <bpmn:laneSet id="W2019_LaneSet4">
        <bpmn:lane id="W2019_Lane1" name="CMO">
        <bpmn:flowNodeRef>W2019_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2019_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2019_Lane2" name="CFO">
        <bpmn:flowNodeRef>W2019_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2019_Lane3" name="COO">
        <bpmn:flowNodeRef>W2019_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2019_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2019_Start5" name="Annual planning cycle">
        <bpmn:outgoing>W2019_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2019_Task6" name="CMO develops annual media business plan: (a) revenue target: Year 1: PHP…">
        <bpmn:documentation>Step 1: CMO develops annual media business plan: (a) revenue target: Year 1: PHP 50–100M (conservative); Year 2: PHP 100–200M, (b) by channel: in-store (60%), ecommerce (30%), print (10%), (c) vendor target: 200+ vendors spending on media (from 800–1,000 total), (d) new initiatives: digital signage expansion, self-service portal, programmatic advertising
Responsible (R): CMO
Accountable (A): COO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2019_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2019_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2019_Task7" name="CFO evaluates financial impact: (a) media revenue contribution to total revenue…">
        <bpmn:documentation>Step 2: CFO evaluates financial impact: (a) media revenue contribution to total revenue (&lt; 1% initially, growing to 1–2%), (b) media margin contribution to EBITDA, (c) investment required: digital signage hardware, CMS platform, creative resources, (d) payback period for media infrastructure investment
Responsible (R): CFO
Accountable (A): COO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2019_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2019_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2019_Task8" name="COO approves plan; CMO executes with quarterly milestone tracking">
        <bpmn:documentation>Step 3: COO approves plan; CMO executes with quarterly milestone tracking
Responsible (R): COO
Accountable (A): CEO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2019_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2019_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2019_End9" name="Complete">
        <bpmn:incoming>W2019_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2019_Annotation10">
        <bpmn:text>Controls: - CTL-387 (ensure controlled execution — Retail Media Revenue &amp; Analytics (PA-48.3).) | - operational: CMO review and approval gate | ---
Owner: CMO</bpmn:text>
      </bpmn:textAnnotation>
