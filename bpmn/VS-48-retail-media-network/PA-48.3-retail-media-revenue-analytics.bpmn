    <bpmn:process id="W_W2018" name="W2018. Retail Media Inventory Yield &amp; Utilization Optimization" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly inventory utilization review
Frequency: Monthly
Volume: ~3,050 media positions
Owner: Marketing Manager
Participants: Marketing Manager, CMO
Source: workflow W2018 — Retail Media Inventory Yield &amp; Utilization Optimization</bpmn:documentation>
      <bpmn:laneSet id="W2018_LaneSet2">
        <bpmn:lane id="W2018_Lane1" name="Marketing Manager">
        <bpmn:flowNodeRef>W2018_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2018_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2018_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2018_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2018_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2018_Start3" name="Monthly inventory utilization review">
        <bpmn:outgoing>W2018_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2018_Task4" name="Monthly utilization report: (a) fill rate: % of available inventory sold by…">
        <bpmn:documentation>Step 1: Monthly utilization report: (a) fill rate: % of available inventory sold by media type, (b) revenue per placement: average revenue by media type, (c) unsold inventory: which placements and periods are unsold?, (d) revenue per store: identify stores with low media revenue (may need more sales effort or lower pricing)
Responsible (R): Marketing Manager
Accountable (A): CMO
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W2018_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2018_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2018_Task5" name="Optimization actions: (a) high fill rate (&gt;80%): consider rate increase, (b)…">
        <bpmn:documentation>Step 2: Optimization actions: (a) high fill rate (&gt;80%): consider rate increase, (b) low fill rate (&lt;50%): promotional pricing, package deals, or internal use, (c) seasonal patterns: pre-sell high-demand periods at premium rates, (d) new inventory: introduce new placement types based on vendor demand
Responsible (R): Marketing Manager
Accountable (A): CMO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2018_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2018_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2018_Task6" name="Annual: comprehensive yield optimization review: (a) total media revenue per…">
        <bpmn:documentation>Step 3: Annual: comprehensive yield optimization review: (a) total media revenue per sqm of selling area, (b) benchmark against international retail media networks, (c) set Year 2 revenue target and inventory plan
Responsible (R): Marketing Manager / CMO
Accountable (A): COO
Duration: 2–3 days/year</bpmn:documentation>
        <bpmn:incoming>W2018_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2018_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2018_End7" name="Complete">
        <bpmn:incoming>W2018_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2018_Annotation8">
        <bpmn:text>Controls: - CTL-387 (ensure controlled execution — Retail Media Revenue &amp; Analytics (PA-48.3).) | - operational: Marketing Manager review and approval gate | ---
Owner: Marketing Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2018_Assoc9" sourceRef="W2018_Annotation8" targetRef="W2018_Start3" associationDirection="None" />
