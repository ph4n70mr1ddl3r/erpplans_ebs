    <bpmn:process id="W_W2020" name="W2020. Retail Media Intercompany Revenue Allocation (Multi-Entity)" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly IC settlement
Frequency: Monthly
Volume: Cross-entity media transactions
Owner: Accounting Manager
Participants: Accounting Manager, CFO
Source: workflow W2020 — Retail Media Intercompany Revenue Allocation (Multi-Entity)</bpmn:documentation>
      <bpmn:laneSet id="W2020_LaneSet2">
        <bpmn:lane id="W2020_Lane1" name="Accounting Manager">
        <bpmn:flowNodeRef>W2020_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2020_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2020_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2020_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2020_Start3" name="Monthly IC settlement">
        <bpmn:outgoing>W2020_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2020_Task4" name="Accounting Manager allocates media revenue across entities: (a) BuildRight…">
        <bpmn:documentation>Step 1: Accounting Manager allocates media revenue across entities: (a) BuildRight Depot, Inc.: in-store media revenue at stores, (b) BuildRight Digital Commerce, Inc.: ecommerce media revenue, (c) revenue shared per IC agreement: Digital Commerce retains media revenue as incremental income (not subject to per-order fulfillment fee)
Responsible (R): Accounting Manager
Accountable (A): CFO
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W2020_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2020_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2020_Task5" name="IC settlement: (a) media revenue allocated to correct entities, (b) cost…">
        <bpmn:documentation>Step 2: IC settlement: (a) media revenue allocated to correct entities, (b) cost allocation: production costs allocated to entity receiving revenue, (c) IC elimination for consolidation per W9A
Responsible (R): Accounting Manager
Accountable (A): CFO
Duration: Per month-end close</bpmn:documentation>
        <bpmn:incoming>W2020_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2020_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2020_End6" name="Complete">
        <bpmn:incoming>W2020_Flow11</bpmn:incoming>
      </bpmn:endEvent>
