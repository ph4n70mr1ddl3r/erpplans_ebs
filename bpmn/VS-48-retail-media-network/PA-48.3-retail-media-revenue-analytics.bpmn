    <bpmn:process id="W_W2021" name="W2021. Retail Media Network Audit &amp; Compliance Review" isExecutable="false">
      <bpmn:documentation>Trigger: Annual audit; quarterly compliance review
Frequency: Annual external audit; quarterly internal review
Volume: All media transactions
Owner: Accounting Manager
Participants: Accounting Manager, Internal Auditor, External Auditor
Source: workflow W2021 — Retail Media Network Audit &amp; Compliance Review</bpmn:documentation>
      <bpmn:laneSet id="W2021_LaneSet4">
        <bpmn:lane id="W2021_Lane1" name="Internal Auditor">
        <bpmn:flowNodeRef>W2021_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2021_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2021_Lane2" name="External Auditor">
        <bpmn:flowNodeRef>W2021_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2021_Lane3" name="Tax Accountant">
        <bpmn:flowNodeRef>W2021_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2021_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2021_Start5" name="Annual audit; quarterly compliance review">
        <bpmn:outgoing>W2021_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2021_Task6" name="Quarterly: Internal Auditor reviews media compliance: (a) rate card compliance…">
        <bpmn:documentation>Step 1: Quarterly: Internal Auditor reviews media compliance: (a) rate card compliance: are vendors charged per approved rates?, (b) placement verification: were booked placements actually installed/active?, (c) vendor credit accuracy: are quality issue credits applied correctly?, (d) co-op fund compliance: are co-op reimbursements per agreement terms?
Responsible (R): Internal Auditor
Accountable (A): CFO
Duration: 2–3 days/quarter</bpmn:documentation>
        <bpmn:incoming>W2021_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2021_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2021_Task7" name="Annual: External Auditor reviews media revenue: (a) revenue recognition per…">
        <bpmn:documentation>Step 2: Annual: External Auditor reviews media revenue: (a) revenue recognition per PFRS 15, (b) sample campaigns: verify execution and invoicing accuracy, (c) IC allocation accuracy
Responsible (R): External Auditor
Accountable (A): CFO
Duration: Per annual audit</bpmn:documentation>
        <bpmn:incoming>W2021_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2021_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2021_Task8" name="Annual: BIR compliance review: (a) media revenue is subject to 12% output VAT…">
        <bpmn:documentation>Step 3: Annual: BIR compliance review: (a) media revenue is subject to 12% output VAT, (b) media services may be subject to percentage tax for some entities (verify per entity registration), (c) ensure all media revenue properly declared in VAT returns
Responsible (R): Tax Accountant
Accountable (A): CFO
Duration: 1 day/year</bpmn:documentation>
        <bpmn:incoming>W2021_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2021_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2021_End9" name="Complete">
        <bpmn:incoming>W2021_Flow15</bpmn:incoming>
      </bpmn:endEvent>
