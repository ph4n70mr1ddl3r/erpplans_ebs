<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-48.3-retail-media-revenue-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2014" name="W2014. Retail Media Revenue Recognition &amp; Billing" isExecutable="false">
      <bpmn:documentation>Trigger: Media campaign completed per booked schedule
Frequency: Monthly billing cycle
Volume: ~50–100 media invoices/month
Owner: AR Clerk
Participants: AR Clerk, Marketing Manager, Accounting Manager
Source: workflow W2014 — Retail Media Revenue Recognition &amp; Billing</bpmn:documentation>
      <bpmn:laneSet id="W2014_LaneSet4">
        <bpmn:lane id="W2014_Lane1" name="System">
        <bpmn:flowNodeRef>W2014_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2014_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2014_Lane2" name="AR Clerk">
        <bpmn:flowNodeRef>W2014_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2014_Lane3" name="Accounting Manager">
        <bpmn:flowNodeRef>W2014_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2014_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2014_Start5" name="Media campaign completed per booked schedule">
        <bpmn:outgoing>W2014_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2014_Task6" name="System generates media invoice upon campaign completion: (a) campaign details…">
        <bpmn:documentation>Step 1: System generates media invoice upon campaign completion: (a) campaign details: vendor, placement, duration, stores, (b) billing: media rate × placement × duration, (c) less: co-op fund credit (if applicable), (d) less: credits for quality issues or downtime, (e) net amount due, (f) BIR-compliant invoice per DOC-002
Responsible (R): System
Accountable (A): AR Clerk
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2014_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2014_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2014_Task7" name="AR Clerk reviews invoice: (a) verify campaign was executed per booking…">
        <bpmn:documentation>Step 2: AR Clerk reviews invoice: (a) verify campaign was executed per booking (compliance rate ≥ 90%), (b) verify pricing matches rate card, (c) apply any agreed discounts or credits, (d) submit invoice to vendor via portal or email
Responsible (R): AR Clerk
Accountable (A): Accounting Manager
Duration: 15–30 min/invoice</bpmn:documentation>
        <bpmn:incoming>W2014_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2014_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2014_Task8" name="Revenue recognition per PFRS 15: (a) in-store/print: recognize revenue when…">
        <bpmn:documentation>Step 3: Revenue recognition per PFRS 15: (a) in-store/print: recognize revenue when campaign executed (materials installed, catalog published), (b) ecommerce: recognize as advertising services rendered (impressions delivered), (c) GL posting: debit AR, credit media revenue + output VAT
Responsible (R): Accounting Manager
Accountable (A): CFO
Duration: Automated after review</bpmn:documentation>
        <bpmn:incoming>W2014_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2014_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2014_End9" name="Complete">
        <bpmn:incoming>W2014_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2014_Annotation10">
        <bpmn:text>Controls: - CTL-387 (ensure controlled execution — Retail Media Revenue &amp; Analytics (PA-48.3).) | - operational: AR Clerk review and approval gate | ---
Owner: AR Clerk</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2014_Assoc11" sourceRef="W2014_Annotation10" targetRef="W2014_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2014_Flow12" sourceRef="W2014_Start5" targetRef="W2014_Task6" />
      <bpmn:sequenceFlow id="W2014_Flow13" sourceRef="W2014_Task6" targetRef="W2014_Task7" />
      <bpmn:sequenceFlow id="W2014_Flow14" sourceRef="W2014_Task7" targetRef="W2014_Task8" />
      <bpmn:sequenceFlow id="W2014_Flow15" sourceRef="W2014_Task8" targetRef="W2014_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2014_diag">
      <bpmndi:BPMNPlane id="W2014_plane" bpmnElement="W_W2014">
        <bpmndi:BPMNShape id="W2014_Lane1_di" bpmnElement="W2014_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2014_Lane2_di" bpmnElement="W2014_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2014_Lane3_di" bpmnElement="W2014_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
