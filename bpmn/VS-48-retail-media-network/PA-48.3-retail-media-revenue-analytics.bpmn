        <bpmndi:BPMNEdge id="W2014_Flow14_di" bpmnElement="W2014_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2014_Flow15_di" bpmnElement="W2014_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2014_Assoc11_di" bpmnElement="W2014_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2015" name="W2015. Retail Media Vendor Collection &amp; AR Management" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly collection cycle
Frequency: Monthly
Volume: ~50–100 active media AR accounts
Owner: AR Clerk
Participants: AR Clerk, Account Manager, Accounting Manager
Source: workflow W2015 — Retail Media Vendor Collection &amp; AR Management</bpmn:documentation>
      <bpmn:laneSet id="W2015_LaneSet3">
        <bpmn:lane id="W2015_Lane1" name="AR Clerk">
        <bpmn:flowNodeRef>W2015_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2015_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2015_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2015_Lane2" name="Credit Analyst">
        <bpmn:flowNodeRef>W2015_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2015_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2015_Start4" name="Monthly collection cycle">
        <bpmn:outgoing>W2015_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2015_Task5" name="Monthly AR aging for media accounts: (a) separate aging from merchandise AP…">
        <bpmn:documentation>Step 1: Monthly AR aging for media accounts: (a) separate aging from merchandise AP vendors (media vendors may owe BuildRight, not the reverse), (b) terms: Net 30 standard; Net 15 for new vendors, (c) some vendors may offset media costs against merchandise rebates per W27
Responsible (R): AR Clerk
Accountable (A): Accounting Manager
Duration: Per monthly cycle</bpmn:documentation>
        <bpmn:incoming>W2015_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2015_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2015_Task6" name="Collection follow-up: (a) 30+ days: Account Manager contacts vendor marketing…">
        <bpmn:documentation>Step 2: Collection follow-up: (a) 30+ days: Account Manager contacts vendor marketing department, (b) 60+ days: escalate to VP Merchandising for leverage (BuildRight is also a customer of this vendor for merchandise), (c) 90+ days: offset against merchandise AP per mutual agreement
Responsible (R): AR Clerk / Account Manager
Accountable (A): Accounting Manager
Duration: Per aging</bpmn:documentation>
        <bpmn:incoming>W2015_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2015_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2015_Task7" name="Vendor credit management: (a) set credit limit per vendor for media spend based…">
        <bpmn:documentation>Step 3: Vendor credit management: (a) set credit limit per vendor for media spend based on merchandise relationship value, (b) prepayment required for vendors with no existing merchandise relationship
Responsible (R): Credit Analyst
Accountable (A): Accounting Manager
Duration: Per vendor</bpmn:documentation>
        <bpmn:incoming>W2015_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2015_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2015_End8" name="Complete">
        <bpmn:incoming>W2015_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2015_Annotation9">
        <bpmn:text>Controls: - CTL-193 (ensure retail-media billing &amp; placement delivery.) | - operational: standard operating procedures; system-enforced validation rules | ---
Owner: AR Clerk</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2015_Assoc10" sourceRef="W2015_Annotation9" targetRef="W2015_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2015_Flow11" sourceRef="W2015_Start4" targetRef="W2015_Task5" />
      <bpmn:sequenceFlow id="W2015_Flow12" sourceRef="W2015_Task5" targetRef="W2015_Task6" />
      <bpmn:sequenceFlow id="W2015_Flow13" sourceRef="W2015_Task6" targetRef="W2015_Task7" />
      <bpmn:sequenceFlow id="W2015_Flow14" sourceRef="W2015_Task7" targetRef="W2015_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2015_diag">
      <bpmndi:BPMNPlane id="W2015_plane" bpmnElement="W_W2015">
        <bpmndi:BPMNShape id="W2015_Lane1_di" bpmnElement="W2015_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
