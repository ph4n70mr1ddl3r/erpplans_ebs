      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2016" name="W2016. Retail Media Network Profitability Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly profitability review
Frequency: Quarterly
Volume: Consolidated media P&amp;L
Owner: CFO
Participants: CFO, CMO, Accounting Manager
Source: workflow W2016 — Retail Media Network Profitability Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2016_LaneSet3">
        <bpmn:lane id="W2016_Lane1" name="Accounting Manager">
        <bpmn:flowNodeRef>W2016_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2016_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2016_Lane2" name="CFO">
        <bpmn:flowNodeRef>W2016_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2016_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2016_Start4" name="Quarterly profitability review">
        <bpmn:outgoing>W2016_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2016_Task5" name="Accounting Manager compiles media P&amp;L: (a) revenue: media sales (in-store +…">
        <bpmn:documentation>Step 1: Accounting Manager compiles media P&amp;L: (a) revenue: media sales (in-store + ecommerce + print), (b) cost of media: (i) production costs (printing, creative), (ii) installation labor (store staff time), (iii) digital platform costs (ad serving technology), (iv) account management labor, (c) gross margin target: 50–70% (media is high-margin), (d) net media contribution after allocated overhead
Responsible (R): Accounting Manager
Accountable (A): CFO
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W2016_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2016_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2016_Task6" name="CFO and CMO review profitability: (a) by media type: which channels are most…">
        <bpmn:documentation>Step 2: CFO and CMO review profitability: (a) by media type: which channels are most profitable?, (b) by vendor: which vendors generate most media revenue?, (c) by store: which stores have highest media fill rate?, (d) optimization: shift resources toward highest-margin media types
Responsible (R): CFO / CMO
Accountable (A): COO
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W2016_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2016_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2016_End7" name="Complete">
        <bpmn:incoming>W2016_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2016_Annotation8">
        <bpmn:text>Controls: - CTL-387 (ensure controlled execution — Retail Media Revenue &amp; Analytics (PA-48.3).) | - operational: CFO review and approval gate | ---
Owner: CFO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2016_Assoc9" sourceRef="W2016_Annotation8" targetRef="W2016_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2016_Flow10" sourceRef="W2016_Start4" targetRef="W2016_Task5" />
      <bpmn:sequenceFlow id="W2016_Flow11" sourceRef="W2016_Task5" targetRef="W2016_Task6" />
      <bpmn:sequenceFlow id="W2016_Flow12" sourceRef="W2016_Task6" targetRef="W2016_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2016_diag">
      <bpmndi:BPMNPlane id="W2016_plane" bpmnElement="W_W2016">
        <bpmndi:BPMNShape id="W2016_Lane1_di" bpmnElement="W2016_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2016_Lane2_di" bpmnElement="W2016_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2016_Task5_di" bpmnElement="W2016_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2016_Task6_di" bpmnElement="W2016_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2016_Start4_di" bpmnElement="W2016_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2016_End7_di" bpmnElement="W2016_End7"><dc:Bounds x="840" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2016_Annotation8_di" bpmnElement="W2016_Annotation8"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2016_Flow10_di" bpmnElement="W2016_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2016_Flow11_di" bpmnElement="W2016_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2016_Flow12_di" bpmnElement="W2016_Flow12"><di:waypoint x="790" y="335" /><di:waypoint x="840" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2016_Assoc9_di" bpmnElement="W2016_Assoc9"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2017" name="W2017. Retail Media Sales Lift Attribution &amp; Vendor ROI Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Campaign completion; quarterly attribution analysis
Frequency: Per campaign; quarterly aggregated analysis
Volume: ~50–100 campaigns/quarter
Owner: Marketing Manager
Participants: Marketing Manager, Digital Marketing Manager, Category Manager, Retail Media Operations Specialist
Source: workflow W2017 — Retail Media Sales Lift Attribution &amp; Vendor ROI Reporting</bpmn:documentation>
      <bpmn:laneSet id="W2017_LaneSet3">
        <bpmn:lane id="W2017_Lane1" name="Marketing Manager">
        <bpmn:flowNodeRef>W2017_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2017_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2017_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2017_Lane2" name="Account Manager">
        <bpmn:flowNodeRef>W2017_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2017_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2017_Start4" name="Campaign completion; quarterly attribution analysis">
        <bpmn:outgoing>W2017_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2017_Task5" name="Sales lift calculation per campaign: (a) compare product sales during campaign…">
        <bpmn:documentation>Step 1: Sales lift calculation per campaign: (a) compare product sales during campaign vs. pre-campaign baseline (4-week average), (b) control group: compare sales at stores with campaign vs. stores without, (c) ecommerce: attributed revenue from ad clicks (last-click attribution), (d) calculate incremental sales: sales lift − organic sales growth
Responsible (R): Marketing Manager
Accountable (A): CMO
Duration: 1–2 days/quarter</bpmn:documentation>
        <bpmn:incoming>W2017_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2017_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2017_Task6" name="Vendor ROI: (a) vendor investment: total media spend on BuildRight campaign…">
        <bpmn:documentation>Step 2: Vendor ROI: (a) vendor investment: total media spend on BuildRight campaign, (b) vendor return: incremental gross margin from sales lift (using vendor&#x27;s margin, not BuildRight&#x27;s), (c) ROI = vendor return ÷ vendor investment, (d) target: ROI ≥ 5x for vendor (industry benchmark for retail media)
Responsible (R): Marketing Manager
Accountable (A): CMO
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W2017_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2017_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2017_Task7" name="Present ROI analysis to vendor: (a) demonstrate value of BuildRight media…">
        <bpmn:documentation>Step 3: Present ROI analysis to vendor: (a) demonstrate value of BuildRight media investment, (b) use data to justify rate increases or upsell additional placements, (c) share anonymized industry benchmarks for context
Responsible (R): Account Manager
Accountable (A): CMO
Duration: Per vendor</bpmn:documentation>
        <bpmn:incoming>W2017_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2017_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2017_End8" name="Complete">
        <bpmn:incoming>W2017_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2017_Annotation9">
        <bpmn:text>Controls: - CTL-193 (ensure retail-media billing &amp; placement delivery.) | - operational: standard operating procedures; system-enforced validation rules | ---
Owner: Marketing Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2017_Assoc10" sourceRef="W2017_Annotation9" targetRef="W2017_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2017_Flow11" sourceRef="W2017_Start4" targetRef="W2017_Task5" />
      <bpmn:sequenceFlow id="W2017_Flow12" sourceRef="W2017_Task5" targetRef="W2017_Task6" />
      <bpmn:sequenceFlow id="W2017_Flow13" sourceRef="W2017_Task6" targetRef="W2017_Task7" />
