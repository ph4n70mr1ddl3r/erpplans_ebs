    <bpmn:process id="W_W3287" name="W3287. Multi-Channel Revenue &amp; Margin Allocation Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Annual plan; ecommerce growth (per profile §8.5)
Frequency: Annual + quarterly
Volume: Store + ecommerce + marketplace channels
Owner: Merchandise Planner
Participants: Merchandise Planner, Ecommerce (links to VS-10/VS-65/VS-95), Category Managers, FP&amp;A (links to VS-17.4)
Source: workflow W3287 — Multi-Channel Revenue &amp; Margin Allocation Planning</bpmn:documentation>
      <bpmn:laneSet id="W3287_LaneSet3">
        <bpmn:lane id="W3287_Lane1" name="Merchandise Planner">
