    <bpmn:process id="W_W3282" name="W3282. Seasonal Merchandise Plan &amp; Department/Category Financial Plan" isExecutable="false">
      <bpmn:documentation>Trigger: Season boundary (per profile §13.2: summer/dry, rainy-season/flood-control, ber-months/Christmas)
Frequency: Seasonal (≈6 major seasons/year)
Volume: 13 departments, ~40 categories per season
Owner: Merchandise Planner
Participants: Merchandise Planner, Category Managers, Buyers (links to VS-03), Allocation (links to VS-55)
Source: workflow W3282 — Seasonal Merchandise Plan &amp; Department/Category Financial Plan</bpmn:documentation>
      <bpmn:laneSet id="W3282_LaneSet3">
        <bpmn:lane id="W3282_Lane1" name="Merchandise Planner">
        <bpmn:flowNodeRef>W3282_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3282_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3282_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3282_Lane2" name="Category Managers">
        <bpmn:flowNodeRef>W3282_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3282_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3282_Start4" name="Season boundary (per profile §13.2: summer/dry, rainy-season/flood-control…">
        <bpmn:outgoing>W3282_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3282_Task5" name="Merchandise Planner develop the seasonal merchandise plan by…">
        <bpmn:documentation>Step 1: Merchandise Planner develop the seasonal merchandise plan by department/category: seasonal sales, GM%, planned receipts, BOM/EOM stock, weeks-of-supply (W3289), and markdown budget (W3285); incorporate seasonal-calendar events and prior-season actuals (links to VS-64 seasonal transition)
Responsible (R): Merchandise Planner / Category Managers
Accountable (A): VP Merchandising
Duration: Per season</bpmn:documentation>
        <bpmn:incoming>W3282_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3282_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3282_Task6" name="Category Managers translate the seasonal financial plan into a category plan…">
        <bpmn:documentation>Step 2: Category Managers translate the seasonal financial plan into a category plan: key items (links to VS-01.1 assortment), depth/width, launch/clearance timing, promo tie-ins (links to VS-14.1/VS-58), and import-vs-domestic mix (links to VS-02.2/VS-87); commit the buy against OTB (W3283/W3284)
Responsible (R): Category Managers / Buyers
Accountable (A): VP Merchandising
Duration: Per season</bpmn:documentation>
        <bpmn:incoming>W3282_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3282_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3282_Task7" name="Merchandise Planner lock the seasonal plan, allocate OTB to categories, and…">
        <bpmn:documentation>Step 3: Merchandise Planner lock the seasonal plan, allocate OTB to categories, and publish the seasonal scorecard baseline for in-season tracking (W3288); coordinate launch readiness with allocation and stores
Responsible (R): Merchandise Planner
Accountable (A): VP Merchandising
Duration: Per season</bpmn:documentation>
        <bpmn:incoming>W3282_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3282_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3282_End8" name="Complete">
        <bpmn:incoming>W3282_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3282_Annotation9">
        <bpmn:text>Controls: - CTL-532 (ensure controlled execution — Seasonal Merchandise Financial Planning &amp; Open-to-Buy (PA-101.1).) | - operational: early season planning and import pipeline visibility; operational: OTB discipline (W3283) and reforecast (W3288)
Owner: Merchandise Planner</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3282_Assoc10" sourceRef="W3282_Annotation9" targetRef="W3282_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3282_Flow11" sourceRef="W3282_Start4" targetRef="W3282_Task5" />
      <bpmn:sequenceFlow id="W3282_Flow12" sourceRef="W3282_Task5" targetRef="W3282_Task6" />
      <bpmn:sequenceFlow id="W3282_Flow13" sourceRef="W3282_Task6" targetRef="W3282_Task7" />
      <bpmn:sequenceFlow id="W3282_Flow14" sourceRef="W3282_Task7" targetRef="W3282_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3282_diag">
      <bpmndi:BPMNPlane id="W3282_plane" bpmnElement="W_W3282">
        <bpmndi:BPMNShape id="W3282_Lane1_di" bpmnElement="W3282_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3282_Lane2_di" bpmnElement="W3282_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3282_Task5_di" bpmnElement="W3282_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3282_Task6_di" bpmnElement="W3282_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3282_Task7_di" bpmnElement="W3282_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3282_Start4_di" bpmnElement="W3282_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3282_End8_di" bpmnElement="W3282_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3282_Annotation9_di" bpmnElement="W3282_Annotation9"><dc:Bounds x="160" y="460" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3282_Flow11_di" bpmnElement="W3282_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3282_Flow12_di" bpmnElement="W3282_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3282_Flow13_di" bpmnElement="W3282_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3282_Flow14_di" bpmnElement="W3282_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3282_Assoc10_di" bpmnElement="W3282_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3283" name="W3283. Open-to-Buy (OTB) Calculation, Maintenance &amp; Weekly Recalculation" isExecutable="false">
      <bpmn:documentation>Trigger: Plan setup; weekly merchandise review
Frequency: Weekly recalculation
Volume: 13 departments / ~40 categories weekly
Owner: Merchandise Planner
Participants: Merchandise Planner, Buyers (links to VS-03), VP Merchandising, FP&amp;A (links to VS-17.4)
Source: workflow W3283 — Open-to-Buy (OTB) Calculation, Maintenance &amp; Weekly Recalculation</bpmn:documentation>
      <bpmn:laneSet id="W3283_LaneSet3">
        <bpmn:lane id="W3283_Lane1" name="Merchandise Planner">
        <bpmn:flowNodeRef>W3283_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3283_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3283_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3283_Lane2" name="Buyers">
        <bpmn:flowNodeRef>W3283_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3283_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3283_Start4" name="Plan setup; weekly merchandise review">
        <bpmn:outgoing>W3283_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3283_Task5" name="Merchandise Planner calculate OTB per department/category: planned EOM stock +…">
        <bpmn:documentation>Step 1: Merchandise Planner calculate OTB per department/category: planned EOM stock + planned sales + planned markdowns − stock-on-hand − on-order (open POs per VS-03.2 and in-transit import per VS-02.2); the residual is the available-to-buy dollars for the period
Responsible (R): Merchandise Planner
Accountable (A): VP Merchandising
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W3283_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3283_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3283_Task6" name="Buyers consume OTB by raising POs/blanket releases (links to VS-03.2) within…">
        <bpmn:documentation>Step 2: Buyers consume OTB by raising POs/blanket releases (links to VS-03.2) within available OTB; system blocks or warns on over-buy; Merchandise Planner release additional OTB only with VP Merchandising approval and documented rationale
Responsible (R): Buyers / Merchandise Planner
Accountable (A): VP Merchandising
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W3283_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3283_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3283_Task7" name="Merchandise Planner recalculate OTB weekly using latest actuals (sales…">
        <bpmn:documentation>Step 3: Merchandise Planner recalculate OTB weekly using latest actuals (sales, receipts, markdowns) and reforecast (W3288); adjust forward commitments, cancel/defer open orders where indicated, and report OTB utilization to VP Merchandising and FP&amp;A
Responsible (R): Merchandise Planner
Accountable (A): VP Merchandising
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W3283_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3283_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3283_End8" name="Complete">
        <bpmn:incoming>W3283_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3283_Annotation9">
        <bpmn:text>Controls: - CTL-69 (ensure merchandise financial plan &amp; OTB discipline.) | - operational: hard OTB controls and weekly recalculation; operational: reforecast-driven OTB release (W3288)
Owner: Merchandise Planner</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3283_Assoc10" sourceRef="W3283_Annotation9" targetRef="W3283_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3283_Flow11" sourceRef="W3283_Start4" targetRef="W3283_Task5" />
      <bpmn:sequenceFlow id="W3283_Flow12" sourceRef="W3283_Task5" targetRef="W3283_Task6" />
      <bpmn:sequenceFlow id="W3283_Flow13" sourceRef="W3283_Task6" targetRef="W3283_Task7" />
      <bpmn:sequenceFlow id="W3283_Flow14" sourceRef="W3283_Task7" targetRef="W3283_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3283_diag">
      <bpmndi:BPMNPlane id="W3283_plane" bpmnElement="W_W3283">
        <bpmndi:BPMNShape id="W3283_Lane1_di" bpmnElement="W3283_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3283_Lane2_di" bpmnElement="W3283_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3283_Task5_di" bpmnElement="W3283_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3283_Task6_di" bpmnElement="W3283_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3283_Task7_di" bpmnElement="W3283_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3283_Start4_di" bpmnElement="W3283_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3283_End8_di" bpmnElement="W3283_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3283_Annotation9_di" bpmnElement="W3283_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3283_Flow11_di" bpmnElement="W3283_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3283_Flow12_di" bpmnElement="W3283_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3283_Flow13_di" bpmnElement="W3283_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3283_Flow14_di" bpmnElement="W3283_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3283_Assoc10_di" bpmnElement="W3283_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3284" name="W3284. Category &amp; Sub-Class Receipt Planning &amp; Commitment Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Seasonal plan lock; OTB release
Frequency: Weekly
Volume: ~12,000 PO lines/month across categories (per profile §6.6)
Owner: Merchandise Planner
Participants: Merchandise Planner, Buyers (links to VS-03), Supply Planning (links to VS-02.1), Import (links to VS-02.2)
Source: workflow W3284 — Category &amp; Sub-Class Receipt Planning &amp; Commitment Tracking</bpmn:documentation>
      <bpmn:laneSet id="W3284_LaneSet3">
        <bpmn:lane id="W3284_Lane1" name="Merchandise Planner">
        <bpmn:flowNodeRef>W3284_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3284_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3284_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3284_Lane2" name="Buyers">
