    <bpmn:process id="W_W3288" name="W3288. Merchandise Plan-vs-Actual Review, In-Season Forecast &amp; Reforecast" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly merchandise review; in-season
Frequency: Weekly
Volume: All departments/categories in-season
Owner: VP Merchandising
Participants: VP Merchandising, Merchandise Planners, Category Managers, Buyers, Supply Planning (links to VS-02.1), FP&amp;A (links to VS-17.4)
Source: workflow W3288 — Merchandise Plan-vs-Actual Review, In-Season Forecast &amp; Reforecast</bpmn:documentation>
      <bpmn:laneSet id="W3288_LaneSet4">
        <bpmn:lane id="W3288_Lane1" name="Merchandise Planner">
