        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4966_Start4" name="Order ready (W4965); appointment reminder; customer arrival">
        <bpmn:outgoing>W4966_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4966_Task5" name="Notify the customer on readiness &amp; appointment: SMS/email/app notification…">
        <bpmn:documentation>Step 1: Notify the customer on readiness &amp; appointment: SMS/email/app notification (order ready, slot time, counter/bay location, what to bring — ID, vehicle type) per the SLA (links VS-10 BOPIS SLA, W4805 pickup journey)
Responsible (R): CX / IT / Store Ops
Accountable (A): Supervisor
Duration: Per pickup</bpmn:documentation>
        <bpmn:incoming>W4966_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4966_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4966_Task6" name="Confirm arrival &amp; manage the queue: on arrival, check in the customer…">
        <bpmn:documentation>Step 2: Confirm arrival &amp; manage the queue: on arrival, check in the customer (order/ID), confirm the vehicle (for loading W4970), manage the wait/queue, and communicate ETA/position
Responsible (R): Counter Staff / Supervisor
Accountable (A): Supervisor
Duration: Per pickup</bpmn:documentation>
        <bpmn:incoming>W4966_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4966_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4966_Task7" name="Manage no-shows &amp; expiries: remind approaching-slot customers, handle no-shows…">
        <bpmn:documentation>Step 3: Manage no-shows &amp; expiries: remind approaching-slot customers, handle no-shows (W4978 — expiry/restock per policy), and re-book; feed CX analytics (W4981)
Responsible (R): CX / Supervisor / Store Ops
Accountable (A): Supervisor
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4966_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4966_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4966_End8" name="Complete">
        <bpmn:incoming>W4966_Flow14</bpmn:incoming>
      </bpmn:endEvent>
