<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-171.1-customer-pickup-and-will-call-program-design-capacity-and-scheduling" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4961" name="W4961. Customer Pickup, Will-Call &amp; Loading-Zone Program Strategy &amp; Operating Model" isExecutable="false">
      <bpmn:documentation>Trigger: Program launch; format evolution (VS-109); CX/throughput issue; expansion
Frequency: Annual + on launch
Volume: 1 program applied to 200 stores × ~bulky-pickup share of 2.8M monthly transactions
Owner: VP Store Operations / Customer Pickup &amp; Loading-Zone Program Manager
Participants: Store Ops (VS-07), CX (VS-13), Ecommerce (VS-10), HSE (VS-24), Real Estate/Facilities (VS-20/VS-138), Self-Haul Rental (VS-162)
Source: workflow W4961 — Customer Pickup, Will-Call &amp; Loading-Zone Program Strategy &amp; Operating Model</bpmn:documentation>
      <bpmn:laneSet id="W4961_LaneSet2">
        <bpmn:lane id="W4961_Lane1" name="Program Manager">
        <bpmn:flowNodeRef>W4961_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4961_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4961_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4961_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4961_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4961_Start3" name="Program launch; format evolution (VS-109); CX/throughput issue; expansion">
        <bpmn:outgoing>W4961_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4961_Task4" name="Set the customer-pickup/will-call/loading-zone strategy &amp; operating model: the…">
        <bpmn:documentation>Step 1: Set the customer-pickup/will-call/loading-zone strategy &amp; operating model: the will-call counter standard, the loading-bay model (drive-through vs back-of-house staging vs curbside), the appointment/time-slot model, the forklift-in-customer-area safety model (links VS-147/VS-24), the staffing/role model (counter, spotter, forklift operator, loader), and the CX/throughput KPIs
Responsible (R): Program Manager / Store Ops / CX / HSE
Accountable (A): VP Store Operations / COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4961_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4961_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4961_Task5" name="Build the operating standards: per-store loading-bay/zone capacity…">
        <bpmn:documentation>Step 2: Build the operating standards: per-store loading-bay/zone capacity, signage/wayfinding (W4964), the customer-identification/release protocol (W4962), the SLA (order ready, wait time, load time), the appointment cadence (W4963), and the integration with BOPIS/ecommerce (W4967) and self-haul rental (W4968)
Responsible (R): Program Manager / Store Ops / CX / IT
Accountable (A): VP Store Operations
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4961_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4961_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4961_Task6" name="Govern the program across 200 stores: store-comms rollout (VS-63), training…">
        <bpmn:documentation>Step 3: Govern the program across 200 stores: store-comms rollout (VS-63), training (links VS-19.4/VS-124), performance review (W4981), and continuous improvement; integrate into store-opening (VS-37) and remodel (VS-109) standards
Responsible (R): Program Manager / Store Ops / Training
Accountable (A): VP Store Operations
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4961_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4961_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4961_End7" name="Complete">
        <bpmn:incoming>W4961_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4961_Annotation8">
        <bpmn:text>Controls: - CTL-743 (ensure controlled execution — Customer Pickup &amp; Will-Call Program Design, Capacity &amp; Scheduling (PA-171.1).) | - CTL-743: standard documented; capacity model; safety model HSE-aligned; KPIs tracked
Owner: VP Store Operations / Customer Pickup &amp; Loading-Zone Program Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4961_Assoc9" sourceRef="W4961_Annotation8" targetRef="W4961_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4961_Flow10" sourceRef="W4961_Start3" targetRef="W4961_Task4" />
      <bpmn:sequenceFlow id="W4961_Flow11" sourceRef="W4961_Task4" targetRef="W4961_Task5" />
      <bpmn:sequenceFlow id="W4961_Flow12" sourceRef="W4961_Task5" targetRef="W4961_Task6" />
      <bpmn:sequenceFlow id="W4961_Flow13" sourceRef="W4961_Task6" targetRef="W4961_End7" />
    </bpmn:process>
