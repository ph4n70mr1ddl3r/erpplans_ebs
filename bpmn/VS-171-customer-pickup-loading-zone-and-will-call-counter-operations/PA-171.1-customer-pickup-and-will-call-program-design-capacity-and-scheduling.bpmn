      <bpmn:sequenceFlow id="W4963_Flow12" sourceRef="W4963_Task5" targetRef="W4963_Task6" />
      <bpmn:sequenceFlow id="W4963_Flow13" sourceRef="W4963_Task6" targetRef="W4963_Task7" />
      <bpmn:sequenceFlow id="W4963_Flow14" sourceRef="W4963_Task7" targetRef="W4963_End8" />
    </bpmn:process>
