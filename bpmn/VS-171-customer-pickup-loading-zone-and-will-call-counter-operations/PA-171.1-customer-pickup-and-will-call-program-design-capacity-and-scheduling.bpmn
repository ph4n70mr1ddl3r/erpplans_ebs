        <bpmndi:BPMNEdge id="W4962_Flow11_di" bpmnElement="W4962_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4962_Flow12_di" bpmnElement="W4962_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4962_Flow13_di" bpmnElement="W4962_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4962_Assoc9_di" bpmnElement="W4962_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4963" name="W4963. Pickup Appointment, Time-Slot &amp; Loading-Bay Capacity Management" isExecutable="false">
      <bpmn:documentation>Trigger: Customer books pickup; capacity planning; peak (weekend/season)
Frequency: Continuous (per booking) + capacity planning
Volume: ~15–30 appointments per store per day × 200 stores
Owner: Loading-Zone/Will-Call Supervisor / Store Ops
Participants: Store Ops (VS-07), Ecommerce (VS-10), CX (VS-13), Data (VS-28)
Source: workflow W4963 — Pickup Appointment, Time-Slot &amp; Loading-Bay Capacity Management</bpmn:documentation>
      <bpmn:laneSet id="W4963_LaneSet3">
        <bpmn:lane id="W4963_Lane1" name="Store Ops">
        <bpmn:flowNodeRef>W4963_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4963_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4963_Lane2" name="Supervisor">
        <bpmn:flowNodeRef>W4963_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4963_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4963_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4963_Start4" name="Customer books pickup; capacity planning; peak (weekend/season)">
        <bpmn:outgoing>W4963_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4963_Task5" name="Offer &amp; manage pickup appointments/time-slots: a time-slot booking model…">
        <bpmn:documentation>Step 1: Offer &amp; manage pickup appointments/time-slots: a time-slot booking model (online/phone/counter) tied to loading-bay capacity and staffing, smoothing arrivals across the day, and prioritizing bulky/contractor orders (links W1193 priority)
Responsible (R): Store Ops / IT / CX
Accountable (A): Supervisor
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4963_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4963_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4963_Task6" name="Manage loading-bay capacity: track bay/door availability, staging-space…">
        <bpmn:documentation>Step 2: Manage loading-bay capacity: track bay/door availability, staging-space utilization, forklift/loader staffing, and the appointment queue; flag over-capacity and offer alternatives (later slot, delivery VS-06/VS-143, self-haul VS-162)
Responsible (R): Supervisor / Store Ops
Accountable (A): Supervisor
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4963_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4963_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4963_Task7" name="Plan for peaks: weekend/season/typhoon-recovery and promo peaks (VS-64/VS-69)…">
        <bpmn:documentation>Step 3: Plan for peaks: weekend/season/typhoon-recovery and promo peaks (VS-64/VS-69), surge staffing/staging, and communicate slot availability to ecommerce (VS-10) and the call center (VS-13.1)
Responsible (R): Supervisor / Store Ops / CX
Accountable (A): Store Mgr
Duration: Per peak</bpmn:documentation>
        <bpmn:incoming>W4963_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4963_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4963_End8" name="Complete">
        <bpmn:incoming>W4963_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4963_Annotation9">
        <bpmn:text>Controls: - CTL-743 (ensure controlled execution — Customer Pickup &amp; Will-Call Program Design, Capacity &amp; Scheduling (PA-171.1).) | - CTL-743: slots tied to capacity; bay/staff tracked; peaks planned; alternatives offered
Owner: Loading-Zone/Will-Call Supervisor / Store Ops</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4963_Assoc10" sourceRef="W4963_Annotation9" targetRef="W4963_Start4" associationDirection="None" />
