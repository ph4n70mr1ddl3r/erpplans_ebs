    <bpmn:process id="W_W4966" name="W4966. Customer Notification, Arrival Confirmation &amp; Queue Management" isExecutable="false">
      <bpmn:documentation>Trigger: Order ready (W4965); appointment reminder; customer arrival
Frequency: Per pickup (continuous)
Volume: ~2–3 notifications per pickup × 200 stores
Owner: Will-Call/Loading-Zone Supervisor / CX (VS-13)
Participants: CX (VS-13), Store Ops (VS-07), Ecommerce (VS-10), Data (VS-28)
Source: workflow W4966 — Customer Notification, Arrival Confirmation &amp; Queue Management</bpmn:documentation>
      <bpmn:laneSet id="W4966_LaneSet3">
        <bpmn:lane id="W4966_Lane1" name="CX">
