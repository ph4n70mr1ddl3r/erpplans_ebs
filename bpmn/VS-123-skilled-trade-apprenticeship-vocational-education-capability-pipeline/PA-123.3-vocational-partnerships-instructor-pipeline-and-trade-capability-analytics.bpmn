        <bpmn:outgoing>W3827_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3827_Task4" name="Trade Capability/L&amp;D build the instructor/master-trainer pipeline: identify…">
        <bpmn:documentation>Step 1: Trade Capability/L&amp;D build the instructor/master-trainer pipeline: identify high-potential master tradespersons, develop them into certified trainers/assessors (TESDA Trainers Methodology/Certified Trainer where applicable — links to W3811), and plan succession for instructor roles
Responsible (R): Trade Capability / L&amp;D / HR
Accountable (A): Trade Capability Lead
Duration: Maintained</bpmn:documentation>
        <bpmn:incoming>W3827_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3827_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3827_Task5" name="Trade Capability/L&amp;D qualify and develop instructors: training-the-trainer…">
        <bpmn:documentation>Step 2: Trade Capability/L&amp;D qualify and develop instructors: training-the-trainer, coaching/assessment skills, curriculum delivery standards, and ongoing instructor development/certification (links to VS-19.4/W683)
Responsible (R): Trade Capability / L&amp;D
Accountable (A): Trade Capability Lead
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W3827_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3827_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3827_Task6" name="Trade Capability/HR recognize and retain instructors/master-trainers…">
        <bpmn:documentation>Step 3: Trade Capability/HR recognize and retain instructors/master-trainers (recognition links to W630, compensation links to VS-102, career path links to W3822) to sustain the instructor base
Responsible (R): Trade Capability / HR
Accountable (A): Trade Capability Lead
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W3827_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3827_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3827_End7" name="Complete">
        <bpmn:incoming>W3827_Flow13</bpmn:incoming>
      </bpmn:endEvent>
