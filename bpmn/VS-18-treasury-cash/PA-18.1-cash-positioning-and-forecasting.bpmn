<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-18.1-cash-positioning-and-forecasting" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W30" name="W30. Daily Treasury &amp; Cash Position Management" isExecutable="false">
      <bpmn:documentation>Trigger: Daily treasury operations cycle
Frequency: Daily
Volume: 200 stores + 4 DCs + HQ cash positions; ~210 bank accounts total across 4 banks (one register with W233/W323/W326) (BDO, BPI, Metrobank, Chinabank) and 5 entities: ~200 store deposit accounts (1 per store for daily cash collection), 4 DC operating accounts, 5 entity main operating accounts, 5 USD import accounts, and additional payroll, savings, and investment accounts per entity
Owner: Treasury Analyst
Participants: Treasury Analyst, Store Managers (cash deposits), CFO, Banks
Source: workflow W30 — Daily Treasury &amp; Cash Position Management</bpmn:documentation>
      <bpmn:laneSet id="W30_LaneSet4">
        <bpmn:lane id="W30_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W30_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W30_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W30_Lane2" name="System">
        <bpmn:flowNodeRef>W30_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W30_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W30_Lane3" name="Treasury Analyst">
        <bpmn:flowNodeRef>W30_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W30_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W30_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W30_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W30_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W30_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W30_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W30_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W30_Start5" name="Daily treasury operations cycle">
        <bpmn:outgoing>W30_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W30_Task6" name="Store Managers prepare daily cash deposit from POS takings per W5F; armored car…">
        <bpmn:documentation>Step 1: Store Managers prepare daily cash deposit from POS takings per W5F; armored car or bank branch deposit
Responsible (R): Store Manager
Accountable (A): COO
Duration: 30 min/day per store</bpmn:documentation>
        <bpmn:incoming>W30_Flow19</bpmn:incoming>
        <bpmn:outgoing>W30_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W30_Task7" name="System imports daily bank statements from all bank accounts (BDO, BPI…">
        <bpmn:documentation>Step 2: System imports daily bank statements from all bank accounts (BDO, BPI, Metrobank, Chinabank) via BPI BizLink, BDO Corporate, or equivalent bank APIs
Responsible (R): System
Accountable (A): Treasury Analyst
Duration: Automated (daily)</bpmn:documentation>
        <bpmn:incoming>W30_Flow20</bpmn:incoming>
        <bpmn:outgoing>W30_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W30_Task8" name="Treasury Analyst reviews daily cash position report: bank balances per entity…">
        <bpmn:documentation>Step 3: Treasury Analyst reviews daily cash position report: bank balances per entity, pending inflows (store deposits), pending outflows (AP payment runs, payroll)
Responsible (R): Treasury Analyst
Accountable (A): CFO
Duration: 30 min/day</bpmn:documentation>
        <bpmn:incoming>W30_Flow21</bpmn:incoming>
        <bpmn:outgoing>W30_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W30_Task9" name="System auto-matches store cash deposits to expected amounts from Z-reports…">
        <bpmn:documentation>Step 4: System auto-matches store cash deposits to expected amounts from Z-reports; flags shortages or delayed deposits
Responsible (R): System
Accountable (A): Treasury Analyst
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W30_Flow22</bpmn:incoming>
        <bpmn:outgoing>W30_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W30_Task10" name="Treasury Analyst identifies surplus or deficit per entity; recommends…">
        <bpmn:documentation>Step 5: Treasury Analyst identifies surplus or deficit per entity; recommends inter-entity cash transfers or short-term placements
Responsible (R): Treasury Analyst
Accountable (A): CFO
Duration: 15 min/day</bpmn:documentation>
        <bpmn:incoming>W30_Flow23</bpmn:incoming>
        <bpmn:outgoing>W30_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W30_Task11" name="If inter-entity transfer needed: Treasury Analyst initiates transfer with CFO…">
        <bpmn:documentation>Step 6: If inter-entity transfer needed: Treasury Analyst initiates transfer with CFO approval; system posts IC loan entry
Responsible (R): Treasury Analyst
Accountable (A): CFO
Duration: 15 min/transfer</bpmn:documentation>
        <bpmn:incoming>W30_Flow24</bpmn:incoming>
        <bpmn:outgoing>W30_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W30_Task12" name="Daily: Treasury executes automated zero-balance (ZBA) cash sweep from store…">
        <bpmn:documentation>Step 7: Daily: Treasury executes automated zero-balance (ZBA) cash sweep from store collection accounts to main operating accounts per entity (per W323&#x27;s daily sweep model)
Responsible (R): Treasury Analyst
Accountable (A): CFO
Duration: Automated + 15 min/run review</bpmn:documentation>
        <bpmn:incoming>W30_Flow25</bpmn:incoming>
        <bpmn:outgoing>W30_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W30_Task13" name="Weekly: Treasury prepares cash flow forecast (2-week rolling) based on AP…">
        <bpmn:documentation>Step 8: Weekly: Treasury prepares cash flow forecast (2-week rolling) based on AP aging, AR collection schedule, payroll dates, and capex commitments
Responsible (R): Treasury Analyst
Accountable (A): CFO
Duration: 2 hours/week</bpmn:documentation>
        <bpmn:incoming>W30_Flow26</bpmn:incoming>
        <bpmn:outgoing>W30_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W30_Task14" name="Monthly: Treasury reconciles all bank accounts per entity; posts bank charges…">
        <bpmn:documentation>Step 9: Monthly: Treasury reconciles all bank accounts per entity; posts bank charges, interest income, FX gains/losses
Responsible (R): Treasury Analyst
Accountable (A): Controller
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W30_Flow27</bpmn:incoming>
        <bpmn:outgoing>W30_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W30_Task15" name="Import payments: Treasury manages USD accounts; executes FX conversions for…">
        <bpmn:documentation>Step 10: Import payments: Treasury manages USD accounts; executes FX conversions for import vendor payments based on LC/TT schedule
Responsible (R): Treasury Analyst
Accountable (A): CFO
Duration: As needed</bpmn:documentation>
        <bpmn:incoming>W30_Flow28</bpmn:incoming>
        <bpmn:outgoing>W30_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W30_End16" name="Complete">
        <bpmn:incoming>W30_Flow29</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W30_Annotation17">
        <bpmn:text>Controls: - CTL-19 (ensure bank reconciliation completeness.); CTL-47 (ensure ecommerce payment reconciliation accuracy.) | - operational: Treasury Analyst review and approval gate; operational: periodic reconciliation against source documents
Owner: Treasury Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W30_Assoc18" sourceRef="W30_Annotation17" targetRef="W30_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W30_Flow19" sourceRef="W30_Start5" targetRef="W30_Task6" />
      <bpmn:sequenceFlow id="W30_Flow20" sourceRef="W30_Task6" targetRef="W30_Task7" />
      <bpmn:sequenceFlow id="W30_Flow21" sourceRef="W30_Task7" targetRef="W30_Task8" />
      <bpmn:sequenceFlow id="W30_Flow22" sourceRef="W30_Task8" targetRef="W30_Task9" />
      <bpmn:sequenceFlow id="W30_Flow23" sourceRef="W30_Task9" targetRef="W30_Task10" />
      <bpmn:sequenceFlow id="W30_Flow24" sourceRef="W30_Task10" targetRef="W30_Task11" />
      <bpmn:sequenceFlow id="W30_Flow25" sourceRef="W30_Task11" targetRef="W30_Task12" />
      <bpmn:sequenceFlow id="W30_Flow26" sourceRef="W30_Task12" targetRef="W30_Task13" />
      <bpmn:sequenceFlow id="W30_Flow27" sourceRef="W30_Task13" targetRef="W30_Task14" />
      <bpmn:sequenceFlow id="W30_Flow28" sourceRef="W30_Task14" targetRef="W30_Task15" />
      <bpmn:sequenceFlow id="W30_Flow29" sourceRef="W30_Task15" targetRef="W30_End16" />
    </bpmn:process>
