      <bpmndi:BPMNPlane id="W326_plane" bpmnElement="W_W326">
        <bpmndi:BPMNShape id="W326_Lane1_di" bpmnElement="W326_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2000" height="170" /></bpmndi:BPMNShape>
