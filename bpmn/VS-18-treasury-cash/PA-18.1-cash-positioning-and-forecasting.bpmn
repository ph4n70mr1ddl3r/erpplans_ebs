    <bpmn:process id="W_W664" name="W664. Cash Flow Variance Analysis &amp; Liquidity Stress Testing" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly actual cash flow availability; quarterly stress testing cycle
Frequency: Monthly variance analysis; quarterly stress testing
Volume: 5 entities; ~PHP 5.19B monthly gross revenue; ~PHP 3.5-4B monthly cash inflows
Owner: Treasury Manager
Participants: FP&amp;A Analyst, Finance Manager, CFO
Source: workflow W664 — Cash Flow Variance Analysis &amp; Liquidity Stress Testing</bpmn:documentation>
      <bpmn:laneSet id="W664_LaneSet4">
        <bpmn:lane id="W664_Lane1" name="Treasury Manager">
        <bpmn:flowNodeRef>W664_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W664_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W664_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W664_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W664_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W664_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W664_Lane2" name="FP&amp;A Analyst">
        <bpmn:flowNodeRef>W664_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W664_Lane3" name="CFO">
        <bpmn:flowNodeRef>W664_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W664_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W664_Start5" name="Monthly actual cash flow availability; quarterly stress testing cycle">
        <bpmn:outgoing>W664_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W664_Task6" name="Treasury Manager compares actual cash flow for prior month against forecast per…">
        <bpmn:documentation>Step 1: Treasury Manager compares actual cash flow for prior month against forecast per W589: cash receipts by channel (POS, ecommerce, trade AR, wholesale), cash disbursements by category (vendor payments, payroll, capex, taxes, IC settlements)
Responsible (R): Treasury Manager
Accountable (A): Treasury Manager
Duration: 2 hrs</bpmn:documentation>
        <bpmn:incoming>W664_Flow16</bpmn:incoming>
        <bpmn:outgoing>W664_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W664_Task7" name="FP&amp;A Analyst analyzes material variances (&gt; 5% deviation): revenue…">
        <bpmn:documentation>Step 2: FP&amp;A Analyst analyzes material variances (&gt; 5% deviation): revenue shortfall/surprise, payment timing shifts, unexpected capex, tax payment timing, FX impact on import payments
Responsible (R): FP&amp;A Analyst
Accountable (A): Finance Manager
Duration: 2 hrs</bpmn:documentation>
        <bpmn:incoming>W664_Flow17</bpmn:incoming>
        <bpmn:outgoing>W664_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W664_Task8" name="Treasury Manager updates rolling 4-week forecast per W589 with…">
        <bpmn:documentation>Step 3: Treasury Manager updates rolling 4-week forecast per W589 with variance-informed adjustments
Responsible (R): Treasury Manager
Accountable (A): Finance Manager
Duration: 1 hr</bpmn:documentation>
        <bpmn:incoming>W664_Flow18</bpmn:incoming>
        <bpmn:outgoing>W664_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W664_Task9" name="Quarterly: Treasury Manager conducts liquidity stress test with three…">
        <bpmn:documentation>Step 4: Quarterly: Treasury Manager conducts liquidity stress test with three scenarios: Base (current forecast), Moderate Stress (15% revenue decline + 30-day AR extension + 15% vendor payment acceleration), Severe Stress (25% revenue decline + 60-day AR extension + supply chain disruption requiring emergency procurement)
Responsible (R): Treasury Manager
Accountable (A): CFO
Duration: 4 hrs</bpmn:documentation>
        <bpmn:incoming>W664_Flow19</bpmn:incoming>
        <bpmn:outgoing>W664_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W664_Task10" name="For each scenario, Treasury Manager models: minimum cash balance compliance per…">
        <bpmn:documentation>Step 5: For each scenario, Treasury Manager models: minimum cash balance compliance per entity (target ≥ 2 weeks operating expenses), debt covenant compliance per W319, ability to fund planned capex, dividend capacity per W327
Responsible (R): Treasury Manager
Accountable (A): Finance Manager
Duration: 3 hrs</bpmn:documentation>
        <bpmn:incoming>W664_Flow20</bpmn:incoming>
        <bpmn:outgoing>W664_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W664_Task11" name="Treasury Manager presents stress test results to CFO with recommended…">
        <bpmn:documentation>Step 6: Treasury Manager presents stress test results to CFO with recommended contingency actions (draw on debt facility per W319, defer discretionary capex, accelerate AR collection per W108, extend vendor terms negotiation)
Responsible (R): Treasury Manager
Accountable (A): CFO
Duration: 2 hrs</bpmn:documentation>
        <bpmn:incoming>W664_Flow21</bpmn:incoming>
        <bpmn:outgoing>W664_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W664_Task12" name="CFO approves contingency plan if Moderate Stress scenario shows covenant breach">
        <bpmn:documentation>Step 7: CFO approves contingency plan if Moderate Stress scenario shows covenant breach
Responsible (R): CFO
Accountable (A): Board
Duration: 1 hr</bpmn:documentation>
        <bpmn:incoming>W664_Flow22</bpmn:incoming>
        <bpmn:outgoing>W664_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W664_End13" name="Complete">
        <bpmn:incoming>W664_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W664_Annotation14">
        <bpmn:text>Controls: - CTL-293 (ensure controlled execution — Cash Positioning &amp; Forecasting (PA-18.1).) | - operational: Treasury Manager review and approval gate
Owner: Treasury Manager</bpmn:text>
      </bpmn:textAnnotation>
