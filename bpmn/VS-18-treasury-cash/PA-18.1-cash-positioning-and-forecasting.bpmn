    <bpmn:process id="W_W424" name="W424. AP Post-dated Check (PDC) Issuance &amp; Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Lease agreement requirements or vendor payment terms specifying PDC issuance
Frequency: Monthly (for lease PDCs) or ad-hoc (for vendors)
Volume: ~200–300 lease PDCs issued annually to mall developers
Owner: Treasury Manager
Participants: AP Clerk, Treasury Analyst, CFO, Lease Manager
Source: workflow W424 — AP Post-dated Check (PDC) Issuance &amp; Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W424_LaneSet3">
        <bpmn:lane id="W424_Lane1" name="AP Clerk">
        <bpmn:flowNodeRef>W424_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W424_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W424_Lane2" name="Treasury Analyst">
        <bpmn:flowNodeRef>W424_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W424_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W424_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W424_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W424_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W424_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W424_Start4" name="Lease agreement requirements or vendor payment terms specifying PDC issuance">
        <bpmn:outgoing>W424_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W424_Task5" name="PDC Batch Generation">
        <bpmn:documentation>Step 1: PDC Batch Generation: AP Clerk prepares a batch of PDCs for the lease term (e.g., 12 checks for 12 months); system prints checks with future maturity dates
Responsible (R): AP Clerk
Accountable (A): AP Supervisor
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W424_Flow14</bpmn:incoming>
        <bpmn:outgoing>W424_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W424_Task6" name="Signatory Approval">
        <bpmn:documentation>Step 2: Signatory Approval: Checks are routed for physical signature per DOA (W317); signed checks are returned to Treasury
Responsible (R): Treasury Analyst
Accountable (A): CFO / Treasury Mgr
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W424_Flow15</bpmn:incoming>
        <bpmn:outgoing>W424_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W424_Task7" name="PDC Issuance Recording">
        <bpmn:documentation>Step 3: PDC Issuance Recording: Treasury Analyst records the PDCs in the ERP &quot;Issued PDC Register&quot;; system creates a memo liability (Unreleased PDCs) but does not yet deduct from GL Cash
Responsible (R): Treasury Analyst
Accountable (A): Treasury Mgr
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W424_Flow16</bpmn:incoming>
        <bpmn:outgoing>W424_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W424_Task8" name="Vendor Handover">
        <bpmn:documentation>Step 4: Vendor Handover: PDCs are delivered to the mall developer/vendor; receiver signs an acknowledgment receipt (AR)
Responsible (R): Treasury Analyst
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W424_Flow17</bpmn:incoming>
        <bpmn:outgoing>W424_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W424_Task9" name="Monthly Monitoring">
        <bpmn:documentation>Step 5: Monthly Monitoring: Treasury Analyst monitors the &quot;Daily AP PDC Maturity Report&quot;; as checks reach their maturity date, they are expected to clear the bank
Responsible (R): Treasury Analyst
Accountable (A): Treasury Mgr
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W424_Flow18</bpmn:incoming>
        <bpmn:outgoing>W424_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W424_Task10" name="Clearing Reconciliation">
        <bpmn:documentation>Step 6: Clearing Reconciliation: Treasury Analyst confirms check clearing via bank statement (W89); ERP updates status to &quot;Cleared&quot;; system posts GL entry: Dr. Accounts Payable / Cr. Cash
Responsible (R): Treasury Analyst
Accountable (A): Treasury Mgr
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W424_Flow19</bpmn:incoming>
        <bpmn:outgoing>W424_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W424_End11" name="Complete">
        <bpmn:incoming>W424_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W424_Annotation12">
        <bpmn:text>Controls: - CTL-293 (ensure controlled execution — Cash Positioning &amp; Forecasting (PA-18.1).) | - operational: Treasury Manager review and approval gate; operational: periodic reconciliation against source documents
Owner: Treasury Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W424_Assoc13" sourceRef="W424_Annotation12" targetRef="W424_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W424_Flow14" sourceRef="W424_Start4" targetRef="W424_Task5" />
      <bpmn:sequenceFlow id="W424_Flow15" sourceRef="W424_Task5" targetRef="W424_Task6" />
      <bpmn:sequenceFlow id="W424_Flow16" sourceRef="W424_Task6" targetRef="W424_Task7" />
      <bpmn:sequenceFlow id="W424_Flow17" sourceRef="W424_Task7" targetRef="W424_Task8" />
      <bpmn:sequenceFlow id="W424_Flow18" sourceRef="W424_Task8" targetRef="W424_Task9" />
      <bpmn:sequenceFlow id="W424_Flow19" sourceRef="W424_Task9" targetRef="W424_Task10" />
      <bpmn:sequenceFlow id="W424_Flow20" sourceRef="W424_Task10" targetRef="W424_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W424_diag">
      <bpmndi:BPMNPlane id="W424_plane" bpmnElement="W_W424">
        <bpmndi:BPMNShape id="W424_Lane1_di" bpmnElement="W424_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
