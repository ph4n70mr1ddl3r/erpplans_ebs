    <bpmn:process id="W_W1202" name="W1202. Store Daily Cash Collection, Armored Car Pickup &amp; Bank Deposit Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: Store daily cash management cycle (end of business day)
Frequency: Daily per store; 200 stores × 365 days = 73,000 cash deposit cycles/year
Volume: ~42% of POS transactions are cash = ~PHP 2.1B cash collected/month across all stores; ~PHP 10.6M/store/month
Owner: Treasury Manager
Participants: Store Manager, Cashier, Treasury Clerk, Armored Car Service (ACS) Partner, Bank
Source: workflow W1202 — Store Daily Cash Collection, Armored Car Pickup &amp; Bank Deposit Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W1202_LaneSet6">
        <bpmn:lane id="W1202_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W1202_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1202_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1202_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1202_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W1202_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1202_Lane3" name="Bank">
        <bpmn:flowNodeRef>W1202_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1202_Lane4" name="System">
        <bpmn:flowNodeRef>W1202_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1202_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1202_Lane5" name="Treasury Manager">
        <bpmn:flowNodeRef>W1202_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1202_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1202_Start7" name="Store daily cash management cycle (end of business day)">
        <bpmn:outgoing>W1202_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1202_Task8" name="End-of-day cash count">
        <bpmn:documentation>Step 1: End-of-day cash count: At store close: Cashier and Store Manager jointly count cash in each of 3 cash drawers; compare physical count to POS Z-report (expected cash per system); record count on dual-signature cash count sheet; if variance &gt; PHP 200 per drawer: investigate per W958 (cash variance monitoring); if variance &gt; PHP 1,000: escalate to VP Store Operations and LP per W562
Responsible (R): Cashier / Store Manager
Accountable (A): Store Manager
Duration: 15–20 min</bpmn:documentation>
        <bpmn:incoming>W1202_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1202_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1202_Task9" name="Cash preparation for pickup">
        <bpmn:documentation>Step 2: Cash preparation for pickup: Cashier prepares cash for armored car pickup: (a) separates notes by denomination, (b) counts and bands cash into standardized deposit bags (one bag per cash drawer; 3 bags per store), (c) records deposit slip with bag number, amount, date, store code inside each bag, (d) seals tamper-evident deposit bags; keeps duplicate deposit slip for store records
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W1202_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1202_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1202_Task10" name="Armored car pickup">
        <bpmn:documentation>Step 3: Armored car pickup: Armored car service (ACS) guard arrives at scheduled time (typically 6–8 PM); Store Manager and ACS guard jointly verify: (a) number of deposit bags matches pickup manifest, (b) each bag is sealed and tamper-evident, (c) total amount on manifest matches total from Step 2; Store Manager signs ACS pickup receipt; guard departs with cash; system records pickup timestamp
Responsible (R): Store Manager / ACS Guard
Accountable (A): Treasury Manager
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W1202_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1202_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1202_Task11" name="Bank deposit processing">
        <bpmn:documentation>Step 4: Bank deposit processing: ACS delivers cash to bank (BDO/BPI/Metrobank per store&#x27;s designated branch); bank teller counts cash and verifies against deposit slip; bank records deposit to BuildRight&#x27;s account; bank sends electronic deposit confirmation to Treasury via bank API or statement upload
Responsible (R): Bank / ACS
Accountable (A): —
Duration: Bank-side (next day)</bpmn:documentation>
        <bpmn:incoming>W1202_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1202_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1202_Task12" name="Deposit reconciliation">
        <bpmn:documentation>Step 5: Deposit reconciliation: Treasury Clerk reconciles daily: (a) system matches POS Z-report cash total (expected) → ACS pickup manifest (picked up) → bank deposit confirmation (deposited), (b) flags discrepancies: (i) POS vs. pickup variance (store-level cash handling issue), (ii) pickup vs. bank variance (ACS or bank counting issue), (c) store-level variances &gt; PHP 500 are escalated to Store Manager for investigation, (d) ACS-level variances are filed as ACS claim per service agreement
Responsible (R): System / Treasury Clerk
Accountable (A): Treasury Manager
Duration: 1 hour/day (centralized for all 200 stores)</bpmn:documentation>
        <bpmn:incoming>W1202_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1202_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1202_Task13" name="Cash position update">
        <bpmn:documentation>Step 6: Cash position update: Upon bank deposit confirmation: system updates daily cash position report per W57; deposited cash moves from &quot;Cash in Transit — Store&quot; to &quot;Bank — [Entity]&quot; GL account; cash position feed updates treasury dashboard for daily cash sweep decision per W57
Responsible (R): System
Accountable (A): Treasury Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1202_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1202_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1202_Task14" name="Monthly cash management review">
        <bpmn:documentation>Step 7: Monthly cash management review: Treasury Manager reviews monthly cash collection KPIs: (a) total cash collected vs. expected (based on cash transaction %), (b) cash variance rate by store (target: &lt; 0.05% of cash collected), (c) ACS pickup timeliness (% on-time), (d) bank deposit turnaround time (target: T+1 business day), (e) stores with recurring variances for LP investigation per W562
Responsible (R): Treasury Manager
Accountable (A): CFO
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1202_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1202_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1202_End15" name="Complete">
        <bpmn:incoming>W1202_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1202_Annotation16">
        <bpmn:text>Controls: - CTL-293 (ensure controlled execution — Cash Positioning &amp; Forecasting (PA-18.1).) | - operational: dual-signature counting (Step 1), tamper-evident bags (Step 2), armored car custody chain (Step 3), and variance monitoring (Step 5/W958); operational: backup ACS partner, smart safe integration per W212 (stores with smart safes can store cash securely overnight), and explicit security guard overnight watch per W71; operational: tamper-evident sealed bags and ACS chain-of-custody for dispute resolution
Owner: Treasury Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1202_Assoc17" sourceRef="W1202_Annotation16" targetRef="W1202_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W1202_Flow18" sourceRef="W1202_Start7" targetRef="W1202_Task8" />
      <bpmn:sequenceFlow id="W1202_Flow19" sourceRef="W1202_Task8" targetRef="W1202_Task9" />
      <bpmn:sequenceFlow id="W1202_Flow20" sourceRef="W1202_Task9" targetRef="W1202_Task10" />
      <bpmn:sequenceFlow id="W1202_Flow21" sourceRef="W1202_Task10" targetRef="W1202_Task11" />
      <bpmn:sequenceFlow id="W1202_Flow22" sourceRef="W1202_Task11" targetRef="W1202_Task12" />
      <bpmn:sequenceFlow id="W1202_Flow23" sourceRef="W1202_Task12" targetRef="W1202_Task13" />
      <bpmn:sequenceFlow id="W1202_Flow24" sourceRef="W1202_Task13" targetRef="W1202_Task14" />
      <bpmn:sequenceFlow id="W1202_Flow25" sourceRef="W1202_Task14" targetRef="W1202_End15" />
    </bpmn:process>
