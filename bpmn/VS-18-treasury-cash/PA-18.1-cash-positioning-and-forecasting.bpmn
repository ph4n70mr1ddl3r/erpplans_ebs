    <bpmn:process id="W_W425" name="W425. Bounced Check (DAIF/DAUD) Recovery &amp; Penalty" isExecutable="false">
      <bpmn:documentation>Trigger: Bank notification of a returned customer check (DAIF — Drawn Against Insufficient Funds, DAUD — Drawn Against Uncleared Deposits, or account closed)
Frequency: Ad-hoc (~15–25 cases/month — aligned with W1381)
Volume: ~200–300 bounced checks/year; average value PHP 50,000–300,000 (per W1381)
Owner: Treasury Manager
Participants: AR Clerk, Treasury Analyst, Collection Team, Legal Department
Source: workflow W425 — Bounced Check (DAIF/DAUD) Recovery &amp; Penalty</bpmn:documentation>
      <bpmn:laneSet id="W425_LaneSet4">
        <bpmn:lane id="W425_Lane1" name="Treasury Analyst">
        <bpmn:flowNodeRef>W425_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W425_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W425_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W425_Lane2" name="System">
        <bpmn:flowNodeRef>W425_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W425_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W425_Lane3" name="AR Clerk">
        <bpmn:flowNodeRef>W425_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W425_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W425_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W425_Start5" name="Bank notification of a returned customer check (DAIF — Drawn Against Insufficient Funds…">
        <bpmn:outgoing>W425_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W425_Task6" name="Bank Notification &amp; Intake">
        <bpmn:documentation>Step 1: Bank Notification &amp; Intake: Treasury Analyst receives the debit advice / bank return memo for the returned check with reason code (DAIF, DAUD, account closed, stop payment); logs the incident in the Bounced Check Incident Log shared with W1381
Responsible (R): Treasury Analyst
Accountable (A): Treasury Mgr
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W425_Flow15</bpmn:incoming>
        <bpmn:outgoing>W425_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W425_Task7" name="Financial Reversal">
        <bpmn:documentation>Step 2: Financial Reversal: system reverses the PDC in two entries: (a) reverse deposit: Dr. PDC Receivable / Cr. Cash in Bank; (b) reinstate receivable: Dr. Accounts Receivable — Customer / Cr. PDC Receivable; the covered AR invoice is reactivated in aging with status &quot;Overdue — Bounced Check&quot;; PDC register status updated to &quot;Bounced — DAIF/DAUD&quot; (aligns with W1381 step 2)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W425_Flow16</bpmn:incoming>
        <bpmn:outgoing>W425_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W425_Task8" name="Penalty Charging">
        <bpmn:documentation>Step 3: Penalty Charging: AR Clerk generates a debit memo for the &quot;Returned Check Fee&quot; (standard penalty + bank charges of PHP 500–2,000 per returned check); system posts: Dr. Accounts Receivable / Cr. Other Income
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W425_Flow17</bpmn:incoming>
        <bpmn:outgoing>W425_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W425_Task9" name="NSF Flag &amp; Credit Hold">
        <bpmn:documentation>Step 4: NSF Flag &amp; Credit Hold: system flags the account to W572 (credit monitoring) as an NSF signal and blocks further credit sales until resolution; hold lifts only per W1381 / W572 disposition
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W425_Flow18</bpmn:incoming>
        <bpmn:outgoing>W425_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W425_Task10" name="Routing to Canonical Resolution">
        <bpmn:documentation>Step 5: Routing to Canonical Resolution: case routed to W1381 for customer contact within 24 hours, notice of dishonor, replacement-payment handling, BP 22 legal escalation, and BIR DAIF reporting
Responsible (R): AR Clerk
Accountable (A): AR Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W425_Flow19</bpmn:incoming>
        <bpmn:outgoing>W425_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W425_Task11" name="Redemption Confirmation (single-path settlement)">
        <bpmn:documentation>Step 6: Redemption Confirmation (single-path settlement): Treasury confirms exactly one cleared redemption instrument (cash, manager&#x27;s check, or bank transfer) before the credit hold lifts; the original bounced check is flagged &quot;do not re-present&quot; in the register to prevent double recovery
Responsible (R): Treasury Analyst
Accountable (A): Treasury Mgr
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W425_Flow20</bpmn:incoming>
        <bpmn:outgoing>W425_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W425_End12" name="Complete">
        <bpmn:incoming>W425_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W425_Annotation13">
        <bpmn:text>Controls: - CTL-293 (ensure controlled execution — Cash Positioning &amp; Forecasting (PA-18.1).) | - operational: standard operating procedures; system-enforced validation rules; operational: monthly reconciliation of the Bounced Check Incident Log to bank return memos
Owner: Treasury Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W425_Assoc14" sourceRef="W425_Annotation13" targetRef="W425_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W425_Flow15" sourceRef="W425_Start5" targetRef="W425_Task6" />
      <bpmn:sequenceFlow id="W425_Flow16" sourceRef="W425_Task6" targetRef="W425_Task7" />
      <bpmn:sequenceFlow id="W425_Flow17" sourceRef="W425_Task7" targetRef="W425_Task8" />
      <bpmn:sequenceFlow id="W425_Flow18" sourceRef="W425_Task8" targetRef="W425_Task9" />
      <bpmn:sequenceFlow id="W425_Flow19" sourceRef="W425_Task9" targetRef="W425_Task10" />
      <bpmn:sequenceFlow id="W425_Flow20" sourceRef="W425_Task10" targetRef="W425_Task11" />
      <bpmn:sequenceFlow id="W425_Flow21" sourceRef="W425_Task11" targetRef="W425_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W425_diag">
      <bpmndi:BPMNPlane id="W425_plane" bpmnElement="W_W425">
        <bpmndi:BPMNShape id="W425_Lane1_di" bpmnElement="W425_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
