    <bpmn:process id="W_W233" name="W233. Cash Flow Forecasting &amp; Liquidity Management" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly treasury cycle
Frequency: Weekly (Daily monitoring)
Volume: Covers 5 entities and ~210 bank accounts across 4 banks (BDO, BPI, Metrobank, Chinabank)
Owner: Treasury Analyst
Participants: CFO, Controller, AP/AR Manager
Source: workflow W233 — Cash Flow Forecasting &amp; Liquidity Management</bpmn:documentation>
      <bpmn:laneSet id="W233_LaneSet4">
        <bpmn:lane id="W233_Lane1" name="System">
        <bpmn:flowNodeRef>W233_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W233_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W233_Lane2" name="Treasury Analyst">
        <bpmn:flowNodeRef>W233_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W233_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W233_Lane3" name="Treasury Mgr">
        <bpmn:flowNodeRef>W233_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W233_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W233_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W233_Start5" name="Weekly treasury cycle">
        <bpmn:outgoing>W233_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W233_Task6" name="Data Aggregation">
        <bpmn:documentation>Step 1: Data Aggregation: Pull expected receipts (AR) and planned payments (AP, Payroll, Tax) from ERP
Responsible (R): System
Accountable (A): Treasury Analyst
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W233_Flow14</bpmn:incoming>
        <bpmn:outgoing>W233_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W233_Task7" name="Non-ERP Inputs">
        <bpmn:documentation>Step 2: Non-ERP Inputs: Add manual forecasts for CAPEX, loan repayments, and dividends
Responsible (R): Treasury Analyst
Accountable (A): Treasury Mgr
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W233_Flow15</bpmn:incoming>
        <bpmn:outgoing>W233_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W233_Task8" name="Analysis">
        <bpmn:documentation>Step 3: Analysis: Identify liquidity gaps or excess cash across entities
Responsible (R): Treasury Analyst
Accountable (A): Treasury Mgr
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W233_Flow16</bpmn:incoming>
        <bpmn:outgoing>W233_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W233_Task9" name="Cash Positioning">
        <bpmn:documentation>Step 4: Cash Positioning: Execute intercompany transfers (sweeping) to optimize interest or cover deficits
Responsible (R): Treasury Mgr
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W233_Flow17</bpmn:incoming>
        <bpmn:outgoing>W233_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W233_Task10" name="Reporting">
        <bpmn:documentation>Step 5: Reporting: Weekly Cash Position Report to Executive Team
Responsible (R): Treasury Mgr
Accountable (A): CFO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W233_Flow18</bpmn:incoming>
        <bpmn:outgoing>W233_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W233_End11" name="Complete">
        <bpmn:incoming>W233_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W233_Annotation12">
        <bpmn:text>Controls: - CTL-293 (ensure controlled execution — Cash Positioning &amp; Forecasting (PA-18.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Treasury Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W233_Assoc13" sourceRef="W233_Annotation12" targetRef="W233_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W233_Flow14" sourceRef="W233_Start5" targetRef="W233_Task6" />
      <bpmn:sequenceFlow id="W233_Flow15" sourceRef="W233_Task6" targetRef="W233_Task7" />
      <bpmn:sequenceFlow id="W233_Flow16" sourceRef="W233_Task7" targetRef="W233_Task8" />
      <bpmn:sequenceFlow id="W233_Flow17" sourceRef="W233_Task8" targetRef="W233_Task9" />
      <bpmn:sequenceFlow id="W233_Flow18" sourceRef="W233_Task9" targetRef="W233_Task10" />
      <bpmn:sequenceFlow id="W233_Flow19" sourceRef="W233_Task10" targetRef="W233_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W233_diag">
      <bpmndi:BPMNPlane id="W233_plane" bpmnElement="W_W233">
        <bpmndi:BPMNShape id="W233_Lane1_di" bpmnElement="W233_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
