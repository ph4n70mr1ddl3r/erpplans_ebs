    <bpmn:process id="W_W235" name="W235. Transfer Pricing Compliance &amp; Documentation" isExecutable="false">
      <bpmn:documentation>Trigger: Annual tax cycle; or major change in intercompany service agreements
Frequency: Annual (Documentation); Quarterly (Review)
Volume: 5 related entities in the Philippines
Owner: Tax Manager
Participants: External Tax Advisor, CFO, Controller
Source: workflow W235 — Transfer Pricing Compliance &amp; Documentation</bpmn:documentation>
      <bpmn:laneSet id="W235_LaneSet2">
        <bpmn:lane id="W235_Lane1" name="Tax Manager">
        <bpmn:flowNodeRef>W235_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W235_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W235_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W235_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W235_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W235_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W235_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W235_Start3" name="Annual tax cycle; or major change in intercompany service agreements">
        <bpmn:outgoing>W235_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W235_Task4" name="Benchmarking">
        <bpmn:documentation>Step 1: Benchmarking: Conduct annual comparability study for intercompany markups (Logistics services, Rent)
Responsible (R): Tax Manager
Accountable (A): CFO
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W235_Flow12</bpmn:incoming>
        <bpmn:outgoing>W235_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W235_Task5" name="Local File Prep">
        <bpmn:documentation>Step 2: Local File Prep: Prepare &quot;Transfer Pricing Documentation&quot; (TPD) per BIR RR No. 02-2013
Responsible (R): Tax Manager
Accountable (A): External Advisor
Duration: 1 month</bpmn:documentation>
        <bpmn:incoming>W235_Flow13</bpmn:incoming>
        <bpmn:outgoing>W235_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W235_Task6" name="Quarterly Monitoring">
        <bpmn:documentation>Step 3: Quarterly Monitoring: Review actual intercompany margins against the Arm&#x27;s Length Range
Responsible (R): Tax Manager
Accountable (A): Controller
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W235_Flow14</bpmn:incoming>
        <bpmn:outgoing>W235_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W235_Task7" name="Adjustments">
        <bpmn:documentation>Step 4: Adjustments: If margins are outside range, trigger true-up/true-down entries
Responsible (R): Tax Manager
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W235_Flow15</bpmn:incoming>
        <bpmn:outgoing>W235_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W235_Task8" name="Reporting">
        <bpmn:documentation>Step 5: Reporting: File BIR Form 1709 (RPT Form) with the Annual Income Tax Return
Responsible (R): Tax Manager
Accountable (A): CFO
Duration: Per schedule</bpmn:documentation>
        <bpmn:incoming>W235_Flow16</bpmn:incoming>
        <bpmn:outgoing>W235_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W235_End9" name="Complete">
        <bpmn:incoming>W235_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W235_Annotation10">
        <bpmn:text>Controls: - CTL-293 (ensure controlled execution — Cash Positioning &amp; Forecasting (PA-18.1).) | - operational: Tax Manager review and approval gate
Owner: Tax Manager</bpmn:text>
      </bpmn:textAnnotation>
