    <bpmn:process id="W_W423" name="W423. AR Post-dated Check (PDC) Warehousing &amp; Clearing" isExecutable="false">
      <bpmn:documentation>Trigger: PDC registered in the AR PDC register per W1380 (VS-16) — treasury execution begins at registration
Frequency: Daily
Volume: ~2,500–4,000 PDCs/year (aligned with W1380 receipt volume)
Owner: Treasury Manager
Participants: Treasury Analyst, Store/HQ Vault Custodian, AR Clerk, Bank Relationship Manager
Source: workflow W423 — AR Post-dated Check (PDC) Warehousing &amp; Clearing</bpmn:documentation>
      <bpmn:laneSet id="W423_LaneSet4">
        <bpmn:lane id="W423_Lane1" name="Vault Custodian">
        <bpmn:flowNodeRef>W423_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W423_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W423_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W423_Lane2" name="Treasury Analyst">
        <bpmn:flowNodeRef>W423_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W423_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W423_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W423_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W423_Lane3" name="System">
        <bpmn:flowNodeRef>W423_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W423_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W423_Start5" name="PDC registered in the AR PDC register per W1380 (VS-16) — treasury execution begins at…">
        <bpmn:outgoing>W423_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W423_Task6" name="Vault Custody Handover">
        <bpmn:documentation>Step 1: Vault Custody Handover: AR Clerk transfers registered physical PDCs to the Store/HQ Vault Custodian; Custodian verifies each check against the W1380 PDC register entry (check number, bank, amount, maturity date) and files them by maturity month in the secure PDC vault
Responsible (R): Vault Custodian
Accountable (A): Treasury Mgr
Duration: 5 min/batch</bpmn:documentation>
        <bpmn:incoming>W423_Flow16</bpmn:incoming>
        <bpmn:outgoing>W423_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W423_Task7" name="Daily Maturity Review">
        <bpmn:documentation>Step 2: Daily Maturity Review: Treasury Analyst works the daily T-1 execution list (checks maturing tomorrow) generated from the PDC register, complementing W1380&#x27;s weekly 7-business-day look-ahead
Responsible (R): Treasury Analyst
Accountable (A): Treasury Mgr
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W423_Flow17</bpmn:incoming>
        <bpmn:outgoing>W423_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W423_Task8" name="Pulling &amp; Verification">
        <bpmn:documentation>Step 3: Pulling &amp; Verification: Vault Custodian pulls maturing checks from the vault; Treasury Analyst verifies physical checks against the maturity list (dual verification before release from vault)
Responsible (R): Vault Custodian / Treasury Analyst
Accountable (A): Treasury Mgr
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W423_Flow18</bpmn:incoming>
        <bpmn:outgoing>W423_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W423_Task9" name="On-Date Deposit">
        <bpmn:documentation>Step 4: On-Date Deposit: Treasury Analyst prepares deposit slip (or remote deposit capture/RDC scanning) and deposits checks in the bank exactly on the maturity date; register status updated to &quot;Deposited&quot;; system posts GL entry: Dr. Cash in Bank / Cr. PDC Receivable (W1380 step 6)
Responsible (R): Treasury Analyst
Accountable (A): Treasury Mgr
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W423_Flow19</bpmn:incoming>
        <bpmn:outgoing>W423_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W423_Task10" name="Clearing Confirmation">
        <bpmn:documentation>Step 5: Clearing Confirmation: T+1 to T+3 after deposit, Treasury Analyst confirms check clearing via online banking / W89; register status updated to &quot;Cleared&quot;; returned checks (DAIF/DAUD) are routed to W425 for financial reversal and W1381 for customer resolution
Responsible (R): Treasury Analyst
Accountable (A): Treasury Mgr
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W423_Flow20</bpmn:incoming>
        <bpmn:outgoing>W423_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W423_Task11" name="Cash Forecast Feed">
        <bpmn:documentation>Step 6: Cash Forecast Feed: PDC maturity schedule flows automatically into W233 (liquidity forecasting) and W30 (daily cash positioning) as scheduled inflows, dated at expected clearing (deposit date + 1–3 banking days), not check date
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W423_Flow21</bpmn:incoming>
        <bpmn:outgoing>W423_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W423_Task12" name="Monthly Vault Count">
        <bpmn:documentation>Step 7: Monthly Vault Count: Treasury Analyst and AR Supervisor jointly count physical warehoused PDCs and reconcile to the PDC register; discrepancies investigated same day and escalated to the Treasury Manager
Responsible (R): Treasury Analyst / AR Supervisor
Accountable (A): Treasury Mgr
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W423_Flow22</bpmn:incoming>
        <bpmn:outgoing>W423_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W423_End13" name="Complete">
        <bpmn:incoming>W423_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W423_Annotation14">
        <bpmn:text>Controls: - CTL-293 (ensure controlled execution — Cash Positioning &amp; Forecasting (PA-18.1).) | - operational: Treasury Manager review and approval gate; operational: periodic reconciliation against source documents (monthly vault count vs PDC register)
Owner: Treasury Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W423_Assoc15" sourceRef="W423_Annotation14" targetRef="W423_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W423_Flow16" sourceRef="W423_Start5" targetRef="W423_Task6" />
      <bpmn:sequenceFlow id="W423_Flow17" sourceRef="W423_Task6" targetRef="W423_Task7" />
