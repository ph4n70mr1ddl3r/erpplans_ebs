        <bpmndi:BPMNShape id="W233_Task7_di" bpmnElement="W233_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W233_Task8_di" bpmnElement="W233_Task8"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W233_Task9_di" bpmnElement="W233_Task9"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W233_Task10_di" bpmnElement="W233_Task10"><dc:Bounds x="1240" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W233_Start5_di" bpmnElement="W233_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W233_End11_di" bpmnElement="W233_End11"><dc:Bounds x="1470" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W233_Annotation12_di" bpmnElement="W233_Annotation12"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W233_Flow14_di" bpmnElement="W233_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W233_Flow15_di" bpmnElement="W233_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W233_Flow16_di" bpmnElement="W233_Flow16"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W233_Flow17_di" bpmnElement="W233_Flow17"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W233_Flow18_di" bpmnElement="W233_Flow18"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W233_Flow19_di" bpmnElement="W233_Flow19"><di:waypoint x="1420" y="505" /><di:waypoint x="1470" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W233_Assoc13_di" bpmnElement="W233_Assoc13"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W234" name="W234. Intercompany Profit Elimination &amp; Consolidation" isExecutable="false">
      <bpmn:documentation>Trigger: Month-end close (W9)
Frequency: Monthly
Volume: Sales between Logistics Inc., Property Inc., and Depot Inc.
Owner: Consolidation Manager
Participants: Entity Controllers, CFO
Source: workflow W234 — Intercompany Profit Elimination &amp; Consolidation</bpmn:documentation>
      <bpmn:laneSet id="W234_LaneSet3">
        <bpmn:lane id="W234_Lane1" name="Entity Accountant">
        <bpmn:flowNodeRef>W234_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W234_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W234_Lane2" name="Consolidation Mgr">
        <bpmn:flowNodeRef>W234_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W234_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W234_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W234_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W234_Start4" name="Month-end close (W9)">
        <bpmn:outgoing>W234_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W234_Task5" name="Reconciliation">
        <bpmn:documentation>Step 1: Reconciliation: Match intercompany sales/purchases and AR/AP balances between entities
Responsible (R): Entity Accountant
Accountable (A): Consolidation Mgr
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W234_Flow12</bpmn:incoming>
        <bpmn:outgoing>W234_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W234_Task6" name="Profit Identification">
        <bpmn:documentation>Step 2: Profit Identification: Identify &quot;Unrealized Profit&quot; in ending inventory for goods sold between entities (e.g., Depot Inc. holding stock bought from Logistics Inc.)
Responsible (R): Consolidation Mgr
Accountable (A): Controller
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W234_Flow13</bpmn:incoming>
        <bpmn:outgoing>W234_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W234_Task7" name="Elimination Entries">
        <bpmn:documentation>Step 3: Elimination Entries: Post elimination journals in the Consolidation Ledger (Dr. Revenue / Cr. COGS; Dr. COGS / Cr. Inventory)
Responsible (R): Consolidation Mgr
Accountable (A): CFO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W234_Flow14</bpmn:incoming>
        <bpmn:outgoing>W234_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W234_Task8" name="Validation">
        <bpmn:documentation>Step 4: Validation: Verify Consolidated Trial Balance reflects zero intercompany balances
Responsible (R): Consolidation Mgr
Accountable (A): —
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W234_Flow15</bpmn:incoming>
        <bpmn:outgoing>W234_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W234_End9" name="Complete">
        <bpmn:incoming>W234_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W234_Annotation10">
        <bpmn:text>Controls: - CTL-293 (ensure controlled execution — Cash Positioning &amp; Forecasting (PA-18.1).) | - operational: periodic reconciliation against source documents
Owner: Consolidation Manager</bpmn:text>
      </bpmn:textAnnotation>
