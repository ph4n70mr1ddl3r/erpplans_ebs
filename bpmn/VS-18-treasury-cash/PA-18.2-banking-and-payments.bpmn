        <bpmndi:BPMNShape id="W1343_Task11_di" bpmnElement="W1343_Task11"><dc:Bounds x="1240" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1343_Start6_di" bpmnElement="W1343_Start6"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1343_End12_di" bpmnElement="W1343_End12"><dc:Bounds x="1470" y="657" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1343_Annotation13_di" bpmnElement="W1343_Annotation13"><dc:Bounds x="160" y="800" width="360" height="114" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1343_Flow15_di" bpmnElement="W1343_Flow15"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1343_Flow16_di" bpmnElement="W1343_Flow16"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1343_Flow17_di" bpmnElement="W1343_Flow17"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1343_Flow18_di" bpmnElement="W1343_Flow18"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1343_Flow19_di" bpmnElement="W1343_Flow19"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1343_Flow20_di" bpmnElement="W1343_Flow20"><di:waypoint x="1420" y="675" /><di:waypoint x="1470" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1343_Assoc14_di" bpmnElement="W1343_Assoc14"><di:waypoint x="340" y="800" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1344" name="W1344. Intercompany Fund Transfer, Cash Pooling &amp; Entity Settlement" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly intercompany settlement cycle; or entity-level cash deficit requiring intragroup funding; or quarterly dividend distribution from subsidiary to holding company
Frequency: Monthly intercompany settlement; weekly cash pooling transfers; quarterly dividend distributions; ad-hoc for cash deficit funding
Volume: 5 legal entities: BuildRight Holdings (parent), BuildRight Depot, Inc. (primary), BuildRight Logistics, BuildRight Digital Commerce, BuildRight Property Management; ~20–30 intercompany transfers per month
Owner: Treasury Manager
Participants: Treasury Analyst, Finance Controller (per entity), CFO, Corporate Secretary (for dividend resolutions)
Source: workflow W1344 — Intercompany Fund Transfer, Cash Pooling &amp; Entity Settlement</bpmn:documentation>
      <bpmn:laneSet id="W1344_LaneSet5">
        <bpmn:lane id="W1344_Lane1" name="Finance Controller">
        <bpmn:flowNodeRef>W1344_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1344_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1344_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1344_Lane2" name="Treasury Analyst">
        <bpmn:flowNodeRef>W1344_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1344_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1344_Lane3" name="Treasury Manager">
        <bpmn:flowNodeRef>W1344_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1344_Lane4" name="Corporate Secretary">
        <bpmn:flowNodeRef>W1344_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1344_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1344_Start6" name="Monthly intercompany settlement cycle; or entity-level cash deficit requiring intragroup…">
        <bpmn:outgoing>W1344_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1344_Task7" name="Monthly intercompany transaction compilation">
        <bpmn:documentation>Step 1: Monthly intercompany transaction compilation: At month-end close per W17: (a) each entity&#x27;s Finance Controller compiles intercompany transactions: (i) intercompany revenue (services provided to other entities), (ii) intercompany expenses (services received from other entities), (iii) intercompany receivables and payables outstanding, (iv) shared service cost allocations per pre-agreed allocation keys, (b) system generates intercompany transaction matrix: rows = providing entity, columns = receiving entity, values = transaction amounts by type, (c) Treasury Analyst reviews matrix for completeness and accuracy — all entities should have matching intercompany entries (providing entity revenue = receiving entity expense)
Responsible (R): Finance Controller (per entity) / Treasury Analyst
Accountable (A): Finance Controller (Consolidation)
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W1344_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1344_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1344_Task8" name="Intercompany netting">
        <bpmn:documentation>Step 2: Intercompany netting: Treasury Analyst performs intercompany netting: (a) for each entity pair (A→B and B→A): net intercompany payable/receivable to a single net amount, (b) example: Retail owes Logistics PHP 15M for delivery services; Logistics owes Retail PHP 3M for office space rental → net: Retail pays Logistics PHP 12M, (c) compile net settlement schedule: which entity pays which, and how much, (d) netting reduces total cash movement from ~PHP 80M/month (gross) to ~PHP 25M/month (net) — significant reduction in bank transfer volume and transaction costs
Responsible (R): Treasury Analyst
Accountable (A): Treasury Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1344_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1344_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1344_Task9" name="Cash pooling transfers">
        <bpmn:documentation>Step 3: Cash pooling transfers: Treasury Manager manages weekly cash pooling: (a) review entity-level cash positions per W30: which entities have excess cash, which have deficits, (b) for entities with excess cash (&gt; 2 weeks operating expenses): transfer excess to Holdings&#x27; central treasury account for centralized management (short-term investment per W80, debt repayment, or redistribution), (c) for entities with cash deficits (insufficient for upcoming payroll, vendor payments, or capex): transfer from Holdings or from cash-rich entity to cover deficit, (d) execute transfers via RTGS per W1342 for amounts &gt; PHP 5M or PESONet for smaller amounts, (e) record intercompany loan for each transfer: principal, interest rate (arm&#x27;s length per BIR transfer pricing — greater of the BIR-prescribed rate (~12% p.a. per RR 14-2002 practice) or a benchmarked market rate), maturity date, (f) track intercompany loan balances: system maintains running balance per entity pair with interest accrual
Responsible (R): Treasury Manager / Treasury Analyst
Accountable (A): CFO
Duration: 2–3 hours/week</bpmn:documentation>
        <bpmn:incoming>W1344_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1344_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1344_Task10" name="Settlement execution">
        <bpmn:documentation>Step 4: Settlement execution: Treasury Analyst executes monthly net settlement: (a) process net payments per settlement schedule from Step 2: RTGS per W1342 for high-value, PESONet for standard amounts, (b) obtain required authorizations per W320 (maker-checker-approver), (c) system records settlement: debit intercompany payable (paying entity), credit intercompany receivable (receiving entity), (d) update intercompany loan balances: net settlement reduces intercompany loan principal, (e) Finance Controller (Consolidation) verifies all intercompany balances are settled or carried as formal intercompany loans with interest
Responsible (R): Treasury Analyst
Accountable (A): Treasury Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1344_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1344_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1344_Task11" name="Quarterly dividend distribution">
        <bpmn:documentation>Step 5: Quarterly dividend distribution: For profitable subsidiaries (Retail, Property Management): (a) Holdings&#x27; Board of Directors declares dividend based on quarterly financial results per W17, (b) Corporate Secretary prepares Board Resolution authorizing dividend: amount, source entity, payment date, (c) Treasury transfers dividend from subsidiary to Holdings via RTGS per W1342, (d) Finance records: subsidiary debits Retained Earnings, credits Cash; Holdings debits Cash, credits Investment in Subsidiary, (e) BIR compliance: dividend received by Holdings from domestic subsidiary is tax-exempt per Philippine tax law (subject to conditions); document tax-exempt status for annual tax return per W17
Responsible (R): Corporate Secretary / Treasury Manager
Accountable (A): CFO / Board of Directors
Duration: 1–2 days per quarter</bpmn:documentation>
        <bpmn:incoming>W1344_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1344_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1344_Task12" name="Intercompany agreement maintenance">
        <bpmn:documentation>Step 6: Intercompany agreement maintenance: Finance Controller maintains intercompany agreements: (a) service agreements: Logistics → Retail (delivery services at arm&#x27;s length rates), Digital Commerce → Retail (platform fee at arm&#x27;s length), Property Management → Retail (rent at market rate), Holdings → all subsidiaries (shared services cost allocation), (b) pricing methodology documentation: how intercompany prices are determined (cost-plus, market-based, or negotiated), (c) BIR transfer pricing documentation per RR 02-2013 (as supplemented by RR 19-2020 TP documentation): contemporaneous documentation of intercompany pricing methodology, benchmarking analysis, and economic substance, (d) annual review and update of intercompany agreements and pricing
Responsible (R): Finance Controller / VP Legal
Accountable (A): CFO
Duration: 3–5 days/year</bpmn:documentation>
        <bpmn:incoming>W1344_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1344_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1344_End13" name="Complete">
        <bpmn:incoming>W1344_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1344_Annotation14">
        <bpmn:text>Controls: - CTL-294 (ensure controlled execution — Banking &amp; Payments (PA-18.2).) | - operational: documented transfer pricing methodology and annual benchmarking analysis; operational: FX hedging per W80; operational: automated intercompany matching during month-end close per W17
Owner: Treasury Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1344_Assoc15" sourceRef="W1344_Annotation14" targetRef="W1344_Start6" associationDirection="None" />
