      <bpmn:sequenceFlow id="W5559_Flow22" sourceRef="W5559_Task10" targetRef="W5559_Task11" />
      <bpmn:sequenceFlow id="W5559_Flow23" sourceRef="W5559_Task11" targetRef="W5559_Task12" />
      <bpmn:sequenceFlow id="W5559_Flow24" sourceRef="W5559_Task12" targetRef="W5559_Task13" />
      <bpmn:sequenceFlow id="W5559_Flow25" sourceRef="W5559_Task13" targetRef="W5559_Task14" />
      <bpmn:sequenceFlow id="W5559_Flow26" sourceRef="W5559_Task14" targetRef="W5559_Task15" />
      <bpmn:sequenceFlow id="W5559_Flow27" sourceRef="W5559_Task15" targetRef="W5559_Task16" />
      <bpmn:sequenceFlow id="W5559_Flow28" sourceRef="W5559_Task16" targetRef="W5559_End17" />
    </bpmn:process>
