      <bpmn:sequenceFlow id="W1343_Flow17" sourceRef="W1343_Task8" targetRef="W1343_Task9" />
      <bpmn:sequenceFlow id="W1343_Flow18" sourceRef="W1343_Task9" targetRef="W1343_Task10" />
      <bpmn:sequenceFlow id="W1343_Flow19" sourceRef="W1343_Task10" targetRef="W1343_Task11" />
      <bpmn:sequenceFlow id="W1343_Flow20" sourceRef="W1343_Task11" targetRef="W1343_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1343_diag">
      <bpmndi:BPMNPlane id="W1343_plane" bpmnElement="W_W1343">
        <bpmndi:BPMNShape id="W1343_Lane1_di" bpmnElement="W1343_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
