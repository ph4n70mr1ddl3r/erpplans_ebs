    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1294_diag">
      <bpmndi:BPMNPlane id="W1294_plane" bpmnElement="W_W1294">
        <bpmndi:BPMNShape id="W1294_Lane1_di" bpmnElement="W1294_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
