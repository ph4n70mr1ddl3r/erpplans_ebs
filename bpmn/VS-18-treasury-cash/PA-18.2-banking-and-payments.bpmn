<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-18.2-banking-and-payments" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W232" name="W232. Letter of Credit (LC) &amp; Bank Guarantee Lifecycle" isExecutable="false">
      <bpmn:documentation>Trigger: Approved Import PO (W2B) requiring LC; or contract requirement for Bank Guarantee
Frequency: 40–60 LCs/month (imports, consistent with W1199); 5–10 Bank Guarantees/year
Volume: High-value import shipments (Machinery, bulk construction materials)
Owner: Treasury Manager
Participants: Import Coordinator, Buyer, Bank, Finance, Banking &amp; Cash-Management Specialist
Source: workflow W232 — Letter of Credit (LC) &amp; Bank Guarantee Lifecycle</bpmn:documentation>
      <bpmn:laneSet id="W232_LaneSet5">
        <bpmn:lane id="W232_Lane1" name="Import Coord">
        <bpmn:flowNodeRef>W232_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W232_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W232_Lane2" name="Treasury Mgr">
        <bpmn:flowNodeRef>W232_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W232_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W232_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W232_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W232_Lane3" name="Bank">
        <bpmn:flowNodeRef>W232_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W232_Lane4" name="Vendor">
        <bpmn:flowNodeRef>W232_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W232_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W232_Start6" name="Approved Import PO (W2B) requiring LC; or contract requirement for Bank Guarantee">
        <bpmn:outgoing>W232_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W232_Task7" name="Application">
        <bpmn:documentation>Step 1: Application: Import Coordinator requests LC issuance based on Pro-forma Invoice and PO
Responsible (R): Import Coord
Accountable (A): Treasury Mgr
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W232_Flow17</bpmn:incoming>
        <bpmn:outgoing>W232_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W232_Task8" name="Bank Submission">
        <bpmn:documentation>Step 2: Bank Submission: Treasury submits LC application to partner bank via electronic portal
Responsible (R): Treasury Mgr
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W232_Flow18</bpmn:incoming>
        <bpmn:outgoing>W232_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W232_Task9" name="LC Issuance">
        <bpmn:documentation>Step 3: LC Issuance: Bank issues LC; notifies Vendor&#x27;s bank (Advising Bank)
Responsible (R): Bank
Accountable (A): —
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W232_Flow19</bpmn:incoming>
        <bpmn:outgoing>W232_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W232_Task10" name="Document Negotiation">
        <bpmn:documentation>Step 4: Document Negotiation: Vendor ships goods; submits shipping documents (Bill of Lading, Invoice, Packing List) to bank
Responsible (R): Vendor
Accountable (A): —
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W232_Flow20</bpmn:incoming>
        <bpmn:outgoing>W232_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W232_Task11" name="Discrepancy Check">
        <bpmn:documentation>Step 5: Discrepancy Check: Treasury and Bank review documents for discrepancies vs. LC terms
Responsible (R): Treasury Mgr
Accountable (A): —
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W232_Flow21</bpmn:incoming>
        <bpmn:outgoing>W232_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W232_Task12" name="Payment/Acceptance">
        <bpmn:documentation>Step 6: Payment/Acceptance: Treasury authorizes payment or acceptance of draft; Bank releases documents to BuildRight for customs clearance (W233)
Responsible (R): Treasury Mgr
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W232_Flow22</bpmn:incoming>
        <bpmn:outgoing>W232_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W232_Task13" name="Closure">
        <bpmn:documentation>Step 7: Closure: LC closed in system once goods received (W3) and payment settled
Responsible (R): Treasury Mgr
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W232_Flow23</bpmn:incoming>
        <bpmn:outgoing>W232_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W232_End14" name="Complete">
        <bpmn:incoming>W232_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W232_Annotation15">
        <bpmn:text>Controls: - CTL-63 (ensure FX exposure reporting accuracy.) | - operational: Treasury Manager review and approval gate
Owner: Treasury Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W232_Assoc16" sourceRef="W232_Annotation15" targetRef="W232_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W232_Flow17" sourceRef="W232_Start6" targetRef="W232_Task7" />
      <bpmn:sequenceFlow id="W232_Flow18" sourceRef="W232_Task7" targetRef="W232_Task8" />
      <bpmn:sequenceFlow id="W232_Flow19" sourceRef="W232_Task8" targetRef="W232_Task9" />
      <bpmn:sequenceFlow id="W232_Flow20" sourceRef="W232_Task9" targetRef="W232_Task10" />
      <bpmn:sequenceFlow id="W232_Flow21" sourceRef="W232_Task10" targetRef="W232_Task11" />
      <bpmn:sequenceFlow id="W232_Flow22" sourceRef="W232_Task11" targetRef="W232_Task12" />
      <bpmn:sequenceFlow id="W232_Flow23" sourceRef="W232_Task12" targetRef="W232_Task13" />
      <bpmn:sequenceFlow id="W232_Flow24" sourceRef="W232_Task13" targetRef="W232_End14" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W232_diag">
      <bpmndi:BPMNPlane id="W232_plane" bpmnElement="W_W232">
        <bpmndi:BPMNShape id="W232_Lane1_di" bpmnElement="W232_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
