        <bpmndi:BPMNEdge id="W232_Flow24_di" bpmnElement="W232_Flow24"><di:waypoint x="1840" y="335" /><di:waypoint x="1890" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W232_Assoc16_di" bpmnElement="W232_Assoc16"><di:waypoint x="340" y="800" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
