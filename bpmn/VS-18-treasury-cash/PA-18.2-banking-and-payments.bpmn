    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W317" name="W317. Bank Account Lifecycle &amp; Signatory Management" isExecutable="false">
      <bpmn:documentation>Trigger: New store opening (W16), new entity setup, new banking relationship, signatory role change, employee separation (W43), or store closure (W45)
Frequency: ~10–15 new accounts/year (new stores); ~5–8 signatory updates/month (employee turnover); ~2–3 account closures/year
Volume: ~215–230 bank accounts across 5 entities and 4 banks (BDO, BPI, Metrobank, Chinabank): ~200 store deposit accounts, 4 DC operating accounts, 5 entity main operating accounts, 5 USD import accounts, and additional payroll, savings, and investment accounts per entity
Owner: Treasury Manager
Participants: Treasury Analyst, CFO, Legal (Board Resolutions), HR (separation alerts), Store Operations (new store setup)
Source: workflow W317 — Bank Account Lifecycle &amp; Signatory Management</bpmn:documentation>
      <bpmn:laneSet id="W317_LaneSet5">
        <bpmn:lane id="W317_Lane1" name="Treasury Analyst">
        <bpmn:flowNodeRef>W317_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W317_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W317_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W317_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W317_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W317_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W317_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W317_Lane2" name="Legal">
        <bpmn:flowNodeRef>W317_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W317_Lane3" name="System">
        <bpmn:flowNodeRef>W317_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W317_Lane4" name="Treasury Mgr">
        <bpmn:flowNodeRef>W317_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W317_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W317_Start6" name="New store opening (W16), new entity setup, new banking relationship, signatory role…">
        <bpmn:outgoing>W317_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W317_Task7" name="Account opening request">
        <bpmn:documentation>Step 1: Account opening request: triggered by new store (W16), new entity, or operational need — Treasury Analyst prepares account opening checklist per bank requirements: Board Resolution (per entity), Secretary&#x27;s Certificate, authorized signatory list with specimen signatures, business registration documents (SEC, DTI, BIR, LGU permit), latest audited financial statements
Responsible (R): Treasury Analyst
Accountable (A): Treasury Mgr
Duration: 2–3 hours/account</bpmn:documentation>
        <bpmn:incoming>W317_Flow19</bpmn:incoming>
        <bpmn:outgoing>W317_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W317_Task8" name="Legal documentation">
        <bpmn:documentation>Step 2: Legal documentation: Legal prepares Board Resolution authorizing account opening and designating authorized signatories; Secretary&#x27;s Certificate signed by Corporate Secretary
Responsible (R): Legal / Corp Secretary
Accountable (A): CFO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W317_Flow20</bpmn:incoming>
        <bpmn:outgoing>W317_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W317_Task9" name="Bank submission">
        <bpmn:documentation>Step 3: Bank submission: Treasury Analyst submits complete documentation package to bank; tracks application status via bank portal or relationship manager
Responsible (R): Treasury Analyst
Accountable (A): —
Duration: 1–2 weeks (bank processing)</bpmn:documentation>
        <bpmn:incoming>W317_Flow21</bpmn:incoming>
        <bpmn:outgoing>W317_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W317_Task10" name="Account activation">
        <bpmn:documentation>Step 4: Account activation: upon bank confirmation, Treasury Analyst records new account in system — account number, bank name, entity, account type (operating, deposit, payroll, USD, investment), purpose, signatory tier (single, dual, any-two-of-three), opening date; links to entity in GL
Responsible (R): Treasury Analyst
Accountable (A): Treasury Mgr
Duration: 30 min/account</bpmn:documentation>
        <bpmn:incoming>W317_Flow22</bpmn:incoming>
        <bpmn:outgoing>W317_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W317_Task11" name="Signatory management — ongoing">
        <bpmn:documentation>Step 5: Signatory management — ongoing: system tracks authorized signatories per account with signatory tier, specimen signature on file, and last update date; when a signatory changes role (promotion, transfer) or separates (W43), HR alerts Treasury Analyst within 5 business days; Treasury Analyst prepares signatory update documentation per bank requirements and submits within 10 business days of trigger event
Responsible (R): Treasury Analyst
Accountable (A): Treasury Mgr
Duration: 1–2 hours/signatory change</bpmn:documentation>
        <bpmn:incoming>W317_Flow23</bpmn:incoming>
        <bpmn:outgoing>W317_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W317_Task12" name="Signatory staleness review">
        <bpmn:documentation>Step 6: Signatory staleness review: system alerts Treasury Manager when any account has had no signatory update in &gt; 12 months; Treasury Analyst reviews all signatories for current employment status and authority level; updates if needed
Responsible (R): System / Treasury Analyst
Accountable (A): Treasury Mgr
Duration: Quarterly review (2 hours)</bpmn:documentation>
        <bpmn:incoming>W317_Flow24</bpmn:incoming>
        <bpmn:outgoing>W317_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W317_Task13" name="Account closure request">
        <bpmn:documentation>Step 7: Account closure request: triggered by store closure (W45), account consolidation, or banking relationship termination — Treasury Analyst confirms zero balance (or arranges final transfer), obtains bank closure confirmation letter, and deactivates account in system
Responsible (R): Treasury Analyst
Accountable (A): Treasury Mgr
Duration: 1–2 hours/account</bpmn:documentation>
        <bpmn:incoming>W317_Flow25</bpmn:incoming>
        <bpmn:outgoing>W317_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W317_Task14" name="Banking relationship review">
        <bpmn:documentation>Step 8: Banking relationship review: annually, Treasury Manager reviews banking relationships across all 4 banks — fee structures, service quality, credit facility availability, digital banking capabilities, and geographic coverage for provincial stores; recommends relationship changes to CFO
Responsible (R): Treasury Mgr
Accountable (A): CFO
Duration: 4–6 hours/year</bpmn:documentation>
        <bpmn:incoming>W317_Flow26</bpmn:incoming>
        <bpmn:outgoing>W317_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W317_Task15" name="Bank fee monitoring">
        <bpmn:documentation>Step 9: Bank fee monitoring: monthly, Treasury Analyst reviews bank fee and charge schedule per account; compares actual fees charged (from bank statements during W89) against agreed fee schedules; disputes unexpected charges with bank relationship manager within 30 days
Responsible (R): Treasury Analyst
Accountable (A): Treasury Mgr
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W317_Flow27</bpmn:incoming>
        <bpmn:outgoing>W317_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W317_End16" name="Complete">
        <bpmn:incoming>W317_Flow28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W317_Annotation17">
        <bpmn:text>Controls: - CTL-59 (prevent unauthorized bank account changes.) | - operational: prompt HR-to-Treasury separation alerting with signatory and system-access revocation
Owner: Treasury Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W317_Assoc18" sourceRef="W317_Annotation17" targetRef="W317_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W317_Flow19" sourceRef="W317_Start6" targetRef="W317_Task7" />
      <bpmn:sequenceFlow id="W317_Flow20" sourceRef="W317_Task7" targetRef="W317_Task8" />
      <bpmn:sequenceFlow id="W317_Flow21" sourceRef="W317_Task8" targetRef="W317_Task9" />
      <bpmn:sequenceFlow id="W317_Flow22" sourceRef="W317_Task9" targetRef="W317_Task10" />
      <bpmn:sequenceFlow id="W317_Flow23" sourceRef="W317_Task10" targetRef="W317_Task11" />
      <bpmn:sequenceFlow id="W317_Flow24" sourceRef="W317_Task11" targetRef="W317_Task12" />
      <bpmn:sequenceFlow id="W317_Flow25" sourceRef="W317_Task12" targetRef="W317_Task13" />
      <bpmn:sequenceFlow id="W317_Flow26" sourceRef="W317_Task13" targetRef="W317_Task14" />
      <bpmn:sequenceFlow id="W317_Flow27" sourceRef="W317_Task14" targetRef="W317_Task15" />
      <bpmn:sequenceFlow id="W317_Flow28" sourceRef="W317_Task15" targetRef="W317_End16" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W317_diag">
      <bpmndi:BPMNPlane id="W317_plane" bpmnElement="W_W317">
        <bpmndi:BPMNShape id="W317_Lane1_di" bpmnElement="W317_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2210" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W317_Lane2_di" bpmnElement="W317_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="2210" height="170" /></bpmndi:BPMNShape>
