        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5410_Start4" name="Monthly portfolio review; covenant monitoring">
        <bpmn:outgoing>W5410_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5410_Task5" name="Monitor factored-receivables aging and delinquency by customer/segment.">
        <bpmn:documentation>Step 1: Monitor factored-receivables aging and delinquency by customer/segment.
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: monthly</bpmn:documentation>
        <bpmn:incoming>W5410_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5410_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5410_Task6" name="Check concentration vs. sub-limits (W5395) and facility thresholds; flag…">
        <bpmn:documentation>Step 2: Check concentration vs. sub-limits (W5395) and facility thresholds; flag breaches.
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: monthly</bpmn:documentation>
        <bpmn:incoming>W5410_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5410_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5410_Task7" name="Monitor pool health (collections rate, dilution, recourse rate) vs. facility…">
        <bpmn:documentation>Step 3: Monitor pool health (collections rate, dilution, recourse rate) vs. facility covenants/triggers.
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: monthly</bpmn:documentation>
        <bpmn:incoming>W5410_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5410_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5410_Task8" name="Take corrective action on breaches (curtail submission, restructure, cure).">
        <bpmn:documentation>Step 4: Take corrective action on breaches (curtail submission, restructure, cure).
Responsible (R): Credit Manager
Accountable (A): Credit Manager
Duration: per breach</bpmn:documentation>
        <bpmn:incoming>W5410_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5410_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5410_Task9" name="Report portfolio health to the credit/treasury committee and funder…">
        <bpmn:documentation>Step 5: Report portfolio health to the credit/treasury committee and funder (W5408/W5416).
Responsible (R): Credit Manager
Accountable (A): CFO
Duration: monthly</bpmn:documentation>
        <bpmn:incoming>W5410_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5410_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5410_End10" name="Complete">
        <bpmn:incoming>W5410_Flow18</bpmn:incoming>
      </bpmn:endEvent>
