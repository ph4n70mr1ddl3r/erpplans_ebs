        <bpmn:flowNodeRef>W5411_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5411_Lane3" name="Credit Manager">
        <bpmn:flowNodeRef>W5411_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5411_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5411_Start5" name="Customer query/dispute on a notified factored invoice; audit/inspection">
        <bpmn:outgoing>W5411_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5411_Task6" name="Receive customer query/dispute on a notified factored invoice (remit, amount…">
        <bpmn:documentation>Step 1: Receive customer query/dispute on a notified factored invoice (remit, amount, assignment).
Responsible (R): AR Lead
Accountable (A): Credit Manager
Duration: per query</bpmn:documentation>
        <bpmn:incoming>W5411_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5411_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5411_Task7" name="Verify the assignment/notification audit-trail (W5396/W5400) and remit accuracy…">
        <bpmn:documentation>Step 2: Verify the assignment/notification audit-trail (W5396/W5400) and remit accuracy (W5403).
Responsible (R): AR Lead
Accountable (A): Credit Manager
Duration: per query</bpmn:documentation>
        <bpmn:incoming>W5411_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5411_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5411_Task8" name="Resolve the query with the customer and factor; correct any remit/notification…">
        <bpmn:documentation>Step 3: Resolve the query with the customer and factor; correct any remit/notification error.
Responsible (R): AR Lead
Accountable (A): Credit Manager
Duration: per query</bpmn:documentation>
        <bpmn:incoming>W5411_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5411_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5411_Task9" name="Maintain the assignment/notification audit-trail for inspection (VS-88/VS-21).">
        <bpmn:documentation>Step 4: Maintain the assignment/notification audit-trail for inspection (VS-88/VS-21).
Responsible (R): Compliance Specialist
Accountable (A): Credit Manager
Duration: ongoing</bpmn:documentation>
        <bpmn:incoming>W5411_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5411_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5411_Task10" name="Escalate systemic notification issues (W5396) for process fix.">
        <bpmn:documentation>Step 5: Escalate systemic notification issues (W5396) for process fix.
Responsible (R): Credit Manager
Accountable (A): Credit Manager
Duration: per pattern</bpmn:documentation>
        <bpmn:incoming>W5411_Flow18</bpmn:incoming>
        <bpmn:outgoing>W5411_Flow19</bpmn:outgoing>
