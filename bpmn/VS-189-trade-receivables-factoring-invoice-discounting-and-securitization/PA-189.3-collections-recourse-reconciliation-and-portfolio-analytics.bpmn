    <bpmn:process id="W_W5410" name="W5410. Receivables Aging, Sub-Limits, Concentration &amp; Pool Health Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly portfolio review; covenant monitoring
Frequency: Monthly
Volume: 1 portfolio review/month
Owner: Credit Manager
Participants: Credit Analyst, Treasury, Risk (VS-21/VS-68)
Source: workflow W5410 — Receivables Aging, Sub-Limits, Concentration &amp; Pool Health Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W5410_LaneSet3">
        <bpmn:lane id="W5410_Lane1" name="Credit Analyst">
        <bpmn:flowNodeRef>W5410_Task5</bpmn:flowNodeRef>
