    <bpmn:process id="W_W5409" name="W5409. Factor/Funder Reconciliation, Fee/Interest Settlement &amp; Monthly Account Statement" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly close; factor statement received
Frequency: Monthly
Volume: ~1 reconciliation/facility/month
Owner: Finance (Receivables Finance)
Participants: Treasury, Factor/Funder, Finance Controller
Source: workflow W5409 — Factor/Funder Reconciliation, Fee/Interest Settlement &amp; Monthly Account Statement</bpmn:documentation>
      <bpmn:laneSet id="W5409_LaneSet3">
        <bpmn:lane id="W5409_Lane1" name="Finance">
        <bpmn:flowNodeRef>W5409_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5409_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5409_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5409_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5409_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5409_Lane2" name="Treasury Manager">
        <bpmn:flowNodeRef>W5409_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5409_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5409_Start4" name="Monthly close; factor statement received">
        <bpmn:outgoing>W5409_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5409_Task5" name="Receive the factor&#x27;s monthly statement (advances, collections, fees, interest…">
        <bpmn:documentation>Step 1: Receive the factor&#x27;s monthly statement (advances, collections, fees, interest, reserve, recourse).
Responsible (R): Finance
Accountable (A): Finance Controller
Duration: per close</bpmn:documentation>
        <bpmn:incoming>W5409_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5409_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5409_Task6" name="Reconcile the statement to BuildRight&#x27;s records (submissions W5401, drawdowns…">
        <bpmn:documentation>Step 2: Reconcile the statement to BuildRight&#x27;s records (submissions W5401, drawdowns W5402, collections W5404).
Responsible (R): Finance
Accountable (A): Finance Controller
Duration: per close</bpmn:documentation>
        <bpmn:incoming>W5409_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5409_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5409_Task7" name="Settle fees/interest and reserve per the facility terms; post to GL…">
        <bpmn:documentation>Step 3: Settle fees/interest and reserve per the facility terms; post to GL (VS-17/VS-157).
Responsible (R): Finance
Accountable (A): Finance Controller
Duration: per close</bpmn:documentation>
        <bpmn:incoming>W5409_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5409_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5409_Task8" name="Investigate and resolve discrepancies with the factor (timing, fees, reserve).">
        <bpmn:documentation>Step 4: Investigate and resolve discrepancies with the factor (timing, fees, reserve).
Responsible (R): Treasury Manager
Accountable (A): Finance Controller
Duration: per exception</bpmn:documentation>
        <bpmn:incoming>W5409_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5409_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5409_Task9" name="Report reconciliation status and any open items to the treasury committee…">
        <bpmn:documentation>Step 5: Report reconciliation status and any open items to the treasury committee (W5416).
Responsible (R): Finance
Accountable (A): CFO
Duration: per close</bpmn:documentation>
        <bpmn:incoming>W5409_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5409_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5409_End10" name="Complete">
        <bpmn:incoming>W5409_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5409_Annotation11">
        <bpmn:text>Controls: - CTL-19: funder-statement reconciliation; CTL-120 (fee/interest settlement accuracy); CTL-30 (close).
Owner: Finance (Receivables Finance)</bpmn:text>
      </bpmn:textAnnotation>
