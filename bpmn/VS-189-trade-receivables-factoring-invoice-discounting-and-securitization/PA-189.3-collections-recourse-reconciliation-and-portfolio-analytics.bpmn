Accountable (A): Treasury Manager
Duration: per issue</bpmn:documentation>
        <bpmn:incoming>W5413_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5413_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5413_Task8" name="Evaluate factor alternatives and rebalance funding mix if performance is poor…">
