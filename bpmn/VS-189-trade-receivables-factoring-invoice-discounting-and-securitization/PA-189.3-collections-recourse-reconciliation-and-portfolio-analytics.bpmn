    <bpmn:process id="W_W5411" name="W5411. Customer Notification Compliance, Audit-Trail &amp; Dispute/Query Handling" isExecutable="false">
      <bpmn:documentation>Trigger: Customer query/dispute on a notified factored invoice; audit/inspection
Frequency: Per query; periodic audit
Volume: ~hundreds of queries/yr
Owner: AR Lead
Participants: Credit Manager, Compliance Specialist, Customer, Trade Account Manager (VS-107), Factor
Source: workflow W5411 — Customer Notification Compliance, Audit-Trail &amp; Dispute/Query Handling</bpmn:documentation>
      <bpmn:laneSet id="W5411_LaneSet4">
        <bpmn:lane id="W5411_Lane1" name="AR Lead">
        <bpmn:flowNodeRef>W5411_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5411_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5411_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5411_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
