<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-189.1-receivables-financing-strategy-funder-relationships-and-setup" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W5393" name="W5393. Receivables Financing Strategy, Instrument Selection &amp; Working-Capital Plan" isExecutable="false">
      <bpmn:documentation>Trigger: Working-capital need; treasury/funding strategy review
Frequency: Annual strategy refresh
Volume: 1 strategy/yr
Owner: Treasury/Working-Capital Lead
Participants: CFO, Credit Manager (VS-68), Finance, Legal (VS-100)
Source: workflow W5393 — Receivables Financing Strategy, Instrument Selection &amp; Working-Capital Plan</bpmn:documentation>
      <bpmn:laneSet id="W5393_LaneSet4">
        <bpmn:lane id="W5393_Lane1" name="Treasury Lead">
        <bpmn:flowNodeRef>W5393_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5393_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5393_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5393_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5393_Lane2" name="Finance Business Partner">
        <bpmn:flowNodeRef>W5393_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5393_Lane3" name="CFO">
        <bpmn:flowNodeRef>W5393_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5393_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5393_Start5" name="Working-capital need; treasury/funding strategy review">
        <bpmn:outgoing>W5393_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5393_Task6" name="Quantify the trade-receivables balance and cash-conversion cycle from AR aging…">
        <bpmn:documentation>Step 1: Quantify the trade-receivables balance and cash-conversion cycle from AR aging (VS-16/VS-68) and the funding gap.
Responsible (R): Treasury Lead
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5393_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5393_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5393_Task7" name="Evaluate instruments: recourse factoring, non-recourse factoring…">
        <bpmn:documentation>Step 2: Evaluate instruments: recourse factoring, non-recourse factoring (credit-insured), invoice discounting (confidential), and securitization — on cost, risk transfer, and customer-impact.
Responsible (R): Treasury Lead
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5393_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5393_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5393_Task8" name="Select the target funding mix (e.g. factoring for high-risk segments…">
        <bpmn:documentation>Step 3: Select the target funding mix (e.g. factoring for high-risk segments, discounting for investment-grade accounts) and target advance rates.
Responsible (R): Treasury Lead
Accountable (A): CFO
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W5393_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5393_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5393_Task9" name="Build the business case: funding cost vs. DSO/cash-release benefit vs. risk…">
        <bpmn:documentation>Step 4: Build the business case: funding cost vs. DSO/cash-release benefit vs. risk transfer vs. relationship cost.
Responsible (R): Finance Business Partner
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5393_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5393_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5393_Task10" name="Approve at the treasury/credit committee and align to the group funding plan…">
        <bpmn:documentation>Step 5: Approve at the treasury/credit committee and align to the group funding plan (VS-18) and board reporting (VS-36).
Responsible (R): CFO
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5393_Flow18</bpmn:incoming>
        <bpmn:outgoing>W5393_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5393_End11" name="Complete">
        <bpmn:incoming>W5393_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5393_Annotation12">
        <bpmn:text>Controls: - CTL-797: ensure controlled execution — Receivables Financing Strategy, Funder Relationships &amp; Program Setup (PA-189.1).) — strategy/facility approval; CTL-21 (working-capital-data accuracy; CTL-35 (budget/funding-plan adherence).
Owner: Treasury/Working-Capital Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5393_Assoc13" sourceRef="W5393_Annotation12" targetRef="W5393_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W5393_Flow14" sourceRef="W5393_Start5" targetRef="W5393_Task6" />
      <bpmn:sequenceFlow id="W5393_Flow15" sourceRef="W5393_Task6" targetRef="W5393_Task7" />
      <bpmn:sequenceFlow id="W5393_Flow16" sourceRef="W5393_Task7" targetRef="W5393_Task8" />
      <bpmn:sequenceFlow id="W5393_Flow17" sourceRef="W5393_Task8" targetRef="W5393_Task9" />
      <bpmn:sequenceFlow id="W5393_Flow18" sourceRef="W5393_Task9" targetRef="W5393_Task10" />
      <bpmn:sequenceFlow id="W5393_Flow19" sourceRef="W5393_Task10" targetRef="W5393_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5393_diag">
      <bpmndi:BPMNPlane id="W5393_plane" bpmnElement="W_W5393">
        <bpmndi:BPMNShape id="W5393_Lane1_di" bpmnElement="W5393_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
