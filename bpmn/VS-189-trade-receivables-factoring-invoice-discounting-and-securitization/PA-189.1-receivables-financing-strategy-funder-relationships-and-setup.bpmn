      <bpmn:sequenceFlow id="W5394_Flow16" sourceRef="W5394_Task7" targetRef="W5394_Task8" />
      <bpmn:sequenceFlow id="W5394_Flow17" sourceRef="W5394_Task8" targetRef="W5394_Task9" />
      <bpmn:sequenceFlow id="W5394_Flow18" sourceRef="W5394_Task9" targetRef="W5394_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5394_diag">
      <bpmndi:BPMNPlane id="W5394_plane" bpmnElement="W_W5394">
        <bpmndi:BPMNShape id="W5394_Lane1_di" bpmnElement="W5394_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5394_Lane2_di" bpmnElement="W5394_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
