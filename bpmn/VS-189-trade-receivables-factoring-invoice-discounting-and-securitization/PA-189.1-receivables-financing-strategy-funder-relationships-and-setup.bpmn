    <bpmn:process id="W_W5394" name="W5394. Factor/Funder Selection, Facility Negotiation &amp; Master Factoring Agreement" isExecutable="false">
      <bpmn:documentation>Trigger: Approved strategy (W5393); facility renewal
Frequency: Initial + periodic renewal (~1–3 yr terms)
Volume: ~1–3 factor/funder facilities
Owner: Treasury Manager
Participants: CFO, Legal (VS-100), Credit Manager, Factors/Banks
Source: workflow W5394 — Factor/Funder Selection, Facility Negotiation &amp; Master Factoring Agreement</bpmn:documentation>
      <bpmn:laneSet id="W5394_LaneSet3">
        <bpmn:lane id="W5394_Lane1" name="Treasury Manager">
        <bpmn:flowNodeRef>W5394_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5394_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5394_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5394_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5394_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5394_Lane2" name="Legal Counsel">
        <bpmn:flowNodeRef>W5394_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5394_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5394_Start4" name="Approved strategy (W5393); facility renewal">
        <bpmn:outgoing>W5394_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5394_Task5" name="RFP/qualify factors/funders (banks, specialized AR financiers) on pricing…">
        <bpmn:documentation>Step 1: RFP/qualify factors/funders (banks, specialized AR financiers) on pricing, advance rate, recourse terms, and service.
Responsible (R): Treasury Manager
Accountable (A): CFO
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W5394_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5394_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5394_Task6" name="Negotiate facility terms: discount/fee rate, advance rate, recourse period…">
        <bpmn:documentation>Step 2: Negotiate facility terms: discount/fee rate, advance rate, recourse period, concentration limits, and termination.
Responsible (R): Treasury Manager
Accountable (A): CFO
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W5394_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5394_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5394_Task7" name="Legal review and execute the master factoring/discounting agreement…">
        <bpmn:documentation>Step 3: Legal review and execute the master factoring/discounting agreement (assignment, representations, covenants).
Responsible (R): Legal Counsel
Accountable (A): VP Legal &amp; Compliance
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W5394_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5394_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5394_Task8" name="Configure the facility in the treasury/factoring system with limits, rates, and…">
        <bpmn:documentation>Step 4: Configure the facility in the treasury/factoring system with limits, rates, and recourse terms.
Responsible (R): Treasury Manager
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5394_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5394_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5394_Task9" name="Onboard to drawdown (W5401) and monitor covenant compliance (VS-18).">
        <bpmn:documentation>Step 5: Onboard to drawdown (W5401) and monitor covenant compliance (VS-18).
Responsible (R): Treasury Manager
Accountable (A): CFO
Duration: ongoing</bpmn:documentation>
        <bpmn:incoming>W5394_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5394_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5394_End10" name="Complete">
        <bpmn:incoming>W5394_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5394_Annotation11">
        <bpmn:text>Controls: - CTL-797: ensure controlled execution — Receivables Financing Strategy, Funder Relationships &amp; Program Setup (PA-189.1).) — facility authorization; CTL-21 (covenant compliance; CTL-19 (treasury reconciliation).
Owner: Treasury Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5394_Assoc12" sourceRef="W5394_Annotation11" targetRef="W5394_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5394_Flow13" sourceRef="W5394_Start4" targetRef="W5394_Task5" />
      <bpmn:sequenceFlow id="W5394_Flow14" sourceRef="W5394_Task5" targetRef="W5394_Task6" />
