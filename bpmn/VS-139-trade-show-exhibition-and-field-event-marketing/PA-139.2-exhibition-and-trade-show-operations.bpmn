      <bpmndi:BPMNPlane id="W4201_plane" bpmnElement="W_W4201">
        <bpmndi:BPMNShape id="W4201_Lane1_di" bpmnElement="W4201_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
