      <bpmn:sequenceFlow id="W4203_Flow11" sourceRef="W4203_Task4" targetRef="W4203_Task5" />
      <bpmn:sequenceFlow id="W4203_Flow12" sourceRef="W4203_Task5" targetRef="W4203_Task6" />
      <bpmn:sequenceFlow id="W4203_Flow13" sourceRef="W4203_Task6" targetRef="W4203_End7" />
    </bpmn:process>
