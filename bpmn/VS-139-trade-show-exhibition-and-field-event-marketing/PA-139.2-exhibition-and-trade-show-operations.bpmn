    <bpmn:process id="W_W4204" name="W4204. On-Site Sales, Engagement &amp; Lead Capture" isExecutable="false">
      <bpmn:documentation>Trigger: Show open / event live
Frequency: During event (multi-day)
Volume: Hundreds–thousands of booth visitors per show
Owner: Event Lead / Trade Sales (VS-11/VS-107)
Participants: Booth staff, Trade Specialists (VS-124), Trade-Pro (VS-43), Merchandising (VS-01)
Source: workflow W4204 — On-Site Sales, Engagement &amp; Lead Capture</bpmn:documentation>
      <bpmn:laneSet id="W4204_LaneSet4">
        <bpmn:lane id="W4204_Lane1" name="Booth Staff">
        <bpmn:flowNodeRef>W4204_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4204_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4204_Lane2" name="Trade Sales">
        <bpmn:flowNodeRef>W4204_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4204_Lane3" name="Event Lead">
        <bpmn:flowNodeRef>W4204_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4204_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4204_Start5" name="Show open / event live">
        <bpmn:outgoing>W4204_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4204_Task6" name="Booth staff engage visitors (qualify —…">
        <bpmn:documentation>Step 1: Booth staff engage visitors (qualify — trade-pro/contractor/developer/architect), run demos (W4203), and capture leads (scan badge/app, consent links to VS-91) into the lead-capture system (W4214)
Responsible (R): Booth Staff / Trade Specialists
Accountable (A): Event Lead
Duration: Per visitor</bpmn:documentation>
        <bpmn:incoming>W4204_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4204_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4204_Task7" name="Trade Sales/Key Accounts conduct pre-booked and walk-up meetings with named…">
        <bpmn:documentation>Step 2: Trade Sales/Key Accounts conduct pre-booked and walk-up meetings with named accounts/prospects (W4205), and progress opportunities (CRM links to VS-11/VS-107)
Responsible (R): Trade Sales / Key Accounts
Accountable (A): Event Lead
Duration: Per meeting</bpmn:documentation>
        <bpmn:incoming>W4204_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4204_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4204_Task8" name="Event Lead monitor booth performance (traffic, leads, meetings vs target…">
        <bpmn:documentation>Step 3: Event Lead monitor booth performance (traffic, leads, meetings vs target W4200), adjust staffing/engagement, and run daily debriefs
Responsible (R): Event Lead / Trade Sales
Accountable (A): Event Marketing Mgr
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W4204_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4204_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4204_End9" name="Complete">
