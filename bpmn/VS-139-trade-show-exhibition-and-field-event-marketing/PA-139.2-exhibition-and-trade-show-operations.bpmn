    <bpmn:process id="W_W4201" name="W4201. Booth/Stand Design, Build &amp; Logistics" isExecutable="false">
      <bpmn:documentation>Trigger: Event confirmed (W4194); brand refresh
Frequency: Per event (flagship shows reusable)
Volume: Per-event booth/stand (national shows large; regional smaller)
Owner: Event Marketing Manager / Exhibit Designer
Participants: Brand (VS-14), Merchandising (VS-01), Procurement (VS-34), Logistics (VS-06), Vendor (co-exhibit)
Source: workflow W4201 — Booth/Stand Design, Build &amp; Logistics</bpmn:documentation>
      <bpmn:laneSet id="W4201_LaneSet2">
        <bpmn:lane id="W4201_Lane1" name="Event Marketing Mgr">
        <bpmn:flowNodeRef>W4201_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4201_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4201_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4201_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4201_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4201_Start3" name="Event confirmed (W4194); brand refresh">
        <bpmn:outgoing>W4201_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4201_Task4" name="Event Marketing/Designer design the booth/stand (layout, branding, product…">
        <bpmn:documentation>Step 1: Event Marketing/Designer design the booth/stand (layout, branding, product zones, demo area, meeting space, lead-capture station) aligned to brand (VS-14) and event objective (W4200)
Responsible (R): Event Marketing Mgr / Designer / Brand
Accountable (A): Event Marketing Mgr
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4201_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4201_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4201_Task5" name="Event Marketing/Procurement source build/fabrication, manage production…">
        <bpmn:documentation>Step 2: Event Marketing/Procurement source build/fabrication, manage production timeline, and coordinate inbound logistics to the venue (shipping, customs for intl. shows, storage — links to VS-06/VS-34)
Responsible (R): Event Marketing Mgr / Procurement / Logistics
Accountable (A): Event Marketing Mgr
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4201_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4201_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4201_Task6" name="Event Marketing oversee installation/dressing at venue, resolve on-site issues…">
        <bpmn:documentation>Step 3: Event Marketing oversee installation/dressing at venue, resolve on-site issues, and capture build lessons for reuse (reusable modular booth inventory)
Responsible (R): Event Marketing Mgr / Designer
Accountable (A): Event Marketing Mgr
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4201_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4201_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4201_End7" name="Complete">
        <bpmn:incoming>W4201_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4201_Annotation8">
        <bpmn:text>Controls: - CTL-648 (ensure controlled execution — Exhibition &amp; Trade-Show Operations (PA-139.2).) | - CTL-648: booth build on timeline; brand standards met (VS-14); asset tracked
Owner: Event Marketing Manager / Exhibit Designer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4201_Assoc9" sourceRef="W4201_Annotation8" targetRef="W4201_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4201_Flow10" sourceRef="W4201_Start3" targetRef="W4201_Task4" />
      <bpmn:sequenceFlow id="W4201_Flow11" sourceRef="W4201_Task4" targetRef="W4201_Task5" />
      <bpmn:sequenceFlow id="W4201_Flow12" sourceRef="W4201_Task5" targetRef="W4201_Task6" />
      <bpmn:sequenceFlow id="W4201_Flow13" sourceRef="W4201_Task6" targetRef="W4201_End7" />
    </bpmn:process>
