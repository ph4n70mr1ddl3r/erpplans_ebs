    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4203" name="W4203. Product Display, Demo &amp; Sample Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Event prep; product-launch tie-in
Frequency: Per event
Volume: Display/demo SKUs + samples/giveaways per event
Owner: Event Marketing Manager / Merchandising (VS-01) / Trade Marketing
Participants: Merchandising (VS-01), Trade Specialists (VS-124), Vendors, Logistics (VS-06), Product Info (VS-137)
Source: workflow W4203 — Product Display, Demo &amp; Sample Coordination</bpmn:documentation>
      <bpmn:laneSet id="W4203_LaneSet2">
        <bpmn:lane id="W4203_Lane1" name="Event Marketing Mgr">
        <bpmn:flowNodeRef>W4203_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4203_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4203_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4203_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4203_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4203_Start3" name="Event prep; product-launch tie-in">
        <bpmn:outgoing>W4203_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4203_Task4" name="Event Marketing/Merchandising select display/demo products and…">
        <bpmn:documentation>Step 1: Event Marketing/Merchandising select display/demo products and samples/giveaways (product focus W4200), coordinate with vendors (W4197), and ensure product-content/collateral (links to VS-137 PIM, VS-14 print)
Responsible (R): Event Marketing Mgr / Merchandising / Vendor
Accountable (A): Event Marketing Mgr
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4203_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4203_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4203_Task5" name="Event Marketing / Trade Specialists plan product demos (paint mixing, cutting…">
        <bpmn:documentation>Step 2: Event Marketing / Trade Specialists plan product demos (paint mixing, cutting, tool demos, solar — links to VS-09/VS-70), and train demo staff (VS-124); ensure safety for DG demos (VS-114)
Responsible (R): Event Marketing Mgr / Trade Specialists
Accountable (A): Event Marketing Mgr
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4203_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4203_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4203_Task6" name="Event Marketing/Logistics coordinate display/sample inbound to venue, manage…">
        <bpmn:documentation>Step 3: Event Marketing/Logistics coordinate display/sample inbound to venue, manage inventory/giveaways on-site, and arrange post-event return/disposal (W4207)
Responsible (R): Event Marketing Mgr / Logistics
Accountable (A): Event Marketing Mgr
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4203_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4203_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4203_End7" name="Complete">
        <bpmn:incoming>W4203_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4203_Annotation8">
        <bpmn:text>Controls: - CTL-648 (ensure controlled execution — Exhibition &amp; Trade-Show Operations (PA-139.2).) | - CTL-648: demo staff trained + DG safety (VS-114/VS-24); sample/giveaway inventory tracked
Owner: Event Marketing Manager / Merchandising (VS-01) / Trade Marketing</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4203_Assoc9" sourceRef="W4203_Annotation8" targetRef="W4203_Start3" associationDirection="None" />
