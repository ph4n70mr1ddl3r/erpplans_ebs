<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-110.2-freight-execution-routing-guide-and-visibility" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3505" name="W3505. Outbound DC-to-Store Freight Planning &amp; Load Tendering" isExecutable="false">
      <bpmn:documentation>Trigger: Store replenishment wave (links to VS-02/VS-04/W1368); routing guide (W3500)
Frequency: Daily waves; 2–3 deliveries/store/week
Volume: ~5,000 replenishment orders/month
Owner: Logistics / DC Operations
Participants: Logistics (links to VS-06.1), DC Operations (links to VS-04.2), Supply Planning (links to VS-02), Carrier/3PL, Store (links to VS-07.3)
Source: workflow W3505 — Outbound DC-to-Store Freight Planning &amp; Load Tendering</bpmn:documentation>
      <bpmn:laneSet id="W3505_LaneSet3">
        <bpmn:lane id="W3505_Lane1" name="Logistics">
        <bpmn:flowNodeRef>W3505_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3505_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3505_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3505_Lane2" name="DC">
        <bpmn:flowNodeRef>W3505_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3505_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3505_Start4" name="Store replenishment wave (links to VS-02/VS-04/W1368); routing guide (W3500)">
        <bpmn:outgoing>W3505_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3505_Task5" name="Logistics/DC plan the outbound freight from the replenishment wave (links to…">
        <bpmn:documentation>Step 1: Logistics/DC plan the outbound freight from the replenishment wave (links to VS-04.2/W1368): consolidate orders into loads by store/region/priority, select vehicle type (10-wheeler/6-wheeler per profile §7.2), apply the routing guide carrier (W3500), and sequence multi-stop routes (W3507); balance cost vs service
Responsible (R): Logistics / DC / Supply Planning
Accountable (A): Logistics Manager
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W3505_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3505_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3505_Task6" name="Logistics tender the load to the routing-guide carrier (W3501), confirm…">
        <bpmn:documentation>Step 2: Logistics tender the load to the routing-guide carrier (W3501), confirm capacity/rate, schedule pickup and dock door (links to VS-04/W1353), and dispatch; manage owned-fleet (20%) vs third-party (80%) assignment per profile §7.2 and capacity
Responsible (R): Logistics / Carrier / DC
Accountable (A): Logistics Manager
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W3505_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3505_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3505_Task7" name="DC/Logistics load and ship (links to VS-04.2), capture shipment/manifest…">
        <bpmn:documentation>Step 3: DC/Logistics load and ship (links to VS-04.2), capture shipment/manifest, transmit ASN to store (links to VS-07.3), track in-transit (W3508), and confirm delivery/receipt (links to VS-07.3); capture the rate/shipment for freight audit (W3513) and analytics (W3516)
Responsible (R): DC / Logistics / Store
Accountable (A): Logistics Manager
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W3505_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3505_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3505_End8" name="Complete">
        <bpmn:incoming>W3505_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3505_Annotation9">
        <bpmn:text>Controls: - CTL-560 (ensure controlled execution — Freight Execution, Routing Guide &amp; Visibility (PA-110.2).) | - operational: consolidation (W3507); operational: SLA and wave planning
Owner: Logistics / DC Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3505_Assoc10" sourceRef="W3505_Annotation9" targetRef="W3505_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3505_Flow11" sourceRef="W3505_Start4" targetRef="W3505_Task5" />
      <bpmn:sequenceFlow id="W3505_Flow12" sourceRef="W3505_Task5" targetRef="W3505_Task6" />
      <bpmn:sequenceFlow id="W3505_Flow13" sourceRef="W3505_Task6" targetRef="W3505_Task7" />
      <bpmn:sequenceFlow id="W3505_Flow14" sourceRef="W3505_Task7" targetRef="W3505_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3505_diag">
      <bpmndi:BPMNPlane id="W3505_plane" bpmnElement="W_W3505">
        <bpmndi:BPMNShape id="W3505_Lane1_di" bpmnElement="W3505_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3505_Lane2_di" bpmnElement="W3505_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3505_Task5_di" bpmnElement="W3505_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3505_Task6_di" bpmnElement="W3505_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3505_Task7_di" bpmnElement="W3505_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3505_Start4_di" bpmnElement="W3505_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3505_End8_di" bpmnElement="W3505_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3505_Annotation9_di" bpmnElement="W3505_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3505_Flow11_di" bpmnElement="W3505_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3505_Flow12_di" bpmnElement="W3505_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3505_Flow13_di" bpmnElement="W3505_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3505_Flow14_di" bpmnElement="W3505_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3505_Assoc10_di" bpmnElement="W3505_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3506" name="W3506. Last-Mile &amp; Customer Delivery Freight Management" isExecutable="false">
      <bpmn:documentation>Trigger: Ecommerce/home-delivery order (links to VS-10/VS-60); customer bulk delivery
Frequency: Continuous; ~42.9K ecommerce orders/month
Volume: ~42.9K ecommerce + bulk contractor deliveries/month
Owner: Logistics / Ecommerce Fulfillment
Participants: Logistics (links to VS-06.3/VS-56), Ecommerce (links to VS-10.2), 3PL/Delivery Partner (links to VS-56), Store (links to VS-07), Carrier
Source: workflow W3506 — Last-Mile &amp; Customer Delivery Freight Management</bpmn:documentation>
      <bpmn:laneSet id="W3506_LaneSet2">
        <bpmn:lane id="W3506_Lane1" name="Logistics">
        <bpmn:flowNodeRef>W3506_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3506_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3506_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3506_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3506_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3506_Start3" name="Ecommerce/home-delivery order (links to VS-10/VS-60); customer bulk delivery">
        <bpmn:outgoing>W3506_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3506_Task4" name="Logistics/Ecommerce plan last-mile delivery per the order-routing decision…">
        <bpmn:documentation>Step 1: Logistics/Ecommerce plan last-mile delivery per the order-routing decision (links to VS-60/W3507): ship-from-store vs DC vs dark-store (links to VS-93) vs drop-ship, carrier/3PL selection (links to VS-56/W3500), delivery window, and bulk/heavy-item handling (white-glove links to W1208, bulk sand/cement links to W1488); manage mixed-basket orders (links to VS-60.2)
Responsible (R): Logistics / Ecommerce / 3PL
Accountable (A): Logistics Manager
Duration: Per order/batch</bpmn:documentation>
        <bpmn:incoming>W3506_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3506_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3506_Task5" name="Logistics/3PL execute the last-mile delivery: dispatch (links to W1165)…">
        <bpmn:documentation>Step 2: Logistics/3PL execute the last-mile delivery: dispatch (links to W1165), driver/route, customer notification, delivery and POD, and failed-delivery/returns handling (links to VS-32); manage delivery-partner SLA (links to VS-56/W1371) and customer experience (links to VS-13)
Responsible (R): Logistics / 3PL / Driver
Accountable (A): Logistics Manager
Duration: Per delivery</bpmn:documentation>
        <bpmn:incoming>W3506_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3506_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3506_Task6" name="Logistics/Ecommerce capture the delivery cost per order, reconcile 3PL…">
        <bpmn:documentation>Step 3: Logistics/Ecommerce capture the delivery cost per order, reconcile 3PL settlement (links to VS-56.3), feed the freight audit (W3513) and cost-to-serve (W3516), and report last-mile performance (W3512); manage delivery-charge to customer and free-delivery threshold (per profile §8.3)
Responsible (R): Logistics / Ecommerce / Finance
Accountable (A): Logistics Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3506_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3506_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3506_End7" name="Complete">
        <bpmn:incoming>W3506_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3506_Annotation8">
        <bpmn:text>Controls: - CTL-560 (ensure controlled execution — Freight Execution, Routing Guide &amp; Visibility (PA-110.2).) | - operational: notification and SLA; operational: cost-to-serve analytics (W3516)
Owner: Logistics / Ecommerce Fulfillment</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3506_Assoc9" sourceRef="W3506_Annotation8" targetRef="W3506_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3506_Flow10" sourceRef="W3506_Start3" targetRef="W3506_Task4" />
      <bpmn:sequenceFlow id="W3506_Flow11" sourceRef="W3506_Task4" targetRef="W3506_Task5" />
      <bpmn:sequenceFlow id="W3506_Flow12" sourceRef="W3506_Task5" targetRef="W3506_Task6" />
      <bpmn:sequenceFlow id="W3506_Flow13" sourceRef="W3506_Task6" targetRef="W3506_End7" />
    </bpmn:process>
