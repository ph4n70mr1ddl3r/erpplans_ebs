      <bpmndi:BPMNPlane id="W3506_plane" bpmnElement="W_W3506">
        <bpmndi:BPMNShape id="W3506_Lane1_di" bpmnElement="W3506_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
