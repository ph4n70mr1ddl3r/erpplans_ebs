      <bpmn:sequenceFlow id="W3512_Flow12" sourceRef="W3512_Task5" targetRef="W3512_Task6" />
      <bpmn:sequenceFlow id="W3512_Flow13" sourceRef="W3512_Task6" targetRef="W3512_End7" />
    </bpmn:process>
