        <bpmndi:BPMNShape id="W3507_Task6_di" bpmnElement="W3507_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3507_Start3_di" bpmnElement="W3507_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3507_End7_di" bpmnElement="W3507_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3507_Annotation8_di" bpmnElement="W3507_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3507_Flow10_di" bpmnElement="W3507_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3507_Flow11_di" bpmnElement="W3507_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3507_Flow12_di" bpmnElement="W3507_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3507_Flow13_di" bpmnElement="W3507_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3507_Assoc9_di" bpmnElement="W3507_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3508" name="W3508. Freight Tracking, Visibility &amp; Exception Management" isExecutable="false">
      <bpmn:documentation>Trigger: Shipment dispatched (W3505/W3506/W3503)
Frequency: Continuous
Volume: All in-transit shipments
Owner: Logistics / Control Tower
Participants: Logistics (links to VS-06), DC (links to VS-04), Store (links to VS-07), Ecommerce (links to VS-10), Carrier/3PL, Customer (links to VS-13)
Source: workflow W3508 — Freight Tracking, Visibility &amp; Exception Management</bpmn:documentation>
      <bpmn:laneSet id="W3508_LaneSet2">
        <bpmn:lane id="W3508_Lane1" name="Logistics">
        <bpmn:flowNodeRef>W3508_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3508_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3508_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3508_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3508_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3508_Start3" name="Shipment dispatched (W3505/W3506/W3503)">
        <bpmn:outgoing>W3508_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3508_Task4" name="Logistics/Carrier track shipments in-transit via Oracle Transportation…">
        <bpmn:documentation>Step 1: Logistics/Carrier track shipments in-transit via Oracle Transportation Execution/EDI/API/GPS (links to VS-27/W1165): location/status, ETA, milestones (pickup, in-transit, delivery), and exceptions (delay, damage, failed pickup/delivery); aggregate to a control-tower view across all legs
Responsible (R): Logistics / Carrier
Accountable (A): Logistics Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3508_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3508_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3508_Task5" name="Logistics detect and triage exceptions: delay (traffic, weather/typhoon links…">
        <bpmn:documentation>Step 2: Logistics detect and triage exceptions: delay (traffic, weather/typhoon links to VS-69, port congestion), damage/loss (links to W3511/VS-90), failed delivery (links to VS-32), capacity shortfall; prioritize by impact and dispatch resolution (reroute, expedite, customer comms links to VS-13)
Responsible (R): Logistics / Control Tower
Accountable (A): Logistics Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3508_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3508_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3508_Task6" name="Logistics publish visibility to stakeholders: store ETA (links to VS-07.3)…">
        <bpmn:documentation>Step 3: Logistics publish visibility to stakeholders: store ETA (links to VS-07.3), ecommerce customer tracking (links to VS-10/VS-13), DC inbound ETA (links to VS-04), and exception status; capture exceptions for analytics (W3516), carrier scorecard (W3512), and continuous improvement (W3518)
Responsible (R): Logistics / Ecommerce / Store
Accountable (A): Logistics Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3508_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3508_Flow13</bpmn:outgoing>
      </bpmn:userTask>
