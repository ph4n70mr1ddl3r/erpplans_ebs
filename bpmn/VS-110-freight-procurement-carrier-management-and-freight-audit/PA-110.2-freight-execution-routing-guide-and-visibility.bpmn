        <bpmndi:BPMNShape id="W3506_Start3_di" bpmnElement="W3506_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3506_End7_di" bpmnElement="W3506_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3506_Annotation8_di" bpmnElement="W3506_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3506_Flow10_di" bpmnElement="W3506_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3506_Flow11_di" bpmnElement="W3506_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3506_Flow12_di" bpmnElement="W3506_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3506_Flow13_di" bpmnElement="W3506_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3506_Assoc9_di" bpmnElement="W3506_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3507" name="W3507. Multi-Stop Route Optimization &amp; Load Consolidation" isExecutable="false">
      <bpmn:documentation>Trigger: Outbound wave (W3505); last-mile batch (W3506)
Frequency: Daily + per batch
Volume: All DC→store and last-mile loads
Owner: Logistics / Transportation
Participants: Logistics (links to VS-06), DC Operations (links to VS-04), IT (links to VS-27/VS-30.2), Supply Planning (links to VS-02)
Source: workflow W3507 — Multi-Stop Route Optimization &amp; Load Consolidation</bpmn:documentation>
      <bpmn:laneSet id="W3507_LaneSet2">
        <bpmn:lane id="W3507_Lane1" name="Logistics">
        <bpmn:flowNodeRef>W3507_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3507_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3507_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3507_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3507_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3507_Start3" name="Outbound wave (W3505); last-mile batch (W3506)">
        <bpmn:outgoing>W3507_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3507_Task4" name="Logistics optimize multi-stop routes in the Route Optimization Engine (in-house…">
        <bpmn:documentation>Step 1: Logistics optimize multi-stop routes in the Route Optimization Engine (in-house build — fit-gap C14) for DC→store delivery (links to W1369/W3505) and last-mile (W3506): sequence stops, apply road/constraint data (Philippine road constraints links to W1369), vehicle capacity, time windows, and driver-hours; minimize distance/cost while meeting service
Responsible (R): Logistics
Accountable (A): Logistics Manager
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W3507_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3507_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3507_Task5" name="Logistics/DC consolidate loads: combine replenishment orders by…">
        <bpmn:documentation>Step 2: Logistics/DC consolidate loads: combine replenishment orders by store/region/priority into full-truck loads (profile §7.2: each truck consolidates a store&#x27;s ~20–30 transfer orders since its previous drop), co-load inbound/outbound where backhaul opportunities exist, and manage cube/weight utilization; balance consolidation vs service/urgency
Responsible (R): Logistics / DC
Accountable (A): Logistics Manager
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W3507_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3507_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3507_Task6" name="Logistics/Finance measure route efficiency (cost/km, cost/stop, stops/route…">
        <bpmn:documentation>Step 3: Logistics/Finance measure route efficiency (cost/km, cost/stop, stops/route, load factor, empty miles/backhaul %), validate savings vs baseline (W3497), and feed continuous improvement (W3518); tune the optimization as the network/demand changes
Responsible (R): Logistics / Finance
Accountable (A): Logistics Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3507_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3507_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3507_End7" name="Complete">
        <bpmn:incoming>W3507_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3507_Annotation8">
        <bpmn:text>Controls: - CTL-560 (ensure controlled execution — Freight Execution, Routing Guide &amp; Visibility (PA-110.2).) | - operational: Route Optimization Engine tuning (in-house build — fit-gap C14); operational: priority rules
Owner: Logistics / Transportation</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3507_Assoc9" sourceRef="W3507_Annotation8" targetRef="W3507_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3507_Flow10" sourceRef="W3507_Start3" targetRef="W3507_Task4" />
      <bpmn:sequenceFlow id="W3507_Flow11" sourceRef="W3507_Task4" targetRef="W3507_Task5" />
      <bpmn:sequenceFlow id="W3507_Flow12" sourceRef="W3507_Task5" targetRef="W3507_Task6" />
      <bpmn:sequenceFlow id="W3507_Flow13" sourceRef="W3507_Task6" targetRef="W3507_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3507_diag">
      <bpmndi:BPMNPlane id="W3507_plane" bpmnElement="W_W3507">
        <bpmndi:BPMNShape id="W3507_Lane1_di" bpmnElement="W3507_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
