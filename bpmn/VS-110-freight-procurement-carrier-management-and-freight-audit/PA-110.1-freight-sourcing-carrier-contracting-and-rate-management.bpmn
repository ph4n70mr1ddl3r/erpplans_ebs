      <bpmn:sequenceFlow id="W3504_Flow12" sourceRef="W3504_Task5" targetRef="W3504_Task6" />
      <bpmn:sequenceFlow id="W3504_Flow13" sourceRef="W3504_Task6" targetRef="W3504_End7" />
    </bpmn:process>
