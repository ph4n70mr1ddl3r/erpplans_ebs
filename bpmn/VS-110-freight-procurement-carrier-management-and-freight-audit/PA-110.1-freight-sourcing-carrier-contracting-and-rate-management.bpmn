<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-110.1-freight-sourcing-carrier-contracting-and-rate-management" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3497" name="W3497. Freight Category Strategy &amp; Spend Baseline" isExecutable="false">
      <bpmn:documentation>Trigger: Annual procurement/SCM planning (links to VS-33.1); spend-review cycle
Frequency: Annual + periodic refresh
Volume: Group freight spend (inbound/import/line-haul/last-mile)
Owner: Logistics / Procurement (Category)
Participants: Logistics (links to VS-06), Procurement (links to VS-03/VS-34), FP&amp;A (links to VS-17.4/VS-33.1), Treasury (links to VS-18), Supply Planning (links to VS-02)
Source: workflow W3497 — Freight Category Strategy &amp; Spend Baseline</bpmn:documentation>
      <bpmn:laneSet id="W3497_LaneSet2">
        <bpmn:lane id="W3497_Lane1" name="Logistics">
        <bpmn:flowNodeRef>W3497_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3497_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3497_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3497_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3497_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3497_Start3" name="Annual procurement/SCM planning (links to VS-33.1); spend-review cycle">
        <bpmn:outgoing>W3497_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3497_Task4" name="Logistics/Procurement build the freight-spend baseline and category strategy…">
        <bpmn:documentation>Step 1: Logistics/Procurement build the freight-spend baseline and category strategy: spend by leg (import ocean, drayage, inbound vendor→DC/DSD, inter-DC/inter-island, DC→store, last-mile), by carrier, by lane/region, by mode, and by cost element (line-haul, fuel surcharge, accessorial); identify consolidation, mode-shift, and carrier-rationalization opportunities
Responsible (R): Logistics / Procurement / FP&amp;A
Accountable (A): COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3497_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3497_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3497_Task5" name="Logistics/Supply Planning set the freight-service requirements and lane…">
        <bpmn:documentation>Step 2: Logistics/Supply Planning set the freight-service requirements and lane network: required transit/lead times (links to VS-02 lead times), service frequencies, capacity needs (TEUs/month, replenishment orders/month links to profile §7), network design (DC catchments links to VS-04), and island/region constraints (links to W66); align to the S&amp;OP (links to VS-02.1) and demand (links to VS-02)
Responsible (R): Logistics / Supply Planning
Accountable (A): COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3497_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3497_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3497_Task6" name="Logistics/FP&amp;A set the freight cost-reduction targets and the carrier-base…">
        <bpmn:documentation>Step 3: Logistics/FP&amp;A set the freight cost-reduction targets and the carrier-base strategy (core carriers, capacity tiers, framework vs spot), align to the budget (links to VS-33.1/VS-17.4) and commodity/fuel outlook (links to VS-106/VS-61), and approve the sourcing plan (W3498); report to governance (W3520/W110 review)
Responsible (R): Logistics / FP&amp;A
Accountable (A): COO / CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3497_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3497_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3497_End7" name="Complete">
        <bpmn:incoming>W3497_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3497_Annotation8">
        <bpmn:text>Controls: - CTL-559 (ensure controlled execution — Freight Sourcing, Carrier Contracting &amp; Rate Management (PA-110.1).) | - operational: consolidated spend baseline; operational: joint logistics/SCM planning
Owner: Logistics / Procurement (Category)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3497_Assoc9" sourceRef="W3497_Annotation8" targetRef="W3497_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3497_Flow10" sourceRef="W3497_Start3" targetRef="W3497_Task4" />
      <bpmn:sequenceFlow id="W3497_Flow11" sourceRef="W3497_Task4" targetRef="W3497_Task5" />
      <bpmn:sequenceFlow id="W3497_Flow12" sourceRef="W3497_Task5" targetRef="W3497_Task6" />
      <bpmn:sequenceFlow id="W3497_Flow13" sourceRef="W3497_Task6" targetRef="W3497_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3497_diag">
      <bpmndi:BPMNPlane id="W3497_plane" bpmnElement="W_W3497">
        <bpmndi:BPMNShape id="W3497_Lane1_di" bpmnElement="W3497_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3497_Task4_di" bpmnElement="W3497_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3497_Task5_di" bpmnElement="W3497_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3497_Task6_di" bpmnElement="W3497_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3497_Start3_di" bpmnElement="W3497_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3497_End7_di" bpmnElement="W3497_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3497_Annotation8_di" bpmnElement="W3497_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3497_Flow10_di" bpmnElement="W3497_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3497_Flow11_di" bpmnElement="W3497_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3497_Flow12_di" bpmnElement="W3497_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3497_Flow13_di" bpmnElement="W3497_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3497_Assoc9_di" bpmnElement="W3497_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3498" name="W3498. Carrier &amp; 3PL Sourcing, RFQ &amp; Qualification" isExecutable="false">
      <bpmn:documentation>Trigger: Sourcing plan (W3497); contract-expiry; new-lane/capacity need
Frequency: Annual RFQ + event-driven
Volume: Carrier base across all legs (~dozens of carriers/3PLs)
Owner: Procurement (Category) / Logistics
Participants: Procurement (links to VS-03/VS-34), Logistics (links to VS-06), Legal (links to VS-100.3), Insurance/Risk (links to VS-26), HSE (links to VS-24), Carrier/3PL
Source: workflow W3498 — Carrier &amp; 3PL Sourcing, RFQ &amp; Qualification</bpmn:documentation>
      <bpmn:laneSet id="W3498_LaneSet2">
        <bpmn:lane id="W3498_Lane1" name="Procurement">
        <bpmn:flowNodeRef>W3498_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3498_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3498_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3498_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3498_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3498_Start3" name="Sourcing plan (W3497); contract-expiry; new-lane/capacity need">
        <bpmn:outgoing>W3498_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3498_Task4" name="Procurement/Logistics run the carrier/3PL RFQ: define lane/volume/service specs…">
        <bpmn:documentation>Step 1: Procurement/Logistics run the carrier/3PL RFQ: define lane/volume/service specs per leg, issue RFP to qualified carriers and 3PLs (links to VS-03 methodology), pre-qualify on capability (equipment, coverage, capacity), financial stability, insurance, safety/regulatory record (links to VS-26/VS-24), and references
Responsible (R): Procurement / Logistics
Accountable (A): COO
Duration: Per RFQ</bpmn:documentation>
        <bpmn:incoming>W3498_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3498_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3498_Task5" name="Procurement/Logistics evaluate bids: rate per lane/mode, fuel/accessorial…">
        <bpmn:documentation>Step 2: Procurement/Logistics evaluate bids: rate per lane/mode, fuel/accessorial structure, transit/lead time, capacity commitment, SLA, technology (track-and-trace, EDI/API links to VS-27), and total cost; score and short-list; manage a balanced core-carrier panel per lane
Responsible (R): Procurement / Logistics / FP&amp;A
Accountable (A): COO
Duration: Per RFQ</bpmn:documentation>
        <bpmn:incoming>W3498_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3498_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3498_Task6" name="Procurement/Legal recommend award per authority (links to VS-36), manage…">
        <bpmn:documentation>Step 3: Procurement/Legal recommend award per authority (links to VS-36), manage framework/master agreements where volume warrants, and route selected carriers to contracting (W3499) and onboarding (W3504); log the award and feed the routing guide (W3500)
Responsible (R): Procurement / Legal
Accountable (A): COO
Duration: Per RFQ</bpmn:documentation>
        <bpmn:incoming>W3498_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3498_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3498_End7" name="Complete">
        <bpmn:incoming>W3498_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3498_Annotation8">
        <bpmn:text>Controls: - CTL-559 (ensure controlled execution — Freight Sourcing, Carrier Contracting &amp; Rate Management (PA-110.1).) | - operational: total-cost and SLA scoring; operational: dual-sourcing core carriers
Owner: Procurement (Category) / Logistics</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3498_Assoc9" sourceRef="W3498_Annotation8" targetRef="W3498_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3498_Flow10" sourceRef="W3498_Start3" targetRef="W3498_Task4" />
      <bpmn:sequenceFlow id="W3498_Flow11" sourceRef="W3498_Task4" targetRef="W3498_Task5" />
      <bpmn:sequenceFlow id="W3498_Flow12" sourceRef="W3498_Task5" targetRef="W3498_Task6" />
      <bpmn:sequenceFlow id="W3498_Flow13" sourceRef="W3498_Task6" targetRef="W3498_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3498_diag">
      <bpmndi:BPMNPlane id="W3498_plane" bpmnElement="W_W3498">
        <bpmndi:BPMNShape id="W3498_Lane1_di" bpmnElement="W3498_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3498_Task4_di" bpmnElement="W3498_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3498_Task5_di" bpmnElement="W3498_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3498_Task6_di" bpmnElement="W3498_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3498_Start3_di" bpmnElement="W3498_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3498_End7_di" bpmnElement="W3498_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3498_Annotation8_di" bpmnElement="W3498_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3498_Flow10_di" bpmnElement="W3498_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3498_Flow11_di" bpmnElement="W3498_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3498_Flow12_di" bpmnElement="W3498_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3498_Flow13_di" bpmnElement="W3498_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3498_Assoc9_di" bpmnElement="W3498_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3499" name="W3499. Carrier Contracting, Rate Negotiation &amp; Tariff Structures" isExecutable="false">
      <bpmn:documentation>Trigger: Award (W3498); contract cycle
Frequency: Per carrier + annual rate review
Volume: Carrier base across all legs
Owner: Procurement (Category) / Legal
Participants: Procurement (links to VS-03/VS-34), Legal (links to VS-100.3), Logistics (links to VS-06), Finance (links to VS-40/VS-17), Carrier/3PL
Source: workflow W3499 — Carrier Contracting, Rate Negotiation &amp; Tariff Structures</bpmn:documentation>
      <bpmn:laneSet id="W3499_LaneSet3">
        <bpmn:lane id="W3499_Lane1" name="Procurement">
        <bpmn:flowNodeRef>W3499_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3499_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3499_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3499_Lane2" name="Legal">
        <bpmn:flowNodeRef>W3499_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3499_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3499_Start4" name="Award (W3498); contract cycle">
        <bpmn:outgoing>W3499_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3499_Task5" name="Procurement/Logistics negotiate the rate structure per carrier/leg…">
        <bpmn:documentation>Step 1: Procurement/Logistics negotiate the rate structure per carrier/leg: point-to-point rates, zone/mileage-based rates (per-km by vehicle type links to W1166), minimum charge, FAK (freight-all-kind) vs commodity rate, accessorial schedule (detention, demurrage, layover, loading/unloading, fuel surcharge formula), and volume rebates; benchmark vs market (links to VS-57 methodology)
Responsible (R): Procurement / Logistics
Accountable (A): COO
Duration: Per carrier</bpmn:documentation>
        <bpmn:incoming>W3499_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3499_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3499_Task6" name="Legal/Procurement structure and execute the contract: term, capacity commitment…">
        <bpmn:documentation>Step 2: Legal/Procurement structure and execute the contract: term, capacity commitment and volume tier, SLA (links to VS-56/W1371), liability/cargo insurance limits (links to VS-26), claims process (W3511), fuel/index mechanism (W3519), termination, and dispute resolution (links to VS-100.3); ensure multi-entity applicability (links to VS-72)
Responsible (R): Legal / Procurement
Accountable (A): COO / CFO
Duration: Per carrier</bpmn:documentation>
        <bpmn:incoming>W3499_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3499_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3499_Task7" name="Procurement/Logistics load the contracted rates/tariff into the Oracle…">
        <bpmn:documentation>Step 3: Procurement/Logistics load the contracted rates/tariff into the Oracle Transportation Execution/ERP rate master (links to VS-27/W1166), publish the rate-effective date, and integrate to the routing guide (W3500) and freight-audit baseline (W3513); track contract compliance and savings vs baseline (W3518)
Responsible (R): Procurement / Logistics / IT
Accountable (A): COO
Duration: Per carrier</bpmn:documentation>
        <bpmn:incoming>W3499_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3499_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3499_End8" name="Complete">
        <bpmn:incoming>W3499_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3499_Annotation9">
        <bpmn:text>Controls: - CTL-559 (ensure controlled execution — Freight Sourcing, Carrier Contracting &amp; Rate Management (PA-110.1).) | - operational: total-cost modeling and audit (W3513); operational: balanced formula (W3519)
Owner: Procurement (Category) / Legal</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3499_Assoc10" sourceRef="W3499_Annotation9" targetRef="W3499_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3499_Flow11" sourceRef="W3499_Start4" targetRef="W3499_Task5" />
      <bpmn:sequenceFlow id="W3499_Flow12" sourceRef="W3499_Task5" targetRef="W3499_Task6" />
      <bpmn:sequenceFlow id="W3499_Flow13" sourceRef="W3499_Task6" targetRef="W3499_Task7" />
      <bpmn:sequenceFlow id="W3499_Flow14" sourceRef="W3499_Task7" targetRef="W3499_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3499_diag">
      <bpmndi:BPMNPlane id="W3499_plane" bpmnElement="W_W3499">
        <bpmndi:BPMNShape id="W3499_Lane1_di" bpmnElement="W3499_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3499_Lane2_di" bpmnElement="W3499_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3499_Task5_di" bpmnElement="W3499_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3499_Task6_di" bpmnElement="W3499_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3499_Task7_di" bpmnElement="W3499_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3499_Start4_di" bpmnElement="W3499_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3499_End8_di" bpmnElement="W3499_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3499_Annotation9_di" bpmnElement="W3499_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3499_Flow11_di" bpmnElement="W3499_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3499_Flow12_di" bpmnElement="W3499_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3499_Flow13_di" bpmnElement="W3499_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3499_Flow14_di" bpmnElement="W3499_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3499_Assoc10_di" bpmnElement="W3499_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3500" name="W3500. Routing Guide, Carrier Compliance &amp; Lane Assignment" isExecutable="false">
      <bpmn:documentation>Trigger: Contracted rates (W3499); network/lanes
Frequency: Maintained + on change
Volume: All origin→destination lanes
Owner: Logistics / Transportation
Participants: Logistics (links to VS-06), Supply Planning (links to VS-02), Procurement (links to VS-03), DC Operations (links to VS-04), Carrier
Source: workflow W3500 — Routing Guide, Carrier Compliance &amp; Lane Assignment</bpmn:documentation>
      <bpmn:laneSet id="W3500_LaneSet2">
        <bpmn:lane id="W3500_Lane1" name="Logistics">
        <bpmn:flowNodeRef>W3500_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3500_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3500_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3500_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3500_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3500_Start3" name="Contracted rates (W3499); network/lanes">
        <bpmn:outgoing>W3500_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3500_Task4" name="Logistics publish the routing guide: preferred carrier(s) and mode per…">
        <bpmn:documentation>Step 1: Logistics publish the routing guide: preferred carrier(s) and mode per origin→destination lane (vendor→DC, vendor→store DSD, DC→store, DC→DC, DC/store→customer, port→DC drayage), rate reference, packaging/handling requirements, appointment/dock rules (links to VS-04/W585), and documentation requirements; cascade to vendors (W3502) and internal teams
Responsible (R): Logistics / Transportation
Accountable (A): COO
Duration: Maintained</bpmn:documentation>
        <bpmn:incoming>W3500_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3500_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3500_Task5" name="Logistics/IT enforce the routing guide at tender (W3501): system-suggested…">
        <bpmn:documentation>Step 2: Logistics/IT enforce the routing guide at tender (W3501): system-suggested carrier per lane, compliance flags for off-guide routing, approval workflow for exceptions, and capture of routing-deviation reason and cost impact; integrate to PO (links to VS-03.2) and SO (links to VS-11/VS-10)
Responsible (R): Logistics / IT
Accountable (A): COO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3500_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3500_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3500_Task6" name="Logistics/Procurement monitor routing-guide compliance, carrier share per lane…">
        <bpmn:documentation>Step 3: Logistics/Procurement monitor routing-guide compliance, carrier share per lane, off-guide spend, and capacity/utilization; rebalance carrier assignments and update the guide as rates/lanes change (W3499); report compliance and off-guide cost to the carrier scorecard (W3512) and review (W3520)
Responsible (R): Logistics / Procurement
Accountable (A): COO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3500_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3500_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3500_End7" name="Complete">
        <bpmn:incoming>W3500_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3500_Annotation8">
        <bpmn:text>Controls: - CTL-78 (ensure freight invoice accuracy &amp; carrier compliance.) | - operational: system enforcement and exception approval; operational: enforcement and exception approval; operational: maintenance discipline
Owner: Logistics / Transportation</bpmn:text>
      </bpmn:textAnnotation>
