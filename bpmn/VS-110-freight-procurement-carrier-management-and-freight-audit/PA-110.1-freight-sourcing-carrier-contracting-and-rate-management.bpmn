        <bpmn:lane id="W3501_Lane1" name="Logistics">
        <bpmn:flowNodeRef>W3501_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3501_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3501_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3501_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3501_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3501_Start3" name="Shipment ready (links to VS-04/VS-06); routing guide (W3500)">
        <bpmn:outgoing>W3501_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3501_Task4" name="Logistics/DC tender the shipment to the routing-guide carrier (W3500)…">
        <bpmn:documentation>Step 1: Logistics/DC tender the shipment to the routing-guide carrier (W3500): automated tender via Oracle Transportation Execution/EDI/API (links to VS-27), shipment details (origin/destination, weight/cube, commodity, required pickup/delivery), rate confirmation, and capacity booking; manage accept/decline and fallback to next-preferred carrier
Responsible (R): Logistics / DC / Carrier
Accountable (A): Logistics Manager
Duration: Per shipment</bpmn:documentation>
        <bpmn:incoming>W3501_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3501_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3501_Task5" name="For off-guide, overflow, or peak capacity, Logistics procure spot/spot-quote…">
        <bpmn:documentation>Step 2: For off-guide, overflow, or peak capacity, Logistics procure spot/spot-quote capacity: solicit spot quotes from approved carriers/brokers, evaluate rate/transit, book per authority, and document the spot exception and reason; manage peak-season (Ber-months, typhoon recovery links to VS-69) capacity
Responsible (R): Logistics / Procurement
Accountable (A): Logistics Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3501_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3501_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3501_Task6" name="Logistics confirm booking, dispatch (links to W1165 last-mile/W3505 outbound)…">
        <bpmn:documentation>Step 3: Logistics confirm booking, dispatch (links to W1165 last-mile/W3505 outbound), track the shipment (W3508), and capture the rate basis (contract vs spot) for freight audit (W3513); manage load consolidation (W3507) and tender efficiency
Responsible (R): Logistics / DC
Accountable (A): Logistics Manager
Duration: Per shipment</bpmn:documentation>
        <bpmn:incoming>W3501_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3501_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3501_End7" name="Complete">
        <bpmn:incoming>W3501_Flow13</bpmn:incoming>
      </bpmn:endEvent>
