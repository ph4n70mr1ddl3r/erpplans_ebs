      <bpmn:sequenceFlow id="W4032_Flow12" sourceRef="W4032_Task5" targetRef="W4032_Task6" />
      <bpmn:sequenceFlow id="W4032_Flow13" sourceRef="W4032_Task6" targetRef="W4032_End7" />
    </bpmn:process>
