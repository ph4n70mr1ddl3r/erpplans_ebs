        <bpmn:lane id="W4030_Lane1" name="HR">
        <bpmn:flowNodeRef>W4030_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4030_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4030_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4030_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4030_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4030_Start3" name="Policy; employee question; election cycle">
        <bpmn:outgoing>W4030_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4030_Task4" name="HR/Legal establish employee political-activity governance: employees&#x27; personal…">
        <bpmn:documentation>Step 1: HR/Legal establish employee political-activity governance: employees&#x27; personal right to participate politically on their own time, the prohibition on coercion (no pressure to support candidates/parties/positions), rules on company-time/company-resource political activity, and any lawful time-off for voting/civic duties
Responsible (R): HR / Legal / Labor Relations
Accountable (A): CHRO / VP Legal
Duration: Maintained</bpmn:documentation>
        <bpmn:incoming>W4030_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4030_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4030_Task5" name="HR/Compliance manage company-organized political activity (rare/none by…">
        <bpmn:documentation>Step 2: HR/Compliance manage company-organized political activity (rare/none by default), ensure no BuildRight resources are used for partisan purposes, and address any coercion concerns via speak-up (links to VS-119)
Responsible (R): HR / Compliance
Accountable (A): CHRO
Duration: Maintained + on inquiry</bpmn:documentation>
        <bpmn:incoming>W4030_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4030_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4030_Task6" name="HR/Legal communicate the policy to employees (links to VS-103.1), train…">
        <bpmn:documentation>Step 3: HR/Legal communicate the policy to employees (links to VS-103.1), train managers, and handle questions/incidents (links to VS-119)
Responsible (R): HR / Communications
Accountable (A): CHRO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4030_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4030_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4030_End7" name="Complete">
        <bpmn:incoming>W4030_Flow13</bpmn:incoming>
      </bpmn:endEvent>
