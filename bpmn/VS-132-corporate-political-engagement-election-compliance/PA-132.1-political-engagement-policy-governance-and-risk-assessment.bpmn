      <bpmn:sequenceFlow id="W4027_Flow12" sourceRef="W4027_Task5" targetRef="W4027_Task6" />
      <bpmn:sequenceFlow id="W4027_Flow13" sourceRef="W4027_Task6" targetRef="W4027_Task7" />
      <bpmn:sequenceFlow id="W4027_Flow14" sourceRef="W4027_Task7" targetRef="W4027_End8" />
    </bpmn:process>
