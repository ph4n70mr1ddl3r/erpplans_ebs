      <bpmn:startEvent id="W4031_Start3" name="Engagement of political-affairs consultant/lobbyist; vendor spend; PAC question">
        <bpmn:outgoing>W4031_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4031_Task4" name="Legal/Govt-Affairs govern political-affairs consultants, lobbyists, and…">
        <bpmn:documentation>Step 1: Legal/Govt-Affairs govern political-affairs consultants, lobbyists, and public-affairs vendors: due diligence (links to VS-86 ABC screening), scope/engagement letters, conduct standards (no improper inducements, disclosure), and procurement controls (links to VS-34)
Responsible (R): Legal / Govt Affairs / Procurement
Accountable (A): VP Legal
Duration: Per engagement</bpmn:documentation>
        <bpmn:incoming>W4031_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4031_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4031_Task5" name="Legal/Compliance assess any BuildRight-affiliated political action committee…">
        <bpmn:documentation>Step 2: Legal/Compliance assess any BuildRight-affiliated political action committee (PAC) or employee-funded political fund (generally not applicable / prohibited in the Philippine context), and ensure none is established or operated without Board approval and legal clearance
Responsible (R): Legal / Compliance
Accountable (A): VP Legal / Board
Duration: On question</bpmn:documentation>
        <bpmn:incoming>W4031_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4031_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4031_Task6" name="Legal/Finance manage vendor payments, retain records (links to VS-88), and…">
        <bpmn:documentation>Step 3: Legal/Finance manage vendor payments, retain records (links to VS-88), and disclose (links to W4032) any political-affairs vendor spend
Responsible (R): Legal / Finance / Govt Affairs
Accountable (A): VP Legal
Duration: Per engagement + periodic</bpmn:documentation>
        <bpmn:incoming>W4031_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4031_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4031_End7" name="Complete">
        <bpmn:incoming>W4031_Flow13</bpmn:incoming>
      </bpmn:endEvent>
