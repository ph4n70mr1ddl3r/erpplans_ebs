      <bpmn:sequenceFlow id="W4026_Flow13" sourceRef="W4026_Task6" targetRef="W4026_Task7" />
      <bpmn:sequenceFlow id="W4026_Flow14" sourceRef="W4026_Task7" targetRef="W4026_End8" />
    </bpmn:process>
