    <bpmn:process id="W_W527" name="W527. POS Tax Exemption Processing (Government / PEZA / Institutional)" isExecutable="false">
      <bpmn:documentation>Trigger: Customer presents tax exemption certificate at POS (government agency purchase order, PEZA-registered entity ID, diplomatic exemption letter, BIR tax exemption ruling)
Frequency: Occasional — varies significantly by store location; ~10–20 per store per month for stores near government centers, PEZA zones, or diplomatic areas; ~2–5 for other stores
Volume: ~640–1,450 tax-exempt transactions/month chain-wide (≈30 gov&#x27;t-center stores × 10–20 + ~170 other stores × 2–5)
Owner: Cashier (processing); Store Manager (verification and approval)
Participants: Cashier, Store Manager, Customer, Finance Team (compliance review)
Source: workflow W527 — POS Tax Exemption Processing (Government / PEZA / Institutional)</bpmn:documentation>
      <bpmn:laneSet id="W527_LaneSet6">
        <bpmn:lane id="W527_Lane1" name="Customer">
        <bpmn:flowNodeRef>W527_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W527_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W527_Lane2" name="Cashier">
        <bpmn:flowNodeRef>W527_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W527_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W527_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W527_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W527_Lane4" name="System">
        <bpmn:flowNodeRef>W527_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W527_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W527_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
