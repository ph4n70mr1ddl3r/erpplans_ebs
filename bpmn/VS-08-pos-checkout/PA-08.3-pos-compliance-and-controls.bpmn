        <bpmndi:BPMNShape id="W540_End12_di" bpmnElement="W540_End12"><dc:Bounds x="1680" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W540_Annotation13_di" bpmnElement="W540_Annotation13"><dc:Bounds x="160" y="630" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W540_Flow15_di" bpmnElement="W540_Flow15"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W540_Flow16_di" bpmnElement="W540_Flow16"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W540_Flow17_di" bpmnElement="W540_Flow17"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W540_Flow18_di" bpmnElement="W540_Flow18"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W540_Flow19_di" bpmnElement="W540_Flow19"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W540_Flow20_di" bpmnElement="W540_Flow20"><di:waypoint x="1420" y="335" /><di:waypoint x="1450" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W540_Flow21_di" bpmnElement="W540_Flow21"><di:waypoint x="1630" y="335" /><di:waypoint x="1680" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W540_Assoc14_di" bpmnElement="W540_Assoc14"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W553" name="W553. POS Pricing Error Detection &amp; Immediate Correction at Checkout" isExecutable="false">
      <bpmn:documentation>Trigger: Customer or cashier detects discrepancy between displayed/advertised price and POS-scanned price at checkout
Frequency: ~8,400 price discrepancy events/month (~0.3% of POS transactions)
Volume: Higher during promotional changeover periods (price file updates) and after planogram resets
Owner: Store Manager (immediate resolution); Pricing Manager (root cause correction)
Participants: Cashier (detection), Customer, Store Manager (authorization), Stock Associate (shelf label correction)
Source: workflow W553 — POS Pricing Error Detection &amp; Immediate Correction at Checkout</bpmn:documentation>
      <bpmn:laneSet id="W553_LaneSet4">
        <bpmn:lane id="W553_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W553_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W553_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W553_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W553_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W553_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W553_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W553_Lane3" name="System">
        <bpmn:flowNodeRef>W553_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W553_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W553_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W553_Start5" name="Customer or cashier detects discrepancy between displayed/advertised price and…">
        <bpmn:outgoing>W553_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W553_Task6" name="Price discrepancy detection">
        <bpmn:documentation>Step 1: Price discrepancy detection: at scan, system displays POS price; customer or cashier notices discrepancy with shelf label or advertised price; cashier pauses transaction and calls Store Manager
Responsible (R): Cashier
Accountable (A): —
Duration: 30 sec</bpmn:documentation>
        <bpmn:incoming>W553_Flow15</bpmn:incoming>
        <bpmn:outgoing>W553_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W553_Task7" name="Price verification">
        <bpmn:documentation>Step 2: Price verification: Store Manager verifies correct price by checking: (a) POS system price (from price master W289 — source of truth), (b) shelf label price, (c) promotional signage if applicable, (d) current promotional calendar (W13), (e) DTI price freeze status (W468) if in calamity-declared area; Store Manager determines which price is correct per policy: (a) if POS price is correct and shelf label is wrong → charge POS price, fix label, (b) if shelf label shows lower price (customer was mislead) → honor shelf price per DTI consumer protection (RA 7394), (c) if promotional price should be active but not yet applied → apply promo price immediately and flag price file sync issue
Responsible (R): Store Manager
Accountable (A): —
Duration: 2–3 min</bpmn:documentation>
        <bpmn:incoming>W553_Flow16</bpmn:incoming>
        <bpmn:outgoing>W553_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W553_Task8" name="Immediate price adjustment">
        <bpmn:documentation>Step 3: Immediate price adjustment: Store Manager authorizes price override per POS-006 (price override with authorization); cashier applies corrected price with reason code &quot;PRICE-DISCREPANCY&quot;; system logs: (a) original POS price, (b) corrected price, (c) difference, (d) reason code, (e) authorizer, (f) shelf label or promotional signage reference; transaction continues with corrected price
Responsible (R): Cashier / Store Manager
Accountable (A): Store Manager
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W553_Flow17</bpmn:incoming>
        <bpmn:outgoing>W553_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W553_Task9" name="Shelf label flagging">
        <bpmn:documentation>Step 4: Shelf label flagging: system automatically generates shelf label correction task: (a) item SKU, (b) store location, (c) correct price, (d) discrepancy type (wrong label, missing label, promo not reflected); task assigned to Stock Associate for immediate correction; high-priority items (front-page promo, endcap display) flagged for immediate correction; all corrections completed before next peak shopping period
Responsible (R): System / Stock Associate
Accountable (A): Store Manager
Duration: Stock Associate: 3–5 min per label</bpmn:documentation>
        <bpmn:incoming>W553_Flow18</bpmn:incoming>
        <bpmn:outgoing>W553_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W553_Task10" name="Root cause logging">
        <bpmn:documentation>Step 5: Root cause logging: Store Manager classifies root cause: (a) label not updated after price change (process gap in W40), (b) promotional pricing sync delay (W533 latency), (c) item placed on wrong shelf (W86 planogram issue), (d) DTI price freeze not yet propagated (W468), (e) pricing master error (W289), (f) other; root cause data feeds into weekly price compliance dashboard for W69
Responsible (R): Store Manager / System
Accountable (A): —
Duration: 30 sec</bpmn:documentation>
        <bpmn:incoming>W553_Flow19</bpmn:incoming>
        <bpmn:outgoing>W553_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W553_Task11" name="Batch price verification trigger">
        <bpmn:documentation>Step 6: Batch price verification trigger: if same SKU has &gt; 3 discrepancy events across stores within 24 hours: system triggers enterprise-wide price verification for that SKU; Pricing Manager notified; price file integrity check initiated; if systemic, corrected price pushed to all terminals via POS-047 within 60 seconds
Responsible (R): System / Pricing Manager
Accountable (A): Pricing Manager
Duration: Automated alert + 15–30 min investigation</bpmn:documentation>
        <bpmn:incoming>W553_Flow20</bpmn:incoming>
        <bpmn:outgoing>W553_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W553_End12" name="Complete">
        <bpmn:incoming>W553_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W553_Annotation13">
        <bpmn:text>Controls: - CTL-265 (ensure controlled execution — POS Compliance &amp; Controls (PA-08.3).) | - operational: allowing customer to continue shopping and return, or moving to customer service counter; operational: honoring lower price and immediate shelf correction; operational: mandatory manager authorization and root cause logging with analytics
Owner: Store Manager (immediate resolution); Pricing Manager (root cause correction)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W553_Assoc14" sourceRef="W553_Annotation13" targetRef="W553_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W553_Flow15" sourceRef="W553_Start5" targetRef="W553_Task6" />
