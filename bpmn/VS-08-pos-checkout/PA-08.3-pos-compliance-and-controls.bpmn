      <bpmn:sequenceFlow id="W529_Flow26" sourceRef="W529_Task12" targetRef="W529_Task13" />
      <bpmn:sequenceFlow id="W529_Flow27" sourceRef="W529_Task13" targetRef="W529_Task14" />
      <bpmn:sequenceFlow id="W529_Flow28" sourceRef="W529_Task14" targetRef="W529_Task15" />
      <bpmn:sequenceFlow id="W529_Flow29" sourceRef="W529_Task15" targetRef="W529_End16" />
    </bpmn:process>
