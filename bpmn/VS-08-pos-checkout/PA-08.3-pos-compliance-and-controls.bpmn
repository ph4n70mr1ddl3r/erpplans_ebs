        <bpmn:flowNodeRef>W527_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W527_Start7" name="Customer presents tax exemption certificate at POS (government agency purchase order…">
        <bpmn:outgoing>W527_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W527_Task8" name="Customer presents tax exemption documentation at checkout: government agency…">
        <bpmn:documentation>Step 1: Customer presents tax exemption documentation at checkout: government agency purchase order with VAT exemption certification, PEZA-registered entity ID card, diplomatic exemption letter, or BIR tax exemption ruling with TIN
Responsible (R): Customer
Accountable (A): —
Duration: —</bpmn:documentation>
        <bpmn:incoming>W527_Flow19</bpmn:incoming>
        <bpmn:outgoing>W527_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W527_Task9" name="Cashier identifies customer in system: looks up customer account (if existing…">
        <bpmn:documentation>Step 2: Cashier identifies customer in system: looks up customer account (if existing B2B account per W24) or creates temporary tax-exempt customer record (for one-time government purchases)
Responsible (R): Cashier
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W527_Flow20</bpmn:incoming>
        <bpmn:outgoing>W527_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W527_Task10" name="Store Manager verifies tax exemption documentation: confirms document validity…">
        <bpmn:documentation>Step 3: Store Manager verifies tax exemption documentation: confirms document validity (government letterhead, PEZA registration number, BIR ruling reference), checks expiry (if applicable), verifies customer identity matches document; approves tax exemption in system with manager ID
Responsible (R): Store Manager
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W527_Flow21</bpmn:incoming>
        <bpmn:outgoing>W527_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W527_Task11" name="System applies zero output VAT to the transaction: all eligible items…">
        <bpmn:documentation>Step 4: System applies zero output VAT to the transaction: all eligible items recalculated with 0% VAT (net of VAT from SRP); customer display shows &quot;TAX EXEMPT TRANSACTION&quot; with exemption type; receipt prints tax exemption details (exemption type, certificate/reference number, verifying manager ID)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W527_Flow22</bpmn:incoming>
        <bpmn:outgoing>W527_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W527_Task12" name="System posts transaction to tax-exempt revenue GL account (separate from…">
        <bpmn:documentation>Step 5: System posts transaction to tax-exempt revenue GL account (separate from standard VATable sales); records in tax-exempt transaction register for BIR reporting (W9A.16 VAT return — exempt/zero-rated sales schedule); zero output VAT entry posted alongside standard Dr. Cash / Cr. Revenue
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W527_Flow23</bpmn:incoming>
        <bpmn:outgoing>W527_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W527_Task13" name="If only some items are tax-exempt (partial exemption — e.g., PEZA-registered…">
        <bpmn:documentation>Step 6: If only some items are tax-exempt (partial exemption — e.g., PEZA-registered entity purchasing mixed merchandise where only certain categories qualify): Cashier manually flags exempt items at line level; system applies VAT only to non-exempt items
Responsible (R): Cashier / System
Accountable (A): Store Manager
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W527_Flow24</bpmn:incoming>
        <bpmn:outgoing>W527_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W527_Task14" name="System logs tax exemption transaction: transaction ID, customer account…">
        <bpmn:documentation>Step 7: System logs tax exemption transaction: transaction ID, customer account, exemption type, certificate/reference number, verifying Store Manager ID, total exempt amount, items exempted; log available for Finance Team BIR audit support
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W527_Flow25</bpmn:incoming>
        <bpmn:outgoing>W527_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W527_Task15" name="Monthly: Finance Team reviews tax-exempt transaction register — total exempt…">
        <bpmn:documentation>Step 8: Monthly: Finance Team reviews tax-exempt transaction register — total exempt sales by exemption type, by store, by customer; verifies documentation completeness for all exempt transactions; flags transactions missing documentation for Store Manager follow-up
Responsible (R): Finance Team
Accountable (A): Controller
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W527_Flow26</bpmn:incoming>
        <bpmn:outgoing>W527_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W527_End16" name="Complete">
        <bpmn:incoming>W527_Flow27</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W527_Annotation17">
        <bpmn:text>Controls: - CTL-265 (ensure controlled execution — POS Compliance &amp; Controls (PA-08.3).) | - operational: should maintain whitelist of verified tax-exempt entities from Finance Team
Owner: Cashier (processing); Store Manager (verification and approval)</bpmn:text>
      </bpmn:textAnnotation>
