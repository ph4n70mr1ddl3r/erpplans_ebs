      <bpmn:sequenceFlow id="W529_Flow22" sourceRef="W529_Task8" targetRef="W529_Task9" />
      <bpmn:sequenceFlow id="W529_Flow23" sourceRef="W529_Task9" targetRef="W529_Task10" />
      <bpmn:sequenceFlow id="W529_Flow24" sourceRef="W529_Task10" targetRef="W529_Task11" />
