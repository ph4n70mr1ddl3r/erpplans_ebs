<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-08.3-pos-compliance-and-controls" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W519" name="W519. POS Suspicious Transaction &amp; AML Compliance Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Cash transaction ≥ PHP 500,000 (single or cumulative within 24 hours for same customer) OR system detects suspicious structuring pattern OR cashier/manager identifies suspicious customer behavior
Frequency: Rare — estimated 5–10 flagged transactions per year chain-wide for hardware retail; more likely at stores near construction hubs serving contractors
Volume: ~5–10 suspicious transaction reports (STRs) filed annually with AMLC
Owner: Compliance Officer (filing); Store Manager (initial documentation)
Participants: Cashier, Store Manager, Compliance Officer, AMLC (external)
Source: workflow W519 — POS Suspicious Transaction &amp; AML Compliance Reporting</bpmn:documentation>
      <bpmn:laneSet id="W519_LaneSet5">
        <bpmn:lane id="W519_Lane1" name="System">
        <bpmn:flowNodeRef>W519_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W519_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W519_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W519_Lane2" name="Cashier">
        <bpmn:flowNodeRef>W519_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W519_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W519_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W519_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W519_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W519_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W519_Lane4" name="Compliance Officer">
        <bpmn:flowNodeRef>W519_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W519_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W519_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W519_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W519_End18</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W519_Start6" name="Cash transaction ≥ PHP 500,000 (single or cumulative within 24 hours for same customer)…">
        <bpmn:outgoing>W519_Flow21</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W519_Task7" name="Threshold monitoring">
        <bpmn:documentation>Step 1: Threshold monitoring: system automatically monitors all cash transactions at POS; if single cash transaction ≥ PHP 500,000: system flags transaction and alerts Store Manager via terminal notification; if same customer (identified via loyalty card, name, or vehicle plate) accumulates cash transactions ≥ PHP 500,000 within 24 hours across multiple transactions: system alerts Store Manager with structuring detection alert
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W519_Flow21</bpmn:incoming>
        <bpmn:outgoing>W519_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W519_Task8" name="Transaction hold">
        <bpmn:documentation>Step 2: Transaction hold: for flagged transactions, system allows transaction completion but places cash in temporary hold status; system prompts cashier to collect customer identification (government-issued photo ID) and record customer details (full name, ID type, ID number, address, contact number, nature of transaction/purpose of purchase)
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W519_Flow22</bpmn:incoming>
        <bpmn:outgoing>W519_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W519_Task9" name="Cashier completes customer identification form in system (or system…">
        <bpmn:documentation>Step 3: Cashier completes customer identification form in system (or system auto-populates from loyalty member data if customer is enrolled); if customer refuses to provide identification: Store Manager is notified; transaction is completed but flagged as &quot;Customer Refused ID&quot; — Compliance Officer reviews within 24 hours
Responsible (R): Cashier / Customer
Accountable (A): Store Manager
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W519_Flow23</bpmn:incoming>
        <bpmn:outgoing>W519_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W519_Task10" name="Store Manager reviews flagged transaction details: customer identity…">
        <bpmn:documentation>Step 4: Store Manager reviews flagged transaction details: customer identity, transaction amount, items purchased, payment method, any prior flagged transactions for same customer; Store Manager assesses whether transaction appears legitimate (e.g., contractor bulk-buying materials for a project) or suspicious (e.g., purchasing high-value easily-resalable items with large cash, customer appears nervous or evasive)
Responsible (R): Store Manager
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W519_Flow24</bpmn:incoming>
        <bpmn:outgoing>W519_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W519_Task11" name="legitimate">
        <bpmn:documentation>Step 5: If Store Manager assesses transaction as legitimate: documents assessment with justification (e.g., &quot;Contractor purchasing cement, rebar, and tiles for government project — presented purchase order from agency&quot;); system records legitimacy determination with manager ID; no STR filed; transaction hold released; documentation retained for 5 years per AMLA record retention
Responsible (R): Store Manager
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W519_Flow25</bpmn:incoming>
        <bpmn:outgoing>W519_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W519_Task12" name="suspicious">
        <bpmn:documentation>Step 6: If Store Manager assesses transaction as suspicious or is unsure: Store Manager escalates to Compliance Officer within 24 hours; Compliance Officer reviews transaction details, customer history, and Store Manager&#x27;s assessment
Responsible (R): Store Manager / Compliance Officer
Accountable (A): Compliance Officer
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W519_Flow26</bpmn:incoming>
        <bpmn:outgoing>W519_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W519_Task13" name="Compliance Officer determines if Suspicious Transaction Report (STR) is…">
        <bpmn:documentation>Step 7: Compliance Officer determines if Suspicious Transaction Report (STR) is warranted per AMLC guidelines; if yes: Compliance Officer prepares STR using AMLC online portal with required details (covered person information, customer information, transaction details, suspicious indicators, supporting documents)
Responsible (R): Compliance Officer
Accountable (A): CFO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W519_Flow27</bpmn:incoming>
        <bpmn:outgoing>W519_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W519_Task14" name="Compliance Officer files STR with AMLC via online portal; system logs STR…">
        <bpmn:documentation>Step 8: Compliance Officer files STR with AMLC via online portal; system logs STR filing with AMLC reference number, filing date, and linked POS transaction(s)
Responsible (R): Compliance Officer
Accountable (A): CFO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W519_Flow28</bpmn:incoming>
        <bpmn:outgoing>W519_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W519_Task15" name="Tipping-off prohibition">
        <bpmn:documentation>Step 9: Tipping-off prohibition: system restricts visibility of STR filing — cashier and Store Manager who reported are NOT informed of STR filing status; only Compliance Officer and CFO have access to STR records; per AMLA Section 9, no person shall disclose to any customer that a STR has been or will be filed
Responsible (R): System / Compliance Officer
Accountable (A): CFO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W519_Flow29</bpmn:incoming>
        <bpmn:outgoing>W519_Flow30</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W519_Task16" name="Compliance Officer maintains STR register: all filed STRs with AMLC reference…">
        <bpmn:documentation>Step 10: Compliance Officer maintains STR register: all filed STRs with AMLC reference numbers, filing dates, transaction references, and status; register subject to AMLC examination during periodic compliance audits
Responsible (R): Compliance Officer
Accountable (A): CFO
Duration: Quarterly review</bpmn:documentation>
        <bpmn:incoming>W519_Flow30</bpmn:incoming>
        <bpmn:outgoing>W519_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W519_Task17" name="Annual: Compliance Officer conducts AML awareness training for all Store…">
        <bpmn:documentation>Step 11: Annual: Compliance Officer conducts AML awareness training for all Store Managers and Lead Cashiers (integrated with W51 training program); training covers AMLA requirements, red flags for suspicious transactions, customer identification procedures, tipping-off prohibition, and STR filing process
Responsible (R): Compliance Officer
Accountable (A): CFO
Duration: 2 hours/year</bpmn:documentation>
        <bpmn:incoming>W519_Flow31</bpmn:incoming>
        <bpmn:outgoing>W519_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W519_End18" name="Complete">
        <bpmn:incoming>W519_Flow32</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W519_Annotation19">
        <bpmn:text>Controls: - CTL-265 (ensure controlled execution — POS Compliance &amp; Controls (PA-08.3).)
Owner: Compliance Officer (filing); Store Manager (initial documentation)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W519_Assoc20" sourceRef="W519_Annotation19" targetRef="W519_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W519_Flow21" sourceRef="W519_Start6" targetRef="W519_Task7" />
      <bpmn:sequenceFlow id="W519_Flow22" sourceRef="W519_Task7" targetRef="W519_Task8" />
      <bpmn:sequenceFlow id="W519_Flow23" sourceRef="W519_Task8" targetRef="W519_Task9" />
      <bpmn:sequenceFlow id="W519_Flow24" sourceRef="W519_Task9" targetRef="W519_Task10" />
      <bpmn:sequenceFlow id="W519_Flow25" sourceRef="W519_Task10" targetRef="W519_Task11" />
      <bpmn:sequenceFlow id="W519_Flow26" sourceRef="W519_Task11" targetRef="W519_Task12" />
      <bpmn:sequenceFlow id="W519_Flow27" sourceRef="W519_Task12" targetRef="W519_Task13" />
      <bpmn:sequenceFlow id="W519_Flow28" sourceRef="W519_Task13" targetRef="W519_Task14" />
      <bpmn:sequenceFlow id="W519_Flow29" sourceRef="W519_Task14" targetRef="W519_Task15" />
      <bpmn:sequenceFlow id="W519_Flow30" sourceRef="W519_Task15" targetRef="W519_Task16" />
      <bpmn:sequenceFlow id="W519_Flow31" sourceRef="W519_Task16" targetRef="W519_Task17" />
      <bpmn:sequenceFlow id="W519_Flow32" sourceRef="W519_Task17" targetRef="W519_End18" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W519_diag">
      <bpmndi:BPMNPlane id="W519_plane" bpmnElement="W_W519">
        <bpmndi:BPMNShape id="W519_Lane1_di" bpmnElement="W519_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2630" height="170" /></bpmndi:BPMNShape>
