    <bpmn:process id="W_W747" name="W747. POS Credit Card Installment Selling &amp; 0% Interest Promotion Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer selects big-ticket item and elects to pay via credit card installment (3/6/12/24 months) at POS
Frequency: Daily; ~15–25 installment transactions per store per day
Volume: 200 stores × ~20 installment transactions/day = ~4,000 installment transactions/day chain-wide (~15% of non-cash transactions by value)
Owner: Cashier
Participants: Cashier, Store Manager (override), Bank Partner (real-time), Customer
Source: workflow W747 — POS Credit Card Installment Selling &amp; 0% Interest Promotion Processing</bpmn:documentation>
      <bpmn:laneSet id="W747_LaneSet4">
        <bpmn:lane id="W747_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W747_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W747_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W747_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W747_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W747_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W747_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W747_Lane2" name="System">
        <bpmn:flowNodeRef>W747_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W747_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W747_Lane3" name="Customer">
        <bpmn:flowNodeRef>W747_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W747_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W747_Start5" name="Customer selects big-ticket item and elects to pay via credit card installment (3/6/12/24…">
        <bpmn:outgoing>W747_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W747_Task6" name="Installment eligibility check">
        <bpmn:documentation>Step 1: Installment eligibility check: Customer expresses interest in installment; Cashier scans item and system checks installment eligibility: (a) SKU is on bank installment-eligible list, (b) item price meets minimum threshold (typically PHP 3,000+), (c) at least one active bank promo covers this SKU
Responsible (R): Cashier
Accountable (A): System
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W747_Flow17</bpmn:incoming>
        <bpmn:outgoing>W747_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W747_Task7" name="Bank promo presentation">
        <bpmn:documentation>Step 2: Bank promo presentation: System displays available installment options: bank name, available terms (3/6/12/24 months), monthly amortization, interest rate (0% for promo, regular rate otherwise), and promo validity period
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W747_Flow18</bpmn:incoming>
        <bpmn:outgoing>W747_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W747_Task8" name="Customer term selection">
        <bpmn:documentation>Step 3: Customer term selection: Customer selects preferred bank and installment term; Cashier confirms customer has the corresponding credit card
Responsible (R): Customer
Accountable (A): Cashier
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W747_Flow19</bpmn:incoming>
        <bpmn:outgoing>W747_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W747_Task9" name="Credit card authorization">
        <bpmn:documentation>Step 4: Credit card authorization: Cashier swipes/dips/taps credit card; POS sends installment transaction to bank for real-time authorization (distinct from straight-charge); bank responds with approval/decline and installment confirmation
Responsible (R): Cashier
Accountable (A): Bank
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W747_Flow20</bpmn:incoming>
        <bpmn:outgoing>W747_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W747_Task10" name="Installment transaction completion">
        <bpmn:documentation>Step 5: Installment transaction completion: System records transaction as installment sale with: bank reference, term, monthly amortization, original amount, and interest subsidy (if 0% promo); BIR-compliant receipt printed with installment details
Responsible (R): Cashier
Accountable (A): System
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W747_Flow21</bpmn:incoming>
        <bpmn:outgoing>W747_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W747_Task11" name="Interest subsidy tracking">
        <bpmn:documentation>Step 6: Interest subsidy tracking: For 0% promos, system records merchant interest subsidy amount (paid by BuildRight to bank); Finance reconciles subsidy deductions from bank settlement (W750)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W747_Flow22</bpmn:incoming>
        <bpmn:outgoing>W747_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W747_Task12" name="Customer installment disclosure">
        <bpmn:documentation>Step 7: Customer installment disclosure: Customer receives printed installment schedule with: total amount, monthly payment, number of months, first billing date, and cancellation policy
Responsible (R): Cashier
Accountable (A): —
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W747_Flow23</bpmn:incoming>
        <bpmn:outgoing>W747_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W747_Task13" name="Exception handling">
        <bpmn:documentation>Step 8: Exception handling: If bank declines: offer alternative bank promo, straight-charge, or layaway (W75); if SKU not eligible: suggest eligible alternative or straight-charge
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W747_Flow24</bpmn:incoming>
        <bpmn:outgoing>W747_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W747_End14" name="Complete">
        <bpmn:incoming>W747_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W747_Annotation15">
        <bpmn:text>Controls: - CTL-263 (ensure controlled execution — Transaction Processing (PA-08.1).) | - operational: downtime — if bank installment API is unavailable, customers cannot complete installment purchases
Owner: Cashier</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W747_Assoc16" sourceRef="W747_Annotation15" targetRef="W747_Start5" associationDirection="None" />
