<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-08.1-transaction-processing" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W206" name="W206. Mobile POS (mPOS) &amp; Queue-Busting Operations" isExecutable="false">
      <bpmn:documentation>Trigger: High foot traffic / long queues at main checkout; or customer needing checkout in Yard/Materials area
Frequency: Peak hours (weekends, holidays); and for bulky outdoor sales
Volume: ~5–10% of total store transactions
Owner: Store Manager
Participants: Sales Associate (mPOS Operator), Cashier (for cash handling if needed), Customer
Source: workflow W206 — Mobile POS (mPOS) &amp; Queue-Busting Operations</bpmn:documentation>
      <bpmn:laneSet id="W206_LaneSet4">
        <bpmn:lane id="W206_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W206_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W206_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W206_Lane2" name="Associate">
        <bpmn:flowNodeRef>W206_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W206_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W206_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W206_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W206_Lane3" name="System">
        <bpmn:flowNodeRef>W206_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W206_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W206_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W206_Start5" name="High foot traffic / long queues at main checkout; or customer needing checkout in…">
        <bpmn:outgoing>W206_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W206_Task6" name="Deployment">
        <bpmn:documentation>Step 1: Deployment: Store Manager monitors queues; dispatches Sales Associates with tablets/mPOS devices to the floor
Responsible (R): Store Manager
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W206_Flow16</bpmn:incoming>
        <bpmn:outgoing>W206_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W206_Task7" name="Scanning">
        <bpmn:documentation>Step 2: Scanning: Associate scans items in customer&#x27;s cart or in the Yard area; system applies real-time pricing and promos
Responsible (R): Associate
Accountable (A): —
Duration: 3–5 min</bpmn:documentation>
        <bpmn:incoming>W206_Flow17</bpmn:incoming>
        <bpmn:outgoing>W206_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W206_Task8" name="Customer Lookup">
        <bpmn:documentation>Step 3: Customer Lookup: Associate scans Loyalty Card or looks up customer via phone/email (W17)
Responsible (R): Associate
Accountable (A): —
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W206_Flow18</bpmn:incoming>
        <bpmn:outgoing>W206_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W206_Task9" name="Tendering">
        <bpmn:documentation>Step 4: Tendering: (a) If Card/E-wallet: Associate processes payment on the mPOS device; (b) If Cash: Associate generates &quot;Pre-order Barcode&quot; and directs customer to &quot;Express Cash&quot; lane
Responsible (R): Associate
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W206_Flow19</bpmn:incoming>
        <bpmn:outgoing>W206_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W206_Task10" name="Receipt">
        <bpmn:documentation>Step 5: Receipt: System generates Digital Receipt (Email/SMS) or prints via Bluetooth belt printer
Responsible (R): System
Accountable (A): —
Duration: 30 sec</bpmn:documentation>
        <bpmn:incoming>W206_Flow20</bpmn:incoming>
        <bpmn:outgoing>W206_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W206_Task11" name="Fulfillment">
        <bpmn:documentation>Step 6: Fulfillment: If items are in Yard: Associate marks items as &quot;Released&quot; in system; guard verifies digital receipt at gate
Responsible (R): Associate
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W206_Flow21</bpmn:incoming>
        <bpmn:outgoing>W206_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W206_Task12" name="Sync">
        <bpmn:documentation>Step 7: Sync: Transactions sync instantly with central ERP inventory and Finance; no manual EOD re-entry required
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W206_Flow22</bpmn:incoming>
        <bpmn:outgoing>W206_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W206_End13" name="Complete">
        <bpmn:incoming>W206_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W206_Annotation14">
        <bpmn:text>Controls: - CTL-263 (ensure controlled execution — Transaction Processing (PA-08.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W206_Assoc15" sourceRef="W206_Annotation14" targetRef="W206_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W206_Flow16" sourceRef="W206_Start5" targetRef="W206_Task6" />
      <bpmn:sequenceFlow id="W206_Flow17" sourceRef="W206_Task6" targetRef="W206_Task7" />
      <bpmn:sequenceFlow id="W206_Flow18" sourceRef="W206_Task7" targetRef="W206_Task8" />
      <bpmn:sequenceFlow id="W206_Flow19" sourceRef="W206_Task8" targetRef="W206_Task9" />
      <bpmn:sequenceFlow id="W206_Flow20" sourceRef="W206_Task9" targetRef="W206_Task10" />
      <bpmn:sequenceFlow id="W206_Flow21" sourceRef="W206_Task10" targetRef="W206_Task11" />
      <bpmn:sequenceFlow id="W206_Flow22" sourceRef="W206_Task11" targetRef="W206_Task12" />
      <bpmn:sequenceFlow id="W206_Flow23" sourceRef="W206_Task12" targetRef="W206_End13" />
    </bpmn:process>
