      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W935" name="W935. Customer Product Registration at POS for Vendor Extended Warranty" isExecutable="false">
      <bpmn:documentation>Trigger: Customer purchases a warranty-eligible product (power tools, appliances, electrical equipment) at POS and opts for product registration
Frequency: ~8,000–12,000 eligible transactions/month chain-wide; ~60% opt-in rate; ~5,000–7,000 registrations/month
Volume: Warranty-eligible categories: power tools (~1,750 SKUs), home appliances (~1,750 SKUs), select electrical equipment (~500 SKUs); registration includes customer details, purchase date, serial number, and vendor warranty terms
Owner: Cashier (at POS) / Customer (self-service via app)
Participants: Cashier, Customer, Warranty Claims Team, Vendor
Source: workflow W935 — Customer Product Registration at POS for Vendor Extended Warranty</bpmn:documentation>
      <bpmn:laneSet id="W935_LaneSet5">
        <bpmn:lane id="W935_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W935_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W935_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W935_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W935_Lane2" name="Customer">
        <bpmn:flowNodeRef>W935_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W935_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W935_Lane3" name="System">
        <bpmn:flowNodeRef>W935_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W935_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W935_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W935_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W935_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W935_Lane4" name="Warranty Claims Team">
        <bpmn:flowNodeRef>W935_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W935_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W935_End18</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W935_Start6" name="Customer purchases a warranty-eligible product (power tools, appliances, electrical…">
        <bpmn:outgoing>W935_Flow21</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W935_Task7" name="Cashier scans warranty-eligible product at POS; system identifies item as…">
        <bpmn:documentation>Step 1: Cashier scans warranty-eligible product at POS; system identifies item as warranty-eligible via item master flag (warranty registration required = Yes/No); system prompts cashier: &quot;Warranty Registration — Scan serial number or skip&quot;
Responsible (R): Cashier / System
Accountable (A): Store Manager
Duration: 30 sec</bpmn:documentation>
        <bpmn:incoming>W935_Flow21</bpmn:incoming>
        <bpmn:outgoing>W935_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W935_Task8" name="If product has a serial number: cashier scans serial number barcode on product…">
        <bpmn:documentation>Step 2: If product has a serial number: cashier scans serial number barcode on product packaging or manually enters serial number; system validates serial number format per vendor-specific patterns stored in item master (e.g., DeWalt: 12-digit alphanumeric, Bosch: 10-digit numeric); if invalid format, cashier re-prompts customer
Responsible (R): Cashier
Accountable (A): —
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W935_Flow22</bpmn:incoming>
        <bpmn:outgoing>W935_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W935_Task9" name="Customer-facing display shows warranty registration prompt: &quot;Register for…">
        <bpmn:documentation>Step 3: Customer-facing display shows warranty registration prompt: &quot;Register for manufacturer warranty? Benefits: extended coverage, repair tracking, recall notifications&quot;; customer selects Register or Skip; if Register: display shows privacy notice per RA 10173 with consent checkbox (data shared with manufacturer for warranty purposes)
Responsible (R): Customer
Accountable (A): —
Duration: 30 sec</bpmn:documentation>
        <bpmn:incoming>W935_Flow23</bpmn:incoming>
        <bpmn:outgoing>W935_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W935_Task10" name="If customer registers and is a loyalty member: system auto-fills customer name…">
        <bpmn:documentation>Step 4: If customer registers and is a loyalty member: system auto-fills customer name, email, phone, and address from loyalty profile; customer confirms or updates on customer-facing display; if guest: customer enters name, email, and phone on customer-facing display
Responsible (R): Customer
Accountable (A): —
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W935_Flow24</bpmn:incoming>
        <bpmn:outgoing>W935_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W935_Task11" name="System creates warranty registration record: registration ID, customer details…">
        <bpmn:documentation>Step 5: System creates warranty registration record: registration ID, customer details, product SKU, serial number, purchase date, purchase receipt number, vendor ID, vendor warranty terms (months, coverage type) from item master; registration record linked to original POS transaction for warranty claim verification (W33)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W935_Flow25</bpmn:incoming>
        <bpmn:outgoing>W935_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W935_Task12" name="System transmits registration to vendor via vendor API integration (for…">
        <bpmn:documentation>Step 6: System transmits registration to vendor via vendor API integration (for connected vendors) or queues for batch email/file transmission (for non-connected vendors); transmission includes customer details, product serial number, purchase date, and retailer reference number
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W935_Flow26</bpmn:incoming>
        <bpmn:outgoing>W935_Flow27</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W935_Task13" name="Customer receives warranty confirmation via email/SMS within 24 hours: product…">
        <bpmn:documentation>Step 7: Customer receives warranty confirmation via email/SMS within 24 hours: product name, serial number, warranty period (start and end date), coverage summary, claim instructions, and BuildRight warranty claim link; registration stored in customer&#x27;s loyalty profile for future access
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W935_Flow27</bpmn:incoming>
        <bpmn:outgoing>W935_Flow28</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W935_Task14" name="System stores registration in digital warranty vault per customer per W911…">
        <bpmn:documentation>Step 8: System stores registration in digital warranty vault per customer per W911; customer can view all registered products and warranty statuses via BuildRight mobile app; system sends warranty expiry reminder notification at T-30 days and T-7 days before warranty expiration
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W935_Flow28</bpmn:incoming>
        <bpmn:outgoing>W935_Flow29</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W935_Task15" name="For loyalty members: system awards bonus loyalty points for product…">
        <bpmn:documentation>Step 9: For loyalty members: system awards bonus loyalty points for product registration (configurable, default: 50 points per registration); points posted immediately as part of the transaction
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W935_Flow29</bpmn:incoming>
        <bpmn:outgoing>W935_Flow30</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W935_Task16" name="Weekly: Warranty Claims Team reviews registration transmission queue — vendor…">
        <bpmn:documentation>Step 10: Weekly: Warranty Claims Team reviews registration transmission queue — vendor API failures, bounced emails, incomplete registrations; resolves exceptions and resubmits within 3 business days
Responsible (R): Warranty Claims Team
Accountable (A): CS Manager
Duration: 2 hours/week</bpmn:documentation>
        <bpmn:incoming>W935_Flow30</bpmn:incoming>
        <bpmn:outgoing>W935_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W935_Task17" name="Monthly: Warranty Claims Team generates registration analytics — registration…">
        <bpmn:documentation>Step 11: Monthly: Warranty Claims Team generates registration analytics — registration rate by category, vendor API success rate, customer opt-in rate, serial number capture rate, bonus points liability; shares with Category Managers for vendor warranty program discussions
Responsible (R): Warranty Claims Team
Accountable (A): VP Merchandising
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W935_Flow31</bpmn:incoming>
        <bpmn:outgoing>W935_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W935_End18" name="Complete">
        <bpmn:incoming>W935_Flow32</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W935_Annotation19">
        <bpmn:text>Controls: - CTL-263 (ensure controlled execution — Transaction Processing (PA-08.1).) | - operational: validation per vendor format catches some but not all errors
Owner: Cashier (at POS) / Customer (self-service via app)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W935_Assoc20" sourceRef="W935_Annotation19" targetRef="W935_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W935_Flow21" sourceRef="W935_Start6" targetRef="W935_Task7" />
      <bpmn:sequenceFlow id="W935_Flow22" sourceRef="W935_Task7" targetRef="W935_Task8" />
      <bpmn:sequenceFlow id="W935_Flow23" sourceRef="W935_Task8" targetRef="W935_Task9" />
      <bpmn:sequenceFlow id="W935_Flow24" sourceRef="W935_Task9" targetRef="W935_Task10" />
      <bpmn:sequenceFlow id="W935_Flow25" sourceRef="W935_Task10" targetRef="W935_Task11" />
      <bpmn:sequenceFlow id="W935_Flow26" sourceRef="W935_Task11" targetRef="W935_Task12" />
      <bpmn:sequenceFlow id="W935_Flow27" sourceRef="W935_Task12" targetRef="W935_Task13" />
      <bpmn:sequenceFlow id="W935_Flow28" sourceRef="W935_Task13" targetRef="W935_Task14" />
      <bpmn:sequenceFlow id="W935_Flow29" sourceRef="W935_Task14" targetRef="W935_Task15" />
      <bpmn:sequenceFlow id="W935_Flow30" sourceRef="W935_Task15" targetRef="W935_Task16" />
      <bpmn:sequenceFlow id="W935_Flow31" sourceRef="W935_Task16" targetRef="W935_Task17" />
      <bpmn:sequenceFlow id="W935_Flow32" sourceRef="W935_Task17" targetRef="W935_End18" />
    </bpmn:process>
