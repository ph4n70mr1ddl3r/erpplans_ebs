        <bpmndi:BPMNEdge id="W544_Flow21_di" bpmnElement="W544_Flow21"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W544_Flow22_di" bpmnElement="W544_Flow22"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
