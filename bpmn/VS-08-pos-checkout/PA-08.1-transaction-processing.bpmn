    <bpmn:process id="W_W272" name="W272. Cashier Over/Short Dispute &amp; Deduction Resolution" isExecutable="false">
      <bpmn:documentation>Trigger: End-of-day cash count reveals a variance (shortage or overage) beyond the allowable threshold.
Frequency: Daily
Volume: Varies (1-5 per store per week)
Owner: Store Manager
Participants: Cashier, Store Cashier Supervisor, HR, Finance
Source: workflow W272 — Cashier Over/Short Dispute &amp; Deduction Resolution</bpmn:documentation>
      <bpmn:laneSet id="W272_LaneSet6">
        <bpmn:lane id="W272_Lane1" name="System">
        <bpmn:flowNodeRef>W272_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W272_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W272_Lane2" name="Cashier">
        <bpmn:flowNodeRef>W272_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W272_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W272_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W272_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W272_Lane4" name="HR Manager">
        <bpmn:flowNodeRef>W272_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W272_Lane5" name="Payroll Officer">
        <bpmn:flowNodeRef>W272_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W272_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W272_Start7" name="End-of-day cash count reveals a variance (shortage or overage) beyond the allowable…">
        <bpmn:outgoing>W272_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W272_Task8" name="System flags variance during W5F (Store Closing): Z-report shows cash count vs…">
        <bpmn:documentation>Step 1: System flags variance during W5F (Store Closing): Z-report shows cash count vs. system total differ by &gt; PHP 200
Responsible (R): System
Accountable (A): Cashier Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W272_Flow17</bpmn:incoming>
        <bpmn:outgoing>W272_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W272_Task9" name="Cashier and Supervisor recount the till together; both sign a variance incident…">
        <bpmn:documentation>Step 2: Cashier and Supervisor recount the till together; both sign a variance incident report with count details
Responsible (R): Cashier / Supervisor
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W272_Flow18</bpmn:incoming>
        <bpmn:outgoing>W272_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W272_Task10" name="Store Manager reviews CCTV footage, POS transaction log, and void/refund…">
        <bpmn:documentation>Step 3: Store Manager reviews CCTV footage, POS transaction log, and void/refund history (W37) for the cashier&#x27;s shift
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W272_Flow19</bpmn:incoming>
        <bpmn:outgoing>W272_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W272_Task11" name="If shortage is confirmed due to cashier error (not system or customer cause)…">
        <bpmn:documentation>Step 4: If shortage is confirmed due to cashier error (not system or customer cause), Store Manager routes incident to HR with supporting evidence
Responsible (R): Store Manager
Accountable (A): HR Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W272_Flow20</bpmn:incoming>
        <bpmn:outgoing>W272_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W272_Task12" name="HR generates salary deduction authorization per PH Labor Code Art. 113 (written…">
        <bpmn:documentation>Step 5: HR generates salary deduction authorization per PH Labor Code Art. 113 (written authorization required; deduction limited to the actual loss and must not bring wages below the minimum wage); cashier signs
Responsible (R): HR Manager
Accountable (A): Store Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W272_Flow21</bpmn:incoming>
        <bpmn:outgoing>W272_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W272_Task13" name="Payroll deducts approved amount from next semi-monthly run; Finance reconciles…">
        <bpmn:documentation>Step 6: Payroll deducts approved amount from next semi-monthly run; Finance reconciles cash clearing account (W10)
Responsible (R): Payroll Officer
Accountable (A): Finance Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W272_Flow22</bpmn:incoming>
        <bpmn:outgoing>W272_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W272_End14" name="Complete">
        <bpmn:incoming>W272_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W272_Annotation15">
        <bpmn:text>Controls: - CTL-184 (ensure POS settlement &amp; tender reconciliation completeness.) | - operational: Store Manager review and approval gate; operational: periodic reconciliation against source documents
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
