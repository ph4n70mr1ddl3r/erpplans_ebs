      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W749" name="W749. POS Heavy Equipment &amp; Power Tool Safety Acknowledgment &amp; Release Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer purchases high-risk equipment (chainsaws, circular saws, angle grinders, jackhammers, generators, welding equipment, pressure washers)
Frequency: Daily; ~5–10 transactions per store per day
Volume: 200 stores × ~7 high-risk equipment sales/day = ~1,400 safety acknowledgment transactions/day chain-wide
Owner: Cashier / Department Supervisor
Participants: Cashier, Department Supervisor, Customer
Source: workflow W749 — POS Heavy Equipment &amp; Power Tool Safety Acknowledgment &amp; Release Processing</bpmn:documentation>
      <bpmn:laneSet id="W749_LaneSet4">
        <bpmn:lane id="W749_Lane1" name="System">
        <bpmn:flowNodeRef>W749_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W749_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W749_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W749_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W749_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W749_Lane2" name="Cashier">
        <bpmn:flowNodeRef>W749_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W749_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W749_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W749_Lane3" name="Customer">
        <bpmn:flowNodeRef>W749_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W749_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W749_Start5" name="Customer purchases high-risk equipment (chainsaws, circular saws, angle grinders…">
        <bpmn:outgoing>W749_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W749_Task6" name="High-risk item detection">
        <bpmn:documentation>Step 1: High-risk item detection: System flags scanned item as high-risk based on item master safety classification (W252); POS prompts safety acknowledgment workflow
Responsible (R): System
Accountable (A): —
Duration: Instant</bpmn:documentation>
        <bpmn:incoming>W749_Flow17</bpmn:incoming>
        <bpmn:outgoing>W749_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W749_Task7" name="Safety brief display">
        <bpmn:documentation>Step 2: Safety brief display: Customer-facing screen displays safety brief: equipment hazards, required PPE, proper operation summary, and emergency procedures; printed safety data sheet (W698 SDS) attached to receipt
Responsible (R): System
Accountable (A): Cashier
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W749_Flow18</bpmn:incoming>
        <bpmn:outgoing>W749_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W749_Task8" name="Verbal safety confirmation">
        <bpmn:documentation>Step 3: Verbal safety confirmation: Cashier verbally confirms customer has read and understood safety brief; asks if customer has questions about safe operation
Responsible (R): Cashier
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W749_Flow19</bpmn:incoming>
        <bpmn:outgoing>W749_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W749_Task9" name="PPE suggestion">
        <bpmn:documentation>Step 4: PPE suggestion: System suggests required PPE for purchased equipment (safety goggles for grinder, ear protection for jackhammer, gloves for chainsaw); Cashier offers PPE add-to-basket
Responsible (R): System
Accountable (A): Cashier
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W749_Flow20</bpmn:incoming>
        <bpmn:outgoing>W749_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W749_Task10" name="Customer acknowledgment signature">
        <bpmn:documentation>Step 5: Customer acknowledgment signature: Customer signs digital safety acknowledgment on customer-facing screen or printed form; acknowledges receipt of safety information and assumption of personal responsibility
Responsible (R): Customer
Accountable (A): Cashier
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W749_Flow21</bpmn:incoming>
        <bpmn:outgoing>W749_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W749_Task11" name="ID verification for restricted items">
        <bpmn:documentation>Step 6: ID verification for restricted items: For items with age restrictions (FPA-regulated chemicals in equipment, cutting tools per W520): Cashier verifies customer ID and age
Responsible (R): Cashier
Accountable (A): —
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W749_Flow22</bpmn:incoming>
        <bpmn:outgoing>W749_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W749_Task12" name="Documentation archival">
        <bpmn:documentation>Step 7: Documentation archival: System archives signed safety acknowledgment with transaction record; 10-year retention per W256 document retention policy; accessible for W285 public liability claims
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W749_Flow23</bpmn:incoming>
        <bpmn:outgoing>W749_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W749_Task13" name="Exception handling">
        <bpmn:documentation>Step 8: Exception handling: If customer refuses to sign acknowledgment: Cashier explains requirement; Store Manager may override with documented reason; refusal flagged in LP system (W37)
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W749_Flow24</bpmn:incoming>
        <bpmn:outgoing>W749_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W749_End14" name="Complete">
        <bpmn:incoming>W749_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W749_Annotation15">
        <bpmn:text>Controls: - CTL-263 (ensure controlled execution — Transaction Processing (PA-08.1).) | - operational: safety gear, exposing BuildRight to negligence claims if injury occurs
Owner: Cashier / Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W749_Assoc16" sourceRef="W749_Annotation15" targetRef="W749_Start5" associationDirection="None" />
