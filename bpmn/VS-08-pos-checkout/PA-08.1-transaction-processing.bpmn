      <bpmn:sequenceFlow id="W749_Flow19" sourceRef="W749_Task7" targetRef="W749_Task8" />
      <bpmn:sequenceFlow id="W749_Flow20" sourceRef="W749_Task8" targetRef="W749_Task9" />
      <bpmn:sequenceFlow id="W749_Flow21" sourceRef="W749_Task9" targetRef="W749_Task10" />
      <bpmn:sequenceFlow id="W749_Flow22" sourceRef="W749_Task10" targetRef="W749_Task11" />
      <bpmn:sequenceFlow id="W749_Flow23" sourceRef="W749_Task11" targetRef="W749_Task12" />
      <bpmn:sequenceFlow id="W749_Flow24" sourceRef="W749_Task12" targetRef="W749_Task13" />
      <bpmn:sequenceFlow id="W749_Flow25" sourceRef="W749_Task13" targetRef="W749_End14" />
    </bpmn:process>
