        <bpmndi:BPMNEdge id="W533_Assoc16_di" bpmnElement="W533_Assoc16"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W534" name="W534. Multi-Origin / Mixed-Basket Fulfillment Orchestration" isExecutable="false">
      <bpmn:documentation>Trigger: Customer at POS (or online) places an order containing items fulfilled from multiple origins
Frequency: ~0.1–0.2% of in-store transactions and ~7–12% of ecommerce orders involve multi-origin fulfillment; ~3,000–5,000 in-store mixed-basket orders/month (0.1–0.2% of 2.8M POS); ecommerce adds ~3,000–5,100 multi-origin orders per W534/W2287 (~15–25 per store per month)
Volume: Average 2–3 fulfillment origins per mixed-basket order
Owner: Sales Associate (in-store intake); Unified Order Management engine (routing); DC Dispatch / Store Manager (fulfillment execution)
Participants: Sales Associate, Cashier, Customer, Unified Order Management engine, Stock Associate (store pick), DC Picker (DC pick), Drop-Ship Vendor, 3PL Carrier
Source: workflow W534 — Multi-Origin / Mixed-Basket Fulfillment Orchestration</bpmn:documentation>
      <bpmn:laneSet id="W534_LaneSet6">
        <bpmn:lane id="W534_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W534_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W534_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W534_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W534_Lane2" name="System">
        <bpmn:flowNodeRef>W534_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W534_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W534_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W534_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W534_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W534_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W534_Task19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W534_Task20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W534_Task21</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W534_Lane3" name="Cashier">
        <bpmn:flowNodeRef>W534_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W534_Lane4" name="Customer">
        <bpmn:flowNodeRef>W534_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W534_Lane5" name="CSR">
        <bpmn:flowNodeRef>W534_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W534_End22</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W534_Start7" name="Customer at POS (or online) places an order containing items fulfilled from multiple…">
        <bpmn:outgoing>W534_Flow25</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W534_Task8" name="Customer selects items in store; some items are in stock on shelf (immediate…">
        <bpmn:documentation>Step 1: Customer selects items in store; some items are in stock on shelf (immediate pickup), some items are not in stock at this store but available at DC or another store, some items are special-order/drop-ship only; Sales Associate uses &quot;Endless Aisle&quot; terminal or POS to check availability across all fulfillment sources
Responsible (R): Sales Associate
Accountable (A): Dept. Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W534_Flow25</bpmn:incoming>
        <bpmn:outgoing>W534_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W534_Task9" name="Sales Associate creates unified order at POS: scans items customer is taking…">
        <bpmn:documentation>Step 2: Sales Associate creates unified order at POS: scans items customer is taking now (in-store fulfillment), selects items for home delivery from DC (per W19), selects items for inter-store transfer (per W22), selects items for drop-ship from vendor (per W246); system shows estimated availability date per fulfillment source
Responsible (R): Sales Associate / Cashier
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W534_Flow26</bpmn:incoming>
        <bpmn:outgoing>W534_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W534_Task10" name="System creates unified sales order in ERP with line items tagged by fulfillment…">
        <bpmn:documentation>Step 3: System creates unified sales order in ERP with line items tagged by fulfillment origin: (a) each origin generates a separate fulfillment order (store pick, DC pick, vendor ship) linked to the parent sales order; (b) financial posting is unified at the sales order level (single revenue recognition, single VAT computation, single loyalty points calculation); (c) fulfillment execution is separate per origin with independent tracking
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W534_Flow27</bpmn:incoming>
        <bpmn:outgoing>W534_Flow28</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W534_Task11" name="System checks ATP per fulfillment origin: store-level ATP for in-store items…">
        <bpmn:documentation>Step 4: System checks ATP per fulfillment origin: store-level ATP for in-store items, DC ATP for delivery items, vendor ATP (if available) for drop-ship items; if ATP unavailable for any line: system offers substitution (W98.1), backorder (W56), or cancellation
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W534_Flow28</bpmn:incoming>
        <bpmn:outgoing>W534_Flow29</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W534_Task12" name="Customer pays for all items at POS (in-store + delivery items + special orders)…">
        <bpmn:documentation>Step 5: Customer pays for all items at POS (in-store + delivery items + special orders) as a single transaction; multi-tender supported per POS-004; delivery fees calculated per delivery origin (separate fee per delivery shipment); system collects payment for full order amount
Responsible (R): Cashier / Customer
Accountable (A): Store Manager
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W534_Flow29</bpmn:incoming>
        <bpmn:outgoing>W534_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W534_Task13" name="System prints unified receipt listing all items with per-item fulfillment…">
        <bpmn:documentation>Step 6: System prints unified receipt listing all items with per-item fulfillment origin and estimated availability: &quot;Item A — carry out today&quot;, &quot;Item B — delivery from DC, ETA 3–5 business days&quot;, &quot;Item C — special order from vendor, ETA 7–10 business days&quot;; customer receives tracking link for delivery items via SMS/email
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W534_Flow30</bpmn:incoming>
        <bpmn:outgoing>W534_Flow31</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W534_Task14" name="In-store items">
        <bpmn:documentation>Step 7: In-store items: customer carries out immediately; inventory deducted at sale per W533 continuous sync
Responsible (R): Customer
Accountable (A): —
Duration: Immediate</bpmn:documentation>
        <bpmn:incoming>W534_Flow31</bpmn:incoming>
        <bpmn:outgoing>W534_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W534_Task15" name="DC delivery items">
        <bpmn:documentation>Step 8: DC delivery items: system routes delivery order to nearest DC with ATP per W19; DC picks, packs, and ships per standard W19 process; customer receives per-item tracking notification
Responsible (R): System / DC
Accountable (A): DC Supervisor
Duration: Per W19 SLA</bpmn:documentation>
        <bpmn:incoming>W534_Flow32</bpmn:incoming>
        <bpmn:outgoing>W534_Flow33</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W534_Task16" name="Inter-store transfer items">
        <bpmn:documentation>Step 9: Inter-store transfer items: system creates inter-store transfer order per W22; Stock Associate at source store picks and stages for next scheduled inter-store transfer; customer picks up at originating store when available
Responsible (R): System / Stock Associate
Accountable (A): Store Manager
Duration: 2–5 days</bpmn:documentation>
        <bpmn:incoming>W534_Flow33</bpmn:incoming>
        <bpmn:outgoing>W534_Flow34</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W534_Task17" name="Drop-ship vendor items">
        <bpmn:documentation>Step 10: Drop-ship vendor items: system creates back-to-back PO per W246; vendor ships directly to customer or store; customer notified per W246 tracking
Responsible (R): System / Vendor
Accountable (A): Ecommerce Mgr
Duration: 3–7 days</bpmn:documentation>
        <bpmn:incoming>W534_Flow34</bpmn:incoming>
        <bpmn:outgoing>W534_Flow35</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W534_Task18" name="Return handling for mixed-basket orders">
        <bpmn:documentation>Step 11: Return handling for mixed-basket orders: customer may return any item from any origin to any BuildRight store per W12; system identifies original fulfillment origin and routes inventory return to appropriate location; refund processed per standard W101 regardless of original fulfillment source
Responsible (R): CSR / System
Accountable (A): Store Manager
Duration: Per W12</bpmn:documentation>
        <bpmn:incoming>W534_Flow35</bpmn:incoming>
        <bpmn:outgoing>W534_Flow36</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W534_Task19" name="Customer places order on website/app containing items stocked at different…">
        <bpmn:documentation>Step 12: Customer places order on website/app containing items stocked at different locations; system evaluates fulfillment options per W536 unified order management: (a) single-location fulfillment preferred (ship all from one DC), (b) split fulfillment if no single location has ATP for all items, (c) ship-from-store (W19B) if DC out of stock but nearby store has ATP, (d) drop-ship (W246) for vendor-direct items, (e) BOPIS (W11) for store-pickup eligible items
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W534_Flow36</bpmn:incoming>
        <bpmn:outgoing>W534_Flow37</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W534_Task20" name="System creates unified sales order with per-line fulfillment routing; customer…">
        <bpmn:documentation>Step 13: System creates unified sales order with per-line fulfillment routing; customer sees single order confirmation with per-item delivery estimates and tracking
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W534_Flow37</bpmn:incoming>
        <bpmn:outgoing>W534_Flow38</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W534_Task21" name="Each fulfillment origin executes independently per its standard workflow (W11…">
        <bpmn:documentation>Step 14: Each fulfillment origin executes independently per its standard workflow (W11, W19, W19B, W246); unified order management tracks overall order completion
Responsible (R): System
Accountable (A): —
Duration: Per origin workflow</bpmn:documentation>
        <bpmn:incoming>W534_Flow38</bpmn:incoming>
        <bpmn:outgoing>W534_Flow39</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W534_End22" name="Complete">
        <bpmn:incoming>W534_Flow39</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W534_Annotation23">
        <bpmn:text>Controls: - CTL-263 (ensure controlled execution — Transaction Processing (PA-08.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Sales Associate (in-store intake); Unified Order Management engine (routing); DC Dispatch / Store Manager (fulfillment execution)</bpmn:text>
      </bpmn:textAnnotation>
