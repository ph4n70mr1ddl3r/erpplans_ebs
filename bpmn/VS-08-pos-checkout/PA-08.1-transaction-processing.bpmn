        <bpmn:flowNodeRef>W523_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W523_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W523_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W523_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W523_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W523_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W523_Lane3" name="System">
        <bpmn:flowNodeRef>W523_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W523_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W523_Start5" name="New promotion launching (promo start date = tomorrow or today); Store Manager or Lead…">
        <bpmn:outgoing>W523_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W523_Task6" name="Lead Cashier receives promotional setup notification from Merchandising…">
        <bpmn:documentation>Step 1: Lead Cashier receives promotional setup notification from Merchandising Coordinator: promotion name, start/end dates, participating SKUs, promotional pricing, promo type (discount %, buy-one-take-one, bundle deal, gift-with-purchase, bank-BIN promo), and promotional barcode numbers (if applicable)
Responsible (R): Lead Cashier
Accountable (A): —
Duration: 5 min (read brief)</bpmn:documentation>
        <bpmn:incoming>W523_Flow19</bpmn:incoming>
        <bpmn:outgoing>W523_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W523_Task7" name="Lead Cashier opens POS terminal promotional preview mode: system displays list…">
        <bpmn:documentation>Step 2: Lead Cashier opens POS terminal promotional preview mode: system displays list of upcoming promotions loaded for this terminal with effective prices per SKU
Responsible (R): Lead Cashier
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W523_Flow20</bpmn:incoming>
        <bpmn:outgoing>W523_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W523_Task8" name="Test scan verification">
        <bpmn:documentation>Step 3: Test scan verification: Lead Cashier scans each promotional SKU&#x27;s barcode at terminal; system displays promotional price on cashier screen and customer display; Lead Cashier verifies displayed price matches promo brief
Responsible (R): Lead Cashier
Accountable (A): —
Duration: 2 min/SKU</bpmn:documentation>
        <bpmn:incoming>W523_Flow21</bpmn:incoming>
        <bpmn:outgoing>W523_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W523_Task9" name="Promotional quick-key verification">
        <bpmn:documentation>Step 4: Promotional quick-key verification: if promotion has dedicated quick-keys on POS screen (e.g., &quot;BOGO Cement,&quot; &quot;20% Off Tiles&quot;), Lead Cashier presses each quick-key; system adds promotional item at correct price; Lead Cashier verifies quick-key label, price, and item description match promo brief
Responsible (R): Lead Cashier
Accountable (A): —
Duration: 1 min/quick-key</bpmn:documentation>
        <bpmn:incoming>W523_Flow22</bpmn:incoming>
        <bpmn:outgoing>W523_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W523_Task10" name="Customer display verification">
        <bpmn:documentation>Step 5: Customer display verification: Lead Cashier confirms promotional pricing displays correctly on customer-facing screen — promo price, original price (strikethrough), savings amount, promotional messaging (e.g., &quot;Buy 1 Take 1!&quot;)
Responsible (R): Lead Cashier
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W523_Flow23</bpmn:incoming>
        <bpmn:outgoing>W523_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W523_Task11" name="Bank-BIN promo verification">
        <bpmn:documentation>Step 6: Bank-BIN promo verification (if applicable): Lead Cashier processes test transaction with test bank card for partner bank promos (W149); system identifies card BIN and applies bank-specific promotional pricing or terms; Lead Cashier verifies correct bank promo applied
Responsible (R): Lead Cashier
Accountable (A): —
Duration: 3 min if bank promo</bpmn:documentation>
        <bpmn:incoming>W523_Flow24</bpmn:incoming>
        <bpmn:outgoing>W523_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W523_Task12" name="Bundle/BOGO verification">
        <bpmn:documentation>Step 7: Bundle/BOGO verification (if applicable): Lead Cashier scans bundle components or BOGO trigger items; system auto-applies bundle pricing or free-item logic; Lead Cashier verifies correct quantity triggers and pricing
Responsible (R): Lead Cashier
Accountable (A): —
Duration: 3 min if bundle</bpmn:documentation>
        <bpmn:incoming>W523_Flow25</bpmn:incoming>
        <bpmn:outgoing>W523_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W523_Task13" name="Lead Cashier documents verification results per terminal in POS system…">
        <bpmn:documentation>Step 8: Lead Cashier documents verification results per terminal in POS system: verification status (Pass/Fail per SKU/quick-key), any discrepancies found; if all pass: terminal marked &quot;Promo Ready&quot;; if any fail: system flags discrepancy to Merchandising Coordinator and IT Helpdesk (W48) for resolution before promo go-live
Responsible (R): Lead Cashier
Accountable (A): Store Manager
Duration: 5 min (documentation)</bpmn:documentation>
        <bpmn:incoming>W523_Flow26</bpmn:incoming>
        <bpmn:outgoing>W523_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W523_Task14" name="Store Manager reviews terminal verification status dashboard: confirms all…">
        <bpmn:documentation>Step 9: Store Manager reviews terminal verification status dashboard: confirms all terminals at store are &quot;Promo Ready&quot;; if any terminal shows &quot;Fail&quot;: Store Manager contacts IT Helpdesk (W48) for resolution; if unresolved by promo start time: Store Manager posts manual price list at affected terminal per W5E degraded mode procedure
Responsible (R): Store Manager
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W523_Flow27</bpmn:incoming>
        <bpmn:outgoing>W523_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W523_Task15" name="Post-promo: on promotion end date, system automatically deactivates promotional…">
        <bpmn:documentation>Step 10: Post-promo: on promotion end date, system automatically deactivates promotional pricing, removes quick-keys, and reverts to standard pricing; Lead Cashier verifies deactivation by test scanning former promo SKU (should show regular price)
Responsible (R): System / Lead Cashier
Accountable (A): Store Manager
Duration: 5 min/post-promo</bpmn:documentation>
        <bpmn:incoming>W523_Flow28</bpmn:incoming>
        <bpmn:outgoing>W523_Flow29</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W523_End16" name="Complete">
        <bpmn:incoming>W523_Flow29</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W523_Annotation17">
        <bpmn:text>Controls: - CTL-263 (ensure controlled execution — Transaction Processing (PA-08.1).) | - operational: post-promo verification of promo deactivation
Owner: Lead Cashier (terminal verification); Department Supervisor (floor setup per W262)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W523_Assoc18" sourceRef="W523_Annotation17" targetRef="W523_Start5" associationDirection="None" />
