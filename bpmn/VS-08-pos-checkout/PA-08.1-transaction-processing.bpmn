        <bpmndi:BPMNEdge id="W1276_Flow19_di" bpmnElement="W1276_Flow19"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1276_Flow20_di" bpmnElement="W1276_Flow20"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
