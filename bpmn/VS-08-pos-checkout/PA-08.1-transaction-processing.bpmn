    <bpmn:process id="W_W1538" name="W1538. POS Multi-Tender Partial Refund Processing, Change Allocation &amp; Tender Reversal Management" isExecutable="false">
      <bpmn:documentation>Trigger: Customer returns a subset of items from a multi-tender transaction (e.g., paid with cash + credit card + e-wallet, returns 2 of 5 items)
Frequency: ~7–11% of all returns (W12) involve multi-tender partial refunds; ~4,000–6,000/month across all stores
Volume: ~20–30 per store per month
Owner: Customer Service Rep
Participants: Customer Service Rep, Cashier, Store Manager (for approvals &gt; PHP 10,000)
Source: workflow W1538 — POS Multi-Tender Partial Refund Processing, Change Allocation &amp; Tender Reversal Management</bpmn:documentation>
      <bpmn:laneSet id="W1538_LaneSet4">
        <bpmn:lane id="W1538_Lane1" name="Customer Service Rep">
        <bpmn:flowNodeRef>W1538_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1538_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1538_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1538_Lane2" name="System">
        <bpmn:flowNodeRef>W1538_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1538_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1538_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1538_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1538_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W1538_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1538_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1538_Start5" name="Customer returns a subset of items from a multi-tender transaction (e.g., paid with cash…">
        <bpmn:outgoing>W1538_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1538_Task6" name="Original transaction lookup">
        <bpmn:documentation>Step 1: Original transaction lookup: Customer Service Rep retrieves original transaction from POS system using receipt barcode scan or transaction number; system displays original tenders used with amounts (e.g., Cash: PHP 500, Credit Card: PHP 1,000, GCash: PHP 300, Loyalty Points: 100 points = PHP 100; Total: PHP 1,900)
Responsible (R): Customer Service Rep
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W1538_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1538_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1538_Task7" name="Return item scan &amp; refund calculation">
        <bpmn:documentation>Step 2: Return item scan &amp; refund calculation: Customer Service Rep scans returned items; system calculates refund subtotal; system calculates refund allocation proportionally across original tenders based on each tender&#x27;s share of the original transaction total
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1538_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1538_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1538_Task8" name="Tender-specific refund processing">
        <bpmn:documentation>Step 3: Tender-specific refund processing: System processes refunds to each tender type: (a) Cash — added to cash drawer, customer receives physical cash; (b) Credit/Debit Card — system initiates card refund to original card number; terminal processes reversal; customer sees refund in 3–5 business days; (c) E-Wallet (GCash/Maya) — system initiates e-wallet refund via payment gateway API; real-time or next-day credit; (d) Loyalty Points — system reverses earned points from original transaction (deducts from customer&#x27;s points balance); (e) Gift Card/Store Credit — system issues new store credit or reloads gift card
Responsible (R): System / Customer Service Rep
Accountable (A): —
Duration: 3–5 min</bpmn:documentation>
        <bpmn:incoming>W1538_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1538_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1538_Task9" name="Rounding &amp; minimum refund handling">
        <bpmn:documentation>Step 4: Rounding &amp; minimum refund handling: If proportional allocation results in fractional amounts, system rounds cash portion to nearest peso and adjusts card/e-wallet portion; if proportional refund to a tender type falls below minimum refund threshold (e.g., PHP 1.00 for card refund), system redirects to cash or store credit
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1538_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1538_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1538_Task10" name="Tax handling">
        <bpmn:documentation>Step 5: Tax handling: System reverses proportionate VAT (12%) from the refund; adjusts store VAT output tax liability; generates BIR-compliant credit note with original invoice reference and refund details
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1538_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1538_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1538_Task11" name="Manager approval">
        <bpmn:documentation>Step 6: Manager approval (if required): For partial refunds exceeding PHP 10,000, Store Manager authorizes with biometric or manager card approval; system records approval with timestamp and manager ID
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W1538_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1538_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1538_Task12" name="Refund receipt &amp; documentation">
        <bpmn:documentation>Step 7: Refund receipt &amp; documentation: System prints BIR-compliant refund receipt with breakdown by tender; original receipt annotated with &quot;Partially Refunded — [Credit Note Number]&quot;; customer signs refund acknowledgment
Responsible (R): Customer Service Rep
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W1538_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1538_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1538_End13" name="Complete">
        <bpmn:incoming>W1538_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1538_Annotation14">
        <bpmn:text>Controls: - CTL-263 (ensure controlled execution — Transaction Processing (PA-08.1).) | - operational: Customer Service Rep review and approval gate
Owner: Customer Service Rep</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1538_Assoc15" sourceRef="W1538_Annotation14" targetRef="W1538_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1538_Flow16" sourceRef="W1538_Start5" targetRef="W1538_Task6" />
      <bpmn:sequenceFlow id="W1538_Flow17" sourceRef="W1538_Task6" targetRef="W1538_Task7" />
      <bpmn:sequenceFlow id="W1538_Flow18" sourceRef="W1538_Task7" targetRef="W1538_Task8" />
      <bpmn:sequenceFlow id="W1538_Flow19" sourceRef="W1538_Task8" targetRef="W1538_Task9" />
      <bpmn:sequenceFlow id="W1538_Flow20" sourceRef="W1538_Task9" targetRef="W1538_Task10" />
      <bpmn:sequenceFlow id="W1538_Flow21" sourceRef="W1538_Task10" targetRef="W1538_Task11" />
      <bpmn:sequenceFlow id="W1538_Flow22" sourceRef="W1538_Task11" targetRef="W1538_Task12" />
      <bpmn:sequenceFlow id="W1538_Flow23" sourceRef="W1538_Task12" targetRef="W1538_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1538_diag">
      <bpmndi:BPMNPlane id="W1538_plane" bpmnElement="W_W1538">
        <bpmndi:BPMNShape id="W1538_Lane1_di" bpmnElement="W1538_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1538_Lane2_di" bpmnElement="W1538_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1538_Lane3_di" bpmnElement="W1538_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1538_Task6_di" bpmnElement="W1538_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1538_Task7_di" bpmnElement="W1538_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1538_Task8_di" bpmnElement="W1538_Task8"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1538_Task9_di" bpmnElement="W1538_Task9"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1538_Task10_di" bpmnElement="W1538_Task10"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1538_Task11_di" bpmnElement="W1538_Task11"><dc:Bounds x="1450" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1538_Task12_di" bpmnElement="W1538_Task12"><dc:Bounds x="1660" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1538_Start5_di" bpmnElement="W1538_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1538_End13_di" bpmnElement="W1538_End13"><dc:Bounds x="1890" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1538_Annotation14_di" bpmnElement="W1538_Annotation14"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1538_Flow16_di" bpmnElement="W1538_Flow16"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1538_Flow17_di" bpmnElement="W1538_Flow17"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1538_Flow18_di" bpmnElement="W1538_Flow18"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1538_Flow19_di" bpmnElement="W1538_Flow19"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1538_Flow20_di" bpmnElement="W1538_Flow20"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1538_Flow21_di" bpmnElement="W1538_Flow21"><di:waypoint x="1420" y="335" /><di:waypoint x="1450" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1538_Flow22_di" bpmnElement="W1538_Flow22"><di:waypoint x="1630" y="505" /><di:waypoint x="1660" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1538_Flow23_di" bpmnElement="W1538_Flow23"><di:waypoint x="1840" y="165" /><di:waypoint x="1890" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1538_Assoc15_di" bpmnElement="W1538_Assoc15"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
