      <bpmn:sequenceFlow id="W528_Flow21" sourceRef="W528_Task9" targetRef="W528_Task10" />
      <bpmn:sequenceFlow id="W528_Flow22" sourceRef="W528_Task10" targetRef="W528_Task11" />
      <bpmn:sequenceFlow id="W528_Flow23" sourceRef="W528_Task11" targetRef="W528_Task12" />
      <bpmn:sequenceFlow id="W528_Flow24" sourceRef="W528_Task12" targetRef="W528_Task13" />
      <bpmn:sequenceFlow id="W528_Flow25" sourceRef="W528_Task13" targetRef="W528_End14" />
    </bpmn:process>
