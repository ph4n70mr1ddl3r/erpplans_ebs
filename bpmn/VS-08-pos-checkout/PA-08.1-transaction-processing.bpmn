        <bpmndi:BPMNEdge id="W1276_Flow22_di" bpmnElement="W1276_Flow22"><di:waypoint x="1420" y="505" /><di:waypoint x="1450" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1276_Flow23_di" bpmnElement="W1276_Flow23"><di:waypoint x="1630" y="505" /><di:waypoint x="1660" y="675" /></bpmndi:BPMNEdge>
