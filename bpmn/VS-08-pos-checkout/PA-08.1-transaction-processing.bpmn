    <bpmn:process id="W_W549" name="W549. POS Damaged &amp; Open-Box Item Discount Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer brings a damaged, dented, or open-box item to checkout and requests a discount; or Store Manager proactively marks damaged items for discounted sale
Frequency: ~8,400 damaged-item transactions/month (~0.3% of POS transactions)
Volume: Higher in stores with high foot traffic and self-service format (customers damage items on shelf)
Owner: Store Manager (discount authorization and condition assessment)
Participants: Cashier (processing), Customer, Store Manager (assessment and approval), Stock Associate (removal and replacement)
Source: workflow W549 — POS Damaged &amp; Open-Box Item Discount Processing</bpmn:documentation>
      <bpmn:laneSet id="W549_LaneSet4">
        <bpmn:lane id="W549_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W549_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W549_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W549_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W549_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W549_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W549_Lane3" name="System">
        <bpmn:flowNodeRef>W549_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W549_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W549_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W549_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W549_Start5" name="Customer brings a damaged, dented, or open-box item to checkout and requests a discount…">
        <bpmn:outgoing>W549_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W549_Task6" name="Damage identification at checkout">
        <bpmn:documentation>Step 1: Damage identification at checkout: customer brings damaged item to cashier; or cashier notices damage during scan; cashier alerts Store Manager for condition assessment
Responsible (R): Cashier
Accountable (A): —
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W549_Flow15</bpmn:incoming>
        <bpmn:outgoing>W549_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W549_Task7" name="Condition assessment">
        <bpmn:documentation>Step 2: Condition assessment: Store Manager inspects item and classifies condition: (a) Minor cosmetic (dent, scratch, scuff — fully functional): 10–20% discount, (b) Moderate damage (torn packaging, missing non-essential parts): 20–35% discount, (c) Significant damage (missing essential parts, heavily dented, but repairable): 35–50% discount, (d) Unsellable (safety hazard, non-functional): refused for sale, removed to damage inventory per W91
Responsible (R): Store Manager
Accountable (A): —
Duration: 2–3 min</bpmn:documentation>
        <bpmn:incoming>W549_Flow16</bpmn:incoming>
        <bpmn:outgoing>W549_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W549_Task8" name="Discount application">
        <bpmn:documentation>Step 3: Discount application: Store Manager authorizes damage discount per condition tier; cashier applies discount with reason code &quot;DAMAGED&quot; in POS; system requires manager authorization (biometric or badge scan); discount shown as separate line on receipt; customer verbal confirmation that item is sold &quot;as-is&quot; with disclosed condition
Responsible (R): Cashier / Store Manager
Accountable (A): Store Manager
Duration: 1–2 min</bpmn:documentation>
        <bpmn:incoming>W549_Flow17</bpmn:incoming>
        <bpmn:outgoing>W549_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W549_Task9" name="Modified warranty disclosure">
        <bpmn:documentation>Step 4: Modified warranty disclosure: system prints modified warranty terms on receipt: (a) damage-discounted items carry reduced warranty (default: 30 days functional warranty vs. standard warranty), (b) receipt prints &quot;AS-IS / DAMAGED ITEM — REDUCED WARRANTY&quot;, (c) specific damage noted on receipt (e.g., &quot;Dented can — cosmetic only&quot;), (d) standard return policy may be restricted per damage type; customer acknowledgment captured (digital signature or verbal confirmation logged)
Responsible (R): System / Cashier
Accountable (A): Store Manager
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W549_Flow18</bpmn:incoming>
        <bpmn:outgoing>W549_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W549_Task10" name="Shrinkage and damage tracking">
        <bpmn:documentation>Step 5: Shrinkage and damage tracking: system logs damage-discount transaction with: (a) original item cost, (b) discount amount (shrinkage), (c) condition tier, (d) damage cause (if known: customer-caused, shelf-damage, transit-damage), (e) Store Manager authorization; damage shrinkage posted to shrinkage GL account; data feeds into monthly damage report and W248 (inventory variance investigation)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W549_Flow19</bpmn:incoming>
        <bpmn:outgoing>W549_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W549_Task11" name="Shelf replacement trigger">
        <bpmn:documentation>Step 6: Shelf replacement trigger: if item removed from shelf due to damage, system triggers replenishment alert: (a) if identical item in backstock, Stock Associate retrieves replacement, (b) if no backstock, replenishment request sent to DC per W4; shelf gap tracked until replacement placed
Responsible (R): System / Stock Associate
Accountable (A): —
Duration: Per W109</bpmn:documentation>
        <bpmn:incoming>W549_Flow20</bpmn:incoming>
        <bpmn:outgoing>W549_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W549_End12" name="Complete">
        <bpmn:incoming>W549_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W549_Annotation13">
        <bpmn:text>Controls: - CTL-263 (ensure controlled execution — Transaction Processing (PA-08.1).) | - operational: manager authorization, condition documentation, and LP monitoring (W538); operational: clear receipt disclosure and verbal confirmation at sale; operational: system-enforced reason code and manager authorization
Owner: Store Manager (discount authorization and condition assessment)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W549_Assoc14" sourceRef="W549_Annotation13" targetRef="W549_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W549_Flow15" sourceRef="W549_Start5" targetRef="W549_Task6" />
      <bpmn:sequenceFlow id="W549_Flow16" sourceRef="W549_Task6" targetRef="W549_Task7" />
      <bpmn:sequenceFlow id="W549_Flow17" sourceRef="W549_Task7" targetRef="W549_Task8" />
      <bpmn:sequenceFlow id="W549_Flow18" sourceRef="W549_Task8" targetRef="W549_Task9" />
      <bpmn:sequenceFlow id="W549_Flow19" sourceRef="W549_Task9" targetRef="W549_Task10" />
      <bpmn:sequenceFlow id="W549_Flow20" sourceRef="W549_Task10" targetRef="W549_Task11" />
      <bpmn:sequenceFlow id="W549_Flow21" sourceRef="W549_Task11" targetRef="W549_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W549_diag">
