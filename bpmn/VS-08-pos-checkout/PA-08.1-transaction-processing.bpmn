    <bpmn:process id="W_W523" name="W523. POS Promotional Terminal Setup &amp; Pre-Live Verification" isExecutable="false">
      <bpmn:documentation>Trigger: New promotion launching (promo start date = tomorrow or today); Store Manager or Lead Cashier receives promotional setup brief from Merchandising team (W262)
Frequency: ~2–3 new promotions starting per week per store (promotional calendar from W13)
Volume: ~400–600 promo setups/week chain-wide; ~9–13 per store per month
Owner: Lead Cashier (terminal verification); Department Supervisor (floor setup per W262)
Participants: Lead Cashier, Department Supervisor, Store Manager (go/no-go), Merchandising Coordinator (W262)
Source: workflow W523 — POS Promotional Terminal Setup &amp; Pre-Live Verification</bpmn:documentation>
      <bpmn:laneSet id="W523_LaneSet4">
        <bpmn:lane id="W523_Lane1" name="Lead Cashier">
        <bpmn:flowNodeRef>W523_Task6</bpmn:flowNodeRef>
