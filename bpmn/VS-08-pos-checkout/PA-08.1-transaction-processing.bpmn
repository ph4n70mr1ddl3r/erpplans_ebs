      <bpmn:sequenceFlow id="W522_Flow25" sourceRef="W522_Task12" targetRef="W522_Task13" />
      <bpmn:sequenceFlow id="W522_Flow26" sourceRef="W522_Task13" targetRef="W522_Task14" />
      <bpmn:sequenceFlow id="W522_Flow27" sourceRef="W522_Task14" targetRef="W522_End15" />
    </bpmn:process>
