        <bpmndi:BPMNEdge id="W548_Flow19_di" bpmnElement="W548_Flow19"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W548_Flow20_di" bpmnElement="W548_Flow20"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
