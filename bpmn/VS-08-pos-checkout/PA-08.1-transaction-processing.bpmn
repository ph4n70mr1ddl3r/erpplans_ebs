        <bpmndi:BPMNShape id="W546_Annotation13_di" bpmnElement="W546_Annotation13"><dc:Bounds x="160" y="630" width="360" height="100" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W546_Flow15_di" bpmnElement="W546_Flow15"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W546_Flow16_di" bpmnElement="W546_Flow16"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W546_Flow17_di" bpmnElement="W546_Flow17"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W546_Flow18_di" bpmnElement="W546_Flow18"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W546_Flow19_di" bpmnElement="W546_Flow19"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W546_Flow20_di" bpmnElement="W546_Flow20"><di:waypoint x="1420" y="505" /><di:waypoint x="1450" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W546_Flow21_di" bpmnElement="W546_Flow21"><di:waypoint x="1630" y="165" /><di:waypoint x="1680" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W546_Assoc14_di" bpmnElement="W546_Assoc14"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W547" name="W547. POS Scan &amp; Go / Mobile Self-Scan Checkout" isExecutable="false">
      <bpmn:documentation>Trigger: Customer initiates scan-and-go session in BuildRight mobile app upon store entry
Frequency: ~42,000 scan-and-go transactions/month (~1.5% of POS transactions); expected to grow to 5% within 2 years
Volume: Peak: weekends and sale events generate 3× scan-and-go volume
Owner: Digital Commerce Manager (feature owner); Store Manager (in-store compliance)
Participants: Customer (self-scanning), Scan-and-Go Attendant (verification), Store Manager (exception handling)
Source: workflow W547 — POS Scan &amp; Go / Mobile Self-Scan Checkout</bpmn:documentation>
      <bpmn:laneSet id="W547_LaneSet4">
        <bpmn:lane id="W547_Lane1" name="Customer">
        <bpmn:flowNodeRef>W547_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W547_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W547_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W547_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W547_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W547_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W547_Lane2" name="Attendant">
        <bpmn:flowNodeRef>W547_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W547_Lane3" name="System">
        <bpmn:flowNodeRef>W547_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W547_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W547_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W547_Start5" name="Customer initiates scan-and-go session in BuildRight mobile app upon store entry">
        <bpmn:outgoing>W547_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W547_Task6" name="Session initiation">
        <bpmn:documentation>Step 1: Session initiation: customer opens BuildRight app in-store; app detects store location via GPS/beacon; customer taps &quot;Scan &amp; Go&quot; to start session; system creates scan-and-go session linked to customer loyalty ID and store; customer grants camera access for barcode scanning
Responsible (R): Customer / System
Accountable (A): —
Duration: 30 sec</bpmn:documentation>
        <bpmn:incoming>W547_Flow17</bpmn:incoming>
        <bpmn:outgoing>W547_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W547_Task7" name="Item scanning">
        <bpmn:documentation>Step 2: Item scanning: customer scans item barcodes using phone camera as they shop; system validates each scan: (a) item exists in active SKU catalog, (b) item is available for sale (not recalled, not discontinued), (c) price displayed from local data store (POS-043); for catch-weight items (POS-016): app prompts customer to weigh item on store scale and enter weight; for age-restricted items (POS-029): app flags item for attendant verification at checkout
Responsible (R): Customer / System
Accountable (A): —
Duration: 5–10 sec per item</bpmn:documentation>
        <bpmn:incoming>W547_Flow18</bpmn:incoming>
        <bpmn:outgoing>W547_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W547_Task8" name="Basket management">
        <bpmn:documentation>Step 3: Basket management: customer can view basket in app at any time: item list, quantities, running total, applied promotions (auto-applied per POS-014); customer can remove items (returns to shelf), change quantities, or scan additional items; real-time inventory deduction reserved (not finalized)
Responsible (R): Customer / System
Accountable (A): —
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W547_Flow19</bpmn:incoming>
        <bpmn:outgoing>W547_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W547_Task9" name="Quick-pay at dedicated terminal">
        <bpmn:documentation>Step 4: Quick-pay at dedicated terminal: customer proceeds to Scan &amp; Go quick-pay terminal (dedicated lane, no traditional checkout); customer scans app QR code at terminal; terminal loads customer&#x27;s virtual basket; system performs final validation: (a) all items still in stock (real-time ATP check), (b) pricing still current, (c) promotions still valid; customer selects payment method (card, e-wallet, loyalty points W550); payment processed; receipt printed or e-receipt delivered (W528)
Responsible (R): Customer / System
Accountable (A): —
Duration: 30–60 sec</bpmn:documentation>
        <bpmn:incoming>W547_Flow20</bpmn:incoming>
        <bpmn:outgoing>W547_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W547_Task10" name="In-app payment (contactless)">
        <bpmn:documentation>Step 5: In-app payment (contactless): alternatively, customer pays directly in app (no terminal needed); payment processed via stored payment method; digital receipt delivered to app; system generates exit QR code; customer presents exit QR to attendant at store exit for verification
Responsible (R): Customer / System
Accountable (A): —
Duration: 30 sec</bpmn:documentation>
        <bpmn:incoming>W547_Flow21</bpmn:incoming>
        <bpmn:outgoing>W547_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W547_Task11" name="Attendant verification">
        <bpmn:documentation>Step 6: Attendant verification: for transactions containing age-restricted items or exceeding random audit threshold (~10% of transactions): attendant scans exit QR or receipt barcode; system displays items flagged for verification; attendant verifies age-restricted items (ID check per POS-029) or performs random basket check; attendant confirms verification in app
Responsible (R): Attendant
Accountable (A): —
Duration: 1–3 min</bpmn:documentation>
        <bpmn:incoming>W547_Flow22</bpmn:incoming>
        <bpmn:outgoing>W547_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W547_Task12" name="Skip-scan and weight verification">
        <bpmn:documentation>Step 7: Skip-scan and weight verification: system cross-references scanned items with expected weight ranges; if basket weight (measured at exit scale or estimated from item weights) deviates &gt; 15% from expected: system flags for attendant verification; LP exception alert triggered per W538
Responsible (R): System / Attendant
Accountable (A): Store Manager
Duration: Per alert</bpmn:documentation>
        <bpmn:incoming>W547_Flow23</bpmn:incoming>
        <bpmn:outgoing>W547_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W547_Task13" name="End-of-day reconciliation">
        <bpmn:documentation>Step 8: End-of-day reconciliation: at store close (W5F), system generates Scan &amp; Go session reconciliation: (a) total sessions initiated vs. completed vs. abandoned, (b) average basket size and value (compared to standard POS), (c) payment method distribution, (d) exception rate (age-restricted, random audit, weight flag), (e) conversion rate; reconciliation report transmitted via W533
Responsible (R): System / Store Manager
Accountable (A): —
Duration: Automated + 5 min review</bpmn:documentation>
        <bpmn:incoming>W547_Flow24</bpmn:incoming>
        <bpmn:outgoing>W547_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W547_End14" name="Complete">
        <bpmn:incoming>W547_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W547_Annotation15">
        <bpmn:text>Controls: - CTL-263 (ensure controlled execution — Transaction Processing (PA-08.1).) | - operational: weight verification, random audits, and LP monitoring (W538); operational: keeping traditional checkout lanes available; operational: offline scanning capability and basket recovery on app restart
Owner: Digital Commerce Manager (feature owner); Store Manager (in-store compliance)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W547_Assoc16" sourceRef="W547_Annotation15" targetRef="W547_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W547_Flow17" sourceRef="W547_Start5" targetRef="W547_Task6" />
