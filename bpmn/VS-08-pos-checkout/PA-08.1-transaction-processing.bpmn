    <bpmn:process id="W_W518" name="W518. Cashier Onboarding, POS Training &amp; Competency Certification" isExecutable="false">
      <bpmn:documentation>Trigger: New cashier hire completes HR onboarding (W15) or existing employee transferred to cashier role
Frequency: As needed — estimated 200–300 new cashiers/year across 200 stores (turnover replacement + new store hires + seasonal temp conversion)
Volume: ~17–25 new cashiers/month across the chain (200–300/year per the Frequency); ~1–1.5 per store per year on average
Owner: Store Manager (training oversight); Lead Cashier (training delivery)
Participants: New Cashier, Lead Cashier (trainer), Store Manager, HR Training Coordinator (W51)
Source: workflow W518 — Cashier Onboarding, POS Training &amp; Competency Certification</bpmn:documentation>
      <bpmn:laneSet id="W518_LaneSet5">
        <bpmn:lane id="W518_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W518_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W518_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W518_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W518_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W518_Lane2" name="Lead Cashier">
        <bpmn:flowNodeRef>W518_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W518_Lane3" name="New Cashier">
        <bpmn:flowNodeRef>W518_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W518_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W518_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W518_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W518_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W518_Lane4" name="System">
        <bpmn:flowNodeRef>W518_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W518_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W518_Start6" name="New cashier hire completes HR onboarding (W15) or existing employee transferred to…">
        <bpmn:outgoing>W518_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W518_Task7" name="New cashier completes HR onboarding (W15) including employee master creation…">
        <bpmn:documentation>Step 1: New cashier completes HR onboarding (W15) including employee master creation (W292) and IT provisioning (W152); Store Manager assigns cashier role in POS system with &quot;Trainee&quot; status
Responsible (R): Store Manager / HR
Accountable (A): Store Manager
Duration: Part of W15</bpmn:documentation>
        <bpmn:incoming>W518_Flow20</bpmn:incoming>
        <bpmn:outgoing>W518_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W518_Task8" name="Lead Cashier conducts POS system orientation: terminal layout, login/logout…">
        <bpmn:documentation>Step 2: Lead Cashier conducts POS system orientation: terminal layout, login/logout, barcode scanner operation, customer display, cash drawer mechanism, receipt printer loading, basic transaction flow (scan → tender → receipt)
Responsible (R): Lead Cashier
Accountable (A): Store Manager
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W518_Flow21</bpmn:incoming>
        <bpmn:outgoing>W518_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W518_Task9" name="training mode">
        <bpmn:documentation>Step 3: New cashier operates in training mode: system simulates transactions (simulated barcode scans, tender, receipt) without posting to GL or deducting inventory; training mode receipts print &quot;TRAINING — NOT VALID&quot; watermark; training transactions logged separately
Responsible (R): New Cashier
Accountable (A): Lead Cashier
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W518_Flow22</bpmn:incoming>
        <bpmn:outgoing>W518_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W518_Task10" name="Supervised transactions">
        <bpmn:documentation>Step 4: Supervised transactions: new cashier processes live customer transactions under Lead Cashier supervision; Lead Cashier observes and corrects in real-time; system tracks supervised transaction count against certification milestone (minimum 50 supervised transactions)
Responsible (R): New Cashier / Lead Cashier
Accountable (A): Store Manager
Duration: 2–3 days (~50 transactions)</bpmn:documentation>
        <bpmn:incoming>W518_Flow23</bpmn:incoming>
        <bpmn:outgoing>W518_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W518_Task11" name="Tender type training">
        <bpmn:documentation>Step 5: Tender type training: new cashier processes each tender type under supervision — cash (counting change, detecting counterfeit per W37), credit/debit card (PIN pad, signature), e-wallet (QR scan, NFC), split tender, trade account (W5B.4c)
Responsible (R): New Cashier / Lead Cashier
Accountable (A): Lead Cashier
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W518_Flow24</bpmn:incoming>
        <bpmn:outgoing>W518_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W518_Task12" name="Special procedure training">
        <bpmn:documentation>Step 6: Special procedure training: price override with authorization (W5B.4a), void transaction (W5B.10), return/exchange processing (W12A), gift card/store credit (W28), catch-weight items (W5B.2), paint mixing custom SKU (W5B.3), employee purchase (W5B.12), age-restricted products (W520)
Responsible (R): New Cashier / Lead Cashier
Accountable (A): Lead Cashier
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W518_Flow25</bpmn:incoming>
        <bpmn:outgoing>W518_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W518_Task13" name="Department product knowledge">
        <bpmn:documentation>Step 7: Department product knowledge: new cashier trains on product identification by department (Lumber, Plumbing/Electrical, Tiles, Tools/Hardware) — recognizing common SKUs, understanding unit-of-measure, identifying catch-weight vs. standard items, hazardous material indicators
Responsible (R): New Cashier / Dept. Supervisor
Accountable (A): Store Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W518_Flow26</bpmn:incoming>
        <bpmn:outgoing>W518_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W518_Task14" name="Certification assessment">
        <bpmn:documentation>Step 8: Certification assessment: Store Manager observes new cashier processing 10 consecutive live transactions without error; Store Manager signs off on cashier competency checklist; system updates cashier status from &quot;Trainee&quot; to &quot;Certified&quot; — certified cashiers can operate terminals unsupervised
Responsible (R): Store Manager / New Cashier
Accountable (A): Store Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W518_Flow27</bpmn:incoming>
        <bpmn:outgoing>W518_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W518_Task15" name="System records cashier certification in employee training log (W51) with…">
        <bpmn:documentation>Step 9: System records cashier certification in employee training log (W51) with: certification date, certified-by manager ID, terminal types qualified (standard POS, SCO, mPOS), competency checklist score; certification linked to employee master (W292)
Responsible (R): System / Store Manager
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W518_Flow28</bpmn:incoming>
        <bpmn:outgoing>W518_Flow29</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W518_Task16" name="Annual recertification">
        <bpmn:documentation>Step 10: Annual recertification: each January, Store Manager reviews all certified cashiers&#x27; performance metrics (transaction speed, void rate, variance history from W522); cashiers with performance below threshold (e.g., &gt; 3× average void rate or &gt; PHP 1,000 cumulative annual variance) undergo refresher training (repeat steps 5–8 abbreviated)
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 1 hour/cashier</bpmn:documentation>
        <bpmn:incoming>W518_Flow29</bpmn:incoming>
        <bpmn:outgoing>W518_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W518_End17" name="Complete">
        <bpmn:incoming>W518_Flow30</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W518_Annotation18">
        <bpmn:text>Controls: - CTL-263 (ensure controlled execution — Transaction Processing (PA-08.1).) | - operational: Store Manager (training oversight); Lead Cashier (training delivery) review and approval gate
Owner: Store Manager (training oversight); Lead Cashier (training delivery)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W518_Assoc19" sourceRef="W518_Annotation18" targetRef="W518_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W518_Flow20" sourceRef="W518_Start6" targetRef="W518_Task7" />
      <bpmn:sequenceFlow id="W518_Flow21" sourceRef="W518_Task7" targetRef="W518_Task8" />
      <bpmn:sequenceFlow id="W518_Flow22" sourceRef="W518_Task8" targetRef="W518_Task9" />
      <bpmn:sequenceFlow id="W518_Flow23" sourceRef="W518_Task9" targetRef="W518_Task10" />
      <bpmn:sequenceFlow id="W518_Flow24" sourceRef="W518_Task10" targetRef="W518_Task11" />
      <bpmn:sequenceFlow id="W518_Flow25" sourceRef="W518_Task11" targetRef="W518_Task12" />
      <bpmn:sequenceFlow id="W518_Flow26" sourceRef="W518_Task12" targetRef="W518_Task13" />
      <bpmn:sequenceFlow id="W518_Flow27" sourceRef="W518_Task13" targetRef="W518_Task14" />
      <bpmn:sequenceFlow id="W518_Flow28" sourceRef="W518_Task14" targetRef="W518_Task15" />
      <bpmn:sequenceFlow id="W518_Flow29" sourceRef="W518_Task15" targetRef="W518_Task16" />
      <bpmn:sequenceFlow id="W518_Flow30" sourceRef="W518_Task16" targetRef="W518_End17" />
    </bpmn:process>
