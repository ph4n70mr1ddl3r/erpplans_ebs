      <bpmn:sequenceFlow id="W517_Flow27" sourceRef="W517_Task13" targetRef="W517_Task14" />
      <bpmn:sequenceFlow id="W517_Flow28" sourceRef="W517_Task14" targetRef="W517_Task15" />
      <bpmn:sequenceFlow id="W517_Flow29" sourceRef="W517_Task15" targetRef="W517_Task16" />
      <bpmn:sequenceFlow id="W517_Flow30" sourceRef="W517_Task16" targetRef="W517_End17" />
    </bpmn:process>
