      <bpmn:sequenceFlow id="W1268_Flow24" sourceRef="W1268_Task11" targetRef="W1268_Task12" />
      <bpmn:sequenceFlow id="W1268_Flow25" sourceRef="W1268_Task12" targetRef="W1268_Task13" />
      <bpmn:sequenceFlow id="W1268_Flow26" sourceRef="W1268_Task13" targetRef="W1268_Task14" />
      <bpmn:sequenceFlow id="W1268_Flow27" sourceRef="W1268_Task14" targetRef="W1268_End15" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1268_diag">
      <bpmndi:BPMNPlane id="W1268_plane" bpmnElement="W_W1268">
        <bpmndi:BPMNShape id="W1268_Lane1_di" bpmnElement="W1268_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2210" height="170" /></bpmndi:BPMNShape>
