    <bpmn:process id="W_W541" name="W541. POS Cash Office Operations &amp; Bank Deposit Preparation" isExecutable="false">
      <bpmn:documentation>Trigger: End of cashier shift (W517) or end-of-day store close (W5F) when cash drawers are submitted to cash office
Frequency: Daily — 2 shifts × 200 stores = 400 cash office processing cycles/day
Volume: ~PHP 2.1B in monthly cash sales (42% of PHP 5.04B); ~PHP 350,000/day/average store in cash
Owner: Store Manager (cash office operations); Finance (bank deposit verification)
Participants: Cash Office Clerk / designated Store Manager on-duty, Cashier (drawer handover), CIT Guard (cash pickup per W212), Bank (deposit processing)
Source: workflow W541 — POS Cash Office Operations &amp; Bank Deposit Preparation</bpmn:documentation>
      <bpmn:laneSet id="W541_LaneSet3">
        <bpmn:lane id="W541_Lane1" name="Cash Office Clerk">
        <bpmn:flowNodeRef>W541_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W541_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W541_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W541_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W541_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W541_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W541_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W541_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W541_Lane2" name="System">
        <bpmn:flowNodeRef>W541_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W541_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W541_Start4" name="End of cashier shift (W517) or end-of-day store close (W5F) when cash drawers are…">
        <bpmn:outgoing>W541_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W541_Task5" name="Drawer receipt from cashier">
        <bpmn:documentation>Step 1: Drawer receipt from cashier: at shift end (W517.7) or EOD (W5F.2), cashier brings sealed cash drawer or tamper-evident cash bag to cash office; Cash Office Clerk verifies tamper-evident seal is intact; records receipt time and cashier name
Responsible (R): Cash Office Clerk
Accountable (A): Store Manager
Duration: 2–3 min per drawer</bpmn:documentation>
        <bpmn:incoming>W541_Flow16</bpmn:incoming>
        <bpmn:outgoing>W541_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W541_Task6" name="Drawer count and verification">
        <bpmn:documentation>Step 2: Drawer count and verification: Cash Office Clerk opens drawer/bag in cash office (secure room with CCTV); counts bills by denomination; counts coins by denomination; records actual cash amount per cashier; system compares actual count to POS system expected amount (opening float + cash sales − cash refunds − cash payouts − voids)
Responsible (R): Cash Office Clerk
Accountable (A): —
Duration: 5–8 min per drawer</bpmn:documentation>
        <bpmn:incoming>W541_Flow17</bpmn:incoming>
        <bpmn:outgoing>W541_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W541_Task7" name="Variance documentation">
        <bpmn:documentation>Step 3: Variance documentation: if variance between actual and expected &gt; PHP 50 (configurable threshold): (a) system flags variance for investigation per W272 (cashier over/short), (b) Cash Office Clerk documents variance with cashier name, amount, date, shift, (c) Store Manager notified, (d) cashier notified and signs variance acknowledgment; variance &lt; PHP 50 recorded but not escalated
Responsible (R): Cash Office Clerk / Store Manager
Accountable (A): Store Manager
Duration: 3–5 min per variance</bpmn:documentation>
        <bpmn:incoming>W541_Flow18</bpmn:incoming>
        <bpmn:outgoing>W541_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W541_Task8" name="Non-cash tender verification">
        <bpmn:documentation>Step 4: Non-cash tender verification: for stores without Smart Safe, Cash Office Clerk also verifies non-cash tender totals: (a) card batch totals vs. POS card tender report (per W537), (b) e-wallet settlement totals vs. POS e-wallet tender report, (c) trade account charges vs. POS trade account report; discrepancies flagged per W537 or W261
Responsible (R): Cash Office Clerk
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W541_Flow19</bpmn:incoming>
        <bpmn:outgoing>W541_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W541_Task9" name="Bank deposit preparation">
        <bpmn:documentation>Step 5: Bank deposit preparation: Cash Office Clerk prepares bank deposit: (a) selects bills and coins for deposit (keeping working float for next day), (b) fills bank deposit slip with cash breakdown by denomination, (c) includes any check payments received, (d) seals deposit in tamper-evident bank bag with deposit slip, (e) records deposit amount in cash office log; for Smart Safe stores (W212): Smart Safe counts and verifies cash automatically; Cash Office Clerk confirms Smart Safe count and initiates deposit report
Responsible (R): Cash Office Clerk
Accountable (A): Store Manager
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W541_Flow20</bpmn:incoming>
        <bpmn:outgoing>W541_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W541_Task10" name="Cash securing">
        <bpmn:documentation>Step 6: Cash securing: remaining working float (next day&#x27;s opening float per W5A) placed in store safe; bank deposit bag secured in safe pending CIT pickup (W212) or manager bank run; cash office log updated with safe contents (working float + deposit bag); safe locked and time-lock set
Responsible (R): Cash Office Clerk
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W541_Flow21</bpmn:incoming>
        <bpmn:outgoing>W541_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W541_Task11" name="Cash office close report">
        <bpmn:documentation>Step 7: Cash office close report: system generates cash office close report: (a) per-cashier actual vs. expected with variances, (b) total cash received, (c) bank deposit amount, (d) working float retained, (e) non-cash tender summary, (f) net cash position; Store Manager reviews and digitally signs; report transmitted to Finance via event stream (W533)
Responsible (R): System / Cash Office Clerk
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W541_Flow22</bpmn:incoming>
        <bpmn:outgoing>W541_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W541_Task12" name="CIT pickup or bank deposit execution">
        <bpmn:documentation>Step 8: CIT pickup or bank deposit execution: for stores with CIT service (W212, FIN-025): CIT guard arrives per schedule; two-person custody transfer (Cash Office Clerk + CIT guard); both sign custody transfer log; CIT guard transports deposit to bank; for stores without CIT: Store Manager or designated supervisor makes bank run before close; bank deposit receipt obtained and filed
Responsible (R): Cash Office Clerk / CIT Guard
Accountable (A): Store Manager
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W541_Flow23</bpmn:incoming>
        <bpmn:outgoing>W541_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W541_End13" name="Complete">
        <bpmn:incoming>W541_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W541_Annotation14">
        <bpmn:text>Controls: - CTL-264 (ensure controlled execution — Payment &amp; Cash Management (PA-08.2).) | - operational: denomination-level count recording and dual-verification for variances &gt; PHP 200; operational: CIT service for high-volume stores, varying bank run times for others; operational: staggered shift handover schedule and Smart Safe automation (W212)
Owner: Store Manager (cash office operations); Finance (bank deposit verification)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W541_Assoc15" sourceRef="W541_Annotation14" targetRef="W541_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W541_Flow16" sourceRef="W541_Start4" targetRef="W541_Task5" />
      <bpmn:sequenceFlow id="W541_Flow17" sourceRef="W541_Task5" targetRef="W541_Task6" />
      <bpmn:sequenceFlow id="W541_Flow18" sourceRef="W541_Task6" targetRef="W541_Task7" />
      <bpmn:sequenceFlow id="W541_Flow19" sourceRef="W541_Task7" targetRef="W541_Task8" />
      <bpmn:sequenceFlow id="W541_Flow20" sourceRef="W541_Task8" targetRef="W541_Task9" />
      <bpmn:sequenceFlow id="W541_Flow21" sourceRef="W541_Task9" targetRef="W541_Task10" />
      <bpmn:sequenceFlow id="W541_Flow22" sourceRef="W541_Task10" targetRef="W541_Task11" />
      <bpmn:sequenceFlow id="W541_Flow23" sourceRef="W541_Task11" targetRef="W541_Task12" />
      <bpmn:sequenceFlow id="W541_Flow24" sourceRef="W541_Task12" targetRef="W541_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W541_diag">
      <bpmndi:BPMNPlane id="W541_plane" bpmnElement="W_W541">
        <bpmndi:BPMNShape id="W541_Lane1_di" bpmnElement="W541_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2000" height="170" /></bpmndi:BPMNShape>
