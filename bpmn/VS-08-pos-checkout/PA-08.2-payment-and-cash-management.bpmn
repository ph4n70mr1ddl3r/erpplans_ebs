      <bpmn:startEvent id="W1354_Start7" name="Store end-of-day cash count and Z-report completion (W574)">
        <bpmn:outgoing>W1354_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1354_Task8" name="Cashier completes end-of-day Z-report; counts physical cash per terminal (3…">
        <bpmn:documentation>Step 1: Cashier completes end-of-day Z-report; counts physical cash per terminal (3 terminals); records count vs. system expected; reports variance to Store Manager
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W1354_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1354_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1354_Task9" name="Store Manager verifies cash count; investigates any variance &gt; PHP 500 per…">
        <bpmn:documentation>Step 2: Store Manager verifies cash count; investigates any variance &gt; PHP 500 per terminal (per W958); resolves or escalates
Responsible (R): Store Manager
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1354_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1354_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1354_Task10" name="Store Manager prepares bank deposit slip: separates notes by denomination…">
        <bpmn:documentation>Step 3: Store Manager prepares bank deposit slip: separates notes by denomination; seals cash in tamper-evident deposit bag with pre-printed barcode; retains duplicate deposit slip
Responsible (R): Store Manager
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1354_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1354_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1354_Task11" name="Armored car guard arrives at scheduled pickup time (varies by store location…">
        <bpmn:documentation>Step 4: Armored car guard arrives at scheduled pickup time (varies by store location; provincial stores may have every-other-day pickup); guard and Store Manager sign handover log; guard scans deposit bag barcode
Responsible (R): Armored Car Guard / Store Manager
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1354_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1354_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1354_Task12" name="Armored car service delivers cash to bank branch; bank processes deposit and…">
        <bpmn:documentation>Step 5: Armored car service delivers cash to bank branch; bank processes deposit and credits store bank account; armored car service transmits electronic pickup confirmation to BuildRight treasury
Responsible (R): Bank / Armored Car Service
Accountable (A): —
Duration: Same day or next day</bpmn:documentation>
        <bpmn:incoming>W1354_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1354_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1354_Task13" name="Treasury Analyst matches daily store deposit records (from ERP Z-report)…">
        <bpmn:documentation>Step 6: Treasury Analyst matches daily store deposit records (from ERP Z-report) against bank credit confirmations; flags unmatched deposits for investigation
Responsible (R): Treasury Analyst
Accountable (A): Treasury Manager
Duration: 2–3 hours/day</bpmn:documentation>
        <bpmn:incoming>W1354_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1354_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1354_Task14" name="Store Manager reviews weekly cash reconciliation report showing deposits vs…">
        <bpmn:documentation>Step 7: Store Manager reviews weekly cash reconciliation report showing deposits vs. bank credits; confirms or disputes any unmatched items
Responsible (R): Store Manager
Accountable (A): Treasury Manager
Duration: 15 min/week</bpmn:documentation>
        <bpmn:incoming>W1354_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1354_Flow25</bpmn:outgoing>
      </bpmn:userTask>
