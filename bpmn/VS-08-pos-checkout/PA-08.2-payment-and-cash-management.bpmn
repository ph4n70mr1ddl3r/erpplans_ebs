<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-08.2-payment-and-cash-management" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W517" name="W517. POS Cashier Shift Handover &amp; Drawer Accountability" isExecutable="false">
      <bpmn:documentation>Trigger: Shift change (typically mid-day, ~2:00 PM at stores with 2 shifts)
Frequency: Daily per POS terminal with shift-based staffing
Volume: ~1 double-shifted terminal × 200 stores = ~200 mid-shift handovers/day; the remaining 2 terminals per store operate single-shift and only require EOD per W5F
Owner: Outgoing Cashier / Incoming Cashier
Participants: Outgoing Cashier, Incoming Cashier, Store Manager (variance escalation)
Source: workflow W517 — POS Cashier Shift Handover &amp; Drawer Accountability</bpmn:documentation>
      <bpmn:laneSet id="W517_LaneSet5">
        <bpmn:lane id="W517_Lane1" name="Outgoing Cashier">
        <bpmn:flowNodeRef>W517_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W517_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W517_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W517_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W517_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W517_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W517_Lane2" name="System">
        <bpmn:flowNodeRef>W517_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W517_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W517_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W517_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W517_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W517_Lane4" name="Incoming Cashier">
        <bpmn:flowNodeRef>W517_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W517_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W517_Start6" name="Shift change (typically mid-day, ~2:00 PM at stores with 2 shifts)">
        <bpmn:outgoing>W517_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W517_Task7" name="Outgoing Cashier completes or suspends any in-progress transaction per W521…">
        <bpmn:documentation>Step 1: Outgoing Cashier completes or suspends any in-progress transaction per W521; system enforces no pending transactions before handover can proceed
Responsible (R): Outgoing Cashier
Accountable (A): —
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W517_Flow20</bpmn:incoming>
        <bpmn:outgoing>W517_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W517_Task8" name="System generates X-report (mid-day sales summary by tender type for this…">
        <bpmn:documentation>Step 2: System generates X-report (mid-day sales summary by tender type for this terminal since opening or last handover) — distinct from Z-report which is end-of-day
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W517_Flow21</bpmn:incoming>
        <bpmn:outgoing>W517_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W517_Task9" name="Outgoing Cashier counts physical cash in drawer; compares to X-report expected…">
        <bpmn:documentation>Step 3: Outgoing Cashier counts physical cash in drawer; compares to X-report expected cash
Responsible (R): Outgoing Cashier
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W517_Flow22</bpmn:incoming>
        <bpmn:outgoing>W517_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W517_Task10" name="If cash variance &gt; PHP 200: Outgoing Cashier documents variance reason in…">
        <bpmn:documentation>Step 4: If cash variance &gt; PHP 200: Outgoing Cashier documents variance reason in system; system alerts Store Manager; Store Manager investigates per W272 (cashier over/short dispute resolution)
Responsible (R): Outgoing Cashier / Store Manager
Accountable (A): Store Manager
Duration: 10 min if variance</bpmn:documentation>
        <bpmn:incoming>W517_Flow23</bpmn:incoming>
        <bpmn:outgoing>W517_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W517_Task11" name="Outgoing Cashier records drawer count in system: cash by denomination, total…">
        <bpmn:documentation>Step 5: Outgoing Cashier records drawer count in system: cash by denomination, total cash, credit/debit card slips count, e-wallet transaction count, total tender amount per X-report, variance (if any)
Responsible (R): Outgoing Cashier
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W517_Flow24</bpmn:incoming>
        <bpmn:outgoing>W517_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W517_Task12" name="Outgoing Cashier removes cash drawer (till); places in tamper-evident bag with…">
        <bpmn:documentation>Step 6: Outgoing Cashier removes cash drawer (till); places in tamper-evident bag with handwritten or printed count slip; secures in backroom safe
Responsible (R): Outgoing Cashier
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W517_Flow25</bpmn:incoming>
        <bpmn:outgoing>W517_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W517_Task13" name="Store Manager or Lead Cashier issues sealed replacement drawer with standard…">
        <bpmn:documentation>Step 7: Store Manager or Lead Cashier issues sealed replacement drawer with standard float (PHP 5,000 per W5A.4) from safe to Incoming Cashier
Responsible (R): Store Manager / Lead Cashier
Accountable (A): Store Manager
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W517_Flow26</bpmn:incoming>
        <bpmn:outgoing>W517_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W517_Task14" name="Incoming Cashier logs into POS terminal; system displays handover screen…">
        <bpmn:documentation>Step 8: Incoming Cashier logs into POS terminal; system displays handover screen showing X-report totals from Outgoing Cashier; Incoming Cashier confirms receipt of sealed drawer and acknowledges handover in system
Responsible (R): Incoming Cashier
Accountable (A): —
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W517_Flow27</bpmn:incoming>
        <bpmn:outgoing>W517_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W517_Task15" name="System records handover event: outgoing cashier ID, incoming cashier ID…">
        <bpmn:documentation>Step 9: System records handover event: outgoing cashier ID, incoming cashier ID, terminal ID, X-report totals, drawer count, variance (if any), handover timestamp; links to W272 if variance escalated
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W517_Flow28</bpmn:incoming>
        <bpmn:outgoing>W517_Flow29</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W517_Task16" name="If no replacement cashier available (sick call, no-show): Store Manager assigns…">
        <bpmn:documentation>Step 10: If no replacement cashier available (sick call, no-show): Store Manager assigns float cashier from available staff; if no staff available, Store Manager operates terminal directly or closes terminal for shift (reducing store checkout capacity)
Responsible (R): Store Manager
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W517_Flow29</bpmn:incoming>
        <bpmn:outgoing>W517_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W517_End17" name="Complete">
        <bpmn:incoming>W517_Flow30</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W517_Annotation18">
        <bpmn:text>Controls: - CTL-264 (ensure controlled execution — Payment &amp; Cash Management (PA-08.2).) | - operational: staggering handover across terminals (not all at once); operational: should enforce logout/login cycle at shift change
Owner: Outgoing Cashier / Incoming Cashier</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W517_Assoc19" sourceRef="W517_Annotation18" targetRef="W517_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W517_Flow20" sourceRef="W517_Start6" targetRef="W517_Task7" />
      <bpmn:sequenceFlow id="W517_Flow21" sourceRef="W517_Task7" targetRef="W517_Task8" />
      <bpmn:sequenceFlow id="W517_Flow22" sourceRef="W517_Task8" targetRef="W517_Task9" />
      <bpmn:sequenceFlow id="W517_Flow23" sourceRef="W517_Task9" targetRef="W517_Task10" />
      <bpmn:sequenceFlow id="W517_Flow24" sourceRef="W517_Task10" targetRef="W517_Task11" />
      <bpmn:sequenceFlow id="W517_Flow25" sourceRef="W517_Task11" targetRef="W517_Task12" />
