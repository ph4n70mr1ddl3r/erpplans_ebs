    <bpmn:process id="W_W2785" name="W2785. Daily Card/E-Wallet Settlement File Ingestion &amp; GL Posting" isExecutable="false">
      <bpmn:documentation>Trigger: Daily settlement file from acquirer/e-wallet/gateway (T+1)
Frequency: Daily per partner
Volume: ~10 settlement files/day; ~PHP 2.9B/month non-cash tender
Owner: AR Settlement Accountant
Participants: AR Settlement Accountant, IT, Finance
Source: workflow W2785 — Daily Card/E-Wallet Settlement File Ingestion &amp; GL Posting</bpmn:documentation>
      <bpmn:laneSet id="W2785_LaneSet4">
        <bpmn:lane id="W2785_Lane1" name="IT">
        <bpmn:flowNodeRef>W2785_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2785_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2785_Lane2" name="AR Settlement Accountant">
        <bpmn:flowNodeRef>W2785_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2785_Lane3" name="Finance">
        <bpmn:flowNodeRef>W2785_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2785_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2785_Start5" name="Daily settlement file from acquirer/e-wallet/gateway (T+1)">
        <bpmn:outgoing>W2785_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2785_Task6" name="IT ingests daily settlement files (EDI/CSV/API) from each acquirer and e-wallet…">
        <bpmn:documentation>Step 1: IT ingests daily settlement files (EDI/CSV/API) from each acquirer and e-wallet into ERP settlement staging; validates file integrity and partner authentication
Responsible (R): IT
Accountable (A): AR Settlement Accountant
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W2785_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2785_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2785_Task7" name="AR Settlement Accountant posts settlement to clearing GL: gross captured, fees…">
        <bpmn:documentation>Step 2: AR Settlement Accountant posts settlement to clearing GL: gross captured, fees deducted, net bank credit; maps each batch by MID/entity/store
Responsible (R): AR Settlement Accountant
Accountable (A): Finance Controller
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W2785_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2785_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2785_Task8" name="Finance validates net settlement matches bank statement credit; investigates…">
        <bpmn:documentation>Step 3: Finance validates net settlement matches bank statement credit; investigates timing differences (T+1 vs. T+2) and currency (USD card settlements)
Responsible (R): Finance
Accountable (A): Finance Controller
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W2785_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2785_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2785_End9" name="Complete">
        <bpmn:incoming>W2785_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2785_Annotation10">
        <bpmn:text>Controls: - CTL-215 (ensure card/e-wallet settlement &amp; chargeback control.) | - operational: schema validation and partner pre-notification
Owner: AR Settlement Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2785_Assoc11" sourceRef="W2785_Annotation10" targetRef="W2785_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2785_Flow12" sourceRef="W2785_Start5" targetRef="W2785_Task6" />
      <bpmn:sequenceFlow id="W2785_Flow13" sourceRef="W2785_Task6" targetRef="W2785_Task7" />
      <bpmn:sequenceFlow id="W2785_Flow14" sourceRef="W2785_Task7" targetRef="W2785_Task8" />
      <bpmn:sequenceFlow id="W2785_Flow15" sourceRef="W2785_Task8" targetRef="W2785_End9" />
    </bpmn:process>
