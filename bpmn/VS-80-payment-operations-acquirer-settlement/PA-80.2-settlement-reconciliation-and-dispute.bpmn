    <bpmn:process id="W_W2786" name="W2786. Settlement-to-POS Capture Reconciliation &amp; Exception Triage" isExecutable="false">
      <bpmn:documentation>Trigger: Daily settlement posting
Frequency: Daily
Volume: ~2.8M POS txns/month; ~1.4M non-cash lines/month
Owner: AR Settlement Accountant
Participants: AR Settlement Accountant, Store Ops, IT
Source: workflow W2786 — Settlement-to-POS Capture Reconciliation &amp; Exception Triage</bpmn:documentation>
      <bpmn:laneSet id="W2786_LaneSet4">
        <bpmn:lane id="W2786_Lane1" name="ERP automation">
        <bpmn:flowNodeRef>W2786_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2786_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2786_Lane2" name="AR Settlement Accountant">
        <bpmn:flowNodeRef>W2786_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2786_Lane3" name="Store Ops">
        <bpmn:flowNodeRef>W2786_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2786_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2786_Start5" name="Daily settlement posting">
        <bpmn:outgoing>W2786_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2786_Task6" name="ERP auto-matches settlement records to POS capture by reference (RRN/auth…">
        <bpmn:documentation>Step 1: ERP auto-matches settlement records to POS capture by reference (RRN/auth code/QR ref); flags unmatched captures and unmatched settlements
Responsible (R): ERP automation
Accountable (A): AR Settlement Accountant
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W2786_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2786_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2786_Task7" name="AR Settlement Accountant triages exceptions: terminal batch not closed…">
        <bpmn:documentation>Step 2: AR Settlement Accountant triages exceptions: terminal batch not closed, declined-but-captured, duplicate capture, missing settlement; assigns owner
Responsible (R): AR Settlement Accountant
Accountable (A): Finance Controller
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W2786_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2786_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2786_Task8" name="Store Ops/IT resolves terminal-level issues (resend batch, manual settlement…">
        <bpmn:documentation>Step 3: Store Ops/IT resolves terminal-level issues (resend batch, manual settlement, RFI to acquirer); AR Settlement Accountant clears exception queue
Responsible (R): Store Ops / IT / AR Settlement Accountant
Accountable (A): Finance Controller
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W2786_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2786_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2786_End9" name="Complete">
        <bpmn:incoming>W2786_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2786_Annotation10">
        <bpmn:text>Controls: - CTL-215 (ensure card/e-wallet settlement &amp; chargeback control.) | - operational: daily SLA-bound triage
Owner: AR Settlement Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2786_Assoc11" sourceRef="W2786_Annotation10" targetRef="W2786_Start5" associationDirection="None" />
