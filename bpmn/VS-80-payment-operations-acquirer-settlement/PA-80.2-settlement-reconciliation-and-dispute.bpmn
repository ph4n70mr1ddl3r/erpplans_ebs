    <bpmn:process id="W_W2792" name="W2792. Aged Unreconciled Settlement &amp; Suspense GL Clearing" isExecutable="false">
      <bpmn:documentation>Trigger: Items aged &gt; 30 days in settlement suspense
Frequency: Weekly review + monthly close
Volume: ~200–400 aged items/month
Owner: AR Settlement Accountant
Participants: AR Settlement Accountant, Finance, Payment Ops Manager
Source: workflow W2792 — Aged Unreconciled Settlement &amp; Suspense GL Clearing</bpmn:documentation>
      <bpmn:laneSet id="W2792_LaneSet4">
        <bpmn:lane id="W2792_Lane1" name="AR Settlement Accountant">
        <bpmn:flowNodeRef>W2792_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2792_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2792_Lane2" name="Finance">
        <bpmn:flowNodeRef>W2792_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2792_Lane3" name="Payment Ops Manager">
        <bpmn:flowNodeRef>W2792_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2792_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2792_Start5" name="Items aged &gt; 30 days in settlement suspense">
        <bpmn:outgoing>W2792_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2792_Task6" name="AR Settlement Accountant reviews aged settlement suspense weekly; classifies…">
        <bpmn:documentation>Step 1: AR Settlement Accountant reviews aged settlement suspense weekly; classifies (acquirer error, timing, write-off candidate); assigns resolution owner
Responsible (R): AR Settlement Accountant
Accountable (A): Finance Controller
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W2792_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2792_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2792_Task7" name="Finance investigates root cause with acquirer/partner; recovers where possible…">
        <bpmn:documentation>Step 2: Finance investigates root cause with acquirer/partner; recovers where possible; provisions write-off for unrecoverable items &gt; 90 days
Responsible (R): Finance
Accountable (A): Finance Controller
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2792_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2792_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2792_Task8" name="Payment Ops Manager closes suspense items; reports aged suspense trend and…">
        <bpmn:documentation>Step 3: Payment Ops Manager closes suspense items; reports aged suspense trend and root-cause themes to management for systemic remediation
Responsible (R): Payment Ops Manager
Accountable (A): Finance Controller
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2792_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2792_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2792_End9" name="Complete">
        <bpmn:incoming>W2792_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2792_Annotation10">
        <bpmn:text>Controls: - CTL-470 (ensure controlled execution — Settlement Reconciliation &amp; Chargeback/Dispute Management (PA-80.2).) | - operational: 30/60/90 aging discipline and write-off governance
Owner: AR Settlement Accountant</bpmn:text>
      </bpmn:textAnnotation>
