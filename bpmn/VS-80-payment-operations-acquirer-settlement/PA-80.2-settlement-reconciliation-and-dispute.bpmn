    <bpmn:process id="W_W2788" name="W2788. Chargeback Notification, Evidence Compilation &amp; Representment" isExecutable="false">
      <bpmn:documentation>Trigger: Chargeback notification from acquirer (issuer dispute)
Frequency: Event-driven; ~300–500 chargebacks/year (~0.003% of card txns, per the ~30–40/month Volume)
Volume: ~30–40/month
Owner: Chargeback Analyst
Participants: Chargeback Analyst, Store Ops, LP, AR Settlement
Source: workflow W2788 — Chargeback Notification, Evidence Compilation &amp; Representment</bpmn:documentation>
      <bpmn:laneSet id="W2788_LaneSet3">
        <bpmn:lane id="W2788_Lane1" name="Chargeback Analyst">
        <bpmn:flowNodeRef>W2788_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2788_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2788_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2788_Lane2" name="Store Ops">
        <bpmn:flowNodeRef>W2788_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2788_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2788_Start4" name="Chargeback notification from acquirer (issuer dispute)">
        <bpmn:outgoing>W2788_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2788_Task5" name="Chargeback Analyst receives chargeback (fraud, friendly fraud, product not…">
        <bpmn:documentation>Step 1: Chargeback Analyst receives chargeback (fraud, friendly fraud, product not received, duplicate); logs in dispute tracker; pulls POS transaction evidence
Responsible (R): Chargeback Analyst
Accountable (A): Payment Operations Manager
Duration: Per dispute</bpmn:documentation>
        <bpmn:incoming>W2788_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2788_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2788_Task6" name="Store Ops/LP compiles compendium: signed charge slip, ID presented, CCTV…">
        <bpmn:documentation>Step 2: Store Ops/LP compiles compendium: signed charge slip, ID presented, CCTV timestamp, delivery proof/POD, BIR invoice, customer communication; assembles representment package
Responsible (R): Store Ops / LP
Accountable (A): Chargeback Analyst
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W2788_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2788_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2788_Task7" name="Chargeback Analyst submits representment via acquirer portal within scheme…">
        <bpmn:documentation>Step 3: Chargeback Analyst submits representment via acquirer portal within scheme deadline (typically 7–45 days); tracks outcome; books chargeback loss or reversal
Responsible (R): Chargeback Analyst
Accountable (A): Finance Controller
Duration: Per dispute</bpmn:documentation>
        <bpmn:incoming>W2788_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2788_Flow14</bpmn:outgoing>
      </bpmn:userTask>
