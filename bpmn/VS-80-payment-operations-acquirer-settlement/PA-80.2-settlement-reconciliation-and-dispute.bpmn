    <bpmn:process id="W_W2787" name="W2787. Mid-Batch / End-of-Day Terminal Close &amp; Capture Totals Validation" isExecutable="false">
      <bpmn:documentation>Trigger: Shift change and end-of-day per terminal
Frequency: 2–3× per day per terminal
Volume: 600 POS terminals × ~3 batches
Owner: Store Cashier Lead
Participants: Cashier, Store Manager, Payment Ops Manager
Source: workflow W2787 — Mid-Batch / End-of-Day Terminal Close &amp; Capture Totals Validation</bpmn:documentation>
      <bpmn:laneSet id="W2787_LaneSet4">
        <bpmn:lane id="W2787_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W2787_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2787_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2787_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W2787_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2787_Lane3" name="Payment Ops Manager">
        <bpmn:flowNodeRef>W2787_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2787_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2787_Start5" name="Shift change and end-of-day per terminal">
        <bpmn:outgoing>W2787_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2787_Task6" name="Cashier initiates terminal batch close (settlement) at shift/day end; prints…">
        <bpmn:documentation>Step 1: Cashier initiates terminal batch close (settlement) at shift/day end; prints batch totals per tender; reconciles to POS Z-report
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 10–15 min/terminal</bpmn:documentation>
        <bpmn:incoming>W2787_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2787_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2787_Task7" name="Store Manager validates capture totals vs. physical evidence (signed charge…">
        <bpmn:documentation>Step 2: Store Manager validates capture totals vs. physical evidence (signed charge slips, e-wallet confirmation); investigates variances; re-batches if needed
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W2787_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2787_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2787_Task8" name="Payment Ops Manager monitors chain-wide batch-close completion rate; escalates…">
        <bpmn:documentation>Step 3: Payment Ops Manager monitors chain-wide batch-close completion rate; escalates terminals with unclosed batches beyond SLA to prevent settlement delay
Responsible (R): Payment Ops Manager
Accountable (A): Finance Controller
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W2787_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2787_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2787_End9" name="Complete">
        <bpmn:incoming>W2787_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2787_Annotation10">
        <bpmn:text>Controls: - CTL-215 (ensure card/e-wallet settlement &amp; chargeback control.) | - operational: SLA monitoring and manager escalation
Owner: Store Cashier Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2787_Assoc11" sourceRef="W2787_Annotation10" targetRef="W2787_Start5" associationDirection="None" />
