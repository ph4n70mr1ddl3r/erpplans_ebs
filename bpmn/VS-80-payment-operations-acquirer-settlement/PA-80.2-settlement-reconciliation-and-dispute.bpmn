      </bpmn:startEvent>
      <bpmn:userTask id="W2790_Task6" name="Customer Service processes refund to original tender in POS/ecommerce…">
        <bpmn:documentation>Step 1: Customer Service processes refund to original tender in POS/ecommerce; generates reversal reference; ensures within scheme refund window
Responsible (R): Customer Service
Accountable (A): Store Manager
Duration: Per refund</bpmn:documentation>
        <bpmn:incoming>W2790_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2790_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2790_Task7" name="ERP auto-matches reversal to original capture; ensures settlement deduction…">
        <bpmn:documentation>Step 2: ERP auto-matches reversal to original capture; ensures settlement deduction equals refund; flags unmatched reversals for investigation
Responsible (R): ERP automation
Accountable (A): AR Settlement Accountant
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W2790_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2790_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2790_Task8" name="AR Settlement Accountant reconciles reversal settlement to bank debit; books…">
        <bpmn:documentation>Step 3: AR Settlement Accountant reconciles reversal settlement to bank debit; books refund liability and clears customer receivable; resolves timing differences
Responsible (R): AR Settlement Accountant
Accountable (A): Finance Controller
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W2790_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2790_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2790_End9" name="Complete">
        <bpmn:incoming>W2790_Flow15</bpmn:incoming>
      </bpmn:endEvent>
