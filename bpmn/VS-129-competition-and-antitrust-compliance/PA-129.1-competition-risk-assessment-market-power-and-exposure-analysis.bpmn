        <bpmndi:BPMNShape id="W3954_Task7_di" bpmnElement="W3954_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3954_Start4_di" bpmnElement="W3954_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
