    <bpmn:process id="W_W3954" name="W3954. Market Definition, Market Share &amp; Market Power Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: Annual assessment; new category/market; significant share change; M&amp;A (links to VS-130)
Frequency: Annual + on change
Volume: ~13 categories × relevant geographic markets
Owner: VP Legal / Strategy
Participants: Legal, Strategy (links to VS-33.3), Market Research/Insights (links to VS-44), Merchandising (links to VS-01), Finance (links to VS-17.4)
Source: workflow W3954 — Market Definition, Market Share &amp; Market Power Assessment</bpmn:documentation>
      <bpmn:laneSet id="W3954_LaneSet3">
        <bpmn:lane id="W3954_Lane1" name="Legal">
        <bpmn:flowNodeRef>W3954_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3954_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3954_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3954_Lane2" name="Strategy">
        <bpmn:flowNodeRef>W3954_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3954_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3954_Start4" name="Annual assessment; new category/market; significant share change; M&amp;A (links to VS-130)">
        <bpmn:outgoing>W3954_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3954_Task5" name="Legal/Strategy define the relevant product and geographic markets per PCC…">
        <bpmn:documentation>Step 1: Legal/Strategy define the relevant product and geographic markets per PCC guidelines (substitutability, SSNIP/hypothetical-monopolist reasoning) for each BuildRight category (lumber/building materials, tiles, plumbing, electrical, paint, tools, hardware, appliances, garden) and channel (big-box retail, B2B/trade, ecommerce, marketplace) — noting the Philippines big-box hardware/DIY market and provincial/regional sub-markets
Responsible (R): Legal / Strategy / Insights
Accountable (A): VP Legal
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3954_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3954_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3954_Task6" name="Strategy/Finance estimate BuildRight&#x27;s market share and position in each…">
        <bpmn:documentation>Step 2: Strategy/Finance estimate BuildRight&#x27;s market share and position in each relevant market (revenue-based, with caveats), identify whether BuildRight holds a *dominant position* (RA 10667 §15 presumption thresholds: ≥50% individual share, or the top two entities with ≥60% combined), and flag markets where dominance triggers special-conduct obligations
Responsible (R): Strategy / Finance / Legal
Accountable (A): VP Legal
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3954_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3954_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3954_Task7" name="Legal document the market-power assessment, retain evidence, and feed findings…">
        <bpmn:documentation>Step 3: Legal document the market-power assessment, retain evidence, and feed findings into the risk-tiering (W3961–W3967 controls) and any M&amp;A notification analysis (links to W3967); refresh on material change
Responsible (R): Legal / Strategy
Accountable (A): VP Legal
Duration: Annual + on change</bpmn:documentation>
        <bpmn:incoming>W3954_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3954_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3954_End8" name="Complete">
        <bpmn:incoming>W3954_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3954_Annotation9">
        <bpmn:text>Controls: - CTL-617 (ensure controlled execution — Competition Risk Assessment, Market Power &amp; Exposure Analysis (PA-129.1).) | - operational: substitutability analysis and PCC-guideline alignment; operational: retained analysis and refresh cycle
Owner: VP Legal / Strategy</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3954_Assoc10" sourceRef="W3954_Annotation9" targetRef="W3954_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3954_Flow11" sourceRef="W3954_Start4" targetRef="W3954_Task5" />
      <bpmn:sequenceFlow id="W3954_Flow12" sourceRef="W3954_Task5" targetRef="W3954_Task6" />
      <bpmn:sequenceFlow id="W3954_Flow13" sourceRef="W3954_Task6" targetRef="W3954_Task7" />
      <bpmn:sequenceFlow id="W3954_Flow14" sourceRef="W3954_Task7" targetRef="W3954_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3954_diag">
      <bpmndi:BPMNPlane id="W3954_plane" bpmnElement="W_W3954">
        <bpmndi:BPMNShape id="W3954_Lane1_di" bpmnElement="W3954_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3954_Lane2_di" bpmnElement="W3954_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
