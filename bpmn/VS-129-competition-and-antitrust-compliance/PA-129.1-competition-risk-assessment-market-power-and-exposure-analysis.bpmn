        <bpmndi:BPMNShape id="W3954_Annotation9_di" bpmnElement="W3954_Annotation9"><dc:Bounds x="160" y="460" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3954_Flow11_di" bpmnElement="W3954_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3954_Flow12_di" bpmnElement="W3954_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3954_Flow13_di" bpmnElement="W3954_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3954_Flow14_di" bpmnElement="W3954_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3954_Assoc10_di" bpmnElement="W3954_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3955" name="W3955. Pricing &amp; Promotional Conduct Competition Risk Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: Annual risk review; pricing-process change; PCC guidance update
Frequency: Annual + on change
Volume: Enterprise pricing/promotion risk assessment
Owner: VP Legal / VP Merchandising
Participants: Legal, Merchandising/Pricing (links to VS-01.2), Competitive Intelligence (links to VS-57), Marketing (links to VS-14/VS-58), Revenue Assurance (links to VS-118), Store Ops (links to VS-07)
Source: workflow W3955 — Pricing &amp; Promotional Conduct Competition Risk Assessment</bpmn:documentation>
      <bpmn:laneSet id="W3955_LaneSet2">
        <bpmn:lane id="W3955_Lane1" name="Legal">
        <bpmn:flowNodeRef>W3955_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3955_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3955_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3955_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3955_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3955_Start3" name="Annual risk review; pricing-process change; PCC guidance update">
        <bpmn:outgoing>W3955_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3955_Task4" name="Legal/Merchandising assess pricing-conduct risk: how BuildRight gathers…">
        <bpmn:documentation>Step 1: Legal/Merchandising assess pricing-conduct risk: how BuildRight gathers competitor prices (VS-57), how it responds tactically (W329), guarantees/price-match (W61), DTI price-freeze compliance (W468), and markdown/promo mechanics (VS-64/VS-58) — ensuring none cross into price-fixing, signaling, or concerted parallel conduct with competitors
Responsible (R): Legal / Merchandising / Competitive Intel
Accountable (A): VP Legal / VP Merchandising
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3955_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3955_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3955_Task5" name="Legal assess promotional-conduct risk: coordinated promotions with competitors…">
        <bpmn:documentation>Step 2: Legal assess promotional-conduct risk: coordinated promotions with competitors, vendor-funded promos that could facilitate RPM or MFN effects, and loyalty/gift-card mechanics (links to VS-13/VS-54) that could exclude competitors
Responsible (R): Legal / Marketing
Accountable (A): VP Legal
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3955_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3955_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3955_Task6" name="Legal document risk findings and issue control requirements into W3961 (pricing…">
        <bpmn:documentation>Step 3: Legal document risk findings and issue control requirements into W3961 (pricing decision controls); feed new risks into training (W3960) and audit (W3968)
Responsible (R): Legal
Accountable (A): VP Legal
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3955_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3955_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3955_End7" name="Complete">
        <bpmn:incoming>W3955_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3955_Annotation8">
        <bpmn:text>Controls: - CTL-617 (ensure controlled execution — Competition Risk Assessment, Market Power &amp; Exposure Analysis (PA-129.1).) | - CTL-159 (ensure competition-law conduct.) | - operational: unilateral-action documentation; operational: RPM/most-favored-nation review (W3956)
Owner: VP Legal / VP Merchandising</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3955_Assoc9" sourceRef="W3955_Annotation8" targetRef="W3955_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3955_Flow10" sourceRef="W3955_Start3" targetRef="W3955_Task4" />
      <bpmn:sequenceFlow id="W3955_Flow11" sourceRef="W3955_Task4" targetRef="W3955_Task5" />
      <bpmn:sequenceFlow id="W3955_Flow12" sourceRef="W3955_Task5" targetRef="W3955_Task6" />
      <bpmn:sequenceFlow id="W3955_Flow13" sourceRef="W3955_Task6" targetRef="W3955_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3955_diag">
      <bpmndi:BPMNPlane id="W3955_plane" bpmnElement="W_W3955">
        <bpmndi:BPMNShape id="W3955_Lane1_di" bpmnElement="W3955_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3955_Task4_di" bpmnElement="W3955_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3955_Task5_di" bpmnElement="W3955_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3955_Task6_di" bpmnElement="W3955_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3955_Start3_di" bpmnElement="W3955_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3955_End7_di" bpmnElement="W3955_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3955_Annotation8_di" bpmnElement="W3955_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3955_Flow10_di" bpmnElement="W3955_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3955_Flow11_di" bpmnElement="W3955_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3955_Flow12_di" bpmnElement="W3955_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3955_Flow13_di" bpmnElement="W3955_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3955_Assoc9_di" bpmnElement="W3955_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3956" name="W3956. Vendor / Trade-Partner Vertical-Restraint &amp; RPM Risk Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: Annual risk review; new vendor/channel agreement; trade-program change
Frequency: Annual + on change
Volume: ~800–1,000 vendors; trade/B2B channel; sari-sari/MSME program
Owner: VP Legal / VP Supply Chain
Participants: Legal, Procurement (links to VS-03), Merchandising (links to VS-01), Trade/B2B Sales (links to VS-11), Trade Pro Program (links to VS-43), Sari-Sari/MSME (links to VS-82), Franchise/Dealer (if any)
Source: workflow W3956 — Vendor / Trade-Partner Vertical-Restraint &amp; RPM Risk Assessment</bpmn:documentation>
      <bpmn:laneSet id="W3956_LaneSet2">
        <bpmn:lane id="W3956_Lane1" name="Legal">
        <bpmn:flowNodeRef>W3956_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3956_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3956_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3956_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3956_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3956_Start3" name="Annual risk review; new vendor/channel agreement; trade-program change">
        <bpmn:outgoing>W3956_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3956_Task4" name="Legal/Procurement assess vertical-restraint risk in vendor and trade…">
        <bpmn:documentation>Step 1: Legal/Procurement assess vertical-restraint risk in vendor and trade agreements: resale price maintenance (RPM — directly prohibited by RA 10667 §14(a)), exclusivity clauses, most-favored-nation/pricing-parity clauses, territory/customer restrictions, tying/bundling, and supplier-imposed MAP (minimum advertised price) regimes
Responsible (R): Legal / Procurement / Merchandising
Accountable (A): VP Legal / VP Supply Chain
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3956_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3956_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3956_Task5" name="Legal/Trade-Sales assess trade-channel conduct risk: how BuildRight…">
        <bpmn:documentation>Step 2: Legal/Trade-Sales assess trade-channel conduct risk: how BuildRight *recommends* vs *imposes* resale pricing on trade pros/resellers (VS-43/VS-82), consignment/VMI (VS-45), and any selective-distribution criteria that could exclude lawful competitors
Responsible (R): Legal / Trade Sales
Accountable (A): VP Legal
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3956_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3956_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3956_Task6" name="Legal issue control requirements into W3962 (vendor-agreement/RPM clause…">
        <bpmn:documentation>Step 3: Legal issue control requirements into W3962 (vendor-agreement/RPM clause review) and the contract-review gate; refresh on program/vendor changes
Responsible (R): Legal
Accountable (A): VP Legal
Duration: Annual + on change</bpmn:documentation>
        <bpmn:incoming>W3956_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3956_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3956_End7" name="Complete">
        <bpmn:incoming>W3956_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3956_Annotation8">
        <bpmn:text>Controls: - CTL-617 (ensure controlled execution — Competition Risk Assessment, Market Power &amp; Exposure Analysis (PA-129.1).) | - CTL-159 (ensure competition-law conduct.) | - operational: recommendation-only model and clause controls; operational: clause review and effect-based analysis
Owner: VP Legal / VP Supply Chain</bpmn:text>
      </bpmn:textAnnotation>
