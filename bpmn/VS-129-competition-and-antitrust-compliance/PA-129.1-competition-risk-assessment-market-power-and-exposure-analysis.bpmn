<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-129.1-competition-risk-assessment-market-power-and-exposure-analysis" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3953" name="W3953. Competition &amp; Antitrust Compliance Program Strategy, Governance &amp; Operating Model" isExecutable="false">
      <bpmn:documentation>Trigger: Annual strategy (links to VS-33.1); program stand-up; regulatory change
Frequency: Annual + on change
Volume: Enterprise competition-compliance program (5 entities)
Owner: VP Legal &amp; Compliance / Chief Compliance Officer
Participants: Legal (links to VS-100), Compliance (links to VS-22/VS-119), Merchandising/Pricing (links to VS-01.2/VS-57), Procurement (links to VS-03/VS-34), Trade/B2B Sales (links to VS-11/VS-43/VS-82), Corp Dev (links to VS-130), Govt Affairs (links to VS-104), Internal Audit (links to VS-21), HR/L&amp;D (links to VS-19.4)
Source: workflow W3953 — Competition &amp; Antitrust Compliance Program Strategy, Governance &amp; Operating Model</bpmn:documentation>
      <bpmn:laneSet id="W3953_LaneSet3">
        <bpmn:lane id="W3953_Lane1" name="VP Legal &amp; Compliance">
        <bpmn:flowNodeRef>W3953_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3953_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3953_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3953_Lane2" name="CEO">
        <bpmn:flowNodeRef>W3953_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3953_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3953_Start4" name="Annual strategy (links to VS-33.1); program stand-up; regulatory change">
        <bpmn:outgoing>W3953_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3953_Task5" name="VP Legal &amp; Compliance define the competition-compliance program: scope (all 5…">
        <bpmn:documentation>Step 1: VP Legal &amp; Compliance define the competition-compliance program: scope (all 5 entities, all product categories, all channels — POS, ecommerce, marketplace, B2B/trade, B2G), framework (RA 10667 + IRR + PCC guidelines + foreign regimes where BuildRight&#x27;s B2B customers/export-import touchpoints apply), governance (Board Audit/Risk Committee oversight, Compliance-led operating model, business-unit compliance partners), and KPIs (risk-coverage %, training completion, control-testing pass rate, incidents, PCC engagements)
Responsible (R): VP Legal &amp; Compliance
Accountable (A): CEO / Board Audit Committee
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3953_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3953_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3953_Task6" name="VP Legal &amp; Compliance map the program to BuildRight&#x27;s risk surface and assign…">
        <bpmn:documentation>Step 2: VP Legal &amp; Compliance map the program to BuildRight&#x27;s risk surface and assign accountability: pricing (Merchandising), vendor/channel contracts (Procurement + Legal), associations (Govt Affairs), procurement/buyer-power (Procurement), digital/marketplace (Ecommerce/Digital Commerce Inc.), M&amp;A (Corp Dev); integrate with ethics/speak-up (links to VS-119), audit (links to VS-21), records (links to VS-88), and the existing single workflow W2683 (now superseded as the program summary)
Responsible (R): VP Legal &amp; Compliance
Accountable (A): CEO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3953_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3953_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3953_Task7" name="CEO/Board ratify the strategy, approve the compliance budget and resourcing…">
        <bpmn:documentation>Step 3: CEO/Board ratify the strategy, approve the compliance budget and resourcing, and cascade competition compliance as a board-level enterprise risk (links to VS-21.2 ERM and VS-36 governance)
Responsible (R): CEO / Board
Accountable (A): Board Audit Committee
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3953_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3953_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3953_End8" name="Complete">
        <bpmn:incoming>W3953_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3953_Annotation9">
        <bpmn:text>Controls: - CTL-617 (ensure controlled execution — Competition Risk Assessment, Market Power &amp; Exposure Analysis (PA-129.1).) | - CTL-159 (ensure competition-law conduct.) | - operational: program-level ownership and embedded compliance partners; operational: elevation to a dedicated program
Owner: VP Legal &amp; Compliance / Chief Compliance Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3953_Assoc10" sourceRef="W3953_Annotation9" targetRef="W3953_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3953_Flow11" sourceRef="W3953_Start4" targetRef="W3953_Task5" />
      <bpmn:sequenceFlow id="W3953_Flow12" sourceRef="W3953_Task5" targetRef="W3953_Task6" />
      <bpmn:sequenceFlow id="W3953_Flow13" sourceRef="W3953_Task6" targetRef="W3953_Task7" />
      <bpmn:sequenceFlow id="W3953_Flow14" sourceRef="W3953_Task7" targetRef="W3953_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3953_diag">
      <bpmndi:BPMNPlane id="W3953_plane" bpmnElement="W_W3953">
        <bpmndi:BPMNShape id="W3953_Lane1_di" bpmnElement="W3953_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3953_Lane2_di" bpmnElement="W3953_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
