        <bpmndi:BPMNEdge id="W3962_Assoc9_di" bpmnElement="W3962_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3963" name="W3963. Joint Venture, Strategic Alliance &amp; Cooperation Agreement Clearance" isExecutable="false">
      <bpmn:documentation>Trigger: Proposed JV/alliance/cooperation/consortium
Frequency: Per proposal
Volume: Occasional (growth-stage company)
Owner: VP Legal / Corp Dev
Participants: Legal, Corp Dev (links to VS-130), Strategy (links to VS-33), Procurement (links to VS-03), affected business unit, Govt Affairs (links to VS-104)
Source: workflow W3963 — Joint Venture, Strategic Alliance &amp; Cooperation Agreement Clearance</bpmn:documentation>
      <bpmn:laneSet id="W3963_LaneSet2">
        <bpmn:lane id="W3963_Lane1" name="Legal">
        <bpmn:flowNodeRef>W3963_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3963_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3963_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3963_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3963_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3963_Start3" name="Proposed JV/alliance/cooperation/consortium">
        <bpmn:outgoing>W3963_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3963_Task4" name="Legal conduct a competition-clearance assessment of the proposed…">
        <bpmn:documentation>Step 1: Legal conduct a competition-clearance assessment of the proposed JV/alliance/cooperation: market overlap, potential coordination of competitively sensitive information, buyer-power/seller-power effects, foreclosure risk, and whether the arrangement meets PCC notification thresholds (links to W3967)
Responsible (R): Legal / Corp Dev / Strategy
Accountable (A): VP Legal
Duration: Per proposal</bpmn:documentation>
        <bpmn:incoming>W3963_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3963_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3963_Task5" name="Legal structure guardrails: clean-team/information-barrier protocols, scope…">
        <bpmn:documentation>Step 2: Legal structure guardrails: clean-team/information-barrier protocols, scope limits, non-competitor-exchange rules, exit rights, and any required notifications/exemptions; integrate into the agreement (links to VS-100.3)
Responsible (R): Legal
Accountable (A): VP Legal
Duration: Per proposal</bpmn:documentation>
        <bpmn:incoming>W3963_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3963_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3963_Task6" name="Legal/Corp Dev document the clearance decision, file any required PCC…">
        <bpmn:documentation>Step 3: Legal/Corp Dev document the clearance decision, file any required PCC notification (links to W3967), and establish post-close monitoring of the arrangement
Responsible (R): Legal / Corp Dev
Accountable (A): VP Legal
Duration: Per proposal + ongoing</bpmn:documentation>
        <bpmn:incoming>W3963_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3963_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3963_End7" name="Complete">
        <bpmn:incoming>W3963_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3963_Annotation8">
        <bpmn:text>Controls: - CTL-618 (ensure controlled execution — Anti-Competitive Conduct Prevention &amp; Compliance Controls (PA-129.2).) | - operational: clean-team and staging; operational: threshold check (W3967)
Owner: VP Legal / Corp Dev</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3963_Assoc9" sourceRef="W3963_Annotation8" targetRef="W3963_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3963_Flow10" sourceRef="W3963_Start3" targetRef="W3963_Task4" />
      <bpmn:sequenceFlow id="W3963_Flow11" sourceRef="W3963_Task4" targetRef="W3963_Task5" />
      <bpmn:sequenceFlow id="W3963_Flow12" sourceRef="W3963_Task5" targetRef="W3963_Task6" />
      <bpmn:sequenceFlow id="W3963_Flow13" sourceRef="W3963_Task6" targetRef="W3963_End7" />
    </bpmn:process>
