<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-129.2-anticompetitive-conduct-prevention-and-compliance-controls" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3961" name="W3961. Pricing Decision &amp; Competitor-Information-Exchange Controls" isExecutable="false">
      <bpmn:documentation>Trigger: Pricing decision; competitive-intel activity; info-sharing request
Frequency: Continuous
Volume: ~Thousands of pricing decisions/yr; ongoing competitive monitoring
Owner: VP Merchandising / VP Legal
Participants: Merchandising/Pricing (links to VS-01.2), Competitive Intel (links to VS-57), Marketing (links to VS-14), Revenue Assurance (links to VS-118), Store Ops (links to VS-07)
Source: workflow W3961 — Pricing Decision &amp; Competitor-Information-Exchange Controls</bpmn:documentation>
      <bpmn:laneSet id="W3961_LaneSet3">
        <bpmn:lane id="W3961_Lane1" name="Merchandising">
        <bpmn:flowNodeRef>W3961_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3961_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3961_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3961_Lane2" name="Legal">
        <bpmn:flowNodeRef>W3961_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3961_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3961_Start4" name="Pricing decision; competitive-intel activity; info-sharing request">
        <bpmn:outgoing>W3961_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3961_Task5" name="Merchandising/Pricing document every significant pricing decision (SRP, trade…">
        <bpmn:documentation>Step 1: Merchandising/Pricing document every significant pricing decision (SRP, trade price, promo, markdown) as a *unilateral* BuildRight decision with internal-cost/margin basis, and route competitively sensitive inputs only through controlled channels (public sources, legitimate VS-57 intelligence)
Responsible (R): Merchandising / Pricing
Accountable (A): VP Merchandising
Duration: Per decision</bpmn:documentation>
        <bpmn:incoming>W3961_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3961_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3961_Task6" name="Legal maintain the competitor-information-exchange control: no exchanges with…">
        <bpmn:documentation>Step 2: Legal maintain the competitor-information-exchange control: no exchanges with competitors of future prices, output, margins, costs, territories, customers, or bidding plans; a &quot;clean team&quot; protocol for any legitimately acquired third-party data; and immediate-escalation guidance if a competitor raises a prohibited topic
Responsible (R): Legal / Pricing / Competitive Intel
Accountable (A): VP Legal
Duration: Maintained</bpmn:documentation>
        <bpmn:incoming>W3961_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3961_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3961_Task7" name="Merchandising/Legal log the decision record and basis (links to records VS-88)…">
        <bpmn:documentation>Step 3: Merchandising/Legal log the decision record and basis (links to records VS-88), and feed anomalies to monitoring/audit (W3968) and speak-up (links to VS-119)
Responsible (R): Merchandising / Legal
Accountable (A): VP Merchandising
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3961_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3961_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3961_End8" name="Complete">
        <bpmn:incoming>W3961_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3961_Annotation9">
        <bpmn:text>Controls: - CTL-618 (ensure controlled execution — Anti-Competitive Conduct Prevention &amp; Compliance Controls (PA-129.2).) | - operational: decision record and clean-team protocol; operational: escalation protocol and documentation
Owner: VP Merchandising / VP Legal</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3961_Assoc10" sourceRef="W3961_Annotation9" targetRef="W3961_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3961_Flow11" sourceRef="W3961_Start4" targetRef="W3961_Task5" />
      <bpmn:sequenceFlow id="W3961_Flow12" sourceRef="W3961_Task5" targetRef="W3961_Task6" />
      <bpmn:sequenceFlow id="W3961_Flow13" sourceRef="W3961_Task6" targetRef="W3961_Task7" />
      <bpmn:sequenceFlow id="W3961_Flow14" sourceRef="W3961_Task7" targetRef="W3961_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3961_diag">
      <bpmndi:BPMNPlane id="W3961_plane" bpmnElement="W_W3961">
        <bpmndi:BPMNShape id="W3961_Lane1_di" bpmnElement="W3961_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3961_Lane2_di" bpmnElement="W3961_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
