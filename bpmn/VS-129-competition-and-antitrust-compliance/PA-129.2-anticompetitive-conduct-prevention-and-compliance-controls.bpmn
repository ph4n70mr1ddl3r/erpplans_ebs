      <bpmndi:BPMNPlane id="W3962_plane" bpmnElement="W_W3962">
        <bpmndi:BPMNShape id="W3962_Lane1_di" bpmnElement="W3962_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
