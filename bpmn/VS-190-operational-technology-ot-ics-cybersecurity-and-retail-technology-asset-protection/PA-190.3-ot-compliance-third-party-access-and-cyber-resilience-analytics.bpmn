<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-190.3-ot-compliance-third-party-access-and-cyber-resilience-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W5433" name="W5433. OT-Aware Third-Party / Vendor Remote-Access Governance &amp; Session Recording" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor service contract setup; remote-support request; periodic recertification
Frequency: Setup per vendor; per remote session; quarterly recertification
Volume: ~50–150 vendor/contractor organizations with potential OT remote access (BMS, fire, SCADA, EV, locker, POS service, IFM providers); ~100s–1,000s sessions/yr
Owner: OT Security Lead
Participants: Vendor service teams, IFM (VS-138), Procurement (VS-34), VS-161 TPRM, Legal (VS-100), HSE (VS-24)
Source: workflow W5433 — OT-Aware Third-Party / Vendor Remote-Access Governance &amp; Session Recording</bpmn:documentation>
      <bpmn:laneSet id="W5433_LaneSet5">
        <bpmn:lane id="W5433_Lane1" name="OT Security Engineer">
        <bpmn:flowNodeRef>W5433_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5433_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5433_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5433_Lane2" name="Procurement">
        <bpmn:flowNodeRef>W5433_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5433_Lane3" name="OT Security Analyst">
        <bpmn:flowNodeRef>W5433_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5433_Lane4" name="OT SOC Analyst">
        <bpmn:flowNodeRef>W5433_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5433_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5433_Start6" name="Vendor service contract setup; remote-support request; periodic recertification">
        <bpmn:outgoing>W5433_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5433_Task7" name="Require every vendor OT remote session to traverse a BuildRight-controlled…">
        <bpmn:documentation>Step 1: Require every vendor OT remote session to traverse a BuildRight-controlled jump-host/bastion with MFA, just-in-time approval, and full session recording — never a vendor VPN/modem direct to the controller.
Responsible (R): OT Security Engineer
Accountable (A): OT Security Lead
Duration: setup</bpmn:documentation>
        <bpmn:incoming>W5433_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5433_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5433_Task8" name="Contractually bind vendors (via Procurement/VS-34 and TPRM/VS-161) to cyber…">
        <bpmn:documentation>Step 2: Contractually bind vendors (via Procurement/VS-34 and TPRM/VS-161) to cyber terms: no standing access, notification of compromise, SBOM/vuln disclosure, personnel vetting (VS-167).
Responsible (R): Procurement / Legal
Accountable (A): VP Legal &amp; Compliance
Duration: per contract</bpmn:documentation>
        <bpmn:incoming>W5433_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5433_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5433_Task9" name="Approve each session against a ticket with business justification + ops…">
        <bpmn:documentation>Step 3: Approve each session against a ticket with business justification + ops sign-off (especially for safety-system access); time-box the access.
Responsible (R): OT Security Analyst
Accountable (A): OT Security Lead
Duration: per session</bpmn:documentation>
        <bpmn:incoming>W5433_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5433_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5433_Task10" name="Record and review sessions (sampling + 100% for safety-system access); alert on…">
        <bpmn:documentation>Step 4: Record and review sessions (sampling + 100% for safety-system access); alert on policy violation (off-hours, out-of-scope device, file transfer).
Responsible (R): OT SOC Analyst
Accountable (A): OT SOC Lead
Duration: per session</bpmn:documentation>
        <bpmn:incoming>W5433_Flow18</bpmn:incoming>
        <bpmn:outgoing>W5433_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5433_Task11" name="Revoke and offboard vendor access at contract end or on TPRM trigger (VS-161) —…">
        <bpmn:documentation>Step 5: Revoke and offboard vendor access at contract end or on TPRM trigger (VS-161) — confirm zero residual paths (W5423).
Responsible (R): OT Security Engineer
Accountable (A): OT Security Lead
Duration: per offboard</bpmn:documentation>
        <bpmn:incoming>W5433_Flow19</bpmn:incoming>
        <bpmn:outgoing>W5433_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5433_End12" name="Complete">
        <bpmn:incoming>W5433_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5433_Annotation13">
        <bpmn:text>Controls: - CTL-802 (ensure controlled execution — OT Compliance, Third-Party Access &amp; Cyber Resilience Analytics (PA-190.3).) | - operational: least privilege / JIT vendor access; session recording via bastion host; no vendor direct network path to any OT controller.
Owner: OT Security Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5433_Assoc14" sourceRef="W5433_Annotation13" targetRef="W5433_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W5433_Flow15" sourceRef="W5433_Start6" targetRef="W5433_Task7" />
      <bpmn:sequenceFlow id="W5433_Flow16" sourceRef="W5433_Task7" targetRef="W5433_Task8" />
      <bpmn:sequenceFlow id="W5433_Flow17" sourceRef="W5433_Task8" targetRef="W5433_Task9" />
      <bpmn:sequenceFlow id="W5433_Flow18" sourceRef="W5433_Task9" targetRef="W5433_Task10" />
      <bpmn:sequenceFlow id="W5433_Flow19" sourceRef="W5433_Task10" targetRef="W5433_Task11" />
      <bpmn:sequenceFlow id="W5433_Flow20" sourceRef="W5433_Task11" targetRef="W5433_End12" />
    </bpmn:process>
