      <bpmn:sequenceFlow id="W5434_Flow16" sourceRef="W5434_Task7" targetRef="W5434_Task8" />
      <bpmn:sequenceFlow id="W5434_Flow17" sourceRef="W5434_Task8" targetRef="W5434_Task9" />
      <bpmn:sequenceFlow id="W5434_Flow18" sourceRef="W5434_Task9" targetRef="W5434_End10" />
    </bpmn:process>
