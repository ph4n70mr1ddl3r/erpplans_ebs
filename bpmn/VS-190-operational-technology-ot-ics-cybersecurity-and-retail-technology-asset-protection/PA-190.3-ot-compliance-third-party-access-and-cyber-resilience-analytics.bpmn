    <bpmn:process id="W_W5438" name="W5438. OT Cyber Awareness, Engineering-Workstation Hygiene &amp; Insider-Threat Controls" isExecutable="false">
      <bpmn:documentation>Trigger: Onboarding; recurring awareness cycle; insider-threat signal (VS-125/VS-119)
Frequency: Annual training + targeted; continuous hygiene monitoring
Volume: ~300–500 OT engineering/maintenance users + vendor personnel (incl. contingent per VS-98)
Owner: OT Security Lead
Participants: HR/L&amp;D (VS-19.4), VS-167 vetting, IFM (VS-138), VS-98 contingent workforce, VS-125 fraud/insider
Source: workflow W5438 — OT Cyber Awareness, Engineering-Workstation Hygiene &amp; Insider-Threat Controls</bpmn:documentation>
      <bpmn:laneSet id="W5438_LaneSet5">
        <bpmn:lane id="W5438_Lane1" name="OT Security Analyst">
        <bpmn:flowNodeRef>W5438_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5438_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5438_Lane2" name="OT Security Engineer">
        <bpmn:flowNodeRef>W5438_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5438_Lane3" name="OT SOC Analyst">
        <bpmn:flowNodeRef>W5438_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5438_Lane4" name="OT Security Lead">
        <bpmn:flowNodeRef>W5438_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5438_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5438_End12</bpmn:flowNodeRef>
