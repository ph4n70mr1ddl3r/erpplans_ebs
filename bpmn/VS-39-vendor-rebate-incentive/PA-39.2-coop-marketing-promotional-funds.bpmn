<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-39.2-coop-marketing-promotional-funds" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1795" name="W1795. Co-Op Advertising Fund Agreement &amp; Budget Allocation" isExecutable="false">
      <bpmn:documentation>Trigger: Annual vendor negotiation; new vendor onboarding
Frequency: ~50–80 co-op agreements negotiated/year
Volume: ~50–80 active co-op marketing agreements
Owner: CMO
Participants: CMO, Category Managers, VP Merchandising, Vendor Marketing
Source: workflow W1795 — Co-Op Advertising Fund Agreement &amp; Budget Allocation</bpmn:documentation>
      <bpmn:laneSet id="W1795_LaneSet3">
        <bpmn:lane id="W1795_Lane1" name="CMO">
        <bpmn:flowNodeRef>W1795_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1795_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1795_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1795_Lane2" name="Marketing">
        <bpmn:flowNodeRef>W1795_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1795_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1795_Start4" name="Annual vendor negotiation; new vendor onboarding">
        <bpmn:outgoing>W1795_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1795_Task5" name="CMO and VP Merchandising negotiate co-op advertising fund agreements with key…">
        <bpmn:documentation>Step 1: CMO and VP Merchandising negotiate co-op advertising fund agreements with key vendors: (a) fund structure: % of purchases (typically 1–3%) or fixed annual budget, (b) eligible activities: print catalogs, social media ads, in-store displays, events, TV/radio, digital banners, (c) approval process: BuildRight proposes activity → vendor approves → execute → submit proof → vendor reimburses, (d) pre-approval: some vendors require pre-approval of all activities; others allow post-execution claim, (e) fund cap: maximum annual co-op spend per vendor, (f) carry-over: unused funds expire or roll to next year (vendor-specific)
Responsible (R): CMO / VP Merchandising
Accountable (A): CFO
Duration: Per agreement</bpmn:documentation>
        <bpmn:incoming>W1795_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1795_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1795_Task6" name="System setup: co-op marketing fund per vendor: (a) annual budget/fund amount…">
        <bpmn:documentation>Step 2: System setup: co-op marketing fund per vendor: (a) annual budget/fund amount, (b) approved activity types, (c) pre-approval requirement flag, (d) reimbursement rate (% of cost covered, typically 50–100%), (e) documentation requirements
Responsible (R): Marketing / System
Accountable (A): CMO
Duration: 30 min/agreement</bpmn:documentation>
        <bpmn:incoming>W1795_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1795_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1795_Task7" name="CMO allocates co-op budget across marketing calendar: (a) bi-monthly catalog…">
        <bpmn:documentation>Step 3: CMO allocates co-op budget across marketing calendar: (a) bi-monthly catalog: vendor co-op for product feature space (full page: PHP 50–100K; half page: PHP 25–50K), (b) social media campaigns: vendor co-op for sponsored posts, (c) in-store displays: vendor co-op for endcap and feature display materials, (d) events: vendor co-op for workshop sponsorship per VS-12.3, (e) seasonal campaigns: vendor co-op for holiday promotions
Responsible (R): CMO
Accountable (A): VP Merchandising
Duration: Quarterly planning</bpmn:documentation>
        <bpmn:incoming>W1795_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1795_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1795_End8" name="Complete">
        <bpmn:incoming>W1795_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1795_Annotation9">
        <bpmn:text>Controls: - CTL-359 (ensure controlled execution — Co-Op Marketing &amp; Promotional Fund Management (PA-39.2).) | - operational: CMO review and approval gate
Owner: CMO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1795_Assoc10" sourceRef="W1795_Annotation9" targetRef="W1795_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1795_Flow11" sourceRef="W1795_Start4" targetRef="W1795_Task5" />
      <bpmn:sequenceFlow id="W1795_Flow12" sourceRef="W1795_Task5" targetRef="W1795_Task6" />
      <bpmn:sequenceFlow id="W1795_Flow13" sourceRef="W1795_Task6" targetRef="W1795_Task7" />
      <bpmn:sequenceFlow id="W1795_Flow14" sourceRef="W1795_Task7" targetRef="W1795_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1795_diag">
      <bpmndi:BPMNPlane id="W1795_plane" bpmnElement="W_W1795">
        <bpmndi:BPMNShape id="W1795_Lane1_di" bpmnElement="W1795_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1795_Lane2_di" bpmnElement="W1795_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
