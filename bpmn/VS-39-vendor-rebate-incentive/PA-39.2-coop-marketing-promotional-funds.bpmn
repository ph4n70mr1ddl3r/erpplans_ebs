    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1796" name="W1796. Vendor-Funded Promotional Activity Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Promotional calendar cycle (6 major events/year)
Frequency: ~6–10 promotional plans/year
Volume: ~30–50 vendor-funded promotional activities per cycle
Owner: CMO
Participants: CMO, Category Managers, VP Merchandising, key vendors
Source: workflow W1796 — Vendor-Funded Promotional Activity Planning</bpmn:documentation>
      <bpmn:laneSet id="W1796_LaneSet3">
        <bpmn:lane id="W1796_Lane1" name="CMO">
        <bpmn:flowNodeRef>W1796_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1796_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1796_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1796_Lane2" name="Category Managers">
        <bpmn:flowNodeRef>W1796_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1796_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1796_Start4" name="Promotional calendar cycle (6 major events/year)">
        <bpmn:outgoing>W1796_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1796_Task5" name="For each promotional event: CMO and Category Managers identify vendor-funded…">
        <bpmn:documentation>Step 1: For each promotional event: CMO and Category Managers identify vendor-funded promotional opportunities: (a) which vendors will participate in the catalog feature, (b) which vendors will fund endcap displays, (c) which vendors will provide promotional pricing (vendor absorbs markdown cost), (d) which vendors will contribute to digital marketing campaign, (e) target: vendor funding covers 30–50% of total promotional marketing cost
Responsible (R): CMO / Category Managers
Accountable (A): VP Merchandising
Duration: 1–2 weeks/cycle</bpmn:documentation>
        <bpmn:incoming>W1796_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1796_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1796_Task6" name="Category Managers contact vendors with promotional proposals: (a) catalog…">
        <bpmn:documentation>Step 2: Category Managers contact vendors with promotional proposals: (a) catalog placement offer (with pricing), (b) endcap display opportunity (with expected traffic and sales lift), (c) digital advertising package (with audience reach), (d) vendor responds with commitment and budget
Responsible (R): Category Managers
Accountable (A): CMO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1796_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1796_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1796_Task7" name="CMO compiles vendor commitments into promotional plan: (a) total vendor funding…">
        <bpmn:documentation>Step 3: CMO compiles vendor commitments into promotional plan: (a) total vendor funding committed, (b) BuildRight&#x27;s own marketing spend, (c) combined promotional plan with activity schedule, (d) ROI projection: expected sales lift vs. total promotional cost
Responsible (R): CMO
Accountable (A): VP Merchandising
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1796_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1796_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1796_End8" name="Complete">
        <bpmn:incoming>W1796_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1796_Annotation9">
        <bpmn:text>Controls: - CTL-359 (ensure controlled execution — Co-Op Marketing &amp; Promotional Fund Management (PA-39.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: CMO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1796_Assoc10" sourceRef="W1796_Annotation9" targetRef="W1796_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1796_Flow11" sourceRef="W1796_Start4" targetRef="W1796_Task5" />
      <bpmn:sequenceFlow id="W1796_Flow12" sourceRef="W1796_Task5" targetRef="W1796_Task6" />
      <bpmn:sequenceFlow id="W1796_Flow13" sourceRef="W1796_Task6" targetRef="W1796_Task7" />
      <bpmn:sequenceFlow id="W1796_Flow14" sourceRef="W1796_Task7" targetRef="W1796_End8" />
    </bpmn:process>
