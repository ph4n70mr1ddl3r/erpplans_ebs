        <bpmndi:BPMNEdge id="W1796_Flow13_di" bpmnElement="W1796_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1796_Flow14_di" bpmnElement="W1796_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1796_Assoc10_di" bpmnElement="W1796_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1797" name="W1797. Co-Op Marketing Activity Execution &amp; Vendor Notification" isExecutable="false">
      <bpmn:documentation>Trigger: Promotional activity start date
Frequency: ~50–100 activities/year
Volume: Varies per promotional cycle
Owner: Marketing Team
Participants: Marketing Team, Category Managers, Vendors, Stores
Source: workflow W1797 — Co-Op Marketing Activity Execution &amp; Vendor Notification</bpmn:documentation>
      <bpmn:laneSet id="W1797_LaneSet2">
        <bpmn:lane id="W1797_Lane1" name="Marketing Team">
        <bpmn:flowNodeRef>W1797_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1797_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1797_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1797_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1797_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1797_Start3" name="Promotional activity start date">
        <bpmn:outgoing>W1797_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1797_Task4" name="Execute co-op marketing activity per plan: (a) catalog distributed (print and…">
        <bpmn:documentation>Step 1: Execute co-op marketing activity per plan: (a) catalog distributed (print and digital), (b) in-store displays set up per vendor-approved layout, (c) social media posts published with vendor product features, (d) email campaign sent to loyalty members, (e) digital ads launched on Facebook, Google, and marketplace platforms
Responsible (R): Marketing Team
Accountable (A): CMO
Duration: Per activity schedule</bpmn:documentation>
        <bpmn:incoming>W1797_Flow10</bpmn:incoming>
        <bpmn:outgoing>W1797_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1797_Task5" name="Vendor notification of activity execution: (a) send vendor proof of execution…">
        <bpmn:documentation>Step 2: Vendor notification of activity execution: (a) send vendor proof of execution (photos of displays, screenshots of digital ads, catalog copies), (b) activity dates and scope confirmation, (c) any deviations from agreed plan documented and explained
Responsible (R): Marketing Team
Accountable (A): —
Duration: 1–2 days post-execution</bpmn:documentation>
        <bpmn:incoming>W1797_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1797_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1797_Task6" name="Store compliance: (a) marketing sends display setup instructions to stores, (b)…">
        <bpmn:documentation>Step 3: Store compliance: (a) marketing sends display setup instructions to stores, (b) stores execute display per planogram, (c) store sends photo confirmation to marketing, (d) marketing verifies compliance and addresses non-compliant stores
Responsible (R): Marketing Team / Store Manager
Accountable (A): CMO
Duration: During promotional period</bpmn:documentation>
        <bpmn:incoming>W1797_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1797_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1797_End7" name="Complete">
        <bpmn:incoming>W1797_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1797_Annotation8">
        <bpmn:text>Controls: - CTL-359 (ensure controlled execution — Co-Op Marketing &amp; Promotional Fund Management (PA-39.2).) | - operational: Marketing Team review and approval gate
Owner: Marketing Team</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1797_Assoc9" sourceRef="W1797_Annotation8" targetRef="W1797_Start3" associationDirection="None" />
