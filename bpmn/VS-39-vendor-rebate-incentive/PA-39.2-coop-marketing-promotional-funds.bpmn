      <bpmn:sequenceFlow id="W1797_Flow11" sourceRef="W1797_Task4" targetRef="W1797_Task5" />
      <bpmn:sequenceFlow id="W1797_Flow12" sourceRef="W1797_Task5" targetRef="W1797_Task6" />
      <bpmn:sequenceFlow id="W1797_Flow13" sourceRef="W1797_Task6" targetRef="W1797_End7" />
    </bpmn:process>
