      <bpmndi:BPMNPlane id="W1797_plane" bpmnElement="W_W1797">
        <bpmndi:BPMNShape id="W1797_Lane1_di" bpmnElement="W1797_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1797_Task4_di" bpmnElement="W1797_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1797_Task5_di" bpmnElement="W1797_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1797_Task6_di" bpmnElement="W1797_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1797_Start3_di" bpmnElement="W1797_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1797_End7_di" bpmnElement="W1797_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1797_Annotation8_di" bpmnElement="W1797_Annotation8"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1797_Flow10_di" bpmnElement="W1797_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1797_Flow11_di" bpmnElement="W1797_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1797_Flow12_di" bpmnElement="W1797_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1797_Flow13_di" bpmnElement="W1797_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1797_Assoc9_di" bpmnElement="W1797_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1798" name="W1798. Co-Op Marketing Expense Documentation &amp; Proof of Performance" isExecutable="false">
      <bpmn:documentation>Trigger: Co-op marketing activity completed
Frequency: ~50–100 documentation packages/year
Volume: 1 proof-of-performance package per activity per vendor
Owner: Marketing Team
Participants: Marketing Team, AP Manager, Vendor
Source: workflow W1798 — Co-Op Marketing Expense Documentation &amp; Proof of Performance</bpmn:documentation>
      <bpmn:laneSet id="W1798_LaneSet3">
        <bpmn:lane id="W1798_Lane1" name="Marketing Team">
        <bpmn:flowNodeRef>W1798_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1798_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1798_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1798_Lane2" name="AP Manager">
        <bpmn:flowNodeRef>W1798_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1798_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1798_Start4" name="Co-op marketing activity completed">
        <bpmn:outgoing>W1798_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1798_Task5" name="Marketing Team compiles proof-of-performance (POP) documentation: (a)…">
        <bpmn:documentation>Step 1: Marketing Team compiles proof-of-performance (POP) documentation: (a) invoice/receipt for marketing expenses (print costs, ad placement fees, display materials), (b) photos of in-store displays (front view, side view, product close-up with pricing), (c) screenshots of digital ads (with date, platform, reach/impressions metrics), (d) catalog copy with vendor product placement highlighted, (e) sales report for promoted items during activity period (vs. baseline), (f) activity summary: dates, stores participating, results
Responsible (R): Marketing Team
Accountable (A): CMO
Duration: 1–2 days/activity</bpmn:documentation>
        <bpmn:incoming>W1798_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1798_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1798_Task6" name="POP package reviewed by AP Manager for completeness: (a) all required…">
        <bpmn:documentation>Step 2: POP package reviewed by AP Manager for completeness: (a) all required documentation per vendor agreement present, (b) expense amounts match invoices, (c) photos meet vendor requirements (clear, dated, correct stores), (d) any missing documentation requested from Marketing before submission
Responsible (R): AP Manager
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1798_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1798_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1798_Task7" name="POP package submitted to vendor: (a) via vendor portal (preferred), (b) via…">
        <bpmn:documentation>Step 3: POP package submitted to vendor: (a) via vendor portal (preferred), (b) via email to vendor marketing contact, (c) retained in system for audit trail
Responsible (R): Marketing Team / AP Manager
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1798_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1798_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1798_End8" name="Complete">
        <bpmn:incoming>W1798_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1798_Annotation9">
        <bpmn:text>Controls: - CTL-359 (ensure controlled execution — Co-Op Marketing &amp; Promotional Fund Management (PA-39.2).) | - operational: Marketing Team review and approval gate
Owner: Marketing Team</bpmn:text>
      </bpmn:textAnnotation>
