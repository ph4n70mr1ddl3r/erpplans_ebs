      <bpmn:sequenceFlow id="W3872_Flow11" sourceRef="W3872_Task4" targetRef="W3872_Task5" />
      <bpmn:sequenceFlow id="W3872_Flow12" sourceRef="W3872_Task5" targetRef="W3872_Task6" />
      <bpmn:sequenceFlow id="W3872_Flow13" sourceRef="W3872_Task6" targetRef="W3872_End7" />
    </bpmn:process>
