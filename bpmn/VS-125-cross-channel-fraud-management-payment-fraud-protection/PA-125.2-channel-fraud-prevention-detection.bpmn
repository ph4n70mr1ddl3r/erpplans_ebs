<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-125.2-channel-fraud-prevention-detection" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3865" name="W3865. POS / Store Transaction Fraud Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: POS transaction stream (links to VS-08); exception alert
Frequency: Continuous (~2.8M POS txns/month across 600 terminals)
Volume: ~33.6M POS txns/yr; ~0.05–0.2% flagged for review
Owner: Fraud Management / Store Ops
Participants: Fraud Management, Store Ops (links to VS-07), Cashiers (links to VS-08), Loss Prevention (links to VS-23), POS/IT (links to VS-08/VS-27), Payments (links to VS-80), HR (links to VS-19)
Source: workflow W3865 — POS / Store Transaction Fraud Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W3865_LaneSet2">
        <bpmn:lane id="W3865_Lane1" name="Fraud Management">
        <bpmn:flowNodeRef>W3865_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3865_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3865_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3865_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3865_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3865_Start3" name="POS transaction stream (links to VS-08); exception alert">
        <bpmn:outgoing>W3865_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3865_Task4" name="Fraud Management/Store-Ops monitor POS for in-store fraud patterns: cashier…">
        <bpmn:documentation>Step 1: Fraud Management/Store-Ops monitor POS for in-store fraud patterns: cashier sweethearting/price-override, no-sale/cash-drawer anomalies, manual-price and markdown abuse (links to VS-01.2/W36), barcode-switch, false refunds, fictitious voids, loyalty-point farming at POS, and EAS-bypass on high-value items (links to VS-23) — using exception reports and scoring (links to W3859)
Responsible (R): Fraud Management / LP / Store Ops
Accountable (A): Fraud Management Lead
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W3865_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3865_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3865_Task5" name="Fraud Management/LP investigate flagged cashiers/transactions (till audit, CCTV…">
        <bpmn:documentation>Step 2: Fraud Management/LP investigate flagged cashiers/transactions (till audit, CCTV sync links to VS-23, journal review links to VS-08), confirm or dismiss, and route employee fraud to HR/Internal (links to W3876)
Responsible (R): Fraud Management / LP / Store Ops
Accountable (A): Fraud Management Lead
Duration: Per alert</bpmn:documentation>
        <bpmn:incoming>W3865_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3865_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3865_Task6" name="Fraud Management/Payments handle card-present fraud (skimming/clone…">
        <bpmn:documentation>Step 3: Fraud Management/Payments handle card-present fraud (skimming/clone, stolen-card use), coordinate with acquirer (links to VS-80) and law enforcement for organized rings (links to W3877), and tighten store controls (manager override thresholds links to VS-08)
Responsible (R): Fraud Management / Payments / LP
Accountable (A): Fraud Management Lead
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W3865_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3865_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3865_End7" name="Complete">
        <bpmn:incoming>W3865_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3865_Annotation8">
        <bpmn:text>Controls: - CTL-605 (ensure controlled execution — Channel-Specific Fraud Prevention &amp; Detection (PA-125.2).) | - operational: CCTV sync and exception analytics; operational: override thresholds and audit (links to VS-08/W1475)
Owner: Fraud Management / Store Ops</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3865_Assoc9" sourceRef="W3865_Annotation8" targetRef="W3865_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3865_Flow10" sourceRef="W3865_Start3" targetRef="W3865_Task4" />
      <bpmn:sequenceFlow id="W3865_Flow11" sourceRef="W3865_Task4" targetRef="W3865_Task5" />
      <bpmn:sequenceFlow id="W3865_Flow12" sourceRef="W3865_Task5" targetRef="W3865_Task6" />
      <bpmn:sequenceFlow id="W3865_Flow13" sourceRef="W3865_Task6" targetRef="W3865_End7" />
    </bpmn:process>
