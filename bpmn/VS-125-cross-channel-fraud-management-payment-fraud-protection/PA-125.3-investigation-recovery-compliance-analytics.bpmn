      <bpmn:sequenceFlow id="W3874_Flow11" sourceRef="W3874_Task4" targetRef="W3874_Task5" />
      <bpmn:sequenceFlow id="W3874_Flow12" sourceRef="W3874_Task5" targetRef="W3874_Task6" />
      <bpmn:sequenceFlow id="W3874_Flow13" sourceRef="W3874_Task6" targetRef="W3874_End7" />
    </bpmn:process>
