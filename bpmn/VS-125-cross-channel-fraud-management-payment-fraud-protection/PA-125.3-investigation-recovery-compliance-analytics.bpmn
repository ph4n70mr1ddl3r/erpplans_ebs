<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-125.3-investigation-recovery-compliance-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3873" name="W3873. Fraud Investigation, Evidence &amp; Case Adjudication" isExecutable="false">
      <bpmn:documentation>Trigger: Confirmed-fraud case (links to W3860); escalated alert
Frequency: Continuous
Volume: ~3,000–8,000 confirmed cases/yr
Owner: Fraud Management
Participants: Fraud Investigators, Legal (links to VS-100), LP (links to VS-23), Channels (links to VS-07/VS-10/VS-80/VS-13), Privacy (links to VS-91), HR for employee cases (links to VS-19)
Source: workflow W3873 — Fraud Investigation, Evidence &amp; Case Adjudication</bpmn:documentation>
      <bpmn:laneSet id="W3873_LaneSet3">
        <bpmn:lane id="W3873_Lane1" name="Fraud Investigators">
        <bpmn:flowNodeRef>W3873_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3873_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3873_Lane2" name="Fraud Management">
        <bpmn:flowNodeRef>W3873_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3873_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3873_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3873_Start4" name="Confirmed-fraud case (links to W3860); escalated alert">
        <bpmn:outgoing>W3873_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3873_Task5" name="Investigators conduct structured investigation per typology (links to W3858)…">
        <bpmn:documentation>Step 1: Investigators conduct structured investigation per typology (links to W3858): transaction reconstruction, CCTV/POS-journal correlation (links to VS-08/VS-23), digital forensics for ATO/ecommerce (links to VS-10/VS-27.3), interview of staff/customers, and structured evidence pack with chain-of-custody
Responsible (R): Fraud Investigators / LP / IT Security
Accountable (A): Fraud Management Lead
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W3873_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3873_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3873_Task6" name="Investigators adjudicate against the evidence standard (confirmed / probable /…">
        <bpmn:documentation>Step 2: Investigators adjudicate against the evidence standard (confirmed / probable / dismissed), determine loss quantum and recovery potential (links to W3874), and decide referral path (recovery, law-enforcement links to W3877, employment action links to W3876, insurance links to VS-26)
Responsible (R): Fraud Management / Legal
Accountable (A): Fraud Management Lead
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W3873_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3873_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3873_Task7" name="Fraud Management close cases with root-cause, control-gap identification, and…">
        <bpmn:documentation>Step 3: Fraud Management close cases with root-cause, control-gap identification, and learning fed back to rules/models/policy (links to W3862) and to the typology catalog (links to W3858)
Responsible (R): Fraud Management
Accountable (A): Fraud Management Lead
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W3873_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3873_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3873_End8" name="Complete">
        <bpmn:incoming>W3873_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3873_Annotation9">
        <bpmn:text>Controls: - CTL-606 (ensure controlled execution — Investigation, Recovery, Compliance &amp; Analytics (PA-125.3).) | - operational: chain-of-custody discipline and Legal review; operational: closed-loop feedback to W3862
Owner: Fraud Management</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3873_Assoc10" sourceRef="W3873_Annotation9" targetRef="W3873_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3873_Flow11" sourceRef="W3873_Start4" targetRef="W3873_Task5" />
      <bpmn:sequenceFlow id="W3873_Flow12" sourceRef="W3873_Task5" targetRef="W3873_Task6" />
      <bpmn:sequenceFlow id="W3873_Flow13" sourceRef="W3873_Task6" targetRef="W3873_Task7" />
      <bpmn:sequenceFlow id="W3873_Flow14" sourceRef="W3873_Task7" targetRef="W3873_End8" />
    </bpmn:process>
