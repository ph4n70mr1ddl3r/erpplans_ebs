      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3875" name="W3875. Chargeback Representment &amp; Dispute Management" isExecutable="false">
      <bpmn:documentation>Trigger: Chargeback received (links to W3870); dispute cycle
Frequency: Continuous
Volume: ~thousands of chargebacks/yr; representment win-rate target ≥65%
Owner: Fraud Management / Payments
Participants: Fraud Management, Payments (links to VS-80), Ecommerce (links to VS-10), Logistics (links to VS-06/VS-56), Legal (links to VS-100), Finance (links to VS-17), CX (links to VS-13), Insights (links to VS-28.1)
Source: workflow W3875 — Chargeback Representment &amp; Dispute Management</bpmn:documentation>
      <bpmn:laneSet id="W3875_LaneSet2">
        <bpmn:lane id="W3875_Lane1" name="Fraud Management">
        <bpmn:flowNodeRef>W3875_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3875_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3875_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3875_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3875_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3875_Start3" name="Chargeback received (links to W3870); dispute cycle">
        <bpmn:outgoing>W3875_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3875_Task4" name="Fraud Management/Payments triage chargebacks by reason code (fraud vs…">
        <bpmn:documentation>Step 1: Fraud Management/Payments triage chargebacks by reason code (fraud vs service/quality vs authorization), decide contest-vs-accept, and route service-disputes to CX/quality (links to VS-13/VS-31) and fraud-disputes to representment
Responsible (R): Fraud Management / Payments
Accountable (A): Fraud Management Lead
Duration: Per chargeback</bpmn:documentation>
        <bpmn:incoming>W3875_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3875_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3875_Task5" name="Fraud Management/Logistics assemble and submit representment within scheme SLA…">
        <bpmn:documentation>Step 2: Fraud Management/Logistics assemble and submit representment within scheme SLA (Visa/Mastercard/QRPh): order details, delivery POD/photo/signature (links to VS-06.3), IP/device match, auth/AVS results, customer comms, prior history
Responsible (R): Fraud Management / Logistics / Payments
Accountable (A): Fraud Management Lead
Duration: Per chargeback</bpmn:documentation>
        <bpmn:incoming>W3875_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3875_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3875_Task6" name="Fraud Management/Insights track representment outcomes (win-rate, pre-arb, fee…">
        <bpmn:documentation>Step 3: Fraud Management/Insights track representment outcomes (win-rate, pre-arb, fee leakage links to VS-118), identify serial chargeback customers (links to VS-126), and feed learnings to ecommerce scoring (links to W3866) and acquirer relationships (links to VS-80)
Responsible (R): Fraud Management / Insights / Payments
Accountable (A): Fraud Management Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3875_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3875_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3875_End7" name="Complete">
        <bpmn:incoming>W3875_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3875_Annotation8">
        <bpmn:text>Controls: - CTL-606 (ensure controlled execution — Investigation, Recovery, Compliance &amp; Analytics (PA-125.3).) | - operational: SLA tracker and pre-assembled evidence templates; operational: analytics (links to VS-118)
Owner: Fraud Management / Payments</bpmn:text>
      </bpmn:textAnnotation>
