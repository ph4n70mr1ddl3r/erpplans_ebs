        <bpmn:outgoing>W3221_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3221_Task6" name="Coordinator reconcile agency invoice to approved time/deliverables (W3220) and…">
        <bpmn:documentation>Step 1: Coordinator reconcile agency invoice to approved time/deliverables (W3220) and contracted rate card (W3213): verify headcount/shifts/hours, rates, SLA credits/penalties (W3212), wage-order pass-through adjustments; flag variances &gt; tolerance
Responsible (R): Coordinator / Finance
Accountable (A): Contingent Workforce Mgr
Duration: Per invoice</bpmn:documentation>
        <bpmn:incoming>W3221_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3221_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3221_Task7" name="Finance/AP (links to VS-15) validate supplier master, PO/contract reference…">
        <bpmn:documentation>Step 2: Finance/AP (links to VS-15) validate supplier master, PO/contract reference, BIR-compliant invoice (links to VS-79 e-invoicing), withholding tax (EWT on services per VS-79.2 — expanded withholding), VAT; route for approval per authority matrix
Responsible (R): AP Clerk / Finance
Accountable (A): Controller
Duration: Per invoice</bpmn:documentation>
        <bpmn:incoming>W3221_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3221_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3221_Task8" name="User Dept/Coordinator approve service acceptance (deliverables met); Finance…">
        <bpmn:documentation>Step 3: User Dept/Coordinator approve service acceptance (deliverables met); Finance processes payment (links to VS-15.2); post to correct cost center/category (links to VS-34.3 expense monitoring); retain records (links to VS-88)
Responsible (R): User Dept / Finance
Accountable (A): Controller
Duration: Per invoice</bpmn:documentation>
        <bpmn:incoming>W3221_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3221_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3221_End9" name="Complete">
        <bpmn:incoming>W3221_Flow15</bpmn:incoming>
      </bpmn:endEvent>
