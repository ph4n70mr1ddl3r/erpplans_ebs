        <bpmndi:BPMNEdge id="W3217_Flow12_di" bpmnElement="W3217_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3217_Flow13_di" bpmnElement="W3217_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3217_Flow14_di" bpmnElement="W3217_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3217_Assoc10_di" bpmnElement="W3217_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3218" name="W3218. Contractor Onboarding, Badging &amp; Site Access" isExecutable="false">
      <bpmn:documentation>Trigger: New contractor worker assigned to a BuildRight site
Frequency: Per worker assignment
Volume: Hundreds–thousands of worker assignments/year (security/janitorial turnover)
Owner: Contingent Workforce Coordinator
Participants: Coordinator, HR (links to VS-19), Safety (links to VS-24), Security (links to VS-23), IT (links to VS-27 for system access), Agency
Source: workflow W3218 — Contractor Onboarding, Badging &amp; Site Access</bpmn:documentation>
      <bpmn:laneSet id="W3218_LaneSet2">
        <bpmn:lane id="W3218_Lane1" name="Coordinator">
        <bpmn:flowNodeRef>W3218_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3218_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3218_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3218_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3218_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3218_Start3" name="New contractor worker assigned to a BuildRight site">
        <bpmn:outgoing>W3218_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3218_Task4" name="Coordinator registers contractor worker in contingent-workforce system…">
        <bpmn:documentation>Step 1: Coordinator registers contractor worker in contingent-workforce system (distinct from BuildRight employee master — links to VS-29 extended masters): name, agency, role/category, assignment location/duration, emergency contact, screening status (W3223), photo for badge; record worker personal data per Data Privacy Act (links to VS-91) with consent
Responsible (R): Coordinator / HR
Accountable (A): Contingent Workforce Mgr
Duration: 15–30 min/worker</bpmn:documentation>
        <bpmn:incoming>W3218_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3218_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3218_Task5" name="Issue site badge (visual + access control): contractor badge visually distinct…">
        <bpmn:documentation>Step 2: Issue site badge (visual + access control): contractor badge visually distinct from employee badge; time-limited to assignment; access scoped to assigned areas only (not back-office systems); enroll in access-control system (links to VS-23.2 physical security); collect and log access
Responsible (R): Coordinator / Security
Accountable (A): Contingent Workforce Mgr
Duration: Per worker</bpmn:documentation>
        <bpmn:incoming>W3218_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3218_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3218_Task6" name="Complete onboarding checklist: safety orientation (W3219), asset/uniform if…">
        <bpmn:documentation>Step 3: Complete onboarding checklist: safety orientation (W3219), asset/uniform if applicable (W3222), system access if required (minimal — links to VS-27 least-privilege), site orientation; document completion before site entry
Responsible (R): Coordinator / Safety / User Dept
Accountable (A): Contingent Workforce Mgr
Duration: Per worker</bpmn:documentation>
        <bpmn:incoming>W3218_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3218_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3218_End7" name="Complete">
        <bpmn:incoming>W3218_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3218_Annotation8">
        <bpmn:text>Controls: - CTL-524 (ensure controlled execution — Contingent Worker Onboarding, Access &amp; Time Operations (PA-98.2).) | - operational: time-limited badges and access review (W3216); operational: purpose-limited collection and consent (links to VS-91)
Owner: Contingent Workforce Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3218_Assoc9" sourceRef="W3218_Annotation8" targetRef="W3218_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3218_Flow10" sourceRef="W3218_Start3" targetRef="W3218_Task4" />
      <bpmn:sequenceFlow id="W3218_Flow11" sourceRef="W3218_Task4" targetRef="W3218_Task5" />
      <bpmn:sequenceFlow id="W3218_Flow12" sourceRef="W3218_Task5" targetRef="W3218_Task6" />
      <bpmn:sequenceFlow id="W3218_Flow13" sourceRef="W3218_Task6" targetRef="W3218_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3218_diag">
      <bpmndi:BPMNPlane id="W3218_plane" bpmnElement="W_W3218">
        <bpmndi:BPMNShape id="W3218_Lane1_di" bpmnElement="W3218_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3218_Task4_di" bpmnElement="W3218_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3218_Task5_di" bpmnElement="W3218_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3218_Task6_di" bpmnElement="W3218_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3218_Start3_di" bpmnElement="W3218_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3218_End7_di" bpmnElement="W3218_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3218_Annotation8_di" bpmnElement="W3218_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3218_Flow10_di" bpmnElement="W3218_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3218_Flow11_di" bpmnElement="W3218_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3218_Flow12_di" bpmnElement="W3218_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3218_Flow13_di" bpmnElement="W3218_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3218_Assoc9_di" bpmnElement="W3218_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3219" name="W3219. Contractor Safety Orientation &amp; Permit-to-Work" isExecutable="false">
      <bpmn:documentation>Trigger: First site assignment; high-risk task (hot work, working at height, electrical, confined space)
Frequency: Per worker + per high-risk task
Volume: All contractor workers + project-specific permits
Owner: Safety Officer
Participants: Safety Officer (links to VS-24), User Dept, Contractor Supervisor, Worker
Source: workflow W3219 — Contractor Safety Orientation &amp; Permit-to-Work</bpmn:documentation>
      <bpmn:laneSet id="W3219_LaneSet2">
        <bpmn:lane id="W3219_Lane1" name="Safety Officer">
        <bpmn:flowNodeRef>W3219_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3219_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3219_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3219_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3219_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3219_Start3" name="First site assignment; high-risk task (hot work, working at height, electrical, confined…">
        <bpmn:outgoing>W3219_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3219_Task4" name="Safety Officer deliver general contractor safety orientation: site hazards…">
        <bpmn:documentation>Step 1: Safety Officer deliver general contractor safety orientation: site hazards (forklifts, racking, chemicals, electrical, slips/trips/falls), emergency procedures (links to VS-24.2), PPE requirements (links to VS-24.1), incident reporting (W3228), BuildRight HSE rules; quiz/acknowledgement before site entry
Responsible (R): Safety Officer
Accountable (A): Safety Mgr
Duration: 30–60 min/worker</bpmn:documentation>
        <bpmn:incoming>W3219_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3219_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3219_Task5" name="For high-risk tasks, issue permit-to-work (PTW): hot work, working at height…">
        <bpmn:documentation>Step 2: For high-risk tasks, issue permit-to-work (PTW): hot work, working at height, electrical live work, confined space, excavation, lockout-tagout (LOTO); verify competency/certification (e.g., scaffold erector, forklift operator per VS-06.2), isolation, fire watch, rescue plan; PTW time-boxed and signed off
Responsible (R): Safety Officer / Contractor Supervisor
Accountable (A): Safety Mgr
Duration: Per task</bpmn:documentation>
        <bpmn:incoming>W3219_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3219_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3219_Task6" name="Monitor compliance: Safety/Store Ops spot-check PTW and PPE compliance; enforce…">
        <bpmn:documentation>Step 3: Monitor compliance: Safety/Store Ops spot-check PTW and PPE compliance; enforce stop-work authority for unsafe conditions; record violations and feed contractor scorecard (W3225) and HSE metrics (links to VS-24.1)
Responsible (R): Safety Officer / User Dept
Accountable (A): Safety Mgr
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W3219_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3219_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3219_End7" name="Complete">
        <bpmn:incoming>W3219_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3219_Annotation8">
        <bpmn:text>Controls: - CTL-121 (ensure lawful contracting &amp; worker classification.) | - operational: no-orientation-no-entry rule and PTW; operational: spot-checks and stop-work authority
Owner: Safety Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3219_Assoc9" sourceRef="W3219_Annotation8" targetRef="W3219_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3219_Flow10" sourceRef="W3219_Start3" targetRef="W3219_Task4" />
      <bpmn:sequenceFlow id="W3219_Flow11" sourceRef="W3219_Task4" targetRef="W3219_Task5" />
      <bpmn:sequenceFlow id="W3219_Flow12" sourceRef="W3219_Task5" targetRef="W3219_Task6" />
      <bpmn:sequenceFlow id="W3219_Flow13" sourceRef="W3219_Task6" targetRef="W3219_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3219_diag">
      <bpmndi:BPMNPlane id="W3219_plane" bpmnElement="W_W3219">
        <bpmndi:BPMNShape id="W3219_Lane1_di" bpmnElement="W3219_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3219_Task4_di" bpmnElement="W3219_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3219_Task5_di" bpmnElement="W3219_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3219_Task6_di" bpmnElement="W3219_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3219_Start3_di" bpmnElement="W3219_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3219_End7_di" bpmnElement="W3219_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3219_Annotation8_di" bpmnElement="W3219_Annotation8"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3219_Flow10_di" bpmnElement="W3219_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3219_Flow11_di" bpmnElement="W3219_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3219_Flow12_di" bpmnElement="W3219_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3219_Flow13_di" bpmnElement="W3219_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3219_Assoc9_di" bpmnElement="W3219_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3220" name="W3220. Time Tracking, Attendance &amp; Deliverable Confirmation" isExecutable="false">
      <bpmn:documentation>Trigger: Daily shifts; deliverable completion
Frequency: Daily
Volume: Hundreds–thousands of daily shifts
Owner: Contingent Workforce Coordinator
Participants: Coordinator, User Dept, Agency, Contractor Supervisor
Source: workflow W3220 — Time Tracking, Attendance &amp; Deliverable Confirmation</bpmn:documentation>
      <bpmn:laneSet id="W3220_LaneSet4">
        <bpmn:lane id="W3220_Lane1" name="Agency">
        <bpmn:flowNodeRef>W3220_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3220_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3220_Lane2" name="User Dept">
        <bpmn:flowNodeRef>W3220_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3220_Lane3" name="Coordinator">
        <bpmn:flowNodeRef>W3220_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3220_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3220_Start5" name="Daily shifts; deliverable completion">
        <bpmn:outgoing>W3220_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3220_Task6" name="Agency/Contractor Supervisor capture worker time-in/time-out per shift…">
        <bpmn:documentation>Step 1: Agency/Contractor Supervisor capture worker time-in/time-out per shift (biometric or badge per W3218 access-control) and deliverables completed (cleaning checklist, security log, promodizer report); submit daily timesheet/deliverable record to BuildRight
Responsible (R): Agency / Contractor Supervisor
Accountable (A): Contingent Workforce Mgr
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W3220_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3220_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3220_Task7" name="User Dept/Coordinator confirm coverage and deliverables against SOW (W3212)…">
        <bpmn:documentation>Step 2: User Dept/Coordinator confirm coverage and deliverables against SOW (W3212): required posts/coverage met, deliverables completed to standard, exceptions (absence, shortfall, quality issues) flagged
Responsible (R): User Dept / Coordinator
Accountable (A): Contingent Workforce Mgr
