        <bpmn:flowNodeRef>W3222_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3222_Start3" name="Worker assignment (issue); worker exit (recovery)">
        <bpmn:outgoing>W3222_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3222_Task4" name="Coordinator/Facilities issue BuildRight-provided assets to contractor workers…">
        <bpmn:documentation>Step 1: Coordinator/Facilities issue BuildRight-provided assets to contractor workers where required (PPE, radio, keys, uniform, badge, mobile device, RF gun per VS-99); record issuance against worker/agency in asset-tracking (links to VS-35/VS-99); agency-provided assets (uniforms, cleaning equipment) remain agency responsibility
Responsible (R): Coordinator / Facilities
Accountable (A): Contingent Workforce Mgr
Duration: Per worker</bpmn:documentation>
        <bpmn:incoming>W3222_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3222_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3222_Task5" name="During assignment, maintain accountability: periodic asset audit, replacement…">
        <bpmn:documentation>Step 2: During assignment, maintain accountability: periodic asset audit, replacement of worn/damaged items, chargeback for loss where contractually permitted; ensure PPE replaced per HSE schedule (links to VS-24.1)
Responsible (R): Coordinator / Facilities
Accountable (A): Contingent Workforce Mgr
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W3222_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3222_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3222_Task6" name="On exit (W3216), recover all BuildRight-issued assets before final access…">
        <bpmn:documentation>Step 3: On exit (W3216), recover all BuildRight-issued assets before final access revocation and final invoice settlement (W3221); document recovery or loss; revoke badge/access (W3218)
Responsible (R): Coordinator / Security / Facilities
Accountable (A): Contingent Workforce Mgr
Duration: Per worker exit</bpmn:documentation>
        <bpmn:incoming>W3222_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3222_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3222_End7" name="Complete">
        <bpmn:incoming>W3222_Flow13</bpmn:incoming>
      </bpmn:endEvent>
