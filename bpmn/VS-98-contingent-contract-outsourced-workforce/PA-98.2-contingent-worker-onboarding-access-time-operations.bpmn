<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-98.2-contingent-worker-onboarding-access-time-operations" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3217" name="W3217. Work Order, Requisition &amp; Dispatch Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Operating need (shift coverage, project, event); scheduled or ad-hoc
Frequency: Daily for recurring services; event-driven for projects
Volume: ~200 stores + 4 DCs + HQ with recurring crews; ad-hoc project demand
Owner: Contingent Workforce Coordinator
Participants: Contingent Workforce Coordinator, User Dept (Store/DC/HQ), Agency, Contingent Workforce Mgr
Source: workflow W3217 — Work Order, Requisition &amp; Dispatch Coordination</bpmn:documentation>
      <bpmn:laneSet id="W3217_LaneSet3">
        <bpmn:lane id="W3217_Lane1" name="User Dept">
        <bpmn:flowNodeRef>W3217_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3217_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3217_Lane2" name="Coordinator">
        <bpmn:flowNodeRef>W3217_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3217_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3217_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3217_Start4" name="Operating need (shift coverage, project, event); scheduled or ad-hoc">
        <bpmn:outgoing>W3217_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3217_Task5" name="User Dept raise work order/requisition: category, headcount, location…">
        <bpmn:documentation>Step 1: User Dept raise work order/requisition: category, headcount, location, date/time window, scope/SOW reference (W3212), special requirements; route through Contingent Workforce Coordinator for approved-supplier dispatch
Responsible (R): User Dept / Coordinator
Accountable (A): User Dept Head
Duration: Per request</bpmn:documentation>
        <bpmn:incoming>W3217_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3217_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3217_Task6" name="Coordinator dispatches to approved agency (W3210) per MSA/SLA (W3213); agency…">
        <bpmn:documentation>Step 2: Coordinator dispatches to approved agency (W3210) per MSA/SLA (W3213); agency confirms worker assignment and sends worker roster (not individual direction by BuildRight — W3211); coordinator confirms acceptance and pre-engagement screening (W3223)
Responsible (R): Coordinator / Agency
Accountable (A): Contingent Workforce Mgr
Duration: Per request</bpmn:documentation>
        <bpmn:incoming>W3217_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3217_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3217_Task7" name="On completion, User Dept confirms deliverables/coverage against SOW…">
        <bpmn:documentation>Step 3: On completion, User Dept confirms deliverables/coverage against SOW (W3220/W3221); coordinator closes work order and triggers time capture (W3220) and invoice flow (W3221); log exceptions
Responsible (R): Coordinator / User Dept
Accountable (A): Contingent Workforce Mgr
Duration: Per request</bpmn:documentation>
        <bpmn:incoming>W3217_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3217_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3217_End8" name="Complete">
        <bpmn:incoming>W3217_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3217_Annotation9">
        <bpmn:text>Controls: - CTL-524 (ensure controlled execution — Contingent Worker Onboarding, Access &amp; Time Operations (PA-98.2).) | - operational: PO/work-order gating; operational: SLA penalty (W3212) and multi-supplier pool
Owner: Contingent Workforce Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3217_Assoc10" sourceRef="W3217_Annotation9" targetRef="W3217_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3217_Flow11" sourceRef="W3217_Start4" targetRef="W3217_Task5" />
      <bpmn:sequenceFlow id="W3217_Flow12" sourceRef="W3217_Task5" targetRef="W3217_Task6" />
      <bpmn:sequenceFlow id="W3217_Flow13" sourceRef="W3217_Task6" targetRef="W3217_Task7" />
      <bpmn:sequenceFlow id="W3217_Flow14" sourceRef="W3217_Task7" targetRef="W3217_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3217_diag">
      <bpmndi:BPMNPlane id="W3217_plane" bpmnElement="W_W3217">
        <bpmndi:BPMNShape id="W3217_Lane1_di" bpmnElement="W3217_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3217_Lane2_di" bpmnElement="W3217_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3217_Task5_di" bpmnElement="W3217_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3217_Task6_di" bpmnElement="W3217_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3217_Task7_di" bpmnElement="W3217_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
