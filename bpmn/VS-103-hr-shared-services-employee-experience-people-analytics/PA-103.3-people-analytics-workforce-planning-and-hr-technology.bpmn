      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3346" name="W3346. Recruitment Analytics, Time-to-Fill &amp; Hiring-Funnel Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Recruitment cycle; complements VS-19.1
Frequency: Monthly
Volume: ~1,200–1,600 hires/year (per profile §11.4)
Owner: People Analytics Manager
Participants: People Analytics Manager, Talent Acquisition (links to VS-19.1), HRBP, Finance (links to VS-17.4)
Source: workflow W3346 — Recruitment Analytics, Time-to-Fill &amp; Hiring-Funnel Reporting</bpmn:documentation>
      <bpmn:laneSet id="W3346_LaneSet2">
        <bpmn:lane id="W3346_Lane1" name="People Analytics Manager">
        <bpmn:flowNodeRef>W3346_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3346_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3346_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3346_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3346_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3346_Start3" name="Recruitment cycle; complements VS-19.1">
        <bpmn:outgoing>W3346_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3346_Task4" name="People Analytics Manager measure recruitment funnel: applications, screened…">
        <bpmn:documentation>Step 1: People Analytics Manager measure recruitment funnel: applications, screened, interviewed, offered, accepted, hired, by source/role/location; compute time-to-fill, cost-per-hire, offer-acceptance rate, quality-of-hire
Responsible (R): People Analytics Manager
Accountable (A): CHRO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3346_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3346_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3346_Task5" name="People Analytics Manager/Talent Acquisition identify bottlenecks (slow…">
        <bpmn:documentation>Step 2: People Analytics Manager/Talent Acquisition identify bottlenecks (slow sourcing, interview bottlenecks, low acceptance), source effectiveness, and diversity of pipeline (links to W3343); recommend sourcing/process improvements
Responsible (R): People Analytics Manager / Talent Acquisition
Accountable (A): CHRO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3346_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3346_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3346_Task6" name="People Analytics Manager report recruitment KPIs to CHRO and hiring managers…">
        <bpmn:documentation>Step 3: People Analytics Manager report recruitment KPIs to CHRO and hiring managers, benchmark to industry, and feed workforce plan (W3345) and budget (W3327)
Responsible (R): People Analytics Manager
Accountable (A): CHRO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3346_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3346_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3346_End7" name="Complete">
        <bpmn:incoming>W3346_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3346_Annotation8">
        <bpmn:text>Controls: - CTL-123 (ensure HR service delivery &amp; people-data accuracy.) | - operational: funnel analytics and pipeline; operational: source analytics
Owner: People Analytics Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3346_Assoc9" sourceRef="W3346_Annotation8" targetRef="W3346_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3346_Flow10" sourceRef="W3346_Start3" targetRef="W3346_Task4" />
      <bpmn:sequenceFlow id="W3346_Flow11" sourceRef="W3346_Task4" targetRef="W3346_Task5" />
      <bpmn:sequenceFlow id="W3346_Flow12" sourceRef="W3346_Task5" targetRef="W3346_Task6" />
      <bpmn:sequenceFlow id="W3346_Flow13" sourceRef="W3346_Task6" targetRef="W3346_End7" />
    </bpmn:process>
