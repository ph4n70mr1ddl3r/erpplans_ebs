      <bpmn:startEvent id="W3352_Start3" name="Process pain point; automation opportunity; complements VS-30">
        <bpmn:outgoing>W3352_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3352_Task4" name="HRSS Mgr map and baseline HR processes (recruitment, onboarding, payroll…">
        <bpmn:documentation>Step 1: HRSS Mgr map and baseline HR processes (recruitment, onboarding, payroll support, benefits, lifecycle, service center), identify waste/friction (case trends links to W3336, feedback links to W3342), and prioritize improvements
Responsible (R): HRSS Mgr / HR functions
Accountable (A): CHRO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3352_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3352_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3352_Task5" name="HRSS Mgr/Automation (links to VS-30.2) implement improvements: standardization…">
        <bpmn:documentation>Step 2: HRSS Mgr/Automation (links to VS-30.2) implement improvements: standardization, automation/RPA (offer letters, verifications, data entry), self-service expansion (W3330), and AI-assist (knowledge base, chatbot); manage change and adoption
Responsible (R): HRSS Mgr / Automation
Accountable (A): CHRO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3352_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3352_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3352_Task6" name="HRSS Mgr measure improvement impact (cycle time, cost, error rate, CSAT links…">
        <bpmn:documentation>Step 3: HRSS Mgr measure improvement impact (cycle time, cost, error rate, CSAT links to W3336), sustain gains with controls/audit (links to VS-21.1), and report HR operational excellence to CHRO
Responsible (R): HRSS Mgr
Accountable (A): CHRO
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W3352_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3352_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3352_End7" name="Complete">
        <bpmn:incoming>W3352_Flow13</bpmn:incoming>
      </bpmn:endEvent>
