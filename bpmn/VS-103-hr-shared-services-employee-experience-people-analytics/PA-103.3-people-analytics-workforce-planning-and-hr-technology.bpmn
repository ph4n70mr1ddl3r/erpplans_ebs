    <bpmn:process id="W_W3352" name="W3352. HR Process Excellence, Automation &amp; Continuous Improvement" isExecutable="false">
      <bpmn:documentation>Trigger: Process pain point; automation opportunity; complements VS-30
Frequency: Continuous
Volume: HR process portfolio
Owner: HR Shared Services Manager
Participants: HRSS Mgr, HR functions, Innovation/Automation (links to VS-30.2), People Analytics (links to VS-103.3), Internal Audit (links to VS-21.1)
Source: workflow W3352 — HR Process Excellence, Automation &amp; Continuous Improvement</bpmn:documentation>
      <bpmn:laneSet id="W3352_LaneSet2">
        <bpmn:lane id="W3352_Lane1" name="HRSS Mgr">
        <bpmn:flowNodeRef>W3352_Task4</bpmn:flowNodeRef>
