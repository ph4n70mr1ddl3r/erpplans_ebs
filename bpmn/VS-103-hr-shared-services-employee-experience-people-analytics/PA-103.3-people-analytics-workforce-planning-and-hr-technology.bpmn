<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-103.3-people-analytics-workforce-planning-and-hr-technology" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3345" name="W3345. Workforce Planning, Headcount Forecasting &amp; Capacity Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Annual plan (links to VS-33.1); growth/new stores; restructure
Frequency: Annual + quarterly
Volume: 6,925 headcount across 5 entities/205 locations
Owner: People Analytics Manager
Participants: People Analytics Manager, HRBP, Store Ops (links to VS-07), Finance (links to VS-17.4), Strategic Planning (links to VS-33.1)
Source: workflow W3345 — Workforce Planning, Headcount Forecasting &amp; Capacity Planning</bpmn:documentation>
      <bpmn:laneSet id="W3345_LaneSet2">
        <bpmn:lane id="W3345_Lane1" name="People Analytics Manager">
        <bpmn:flowNodeRef>W3345_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3345_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3345_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3345_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3345_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3345_Start3" name="Annual plan (links to VS-33.1); growth/new stores; restructure">
        <bpmn:outgoing>W3345_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3345_Task4" name="People Analytics Manager/HRBP build the workforce plan: current-state headcount…">
        <bpmn:documentation>Step 1: People Analytics Manager/HRBP build the workforce plan: current-state headcount by entity/function/location, demand drivers (sales growth, new stores per VS-37, store closures per VS-59, automation), and gap analysis to future-state needs
Responsible (R): People Analytics Manager / HRBP
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3345_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3345_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3345_Task5" name="People Analytics Manager/Finance forecast headcount and labor cost under…">
        <bpmn:documentation>Step 2: People Analytics Manager/Finance forecast headcount and labor cost under scenarios, reconcile to the labor budget (links to VS-33.1/VS-102 W3327), and identify build/buy/redeploy actions; coordinate store staffing model (29/store per profile §12.1, links to VS-19.3 WFM)
Responsible (R): People Analytics Manager / Finance
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3345_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3345_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3345_Task6" name="People Analytics Manager/HRBP track actual vs plan, flag gaps…">
        <bpmn:documentation>Step 3: People Analytics Manager/HRBP track actual vs plan, flag gaps (over/under-staffing by location), and feed to recruitment (links to VS-19.1) and WFM (links to VS-19.3); report to leadership (links to VS-33.2)
Responsible (R): People Analytics Manager
Accountable (A): CHRO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3345_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3345_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3345_End7" name="Complete">
        <bpmn:incoming>W3345_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3345_Annotation8">
        <bpmn:text>Controls: - CTL-540 (ensure controlled execution — People Analytics, Workforce Planning &amp; HR Technology (PA-103.3).) | - operational: scenario planning and budget reconciliation; operational: driver-based demand modeling
Owner: People Analytics Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3345_Assoc9" sourceRef="W3345_Annotation8" targetRef="W3345_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3345_Flow10" sourceRef="W3345_Start3" targetRef="W3345_Task4" />
      <bpmn:sequenceFlow id="W3345_Flow11" sourceRef="W3345_Task4" targetRef="W3345_Task5" />
      <bpmn:sequenceFlow id="W3345_Flow12" sourceRef="W3345_Task5" targetRef="W3345_Task6" />
      <bpmn:sequenceFlow id="W3345_Flow13" sourceRef="W3345_Task6" targetRef="W3345_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3345_diag">
      <bpmndi:BPMNPlane id="W3345_plane" bpmnElement="W_W3345">
        <bpmndi:BPMNShape id="W3345_Lane1_di" bpmnElement="W3345_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
