      <bpmndi:BPMNPlane id="W3346_plane" bpmnElement="W_W3346">
        <bpmndi:BPMNShape id="W3346_Lane1_di" bpmnElement="W3346_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
