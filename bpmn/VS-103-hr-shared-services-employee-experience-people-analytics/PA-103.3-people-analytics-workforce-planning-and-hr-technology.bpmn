        <bpmndi:BPMNShape id="W3346_Annotation8_di" bpmnElement="W3346_Annotation8"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3346_Flow10_di" bpmnElement="W3346_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3346_Flow11_di" bpmnElement="W3346_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3346_Flow12_di" bpmnElement="W3346_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3346_Flow13_di" bpmnElement="W3346_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3346_Assoc9_di" bpmnElement="W3346_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3347" name="W3347. Turnover/Attrition Analytics, Retention Risk &amp; Exit Insight" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly turnover review; complements VS-19.5
Frequency: Monthly
Volume: ~15–20% annual turnover (per profile §11.4)
Owner: People Analytics Manager
Participants: People Analytics Manager, HRBP, C&amp;B (links to VS-102), EX (links to VS-103.2), CHRO
Source: workflow W3347 — Turnover/Attrition Analytics, Retention Risk &amp; Exit Insight</bpmn:documentation>
      <bpmn:laneSet id="W3347_LaneSet2">
        <bpmn:lane id="W3347_Lane1" name="People Analytics Manager">
        <bpmn:flowNodeRef>W3347_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3347_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3347_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3347_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3347_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3347_Start3" name="Monthly turnover review; complements VS-19.5">
        <bpmn:outgoing>W3347_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3347_Task4" name="People Analytics Manager measure turnover: overall, voluntary/involuntary…">
        <bpmn:documentation>Step 1: People Analytics Manager measure turnover: overall, voluntary/involuntary, regrettable, by tenure/role/location/entity/manager; compute retention curves and identify hotspots
Responsible (R): People Analytics Manager
Accountable (A): CHRO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3347_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3347_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3347_Task5" name="People Analytics Manager conduct exit analysis: exit-interview themes (links to…">
        <bpmn:documentation>Step 2: People Analytics Manager conduct exit analysis: exit-interview themes (links to VS-19.5), drivers (pay links to VS-102, manager, growth, workload), and regrettable-loss patterns; build retention-risk model for high performers/key roles
Responsible (R): People Analytics Manager
Accountable (A): CHRO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3347_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3347_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3347_Task6" name="People Analytics Manager/HRBP build retention action plans for hotspots…">
        <bpmn:documentation>Step 3: People Analytics Manager/HRBP build retention action plans for hotspots (manager coaching links to VS-19.4, rewards links to VS-102, EX links to VS-103.2), track impact, and report to leadership (links to VS-33.2)
Responsible (R): People Analytics Manager / HRBP
Accountable (A): CHRO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3347_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3347_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3347_End7" name="Complete">
        <bpmn:incoming>W3347_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3347_Annotation8">
        <bpmn:text>Controls: - CTL-540 (ensure controlled execution — People Analytics, Workforce Planning &amp; HR Technology (PA-103.3).) | - operational: retention-risk model and proactive action; operational: exit analysis and analytics
Owner: People Analytics Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3347_Assoc9" sourceRef="W3347_Annotation8" targetRef="W3347_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3347_Flow10" sourceRef="W3347_Start3" targetRef="W3347_Task4" />
      <bpmn:sequenceFlow id="W3347_Flow11" sourceRef="W3347_Task4" targetRef="W3347_Task5" />
      <bpmn:sequenceFlow id="W3347_Flow12" sourceRef="W3347_Task5" targetRef="W3347_Task6" />
      <bpmn:sequenceFlow id="W3347_Flow13" sourceRef="W3347_Task6" targetRef="W3347_End7" />
    </bpmn:process>
