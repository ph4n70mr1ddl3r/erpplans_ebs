        </bpmn:lane>
        <bpmn:lane id="W3330_Lane3" name="HR Technology">
        <bpmn:flowNodeRef>W3330_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3330_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3330_Start5" name="Continuous portal use; release/enhancement">
        <bpmn:outgoing>W3330_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3330_Task6" name="HRSS/HR Technology operate the ESS/MSS portal: personal data updates…">
        <bpmn:documentation>Step 1: HRSS/HR Technology operate the ESS/MSS portal: personal data updates, payslip/view (links to VS-19.2), leave requests/approvals, benefits enrollment (links to VS-102), time/attendance views (links to VS-19.3), directory, policy/knowledge access
Responsible (R): HRSS / HR Technology
Accountable (A): HR Shared Services Mgr
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3330_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3330_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3330_Task7" name="HRSS team support adoption: training, in-store enablement for 5,800 store staff…">
        <bpmn:documentation>Step 2: HRSS team support adoption: training, in-store enablement for 5,800 store staff (low tech-literacy segments per profile §17), issue resolution, and feedback; manage access provisioning and role-based security (links to VS-27.3)
Responsible (R): HRSS team
Accountable (A): HR Shared Services Mgr
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3330_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3330_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3330_Task8" name="HR Technology/IT maintain portal integration (payroll, benefits, attendance…">
        <bpmn:documentation>Step 3: HR Technology/IT maintain portal integration (payroll, benefits, attendance, master data links to VS-29), push enhancements, monitor uptime/performance (links to VS-27), and track adoption/usage analytics
Responsible (R): HR Technology / IT
Accountable (A): HR Shared Services Mgr
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3330_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3330_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3330_End9" name="Complete">
        <bpmn:incoming>W3330_Flow15</bpmn:incoming>
      </bpmn:endEvent>
