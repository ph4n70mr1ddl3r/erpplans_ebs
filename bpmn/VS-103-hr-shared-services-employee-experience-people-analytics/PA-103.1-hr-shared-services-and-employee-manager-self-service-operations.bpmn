    <bpmn:process id="W_W3329" name="W3329. Employee Service Center (HR Helpdesk) Case Intake, Triage &amp; Resolution" isExecutable="false">
      <bpmn:documentation>Trigger: Employee/manager HR request (any channel)
Frequency: Continuous
Volume: ~thousands of cases/month across 6,911 employees
Owner: HR Shared Services Manager
Participants: HRSS team, Employees, Managers, HR Business Partners, Subject experts
Source: workflow W3329 — Employee Service Center (HR Helpdesk) Case Intake, Triage &amp; Resolution</bpmn:documentation>
      <bpmn:laneSet id="W3329_LaneSet2">
        <bpmn:lane id="W3329_Lane1" name="HRSS team">
        <bpmn:flowNodeRef>W3329_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3329_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3329_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3329_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3329_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3329_Start3" name="Employee/manager HR request (any channel)">
        <bpmn:outgoing>W3329_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3329_Task4" name="HRSS team intake the request via channel (portal links to VS-103.1, phone…">
        <bpmn:documentation>Step 1: HRSS team intake the request via channel (portal links to VS-103.1, phone, email, in-person at store/DC/HQ): capture employee identity, category (pay links to VS-19.2, benefits VS-102, leave, policy, lifecycle), and urgency; create case in case-management system
Responsible (R): HRSS team
Accountable (A): HR Shared Services Mgr
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W3329_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3329_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3329_Task5" name="HRSS team triage: resolve Tier-1 (policy, status lookups, simple transactions)…">
        <bpmn:documentation>Step 2: HRSS team triage: resolve Tier-1 (policy, status lookups, simple transactions) at first contact; route Tier-2/3 to the right specialist (payroll VS-19.2, C&amp;B VS-102, HRBP, legal VS-100, IT VS-27) with context; set SLA and acknowledge
Responsible (R): HRSS team
Accountable (A): HR Shared Services Mgr
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W3329_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3329_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3329_Task6" name="HRSS team/specialist resolve, validate, and close the case; update knowledge…">
        <bpmn:documentation>Step 3: HRSS team/specialist resolve, validate, and close the case; update knowledge base (W3331), notify the employee/manager, and capture CSAT (W3336); track reopen and aging
Responsible (R): HRSS team / Specialist
Accountable (A): HR Shared Services Mgr
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W3329_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3329_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3329_End7" name="Complete">
        <bpmn:incoming>W3329_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3329_Annotation8">
        <bpmn:text>Controls: - CTL-538 (ensure controlled execution — HR Shared Services &amp; Employee/Manager Self-Service Operations (PA-103.1).) | - operational: omnichannel case intake; operational: Tier-1 empowerment and knowledge base (W3331)
Owner: HR Shared Services Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3329_Assoc9" sourceRef="W3329_Annotation8" targetRef="W3329_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3329_Flow10" sourceRef="W3329_Start3" targetRef="W3329_Task4" />
      <bpmn:sequenceFlow id="W3329_Flow11" sourceRef="W3329_Task4" targetRef="W3329_Task5" />
      <bpmn:sequenceFlow id="W3329_Flow12" sourceRef="W3329_Task5" targetRef="W3329_Task6" />
      <bpmn:sequenceFlow id="W3329_Flow13" sourceRef="W3329_Task6" targetRef="W3329_End7" />
    </bpmn:process>
