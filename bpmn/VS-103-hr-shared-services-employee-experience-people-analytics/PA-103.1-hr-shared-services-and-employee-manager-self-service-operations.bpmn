    <bpmn:process id="W_W3332" name="W3332. Multi-Entity HR Shared Services Delivery &amp; Cross-Entity Case Routing" isExecutable="false">
      <bpmn:documentation>Trigger: Employee request spans entities; entity change
Frequency: Continuous
Volume: 5 payroll entities (per profile §2)
Owner: HR Shared Services Manager
Participants: HRSS team, Entity HR leads, Payroll (links to VS-19.2), Cross-entity shared services (links to VS-72)
Source: workflow W3332 — Multi-Entity HR Shared Services Delivery &amp; Cross-Entity Case Routing</bpmn:documentation>
      <bpmn:laneSet id="W3332_LaneSet3">
        <bpmn:lane id="W3332_Lane1" name="HRSS team">
        <bpmn:flowNodeRef>W3332_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3332_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3332_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3332_Lane2" name="HR Shared Services Mgr">
        <bpmn:flowNodeRef>W3332_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3332_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3332_Start4" name="Employee request spans entities; entity change">
        <bpmn:outgoing>W3332_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3332_Task5" name="HRSS team deliver shared HR services across all 5 entities (Holdings, Depot…">
        <bpmn:documentation>Step 1: HRSS team deliver shared HR services across all 5 entities (Holdings, Depot, Logistics, Digital Commerce, Property Mgmt per profile §2) from a central service center, with entity-specific policy/config awareness
Responsible (R): HRSS team
Accountable (A): HR Shared Services Mgr
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3332_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3332_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3332_Task6" name="HRSS team route cross-entity cases correctly: identify the employee&#x27;s employing…">
