    <bpmn:process id="W_W3330" name="W3330. Employee Self-Service (ESS) &amp; Manager Self-Service (MSS) Portal Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Continuous portal use; release/enhancement
Frequency: Continuous
Volume: 6,911 employees + managers
Owner: HR Shared Services Manager
Participants: HRSS team, HR Technology (links to VS-103.3), IT (links to VS-27), Payroll (links to VS-19.2)
Source: workflow W3330 — Employee Self-Service (ESS) &amp; Manager Self-Service (MSS) Portal Operations</bpmn:documentation>
      <bpmn:laneSet id="W3330_LaneSet4">
        <bpmn:lane id="W3330_Lane1" name="HRSS">
        <bpmn:flowNodeRef>W3330_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3330_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
