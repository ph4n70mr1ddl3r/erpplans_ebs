      <bpmn:sequenceFlow id="W3338_Flow13" sourceRef="W3338_Task6" targetRef="W3338_Task7" />
      <bpmn:sequenceFlow id="W3338_Flow14" sourceRef="W3338_Task7" targetRef="W3338_Task8" />
      <bpmn:sequenceFlow id="W3338_Flow15" sourceRef="W3338_Task8" targetRef="W3338_End9" />
    </bpmn:process>
