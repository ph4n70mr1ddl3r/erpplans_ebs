      <bpmn:sequenceFlow id="W3339_Flow12" sourceRef="W3339_Task5" targetRef="W3339_Task6" />
      <bpmn:sequenceFlow id="W3339_Flow13" sourceRef="W3339_Task6" targetRef="W3339_End7" />
    </bpmn:process>
