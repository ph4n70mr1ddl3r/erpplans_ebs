    <bpmn:process id="W_W3340" name="W3340. Town Hall, Leadership Communication &amp; All-Hands Event Management" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly/all-hands cycle; strategic milestone
Frequency: Quarterly + on event
Volume: Enterprise/all-hands
Owner: Internal Communications Manager
Participants: Internal Comms Mgr, Leadership, EX, IT/AV (links to VS-27), Facilities (links to VS-07.2)
Source: workflow W3340 — Town Hall, Leadership Communication &amp; All-Hands Event Management</bpmn:documentation>
      <bpmn:laneSet id="W3340_LaneSet3">
        <bpmn:lane id="W3340_Lane1" name="Internal Comms Mgr">
        <bpmn:flowNodeRef>W3340_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3340_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3340_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3340_Lane2" name="Leadership">
        <bpmn:flowNodeRef>W3340_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3340_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3340_Start4" name="Quarterly/all-hands cycle; strategic milestone">
        <bpmn:outgoing>W3340_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3340_Task5" name="Internal Comms Mgr/Leadership plan town halls and all-hands: agenda…">
        <bpmn:documentation>Step 1: Internal Comms Mgr/Leadership plan town halls and all-hands: agenda (performance links to VS-33.2, strategy, recognition, Q&amp;A), format (in-person HQ + livestream to 200 stores/DCs), logistics, and AV/IT (links to VS-27)
Responsible (R): Internal Comms Mgr / Leadership
Accountable (A): CEO
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3340_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3340_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3340_Task6" name="Leadership deliver town halls with authentic two-way communication, live Q&amp;A…">
