    <bpmn:process id="W_W3337" name="W3337. Employee Onboarding Experience &amp; Day-1 Readiness Program" isExecutable="false">
      <bpmn:documentation>Trigger: New hire (links to VS-19.1)
Frequency: ~1,200–1,600 hires/year (per profile §11.4)
Volume: Per hire
Owner: Employee Experience Manager
Participants: EX Manager, HRSS (W3335), Hiring Manager, IT (links to VS-27/VS-99), Training (links to VS-19.4), Buddy/Mentor
Source: workflow W3337 — Employee Onboarding Experience &amp; Day-1 Readiness Program</bpmn:documentation>
      <bpmn:laneSet id="W3337_LaneSet3">
        <bpmn:lane id="W3337_Lane1" name="EX Manager">
        <bpmn:flowNodeRef>W3337_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3337_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3337_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3337_Lane2" name="Hiring Manager">
        <bpmn:flowNodeRef>W3337_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3337_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3337_Start4" name="New hire (links to VS-19.1)">
        <bpmn:outgoing>W3337_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3337_Task5" name="EX Manager design/operate the onboarding experience: pre-boarding (welcome…">
        <bpmn:documentation>Step 1: EX Manager design/operate the onboarding experience: pre-boarding (welcome pack, e-sign documents links to W3333, system access links to W3335), day-1 readiness (workspace, equipment, uniform, introductions), and first-week program
Responsible (R): EX Manager / HRSS
Accountable (A): CHRO
Duration: Per hire</bpmn:documentation>
        <bpmn:incoming>W3337_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3337_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3337_Task6" name="Hiring Manager/EX Manager deliver role onboarding: team integration…">
        <bpmn:documentation>Step 2: Hiring Manager/EX Manager deliver role onboarding: team integration, expectations, goals (30/60/90), training (POS/safety/product per VS-19.4), buddy assignment, and store/DC orientation; collect early feedback
Responsible (R): Hiring Manager / EX Manager
Accountable (A): CHRO
Duration: Per hire</bpmn:documentation>
        <bpmn:incoming>W3337_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3337_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3337_Task7" name="EX Manager measure onboarding effectiveness (time-to-productivity, 30/60/90…">
        <bpmn:documentation>Step 3: EX Manager measure onboarding effectiveness (time-to-productivity, 30/60/90 feedback, early retention links to VS-103.3) and continuously improve the program
Responsible (R): EX Manager
Accountable (A): CHRO
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W3337_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3337_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3337_End8" name="Complete">
        <bpmn:incoming>W3337_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3337_Annotation9">
        <bpmn:text>Controls: - CTL-539 (ensure controlled execution — Employee Experience, Engagement &amp; Internal Communications (PA-103.2).) | - operational: structured experience and feedback; operational: pre-boarding checklist (W3335)
Owner: Employee Experience Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3337_Assoc10" sourceRef="W3337_Annotation9" targetRef="W3337_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3337_Flow11" sourceRef="W3337_Start4" targetRef="W3337_Task5" />
      <bpmn:sequenceFlow id="W3337_Flow12" sourceRef="W3337_Task5" targetRef="W3337_Task6" />
      <bpmn:sequenceFlow id="W3337_Flow13" sourceRef="W3337_Task6" targetRef="W3337_Task7" />
      <bpmn:sequenceFlow id="W3337_Flow14" sourceRef="W3337_Task7" targetRef="W3337_End8" />
    </bpmn:process>
