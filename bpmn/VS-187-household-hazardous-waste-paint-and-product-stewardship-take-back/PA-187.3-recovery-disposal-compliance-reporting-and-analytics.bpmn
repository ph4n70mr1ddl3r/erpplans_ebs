      <bpmn:sequenceFlow id="W5362_Flow19" sourceRef="W5362_Task10" targetRef="W5362_Task11" />
      <bpmn:sequenceFlow id="W5362_Flow20" sourceRef="W5362_Task11" targetRef="W5362_End12" />
    </bpmn:process>
