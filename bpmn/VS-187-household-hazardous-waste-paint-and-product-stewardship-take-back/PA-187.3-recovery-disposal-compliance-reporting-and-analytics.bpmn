      <bpmn:startEvent id="W5368_Start4" name="Monthly/quarterly program-performance review; ESG reporting cycle">
        <bpmn:outgoing>W5368_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5368_Task5" name="Compute diversion rate (diverted from landfill ÷ total), recycling yield per…">
        <bpmn:documentation>Step 1: Compute diversion rate (diverted from landfill ÷ total), recycling yield per stream, and recovery revenue vs. cost.
Responsible (R): BI Analyst
Accountable (A): Sustainability/ESG Manager
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W5368_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5368_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5368_Task6" name="Compute customer participation (unique participants, repeat rate, per-store…">
