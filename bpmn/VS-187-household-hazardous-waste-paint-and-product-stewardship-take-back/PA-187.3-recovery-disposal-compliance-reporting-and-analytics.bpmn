    <bpmn:process id="W_W5368" name="W5368. Diversion Rate, Recycling Yield, Customer Participation &amp; Program Impact Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly/quarterly program-performance review; ESG reporting cycle
Frequency: Monthly
Volume: 1 program dashboard/month; ~4 ESG reporting cycles/yr
Owner: Sustainability/ESG Manager
Participants: BI/Analytics (VS-28), Finance, Marketing, Store Operations
Source: workflow W5368 — Diversion Rate, Recycling Yield, Customer Participation &amp; Program Impact Analytics</bpmn:documentation>
      <bpmn:laneSet id="W5368_LaneSet3">
        <bpmn:lane id="W5368_Lane1" name="BI Analyst">
        <bpmn:flowNodeRef>W5368_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5368_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5368_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
