Responsible (R): Sustainability/ESG Manager
Accountable (A): Sustainability/ESG Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W5368_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5368_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5368_Task8" name="Feed the metrics into ESG/sustainability reporting and board ESG reporting…">
