        <bpmn:outgoing>W5367_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5367_Task5" name="Reconcile actual take-back volumes (by brand/SKU) against manufacturer…">
        <bpmn:documentation>Step 1: Reconcile actual take-back volumes (by brand/SKU) against manufacturer co-funding terms (W5348).
Responsible (R): Finance Business Partner
Accountable (A): Finance Business Partner
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5367_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5367_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5367_Task6" name="Compute co-funding receivable per brand and recovery revenue (reblended paint…">
        <bpmn:documentation>Step 2: Compute co-funding receivable per brand and recovery revenue (reblended paint, scrap metal, battery lead — W5362/W5363).
Responsible (R): Finance Business Partner
Accountable (A): Finance Business Partner
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W5367_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5367_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5367_Task7" name="Process and 2-way-match TSD/transporter vendor invoices against manifests…">
        <bpmn:documentation>Step 3: Process and 2-way-match TSD/transporter vendor invoices against manifests (VS-15).
Responsible (R): Accounts Payable
Accountable (A): Finance Business Partner
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5367_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5367_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5367_Task8" name="Settle co-funding receivables with brands and TSD payables; net into the…">
        <bpmn:documentation>Step 4: Settle co-funding receivables with brands and TSD payables; net into the program P&amp;L.
Responsible (R): Accounts Payable
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5367_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5367_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5367_Task9" name="Report program cost-recovery vs. gross cost to the ESG/steering committee…">
        <bpmn:documentation>Step 5: Report program cost-recovery vs. gross cost to the ESG/steering committee (W5368).
Responsible (R): Finance Business Partner
Accountable (A): CFO
Duration: monthly</bpmn:documentation>
        <bpmn:incoming>W5367_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5367_Flow18</bpmn:outgoing>
      </bpmn:userTask>
