    <bpmn:process id="W_W5361" name="W5361. TSD Facility Processing, Recovery, Recycling &amp; Energy-Recovery Verification" isExecutable="false">
      <bpmn:documentation>Trigger: Manifest arrives at TSD (W5351/W5360); periodic recovery verification
Frequency: Per manifest batch; quarterly recovery audit
Volume: ~5,000–15,000 manifest batches/yr; ~4 quarterly audits
Owner: Compliance Specialist (Environmental)
Participants: TSD Facility, Sustainability/ESG Manager, Internal Audit (VS-21)
Source: workflow W5361 — TSD Facility Processing, Recovery, Recycling &amp; Energy-Recovery Verification</bpmn:documentation>
      <bpmn:laneSet id="W5361_LaneSet3">
        <bpmn:lane id="W5361_Lane1" name="Compliance Specialist">
        <bpmn:flowNodeRef>W5361_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5361_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5361_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5361_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5361_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5361_Lane2" name="Internal Audit">
        <bpmn:flowNodeRef>W5361_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5361_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5361_Start4" name="Manifest arrives at TSD (W5351/W5360); periodic recovery verification">
        <bpmn:outgoing>W5361_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5361_Task5" name="Receive TSD processing confirmation per manifest: stream, quantity, processing…">
        <bpmn:documentation>Step 1: Receive TSD processing confirmation per manifest: stream, quantity, processing method (recycle/recovery/disposal).
Responsible (R): Compliance Specialist
Accountable (A): Compliance Specialist
Duration: per manifest</bpmn:documentation>
        <bpmn:incoming>W5361_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5361_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5361_Task6" name="Verify the processing method matches the agreed recovery path (e.g. oil…">
        <bpmn:documentation>Step 2: Verify the processing method matches the agreed recovery path (e.g. oil re-refined, batteries recycled, lamps mercury-recovered).
Responsible (R): Compliance Specialist
Accountable (A): Compliance Specialist
Duration: per manifest</bpmn:documentation>
        <bpmn:incoming>W5361_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5361_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5361_Task7" name="Capture recovery certificates/yields per stream and partner; reconcile to the…">
        <bpmn:documentation>Step 3: Capture recovery certificates/yields per stream and partner; reconcile to the manifest (cradle-to-grave close).
Responsible (R): Compliance Specialist
Accountable (A): Compliance Specialist
Duration: per manifest</bpmn:documentation>
        <bpmn:incoming>W5361_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5361_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5361_Task8" name="Audit a sample of TSD records quarterly (internal audit cross-link VS-21).">
        <bpmn:documentation>Step 4: Audit a sample of TSD records quarterly (internal audit cross-link VS-21).
Responsible (R): Internal Audit
Accountable (A): Compliance Specialist
Duration: quarterly</bpmn:documentation>
        <bpmn:incoming>W5361_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5361_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5361_Task9" name="Flag any discrepancy (short recovery, unexplained disposal) for TPRM follow-up…">
        <bpmn:documentation>Step 5: Flag any discrepancy (short recovery, unexplained disposal) for TPRM follow-up (VS-161).
Responsible (R): Compliance Specialist
Accountable (A): Compliance Specialist
Duration: per discrepancy</bpmn:documentation>
        <bpmn:incoming>W5361_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5361_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5361_End10" name="Complete">
        <bpmn:incoming>W5361_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5361_Annotation11">
        <bpmn:text>Controls: - CTL-793 (ensure controlled execution — Recovery, Disposal, Compliance Reporting &amp; Stewardship Analytics (PA-187.3).) | - operational: cradle-to-grave TSD verification; CTL-21 (quantity reconciliation).
Owner: Compliance Specialist (Environmental)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5361_Assoc12" sourceRef="W5361_Annotation11" targetRef="W5361_Start4" associationDirection="None" />
