Responsible (R): Sustainability/ESG Manager
Accountable (A): VP Legal &amp; Compliance
Duration: per cycle</bpmn:documentation>
        <bpmn:incoming>W5368_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5368_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5368_Task9" name="Recommend program adjustments (scope, incentives, partner mix) to the steering…">
