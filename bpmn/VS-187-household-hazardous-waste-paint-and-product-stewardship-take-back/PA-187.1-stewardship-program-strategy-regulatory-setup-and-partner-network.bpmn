    <bpmn:process id="W_W5346" name="W5346. DENR-EMB Hazardous Waste Generator/Treater Registration &amp; Permitting (RA 6969)" isExecutable="false">
      <bpmn:documentation>Trigger: Program launch (W5345); new store added to the program; permit renewal
Frequency: Initial registration per store/entity; periodic renewal (per DENR-EMB cycle)
Volume: ~200 store-level hazardous-waste generator registrations; ~5 entity-level permits
Owner: Compliance Specialist (Environmental)
Participants: DENR-EMB liaison, HSE Officer, Facilities, Permit Portfolio (VS-166)
Source: workflow W5346 — DENR-EMB Hazardous Waste Generator/Treater Registration &amp; Permitting (RA 6969)</bpmn:documentation>
      <bpmn:laneSet id="W5346_LaneSet3">
        <bpmn:lane id="W5346_Lane1" name="Compliance Specialist">
        <bpmn:flowNodeRef>W5346_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5346_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5346_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5346_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5346_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5346_Lane2" name="HSE Officer">
        <bpmn:flowNodeRef>W5346_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5346_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5346_Start4" name="Program launch (W5345); new store added to the program; permit renewal">
        <bpmn:outgoing>W5346_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5346_Task5" name="Register each participating store as a hazardous-waste generator with DENR-EMB…">
        <bpmn:documentation>Step 1: Register each participating store as a hazardous-waste generator with DENR-EMB (RA 6969 / DAO permits) for the streams it will accept.
Responsible (R): Compliance Specialist
Accountable (A): VP Legal &amp; Compliance
Duration: per store</bpmn:documentation>
        <bpmn:incoming>W5346_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5346_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5346_Task6" name="Secure the entity-level permits (generator, and transporter/treater…">
        <bpmn:documentation>Step 2: Secure the entity-level permits (generator, and transporter/treater arrangements via accredited TSD — W5347).
Responsible (R): Compliance Specialist
Accountable (A): VP Legal &amp; Compliance
Duration: 4–8 weeks</bpmn:documentation>
        <bpmn:incoming>W5346_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5346_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5346_Task7" name="Establish the per-store hazardous-waste storage area/containment to DENR spec…">
        <bpmn:documentation>Step 3: Establish the per-store hazardous-waste storage area/containment to DENR spec (links W5349).
Responsible (R): HSE Officer
Accountable (A): Facilities Manager
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W5346_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5346_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5346_Task8" name="Record permits in the license/permit portfolio with renewal alerts (VS-166)…">
        <bpmn:documentation>Step 4: Record permits in the license/permit portfolio with renewal alerts (VS-166); gate take-back availability on valid permit.
Responsible (R): Compliance Specialist
Accountable (A): Compliance Specialist
Duration: per permit</bpmn:documentation>
        <bpmn:incoming>W5346_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5346_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5346_Task9" name="Maintain the required hazardous-waste register/ledger and reporting workflow…">
        <bpmn:documentation>Step 5: Maintain the required hazardous-waste register/ledger and reporting workflow (W5364).
Responsible (R): Compliance Specialist
Accountable (A): Compliance Specialist
Duration: ongoing</bpmn:documentation>
        <bpmn:incoming>W5346_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5346_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5346_End10" name="Complete">
        <bpmn:incoming>W5346_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5346_Annotation11">
        <bpmn:text>Controls: - CTL-41: DENR/agency regulatory compliance; CTL-34 (permit-validity availability gate).
Owner: Compliance Specialist (Environmental)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5346_Assoc12" sourceRef="W5346_Annotation11" targetRef="W5346_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5346_Flow13" sourceRef="W5346_Start4" targetRef="W5346_Task5" />
      <bpmn:sequenceFlow id="W5346_Flow14" sourceRef="W5346_Task5" targetRef="W5346_Task6" />
      <bpmn:sequenceFlow id="W5346_Flow15" sourceRef="W5346_Task6" targetRef="W5346_Task7" />
      <bpmn:sequenceFlow id="W5346_Flow16" sourceRef="W5346_Task7" targetRef="W5346_Task8" />
      <bpmn:sequenceFlow id="W5346_Flow17" sourceRef="W5346_Task8" targetRef="W5346_Task9" />
      <bpmn:sequenceFlow id="W5346_Flow18" sourceRef="W5346_Task9" targetRef="W5346_End10" />
    </bpmn:process>
