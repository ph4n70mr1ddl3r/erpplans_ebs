    <bpmn:process id="W_W5349" name="W5349. In-Store Take-Back Collection Point Design, Containment &amp; Safety Infrastructure" isExecutable="false">
      <bpmn:documentation>Trigger: New store added to the program (W5345/W5346)
Frequency: Per store build/retrofit
Volume: ~200 collection points at full rollout
Owner: Facilities &amp; Real Estate Manager
Participants: HSE Officer, BFP Fire Safety Inspector, Store Manager
Source: workflow W5349 — In-Store Take-Back Collection Point Design, Containment &amp; Safety Infrastructure</bpmn:documentation>
      <bpmn:laneSet id="W5349_LaneSet3">
        <bpmn:lane id="W5349_Lane1" name="Facilities Manager">
        <bpmn:flowNodeRef>W5349_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5349_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5349_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5349_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5349_Lane2" name="HSE Officer">
        <bpmn:flowNodeRef>W5349_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5349_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5349_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5349_Start4" name="New store added to the program (W5345/W5346)">
        <bpmn:outgoing>W5349_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5349_Task5" name="Design the collection point: ventilated/curtained area, separated from stock…">
        <bpmn:documentation>Step 1: Design the collection point: ventilated/curtained area, separated from stock and customer flow, with spill containment.
Responsible (R): Facilities Manager
Accountable (A): HSE Officer
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5349_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5349_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5349_Task6" name="Install stream-specific containment: flame cabinets (paint/solvent)…">
        <bpmn:documentation>Step 2: Install stream-specific containment: flame cabinets (paint/solvent), acid/lithium-rated bins with fire separation (batteries), mercury-tight containers (lamps), oil-rated bunded drums (used oil).
Responsible (R): Facilities Manager
Accountable (A): HSE Officer
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W5349_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5349_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5349_Task7" name="Equip with spill kits, PPE, fire suppression rated to the streams (BFP Fire…">
        <bpmn:documentation>Step 3: Equip with spill kits, PPE, fire suppression rated to the streams (BFP Fire Code FSIC), and emergency eyewash.
Responsible (R): Facilities Manager
Accountable (A): BFP Inspector
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5349_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5349_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5349_Task8" name="Signage, customer instructions, and max-quantity limits (W5350); staff training…">
        <bpmn:documentation>Step 4: Signage, customer instructions, and max-quantity limits (W5350); staff training on handling.
Responsible (R): HSE Officer
Accountable (A): Store Manager
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5349_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5349_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5349_Task9" name="Commission with HSE + BFP sign-off before first acceptance; gate acceptance on…">
        <bpmn:documentation>Step 5: Commission with HSE + BFP sign-off before first acceptance; gate acceptance on passed commissioning.
Responsible (R): HSE Officer
Accountable (A): Store Manager
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W5349_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5349_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5349_End10" name="Complete">
        <bpmn:incoming>W5349_Flow18</bpmn:incoming>
      </bpmn:endEvent>
