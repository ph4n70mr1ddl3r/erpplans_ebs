<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-187.1-stewardship-program-strategy-regulatory-setup-and-partner-network" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W5345" name="W5345. Product Stewardship &amp; Take-Back Program Strategy, Scope &amp; Regulatory Mapping" isExecutable="false">
      <bpmn:documentation>Trigger: Executive/ESG decision to launch a structured customer take-back program
Frequency: Annual strategy refresh; ad-hoc scope expansion
Volume: 1 program strategy/yr
Owner: Sustainability/ESG Manager
Participants: VP Legal &amp; Compliance, HSE Officer, Merchandising, Store Operations, Finance
Source: workflow W5345 — Product Stewardship &amp; Take-Back Program Strategy, Scope &amp; Regulatory Mapping</bpmn:documentation>
      <bpmn:laneSet id="W5345_LaneSet4">
        <bpmn:lane id="W5345_Lane1" name="Sustainability">
        <bpmn:flowNodeRef>W5345_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5345_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5345_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5345_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5345_Lane2" name="Compliance Specialist">
        <bpmn:flowNodeRef>W5345_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5345_Lane3" name="Finance Business Partner">
        <bpmn:flowNodeRef>W5345_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5345_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5345_Start5" name="Executive/ESG decision to launch a structured customer take-back program">
        <bpmn:outgoing>W5345_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5345_Task6" name="Define the take-back scope by stream (paint, used oil, batteries, lamps…">
        <bpmn:documentation>Step 1: Define the take-back scope by stream (paint, used oil, batteries, lamps, pesticides/solvents, e-waste, cylinders) and map each to the product assortment BuildRight sells.
Responsible (R): Sustainability/ESG Manager
Accountable (A): Sustainability/ESG Manager
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5345_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5345_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5345_Task7" name="Map each stream to its regulatory regime: RA 6969 (Toxic Substances), RA 8749…">
        <bpmn:documentation>Step 2: Map each stream to its regulatory regime: RA 6969 (Toxic Substances), RA 8749 (Clean Air), RA 9275 (Clean Water), RA 9003 (solid waste), RA 6969 hazardous-waste rules, DENR-EMB DAOs, and RA 11898 EPR where overlapping.
Responsible (R): Compliance Specialist
Accountable (A): VP Legal &amp; Compliance
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5345_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5345_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5345_Task8" name="Set diversion targets, program KPIs, and the business case (footfall lift…">
        <bpmn:documentation>Step 3: Set diversion targets, program KPIs, and the business case (footfall lift, ESG/CSR value, recovery revenue, cost of compliance).
Responsible (R): Finance Business Partner
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5345_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5345_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5345_Task9" name="Define phasing (pilot stores → regional → national) and the stream rollout…">
        <bpmn:documentation>Step 4: Define phasing (pilot stores → regional → national) and the stream rollout sequence.
Responsible (R): Sustainability/ESG Manager
Accountable (A): COO
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W5345_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5345_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5345_Task10" name="Approve the strategy at the ESG/steering committee and board ESG reporting…">
        <bpmn:documentation>Step 5: Approve the strategy at the ESG/steering committee and board ESG reporting (links VS-25/VS-36).
Responsible (R): Sustainability/ESG Manager
Accountable (A): VP Legal &amp; Compliance
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5345_Flow18</bpmn:incoming>
        <bpmn:outgoing>W5345_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5345_End11" name="Complete">
        <bpmn:incoming>W5345_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5345_Annotation12">
        <bpmn:text>Controls: - CTL-791 (ensure controlled execution — Program Strategy, Regulatory Setup &amp; Partner Network (PA-187.1).) | - operational: regulatory compliance scope; program budget adherence.
Owner: Sustainability/ESG Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5345_Assoc13" sourceRef="W5345_Annotation12" targetRef="W5345_Start5" associationDirection="None" />
