    <bpmn:process id="W_W5347" name="W5347. Take-Back Partner, Transporter &amp; TSD (Treatment-Storage-Disposal) Facility Accreditation" isExecutable="false">
      <bpmn:documentation>Trigger: Program setup (W5345); partner renewal/performance review
Frequency: Initial accreditation + periodic re-qualification
Volume: ~5–15 accredited partners (transporters + TSD facilities)
Owner: Procurement Manager (Services)
Participants: Compliance Specialist, HSE Officer, TPRM (VS-161), Finance
Source: workflow W5347 — Take-Back Partner, Transporter &amp; TSD (Treatment-Storage-Disposal) Facility Accreditation</bpmn:documentation>
      <bpmn:laneSet id="W5347_LaneSet3">
        <bpmn:lane id="W5347_Lane1" name="Procurement Manager">
        <bpmn:flowNodeRef>W5347_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5347_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5347_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5347_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5347_Lane2" name="TPRM Analyst">
        <bpmn:flowNodeRef>W5347_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5347_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5347_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5347_Start4" name="Program setup (W5345); partner renewal/performance review">
        <bpmn:outgoing>W5347_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5347_Task5" name="Identify DENR-accredited hazardous-waste transporters and TSD facilities per…">
        <bpmn:documentation>Step 1: Identify DENR-accredited hazardous-waste transporters and TSD facilities per stream (paint recycler, oil re-refiner, battery recycler, lamp/hg handler, e-waste processor).
Responsible (R): Procurement Manager
Accountable (A): Compliance Specialist
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W5347_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5347_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5347_Task6" name="Qualify each on DENR accreditation, capacity, coverage, pricing, and HSSE…">
        <bpmn:documentation>Step 2: Qualify each on DENR accreditation, capacity, coverage, pricing, and HSSE record (TPRM — VS-161).
Responsible (R): TPRM Analyst
Accountable (A): Compliance Specialist
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W5347_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5347_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5347_Task7" name="Negotiate service agreements with manifest/handling fees, SLAs, and reporting…">
        <bpmn:documentation>Step 3: Negotiate service agreements with manifest/handling fees, SLAs, and reporting obligations.
Responsible (R): Procurement Manager
Accountable (A): VP Supply Chain
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W5347_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5347_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5347_Task8" name="Record partners in the vendor/TSD master; link to the manifest chain-of-custody…">
        <bpmn:documentation>Step 4: Record partners in the vendor/TSD master; link to the manifest chain-of-custody (W5351).
Responsible (R): Procurement Manager
Accountable (A): Compliance Specialist
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5347_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5347_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5347_Task9" name="Monitor partner performance, accreditation validity, and incidents (W5365)…">
        <bpmn:documentation>Step 5: Monitor partner performance, accreditation validity, and incidents (W5365); re-qualify periodically.
Responsible (R): TPRM Analyst
Accountable (A): Compliance Specialist
Duration: quarterly</bpmn:documentation>
        <bpmn:incoming>W5347_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5347_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5347_End10" name="Complete">
        <bpmn:incoming>W5347_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5347_Annotation11">
        <bpmn:text>Controls: - CTL-06: vendor/TSD onboarding with DENR check; CTL-41 (regulatory partner compliance).
Owner: Procurement Manager (Services)</bpmn:text>
