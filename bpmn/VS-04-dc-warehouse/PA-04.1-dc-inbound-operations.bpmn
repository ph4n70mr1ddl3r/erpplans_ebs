    <bpmn:process id="W_W3C" name="W3C. DC Inbound Delivery Scheduling" isExecutable="false">
      <bpmn:documentation>Trigger: Purchase order confirmed with vendor or import shipment ETA confirmed
Frequency: Daily; ~50 receipts/day per DC (~200/day chain-wide per the canon)
Volume: ~1,200 merchandise receipts/month + ~80–240 blanket releases + ~100–150 import containers (the ~400–600 TEUs/month §7.1 canon at ~1 TEU/container across 4 DCs, per W1271) + ~30–50 non-merchandise receipts per DC per month
Owner: DC Receiving Supervisor
Participants: Buyer, Import Coordinator, DC Receiving Supervisor, DC Dispatch, Vendor/Carrier
Source: workflow W3C — DC Inbound Delivery Scheduling</bpmn:documentation>
      <bpmn:laneSet id="W3C_LaneSet6">
        <bpmn:lane id="W3C_Lane1" name="System">
        <bpmn:flowNodeRef>W3C_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3C_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3C_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3C_Lane2" name="DC Receiving Supervisor">
        <bpmn:flowNodeRef>W3C_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3C_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3C_Lane3" name="Buyer">
        <bpmn:flowNodeRef>W3C_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3C_Lane4" name="Import Coordinator">
        <bpmn:flowNodeRef>W3C_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3C_Lane5" name="Guard">
        <bpmn:flowNodeRef>W3C_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3C_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3C_Start7" name="Purchase order confirmed with vendor or import shipment ETA confirmed">
        <bpmn:outgoing>W3C_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W3C_Task8" name="System generates inbound delivery forecast from open POs: PO number, vendor…">
        <bpmn:documentation>Step 1: System generates inbound delivery forecast from open POs: PO number, vendor, expected delivery date (from PO promised date or import ETA), number of lines, estimated pallet/cube count, and dock door requirements (refrigerated none; hazardous materials for paint/chemicals; standard for general merchandise)
Responsible (R): System
Accountable (A): —
Duration: Automated (nightly)</bpmn:documentation>
        <bpmn:incoming>W3C_Flow18</bpmn:incoming>
        <bpmn:outgoing>W3C_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W3C_Task9" name="DC Receiving Supervisor reviews next 3-day inbound forecast each morning…">
        <bpmn:documentation>Step 2: DC Receiving Supervisor reviews next 3-day inbound forecast each morning; identifies days with high receiving volume (&gt; 50 receipts) or overlapping large deliveries; adjusts dock door assignments and staff scheduling
Responsible (R): DC Receiving Supervisor
Accountable (A): DC Manager
Duration: 15 min/day</bpmn:documentation>
        <bpmn:incoming>W3C_Flow19</bpmn:incoming>
        <bpmn:outgoing>W3C_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W3C_Task10" name="For domestic vendor deliveries: Buyer or system transmits delivery appointment…">
        <bpmn:documentation>Step 3: For domestic vendor deliveries: Buyer or system transmits delivery appointment to vendor with requested delivery date and time window (typically 8:00 AM – 4:00 PM, 2-hour windows); vendor confirms or proposes alternative; system logs appointment confirmation
Responsible (R): Buyer / System
Accountable (A): DC Receiving Supervisor
Duration: 5 min/PO</bpmn:documentation>
        <bpmn:incoming>W3C_Flow20</bpmn:incoming>
        <bpmn:outgoing>W3C_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W3C_Task11" name="For import containers: Import Coordinator books delivery appointment with DC…">
        <bpmn:documentation>Step 4: For import containers: Import Coordinator books delivery appointment with DC once container is released from port; provides container number, commodity, estimated weight, and special handling requirements; DC Receiving Supervisor confirms appointment and assigns dock door
Responsible (R): Import Coordinator
Accountable (A): DC Receiving Supervisor
Duration: 10 min/container</bpmn:documentation>
        <bpmn:incoming>W3C_Flow21</bpmn:incoming>
        <bpmn:outgoing>W3C_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3C_Task12" name="If vendor arrives without appointment: guard checks against open PO list; if…">
        <bpmn:documentation>Step 5: If vendor arrives without appointment: guard checks against open PO list; if valid PO exists, Receiving Supervisor accepts on a space-available basis (may result in extended wait time); if no valid PO, guard turns delivery away with Buyer notification
Responsible (R): Guard / DC Receiving Supervisor
Accountable (A): DC Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W3C_Flow22</bpmn:incoming>
        <bpmn:outgoing>W3C_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W3C_Task13" name="System maintains dock door utilization dashboard per DC: shows scheduled…">
        <bpmn:documentation>Step 6: System maintains dock door utilization dashboard per DC: shows scheduled appointments, completed receipts, and available capacity by time slot; Receiving Supervisor uses dashboard to optimize dock assignments and avoid congestion
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W3C_Flow23</bpmn:incoming>
        <bpmn:outgoing>W3C_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W3C_Task14" name="Monthly: DC Receiving Supervisor reviews appointment compliance report — vendor…">
        <bpmn:documentation>Step 7: Monthly: DC Receiving Supervisor reviews appointment compliance report — vendor on-time arrival %, no-show rate, unscheduled delivery rate; feeds into vendor scorecard (W44) and carrier performance review (W52)
Responsible (R): DC Receiving Supervisor
Accountable (A): DC Manager
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W3C_Flow24</bpmn:incoming>
        <bpmn:outgoing>W3C_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3C_End15" name="Complete">
        <bpmn:incoming>W3C_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3C_Annotation16">
        <bpmn:text>Controls: (none recorded)
Owner: DC Receiving Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3C_Assoc17" sourceRef="W3C_Annotation16" targetRef="W3C_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W3C_Flow18" sourceRef="W3C_Start7" targetRef="W3C_Task8" />
      <bpmn:sequenceFlow id="W3C_Flow19" sourceRef="W3C_Task8" targetRef="W3C_Task9" />
      <bpmn:sequenceFlow id="W3C_Flow20" sourceRef="W3C_Task9" targetRef="W3C_Task10" />
      <bpmn:sequenceFlow id="W3C_Flow21" sourceRef="W3C_Task10" targetRef="W3C_Task11" />
      <bpmn:sequenceFlow id="W3C_Flow22" sourceRef="W3C_Task11" targetRef="W3C_Task12" />
      <bpmn:sequenceFlow id="W3C_Flow23" sourceRef="W3C_Task12" targetRef="W3C_Task13" />
      <bpmn:sequenceFlow id="W3C_Flow24" sourceRef="W3C_Task13" targetRef="W3C_Task14" />
      <bpmn:sequenceFlow id="W3C_Flow25" sourceRef="W3C_Task14" targetRef="W3C_End15" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3C_diag">
      <bpmndi:BPMNPlane id="W3C_plane" bpmnElement="W_W3C">
        <bpmndi:BPMNShape id="W3C_Lane1_di" bpmnElement="W3C_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3C_Lane2_di" bpmnElement="W3C_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3C_Lane3_di" bpmnElement="W3C_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3C_Lane4_di" bpmnElement="W3C_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3C_Lane5_di" bpmnElement="W3C_Lane5" isHorizontal="true"><dc:Bounds x="160" y="760" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3C_Task8_di" bpmnElement="W3C_Task8"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
