        <bpmndi:BPMNShape id="W221_Task11_di" bpmnElement="W221_Task11"><dc:Bounds x="1240" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W221_Task12_di" bpmnElement="W221_Task12"><dc:Bounds x="1450" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W221_Start6_di" bpmnElement="W221_Start6"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W221_End13_di" bpmnElement="W221_End13"><dc:Bounds x="1680" y="657" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W221_Annotation14_di" bpmnElement="W221_Annotation14"><dc:Bounds x="160" y="800" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W221_Flow16_di" bpmnElement="W221_Flow16"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W221_Flow17_di" bpmnElement="W221_Flow17"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W221_Flow18_di" bpmnElement="W221_Flow18"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W221_Flow19_di" bpmnElement="W221_Flow19"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W221_Flow20_di" bpmnElement="W221_Flow20"><di:waypoint x="1210" y="675" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W221_Flow21_di" bpmnElement="W221_Flow21"><di:waypoint x="1420" y="165" /><di:waypoint x="1450" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W221_Flow22_di" bpmnElement="W221_Flow22"><di:waypoint x="1630" y="505" /><di:waypoint x="1680" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W221_Assoc15_di" bpmnElement="W221_Assoc15"><di:waypoint x="340" y="800" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W222" name="W222. DC Container Yard &amp; Chassis Management" isExecutable="false">
      <bpmn:documentation>Trigger: Import container arrives at DC gate, or empty container requires scheduling for port return
Frequency: 20–50 container movements per day
Volume: 200-slot yard capacity
Owner: Yard Superintendent
Participants: Gate Guard, Yard Coordinator, Reach Stacker Operator, Dispatcher, 3PL Truck Driver
Source: workflow W222 — DC Container Yard &amp; Chassis Management</bpmn:documentation>
      <bpmn:laneSet id="W222_LaneSet5">
        <bpmn:lane id="W222_Lane1" name="Gate Guard">
        <bpmn:flowNodeRef>W222_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W222_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W222_Lane2" name="System">
        <bpmn:flowNodeRef>W222_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W222_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W222_Lane3" name="Reach Stacker Operator">
        <bpmn:flowNodeRef>W222_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W222_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W222_Lane4" name="Yard Coordinator">
        <bpmn:flowNodeRef>W222_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W222_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W222_Start6" name="Import container arrives at DC gate, or empty container requires scheduling for port…">
        <bpmn:outgoing>W222_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W222_Task7" name="Gate-In Registration">
        <bpmn:documentation>Step 1: Gate-In Registration: Gate Guard inspects seal integrity, container physical state, and chassis lease records; scan-registers container number in Oracle WMS Yard Management (fit-gap C6); records gate-in timestamp
Responsible (R): Gate Guard
Accountable (A): Yard Superintendent
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W222_Flow16</bpmn:incoming>
        <bpmn:outgoing>W222_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W222_Task8" name="Yard Slot Assignment">
        <bpmn:documentation>Step 2: Yard Slot Assignment: YMS automatically assigns slot coordinates (grid lane, stack height) based on container status (Full Import, Empty Return, Hazmat quarantine) and priority
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W222_Flow17</bpmn:incoming>
        <bpmn:outgoing>W222_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W222_Task9" name="Physical Stacking">
        <bpmn:documentation>Step 3: Physical Stacking: Reach Stacker Operator picks container from truck chassis; places in assigned yard slot; scan-confirms the grid coordinates in YMS to update the real-time yard map
Responsible (R): Reach Stacker Operator
Accountable (A): Yard Coordinator
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W222_Flow18</bpmn:incoming>
        <bpmn:outgoing>W222_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W222_Task10" name="Demurrage &amp; Detention Tracking">
        <bpmn:documentation>Step 4: Demurrage &amp; Detention Tracking: YMS starts carrier-specific free-time countdown timers (e.g., 4 days yard free time, 7 days container lease); triggers daily priority warnings to Import Logistics team
Responsible (R): System
Accountable (A): Yard Superintendent
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W222_Flow19</bpmn:incoming>
        <bpmn:outgoing>W222_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W222_Task11" name="Stripping Scheduling">
        <bpmn:documentation>Step 5: Stripping Scheduling: Yard Coordinator assigns yard container to a warehouse dock; Reach Stacker Operator moves container to dock chassis; Receiving Clerk scan-registers goods receipt (W3)
Responsible (R): Yard Coordinator / Reach Stacker Operator
Accountable (A): —
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W222_Flow20</bpmn:incoming>
        <bpmn:outgoing>W222_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W222_Task12" name="Empty Container Gate-Out">
        <bpmn:documentation>Step 6: Empty Container Gate-Out: System marks container &quot;Empty&quot;; Dispatcher books return logistics; Reach Stacker Operator loads empty container to carrier chassis; Gate Guard records gate-out, verifies empty status, and registers time in YMS
Responsible (R): Reach Stacker Operator / Gate Guard
Accountable (A): Yard Superintendent
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W222_Flow21</bpmn:incoming>
        <bpmn:outgoing>W222_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W222_End13" name="Complete">
        <bpmn:incoming>W222_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W222_Annotation14">
        <bpmn:text>Controls: - CTL-250 (ensure controlled execution — DC Inbound Operations (PA-04.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Yard Superintendent</bpmn:text>
      </bpmn:textAnnotation>
