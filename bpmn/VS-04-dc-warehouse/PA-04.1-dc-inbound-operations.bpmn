      <bpmn:sequenceFlow id="W1271_Flow23" sourceRef="W1271_Task10" targetRef="W1271_Task11" />
      <bpmn:sequenceFlow id="W1271_Flow24" sourceRef="W1271_Task11" targetRef="W1271_Task12" />
      <bpmn:sequenceFlow id="W1271_Flow25" sourceRef="W1271_Task12" targetRef="W1271_Task13" />
      <bpmn:sequenceFlow id="W1271_Flow26" sourceRef="W1271_Task13" targetRef="W1271_Task14" />
      <bpmn:sequenceFlow id="W1271_Flow27" sourceRef="W1271_Task14" targetRef="W1271_Task15" />
      <bpmn:sequenceFlow id="W1271_Flow28" sourceRef="W1271_Task15" targetRef="W1271_Task16" />
      <bpmn:sequenceFlow id="W1271_Flow29" sourceRef="W1271_Task16" targetRef="W1271_Task17" />
      <bpmn:sequenceFlow id="W1271_Flow30" sourceRef="W1271_Task17" targetRef="W1271_End18" />
    </bpmn:process>
