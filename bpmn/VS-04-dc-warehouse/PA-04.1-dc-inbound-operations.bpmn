        <bpmn:flowNodeRef>W66_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W66_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W66_Start7" name="Inter-DC transfer (W22) between islands (e.g., DC3 Luzon → DC2 Visayas, DC1 Mindanao →…">
        <bpmn:outgoing>W66_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W66_Task8" name="Supply Planner identifies need for inter-island transfer (W22) when demand at a…">
        <bpmn:documentation>Step 1: Supply Planner identifies need for inter-island transfer (W22) when demand at a DC cannot be met from same-island supply and vendor PO lead time is too long; or when seasonal inventory rebalancing requires inter-island movement
Responsible (R): Supply Planner
Accountable (A): Supply Planning Manager
Duration: Per W22</bpmn:documentation>
        <bpmn:incoming>W66_Flow20</bpmn:incoming>
        <bpmn:outgoing>W66_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W66_Task9" name="ro-ro ferry">
        <bpmn:documentation>Step 2: Import Coordinator or Fleet Manager selects inter-island carrier and route: (a) ro-ro ferry — for truck-loaded cargo; vehicle driven onto ferry; 12–36 hours transit; routes: Manila→Cebu, Cebu→Davao, Manila→Davao (via Matnog); (b) container vessel — for containerized cargo; 3–7 days transit depending on route and vessel schedule; (c) LCL consolidator — for small transfers that don&#x27;t fill a container
Responsible (R): Import Coordinator / Fleet Manager
Accountable (A): Supply Chain Manager
Duration: 1–2 hours/shipment</bpmn:documentation>
        <bpmn:incoming>W66_Flow21</bpmn:incoming>
        <bpmn:outgoing>W66_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W66_Task10" name="System creates Transfer Order per W22 with &quot;Inter-Island&quot; transport mode flag…">
        <bpmn:documentation>Step 3: System creates Transfer Order per W22 with &quot;Inter-Island&quot; transport mode flag; extended lead time applied (3–7 days vs. 1–3 days for same-island); in-transit insurance coverage confirmed per W59 (cargo/in-transit policy)
Responsible (R): Supply Planner
Accountable (A): Supply Planning Manager
Duration: Per W22</bpmn:documentation>
        <bpmn:incoming>W66_Flow22</bpmn:incoming>
        <bpmn:outgoing>W66_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W66_Task11" name="Source DC picks and loads goods; for container shipments: DC packs into…">
        <bpmn:documentation>Step 4: Source DC picks and loads goods; for container shipments: DC packs into container and seals; for ro-ro: goods loaded on owned or 3PL truck
Responsible (R): DC Team
Accountable (A): DC Supervisor
Duration: Per W3/W4</bpmn:documentation>
        <bpmn:incoming>W66_Flow23</bpmn:incoming>
        <bpmn:outgoing>W66_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W66_Task12" name="Import Coordinator books shipment with carrier; provides container number or…">
        <bpmn:documentation>Step 5: Import Coordinator books shipment with carrier; provides container number or truck plate number, commodity description, and destination DC; receives booking confirmation and estimated arrival date
Responsible (R): Import Coordinator
Accountable (A): Fleet Manager
Duration: 30 min/shipment</bpmn:documentation>
        <bpmn:incoming>W66_Flow24</bpmn:incoming>
        <bpmn:outgoing>W66_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W66_Task13" name="In-transit tracking: Import Coordinator monitors shipment status via carrier…">
        <bpmn:documentation>Step 6: In-transit tracking: Import Coordinator monitors shipment status via carrier tracking or direct communication; updates system ETA; for ro-ro: monitors ferry schedule (weather delays common during typhoon season — W49)
Responsible (R): Import Coordinator
Accountable (A): Supply Chain Manager
Duration: 15 min/day per shipment</bpmn:documentation>
        <bpmn:incoming>W66_Flow25</bpmn:incoming>
        <bpmn:outgoing>W66_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W66_Task14" name="Goods arrive at destination port/DC; destination DC receives and processes…">
        <bpmn:documentation>Step 7: Goods arrive at destination port/DC; destination DC receives and processes Goods Receipt per W22 step 7; system records inter-island freight cost allocation to transferred inventory
Responsible (R): Receiving Clerk (DC)
Accountable (A): DC Supervisor
Duration: Per W22</bpmn:documentation>
        <bpmn:incoming>W66_Flow26</bpmn:incoming>
        <bpmn:outgoing>W66_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W66_Task15" name="System allocates inter-island freight cost to transferred items: freight cost ÷…">
        <bpmn:documentation>Step 8: System allocates inter-island freight cost to transferred items: freight cost ÷ total transferred value × per-item value added to destination inventory cost (similar to landed cost allocation in W2B.12 but for domestic inter-island movement)
Responsible (R): System
Accountable (A): Finance
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W66_Flow27</bpmn:incoming>
        <bpmn:outgoing>W66_Flow28</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W66_Task16" name="Monthly: Import Coordinator and Fleet Manager review inter-island logistics…">
        <bpmn:documentation>Step 9: Monthly: Import Coordinator and Fleet Manager review inter-island logistics cost and performance: cost per TEU by route, on-time delivery %, damage rate, carrier comparison; recommends route or carrier optimization
Responsible (R): Import Coordinator / Fleet Manager
Accountable (A): Supply Chain Manager
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W66_Flow28</bpmn:incoming>
        <bpmn:outgoing>W66_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W66_End17" name="Complete">
        <bpmn:incoming>W66_Flow29</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W66_Annotation18">
        <bpmn:text>Controls: - CTL-250 (ensure controlled execution — DC Inbound Operations (PA-04.1).) | - operational: Import Coordinator / Fleet Manager review and approval gate
Owner: Import Coordinator / Fleet Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W66_Assoc19" sourceRef="W66_Annotation18" targetRef="W66_Start7" associationDirection="None" />
