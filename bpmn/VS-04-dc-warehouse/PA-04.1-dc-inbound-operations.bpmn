<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-04.1-dc-inbound-operations" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3" name="W3. Warehouse Receiving &amp; Putaway" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor delivery truck arrives at DC (or container from port)
Frequency: ~6,000 goods receipts/month across all DCs; ~1,500/DC/month; ~50/day per DC
Volume: ~2 lines per receipt on average (the ~12,000 PO-lines/month all-types canon across the ~6,000 goods-receipts/month canon — bulk POs arrive as multiple partial truck receipts, per data-volumes §1.1/§1.2)
Owner: DC Receiving Supervisor
Participants: Receiving Clerk, Quality Checker, Putaway Staff, DC Supervisor, Buyer (if discrepancy), Special Handling Lead, Discrepancy Analysts
Source: workflow W3 — Warehouse Receiving &amp; Putaway</bpmn:documentation>
      <bpmn:laneSet id="W3_LaneSet7">
        <bpmn:lane id="W3_Lane1" name="Guard">
        <bpmn:flowNodeRef>W3_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3_Lane2" name="Receiving Clerk">
        <bpmn:flowNodeRef>W3_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3_Lane3" name="Unloading Crew">
        <bpmn:flowNodeRef>W3_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3_Lane4" name="Quality Checker">
        <bpmn:flowNodeRef>W3_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3_Lane5" name="System">
        <bpmn:flowNodeRef>W3_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3_Task18</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3_Lane6" name="Putaway Staff">
        <bpmn:flowNodeRef>W3_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3_End19</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3_Start8" name="Vendor delivery truck arrives at DC (or container from port)">
        <bpmn:outgoing>W3_Flow22</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3_Task9" name="Truck arrives at DC gate; guard checks delivery schedule vs. appointment log">
        <bpmn:documentation>Step 1: Truck arrives at DC gate; guard checks delivery schedule vs. appointment log
Responsible (R): Guard
Accountable (A): DC Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W3_Flow22</bpmn:incoming>
        <bpmn:outgoing>W3_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3_Task10" name="Receiving Clerk pulls up expected PO or Transfer Order in system">
        <bpmn:documentation>Step 2: Receiving Clerk pulls up expected PO or Transfer Order in system
Responsible (R): Receiving Clerk
Accountable (A): DC Supervisor
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W3_Flow23</bpmn:incoming>
        <bpmn:outgoing>W3_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3_Task11" name="Unload truck; stage in receiving area">
        <bpmn:documentation>Step 3: Unload truck; stage in receiving area
Responsible (R): Unloading Crew (3–4)
Accountable (A): Receiving Clerk
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W3_Flow24</bpmn:incoming>
        <bpmn:outgoing>W3_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3_Task12" name="Scan/verify each item against PO: SKU, quantity, lot/batch (if applicable)">
        <bpmn:documentation>Step 4: Scan/verify each item against PO: SKU, quantity, lot/batch (if applicable)
Responsible (R): Receiving Clerk
Accountable (A): DC Supervisor
Duration: 20–40 min</bpmn:documentation>
        <bpmn:incoming>W3_Flow25</bpmn:incoming>
        <bpmn:outgoing>W3_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3_Task13" name="Quality check on sampled items (damage, correctness, expiry if applicable) per…">
        <bpmn:documentation>Step 5: Quality check on sampled items (damage, correctness, expiry if applicable) per category-specific inspection checklist (see Quality Inspection Standards below)
Responsible (R): Quality Checker
Accountable (A): DC Supervisor
Duration: 10–20 min</bpmn:documentation>
        <bpmn:incoming>W3_Flow26</bpmn:incoming>
        <bpmn:outgoing>W3_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3_Task14" name="If discrepancy (shortage, damage, wrong item): flag in system; notify Buyer">
        <bpmn:documentation>Step 6: If discrepancy (shortage, damage, wrong item): flag in system; notify Buyer
Responsible (R): Receiving Clerk
Accountable (A): DC Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W3_Flow27</bpmn:incoming>
        <bpmn:outgoing>W3_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3_Task15" name="Confirm Goods Receipt in system; inventory increases in real-time">
        <bpmn:documentation>Step 7: Confirm Goods Receipt in system; inventory increases in real-time
Responsible (R): Receiving Clerk
Accountable (A): DC Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W3_Flow28</bpmn:incoming>
        <bpmn:outgoing>W3_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W3_Task16" name="System suggests putaway location based on zone, bin capacity, item velocity">
        <bpmn:documentation>Step 8: System suggests putaway location based on zone, bin capacity, item velocity
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W3_Flow29</bpmn:incoming>
        <bpmn:outgoing>W3_Flow30</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W3_Task17" name="Putaway staff moves goods to assigned bin; scan-confirm in system">
        <bpmn:documentation>Step 9: Putaway staff moves goods to assigned bin; scan-confirm in system
Responsible (R): Putaway Staff
Accountable (A): DC Supervisor
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W3_Flow30</bpmn:incoming>
        <bpmn:outgoing>W3_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W3_Task18" name="Update PO/TO status; trigger vendor invoice matching (AP)">
        <bpmn:documentation>Step 10: Update PO/TO status; trigger vendor invoice matching (AP)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W3_Flow31</bpmn:incoming>
        <bpmn:outgoing>W3_Flow32</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W3_End19" name="Complete">
        <bpmn:incoming>W3_Flow32</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3_Annotation20">
        <bpmn:text>Controls: - CTL-09 (separate purchasing from receiving.); CTL-56 (ensure barcode/GTIN master consistency.) | - operational: DC Receiving Supervisor review and approval gate
Owner: DC Receiving Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3_Assoc21" sourceRef="W3_Annotation20" targetRef="W3_Start8" associationDirection="None" />
      <bpmn:sequenceFlow id="W3_Flow22" sourceRef="W3_Start8" targetRef="W3_Task9" />
      <bpmn:sequenceFlow id="W3_Flow23" sourceRef="W3_Task9" targetRef="W3_Task10" />
      <bpmn:sequenceFlow id="W3_Flow24" sourceRef="W3_Task10" targetRef="W3_Task11" />
      <bpmn:sequenceFlow id="W3_Flow25" sourceRef="W3_Task11" targetRef="W3_Task12" />
      <bpmn:sequenceFlow id="W3_Flow26" sourceRef="W3_Task12" targetRef="W3_Task13" />
      <bpmn:sequenceFlow id="W3_Flow27" sourceRef="W3_Task13" targetRef="W3_Task14" />
      <bpmn:sequenceFlow id="W3_Flow28" sourceRef="W3_Task14" targetRef="W3_Task15" />
      <bpmn:sequenceFlow id="W3_Flow29" sourceRef="W3_Task15" targetRef="W3_Task16" />
      <bpmn:sequenceFlow id="W3_Flow30" sourceRef="W3_Task16" targetRef="W3_Task17" />
      <bpmn:sequenceFlow id="W3_Flow31" sourceRef="W3_Task17" targetRef="W3_Task18" />
      <bpmn:sequenceFlow id="W3_Flow32" sourceRef="W3_Task18" targetRef="W3_End19" />
    </bpmn:process>
