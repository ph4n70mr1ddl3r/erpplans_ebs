        <bpmndi:BPMNShape id="W221_Lane3_di" bpmnElement="W221_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W221_Lane4_di" bpmnElement="W221_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W221_Task7_di" bpmnElement="W221_Task7"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
