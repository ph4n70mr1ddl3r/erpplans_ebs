    <bpmn:process id="W_W3B" name="W3B. Yard &amp; Outdoor Inventory Management" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor delivery of lumber, cement, steel/rebar, or other bulky items requiring outdoor yard storage
Frequency: Daily; ~10–20 yard receipts per DC/day
Volume: ~30–40% of total DC inventory by volume stored in yard zones across 4 DCs and 200 store yards
Owner: DC Yard Supervisor (DC); Department Supervisor (Store)
Participants: Receiving Clerk, Yard Staff, Stock Associate, DC Supervisor / Dept. Supervisor
Source: workflow W3B — Yard &amp; Outdoor Inventory Management</bpmn:documentation>
      <bpmn:laneSet id="W3B_LaneSet5">
        <bpmn:lane id="W3B_Lane1" name="Receiving Clerk">
        <bpmn:flowNodeRef>W3B_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3B_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3B_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3B_Lane2" name="System">
        <bpmn:flowNodeRef>W3B_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3B_Lane3" name="Yard Staff">
        <bpmn:flowNodeRef>W3B_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3B_Lane4" name="Stock Associate">
        <bpmn:flowNodeRef>W3B_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3B_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3B_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3B_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3B_Start6" name="Vendor delivery of lumber, cement, steel/rebar, or other bulky items requiring outdoor…">
        <bpmn:outgoing>W3B_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3B_Task7" name="Goods received at yard gate (separate from indoor receiving); Receiving Clerk…">
        <bpmn:documentation>Step 1: Goods received at yard gate (separate from indoor receiving); Receiving Clerk verifies against PO/TO using handheld
Responsible (R): Receiving Clerk
Accountable (A): DC Supervisor / Dept. Supervisor
Duration: 20–40 min</bpmn:documentation>
        <bpmn:incoming>W3B_Flow17</bpmn:incoming>
        <bpmn:outgoing>W3B_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W3B_Task8" name="System records receipt into yard zone (zone-level tracking, not individual…">
        <bpmn:documentation>Step 2: System records receipt into yard zone (zone-level tracking, not individual bin); inventory tracked by yard zone (e.g., Yard-A: Lumber, Yard-B: Cement/Blocks, Yard-C: Steel/Rebar)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W3B_Flow18</bpmn:incoming>
        <bpmn:outgoing>W3B_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W3B_Task9" name="For catch-weight items (lumber, rebar): associate measures and records actual…">
        <bpmn:documentation>Step 3: For catch-weight items (lumber, rebar): associate measures and records actual length/piece count at receipt; system calculates quantity in board feet / linear meters / pieces
Responsible (R): Receiving Clerk
Accountable (A): Dept. Supervisor
Duration: 10–20 min</bpmn:documentation>
        <bpmn:incoming>W3B_Flow19</bpmn:incoming>
        <bpmn:outgoing>W3B_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3B_Task10" name="Goods staged in designated yard zone; organized by SKU type and length/size for…">
        <bpmn:documentation>Step 4: Goods staged in designated yard zone; organized by SKU type and length/size for easy retrieval
Responsible (R): Yard Staff
Accountable (A): DC Supervisor
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W3B_Flow20</bpmn:incoming>
        <bpmn:outgoing>W3B_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3B_Task11" name="Physical counting: yard items counted by zone during cycle counts (W6) and…">
        <bpmn:documentation>Step 5: Physical counting: yard items counted by zone during cycle counts (W6) and annual physical inventory (W42); counted by piece/bundle rather than individual bin scan
Responsible (R): Stock Associate
Accountable (A): Dept. Supervisor
Duration: Per W6/W42</bpmn:documentation>
        <bpmn:incoming>W3B_Flow21</bpmn:incoming>
        <bpmn:outgoing>W3B_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3B_Task12" name="Weather damage discovered during daily yard walkthrough: Stock Associate…">
        <bpmn:documentation>Step 6: Weather damage discovered during daily yard walkthrough: Stock Associate reports damage (warped lumber, water-damaged cement, rusted rebar); DC Supervisor/Dept. Supervisor approves disposition (markdown, scrap, RTV, insurance claim) per W3.6a process
Responsible (R): Stock Associate
Accountable (A): DC Supervisor / Dept. Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W3B_Flow22</bpmn:incoming>
        <bpmn:outgoing>W3B_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3B_Task13" name="Yard-to-sales-floor movement: when yard stock is needed indoors (e.g., small…">
        <bpmn:documentation>Step 7: Yard-to-sales-floor movement: when yard stock is needed indoors (e.g., small lumber pieces moved to indoor display), Stock Associate transfers items in system from yard zone to indoor location
Responsible (R): Stock Associate
Accountable (A): Dept. Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W3B_Flow23</bpmn:incoming>
        <bpmn:outgoing>W3B_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3B_End14" name="Complete">
        <bpmn:incoming>W3B_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3B_Annotation15">
        <bpmn:text>Controls: (none recorded)
Owner: DC Yard Supervisor (DC); Department Supervisor (Store)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3B_Assoc16" sourceRef="W3B_Annotation15" targetRef="W3B_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W3B_Flow17" sourceRef="W3B_Start6" targetRef="W3B_Task7" />
      <bpmn:sequenceFlow id="W3B_Flow18" sourceRef="W3B_Task7" targetRef="W3B_Task8" />
      <bpmn:sequenceFlow id="W3B_Flow19" sourceRef="W3B_Task8" targetRef="W3B_Task9" />
      <bpmn:sequenceFlow id="W3B_Flow20" sourceRef="W3B_Task9" targetRef="W3B_Task10" />
      <bpmn:sequenceFlow id="W3B_Flow21" sourceRef="W3B_Task10" targetRef="W3B_Task11" />
      <bpmn:sequenceFlow id="W3B_Flow22" sourceRef="W3B_Task11" targetRef="W3B_Task12" />
      <bpmn:sequenceFlow id="W3B_Flow23" sourceRef="W3B_Task12" targetRef="W3B_Task13" />
      <bpmn:sequenceFlow id="W3B_Flow24" sourceRef="W3B_Task13" targetRef="W3B_End14" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3B_diag">
      <bpmndi:BPMNPlane id="W3B_plane" bpmnElement="W_W3B">
        <bpmndi:BPMNShape id="W3B_Lane1_di" bpmnElement="W3B_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3B_Lane2_di" bpmnElement="W3B_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3B_Lane3_di" bpmnElement="W3B_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3B_Lane4_di" bpmnElement="W3B_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1790" height="170" /></bpmndi:BPMNShape>
