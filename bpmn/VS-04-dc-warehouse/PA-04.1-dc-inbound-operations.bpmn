    <bpmn:process id="W_W648" name="W648. DC Cycle Counting &amp; Inventory Accuracy Program" isExecutable="false">
      <bpmn:documentation>Trigger: Daily per DC zone schedule; triggered by variance alert
Frequency: Daily zone counting (A-items monthly, B-items quarterly, C-items semi-annually); full annual wall-to-wall per W42
Volume: ~7,000 SKUs per DC; ~100–150 counts/day per DC on the A/B/C cadence (~400–600 counts/day across 4 DCs)
Owner: DC Inventory Supervisor
Participants: Cycle Counter, DC Manager, Inventory Planner, LP Analyst (variance investigation)
Source: workflow W648 — DC Cycle Counting &amp; Inventory Accuracy Program</bpmn:documentation>
      <bpmn:laneSet id="W648_LaneSet5">
        <bpmn:lane id="W648_Lane1" name="System">
        <bpmn:flowNodeRef>W648_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W648_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W648_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W648_Lane2" name="Cycle Counter">
        <bpmn:flowNodeRef>W648_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W648_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W648_Lane3" name="DC Inventory Supervisor">
        <bpmn:flowNodeRef>W648_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W648_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W648_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W648_Lane4" name="DC Manager">
        <bpmn:flowNodeRef>W648_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W648_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W648_Start6" name="Daily per DC zone schedule; triggered by variance alert">
        <bpmn:outgoing>W648_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W648_Task7" name="System generates daily cycle count task list by zone based on ABC…">
        <bpmn:documentation>Step 1: System generates daily cycle count task list by zone based on ABC classification frequency schedule and variance-triggered recounts; assigns to Cycle Counter via RF device
Responsible (R): System
Accountable (A): DC Inventory Supervisor
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W648_Flow18</bpmn:incoming>
        <bpmn:outgoing>W648_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W648_Task8" name="Cycle Counter performs physical count at system-directed bin locations using RF…">
        <bpmn:documentation>Step 2: Cycle Counter performs physical count at system-directed bin locations using RF scanner; records count quantity; system flags variance against book quantity
Responsible (R): Cycle Counter
Accountable (A): DC Inventory Supervisor
Duration: 4–6 hours/day</bpmn:documentation>
        <bpmn:incoming>W648_Flow19</bpmn:incoming>
        <bpmn:outgoing>W648_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W648_Task9" name="For items within tolerance (A-items: ±0.5%, B-items: ±1%, C-items: ±2%): system…">
        <bpmn:documentation>Step 3: For items within tolerance (A-items: ±0.5%, B-items: ±1%, C-items: ±2%): system auto-adjusts book quantity; adjustment posted with cycle count reference
Responsible (R): System
Accountable (A): DC Inventory Supervisor
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W648_Flow20</bpmn:incoming>
        <bpmn:outgoing>W648_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W648_Task10" name="For items outside tolerance: system generates recount task; Cycle Counter…">
        <bpmn:documentation>Step 4: For items outside tolerance: system generates recount task; Cycle Counter performs blind recount (no prior count visible)
Responsible (R): Cycle Counter
Accountable (A): DC Inventory Supervisor
Duration: 30 min/recount</bpmn:documentation>
        <bpmn:incoming>W648_Flow21</bpmn:incoming>
        <bpmn:outgoing>W648_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W648_Task11" name="If recount confirms variance: DC Inventory Supervisor investigates root cause…">
        <bpmn:documentation>Step 5: If recount confirms variance: DC Inventory Supervisor investigates root cause (receiving error, miscount, misplacement, picking error, system error, theft); classifies root cause in system
Responsible (R): DC Inventory Supervisor
Accountable (A): DC Manager
Duration: 15 min/item</bpmn:documentation>
        <bpmn:incoming>W648_Flow22</bpmn:incoming>
        <bpmn:outgoing>W648_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W648_Task12" name="DC Inventory Supervisor submits adjustment for approval per threshold: DC…">
        <bpmn:documentation>Step 6: DC Inventory Supervisor submits adjustment for approval per threshold: DC Manager for adjustments &lt; PHP 50,000; VP Supply Chain for adjustments PHP 50,000–500,000; CFO for adjustments &gt; PHP 500,000
Responsible (R): DC Inventory Supervisor
Accountable (A): DC Manager
Duration: Varies by threshold</bpmn:documentation>
        <bpmn:incoming>W648_Flow23</bpmn:incoming>
        <bpmn:outgoing>W648_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W648_Task13" name="DC Manager reviews daily cycle count accuracy rate; targets ≥ 99.5% accuracy…">
        <bpmn:documentation>Step 7: DC Manager reviews daily cycle count accuracy rate; targets ≥ 99.5% accuracy for A-items, ≥ 98% for B-items, ≥ 95% for C-items; investigates recurring variance locations
Responsible (R): DC Manager
Accountable (A): VP Supply Chain
Duration: 30 min/day</bpmn:documentation>
        <bpmn:incoming>W648_Flow24</bpmn:incoming>
        <bpmn:outgoing>W648_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W648_Task14" name="Weekly: DC Inventory Supervisor produces cycle count accuracy report feeding DC…">
        <bpmn:documentation>Step 8: Weekly: DC Inventory Supervisor produces cycle count accuracy report feeding DC daily KPI dashboard (W586) and variance investigation queue
Responsible (R): DC Inventory Supervisor
Accountable (A): DC Manager
Duration: 1 hour/week</bpmn:documentation>
        <bpmn:incoming>W648_Flow25</bpmn:incoming>
        <bpmn:outgoing>W648_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W648_End15" name="Complete">
        <bpmn:incoming>W648_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W648_Annotation16">
        <bpmn:text>Controls: - CTL-250 (ensure controlled execution — DC Inbound Operations (PA-04.1).) | - operational: DC Inventory Supervisor review and approval gate
Owner: DC Inventory Supervisor</bpmn:text>
      </bpmn:textAnnotation>
