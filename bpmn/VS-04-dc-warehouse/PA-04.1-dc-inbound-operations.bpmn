    <bpmn:process id="W_W652" name="W652. Seasonal Warehouse Surge Planning &amp; Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Seasonal demand forecast (W32); triggered 8–12 weeks before peak season
Frequency: 4 major seasons/year: Christmas (Sep–Dec), Summer (Mar–May), Back-to-School (May–Jun), Rainy Season (Jun–Aug); plus 6 bi-monthly sale events
Volume: up to 1.5× normal DC volume at the canonical peak-day sizing (§1.1: 200 receipts/day → 300/day), with surge staffing plans for Christmas; extended-receipt days scheduled rather than single-day 2–3× spikes
Owner: DC Manager
Participants: VP Supply Chain, HR Manager (temporary labor), DC Inventory Supervisor, Category Manager
Source: workflow W652 — Seasonal Warehouse Surge Planning &amp; Execution</bpmn:documentation>
      <bpmn:laneSet id="W652_LaneSet3">
        <bpmn:lane id="W652_Lane1" name="DC Manager">
        <bpmn:flowNodeRef>W652_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W652_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W652_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W652_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W652_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W652_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W652_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W652_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W652_Lane2" name="HR Manager">
        <bpmn:flowNodeRef>W652_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W652_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W652_Start4" name="Seasonal demand forecast (W32); triggered 8–12 weeks before peak season">
        <bpmn:outgoing>W652_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W652_Task5" name="T-12 weeks: VP Supply Chain provides seasonal volume forecast per DC (units…">
        <bpmn:documentation>Step 1: T-12 weeks: VP Supply Chain provides seasonal volume forecast per DC (units, lines, orders); DC Manager compares forecast against current DC capacity (receiving docks, putaway zones, pick faces, shipping docks, labor)
Responsible (R): DC Manager
Accountable (A): VP Supply Chain
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W652_Flow16</bpmn:incoming>
        <bpmn:outgoing>W652_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W652_Task6" name="T-10 weeks: DC Manager develops surge plan: temporary labor requirement…">
        <bpmn:documentation>Step 2: T-10 weeks: DC Manager develops surge plan: temporary labor requirement (headcount, duration, shift pattern — extended hours or additional shift), equipment rental plan (forklifts, reach stackers, RF devices), overflow staging area activation plan, seasonal SKU forward-pick zone re-slotting
Responsible (R): DC Manager
Accountable (A): VP Supply Chain
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W652_Flow17</bpmn:incoming>
        <bpmn:outgoing>W652_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W652_Task7" name="T-8 weeks: HR Manager initiates seasonal staffing process (W555): temporary…">
        <bpmn:documentation>Step 3: T-8 weeks: HR Manager initiates seasonal staffing process (W555): temporary worker recruitment, abbreviated onboarding (safety + basic WMS operation), schedule alignment with surge plan
Responsible (R): HR Manager
Accountable (A): DC Manager
Duration: Per W555</bpmn:documentation>
        <bpmn:incoming>W652_Flow18</bpmn:incoming>
        <bpmn:outgoing>W652_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W652_Task8" name="T-6 weeks: DC Manager executes seasonal re-slotting: high-velocity seasonal…">
        <bpmn:documentation>Step 4: T-6 weeks: DC Manager executes seasonal re-slotting: high-velocity seasonal SKUs moved to forward-pick zones; reserve storage consolidated to create overflow receiving space; seasonal promotional displays and bulk staging areas designated
Responsible (R): DC Manager
Accountable (A): VP Supply Chain
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W652_Flow19</bpmn:incoming>
        <bpmn:outgoing>W652_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W652_Task9" name="T-4 weeks: Equipment rental delivery and commissioning; temporary worker first…">
        <bpmn:documentation>Step 5: T-4 weeks: Equipment rental delivery and commissioning; temporary worker first shift with supervised onboarding; extended operating hours commence; overflow area activated and stocked
Responsible (R): DC Manager
Accountable (A): VP Supply Chain
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W652_Flow20</bpmn:incoming>
        <bpmn:outgoing>W652_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W652_Task10" name="During peak: DC Manager monitors daily volume vs. forecast; adjusts labor…">
        <bpmn:documentation>Step 6: During peak: DC Manager monitors daily volume vs. forecast; adjusts labor allocation daily; activates 3rd shift if volume exceeds 2× normal for 3+ consecutive days; daily stand-up meetings with shift supervisors
Responsible (R): DC Manager
Accountable (A): VP Supply Chain
Duration: 30 min/day</bpmn:documentation>
        <bpmn:incoming>W652_Flow21</bpmn:incoming>
        <bpmn:outgoing>W652_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W652_Task11" name="T+2 weeks post-peak: DC Manager executes wind-down: return rental equipment…">
        <bpmn:documentation>Step 7: T+2 weeks post-peak: DC Manager executes wind-down: return rental equipment, release temporary workers per W555 offboarding, restore normal slotting, deactivate overflow areas, return to normal operating hours
Responsible (R): DC Manager
Accountable (A): VP Supply Chain
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W652_Flow22</bpmn:incoming>
        <bpmn:outgoing>W652_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W652_Task12" name="T+4 weeks post-peak: DC Manager produces seasonal surge performance report…">
        <bpmn:documentation>Step 8: T+4 weeks post-peak: DC Manager produces seasonal surge performance report: volume vs. forecast, labor productivity, overtime cost, equipment utilization, service level maintained, lessons learned for next surge
Responsible (R): DC Manager
Accountable (A): VP Supply Chain
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W652_Flow23</bpmn:incoming>
        <bpmn:outgoing>W652_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W652_End13" name="Complete">
        <bpmn:incoming>W652_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W652_Annotation14">
        <bpmn:text>Controls: - CTL-250 (ensure controlled execution — DC Inbound Operations (PA-04.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: DC Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W652_Assoc15" sourceRef="W652_Annotation14" targetRef="W652_Start4" associationDirection="None" />
