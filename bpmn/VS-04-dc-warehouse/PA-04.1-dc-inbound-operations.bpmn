    <bpmn:process id="W_W221" name="W221. Cross-Docking Operations for Fast-Moving Bulky Items" isExecutable="false">
      <bpmn:documentation>Trigger: Advance Shipping Notice (ASN) or incoming import container contains fast-moving bulk items (cement, steel rebar, standard tiles) with active store replenishment demands or backorders
Frequency: Daily at Distribution Centers
Volume: ~10–20 container-loads cross-docked per day
Owner: DC Operations Manager
Participants: Receiving Clerk, Cross-Dock Coordinator, Forklift Operator, Shipping Clerk
Source: workflow W221 — Cross-Docking Operations for Fast-Moving Bulky Items</bpmn:documentation>
      <bpmn:laneSet id="W221_LaneSet5">
        <bpmn:lane id="W221_Lane1" name="System">
        <bpmn:flowNodeRef>W221_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W221_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W221_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W221_Lane2" name="Cross-Dock Coord">
        <bpmn:flowNodeRef>W221_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W221_Lane3" name="Forklift Operator">
        <bpmn:flowNodeRef>W221_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W221_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W221_Lane4" name="Receiving Clerk">
        <bpmn:flowNodeRef>W221_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W221_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W221_Start6" name="Advance Shipping Notice (ASN) or incoming import container contains fast-moving bulk…">
        <bpmn:outgoing>W221_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W221_Task7" name="Pre-Allocation Matching">
        <bpmn:documentation>Step 1: Pre-Allocation Matching: System evaluates incoming container ASN against active store replenishment orders (W4) and customer backorders (W56); identifies high-matching fast-moving SKUs suitable for cross-docking
Responsible (R): System
Accountable (A): DC Operations Mgr
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W221_Flow16</bpmn:incoming>
        <bpmn:outgoing>W221_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W221_Task8" name="Dock Assignment">
        <bpmn:documentation>Step 2: Dock Assignment: Cross-Dock Coordinator assigns inbound container to a receiving dock adjacent to outbound store dispatch doors
Responsible (R): Cross-Dock Coord
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W221_Flow17</bpmn:incoming>
        <bpmn:outgoing>W221_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W221_Task9" name="Unloading &amp; Direct Scan">
        <bpmn:documentation>Step 3: Unloading &amp; Direct Scan: Forklift Operator unloads pallets; scan-confirms receipt via WMS terminal; system detects pre-allocation and flags pallet for &quot;Direct Cross-Dock Staging&quot; (bypassing normal bulk putaway racks)
Responsible (R): Forklift Operator
Accountable (A): Receiving Supervisor
Duration: 15 min/pallet</bpmn:documentation>
        <bpmn:incoming>W221_Flow18</bpmn:incoming>
        <bpmn:outgoing>W221_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W221_Task10" name="Sorting &amp; Routing">
        <bpmn:documentation>Step 4: Sorting &amp; Routing: Receiving Clerk scan-confirms pallet; system generates store-specific routing labels and prints destination tags; Forklift Operator moves pallets directly to the designated outbound lane
Responsible (R): Receiving Clerk
Accountable (A): —
Duration: 5 min/pallet</bpmn:documentation>
        <bpmn:incoming>W221_Flow19</bpmn:incoming>
        <bpmn:outgoing>W221_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W221_Task11" name="Load Integration">
        <bpmn:documentation>Step 5: Load Integration: System automatically merges cross-docked pallets into the active outbound DC load planning schedule (W106) for store deliveries
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W221_Flow20</bpmn:incoming>
        <bpmn:outgoing>W221_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W221_Task12" name="Outbound Loading">
        <bpmn:documentation>Step 6: Outbound Loading: Forklift Operator loads the pallets directly onto the designated store delivery truck; scan-confirms loading; Shipping Clerk generates Outbound Transfer document
Responsible (R): Forklift Operator / Shipping Clerk
Accountable (A): DC Operations Mgr
Duration: 10 min/pallet</bpmn:documentation>
        <bpmn:incoming>W221_Flow21</bpmn:incoming>
        <bpmn:outgoing>W221_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W221_End13" name="Complete">
        <bpmn:incoming>W221_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W221_Annotation14">
        <bpmn:text>Controls: - CTL-250 (ensure controlled execution — DC Inbound Operations (PA-04.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: DC Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W221_Assoc15" sourceRef="W221_Annotation14" targetRef="W221_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W221_Flow16" sourceRef="W221_Start6" targetRef="W221_Task7" />
