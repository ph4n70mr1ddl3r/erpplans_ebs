    <bpmn:process id="W_W681" name="W681. DC Quality Control &amp; Vendor Compliance Inspection at Receiving" isExecutable="false">
      <bpmn:documentation>Trigger: Each inbound delivery at DC receiving dock
Frequency: Per delivery; ~6,000 inbound deliveries/month across 4 DCs (per the DC goods-receipt canon)
Volume: ~1,500 deliveries/DC/month; AQL sampling per PUR-016 on designated categories
Owner: QC Inspector
Participants: Receiving Supervisor, DC Operations Manager, Procurement Quality Engineer
Source: workflow W681 — DC Quality Control &amp; Vendor Compliance Inspection at Receiving</bpmn:documentation>
      <bpmn:laneSet id="W681_LaneSet5">
        <bpmn:lane id="W681_Lane1" name="Receiving Supervisor">
        <bpmn:flowNodeRef>W681_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W681_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W681_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W681_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W681_Lane2" name="QC Inspector">
        <bpmn:flowNodeRef>W681_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W681_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W681_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W681_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W681_Lane3" name="DC Operations Manager">
        <bpmn:flowNodeRef>W681_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W681_Lane4" name="Procurement Quality Engineer">
        <bpmn:flowNodeRef>W681_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W681_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W681_Start6" name="Each inbound delivery at DC receiving dock">
        <bpmn:outgoing>W681_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W681_Task7" name="Delivery arrives at DC; dock assigned per W585 scheduling; Receiving Supervisor…">
        <bpmn:documentation>Step 1: Delivery arrives at DC; dock assigned per W585 scheduling; Receiving Supervisor verifies carrier appointment and documentation (delivery receipt, packing list, customs clearance for imports per W464)
Responsible (R): Receiving Supervisor
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W681_Flow19</bpmn:incoming>
        <bpmn:outgoing>W681_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W681_Task8" name="Receiving Supervisor performs unloading with visual inspection: checks for…">
        <bpmn:documentation>Step 2: Receiving Supervisor performs unloading with visual inspection: checks for transit damage (crushed packaging, wet cartons, broken pallets), temperature indicator for sensitive goods per W492, and seal integrity for import containers; segregates suspect items in quarantine zone per W219
Responsible (R): Receiving Supervisor
Accountable (A): QC Inspector
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W681_Flow20</bpmn:incoming>
        <bpmn:outgoing>W681_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W681_Task9" name="QC Inspector performs AQL sampling per PUR-016 on designated categories…">
        <bpmn:documentation>Step 3: QC Inspector performs AQL sampling per PUR-016 on designated categories: selects random sample from lot per sampling plan; inspects for product quality (cosmetic defects, dimensional accuracy, finish quality), labeling compliance (barcode readability, required markings per DTI-BPS ICC/SOC per W447), and shelf-life verification for date-sensitive items (paint, adhesives, chemicals)
Responsible (R): QC Inspector
Accountable (A): —
Duration: 30-60 min</bpmn:documentation>
        <bpmn:incoming>W681_Flow21</bpmn:incoming>
        <bpmn:outgoing>W681_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W681_Task10" name="QC Inspector records inspection results in Oracle Quality (fit-gap C12): pass…">
        <bpmn:documentation>Step 4: QC Inspector records inspection results in Oracle Quality (fit-gap C12): pass, conditional pass (minor issues — accepted with notation), fail (rejected per W110); captures photos of defects
Responsible (R): QC Inspector
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W681_Flow22</bpmn:incoming>
        <bpmn:outgoing>W681_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W681_Task11" name="For failed inspections: QC Inspector creates quality hold per W219; Procurement…">
        <bpmn:documentation>Step 5: For failed inspections: QC Inspector creates quality hold per W219; Procurement Quality Engineer notified; vendor CAPA per W110 initiated; Receiving Supervisor processes partial receipt for accepted quantity
Responsible (R): QC Inspector
Accountable (A): Procurement Quality Engineer
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W681_Flow23</bpmn:incoming>
        <bpmn:outgoing>W681_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W681_Task12" name="For import shipments: QC Inspector verifies customs documentation completeness…">
        <bpmn:documentation>Step 6: For import shipments: QC Inspector verifies customs documentation completeness per W239, performs landed cost component verification (duty rate applied, freight allocation per FIN-013), and checks product certification compliance per W625 for regulated categories
Responsible (R): QC Inspector
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W681_Flow24</bpmn:incoming>
        <bpmn:outgoing>W681_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W681_Task13" name="Receiving Supervisor completes goods receipt in ERP for accepted items; system…">
        <bpmn:documentation>Step 7: Receiving Supervisor completes goods receipt in ERP for accepted items; system updates inventory with QC status; vendor scorecard per W44 updated with quality data
Responsible (R): Receiving Supervisor
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W681_Flow25</bpmn:incoming>
        <bpmn:outgoing>W681_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W681_Task14" name="Monthly: DC Operations Manager produces vendor quality report: defect rate by…">
        <bpmn:documentation>Step 8: Monthly: DC Operations Manager produces vendor quality report: defect rate by vendor, category, and DC; recurring defect patterns; vendor response time to CAPA
Responsible (R): DC Operations Manager
Accountable (A): —
Duration: 3 hours</bpmn:documentation>
        <bpmn:incoming>W681_Flow26</bpmn:incoming>
        <bpmn:outgoing>W681_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W681_Task15" name="Quarterly: Procurement Quality Engineer reviews AQL sampling parameters and…">
        <bpmn:documentation>Step 9: Quarterly: Procurement Quality Engineer reviews AQL sampling parameters and inspection criteria per PUR-016; adjusts sampling levels based on vendor quality history
Responsible (R): Procurement Quality Engineer
Accountable (A): DC Operations Manager
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W681_Flow27</bpmn:incoming>
        <bpmn:outgoing>W681_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W681_End16" name="Complete">
        <bpmn:incoming>W681_Flow28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W681_Annotation17">
        <bpmn:text>Controls: - CTL-250 (ensure controlled execution — DC Inbound Operations (PA-04.1).) | - operational: QC Inspector review and approval gate
Owner: QC Inspector</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W681_Assoc18" sourceRef="W681_Annotation17" targetRef="W681_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W681_Flow19" sourceRef="W681_Start6" targetRef="W681_Task7" />
