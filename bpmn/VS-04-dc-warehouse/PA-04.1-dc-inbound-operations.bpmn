      <bpmndi:BPMNPlane id="W681_plane" bpmnElement="W_W681">
        <bpmndi:BPMNShape id="W681_Lane1_di" bpmnElement="W681_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2210" height="170" /></bpmndi:BPMNShape>
