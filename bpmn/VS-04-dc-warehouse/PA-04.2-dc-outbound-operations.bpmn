      <bpmn:sequenceFlow id="W1368_Flow23" sourceRef="W1368_Task11" targetRef="W1368_Task12" />
      <bpmn:sequenceFlow id="W1368_Flow24" sourceRef="W1368_Task12" targetRef="W1368_Task13" />
      <bpmn:sequenceFlow id="W1368_Flow25" sourceRef="W1368_Task13" targetRef="W1368_End14" />
    </bpmn:process>
