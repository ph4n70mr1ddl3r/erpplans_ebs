      <bpmn:startEvent id="W1353_Start6" name="Pick completion and verification for outbound orders (store replenishment or ecommerce)">
        <bpmn:outgoing>W1353_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1353_Task7" name="System assigns completed pick orders to staging lanes based on: destination…">
        <bpmn:documentation>Step 1: System assigns completed pick orders to staging lanes based on: destination (store vs. ecommerce), carrier, and scheduled departure time
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1353_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1353_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1353_Task8" name="Staging Staff moves picked pallets/carts to assigned staging lane; scans…">
        <bpmn:documentation>Step 2: Staging Staff moves picked pallets/carts to assigned staging lane; scans staging location barcode to confirm placement
Responsible (R): Staging Staff
Accountable (A): DC Dispatch Coordinator
Duration: 5–10 min/shipment</bpmn:documentation>
        <bpmn:incoming>W1353_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1353_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1353_Task9" name="DC Dispatch Coordinator reviews dock schedule: assigns loading bay and time…">
        <bpmn:documentation>Step 3: DC Dispatch Coordinator reviews dock schedule: assigns loading bay and time slot per outbound shipment; reserves dock doors for expected inbound deliveries
Responsible (R): DC Dispatch Coordinator
Accountable (A): DC Manager
Duration: 30 min/morning + 30 min/afternoon</bpmn:documentation>
        <bpmn:incoming>W1353_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1353_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1353_Task10" name="System notifies truck driver (owned fleet or 3PL) of assigned dock door and…">
        <bpmn:documentation>Step 4: System notifies truck driver (owned fleet or 3PL) of assigned dock door and loading window via mobile app/SMS
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1353_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1353_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1353_Task11" name="Driver arrives at assigned dock door; Staging Staff and Driver conduct…">
        <bpmn:documentation>Step 5: Driver arrives at assigned dock door; Staging Staff and Driver conduct pre-loading inspection (seal integrity for ecommerce, pallet condition for store shipments)
Responsible (R): Staging Staff / Driver
Accountable (A): DC Dispatch Coordinator
Duration: 5 min/shipment</bpmn:documentation>
        <bpmn:incoming>W1353_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1353_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1353_Task12" name="Staging Staff loads shipment under DC Dispatch Coordinator supervision; system…">
        <bpmn:documentation>Step 6: Staging Staff loads shipment under DC Dispatch Coordinator supervision; system records load confirmation per order line
Responsible (R): Staging Staff
Accountable (A): DC Dispatch Coordinator
Duration: 15–30 min/shipment</bpmn:documentation>
        <bpmn:incoming>W1353_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1353_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1353_Task13" name="Driver signs digital load confirmation; system transmits shipment notification…">
        <bpmn:documentation>Step 7: Driver signs digital load confirmation; system transmits shipment notification to destination store (for replenishment) or ecommerce tracking (for parcels)
Responsible (R): Driver / System
Accountable (A): DC Dispatch Coordinator
Duration: 2 min/shipment</bpmn:documentation>
        <bpmn:incoming>W1353_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1353_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1353_Task14" name="DC Dispatch Coordinator monitors dock utilization throughout the day; reassigns…">
        <bpmn:documentation>Step 8: DC Dispatch Coordinator monitors dock utilization throughout the day; reassigns doors if delays create queuing
Responsible (R): DC Dispatch Coordinator
Accountable (A): DC Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W1353_Flow25</bpmn:incoming>
        <bpmn:outgoing>W1353_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1353_End15" name="Complete">
        <bpmn:incoming>W1353_Flow26</bpmn:incoming>
      </bpmn:endEvent>
