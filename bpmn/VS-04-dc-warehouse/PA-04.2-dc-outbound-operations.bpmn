      <bpmndi:BPMNPlane id="W1368_plane" bpmnElement="W_W1368">
        <bpmndi:BPMNShape id="W1368_Lane1_di" bpmnElement="W1368_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2000" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1368_Lane2_di" bpmnElement="W1368_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="2000" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1368_Lane3_di" bpmnElement="W1368_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="2000" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1368_Task6_di" bpmnElement="W1368_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1368_Task7_di" bpmnElement="W1368_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1368_Task8_di" bpmnElement="W1368_Task8"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1368_Task9_di" bpmnElement="W1368_Task9"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1368_Task10_di" bpmnElement="W1368_Task10"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1368_Task11_di" bpmnElement="W1368_Task11"><dc:Bounds x="1450" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1368_Task12_di" bpmnElement="W1368_Task12"><dc:Bounds x="1660" y="465" width="180" height="80" /></bpmndi:BPMNShape>
