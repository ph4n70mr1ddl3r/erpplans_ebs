      <bpmn:sequenceFlow id="W796_Flow22" sourceRef="W796_Task11" targetRef="W796_Task12" />
      <bpmn:sequenceFlow id="W796_Flow23" sourceRef="W796_Task12" targetRef="W796_End13" />
    </bpmn:process>
