    <bpmn:process id="W_W651" name="W651. Reverse Logistics Processing (Customer/Store Returns at DC)" isExecutable="false">
      <bpmn:documentation>Trigger: Store return shipment received at DC; ecommerce return received at DC
Frequency: ~6,000–9,000 return items/month across 4 DCs (per the ~50–75/DC/day Volume)
Volume: ~50–75 return items/DC/day
Owner: DC Returns Processor
Participants: Quality Inspector, DC Inventory Supervisor, Vendor Relations Coordinator, LP Analyst
Source: workflow W651 — Reverse Logistics Processing (Customer/Store Returns at DC)</bpmn:documentation>
      <bpmn:laneSet id="W651_LaneSet6">
        <bpmn:lane id="W651_Lane1" name="DC Returns Processor">
        <bpmn:flowNodeRef>W651_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W651_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W651_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W651_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W651_Lane2" name="Quality Inspector">
        <bpmn:flowNodeRef>W651_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W651_Lane3" name="Vendor Relations Coordinator">
        <bpmn:flowNodeRef>W651_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W651_Lane4" name="DC Inventory Supervisor">
        <bpmn:flowNodeRef>W651_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W651_Lane5" name="DC Manager">
        <bpmn:flowNodeRef>W651_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W651_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W651_Start7" name="Store return shipment received at DC; ecommerce return received at DC">
        <bpmn:outgoing>W651_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W651_Task8" name="DC Returns Processor receives return shipment from store or ecommerce carrier…">
        <bpmn:documentation>Step 1: DC Returns Processor receives return shipment from store or ecommerce carrier; scans return authorization (RA) number; verifies shipment matches RA manifest (item, quantity, condition)
Responsible (R): DC Returns Processor
Accountable (A): DC Inventory Supervisor
Duration: 15 min/shipment</bpmn:documentation>
        <bpmn:incoming>W651_Flow18</bpmn:incoming>
        <bpmn:outgoing>W651_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W651_Task9" name="Quality Inspector inspects each returned item against return reason code and…">
        <bpmn:documentation>Step 2: Quality Inspector inspects each returned item against return reason code and item condition: Grade A (sealed/original packaging, undamaged — restock to saleable inventory), Grade B (opened, minor cosmetic damage, complete accessories — eligible for discount bin or open-box sale per W549), Grade C (defective, damaged, missing parts — vendor RTV per W88, repair, or destroy), Grade D (safety hazard, contamination — immediate quarantine and destroy)
Responsible (R): Quality Inspector
Accountable (A): DC Inventory Supervisor
Duration: 5 min/item</bpmn:documentation>
        <bpmn:incoming>W651_Flow19</bpmn:incoming>
        <bpmn:outgoing>W651_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W651_Task10" name="DC Returns Processor updates system with inspection grade; system routes item…">
        <bpmn:documentation>Step 3: DC Returns Processor updates system with inspection grade; system routes item to appropriate disposition: Grade A → saleable putaway (W3), Grade B → discount staging area, Grade C → RTV staging (W88) or repair queue, Grade D → quarantine for destruction
Responsible (R): DC Returns Processor
Accountable (A): DC Inventory Supervisor
Duration: 3 min/item</bpmn:documentation>
        <bpmn:incoming>W651_Flow20</bpmn:incoming>
        <bpmn:outgoing>W651_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W651_Task11" name="For Grade C vendor-caused defects: Vendor Relations Coordinator initiates…">
        <bpmn:documentation>Step 4: For Grade C vendor-caused defects: Vendor Relations Coordinator initiates vendor claim with evidence (photos, defect description, original GR data); tracks vendor credit receipt per W88 SLA
Responsible (R): Vendor Relations Coordinator
Accountable (A): DC Inventory Supervisor
Duration: 15 min/claim</bpmn:documentation>
        <bpmn:incoming>W651_Flow21</bpmn:incoming>
        <bpmn:outgoing>W651_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W651_Task12" name="For LP-flagged returns (high-value items, serial returner items per W605…">
        <bpmn:documentation>Step 5: For LP-flagged returns (high-value items, serial returner items per W605, patterns suggesting return fraud): DC Returns Processor sets aside for LP Analyst investigation before disposition
Responsible (R): DC Returns Processor
Accountable (A): LP Analyst
Duration: As flagged</bpmn:documentation>
        <bpmn:incoming>W651_Flow22</bpmn:incoming>
        <bpmn:outgoing>W651_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W651_Task13" name="Weekly: DC Inventory Supervisor produces returns analytics: return rate by…">
        <bpmn:documentation>Step 6: Weekly: DC Inventory Supervisor produces returns analytics: return rate by category and store, grade distribution, vendor defect rate, processing cycle time, recovery rate (value recovered ÷ value returned)
Responsible (R): DC Inventory Supervisor
Accountable (A): DC Manager
Duration: 2 hours/week</bpmn:documentation>
        <bpmn:incoming>W651_Flow23</bpmn:incoming>
        <bpmn:outgoing>W651_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W651_Task14" name="Monthly: DC Manager reviews return trend data with Merchandising (W102) and…">
        <bpmn:documentation>Step 7: Monthly: DC Manager reviews return trend data with Merchandising (W102) and Supply Chain (W31); identifies systemic quality issues for vendor CAPA (W110) and assortment review (W1)
Responsible (R): DC Manager
Accountable (A): VP Supply Chain
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W651_Flow24</bpmn:incoming>
        <bpmn:outgoing>W651_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W651_End15" name="Complete">
        <bpmn:incoming>W651_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W651_Annotation16">
        <bpmn:text>Controls: - CTL-252 (ensure controlled execution — DC Operations Management (PA-04.3).) | - operational: DC Returns Processor review and approval gate
Owner: DC Returns Processor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W651_Assoc17" sourceRef="W651_Annotation16" targetRef="W651_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W651_Flow18" sourceRef="W651_Start7" targetRef="W651_Task8" />
