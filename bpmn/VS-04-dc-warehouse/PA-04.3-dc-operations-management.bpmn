        <bpmndi:BPMNEdge id="W796_Flow20_di" bpmnElement="W796_Flow20"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W796_Flow21_di" bpmnElement="W796_Flow21"><di:waypoint x="1420" y="335" /><di:waypoint x="1450" y="335" /></bpmndi:BPMNEdge>
