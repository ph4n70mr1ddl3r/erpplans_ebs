      <bpmn:sequenceFlow id="W1237_Flow20" sourceRef="W1237_Task9" targetRef="W1237_Task10" />
      <bpmn:sequenceFlow id="W1237_Flow21" sourceRef="W1237_Task10" targetRef="W1237_Task11" />
      <bpmn:sequenceFlow id="W1237_Flow22" sourceRef="W1237_Task11" targetRef="W1237_Task12" />
      <bpmn:sequenceFlow id="W1237_Flow23" sourceRef="W1237_Task12" targetRef="W1237_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1237_diag">
      <bpmndi:BPMNPlane id="W1237_plane" bpmnElement="W_W1237">
        <bpmndi:BPMNShape id="W1237_Lane1_di" bpmnElement="W1237_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1237_Lane2_di" bpmnElement="W1237_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1237_Lane3_di" bpmnElement="W1237_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1790" height="170" /></bpmndi:BPMNShape>
