<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-04.3-dc-operations-management" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W188" name="W188. Fleet Spare Parts &amp; Preventive Maintenance (PM) Management" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled maintenance interval or spare part depletion
Frequency: Ongoing
Volume: Managing parts for ~40 owned vehicles
Owner: Fleet Manager
Participants: Driver, Workshop Supervisor, Procurement (for parts)
Source: workflow W188 — Fleet Spare Parts &amp; Preventive Maintenance (PM) Management</bpmn:documentation>
      <bpmn:laneSet id="W188_LaneSet4">
        <bpmn:lane id="W188_Lane1" name="System">
        <bpmn:flowNodeRef>W188_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W188_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W188_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W188_Lane2" name="Fleet Manager">
        <bpmn:flowNodeRef>W188_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W188_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W188_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W188_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W188_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W188_Lane3" name="Workshop Staff">
        <bpmn:flowNodeRef>W188_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W188_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W188_Start5" name="Scheduled maintenance interval or spare part depletion">
        <bpmn:outgoing>W188_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W188_Task6" name="System tracks odometer/hours for each vehicle; triggers &quot;Maintenance Alert&quot;…">
        <bpmn:documentation>Step 1: System tracks odometer/hours for each vehicle; triggers &quot;Maintenance Alert&quot; (W52.4)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W188_Flow17</bpmn:incoming>
        <bpmn:outgoing>W188_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W188_Task7" name="Fleet Manager reviews spare parts inventory (tires, batteries, oil, filters…">
        <bpmn:documentation>Step 2: Fleet Manager reviews spare parts inventory (tires, batteries, oil, filters, brake pads)
Responsible (R): Fleet Manager
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W188_Flow18</bpmn:incoming>
        <bpmn:outgoing>W188_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W188_Task8" name="If parts below reorder point: System generates PO for parts (W2A)">
        <bpmn:documentation>Step 3: If parts below reorder point: System generates PO for parts (W2A)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W188_Flow19</bpmn:incoming>
        <bpmn:outgoing>W188_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W188_Task9" name="Vehicle sent to workshop; Fleet Manager issues &quot;Maintenance Work Order&quot;">
        <bpmn:documentation>Step 4: Vehicle sent to workshop; Fleet Manager issues &quot;Maintenance Work Order&quot;
Responsible (R): Fleet Manager
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W188_Flow20</bpmn:incoming>
        <bpmn:outgoing>W188_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W188_Task10" name="Workshop performs service; consumes spare parts from fleet inventory">
        <bpmn:documentation>Step 5: Workshop performs service; consumes spare parts from fleet inventory
Responsible (R): Workshop Staff
Accountable (A): —
Duration: 4-8 hours</bpmn:documentation>
        <bpmn:incoming>W188_Flow21</bpmn:incoming>
        <bpmn:outgoing>W188_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W188_Task11" name="Record maintenance details: parts used, labor hours, costs, next service…">
        <bpmn:documentation>Step 6: Record maintenance details: parts used, labor hours, costs, next service interval
Responsible (R): Fleet Manager
Accountable (A): —
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W188_Flow22</bpmn:incoming>
        <bpmn:outgoing>W188_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W188_Task12" name="Update vehicle status in Fleet Module: &quot;Available&quot;">
        <bpmn:documentation>Step 7: Update vehicle status in Fleet Module: &quot;Available&quot;
Responsible (R): Fleet Manager
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W188_Flow23</bpmn:incoming>
        <bpmn:outgoing>W188_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W188_Task13" name="Quarterly: Analyze maintenance cost per km across all vehicle brands/models">
        <bpmn:documentation>Step 8: Quarterly: Analyze maintenance cost per km across all vehicle brands/models
Responsible (R): Fleet Manager
Accountable (A): VP Supply Chain
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W188_Flow24</bpmn:incoming>
        <bpmn:outgoing>W188_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W188_End14" name="Complete">
        <bpmn:incoming>W188_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W188_Annotation15">
        <bpmn:text>Controls: - CTL-252 (ensure controlled execution — DC Operations Management (PA-04.3).) | - operational: Fleet Manager review and approval gate
Owner: Fleet Manager</bpmn:text>
      </bpmn:textAnnotation>
