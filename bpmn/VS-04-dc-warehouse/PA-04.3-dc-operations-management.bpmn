        <bpmndi:BPMNShape id="W1041_Start4_di" bpmnElement="W1041_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1041_End9_di" bpmnElement="W1041_End9"><dc:Bounds x="1260" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1041_Annotation10_di" bpmnElement="W1041_Annotation10"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1041_Flow12_di" bpmnElement="W1041_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1041_Flow13_di" bpmnElement="W1041_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1041_Flow14_di" bpmnElement="W1041_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1041_Flow15_di" bpmnElement="W1041_Flow15"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1041_Flow16_di" bpmnElement="W1041_Flow16"><di:waypoint x="1210" y="335" /><di:waypoint x="1260" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1041_Assoc11_di" bpmnElement="W1041_Assoc11"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1222" name="W1222. DC Hazardous Material Storage Compliance &amp; Inspection Program" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled (monthly inspection cycle); or triggered by DENR/Fire Bureau advisory; or triggered by hazmat incident
Frequency: Monthly compliance inspection per DC; quarterly comprehensive audit; annual third-party certification
Volume: 4 DCs × 12 monthly inspections = 48 inspections/year + 4 quarterly audits + annual certification
Owner: DC Safety Officer
Participants: DC Safety Officer, DC Manager, DENR Compliance Officer, Fire Safety Inspector, HSE Coordinator
Source: workflow W1222 — DC Hazardous Material Storage Compliance &amp; Inspection Program</bpmn:documentation>
      <bpmn:laneSet id="W1222_LaneSet5">
        <bpmn:lane id="W1222_Lane1" name="DC Safety Officer">
        <bpmn:flowNodeRef>W1222_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1222_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1222_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1222_Lane2" name="DC Staff">
        <bpmn:flowNodeRef>W1222_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1222_Lane3" name="HSE Coordinator">
        <bpmn:flowNodeRef>W1222_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1222_Lane4" name="External Consultant">
        <bpmn:flowNodeRef>W1222_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1222_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1222_Start6" name="Scheduled (monthly inspection cycle); or triggered by DENR/Fire Bureau advisory; or…">
        <bpmn:outgoing>W1222_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1222_Task7" name="Monthly compliance inspection">
        <bpmn:documentation>Step 1: Monthly compliance inspection: DC Safety Officer conducts walkthrough of all hazmat storage areas using standardized checklist: (a) Storage segregation: flammables separated from oxidizers; acids separated from bases; paint/solvents in dedicated ventilated cage; (b) Labeling: all containers have GHS-compliant labels with hazard pictograms, signal words, and first-aid information; no unlabeled containers; (c) Containment: spill pallets under liquid hazmat containers; drain covers in place; containment berms intact; (d) Ventilation: exhaust fans operational in paint/solvent storage cage; air quality within permissible exposure limits; (e) Fire safety: fire extinguishers (correct type for stored materials — CO2 for flammable liquids, dry chemical for general) present and within inspection date; sprinkler heads unobstructed; no ignition sources in flammable areas; (f) PPE: hazmat handling PPE (gloves, goggles, respirators) available and in good condition per W56; (g) Documentation: Safety Data Sheets (SDS) binder current and accessible for all stored hazmat
Responsible (R): DC Safety Officer
Accountable (A): DC Manager
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W1222_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1222_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1222_Task8" name="Safety Officer documents inspection findings in system: (a) photographs of any…">
        <bpmn:documentation>Step 2: Safety Officer documents inspection findings in system: (a) photographs of any deficiencies, (b) severity rating (Critical: immediate danger — stop operations until corrected; Major: regulatory violation — correct within 48 hours; Minor: best practice deviation — correct within 7 days), (c) assigns corrective actions with responsible person and deadline
Responsible (R): DC Safety Officer
Accountable (A): DC Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1222_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1222_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1222_Task9" name="Corrective action execution">
        <bpmn:documentation>Step 3: Corrective action execution: responsible person addresses deficiency: (a) Critical: DC Manager halts affected operations; Safety Officer oversees immediate correction; DC Manager authorizes restart after verification, (b) Major: corrected within 48 hours; Safety Officer verifies; (c) Minor: corrected within 7 days; Safety Officer verifies at next inspection; all corrections documented with before/after photos
Responsible (R): DC Staff / DC Safety Officer
Accountable (A): DC Manager
Duration: Variable</bpmn:documentation>
        <bpmn:incoming>W1222_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1222_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1222_Task10" name="Quarterly comprehensive audit">
        <bpmn:documentation>Step 4: Quarterly comprehensive audit: HSE Coordinator conducts in-depth audit per DC: (a) review all monthly inspection findings and corrective action closure rate, (b) interview DC staff on hazmat handling procedures — verify knowledge of SDS access, spill response, and emergency procedures, (c) inspect emergency equipment: eye wash stations, spill kits, emergency showers — test functionality, (d) review hazmat inventory: verify stored quantities within ECC permit limits, (e) check waste manifest: hazmat waste disposed per DENR-registered transporter with proper documentation, (f) compile audit score and trend against prior quarters
Responsible (R): HSE Coordinator
Accountable (A): COO
Duration: 1 day per DC</bpmn:documentation>
        <bpmn:incoming>W1222_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1222_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1222_Task11" name="Annual third-party certification">
        <bpmn:documentation>Step 5: Annual third-party certification: engage DENR-accredited environmental compliance consultant for: (a) comprehensive facility inspection, (b) ECC compliance review and renewal recommendation, (c) hazardous waste management audit, (d) Fire Safety Inspection Certificate (FSIC) from Bureau of Fire Protection, (e) any required emissions or discharge testing, (f) certification report submitted to DENR if required by ECC conditions
Responsible (R): External Consultant / HSE Coordinator
Accountable (A): COO
Duration: 2–3 days per DC</bpmn:documentation>
        <bpmn:incoming>W1222_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1222_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1222_End12" name="Complete">
        <bpmn:incoming>W1222_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1222_Annotation13">
        <bpmn:text>Controls: - CTL-252 (ensure controlled execution — DC Operations Management (PA-04.3).) | - operational: tracks SDS version dates and flags &gt; 3 years old
Owner: DC Safety Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1222_Assoc14" sourceRef="W1222_Annotation13" targetRef="W1222_Start6" associationDirection="None" />
