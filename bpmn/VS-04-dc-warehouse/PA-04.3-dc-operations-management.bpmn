        <bpmndi:BPMNEdge id="W1237_Flow17_di" bpmnElement="W1237_Flow17"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1237_Flow18_di" bpmnElement="W1237_Flow18"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
