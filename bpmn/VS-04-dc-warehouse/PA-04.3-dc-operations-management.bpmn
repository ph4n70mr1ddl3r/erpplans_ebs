        <bpmndi:BPMNEdge id="W1237_Flow20_di" bpmnElement="W1237_Flow20"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1237_Flow21_di" bpmnElement="W1237_Flow21"><di:waypoint x="1420" y="165" /><di:waypoint x="1450" y="335" /></bpmndi:BPMNEdge>
