    <bpmn:process id="W_W270" name="W270. Pallet &amp; Returnable Transport Packaging (RTP) Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Receipt of goods on vendor-owned pallets/crates or shipment to stores using internal RTP
Frequency: Daily
Volume: Hundreds of pallets/crates per DC per day; ~50–100 vendor RTP exchanges/day across all DCs
Owner: DC Manager (DC-level); Store Receiving Clerk (store-level)
Participants: DC Receiving Clerk, Store Receiving Clerk, Yard Coordinator, Vendor Logistics, AP Clerk, Finance
Source: workflow W270 — Pallet &amp; Returnable Transport Packaging (RTP) Tracking</bpmn:documentation>
      <bpmn:laneSet id="W270_LaneSet7">
        <bpmn:lane id="W270_Lane1" name="DC Receiving Clerk">
        <bpmn:flowNodeRef>W270_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W270_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W270_Lane2" name="System">
        <bpmn:flowNodeRef>W270_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W270_Lane3" name="DC Dispatch">
        <bpmn:flowNodeRef>W270_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W270_Lane4" name="Store Receiving Clerk">
        <bpmn:flowNodeRef>W270_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W270_Lane5" name="AP Clerk">
        <bpmn:flowNodeRef>W270_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W270_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W270_Lane6" name="DC Manager">
        <bpmn:flowNodeRef>W270_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W270_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W270_Start8" name="Receipt of goods on vendor-owned pallets/crates or shipment to stores using internal RTP">
        <bpmn:outgoing>W270_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W270_Task9" name="DC Receiving Clerk logs quantity and type of vendor-owned RTPs (pallets…">
        <bpmn:documentation>Step 1: DC Receiving Clerk logs quantity and type of vendor-owned RTPs (pallets, crates, totes) received alongside each PO Goods Receipt; records RTP type (standard pallet, custom crate, collapsible tote), vendor ID, and quantity in WMS
Responsible (R): DC Receiving Clerk
Accountable (A): DC Supervisor
Duration: 3 min/receipt</bpmn:documentation>
        <bpmn:incoming>W270_Flow19</bpmn:incoming>
        <bpmn:outgoing>W270_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W270_Task10" name="System updates the RTP liability balance for the vendor — increases vendor RTP…">
        <bpmn:documentation>Step 2: System updates the RTP liability balance for the vendor — increases vendor RTP receivable by quantity received; RTPs tracked as non-valuated assets (no inventory value) but with quantity accountability per vendor
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W270_Flow20</bpmn:incoming>
        <bpmn:outgoing>W270_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W270_Task11" name="DC transfers goods to stores using internal (BuildRight-owned) RTPs; system…">
        <bpmn:documentation>Step 3: DC transfers goods to stores using internal (BuildRight-owned) RTPs; system tracks internal RTP location from DC to store and records the store as the current RTP holder
Responsible (R): DC Dispatch / Store Receiving Clerk
Accountable (A): DC Supervisor
Duration: 2 min/dispatch</bpmn:documentation>
        <bpmn:incoming>W270_Flow21</bpmn:incoming>
        <bpmn:outgoing>W270_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W270_Task12" name="Store Receiving Clerk or DC Receiving Clerk returns empty vendor-owned RTPs to…">
        <bpmn:documentation>Step 4: Store Receiving Clerk or DC Receiving Clerk returns empty vendor-owned RTPs to vendor during next vendor delivery or scheduled pickup; system debits the vendor RTP liability balance by quantity returned; Guard verifies RTP count at gate-out
Responsible (R): Store Receiving Clerk / DC Receiving Clerk
Accountable (A): Store Manager / DC Supervisor
Duration: 5 min/return</bpmn:documentation>
        <bpmn:incoming>W270_Flow22</bpmn:incoming>
        <bpmn:outgoing>W270_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W270_Task13" name="Finance reconciles RTP balances monthly per vendor: system generates RTP aging…">
        <bpmn:documentation>Step 5: Finance reconciles RTP balances monthly per vendor: system generates RTP aging report showing outstanding vendor RTP receivables by vendor, RTP type, and days outstanding; AP Clerk compares system RTP balance to vendor&#x27;s RTP statement
Responsible (R): AP Clerk
Accountable (A): Controller
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W270_Flow23</bpmn:incoming>
        <bpmn:outgoing>W270_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W270_Task14" name="For lost or damaged RTPs: system generates penalty invoice per vendor RTP…">
        <bpmn:documentation>Step 6: For lost or damaged RTPs: system generates penalty invoice per vendor RTP agreement terms (standard penalty: PHP 300–500 per standard pallet, PHP 1,000–3,000 per custom crate); AP Clerk issues debit memo to vendor or deducts from next payment; if BuildRight-owned RTP lost by store, Store Manager investigates and absorbs cost in store shrinkage
Responsible (R): AP Clerk / Store Manager
Accountable (A): Controller
Duration: 15 min/case</bpmn:documentation>
        <bpmn:incoming>W270_Flow24</bpmn:incoming>
        <bpmn:outgoing>W270_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W270_Task15" name="Quarterly: DC Manager reviews RTP return rate per vendor and per store…">
        <bpmn:documentation>Step 7: Quarterly: DC Manager reviews RTP return rate per vendor and per store; identifies stores with low RTP return compliance for process improvement; flags vendors with persistent RTP discrepancies for contract renegotiation
Responsible (R): DC Manager
Accountable (A): Supply Chain Manager
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W270_Flow25</bpmn:incoming>
        <bpmn:outgoing>W270_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W270_End16" name="Complete">
        <bpmn:incoming>W270_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W270_Annotation17">
        <bpmn:text>Controls: - CTL-252 (ensure controlled execution — DC Operations Management (PA-04.3).)
Owner: DC Manager (DC-level); Store Receiving Clerk (store-level)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W270_Assoc18" sourceRef="W270_Annotation17" targetRef="W270_Start8" associationDirection="None" />
      <bpmn:sequenceFlow id="W270_Flow19" sourceRef="W270_Start8" targetRef="W270_Task9" />
      <bpmn:sequenceFlow id="W270_Flow20" sourceRef="W270_Task9" targetRef="W270_Task10" />
      <bpmn:sequenceFlow id="W270_Flow21" sourceRef="W270_Task10" targetRef="W270_Task11" />
      <bpmn:sequenceFlow id="W270_Flow22" sourceRef="W270_Task11" targetRef="W270_Task12" />
