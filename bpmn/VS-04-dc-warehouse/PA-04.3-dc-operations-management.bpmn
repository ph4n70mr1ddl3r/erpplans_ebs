        <bpmndi:BPMNShape id="W270_Task10_di" bpmnElement="W270_Task10"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W270_Task11_di" bpmnElement="W270_Task11"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
