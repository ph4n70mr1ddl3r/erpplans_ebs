      <bpmndi:BPMNPlane id="W270_plane" bpmnElement="W_W270">
        <bpmndi:BPMNShape id="W270_Lane1_di" bpmnElement="W270_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
