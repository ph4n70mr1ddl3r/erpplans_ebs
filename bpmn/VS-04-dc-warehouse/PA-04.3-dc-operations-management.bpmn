    <bpmn:process id="W_W650" name="W650. Warehouse Equipment Preventive Maintenance" isExecutable="false">
      <bpmn:documentation>Trigger: Maintenance schedule trigger; triggered by equipment failure or inspection finding
Frequency: Weekly inspection; monthly PM for forklifts and reach stackers; quarterly PM for conveyors and dock levelers; annual overhaul
Volume: ~20–30 forklifts/reach stackers per DC × 4 DCs = ~80–120 units; ~40 dock levelers; ~200 RF devices; misc. equipment
Owner: DC Maintenance Supervisor
Participants: Equipment Technician, DC Manager, Equipment Vendor Service Engineer, Finance Analyst (capex)
Source: workflow W650 — Warehouse Equipment Preventive Maintenance</bpmn:documentation>
      <bpmn:laneSet id="W650_LaneSet5">
        <bpmn:lane id="W650_Lane1" name="System">
        <bpmn:flowNodeRef>W650_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W650_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W650_Lane2" name="Equipment Technician">
        <bpmn:flowNodeRef>W650_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W650_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W650_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W650_Lane3" name="DC Maintenance Supervisor">
        <bpmn:flowNodeRef>W650_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W650_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W650_Lane4" name="Finance Analyst">
        <bpmn:flowNodeRef>W650_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W650_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W650_Start6" name="Maintenance schedule trigger; triggered by equipment failure or inspection finding">
        <bpmn:outgoing>W650_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W650_Task7" name="System generates PM work orders based on equipment maintenance schedule…">
        <bpmn:documentation>Step 1: System generates PM work orders based on equipment maintenance schedule (manufacturer-recommended intervals + usage hours from telematics); assigns to Equipment Technician
Responsible (R): System
Accountable (A): DC Maintenance Supervisor
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W650_Flow17</bpmn:incoming>
        <bpmn:outgoing>W650_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W650_Task8" name="Equipment Technician executes PM per equipment-specific checklist: forklifts…">
        <bpmn:documentation>Step 2: Equipment Technician executes PM per equipment-specific checklist: forklifts (engine/motor, hydraulic system, mast/chain, brakes, steering, tires, battery/charging), reach stackers (hydraulics, spreader, steering), dock levelers (hydraulic cylinder, lip extension, safety legs, weather seal), RF devices (battery, scanner, screen, firmware update), barcode printers (print head cleaning, label sensor, calibration), stretch-wrap machines (tension adjustment, film carriage, turntable)
Responsible (R): Equipment Technician
Accountable (A): DC Maintenance Supervisor
Duration: 1–2 hours/unit</bpmn:documentation>
        <bpmn:incoming>W650_Flow18</bpmn:incoming>
        <bpmn:outgoing>W650_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W650_Task9" name="Equipment Technician records PM completion in system: checklist results, parts…">
        <bpmn:documentation>Step 3: Equipment Technician records PM completion in system: checklist results, parts consumed, hours spent, any findings requiring follow-up repair; system updates next PM due date based on hours/interval
Responsible (R): Equipment Technician
Accountable (A): DC Maintenance Supervisor
Duration: 15 min/unit</bpmn:documentation>
        <bpmn:incoming>W650_Flow19</bpmn:incoming>
        <bpmn:outgoing>W650_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W650_Task10" name="For equipment requiring repair beyond PM scope: Equipment Technician creates…">
        <bpmn:documentation>Step 4: For equipment requiring repair beyond PM scope: Equipment Technician creates repair work order with severity (critical: equipment out of service, major: degraded but functional, minor: non-urgent); for critical repairs, DC Maintenance Supervisor authorizes vendor service call
Responsible (R): Equipment Technician
Accountable (A): DC Maintenance Supervisor
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W650_Flow20</bpmn:incoming>
        <bpmn:outgoing>W650_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W650_Task11" name="For critical equipment failures during operations: DC Maintenance Supervisor…">
        <bpmn:documentation>Step 5: For critical equipment failures during operations: DC Maintenance Supervisor activates backup equipment plan (rental forklift from vendor pool, manual pallet jack substitution, manual dock operations); communicates impact to DC Manager for labor reallocation
Responsible (R): DC Maintenance Supervisor
Accountable (A): DC Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W650_Flow21</bpmn:incoming>
        <bpmn:outgoing>W650_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W650_Task12" name="Monthly: DC Maintenance Supervisor reviews equipment uptime report (target: ≥…">
        <bpmn:documentation>Step 6: Monthly: DC Maintenance Supervisor reviews equipment uptime report (target: ≥ 95% for forklifts and reach stackers); analyzes MTBF and MTTR trends; identifies units approaching end-of-life for replacement planning
Responsible (R): DC Maintenance Supervisor
Accountable (A): DC Manager
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W650_Flow22</bpmn:incoming>
        <bpmn:outgoing>W650_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W650_Task13" name="Quarterly: Finance Analyst reviews equipment maintenance costs vs. depreciation…">
        <bpmn:documentation>Step 7: Quarterly: Finance Analyst reviews equipment maintenance costs vs. depreciation schedule; recommends repair-vs-replace decisions for units with excessive maintenance cost per W39
Responsible (R): Finance Analyst
Accountable (A): Finance Manager
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W650_Flow23</bpmn:incoming>
        <bpmn:outgoing>W650_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W650_End14" name="Complete">
        <bpmn:incoming>W650_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W650_Annotation15">
        <bpmn:text>Controls: - CTL-252 (ensure controlled execution — DC Operations Management (PA-04.3).) | - operational: DC Maintenance Supervisor review and approval gate
Owner: DC Maintenance Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W650_Assoc16" sourceRef="W650_Annotation15" targetRef="W650_Start6" associationDirection="None" />
