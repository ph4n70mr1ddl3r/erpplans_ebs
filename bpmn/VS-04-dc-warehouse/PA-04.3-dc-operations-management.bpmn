    <bpmn:process id="W_W1534" name="W1534. DC Night Shift Operations, Security Protocol &amp; Shift Handover Management" isExecutable="false">
      <bpmn:documentation>Trigger: Daily night shift activation (typically 10:00 PM – 6:00 AM); or peak season extended operations
Frequency: Daily (4 DCs); peak season may run 2 shifts
Volume: ~30–40 DC employees on the overnight (10 PM–6 AM) shift per DC (~150 per DC total across shifts; a supplemental shift beyond W584&#x27;s two-shift core model)
Owner: DC Night Shift Supervisor
Participants: Night Shift Supervisor, Night Shift Associates, Security Guards, DC Manager (on-call)
Source: workflow W1534 — DC Night Shift Operations, Security Protocol &amp; Shift Handover Management</bpmn:documentation>
      <bpmn:laneSet id="W1534_LaneSet5">
        <bpmn:lane id="W1534_Lane1" name="Night Shift Supervisor">
        <bpmn:flowNodeRef>W1534_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1534_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1534_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1534_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1534_Lane2" name="Security Guards">
        <bpmn:flowNodeRef>W1534_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1534_Lane3" name="Night Shift Associates">
        <bpmn:flowNodeRef>W1534_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1534_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1534_Lane4" name="System">
        <bpmn:flowNodeRef>W1534_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1534_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1534_Start6" name="Daily night shift activation (typically 10:00 PM – 6:00 AM); or peak season extended…">
        <bpmn:outgoing>W1534_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1534_Task7" name="Shift start-up">
        <bpmn:documentation>Step 1: Shift start-up: Night Shift Supervisor reviews day shift handover log — pending picks, inbound receipts awaiting putaway, priority shipments for next-day dispatch, equipment issues; assigns tasks to night shift associates based on priority and labor plan
Responsible (R): Night Shift Supervisor
Accountable (A): —
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W1534_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1534_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1534_Task8" name="Security protocol activation">
        <bpmn:documentation>Step 2: Security protocol activation: Security Guards activate night shift perimeter controls — gate lockdown to single entry/exit point, CCTV monitoring station staffed, badge-only access to warehouse floor, visitor/contractor prohibition after 10 PM; Night Shift Supervisor verifies all non-night-shift personnel have exited the building
Responsible (R): Security Guards / Night Shift Supervisor
Accountable (A): DC Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1534_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1534_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1534_Task9" name="Night operations execution">
        <bpmn:documentation>Step 3: Night operations execution: (a) Outbound pick/pack for next-day store deliveries — wave picking of replenishment orders (W4) scheduled for morning dispatch; (b) Inbound putaway of late-arriving vendor deliveries; (c) Cycle counting in designated zones (W6) — night shift targets low-traffic areas; (d) Kit assembly (W46) for promotional bundles; (e) Equipment charging and maintenance area clearing
Responsible (R): Night Shift Associates
Accountable (A): Night Shift Supervisor
Duration: 6–8 hours</bpmn:documentation>
        <bpmn:incoming>W1534_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1534_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1534_Task10" name="Incident management">
        <bpmn:documentation>Step 4: Incident management: Any security incident (unauthorized access attempt, alarm trigger), safety incident (forklift collision, slip/trip), or equipment failure is immediately reported to Night Shift Supervisor; critical incidents escalate to DC Manager (on-call); non-critical incidents logged for day shift review
Responsible (R): Night Shift Associates / Security
Accountable (A): Night Shift Supervisor
Duration: As needed</bpmn:documentation>
        <bpmn:incoming>W1534_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1534_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1534_Task11" name="Shift handover preparation">
        <bpmn:documentation>Step 5: Shift handover preparation: Night Shift Supervisor prepares handover log — tasks completed, tasks pending, incidents occurred, equipment status, dock door assignments for morning shift, priority items requiring DC Manager attention; system updates wave completion status
Responsible (R): Night Shift Supervisor
Accountable (A): —
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W1534_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1534_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1534_Task12" name="Shift handover execution">
        <bpmn:documentation>Step 6: Shift handover execution: Night Shift Supervisor briefs incoming day shift DC Supervisor on handover log; walk-through of active work areas; physical verification of staged outbound shipments against dispatch plan; acknowledgment sign-off by both supervisors
Responsible (R): Night Shift Supervisor / DC Supervisor
Accountable (A): DC Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1534_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1534_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1534_Task13" name="Night shift KPI reporting">
        <bpmn:documentation>Step 7: Night shift KPI reporting: System automatically generates night shift performance report — lines picked, pallets put away, cycle count completion, incident count, labor productivity vs. target; feeds into daily DC KPI dashboard (W586)
Responsible (R): System
Accountable (A): DC Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1534_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1534_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1534_End14" name="Complete">
        <bpmn:incoming>W1534_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1534_Annotation15">
        <bpmn:text>Controls: - CTL-252 (ensure controlled execution — DC Operations Management (PA-04.3).) | - operational: DC Night Shift Supervisor review and approval gate
Owner: DC Night Shift Supervisor</bpmn:text>
      </bpmn:textAnnotation>
