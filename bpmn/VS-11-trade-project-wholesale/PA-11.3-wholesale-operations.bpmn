<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-11.3-wholesale-operations" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W145" name="W145. Wholesale Reseller Onboarding &amp; Credit Management" isExecutable="false">
      <bpmn:documentation>Trigger: 3rd-party hardware store or construction supply company requests reseller partnership
Frequency: 2–5 new resellers/month
Volume: ~100–150 active resellers
Owner: B2B Sales Manager
Participants: Sales Rep, Credit Analyst, Legal, Finance
Source: workflow W145 — Wholesale Reseller Onboarding &amp; Credit Management</bpmn:documentation>
      <bpmn:laneSet id="W145_LaneSet6">
        <bpmn:lane id="W145_Lane1" name="Reseller">
        <bpmn:flowNodeRef>W145_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W145_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W145_Lane2" name="Credit Analyst">
        <bpmn:flowNodeRef>W145_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W145_Lane3" name="Finance">
        <bpmn:flowNodeRef>W145_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W145_Lane4" name="B2B Sales Mgr">
        <bpmn:flowNodeRef>W145_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W145_Lane5" name="Sales Rep">
        <bpmn:flowNodeRef>W145_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W145_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W145_Start7" name="3rd-party hardware store or construction supply company requests reseller partnership">
        <bpmn:outgoing>W145_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W145_Task8" name="Application">
        <bpmn:documentation>Step 1: Application: Reseller submits business permits, SEC/DTI registration, and BIR 2303 (Certificate of Registration)
Responsible (R): Reseller / Sales Rep
Accountable (A): B2B Sales Mgr
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W145_Flow16</bpmn:incoming>
        <bpmn:outgoing>W145_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W145_Task9" name="Credit Review">
        <bpmn:documentation>Step 2: Credit Review: Credit Analyst performs deep-dive on financial statements and trade references per W24; sets &quot;Wholesale Credit Limit&quot;
Responsible (R): Credit Analyst
Accountable (A): Finance Mgr
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W145_Flow17</bpmn:incoming>
        <bpmn:outgoing>W145_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W145_Task10" name="Tax Configuration">
        <bpmn:documentation>Step 3: Tax Configuration: System flags account as &quot;Reseller&quot;; configures automatic handling of Expanded Withholding Tax (EWT) certificates (BIR 2307)
Responsible (R): Finance (AR)
Accountable (A): Controller
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W145_Flow18</bpmn:incoming>
        <bpmn:outgoing>W145_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W145_Task11" name="Price List Assignment">
        <bpmn:documentation>Step 4: Price List Assignment: Assign &quot;Wholesale Tier&quot; price list (W40.15–19) based on projected annual volume
Responsible (R): B2B Sales Mgr
Accountable (A): VP Merch
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W145_Flow19</bpmn:incoming>
        <bpmn:outgoing>W145_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W145_Task12" name="Onboarding">
        <bpmn:documentation>Step 5: Onboarding: Create account in ERP with &quot;Reseller&quot; category; provide login to B2B ordering portal
Responsible (R): Sales Rep
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W145_Flow20</bpmn:incoming>
        <bpmn:outgoing>W145_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W145_End13" name="Complete">
        <bpmn:incoming>W145_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W145_Annotation14">
        <bpmn:text>Controls: - CTL-274 (ensure controlled execution — Wholesale Operations (PA-11.3).) | - operational: B2B Sales Manager review and approval gate
Owner: B2B Sales Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W145_Assoc15" sourceRef="W145_Annotation14" targetRef="W145_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W145_Flow16" sourceRef="W145_Start7" targetRef="W145_Task8" />
      <bpmn:sequenceFlow id="W145_Flow17" sourceRef="W145_Task8" targetRef="W145_Task9" />
      <bpmn:sequenceFlow id="W145_Flow18" sourceRef="W145_Task9" targetRef="W145_Task10" />
      <bpmn:sequenceFlow id="W145_Flow19" sourceRef="W145_Task10" targetRef="W145_Task11" />
      <bpmn:sequenceFlow id="W145_Flow20" sourceRef="W145_Task11" targetRef="W145_Task12" />
      <bpmn:sequenceFlow id="W145_Flow21" sourceRef="W145_Task12" targetRef="W145_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W145_diag">
      <bpmndi:BPMNPlane id="W145_plane" bpmnElement="W_W145">
        <bpmndi:BPMNShape id="W145_Lane1_di" bpmnElement="W145_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W145_Lane2_di" bpmnElement="W145_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W145_Lane3_di" bpmnElement="W145_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W145_Lane4_di" bpmnElement="W145_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W145_Lane5_di" bpmnElement="W145_Lane5" isHorizontal="true"><dc:Bounds x="160" y="760" width="1370" height="170" /></bpmndi:BPMNShape>
