      <bpmn:sequenceFlow id="W598_Flow21" sourceRef="W598_Task9" targetRef="W598_Task10" />
      <bpmn:sequenceFlow id="W598_Flow22" sourceRef="W598_Task10" targetRef="W598_Task11" />
      <bpmn:sequenceFlow id="W598_Flow23" sourceRef="W598_Task11" targetRef="W598_Task12" />
      <bpmn:sequenceFlow id="W598_Flow24" sourceRef="W598_Task12" targetRef="W598_Task13" />
      <bpmn:sequenceFlow id="W598_Flow25" sourceRef="W598_Task13" targetRef="W598_Task14" />
      <bpmn:sequenceFlow id="W598_Flow26" sourceRef="W598_Task14" targetRef="W598_Task15" />
      <bpmn:sequenceFlow id="W598_Flow27" sourceRef="W598_Task15" targetRef="W598_End16" />
    </bpmn:process>
