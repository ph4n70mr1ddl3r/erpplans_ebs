        <bpmndi:BPMNShape id="W145_End13_di" bpmnElement="W145_End13"><dc:Bounds x="1470" y="827" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W145_Annotation14_di" bpmnElement="W145_Annotation14"><dc:Bounds x="160" y="970" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W145_Flow16_di" bpmnElement="W145_Flow16"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W145_Flow17_di" bpmnElement="W145_Flow17"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W145_Flow18_di" bpmnElement="W145_Flow18"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W145_Flow19_di" bpmnElement="W145_Flow19"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W145_Flow20_di" bpmnElement="W145_Flow20"><di:waypoint x="1210" y="675" /><di:waypoint x="1240" y="845" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W145_Flow21_di" bpmnElement="W145_Flow21"><di:waypoint x="1420" y="845" /><di:waypoint x="1470" y="845" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W145_Assoc15_di" bpmnElement="W145_Assoc15"><di:waypoint x="340" y="970" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W146" name="W146. Bulk Fulfillment &amp; Cross-Docking for Wholesale" isExecutable="false">
      <bpmn:documentation>Trigger: Wholesale Sales Order (SO) exceeding 10 pallets or full truckload
Frequency: Weekly; ~10–20 bulk shipments/DC
Volume: Primary commodities: Cement, Plywood, Steel Bars, Tiles
Owner: DC Manager
Participants: Logistics, Warehouse, 3PL Carrier, Reseller
Source: workflow W146 — Bulk Fulfillment &amp; Cross-Docking for Wholesale</bpmn:documentation>
      <bpmn:laneSet id="W146_LaneSet7">
        <bpmn:lane id="W146_Lane1" name="Sales Rep, B2B Support Representative">
        <bpmn:flowNodeRef>W146_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W146_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W146_Lane2" name="DC Manager">
        <bpmn:flowNodeRef>W146_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W146_Lane3" name="Logistics">
        <bpmn:flowNodeRef>W146_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W146_Lane4" name="DC Team">
        <bpmn:flowNodeRef>W146_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W146_Lane5" name="Driver">
        <bpmn:flowNodeRef>W146_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W146_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W146_Lane6" name="System">
        <bpmn:flowNodeRef>W146_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W146_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W146_Start8" name="Wholesale Sales Order (SO) exceeding 10 pallets or full truckload">
        <bpmn:outgoing>W146_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W146_Task9" name="SO Entry">
        <bpmn:documentation>Step 1: SO Entry: Sales Rep enters wholesale order; system checks DC inventory (skipping store-level pools)
Responsible (R): Sales Rep, B2B Support Representative
Accountable (A): B2B Sales Mgr
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W146_Flow19</bpmn:incoming>
        <bpmn:outgoing>W146_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W146_Task10" name="Fulfillment Strategy">
        <bpmn:documentation>Step 2: Fulfillment Strategy: (a) If stock in DC: Pick from bulk zone; (b) If stock coming from vendor: Flag for &quot;Cross-Dock&quot; (no putaway)
Responsible (R): DC Manager
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W146_Flow20</bpmn:incoming>
        <bpmn:outgoing>W146_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W146_Task11" name="Transportation Booking">
        <bpmn:documentation>Step 3: Transportation Booking: Book 10-wheeler or tractor head via 3PL (W62B); specify &quot;Wholesale Delivery&quot; SLA
Responsible (R): Logistics
Accountable (A): Fleet Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W146_Flow21</bpmn:incoming>
        <bpmn:outgoing>W146_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W146_Task12" name="Loading &amp; Tally">
        <bpmn:documentation>Step 4: Loading &amp; Tally: Physical tally during loading; driver signs &quot;Wholesale Tally Sheet&quot; and B/L
Responsible (R): DC Team / Driver
Accountable (A): DC Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W146_Flow22</bpmn:incoming>
        <bpmn:outgoing>W146_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W146_Task13" name="Direct Shipment">
        <bpmn:documentation>Step 5: Direct Shipment: Delivery from DC or Vendor direct to Reseller site (bypassing BuildRight stores)
Responsible (R): Driver
Accountable (A): —
Duration: Varies</bpmn:documentation>
        <bpmn:incoming>W146_Flow23</bpmn:incoming>
        <bpmn:outgoing>W146_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W146_Task14" name="Proof of Delivery (POD)">
        <bpmn:documentation>Step 6: Proof of Delivery (POD): Reseller signs POD and provides BIR 2307 (if applicable); driver uploads via mobile app
Responsible (R): Driver
Accountable (A): AR Clerk
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W146_Flow24</bpmn:incoming>
        <bpmn:outgoing>W146_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W146_Task15" name="Billing">
        <bpmn:documentation>Step 7: Billing: System generates Wholesale Invoice; adjusts inventory; initiates collection cycle (W8)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W146_Flow25</bpmn:incoming>
        <bpmn:outgoing>W146_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W146_End16" name="Complete">
        <bpmn:incoming>W146_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W146_Annotation17">
        <bpmn:text>Controls: - CTL-274 (ensure controlled execution — Wholesale Operations (PA-11.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: DC Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W146_Assoc18" sourceRef="W146_Annotation17" targetRef="W146_Start8" associationDirection="None" />
      <bpmn:sequenceFlow id="W146_Flow19" sourceRef="W146_Start8" targetRef="W146_Task9" />
      <bpmn:sequenceFlow id="W146_Flow20" sourceRef="W146_Task9" targetRef="W146_Task10" />
      <bpmn:sequenceFlow id="W146_Flow21" sourceRef="W146_Task10" targetRef="W146_Task11" />
      <bpmn:sequenceFlow id="W146_Flow22" sourceRef="W146_Task11" targetRef="W146_Task12" />
      <bpmn:sequenceFlow id="W146_Flow23" sourceRef="W146_Task12" targetRef="W146_Task13" />
      <bpmn:sequenceFlow id="W146_Flow24" sourceRef="W146_Task13" targetRef="W146_Task14" />
      <bpmn:sequenceFlow id="W146_Flow25" sourceRef="W146_Task14" targetRef="W146_Task15" />
      <bpmn:sequenceFlow id="W146_Flow26" sourceRef="W146_Task15" targetRef="W146_End16" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W146_diag">
      <bpmndi:BPMNPlane id="W146_plane" bpmnElement="W_W146">
        <bpmndi:BPMNShape id="W146_Lane1_di" bpmnElement="W146_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
