      <bpmn:sequenceFlow id="W972_Flow15" sourceRef="W972_Task6" targetRef="W972_Task7" />
      <bpmn:sequenceFlow id="W972_Flow16" sourceRef="W972_Task7" targetRef="W972_Task8" />
      <bpmn:sequenceFlow id="W972_Flow17" sourceRef="W972_Task8" targetRef="W972_Task9" />
      <bpmn:sequenceFlow id="W972_Flow18" sourceRef="W972_Task9" targetRef="W972_End10" />
    </bpmn:process>
