        <bpmndi:BPMNShape id="W145_Task11_di" bpmnElement="W145_Task11"><dc:Bounds x="1030" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W145_Task12_di" bpmnElement="W145_Task12"><dc:Bounds x="1240" y="805" width="180" height="80" /></bpmndi:BPMNShape>
