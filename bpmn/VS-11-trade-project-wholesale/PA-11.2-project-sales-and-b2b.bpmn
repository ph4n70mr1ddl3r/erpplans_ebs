    <bpmn:process id="W_W1508" name="W1508. Customer Project Financing &amp; Partner Bank Consumer Loan Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Customer&#x27;s project quotation (W162, W148) exceeds PHP 50,000 and customer requests financing; or Sales Associate identifies financing opportunity during project consultation
Frequency: ~200–300 financing applications/month chain-wide
Volume: Average financed project value: PHP 80,000–300,000; approval rate ~60–70%; funded projects ~120–210/month
Owner: Project Sales Manager
Participants: Sales Associate, Project Sales Manager, Partner Bank Loan Officer, Finance (AR), Customer
Source: workflow W1508 — Customer Project Financing &amp; Partner Bank Consumer Loan Coordination</bpmn:documentation>
      <bpmn:laneSet id="W1508_LaneSet5">
        <bpmn:lane id="W1508_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W1508_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1508_Task8</bpmn:flowNodeRef>
