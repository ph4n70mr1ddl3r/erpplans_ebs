    <bpmn:process id="W_W421" name="W421. Batch/Shade Reconciliation for Large Project Sales" isExecutable="false">
      <bpmn:documentation>Trigger: Large-scale quotation (e.g., &gt; 100 sqm) for tiles, flooring, or paint requiring color consistency
Frequency: Weekly per Project Sales Rep
Volume: ~1.5–2.5 project quotes/month per store (~300–500/month chain-wide per W162)
Owner: Project Sales Lead
Participants: Sales Rep, Warehouse Supervisor, Inventory Control, Customer
Source: workflow W421 — Batch/Shade Reconciliation for Large Project Sales</bpmn:documentation>
      <bpmn:laneSet id="W421_LaneSet4">
        <bpmn:lane id="W421_Lane1" name="Sales Rep">
        <bpmn:flowNodeRef>W421_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W421_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W421_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W421_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W421_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W421_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W421_Lane2" name="Warehouse Supervisor">
        <bpmn:flowNodeRef>W421_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W421_Lane3" name="Warehouse Clerk">
        <bpmn:flowNodeRef>W421_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W421_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W421_Start5" name="Large-scale quotation (e.g., &gt; 100 sqm) for tiles, flooring, or paint requiring color…">
        <bpmn:outgoing>W421_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W421_Task6" name="Requirement Definition">
        <bpmn:documentation>Step 1: Requirement Definition: Sales Rep identifies &quot;Single Batch&quot; requirement for a project to ensure color/shade uniformity (e.g., &quot;Must be same shade code for 500 sqm of 60x60 Granite Tiles&quot;)
Responsible (R): Sales Rep
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W421_Flow16</bpmn:incoming>
        <bpmn:outgoing>W421_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W421_Task7" name="Lot Availability Check">
        <bpmn:documentation>Step 2: Lot Availability Check: Sales Rep checks ERP for Lot/Batch attributes (Shade Code, Batch Date) across available inventory in DC and regional stores
Responsible (R): Sales Rep
Accountable (A): Inventory Control
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W421_Flow17</bpmn:incoming>
        <bpmn:outgoing>W421_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W421_Task8" name="Physical Verification">
        <bpmn:documentation>Step 3: Physical Verification: Warehouse Supervisor performs physical check of pallets to confirm shade codes and &quot;Manufacture Date&quot; match ERP records; flags any &quot;Mixed Pallets&quot;
Responsible (R): Warehouse Supervisor
Accountable (A): DC Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W421_Flow18</bpmn:incoming>
        <bpmn:outgoing>W421_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W421_Task9" name="Shade Reservation">
        <bpmn:documentation>Step 4: Shade Reservation: Sales Rep creates a &quot;Shade-Locked&quot; Reservation in ERP; system prevents these specific Lots from being sold to walk-in customers or other orders
Responsible (R): Sales Rep
Accountable (A): Inventory Control
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W421_Flow19</bpmn:incoming>
        <bpmn:outgoing>W421_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W421_Task10" name="Sample Approval">
        <bpmn:documentation>Step 5: Sample Approval: Rep provides physical sample of the specific shade to the customer/architect for sign-off
Responsible (R): Sales Rep
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W421_Flow20</bpmn:incoming>
        <bpmn:outgoing>W421_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W421_Task11" name="Staged Release">
        <bpmn:documentation>Step 6: Staged Release: As project progresses, Warehouse releases the reserved Lot/Batch for delivery (W164); system warns if any attempt is made to substitute with a different shade
Responsible (R): Warehouse Clerk
Accountable (A): DC Manager
Duration: Per W164</bpmn:documentation>
        <bpmn:incoming>W421_Flow21</bpmn:incoming>
        <bpmn:outgoing>W421_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W421_Task12" name="Shortage Management">
        <bpmn:documentation>Step 7: Shortage Management: If project requires more stock than currently available in a single shade: Rep coordinates with Buyer (W2B) to place a special &quot;Single Run&quot; order with the manufacturer
Responsible (R): Sales Rep / Buyer
Accountable (A): Category Mgr
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W421_Flow22</bpmn:incoming>
        <bpmn:outgoing>W421_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W421_End13" name="Complete">
        <bpmn:incoming>W421_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W421_Annotation14">
        <bpmn:text>Controls: - CTL-273 (ensure controlled execution — Project Sales &amp; B2B (PA-11.2).) | - operational: Project Sales Lead review and approval gate
Owner: Project Sales Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W421_Assoc15" sourceRef="W421_Annotation14" targetRef="W421_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W421_Flow16" sourceRef="W421_Start5" targetRef="W421_Task6" />
      <bpmn:sequenceFlow id="W421_Flow17" sourceRef="W421_Task6" targetRef="W421_Task7" />
      <bpmn:sequenceFlow id="W421_Flow18" sourceRef="W421_Task7" targetRef="W421_Task8" />
      <bpmn:sequenceFlow id="W421_Flow19" sourceRef="W421_Task8" targetRef="W421_Task9" />
      <bpmn:sequenceFlow id="W421_Flow20" sourceRef="W421_Task9" targetRef="W421_Task10" />
      <bpmn:sequenceFlow id="W421_Flow21" sourceRef="W421_Task10" targetRef="W421_Task11" />
      <bpmn:sequenceFlow id="W421_Flow22" sourceRef="W421_Task11" targetRef="W421_Task12" />
      <bpmn:sequenceFlow id="W421_Flow23" sourceRef="W421_Task12" targetRef="W421_End13" />
    </bpmn:process>
