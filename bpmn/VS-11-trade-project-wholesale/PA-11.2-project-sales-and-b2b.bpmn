      <bpmn:sequenceFlow id="W229_Flow18" sourceRef="W229_Task8" targetRef="W229_Task9" />
      <bpmn:sequenceFlow id="W229_Flow19" sourceRef="W229_Task9" targetRef="W229_Task10" />
      <bpmn:sequenceFlow id="W229_Flow20" sourceRef="W229_Task10" targetRef="W229_Task11" />
      <bpmn:sequenceFlow id="W229_Flow21" sourceRef="W229_Task11" targetRef="W229_Task12" />
      <bpmn:sequenceFlow id="W229_Flow22" sourceRef="W229_Task12" targetRef="W229_End13" />
    </bpmn:process>
