    <bpmn:process id="W_W165" name="W165. Project Retention &amp; Milestone Billing" isExecutable="false">
      <bpmn:documentation>Trigger: Project milestone achieved; or final billing with retention
Frequency: Milestone-based; typically 3–6 milestones per project; projects span 6–18 months
Volume: ~80–120 active projects with milestone billing at any time (one register with W918)
Owner: AR Clerk
Participants: Sales Rep, AR Clerk, Client Project Manager, Sales Manager, Finance (Controller)
Source: workflow W165 — Project Retention &amp; Milestone Billing</bpmn:documentation>
      <bpmn:laneSet id="W165_LaneSet4">
        <bpmn:lane id="W165_Lane1" name="Sales Rep">
        <bpmn:flowNodeRef>W165_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W165_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W165_Lane2" name="AR Clerk">
        <bpmn:flowNodeRef>W165_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W165_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W165_Lane3" name="System">
        <bpmn:flowNodeRef>W165_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W165_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W165_Start5" name="Project milestone achieved; or final billing with retention">
        <bpmn:outgoing>W165_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W165_Task6" name="Sales Rep confirms milestone achievement with client (e.g., &quot;Structural Phase…">
        <bpmn:documentation>Step 1: Sales Rep confirms milestone achievement with client (e.g., &quot;Structural Phase Complete&quot;)
Responsible (R): Sales Rep
Accountable (A): —
Duration: —</bpmn:documentation>
        <bpmn:incoming>W165_Flow13</bpmn:incoming>
        <bpmn:outgoing>W165_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W165_Task7" name="AR Clerk generates Milestone Invoice per contract terms (e.g., 20% of total…">
        <bpmn:documentation>Step 2: AR Clerk generates Milestone Invoice per contract terms (e.g., 20% of total project value)
Responsible (R): AR Clerk
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W165_Flow14</bpmn:incoming>
        <bpmn:outgoing>W165_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W165_Task8" name="Retention Management">
        <bpmn:documentation>Step 3: Retention Management: If contract specifies retention (typically 5–10% held until final acceptance), system automatically deducts retention from each milestone invoice and posts to &quot;Retention Receivable&quot; account
Responsible (R): System / AR Clerk
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W165_Flow15</bpmn:incoming>
        <bpmn:outgoing>W165_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W165_Task9" name="Final Acceptance: Client signs off; AR Clerk invoices for the total accumulated…">
        <bpmn:documentation>Step 4: Final Acceptance: Client signs off; AR Clerk invoices for the total accumulated Retention balance
Responsible (R): AR Clerk
Accountable (A): Sales Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W165_Flow16</bpmn:incoming>
        <bpmn:outgoing>W165_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W165_End10" name="Complete">
        <bpmn:incoming>W165_Flow17</bpmn:incoming>
      </bpmn:endEvent>
