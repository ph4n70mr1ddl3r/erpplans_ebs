<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-11.2-project-sales-and-b2b" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W162" name="W162. Project Quotation &amp; Bid Management" isExecutable="false">
      <bpmn:documentation>Trigger: Customer requests a quote for a specific construction project or bulk purchase
Frequency: ~300–500 quotes/month
Volume: Quote value: PHP 100K to PHP 10M+
Owner: Sales Rep (B2B)
Participants: Sales Rep, Category Manager (for deep discounts), Project Manager (Client)
Source: workflow W162 — Project Quotation &amp; Bid Management</bpmn:documentation>
      <bpmn:laneSet id="W162_LaneSet3">
        <bpmn:lane id="W162_Lane1" name="Sales Rep">
        <bpmn:flowNodeRef>W162_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W162_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W162_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W162_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W162_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W162_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W162_Lane2" name="System">
        <bpmn:flowNodeRef>W162_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W162_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W162_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W162_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W162_Start4" name="Customer requests a quote for a specific construction project or bulk purchase">
        <bpmn:outgoing>W162_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W162_Task5" name="Sales Rep receives Bill of Quantities (BOQ) or item list from client project">
        <bpmn:documentation>Step 1: Sales Rep receives Bill of Quantities (BOQ) or item list from client project
Responsible (R): Sales Rep
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W162_Flow16</bpmn:incoming>
        <bpmn:outgoing>W162_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W162_Task6" name="Sales Rep creates Quote in system: selects items, specifies quantities, sets…">
        <bpmn:documentation>Step 2: Sales Rep creates Quote in system: selects items, specifies quantities, sets validity period (typically 15–30 days)
Responsible (R): Sales Rep
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W162_Flow17</bpmn:incoming>
        <bpmn:outgoing>W162_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W162_Task7" name="System checks current stock (ATP) across all DCs/Stores; flags items with…">
        <bpmn:documentation>Step 3: System checks current stock (ATP) across all DCs/Stores; flags items with insufficient stock for the project timeline
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W162_Flow18</bpmn:incoming>
        <bpmn:outgoing>W162_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W162_Task8" name="Pricing Strategy">
        <bpmn:documentation>Step 4: Pricing Strategy: (a) If standard B2B price list used: auto-approved; (b) If additional discount requested (&gt; 5% off B2B list): route to Category Manager for approval; (c) If &quot;Loss Leader&quot; pricing for strategic bid: route to VP Merchandising
Responsible (R): Sales Rep / Cat. Manager
Accountable (A): VP Merchandising
Duration: 1–4 hours</bpmn:documentation>
        <bpmn:incoming>W162_Flow19</bpmn:incoming>
        <bpmn:outgoing>W162_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W162_Task9" name="System generates Quotation PDF with terms (payment, delivery, lead times, force…">
        <bpmn:documentation>Step 5: System generates Quotation PDF with terms (payment, delivery, lead times, force majeure)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W162_Flow20</bpmn:incoming>
        <bpmn:outgoing>W162_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W162_Task10" name="Sales Rep presents quote to client; negotiates terms">
        <bpmn:documentation>Step 6: Sales Rep presents quote to client; negotiates terms
Responsible (R): Sales Rep
Accountable (A): Sales Manager
Duration: 1–5 days</bpmn:documentation>
        <bpmn:incoming>W162_Flow21</bpmn:incoming>
        <bpmn:outgoing>W162_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W162_Task11" name="Project Contract / Master Sales Order">
        <bpmn:documentation>Step 7: Client accepts: Sales Rep converts Quote to Project Contract / Master Sales Order in system
Responsible (R): Sales Rep
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W162_Flow22</bpmn:incoming>
        <bpmn:outgoing>W162_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W162_Task12" name="If Quote expires: system auto-cancels; Sales Rep can &quot;re-quote&quot; with updated…">
        <bpmn:documentation>Step 8: If Quote expires: system auto-cancels; Sales Rep can &quot;re-quote&quot; with updated pricing
Responsible (R): System
Accountable (A): Sales Rep
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W162_Flow23</bpmn:incoming>
        <bpmn:outgoing>W162_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W162_End13" name="Complete">
        <bpmn:incoming>W162_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W162_Annotation14">
        <bpmn:text>Controls: - CTL-273 (ensure controlled execution — Project Sales &amp; B2B (PA-11.2).) | - operational: Sales Rep (B2B) review and approval gate
Owner: Sales Rep (B2B)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W162_Assoc15" sourceRef="W162_Annotation14" targetRef="W162_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W162_Flow16" sourceRef="W162_Start4" targetRef="W162_Task5" />
      <bpmn:sequenceFlow id="W162_Flow17" sourceRef="W162_Task5" targetRef="W162_Task6" />
      <bpmn:sequenceFlow id="W162_Flow18" sourceRef="W162_Task6" targetRef="W162_Task7" />
      <bpmn:sequenceFlow id="W162_Flow19" sourceRef="W162_Task7" targetRef="W162_Task8" />
      <bpmn:sequenceFlow id="W162_Flow20" sourceRef="W162_Task8" targetRef="W162_Task9" />
      <bpmn:sequenceFlow id="W162_Flow21" sourceRef="W162_Task9" targetRef="W162_Task10" />
      <bpmn:sequenceFlow id="W162_Flow22" sourceRef="W162_Task10" targetRef="W162_Task11" />
      <bpmn:sequenceFlow id="W162_Flow23" sourceRef="W162_Task11" targetRef="W162_Task12" />
      <bpmn:sequenceFlow id="W162_Flow24" sourceRef="W162_Task12" targetRef="W162_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W162_diag">
      <bpmndi:BPMNPlane id="W162_plane" bpmnElement="W_W162">
        <bpmndi:BPMNShape id="W162_Lane1_di" bpmnElement="W162_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2000" height="170" /></bpmndi:BPMNShape>
