        <bpmndi:BPMNShape id="W1180_Task9_di" bpmnElement="W1180_Task9"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1180_Task10_di" bpmnElement="W1180_Task10"><dc:Bounds x="1450" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1180_Task11_di" bpmnElement="W1180_Task11"><dc:Bounds x="1660" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1180_Start4_di" bpmnElement="W1180_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1180_End12_di" bpmnElement="W1180_End12"><dc:Bounds x="1890" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1180_Annotation13_di" bpmnElement="W1180_Annotation13"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
