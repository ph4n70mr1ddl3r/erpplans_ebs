      <bpmndi:BPMNPlane id="W1118_plane" bpmnElement="W_W1118">
        <bpmndi:BPMNShape id="W1118_Lane1_di" bpmnElement="W1118_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
