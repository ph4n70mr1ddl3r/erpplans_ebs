        <bpmndi:BPMNEdge id="W228_Flow20_di" bpmnElement="W228_Flow20"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W228_Flow21_di" bpmnElement="W228_Flow21"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W228_Flow22_di" bpmnElement="W228_Flow22"><di:waypoint x="1420" y="675" /><di:waypoint x="1450" y="845" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W228_Flow23_di" bpmnElement="W228_Flow23"><di:waypoint x="1630" y="845" /><di:waypoint x="1680" y="845" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W228_Assoc16_di" bpmnElement="W228_Assoc16"><di:waypoint x="340" y="970" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W229" name="W229. B2B Customer Credit Limit Exception &amp; Escalation" isExecutable="false">
      <bpmn:documentation>Trigger: Staged delivery (Call-Off) (W164) is blocked at release because customer exceeds credit limit or has overdue invoices
Frequency: ~30–50 exception requests/month
Volume: Exception values: PHP 100K to PHP 5M+
Owner: B2B Credit Manager
Participants: B2B Credit Manager, Sales Rep, Credit Control Clerk, Head of Trade / Account Management, CFO, Customer
Source: workflow W229 — B2B Customer Credit Limit Exception &amp; Escalation</bpmn:documentation>
      <bpmn:laneSet id="W229_LaneSet5">
        <bpmn:lane id="W229_Lane1" name="System">
        <bpmn:flowNodeRef>W229_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W229_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W229_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W229_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W229_Lane2" name="Credit Control Clerk">
        <bpmn:flowNodeRef>W229_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W229_Lane3" name="Sales Rep">
        <bpmn:flowNodeRef>W229_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W229_Lane4" name="B2B Credit Manager">
        <bpmn:flowNodeRef>W229_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W229_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W229_Start6" name="Staged delivery (Call-Off) (W164) is blocked at release because customer exceeds credit…">
        <bpmn:outgoing>W229_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W229_Task7" name="System Hold">
        <bpmn:documentation>Step 1: System Hold: System automatically blocks Release Order (W164.3) due to credit limit breach or overdue balance; triggers alert to Sales Rep and Credit Control Clerk
Responsible (R): System
Accountable (A): B2B Credit Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W229_Flow16</bpmn:incoming>
        <bpmn:outgoing>W229_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W229_Task8" name="Status Verification">
        <bpmn:documentation>Step 2: Status Verification: Credit Control Clerk reviews account (AR ledger, average payment days, credit utilization); consults with Sales Rep to check for payments in transit or bank guarantees
Responsible (R): Credit Control Clerk
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W229_Flow17</bpmn:incoming>
        <bpmn:outgoing>W229_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W229_Task9" name="Escalation Request">
        <bpmn:documentation>Step 3: Escalation Request: Sales Rep submits &quot;Credit Exception Request&quot; in system, detailing project urgency, invoice value, payment commitment date, and attachment of client commitment letter
Responsible (R): Sales Rep
Accountable (A): B2B Credit Manager
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W229_Flow18</bpmn:incoming>
        <bpmn:outgoing>W229_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W229_Task10" name="Tiered Routing">
        <bpmn:documentation>Step 4: Tiered Routing: System routes the request based on exception value for digital approval:&lt;br&gt;• Up to PHP 100K: Approved by Credit Manager;&lt;br&gt;• PHP 100K to PHP 1M: Approved by Credit Manager + Head of Trade / Account Management;&lt;br&gt;• Above PHP 1M: Approved by CFO
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W229_Flow19</bpmn:incoming>
        <bpmn:outgoing>W229_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W229_Task11" name="Temporary Release">
        <bpmn:documentation>Step 5: Temporary Release: Approver grants exception; Credit Manager enters a &quot;Temporary Credit Override&quot; in ERP with a strict expiry date (typically 7–14 days); system releases blocked order for dispatch
Responsible (R): B2B Credit Manager / CFO
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W229_Flow20</bpmn:incoming>
        <bpmn:outgoing>W229_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W229_Task12" name="Auto-Lock Enforcement">
        <bpmn:documentation>Step 6: Auto-Lock Enforcement: System tracks payment; if commitment not fulfilled within override window, system automatically locks B2B customer account and suspends all subsequent deliveries
Responsible (R): System
Accountable (A): B2B Credit Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W229_Flow21</bpmn:incoming>
        <bpmn:outgoing>W229_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W229_End13" name="Complete">
        <bpmn:incoming>W229_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W229_Annotation14">
        <bpmn:text>Controls: - CTL-273 (ensure controlled execution — Project Sales &amp; B2B (PA-11.2).) | - operational: B2B Credit Manager review and approval gate
Owner: B2B Credit Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W229_Assoc15" sourceRef="W229_Annotation14" targetRef="W229_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W229_Flow16" sourceRef="W229_Start6" targetRef="W229_Task7" />
