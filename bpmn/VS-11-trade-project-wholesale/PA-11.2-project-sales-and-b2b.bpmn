    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W163" name="W163. Contract Pricing &amp; Project Price Books" isExecutable="false">
      <bpmn:documentation>Trigger: Project Contract signed; requires locked-in pricing for duration of project (6–18 months)
Frequency: ~10–20 new project price books/month; ongoing maintenance for active projects
Volume: ~30–50 active project price books at any time
Owner: Pricing Analyst
Participants: Pricing Analyst, Category Manager, Sales Rep, Finance
Source: workflow W163 — Contract Pricing &amp; Project Price Books</bpmn:documentation>
      <bpmn:laneSet id="W163_LaneSet3">
        <bpmn:lane id="W163_Lane1" name="Pricing Analyst">
        <bpmn:flowNodeRef>W163_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W163_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W163_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W163_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W163_Lane2" name="System">
        <bpmn:flowNodeRef>W163_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W163_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W163_Start4" name="Project Contract signed; requires locked-in pricing for duration of project (6–18 months)">
        <bpmn:outgoing>W163_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W163_Task5" name="Project Price Book">
        <bpmn:documentation>Step 1: Pricing Analyst creates a Project Price Book linked to the specific Customer + Project ID
Responsible (R): Pricing Analyst
Accountable (A): Category Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W163_Flow12</bpmn:incoming>
        <bpmn:outgoing>W163_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W163_Task6" name="Enters locked-in prices for the agreed BOQ items; sets price validity end date">
        <bpmn:documentation>Step 2: Enters locked-in prices for the agreed BOQ items; sets price validity end date
Responsible (R): Pricing Analyst
Accountable (A): Category Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W163_Flow13</bpmn:incoming>
        <bpmn:outgoing>W163_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W163_Task7" name="System ensures that when this Customer orders for this Project, the Project…">
        <bpmn:documentation>Step 3: System ensures that when this Customer orders for this Project, the Project Price Book takes precedence over standard B2B or Promo price lists
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W163_Flow14</bpmn:incoming>
        <bpmn:outgoing>W163_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W163_Task8" name="Price Escalation Clause">
        <bpmn:documentation>Step 4: Price Escalation Clause: If contract allows for price adjustment (e.g., fuel/commodity surcharge), Pricing Analyst updates Price Book based on formula; triggers notification to client
Responsible (R): Pricing Analyst
Accountable (A): Sales Rep
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W163_Flow15</bpmn:incoming>
        <bpmn:outgoing>W163_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W163_End9" name="Complete">
        <bpmn:incoming>W163_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W163_Annotation10">
        <bpmn:text>Controls: - CTL-185 (ensure B2B billing &amp; receivable milestone integrity.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Pricing Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W163_Assoc11" sourceRef="W163_Annotation10" targetRef="W163_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W163_Flow12" sourceRef="W163_Start4" targetRef="W163_Task5" />
      <bpmn:sequenceFlow id="W163_Flow13" sourceRef="W163_Task5" targetRef="W163_Task6" />
      <bpmn:sequenceFlow id="W163_Flow14" sourceRef="W163_Task6" targetRef="W163_Task7" />
      <bpmn:sequenceFlow id="W163_Flow15" sourceRef="W163_Task7" targetRef="W163_Task8" />
      <bpmn:sequenceFlow id="W163_Flow16" sourceRef="W163_Task8" targetRef="W163_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W163_diag">
      <bpmndi:BPMNPlane id="W163_plane" bpmnElement="W_W163">
        <bpmndi:BPMNShape id="W163_Lane1_di" bpmnElement="W163_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W163_Lane2_di" bpmnElement="W163_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W163_Task5_di" bpmnElement="W163_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W163_Task6_di" bpmnElement="W163_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W163_Task7_di" bpmnElement="W163_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W163_Task8_di" bpmnElement="W163_Task8"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W163_Start4_di" bpmnElement="W163_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W163_End9_di" bpmnElement="W163_End9"><dc:Bounds x="1260" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W163_Annotation10_di" bpmnElement="W163_Annotation10"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W163_Flow12_di" bpmnElement="W163_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W163_Flow13_di" bpmnElement="W163_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W163_Flow14_di" bpmnElement="W163_Flow14"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W163_Flow15_di" bpmnElement="W163_Flow15"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W163_Flow16_di" bpmnElement="W163_Flow16"><di:waypoint x="1210" y="165" /><di:waypoint x="1260" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W163_Assoc11_di" bpmnElement="W163_Assoc11"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W164" name="W164. Staged Project Delivery &amp; Call-Off Orders" isExecutable="false">
      <bpmn:documentation>Trigger: Project site requests a partial delivery (Call-Off) against the Master Sales Order
Frequency: Weekly/Bi-weekly per project
Volume: Total project may have 10–50 partial deliveries
Owner: Sales Coordinator
Participants: Sales Coordinator, Client Project Manager, Logistics Team, Credit Control Clerk, Supply Planner
Source: workflow W164 — Staged Project Delivery &amp; Call-Off Orders</bpmn:documentation>
      <bpmn:laneSet id="W164_LaneSet5">
        <bpmn:lane id="W164_Lane1" name="Client">
        <bpmn:flowNodeRef>W164_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W164_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W164_Lane2" name="Sales Coordinator">
        <bpmn:flowNodeRef>W164_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W164_Lane3" name="System">
        <bpmn:flowNodeRef>W164_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W164_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W164_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W164_Lane4" name="Logistics Team">
        <bpmn:flowNodeRef>W164_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W164_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W164_Start6" name="Project site requests a partial delivery (Call-Off) against the Master Sales Order">
        <bpmn:outgoing>W164_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W164_Task7" name="Client Project Site sends &quot;Call-Off&quot; request (Item, Quantity, Site Location…">
        <bpmn:documentation>Step 1: Client Project Site sends &quot;Call-Off&quot; request (Item, Quantity, Site Location, Date)
Responsible (R): Client / Sales Rep
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W164_Flow16</bpmn:incoming>
        <bpmn:outgoing>W164_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W164_Task8" name="Release Order (Delivery Order)">
        <bpmn:documentation>Step 2: Sales Coordinator creates Release Order (Delivery Order) against the Master Sales Order
Responsible (R): Sales Coordinator
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W164_Flow17</bpmn:incoming>
        <bpmn:outgoing>W164_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W164_Task9" name="System validates: (a) Quantity is within Master Order balance, (b) Customer has…">
        <bpmn:documentation>Step 3: System validates: (a) Quantity is within Master Order balance, (b) Customer has available credit limit, (c) Customer has no overdue invoices
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W164_Flow18</bpmn:incoming>
        <bpmn:outgoing>W164_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W164_Task10" name="System reserves stock at the designated DC or Store for this release">
        <bpmn:documentation>Step 4: System reserves stock at the designated DC or Store for this release
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W164_Flow19</bpmn:incoming>
        <bpmn:outgoing>W164_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W164_Task11" name="Logistics processes the delivery per W19 (Dispatch)">
        <bpmn:documentation>Step 5: Logistics processes the delivery per W19 (Dispatch)
Responsible (R): Logistics Team
Accountable (A): —
Duration: Per W19</bpmn:documentation>
        <bpmn:incoming>W164_Flow20</bpmn:incoming>
        <bpmn:outgoing>W164_Flow21</bpmn:outgoing>
      </bpmn:userTask>
