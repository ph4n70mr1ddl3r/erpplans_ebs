    <bpmn:process id="W_W1549" name="W1549. Contractor Annual Spend Tier Review, Loyalty Tier Recalculation &amp; Benefit Adjustment" isExecutable="false">
      <bpmn:documentation>Trigger: Annual contractor tier review cycle (January); or contractor requests tier evaluation mid-year
Frequency: Annual review of ~5,200 trade accounts; ~200 mid-year review requests
Volume: All trade account customers reviewed annually for tier qualification
Owner: Trade Account Manager
Participants: Trade Account Manager, Credit Analyst, Category Manager, VP Store Operations
Source: workflow W1549 — Contractor Annual Spend Tier Review, Loyalty Tier Recalculation &amp; Benefit Adjustment</bpmn:documentation>
      <bpmn:laneSet id="W1549_LaneSet5">
        <bpmn:lane id="W1549_Lane1" name="System">
        <bpmn:flowNodeRef>W1549_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1549_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1549_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1549_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1549_Lane2" name="Credit Analyst">
        <bpmn:flowNodeRef>W1549_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1549_Lane3" name="Trade Account Manager">
        <bpmn:flowNodeRef>W1549_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1549_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1549_Lane4" name="VP Store Operations">
        <bpmn:flowNodeRef>W1549_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1549_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1549_Start6" name="Annual contractor tier review cycle (January); or contractor requests tier evaluation…">
        <bpmn:outgoing>W1549_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1549_Task7" name="Annual spend aggregation">
        <bpmn:documentation>Step 1: Annual spend aggregation: System calculates 12-month trailing spend per trade account — total spend, spend by category, transaction frequency, average transaction value, payment behavior (on-time %, average days-to-pay); flags accounts with significant YoY growth (≥ 25%) or decline (≥ 20%)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1549_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1549_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1549_Task8" name="Tier recalculation">
        <bpmn:documentation>Step 2: Tier recalculation: System applies tier qualification rules — Bronze: PHP 100K–500K annual spend; Silver: PHP 500K–1.5M; Gold: PHP 1.5M–5M; Platinum: &gt; PHP 5M; additional factors: payment behavior score, account age, multi-category breadth; generates tier change recommendations (upgrade, downgrade, maintain)
Responsible (R): System
Accountable (A): Trade Account Manager
Duration: Automated + 30 min review</bpmn:documentation>
        <bpmn:incoming>W1549_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1549_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1549_Task9" name="Credit review integration">
        <bpmn:documentation>Step 3: Credit review integration: For tier upgrade recommendations, Credit Analyst reviews credit limit adequacy — higher tiers typically warrant higher credit limits; system recommends credit limit adjustments aligned with new tier (W328); flags accounts where tier upgrade exceeds current credit utilization capacity
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: 15 min/account (upgrades only)</bpmn:documentation>
        <bpmn:incoming>W1549_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1549_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1549_Task10" name="Benefit adjustment">
        <bpmn:documentation>Step 4: Benefit adjustment: For tier changes, system automatically adjusts: (a) trade discount percentage in customer price book (W163); (b) payment terms (Bronze: Net 30, Silver: Net 30, Gold: Net 45, Platinum: Net 60); (c) Pro Desk priority access level; (d) promotional calendar eligibility (Platinum gets early access)
Responsible (R): System
Accountable (A): Trade Account Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1549_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1549_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1549_Task11" name="Customer communication">
        <bpmn:documentation>Step 5: Customer communication: Trade Account Manager sends personalized tier status notification to each trade customer — congratulations for upgrades (with enhanced benefit details), gentle notification for downgrades (with qualification criteria for re-upgrade), or maintenance confirmation; for top-tier upgrades, Trade Account Manager schedules in-store meeting with Store Manager
Responsible (R): Trade Account Manager
Accountable (A): VP Store Operations
Duration: 10 min/account × ~1,000 tier changes</bpmn:documentation>
        <bpmn:incoming>W1549_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1549_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1549_Task12" name="Retention outreach for downgrades">
        <bpmn:documentation>Step 6: Retention outreach for downgrades: For accounts downgraded due to spend decline, Trade Account Manager conducts outreach call — understand reason for reduced spend (competitor switch? project cycle? dissatisfaction?); offers win-back promotion (W84) if applicable; documents feedback for Category Manager review
Responsible (R): Trade Account Manager
Accountable (A): VP Store Operations
Duration: 20 min/account × ~200 downgrades</bpmn:documentation>
        <bpmn:incoming>W1549_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1549_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1549_Task13" name="Executive review">
        <bpmn:documentation>Step 7: Executive review: VP Store Operations and VP Merchandising review annual tier distribution — total accounts per tier, tier migration rates, revenue concentration by tier, margin analysis by tier; identifies strategic opportunities (e.g., Silver→Gold upgrade campaigns)
Responsible (R): VP Store Operations
Accountable (A): CEO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W1549_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1549_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1549_End14" name="Complete">
        <bpmn:incoming>W1549_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1549_Annotation15">
        <bpmn:text>Controls: - CTL-273 (ensure controlled execution — Project Sales &amp; B2B (PA-11.2).) | - operational: Trade Account Manager review and approval gate
Owner: Trade Account Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1549_Assoc16" sourceRef="W1549_Annotation15" targetRef="W1549_Start6" associationDirection="None" />
