    <bpmn:process id="W_W1509" name="W1509. Customer Bulk Construction Material Direct-to-Jobsite Delivery Order Management" isExecutable="false">
      <bpmn:documentation>Trigger: Customer (trade account or walk-in) purchases bulk construction materials (cement, sand, gravel, steel rebar, hollow blocks, lumber) requiring delivery directly to construction jobsite
Frequency: ~3–5 bulk delivery orders per store per week; higher during construction season (Jan–May, Sep–Dec)
Volume: ~2,600–4,300 bulk delivery orders/month chain-wide (~600–1,000/week per the Frequency); average order weight: 5–20 tons; average order value: PHP 30,000–150,000
Owner: Sales Associate (order capture); Logistics Coordinator (delivery execution)
Participants: Sales Associate, Customer, Logistics Coordinator, Truck Driver, Receiving Clerk (at jobsite), Category Manager
Source: workflow W1509 — Customer Bulk Construction Material Direct-to-Jobsite Delivery Order Management</bpmn:documentation>
      <bpmn:laneSet id="W1509_LaneSet5">
        <bpmn:lane id="W1509_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W1509_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1509_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1509_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1509_Lane2" name="Logistics Coordinator">
        <bpmn:flowNodeRef>W1509_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1509_Lane3" name="Stock Associate">
        <bpmn:flowNodeRef>W1509_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1509_Lane4" name="Driver">
        <bpmn:flowNodeRef>W1509_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1509_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1509_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1509_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1509_Start6" name="Customer (trade account or walk-in) purchases bulk construction materials (cement, sand…">
        <bpmn:outgoing>W1509_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1509_Task7" name="Order capture at store">
        <bpmn:documentation>Step 1: Order capture at store: Customer visits store or calls to place bulk material order: (a) Sales Associate captures: (i) material type, grade, and quantity (e.g., 200 bags Portland cement, 5 cu.m. washed sand, 500 pcs 4&quot; hollow blocks), (b) delivery address with GPS coordinates or landmark description (construction sites often lack formal addresses), (c) jobsite contact person and mobile number, (d) required delivery date and time window (AM/PM specific), (e) jobsite access notes (gate code, road width for truck, overhead clearance, floor level for high-rise), (f) unloading method: (i) manual unload (driver + 1 helper), (ii) boom truck/crane required (customer cost), (iii) pump truck required for concrete (coordinated with ready-mix supplier), (iv) customer provides own labor for unloading; Sales Associate enters order in ERP as Delivery Order (DO) type &quot;Bulk Jobsite&quot;
Responsible (R): Sales Associate
Accountable (A): Dept Supervisor
Duration: 15–20 min</bpmn:documentation>
        <bpmn:incoming>W1509_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1509_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1509_Task8" name="Delivery fee calculation &amp; payment">
        <bpmn:documentation>Step 2: Delivery fee calculation &amp; payment: System calculates delivery fee based on: (a) distance from store to jobsite (zone-based: within 5 km / 5–15 km / 15–30 km / 30+ km), (b) vehicle type required: (i) 6-wheeler truck (max 8 tons) for standard deliveries, (ii) 10-wheeler wing van (max 15 tons) for large orders, (iii) boom truck (additional PHP 3,000–5,000 surcharge), (iv) flatbed with crane for steel/lumber; (c) delivery fee displayed to customer; (d) free delivery for orders ≥ PHP 50,000 within 15 km (standard BuildRight policy); (e) customer pays for materials + delivery fee at POS; for trade accounts: charge to account per W1269 credit terms
Responsible (R): Sales Associate / System
Accountable (A): Dept Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1509_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1509_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1509_Task9" name="Logistics coordination">
        <bpmn:documentation>Step 3: Logistics coordination: Logistics Coordinator reviews all pending bulk DOs for the day/next day: (a) group orders by delivery zone for route optimization, (b) assign vehicle based on weight/volume and jobsite access requirements, (c) assign driver and helper; for boom truck requirements: coordinate with external equipment rental, (d) generate delivery route sheet with optimized sequence, (e) confirm delivery schedule with customer via SMS/call (Day-before confirmation: reduce failed delivery rate), (f) for multi-drop routes: sequence deliveries to minimize backtracking and ensure each customer receives materials within promised time window
Responsible (R): Logistics Coordinator
Accountable (A): Logistics Mgr
Duration: 30–60 min/day</bpmn:documentation>
        <bpmn:incoming>W1509_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1509_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1509_Task10" name="Loading &amp; dispatch">
        <bpmn:documentation>Step 4: Loading &amp; dispatch: At store: (a) Stock Associates load materials onto assigned truck per delivery sequence (last delivery loaded first for easy access), (b) for fragile items (hollow blocks): stack carefully with dunnage to prevent breakage, (c) for cement: protect from rain with tarpaulin, (d) driver verifies load against DO: material type, quantity, and jobsite address; signs load confirmation, (e) driver departs store with DO, delivery route sheet, and customer contact information
Responsible (R): Stock Associate / Driver
Accountable (A): Dept Supervisor
Duration: 30–60 min per truck</bpmn:documentation>
        <bpmn:incoming>W1509_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1509_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1509_Task11" name="Jobsite delivery">
        <bpmn:documentation>Step 5: Jobsite delivery: Driver arrives at construction site: (a) contact jobsite person 15 minutes before arrival, (b) navigate to delivery point — construction sites may have narrow access roads, overhead obstructions, or require security clearance; (c) position truck for optimal unloading, (d) unload materials per agreed method: (i) manual: driver + helper place materials at designated staging area on site, (ii) boom truck: operator lifts pallets to upper floors, (iii) customer&#x27;s own labor unloads; (e) count and verify quantity with jobsite contact: confirm number of cement bags, hollow blocks, etc. — for sand/gravel: estimate volume visually against ordered cubic meters (weight bridge at jobsite is rare), (f) jobsite contact signs Delivery Receipt (DR) confirming quantity received and condition
Responsible (R): Driver / Jobsite Contact
Accountable (A): Logistics Coordinator
Duration: 30–90 min per delivery</bpmn:documentation>
        <bpmn:incoming>W1509_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1509_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1509_Task12" name="Shortage &amp; damage resolution">
        <bpmn:documentation>Step 6: Shortage &amp; damage resolution: If discrepancy at delivery: (a) shortage: driver and customer count together; if confirmed shortage: (i) driver notes shortage on DR with both signatures, (ii) store processes credit note for shortage, (iii) schedule make-up delivery if customer requires full quantity, (b) damage: broken hollow blocks, torn cement bags, bent rebar: (i) driver notes damage on DR, (ii) customer may reject damaged items or accept with notation, (iii) store replaces damaged items on next delivery or issues credit, (c) system updates DO status: Delivered Complete / Delivered Partial / Delivered with Damage
Responsible (R): Driver / Jobsite Contact / Sales Associate
Accountable (A): Logistics Coordinator
Duration: 15–30 min per discrepancy</bpmn:documentation>
        <bpmn:incoming>W1509_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1509_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1509_Task13" name="Delivery confirmation &amp; system update">
        <bpmn:documentation>Step 7: Delivery confirmation &amp; system update: Driver returns to store with signed DR: (a) Receiving Clerk scans signed DR into system; (b) system updates DO status to &quot;Delivered&quot; and triggers: (i) inventory deduction at store for delivered quantities, (ii) AR invoice generation for trade accounts, (iii) delivery performance metric update; (c) system sends delivery confirmation SMS to customer: &quot;Your delivery of [materials] has been completed. Thank you for choosing BuildRight!&quot;
Responsible (R): Driver / Receiving Clerk
Accountable (A): Dept Supervisor
Duration: 5–10 min per DR</bpmn:documentation>
        <bpmn:incoming>W1509_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1509_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1509_End14" name="Complete">
        <bpmn:incoming>W1509_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1509_Annotation15">
        <bpmn:text>Controls: - CTL-273 (ensure controlled execution — Project Sales &amp; B2B (PA-11.2).) | - operational: collecting detailed access notes at order capture (Step 1) and driver pre-call to jobsite contact (Step 5); operational: truck scale tickets (if available) and clear DR signature protocol; operational: Day-before confirmation (Step 3), buffer time in delivery windows, and escalation hotline for delivery delays
Owner: Sales Associate (order capture); Logistics Coordinator (delivery execution)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1509_Assoc16" sourceRef="W1509_Annotation15" targetRef="W1509_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1509_Flow17" sourceRef="W1509_Start6" targetRef="W1509_Task7" />
      <bpmn:sequenceFlow id="W1509_Flow18" sourceRef="W1509_Task7" targetRef="W1509_Task8" />
      <bpmn:sequenceFlow id="W1509_Flow19" sourceRef="W1509_Task8" targetRef="W1509_Task9" />
      <bpmn:sequenceFlow id="W1509_Flow20" sourceRef="W1509_Task9" targetRef="W1509_Task10" />
      <bpmn:sequenceFlow id="W1509_Flow21" sourceRef="W1509_Task10" targetRef="W1509_Task11" />
      <bpmn:sequenceFlow id="W1509_Flow22" sourceRef="W1509_Task11" targetRef="W1509_Task12" />
      <bpmn:sequenceFlow id="W1509_Flow23" sourceRef="W1509_Task12" targetRef="W1509_Task13" />
      <bpmn:sequenceFlow id="W1509_Flow24" sourceRef="W1509_Task13" targetRef="W1509_End14" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1509_diag">
      <bpmndi:BPMNPlane id="W1509_plane" bpmnElement="W_W1509">
        <bpmndi:BPMNShape id="W1509_Lane1_di" bpmnElement="W1509_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1509_Lane2_di" bpmnElement="W1509_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1509_Lane3_di" bpmnElement="W1509_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1509_Lane4_di" bpmnElement="W1509_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1509_Task7_di" bpmnElement="W1509_Task7"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1509_Task8_di" bpmnElement="W1509_Task8"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1509_Task9_di" bpmnElement="W1509_Task9"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1509_Task10_di" bpmnElement="W1509_Task10"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
