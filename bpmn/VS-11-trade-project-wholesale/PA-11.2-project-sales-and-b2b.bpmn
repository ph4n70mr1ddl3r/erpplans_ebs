      <bpmn:sequenceFlow id="W1153_Flow14" sourceRef="W1153_Task6" targetRef="W1153_Task7" />
      <bpmn:sequenceFlow id="W1153_Flow15" sourceRef="W1153_Task7" targetRef="W1153_Task8" />
      <bpmn:sequenceFlow id="W1153_Flow16" sourceRef="W1153_Task8" targetRef="W1153_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1153_diag">
      <bpmndi:BPMNPlane id="W1153_plane" bpmnElement="W_W1153">
        <bpmndi:BPMNShape id="W1153_Lane1_di" bpmnElement="W1153_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
