      <bpmn:sequenceFlow id="W1549_Flow21" sourceRef="W1549_Task10" targetRef="W1549_Task11" />
      <bpmn:sequenceFlow id="W1549_Flow22" sourceRef="W1549_Task11" targetRef="W1549_Task12" />
      <bpmn:sequenceFlow id="W1549_Flow23" sourceRef="W1549_Task12" targetRef="W1549_Task13" />
      <bpmn:sequenceFlow id="W1549_Flow24" sourceRef="W1549_Task13" targetRef="W1549_End14" />
    </bpmn:process>
