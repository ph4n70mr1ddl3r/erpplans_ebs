      <bpmn:sequenceFlow id="W1288_Flow24" sourceRef="W1288_Task13" targetRef="W1288_End14" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1288_diag">
      <bpmndi:BPMNPlane id="W1288_plane" bpmnElement="W_W1288">
        <bpmndi:BPMNShape id="W1288_Lane1_di" bpmnElement="W1288_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
