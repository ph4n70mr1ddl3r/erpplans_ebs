        <bpmndi:BPMNShape id="W1011_Task8_di" bpmnElement="W1011_Task8"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1011_Task9_di" bpmnElement="W1011_Task9"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1011_Start4_di" bpmnElement="W1011_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1011_End10_di" bpmnElement="W1011_End10"><dc:Bounds x="1470" y="317" width="36" height="36" /></bpmndi:BPMNShape>
