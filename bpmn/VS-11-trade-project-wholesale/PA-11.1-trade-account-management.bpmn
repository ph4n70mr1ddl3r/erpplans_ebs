    <bpmn:process id="W_W166" name="W166. Corporate / Institutional Tendering" isExecutable="false">
      <bpmn:documentation>Trigger: Government (PhilGEPS) or Private Institutional RFP/RFQ issued
Frequency: ~5–10 active bids at any time; PhilGEPS postings are continuous
Volume: Government tenders range PHP 500K–20M; institutional RFQs PHP 200K–10M
Owner: Bid &amp; Tender Manager
Participants: Bid Manager, Head of Trade / Account Management, Legal Counsel, CFO, Category Manager, Sales Rep
Source: workflow W166 — Corporate / Institutional Tendering</bpmn:documentation>
      <bpmn:laneSet id="W166_LaneSet2">
        <bpmn:lane id="W166_Lane1" name="Bid Manager">
        <bpmn:flowNodeRef>W166_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W166_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W166_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W166_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W166_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W166_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W166_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W166_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W166_Start3" name="Government (PhilGEPS) or Private Institutional RFP/RFQ issued">
        <bpmn:outgoing>W166_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W166_Task4" name="Bid Manager monitors PhilGEPS/Tender boards; downloads RFP">
        <bpmn:documentation>Step 1: Bid Manager monitors PhilGEPS/Tender boards; downloads RFP
Responsible (R): Bid Manager
Accountable (A): —
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W166_Flow13</bpmn:incoming>
        <bpmn:outgoing>W166_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W166_Task5" name="Initial Go/No-Go: Evaluate capability, capacity, and margin potential">
        <bpmn:documentation>Step 2: Initial Go/No-Go: Evaluate capability, capacity, and margin potential
Responsible (R): Bid Manager
Accountable (A): Head of Trade / Account Management
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W166_Flow14</bpmn:incoming>
        <bpmn:outgoing>W166_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W166_Task6" name="Coordinate with Legal (Tender Bonds, JV agreements) and Finance (Performance…">
        <bpmn:documentation>Step 3: Coordinate with Legal (Tender Bonds, JV agreements) and Finance (Performance Bonds, Cash Flow)
Responsible (R): Bid Manager
Accountable (A): Legal / CFO
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W166_Flow15</bpmn:incoming>
        <bpmn:outgoing>W166_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W166_Task7" name="Compile Bid Package: Pricing (W162), Technical Specs (W50), Corporate Docs">
        <bpmn:documentation>Step 4: Compile Bid Package: Pricing (W162), Technical Specs (W50), Corporate Docs
Responsible (R): Bid Manager
Accountable (A): —
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W166_Flow16</bpmn:incoming>
        <bpmn:outgoing>W166_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W166_Task8" name="Submit Bid (Electronic or Physical); track bid opening results">
        <bpmn:documentation>Step 5: Submit Bid (Electronic or Physical); track bid opening results
Responsible (R): Bid Manager
Accountable (A): —
Duration: Per RFP</bpmn:documentation>
        <bpmn:incoming>W166_Flow17</bpmn:incoming>
        <bpmn:outgoing>W166_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W166_Task9" name="If won: Transition to W163 (Contract Pricing) and W164 (Fulfillment)">
        <bpmn:documentation>Step 6: If won: Transition to W163 (Contract Pricing) and W164 (Fulfillment)
Responsible (R): Bid Manager
Accountable (A): —
Duration: —</bpmn:documentation>
        <bpmn:incoming>W166_Flow18</bpmn:incoming>
        <bpmn:outgoing>W166_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W166_End10" name="Complete">
        <bpmn:incoming>W166_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W166_Annotation11">
        <bpmn:text>Controls: - CTL-272 (ensure controlled execution — Trade Account Management (PA-11.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Bid &amp; Tender Manager</bpmn:text>
      </bpmn:textAnnotation>
