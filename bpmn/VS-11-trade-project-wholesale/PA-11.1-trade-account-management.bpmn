      <bpmn:sequenceFlow id="W1394_Flow24" sourceRef="W1394_Task12" targetRef="W1394_Task13" />
      <bpmn:sequenceFlow id="W1394_Flow25" sourceRef="W1394_Task13" targetRef="W1394_End14" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1394_diag">
      <bpmndi:BPMNPlane id="W1394_plane" bpmnElement="W_W1394">
        <bpmndi:BPMNShape id="W1394_Lane1_di" bpmnElement="W1394_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2000" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1394_Lane2_di" bpmnElement="W1394_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="2000" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1394_Lane3_di" bpmnElement="W1394_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="2000" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1394_Task6_di" bpmnElement="W1394_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1394_Task7_di" bpmnElement="W1394_Task7"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1394_Task8_di" bpmnElement="W1394_Task8"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1394_Task9_di" bpmnElement="W1394_Task9"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1394_Task10_di" bpmnElement="W1394_Task10"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1394_Task11_di" bpmnElement="W1394_Task11"><dc:Bounds x="1450" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1394_Task12_di" bpmnElement="W1394_Task12"><dc:Bounds x="1660" y="295" width="180" height="80" /></bpmndi:BPMNShape>
