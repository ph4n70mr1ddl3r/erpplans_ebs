        <bpmndi:BPMNEdge id="W3730_Assoc9_di" bpmnElement="W3730_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3731" name="W3731. Culture, Engagement &amp; Trust Measurement" isExecutable="false">
      <bpmn:documentation>Trigger: Annual survey cycle; pulse survey
Frequency: Annual + pulse
Volume: ~6,925 employees across 200 stores/4 DCs/5 entities
Owner: Ethics &amp; Compliance Officer / HR-EX
Participants: Ethics &amp; Compliance Officer, HR/EX (links to VS-103.2/VS-103.3), Communications (links to VS-14.3), BI (links to VS-28.1), Store Ops (links to VS-07), Ethics Committee (links to W3719)
Source: workflow W3731 — Culture, Engagement &amp; Trust Measurement</bpmn:documentation>
      <bpmn:laneSet id="W3731_LaneSet2">
        <bpmn:lane id="W3731_Lane1" name="Ethics &amp; Compliance Officer">
        <bpmn:flowNodeRef>W3731_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3731_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3731_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3731_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3731_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3731_Start3" name="Annual survey cycle; pulse survey">
        <bpmn:outgoing>W3731_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3731_Task4" name="Ethics &amp; Compliance Officer/HR-EX measure ethics culture and speak-up trust…">
        <bpmn:documentation>Step 1: Ethics &amp; Compliance Officer/HR-EX measure ethics culture and speak-up trust: annual ethics-culture survey and periodic pulse surveys on psychological safety, willingness to speak up, perceived retaliation risk, leadership integrity, and awareness of the channel — across all locations/entities (links to VS-103.2 engagement)
Responsible (R): Ethics &amp; Compliance Officer / HR-EX / BI
Accountable (A): Ethics &amp; Compliance Officer
Duration: Annual + pulse</bpmn:documentation>
        <bpmn:incoming>W3731_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3731_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3731_Task5" name="Ethics &amp; Compliance Officer/HR-EX analyze results by…">
        <bpmn:documentation>Step 2: Ethics &amp; Compliance Officer/HR-EX analyze results by location/entity/function/demographic, identify low-trust hotspots, and correlate with report volume/analytics (W3729) to distinguish &quot;no misconduct&quot; from &quot;no trust to report&quot;
Responsible (R): Ethics &amp; Compliance Officer / BI
Accountable (A): Ethics &amp; Compliance Officer
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3731_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3731_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3731_Task6" name="Ethics &amp; Compliance Officer/Communications drive culture improvement: targeted…">
        <bpmn:documentation>Step 3: Ethics &amp; Compliance Officer/Communications drive culture improvement: targeted leadership/communication/training in low-trust areas (links to W3718), track trust-score improvement, and report culture posture to the Ethics Committee (W3719) and governance (links to VS-36)
Responsible (R): Ethics &amp; Compliance Officer / HR-EX / Communications
Accountable (A): Ethics &amp; Compliance Officer
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3731_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3731_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3731_End7" name="Complete">
        <bpmn:incoming>W3731_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3731_Annotation8">
        <bpmn:text>Controls: - CTL-588 (ensure controlled execution — Ethics Analytics, Culture &amp; Program Assurance (PA-119.3).) | - operational: accessible/anonymous surveys and store-level promotion; operational: trust measurement
Owner: Ethics &amp; Compliance Officer / HR-EX</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3731_Assoc9" sourceRef="W3731_Annotation8" targetRef="W3731_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3731_Flow10" sourceRef="W3731_Start3" targetRef="W3731_Task4" />
      <bpmn:sequenceFlow id="W3731_Flow11" sourceRef="W3731_Task4" targetRef="W3731_Task5" />
      <bpmn:sequenceFlow id="W3731_Flow12" sourceRef="W3731_Task5" targetRef="W3731_Task6" />
      <bpmn:sequenceFlow id="W3731_Flow13" sourceRef="W3731_Task6" targetRef="W3731_End7" />
    </bpmn:process>
