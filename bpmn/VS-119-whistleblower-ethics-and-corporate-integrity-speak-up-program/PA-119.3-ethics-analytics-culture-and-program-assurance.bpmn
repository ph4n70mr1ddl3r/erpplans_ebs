<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-119.3-ethics-analytics-culture-and-program-assurance" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3729" name="W3729. Ethics &amp; Speak-Up Analytics &amp; KPI Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Reporting cycle; committee review
Frequency: Monthly + quarterly
Volume: Program KPIs and analytics
Owner: Ethics &amp; Compliance Officer / BI
Participants: Ethics &amp; Compliance Officer, BI (links to VS-28.1/VS-103.3), Audit (links to VS-21), Risk (links to VS-21.2), Ethics Committee (links to W3719), Board Audit Committee (links to VS-36)
Source: workflow W3729 — Ethics &amp; Speak-Up Analytics &amp; KPI Reporting</bpmn:documentation>
      <bpmn:laneSet id="W3729_LaneSet2">
        <bpmn:lane id="W3729_Lane1" name="Ethics &amp; Compliance Officer">
        <bpmn:flowNodeRef>W3729_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3729_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3729_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3729_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3729_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3729_Start3" name="Reporting cycle; committee review">
        <bpmn:outgoing>W3729_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3729_Task4" name="Ethics &amp; Compliance Officer/BI maintain the ethics &amp; speak-up KPI dashboard…">
        <bpmn:documentation>Step 1: Ethics &amp; Compliance Officer/BI maintain the ethics &amp; speak-up KPI dashboard: report volume by channel/category/location, substantiation rate, case cycle-time, retaliation incidents, repeat-offender/repeat-issue patterns, training completion, and culture-trust score
Responsible (R): Ethics &amp; Compliance Officer / BI
Accountable (A): Ethics &amp; Compliance Officer
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3729_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3729_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3729_Task5" name="Ethics &amp; Compliance Officer analyze trends: by category (ABC, fraud…">
        <bpmn:documentation>Step 2: Ethics &amp; Compliance Officer analyze trends: by category (ABC, fraud, harassment, safety, etc.), by location/entity, over time; identify hotspots, emerging risks, and control-effectiveness decay; benchmark against program maturity and external norms
Responsible (R): Ethics &amp; Compliance Officer / BI / Risk
Accountable (A): Ethics &amp; Compliance Officer
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3729_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3729_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3729_Task6" name="Ethics &amp; Compliance Officer publish analytics to the Ethics Committee (W3719)…">
        <bpmn:documentation>Step 3: Ethics &amp; Compliance Officer publish analytics to the Ethics Committee (W3719), board audit committee (links to VS-36), and executives; drive prioritized action on hotspots and feed to risk assessment (W3730) and continuous improvement (W3736)
Responsible (R): Ethics &amp; Compliance Officer / BI
Accountable (A): Ethics &amp; Compliance Officer
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3729_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3729_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3729_End7" name="Complete">
        <bpmn:incoming>W3729_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3729_Annotation8">
        <bpmn:text>Controls: - CTL-588 (ensure controlled execution — Ethics Analytics, Culture &amp; Program Assurance (PA-119.3).) | - operational: KPI dashboard; operational: culture measurement (W3731)
Owner: Ethics &amp; Compliance Officer / BI</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3729_Assoc9" sourceRef="W3729_Annotation8" targetRef="W3729_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3729_Flow10" sourceRef="W3729_Start3" targetRef="W3729_Task4" />
      <bpmn:sequenceFlow id="W3729_Flow11" sourceRef="W3729_Task4" targetRef="W3729_Task5" />
      <bpmn:sequenceFlow id="W3729_Flow12" sourceRef="W3729_Task5" targetRef="W3729_Task6" />
      <bpmn:sequenceFlow id="W3729_Flow13" sourceRef="W3729_Task6" targetRef="W3729_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3729_diag">
      <bpmndi:BPMNPlane id="W3729_plane" bpmnElement="W_W3729">
        <bpmndi:BPMNShape id="W3729_Lane1_di" bpmnElement="W3729_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
