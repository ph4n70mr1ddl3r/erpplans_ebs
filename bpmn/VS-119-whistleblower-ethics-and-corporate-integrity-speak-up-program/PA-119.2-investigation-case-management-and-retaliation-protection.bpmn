        <bpmndi:BPMNShape id="W3722_Start3_di" bpmnElement="W3722_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3722_End7_di" bpmnElement="W3722_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3722_Annotation8_di" bpmnElement="W3722_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3722_Flow10_di" bpmnElement="W3722_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3722_Flow11_di" bpmnElement="W3722_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3722_Flow12_di" bpmnElement="W3722_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3722_Flow13_di" bpmnElement="W3722_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3722_Assoc9_di" bpmnElement="W3722_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3723" name="W3723. Investigation Finding, Conclusion &amp; Adjudication" isExecutable="false">
      <bpmn:documentation>Trigger: Investigation completion (W3721/W3722)
Frequency: Per case
Volume: All investigated cases
Owner: Lead Investigator / Ethics &amp; Compliance Officer
Participants: Lead Investigator, Ethics &amp; Compliance Officer, Legal (links to VS-100.3), HR (links to VS-19), Ethics Committee (links to W3719), Audit (links to VS-21), Risk (links to VS-21.2)
Source: workflow W3723 — Investigation Finding, Conclusion &amp; Adjudication</bpmn:documentation>
      <bpmn:laneSet id="W3723_LaneSet3">
        <bpmn:lane id="W3723_Lane1" name="Lead Investigator">
        <bpmn:flowNodeRef>W3723_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3723_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3723_Lane2" name="Ethics &amp; Compliance Officer">
        <bpmn:flowNodeRef>W3723_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3723_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3723_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3723_Start4" name="Investigation completion (W3721/W3722)">
        <bpmn:outgoing>W3723_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3723_Task5" name="Lead Investigator prepare the investigation report: findings of fact, evidence…">
        <bpmn:documentation>Step 1: Lead Investigator prepare the investigation report: findings of fact, evidence, witness statements, the conclusion (substantiated / unsubstantiated / inconclusive), root cause, and recommended action — documented objectively and defensibly
Responsible (R): Lead Investigator / Legal
Accountable (A): Ethics &amp; Compliance Officer
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W3723_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3723_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3723_Task6" name="Ethics &amp; Compliance Officer/Ethics Committee adjudicate: review the report…">
        <bpmn:documentation>Step 2: Ethics &amp; Compliance Officer/Ethics Committee adjudicate: review the report, confirm the conclusion, decide on action (links to W3724), manage any dissent/appeal, and for high-severity cases escalate to the Ethics Committee (W3719) and board (links to VS-36)
Responsible (R): Ethics &amp; Compliance Officer / Ethics Committee
Accountable (A): Ethics Committee
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W3723_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3723_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3723_Task7" name="Ethics &amp; Compliance Officer communicate the outcome to the reporter (where…">
        <bpmn:documentation>Step 3: Ethics &amp; Compliance Officer communicate the outcome to the reporter (where appropriate and lawful) and the subject per process, manage confidentiality, and trigger disciplinary/corrective action (W3724); document the adjudication in case-management (links to W3720)
Responsible (R): Ethics &amp; Compliance Officer / HR / Legal
Accountable (A): Ethics &amp; Compliance Officer
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W3723_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3723_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3723_End8" name="Complete">
        <bpmn:incoming>W3723_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3723_Annotation9">
        <bpmn:text>Controls: - CTL-587 (ensure controlled execution — Investigation, Case Management &amp; Retaliation Protection (PA-119.2).) | - operational: thorough investigation and control-improvement; operational: Ethics Committee independence
Owner: Lead Investigator / Ethics &amp; Compliance Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3723_Assoc10" sourceRef="W3723_Annotation9" targetRef="W3723_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3723_Flow11" sourceRef="W3723_Start4" targetRef="W3723_Task5" />
      <bpmn:sequenceFlow id="W3723_Flow12" sourceRef="W3723_Task5" targetRef="W3723_Task6" />
      <bpmn:sequenceFlow id="W3723_Flow13" sourceRef="W3723_Task6" targetRef="W3723_Task7" />
      <bpmn:sequenceFlow id="W3723_Flow14" sourceRef="W3723_Task7" targetRef="W3723_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3723_diag">
      <bpmndi:BPMNPlane id="W3723_plane" bpmnElement="W_W3723">
        <bpmndi:BPMNShape id="W3723_Lane1_di" bpmnElement="W3723_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3723_Lane2_di" bpmnElement="W3723_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3723_Task5_di" bpmnElement="W3723_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3723_Task6_di" bpmnElement="W3723_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3723_Task7_di" bpmnElement="W3723_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3723_Start4_di" bpmnElement="W3723_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3723_End8_di" bpmnElement="W3723_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3723_Annotation9_di" bpmnElement="W3723_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3723_Flow11_di" bpmnElement="W3723_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3723_Flow12_di" bpmnElement="W3723_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3723_Flow13_di" bpmnElement="W3723_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3723_Flow14_di" bpmnElement="W3723_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3723_Assoc10_di" bpmnElement="W3723_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3724" name="W3724. Disciplinary, Corrective &amp; Remediation Action" isExecutable="false">
      <bpmn:documentation>Trigger: Substantiated finding (W3723)
Frequency: Per substantiated case
Volume: Per case
Owner: Ethics &amp; Compliance Officer / HR
Participants: Ethics &amp; Compliance Officer, HR (links to VS-19/VS-84), Legal (links to VS-100.3), LP (links to VS-23), the subject&#x27;s management, Audit (links to VS-21), Risk (links to VS-21.2), Finance/Recovery (links to VS-17)
Source: workflow W3724 — Disciplinary, Corrective &amp; Remediation Action</bpmn:documentation>
      <bpmn:laneSet id="W3724_LaneSet2">
        <bpmn:lane id="W3724_Lane1" name="Ethics &amp; Compliance Officer">
        <bpmn:flowNodeRef>W3724_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3724_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3724_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3724_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3724_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3724_Start3" name="Substantiated finding (W3723)">
        <bpmn:outgoing>W3724_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3724_Task4" name="Ethics &amp; Compliance Officer/HR determine and execute disciplinary action…">
        <bpmn:documentation>Step 1: Ethics &amp; Compliance Officer/HR determine and execute disciplinary action proportionate to the substantiated misconduct: coaching/warning, reprimand, reassignment, suspension, or termination (links to VS-19.5/VS-84 due-process), following labor-law due process (links to VS-84)
Responsible (R): Ethics &amp; Compliance Officer / HR / Legal
Accountable (A): Ethics Committee
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W3724_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3724_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3724_Task5" name="Ethics &amp; Compliance Officer drive corrective/remediation action on root cause…">
        <bpmn:documentation>Step 2: Ethics &amp; Compliance Officer drive corrective/remediation action on root cause: control/process fix, policy update (links to W3714), system change, training (links to W3718), and where a control failed, an audit follow-up (links to VS-21); pursue financial recovery where loss occurred (links to VS-17/VS-23)
Responsible (R): Ethics &amp; Compliance Officer / Internal Controls / Audit
Accountable (A): Ethics &amp; Compliance Officer
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W3724_Flow11</bpmn:incoming>
