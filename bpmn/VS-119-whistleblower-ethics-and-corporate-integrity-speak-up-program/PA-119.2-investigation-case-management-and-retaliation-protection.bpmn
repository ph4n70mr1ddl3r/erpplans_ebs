      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3722" name="W3722. Investigation Interview &amp; Witness Management" isExecutable="false">
      <bpmn:documentation>Trigger: Investigation plan (W3721)
Frequency: Per case
Volume: Subjects/witnesses per case
Owner: Lead Investigator / HR
Participants: Lead Investigator, HR (links to VS-19/VS-84), Legal (links to VS-100.3), Ethics &amp; Compliance Officer, LP (links to VS-23), witnesses/subjects
Source: workflow W3722 — Investigation Interview &amp; Witness Management</bpmn:documentation>
      <bpmn:laneSet id="W3722_LaneSet2">
        <bpmn:lane id="W3722_Lane1" name="Lead Investigator">
        <bpmn:flowNodeRef>W3722_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3722_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3722_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3722_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3722_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3722_Start3" name="Investigation plan (W3721)">
        <bpmn:outgoing>W3722_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3722_Task4" name="Lead Investigator/HR plan and conduct interviews: identify interview subjects…">
        <bpmn:documentation>Step 1: Lead Investigator/HR plan and conduct interviews: identify interview subjects (reporter, accused, witnesses), schedule confidentially, conduct interviews per protocol (two interviewers, note-taking/recording where lawful), and protect witness confidentiality
Responsible (R): Lead Investigator / HR / Legal
Accountable (A): Ethics &amp; Compliance Officer
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W3722_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3722_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3722_Task5" name="Lead Investigator manage subject/witness rights and protections: ensure…">
        <bpmn:documentation>Step 2: Lead Investigator manage subject/witness rights and protections: ensure fairness, the right to representation (union/links to VS-84 where applicable), protection from retaliation (links to W3725), and HR/legal compliance with labor law (links to VS-19/VS-84)
Responsible (R): Lead Investigator / HR / Legal
Accountable (A): Ethics &amp; Compliance Officer
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W3722_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3722_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3722_Task6" name="Lead Investigator document interview statements, assess…">
        <bpmn:documentation>Step 3: Lead Investigator document interview statements, assess credibility/consistency, reconcile with evidence (W3721), and identify follow-up leads; manage witness support throughout
Responsible (R): Lead Investigator
Accountable (A): Ethics &amp; Compliance Officer
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W3722_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3722_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3722_End7" name="Complete">
        <bpmn:incoming>W3722_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3722_Annotation8">
        <bpmn:text>Controls: - CTL-587 (ensure controlled execution — Investigation, Case Management &amp; Retaliation Protection (PA-119.2).) | - operational: simultaneous/confidential interviews; operational: protection (W3725)
Owner: Lead Investigator / HR</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3722_Assoc9" sourceRef="W3722_Annotation8" targetRef="W3722_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3722_Flow10" sourceRef="W3722_Start3" targetRef="W3722_Task4" />
      <bpmn:sequenceFlow id="W3722_Flow11" sourceRef="W3722_Task4" targetRef="W3722_Task5" />
      <bpmn:sequenceFlow id="W3722_Flow12" sourceRef="W3722_Task5" targetRef="W3722_Task6" />
      <bpmn:sequenceFlow id="W3722_Flow13" sourceRef="W3722_Task6" targetRef="W3722_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3722_diag">
      <bpmndi:BPMNPlane id="W3722_plane" bpmnElement="W_W3722">
        <bpmndi:BPMNShape id="W3722_Lane1_di" bpmnElement="W3722_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3722_Task4_di" bpmnElement="W3722_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
