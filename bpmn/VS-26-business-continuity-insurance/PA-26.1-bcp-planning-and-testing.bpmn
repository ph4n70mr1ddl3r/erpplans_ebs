    <bpmn:process id="W_W853" name="W853. Business Continuity Plan Tabletop Exercise &amp; Drill Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled — annual full exercise; semi-annual tabletop; quarterly IT DR test
Frequency: 1 full exercise/year, 2 tabletops/year, 4 IT DR tests/year
Volume: 1 full exercise involving 10–20 key personnel; 2 tabletops involving 8–12 participants each; 4 IT DR tests involving IT team
Owner: BC Manager
Participants: Executive Committee, CIO, COO, CHRO, CFO, VP Supply Chain, LP Director, Store Manager representatives
Source: workflow W853 — Business Continuity Plan Tabletop Exercise &amp; Drill Execution</bpmn:documentation>
      <bpmn:laneSet id="W853_LaneSet2">
        <bpmn:lane id="W853_Lane1" name="BC Manager">
        <bpmn:flowNodeRef>W853_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W853_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W853_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W853_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W853_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W853_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W853_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W853_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W853_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W853_Start3" name="Scheduled — annual full exercise; semi-annual tabletop; quarterly IT DR test">
        <bpmn:outgoing>W853_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W853_Task4" name="Design exercise scenario — based on realistic threat (typhoon Signal No. 4…">
        <bpmn:documentation>Step 1: Design exercise scenario — based on realistic threat (typhoon Signal No. 4 hitting Visayas, 7.2 magnitude earthquake in Mindanao, ransomware attack on ERP, or pandemic resurgence); define inject points and expected responses
Responsible (R): BC Manager
Accountable (A): COO
Duration: 8 hours</bpmn:documentation>
        <bpmn:incoming>W853_Flow14</bpmn:incoming>
        <bpmn:outgoing>W853_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W853_Task5" name="Prepare exercise materials — scenario briefing document, inject cards…">
        <bpmn:documentation>Step 2: Prepare exercise materials — scenario briefing document, inject cards (escalating events), evaluation rubric, participant roles, and communication simulation plan
Responsible (R): BC Manager
Accountable (A): COO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W853_Flow15</bpmn:incoming>
        <bpmn:outgoing>W853_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W853_Task6" name="Conduct tabletop exercise — walk through scenario with Executive Committee and…">
        <bpmn:documentation>Step 3: Conduct tabletop exercise — walk through scenario with Executive Committee and department heads; discuss decision points, communication protocols, resource allocation, and escalation procedures
Responsible (R): BC Manager
Accountable (A): CEO
Duration: 3–4 hours</bpmn:documentation>
        <bpmn:incoming>W853_Flow16</bpmn:incoming>
        <bpmn:outgoing>W853_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W853_Task7" name="For full exercise: simulate operational response — activate communication tree…">
        <bpmn:documentation>Step 4: For full exercise: simulate operational response — activate communication tree (simulated), conduct mock store closure/reopening at 2 volunteer stores, test IT DR failover, and simulate supply chain rerouting
Responsible (R): BC Manager
Accountable (A): COO
Duration: 1 full day</bpmn:documentation>
        <bpmn:incoming>W853_Flow17</bpmn:incoming>
        <bpmn:outgoing>W853_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W853_Task8" name="Evaluate exercise performance — assess decision speed, communication…">
        <bpmn:documentation>Step 5: Evaluate exercise performance — assess decision speed, communication effectiveness, plan adequacy, resource availability, and interdepartmental coordination
Responsible (R): BC Manager
Accountable (A): COO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W853_Flow18</bpmn:incoming>
        <bpmn:outgoing>W853_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W853_Task9" name="Document findings and recommendations — identify plan gaps, training needs…">
        <bpmn:documentation>Step 6: Document findings and recommendations — identify plan gaps, training needs, resource shortfalls, and system improvements; assign corrective action owners and deadlines
Responsible (R): BC Manager
Accountable (A): COO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W853_Flow19</bpmn:incoming>
        <bpmn:outgoing>W853_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W853_Task10" name="Track corrective action completion — follow up on all identified improvements…">
        <bpmn:documentation>Step 7: Track corrective action completion — follow up on all identified improvements; verify implementation before next exercise cycle
Responsible (R): BC Manager
Accountable (A): COO
Duration: Ongoing (quarterly review)</bpmn:documentation>
        <bpmn:incoming>W853_Flow20</bpmn:incoming>
        <bpmn:outgoing>W853_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W853_End11" name="Complete">
        <bpmn:incoming>W853_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W853_Annotation12">
        <bpmn:text>Controls: - CTL-228 (ensure BCP readiness &amp; insurance recovery.) | - operational: standard operating procedures; system-enforced validation rules
Owner: BC Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W853_Assoc13" sourceRef="W853_Annotation12" targetRef="W853_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W853_Flow14" sourceRef="W853_Start3" targetRef="W853_Task4" />
      <bpmn:sequenceFlow id="W853_Flow15" sourceRef="W853_Task4" targetRef="W853_Task5" />
      <bpmn:sequenceFlow id="W853_Flow16" sourceRef="W853_Task5" targetRef="W853_Task6" />
