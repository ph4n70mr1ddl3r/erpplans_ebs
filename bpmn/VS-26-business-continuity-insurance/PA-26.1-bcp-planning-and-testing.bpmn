      <bpmn:sequenceFlow id="W1204_Flow18" sourceRef="W1204_Task8" targetRef="W1204_Task9" />
      <bpmn:sequenceFlow id="W1204_Flow19" sourceRef="W1204_Task9" targetRef="W1204_Task10" />
      <bpmn:sequenceFlow id="W1204_Flow20" sourceRef="W1204_Task10" targetRef="W1204_End11" />
    </bpmn:process>
