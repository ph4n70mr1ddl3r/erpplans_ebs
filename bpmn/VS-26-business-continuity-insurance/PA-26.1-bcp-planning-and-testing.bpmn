      <bpmn:sequenceFlow id="W853_Flow18" sourceRef="W853_Task7" targetRef="W853_Task8" />
      <bpmn:sequenceFlow id="W853_Flow19" sourceRef="W853_Task8" targetRef="W853_Task9" />
      <bpmn:sequenceFlow id="W853_Flow20" sourceRef="W853_Task9" targetRef="W853_Task10" />
      <bpmn:sequenceFlow id="W853_Flow21" sourceRef="W853_Task10" targetRef="W853_End11" />
    </bpmn:process>
