    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1323" name="W1323. Supply Chain Disruption Simulation &amp; Alternate Sourcing Activation Drill" isExecutable="false">
      <bpmn:documentation>Trigger: Annual BCP testing cycle (aligned with W847/W853); or triggered by actual near-miss disruption event (port congestion, supplier bankruptcy, typhoon-induced logistics failure)
Frequency: Annual full simulation; semi-annual tabletop scenario for supply chain team
Volume: 1 full simulation + 1 tabletop per year
Owner: Supply Planning Manager
Participants: Supply Planning Manager, Category Managers (5), Buyers (10 per §13.1), DC Supervisors (4), Logistics Manager, VP Merchandising, COO, Procurement Manager
Source: workflow W1323 — Supply Chain Disruption Simulation &amp; Alternate Sourcing Activation Drill</bpmn:documentation>
      <bpmn:laneSet id="W1323_LaneSet6">
        <bpmn:lane id="W1323_Lane1" name="Supply Planning Manager">
        <bpmn:flowNodeRef>W1323_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1323_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1323_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1323_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1323_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1323_Lane2" name="Buyers">
        <bpmn:flowNodeRef>W1323_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1323_Lane3" name="Logistics Manager">
        <bpmn:flowNodeRef>W1323_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1323_Lane4" name="Marketing">
        <bpmn:flowNodeRef>W1323_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1323_Lane5" name="Finance">
        <bpmn:flowNodeRef>W1323_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1323_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1323_Start7" name="Annual BCP testing cycle (aligned with W847/W853); or triggered by actual near-miss…">
        <bpmn:outgoing>W1323_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1323_Task8" name="Scenario design">
        <bpmn:documentation>Step 1: Scenario design: Supply Planning Manager designs simulation scenario based on realistic Philippine supply chain risks: (a) Scenario A — Port congestion: Manila port congested for 30 days (as occurred in 2014, 2018); import containers delayed; DC3 (Laguna) and DC4 (Clark) unable to receive import shipments; (b) Scenario B — Primary vendor failure: top vendor (accounting for 8% of COGS) suddenly ceases operations due to factory fire or financial collapse; 300+ SKUs affected; (c) Scenario C — Typhoon logistics disruption: Signal No. 5 typhoon closes Visayas ports for 7 days; DC2 (Cebu) unable to receive or dispatch; 40 Visayas stores cut off from supply; (d) Scenario D — Raw material shortage: global cement or steel shortage causes 30% price increase and 50% availability reduction for key construction materials; scenario selected annually by rotation; Supply Planning Manager prepares inject cards with escalating developments over simulated 30-day period
Responsible (R): Supply Planning Manager
Accountable (A): VP Merchandising
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W1323_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1323_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1323_Task9" name="Simulation kickoff">
        <bpmn:documentation>Step 2: Simulation kickoff: Supply Planning Manager briefs participants: (a) presents initial scenario inject (e.g., &quot;Day 1: News reports Manila port congestion; 200 BuildRight containers stuck at anchorage; ETA unknown&quot;); (b) participants organized by function: Merchandising/Buying (sourcing), Supply Planning (allocation), Logistics (rerouting), DC Operations (receiving/dispatch), Finance (cost impact); (c) each function has access to their normal ERP data and tools; (d) simulation runs in real-time compressed format: each simulated &quot;day&quot; = 30 minutes of real time; total simulation: 15 simulated days in ~8 hours
Responsible (R): Supply Planning Manager
Accountable (A): COO
Duration: 30 min briefing</bpmn:documentation>
        <bpmn:incoming>W1323_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1323_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1323_Task10" name="Alternate vendor activation drill">
        <bpmn:documentation>Step 3: Alternate vendor activation drill: Buyers must identify and activate alternate vendors for affected categories: (a) search vendor master for pre-qualified alternate vendors per W224; (b) contact alternate vendors for emergency pricing and availability (simulated via role-play or scripted responses); (c) Buyers who have maintained vendor relationships per W36 get faster response times; (d) Category Manager approves alternate vendor selection based on price, quality, and lead time tradeoffs; (e) Procurement issues emergency POs per W60 expedited order process; (f) Finance confirms budget authorization per W489 for emergency procurement above normal thresholds
Responsible (R): Buyers / Category Manager / Procurement
Accountable (A): VP Merchandising
Duration: 2–3 simulated days</bpmn:documentation>
        <bpmn:incoming>W1323_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1323_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1323_Task11" name="Logistics rerouting drill">
        <bpmn:documentation>Step 4: Logistics rerouting drill: Logistics Manager must reroute shipments around disrupted nodes: (a) if port congested: identify alternate ports (Subic, Batangas) and arrange drayage to DCs; (b) if DC inaccessible: redirect shipments to alternate DC and plan inter-DC transfer per W22; (c) if inter-island routes closed: assess air freight for critical items; evaluate inventory redistribution from unaffected stores; (d) coordinate with 3PL carriers per W1207 for capacity; (e) Logistics Manager documents rerouting decisions and estimated cost impact vs. normal logistics cost
Responsible (R): Logistics Manager
Accountable (A): COO
Duration: 3–4 simulated days</bpmn:documentation>
        <bpmn:incoming>W1323_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1323_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1323_Task12" name="Store allocation prioritization">
        <bpmn:documentation>Step 5: Store allocation prioritization: Supply Planning Manager must allocate limited inventory across 200 stores: (a) identify stores with lowest weeks-of-supply in affected categories; (b) prioritize: (i) high-volume flagship stores, (ii) stores with active B2B project commitments (W58), (iii) stores in high-competition trade areas where stock-outs drive customer defection; (c) activate store-to-store transfers per W22 for stores with excess inventory in affected categories; (d) communicate allocation decisions to Regional Managers; (e) adjust replenishment parameters per W31 to stretch available inventory
Responsible (R): Supply Planning Manager
Accountable (A): VP Merchandising
Duration: 3–4 simulated days</bpmn:documentation>
        <bpmn:incoming>W1323_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1323_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1323_Task13" name="Customer communication coordination">
        <bpmn:documentation>Step 6: Customer communication coordination: Marketing and Store Operations coordinate customer messaging: (a) update ecommerce inventory availability to reflect real-time constraints; (b) prepare store signage for affected categories (&quot;Temporarily unavailable — arriving [date]&quot;); (c) enable substitution suggestions per W279 for out-of-stock items; (d) B2B Sales Manager contacts affected trade account customers with revised delivery timelines; (e) Customer Service updated with FAQ script for availability inquiries
Responsible (R): Marketing / Store Ops / B2B Sales
Accountable (A): VP Merchandising
Duration: 2 simulated days</bpmn:documentation>
        <bpmn:incoming>W1323_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1323_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1323_Task14" name="Financial impact assessment">
        <bpmn:documentation>Step 7: Financial impact assessment: Finance tracks simulated financial impact: (a) lost revenue from stock-outs (estimated); (b) incremental logistics cost from rerouting; (c) incremental procurement cost from alternate vendors (price premiums, expedited shipping); (d) margin impact by category; (e) Finance provides cost-benefit analysis to COO for decision support
Responsible (R): Finance / CFO
Accountable (A): —
Duration: Continuous during simulation</bpmn:documentation>
        <bpmn:incoming>W1323_Flow25</bpmn:incoming>
        <bpmn:outgoing>W1323_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1323_Task15" name="Simulation debrief &amp; lessons learned">
        <bpmn:documentation>Step 8: Simulation debrief &amp; lessons learned: After simulation: (a) Supply Planning Manager facilitates debrief: (i) what worked well — pre-qualified alternate vendors, clear escalation protocols, rapid logistics rerouting; (ii) what needs improvement — vendor contact information outdated, DC capacity insufficient for rerouted volume, store allocation prioritization criteria unclear; (b) each function documents their top 3 lessons learned and recommended improvements; (c) Supply Planning Manager compiles simulation report with findings and corrective action plan; (d) corrective actions tracked to completion before next simulation; (e) findings integrated into BCP per W847 and communicated to BC Manager
Responsible (R): Supply Planning Manager / All Participants
Accountable (A): COO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W1323_Flow26</bpmn:incoming>
        <bpmn:outgoing>W1323_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1323_End16" name="Complete">
        <bpmn:incoming>W1323_Flow27</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1323_Annotation17">
        <bpmn:text>Controls: - CTL-319 (ensure controlled execution — BCP Planning &amp; Testing (PA-26.1).) | - operational: scheduling on designated BCP testing days per W853 calendar; operational: role-play realism and scripted vendor responses reflecting realistic negotiation timelines; operational: structured decision-making process and function-specific decision authority
Owner: Supply Planning Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1323_Assoc18" sourceRef="W1323_Annotation17" targetRef="W1323_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W1323_Flow19" sourceRef="W1323_Start7" targetRef="W1323_Task8" />
      <bpmn:sequenceFlow id="W1323_Flow20" sourceRef="W1323_Task8" targetRef="W1323_Task9" />
      <bpmn:sequenceFlow id="W1323_Flow21" sourceRef="W1323_Task9" targetRef="W1323_Task10" />
      <bpmn:sequenceFlow id="W1323_Flow22" sourceRef="W1323_Task10" targetRef="W1323_Task11" />
      <bpmn:sequenceFlow id="W1323_Flow23" sourceRef="W1323_Task11" targetRef="W1323_Task12" />
      <bpmn:sequenceFlow id="W1323_Flow24" sourceRef="W1323_Task12" targetRef="W1323_Task13" />
      <bpmn:sequenceFlow id="W1323_Flow25" sourceRef="W1323_Task13" targetRef="W1323_Task14" />
      <bpmn:sequenceFlow id="W1323_Flow26" sourceRef="W1323_Task14" targetRef="W1323_Task15" />
      <bpmn:sequenceFlow id="W1323_Flow27" sourceRef="W1323_Task15" targetRef="W1323_End16" />
    </bpmn:process>
