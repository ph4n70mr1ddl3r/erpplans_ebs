<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-26.1-bcp-planning-and-testing" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W847" name="W847. Business Continuity Plan Annual Review &amp; Update" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled — annual (Q1 each year); or ad-hoc triggered by material organizational change (new store format, DC addition, IT platform migration)
Frequency: Annual formal review; quarterly interim updates for material changes
Volume: 1 comprehensive plan revision per year covering all 205 locations (200 stores + 4 DCs + HQ per W1204)
Owner: Business Continuity Manager / COO
Participants: CIO, CFO, CHRO, VP Supply Chain, LP Director, Legal Counsel, Department Heads
Source: workflow W847 — Business Continuity Plan Annual Review &amp; Update</bpmn:documentation>
      <bpmn:laneSet id="W847_LaneSet4">
        <bpmn:lane id="W847_Lane1" name="BC Manager">
        <bpmn:flowNodeRef>W847_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W847_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W847_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W847_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W847_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W847_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W847_Lane2" name="CIO">
        <bpmn:flowNodeRef>W847_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W847_Lane3" name="CHRO">
        <bpmn:flowNodeRef>W847_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W847_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W847_Start5" name="Scheduled — annual (Q1 each year); or ad-hoc triggered by material organizational change…">
        <bpmn:outgoing>W847_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W847_Task6" name="Distribute BCP self-assessment questionnaire to all department heads — assess…">
        <bpmn:documentation>Step 1: Distribute BCP self-assessment questionnaire to all department heads — assess current recovery capabilities, identify new single points of failure, validate RTO/RPO targets, and confirm contact lists
Responsible (R): BC Manager
Accountable (A): COO
Duration: 1 week (elapsed)</bpmn:documentation>
        <bpmn:incoming>W847_Flow16</bpmn:incoming>
        <bpmn:outgoing>W847_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W847_Task7" name="Conduct business impact analysis (BIA) update — reassess critical business…">
        <bpmn:documentation>Step 2: Conduct business impact analysis (BIA) update — reassess critical business processes, maximum tolerable downtime, financial impact per hour of outage, and interdependency map for all 5 legal entities
Responsible (R): BC Manager
Accountable (A): COO
Duration: 2 weeks (elapsed)</bpmn:documentation>
        <bpmn:incoming>W847_Flow17</bpmn:incoming>
        <bpmn:outgoing>W847_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W847_Task8" name="Review and update IT disaster recovery plan — verify DR site readiness (Clark…">
        <bpmn:documentation>Step 3: Review and update IT disaster recovery plan — verify DR site readiness (Clark DC for Luzon, Cebu DC for Visayas, Davao DC for Mindanao), test data replication integrity, update system inventory and recovery sequences
Responsible (R): CIO
Accountable (A): COO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W847_Flow18</bpmn:incoming>
        <bpmn:outgoing>W847_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W847_Task9" name="Update store emergency response procedures — incorporate lessons from prior…">
        <bpmn:documentation>Step 4: Update store emergency response procedures — incorporate lessons from prior year incidents, update emergency contact directories (PNP, BFP, Red Cross, LGU), verify emergency supply stock levels
Responsible (R): BC Manager
Accountable (A): COO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W847_Flow19</bpmn:incoming>
        <bpmn:outgoing>W847_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W847_Task10" name="Validate communication tree — update all-staff contact database, test SMS blast…">
        <bpmn:documentation>Step 5: Validate communication tree — update all-staff contact database, test SMS blast system, verify satellite phone inventory for areas with unreliable cellular coverage
Responsible (R): CHRO
Accountable (A): COO
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W847_Flow20</bpmn:incoming>
        <bpmn:outgoing>W847_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W847_Task11" name="Present updated BCP to Executive Committee for approval — key changes, cost…">
        <bpmn:documentation>Step 6: Present updated BCP to Executive Committee for approval — key changes, cost implications, identified gaps, and investment recommendations
Responsible (R): BC Manager
Accountable (A): CEO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W847_Flow21</bpmn:incoming>
        <bpmn:outgoing>W847_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W847_Task12" name="Distribute updated BCP materials — digital copies to all Store Managers…">
        <bpmn:documentation>Step 7: Distribute updated BCP materials — digital copies to all Store Managers, physical emergency binders to all 200 stores and 4 DCs, and updated intranet portal
Responsible (R): BC Manager
Accountable (A): COO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W847_Flow22</bpmn:incoming>
        <bpmn:outgoing>W847_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W847_End13" name="Complete">
        <bpmn:incoming>W847_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W847_Annotation14">
        <bpmn:text>Controls: - CTL-319 (ensure controlled execution — BCP Planning &amp; Testing (PA-26.1).) | - operational: Business Continuity Manager / COO review and approval gate
Owner: Business Continuity Manager / COO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W847_Assoc15" sourceRef="W847_Annotation14" targetRef="W847_Start5" associationDirection="None" />
