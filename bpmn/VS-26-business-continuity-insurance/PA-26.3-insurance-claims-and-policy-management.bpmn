    <bpmn:process id="W_W861" name="W861. Employee Injury Insurance Claim Coordination &amp; SSS/ECC Filing" isExecutable="false">
      <bpmn:documentation>Trigger: Workplace injury or occupational illness affecting any BuildRight employee; triggered by HSE incident report
Frequency: Estimated 100–150 reportable injuries per year across 6,911 employees
Volume: ~30–50 claims filed with SSS/ECC per year (lost-time injuries); minor injuries treated on-site without claim
Owner: HR Manager / Insurance Coordinator
Participants: Injured Employee, Store Manager, HR Manager, Insurance Coordinator, Company Nurse, SSS Representative, DOLE (for serious incidents)
Source: workflow W861 — Employee Injury Insurance Claim Coordination &amp; SSS/ECC Filing</bpmn:documentation>
      <bpmn:laneSet id="W861_LaneSet5">
        <bpmn:lane id="W861_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W861_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W861_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W861_Lane2" name="HR Manager">
        <bpmn:flowNodeRef>W861_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W861_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W861_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W861_Lane3" name="Company Nurse">
        <bpmn:flowNodeRef>W861_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W861_Lane4" name="HR Benefits Specialist">
        <bpmn:flowNodeRef>W861_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W861_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W861_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W861_Start6" name="Workplace injury or occupational illness affecting any BuildRight employee; triggered by…">
        <bpmn:outgoing>W861_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W861_Task7" name="Injury incident documentation — Store Manager completes incident report within…">
        <bpmn:documentation>Step 1: Injury incident documentation — Store Manager completes incident report within 24 hours: nature of injury, body part, cause, witness statements, first aid administered, and medical referral if needed
Responsible (R): Store Manager
Accountable (A): HR Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W861_Flow17</bpmn:incoming>
        <bpmn:outgoing>W861_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W861_Task8" name="Determine reportability — HR Manager classifies as: (a) first aid only (no…">
        <bpmn:documentation>Step 2: Determine reportability — HR Manager classifies as: (a) first aid only (no claim), (b) medical treatment (clinic/hospital visit, possible claim), (c) lost-time injury (claim required), (d) serious incident (DOLE notification required within 24 hours per DO 252-25 (revised IRR of RA 11058, superseding DO 198-18))
Responsible (R): HR Manager
Accountable (A): CHRO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W861_Flow18</bpmn:incoming>
        <bpmn:outgoing>W861_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W861_Task9" name="Facilitate medical treatment — arrange company-designated physician evaluation…">
        <bpmn:documentation>Step 3: Facilitate medical treatment — arrange company-designated physician evaluation; ensure Employee&#x27;s Compensation (SSS/ECC) medical requirements are met from initial visit; document all treatment and costs
Responsible (R): Company Nurse
Accountable (A): HR Manager
Duration: Variable (same day)</bpmn:documentation>
        <bpmn:incoming>W861_Flow19</bpmn:incoming>
        <bpmn:outgoing>W861_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W861_Task10" name="File SSS sickness/injury notification — submit the SSS Sickness Notification…">
        <bpmn:documentation>Step 4: File SSS sickness/injury notification — submit the SSS Sickness Notification Form (SIC-01252) within the employer deadline; for EC claims, submit the SSS EC report forms (e.g., B-309 accident/sickness report) with medical certificates
Responsible (R): HR Benefits Specialist
Accountable (A): HR Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W861_Flow20</bpmn:incoming>
        <bpmn:outgoing>W861_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W861_Task11" name="Track employee recovery and return-to-work — monitor medical status, coordinate…">
        <bpmn:documentation>Step 5: Track employee recovery and return-to-work — monitor medical status, coordinate with HSE (W805) for return-to-work assessment, arrange light duty if applicable, and maintain contact with employee during absence
Responsible (R): HR Manager
Accountable (A): Store Manager
Duration: Ongoing (1–12 weeks)</bpmn:documentation>
        <bpmn:incoming>W861_Flow21</bpmn:incoming>
        <bpmn:outgoing>W861_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W861_Task12" name="Process SSS/ECC benefit reimbursement — upon claim approval, verify benefit…">
        <bpmn:documentation>Step 6: Process SSS/ECC benefit reimbursement — upon claim approval, verify benefit amount, coordinate with payroll for salary differential (if company pays above SSS benefit), and record in HR system
Responsible (R): HR Benefits Specialist
Accountable (A): Finance Controller
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W861_Flow22</bpmn:incoming>
        <bpmn:outgoing>W861_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W861_Task13" name="Claim closure and record update — close incident file, update OSH (Occupational…">
        <bpmn:documentation>Step 7: Claim closure and record update — close incident file, update OSH (Occupational Safety and Health) log, contribute to annual HSE statistics, and identify preventive measures
Responsible (R): HR Manager
Accountable (A): HSE Officer
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W861_Flow23</bpmn:incoming>
        <bpmn:outgoing>W861_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W861_End14" name="Complete">
        <bpmn:incoming>W861_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W861_Annotation15">
        <bpmn:text>Controls: - CTL-321 (ensure controlled execution — Insurance Claims &amp; Policy Management (PA-26.3).) | - operational: HR Manager / Insurance Coordinator review and approval gate
Owner: HR Manager / Insurance Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W861_Assoc16" sourceRef="W861_Annotation15" targetRef="W861_Start6" associationDirection="None" />
