        <bpmndi:BPMNEdge id="W864_Flow17_di" bpmnElement="W864_Flow17"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W864_Flow18_di" bpmnElement="W864_Flow18"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
