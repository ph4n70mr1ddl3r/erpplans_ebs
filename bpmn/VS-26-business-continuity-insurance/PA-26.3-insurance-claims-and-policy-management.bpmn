    <bpmn:process id="W_W859" name="W859. Vehicle &amp; Fleet Insurance Claim Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Vehicle accident, theft, or damage involving company-owned fleet vehicles (delivery trucks, service vehicles, management vehicles)
Frequency: Estimated 20–30 vehicle claims per year for the owned fleet of ~40 delivery trucks (plus a small service/management vehicle pool)
Volume: Average claim value: PHP 50,000–300,000 (repair); total loss: PHP 500,000–3,000,000
Owner: Fleet Manager / Insurance Coordinator
Participants: Driver, Fleet Manager, Insurance Coordinator, Finance Controller, External Repair Shop, LTO (Land Transportation Office)
Source: workflow W859 — Vehicle &amp; Fleet Insurance Claim Processing</bpmn:documentation>
      <bpmn:laneSet id="W859_LaneSet5">
        <bpmn:lane id="W859_Lane1" name="Driver">
        <bpmn:flowNodeRef>W859_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W859_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W859_Lane2" name="Fleet Manager">
        <bpmn:flowNodeRef>W859_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W859_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W859_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W859_Lane3" name="Insurance Coordinator">
        <bpmn:flowNodeRef>W859_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W859_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W859_Lane4" name="Finance Controller">
        <bpmn:flowNodeRef>W859_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W859_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W859_Start6" name="Vehicle accident, theft, or damage involving company-owned fleet vehicles (delivery…">
        <bpmn:outgoing>W859_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W859_Task7" name="Incident report — driver reports vehicle incident to Fleet Manager within 4…">
        <bpmn:documentation>Step 1: Incident report — driver reports vehicle incident to Fleet Manager within 4 hours; include police report (if third-party involved), photos of damage, location, and circumstances
Responsible (R): Driver
Accountable (A): Fleet Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W859_Flow17</bpmn:incoming>
        <bpmn:outgoing>W859_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W859_Task8" name="Vehicle assessment — Fleet Manager arranges vehicle inspection at authorized…">
        <bpmn:documentation>Step 2: Vehicle assessment — Fleet Manager arranges vehicle inspection at authorized repair shop; obtain repair estimate; classify as repairable or total loss
Responsible (R): Fleet Manager
Accountable (A): Insurance Coordinator
Duration: 1–3 days (elapsed)</bpmn:documentation>
        <bpmn:incoming>W859_Flow18</bpmn:incoming>
        <bpmn:outgoing>W859_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W859_Task9" name="Submit insurance claim — complete vehicle claim form with: (a) police report or…">
        <bpmn:documentation>Step 3: Submit insurance claim — complete vehicle claim form with: (a) police report or barangay blotter, (b) driver&#x27;s license and vehicle registration, (c) repair estimate or total loss valuation, (d) photos, (e) third-party information (if applicable)
Responsible (R): Insurance Coordinator
Accountable (A): Fleet Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W859_Flow19</bpmn:incoming>
        <bpmn:outgoing>W859_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W859_Task10" name="Coordinate repair authorization — insurer approves repair scope and cost; Fleet…">
        <bpmn:documentation>Step 4: Coordinate repair authorization — insurer approves repair scope and cost; Fleet Manager authorizes repair shop to proceed; arrange replacement vehicle if needed for delivery schedule
Responsible (R): Fleet Manager
Accountable (A): Insurance Coordinator
Duration: 3–5 days (elapsed)</bpmn:documentation>
        <bpmn:incoming>W859_Flow20</bpmn:incoming>
        <bpmn:outgoing>W859_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W859_Task11" name="Third-party liability handling — if company vehicle at fault, coordinate with…">
        <bpmn:documentation>Step 5: Third-party liability handling — if company vehicle at fault, coordinate with insurer for third-party claim settlement; if third-party at fault, pursue recovery through their insurer
Responsible (R): Insurance Coordinator
Accountable (A): Legal Counsel
Duration: Variable (2–12 weeks)</bpmn:documentation>
        <bpmn:incoming>W859_Flow21</bpmn:incoming>
        <bpmn:outgoing>W859_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W859_Task12" name="Process claim settlement — record insurance recovery, post repair expense, and…">
        <bpmn:documentation>Step 6: Process claim settlement — record insurance recovery, post repair expense, and close claim file; update vehicle asset record
Responsible (R): Finance Controller
Accountable (A): Insurance Coordinator
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W859_Flow22</bpmn:incoming>
        <bpmn:outgoing>W859_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W859_Task13" name="Driver incident review — Fleet Manager reviews incident with driver; determine…">
        <bpmn:documentation>Step 7: Driver incident review — Fleet Manager reviews incident with driver; determine preventability; if preventable, apply Fleet safety program consequence (retraining, warning, or suspension)
Responsible (R): Fleet Manager
Accountable (A): VP Supply Chain
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W859_Flow23</bpmn:incoming>
        <bpmn:outgoing>W859_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W859_End14" name="Complete">
        <bpmn:incoming>W859_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W859_Annotation15">
        <bpmn:text>Controls: - CTL-321 (ensure controlled execution — Insurance Claims &amp; Policy Management (PA-26.3).) | - operational: Fleet Manager / Insurance Coordinator review and approval gate; claim register reconciled monthly
Owner: Fleet Manager / Insurance Coordinator</bpmn:text>
      </bpmn:textAnnotation>
