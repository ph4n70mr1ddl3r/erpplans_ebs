    <bpmn:process id="W_W864" name="W864. Insurance Claim Recovery, Settlement &amp; Accounting Entry" isExecutable="false">
      <bpmn:documentation>Trigger: Insurance claim settlement received from insurer; or final claim denial
Frequency: 40–60 settlement events per year across all claim types
Volume: Average settlement: PHP 50,000–500,000; catastrophic: PHP 5–50 million
Owner: Finance Controller
Participants: Insurance Coordinator, CFO, External Auditor (for material settlements)
Source: workflow W864 — Insurance Claim Recovery, Settlement &amp; Accounting Entry</bpmn:documentation>
      <bpmn:laneSet id="W864_LaneSet3">
        <bpmn:lane id="W864_Lane1" name="Insurance Coordinator">
        <bpmn:flowNodeRef>W864_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W864_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W864_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W864_Lane2" name="Finance Controller">
        <bpmn:flowNodeRef>W864_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W864_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W864_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W864_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W864_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W864_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W864_Start4" name="Insurance claim settlement received from insurer; or final claim denial">
        <bpmn:outgoing>W864_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W864_Task5" name="Receive settlement offer — Insurance Coordinator receives insurer&#x27;s settlement…">
        <bpmn:documentation>Step 1: Receive settlement offer — Insurance Coordinator receives insurer&#x27;s settlement offer letter; review against claim amount for acceptance or dispute
Responsible (R): Insurance Coordinator
Accountable (A): Finance Controller
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W864_Flow15</bpmn:incoming>
        <bpmn:outgoing>W864_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W864_Task6" name="Verify settlement calculation — Finance Controller reconciles: (a) claim amount…">
        <bpmn:documentation>Step 2: Verify settlement calculation — Finance Controller reconciles: (a) claim amount vs. offer, (b) deductible application, (c) co-insurance adjustment, (d) underinsurance penalty (average clause), (e) salvage credit (if applicable); calculate net recovery
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W864_Flow16</bpmn:incoming>
        <bpmn:outgoing>W864_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W864_Task7" name="Approve settlement — for amounts &lt; PHP 500,000: Finance Controller approves…">
        <bpmn:documentation>Step 3: Approve settlement — for amounts &lt; PHP 500,000: Finance Controller approves; PHP 500,000–5,000,000: CFO approves; &gt; PHP 5,000,000: CEO/CFO approves
Responsible (R): Finance Controller
Accountable (A): CFO / CEO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W864_Flow17</bpmn:incoming>
        <bpmn:outgoing>W864_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W864_Task8" name="Process settlement payment — record insurance recovery in GL: debit cash/bank…">
        <bpmn:documentation>Step 4: Process settlement payment — record insurance recovery in GL: debit cash/bank, credit insurance recovery (other income) or receivable; offset against original loss entry; process any deductible write-off
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W864_Flow18</bpmn:incoming>
        <bpmn:outgoing>W864_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W864_Task9" name="Reconcile claim file — ensure total claim costs (repairs, replacements, lost…">
        <bpmn:documentation>Step 5: Reconcile claim file — ensure total claim costs (repairs, replacements, lost inventory) equal insurance recovery + deductible + unrecovered balance; post unrecovered balance to appropriate expense account
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W864_Flow19</bpmn:incoming>
        <bpmn:outgoing>W864_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W864_Task10" name="Close claim file — update insurance register, archive claim documentation per…">
        <bpmn:documentation>Step 6: Close claim file — update insurance register, archive claim documentation per retention policy (10 years for BIR), and update claims history database for actuarial analysis
Responsible (R): Insurance Coordinator
Accountable (A): Finance Controller
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W864_Flow20</bpmn:incoming>
        <bpmn:outgoing>W864_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W864_Task11" name="Report to management — include settlement results in monthly finance report…">
        <bpmn:documentation>Step 7: Report to management — include settlement results in monthly finance report; flag unrecovered amounts; provide input for annual insurance renewal negotiation (W862)
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W864_Flow21</bpmn:incoming>
        <bpmn:outgoing>W864_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W864_End12" name="Complete">
        <bpmn:incoming>W864_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W864_Annotation13">
        <bpmn:text>Controls: - CTL-228 (ensure BCP readiness &amp; insurance recovery.) | - operational: Finance Controller review and approval gate; operational: periodic reconciliation against source documents
Owner: Finance Controller</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W864_Assoc14" sourceRef="W864_Annotation13" targetRef="W864_Start4" associationDirection="None" />
