    <bpmn:process id="W_W860" name="W860. Business Interruption Insurance Claim &amp; Loss Documentation" isExecutable="false">
      <bpmn:documentation>Trigger: Store or DC closure exceeding 72 consecutive hours due to insured peril; typically triggered alongside W858 (catastrophic property claim)
Frequency: Estimated 3–5 business interruption claims per year
Volume: Average claim: PHP 500,000–5,000,000; catastrophic: PHP 10–50 million (multi-store closure)
Owner: Finance Controller / Insurance Coordinator
Participants: CFO, BC Manager, Store Manager, External Accountant, Insurance Broker, Loss Adjuster
Source: workflow W860 — Business Interruption Insurance Claim &amp; Loss Documentation</bpmn:documentation>
      <bpmn:laneSet id="W860_LaneSet5">
        <bpmn:lane id="W860_Lane1" name="Finance Analyst">
        <bpmn:flowNodeRef>W860_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W860_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W860_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W860_Lane2" name="External Accountant">
        <bpmn:flowNodeRef>W860_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W860_Lane3" name="Insurance Coordinator">
        <bpmn:flowNodeRef>W860_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W860_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W860_Lane4" name="Finance Controller">
        <bpmn:flowNodeRef>W860_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W860_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W860_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W860_Start6" name="Store or DC closure exceeding 72 consecutive hours due to insured peril; typically…">
        <bpmn:outgoing>W860_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W860_Task7" name="Identify BI-qualifying events — track all store/DC closures exceeding 72 hours…">
        <bpmn:documentation>Step 1: Identify BI-qualifying events — track all store/DC closures exceeding 72 hours; calculate estimated daily sales loss per location using rolling 12-month average; flag for BI claim consideration
Responsible (R): Finance Analyst
Accountable (A): Finance Controller
Duration: 2 hours per event</bpmn:documentation>
        <bpmn:incoming>W860_Flow17</bpmn:incoming>
        <bpmn:outgoing>W860_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W860_Task8" name="Compile BI documentation package — (a) daily sales comparison (closure period…">
        <bpmn:documentation>Step 2: Compile BI documentation package — (a) daily sales comparison (closure period vs. same period prior year), (b) payroll expense during closure (continuing costs), (c) fixed costs (rent, utilities, depreciation), (d) mitigation actions taken (BOPIS, curbside pickup), (e) saved variable costs (reduced COGS, lower utility), (f) projected recovery period sales ramp-up curve
Responsible (R): Finance Analyst
Accountable (A): Finance Controller
Duration: 8–16 hours</bpmn:documentation>
        <bpmn:incoming>W860_Flow18</bpmn:incoming>
        <bpmn:outgoing>W860_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W860_Task9" name="Engage forensic accountant (for claims &gt; PHP 5 million) — independent…">
        <bpmn:documentation>Step 3: Engage forensic accountant (for claims &gt; PHP 5 million) — independent verification of loss calculation; adjust for trends, seasonality, and market conditions; prepare accountants&#x27; report for insurer
Responsible (R): External Accountant
Accountable (A): CFO
Duration: 1–2 weeks (elapsed)</bpmn:documentation>
        <bpmn:incoming>W860_Flow19</bpmn:incoming>
        <bpmn:outgoing>W860_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W860_Task10" name="Submit BI claim to insurer — include property claim reference (W858), detailed…">
        <bpmn:documentation>Step 4: Submit BI claim to insurer — include property claim reference (W858), detailed loss calculation, supporting financial statements, and projected recovery timeline
Responsible (R): Insurance Coordinator
Accountable (A): Finance Controller
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W860_Flow20</bpmn:incoming>
        <bpmn:outgoing>W860_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W860_Task11" name="Negotiate BI settlement — insurer reviews loss calculation methodology, may…">
        <bpmn:documentation>Step 5: Negotiate BI settlement — insurer reviews loss calculation methodology, may dispute: (a) base period selection, (b) trend adjustments, (c) saved expense calculations, (d) recovery period assumption; typically requires 2–3 rounds of negotiation
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: 4–8 weeks (elapsed)</bpmn:documentation>
        <bpmn:incoming>W860_Flow21</bpmn:incoming>
        <bpmn:outgoing>W860_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W860_Task12" name="Process BI recovery — record insurance recovery as other income; reconcile…">
        <bpmn:documentation>Step 6: Process BI recovery — record insurance recovery as other income; reconcile against actual lost profit; close BI claim file
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W860_Flow22</bpmn:incoming>
        <bpmn:outgoing>W860_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W860_Task13" name="Update BI loss history — maintain claims database for actuarial analysis at…">
        <bpmn:documentation>Step 7: Update BI loss history — maintain claims database for actuarial analysis at next policy renewal; identify patterns (geographic, seasonal) for risk management
Responsible (R): Insurance Coordinator
Accountable (A): CFO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W860_Flow23</bpmn:incoming>
        <bpmn:outgoing>W860_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W860_End14" name="Complete">
        <bpmn:incoming>W860_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W860_Annotation15">
        <bpmn:text>Controls: - CTL-228 (ensure BCP readiness &amp; insurance recovery.) | - operational: Finance Controller / Insurance Coordinator review and approval gate; operational: periodic reconciliation against source documents
Owner: Finance Controller / Insurance Coordinator</bpmn:text>
      </bpmn:textAnnotation>
