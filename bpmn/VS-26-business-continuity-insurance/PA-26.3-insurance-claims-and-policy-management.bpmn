        <bpmndi:BPMNEdge id="W862_Flow17_di" bpmnElement="W862_Flow17"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W862_Flow18_di" bpmnElement="W862_Flow18"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W862_Flow19_di" bpmnElement="W862_Flow19"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W862_Flow20_di" bpmnElement="W862_Flow20"><di:waypoint x="1420" y="165" /><di:waypoint x="1450" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W862_Flow21_di" bpmnElement="W862_Flow21"><di:waypoint x="1630" y="165" /><di:waypoint x="1660" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W862_Flow22_di" bpmnElement="W862_Flow22"><di:waypoint x="1840" y="165" /><di:waypoint x="1890" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W862_Assoc14_di" bpmnElement="W862_Assoc14"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W863" name="W863. Third-Party Liability Claim &amp; Customer Incident Insurance Response" isExecutable="false">
      <bpmn:documentation>Trigger: Customer or third-party injury/property damage on BuildRight premises; or claim/lawsuit received from third party
Frequency: Estimated 240–480 third-party incidents per year (20–40/month, per W1566); ~12–20 are formally notified to the insurer each year, of which ~5–10 become defended liability claims (per W1566)
Volume: Average claim value: PHP 20,000–200,000; major injury lawsuit: PHP 500,000–5,000,000
Owner: Insurance Coordinator / Legal Counsel
Participants: Store Manager, LP Officer, Insurance Coordinator, Legal Counsel, Insurance Broker, External Lawyer (for litigation)
Source: workflow W863 — Third-Party Liability Claim &amp; Customer Incident Insurance Response</bpmn:documentation>
      <bpmn:laneSet id="W863_LaneSet4">
        <bpmn:lane id="W863_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W863_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W863_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W863_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W863_Lane2" name="Insurance Coordinator">
        <bpmn:flowNodeRef>W863_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W863_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W863_Lane3" name="Legal Counsel">
        <bpmn:flowNodeRef>W863_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W863_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W863_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W863_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W863_Start5" name="Customer or third-party injury/property damage on BuildRight premises; or claim/lawsuit…">
        <bpmn:outgoing>W863_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W863_Task6" name="Incident documentation — Store Manager completes third-party incident report…">
        <bpmn:documentation>Step 1: Incident documentation — Store Manager completes third-party incident report within 24 hours: injured party details, incident description, witness statements, photos of scene, first aid provided, and CCTV footage preservation request
Responsible (R): Store Manager
Accountable (A): LP Manager
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W863_Flow16</bpmn:incoming>
        <bpmn:outgoing>W863_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W863_Task7" name="Notify insurer of potential claim — even if formal claim not yet filed, notify…">
        <bpmn:documentation>Step 2: Notify insurer of potential claim — even if formal claim not yet filed, notify insurer of incident for reservation of rights; include incident report, photos, and CCTV footage reference
Responsible (R): Insurance Coordinator
Accountable (A): Legal Counsel
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W863_Flow17</bpmn:incoming>
        <bpmn:outgoing>W863_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W863_Task8" name="Customer follow-up — HR or Store Manager contacts injured party within 48 hours…">
        <bpmn:documentation>Step 3: Customer follow-up — HR or Store Manager contacts injured party within 48 hours to express concern, offer assistance, and document injury progression; do NOT admit liability or make settlement offers without Legal approval
Responsible (R): Store Manager / HR
Accountable (A): Legal Counsel
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W863_Flow18</bpmn:incoming>
        <bpmn:outgoing>W863_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W863_Task9" name="Legal assessment — Legal Counsel reviews incident for liability exposure…">
        <bpmn:documentation>Step 4: Legal assessment — Legal Counsel reviews incident for liability exposure; determine defense strategy; engage external lawyer if litigation anticipated
Responsible (R): Legal Counsel
Accountable (A): Insurance Coordinator
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W863_Flow19</bpmn:incoming>
        <bpmn:outgoing>W863_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W863_Task10" name="Formal claim response — if demand letter received, Legal Counsel drafts…">
        <bpmn:documentation>Step 5: Formal claim response — if demand letter received, Legal Counsel drafts response (deny liability, offer mediation, or negotiate settlement); coordinate with insurer for settlement authority
Responsible (R): Legal Counsel
Accountable (A): CFO
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W863_Flow20</bpmn:incoming>
        <bpmn:outgoing>W863_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W863_Task11" name="Settlement or litigation — negotiate settlement within insurer&#x27;s authority…">
        <bpmn:documentation>Step 6: Settlement or litigation — negotiate settlement within insurer&#x27;s authority (typically &lt; PHP 500,000); for larger claims, defend through litigation; keep insurer informed at every stage
Responsible (R): Legal Counsel / External Lawyer
Accountable (A): CFO
Duration: Variable (1–24 months)</bpmn:documentation>
        <bpmn:incoming>W863_Flow21</bpmn:incoming>
        <bpmn:outgoing>W863_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W863_Task12" name="Claim closure — record settlement or judgment in finance module; update…">
        <bpmn:documentation>Step 7: Claim closure — record settlement or judgment in finance module; update premises safety measures to prevent recurrence; close incident file
Responsible (R): Insurance Coordinator
Accountable (A): CFO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W863_Flow22</bpmn:incoming>
        <bpmn:outgoing>W863_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W863_End13" name="Complete">
        <bpmn:incoming>W863_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W863_Annotation14">
        <bpmn:text>Controls: - CTL-321 (ensure controlled execution — Insurance Claims &amp; Policy Management (PA-26.3).) | - operational: Insurance Coordinator / Legal Counsel review and approval gate
Owner: Insurance Coordinator / Legal Counsel</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W863_Assoc15" sourceRef="W863_Annotation14" targetRef="W863_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W863_Flow16" sourceRef="W863_Start5" targetRef="W863_Task6" />
      <bpmn:sequenceFlow id="W863_Flow17" sourceRef="W863_Task6" targetRef="W863_Task7" />
      <bpmn:sequenceFlow id="W863_Flow18" sourceRef="W863_Task7" targetRef="W863_Task8" />
      <bpmn:sequenceFlow id="W863_Flow19" sourceRef="W863_Task8" targetRef="W863_Task9" />
      <bpmn:sequenceFlow id="W863_Flow20" sourceRef="W863_Task9" targetRef="W863_Task10" />
      <bpmn:sequenceFlow id="W863_Flow21" sourceRef="W863_Task10" targetRef="W863_Task11" />
      <bpmn:sequenceFlow id="W863_Flow22" sourceRef="W863_Task11" targetRef="W863_Task12" />
      <bpmn:sequenceFlow id="W863_Flow23" sourceRef="W863_Task12" targetRef="W863_End13" />
    </bpmn:process>
