        <bpmndi:BPMNShape id="W1566_Task10_di" bpmnElement="W1566_Task10"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1566_Task11_di" bpmnElement="W1566_Task11"><dc:Bounds x="1240" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1566_Task12_di" bpmnElement="W1566_Task12"><dc:Bounds x="1450" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1566_Start6_di" bpmnElement="W1566_Start6"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1566_End13_di" bpmnElement="W1566_End13"><dc:Bounds x="1680" y="657" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1566_Annotation14_di" bpmnElement="W1566_Annotation14"><dc:Bounds x="160" y="800" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1566_Flow16_di" bpmnElement="W1566_Flow16"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1566_Flow17_di" bpmnElement="W1566_Flow17"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1566_Flow18_di" bpmnElement="W1566_Flow18"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1566_Flow19_di" bpmnElement="W1566_Flow19"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
