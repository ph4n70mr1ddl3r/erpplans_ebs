    <bpmn:process id="W_W862" name="W862. Insurance Policy Annual Renewal &amp; Coverage Review" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled — annual renewal cycle (policies typically renewed annually, aligned to company fiscal year)
Frequency: Annual comprehensive review; quarterly interim adjustments for material changes
Volume: 1 annual renewal covering ~15–20 insurance policies across all 5 legal entities
Owner: Insurance Coordinator / CFO
Participants: CFO, COO, LP Director, Fleet Manager, CHRO, Insurance Broker, External Actuary
Source: workflow W862 — Insurance Policy Annual Renewal &amp; Coverage Review</bpmn:documentation>
      <bpmn:laneSet id="W862_LaneSet3">
        <bpmn:lane id="W862_Lane1" name="Insurance Coordinator">
        <bpmn:flowNodeRef>W862_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W862_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W862_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W862_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W862_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W862_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W862_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W862_Lane2" name="Insurance Broker">
        <bpmn:flowNodeRef>W862_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W862_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W862_Start4" name="Scheduled — annual renewal cycle (policies typically renewed annually, aligned to company…">
        <bpmn:outgoing>W862_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W862_Task5" name="Compile renewal data package — (a) prior year claims history (frequency…">
        <bpmn:documentation>Step 1: Compile renewal data package — (a) prior year claims history (frequency, severity, recovery rate), (b) current asset register (buildings, equipment, vehicles), (c) payroll data (for workers&#x27; comp), (d) revenue data (for BI and liability limits), (e) any new locations or operations
Responsible (R): Insurance Coordinator
Accountable (A): CFO
Duration: 8 hours</bpmn:documentation>
        <bpmn:incoming>W862_Flow15</bpmn:incoming>
        <bpmn:outgoing>W862_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W862_Task6" name="Conduct coverage gap analysis — compare current coverage against: (a) new…">
        <bpmn:documentation>Step 2: Conduct coverage gap analysis — compare current coverage against: (a) new locations opened during year, (b) new vehicle acquisitions, (c) changes in inventory values, (d) new business activities (ecommerce warehouse, installation services), (e) updated risk assessment from BC Manager
Responsible (R): Insurance Coordinator
Accountable (A): CFO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W862_Flow16</bpmn:incoming>
        <bpmn:outgoing>W862_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W862_Task7" name="Obtain competitive quotations — engage insurance broker to obtain quotes from…">
        <bpmn:documentation>Step 3: Obtain competitive quotations — engage insurance broker to obtain quotes from 3–5 insurers; compare coverage terms, premiums, deductibles, and exclusions; prepare comparison matrix
Responsible (R): Insurance Broker
Accountable (A): CFO
Duration: 2 weeks (elapsed)</bpmn:documentation>
        <bpmn:incoming>W862_Flow17</bpmn:incoming>
        <bpmn:outgoing>W862_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W862_Task8" name="Evaluate and negotiate — review quotes with CFO and LP Director; negotiate…">
        <bpmn:documentation>Step 4: Evaluate and negotiate — review quotes with CFO and LP Director; negotiate terms with preferred insurer; consider higher deductibles for premium savings on low-frequency risks
Responsible (R): Insurance Coordinator
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W862_Flow18</bpmn:incoming>
        <bpmn:outgoing>W862_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W862_Task9" name="Present renewal recommendation to CFO — summarize coverage changes, premium…">
        <bpmn:documentation>Step 5: Present renewal recommendation to CFO — summarize coverage changes, premium impact (vs. prior year), claims history analysis, and recommendation for policy selection
Responsible (R): Insurance Coordinator
Accountable (A): CFO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W862_Flow19</bpmn:incoming>
        <bpmn:outgoing>W862_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W862_Task10" name="Execute renewal — obtain CEO/CFO authorization, sign policy documents, process…">
        <bpmn:documentation>Step 6: Execute renewal — obtain CEO/CFO authorization, sign policy documents, process premium payment, distribute certificates of insurance to all locations
Responsible (R): Insurance Coordinator
Accountable (A): CFO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W862_Flow20</bpmn:incoming>
        <bpmn:outgoing>W862_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W862_Task11" name="Update insurance register — record all policy details in insurance tracking…">
        <bpmn:documentation>Step 7: Update insurance register — record all policy details in insurance tracking system; set renewal reminders; distribute policy summary to all Store Managers and DC Managers
Responsible (R): Insurance Coordinator
Accountable (A): CFO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W862_Flow21</bpmn:incoming>
        <bpmn:outgoing>W862_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W862_End12" name="Complete">
        <bpmn:incoming>W862_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W862_Annotation13">
        <bpmn:text>Controls: - CTL-321 (ensure controlled execution — Insurance Claims &amp; Policy Management (PA-26.3).) | - operational: Insurance Coordinator / CFO review and approval gate
Owner: Insurance Coordinator / CFO</bpmn:text>
      </bpmn:textAnnotation>
