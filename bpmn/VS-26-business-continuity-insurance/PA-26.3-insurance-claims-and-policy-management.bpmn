    <bpmn:process id="W_W858" name="W858. Typhoon, Flood &amp; Natural Disaster Damage Assessment &amp; Insurance Claim" isExecutable="false">
      <bpmn:documentation>Trigger: Natural disaster event (typhoon, flood, earthquake, volcanic eruption) affecting BuildRight locations; triggered by W848 post-disaster rapid assessment
Frequency: 2–3 catastrophic events per year affecting multiple locations simultaneously
Volume: Each event may generate 10–50 property claims; catastrophic event (Signal No. 4+) may affect 30–80 stores
Owner: Insurance Coordinator / BC Manager
Participants: COO, CFO, Store Managers (affected), LP Officers, External Adjuster Team, Insurance Broker, Legal Counsel, Structural Engineer
Source: workflow W858 — Typhoon, Flood &amp; Natural Disaster Damage Assessment &amp; Insurance Claim</bpmn:documentation>
      <bpmn:laneSet id="W858_LaneSet6">
        <bpmn:lane id="W858_Lane1" name="BC Manager">
        <bpmn:flowNodeRef>W858_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W858_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W858_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W858_Lane2" name="Insurance Coordinator">
        <bpmn:flowNodeRef>W858_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W858_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W858_Lane3" name="Insurance Broker">
        <bpmn:flowNodeRef>W858_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W858_Lane4" name="CFO">
        <bpmn:flowNodeRef>W858_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W858_Lane5" name="Finance Controller">
        <bpmn:flowNodeRef>W858_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W858_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W858_Start7" name="Natural disaster event (typhoon, flood, earthquake, volcanic eruption) affecting…">
        <bpmn:outgoing>W858_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W858_Task8" name="Aggregate damage reports from all affected stores — compile W848 rapid…">
        <bpmn:documentation>Step 1: Aggregate damage reports from all affected stores — compile W848 rapid assessment results into consolidated damage register; categorize by severity (minor: operational within 24h, moderate: 1–7 days, major: &gt; 7 days or structural concern)
Responsible (R): BC Manager
Accountable (A): COO
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W858_Flow18</bpmn:incoming>
        <bpmn:outgoing>W858_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W858_Task9" name="Prioritize claim filing order — major structural damage first, then moderate…">
        <bpmn:documentation>Step 2: Prioritize claim filing order — major structural damage first, then moderate inventory damage, then minor; estimate aggregate claim value and notify insurer of catastrophic event
Responsible (R): Insurance Coordinator
Accountable (A): CFO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W858_Flow19</bpmn:incoming>
        <bpmn:outgoing>W858_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W858_Task10" name="Deploy damage assessment teams — for major claims: engage external structural…">
        <bpmn:documentation>Step 3: Deploy damage assessment teams — for major claims: engage external structural engineer + insurance adjuster; for moderate claims: LP Officer + Store Manager conduct detailed assessment; for minor: Store Manager self-assessment with photo documentation
Responsible (R): BC Manager
Accountable (A): COO
Duration: 1–3 days (field deployment)</bpmn:documentation>
        <bpmn:incoming>W858_Flow20</bpmn:incoming>
        <bpmn:outgoing>W858_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W858_Task11" name="Compile catastrophic event claim package — consolidated claim submission to…">
        <bpmn:documentation>Step 4: Compile catastrophic event claim package — consolidated claim submission to insurer with: (a) event summary (PAGASA data, affected area map), (b) location-by-location damage detail, (c) aggregate loss estimate with supporting valuation, (d) business interruption calculation (per W860), (e) emergency repair documentation
Responsible (R): Insurance Coordinator
Accountable (A): CFO
Duration: 8–16 hours</bpmn:documentation>
        <bpmn:incoming>W858_Flow21</bpmn:incoming>
        <bpmn:outgoing>W858_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W858_Task12" name="Engage loss adjuster for catastrophic event — insurer appoints catastrophic…">
        <bpmn:documentation>Step 5: Engage loss adjuster for catastrophic event — insurer appoints catastrophic loss adjuster; coordinate multi-site inspection schedule over 2–4 weeks; provide logistics support (transport, access)
Responsible (R): Insurance Broker
Accountable (A): Insurance Coordinator
Duration: 2–4 weeks (elapsed)</bpmn:documentation>
        <bpmn:incoming>W858_Flow22</bpmn:incoming>
        <bpmn:outgoing>W858_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W858_Task13" name="Negotiate catastrophic settlement — typically involves interim payments for…">
        <bpmn:documentation>Step 6: Negotiate catastrophic settlement — typically involves interim payments for emergency repairs + final settlement after full assessment; may require mediation if insurer disputes scope or value
Responsible (R): CFO
Accountable (A): CEO
Duration: 4–8 weeks (elapsed)</bpmn:documentation>
        <bpmn:incoming>W858_Flow23</bpmn:incoming>
        <bpmn:outgoing>W858_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W858_Task14" name="Process recovery and close claims — record all insurance recoveries, reconcile…">
        <bpmn:documentation>Step 7: Process recovery and close claims — record all insurance recoveries, reconcile against actual repair costs, document unrecovered losses, and update property valuations for next renewal
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W858_Flow24</bpmn:incoming>
        <bpmn:outgoing>W858_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W858_End15" name="Complete">
        <bpmn:incoming>W858_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W858_Annotation16">
        <bpmn:text>Controls: - CTL-228 (ensure BCP readiness &amp; insurance recovery.) | - operational: periodic reconciliation against source documents
Owner: Insurance Coordinator / BC Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W858_Assoc17" sourceRef="W858_Annotation16" targetRef="W858_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W858_Flow18" sourceRef="W858_Start7" targetRef="W858_Task8" />
      <bpmn:sequenceFlow id="W858_Flow19" sourceRef="W858_Task8" targetRef="W858_Task9" />
