<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-26.3-insurance-claims-and-policy-management" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W857" name="W857. Store &amp; DC Property Insurance Claim Filing &amp; Documentation" isExecutable="false">
      <bpmn:documentation>Trigger: Property damage event at any store, DC, or HQ — fire, break-in, water damage, equipment failure, or vandalism
Frequency: Estimated 30–50 property claims per year across 205 locations
Volume: Average claim value: PHP 50,000–500,000 (minor to moderate damage); major claims (typhoon, fire): PHP 1–10 million
Owner: Insurance Coordinator / Finance Controller
Participants: Store Manager, LP Officer, Finance Controller, Insurance Broker, External Adjuster, Legal Counsel
Source: workflow W857 — Store &amp; DC Property Insurance Claim Filing &amp; Documentation</bpmn:documentation>
      <bpmn:laneSet id="W857_LaneSet4">
        <bpmn:lane id="W857_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W857_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W857_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W857_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W857_Lane2" name="Insurance Coordinator">
        <bpmn:flowNodeRef>W857_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W857_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W857_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W857_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W857_Lane3" name="Finance Controller">
        <bpmn:flowNodeRef>W857_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W857_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W857_Start5" name="Property damage event at any store, DC, or HQ — fire, break-in, water damage, equipment…">
        <bpmn:outgoing>W857_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W857_Task6" name="Incident notification — Store Manager reports property damage to Insurance…">
        <bpmn:documentation>Step 1: Incident notification — Store Manager reports property damage to Insurance Coordinator within 24 hours; include initial damage description, estimated value, photos, and whether emergency repairs needed
Responsible (R): Store Manager
Accountable (A): Insurance Coordinator
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W857_Flow16</bpmn:incoming>
        <bpmn:outgoing>W857_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W857_Task7" name="Emergency mitigation authorization — for time-sensitive damage (water ingress…">
        <bpmn:documentation>Step 2: Emergency mitigation authorization — for time-sensitive damage (water ingress, structural compromise), Insurance Coordinator authorizes emergency repairs up to PHP 100,000 without adjuster inspection; document with photos before and after
Responsible (R): Insurance Coordinator
Accountable (A): CFO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W857_Flow17</bpmn:incoming>
        <bpmn:outgoing>W857_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W857_Task8" name="Compile claim documentation — (a) detailed damage description with cause, (b)…">
        <bpmn:documentation>Step 3: Compile claim documentation — (a) detailed damage description with cause, (b) photographic evidence (before/after where available), (c) repair estimates from 2–3 contractors, (d) police report (if theft/vandalism), (e) BFP fire investigation report (if fire), (f) inventory damage assessment with replacement cost
Responsible (R): Store Manager / LP Officer
Accountable (A): Insurance Coordinator
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W857_Flow18</bpmn:incoming>
        <bpmn:outgoing>W857_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W857_Task9" name="Submit insurance claim to broker — complete insurer claim form, attach all…">
        <bpmn:documentation>Step 4: Submit insurance claim to broker — complete insurer claim form, attach all documentation, provide loss amount breakdown (building, equipment, inventory, cleanup); submit within insurer&#x27;s required timeframe (typically 30 days)
Responsible (R): Insurance Coordinator
Accountable (A): Finance Controller
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W857_Flow19</bpmn:incoming>
        <bpmn:outgoing>W857_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W857_Task10" name="Coordinate adjuster inspection — schedule insurance adjuster visit, ensure…">
        <bpmn:documentation>Step 5: Coordinate adjuster inspection — schedule insurance adjuster visit, ensure Store Manager availability, provide access to damaged areas and documentation
Responsible (R): Insurance Coordinator
Accountable (A): Insurance Broker
Duration: 2 hours (scheduling)</bpmn:documentation>
        <bpmn:incoming>W857_Flow20</bpmn:incoming>
        <bpmn:outgoing>W857_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W857_Task11" name="Negotiate settlement — review adjuster report, dispute undervaluation if…">
        <bpmn:documentation>Step 6: Negotiate settlement — review adjuster report, dispute undervaluation if applicable, provide supplementary evidence, and agree on settlement amount with insurer
Responsible (R): Insurance Coordinator
Accountable (A): Finance Controller
Duration: 4–8 hours (over 2–4 weeks)</bpmn:documentation>
        <bpmn:incoming>W857_Flow21</bpmn:incoming>
        <bpmn:outgoing>W857_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W857_Task12" name="Process settlement — record insurance recovery in finance module, offset…">
        <bpmn:documentation>Step 7: Process settlement — record insurance recovery in finance module, offset against damage loss, and close claim file
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W857_Flow22</bpmn:incoming>
        <bpmn:outgoing>W857_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W857_End13" name="Complete">
        <bpmn:incoming>W857_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W857_Annotation14">
        <bpmn:text>Controls: - CTL-321 (ensure controlled execution — Insurance Claims &amp; Policy Management (PA-26.3).) | - operational: Insurance Coordinator / Finance Controller review and approval gate
Owner: Insurance Coordinator / Finance Controller</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W857_Assoc15" sourceRef="W857_Annotation14" targetRef="W857_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W857_Flow16" sourceRef="W857_Start5" targetRef="W857_Task6" />
      <bpmn:sequenceFlow id="W857_Flow17" sourceRef="W857_Task6" targetRef="W857_Task7" />
