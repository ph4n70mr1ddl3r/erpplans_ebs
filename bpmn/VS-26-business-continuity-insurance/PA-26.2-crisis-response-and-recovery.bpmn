    <bpmn:process id="W_W852" name="W852. Supply Chain Disruption Business Impact Assessment &amp; Recovery" isExecutable="false">
      <bpmn:documentation>Trigger: Major supply chain disruption — port closure (Manila South Harbor, Cebu, Davao), vendor manufacturing halt, container shipping disruption, or national transportation strike
Frequency: Estimated 2–4 significant disruptions per year
Volume: Each disruption may affect 10–50% of inbound supply depending on scope
Owner: VP Supply Chain
Participants: Procurement Manager, Warehouse Manager, Merchandising Manager, CFO, BC Manager, VP Store Operations
Source: workflow W852 — Supply Chain Disruption Business Impact Assessment &amp; Recovery</bpmn:documentation>
      <bpmn:laneSet id="W852_LaneSet5">
        <bpmn:lane id="W852_Lane1" name="Supply Chain Planner">
        <bpmn:flowNodeRef>W852_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W852_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W852_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W852_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W852_Lane2" name="Supply Chain Analyst">
        <bpmn:flowNodeRef>W852_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W852_Lane3" name="Procurement Manager">
        <bpmn:flowNodeRef>W852_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W852_Lane4" name="VP Supply Chain">
        <bpmn:flowNodeRef>W852_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W852_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W852_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W852_Start6" name="Major supply chain disruption — port closure (Manila South Harbor, Cebu, Davao), vendor…">
        <bpmn:outgoing>W852_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W852_Task7" name="Assess disruption scope — identify affected POs (in-transit, pending shipment…">
        <bpmn:documentation>Step 1: Assess disruption scope — identify affected POs (in-transit, pending shipment, at port), affected vendors, affected categories, estimated duration of disruption, and inventory coverage in days-of-supply
Responsible (R): Supply Chain Planner
Accountable (A): VP Supply Chain
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W852_Flow17</bpmn:incoming>
        <bpmn:outgoing>W852_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W852_Task8" name="Quantify business impact — estimate lost sales by category, store impact (which…">
        <bpmn:documentation>Step 2: Quantify business impact — estimate lost sales by category, store impact (which locations most affected), customer satisfaction impact, and financial exposure
Responsible (R): Supply Chain Analyst
Accountable (A): CFO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W852_Flow18</bpmn:incoming>
        <bpmn:outgoing>W852_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W852_Task9" name="Activate alternative sourcing — identify backup vendors, authorized substitute…">
        <bpmn:documentation>Step 3: Activate alternative sourcing — identify backup vendors, authorized substitute SKUs, alternative ports of entry, and expedited air freight options for critical items
Responsible (R): Procurement Manager
Accountable (A): VP Supply Chain
Duration: 8–16 hours (over 2–3 days)</bpmn:documentation>
        <bpmn:incoming>W852_Flow19</bpmn:incoming>
        <bpmn:outgoing>W852_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W852_Task10" name="Implement allocation strategy — if supply is constrained, allocate available…">
        <bpmn:documentation>Step 4: Implement allocation strategy — if supply is constrained, allocate available inventory to stores based on sales velocity, strategic importance, and customer impact
Responsible (R): Supply Chain Planner
Accountable (A): VP Merchandising
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W852_Flow20</bpmn:incoming>
        <bpmn:outgoing>W852_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W852_Task11" name="Communicate to Store Managers — provide impacted category list, expected…">
        <bpmn:documentation>Step 5: Communicate to Store Managers — provide impacted category list, expected recovery timeline, substitute SKU guidance, and customer messaging for out-of-stock items
Responsible (R): VP Supply Chain
Accountable (A): COO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W852_Flow21</bpmn:incoming>
        <bpmn:outgoing>W852_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W852_Task12" name="Monitor recovery — track alternative vendor performance, port reopening status…">
        <bpmn:documentation>Step 6: Monitor recovery — track alternative vendor performance, port reopening status, container movement, and inventory replenishment rate against normal levels
Responsible (R): Supply Chain Planner
Accountable (A): VP Supply Chain
Duration: Daily until resolved (1–4 weeks)</bpmn:documentation>
        <bpmn:incoming>W852_Flow22</bpmn:incoming>
        <bpmn:outgoing>W852_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W852_Task13" name="Post-disruption review — document root cause, response effectiveness, inventory…">
        <bpmn:documentation>Step 7: Post-disruption review — document root cause, response effectiveness, inventory impact, financial cost, and recommendations for supply chain resilience improvement
Responsible (R): VP Supply Chain
Accountable (A): COO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W852_Flow23</bpmn:incoming>
        <bpmn:outgoing>W852_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W852_End14" name="Complete">
        <bpmn:incoming>W852_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W852_Annotation15">
        <bpmn:text>Controls: - CTL-320 (ensure controlled execution — Crisis Response &amp; Recovery (PA-26.2).) | - operational: VP Supply Chain review and approval gate
Owner: VP Supply Chain</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W852_Assoc16" sourceRef="W852_Annotation15" targetRef="W852_Start6" associationDirection="None" />
