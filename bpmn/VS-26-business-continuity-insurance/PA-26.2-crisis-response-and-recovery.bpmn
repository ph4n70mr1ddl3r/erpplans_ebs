      <bpmn:sequenceFlow id="W850_Flow18" sourceRef="W850_Task7" targetRef="W850_Task8" />
      <bpmn:sequenceFlow id="W850_Flow19" sourceRef="W850_Task8" targetRef="W850_Task9" />
      <bpmn:sequenceFlow id="W850_Flow20" sourceRef="W850_Task9" targetRef="W850_Task10" />
      <bpmn:sequenceFlow id="W850_Flow21" sourceRef="W850_Task10" targetRef="W850_Task11" />
      <bpmn:sequenceFlow id="W850_Flow22" sourceRef="W850_Task11" targetRef="W850_End12" />
    </bpmn:process>
