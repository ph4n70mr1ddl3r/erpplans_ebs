<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-26.2-crisis-response-and-recovery" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W848" name="W848. Typhoon &amp; Natural Disaster Store Emergency Protocol &amp; Response" isExecutable="false">
      <bpmn:documentation>Trigger: PAGASA typhoon warning Signal No. 2 or above in store&#x27;s area; earthquake intensity ≥ V (PHIVOLCS scale); or LGU mandatory evacuation order
Frequency: Estimated 5–8 activations per year across the chain (Philippines averages 20 typhoons/year; not all affect BuildRight locations)
Volume: Each activation may affect 20–80 stores depending on typhoon path; DC activations average 2–3 per year
Owner: COO / Regional Manager
Participants: Store Manager, DC Manager, LP Officer, IT Security, CHRO, BC Manager, External Emergency Services
Source: workflow W848 — Typhoon &amp; Natural Disaster Store Emergency Protocol &amp; Response</bpmn:documentation>
      <bpmn:laneSet id="W848_LaneSet5">
        <bpmn:lane id="W848_Lane1" name="BC Manager">
        <bpmn:flowNodeRef>W848_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W848_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W848_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W848_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W848_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W848_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W848_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W848_Lane3" name="DC Manager">
        <bpmn:flowNodeRef>W848_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W848_Lane4" name="COO">
        <bpmn:flowNodeRef>W848_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W848_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W848_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W848_Start6" name="PAGASA typhoon warning Signal No. 2 or above in store&#x27;s area; earthquake intensity ≥ V…">
        <bpmn:outgoing>W848_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W848_Task7" name="Activate disaster monitoring — BC Manager tracks PAGASA bulletins every 3…">
        <bpmn:documentation>Step 1: Activate disaster monitoring — BC Manager tracks PAGASA bulletins every 3 hours; classify stores by risk zone (direct path, peripheral, minimal); pre-position emergency response resources
Responsible (R): BC Manager
Accountable (A): COO
Duration: Continuous (from Signal No. 1)</bpmn:documentation>
        <bpmn:incoming>W848_Flow18</bpmn:incoming>
        <bpmn:outgoing>W848_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W848_Task8" name="Issue pre-emptive store advisory (at Signal No. 1) — Store Managers activate…">
        <bpmn:documentation>Step 2: Issue pre-emptive store advisory (at Signal No. 1) — Store Managers activate preparedness checklist: secure outdoor merchandise (lumber, garden center), sandbag entrances in flood-prone locations, verify generator fuel and emergency supplies
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W848_Flow19</bpmn:incoming>
        <bpmn:outgoing>W848_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W848_Task9" name="Execute controlled store closure (at Signal No. 3+, LGU evacuation order, or…">
        <bpmn:documentation>Step 3: Execute controlled store closure (at Signal No. 3+, LGU evacuation order, or facility safety failure — closure decision per W2510 / VS-69) — complete all customer transactions, secure cash in safe, power down non-essential equipment, deploy window protection, activate security alarm, send staff home with safety advisory
Responsible (R): Store Manager
Accountable (A): COO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W848_Flow20</bpmn:incoming>
        <bpmn:outgoing>W848_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W848_Task10" name="DC emergency protocol — secure all inventory above flood level, activate backup…">
        <bpmn:documentation>Step 4: DC emergency protocol — secure all inventory above flood level, activate backup power, secure dock doors, protect hazardous materials, maintain skeleton crew if safe to do so
Responsible (R): DC Manager
Accountable (A): VP Supply Chain
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W848_Flow21</bpmn:incoming>
        <bpmn:outgoing>W848_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W848_Task11" name="HQ crisis team activation — establish situation room, activate communication…">
        <bpmn:documentation>Step 5: HQ crisis team activation — establish situation room, activate communication tree (W855), coordinate with all affected stores/DCs, liaise with LGU emergency management
Responsible (R): COO
Accountable (A): CEO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W848_Flow22</bpmn:incoming>
        <bpmn:outgoing>W848_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W848_Task12" name="Post-disaster rapid damage assessment (within 24 hours of all-clear) — Store…">
        <bpmn:documentation>Step 6: Post-disaster rapid damage assessment (within 24 hours of all-clear) — Store Manager or designated key holder conducts site visit, photographs damage, assesses structural integrity, inventory loss, and equipment condition
Responsible (R): Store Manager / LP Officer
Accountable (A): COO
Duration: 2–4 hours per store</bpmn:documentation>
        <bpmn:incoming>W848_Flow23</bpmn:incoming>
        <bpmn:outgoing>W848_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W848_Task13" name="Submit damage report and insurance claim trigger — compile damage assessment…">
        <bpmn:documentation>Step 7: Submit damage report and insurance claim trigger — compile damage assessment, inventory loss estimate, and business interruption impact; notify Insurance Coordinator to initiate claim (per W876)
Responsible (R): BC Manager
Accountable (A): CFO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W848_Flow24</bpmn:incoming>
        <bpmn:outgoing>W848_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W848_Task14" name="Execute store reopening (see W850) — prioritize based on structural safety…">
        <bpmn:documentation>Step 8: Execute store reopening (see W850) — prioritize based on structural safety, inventory availability, staff safety, and community need (BuildRight often serves as recovery supply hub)
Responsible (R): COO
Accountable (A): CEO
Duration: 1–3 days per store</bpmn:documentation>
        <bpmn:incoming>W848_Flow25</bpmn:incoming>
        <bpmn:outgoing>W848_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W848_End15" name="Complete">
        <bpmn:incoming>W848_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W848_Annotation16">
        <bpmn:text>Controls: - CTL-320 (ensure controlled execution — Crisis Response &amp; Recovery (PA-26.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: COO / Regional Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W848_Assoc17" sourceRef="W848_Annotation16" targetRef="W848_Start6" associationDirection="None" />
