    <bpmn:process id="W_W850" name="W850. Store Emergency Closure &amp; Reopening Procedure" isExecutable="false">
      <bpmn:documentation>Trigger: Natural disaster (W848), civil disturbance, power outage &gt; 4 hours, structural concern, or government-mandated closure
Frequency: Estimated 5–10 closures per store per year (most are weather-related half-day closures)
Volume: ~1,000–2,000 closure events per year chain-wide
Owner: Store Manager
Participants: Regional Manager, LP Officer, IT Helpdesk, HR, BC Manager
Source: workflow W850 — Store Emergency Closure &amp; Reopening Procedure</bpmn:documentation>
      <bpmn:laneSet id="W850_LaneSet3">
        <bpmn:lane id="W850_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W850_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W850_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W850_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W850_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W850_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W850_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W850_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W850_Lane2" name="LP Officer">
        <bpmn:flowNodeRef>W850_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W850_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W850_Start4" name="Natural disaster (W848), civil disturbance, power outage &gt; 4 hours, structural concern…">
        <bpmn:outgoing>W850_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W850_Task5" name="Receive and validate closure authorization — Regional Manager issues the…">
        <bpmn:documentation>Step 1: Receive and validate closure authorization — Regional Manager issues the closure directive per the W2510 decision matrix (VS-69; VP Store Operations approves multi-store events; COO issues chain-wide directives); Store Manager confirms with regional office; log closure reason and expected duration
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W850_Flow15</bpmn:incoming>
        <bpmn:outgoing>W850_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W850_Task6" name="Execute in-store closure procedure — (a) announce last call to customers, (b)…">
        <bpmn:documentation>Step 2: Execute in-store closure procedure — (a) announce last call to customers, (b) complete all pending POS transactions, (c) reconcile cash drawers and secure in safe, (d) power down non-essential systems per shutdown checklist, (e) secure all entrances, (f) activate security alarm, (g) verify all staff have safe transport home
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W850_Flow16</bpmn:incoming>
        <bpmn:outgoing>W850_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W850_Task7" name="Submit closure report to regional office — store ID, closure time, reason…">
        <bpmn:documentation>Step 3: Submit closure report to regional office — store ID, closure time, reason, estimated reopening, staff headcount confirmed safe, cash secure status, and any known damage
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W850_Flow17</bpmn:incoming>
        <bpmn:outgoing>W850_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W850_Task8" name="During closure: maintain remote monitoring — CCTV remote access, alarm system…">
        <bpmn:documentation>Step 4: During closure: maintain remote monitoring — CCTV remote access, alarm system monitoring, LP coordination with security agency for physical patrol if warranted
Responsible (R): LP Officer
Accountable (A): LP Manager (Regional)
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W850_Flow18</bpmn:incoming>
        <bpmn:outgoing>W850_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W850_Task9" name="Reopening assessment — Store Manager or designated key holder conducts…">
        <bpmn:documentation>Step 5: Reopening assessment — Store Manager or designated key holder conducts pre-reopening inspection: structural safety, electrical safety, water damage, inventory condition, POS/system functionality, staff availability
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W850_Flow19</bpmn:incoming>
        <bpmn:outgoing>W850_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W850_Task10" name="Execute reopening — (a) restore systems (POS startup, network verification)…">
        <bpmn:documentation>Step 6: Execute reopening — (a) restore systems (POS startup, network verification), (b) cash drawer opening and float distribution, (c) brief staff on any modified procedures, (d) restock damaged/displaced merchandise, (e) reopen to customers
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W850_Flow20</bpmn:incoming>
        <bpmn:outgoing>W850_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W850_Task11" name="Submit reopening report — time opened, damage summary (if any), sales impact…">
        <bpmn:documentation>Step 7: Submit reopening report — time opened, damage summary (if any), sales impact estimate, and any follow-up actions required
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W850_Flow21</bpmn:incoming>
        <bpmn:outgoing>W850_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W850_End12" name="Complete">
        <bpmn:incoming>W850_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W850_Annotation13">
        <bpmn:text>Controls: - CTL-320 (ensure controlled execution — Crisis Response &amp; Recovery (PA-26.2).) | - operational: periodic reconciliation against source documents
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W850_Assoc14" sourceRef="W850_Annotation13" targetRef="W850_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W850_Flow15" sourceRef="W850_Start4" targetRef="W850_Task5" />
