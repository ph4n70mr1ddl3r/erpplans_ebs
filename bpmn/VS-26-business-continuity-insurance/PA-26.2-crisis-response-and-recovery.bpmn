    <bpmn:process id="W_W855" name="W855. Communication Tree Activation &amp; Crisis Communication Management" isExecutable="false">
      <bpmn:documentation>Trigger: Any event requiring coordinated communication to multiple stakeholder groups simultaneously — natural disaster, system outage, product recall, workplace safety incident, or PR crisis
Frequency: 3–5 activations per year (major); 10–15 minor activations
Volume: Each major activation reaches 6,932 employees, 200 Store Managers, 4 DC Managers, and potentially 600,000 loyalty customers
Owner: COO / Corporate Communications Manager
Participants: CEO, CHRO, CIO, Legal Counsel, BC Manager, Store Managers, External PR Agency (for public-facing crises)
Source: workflow W855 — Communication Tree Activation &amp; Crisis Communication Management</bpmn:documentation>
      <bpmn:laneSet id="W855_LaneSet2">
        <bpmn:lane id="W855_Lane1" name="Corporate Communications">
        <bpmn:flowNodeRef>W855_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W855_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W855_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W855_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W855_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W855_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W855_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W855_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W855_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W855_Start3" name="Any event requiring coordinated communication to multiple stakeholder groups…">
        <bpmn:outgoing>W855_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W855_Task4" name="Assess communication scope — determine stakeholder groups affected (employees…">
        <bpmn:documentation>Step 1: Assess communication scope — determine stakeholder groups affected (employees, customers, vendors, media, regulators), message urgency (immediate/same day/next day), and communication channel (SMS blast, email, intranet, social media, press release)
Responsible (R): Corporate Communications
Accountable (A): COO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W855_Flow14</bpmn:incoming>
        <bpmn:outgoing>W855_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W855_Task5" name="Draft and approve message — prepare factual, non-speculative message…">
        <bpmn:documentation>Step 2: Draft and approve message — prepare factual, non-speculative message appropriate for each audience; Legal Counsel reviews for liability; CEO approves external communications
Responsible (R): Corporate Communications
Accountable (A): CEO
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W855_Flow15</bpmn:incoming>
        <bpmn:outgoing>W855_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W855_Task6" name="Activate internal communication tree — (a) SMS blast to all Store Managers…">
        <bpmn:documentation>Step 3: Activate internal communication tree — (a) SMS blast to all Store Managers (target: within 15 min), (b) email to all employees, (c) intranet posting, (d) department head cascade (phone tree for P1 events), (e) employee hotline activation
Responsible (R): Corporate Communications
Accountable (A): COO
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W855_Flow16</bpmn:incoming>
        <bpmn:outgoing>W855_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W855_Task7" name="Activate external communication — (a) customer notification (SMS/email for…">
        <bpmn:documentation>Step 4: Activate external communication — (a) customer notification (SMS/email for affected loyalty members), (b) social media post (advisory or statement), (c) vendor notification for supply chain events, (d) press statement for media events, (e) regulatory notification (BIR, DOLE, LGU) as required
Responsible (R): Corporate Communications
Accountable (A): CEO
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W855_Flow17</bpmn:incoming>
        <bpmn:outgoing>W855_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W855_Task8" name="Establish ongoing communication cadence — regular status updates at defined…">
        <bpmn:documentation>Step 5: Establish ongoing communication cadence — regular status updates at defined intervals (hourly for P1, every 4 hours for P2, daily for P3) until event resolved
Responsible (R): Corporate Communications
Accountable (A): COO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W855_Flow18</bpmn:incoming>
        <bpmn:outgoing>W855_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W855_Task9" name="Monitor social media and feedback — track customer/employee reactions on social…">
        <bpmn:documentation>Step 6: Monitor social media and feedback — track customer/employee reactions on social media, respond to inquiries, correct misinformation, and escalate negative sentiment trends
Responsible (R): Corporate Communications
Accountable (A): COO
Duration: Continuous during event</bpmn:documentation>
        <bpmn:incoming>W855_Flow19</bpmn:incoming>
        <bpmn:outgoing>W855_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W855_Task10" name="Issue closure communication — all-clear notification, summary of event and…">
        <bpmn:documentation>Step 7: Issue closure communication — all-clear notification, summary of event and resolution, thank stakeholders for patience, and provide next steps or resources
Responsible (R): Corporate Communications
Accountable (A): CEO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W855_Flow20</bpmn:incoming>
        <bpmn:outgoing>W855_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W855_End11" name="Complete">
        <bpmn:incoming>W855_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W855_Annotation12">
        <bpmn:text>Controls: - CTL-320 (ensure controlled execution — Crisis Response &amp; Recovery (PA-26.2).) | - operational: reliability during disasters — telecom congestion may delay delivery
Owner: COO / Corporate Communications Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W855_Assoc13" sourceRef="W855_Annotation12" targetRef="W855_Start3" associationDirection="None" />
