      <bpmndi:BPMNPlane id="W849_plane" bpmnElement="W_W849">
        <bpmndi:BPMNShape id="W849_Lane1_di" bpmnElement="W849_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W849_Lane2_di" bpmnElement="W849_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W849_Lane3_di" bpmnElement="W849_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W849_Task6_di" bpmnElement="W849_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
