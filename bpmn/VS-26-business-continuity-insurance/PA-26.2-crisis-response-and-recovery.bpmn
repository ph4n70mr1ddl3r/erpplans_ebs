      <bpmn:sequenceFlow id="W855_Flow15" sourceRef="W855_Task4" targetRef="W855_Task5" />
      <bpmn:sequenceFlow id="W855_Flow16" sourceRef="W855_Task5" targetRef="W855_Task6" />
      <bpmn:sequenceFlow id="W855_Flow17" sourceRef="W855_Task6" targetRef="W855_Task7" />
      <bpmn:sequenceFlow id="W855_Flow18" sourceRef="W855_Task7" targetRef="W855_Task8" />
      <bpmn:sequenceFlow id="W855_Flow19" sourceRef="W855_Task8" targetRef="W855_Task9" />
      <bpmn:sequenceFlow id="W855_Flow20" sourceRef="W855_Task9" targetRef="W855_Task10" />
      <bpmn:sequenceFlow id="W855_Flow21" sourceRef="W855_Task10" targetRef="W855_End11" />
    </bpmn:process>
