    <bpmn:process id="W_W1213" name="W1213. Store-Level Flood Response, Water Damage Mitigation &amp; Post-Flood Recovery Protocol" isExecutable="false">
      <bpmn:documentation>Trigger: PAGASA issues flood warning for store area; or store staff observe rising water levels near store perimeter; or local government issues evacuation advisory
Frequency: 2–4 flood events per year affecting a subset of stores (primarily during June–November typhoon season); individual store may flood once every 2–3 years
Volume: ~10–30 stores affected per major flood event (out of 200 total)
Owner: Store Manager
Participants: Store Manager, all store staff, Regional Manager, LP Officer, Facilities Maintenance, Insurance Claims Coordinator
Source: workflow W1213 — Store-Level Flood Response, Water Damage Mitigation &amp; Post-Flood Recovery Protocol</bpmn:documentation>
      <bpmn:laneSet id="W1213_LaneSet5">
        <bpmn:lane id="W1213_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W1213_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1213_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1213_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1213_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1213_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1213_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1213_Lane2" name="Facilities Maintenance">
        <bpmn:flowNodeRef>W1213_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1213_Lane3" name="Insurance Claims Coordinator">
        <bpmn:flowNodeRef>W1213_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1213_Lane4" name="Supply Planning">
        <bpmn:flowNodeRef>W1213_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1213_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1213_Start6" name="PAGASA issues flood warning for store area; or store staff observe rising water levels…">
        <bpmn:outgoing>W1213_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1213_Task7" name="Pre-flood alert">
        <bpmn:documentation>Step 1: Pre-flood alert: PAGASA warning or Regional Manager alert received; Store Manager activates flood preparedness checklist: (a) move cement, adhesives, and water-soluble items from floor level to upper shelving or pallets (minimum 60cm elevation), (b) deploy flood barriers/sandbags at entrance and receiving dock, (c) cover lumber yard merchandise with tarpaulins, (d) move electrical items, power tools, and appliances from lowest shelves, (e) raise computers, POS terminals, and servers above flood level, (f) secure cash office — move cash, documents, and safe above flood line
Responsible (R): Store Manager / All Staff
Accountable (A): Regional Manager
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W1213_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1213_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1213_Task8" name="During flooding">
        <bpmn:documentation>Step 2: During flooding: if water enters store: (a) Store Manager orders evacuation of staff and customers to safe area, (b) LP Officer activates CCTV recording to capture flood damage for insurance documentation, (c) shut off electrical main breaker to prevent electrocution, (d) if time permits: staff moves highest-value items (power tools, appliances) to upper shelves or mezzanine, (e) Store Manager photographs water line height and affected areas for documentation
Responsible (R): Store Manager / All Staff
Accountable (A): Regional Manager
Duration: Event duration</bpmn:documentation>
        <bpmn:incoming>W1213_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1213_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1213_Task9" name="Post-flood assessment">
        <bpmn:documentation>Step 3: Post-flood assessment (once water recedes and area declared safe): Store Manager and LP Officer conduct damage assessment: (a) photograph all damaged merchandise, equipment, and facility areas with wide-angle and close-up shots, (b) estimate water line height (highest point of water contact), (c) categorize damage: (i) destroyed (cement, adhesives, cardboard packaging, electrical items submerged) — write-off per W92, (ii) damaged but salvageable (lumber with surface water, items in wet packaging) — assess per W91, (iii) unaffected (items above water line), (d) system generates damage report with estimated value
Responsible (R): Store Manager / LP Officer
Accountable (A): Regional Manager
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W1213_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1213_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1213_Task10" name="Emergency merchandise disposition">
        <bpmn:documentation>Step 4: Emergency merchandise disposition: (a) destroyed items: system marks as damaged, creates write-off request per W92 (requires Regional Manager approval for amounts &gt; PHP 100K, COO for &gt; PHP 500K); (b) water-damaged items with salvage value: Store Manager coordinates with Merchandising for emergency markdown sale per W93 (&quot;flood sale&quot; — sell water-damaged items at 30–50% discount to recover partial value); (c) contaminated items (paint, chemicals mixed with floodwater): denature and dispose per DENR hazmat procedures per W24.3
Responsible (R): Store Manager / Merchandising
Accountable (A): COO
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W1213_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1213_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1213_Task11" name="Facility restoration">
        <bpmn:documentation>Step 5: Facility restoration: (a) Store Manager contacts Facilities Maintenance for emergency response: water extraction, dehumidification, mold prevention treatment, (b) electrical system inspection by licensed electrician before power restoration, (c) sanitize all affected floor and shelf surfaces, (d) replace damaged shelving, signage, and fixtures per W1025, (e) POS and IT equipment: IT Helpdesk (W48) inspects and replaces water-damaged terminals and network equipment
Responsible (R): Facilities Maintenance / IT Helpdesk
Accountable (A): COO
Duration: 3–7 days</bpmn:documentation>
        <bpmn:incoming>W1213_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1213_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1213_Task12" name="Insurance claim initiation">
        <bpmn:documentation>Step 6: Insurance claim initiation: (a) Store Manager submits flood damage report and photographs to Insurance Claims Coordinator, (b) Coordinator files claim with property insurance provider per W857 within 72 hours, (c) schedule adjuster visit for damage verification, (d) Coordinator tracks claim through settlement per W857/W858
Responsible (R): Insurance Claims Coordinator
Accountable (A): CFO
Duration: 2 hours initial; ongoing</bpmn:documentation>
        <bpmn:incoming>W1213_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1213_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1213_Task13" name="Replenishment and reopening">
        <bpmn:documentation>Step 7: Replenishment and reopening: (a) Supply Planning initiates emergency replenishment for destroyed items, (b) Merchandising adjusts allocation to prioritize flood-affected store, (c) Store Manager conducts pre-opening walkthrough to verify safety and readiness, (d) Regional Manager authorizes store reopening, (e) Marketing coordinates community notification of store reopening
Responsible (R): Supply Planning / Store Manager
Accountable (A): COO
Duration: 3–7 days</bpmn:documentation>
        <bpmn:incoming>W1213_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1213_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1213_Task14" name="Post-recovery review">
        <bpmn:documentation>Step 8: Post-recovery review: Store Manager documents lessons learned: (a) flood preparedness effectiveness — were sandbags adequate? Were vulnerable items moved in time?, (b) response time — how quickly was staff mobilized?, (c) damage reduction actions that worked, (d) recommendations for facility improvements (drainage, elevated storage, flood barriers); feeds into W856 post-incident review and informs store facility capital plan per VS-20 (W21 capex requests)
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W1213_Flow25</bpmn:incoming>
        <bpmn:outgoing>W1213_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1213_End15" name="Complete">
        <bpmn:incoming>W1213_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1213_Annotation16">
        <bpmn:text>Controls: - CTL-320 (ensure controlled execution — Crisis Response &amp; Recovery (PA-26.2).) | - operational: Store Manager review and approval gate
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1213_Assoc17" sourceRef="W1213_Annotation16" targetRef="W1213_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1213_Flow18" sourceRef="W1213_Start6" targetRef="W1213_Task7" />
      <bpmn:sequenceFlow id="W1213_Flow19" sourceRef="W1213_Task7" targetRef="W1213_Task8" />
      <bpmn:sequenceFlow id="W1213_Flow20" sourceRef="W1213_Task8" targetRef="W1213_Task9" />
      <bpmn:sequenceFlow id="W1213_Flow21" sourceRef="W1213_Task9" targetRef="W1213_Task10" />
      <bpmn:sequenceFlow id="W1213_Flow22" sourceRef="W1213_Task10" targetRef="W1213_Task11" />
      <bpmn:sequenceFlow id="W1213_Flow23" sourceRef="W1213_Task11" targetRef="W1213_Task12" />
      <bpmn:sequenceFlow id="W1213_Flow24" sourceRef="W1213_Task12" targetRef="W1213_Task13" />
      <bpmn:sequenceFlow id="W1213_Flow25" sourceRef="W1213_Task13" targetRef="W1213_Task14" />
      <bpmn:sequenceFlow id="W1213_Flow26" sourceRef="W1213_Task14" targetRef="W1213_End15" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1213_diag">
