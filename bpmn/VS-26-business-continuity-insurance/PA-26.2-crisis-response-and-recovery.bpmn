    <bpmn:process id="W_W854" name="W854. Pandemic/Epidemic Business Continuity Activation &amp; Operations" isExecutable="false">
      <bpmn:documentation>Trigger: WHO declares pandemic with Philippine impact; DOH declares epidemic alert; or company medical advisor recommends activation
Frequency: Rare (COVID-19-level events: estimated 1–2 per decade); preparedness maintained continuously
Volume: 1 activation affects all 200 stores, 4 DCs, and HQ; duration may be 3–18 months
Owner: CEO / COO
Participants: Executive Committee, CHRO, BC Manager, CIO, VP Supply Chain, Legal Counsel, External Medical Advisor
Source: workflow W854 — Pandemic/Epidemic Business Continuity Activation &amp; Operations</bpmn:documentation>
      <bpmn:laneSet id="W854_LaneSet7">
        <bpmn:lane id="W854_Lane1" name="CEO">
        <bpmn:flowNodeRef>W854_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W854_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W854_Lane2" name="CHRO">
        <bpmn:flowNodeRef>W854_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W854_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W854_Lane3" name="CIO">
        <bpmn:flowNodeRef>W854_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W854_Lane4" name="COO">
        <bpmn:flowNodeRef>W854_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W854_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W854_Lane5" name="VP Supply Chain">
        <bpmn:flowNodeRef>W854_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W854_Lane6" name="CFO">
        <bpmn:flowNodeRef>W854_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W854_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W854_Start8" name="WHO declares pandemic with Philippine impact; DOH declares epidemic alert; or company…">
        <bpmn:outgoing>W854_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W854_Task9" name="Activate pandemic response plan — CEO convenes crisis management team; declare…">
        <bpmn:documentation>Step 1: Activate pandemic response plan — CEO convenes crisis management team; declare pandemic operating mode; establish daily situation briefings and weekly strategy reviews
Responsible (R): CEO
Accountable (A): Board of Directors
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W854_Flow20</bpmn:incoming>
        <bpmn:outgoing>W854_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W854_Task10" name="Implement workplace safety protocols — mandatory masking, social distancing…">
        <bpmn:documentation>Step 2: Implement workplace safety protocols — mandatory masking, social distancing (store capacity limits), temperature screening, sanitation stations, contact tracing, and isolation rooms at each location
Responsible (R): CHRO
Accountable (A): COO
Duration: 1 week deployment</bpmn:documentation>
        <bpmn:incoming>W854_Flow21</bpmn:incoming>
        <bpmn:outgoing>W854_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W854_Task11" name="Activate remote work for HQ/support functions — deploy VPN and collaboration…">
        <bpmn:documentation>Step 3: Activate remote work for HQ/support functions — deploy VPN and collaboration tools for all non-store employees; maintain skeleton crew at HQ for essential on-site functions
Responsible (R): CIO
Accountable (A): COO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W854_Flow22</bpmn:incoming>
        <bpmn:outgoing>W854_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W854_Task12" name="Adjust store operations — reduced operating hours, BOPIS/curbside pickup…">
        <bpmn:documentation>Step 4: Adjust store operations — reduced operating hours, BOPIS/curbside pickup emphasis, contactless payment promotion, queue management, and vulnerable population shopping hours
Responsible (R): COO
Accountable (A): CEO
Duration: Immediate</bpmn:documentation>
        <bpmn:incoming>W854_Flow23</bpmn:incoming>
        <bpmn:outgoing>W854_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W854_Task13" name="Manage workforce availability — track employee health status (anonymized)…">
        <bpmn:documentation>Step 5: Manage workforce availability — track employee health status (anonymized), activate cross-training for critical roles, hire temporary staff for increased sanitation, and manage leave policies (quarantine, isolation, caregiving)
Responsible (R): CHRO
Accountable (A): COO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W854_Flow24</bpmn:incoming>
        <bpmn:outgoing>W854_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W854_Task14" name="Activate supply chain pandemic protocols — prioritize essential categories…">
        <bpmn:documentation>Step 6: Activate supply chain pandemic protocols — prioritize essential categories (sanitizers, PPE, building materials for home improvement), implement purchase limits for high-demand items, coordinate with vendors for supply continuity
Responsible (R): VP Supply Chain
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W854_Flow25</bpmn:incoming>
        <bpmn:outgoing>W854_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W854_Task15" name="Financial impact management — daily cash flow monitoring, expense reduction…">
        <bpmn:documentation>Step 7: Financial impact management — daily cash flow monitoring, expense reduction activation, government subsidy application (DOLE, SSS), rent renegotiation with landlords, and investor communication
Responsible (R): CFO
Accountable (A): CEO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W854_Flow26</bpmn:incoming>
        <bpmn:outgoing>W854_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W854_Task16" name="Deactivation and recovery — transition to post-pandemic operations as DOH…">
        <bpmn:documentation>Step 8: Deactivation and recovery — transition to post-pandemic operations as DOH guidance permits; phased return to normal operations; employee wellness support program; capture lessons learned
Responsible (R): COO
Accountable (A): CEO
Duration: 1–3 months</bpmn:documentation>
        <bpmn:incoming>W854_Flow27</bpmn:incoming>
        <bpmn:outgoing>W854_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W854_End17" name="Complete">
        <bpmn:incoming>W854_Flow28</bpmn:incoming>
      </bpmn:endEvent>
