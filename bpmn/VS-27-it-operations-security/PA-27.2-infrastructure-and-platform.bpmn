        <bpmn:flowNodeRef>W369_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W369_Start3" name="Monthly SLA report from vendor; vendor service disruption; or contract renewal milestone">
        <bpmn:outgoing>W369_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W369_Task4" name="SLA Monitoring">
        <bpmn:documentation>Step 1: SLA Monitoring: Collect monthly performance data from vendors (uptime, latency, resolution time) vs. contractual targets
Responsible (R): IT Vendor Mgr
Accountable (A): IT Vendor Mgr
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W369_Flow11</bpmn:incoming>
        <bpmn:outgoing>W369_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W369_Task5" name="Dispute Management">
        <bpmn:documentation>Step 2: Dispute Management: If SLA is breached, initiate service credit claim process per contract terms; track &quot;SLA Debt&quot;
Responsible (R): IT Vendor Mgr
Accountable (A): CIO
Duration: 2 hours/breach</bpmn:documentation>
        <bpmn:incoming>W369_Flow12</bpmn:incoming>
        <bpmn:outgoing>W369_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W369_Task6" name="Vendor Governance Meeting">
        <bpmn:documentation>Step 3: Vendor Governance Meeting: Conduct monthly review with Tier 1 vendors (e.g., PLDT, AWS, Microsoft) to review incidents and roadmaps
Responsible (R): IT Vendor Mgr
Accountable (A): CIO
Duration: 1 hour/vendor</bpmn:documentation>
        <bpmn:incoming>W369_Flow13</bpmn:incoming>
        <bpmn:outgoing>W369_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W369_Task7" name="Risk Assessment">
        <bpmn:documentation>Step 4: Risk Assessment: Annual review of vendor financial health, compliance certifications (SOC2, etc.), and concentration risk
Responsible (R): IT Vendor Mgr
Accountable (A): CIO
Duration: 8 hours/year</bpmn:documentation>
        <bpmn:incoming>W369_Flow14</bpmn:incoming>
        <bpmn:outgoing>W369_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W369_End8" name="Complete">
        <bpmn:incoming>W369_Flow15</bpmn:incoming>
      </bpmn:endEvent>
