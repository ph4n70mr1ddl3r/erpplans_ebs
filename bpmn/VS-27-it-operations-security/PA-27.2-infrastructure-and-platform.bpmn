        <bpmn:flowNodeRef>W5519_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5519_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5519_Lane4" name="IT Infra Lead">
        <bpmn:flowNodeRef>W5519_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5519_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5519_Start6" name="Store or HQ telephony fault (W48 ticket); new-store telephony build (VS-37); extension…">
        <bpmn:outgoing>W5519_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W5519_Task7" name="Monitoring">
        <bpmn:documentation>Step 1: Monitoring: Continuous SIP-trunk availability &amp; call-quality watch (latency/jitter via W366 SD-WAN QoS); degradation auto-tickets to W48 with circuit context
Responsible (R): System / Network Engineer
Accountable (A): IT Infra Mgr
Duration: 10 min/day review</bpmn:documentation>
        <bpmn:incoming>W5519_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5519_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W5519_Task8" name="Moves/adds/changes">
        <bpmn:documentation>Step 2: Moves/adds/changes: Fulfil extension changes, handset swaps, voicemail, auto-attendant &amp; ring-group updates from W48-approved tickets
Responsible (R): IT Helpdesk
Accountable (A): IT Infra Mgr
Duration: 20 min/MAC × ~40/month</bpmn:documentation>
        <bpmn:incoming>W5519_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5519_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5519_Task9" name="Store-telephony lifecycle">
        <bpmn:documentation>Step 3: Store-telephony lifecycle: Handset standardization &amp; deployment with the VS-99 device program (W3236); new-store telephony build per the VS-37 checklist (extensions, auto-attendant, emergency numbers)
Responsible (R): Network Engineer / IT Asset Coordinator
Accountable (A): IT Infra Mgr
Duration: Per store event (VS-37)</bpmn:documentation>
        <bpmn:incoming>W5519_Flow18</bpmn:incoming>
        <bpmn:outgoing>W5519_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5519_Task10" name="Continuity failover">
        <bpmn:documentation>Step 4: Continuity failover: Maintain the call-forwarding runbook to mobile/alternate routes during store ISP or POS outages (links to W55/W1531/VS-69); quarterly failover test
Responsible (R): Network Engineer / Store Manager
Accountable (A): IT Infra Mgr
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W5519_Flow19</bpmn:incoming>
        <bpmn:outgoing>W5519_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5519_Task11" name="Contact-center slice &amp; carrier reconciliation">
        <bpmn:documentation>Step 5: Contact-center slice &amp; carrier reconciliation: Maintain the telephony-queue integration consumed by the CS omnichannel platform (PA-13.1); reconcile carrier circuits &amp; invoices to W369
Responsible (R): IT Infra Lead
Accountable (A): IT Infra Mgr
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W5519_Flow20</bpmn:incoming>
        <bpmn:outgoing>W5519_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5519_Task12" name="Annual extension &amp; billing audit">
        <bpmn:documentation>Step 6: Annual extension &amp; billing audit: Reconcile active extensions against the HR/role master and carrier bills; retire dormant numbers
Responsible (R): IT Helpdesk / IT Infra Lead
Accountable (A): IT Infra Mgr
Duration: 24 hours/year</bpmn:documentation>
        <bpmn:incoming>W5519_Flow21</bpmn:incoming>
        <bpmn:outgoing>W5519_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5519_End13" name="Complete">
        <bpmn:incoming>W5519_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5519_Annotation14">
        <bpmn:text>Controls: - CTL-323 (ensure controlled execution — Infrastructure &amp; Platform (PA-27.2).) | - operational: MACs fulfilled only from W48-approved tickets | - operational: annual extension audit reconciles carrier billing to the role master
Owner: IT Infrastructure Manager</bpmn:text>
      </bpmn:textAnnotation>
