    <bpmn:process id="W_W373" name="W373. IT FinOps &amp; Cloud Cost Management" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly cloud invoice; budget variance alert; or major project kickoff
Frequency: Weekly monitoring; monthly reconciliation
Volume: ~PHP 2M - 5M monthly cloud/IT spend
Owner: IT FinOps Analyst / CIO
Participants: Cloud Architect, Finance Controller, Project Managers
Source: workflow W373 — IT FinOps &amp; Cloud Cost Management</bpmn:documentation>
      <bpmn:laneSet id="W373_LaneSet3">
        <bpmn:lane id="W373_Lane1" name="Cloud Arch">
        <bpmn:flowNodeRef>W373_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W373_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W373_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W373_Lane2" name="IT FinOps Analyst">
        <bpmn:flowNodeRef>W373_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W373_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W373_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W373_Start4" name="Monthly cloud invoice; budget variance alert; or major project kickoff">
        <bpmn:outgoing>W373_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W373_Task5" name="Cost Allocation">
        <bpmn:documentation>Step 1: Cost Allocation: Tag all cloud resources by Department/Project to enable granular showback/chargeback
Responsible (R): Cloud Arch
Accountable (A): IT FinOps Analyst
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W373_Flow12</bpmn:incoming>
        <bpmn:outgoing>W373_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W373_Task6" name="Weekly Burn Review">
        <bpmn:documentation>Step 2: Weekly Burn Review: Review cloud spend trends; identify unexpected spikes or &quot;orphaned&quot; resources
Responsible (R): IT FinOps Analyst
Accountable (A): CIO
Duration: 1 hour/week</bpmn:documentation>
        <bpmn:incoming>W373_Flow13</bpmn:incoming>
        <bpmn:outgoing>W373_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W373_Task7" name="Optimization Actions">
        <bpmn:documentation>Step 3: Optimization Actions: Execute right-sizing, reserved instance (RI) purchases, or spot instance usage
Responsible (R): Cloud Arch
Accountable (A): CIO
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W373_Flow14</bpmn:incoming>
        <bpmn:outgoing>W373_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W373_Task8" name="Budget Reconciliation">
        <bpmn:documentation>Step 4: Budget Reconciliation: Reconcile actual IT spend (SaaS + Cloud + Maintenance) vs. budget; explain variances
Responsible (R): IT FinOps Analyst
Accountable (A): CIO
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W373_Flow15</bpmn:incoming>
        <bpmn:outgoing>W373_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W373_End9" name="Complete">
        <bpmn:incoming>W373_Flow16</bpmn:incoming>
      </bpmn:endEvent>
