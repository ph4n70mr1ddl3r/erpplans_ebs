    <bpmn:process id="W_W395" name="W395. Mobile App Store Management (Public &amp; Enterprise)" isExecutable="false">
      <bpmn:documentation>Trigger: New mobile app version release (Ecommerce, Loyalty, mPOS)
Frequency: Monthly or per release
Volume: Managing ~3–5 active apps across iOS and Android
Owner: Mobility Lead
Participants: App Developers, Marketing, Security Admin
Source: workflow W395 — Mobile App Store Management (Public &amp; Enterprise)</bpmn:documentation>
      <bpmn:laneSet id="W395_LaneSet4">
        <bpmn:lane id="W395_Lane1" name="Developer">
        <bpmn:flowNodeRef>W395_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W395_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W395_Lane2" name="Security Admin">
        <bpmn:flowNodeRef>W395_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W395_Lane3" name="Mobility Lead">
        <bpmn:flowNodeRef>W395_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W395_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W395_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W395_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W395_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W395_Start5" name="New mobile app version release (Ecommerce, Loyalty, mPOS)">
        <bpmn:outgoing>W395_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W395_Task6" name="Build Preparation">
        <bpmn:documentation>Step 1: Build Preparation: Prepare app binaries, release notes, and store assets (screenshots, descriptions)
Responsible (R): Developer
Accountable (A): Mobility Lead
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W395_Flow15</bpmn:incoming>
        <bpmn:outgoing>W395_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W395_Task7" name="Security Review">
        <bpmn:documentation>Step 2: Security Review: Conduct static and dynamic analysis of the build for vulnerabilities
Responsible (R): Security Admin
Accountable (A): CIO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W395_Flow16</bpmn:incoming>
        <bpmn:outgoing>W395_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W395_Task8" name="Store Submission">
        <bpmn:documentation>Step 3: Store Submission: Upload to Apple App Store (App Store Connect) and Google Play Console
Responsible (R): Mobility Lead
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W395_Flow17</bpmn:incoming>
        <bpmn:outgoing>W395_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W395_Task9" name="Review Management">
        <bpmn:documentation>Step 4: Review Management: Monitor store review status; address any rejections or feedback from Apple/Google
Responsible (R): Mobility Lead
Accountable (A): Developer
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W395_Flow18</bpmn:incoming>
        <bpmn:outgoing>W395_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W395_Task10" name="Release Execution">
        <bpmn:documentation>Step 5: Release Execution: Trigger &quot;Phased Release&quot; (e.g., 1% -&gt; 10% -&gt; 100%) to monitor for production crashes
Responsible (R): Mobility Lead
Accountable (A): App Manager
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W395_Flow19</bpmn:incoming>
        <bpmn:outgoing>W395_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W395_Task11" name="Internal App Distribution">
        <bpmn:documentation>Step 6: Internal App Distribution: Deploy enterprise-only apps (mPOS, WMS) via MDM (W371) to corporate devices
Responsible (R): Mobility Lead
Accountable (A): IT Ops
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W395_Flow20</bpmn:incoming>
        <bpmn:outgoing>W395_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W395_End12" name="Complete">
        <bpmn:incoming>W395_Flow21</bpmn:incoming>
      </bpmn:endEvent>
