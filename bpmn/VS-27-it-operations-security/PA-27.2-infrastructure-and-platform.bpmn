<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-27.2-infrastructure-and-platform" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W55" name="W55. IT Disaster Recovery &amp; System Failover" isExecutable="false">
      <bpmn:documentation>Trigger: Core ERP system failure exceeding RTO (4 hours per NFR-013), data center outage, cloud service disruption, or cyber attack causing system unavailability
Frequency: Rare; estimated 0–2 DR events/year requiring failover
Volume: Affects all ~6,762 employees (~1,500 named ERP users); 600 POS terminals; 200 stores; 4 DCs
Owner: CIO
Participants: CIO, IT Infrastructure team, IT Helpdesk, VP Store Operations, CFO, external DR service provider
Source: workflow W55 — IT Disaster Recovery &amp; System Failover</bpmn:documentation>
      <bpmn:laneSet id="W55_LaneSet8">
        <bpmn:lane id="W55_Lane1" name="IT Infrastructure">
        <bpmn:flowNodeRef>W55_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W55_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W55_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W55_Task21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W55_Start9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W55_Lane2" name="IT Infrastructure Lead">
        <bpmn:flowNodeRef>W55_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W55_Lane3" name="CIO">
        <bpmn:flowNodeRef>W55_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W55_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W55_Task20</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W55_Lane4" name="Store Manager">
        <bpmn:flowNodeRef>W55_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W55_Lane5" name="DC Manager">
        <bpmn:flowNodeRef>W55_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W55_Lane6" name="Ecom Team">
        <bpmn:flowNodeRef>W55_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W55_Lane7" name="IT Infrastructure + Finance">
        <bpmn:flowNodeRef>W55_Task19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W55_End22</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W55_Start9" name="Core ERP system failure exceeding RTO (4 hours per NFR-013), data center outage, cloud…">
        <bpmn:outgoing>W55_Flow25</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W55_Task10" name="IT Infrastructure monitoring detects or is alerted to system failure: error…">
        <bpmn:documentation>Step 1: IT Infrastructure monitoring detects or is alerted to system failure: error rates, service health checks, connectivity loss, or user reports of system unavailability
Responsible (R): IT Infrastructure / System
Accountable (A): CIO
Duration: Immediate (automated detection)</bpmn:documentation>
        <bpmn:incoming>W55_Flow25</bpmn:incoming>
        <bpmn:outgoing>W55_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W55_Task11" name="IT Infrastructure assesses scope and severity: (a) single module failure (e.g…">
        <bpmn:documentation>Step 2: IT Infrastructure assesses scope and severity: (a) single module failure (e.g., POS integration down), (b) full ERP outage, (c) data center / cloud region outage, (d) suspected cyber attack (ransomware, DDoS)
Responsible (R): IT Infrastructure Lead
Accountable (A): CIO
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W55_Flow26</bpmn:incoming>
        <bpmn:outgoing>W55_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W55_Task12" name="CIO declares DR event if severity exceeds RTO: notifies CEO, COO, CFO…">
        <bpmn:documentation>Step 3: CIO declares DR event if severity exceeds RTO: notifies CEO, COO, CFO; communicates estimated recovery time; VP Store Operations notifies Regional Managers and Store Managers
Responsible (R): CIO
Accountable (A): CEO
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W55_Flow27</bpmn:incoming>
        <bpmn:outgoing>W55_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W55_Task13" name="Stores">
        <bpmn:documentation>Step 4: Stores: continue selling in offline mode per W5G; POS transactions queue locally for upload upon recovery
Responsible (R): Store Manager
Accountable (A): VP Store Operations
Duration: Automated (W5G)</bpmn:documentation>
        <bpmn:incoming>W55_Flow28</bpmn:incoming>
        <bpmn:outgoing>W55_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W55_Task14" name="DCs">
        <bpmn:documentation>Step 5: DCs: DC operations shift to manual processing — Receiving Clerks record goods receipts on paper/spreadsheet for batch entry upon recovery; picking and shipping suspended for non-critical orders
Responsible (R): DC Manager
Accountable (A): Supply Chain Manager
Duration: Manual fallback</bpmn:documentation>
        <bpmn:incoming>W55_Flow29</bpmn:incoming>
        <bpmn:outgoing>W55_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W55_Task15" name="Ecommerce">
        <bpmn:documentation>Step 6: Ecommerce: Digital Commerce platform displays maintenance notification; new orders suspended; in-progress orders held for fulfillment upon recovery
Responsible (R): Ecom Team
Accountable (A): CMO
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W55_Flow30</bpmn:incoming>
        <bpmn:outgoing>W55_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W55_Task16" name="Recovery execution">
        <bpmn:documentation>Step 7: Recovery execution: IT Infrastructure initiates failover to DR site or secondary cloud region: (a) verify DR environment is current (data replication lag ≤ RPO), (b) switch DNS and network routing to DR environment, (c) validate core services: authentication, POS sync, inventory, financial posting, (d) incremental data replay from primary if replication lag exists
Responsible (R): IT Infrastructure
Accountable (A): CIO
Duration: 1–3 hours</bpmn:documentation>
        <bpmn:incoming>W55_Flow31</bpmn:incoming>
        <bpmn:outgoing>W55_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W55_Task17" name="If primary system restore (instead of failover): (a) identify root cause, (b)…">
        <bpmn:documentation>Step 8: If primary system restore (instead of failover): (a) identify root cause, (b) repair or restore from backup, (c) verify data integrity against last known good checkpoint, (d) bring services online sequentially (core first, then ancillary), (e) validate system health
Responsible (R): IT Infrastructure
Accountable (A): CIO
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W55_Flow32</bpmn:incoming>
        <bpmn:outgoing>W55_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W55_Task18" name="System restored: CIO communicates &quot;all clear&quot; to business; stores begin…">
        <bpmn:documentation>Step 9: System restored: CIO communicates &quot;all clear&quot; to business; stores begin uploading offline transactions per W5G; DCs batch-enter manual receipts; ecommerce resumes order processing
Responsible (R): CIO
Accountable (A): CEO
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W55_Flow33</bpmn:incoming>
        <bpmn:outgoing>W55_Flow34</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W55_Task19" name="Data integrity verification">
        <bpmn:documentation>Step 10: Data integrity verification: IT runs reconciliation checks: (a) offline POS transactions vs. central inventory, (b) any manual DC entries vs. expected receipts, (c) database transaction logs for completeness, (d) financial posting integrity (no partial journal entries)
Responsible (R): IT Infrastructure + Finance
Accountable (A): Controller
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W55_Flow34</bpmn:incoming>
        <bpmn:outgoing>W55_Flow35</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W55_Task20" name="Post-recovery: CIO conducts root cause analysis within 5 business days…">
        <bpmn:documentation>Step 11: Post-recovery: CIO conducts root cause analysis within 5 business days; documents incident, root cause, recovery actions, data loss (if any), and preventive measures
Responsible (R): CIO
Accountable (A): CEO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W55_Flow35</bpmn:incoming>
        <bpmn:outgoing>W55_Flow36</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W55_Task21" name="Quarterly: IT Infrastructure conducts scheduled DR failover test during…">
        <bpmn:documentation>Step 12: Quarterly: IT Infrastructure conducts scheduled DR failover test during maintenance window; validates RTO and RPO targets; documents test results; updates DR runbook based on findings
Responsible (R): IT Infrastructure
Accountable (A): CIO
Duration: 4 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W55_Flow36</bpmn:incoming>
        <bpmn:outgoing>W55_Flow37</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W55_End22" name="Complete">
        <bpmn:incoming>W55_Flow37</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W55_Annotation23">
        <bpmn:text>Controls: - CTL-323 (ensure controlled execution — Infrastructure &amp; Platform (PA-27.2).) | - operational: periodic reconciliation against source documents
Owner: CIO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W55_Assoc24" sourceRef="W55_Annotation23" targetRef="W55_Start9" associationDirection="None" />
      <bpmn:sequenceFlow id="W55_Flow25" sourceRef="W55_Start9" targetRef="W55_Task10" />
