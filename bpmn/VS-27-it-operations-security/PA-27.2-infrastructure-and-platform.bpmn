    <bpmn:process id="W_W396" name="W396. ERP Data Archiving &amp; Database Tiering Operational Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Database size exceeding performance thresholds; or annual archiving cycle
Frequency: Annual (Full); Quarterly (Log purging)
Volume: Archiving millions of transaction records
Owner: Database Administrator (DBA)
Participants: Finance Controller, IT Infrastructure Manager
Source: workflow W396 — ERP Data Archiving &amp; Database Tiering Operational Execution</bpmn:documentation>
      <bpmn:laneSet id="W396_LaneSet3">
        <bpmn:lane id="W396_Lane1" name="DBA">
        <bpmn:flowNodeRef>W396_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W396_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W396_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W396_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W396_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W396_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W396_Lane2" name="Cloud Arch">
        <bpmn:flowNodeRef>W396_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W396_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W396_Start4" name="Database size exceeding performance thresholds; or annual archiving cycle">
        <bpmn:outgoing>W396_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W396_Task5" name="Archiving Scope">
        <bpmn:documentation>Step 1: Archiving Scope: Identify technical data (logs, temp tables) and business data (old POs, GL entries) for archiving per W256
Responsible (R): DBA
Accountable (A): Finance Controller
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W396_Flow14</bpmn:incoming>
        <bpmn:outgoing>W396_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W396_Task6" name="Consistency Check">
        <bpmn:documentation>Step 2: Consistency Check: Verify data integrity and cross-module links before archiving
Responsible (R): DBA
Accountable (A): —
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W396_Flow15</bpmn:incoming>
        <bpmn:outgoing>W396_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W396_Task7" name="Archiving Run">
        <bpmn:documentation>Step 3: Archiving Run: Execute archiving job to move data from active DB to &quot;Archive&quot; tables or cold storage
Responsible (R): DBA
Accountable (A): Infra Mgr
Duration: 8–12 hours</bpmn:documentation>
        <bpmn:incoming>W396_Flow16</bpmn:incoming>
        <bpmn:outgoing>W396_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W396_Task8" name="Tiering Optimization">
        <bpmn:documentation>Step 4: Tiering Optimization: Move archived data to lower-cost storage (e.g., S3 Glacier) while maintaining read access
Responsible (R): Cloud Arch
Accountable (A): CIO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W396_Flow17</bpmn:incoming>
        <bpmn:outgoing>W396_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W396_Task9" name="Validation">
        <bpmn:documentation>Step 5: Validation: Verify that archived data is still accessible for audit/reporting via the archiving viewer
Responsible (R): DBA
Accountable (A): Finance Controller
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W396_Flow18</bpmn:incoming>
        <bpmn:outgoing>W396_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W396_Task10" name="DB Shrink/Index">
        <bpmn:documentation>Step 6: DB Shrink/Index: Reorganize database indexes and reclaim white space to improve active system performance
Responsible (R): DBA
Accountable (A): —
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W396_Flow19</bpmn:incoming>
        <bpmn:outgoing>W396_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W396_End11" name="Complete">
        <bpmn:incoming>W396_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W396_Annotation12">
        <bpmn:text>Controls: - CTL-323 (ensure controlled execution — Infrastructure &amp; Platform (PA-27.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Database Administrator (DBA)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W396_Assoc13" sourceRef="W396_Annotation12" targetRef="W396_Start4" associationDirection="None" />
