    <bpmn:process id="W_W376" name="W376. IT Capacity &amp; Performance Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly review cycle; system performance threshold alert (NFR-004); or 80% utilization alert
Frequency: Quarterly
Volume: Monitoring 200+ stores, 4 DCs, and cloud infrastructure (~150+ instances)
Owner: IT Infrastructure Manager
Participants: Cloud Architect, Database Administrator, Network Engineer, CIO, Finance (Budgeting)
Source: workflow W376 — IT Capacity &amp; Performance Planning</bpmn:documentation>
      <bpmn:laneSet id="W376_LaneSet5">
        <bpmn:lane id="W376_Lane1" name="IT Infra Lead">
        <bpmn:flowNodeRef>W376_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W376_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
