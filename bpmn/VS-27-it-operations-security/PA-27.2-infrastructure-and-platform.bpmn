      <bpmn:sequenceFlow id="W396_Flow16" sourceRef="W396_Task6" targetRef="W396_Task7" />
      <bpmn:sequenceFlow id="W396_Flow17" sourceRef="W396_Task7" targetRef="W396_Task8" />
      <bpmn:sequenceFlow id="W396_Flow18" sourceRef="W396_Task8" targetRef="W396_Task9" />
      <bpmn:sequenceFlow id="W396_Flow19" sourceRef="W396_Task9" targetRef="W396_Task10" />
      <bpmn:sequenceFlow id="W396_Flow20" sourceRef="W396_Task10" targetRef="W396_End11" />
    </bpmn:process>
