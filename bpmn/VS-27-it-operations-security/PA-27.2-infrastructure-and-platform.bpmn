      <bpmn:startEvent id="W376_Start6" name="Quarterly review cycle; system performance threshold alert (NFR-004); or 80% utilization…">
        <bpmn:outgoing>W376_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W376_Task7" name="Utilization Baselining">
        <bpmn:documentation>Step 1: Utilization Baselining: Extract 90-day utilization data for compute, storage, memory, and bandwidth across all core systems
Responsible (R): IT Infra Lead
Accountable (A): IT Infra Mgr
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W376_Flow16</bpmn:incoming>
        <bpmn:outgoing>W376_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W376_Task8" name="Growth Projection">
        <bpmn:documentation>Step 2: Growth Projection: Review business roadmap (new stores W16, ecommerce growth, peak season 12.12) to project future resource needs
Responsible (R): IT Infra Mgr
Accountable (A): CIO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W376_Flow17</bpmn:incoming>
        <bpmn:outgoing>W376_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W376_Task9" name="Gap Analysis">
        <bpmn:documentation>Step 3: Gap Analysis: Compare projected demand against current limits; identify potential bottlenecks (e.g., DB storage will hit 90% in 4 months)
Responsible (R): Cloud Architect / DBA
Accountable (A): IT Infra Mgr
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W376_Flow18</bpmn:incoming>
        <bpmn:outgoing>W376_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W376_Task10" name="Optimization Review">
        <bpmn:documentation>Step 4: Optimization Review: (Cross-ref W368.2) Identify underutilized resources that can be downsized to free up budget/capacity
Responsible (R): Cloud Architect
Accountable (A): CIO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W376_Flow19</bpmn:incoming>
        <bpmn:outgoing>W376_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W376_Task11" name="Scaling Recommendation">
        <bpmn:documentation>Step 5: Scaling Recommendation: Prepare upgrade plan: (a) vertical scaling (larger instances), (b) horizontal scaling (more nodes), (c) cloud budget adjustment (W373)
Responsible (R): IT Infra Mgr
Accountable (A): CIO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W376_Flow20</bpmn:incoming>
        <bpmn:outgoing>W376_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W376_Task12" name="Implementation">
        <bpmn:documentation>Step 6: Implementation: Execute scaling actions during maintenance windows; update NFR monitoring thresholds
Responsible (R): IT Infrastructure
Accountable (A): IT Infra Mgr
Duration: Per change</bpmn:documentation>
        <bpmn:incoming>W376_Flow21</bpmn:incoming>
        <bpmn:outgoing>W376_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W376_End13" name="Complete">
        <bpmn:incoming>W376_Flow22</bpmn:incoming>
      </bpmn:endEvent>
