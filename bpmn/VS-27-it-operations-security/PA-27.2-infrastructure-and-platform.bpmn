    <bpmn:process id="W_W369" name="W369. IT Vendor SLA Governance &amp; Performance Management" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly SLA report from vendor; vendor service disruption; or contract renewal milestone
Frequency: Monthly review; annual performance audit
Volume: ~20 critical IT vendors (ISP, Cloud, SaaS, Hardware Maintenance)
Owner: IT Vendor Manager
Participants: CIO, IT Infrastructure Lead, Procurement, Legal
Source: workflow W369 — IT Vendor SLA Governance &amp; Performance Management</bpmn:documentation>
      <bpmn:laneSet id="W369_LaneSet2">
        <bpmn:lane id="W369_Lane1" name="IT Vendor Mgr">
        <bpmn:flowNodeRef>W369_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W369_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W369_Task6</bpmn:flowNodeRef>
