        <bpmn:flowNodeRef>W5518_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5518_Start7" name="Tenant incident or service-health degradation (mail-flow delay, Teams outage); new-hire…">
        <bpmn:outgoing>W5518_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W5518_Task8" name="Monitoring">
        <bpmn:documentation>Step 1: Monitoring: Daily tenant service-health &amp; mail-flow watch (M365 Service Health Dashboard, Exchange Online message trace, quarantine triage, anti-spoofing/DMARC aggregate-report review); anomalies auto-ticket to W48
Responsible (R): System / IT Helpdesk
Accountable (A): IT Infra Mgr
Duration: 20 min/day</bpmn:documentation>
        <bpmn:incoming>W5518_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5518_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W5518_Task9" name="Email-security operations">
        <bpmn:documentation>Step 2: Email-security operations: Release/deny phishing-quarantine requests from W48 tickets; update spoof/impersonation protections; enforce DMARC/DKIM/SPF across owned domains (links to W377 domain portfolio)
Responsible (R): Security Analyst
Accountable (A): IT Security Mgr
Duration: 1 hour/week</bpmn:documentation>
        <bpmn:incoming>W5518_Flow18</bpmn:incoming>
        <bpmn:outgoing>W5518_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5518_Task10" name="Identity &amp; security-baseline governance">
        <bpmn:documentation>Step 3: Identity &amp; security-baseline governance: Conditional-access/MFA enforcement aligned to the W393 zero-trust policy; external-sharing defaults; third-party OAuth consent review; privileged-role hygiene with W375
Responsible (R): Security Analyst / App Manager
Accountable (A): IT Infra Mgr
Duration: 4 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W5518_Flow19</bpmn:incoming>
        <bpmn:outgoing>W5518_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5518_Task11" name="Lifecycle operations">
        <bpmn:documentation>Step 4: Lifecycle operations: Mailbox/Teams/SharePoint provisioning &amp; de-provisioning synced from W152 joiner-mover-leaver events; exceptions (shared mailboxes, resource calendars, distribution lists) handled manually
Responsible (R): IT Helpdesk
Accountable (A): IT Infra Mgr
Duration: 15 min/exception × ~40/month</bpmn:documentation>
        <bpmn:incoming>W5518_Flow20</bpmn:incoming>
        <bpmn:outgoing>W5518_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5518_Task12" name="Collaboration-sprawl &amp; intranet governance">
        <bpmn:documentation>Step 5: Collaboration-sprawl &amp; intranet governance: Teams/SharePoint site lifecycle (orphaned-site review, guest-access expiry, storage/quota); intranet/employee-portal platform support (content owned by Internal Communications per VS-19)
Responsible (R): IT Infra Lead
Accountable (A): IT Infra Mgr
Duration: 3 hours/month</bpmn:documentation>
        <bpmn:incoming>W5518_Flow21</bpmn:incoming>
        <bpmn:outgoing>W5518_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5518_Task13" name="Tenant-service review">
        <bpmn:documentation>Step 6: Tenant-service review: Microsoft roadmap/change advisory, license-position feed to W370/W3243, CSP billing-variance check
Responsible (R): IT Infra Mgr / IT Helpdesk
Accountable (A): CIO
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W5518_Flow22</bpmn:incoming>
        <bpmn:outgoing>W5518_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5518_End14" name="Complete">
        <bpmn:incoming>W5518_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5518_Annotation15">
        <bpmn:text>Controls: - CTL-323 (ensure controlled execution — Infrastructure &amp; Platform (PA-27.2).) | - operational: tenant configuration changes ride W1409 CAB approval | - operational: quarterly OAuth consent-review gate before external app grants are renewed
Owner: IT Infrastructure Manager</bpmn:text>
      </bpmn:textAnnotation>
