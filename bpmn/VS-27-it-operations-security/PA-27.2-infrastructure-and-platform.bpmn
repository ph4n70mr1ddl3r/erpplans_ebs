    <bpmn:process id="W_W366" name="W366. Network Infrastructure &amp; Connectivity Management" isExecutable="false">
      <bpmn:documentation>Trigger: Network latency alert; ISP outage notification; new location setup (W16); or scheduled maintenance
Frequency: Continuous monitoring; daily management
Volume: 200 stores; 4 DCs; 1 HQ; ~200+ SD-WAN nodes; ~400+ ISP circuits (primary/secondary)
Owner: IT Infrastructure Manager
Participants: IT Infrastructure Lead, Network Engineers, ISP Account Managers, Store Managers
Source: workflow W366 — Network Infrastructure &amp; Connectivity Management</bpmn:documentation>
      <bpmn:laneSet id="W366_LaneSet4">
        <bpmn:lane id="W366_Lane1" name="System">
        <bpmn:flowNodeRef>W366_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W366_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W366_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W366_Lane2" name="Network Engineer">
        <bpmn:flowNodeRef>W366_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W366_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W366_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W366_Lane3" name="IT Infra Lead">
        <bpmn:flowNodeRef>W366_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W366_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W366_Start5" name="Network latency alert; ISP outage notification; new location setup (W16); or scheduled…">
        <bpmn:outgoing>W366_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W366_Task6" name="Monitoring">
        <bpmn:documentation>Step 1: Monitoring: System monitors all 200+ nodes via SD-WAN dashboard; tracks latency, packet loss, and circuit health (Primary vs. Secondary)
Responsible (R): System
Accountable (A): IT Infra Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W366_Flow15</bpmn:incoming>
        <bpmn:outgoing>W366_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W366_Task7" name="Outage Detection">
        <bpmn:documentation>Step 2: Outage Detection: If circuit fails, system auto-switches to secondary (e.g., PLDT to Globe or Starlink); generates &quot;Failover Alert&quot; to IT Helpdesk
Responsible (R): System
Accountable (A): —
Duration: Immediate</bpmn:documentation>
        <bpmn:incoming>W366_Flow16</bpmn:incoming>
        <bpmn:outgoing>W366_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W366_Task8" name="ISP Escalation">
        <bpmn:documentation>Step 3: ISP Escalation: Network Engineer contacts ISP for primary circuit restoration; tracks ticket until resolution; monitors SLA credits if uptime falls below the 99.9% SLA
Responsible (R): Network Engineer
Accountable (A): IT Infra Mgr
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W366_Flow17</bpmn:incoming>
        <bpmn:outgoing>W366_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W366_Task9" name="Store Wi-Fi Management">
        <bpmn:documentation>Step 4: Store Wi-Fi Management: Manage guest vs. corporate Wi-Fi; ensure RF devices (WMS) and mPOS have prioritized bandwidth (QoS)
Responsible (R): Network Engineer
Accountable (A): IT Infra Lead
Duration: 1 hour/week</bpmn:documentation>
        <bpmn:incoming>W366_Flow18</bpmn:incoming>
        <bpmn:outgoing>W366_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W366_Task10" name="Hardware Maintenance">
        <bpmn:documentation>Step 5: Hardware Maintenance: Periodic firmware updates for routers, switches, and APs; physical inspections of network racks in stores during PM (W265)
Responsible (R): Network Engineer
Accountable (A): IT Infra Mgr
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W366_Flow19</bpmn:incoming>
        <bpmn:outgoing>W366_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W366_Task11" name="Bandwidth Optimization">
        <bpmn:documentation>Step 6: Bandwidth Optimization: During peak events (12.12, paydays), IT increases bandwidth or implements stricter traffic shaping to protect POS/payment traffic
Responsible (R): IT Infra Lead
Accountable (A): CIO
Duration: 2 hours/event</bpmn:documentation>
        <bpmn:incoming>W366_Flow20</bpmn:incoming>
        <bpmn:outgoing>W366_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W366_End12" name="Complete">
        <bpmn:incoming>W366_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W366_Annotation13">
        <bpmn:text>Controls: - CTL-323 (ensure controlled execution — Infrastructure &amp; Platform (PA-27.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: IT Infrastructure Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W366_Assoc14" sourceRef="W366_Annotation13" targetRef="W366_Start5" associationDirection="None" />
