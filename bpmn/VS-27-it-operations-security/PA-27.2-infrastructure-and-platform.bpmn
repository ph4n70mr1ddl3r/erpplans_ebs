    <bpmn:process id="W_W368" name="W368. Database &amp; Cloud Infrastructure Management" isExecutable="false">
      <bpmn:documentation>Trigger: Performance threshold alert; cloud cost budget alert; or scheduled maintenance
Frequency: Continuous monitoring; monthly optimization
Volume: ~50TB+ data; 55K SKUs; ~150+ cloud instances/services
Owner: Cloud / Database Architect
Participants: DBA, DevOps Engineer, Finance (IT Budgeting)
Source: workflow W368 — Database &amp; Cloud Infrastructure Management</bpmn:documentation>
      <bpmn:laneSet id="W368_LaneSet4">
        <bpmn:lane id="W368_Lane1" name="DBA">
        <bpmn:flowNodeRef>W368_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W368_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W368_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W368_Lane2" name="Cloud Architect">
        <bpmn:flowNodeRef>W368_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W368_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W368_Lane3" name="DevOps Engineer">
        <bpmn:flowNodeRef>W368_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W368_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W368_Start5" name="Performance threshold alert; cloud cost budget alert; or scheduled maintenance">
        <bpmn:outgoing>W368_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W368_Task6" name="Performance Tuning">
        <bpmn:documentation>Step 1: Performance Tuning: Monitor database query performance; optimize slow queries; manage indexing and vacuuming to maintain ERP speed (NFR-003)
Responsible (R): DBA
Accountable (A): IT Infra Mgr
Duration: 2 hours/day</bpmn:documentation>
        <bpmn:incoming>W368_Flow14</bpmn:incoming>
        <bpmn:outgoing>W368_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W368_Task7" name="Cloud Cost Optimization">
        <bpmn:documentation>Step 2: Cloud Cost Optimization: Review cloud billing (AWS/Azure); identify underutilized instances; manage Reserved Instances (RIs) or Savings Plans
Responsible (R): Cloud Architect
Accountable (A): CIO
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W368_Flow15</bpmn:incoming>
        <bpmn:outgoing>W368_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W368_Task8" name="Storage &amp; Backup Management">
        <bpmn:documentation>Step 3: Storage &amp; Backup Management: Monitor storage growth; manage data archival (W256); verify backup integrity via monthly restore tests
Responsible (R): DBA
Accountable (A): IT Infra Mgr
Duration: 2 hours/week</bpmn:documentation>
        <bpmn:incoming>W368_Flow16</bpmn:incoming>
        <bpmn:outgoing>W368_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W368_Task9" name="Environment Lifecycle">
        <bpmn:documentation>Step 4: Environment Lifecycle: Manage promotion of resources from Dev → QA → Staging → Prod; ensure environment parity
Responsible (R): DevOps Engineer
Accountable (A): App Mgr
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W368_Flow17</bpmn:incoming>
        <bpmn:outgoing>W368_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W368_Task10" name="Resource Scaling">
        <bpmn:documentation>Step 5: Resource Scaling: During peak periods (e.g., Q4 holidays), scale up compute resources to handle increased concurrent users (NFR-005)
Responsible (R): Cloud Architect
Accountable (A): CIO
Duration: 2 hours/event</bpmn:documentation>
        <bpmn:incoming>W368_Flow18</bpmn:incoming>
        <bpmn:outgoing>W368_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W368_End11" name="Complete">
        <bpmn:incoming>W368_Flow19</bpmn:incoming>
      </bpmn:endEvent>
