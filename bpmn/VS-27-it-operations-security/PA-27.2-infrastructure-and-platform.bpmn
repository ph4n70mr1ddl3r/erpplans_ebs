    </bpmn:process>
    <bpmndi:BPMNDiagram id="W614_diag">
      <bpmndi:BPMNPlane id="W614_plane" bpmnElement="W_W614">
        <bpmndi:BPMNShape id="W614_Lane1_di" bpmnElement="W614_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2210" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W614_Lane2_di" bpmnElement="W614_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="2210" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W614_Task5_di" bpmnElement="W614_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W614_Task6_di" bpmnElement="W614_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W614_Task7_di" bpmnElement="W614_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
