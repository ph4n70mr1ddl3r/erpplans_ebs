      <bpmn:startEvent id="W384_Start5" name="Scheduled test cycle (W73), new project development (W132), or request for data refresh…">
        <bpmn:outgoing>W384_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W384_Task6" name="Environment Request">
        <bpmn:documentation>Step 1: Environment Request: Project or QA Lead requests environment refresh or new instance; specifies data set requirements
Responsible (R): Project/QA Lead
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W384_Flow14</bpmn:incoming>
        <bpmn:outgoing>W384_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W384_Task7" name="Cloning">
        <bpmn:documentation>Step 2: Cloning: DBA initiates database clone from Production to target environment; ensures snapshot consistency
Responsible (R): DBA
Accountable (A): Cloud Arch
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W384_Flow15</bpmn:incoming>
        <bpmn:outgoing>W384_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W384_Task8" name="Data Masking (Anonymization)">
        <bpmn:documentation>Step 3: Data Masking (Anonymization): Execute automated masking scripts on PII: scramble customer names, emails, phone numbers, and employee salary data per RA 10173 standards
Responsible (R): DBA / Security
Accountable (A): IT Security Mgr
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W384_Flow16</bpmn:incoming>
        <bpmn:outgoing>W384_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W384_Task9" name="Integration Scrambling">
        <bpmn:documentation>Step 4: Integration Scrambling: Update API endpoints and service connections to point to non-prod versions; disable outbound communications (e.g., email/SMS to actual customers)
Responsible (R): DevOps Engineer
Accountable (A): Cloud Arch
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W384_Flow17</bpmn:incoming>
        <bpmn:outgoing>W384_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W384_Task10" name="Access &amp; Sanity Check">
        <bpmn:documentation>Step 5: Access &amp; Sanity Check: Provision access for the requestor team; verify core ERP functions are operational in the refreshed environment
Responsible (R): DBA / DevOps
Accountable (A): Cloud Arch
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W384_Flow18</bpmn:incoming>
        <bpmn:outgoing>W384_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W384_End11" name="Complete">
        <bpmn:incoming>W384_Flow19</bpmn:incoming>
      </bpmn:endEvent>
