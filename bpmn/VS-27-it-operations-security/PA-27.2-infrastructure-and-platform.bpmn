        <bpmn:outgoing>W393_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W393_Task7" name="Access Provisioning">
        <bpmn:documentation>Step 1: Access Provisioning: Assign VPN/ZTNA profile based on role; require MFA enrollment
Responsible (R): IT Helpdesk
Accountable (A): Infra Mgr
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W393_Flow15</bpmn:incoming>
        <bpmn:outgoing>W393_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W393_Task8" name="Device Compliance Check">
        <bpmn:documentation>Step 2: Device Compliance Check: Verify remote device meets security standards (Antivirus, Patch level) via MDM (W371)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W393_Flow16</bpmn:incoming>
        <bpmn:outgoing>W393_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W393_Task9" name="Session Monitoring">
        <bpmn:documentation>Step 3: Session Monitoring: Monitor remote access logs for unusual patterns (e.g., impossible travel, bulk data download)
Responsible (R): Security Admin
Accountable (A): —
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W393_Flow17</bpmn:incoming>
        <bpmn:outgoing>W393_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W393_Task10" name="Policy Update">
        <bpmn:documentation>Step 4: Policy Update: Adjust access rules (Geo-blocking, IP whitelisting) based on current threat landscape
Responsible (R): Network Engineer
Accountable (A): IT Security Mgr
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W393_Flow18</bpmn:incoming>
        <bpmn:outgoing>W393_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W393_Task11" name="Access Revocation">
        <bpmn:documentation>Step 5: Access Revocation: Disable remote access immediately upon employee separation (W43)
Responsible (R): IT Helpdesk
Accountable (A): CIO
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W393_Flow19</bpmn:incoming>
        <bpmn:outgoing>W393_Flow20</bpmn:outgoing>
      </bpmn:userTask>
