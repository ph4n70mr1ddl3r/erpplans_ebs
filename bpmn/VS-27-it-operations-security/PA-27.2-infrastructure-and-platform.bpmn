        <bpmndi:BPMNEdge id="W396_Flow15_di" bpmnElement="W396_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W396_Flow16_di" bpmnElement="W396_Flow16"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
