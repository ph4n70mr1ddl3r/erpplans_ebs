    <bpmn:process id="W_W390" name="W390. IT Service Continuity &amp; Business Impact Analysis (BIA) Refresh" isExecutable="false">
      <bpmn:documentation>Trigger: Annual review cycle or significant change in business operations/org structure
Frequency: Annual
Volume: Covers all critical business processes and supporting IT services
Owner: CIO
Participants: Business Department Heads, IT Infrastructure Lead, DPO
Source: workflow W390 — IT Service Continuity &amp; Business Impact Analysis (BIA) Refresh</bpmn:documentation>
      <bpmn:laneSet id="W390_LaneSet4">
        <bpmn:lane id="W390_Lane1" name="Dept Heads">
        <bpmn:flowNodeRef>W390_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W390_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W390_Start5</bpmn:flowNodeRef>
