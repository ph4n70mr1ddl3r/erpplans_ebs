    <bpmn:process id="W_W367" name="W367. Cybersecurity Operations &amp; Vulnerability Management" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled vulnerability scan; threat intelligence alert; major patch release (Patch Tuesday); or security incident
Frequency: Daily monitoring; weekly scanning; monthly patching
Volume: ~1,500 endpoints; 100+ servers; 600 POS terminals; 50+ integrations
Owner: IT Security Manager
Participants: Security Analyst, Infrastructure Team, Application Developers, Internal Audit
Source: workflow W367 — Cybersecurity Operations &amp; Vulnerability Management</bpmn:documentation>
      <bpmn:laneSet id="W367_LaneSet4">
        <bpmn:lane id="W367_Lane1" name="System">
        <bpmn:flowNodeRef>W367_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W367_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W367_Lane2" name="Security Analyst">
        <bpmn:flowNodeRef>W367_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W367_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W367_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W367_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W367_Lane3" name="Infrastructure Team">
        <bpmn:flowNodeRef>W367_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W367_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W367_Start5" name="Scheduled vulnerability scan; threat intelligence alert; major patch release (Patch…">
        <bpmn:outgoing>W367_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W367_Task6" name="Vulnerability Scanning">
        <bpmn:documentation>Step 1: Vulnerability Scanning: Automated tools scan network, servers, and applications for known vulnerabilities (CVEs); generate prioritized risk report
Responsible (R): System / Security Analyst
Accountable (A): IT Security Mgr
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W367_Flow15</bpmn:incoming>
        <bpmn:outgoing>W367_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W367_Task7" name="Patch Prioritization">
        <bpmn:documentation>Step 2: Patch Prioritization: Review scan results; prioritize &quot;Critical&quot; and &quot;High&quot; vulnerabilities; coordinate with App/Infra teams for testing
Responsible (R): Security Analyst
Accountable (A): IT Security Mgr
Duration: 2 hours/week</bpmn:documentation>
        <bpmn:incoming>W367_Flow16</bpmn:incoming>
        <bpmn:outgoing>W367_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W367_Task8" name="Patch Deployment">
        <bpmn:documentation>Step 3: Patch Deployment: Deploy security patches to OS, middleware, and applications during maintenance windows; verify post-patch health
Responsible (R): Infrastructure Team
Accountable (A): IT Security Mgr
Duration: 4 hours/week</bpmn:documentation>
        <bpmn:incoming>W367_Flow17</bpmn:incoming>
        <bpmn:outgoing>W367_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W367_Task9" name="Endpoint Protection (EDR) Monitoring">
        <bpmn:documentation>Step 4: Endpoint Protection (EDR) Monitoring: Monitor EDR dashboard for malware, unauthorized access, or lateral movement; triage and isolate suspicious devices
Responsible (R): Security Analyst
Accountable (A): IT Security Mgr
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W367_Flow18</bpmn:incoming>
        <bpmn:outgoing>W367_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W367_Task10" name="Phishing Simulation">
        <bpmn:documentation>Step 5: Phishing Simulation: Conduct quarterly phishing tests for all 6,911 employees; assign remedial training to users who fail
Responsible (R): Security Analyst
Accountable (A): IT Security Mgr
Duration: 4 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W367_Flow19</bpmn:incoming>
        <bpmn:outgoing>W367_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W367_Task11" name="Firewall &amp; WAF Review">
        <bpmn:documentation>Step 6: Firewall &amp; WAF Review: Periodic review of firewall rules and Web Application Firewall (WAF) policies to ensure &quot;least privilege&quot; access
Responsible (R): Security Analyst
Accountable (A): CIO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W367_Flow20</bpmn:incoming>
        <bpmn:outgoing>W367_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W367_End12" name="Complete">
        <bpmn:incoming>W367_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W367_Annotation13">
        <bpmn:text>Controls: - CTL-324 (ensure controlled execution — Cybersecurity &amp; Privacy (PA-27.3).) | - operational: IT Security Manager review and approval gate
Owner: IT Security Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W367_Assoc14" sourceRef="W367_Annotation13" targetRef="W367_Start5" associationDirection="None" />
