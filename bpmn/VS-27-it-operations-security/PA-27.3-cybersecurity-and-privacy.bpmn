    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5522_diag">
      <bpmndi:BPMNPlane id="W5522_plane" bpmnElement="W_W5522">
        <bpmndi:BPMNShape id="W5522_Lane1_di" bpmnElement="W5522_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
