    <bpmn:process id="W_W375" name="W375. Privileged Access Management (PAM) Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Request for administrative or elevated access; monthly review cycle for high-risk accounts
Frequency: Daily (provisioning); Monthly (review)
Volume: ~50–70 privileged accounts (Cloud Admins, DBAs, ERP Admins, Network Admins)
Owner: IT Security Manager
Participants: IT Infrastructure, System Admins, Security Analyst, Internal Audit
Source: workflow W375 — Privileged Access Management (PAM) Operations</bpmn:documentation>
      <bpmn:laneSet id="W375_LaneSet5">
        <bpmn:lane id="W375_Lane1" name="IT Staff">
        <bpmn:flowNodeRef>W375_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W375_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W375_Lane2" name="IT Security Mgr">
        <bpmn:flowNodeRef>W375_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W375_Lane3" name="System">
        <bpmn:flowNodeRef>W375_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W375_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W375_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W375_Lane4" name="Security Analyst">
        <bpmn:flowNodeRef>W375_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W375_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W375_Start6" name="Request for administrative or elevated access; monthly review cycle for high-risk accounts">
        <bpmn:outgoing>W375_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W375_Task7" name="Access Request">
        <bpmn:documentation>Step 1: Access Request: IT staff requests temporary or permanent privileged access (e.g., Domain Admin, Cloud Global Admin) with justification
Responsible (R): IT Staff
Accountable (A): IT Security Mgr
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W375_Flow16</bpmn:incoming>
        <bpmn:outgoing>W375_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W375_Task8" name="Security Approval">
        <bpmn:documentation>Step 2: Security Approval: Security Manager verifies need-to-know and least-privilege; checks for SOD conflicts (W338)
Responsible (R): IT Security Mgr
Accountable (A): CIO
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W375_Flow17</bpmn:incoming>
        <bpmn:outgoing>W375_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W375_Task9" name="JIT Provisioning">
        <bpmn:documentation>Step 3: JIT Provisioning: System grants Just-in-Time (JIT) access for a limited window (e.g., 4 hours); requires MFA challenge
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W375_Flow18</bpmn:incoming>
        <bpmn:outgoing>W375_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W375_Task10" name="Session Monitoring">
        <bpmn:documentation>Step 4: Session Monitoring: System logs all actions taken during privileged session (keystrokes, commands); high-risk actions alert Security Analyst
Responsible (R): System
Accountable (A): Security Analyst
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W375_Flow19</bpmn:incoming>
        <bpmn:outgoing>W375_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W375_Task11" name="Access Revocation">
        <bpmn:documentation>Step 5: Access Revocation: Access automatically expires at end of window; permanent accounts require manual de-provisioning upon role change (W152)
Responsible (R): System / IT Helpdesk
Accountable (A): IT Security Mgr
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W375_Flow20</bpmn:incoming>
        <bpmn:outgoing>W375_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W375_Task12" name="Monthly Privileged Review">
        <bpmn:documentation>Step 6: Monthly Privileged Review: Security Analyst reviews all accounts with administrative rights; verifies users still require access; revokes unused permissions
Responsible (R): Security Analyst
Accountable (A): IT Security Mgr
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W375_Flow21</bpmn:incoming>
        <bpmn:outgoing>W375_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W375_End13" name="Complete">
        <bpmn:incoming>W375_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W375_Annotation14">
        <bpmn:text>Controls: - CTL-324 (ensure controlled execution — Cybersecurity &amp; Privacy (PA-27.3).) | - operational: IT Security Manager review and approval gate
Owner: IT Security Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W375_Assoc15" sourceRef="W375_Annotation14" targetRef="W375_Start6" associationDirection="None" />
