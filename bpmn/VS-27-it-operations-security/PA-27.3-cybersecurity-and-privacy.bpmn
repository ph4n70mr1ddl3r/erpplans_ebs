    <bpmn:process id="W_W389" name="W389. Data Privacy Impact Assessment (DPIA) Lifecycle" isExecutable="false">
      <bpmn:documentation>Trigger: New system project (W374), major software change (W132), or data processing change
Frequency: As-needed (per project)
Volume: ~5–10 major assessments per year
Owner: Data Protection Officer (DPO)
Participants: Project Manager, IT Security, Legal, Business Owner
Source: workflow W389 — Data Privacy Impact Assessment (DPIA) Lifecycle</bpmn:documentation>
      <bpmn:laneSet id="W389_LaneSet5">
        <bpmn:lane id="W389_Lane1" name="Project Manager">
        <bpmn:flowNodeRef>W389_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W389_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W389_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W389_Lane2" name="Security Analyst">
        <bpmn:flowNodeRef>W389_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W389_Lane3" name="IT Security">
        <bpmn:flowNodeRef>W389_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W389_Lane4" name="DPO">
        <bpmn:flowNodeRef>W389_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W389_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W389_Start6" name="New system project (W374), major software change (W132), or data processing change">
        <bpmn:outgoing>W389_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W389_Task7" name="Threshold Assessment">
        <bpmn:documentation>Step 1: Threshold Assessment: Determine if a project involves high-risk processing (sensitive personal info, automated profiling, large-scale monitoring)
Responsible (R): Project Manager
Accountable (A): DPO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W389_Flow15</bpmn:incoming>
        <bpmn:outgoing>W389_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W389_Task8" name="Data Flow Mapping">
        <bpmn:documentation>Step 2: Data Flow Mapping: Document how personal data is collected, used, stored, and shared within the new system
Responsible (R): Project Manager
Accountable (A): —
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W389_Flow16</bpmn:incoming>
        <bpmn:outgoing>W389_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W389_Task9" name="Risk Identification">
        <bpmn:documentation>Step 3: Risk Identification: Identify threats to data subject rights and potential harms (breach, discrimination, etc.)
Responsible (R): Security Analyst
Accountable (A): DPO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W389_Flow17</bpmn:incoming>
        <bpmn:outgoing>W389_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W389_Task10" name="Mitigation Planning">
        <bpmn:documentation>Step 4: Mitigation Planning: Define technical and organizational measures to reduce privacy risks (encryption, masking, access limits)
Responsible (R): IT Security
Accountable (A): DPO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W389_Flow18</bpmn:incoming>
        <bpmn:outgoing>W389_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W389_Task11" name="DPO Sign-off">
        <bpmn:documentation>Step 5: DPO Sign-off: DPO reviews assessment and mitigations; signs off before project go-live
Responsible (R): DPO
Accountable (A): CEO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W389_Flow19</bpmn:incoming>
        <bpmn:outgoing>W389_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W389_End12" name="Complete">
        <bpmn:incoming>W389_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W389_Annotation13">
        <bpmn:text>Controls: - CTL-324 (ensure controlled execution — Cybersecurity &amp; Privacy (PA-27.3).) | - operational: Data Protection Officer (DPO) review and approval gate
Owner: Data Protection Officer (DPO)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W389_Assoc14" sourceRef="W389_Annotation13" targetRef="W389_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W389_Flow15" sourceRef="W389_Start6" targetRef="W389_Task7" />
