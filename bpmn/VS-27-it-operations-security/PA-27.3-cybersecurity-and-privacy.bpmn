    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W386" name="W386. IT Strategy &amp; Annual Roadmap Development" isExecutable="false">
      <bpmn:documentation>Trigger: Annual corporate strategic planning cycle (typically Q3/Q4)
Frequency: Annual (with quarterly roadmap updates)
Volume: Covers all IT domains, digital transformation, and major CAPEX/OPEX
Owner: CIO
Participants: CEO, CFO, COO, Department Heads, IT Leads
Source: workflow W386 — IT Strategy &amp; Annual Roadmap Development</bpmn:documentation>
      <bpmn:laneSet id="W386_LaneSet4">
        <bpmn:lane id="W386_Lane1" name="CIO">
        <bpmn:flowNodeRef>W386_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W386_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W386_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W386_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W386_Lane2" name="IT Project Mgr">
        <bpmn:flowNodeRef>W386_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W386_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W386_Lane3" name="IT Leads">
        <bpmn:flowNodeRef>W386_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W386_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W386_Start5" name="Annual corporate strategic planning cycle (typically Q3/Q4)">
        <bpmn:outgoing>W386_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W386_Task6" name="Environmental Scan &amp; Gap Analysis">
        <bpmn:documentation>Step 1: Environmental Scan &amp; Gap Analysis: Review business goals (e.g., store expansion, ecommerce targets), technology trends, and current system performance/gaps
Responsible (R): CIO / IT Leads
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W386_Flow15</bpmn:incoming>
        <bpmn:outgoing>W386_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W386_Task7" name="Stakeholder Interviews">
        <bpmn:documentation>Step 2: Stakeholder Interviews: Meet with Dept Heads to understand unmet needs and upcoming business initiatives
Responsible (R): IT Project Mgr
Accountable (A): CIO
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W386_Flow16</bpmn:incoming>
        <bpmn:outgoing>W386_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W386_Task8" name="Roadmap Prioritization">
        <bpmn:documentation>Step 3: Roadmap Prioritization: Score potential projects based on ROI, strategic alignment, risk, and technical feasibility; align with IT Steering Committee
Responsible (R): IT Leads
Accountable (A): CIO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W386_Flow17</bpmn:incoming>
        <bpmn:outgoing>W386_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W386_Task9" name="Budget Development">
        <bpmn:documentation>Step 4: Budget Development: Estimate CAPEX (W21) and OPEX for the roadmap; include hardware refresh (W131) and software maintenance
Responsible (R): CIO / Finance
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W386_Flow18</bpmn:incoming>
        <bpmn:outgoing>W386_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W386_Task10" name="Board Approval">
        <bpmn:documentation>Step 5: Board Approval: Present IT Strategy and Budget to CEO/Board for formal approval
Responsible (R): CIO
Accountable (A): CEO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W386_Flow19</bpmn:incoming>
        <bpmn:outgoing>W386_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W386_Task11" name="Execution &amp; Monitoring">
        <bpmn:documentation>Step 6: Execution &amp; Monitoring: Publish roadmap; track project progress (W128) and update roadmap quarterly based on business shifts
Responsible (R): IT Project Mgr
Accountable (A): CIO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W386_Flow20</bpmn:incoming>
        <bpmn:outgoing>W386_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W386_End12" name="Complete">
        <bpmn:incoming>W386_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W386_Annotation13">
        <bpmn:text>Controls: - CTL-324 (ensure controlled execution — Cybersecurity &amp; Privacy (PA-27.3).) | - operational: CIO review and approval gate
Owner: CIO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W386_Assoc14" sourceRef="W386_Annotation13" targetRef="W386_Start5" associationDirection="None" />
