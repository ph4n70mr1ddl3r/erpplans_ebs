        <bpmndi:BPMNShape id="W5522_Task6_di" bpmnElement="W5522_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5522_Task7_di" bpmnElement="W5522_Task7"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
