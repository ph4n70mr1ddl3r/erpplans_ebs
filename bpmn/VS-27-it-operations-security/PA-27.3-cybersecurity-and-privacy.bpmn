    <bpmn:process id="W_W383" name="W383. IT Security Incident Response (General)" isExecutable="false">
      <bpmn:documentation>Trigger: Security alert from SIEM, EDR detection, unauthorized access report, or suspected malware infection
Frequency: As-needed; estimated 5–10 incidents/month requiring investigation
Volume: Covers ~1,500 endpoints, ~600 POS terminals, and cloud infrastructure
Owner: IT Security Manager
Participants: Security Analyst, IT Infrastructure, Legal (if breach), affected Business Owners
Source: workflow W383 — IT Security Incident Response (General)</bpmn:documentation>
      <bpmn:laneSet id="W383_LaneSet4">
        <bpmn:lane id="W383_Lane1" name="Security Analyst">
        <bpmn:flowNodeRef>W383_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W383_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W383_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W383_Lane2" name="IT Security Mgr">
        <bpmn:flowNodeRef>W383_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W383_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W383_Lane3" name="Infrastructure Team">
        <bpmn:flowNodeRef>W383_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W383_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W383_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W383_Start5" name="Security alert from SIEM, EDR detection, unauthorized access report, or suspected malware…">
        <bpmn:outgoing>W383_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W383_Task6" name="Triage &amp; Classification">
        <bpmn:documentation>Step 1: Triage &amp; Classification: Verify alert; classify by severity (Low, Medium, High, Critical) and type (Malware, Unauthorized Access, Denial of Service, etc.)
Responsible (R): Security Analyst
Accountable (A): IT Security Mgr
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W383_Flow15</bpmn:incoming>
        <bpmn:outgoing>W383_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W383_Task7" name="Containment">
        <bpmn:documentation>Step 2: Containment: Execute immediate isolation steps: block IP addresses, disable compromised accounts, or isolate infected host from network
Responsible (R): IT Security Mgr
Accountable (A): CIO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W383_Flow16</bpmn:incoming>
        <bpmn:outgoing>W383_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W383_Task8" name="Investigation &amp; Analysis">
        <bpmn:documentation>Step 3: Investigation &amp; Analysis: Analyze logs, memory, and disk to determine root cause, extent of lateral movement, and whether PII was touched (trigger W53 if yes)
Responsible (R): Security Analyst
Accountable (A): IT Security Mgr
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W383_Flow17</bpmn:incoming>
        <bpmn:outgoing>W383_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W383_Task9" name="Eradication">
        <bpmn:documentation>Step 4: Eradication: Remove the threat: delete malware, close vulnerability, or rebuild compromised system from clean image
Responsible (R): Infrastructure Team
Accountable (A): IT Security Mgr
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W383_Flow18</bpmn:incoming>
        <bpmn:outgoing>W383_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W383_Task10" name="Recovery">
        <bpmn:documentation>Step 5: Recovery: Restore services; monitor for recurrence; verify system integrity before full business resumption
Responsible (R): Infrastructure Team
Accountable (A): CIO
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W383_Flow19</bpmn:incoming>
        <bpmn:outgoing>W383_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W383_Task11" name="Post-Incident Review">
        <bpmn:documentation>Step 6: Post-Incident Review: Document timeline, impact, and lessons learned; update security controls and W381 Knowledge Base
Responsible (R): IT Security Mgr
Accountable (A): CIO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W383_Flow20</bpmn:incoming>
        <bpmn:outgoing>W383_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W383_End12" name="Complete">
        <bpmn:incoming>W383_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W383_Annotation13">
        <bpmn:text>Controls: - CTL-324 (ensure controlled execution — Cybersecurity &amp; Privacy (PA-27.3).) | - operational: IT Security Manager review and approval gate
Owner: IT Security Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W383_Assoc14" sourceRef="W383_Annotation13" targetRef="W383_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W383_Flow15" sourceRef="W383_Start5" targetRef="W383_Task6" />
      <bpmn:sequenceFlow id="W383_Flow16" sourceRef="W383_Task6" targetRef="W383_Task7" />
      <bpmn:sequenceFlow id="W383_Flow17" sourceRef="W383_Task7" targetRef="W383_Task8" />
      <bpmn:sequenceFlow id="W383_Flow18" sourceRef="W383_Task8" targetRef="W383_Task9" />
      <bpmn:sequenceFlow id="W383_Flow19" sourceRef="W383_Task9" targetRef="W383_Task10" />
      <bpmn:sequenceFlow id="W383_Flow20" sourceRef="W383_Task10" targetRef="W383_Task11" />
      <bpmn:sequenceFlow id="W383_Flow21" sourceRef="W383_Task11" targetRef="W383_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W383_diag">
      <bpmndi:BPMNPlane id="W383_plane" bpmnElement="W_W383">
        <bpmndi:BPMNShape id="W383_Lane1_di" bpmnElement="W383_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W383_Lane2_di" bpmnElement="W383_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W383_Lane3_di" bpmnElement="W383_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1580" height="170" /></bpmndi:BPMNShape>
