    <bpmn:process id="W_W371" name="W371. Mobile Device Management (MDM) Operations" isExecutable="false">
      <bpmn:documentation>Trigger: New RF device/mPOS rollout; device failure; or lost/stolen report
Frequency: Ongoing; daily enrollment/monitoring
Volume: ~500 RF devices; ~200 mPOS units; ~100 corporate mobile phones
Owner: Mobility Lead
Participants: IT Helpdesk, Store Operations, DC Managers
Source: workflow W371 — Mobile Device Management (MDM) Operations</bpmn:documentation>
      <bpmn:laneSet id="W371_LaneSet3">
        <bpmn:lane id="W371_Lane1" name="IT Helpdesk">
        <bpmn:flowNodeRef>W371_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W371_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W371_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W371_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W371_Lane2" name="Mobility Lead">
        <bpmn:flowNodeRef>W371_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W371_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W371_Start4" name="New RF device/mPOS rollout; device failure; or lost/stolen report">
        <bpmn:outgoing>W371_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W371_Task5" name="Enrollment">
        <bpmn:documentation>Step 1: Enrollment: Zero-touch deployment of new devices into MDM; apply security profiles, app restrictions, and Wi-Fi certs
Responsible (R): IT Helpdesk
Accountable (A): Mobility Lead
Duration: 15 min/device</bpmn:documentation>
        <bpmn:incoming>W371_Flow12</bpmn:incoming>
        <bpmn:outgoing>W371_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W371_Task6" name="App Distribution">
        <bpmn:documentation>Step 2: App Distribution: Remote push of updates to WMS/POS apps; manage version consistency across 200+ locations
Responsible (R): Mobility Lead
Accountable (A): CIO
Duration: 1 hour/release</bpmn:documentation>
        <bpmn:incoming>W371_Flow13</bpmn:incoming>
        <bpmn:outgoing>W371_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W371_Task7" name="Lost/Stolen Protocol">
        <bpmn:documentation>Step 3: Lost/Stolen Protocol: Remote wipe/lock of compromised devices within 30 minutes of report
Responsible (R): IT Helpdesk
Accountable (A): Mobility Lead
Duration: 5 min/event</bpmn:documentation>
        <bpmn:incoming>W371_Flow14</bpmn:incoming>
        <bpmn:outgoing>W371_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W371_Task8" name="Health Monitoring">
        <bpmn:documentation>Step 4: Health Monitoring: Monitor battery health and hardware telemetry; proactive replacement of failing units
Responsible (R): IT Helpdesk
Accountable (A): Mobility Lead
Duration: 2 hours/week</bpmn:documentation>
        <bpmn:incoming>W371_Flow15</bpmn:incoming>
        <bpmn:outgoing>W371_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W371_End9" name="Complete">
        <bpmn:incoming>W371_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W371_Annotation10">
        <bpmn:text>Controls: - CTL-324 (ensure controlled execution — Cybersecurity &amp; Privacy (PA-27.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Mobility Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W371_Assoc11" sourceRef="W371_Annotation10" targetRef="W371_Start4" associationDirection="None" />
