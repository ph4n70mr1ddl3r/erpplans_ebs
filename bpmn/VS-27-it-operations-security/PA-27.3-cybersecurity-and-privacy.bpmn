      <bpmn:sequenceFlow id="W1205_Flow17" sourceRef="W1205_Task6" targetRef="W1205_Task7" />
      <bpmn:sequenceFlow id="W1205_Flow18" sourceRef="W1205_Task7" targetRef="W1205_Task8" />
      <bpmn:sequenceFlow id="W1205_Flow19" sourceRef="W1205_Task8" targetRef="W1205_Task9" />
      <bpmn:sequenceFlow id="W1205_Flow20" sourceRef="W1205_Task9" targetRef="W1205_Task10" />
      <bpmn:sequenceFlow id="W1205_Flow21" sourceRef="W1205_Task10" targetRef="W1205_Task11" />
      <bpmn:sequenceFlow id="W1205_Flow22" sourceRef="W1205_Task11" targetRef="W1205_End12" />
    </bpmn:process>
