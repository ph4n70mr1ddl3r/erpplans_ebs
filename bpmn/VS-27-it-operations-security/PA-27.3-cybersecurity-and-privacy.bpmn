        <bpmn:lane id="W390_Lane2" name="IT Infra Lead">
        <bpmn:flowNodeRef>W390_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W390_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W390_Lane3" name="CIO">
        <bpmn:flowNodeRef>W390_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W390_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W390_Start5" name="Annual review cycle or significant change in business operations/org structure">
        <bpmn:outgoing>W390_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W390_Task6" name="Business Process Identification">
        <bpmn:documentation>Step 1: Business Process Identification: List all core business processes (Sales, Logistics, Finance, etc.)
Responsible (R): Dept Heads
Accountable (A): —
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W390_Flow14</bpmn:incoming>
        <bpmn:outgoing>W390_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W390_Task7" name="Impact Analysis">
        <bpmn:documentation>Step 2: Impact Analysis: Determine MTPD (Maximum Tolerable Period of Disruption) and financial/operational impact of downtime for each
Responsible (R): Dept Heads
Accountable (A): CFO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W390_Flow15</bpmn:incoming>
        <bpmn:outgoing>W390_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W390_Task8" name="IT Service Mapping">
        <bpmn:documentation>Step 3: IT Service Mapping: Map each business process to its supporting IT services/systems
Responsible (R): IT Infra Lead
Accountable (A): CIO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W390_Flow16</bpmn:incoming>
        <bpmn:outgoing>W390_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W390_Task9" name="RTO/RPO Definition">
        <bpmn:documentation>Step 4: RTO/RPO Definition: Set Recovery Time Objectives (RTO) and Recovery Point Objectives (RPO) based on impact analysis
Responsible (R): CIO
Accountable (A): CEO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W390_Flow17</bpmn:incoming>
        <bpmn:outgoing>W390_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W390_Task10" name="DR Plan Update">
        <bpmn:documentation>Step 5: DR Plan Update: Ensure DR failover procedures (W55) and backup schedules (W382) align with the refreshed RTO/RPO
Responsible (R): IT Infra Lead
Accountable (A): CIO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W390_Flow18</bpmn:incoming>
        <bpmn:outgoing>W390_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W390_End11" name="Complete">
        <bpmn:incoming>W390_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W390_Annotation12">
        <bpmn:text>Controls: - CTL-324 (ensure controlled execution — Cybersecurity &amp; Privacy (PA-27.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: CIO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W390_Assoc13" sourceRef="W390_Annotation12" targetRef="W390_Start5" associationDirection="None" />
