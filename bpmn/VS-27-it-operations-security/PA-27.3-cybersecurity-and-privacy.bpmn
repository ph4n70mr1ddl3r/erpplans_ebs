    <bpmn:process id="W_W388" name="W388. Shadow IT Discovery &amp; Governance" isExecutable="false">
      <bpmn:documentation>Trigger: Periodic scan of firewall/CASB logs, or review of employee expense reports/AP invoices
Frequency: Monthly
Volume: Potentially dozens of unsanctioned SaaS/Cloud applications
Owner: IT Security Manager
Participants: IT Vendor Manager, Finance (AP), Department Managers
Source: workflow W388 — Shadow IT Discovery &amp; Governance</bpmn:documentation>
      <bpmn:laneSet id="W388_LaneSet4">
        <bpmn:lane id="W388_Lane1" name="Security Analyst">
        <bpmn:flowNodeRef>W388_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W388_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W388_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W388_Lane2" name="IT Security Mgr">
        <bpmn:flowNodeRef>W388_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W388_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W388_Lane3" name="IT Vendor Mgr">
        <bpmn:flowNodeRef>W388_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W388_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W388_Start5" name="Periodic scan of firewall/CASB logs, or review of employee expense reports/AP invoices">
        <bpmn:outgoing>W388_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W388_Task6" name="Detection">
        <bpmn:documentation>Step 1: Detection: Analyze network logs (CASB/Firewall) and financial records (AP/Expenses) for payments to unknown software/cloud vendors
Responsible (R): Security Analyst
Accountable (A): IT Security Mgr
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W388_Flow14</bpmn:incoming>
        <bpmn:outgoing>W388_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W388_Task7" name="Risk Assessment">
        <bpmn:documentation>Step 2: Risk Assessment: Evaluate discovered applications for data privacy (RA 10173), security, and cost risks
Responsible (R): Security Analyst
Accountable (A): IT Security Mgr
Duration: 2 hours/app</bpmn:documentation>
        <bpmn:incoming>W388_Flow15</bpmn:incoming>
        <bpmn:outgoing>W388_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W388_Task8" name="Decision">
        <bpmn:documentation>Step 3: Decision: (a) Sanction: Bring into official governance (W370); (b) Discontinue: Block at firewall and notify user; (c) Consolidate: Migrate data to an existing enterprise tool
Responsible (R): IT Security Mgr
Accountable (A): CIO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W388_Flow16</bpmn:incoming>
        <bpmn:outgoing>W388_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W388_Task9" name="Remediation">
        <bpmn:documentation>Step 4: Remediation: For sanctioned apps, ensure DPA (Data Processing Agreement) is signed and SSO is integrated if possible
Responsible (R): IT Vendor Mgr
Accountable (A): CIO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W388_Flow17</bpmn:incoming>
        <bpmn:outgoing>W388_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W388_Task10" name="Policy Reinforcement">
        <bpmn:documentation>Step 5: Policy Reinforcement: Update Acceptable Use Policy (W372) based on discovery trends
Responsible (R): IT Security Mgr
Accountable (A): HR Head
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W388_Flow18</bpmn:incoming>
        <bpmn:outgoing>W388_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W388_End11" name="Complete">
        <bpmn:incoming>W388_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W388_Annotation12">
        <bpmn:text>Controls: - CTL-324 (ensure controlled execution — Cybersecurity &amp; Privacy (PA-27.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: IT Security Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W388_Assoc13" sourceRef="W388_Annotation12" targetRef="W388_Start5" associationDirection="None" />
