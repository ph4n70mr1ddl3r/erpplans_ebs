    <bpmn:process id="W_W397" name="W397. Cyber Threat Intelligence &amp; Proactive Threat Hunting" isExecutable="false">
      <bpmn:documentation>Trigger: New threat intelligence report; or scheduled hunting cycle
Frequency: Weekly hunting; Continuous intel monitoring
Volume: Analysis of ~100+ Indicators of Compromise (IoC)
Owner: IT Security Manager
Participants: Security Analyst, Network Engineer
Source: workflow W397 — Cyber Threat Intelligence &amp; Proactive Threat Hunting</bpmn:documentation>
      <bpmn:laneSet id="W397_LaneSet4">
        <bpmn:lane id="W397_Lane1" name="Security Analyst">
        <bpmn:flowNodeRef>W397_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W397_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W397_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W397_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W397_Lane2" name="System">
        <bpmn:flowNodeRef>W397_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W397_Lane3" name="IT Security Mgr">
        <bpmn:flowNodeRef>W397_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W397_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W397_Start5" name="New threat intelligence report; or scheduled hunting cycle">
        <bpmn:outgoing>W397_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W397_Task6" name="Intel Collection">
        <bpmn:documentation>Step 1: Intel Collection: Aggregate threat feeds from industry sources (ISAC, CISA, Vendors) and dark web monitoring
Responsible (R): Security Analyst
Accountable (A): —
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W397_Flow14</bpmn:incoming>
        <bpmn:outgoing>W397_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W397_Task7" name="IoC Ingestion">
        <bpmn:documentation>Step 2: IoC Ingestion: Import Indicators of Compromise (IPs, Hashes, Domains) into SIEM/EDR for automated matching
Responsible (R): System
Accountable (A): Security Analyst
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W397_Flow15</bpmn:incoming>
        <bpmn:outgoing>W397_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W397_Task8" name="Proactive Hunting">
        <bpmn:documentation>Step 3: Proactive Hunting: Manually search logs for advanced persistent threats (APTs) that bypass automated tools
Responsible (R): Security Analyst
Accountable (A): IT Security Mgr
Duration: 4 hours/week</bpmn:documentation>
        <bpmn:incoming>W397_Flow16</bpmn:incoming>
        <bpmn:outgoing>W397_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W397_Task9" name="Threat Modeling">
        <bpmn:documentation>Step 4: Threat Modeling: Review internal architecture against new attack techniques; identify weak points
Responsible (R): IT Security Mgr
Accountable (A): CIO
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W397_Flow17</bpmn:incoming>
        <bpmn:outgoing>W397_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W397_Task10" name="Actionable Intel">
        <bpmn:documentation>Step 5: Actionable Intel: If new threat is found, trigger W383 (Incident Response) or update firewall/WAF rules (W366)
Responsible (R): Security Analyst
Accountable (A): IT Security Mgr
Duration: Immediate</bpmn:documentation>
        <bpmn:incoming>W397_Flow18</bpmn:incoming>
        <bpmn:outgoing>W397_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W397_End11" name="Complete">
        <bpmn:incoming>W397_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W397_Annotation12">
        <bpmn:text>Controls: - CTL-324 (ensure controlled execution — Cybersecurity &amp; Privacy (PA-27.3).) | - operational: IT Security Manager review and approval gate | ---
Owner: IT Security Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W397_Assoc13" sourceRef="W397_Annotation12" targetRef="W397_Start5" associationDirection="None" />
