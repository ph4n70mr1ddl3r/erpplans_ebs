    <bpmn:process id="W_W394" name="W394. IT Technical Skills, Training &amp; Certification Lifecycle" isExecutable="false">
      <bpmn:documentation>Trigger: Annual performance review; or new technology adoption
Frequency: Annual planning; Quarterly progress review
Volume: ~30 IT staff
Owner: CIO
Participants: IT Leads, HR Training Team
Source: workflow W394 — IT Technical Skills, Training &amp; Certification Lifecycle</bpmn:documentation>
      <bpmn:laneSet id="W394_LaneSet4">
        <bpmn:lane id="W394_Lane1" name="IT Leads">
        <bpmn:flowNodeRef>W394_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W394_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W394_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W394_Lane2" name="CIO">
        <bpmn:flowNodeRef>W394_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W394_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W394_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W394_Lane3" name="IT Staff">
        <bpmn:flowNodeRef>W394_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W394_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W394_Start5" name="Annual performance review; or new technology adoption">
        <bpmn:outgoing>W394_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W394_Task6" name="Skills Assessment">
        <bpmn:documentation>Step 1: Skills Assessment: Map current IT team skills against required competencies for the IT Roadmap (W386)
Responsible (R): IT Leads
Accountable (A): CIO
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W394_Flow15</bpmn:incoming>
        <bpmn:outgoing>W394_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W394_Task7" name="Gap Identification">
        <bpmn:documentation>Step 2: Gap Identification: Identify &quot;Single Points of Failure&quot; (skills held by only one person) and technical gaps
Responsible (R): CIO
Accountable (A): —
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W394_Flow16</bpmn:incoming>
        <bpmn:outgoing>W394_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W394_Task8" name="Training Roadmap">
        <bpmn:documentation>Step 3: Training Roadmap: Define training tracks and required certifications (e.g., AWS, SAP, CISA, PMP)
Responsible (R): IT Leads
Accountable (A): CIO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W394_Flow17</bpmn:incoming>
        <bpmn:outgoing>W394_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W394_Task9" name="Certification Support">
        <bpmn:documentation>Step 4: Certification Support: Provide budget and time for IT staff to complete exams and training
Responsible (R): CIO
Accountable (A): —
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W394_Flow18</bpmn:incoming>
        <bpmn:outgoing>W394_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W394_Task10" name="Knowledge Transfer">
        <bpmn:documentation>Step 5: Knowledge Transfer: Conduct internal &quot;Brown Bag&quot; sessions to share skills across the team
Responsible (R): IT Staff
Accountable (A): IT Leads
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W394_Flow19</bpmn:incoming>
        <bpmn:outgoing>W394_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W394_Task11" name="Progress Tracking">
        <bpmn:documentation>Step 6: Progress Tracking: Update skills matrix quarterly to reflect new certifications and proficiencies
Responsible (R): CIO
Accountable (A): HR Head
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W394_Flow20</bpmn:incoming>
        <bpmn:outgoing>W394_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W394_End12" name="Complete">
        <bpmn:incoming>W394_Flow21</bpmn:incoming>
      </bpmn:endEvent>
