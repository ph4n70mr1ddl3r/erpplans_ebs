        <bpmn:lane id="W377_Lane4" name="Security Analyst">
        <bpmn:flowNodeRef>W377_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W377_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W377_Start6" name="New application rollout; or 60 days prior to certificate/domain expiration">
        <bpmn:outgoing>W377_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W377_Task7" name="Inventory Review">
        <bpmn:documentation>Step 1: Inventory Review: Monthly scan of all public-facing endpoints to identify certificate expiration dates and domain renewal windows
Responsible (R): Network Engineer
Accountable (A): IT Infra Lead
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W377_Flow16</bpmn:incoming>
        <bpmn:outgoing>W377_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W377_Task8" name="Renewal Authorization">
        <bpmn:documentation>Step 2: Renewal Authorization: For domains/certs expiring in 60 days, verify with App Owners if still needed; obtain CIO approval for renewal
Responsible (R): IT Infra Lead
Accountable (A): CIO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W377_Flow17</bpmn:incoming>
        <bpmn:outgoing>W377_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W377_Task9" name="Certificate Request (CSR)">
        <bpmn:documentation>Step 3: Certificate Request (CSR): Generate CSR; submit to Certificate Authority (CA); complete domain validation (DNS or file-based)
Responsible (R): Network Engineer
Accountable (A): IT Infra Lead
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W377_Flow18</bpmn:incoming>
        <bpmn:outgoing>W377_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W377_Task10" name="Implementation">
        <bpmn:documentation>Step 4: Implementation: Install new certificate on Load Balancers (WAF/ALB), Web Servers, or API Gateways (W257)
Responsible (R): DevOps / Network Eng
Accountable (A): IT Infra Lead
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W377_Flow19</bpmn:incoming>
        <bpmn:outgoing>W377_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W377_Task11" name="Verification">
        <bpmn:documentation>Step 5: Verification: Confirm site/API accessibility and certificate chain validity; update expiry date in IT Asset Register (W131)
Responsible (R): Security Analyst
Accountable (A): IT Infra Lead
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W377_Flow20</bpmn:incoming>
        <bpmn:outgoing>W377_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W377_Task12" name="Domain Renewal">
        <bpmn:documentation>Step 6: Domain Renewal: Process domain renewal payment via corporate credit card or PO (W136); update WHOIS contact info if needed
Responsible (R): IT Infra Lead
Accountable (A): Finance Mgr
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W377_Flow21</bpmn:incoming>
        <bpmn:outgoing>W377_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W377_End13" name="Complete">
        <bpmn:incoming>W377_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W377_Annotation14">
        <bpmn:text>Controls: - CTL-324 (ensure controlled execution — Cybersecurity &amp; Privacy (PA-27.3).) | - operational: IT Infrastructure Lead review and approval gate
Owner: IT Infrastructure Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W377_Assoc15" sourceRef="W377_Annotation14" targetRef="W377_Start6" associationDirection="None" />
