<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-27.3-cybersecurity-and-privacy" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W53" name="W53. Data Privacy Breach Response" isExecutable="false">
      <bpmn:documentation>Trigger: Suspected or confirmed breach of personal data (customer, employee, or vendor data) as defined by RA 10173 (Data Privacy Act of 2012)
Frequency: Rare; estimated 0–2 incidents/year requiring formal breach response
Volume: Variable — from a single record exposed to bulk data extraction
Owner: Data Protection Officer (DPO)
Participants: DPO, CIO, IT Security, Legal, affected department head, NPC (National Privacy Commission), affected data subjects
Source: workflow W53 — Data Privacy Breach Response</bpmn:documentation>
      <bpmn:laneSet id="W53_LaneSet8">
        <bpmn:lane id="W53_Lane1" name="IT Security">
        <bpmn:flowNodeRef>W53_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W53_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W53_Start9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W53_Lane2" name="CIO + DPO">
        <bpmn:flowNodeRef>W53_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W53_Task20</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W53_Lane3" name="DPO">
        <bpmn:flowNodeRef>W53_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W53_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W53_Task19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W53_Task21</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W53_Lane4" name="DPO + Legal">
        <bpmn:flowNodeRef>W53_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W53_Lane5" name="CIO">
        <bpmn:flowNodeRef>W53_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W53_Lane6" name="Legal">
        <bpmn:flowNodeRef>W53_Task17</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W53_Lane7" name="Dept. Head">
        <bpmn:flowNodeRef>W53_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W53_End22</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W53_Start9" name="Suspected or confirmed breach of personal data (customer, employee, or vendor data) as…">
        <bpmn:outgoing>W53_Flow25</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W53_Task10" name="Breach discovered or suspected: IT Security alerts (automated monitoring)…">
        <bpmn:documentation>Step 1: Breach discovered or suspected: IT Security alerts (automated monitoring), employee report, third-party notification, or customer complaint about unauthorized access
Responsible (R): IT Security / Any employee
Accountable (A): CIO
Duration: Immediate</bpmn:documentation>
        <bpmn:incoming>W53_Flow25</bpmn:incoming>
        <bpmn:outgoing>W53_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W53_Task11" name="CIO and DPO assess breach severity: (a) scope — how many records, what data…">
        <bpmn:documentation>Step 2: CIO and DPO assess breach severity: (a) scope — how many records, what data types (name, contact, financial, government ID), (b) vector — how the breach occurred (external attack, insider, misconfiguration, lost device, vendor breach), (c) containment status — is the breach ongoing or contained
Responsible (R): CIO + DPO
Accountable (A): CEO
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W53_Flow26</bpmn:incoming>
        <bpmn:outgoing>W53_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W53_Task12" name="Containment">
        <bpmn:documentation>Step 3: Containment: IT Security takes immediate action to stop the breach: isolate affected systems, revoke compromised credentials, block unauthorized access, preserve forensic evidence
Responsible (R): IT Security
Accountable (A): CIO
Duration: As needed</bpmn:documentation>
        <bpmn:incoming>W53_Flow27</bpmn:incoming>
        <bpmn:outgoing>W53_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W53_Task13" name="Notifiable breach">
        <bpmn:documentation>Step 4: DPO classifies the breach per NPC guidelines: (a) Notifiable breach — involves sensitive personal info, affects 100+ data subjects, or involves significant harm; (b) Non-notifiable breach — limited scope, no sensitive data, quickly contained
Responsible (R): DPO
Accountable (A): CEO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W53_Flow28</bpmn:incoming>
        <bpmn:outgoing>W53_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W53_Task14" name="If notifiable: DPO prepares NPC notification within 72 hours: nature of breach…">
        <bpmn:documentation>Step 5: If notifiable: DPO prepares NPC notification within 72 hours: nature of breach, data subjects affected, data types exposed, measures taken, remedial actions planned; submits via NPC online portal or prescribed form
Responsible (R): DPO
Accountable (A): CEO
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W53_Flow29</bpmn:incoming>
        <bpmn:outgoing>W53_Flow30</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W53_Task15" name="DPO prepares data subject notification: clear description of breach in plain…">
        <bpmn:documentation>Step 6: DPO prepares data subject notification: clear description of breach in plain language, data exposed, potential harm, mitigation steps data subjects should take, BuildRight contact for inquiries; notification via email, SMS, or website notice depending on breach scope
Responsible (R): DPO + Legal
Accountable (A): CMO
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W53_Flow30</bpmn:incoming>
        <bpmn:outgoing>W53_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W53_Task16" name="CIO directs forensic investigation: determine root cause, full scope, and…">
        <bpmn:documentation>Step 7: CIO directs forensic investigation: determine root cause, full scope, and whether any data was exfiltrated; engage external forensic firm if needed; preserve all logs and evidence
Responsible (R): CIO
Accountable (A): CEO
Duration: 1–5 days</bpmn:documentation>
        <bpmn:incoming>W53_Flow31</bpmn:incoming>
        <bpmn:outgoing>W53_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W53_Task17" name="Legal assesses regulatory and litigation risk: review NPC requirements…">
        <bpmn:documentation>Step 8: Legal assesses regulatory and litigation risk: review NPC requirements, evaluate liability exposure, prepare responses to potential regulatory inquiry or customer claims
Responsible (R): Legal
Accountable (A): CEO
Duration: As needed</bpmn:documentation>
        <bpmn:incoming>W53_Flow32</bpmn:incoming>
        <bpmn:outgoing>W53_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W53_Task18" name="Affected department head implements immediate operational safeguards: e.g., if…">
        <bpmn:documentation>Step 9: Affected department head implements immediate operational safeguards: e.g., if payment data breached — reset payment credentials, work with payment gateways; if employee data breached — offer credit monitoring
Responsible (R): Dept. Head
Accountable (A): CEO
Duration: As needed</bpmn:documentation>
        <bpmn:incoming>W53_Flow33</bpmn:incoming>
        <bpmn:outgoing>W53_Flow34</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W53_Task19" name="DPO documents full incident in breach register: timeline, root cause, scope…">
        <bpmn:documentation>Step 10: DPO documents full incident in breach register: timeline, root cause, scope, notifications sent, remedial actions, resolution date; breach register retained for 5 years per NPC requirements
Responsible (R): DPO
Accountable (A): CEO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W53_Flow34</bpmn:incoming>
        <bpmn:outgoing>W53_Flow35</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W53_Task20" name="Post-incident: CIO and DPO conduct lessons-learned review; update security…">
        <bpmn:documentation>Step 11: Post-incident: CIO and DPO conduct lessons-learned review; update security controls, access policies, and data handling procedures; implement preventive measures; schedule follow-up assessment in 30 days
Responsible (R): CIO + DPO
Accountable (A): CEO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W53_Flow35</bpmn:incoming>
        <bpmn:outgoing>W53_Flow36</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W53_Task21" name="Quarterly: DPO reviews breach register with CEO and Internal Audit; analyzes…">
        <bpmn:documentation>Step 12: Quarterly: DPO reviews breach register with CEO and Internal Audit; analyzes trends; reports aggregate breach statistics in annual privacy impact assessment
Responsible (R): DPO
Accountable (A): CEO
Duration: 30 min/quarter</bpmn:documentation>
        <bpmn:incoming>W53_Flow36</bpmn:incoming>
        <bpmn:outgoing>W53_Flow37</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W53_End22" name="Complete">
        <bpmn:incoming>W53_Flow37</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W53_Annotation23">
        <bpmn:text>Controls: - CTL-27 (safeguard customer data.) | - operational: Data Protection Officer (DPO) review and approval gate
Owner: Data Protection Officer (DPO)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W53_Assoc24" sourceRef="W53_Annotation23" targetRef="W53_Start9" associationDirection="None" />
      <bpmn:sequenceFlow id="W53_Flow25" sourceRef="W53_Start9" targetRef="W53_Task10" />
      <bpmn:sequenceFlow id="W53_Flow26" sourceRef="W53_Task10" targetRef="W53_Task11" />
      <bpmn:sequenceFlow id="W53_Flow27" sourceRef="W53_Task11" targetRef="W53_Task12" />
      <bpmn:sequenceFlow id="W53_Flow28" sourceRef="W53_Task12" targetRef="W53_Task13" />
