    <bpmn:process id="W_W152" name="W152. Employee IT Provisioning &amp; Access Lifecycle Management" isExecutable="false">
      <bpmn:documentation>Trigger: New hire notification (W15); employee transfer (W43.15); or separation (W43)
Frequency: 100–150 provisioning events/month
Volume: Covers ~6,911 employees and ~1,500 ERP users
Owner: IT Infrastructure Manager
Participants: HR, IT Helpdesk, Hiring Manager, Security
Source: workflow W152 — Employee IT Provisioning &amp; Access Lifecycle Management</bpmn:documentation>
      <bpmn:laneSet id="W152_LaneSet4">
        <bpmn:lane id="W152_Lane1" name="System">
        <bpmn:flowNodeRef>W152_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W152_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
