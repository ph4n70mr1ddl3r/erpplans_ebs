    <bpmn:process id="W_W379" name="W379. IT Service Request Fulfillment &amp; Service Catalog" isExecutable="false">
      <bpmn:documentation>Trigger: User submits a non-incident request (e.g., software install, access request, report access) via Service Catalog
Frequency: ~300–500 requests/month
Volume: Managing ~50 standard request types
Owner: IT Service Delivery Lead
Participants: IT Helpdesk, Dept Heads (for approval), IT Specialists
Source: workflow W379 — IT Service Request Fulfillment &amp; Service Catalog</bpmn:documentation>
      <bpmn:laneSet id="W379_LaneSet5">
        <bpmn:lane id="W379_Lane1" name="End User">
        <bpmn:flowNodeRef>W379_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W379_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W379_Lane2" name="Dept Head">
        <bpmn:flowNodeRef>W379_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W379_Lane3" name="Helpdesk Agent">
        <bpmn:flowNodeRef>W379_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W379_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W379_Lane4" name="IT Specialist">
        <bpmn:flowNodeRef>W379_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W379_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W379_Start6" name="User submits a non-incident request (e.g., software install, access request, report…">
        <bpmn:outgoing>W379_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W379_Task7" name="Request Intake">
        <bpmn:documentation>Step 1: Request Intake: User selects service from IT Service Catalog; provides required details/justification
Responsible (R): End User
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W379_Flow15</bpmn:incoming>
        <bpmn:outgoing>W379_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W379_Task8" name="Approval Workflow">
        <bpmn:documentation>Step 2: Approval Workflow: System routes request to Dept Head or Data Owner for approval (if required per catalog rules)
Responsible (R): Dept Head
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W379_Flow16</bpmn:incoming>
        <bpmn:outgoing>W379_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W379_Task9" name="Triage &amp; Assignment">
        <bpmn:documentation>Step 3: Triage &amp; Assignment: Helpdesk verifies approval and routes to appropriate team for fulfillment
Responsible (R): Helpdesk Agent
Accountable (A): Service Del Lead
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W379_Flow17</bpmn:incoming>
        <bpmn:outgoing>W379_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W379_Task10" name="Fulfillment">
        <bpmn:documentation>Step 4: Fulfillment: Execute standard request (e.g., install software via MDM, grant folder access, provision VoIP extension)
Responsible (R): IT Specialist / Helpdesk
Accountable (A): Service Del Lead
Duration: 15–60 min</bpmn:documentation>
        <bpmn:incoming>W379_Flow18</bpmn:incoming>
        <bpmn:outgoing>W379_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W379_Task11" name="Verification &amp; Closure">
        <bpmn:documentation>Step 5: Verification &amp; Closure: Confirm completion with user; close request; track fulfillment SLA (typically 24–48 hours)
Responsible (R): Helpdesk Agent
Accountable (A): Service Del Lead
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W379_Flow19</bpmn:incoming>
        <bpmn:outgoing>W379_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W379_End12" name="Complete">
        <bpmn:incoming>W379_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W379_Annotation13">
        <bpmn:text>Controls: - CTL-322 (ensure controlled execution — Service Management (PA-27.1).) | - operational: IT Service Delivery Lead review and approval gate
Owner: IT Service Delivery Lead</bpmn:text>
      </bpmn:textAnnotation>
