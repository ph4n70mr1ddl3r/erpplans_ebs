        <bpmn:flowNodeRef>W132_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W132_Lane6" name="DevOps">
        <bpmn:flowNodeRef>W132_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W132_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W132_Start8" name="Business request for new feature, bug fix, or system update">
        <bpmn:outgoing>W132_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W132_Task9" name="Requirement Analysis: Document functional and technical specs">
        <bpmn:documentation>Step 1: Requirement Analysis: Document functional and technical specs
Responsible (R): Business Analyst
Accountable (A): App Manager
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W132_Flow18</bpmn:incoming>
        <bpmn:outgoing>W132_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W132_Task10" name="Development: Code changes in sandbox/dev environment">
        <bpmn:documentation>Step 2: Development: Code changes in sandbox/dev environment
Responsible (R): Developer
Accountable (A): App Manager
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W132_Flow19</bpmn:incoming>
        <bpmn:outgoing>W132_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W132_Task11" name="Unit &amp; Integration Testing: Verify code in QA environment">
        <bpmn:documentation>Step 3: Unit &amp; Integration Testing: Verify code in QA environment
Responsible (R): QA Team
Accountable (A): App Manager
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W132_Flow20</bpmn:incoming>
        <bpmn:outgoing>W132_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W132_Task12" name="User Acceptance Testing (UAT): Business users sign off on change">
        <bpmn:documentation>Step 4: User Acceptance Testing (UAT): Business users sign off on change
Responsible (R): Dept Users
Accountable (A): Dept Head
Duration: 2–5 days</bpmn:documentation>
        <bpmn:incoming>W132_Flow21</bpmn:incoming>
        <bpmn:outgoing>W132_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W132_Task13" name="CAB Review: Evaluate risk and impact of the change">
        <bpmn:documentation>Step 5: CAB Review: Evaluate risk and impact of the change
Responsible (R): CAB
Accountable (A): CIO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W132_Flow22</bpmn:incoming>
        <bpmn:outgoing>W132_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W132_Task14" name="Deployment: Release to Production environment during maintenance window">
        <bpmn:documentation>Step 6: Deployment: Release to Production environment during maintenance window
Responsible (R): DevOps / IT Ops
Accountable (A): App Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W132_Flow23</bpmn:incoming>
        <bpmn:outgoing>W132_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W132_End15" name="Complete">
        <bpmn:incoming>W132_Flow24</bpmn:incoming>
      </bpmn:endEvent>
