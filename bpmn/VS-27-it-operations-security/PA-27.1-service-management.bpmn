        <bpmndi:BPMNEdge id="W392_Flow16_di" bpmnElement="W392_Flow16"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W392_Flow17_di" bpmnElement="W392_Flow17"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
