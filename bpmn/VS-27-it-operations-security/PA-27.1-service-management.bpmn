    <bpmn:process id="W_W387" name="W387. IT Compliance &amp; Control Self-Assessment (CSA)" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled quarterly review or pre-audit window
Frequency: Quarterly
Volume: Covers ITGCs (Access, Change, Operations) and regulatory requirements (NPC, BIR CAS)
Owner: IT Compliance Lead / IT Manager
Participants: IT Security, Internal Audit, Process Owners
Source: workflow W387 — IT Compliance &amp; Control Self-Assessment (CSA)</bpmn:documentation>
      <bpmn:laneSet id="W387_LaneSet2">
        <bpmn:lane id="W387_Lane1" name="IT Compliance Lead">
        <bpmn:flowNodeRef>W387_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W387_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W387_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W387_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W387_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W387_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W387_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W387_Start3" name="Scheduled quarterly review or pre-audit window">
        <bpmn:outgoing>W387_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W387_Task4" name="Control Selection">
        <bpmn:documentation>Step 1: Control Selection: Identify key controls to test (e.g., user access reviews, change approvals, backup success rates)
Responsible (R): IT Compliance Lead
Accountable (A): CIO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W387_Flow12</bpmn:incoming>
        <bpmn:outgoing>W387_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W387_Task5" name="Sampling">
        <bpmn:documentation>Step 2: Sampling: Select random samples of transactions/events (e.g., 25 change requests, 25 new hire access forms)
Responsible (R): IT Compliance Lead
Accountable (A): —
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W387_Flow13</bpmn:incoming>
        <bpmn:outgoing>W387_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W387_Task6" name="Evidence Collection">
        <bpmn:documentation>Step 3: Evidence Collection: Gather logs, approval emails, and screenshots as evidence of control performance
Responsible (R): IT Compliance Lead
Accountable (A): Process Owners
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W387_Flow14</bpmn:incoming>
        <bpmn:outgoing>W387_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W387_Task7" name="Gap Identification &amp; Remediation">
        <bpmn:documentation>Step 4: Gap Identification &amp; Remediation: Document any control failures; define remediation plan with owners and deadlines
Responsible (R): IT Compliance Lead
Accountable (A): CIO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W387_Flow15</bpmn:incoming>
        <bpmn:outgoing>W387_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W387_Task8" name="Reporting">
        <bpmn:documentation>Step 5: Reporting: Present CSA results and remediation status to CIO and Internal Audit
Responsible (R): IT Compliance Lead
Accountable (A): CIO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W387_Flow16</bpmn:incoming>
        <bpmn:outgoing>W387_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W387_End9" name="Complete">
        <bpmn:incoming>W387_Flow17</bpmn:incoming>
      </bpmn:endEvent>
