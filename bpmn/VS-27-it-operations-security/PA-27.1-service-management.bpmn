    <bpmn:process id="W_W381" name="W381. IT Knowledge Management" isExecutable="false">
      <bpmn:documentation>Trigger: Resolution of a new incident; completion of a project; or identifying a documentation gap
Frequency: Weekly updates
Volume: Maintaining ~200+ IT standard operating procedures (SOPs) and ~500+ &quot;How-To&quot; articles
Owner: IT Knowledge Coordinator
Participants: All IT Staff, IT Helpdesk Lead
Source: workflow W381 — IT Knowledge Management</bpmn:documentation>
      <bpmn:laneSet id="W381_LaneSet4">
        <bpmn:lane id="W381_Lane1" name="Technician">
        <bpmn:flowNodeRef>W381_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W381_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W381_Lane2" name="IT Lead">
        <bpmn:flowNodeRef>W381_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W381_Lane3" name="Knowledge Coord">
        <bpmn:flowNodeRef>W381_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W381_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W381_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W381_Start5" name="Resolution of a new incident; completion of a project; or identifying a documentation gap">
        <bpmn:outgoing>W381_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W381_Task6" name="Content Capture">
        <bpmn:documentation>Step 1: Content Capture: After incident resolution (W48) or project go-live, technician drafts a Knowledge Base (KB) article or SOP update
Responsible (R): Technician
Accountable (A): IT Lead
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W381_Flow13</bpmn:incoming>
        <bpmn:outgoing>W381_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W381_Task7" name="Review &amp; Validation">
        <bpmn:documentation>Step 2: Review &amp; Validation: Technical peer or IT Lead reviews article for accuracy, clarity, and security (no passwords/secrets)
Responsible (R): IT Lead
Accountable (A): Knowledge Coord
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W381_Flow14</bpmn:incoming>
        <bpmn:outgoing>W381_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W381_Task8" name="Publishing">
        <bpmn:documentation>Step 3: Publishing: Article published to either: (a) Internal IT KB (technical); or (b) End-User Portal (self-service)
Responsible (R): Knowledge Coord
Accountable (A): ITOC Lead
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W381_Flow15</bpmn:incoming>
        <bpmn:outgoing>W381_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W381_Task9" name="Maintenance">
        <bpmn:documentation>Step 4: Maintenance: Periodic review of articles based on usage and feedback; retire or update outdated content
Responsible (R): Knowledge Coord
Accountable (A): ITOC Lead
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W381_Flow16</bpmn:incoming>
        <bpmn:outgoing>W381_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W381_End10" name="Complete">
        <bpmn:incoming>W381_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W381_Annotation11">
        <bpmn:text>Controls: - CTL-322 (ensure controlled execution — Service Management (PA-27.1).) | - operational: IT Knowledge Coordinator review and approval gate
Owner: IT Knowledge Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W381_Assoc12" sourceRef="W381_Annotation11" targetRef="W381_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W381_Flow13" sourceRef="W381_Start5" targetRef="W381_Task6" />
