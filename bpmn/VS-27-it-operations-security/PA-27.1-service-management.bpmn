    <bpmn:process id="W_W370" name="W370. Software License &amp; SaaS Subscription Management" isExecutable="false">
      <bpmn:documentation>Trigger: New software request; employee separation (W43); or annual true-up
Frequency: Monthly reconciliation; annual true-up
Volume: ~50+ SaaS applications; ~1,500 ERP users; ~6,911 M365/Email users
Owner: Software Asset Manager
Participants: IT Helpdesk, Procurement, Finance
Source: workflow W370 — Software License &amp; SaaS Subscription Management</bpmn:documentation>
      <bpmn:laneSet id="W370_LaneSet3">
        <bpmn:lane id="W370_Lane1" name="IT Helpdesk">
        <bpmn:flowNodeRef>W370_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W370_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W370_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W370_Lane2" name="SW Asset Mgr">
        <bpmn:flowNodeRef>W370_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W370_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W370_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W370_Start4" name="New software request; employee separation (W43); or annual true-up">
        <bpmn:outgoing>W370_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W370_Task5" name="License Allocation">
        <bpmn:documentation>Step 1: License Allocation: Assign software licenses based on job role during provisioning (W152)
Responsible (R): IT Helpdesk
Accountable (A): SW Asset Mgr
Duration: 10 min/user</bpmn:documentation>
        <bpmn:incoming>W370_Flow12</bpmn:incoming>
        <bpmn:outgoing>W370_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W370_Task6" name="Harvesting">
        <bpmn:documentation>Step 2: Harvesting: Reclaim licenses from inactive or separated users within 24 hours of notification (W43)
Responsible (R): IT Helpdesk
Accountable (A): SW Asset Mgr
Duration: 10 min/user</bpmn:documentation>
        <bpmn:incoming>W370_Flow13</bpmn:incoming>
        <bpmn:outgoing>W370_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W370_Task7" name="Usage Audit">
        <bpmn:documentation>Step 3: Usage Audit: Quarterly review of actual software usage vs. licensed seats; identify &quot;shelfware&quot; for reduction
Responsible (R): SW Asset Mgr
Accountable (A): CIO
Duration: 4 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W370_Flow14</bpmn:incoming>
        <bpmn:outgoing>W370_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W370_Task8" name="Compliance Review">
        <bpmn:documentation>Step 4: Compliance Review: Annual &quot;True-Up&quot; reconciliation with major vendors (Microsoft, Oracle, SAP, etc.)
Responsible (R): SW Asset Mgr
Accountable (A): CIO
Duration: 1 week/year</bpmn:documentation>
        <bpmn:incoming>W370_Flow15</bpmn:incoming>
        <bpmn:outgoing>W370_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W370_End9" name="Complete">
        <bpmn:incoming>W370_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W370_Annotation10">
