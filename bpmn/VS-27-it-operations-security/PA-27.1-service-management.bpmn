    <bpmn:process id="W_W615" name="W615. Customer Mobile App Daily Operations &amp; Content Management" isExecutable="false">
      <bpmn:documentation>Trigger: Start of business day; content update request; app performance alert
Frequency: Daily monitoring; continuous content management
Volume: ~600,000 registered app users; ~42,900 ecommerce orders/month via app/web; daily active users ~15,000–20,000
Owner: Digital Product Manager
Participants: Digital Product Manager, Mobile Developer, Content Manager, Marketing Specialist, IT Integration Specialist
Source: workflow W615 — Customer Mobile App Daily Operations &amp; Content Management</bpmn:documentation>
      <bpmn:laneSet id="W615_LaneSet4">
        <bpmn:lane id="W615_Lane1" name="Digital Product Manager">
        <bpmn:flowNodeRef>W615_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W615_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W615_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W615_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W615_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W615_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W615_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W615_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W615_Lane2" name="Mobile Developer">
        <bpmn:flowNodeRef>W615_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W615_Lane3" name="Marketing Specialist">
        <bpmn:flowNodeRef>W615_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W615_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W615_Start5" name="Start of business day; content update request; app performance alert">
        <bpmn:outgoing>W615_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W615_Task6" name="Morning: Digital Product Manager reviews app performance dashboard — daily…">
        <bpmn:documentation>Step 1: Morning: Digital Product Manager reviews app performance dashboard — daily active users, session duration, crash rate (target &lt; 0.5%), API response time, app store rating, and user review feed
Responsible (R): Digital Product Manager
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W615_Flow18</bpmn:incoming>
        <bpmn:outgoing>W615_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W615_Task7" name="For crashes or performance degradation: Mobile Developer investigates crash…">
        <bpmn:documentation>Step 2: For crashes or performance degradation: Mobile Developer investigates crash logs and performance metrics; identifies root cause (OS compatibility, API timeout, memory leak); deploys hotfix via expedited app store review process (per W395)
Responsible (R): Mobile Developer
Accountable (A): Digital Product Manager
Duration: 1-4 hours</bpmn:documentation>
        <bpmn:incoming>W615_Flow19</bpmn:incoming>
        <bpmn:outgoing>W615_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W615_Task8" name="Content updates: Marketing Specialist submits content update requests for app…">
        <bpmn:documentation>Step 3: Content updates: Marketing Specialist submits content update requests for app home screen banners, promotional push notifications, and featured products; Digital Product Manager approves content calendar
Responsible (R): Marketing Specialist
Accountable (A): Digital Product Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W615_Flow20</bpmn:incoming>
        <bpmn:outgoing>W615_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W615_Task9" name="Digital Product Manager configures push notification campaigns: target segment…">
        <bpmn:documentation>Step 4: Digital Product Manager configures push notification campaigns: target segment (from CDP per W156), message content, delivery time, and A/B test variant; system schedules delivery via push notification service
Responsible (R): Digital Product Manager
Accountable (A): —
Duration: 15 min/campaign</bpmn:documentation>
        <bpmn:incoming>W615_Flow21</bpmn:incoming>
        <bpmn:outgoing>W615_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W615_Task10" name="Feature flag management: Digital Product Manager reviews active feature flags…">
        <bpmn:documentation>Step 5: Feature flag management: Digital Product Manager reviews active feature flags (new features gradually rolled out to % of users); adjusts rollout percentage based on usage analytics and error rates; activates or deactivates features via remote configuration
Responsible (R): Digital Product Manager
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W615_Flow22</bpmn:incoming>
        <bpmn:outgoing>W615_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W615_Task11" name="Product catalog sync verification: Digital Product Manager confirms app product…">
        <bpmn:documentation>Step 6: Product catalog sync verification: Digital Product Manager confirms app product catalog matches ERP (per ECOM-009); spot-checks product images, prices, and availability for top 100 SKUs; flags discrepancies to IT Integration Specialist
Responsible (R): Digital Product Manager
Accountable (A): IT Specialist
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W615_Flow23</bpmn:incoming>
        <bpmn:outgoing>W615_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W615_Task12" name="User analytics review: Digital Product Manager analyzes user journey funnels —…">
        <bpmn:documentation>Step 7: User analytics review: Digital Product Manager analyzes user journey funnels — app open → product search → product view → add to cart → checkout → payment completion; identifies drop-off points; creates improvement backlog items
Responsible (R): Digital Product Manager
Accountable (A): —
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W615_Flow24</bpmn:incoming>
        <bpmn:outgoing>W615_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W615_Task13" name="App store management: Digital Product Manager responds to user reviews…">
        <bpmn:documentation>Step 8: App store management: Digital Product Manager responds to user reviews (escalating technical issues to development team), monitors app store rating trend, and coordinates app version updates (per W395) with release notes and screenshots
Responsible (R): Digital Product Manager
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W615_Flow25</bpmn:incoming>
        <bpmn:outgoing>W615_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W615_Task14" name="Weekly: Digital Product Manager presents app performance summary to CMO and CIO…">
        <bpmn:documentation>Step 9: Weekly: Digital Product Manager presents app performance summary to CMO and CIO — user growth, engagement metrics, conversion rates, crash-free rate, app store rating, and upcoming feature roadmap
Responsible (R): Digital Product Manager
Accountable (A): CMO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W615_Flow26</bpmn:incoming>
        <bpmn:outgoing>W615_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W615_End15" name="Complete">
        <bpmn:incoming>W615_Flow27</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W615_Annotation16">
        <bpmn:text>Controls: - CTL-322 (ensure controlled execution — Service Management (PA-27.1).) | - operational: remote configuration for non-code changes and expedited review requests for critical fixes; operational: broad device testing matrix and graceful degradation for older OS versions; operational: preference center allowing users to choose notification types
Owner: Digital Product Manager</bpmn:text>
      </bpmn:textAnnotation>
