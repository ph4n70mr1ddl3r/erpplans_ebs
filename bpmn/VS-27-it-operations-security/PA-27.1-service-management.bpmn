    <bpmn:process id="W_W391" name="W391. Software Quality Assurance (QA) &amp; Testing Lifecycle" isExecutable="false">
      <bpmn:documentation>Trigger: Completion of software development (W132) or start of a major project
Frequency: Per release cycle (weekly)
Volume: Testing ~5–10 changes per week; major regression quarterly
Owner: QA Manager
Participants: QA Engineers, Developers, Business Analysts, DevOps
Source: workflow W391 — Software Quality Assurance (QA) &amp; Testing Lifecycle</bpmn:documentation>
      <bpmn:laneSet id="W391_LaneSet4">
        <bpmn:lane id="W391_Lane1" name="QA Manager">
        <bpmn:flowNodeRef>W391_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W391_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W391_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W391_Lane2" name="QA Engineer">
        <bpmn:flowNodeRef>W391_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W391_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W391_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W391_Lane3" name="DevOps">
        <bpmn:flowNodeRef>W391_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W391_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W391_Start5" name="Completion of software development (W132) or start of a major project">
        <bpmn:outgoing>W391_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W391_Task6" name="Test Planning">
        <bpmn:documentation>Step 1: Test Planning: Define test strategy, scope, and resources for the release; identify critical regression paths
Responsible (R): QA Manager
Accountable (A): App Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W391_Flow15</bpmn:incoming>
        <bpmn:outgoing>W391_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W391_Task7" name="Test Case Development">
        <bpmn:documentation>Step 2: Test Case Development: Create or update manual and automated test scripts based on functional specs
Responsible (R): QA Engineer
Accountable (A): QA Manager
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W391_Flow16</bpmn:incoming>
        <bpmn:outgoing>W391_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W391_Task8" name="Environment Prep">
        <bpmn:documentation>Step 3: Environment Prep: Deploy code to QA environment; verify data sets (W384)
Responsible (R): DevOps
Accountable (A): QA Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W391_Flow17</bpmn:incoming>
        <bpmn:outgoing>W391_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W391_Task9" name="Test Execution">
        <bpmn:documentation>Step 4: Test Execution: Execute manual and automated tests (Functional, Regression, Integration, Performance, Security)
Responsible (R): QA Engineer
Accountable (A): QA Manager
Duration: 2–4 days</bpmn:documentation>
        <bpmn:incoming>W391_Flow18</bpmn:incoming>
        <bpmn:outgoing>W391_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W391_Task10" name="Defect Management">
        <bpmn:documentation>Step 5: Defect Management: Log bugs in tracking system; re-test fixes until resolved or deferred
Responsible (R): QA Engineer
Accountable (A): Developer
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W391_Flow19</bpmn:incoming>
        <bpmn:outgoing>W391_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W391_Task11" name="Test Summary Report">
        <bpmn:documentation>Step 6: Test Summary Report: Document test results, coverage, and remaining known defects; provide &quot;Go/No-Go&quot; recommendation
Responsible (R): QA Manager
Accountable (A): CIO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W391_Flow20</bpmn:incoming>
        <bpmn:outgoing>W391_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W391_End12" name="Complete">
        <bpmn:incoming>W391_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W391_Annotation13">
        <bpmn:text>Controls: - CTL-322 (ensure controlled execution — Service Management (PA-27.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: QA Manager</bpmn:text>
      </bpmn:textAnnotation>
