    <bpmn:process id="W_W392" name="W392. IT Service Level Management (SLM) &amp; Business Relationship Management (BRM)" isExecutable="false">
      <bpmn:documentation>Trigger: Annual service review; or new business requirement
Frequency: Monthly reviews; Annual SLA refresh
Volume: Managing ~15 core business services (e.g., POS, Ecommerce, DC Ops)
Owner: IT Service Delivery Manager
Participants: CIO, Department Heads, IT Leads
Source: workflow W392 — IT Service Level Management (SLM) &amp; Business Relationship Management (BRM)</bpmn:documentation>
      <bpmn:laneSet id="W392_LaneSet3">
        <bpmn:lane id="W392_Lane1" name="Service Del Mgr">
        <bpmn:flowNodeRef>W392_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W392_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W392_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W392_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W392_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W392_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W392_Lane2" name="ITOC Lead">
        <bpmn:flowNodeRef>W392_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W392_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W392_Start4" name="Annual service review; or new business requirement">
        <bpmn:outgoing>W392_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W392_Task5" name="Service Definition">
        <bpmn:documentation>Step 1: Service Definition: Catalog core IT services and their impact on business processes
Responsible (R): Service Del Mgr
Accountable (A): CIO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W392_Flow14</bpmn:incoming>
        <bpmn:outgoing>W392_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W392_Task6" name="SLA Negotiation">
        <bpmn:documentation>Step 2: SLA Negotiation: Define RTO, RPO, and uptime targets for each service with Department Heads
Responsible (R): Service Del Mgr
Accountable (A): Dept Head
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W392_Flow15</bpmn:incoming>
        <bpmn:outgoing>W392_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W392_Task7" name="Service Monitoring">
        <bpmn:documentation>Step 3: Service Monitoring: Monitor actual performance against SLA targets (W380)
Responsible (R): ITOC Lead
Accountable (A): Service Del Mgr
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W392_Flow16</bpmn:incoming>
        <bpmn:outgoing>W392_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W392_Task8" name="SLA Reporting">
        <bpmn:documentation>Step 4: SLA Reporting: Generate monthly Service Level Reports showing compliance and breaches
Responsible (R): Service Del Mgr
Accountable (A): CIO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W392_Flow17</bpmn:incoming>
        <bpmn:outgoing>W392_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W392_Task9" name="Business Review (BRM)">
        <bpmn:documentation>Step 5: Business Review (BRM): Meet with Dept Heads monthly to discuss IT performance, upcoming needs, and satisfaction
Responsible (R): Service Del Mgr
Accountable (A): Dept Head
Duration: 1 hour/dept</bpmn:documentation>
        <bpmn:incoming>W392_Flow18</bpmn:incoming>
        <bpmn:outgoing>W392_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W392_Task10" name="Service Improvement Plan (SIP)">
        <bpmn:documentation>Step 6: Service Improvement Plan (SIP): If SLAs are consistently breached, initiate a SIP to address root causes (W378)
Responsible (R): Service Del Mgr
Accountable (A): CIO
Duration: As needed</bpmn:documentation>
        <bpmn:incoming>W392_Flow19</bpmn:incoming>
        <bpmn:outgoing>W392_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W392_End11" name="Complete">
        <bpmn:incoming>W392_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W392_Annotation12">
        <bpmn:text>Controls: - CTL-322 (ensure controlled execution — Service Management (PA-27.1).) | - operational: IT Service Delivery Manager review and approval gate
Owner: IT Service Delivery Manager</bpmn:text>
      </bpmn:textAnnotation>
