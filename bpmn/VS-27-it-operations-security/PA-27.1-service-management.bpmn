    <bpmn:process id="W_W380" name="W380. IT Alert &amp; Event Management" isExecutable="false">
      <bpmn:documentation>Trigger: Automated alert from infrastructure, application, or security monitoring tools
Frequency: Continuous; thousands of events/day; ~20–30 actionable alerts/day
Volume: Monitoring 200+ stores, 4 DCs, 150+ cloud instances, and 50+ integrations
Owner: IT Operations (FS/INFRA)
Participants: ITOC Analysts, Infrastructure Team, Network Engineers
Source: workflow W380 — IT Alert &amp; Event Management</bpmn:documentation>
      <bpmn:laneSet id="W380_LaneSet4">
        <bpmn:lane id="W380_Lane1" name="System">
        <bpmn:flowNodeRef>W380_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W380_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W380_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W380_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W380_Lane2" name="ITOC Analyst">
        <bpmn:flowNodeRef>W380_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W380_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W380_Lane3" name="ITOC Lead">
        <bpmn:flowNodeRef>W380_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W380_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W380_Start5" name="Automated alert from infrastructure, application, or security monitoring tools">
        <bpmn:outgoing>W380_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W380_Task6" name="Event Collection">
        <bpmn:documentation>Step 1: Event Collection: Monitoring tools collect telemetry data; apply filters to remove &quot;noise&quot; and group related events
Responsible (R): System
Accountable (A): —
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W380_Flow15</bpmn:incoming>
        <bpmn:outgoing>W380_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W380_Task7" name="Alert Generation">
        <bpmn:documentation>Step 2: Alert Generation: Threshold breach or pattern detection triggers an actionable alert; system auto-classifies severity
Responsible (R): System
Accountable (A): —
Duration: Immediate</bpmn:documentation>
        <bpmn:incoming>W380_Flow16</bpmn:incoming>
        <bpmn:outgoing>W380_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W380_Task8" name="Triage &amp; Correlation">
        <bpmn:documentation>Step 3: Triage &amp; Correlation: ITOC Analyst reviews alert; correlates with other alerts (e.g., &quot;Network Down&quot; + &quot;POS Sync Error&quot;); determines if it&#x27;s a real incident
Responsible (R): ITOC Analyst
Accountable (A): ITOC Lead
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W380_Flow17</bpmn:incoming>
        <bpmn:outgoing>W380_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W380_Task9" name="Incident Conversion">
        <bpmn:documentation>Step 4: Incident Conversion: For confirmed issues, system auto-creates an Incident Ticket (W48) and populates with diagnostic data
Responsible (R): System / ITOC Analyst
Accountable (A): ITOC Lead
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W380_Flow18</bpmn:incoming>
        <bpmn:outgoing>W380_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W380_Task10" name="Escalation">
        <bpmn:documentation>Step 5: Escalation: Notify relevant technical team (Network, Cloud, DB) per the on-call schedule; monitor for resolution
Responsible (R): ITOC Analyst
Accountable (A): ITOC Lead
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W380_Flow19</bpmn:incoming>
        <bpmn:outgoing>W380_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W380_Task11" name="Threshold Tuning">
        <bpmn:documentation>Step 6: Threshold Tuning: Monthly: Review &quot;false positive&quot; alerts; tune thresholds to improve signal-to-noise ratio
Responsible (R): ITOC Lead
Accountable (A): IT Infra Mgr
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W380_Flow20</bpmn:incoming>
        <bpmn:outgoing>W380_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W380_End12" name="Complete">
        <bpmn:incoming>W380_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W380_Annotation13">
        <bpmn:text>Controls: - CTL-322 (ensure controlled execution — Service Management (PA-27.1).) | - operational: IT Operations Center (ITOC) Lead review and approval gate
Owner: IT Operations (FS/INFRA)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W380_Assoc14" sourceRef="W380_Annotation13" targetRef="W380_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W380_Flow15" sourceRef="W380_Start5" targetRef="W380_Task6" />
      <bpmn:sequenceFlow id="W380_Flow16" sourceRef="W380_Task6" targetRef="W380_Task7" />
      <bpmn:sequenceFlow id="W380_Flow17" sourceRef="W380_Task7" targetRef="W380_Task8" />
      <bpmn:sequenceFlow id="W380_Flow18" sourceRef="W380_Task8" targetRef="W380_Task9" />
      <bpmn:sequenceFlow id="W380_Flow19" sourceRef="W380_Task9" targetRef="W380_Task10" />
      <bpmn:sequenceFlow id="W380_Flow20" sourceRef="W380_Task10" targetRef="W380_Task11" />
      <bpmn:sequenceFlow id="W380_Flow21" sourceRef="W380_Task11" targetRef="W380_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W380_diag">
      <bpmndi:BPMNPlane id="W380_plane" bpmnElement="W_W380">
        <bpmndi:BPMNShape id="W380_Lane1_di" bpmnElement="W380_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W380_Lane2_di" bpmnElement="W380_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1580" height="170" /></bpmndi:BPMNShape>
