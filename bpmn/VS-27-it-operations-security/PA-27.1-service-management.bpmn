    <bpmn:process id="W_W398" name="W398. IT Innovation, Emerging Tech &amp; Proof of Concept (PoC) Lifecycle" isExecutable="false">
      <bpmn:documentation>Trigger: Strategic roadmap item (W386); or business request for breakthrough tech
Frequency: 2–3 PoCs per year
Volume: Managing experimental tech (e.g., GenAI, IoT, Edge Compute)
Owner: IT Innovation Lead / CIO
Participants: Tech Leads, Business Stakeholders, Vendors
Source: workflow W398 — IT Innovation, Emerging Tech &amp; Proof of Concept (PoC) Lifecycle</bpmn:documentation>
      <bpmn:laneSet id="W398_LaneSet5">
        <bpmn:lane id="W398_Lane1" name="Innovation Lead">
        <bpmn:flowNodeRef>W398_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W398_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W398_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W398_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W398_Lane2" name="Cloud Arch">
        <bpmn:flowNodeRef>W398_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W398_Lane3" name="Tech Leads">
        <bpmn:flowNodeRef>W398_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W398_Lane4" name="CIO">
        <bpmn:flowNodeRef>W398_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W398_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W398_Start6" name="Strategic roadmap item (W386); or business request for breakthrough tech">
        <bpmn:outgoing>W398_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W398_Task7" name="Opportunity Triage">
        <bpmn:documentation>Step 1: Opportunity Triage: Evaluate new tech against business pain points (e.g., &quot;Can GenAI improve helpdesk resolution?&quot;)
Responsible (R): Innovation Lead
Accountable (A): CIO
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W398_Flow16</bpmn:incoming>
        <bpmn:outgoing>W398_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W398_Task8" name="PoC Definition">
        <bpmn:documentation>Step 2: PoC Definition: Define success criteria (KPIs), scope, and duration (typically 4–8 weeks) for the experiment
Responsible (R): Innovation Lead
Accountable (A): Business Owner
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W398_Flow17</bpmn:incoming>
        <bpmn:outgoing>W398_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W398_Task9" name="Sandbox Setup">
        <bpmn:documentation>Step 3: Sandbox Setup: Provision isolated environment for the PoC to prevent production risk
Responsible (R): Cloud Arch
Accountable (A): Innovation Lead
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W398_Flow18</bpmn:incoming>
        <bpmn:outgoing>W398_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W398_Task10" name="Execution">
        <bpmn:documentation>Step 4: Execution: Build and test the PoC; partner with vendors if needed for rapid prototyping
Responsible (R): Tech Leads / Vendor
Accountable (A): Innovation Lead
Duration: 4–8 weeks</bpmn:documentation>
        <bpmn:incoming>W398_Flow19</bpmn:incoming>
        <bpmn:outgoing>W398_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W398_Task11" name="Evaluation">
        <bpmn:documentation>Step 5: Evaluation: Measure results against success criteria; determine ROI and scalability
Responsible (R): Innovation Lead
Accountable (A): CIO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W398_Flow20</bpmn:incoming>
        <bpmn:outgoing>W398_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W398_Task12" name="Transition Decision">
        <bpmn:documentation>Step 6: Transition Decision: (a) Scale: Move to Project Intake (W374); (b) Pivot: Adjust tech/use case; (c) Stop: Archive learnings
Responsible (R): CIO
Accountable (A): CEO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W398_Flow21</bpmn:incoming>
        <bpmn:outgoing>W398_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W398_End13" name="Complete">
        <bpmn:incoming>W398_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W398_Annotation14">
        <bpmn:text>Controls: - CTL-322 (ensure controlled execution — Service Management (PA-27.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: IT Innovation Lead / CIO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W398_Assoc15" sourceRef="W398_Annotation14" targetRef="W398_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W398_Flow16" sourceRef="W398_Start6" targetRef="W398_Task7" />
      <bpmn:sequenceFlow id="W398_Flow17" sourceRef="W398_Task7" targetRef="W398_Task8" />
      <bpmn:sequenceFlow id="W398_Flow18" sourceRef="W398_Task8" targetRef="W398_Task9" />
      <bpmn:sequenceFlow id="W398_Flow19" sourceRef="W398_Task9" targetRef="W398_Task10" />
      <bpmn:sequenceFlow id="W398_Flow20" sourceRef="W398_Task10" targetRef="W398_Task11" />
      <bpmn:sequenceFlow id="W398_Flow21" sourceRef="W398_Task11" targetRef="W398_Task12" />
      <bpmn:sequenceFlow id="W398_Flow22" sourceRef="W398_Task12" targetRef="W398_End13" />
    </bpmn:process>
