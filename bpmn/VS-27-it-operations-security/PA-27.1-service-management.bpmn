      <bpmn:sequenceFlow id="W385_Flow21" sourceRef="W385_Task11" targetRef="W385_Task12" />
      <bpmn:sequenceFlow id="W385_Flow22" sourceRef="W385_Task12" targetRef="W385_End13" />
    </bpmn:process>
