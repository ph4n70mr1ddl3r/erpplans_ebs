<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-27.1-service-management" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W48" name="W48. IT Operations &amp; Helpdesk Support" isExecutable="false">
      <bpmn:documentation>Trigger: User reports issue (phone, email, self-service portal); system generates automated alert; scheduled change window
Frequency: Continuous; ~800–1,200 support tickets/month across all locations
Volume: ~6,911 users; 600 POS terminals; 4 WMS Systems; ~500 RF devices; 200+ network locations
Owner: IT Helpdesk Lead
Participants: IT Helpdesk, IT Infrastructure, IT Applications, end users, external vendors
Source: workflow W48 — IT Operations &amp; Helpdesk Support</bpmn:documentation>
      <bpmn:laneSet id="W48_LaneSet10">
        <bpmn:lane id="W48_Lane1" name="End User">
        <bpmn:flowNodeRef>W48_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W48_Start11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W48_Lane2" name="Helpdesk Agent">
        <bpmn:flowNodeRef>W48_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W48_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W48_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W48_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W48_Task21</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W48_Lane3" name="System">
        <bpmn:flowNodeRef>W48_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W48_Lane4" name="IT Specialist">
        <bpmn:flowNodeRef>W48_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W48_Task19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W48_Task20</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W48_Lane5" name="IT Helpdesk Lead">
        <bpmn:flowNodeRef>W48_Task22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W48_Task24</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W48_Lane6" name="IT Team Member">
        <bpmn:flowNodeRef>W48_Task23</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W48_Lane7" name="CIO">
        <bpmn:flowNodeRef>W48_Task25</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W48_Lane8" name="IT Infrastructure">
        <bpmn:flowNodeRef>W48_Task26</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W48_Lane9" name="IT Team">
        <bpmn:flowNodeRef>W48_Task27</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W48_End28</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W48_Start11" name="User reports issue (phone, email, self-service portal); system generates automated alert…">
        <bpmn:outgoing>W48_Flow31</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W48_Task12" name="User contacts IT Helpdesk via phone, email, or self-service portal; describes…">
        <bpmn:documentation>Step 1: User contacts IT Helpdesk via phone, email, or self-service portal; describes issue with system, hardware, network, or access
Responsible (R): End User
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W48_Flow31</bpmn:incoming>
        <bpmn:outgoing>W48_Flow32</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W48_Task13" name="Helpdesk Agent creates support ticket: user, location, device, issue category…">
        <bpmn:documentation>Step 2: Helpdesk Agent creates support ticket: user, location, device, issue category, severity (see matrix below), description
Responsible (R): Helpdesk Agent
Accountable (A): IT Helpdesk Lead
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W48_Flow32</bpmn:incoming>
        <bpmn:outgoing>W48_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W48_Task14" name="System auto-routes ticket based on category: (a) POS/retail → Retail IT support…">
        <bpmn:documentation>Step 3: System auto-routes ticket based on category: (a) POS/retail → Retail IT support queue, (b) network/connectivity → Infrastructure queue, (c) ERP/application → Applications queue, (d) hardware → Hardware support queue, (e) access/permissions → Security queue
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W48_Flow33</bpmn:incoming>
        <bpmn:outgoing>W48_Flow34</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W48_Task15" name="Tier 1 — Remote resolution">
        <bpmn:documentation>Step 4: Tier 1 — Remote resolution: Helpdesk Agent attempts to resolve remotely (password reset, configuration fix, user guidance, system restart)
Responsible (R): Helpdesk Agent
Accountable (A): IT Helpdesk Lead
Duration: 5–15 min</bpmn:documentation>
        <bpmn:incoming>W48_Flow34</bpmn:incoming>
        <bpmn:outgoing>W48_Flow35</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W48_Task16" name="If Tier 1 resolves: ticket closed with resolution code; user confirms">
        <bpmn:documentation>Step 5: If Tier 1 resolves: ticket closed with resolution code; user confirms
Responsible (R): Helpdesk Agent
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W48_Flow35</bpmn:incoming>
        <bpmn:outgoing>W48_Flow36</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W48_Task17" name="If Tier 1 unresolved: ticket escalated to Tier 2 (specialist) with diagnostic…">
        <bpmn:documentation>Step 6: If Tier 1 unresolved: ticket escalated to Tier 2 (specialist) with diagnostic notes; SLA timer restarts per severity
Responsible (R): Helpdesk Agent
Accountable (A): IT Helpdesk Lead
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W48_Flow36</bpmn:incoming>
        <bpmn:outgoing>W48_Flow37</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W48_Task18" name="Tier 2 — Specialist resolution">
        <bpmn:documentation>Step 7: Tier 2 — Specialist resolution: IT specialist investigates; may require remote session, configuration change, or system-level fix
Responsible (R): IT Specialist
Accountable (A): IT Helpdesk Lead
Duration: 15–60 min</bpmn:documentation>
        <bpmn:incoming>W48_Flow37</bpmn:incoming>
        <bpmn:outgoing>W48_Flow38</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W48_Task19" name="If Tier 2 requires on-site presence (hardware failure, network cabling, POS…">
        <bpmn:documentation>Step 8: If Tier 2 requires on-site presence (hardware failure, network cabling, POS terminal replacement): ticket assigned to IT Field Support with scheduled site visit
Responsible (R): IT Specialist
Accountable (A): CIO
Duration: Scheduling: 5 min</bpmn:documentation>
        <bpmn:incoming>W48_Flow38</bpmn:incoming>
        <bpmn:outgoing>W48_Flow39</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W48_Task20" name="Tier 3 — Vendor / escalation">
        <bpmn:documentation>Step 9: Tier 3 — Vendor / escalation: if issue requires vendor support (POS software bug, ERP vendor support, hardware warranty claim), IT engages vendor; tracks vendor response SLA
Responsible (R): IT Specialist / CIO
Accountable (A): CIO
Duration: Vendor-dependent</bpmn:documentation>
        <bpmn:incoming>W48_Flow39</bpmn:incoming>
        <bpmn:outgoing>W48_Flow40</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W48_Task21" name="Resolution confirmed by user; ticket closed; system logs resolution time, root…">
        <bpmn:documentation>Step 10: Resolution confirmed by user; ticket closed; system logs resolution time, root cause category, and recurring issue flag
Responsible (R): Helpdesk Agent
Accountable (A): IT Helpdesk Lead
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W48_Flow40</bpmn:incoming>
        <bpmn:outgoing>W48_Flow41</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W48_Task22" name="Monthly: IT Helpdesk Lead reviews ticket analytics: volume by category…">
        <bpmn:documentation>Step 11: Monthly: IT Helpdesk Lead reviews ticket analytics: volume by category, resolution rate by tier, SLA compliance, mean time to resolution, top recurring issues per location
Responsible (R): IT Helpdesk Lead
Accountable (A): CIO
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W48_Flow41</bpmn:incoming>
        <bpmn:outgoing>W48_Flow42</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W48_Task23" name="IT team member submits change request: description, affected systems, risk…">
        <bpmn:documentation>Step 12: IT team member submits change request: description, affected systems, risk assessment, rollback plan, planned window
Responsible (R): IT Team Member
Accountable (A): IT Helpdesk Lead
Duration: As needed (~20–30 changes/month)</bpmn:documentation>
        <bpmn:incoming>W48_Flow42</bpmn:incoming>
        <bpmn:outgoing>W48_Flow43</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W48_Task24" name="IT Helpdesk Lead reviews and classifies: (a) standard change (pre-approved, low…">
        <bpmn:documentation>Step 13: IT Helpdesk Lead reviews and classifies: (a) standard change (pre-approved, low risk — e.g., password policy update), (b) normal change (requires review and approval — e.g., POS software patch), (c) emergency change (unplanned, critical fix — e.g., security vulnerability patch)
Responsible (R): IT Helpdesk Lead
Accountable (A): CIO
Duration: 10 min/change</bpmn:documentation>
        <bpmn:incoming>W48_Flow43</bpmn:incoming>
        <bpmn:outgoing>W48_Flow44</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W48_Task25" name="Normal changes: CIO approves; emergency changes: CIO verbal approval with…">
        <bpmn:documentation>Step 14: Normal changes: CIO approves; emergency changes: CIO verbal approval with post-hoc documentation; standard changes: auto-approved per catalog
Responsible (R): CIO
Accountable (A): —
Duration: 5–15 min/change</bpmn:documentation>
        <bpmn:incoming>W48_Flow44</bpmn:incoming>
        <bpmn:outgoing>W48_Flow45</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W48_Task26" name="Change executed during maintenance window (typically Tuesday/Thursday…">
        <bpmn:documentation>Step 15: Change executed during maintenance window (typically Tuesday/Thursday 22:00–02:00 or Sunday 00:00–04:00 to avoid peak hours)
Responsible (R): IT Infrastructure
Accountable (A): CIO
Duration: Per change</bpmn:documentation>
        <bpmn:incoming>W48_Flow45</bpmn:incoming>
        <bpmn:outgoing>W48_Flow46</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W48_Task27" name="Post-change verification: IT confirms system health; Helpdesk monitors for…">
        <bpmn:documentation>Step 16: Post-change verification: IT confirms system health; Helpdesk monitors for related ticket spikes in next 24 hours
Responsible (R): IT Team
Accountable (A): IT Helpdesk Lead
Duration: 15 min/change</bpmn:documentation>
        <bpmn:incoming>W48_Flow46</bpmn:incoming>
        <bpmn:outgoing>W48_Flow47</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W48_End28" name="Complete">
        <bpmn:incoming>W48_Flow47</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W48_Annotation29">
        <bpmn:text>Controls: - CTL-322 (ensure controlled execution — Service Management (PA-27.1).) | - operational: IT Helpdesk Lead review and approval gate
Owner: IT Helpdesk Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W48_Assoc30" sourceRef="W48_Annotation29" targetRef="W48_Start11" associationDirection="None" />
