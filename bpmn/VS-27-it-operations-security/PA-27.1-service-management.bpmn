        <bpmn:flowNodeRef>W152_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W152_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W152_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W152_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W152_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W152_Lane3" name="Security Admin">
        <bpmn:flowNodeRef>W152_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W152_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W152_Start5" name="New hire notification (W15); employee transfer (W43.15); or separation (W43)">
        <bpmn:outgoing>W152_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W152_Task6" name="Request">
        <bpmn:documentation>Step 1: Request: HR system triggers provisioning request upon completion of W15 onboarding
Responsible (R): System / HR
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W152_Flow16</bpmn:incoming>
        <bpmn:outgoing>W152_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W152_Task7" name="Identity Creation">
        <bpmn:documentation>Step 2: Identity Creation: System auto-generates AD/Azure account, company email, and employee ID link
Responsible (R): IT Helpdesk
Accountable (A): Infrastructure Mgr
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W152_Flow17</bpmn:incoming>
        <bpmn:outgoing>W152_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W152_Task8" name="Access Role Mapping">
        <bpmn:documentation>Step 3: Access Role Mapping: Assign ERP roles (W37), folder permissions, and application access based on Job Code
Responsible (R): IT Helpdesk
Accountable (A): Infrastructure Mgr
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W152_Flow18</bpmn:incoming>
        <bpmn:outgoing>W152_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W152_Task9" name="Hardware Prep">
        <bpmn:documentation>Step 4: Hardware Prep: Image laptop/workstation; configure POS login for store staff
Responsible (R): IT Helpdesk
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W152_Flow19</bpmn:incoming>
        <bpmn:outgoing>W152_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W152_Task10" name="Transfer / Change">
        <bpmn:documentation>Step 5: Transfer / Change: Upon employee transfer, review and revoke old permissions; add new ones within 24 hours
Responsible (R): IT Helpdesk
Accountable (A): Dept Head
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W152_Flow20</bpmn:incoming>
        <bpmn:outgoing>W152_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W152_Task11" name="De-provisioning">
        <bpmn:documentation>Step 6: De-provisioning: Upon separation (W43), immediate block on all accounts (T-minus 0); hardware retrieval
Responsible (R): IT Helpdesk
Accountable (A): CIO
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W152_Flow21</bpmn:incoming>
        <bpmn:outgoing>W152_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W152_Task12" name="Audit">
        <bpmn:documentation>Step 7: Audit: Monthly reconciliation of Active Directory vs. HR Master to identify &quot;ghost accounts&quot;
Responsible (R): Security Admin
Accountable (A): CIO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W152_Flow22</bpmn:incoming>
        <bpmn:outgoing>W152_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W152_End13" name="Complete">
        <bpmn:incoming>W152_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W152_Annotation14">
        <bpmn:text>Controls: - CTL-54 (prevent unauthorized employee master data changes.) | - operational: IT Infrastructure Manager review and approval gate; operational: periodic reconciliation against source documents
Owner: IT Infrastructure Manager</bpmn:text>
      </bpmn:textAnnotation>
