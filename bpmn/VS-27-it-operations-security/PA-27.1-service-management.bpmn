    <bpmn:process id="W_W385" name="W385. Data Cleansing &amp; Migration Operational Lifecycle" isExecutable="false">
      <bpmn:documentation>Trigger: New store rollout (W16), new legal entity integration (W73), or legacy system decommissioning
Frequency: Per rollout phase (10–15 stores/year)
Volume: Migration of ~55K SKUs, ~600K customers, and location-specific balances
Owner: IT Project Manager / Data Lead
Participants: Data Analysts, Business Data Stewards, Legacy System Admins, IT Devs
Source: workflow W385 — Data Cleansing &amp; Migration Operational Lifecycle</bpmn:documentation>
      <bpmn:laneSet id="W385_LaneSet5">
        <bpmn:lane id="W385_Lane1" name="Legacy Admin">
        <bpmn:flowNodeRef>W385_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W385_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W385_Lane2" name="Data Analyst">
        <bpmn:flowNodeRef>W385_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W385_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W385_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W385_Lane3" name="Data Steward">
        <bpmn:flowNodeRef>W385_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W385_Lane4" name="Data Lead">
        <bpmn:flowNodeRef>W385_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W385_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W385_Start6" name="New store rollout (W16), new legal entity integration (W73), or legacy system…">
        <bpmn:outgoing>W385_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W385_Task7" name="Extraction">
        <bpmn:documentation>Step 1: Extraction: Extract data from legacy source systems (POS, localized accounting, spreadsheets) into staging area
Responsible (R): Legacy Admin
Accountable (A): Data Analyst
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W385_Flow16</bpmn:incoming>
        <bpmn:outgoing>W385_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W385_Task8" name="Technical Cleansing">
        <bpmn:documentation>Step 2: Technical Cleansing: Automated scripts fix formatting issues, remove duplicates, and validate against ERP mandatory fields
Responsible (R): Data Analyst
Accountable (A): Data Lead
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W385_Flow17</bpmn:incoming>
        <bpmn:outgoing>W385_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W385_Task9" name="Business Cleansing">
        <bpmn:documentation>Step 3: Business Cleansing: Data Stewards review exceptions; fix invalid addresses, re-map categories, and resolve ownership disputes
Responsible (R): Data Steward
Accountable (A): Dept Head
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W385_Flow18</bpmn:incoming>
        <bpmn:outgoing>W385_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W385_Task10" name="Mapping &amp; Transformation">
        <bpmn:documentation>Step 4: Mapping &amp; Transformation: Map legacy fields to ERP templates; convert units of measure and currency if needed
Responsible (R): Data Analyst
Accountable (A): Data Lead
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W385_Flow19</bpmn:incoming>
        <bpmn:outgoing>W385_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W385_Task11" name="Load (ETL)">
        <bpmn:documentation>Step 5: Load (ETL): Execute load into ERP staging environment; verify record counts and total balances against source
Responsible (R): Data Analyst
Accountable (A): Data Lead
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W385_Flow20</bpmn:incoming>
        <bpmn:outgoing>W385_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W385_Task12" name="Reconciliation">
        <bpmn:documentation>Step 6: Reconciliation: Technical reconciliation report signed off by Finance (for balances) and IT (for record counts)
Responsible (R): Data Lead
Accountable (A): Controller
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W385_Flow21</bpmn:incoming>
        <bpmn:outgoing>W385_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W385_End13" name="Complete">
        <bpmn:incoming>W385_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W385_Annotation14">
        <bpmn:text>Controls: - CTL-322 (ensure controlled execution — Service Management (PA-27.1).) | - operational: IT Project Manager / Data Lead review and approval gate; periodic reconciliation against source documents
Owner: IT Project Manager / Data Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W385_Assoc15" sourceRef="W385_Annotation14" targetRef="W385_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W385_Flow16" sourceRef="W385_Start6" targetRef="W385_Task7" />
