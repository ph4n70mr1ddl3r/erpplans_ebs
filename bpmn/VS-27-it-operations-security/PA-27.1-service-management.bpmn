    <bpmn:process id="W_W73" name="W73. System Upgrade &amp; New Entity Integration Testing" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled ERP system upgrade, major release deployment, or onboarding of a new store or legal entity
Frequency: As-needed (typically 1–2 times per year for major upgrades, or per new store/entity onboarding)
Volume: All affected master records, local transaction buffers, and employee lists
Owner: IT Project Manager / Department Heads
Participants: Store Managers, Cashiers, AP/AR Clerk, Category Managers, Buyers, Cost Accountant, IT
Source: workflow W73 — System Upgrade &amp; New Entity Integration Testing</bpmn:documentation>
      <bpmn:laneSet id="W73_LaneSet14">
        <bpmn:lane id="W73_Lane1" name="Merchandise Planner">
        <bpmn:flowNodeRef>W73_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W73_Start15</bpmn:flowNodeRef>
        </bpmn:lane>
