    </bpmn:process>
    <bpmndi:BPMNDiagram id="W615_diag">
      <bpmndi:BPMNPlane id="W615_plane" bpmnElement="W_W615">
        <bpmndi:BPMNShape id="W615_Lane1_di" bpmnElement="W615_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2210" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W615_Lane2_di" bpmnElement="W615_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="2210" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W615_Lane3_di" bpmnElement="W615_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="2210" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W615_Task6_di" bpmnElement="W615_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W615_Task7_di" bpmnElement="W615_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W615_Task8_di" bpmnElement="W615_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
