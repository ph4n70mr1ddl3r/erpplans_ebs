      <bpmn:startEvent id="W73_Start15" name="Scheduled ERP system upgrade, major release deployment, or onboarding of a new store or…">
        <bpmn:outgoing>W73_Flow32</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W73_Task16" name="Item master validation">
        <bpmn:documentation>Step 1: Item master validation: Merchandise Planners verify updated or new SKU data — sample 100–500 SKUs; confirm item description, unit of measure, cost, SRP, category assignment, and attributes match database standards; report discrepancies to IT for correction
Responsible (R): Merchandise Planner
Accountable (A): Category Manager
Duration: 4 hours/iteration</bpmn:documentation>
        <bpmn:incoming>W73_Flow32</bpmn:incoming>
        <bpmn:outgoing>W73_Flow33</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W73_Task17" name="Customer master validation">
        <bpmn:documentation>Step 2: Customer master validation: AR Clerks verify sample of trade/corporate accounts — confirm credit limits, payment terms, and VAT treatment classification; Loyalty Manager verifies sample of loyalty accounts — points balance, tier status, and contact info
Responsible (R): AR Clerk / Loyalty Manager
Accountable (A): AR Supervisor
Duration: 4 hours/iteration</bpmn:documentation>
        <bpmn:incoming>W73_Flow33</bpmn:incoming>
        <bpmn:outgoing>W73_Flow34</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W73_Task18" name="Vendor master validation">
        <bpmn:documentation>Step 3: Vendor master validation: Buyers verify sample of vendors — confirm payment terms, lead times, bank details, and tax classification
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 2 hours/iteration</bpmn:documentation>
        <bpmn:incoming>W73_Flow34</bpmn:incoming>
        <bpmn:outgoing>W73_Flow35</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W73_Task19" name="Inventory balance validation">
        <bpmn:documentation>Step 4: Inventory balance validation: Cost Accountant and DC / Store Supervisors verify opening inventory balances for new locations or after system migration — reconcile quantities and values (WAC) to baseline records; identify discrepancies &gt; 1% by value
Responsible (R): Cost Accountant / Store Supervisor
Accountable (A): Controller
Duration: 4 hours/location</bpmn:documentation>
        <bpmn:incoming>W73_Flow35</bpmn:incoming>
        <bpmn:outgoing>W73_Flow36</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W73_Task20" name="Financial validation">
        <bpmn:documentation>Step 5: Financial validation: Controller and Chief Accountant verify trial balance and ledger integration for new entities or post-upgrade — GL account mappings, open AP/AR invoices, fixed asset register, and bank connections
Responsible (R): Controller / Chief Accountant
Accountable (A): CFO
Duration: 8 hours/iteration</bpmn:documentation>
        <bpmn:incoming>W73_Flow36</bpmn:incoming>
        <bpmn:outgoing>W73_Flow37</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W73_Task21" name="Employee master validation">
        <bpmn:documentation>Step 6: Employee master validation: HR Head verifies employee data for new locations or post-upgrade — confirm salary, tax status, statutory deduction registration, and organizational assignment
Responsible (R): HR Head
Accountable (A): CHRO
Duration: 2 hours/iteration</bpmn:documentation>
        <bpmn:incoming>W73_Flow37</bpmn:incoming>
        <bpmn:outgoing>W73_Flow38</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W73_Task22" name="All validation exceptions logged in IT ticket tracker; corrected and…">
        <bpmn:documentation>Step 7: All validation exceptions logged in IT ticket tracker; corrected and re-validated until zero material discrepancies
Responsible (R): All validators
Accountable (A): IT Project Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W73_Flow38</bpmn:incoming>
        <bpmn:outgoing>W73_Flow39</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W73_Task23" name="Payroll parallel run">
        <bpmn:documentation>Step 8: Payroll parallel run: for upgrades affecting the payroll engine, Payroll Officer runs payroll in both sandbox (upgrade test) and production environments; compares output per employee; discrepancies &gt; PHP 1 flagged and resolved
Responsible (R): Payroll Officer / IT
Accountable (A): CFO
Duration: 1 payroll cycle</bpmn:documentation>
        <bpmn:incoming>W73_Flow39</bpmn:incoming>
        <bpmn:outgoing>W73_Flow40</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W73_Task24" name="Close process parallel run">
        <bpmn:documentation>Step 9: Close process parallel run: for upgrades affecting accounting rules, Chief Accountant performs test close steps in sandbox; compares trial balance and key reconciliation outputs to production
Responsible (R): Chief Accountant
Accountable (A): Controller
Duration: 1 close cycle</bpmn:documentation>
        <bpmn:incoming>W73_Flow40</bpmn:incoming>
        <bpmn:outgoing>W73_Flow41</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W73_Task25" name="POS upgrade testing">
        <bpmn:documentation>Step 10: POS upgrade testing: for POS software updates or new store openings, Cashiers process test transactions on designated terminal in sandbox or staging mode; Store Manager compares test Z-reports against expectations
Responsible (R): Cashier / Store Manager
Accountable (A): VP Store Operations
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W73_Flow41</bpmn:incoming>
        <bpmn:outgoing>W73_Flow42</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W73_Task26" name="Inventory transaction testing">
        <bpmn:documentation>Step 11: Inventory transaction testing: stock associates execute key inventory transactions (receipt, transfer, count, sales deduction) in sandbox; Cost Accountant validates ending balance calculations
Responsible (R): Receiving Clerk / Cost Accountant
Accountable (A): Controller
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W73_Flow42</bpmn:incoming>
        <bpmn:outgoing>W73_Flow43</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W73_Task27" name="User acceptance testing (UAT)">
        <bpmn:documentation>Step 12: User acceptance testing (UAT): before major upgrades, designated power users from each department execute scripted UAT test cases covering critical workflows; all test cases must pass with zero critical defects
Responsible (R): Department power users
Accountable (A): IT Project Manager
Duration: 1 week/release</bpmn:documentation>
        <bpmn:incoming>W73_Flow43</bpmn:incoming>
        <bpmn:outgoing>W73_Flow44</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W73_Task28" name="Sign-off">
        <bpmn:documentation>Step 13: Sign-off: after successful UAT, Department Heads sign off on release readiness; Controller signs off on financial accuracy; CFO gives final go-live approval
Responsible (R): Department Heads / CFO
Accountable (A): CEO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W73_Flow44</bpmn:incoming>
        <bpmn:outgoing>W73_Flow45</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W73_End29" name="Complete">
        <bpmn:incoming>W73_Flow45</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W73_Annotation30">
        <bpmn:text>Controls: - CTL-322 (ensure controlled execution — Service Management (PA-27.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: IT Project Manager / Department Heads</bpmn:text>
      </bpmn:textAnnotation>
