    <bpmn:process id="W_W372" name="W372. IT Policy, Security Awareness &amp; User Training" isExecutable="false">
      <bpmn:documentation>Trigger: New hire onboarding (W15); policy update; or security incident trend
Frequency: Continuous (onboarding); Quarterly (refreshers)
Volume: 6,911 employees; ~100–130 new hires/month (per profile §11.4)
Owner: IT Security Manager
Participants: HR Training Team, IT Security Analyst, All Employees
Source: workflow W372 — IT Policy, Security Awareness &amp; User Training</bpmn:documentation>
      <bpmn:laneSet id="W372_LaneSet4">
        <bpmn:lane id="W372_Lane1" name="Employee">
        <bpmn:flowNodeRef>W372_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W372_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W372_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W372_Lane2" name="Security Analyst">
        <bpmn:flowNodeRef>W372_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W372_Lane3" name="IT App Lead">
        <bpmn:flowNodeRef>W372_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W372_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W372_Start5" name="New hire onboarding (W15); policy update; or security incident trend">
        <bpmn:outgoing>W372_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W372_Task6" name="Onboarding Training">
        <bpmn:documentation>Step 1: Onboarding Training: New hires complete &quot;IT Acceptable Use&quot; and &quot;Cybersecurity Basics&quot; modules before system access
Responsible (R): Employee
Accountable (A): IT Security Mgr
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W372_Flow13</bpmn:incoming>
        <bpmn:outgoing>W372_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W372_Task7" name="Policy Acknowledgment">
        <bpmn:documentation>Step 2: Policy Acknowledgment: Digital sign-off on IT policies (Password, Data Privacy, Remote Work) recorded in HR system
Responsible (R): Employee
Accountable (A): HR Head
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W372_Flow14</bpmn:incoming>
        <bpmn:outgoing>W372_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W372_Task8" name="Phishing Simulation">
        <bpmn:documentation>Step 3: Phishing Simulation: (Cross-ref W367.5) Execute tests and assign remedial training to failures
Responsible (R): Security Analyst
Accountable (A): IT Security Mgr
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W372_Flow15</bpmn:incoming>
        <bpmn:outgoing>W372_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W372_Task9" name="ERP Skills Training">
        <bpmn:documentation>Step 4: ERP Skills Training: Coordinate with functional leads to provide &quot;How-To&quot; sessions for new ERP features
Responsible (R): IT App Lead
Accountable (A): Dept Head
Duration: 2 hours/session</bpmn:documentation>
        <bpmn:incoming>W372_Flow16</bpmn:incoming>
        <bpmn:outgoing>W372_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W372_End10" name="Complete">
        <bpmn:incoming>W372_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W372_Annotation11">
        <bpmn:text>Controls: - CTL-322 (ensure controlled execution — Service Management (PA-27.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: IT Security Manager</bpmn:text>
      </bpmn:textAnnotation>
