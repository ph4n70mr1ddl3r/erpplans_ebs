    <bpmn:process id="W_W378" name="W378. IT Problem Management &amp; Root Cause Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: High-severity incident (P1); recurring incidents of the same category; or trend analysis identifying systemic weakness
Frequency: As-needed; Monthly trend review
Volume: ~5–10 deep-dive RCAs per month
Owner: IT Problem Manager
Participants: IT Specialists (Tier 2/3), Vendor Support, App Owners, Infrastructure Lead
Source: workflow W378 — IT Problem Management &amp; Root Cause Analysis</bpmn:documentation>
      <bpmn:laneSet id="W378_LaneSet4">
        <bpmn:lane id="W378_Lane1" name="IT Helpdesk Lead">
        <bpmn:flowNodeRef>W378_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W378_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W378_Lane2" name="IT Specialist">
        <bpmn:flowNodeRef>W378_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W378_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W378_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W378_Lane3" name="Problem Mgr">
        <bpmn:flowNodeRef>W378_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W378_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W378_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W378_Start5" name="High-severity incident (P1); recurring incidents of the same category; or trend analysis…">
        <bpmn:outgoing>W378_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W378_Task6" name="Problem Identification">
        <bpmn:documentation>Step 1: Problem Identification: Identify recurring incidents or major outages that require structural investigation; create &quot;Problem Record&quot; linked to related incidents
Responsible (R): IT Helpdesk Lead
Accountable (A): Problem Mgr
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W378_Flow15</bpmn:incoming>
        <bpmn:outgoing>W378_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W378_Task7" name="Root Cause Analysis (RCA)">
        <bpmn:documentation>Step 2: Root Cause Analysis (RCA): Conduct &quot;5 Whys&quot; or Fishbone analysis to identify underlying technical or process failure; document findings in RCA report
Responsible (R): IT Specialist
Accountable (A): Problem Mgr
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W378_Flow16</bpmn:incoming>
        <bpmn:outgoing>W378_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W378_Task8" name="Workaround Identification">
        <bpmn:documentation>Step 3: Workaround Identification: If permanent fix is complex, document a validated workaround in the Known Error Database (W381) to minimize future impact
Responsible (R): IT Specialist
Accountable (A): Problem Mgr
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W378_Flow17</bpmn:incoming>
        <bpmn:outgoing>W378_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W378_Task9" name="Permanent Fix Implementation">
        <bpmn:documentation>Step 4: Permanent Fix Implementation: Raise Change Request (W132) for the permanent solution (code fix, hardware upgrade, configuration change)
Responsible (R): IT Specialist
Accountable (A): App/Infra Mgr
Duration: Per change</bpmn:documentation>
        <bpmn:incoming>W378_Flow18</bpmn:incoming>
        <bpmn:outgoing>W378_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W378_Task10" name="Post-Implementation Review (PIR)">
        <bpmn:documentation>Step 5: Post-Implementation Review (PIR): Verify that the permanent fix has eliminated the recurring incident; monitor for 30 days
Responsible (R): Problem Mgr
Accountable (A): CIO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W378_Flow19</bpmn:incoming>
        <bpmn:outgoing>W378_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W378_Task11" name="Closure">
        <bpmn:documentation>Step 6: Closure: Close Problem Record; update Knowledge Base; share lessons learned with IT team
Responsible (R): Problem Mgr
Accountable (A): CIO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W378_Flow20</bpmn:incoming>
        <bpmn:outgoing>W378_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W378_End12" name="Complete">
        <bpmn:incoming>W378_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W378_Annotation13">
        <bpmn:text>Controls: - CTL-322 (ensure controlled execution — Service Management (PA-27.1).) | - operational: IT Problem Manager review and approval gate
Owner: IT Problem Manager</bpmn:text>
      </bpmn:textAnnotation>
