    <bpmn:process id="W_W132" name="W132. Software Development &amp; Change Management" isExecutable="false">
      <bpmn:documentation>Trigger: Business request for new feature, bug fix, or system update
Frequency: Weekly release cycle
Volume: ~5–10 changes per week
Owner: Application Manager
Participants: Developers, QA Team, Business Users (UAT), Change Advisory Board (CAB)
Source: workflow W132 — Software Development &amp; Change Management</bpmn:documentation>
      <bpmn:laneSet id="W132_LaneSet7">
        <bpmn:lane id="W132_Lane1" name="Business Analyst">
        <bpmn:flowNodeRef>W132_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W132_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
