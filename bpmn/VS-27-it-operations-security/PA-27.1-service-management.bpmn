    <bpmn:process id="W_W1408" name="W1408. ERP User Access Quarterly Review, Segregation of Duties (SoD) Audit &amp; Excessive Access Remediation" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly access review calendar (Q1: January, Q2: April, Q3: July, Q4: October); or triggered by employee role change (W152), separation (W43), or internal audit finding (W21.1)
Frequency: Quarterly comprehensive review; continuous system-level SoD monitoring
Volume: ~1,500 active ERP user accounts across 5 legal entities (per W152/W370; 6,911 is the M365/email estate); ~500–800 role-based access profiles; quarterly review covers ~375 accounts (25% risk-based sample)
Owner: IT Security Manager
Participants: IT Security Manager, System Administrator, Department Heads (access certifiers), Internal Auditor, HR Manager, Data Protection Officer (DPO)
Source: workflow W1408 — ERP User Access Quarterly Review, Segregation of Duties (SoD) Audit &amp; Excessive Access Remediation</bpmn:documentation>
      <bpmn:laneSet id="W1408_LaneSet6">
        <bpmn:lane id="W1408_Lane1" name="System">
        <bpmn:flowNodeRef>W1408_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1408_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1408_Lane2" name="IT Security Manager">
        <bpmn:flowNodeRef>W1408_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1408_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1408_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1408_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1408_Task16</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1408_Lane3" name="System Administrator">
        <bpmn:flowNodeRef>W1408_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1408_Lane4" name="Internal Auditor">
        <bpmn:flowNodeRef>W1408_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1408_Lane5" name="DPO">
        <bpmn:flowNodeRef>W1408_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1408_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1408_Start7" name="Quarterly access review calendar (Q1: January, Q2: April, Q3: July, Q4: October); or…">
        <bpmn:outgoing>W1408_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1408_Task8" name="System generates quarterly access review report: (a) list of all active user…">
        <bpmn:documentation>Step 1: System generates quarterly access review report: (a) list of all active user accounts with assigned roles, permissions, and last login date; (b) SoD conflict report — identifies users with incompatible role combinations (e.g., AP Clerk + Payment Approver, Store Manager + System Administrator, Payroll Officer + HR Master Data Editor); (c) excessive access report — identifies users with permissions beyond their job requirements (based on role template comparison); (d) orphaned account report — accounts active for employees who have separated (cross-referenced with HR employee master W292); (e) dormant account report — accounts with no login in 90+ days; (f) privileged account report — users with system administrator, database administrator, or superuser roles
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1408_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1408_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1408_Task9" name="Critical">
        <bpmn:documentation>Step 2: IT Security Manager reviews SoD conflict report; classifies each conflict as: (a) Critical — financial transaction risk (e.g., vendor creation + payment, journal entry + approval, refund processing + void authorization); (b) High — data integrity risk (e.g., inventory adjustment + approval, price override + POS admin); (c) Medium — operational risk (e.g., report generation across entities, read access to HR data outside department)
Responsible (R): IT Security Manager
Accountable (A): Internal Auditor
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W1408_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1408_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1408_Task10" name="IT Security Manager distributes access certification lists to Department Heads…">
        <bpmn:documentation>Step 3: IT Security Manager distributes access certification lists to Department Heads: each Department Head receives a list of their direct and indirect reports with current ERP roles and permissions; Department Head must certify that each employee&#x27;s access is appropriate for their current job function; mark each as &quot;Certified — Access Appropriate&quot; or &quot;Action Required — Reduce/Modify Access&quot;
Responsible (R): IT Security Manager / Department Heads
Accountable (A): VP department
Duration: 1 hour/department head</bpmn:documentation>
        <bpmn:incoming>W1408_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1408_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1408_Task11" name="Department Heads return certified access lists within 10 business days; IT…">
        <bpmn:documentation>Step 4: Department Heads return certified access lists within 10 business days; IT Security Manager compiles responses; follows up with non-responsive Department Heads (escalation to VP after 15 business days)
Responsible (R): IT Security Manager
Accountable (A): —
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W1408_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1408_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1408_Task12" name="Orphaned accounts">
        <bpmn:documentation>Step 5: IT Security Manager processes access modifications: (a) Orphaned accounts — immediately disabled and flagged for HR confirmation of separation; (b) Critical SoD conflicts — one of the conflicting roles removed within 2 business days; user and Department Head notified; if business justification requires both roles, mitigating control documented (e.g., enhanced transaction monitoring); (c) Excessive access — permissions reduced to role template standard; (d) Dormant accounts — disabled if confirmed as inactive; if employee on leave, flagged for reactivation upon return
Responsible (R): IT Security Manager / System Administrator
Accountable (A): Internal Auditor
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W1408_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1408_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1408_Task13" name="System Administrator executes access changes in ERP; system logs all…">
        <bpmn:documentation>Step 6: System Administrator executes access changes in ERP; system logs all modifications with IT Security Manager approval; change log stored for 10 years per BIR CAS requirements
Responsible (R): System Administrator
Accountable (A): IT Security Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W1408_Flow25</bpmn:incoming>
        <bpmn:outgoing>W1408_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1408_Task14" name="Internal Auditor reviews quarterly access review results: verifies SoD…">
        <bpmn:documentation>Step 7: Internal Auditor reviews quarterly access review results: verifies SoD conflicts were remediated, orphaned accounts were disabled, Department Head certifications were completed; samples 10% of remediated accounts for independent verification; includes findings in quarterly internal audit report (W21.1)
Responsible (R): Internal Auditor
Accountable (A): Head of Internal Audit
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W1408_Flow26</bpmn:incoming>
        <bpmn:outgoing>W1408_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1408_Task15" name="DPO reviews privileged access to personal data (customer records, employee…">
        <bpmn:documentation>Step 8: DPO reviews privileged access to personal data (customer records, employee records, payroll data): verifies that only authorized personnel with documented business need have access to PII; documents findings in NPC-required privacy impact assessment
Responsible (R): DPO
Accountable (A): —
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W1408_Flow27</bpmn:incoming>
        <bpmn:outgoing>W1408_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1408_Task16" name="IT Security Manager generates quarterly access review summary for CIO: total…">
        <bpmn:documentation>Step 9: IT Security Manager generates quarterly access review summary for CIO: total accounts reviewed, SoD conflicts found and remediated, orphaned accounts disabled, Department Head certification completion rate, overdue certifications, and trend comparison to prior quarters
Responsible (R): IT Security Manager
Accountable (A): CIO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W1408_Flow28</bpmn:incoming>
        <bpmn:outgoing>W1408_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1408_End17" name="Complete">
        <bpmn:incoming>W1408_Flow29</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1408_Annotation18">
        <bpmn:text>Controls: - CTL-322 (ensure controlled execution — Service Management (PA-27.1).)
Owner: IT Security Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1408_Assoc19" sourceRef="W1408_Annotation18" targetRef="W1408_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W1408_Flow20" sourceRef="W1408_Start7" targetRef="W1408_Task8" />
      <bpmn:sequenceFlow id="W1408_Flow21" sourceRef="W1408_Task8" targetRef="W1408_Task9" />
      <bpmn:sequenceFlow id="W1408_Flow22" sourceRef="W1408_Task9" targetRef="W1408_Task10" />
      <bpmn:sequenceFlow id="W1408_Flow23" sourceRef="W1408_Task10" targetRef="W1408_Task11" />
      <bpmn:sequenceFlow id="W1408_Flow24" sourceRef="W1408_Task11" targetRef="W1408_Task12" />
      <bpmn:sequenceFlow id="W1408_Flow25" sourceRef="W1408_Task12" targetRef="W1408_Task13" />
      <bpmn:sequenceFlow id="W1408_Flow26" sourceRef="W1408_Task13" targetRef="W1408_Task14" />
      <bpmn:sequenceFlow id="W1408_Flow27" sourceRef="W1408_Task14" targetRef="W1408_Task15" />
      <bpmn:sequenceFlow id="W1408_Flow28" sourceRef="W1408_Task15" targetRef="W1408_Task16" />
      <bpmn:sequenceFlow id="W1408_Flow29" sourceRef="W1408_Task16" targetRef="W1408_End17" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1408_diag">
      <bpmndi:BPMNPlane id="W1408_plane" bpmnElement="W_W1408">
        <bpmndi:BPMNShape id="W1408_Lane1_di" bpmnElement="W1408_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2210" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1408_Lane2_di" bpmnElement="W1408_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="2210" height="170" /></bpmndi:BPMNShape>
